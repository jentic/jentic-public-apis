ef":"#/components/headers/ratelimit-remaining-429"},"ratelimit-reset":{"$ref":"#/components/headers/ratelimit-reset"},"ratelimit-policy":{"$ref":"#/components/headers/ratelimit-policy-429"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"rate_limit_exceeded","message":"Rate limit exceeded"}}}}}}}},"/threads/{id}/mute":{"put":{"operationId":"muteThread","summary":"Mute a thread for an address","description":"Marks the thread muted for the address: its mail reads as `muted: true` and `GET /emails?exclude_muted=true` leaves it out. Mail keeps arriving and stays readable. Idempotent. 404 when the thread does not exist or the address neither received nor sent mail in it.","tags":["Threads"],"security":[{"BearerAuth":[]}],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"},"description":"The thread id (`thread_id` on an email or sent email)."},{"name":"address","in":"query","required":false,"schema":{"type":"string","format":"email","maxLength":320},"description":"The receiving address the mute applies to. A connected agent may omit it (its own address is used) and cannot name another. Other credentials must name an address that received or sent mail in the thread."}],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/SuccessEnvelope"},{"type":"object","properties":{"data":{"$ref":"#/components/schemas/ThreadMute"}}}]}}},"headers":{"ratelimit-limit":{"$ref":"#/components/headers/ratelimit-limit"},"ratelimit-remaining":{"$ref":"#/components/headers/ratelimit-remaining"},"ratelimit-reset":{"$ref":"#/components/headers/ratelimit-reset"},"ratelimit-policy":{"$ref":"#/components/headers/ratelimit-policy"}}},"400":{"description":"Invalid request parameters","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"c