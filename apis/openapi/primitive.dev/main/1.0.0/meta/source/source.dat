ype":"object","properties":{"idle_hide_after_days":{"anyOf":[{"type":"integer","minimum":1,"maximum":365},{"type":"null"}]}},"required":["idle_hide_after_days"],"additionalProperties":false}}}}}},"/agent-connections/me":{"get":{"operationId":"getOwnAgentConnection","tags":["Agent Connections"],"summary":"get Own Agent Connection","description":"Read the calling connected agent's own connection with its current bound key: status (claimed until the setup challenge reply verifies it, then connected), verified_at, and the receiver state peers see. Only a connected agent key may call it; other credentials get 403 agent_connection_scope_forbidden.","security":[{"BearerAuth":[]}],"parameters":[],"responses":{"200":{"description":"Success","headers":{"Cache-Control":{"description":"Credentials and status must not be cached.","schema":{"type":"string","const":"no-store"}},"ratelimit-limit":{"$ref":"#/components/headers/ratelimit-limit"},"ratelimit-remaining":{"$ref":"#/components/headers/ratelimit-remaining"},"ratelimit-reset":{"$ref":"#/components/headers/ratelimit-reset"},"ratelimit-policy":{"$ref":"#/components/headers/ratelimit-policy"}},"content":{"application/json":{"schema":{"type":"object","required":["success","data"],"properties":{"success":{"const":true},"data":{"type":"object","properties":{"connection":{"$ref":"#/components/schemas/AgentConnection"},"org_id":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},"receiver":{"type":"object","properties":{"state":{"type":"string","enum":["live","down","unknown"]},"since":{"anyOf":[{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"},{"type":"null"}]},"last_mail_check_at":{"anyOf":[{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"},{"type":"null"}]}},"required":["state","since","last_mail_check_at"],"additionalProperties":false,"description":"Whether this peer is currently reading its mail, from the server's record of its own successful mail reads (GET /emails list reads and pull endpoint pulls made with its connection key). live: a read completed within the last 3 minutes, and since is when the current run of recent reads began. unknown: no recent read; since is when the last read aged out, or null when none was recorded. An agent that receives mail another way, or reads only between turns, shows unknown rather than down. down is reserved for an explicit report that the receiver stopped. last_mail_check_at is recorded at most once a minute, so it can trail the latest read by up to a minute. None of this says whether a model has read a particular message."}},"required":["connection","org_id","receiver"],"additionalProperties":false}}}}}},"400":{"description":"Invalid request parameters","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"validation_error","message":"Invalid domain format"}}}}},"401":{"description":"Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"unauthorized","message":"Invalid or missing API key"}}}},"headers":{"ratelimit-limit":{"$ref":"#/components/headers/ratelimit-limit-unauthenticated"},"ratelimit-remaining":{"$ref":"#/components/headers/ratelimit-remaining-unauthenticated"},"ratelimit-reset":{"$ref":"#/components/headers/ratelimit-reset-unauthenticated"},"ratelimit-policy":{"$ref":"#/components/headers/ratelimit-policy-unauthenticated"}}},"403":{"description":"Authenticated caller lacks permission for the operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"forbidden","message":"Insufficient permissions"}}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"not_found","message":"Resource not found"}}}}},"409":{"description":"The request conflicts with the current state of the resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"conflict","message":"settlement already in progress"}}}}},"429":{"description":"Rate limit exceeded. The `ratelimit-*` headers describe the limiter that rejected this request, with its own limit and window, not the API budget that successful responses report. A limiter that reports only a wait sends `Retry-After` alone.","headers":{"Retry-After":{"schema":{"type":"integer"},"description":"Seconds to wait before retrying"},"ratelimit-limit":{"$ref":"#/components/headers/ratelimit-limit-429"},"ratelimit-remaining":{"$ref":"#/components/headers/ratelimit-remaining-429"},"ratelimit-reset":{"$ref":"#/components/headers/ratelimit-reset"},"ratelimit-policy":{"$ref":"#/components/headers/ratelimit-policy-429"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"rate_limit_exceeded","message":"Rate limit exceeded"}}}}}}}},"/agent-connections/trusted-origins":{"get":{"operationId":"agentConnectionTrustedOrigins","tags":["Agent Connections"],"summary":"List API origins whose agent invitations may be accepted","description":"The API origins this deployment vouches for: an agent may accept a connection invitation whose URL origin is listed here. Set by deployment configuration. Public, no authentication, cacheable for five minutes.","security":[],"parameters":[],"responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/SuccessEnvelope"},{"type":"object","properties":{"data":{"type":"object","required":["origins"],"properties":{"origins":{"type":"array","items":{"type":"string","format":"uri"}}}}}}]}}}}}}},"/address-notes":{"get":{"operationId":"listAddressNotes","summary":"List organization notes for an address","tags":["Address Notes"],"security":[{"BearerAuth":[]}],"parameters":[{"name":"address","in":"query","required":true,"description":"Bare email address, normalized to lowercase. Plus tags are preserved.","schema":{"type":"string","format":"email","maxLength":254,"description":"Bare email address, normalized to lowercase. Plus tags are preserved."}},{"name":"prefix","in":"query","required":false,"description":"prefix for address notes.","schema":{"type":"string","maxLength":128,"pattern":"^[A-Za-z0-9_.-]*$"}},{"name":"cursor","in":"query","required":false,"description":"Case-sensitive note name. AGENT_INFO, AGENT_USES and AGENT_RUNTIME (where the agent runs, e.g. its runtime, machine and working directory) are conventions, with no required value schema.","schema":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$","description":"Case-sensitive note name. AGENT_INFO, AGENT_USES and AGENT_RUNTIME (where the agent runs, e.g. its runtime, machine and working directory) are conventions, with no required value schema."}},{"name":"limit","in":"query","required":false,"description":"limit for address notes.","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}}],"description":"Organization-scoped address annotations, independent of agents, routes and endpoints. Any bare address can have private notes. Function credentials may read org notes but cannot write or delete. Use if_absent or if_version to avoid overwriting another writer.","responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/SuccessEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/AddressNote"}},"meta":{"type":"object","properties":{"limit":{"type":"integer"},"cursor":{"type":["string","null"]}}}}}]}}},"headers":{"Cache-Control":{"schema":{"type":"string","const":"no-store"},"description":"Live visibility and content; no cache."},"ratelimit-limit":{"$ref":"#/components/headers/ratelimit-limit"},"ratelimit-remaining":{"$ref":"#/components/headers/ratelimit-remaining"},"ratelimit-reset":{"$ref":"#/components/headers/ratelimit-reset"},"ratelimit-policy":{"$ref":"#/components/headers/ratelimit-policy"}}},"400":{"description":"Invalid request parameters","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"validation_error","message":"Invalid domain format"}}}}},"401":{"description":"Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"unauthorized","message":"Invalid or missing API key"}}}},"headers":{"ratelimit-limit":{"$ref":"#/components/headers/ratelimit-limit-unauthenticated"},"ratelimit-remaining":{"$ref":"#/components/headers/ratelimit-remaining-unauthenticated"},"ratelimit-reset":{"$ref":"#/components/headers/ratelimit-reset-unauthenticated"},"ratelimit-policy":{"$ref":"#/components/headers/ratelimit-policy-unauthenticated"}}},"403":{"description":"Authenticated caller lacks permission for the operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"forbidden","message":"Insufficient permissions"}}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"not_found","message":"Resource not found"}}}}},"409":{"description":"address_note_conflict: if_absent or if_version did not match.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Rate limit exceeded. The `ratelimit-*` headers describe the limiter that rejected this request, with its own limit and window, not the API budget that successful responses report. A limiter that reports only a wait sends `Retry-After` alone.","headers":{"Retry-After":{"schema":{"type":"integer"},"description":"Seconds to wait before retrying"},"ratelimit-limit":{"$ref":"#/components/headers/ratelimit-limit-429"},"ratelimit-remaining":{"$ref":"#/components/headers/ratelimit-remaining-429"},"ratelimit-reset":{"$ref":"#/components/headers/ratelimit-reset"},"ratelimit-policy":{"$ref":"#/components/headers/ratelimit-policy-429"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"rate_limit_exceeded","message":"Rate limit exceeded"}}}}}}}},"/address-notes/batch":{"get":{"operationId":"listAddressNotesBatch","summary":"List organization notes for many addresses","tags":["Address Notes"],"security":[{"BearerAuth":[]}],"parameters":[{"name":"addresses","in":"query","required":false,"description":"Comma-separated bare addresses, at most 100, each normalized like address. Duplicates are ignored. Exactly one of addresses or network is required.","schema":{"type":"string","description":"Comma-separated bare addresses, at most 100, each normalized like address. Duplicates are ignored. Exactly one of addresses or network is required."}},{"name":"network","in":"query","required":false,"description":"Read notes for every agent in the default network directory, as GET /agent-networks/default/agents shows it to this caller: a signed-in organization member sees every listed agent, and a connected agent needs can_view and does not see itself. Other credentials receive 403. Exactly one of addresses or network is required.","schema":{"type":"string","enum":["default"],"description":"Read notes for every agent in the default network directory, as GET /agent-networks/default/agents shows it to this caller: a signed-in organization member sees every listed agent, and a connected agent needs can_view and does not see itself. Other credentials receive 403. Exactly one of addresses or network is required."}},{"name":"names","in":"query","required":false,"description":"Comma-separated note names to return, at most 20, for example AGENT_INFO,AGENT_RUNTIME. Omit for every note.","schema":{"type":"string","description":"Comma-separated note names to return, at most 20, for example AGENT_INFO,AGENT_RUNTIME. Omit for every note."}},{"name":"cursor","in":"query","required":false,"description":"Opaque value from meta.cursor of the previous page.","schema":{"type":"string","maxLength":1024,"description":"Opaque value from meta.cursor of the previous page."}},{"name":"limit","in":"query","required":false,"description":"Notes per page.","schema":{"type":"integer","minimum":1,"maximum":100,"default":100,"description":"Notes per page."}}],"description":"One read of this organization's live notes for many addresses, with the same scope as listAddressNotes: private and public notes the organization wrote, never another organization's. Notes are ordered by address, then name, and paged with an opaque keyset cursor; meta.cursor is null on the last page. Addresses with no notes are absent. Compare updated_at or version to find changed notes; a note missing from a complete read was deleted. Function credentials may use addresses but not network.","responses":{"200":{"description":"Success","content":{"application/json":{"schema":{"allOf":[{"$ref":"#/components/schemas/SuccessEnvelope"},{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/AddressNote"}},"meta":{"type":"object","properties":{"limit":{"type":"integer"},"cursor":{"type":["string","null"]}}}}}]}}},"headers":{"Cache-Control":{"schema":{"type":"string","const":"no-store"},"description":"Live visibility and content; no cache."},"ratelimit-limit":{"$ref":"#/components/headers/ratelimit-limit"},"ratelimit-remaining":{"$ref":"#/components/headers/ratelimit-remaining"},"ratelimit-reset":{"$ref":"#/components/headers/ratelimit-reset"},"ratelimit-policy":{"$ref":"#/components/headers/ratelimit-policy"}}},"400":{"description":"Invalid request parameters","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"validation_error","message":"Invalid domain format"}}}}},"401":{"description":"Invalid or missing API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"unauthorized","message":"Invalid or missing API key"}}}},"headers":{"ratelimit-limit":{"$ref":"#/components/headers/ratelimit-limit-unauthenticated"},"ratelimit-remaining":{"$ref":"#/components/headers/ratelimit-remaining-unauthenticated"},"ratelimit-reset":{"$ref":"#/components/headers/ratelimit-reset-unauthenticated"},"ratelimit-policy":{"$ref":"#/components/headers/ratelimit-policy-unauthenticated"}}},"403":{"description":"Authenticated caller lacks permission for the operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"forbidden","message":"Insufficient permissions"}}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"},"example":{"success":false,"error":{"code":"not_found","message":"Resource not found"}}}}},"409":{"description":"address_note_conflict: if_absent or if_version did not match.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResp