s\\S]{0,254}\\S)?\\s*$","description":"The credit code to redeem. Surrounding whitespace is ignored; the rest must be 1 to 256 characters."}}},"CreditRedemption":{"type":"object","additionalProperties":false,"required":["redemption_id","amount_micros","currency","granted_at","expires_at","label","replayed","message"],"properties":{"redemption_id":{"type":"string","description":"Identifier of the redemption."},"amount_micros":{"type":"string","pattern":"^[0-9]+$","description":"Credit granted, in micros of `currency` (1 USD = 1000000 micros)."},"currency":{"type":"string","description":"Currency of the granted credit, for example `usd`."},"granted_at":{"type":"string","format":"date-time","description":"When the credit was granted."},"expires_at":{"type":["string","null"],"format":"date-time","description":"When the granted credit expires, or null when it does not expire."},"label":{"type":["string","null"],"description":"Customer-facing label of the promotion, when it has one."},"replayed":{"type":"boolean","description":"True when this Idempotency-Key already redeemed this code and the original grant is returned. No second grant is made."},"message":{"type":"string","description":"Human-readable summary of the grant, suitable to show as is."}}},"CreditBalance":{"type":"object","additionalProperties":false,"required":["budget"],"properties":{"budget":{"type":["object","null"],"description":"The active agent spending budget an operator funded for top-ups, or null when there is none.","additionalProperties":false,"required":["currency","max_amount_micros","spent_micros","remaining_micros","per_topup_cap_micros","expires_at","status"],"properties":{"currency":{"type":"string","description":"Currency of the budget, for example `usd`."},"max_amount_micros":{"type":"string","pattern":"^[0-9]+$","description":"Total allowance the operator funded, in micros."},"spent_micros":{"type":"string","pattern":"^[0-9]+$","description":"How much of the allowance has been drawn down, 