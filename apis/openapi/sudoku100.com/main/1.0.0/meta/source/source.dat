openapi: 3.0.3
info:
  title: Sudoku100 API
  version: 1.0.0
  description: |
    Free Sudoku puzzle generation API — no registration, no API key required.

    Generate Sudoku puzzles as images (PNG / WebP / SVG / JPG) in six difficulty
    levels, or fetch a specific puzzle by ID. Every puzzle is generated in real
    time with a guaranteed unique solution.

    - 6 difficulty levels: beginner, easy, medium, hard, expert, extreme
    - 4 image formats: PNG, WebP, SVG, JPG
    - Custom image width: 100–1000 px
    - Deterministic puzzles by ID: 1–10000
    - Multi-language documentation (41 languages)
  license:
    name: MIT
    url: https://github.com/sudoku100com-create/Sudoku-generate-API/blob/main/LICENSE
  contact:
    name: Sudoku100
    url: https://www.sudoku100.com
  x-logo:
    url: https://www.sudoku100.com/sudoku-img?width=400&format=png
servers:
  - url: https://www.sudoku100.com
    description: Production
# The Sudoku100 API is free and requires no authentication.
# Declaring an empty global `security` array explicitly states that
# no security scheme applies to any operation in this spec.
security: []
externalDocs:
  description: GitHub Repository
  url: https://github.com/sudoku100com-create/Sudoku-generate-API
tags:
  - name: Sudoku
    description: Sudoku puzzle generation endpoints

paths:
  /sudoku-img:
    get:
      tags:
        - Sudoku
      summary: Generate a random Sudoku puzzle image
      description: |
        Generates a Sudoku puzzle image at a random difficulty. Optionally pass
        `width` and `format` query parameters to customize the output.
      operationId: generateRandomSudoku
      parameters:
        - name: width
          in: query
          description: Image width in pixels (100–1000).
          required: false
          schema:
            type: integer
            minimum: 100
            maximum: 1000
            default: 500
        - name: format
          in: query
          description: Output image format.
          required: false
          schema:
            type: string
            enum: [png, webp, svg, jpg]
            default: png
      responses:
        '200':
          description: A Sudoku puzzle image.
          content:
            image/png:
              schema:
                type: string
                format: binary
            image/webp:
              schema:
                type: string
                format: binary
            image/svg+xml:
              schema:
                type: string
                format: binary
            image/jpeg:
              schema:
                type: string
                format: binary

  /sudoku-img/{difficulty}:
    get:
      tags:
        - Sudoku
      summary: Generate a Sudoku puzzle image at a specific difficulty
      description: |
        Generates a Sudoku puzzle image at the requested difficulty level.
        Difficulty controls the number of pre-filled clues (and thus how hard
        the puzzle is to solve).

        | Difficulty | Clues |
        |---|---|
        | beginner | 45–50 |
        | easy | 38–44 |
        | medium | 32–37 |
        | hard | 26–31 |
        | expert | 20–25 |
        | extreme | 17–19 |
      operationId: generateSudokuByDifficulty
      parameters:
        - name: difficulty
          in: path
          required: true
          description: Sudoku difficulty level.
          schema:
            type: string
            enum: [beginner, easy, medium, hard, expert, extreme]
        - name: width
          in: query
          description: Image width in pixels (100–1000).
          required: false
          schema:
            type: integer
            minimum: 100
            maximum: 1000
            default: 500
        - name: format
          in: query
          description: Output image format.
          required: false
          schema:
            type: string
            enum: [png, webp, svg, jpg]
            default: png
      responses:
        '200':
          description: A Sudoku puzzle image at the requested difficulty.
          content:
            image/png:
              schema:
                type: string
                format: binary
            image/webp:
              schema:
                type: string
                format: binary
            image/svg+xml:
              schema:
                type: string
                format: binary
            image/jpeg:
              schema:
                type: string
                format: binary
        '400':
          description: Invalid difficulty value.

  /img-id/{id}:
    get:
      tags:
        - Sudoku
      summary: Get a specific Sudoku puzzle image by ID
      description: |
        Returns a deterministic Sudoku puzzle image. The same ID always returns
        the same puzzle, making it suitable for sharing, linking, or repeated
        practice.
      operationId: getSudokuById
      parameters:
        - name: id
          in: path
          required: true
          description: Sudoku puzzle ID (1–10000).
          schema:
            type: integer
            minimum: 1
            maximum: 10000
        - name: width
          in: query
          description: Image width in pixels (100–1000).
          required: false
          schema:
            type: integer
            minimum: 100
            maximum: 1000
            default: 500
        - name: format
          in: query
          description: Output image format.
          required: false
          schema:
            type: string
            enum: [png, webp, svg, jpg]
            default: png
      responses:
        '200':
          description: The requested Sudoku puzzle image.
          content:
            image/png:
              schema:
                type: string
                format: binary
            image/webp:
              schema:
                type: string
                format: binary
            image/svg+xml:
              schema:
                type: string
                format: binary
            image/jpeg:
              schema:
                type: string
                format: binary
        '404':
          description: Puzzle ID not found.

  /sudoku-solver:
    get:
      tags:
        - Sudoku
      summary: Solve a Sudoku puzzle
      description: |
        Returns the solution for a Sudoku puzzle. Pass an `id` to solve a
        specific puzzle by its ID.
      operationId: solveSudoku
      parameters:
        - name: id
          in: query
          description: Sudoku puzzle ID to solve (1–10000).
          required: false
          schema:
            type: integer
            minimum: 1
            maximum: 10000
      responses:
        '200':
          description: The solved Sudoku puzzle.
          content:
            image/png:
              schema:
                type: string
                format: binary
