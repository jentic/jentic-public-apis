{
  "openapi": "3.0.3",
  "info": {
    "title": "Wiktionary MediaWiki API",
    "description": "The MediaWiki Action API for Wiktionary, providing access to dictionary content, word definitions, categories, and search functionality. This is the same API engine used by Wikipedia and other Wikimedia projects. All operations use the single /api.php endpoint with different 'action' parameter values.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://en.wiktionary.org/w/api.php",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://en.wiktionary.org/w",
      "description": "Wiktionary MediaWiki API"
    }
  ],
  "paths": {
    "/api.php": {
      "get": {
        "operationId": "actionQuery",
        "summary": "Query pages, search, list category members, and retrieve site metadata",
        "description": "The primary data retrieval action. Use action=query with prop, list, or meta parameters to fetch page content, search results, category members, site info, and more. Combine with format=json for JSON responses.",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "query",
                "parse",
                "opensearch",
                "expandtemplates"
              ]
            },
            "description": "The action to perform: query (data retrieval), parse (render wikitext to HTML), opensearch (search suggestions), expandtemplates (expand wikitext templates)"
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "jsonfm",
                "xml",
                "xmlfm"
              ],
              "default": "json"
            },
            "description": "Output format"
          },
          {
            "name": "titles",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Pipe-separated list of page titles to query (action=query)"
          },
          {
            "name": "pageids",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Pipe-separated list of page IDs to query (action=query)"
          },
          {
            "name": "prop",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "For action=query: properties to get (revisions, links, categories, extracts, info, langlinks). For action=parse: output properties (text, wikitext, categories, sections, langlinks, links)"
          },
          {
            "name": "rvprop",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Revision properties when prop=revisions (content, timestamp, user, comment, ids)"
          },
          {
            "name": "rvslots",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "main"
            },
            "description": "Which revision slots to return data for"
          },
          {
            "name": "list",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Lists to query: search, categorymembers, allpages, recentchanges (action=query)"
          },
          {
            "name": "meta",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Metadata to query: siteinfo, userinfo, tokens (action=query)"
          },
          {
            "name": "srsearch",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search query string when list=search (action=query)"
          },
          {
            "name": "srlimit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 500
            },
            "description": "Maximum number of search results to return"
          },
          {
            "name": "sroffset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Offset for search result pagination"
          },
          {
            "name": "cmtitle",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Category title when list=categorymembers (e.g., Category:English_nouns)"
          },
          {
            "name": "cmlimit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 500
            },
            "description": "Maximum number of category members to return"
          },
          {
            "name": "siprop",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Site info properties when meta=siteinfo (general, namespaces, statistics)"
          },
          {
            "name": "continue",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Continue parameter for pagination from previous response"
          },
          {
            "name": "redirects",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Automatically resolve redirects"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Title of the page to parse (action=parse)"
          },
          {
            "name": "section",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Section number to parse, 0 for lead section (action=parse)"
          },
          {
            "name": "disabletoc",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Omit table of contents in output (action=parse)"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search string (action=opensearch)"
          },
          {
            "name": "namespace",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "0"
            },
            "description": "Namespaces to search, pipe-separated IDs (action=opensearch)"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 500
            },
            "description": "Maximum number of results (action=opensearch)"
          },
          {
            "name": "text",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Wikitext to expand (action=expandtemplates)"
          },
          {
            "name": "title",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Page title for context (action=expandtemplates)"
          },
          {
            "name": "maxlag",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Maximum replication lag in seconds. If exceeded, the API returns an error instead of processing."
          },
          {
            "name": "origin",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "For CORS requests, set to * for anonymous access"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. Structure varies by action parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "batchcomplete": {
                      "type": "string"
                    },
                    "continue": {
                      "type": "object",
                      "description": "Continuation data for paginated results"
                    },
                    "query": {
                      "type": "object",
                      "description": "Present when action=query",
                      "properties": {
                        "pages": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "object",
                            "properties": {
                              "pageid": {
                                "type": "integer"
                              },
                              "ns": {
                                "type": "integer"
                              },
                              "title": {
                                "type": "string"
                              },
                              "revisions": {
                                "type": "array",
                                "items": {
                                  "type": "object"
                                }
                              }
                            }
                          }
                        },
                        "search": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "ns": {
                                "type": "integer"
                              },
                              "title": {
                                "type": "string"
                              },
                              "pageid": {
                                "type": "integer"
                              },
                              "snippet": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "categorymembers": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "pageid": {
                                "type": "integer"
                              },
                              "ns": {
                                "type": "integer"
                              },
                              "title": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "general": {
                          "type": "object",
                          "description": "Site info when meta=siteinfo"
                        }
                      }
                    },
                    "parse": {
                      "type": "object",
                      "description": "Present when action=parse",
                      "properties": {
                        "title": {
                          "type": "string"
                        },
                        "pageid": {
                          "type": "integer"
                        },
                        "text": {
                          "type": "object",
                          "properties": {
                            "*": {
                              "type": "string"
                            }
                          }
                        },
                        "categories": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "sections": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "toclevel": {
                                "type": "integer"
                              },
                              "level": {
                                "type": "string"
                              },
                              "line": {
                                "type": "string"
                              },
                              "number": {
                                "type": "string"
                              },
                              "index": {
                                "type": "string"
                              }
                            }
                          }
                        },
                        "langlinks": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "expandtemplates": {
                      "type": "object",
                      "description": "Present when action=expandtemplates",
                      "properties": {
                        "wikitext": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "MediaWiki",
      "description": "MediaWiki Action API operations"
    }
  ]
}
