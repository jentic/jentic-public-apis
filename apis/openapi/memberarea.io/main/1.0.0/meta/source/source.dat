"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"}}}},"/datasets/{uuid}/rows/{rowUuid}/attachments/{fileUuid}":{"parameters":[{"in":"path","name":"uuid","required":true,"schema":{"type":"string","format":"uuid"},"description":"Dataset UUID."},{"in":"path","name":"rowUuid","required":true,"schema":{"type":"string","format":"uuid"},"description":"Row UUID."},{"in":"path","name":"fileUuid","required":true,"schema":{"type":"string","format":"uuid"},"description":"File UUID."}],"delete":{"operationId":"deleteDatasetsByUuidRowsByRowUuidAttachmentsByFileUuid","tags":["Datasets"],"summary":"Take a file off a row","description":"Required scope: `datasets:write`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"204":{"description":"Deleted"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/datasets/{uuid}/rows/{rowUuid}/attachments/{fileUuid}/file":{"parameters":[{"in":"path","name":"uuid","required":true,"schema":{"type":"string","format":"uuid"},"description":"Dataset UUID."},{"in":"path","name":"rowUuid","required":true,"schema":{"type":"string","format":"uuid"},"description":"Row UUID."},{"in":"path","name":"fileUuid","required":true,"schema":{"type":"string","format":"uuid"},"description":"File UUID."}],"get":{"operationId":"getDatasetsByUuidRowsByRowUuidAttachmentsByFileUuidFile","tags":["Datasets"],"summary":"Download an attached file","description":"The file behind the signed link the listing hands out. Required scope: `datasets:read`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/octet-stream":{"schema":{"type":"string","format":"binary"}}}},"404":{"$ref":"#/components/responses/NotFound"}}}},"/affiliates/commissions":{"get":{"operationId":"getAffiliatesCommissions","tags":["Affiliates"],"summary":"List affiliate commissions","description":"Returns paginated affiliate commissions for the business, newest\nfirst. Filter by `status` (pending, locked, paid, reversed),\n`affiliate_code`, or `is_test`.\n","parameters":[{"in":"query","name":"status","schema":{"type":"string","enum":["pending","locked","paid","reversed"]}},{"in":"query","name":"affiliate_code","schema":{"type":"string"}},{"in":"query","name":"is_test","schema":{"type":"boolean"}},{"in":"query","name":"per_page","schema":{"type":"integer","minimum":1,"maximum":100}},{"in":"query","name":"page","schema":{"type":"integer","minimum":1}}],"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"Paginated list of commissions","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/AffiliateCommission"}},"meta":{"type":"object","properties":{"page":{"type":"integer"},"per_page":{"type":"integer"},"total":{"type":"integer"},"last_page":{"type":"integer"}}}}}}}},"401":{"description":"API key missing or invalid","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}}}}},"/affiliates":{"post":{"operationId":"postAffiliates","tags":["Affiliates"],"summary":"Turn a member into an affiliate, or sign up a new partner","description":"Creates the affiliate account and returns their referral code and\nreferral link. Name the person either by `member_id` (an existing\nmember) or by `email`. With `email`, an existing member of this\nbusiness is reused; otherwise a new member is created from `email`,\n`first_name`, `last_name` and `language`, so a sign-up form on your own\nwebsite needs a single call. Idempotent by member: a member who already\nhas an affiliate account comes back with 200 and the existing record,\nuntouched, so the call can be repeated safely. A previously removed\naffiliate is revived rather than duplicated.\n\nLeave `code` empty to have one derived from the member's name, made\nunique inside the business. Pass `parent_code` to place the new\naffiliate under a sponsor in the tree, for example the `ref` code from\nthe link the visitor arrived with.\n\nWith `send_welcome_mail`, the welcome email carries the referral and\nrecruiting links. When this call created the member, it also carries a\nbutton to set a password (valid for 60 minutes; after that the member\nuses Forgot password on the login page).\n\nRequired scope: `affiliates:write`, plus `members:write` when the call\ncreates a new member. Call it from your server, never from browser\ncode, because the request carries your API key.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AffiliateCreate"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"The affiliate was created (or a removed one was revived)","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Affiliate"}}}}}},"200":{"description":"The member already had an affiliate account, returned unchanged","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Affiliate"}}}}}},"402":{"$ref":"#/components/responses/PlanLimitReached","description":"Creating the member for `email` would exceed the plan's member limit (limit_members)."},"404":{"description":"The member behind `member_id`, or the sponsor behind `parent_code`, does not exist in this business.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"$ref":"#/components/responses/ValidationError"}}}},"/affiliates/by-code/{code}":{"parameters":[{"in":"path","name":"code","required":true,"schema":{"type":"string"},"description":"The referral code exactly as it appears in the affiliate link, e.g. the CODE in /r/CODE or ?ref=CODE."}],"get":{"operationId":"getAffiliatesByCode","tags":["Affiliates"],"summary":"Look up an affiliate by referral code","description":"Resolves a referral code to the affiliate that owns it, the member\nbehind that affiliate account, and the sponsor one level above them\n(`null` at the top of the tree). Inactive affiliates are returned as\nwell, flagged by `is_active`, so a retired partner can be told apart\nfrom an unknown code, which answers 404. Requires the\n`affiliates:read` scope.\n","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"The affiliate behind the code","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Affiliate"}}}}}},"403":{"description":"API key lacks the affiliates:read scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"404":{"$ref":"#/components/responses/NotFound"}}}},"/contacts":{"get":{"operationId":"getContacts","tags":["Contacts"],"summary":"List contacts","description":"The business's CRM contacts. Required scope: `contacts:read`.","parameters":[{"$ref":"#/components/parameters/PerPage"},{"$ref":"#/components/parameters/Page"},{"in":"query","name":"search","schema":{"type":"string"}},{"in":"query","name":"status","schema":{"type":"string"}},{"in":"query","name":"source","schema":{"type":"string"}}],"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContactsPage"}}}}}},"post":{"operationId":"postContacts","tags":["Contacts"],"summary":"Create a contact","description":"Required scope: `contacts:write`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContactWrite"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"Created","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Contact"}}}}}},"402":{"$ref":"#/components/responses/PlanLimitReached","description":"Creating this contact would add a member and the plan's member limit (limit_members) is reached. Only raised when the contact is created with login access."},"403":{"description":"API key lacks the contacts:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"422":{"$ref":"#/components/responses/ValidationError"}}}},"/contacts/{uuid}":{"parameters":[{"in":"path","name":"uuid","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getContactsByUuid","tags":["Contacts"],"summary":"Retrieve a contact","description":"Required scope: `contacts:read`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Contact"}}}}}},"404":{"$ref":"#/components/responses/NotFound"}}},"patch":{"operationId":"patchContactsByUuid","tags":["Contacts"],"summary":"Update a contact","description":"Required scope: `contacts:write`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContactUpdate"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Contact"}}}}}},"403":{"description":"API key lacks the contacts:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"404":{"$ref":"#/components/responses/NotFound"}}},"put":{"operationId":"putContactsByUuid","tags":["Contacts"],"summary":"Replace a contact","description":"Alias of PATCH. Required scope: `contacts:write`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ContactUpdate"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Contact"}}}}}},"403":{"description":"API key lacks the contacts:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"404":{"$ref":"#/components/responses/NotFound"}}},"delete":{"operationId":"deleteContactsByUuid","tags":["Contacts"],"summary":"Delete a contact","description":"Required scope: `contacts:write`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"204":{"description":"Deleted"},"403":{"description":"API key lacks the contacts:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}}}}},"/contacts/{uuid}/tags/{tagId}":{"parameters":[{"in":"path","name":"uuid","required":true,"schema":{"type":"string","format":"uuid"}},{"in":"path","name":"tagId","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"postContactsByUuidTagsByTagId","tags":["Contacts","Tags"],"summary":"Attach a tag to a contact","description":"Required scope: `contacts:write`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"Attached","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Contact"}}}}}},"403":{"description":"API key lacks the contacts:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"404":{"$ref":"#/components/responses/NotFound"}}},"delete":{"operationId":"deleteContactsByUuidTagsByTagId","tags":["Contacts","Tags"],"summary":"Detach a tag from a contact","description":"Required scope: `contacts:write`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"204":{"description":"Detached"},"403":{"description":"API key lacks the contacts:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}}}}},"/hooks":{"get":{"operationId":"getHooks","tags":["Hooks"],"summary":"List REST-hook subscriptions","description":"Active subscriptions registered with the current API key. Required scope: `webhooks:manage`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/HookSubscription"}}}}}}}}},"post":{"operationId":"postHooks","tags":["Hooks"],"summary":"Subscribe to an event","description":"Register a target URL to receive any supported event across members,\norders, subscriptions, affiliates, courses, community, events, popups\nand datasets. See the `event` enum for the full list. Returns the\nsubscription with its `uuid`: store it for the DELETE call later.\nOptional `secret` is used to HMAC-SHA256 sign every payload\n(header `X-Maio-Signature`).\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["event","target_url"],"properties":{"event":{"type":"string","enum":["lead.created","form.submitted","funnel.completed","order.paid","order.payment_pending","order.payment_failed","invoice.paid","refund.created","subscription.created","subscription.renewed","subscription.cancelled","subscription.payment_failed","affiliate.commission.created","affiliate.payout.paid","member.signup","member.login","member.tag_added","member.tag_removed","member.field_changed","course.completed","lesson.completed","event.registered","event.attended","community.post_created","community.level_up","community.badge_earned","page.published","page.unpublished","popup.interacted","dataset.row_created","dataset.row_updated","dataset.row_deleted","inbox.message_received","inbox.ticket_created","contact.created"]},"target_url":{"type":"string","format":"uri"},"secret":{"type":"string","minLength":8,"maxLength":128},"filters":{"type":"object","additionalProperties":true,"description":"Narrows the subscription. Each key is a dot path into the event payload, each value the value or list of values it accepts. The key dataset.id set to a dataset UUID makes a dataset trigger watch one dataset instead of all. Up to 5 entries. On the dataset events only dataset.id, dataset.name, row.id, row.status and row.data.* are accepted, so a typo cannot mute the subscription. Without it every payload of the event is delivered. Send null to clear it; an empty object is refused with the code empty_filters."}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"Subscribed","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/HookSubscription"}}}}}},"422":{"$ref":"#/components/responses/ValidationError"}}}},"/hooks/{uuid}":{"parameters":[{"in":"path","name":"uuid","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getHooksByUuid","tags":["Hooks"],"summary":"Retrieve a hook subscription","description":"Required scope: `webhooks:manage`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/HookSubscription"}}}}}},"404":{"$ref":"#/components/responses/NotFound"}}},"patch":{"operationId":"patchHooksByUuid","tags":["Hooks"],"summary":"Update a hook subscription","description":"Required scope: `webhooks:manage`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"target_url":{"type":"string","format":"uri"},"is_active":{"type":"boolean"},"secret":{"type":"string","minLength":8,"maxLength":128}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/HookSubscription"}}}}}},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"}}},"delete":{"operationId":"deleteHooksByUuid","tags":["Hooks"],"summary":"Unsubscribe a hook","description":"Zapier and Make call this when the Zap / Scenario is paused or deleted. Server stops fanning events to the URL immediately.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"Deleted"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/inbox/channels":{"get":{"operationId":"getInboxChannels","tags":["Inbox"],"summary":"List inbox channels","description":"Channels connected to the inbox (Instagram, WhatsApp, email, and more). Required scope: `inbox:read`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InboxChannelsPage"}}}}}}},"/inbox/conversations":{"get":{"operationId":"getInboxConversations","tags":["Inbox"],"summary":"List conversations","description":"Direct messages and comment threads across every connected channel. Required scope: `inbox:read`.","parameters":[{"$ref":"#/components/parameters/PerPage"},{"$ref":"#/components/parameters/Page"},{"in":"query","name":"status","schema":{"type":"string","enum":["open","snoozed","done"]}},{"in":"query","name":"channel","schema":{"type":"string","format":"uuid"}},{"in":"query","name":"unread","schema":{"type":"boolean"}}],"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InboxConversationsPage"}}}}}}},"/inbox/conversations/{uuid}":{"parameters":[{"in":"path","name":"uuid","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getInboxConversationsByUuid","tags":["Inbox"],"summary":"Retrieve a conversation","description":"Returns the conversation with its embedded messages. Required scope: `inbox:read`.","response