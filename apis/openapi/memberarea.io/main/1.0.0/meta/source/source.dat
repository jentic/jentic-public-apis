password, for example straight from your own users table. Plain passwords are rejected. With it, the call also creates a member account for this email that signs in with exactly this password, so the person uses the same password on your MemberArea as on your platform. An existing contact with this email is updated instead of rejected, and no double opt-in mail is sent. Requires email. If a member account for this email already exists in your MemberArea, its password stays unchanged. The response is the contact; look the member up with GET /members/by-email."}}},"ContactUpdate":{"type":"object","properties":{"email":{"type":["string","null"],"format":"email"},"first_name":{"type":["string","null"]},"last_name":{"type":["string","null"]},"phone":{"type":["string","null"]},"website":{"type":["string","null"]},"language":{"type":["string","null"]},"image":{"type":["string","null"]},"status":{"type":"string"},"custom_fields":{"type":"object","additionalProperties":true},"consent_email":{"type":"boolean","description":"Set to true to record email consent for an existing contact. Stores the consent timestamp, source (api) and request IP if none is on record yet, and promotes a contact still awaiting double opt-in to active. Requires the contact to have an email. Has no effect when false or omitted."},"consent_phone":{"type":"boolean","description":"Set to true to record phone consent for an existing contact. Stores the phone consent timestamp, source (api) and request IP if none is on record yet. Requires the contact to have a phone number. Has no effect when false or omitted."}}},"CourseProgress":{"type":"object","properties":{"course":{"$ref":"#/components/schemas/Course"},"progress":{"type":"integer","minimum":0,"maximum":100},"completed":{"type":"boolean"}}},"MemberRole":{"type":"object","properties":{"member_id":{"type":"string","format":"uuid"},"role":{"$ref":"#/components/schemas/Role"}}},"RosterEntry":{"type":"object","properties":{"member":{"$ref":"#/components/s