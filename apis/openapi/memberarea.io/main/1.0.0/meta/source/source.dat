:{"parameters":[{"in":"path","name":"uuid","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"postInboxTicketsByUuidNotes","tags":["Inbox"],"summary":"Add a note to a ticket","description":"Required scope: `inbox:write`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["body"],"properties":{"body":{"type":"string","maxLength":10000}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"Created","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/InboxTicketNote"}}}}}},"403":{"description":"API key lacks the inbox:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}}}}},"/inbox/labels":{"get":{"operationId":"getInboxLabels","tags":["Inbox"],"summary":"List labels","description":"Labels available to organize conversations. Required scope: `inbox:read`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InboxLabelsPage"}}}}}}},"/inbox/saved-replies":{"get":{"operationId":"getInboxSavedReplies","tags":["Inbox"],"summary":"List saved replies","description":"Reusable canned responses. Required scope: `inbox:read`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InboxSavedRepliesPage"}}}}}}},"/courses/{courseUuid}/enrollments":{"parameters":[{"in":"path","name":"courseUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"postCoursesByCourseUuidEnrollments","tags":["Courses"],"summary":"Enroll a member in a course","description":"Grants a member access to the course. Required scope: `courses:write`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["member"],"properties":{"member":{"type":"string","format":"uuid"}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"Created","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Enrollment"}}}}}},"403":{"description":"API key lacks the courses:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"404":{"$ref":"#/components/responses/NotFound"}}}},"/courses/{courseUuid}/enrollments/{memberUuid}":{"parameters":[{"in":"path","name":"courseUuid","required":true,"schema":{"type":"string","format":"uuid"}},{"in":"path","name":"memberUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"delete":{"operationId":"deleteCoursesByCourseUuidEnrollmentsByMemberUuid","tags":["Courses"],"summary":"Unenroll a member from a course","description":"Required scope: `courses:write`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"204":{"description":"Removed"},"403":{"description":"API key lacks the courses:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"404":{"$ref":"#/components/responses/NotFound"}}}},"/courses/{courseUuid}/lessons/{lessonUuid}/completion":{"parameters":[{"in":"path","name":"courseUuid","required":true,"schema":{"type":"string","format":"uuid"}},{"in":"path","name":"lessonUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"postCoursesByCourseUuidLessonsByLessonUuidCompletion","tags":["Courses"],"summary":"Mark a lesson complete for a member","description":"Required scope: `courses:write`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["member"],"properties":{"member":{"type":"string","format":"uuid"}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/LessonCompletion"}}}}}},"403":{"description":"API key lacks the courses:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"404":{"$ref":"#/components/responses/NotFound"}}}},"/courses/{courseUuid}/publish":{"parameters":[{"in":"path","name":"courseUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"postCoursesByCourseUuidPublish","tags":["Courses"],"summary":"Publish the course","description":"Publishes the course's latest draft version, so every lesson change made\nthrough the API becomes visible to members, and opens a fresh draft\nversion for the next round of edits. Required scope: `courses:write`.\n","requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"version_name":{"type":["string","null"],"example":"Recording from 12 May"},"version_description":{"type":["string","null"],"example":"Adds the Zoom call as lesson 4."},"hide":{"type":"boolean","default":false,"description":"Keep the version out of the member-facing version list."},"notify":{"type":"boolean","default":false,"description":"Email members that the course was updated."}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/CoursePublication"}}}}}},"403":{"description":"API key lacks the courses:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"}}}},"/modules/{moduleUuid}/lessons":{"parameters":[{"in":"path","name":"moduleUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getModulesByModuleUuidLessons","tags":["Lesson Content"],"summary":"List the lessons of a module","description":"The draft lessons of one module, in the order the editor shows them.\nRequired scope: `lessons:read`.\n","parameters":[{"$ref":"#/components/parameters/PerPage"},{"$ref":"#/components/parameters/Page"}],"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LessonsPage"}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}},"post":{"operationId":"postModulesByModuleUuidLessons","tags":["Lesson Content"],"summary":"Create a lesson in a module","description":"Adds a lesson to the module's draft. Without `section_id` the lesson\nlands in the module's first section, and a module without any section\ngets one. Publish the course afterwards to show it to members.\nRequired scope: `lessons:write`.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LessonWrite"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"Created","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Lesson"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"}}}},"/modules/{moduleUuid}/recordings":{"parameters":[{"in":"path","name":"moduleUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"postModulesByModuleUuidRecordings","tags":["Lesson Content"],"summary":"Turn a meeting recording into a lesson","description":"The one call a Zoom-to-MemberArea automation needs: hand over the\nrecording's download URL and get back a new lesson with one page and a\nvideo element playing that recording. The file is pulled by the video\nservice in the background, so the element is playable a few minutes\nlater, not instantly.\n\nFor a protected download link (Zoom cloud recordings expect a bearer\ntoken) either append the token to the URL or pass it in `headers`.\nThe lesson is created hidden (`status: 0`) unless you say otherwise, so\nyou can review it before publishing the course.\nRequired scope: `lessons:write`.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LessonRecordingWrite"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"Created","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Lesson"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"},"502":{"description":"The video service refused the recording URL.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/lessons/element-types":{"get":{"operationId":"getLessonsElementTypes","tags":["Lesson Content"],"summary":"List the available element types","description":"The catalog an integration picks `type` from when it creates an\nelement. Match on `type`, never on a numeric id: ids differ per\ninstallation. Required scope: `lessons:read`.\n","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/LessonElementType"}}}}}}},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/lessons/{lessonUuid}":{"parameters":[{"in":"path","name":"lessonUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getLessonsByLessonUuid","tags":["Lesson Content"],"summary":"Read a lesson with its pages and elements","description":"Required scope: `lessons:read`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Lesson"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}},"patch":{"operationId":"patchLessonsByLessonUuid","tags":["Lesson Content"],"summary":"Update a lesson","description":"Only the fields you send are changed. Required scope: `lessons:write`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LessonWrite"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Lesson"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"}}},"delete":{"operationId":"deleteLessonsByLessonUuid","tags":["Lesson Content"],"summary":"Delete a lesson","description":"Moves the lesson to the trash, where the editor can restore it.\nMembers keep seeing it until the course is published again.\nRequired scope: `lessons:write`.\n","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"204":{"description":"Deleted"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/lessons/{lessonUuid}/recordings":{"parameters":[{"in":"path","name":"lessonUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"postLessonsByLessonUuidRecordings","tags":["Lesson Content"],"summary":"Add a recording to an existing lesson","description":"Same import as the module-level call, but the video is appended to a\nlesson you already have. Without `page_id` it gets a page of its own.\nRequired scope: `lessons:write`.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LessonRecordingWrite"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"Created","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Lesson"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"},"502":{"description":"The video service refused the recording URL.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/lessons/{lessonUuid}/pages":{"parameters":[{"in":"path","name":"lessonUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getLessonsByLessonUuidPages","tags":["Lesson Content"],"summary":"List the pages of a lesson","description":"Required scope: `lessons:read`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/LessonPage"}}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}},"post":{"operationId":"postLessonsByLessonUuidPages","tags":["Lesson Content"],"summary":"Add a page to a lesson","description":"Required scope: `lessons:write`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LessonPageWrite"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"Created","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/LessonPage"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"}}}},"/lessons/{lessonUuid}/pages/{pageUuid}":{"parameters":[{"in":"path","name":"lessonUuid","required":true,"schema":{"type":"string","format":"uuid"}},{"in":"path","name":"pageUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"patch":{"operationId":"patchLessonsByLessonUuidPagesByPageUuid","tags":["Lesson Content"],"summary":"Update a page","description":"Required scope: `lessons:write`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LessonPageWrite"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/LessonPage"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"}}},"delete":{"operationId":"deleteLessonsByLessonUuidPagesByPageUuid","tags":["Lesson Content"],"summary":"Delete a page","description":"Required scope: `lessons:write`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"204":{"description":"Deleted"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/lessons/{lessonUuid}/pages/{pageUuid}/elements":{"parameters":[{"in":"path","name":"lessonUuid","required":true,"schema":{"type":"string","format":"uuid"}},{"in":"path","name":"pageUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getLessonsByLessonUuidPagesByPageUuidElements","tags":["Lesson Content"],"summary":"List the elements of a page","description":"Required scope: `lessons:read`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/LessonElement"}}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}},"post":{"operationId":"postLessonsByLessonUuidPagesByPageUuidElements","tags":["Lesson Content"],"summary":"Add an element to a page","description":"`type` is matched against the element catalog by name, case-insensitively.\n`content` is the element's own payload and differs per type; read an\nexisting element of the same type to see the shape it expects.\nRequired scope: `lessons:write`.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LessonElementWrite"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"Created","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/LessonElement"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"description":"Invalid payload, or an element type that is not in the catalog.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/lessons/{lessonUuid}/pages/{pageUuid}/elements/{elementUuid}":{"parameters":[{"in":"path","name":"lessonUuid","required":true,"schema":{"type":"string","format":"uuid"}},{"in":"path","name":"pageUuid","required":true,"schema":{"type":"string","format":"uuid"}},{"in":"path","name":"elementUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"patch":{"operationId":"patchLessonsByLessonUuidPagesByPageUuidElementsByElementUuid","tags":["Lesson Content"],"summary":"Update an element","description":"The element keeps its type. Required scope: `lessons:write`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LessonElementUpdate"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/LessonElement"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"}}},"delete":{"operationId":"deleteLessonsByLessonUuidPagesByPageUuidElementsByElementUuid","tags":["Lesson Content"],"summary":"Delete an element","description":"Required scope: `lessons:write`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"204":{"description":"Deleted"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/events/{eventUuid}/registrations":{"parameters":[{"in":"path","name":"eventUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"postEventsByEventUuidRegistrations","tags":["Events"],"summary":"Register a member for an event","description":"Required scope: `events:write`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EventRegistrationWrite"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"Created","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/EventRegistration"}}}}}},"403":{"description":"API key lacks the events:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"}}}},"/events/{eventUuid}/registrations/{memberUuid}":{"parameters":[{"in":"path","name":"eventUuid","required":true,"schema":{"type":"string","format":"uuid"}},{"in":"path","name":"memberUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"delete":{"operationId":"deleteEventsByEventUuidRegistrationsByMemberUuid","tags":["Events"],"summary":"Cancel a member's event registration","description":"Required scope: `events:write`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"204":{"description":"Removed"},"403":{"description":"API key lacks the events:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"404":{"$ref":"#/components/responses/NotFound"}}}},"/events/{eventUuid}/check-in":{"parameters":[{"in":"path","name":"eventUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"postEventsByEventUuidCheckIn","tags":["Events"],"summary":"Check a member in at an event","description":"Required scope: `events:write`.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["member"],"properties":{"member":{"type":"string","format":"uuid"}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/EventCheckIn"}}}}}},"403":{"description":"API key lacks the events:write scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"404":{"$ref":"#/components/responses/NotFound"}}}},"/automations":{"get":{"operationId":"getAutomations","tags":["Automations"],"summary":"List automations","description":"Required scope: `automations:read`.","parameters":[{"$ref":"#/components/parameters/PerPage"},{"$ref":"#/components/parameters/Page"}],"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AutomationsPage"}}}}}}},"/automations/{uuid}":{"parameters":[{"in":"path","name":"uuid","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getAutomationsByUuid","tags":["Automations"],"summary":"Retrieve an automation","description":"Required scope: `automations:read`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Automation"}}}}}},"404":{"$ref":"#/components/responses/NotFound"}}}},"/automations/{uuid}/trigger":{"parameters":[{"in":"path","name":"uuid","required":true,"schema":{"type":"string","format":"uuid"}}],"post":{"operationId":"postAutomationsByUuidTrigger","tags":["Automations"],"summary":"Trigger an automation","description":"Starts a run of the automation with an optional payload. Required scope: `automations:trigger`.","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AutomationTriggerWrite"}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"202":{"description":"Accepted","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/AutomationTriggerResult"}}}}}},"403":{"description":"API key lacks the automations:trigger scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"404":{"$ref":"#/components/responses/NotFound"},"409":{"description":"Automation is disabled, not published, or has no trigger node.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/automations/{uuid}/runs":{"parameters":[{"in":"path","name":"uuid","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getAutomationsByUuidRuns","tags":["Automations"],"summary":"List automation runs","description":"Required scope: `automations:read`.","parameters":[{"$ref":"#/components/parameters/PerPage"},{"$ref":"#/components/parameters/Page"},{"in":"query","name":"status","schema":{"type":"string","enum":["running","completed","failed","cancelled"]}},{"in":"query","name":"since","schema":{"type":"string","format":"date-time"}}],"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AutomationRunsPage"}}}}}}},"/automations/{uuid}/runs/{runUuid}":{"parameters":[{"in":"path","name":"uuid","required":true,"schema":{"type":"string","format":"uuid"}},{"in":"path","name":"runUuid","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getAutomationsByUuidRunsByRunUuid","tags":["Automations"],"summary":"Retrieve an automation run","description":"Returns the run with its node runs. Required scope: `automations:read`.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/AutomationRun"}}}}}},"404":{"$ref":"#/components/responses/NotFound"}}}},"/openapi.json":{"get":{"operationId":"getOpenapiJson","tags":["Introspection"],"summary":"This specification as JSON","description":"Public. No API key required.","security":[],"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object"}}}},"304":{"description":"Not modified"}}}},"/openapi.yaml":{"get":{"operationId":"getOpenapiYaml","tags":["Introspection"],"summary":"This specification as YAML","description":"Public. No API key required.","security":[],"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"200":{"description":"OK","content":{"application/yaml":{"schema":{"type":"string"}}}},"304":{"description":"Not modified"}}}},"/marketing/badges":{"get":{"operationId":"getMarketingBadges","tags":["Marketing","Courses"],"summary":"List marketing badges","description":"Returns the enabled trust seals of your courses, ready to embed on an\nexternal site. Required scope: `courses:read` or `wordpress:read`.\n","parameters":[{"$ref":"#/components/parameters/PerPage"},{"$ref":"#/components/parameters/Page"}],"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"Paginated list of badges","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/MarketingBadge"}},"meta":{"$ref":"#/components/schemas/PaginationMeta"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/datasets/forms":{"get":{"operationId":"getDatasetsForms","tags":["Datasets"],"summary":"List the forms of all datasets","description":"Every form that writes into one of your datasets, for picking one to\nembed. Required scope: `datasets:read` or `wordpress:read`.\n","parameters":[{"$ref":"#/components/parameters/PerPage"},{"$ref":"#/components/parameters/Page"}],"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"Paginated list of forms","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/DatasetForm"}},"meta":{"$ref":"#/components/schemas/PaginationMeta"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"}}}},"/wordpress/connections":{"get":{"operationId":"getWordpressConnections","tags":["WordPress"],"summary":"List connected websites","description":"Required scope: `wordpress:manage`. Secrets are never returned again.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/WordpressConnection"}}}}}}},"403":{"$ref":"#/components/responses/Forbidden"}}},"post":{"operationId":"postWordpressConnections","tags":["WordPress"],"summary":"Register a website","description":"Creates the trust relationship between a website and this MemberArea.\nThe response carries `secret` exactly once. Store it server-side on the\nwebsite; it authenticates the login exchange and the access check.\n\n**Posting a `site_url` that is already registered replaces that\nregistration** instead of creating a second one: the old secret stops\nworking immediately, and if `return_url` changed or `share_email` was\nwidened, every member has to consent again. Do not repeat this call to\nretry a failed request unless you are prepared to store the new secret.\nRequired scope: `wordpress:manage`.\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name","site_url","return_url"],"properties":{"name":{"type":"string","example":"Club website"},"site_url":{"type":"string","format":"uri","example":"https://club.example.com"},"return_url":{"type":"string","format":"uri","description":"Where a member is sent back to after signing in. Must be https and must be a plain address: no query string, no fragment, no credentials. Anything else is refused at registration, because the login would never recognise it.","example":"https://club.example.com/memberarea/callback"},"share_email":{"type":"boolean","default":false,"description":"Whether the website may learn the member's email address."}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"Created","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"allOf":[{"$ref":"#/components/schemas/WordpressConnection"},{"type":"object","properties":{"secret":{"type":"string","example":"mws_\u2026"}}}]}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"422":{"$ref":"#/components/responses/ValidationError"}}}},"/wordpress/connections/{uuid}":{"parameters":[{"in":"path","name":"uuid","required":true,"schema":{"type":"string","format":"uuid"},"description":"Connection UUID."}],"delete":{"operationId":"deleteWordpressConnectionsByUuid","tags":["WordPress"],"summary":"Disconnect a website","description":"Required scope: `wordpress:manage`. Ends every session the website holds.","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"Disconnected","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"deleted":{"type":"boolean"}}}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"}}}},"/wordpress/sessions":{"post":{"operationId":"postWordpressSessions","tags":["WordPress"],"summary":"Exchange a login code for a member identity","description":"Called server-side by a connected website after a member returned from\nthe sign-in screen. Authentication is the connection secret, not an API\nkey, so a leaked API key cannot mint member sessions. A code is\nsingle-use, expires after 60 seconds and is bound to the connection it\nwas issued for.\n","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["connection","secret","code"],"properties":{"connection":{"type":"string","format":"uuid"},"secret":{"type":"string","example":"mws_\u2026"},"code":{"type":"string"}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"200":{"description":"The member behind the code","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"member":{"$ref":"#/components/schemas/WordpressMember"}}}}}}}},"401":{"description":"Connection, secret or code not valid","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"The member may no longer sign in here","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"$ref":"#/components/responses/ValidationError"},"429":{"description":"Too many attempts for this connection and IP","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/wordpress/access":{"post":{"operationId":"postWordpressAccess","tags":["WordPress"],"summary":"Ask whether a member may see something","description":"Answers up to 50 checks with booleans only, never with the records\nthemselves, so a connected website can gate content without being able\nto read your member roster. Authentication is the connection secret,\nand the member must have consented to this website. Product access\nfollows the platform: refunds, cancellations and ended subscriptions\ntake it away. Answers may be cached privately for 60 seconds. An empty\nbatch is a plain \"is this member still allowed here\" probe.\n","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["connection","secret","member"],"properties":{"connection":{"type":"string","format":"uuid"},"secret":{"type":"string","example":"mws_\u2026"},"member":{"type":"string","format":"uuid"},"checks":{"type":"array","description":"Leave it out or send an empty list to ask nothing but\nwhether the member may still be here at all. That is how a\nconnected site keeps a signed-in visitor honest.\n","maxItems":50,"items":{"type":"object","required":["type","id"],"properties":{"type":{"type":"string","enum":["course","group","product"]},"id":{"type":"string","format":"uuid"}}}}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"200":{"description":"One boolean per check, keyed `type:id`","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"access":{"type":"object","additionalProperties":{"type":"boolean"},"example":{"course:9b7c1e2a-3f4d-4a5b-8c6d-1e2f3a4b5c6d":true,"product:4d3c2b1a-9f8e-4d7c-8b6a-5f4e3d2c1b0a":false}}}}}}}}},"401":{"description":"Connection or secret not valid","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"The member is unavailable to this website","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"$ref":"#/components/responses/ValidationError"},"429":{"description":"Too many attempts","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/wordpress/courses":{"post":{"operationId":"postWordpressCourses","tags":["WordPress"],"summary":"The courses one member holds","description":"For a connected site to show a member their own courses. Authenticated\nwith the connection secret and the member's consent, never with an API\nkey, so a site that can show one member their courses cannot read\nanybody else's. Only published, listed courses are returned, each with\nprogress and a deep link into the member area.\n","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["connection","secret","member"],"properties":{"connection":{"type":"string","format":"uuid"},"secret":{"type":"string","example":"mws_\u2026"},"member":{"type":"string","format":"uuid"}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"200":{"description":"The member's courses","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"courses":{"type":"array","items":{"$ref":"#/components/schemas/MemberCourse"}}}}}}}}},"401":{"description":"Connection or secret not valid","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"The member is unavailable to this website","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"$ref":"#/components/responses/ValidationError"},"429":{"description":"Too many attempts","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/automations/webhook/{automation_uuid}":{"parameters":[{"in":"path","name":"automation_uuid","required":true,"schema":{"type":"string","format":"uuid"},"description":"Automation UUID."}],"post":{"operationId":"postAutomationsWebhookByAutomation_uuid","tags":["Automations"],"summary":"Trigger an automation from an external system","description":"Authentication is the automation's own `webhook_secret`, not an API\nkey. Send it as the `X-Automation-Secret` header or, if your caller\ncannot set headers, as a `secret` query parameter. Rate limited per\nautomation. Errors from this endpoint use `{\"error\": \"<code>\"}` with a\nplain string, not the envelope the rest of the API uses.\n","security":[],"parameters":[{"in":"header","name":"X-Automation-Secret","required":false,"schema":{"type":"string"},"description":"The automation's webhook secret. Preferred over the query parameter."},{"in":"query","name":"secret","required":false,"schema":{"type":"string"},"description":"Fallback for callers that cannot set headers."}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","description":"Arbitrary payload handed to the automation."}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"200":{"description":"Accepted","content":{"application/json":{"schema":{"type":"object"}}}},"401":{"description":"Secret missing or wrong","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookError"}}}},"404":{"description":"No such automation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookError"}}}},"409":{"description":"The automation exists but cannot run: disabled (automation_disabled), unpublished (no_published_version), or an empty graph (empty_graph)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookError"}}}},"429":{"description":"Too many calls for this automation. Metered per automation UUID and per IP, not per API key, so this response carries neither the envelope nor the X-RateLimit headers.","headers":{"Retry-After":{"description":"Seconds to wait before retrying.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string","example":"Too Many Attempts."}}}}}}}}},"/community/forums/{forum}/mark-read":{"parameters":[{"in":"path","name":"forum","required":true,"schema":{"type":"string","format":"uuid"},"description":"Forum UUID."}],"post":{"operationId":"postCommunityForumsByForumMarkRead","tags":["Community"],"summary":"Mark a forum as read","description":"Marks every post in the forum as read for the user behind the key.\nRequired scope: `community:write`. Needs a user-linked credential.\n","responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"204":{"description":"Marked"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"description":"The credential is not linked to a user","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/community/areas/{area}/notifications":{"parameters":[{"in":"path","name":"area","required":true,"schema":{"type":"string","format":"uuid"},"description":"Area UUID."}],"put":{"operationId":"putCommunityAreasByAreaNotifications","tags":["Community"],"summary":"Set the notification mode for an area","description":"Required scope: `community:write`. Needs a user-linked credential.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["mode"],"properties":{"mode":{"type":"string","enum":["all","mentions_only","muted"]}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/CommunityArea"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"}}}},"/community/badges/{badge}/featured":{"parameters":[{"in":"path","name":"badge","required":true,"schema":{"type":"string","format":"uuid"},"description":"Badge UUID."}],"put":{"operationId":"putCommunityBadgesByBadgeFeatured","tags":["Community"],"summary":"Feature or unfeature a badge on your profile","description":"Required scope: `community:write`. Needs a user-linked credential.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["featured"],"properties":{"featured":{"type":"boolean"}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"200":{"description":"The badge itself. Whether it is featured is not part of the badge payload.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/CommunityBadge"}}}}}},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"422":{"$ref":"#/components/responses/ValidationError"}}}}},"components":{"securitySchemes":{"ApiKeyHeader":{"type":"apiKey","in":"header","name":"X-Api-Key","description":"API keys start with `mak_`. Endpoints authenticated some other way declare `security: []` and describe what they expect instead."},"ApiKeyBearer":{"type":"http","scheme":"bearer","description":"The same key, sent as `Authorization: Bearer mak_\u2026`. Equivalent to the header form. An OAuth access token (`mao_\u2026`) rides in this header too."},"OAuth2":{"type":"oauth2","description":"Authorization code with PKCE, for software that other MemberAreas\nconnect. Tokens start with `mao_` and travel as\n`Authorization: Bearer mao_\u2026`. One token belongs to one MemberArea,\ncarries the scopes its administrator approved, expires after an hour\nand is refreshable for 60 days. The **OAuth** section walks the flow\nand explains how to get a `client_id`.\n","flows":{"authorizationCode":{"authorizationUrl":"https://app.memberarea.io/oauth/authorize","tokenUrl":"https://app.memberarea.io/oauth/token","refreshUrl":"https://app.memberarea.io/oauth/token","scopes":{"webhooks:manage":"Configure outgoing webhooks","members:read":"Read members + tags + custom-field values","members:write":"Create / update / delete members, tags and field values","members:login":"Issue one-time login links that sign a member in","contacts:read":"Read audience contacts (CRM subscribers without a member login)","contacts:write":"Create / update / delete audience contacts and their tags","roles:read":"Read the available member roles","roles:write":"Assign a role to a member (non-admin ranks only)","fields:read":"Read global fields + their values","fields:write":"Create / update / delete global fields and set their values","groups:read":"Read groups + group membership","groups:write":"Create / update / delete groups and membership","community:read":"Read community areas, forums, posts, comments, badges","community:write":"Create / update / delete community content","datasets:read":"Read dataset rows","datasets:write":"Create / update / delete dataset rows","conversions:write":"Register external affiliate conversions","affiliates:read":"Read an affiliate + their sponsor by referral code","affiliates:write":"Create affiliates, assign / remove affiliate member claims","affiliates:redeem":"Read + redeem a member affiliate reward balance","inbox:read":"Read inbox channels, conversations, messages, tickets","inbox:write":"Send messages, manage conversations and tickets","courses:read":"Read courses, modules, course progress and marketing badges. The course roster additionally needs members:read","courses:write":"Enrol members, mark progress, revoke course access","lessons:read":"Read the lessons of a module with their pages and elements","lessons:write":"Create, edit and delete lessons, pages and elements","events:read":"Read events and their registrations","events:write":"Register members, RSVP and check-in for events","hubs:read":"Read hubs and their metadata","payments:read":"Read products, orders, subscriptions and affiliate commissions","payments:write":"Grant and revoke bundle access for a member","automations:read":"List automations and their run history","automations:trigger":"Trigger an automation run","manychat:manage":"Connect a ManyChat account and store its App Key so flows can be started from this MemberArea","wordpress:manage":"Register a WordPress site and let its visitors sign in as members","wordpress:read":"Read only what a connected website renders: products with prices, courses with their offers, marketing badges, the form list and group names for gating content. No orders, no member data"}}}}},"parameters":{"IdPath":{"in":"path","name":"id","required":true,"schema":{"type":"string","format":"uuid"}},"Search":{"in":"query","name":"search","schema":{"type":"string"},"description":"Case-insensitive partial match across the primary text fields."},"PerPage":{"in":"query","name":"per_page","schema":{"type":"integer","minimum":1,"maximum":100,"default":25}},"Page":{"in":"query","name":"page","schema":{"type":"integer","minimum":1,"default":1}},"Published":{"in":"query","name":"published","schema":{"type":"boolean"},"description":"Restrict to courses that have a published version (`1`) or to drafts (`0`). Omit for both."},"IncludeOffers":{"in":"query","name":"include","schema":{"type":"string","enum":["offers"]},"description":"Pass `offers` to add the purchase options to every course. Needs\n`payments:read` or `wordpress:read` on top of the read scope.\n"}},"responses":{"OAuthUnexpectedError":{"description":"Any status the OAuth endpoint does not list explicitly. These endpoints answer in RFC 6749 shape (`error`, `error_description`), never in this API's envelope, and the browser-facing consent screen answers in HTML.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthError"}},"text/html":{"schema":{"type":"string"}}}},"UnexpectedError":{"description":"Any status this operation does not list explicitly. In practice that is a server fault (500), the maintenance window (503) or a malformed request the router rejected before the endpoint ran (400, 404, 405, 413, 415). Every one of them carries the `error` envelope, so a client can read `error.code` without knowing which case it hit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"NotFound":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Forbidden":{"description":"The API key lacks the scope this endpoint requires. Always carries the `error` envelope; the code is `missing_scope` when the scope guard rejected the call, and the framework's `message` key stands beside the envelope in that case. A few endpoints check the scope themselves and answer with the envelope alone.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"ValidationError":{"description":"Validation failed. Always carries the `error` envelope with code `validation_failed` and the per-field messages under `error.details`. When the framework's validator rejected the call, `message` and `errors` stand beside the envelope; endpoints that validate themselves answer with the envelope alone.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"Unauthorized":{"description":"Missing or invalid API key. Carries the `error` envelope, and since the rejection happens before the endpoint runs, the framework's `message` key stands beside it.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FrameworkError"}}}},"RateLimited":{"description":"Rate limit exceeded for this API key (or per IP before authentication). The tiered per-key limiter enforces a per-minute and a per-day window; the effective limit scales with the plan's api_rate_multiplier. `error.window` says which of the two tripped, and comes from the per-key limiter only; the key-free endpoints meter per IP and answer without it. The four X-RateLimit headers ride on successful responses, not on this one: a 429 carries Retry-After plus the cap and remainder of the window that tripped.","headers":{"Retry-After":{"description":"Seconds to wait before retrying.","schema":{"type":"integer"}},"X-RateLimit-Limit":{"description":"Cap of the window that tripped, already scaled by the plan multiplier.","schema":{"type":"integer"}},"X-RateLimit-Remaining":{"description":"Always 0 on this response.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["rate_limited"]},"message":{"type":"string"},"window":{"type":"string","enum":["minute","day"]}}}}}}}},"PlanLimitReached":{"description":"The business has reached a plan limit for the resource being created. Upgrade the plan to raise the limit.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["plan_limit_reached"]},"message":{"type":"string"},"limit_key":{"type":"string","description":"The plan column that was hit (e.g. limit_members, limit_communities, limit_dataset_rows)."},"limit":{"type":"integer","description":"The configured limit value on the plan."}}}}}}}}},"schemas":{"AffiliateCommission":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"affiliate_id":{"type":"string","format":"uuid"},"affiliate_code":{"type":"string"},"order_id":{"type":["string","null"],"format":"uuid"},"transaction_id":{"type":["string","null"],"format":"uuid"},"level":{"type":"integer"},"status":{"type":"string","enum":["pending","locked","paid","reversed"]},"commission_type":{"type":"string","enum":["percent","fixed"]},"commission_value":{"type":"integer"},"currency":{"type":"string"},"base_amount":{"type":"integer","description":"Commission base in minor units (cents)."},"commission_amount":{"type":"integer","description":"Effective commission in minor units (adjusted when set, else base)."},"is_test":{"type":"boolean"},"locked_at":{"type":["string","null"],"format":"date-time"},"paid_at":{"type":["string","null"],"format":"date-time"},"reversed_at":{"type":["string","null"],"format":"date-time"},"created_at":{"type":"string","format":"date-time"}}},"AffiliateCreate":{"type":"object","description":"Pass either `member_id` or `email`, never both.","properties":{"member_id":{"type":"string","format":"uuid","description":"UUID of the member who becomes the affiliate. Must already be a member of this business."},"email":{"type":"string","format":"email","maxLength":255,"description":"Email of the person who becomes the affiliate. Reuses the member of this business with this email, or creates one."},"first_name":{"type":"string","maxLength":120,"description":"Required when `email` creates a new member."},"last_name":{"type":"string","maxLength":120},"language":{"type":"string","maxLength":8,"description":"Language of the new member, for example de or en."},"code":{"type":"string","minLength":3,"maxLength":50,"pattern":"^[a-zA-Z0-9_-]+$","description":"Referral code to claim. Lower-cased, unique inside the business. Derived from the member's name when omitted."},"parent_code":{"type":"string","maxLength":64,"description":"Referral code of the sponsor this affiliate is placed under."},"is_active":{"type":"boolean","default":true},"send_welcome_mail":{"type":"boolean","default":false,"description":"Queue the affiliate welcome email to the member, carrying their referral and recruiting links, plus a button to set a password when this call created the member."}}},"MemberLoginLinkCreate":{"type":"object","properties":{"to":{"type":"string","maxLength":255,"default":"/dashboard","description":"Path on your MemberArea the member lands on. Must start with a single slash."},"expires_in_minutes":{"type":"integer","minimum":1,"maximum":1440,"default":15}}},"MemberLoginLink":{"type":"object","properties":{"member_id":{"type":"string","format":"uuid"},"url":{"type":"string","format":"uri","description":"Single-use signed login URL. Treat it as a credential."},"target":{"type":"string"},"expires_at":{"type":"string","format":"date-time"}}},"Affiliate":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"code":{"type":"string","description":"The referral code carried by the affiliate's links."},"is_active":{"type":"boolean"},"referral_url":{"type":["string","null"],"format":"uri","description":"Ready-to-share referral link, https://<your-domain>/r/<code>. Null while the business has no domain."},"reward_mode":{"type":"string","enum":["cash","account_credit"]},"member":{"oneOf":[{"$ref":"#/components/schemas/AffiliateMember"},{"type":"null"}]},"sponsor":{"oneOf":[{"$ref":"#/components/schemas/AffiliateSponsor"},{"type":"null"}]},"created_at":{"type":"string","format":"date-time"}}},"AffiliateMember":{"type":"object","description":"The member the affiliate account belongs to.","properties":{"id":{"type":"string","format":"uuid"},"first_name":{"type":"string"},"last_name":{"type":"string"},"email":{"type":"string","format":"email"},"image":{"type":["string","null"]}}},"AffiliateSponsor":{"type":"object","description":"The affiliate one level above in the tree.","properties":{"id":{"type":"string","format":"uuid"},"code":{"type":"string"},"is_active":{"type":"boolean"},"member":{"oneOf":[{"$ref":"#/components/schemas/AffiliateMember"},{"type":"null"}]}}},"Lead":{"type":"object","properties":{"uuid":{"type":"string","format":"uuid"},"status":{"type":["string","null"]},"tags":{"type":"array","items":{"type":"string"}},"is_partial":{"type":"boolean"},"archived_at":{"type":["string","null"],"format":"date-time"},"email_verified":{"type":"boolean"},"phone_verified":{"type":"boolean"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"source":{"type":"object","properties":{"form_uuid":{"type":"string","format":"uuid"},"form_name":{"type":"string"},"page_title":{"type":"string"},"page_slug":{"type":"string"}}}}},"LeadDetail":{"allOf":[{"$ref":"#/components/schemas/Lead"},{"type":"object","properties":{"data":{"type":"object","additionalProperties":true,"description":"Raw submission key/value payload."},"utm":{"type":["object","null"],"additionalProperties":{"type":"string"}}}}]},"HookSubscription":{"type":"object","properties":{"uuid":{"type":"string","format":"uuid"},"filters":{"type":["object","null"],"additionalProperties":true,"description":"Narrows the subscription. Each key is a dot path into the event payload, each value the value or list of values it accepts. The key dataset.id set to a dataset UUID makes a dataset trigger watch one dataset instead of all. Up to 5 entries. On the dataset events only dataset.id, dataset.name, row.id, row.status and row.data.* are accepted, so a typo cannot mute the subscription. Without it every payload of the event is delivered. Send null to clear it; an empty object is refused with the code empty_filters."},"event":{"type":"string","enum":["lead.created","form.submitted","funnel.completed","order.paid","order.payment_pending","order.payment_failed","invoice.paid","refund.created","subscription.created","subscription.renewed","subscription.cancelled","subscription.payment_failed","affiliate.commission.created","affiliate.payout.paid","member.signup","member.login","member.tag_added","member.tag_removed","member.field_changed","course.completed","lesson.completed","event.registered","event.attended","community.post_created","community.level_up","community.badge_earned","page.published","page.unpublished","popup.interacted","dataset.row_created","dataset.row_updated","dataset.row_deleted","inbox.message_received","inbox.ticket_created","contact.created"]},"target_url":{"type":"string","format":"uri"},"is_active":{"type":"boolean"},"last_fired_at":{"type":["string","null"],"format":"date-time"},"fail_count":{"type":"integer"},"created_at":{"type":"string","format":"date-time"}}},"Error":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"details":{"type":"object","additionalProperties":true}}}}},"FrameworkError":{"type":"object","description":"Errors raised before an endpoint runs, or by the validator. They carry\nthe same `error` envelope as every other error, plus the framework's\nown `message` and `errors` keys for clients written before the envelope\nwas universal. Reading `error.code` is enough.\n","properties":{"error":{"type":"object","properties":{"code":{"type":"string","example":"missing_scope"},"message":{"type":"string"},"details":{"type":"object","description":"Only on validation failures: mirrors `errors`.","additionalProperties":{"type":"array","items":{"type":"string"}}}}},"message":{"type":"string","example":"Missing scope: payments:read."},"errors":{"type":"object","description":"Only on validation failures: one array of messages per rejected field.","additionalProperties":{"type":"array","items":{"type":"string"}}}}},"WebhookError":{"type":"object","description":"The automation webhook answers with a bare code string. It is the one\nendpoint on this API whose `error` is a string rather than the envelope,\nbecause senders were built against it before the envelope was universal.\nKnown codes: not_found, invalid_secret, automation_disabled,\nno_published_version, empty_graph.\n","properties":{"error":{"type":"string","example":"invalid_secret","enum":["not_found","invalid_secret","automation_disabled","no_published_version","empty_graph"]}}},"OAuthTokenResponse":{"type":"object","description":"The token endpoint's answer. Both tokens are replaced on every refresh,\nso persist them together.\n","properties":{"access_token":{"type":"string","examples":["mao_\u2026"],"description":"Send as `Authorization: Bearer`."},"token_type":{"type":"string","examples":["bearer"]},"expires_in":{"type":"integer","examples":[3600],"description":"Seconds until the access token expires."},"refresh_token":{"type":"string","examples":["mor_\u2026"],"description":"Valid for 60 days. Single use: each refresh issues a new one."},"scope":{"type":"string","examples":["members:read members:write"],"description":"What was actually granted, space separated."}}},"OAuthError":{"type":"object","description":"The OAuth endpoints answer in RFC 6749 shape, not in this API's\n`{ error: { code, message } }` envelope. Only the endpoints under\n`/oauth` do this; a token used against the API itself gets the normal\nenvelope.\n","properties":{"error":{"type":"string","enum":["invalid_request","invalid_client","invalid_grant","invalid_scope","unauthorized_client","unsupported_grant_type","unsupported_response_type","access_denied"]},"error_description":{"type":"string"}}},"PaginationMeta":{"type":"object","properties":{"page":{"type":"integer"},"per_page":{"type":"integer"},"total":{"type":"integer"},"last_page":{"type":"integer"}}},"Member":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"first_name":{"type":"string"},"last_name":{"type":"string"},"email":{"type":"string","format":"email"},"image":{"type":["string","null"]},"language":{"type":["string","null"]},"status":{"type":["integer","null"],"description":"Membership status within this MemberArea (present in list/membership contexts)."},"last_login_at":{"type":["string","null"],"format":"date-time","description":"When the member last used your MemberArea while signed in, refreshed on every page they open. null if they have never signed in. Filled on the /members endpoints; group and course rosters return null."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},"MemberCreate":{"type":"object","required":["first_name","last_name","email"],"properties":{"first_name":{"type":"string","maxLength":120},"last_name":{"type":"string","maxLength":120},"email":{"type":"string","format":"email"},"language":{"type":"string","maxLength":8}}},"MemberUpdate":{"type":"object","properties":{"first_name":{"type":"string","maxLength":120},"last_name":{"type":"string","maxLength":120},"email":{"type":"string","format":"email"},"language":{"type":["string","null"],"maxLength":8}}},"MembersPage":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Member"}},"meta":{"$ref":"#/c