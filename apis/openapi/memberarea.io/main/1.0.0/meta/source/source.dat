ch is off by default on new API keys.\n\nIdempotent: send a stable `idempotency_key` per conversion. Replays\nreturn the original result with HTTP 200 instead of paying twice.\nAmounts are integers in minor units (cents).\n","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["affiliate_code","amount","currency","idempotency_key"],"properties":{"affiliate_code":{"type":"string","maxLength":100,"description":"Affiliate code that referred the sale."},"amount":{"type":"integer","minimum":1,"maximum":2000000,"description":"Sale total in minor units (cents)."},"tax_amount":{"type":"integer","minimum":0,"description":"VAT/tax portion contained in `amount`, in minor units (cents). Stored for reporting; commissions still run on `amount`."},"currency":{"type":"string","example":"EUR"},"idempotency_key":{"type":"string","minLength":8,"maxLength":100,"description":"Stable unique id of this conversion in your system."},"customer_email":{"type":"string","format":"email","description":"Buyer email. Used for self-referral protection and member matching."},"product_uuid":{"type":"string","format":"uuid","description":"Optional product this conversion belongs to."},"is_test":{"type":"boolean","default":false},"occurred_at":{"type":"string","format":"date-time"},"metadata":{"type":"object","additionalProperties":true}}}}}},"responses":{"default":{"$ref":"#/components/responses/UnexpectedError"},"401":{"$ref":"#/components/responses/Unauthorized"},"429":{"$ref":"#/components/responses/RateLimited"},"201":{"description":"Conversion accepted, commissions created.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/ConversionResult"}}}}}},"200":{"description":"Duplicate idempotency_key. Original result returned.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/ConversionResult"}}}}}},"403":{"description":"API key lacks the co