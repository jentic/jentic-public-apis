 that unlock this course, directly or through a group, with\nthe prices a checkout can be started with. Bundles, hidden products\nand products without an active price are left out.\n","items":{"$ref":"#/components/schemas/CourseOffer"}},"created_at":{"type":["string","null"],"format":"date-time","example":"2026-01-14T09:30:00+00:00"},"updated_at":{"type":["string","null"],"format":"date-time","example":"2026-02-02T16:45:12+00:00"}}},"CourseOffer":{"type":"object","properties":{"product_id":{"type":"string","format":"uuid","example":"4d3c2b1a-9f8e-4d7c-8b6a-5f4e3d2c1b0a"},"name":{"type":"string","example":"Onboarding Masterclass"},"prices":{"type":"array","items":{"$ref":"#/components/schemas/CourseOfferPrice"}}}},"CourseOfferPrice":{"type":"object","description":"`amount` is in the smallest currency unit. Its meaning depends on\n`pricing_model`: for `installment` it is the total, charged in\n`installment_count` rates after `upfront_amount`; for\n`pay_what_you_want` it is the suggested amount and\n`pwyw_minimum_amount` the floor; for `subscription` it is charged every\n`billing_interval_count` \u00d7 `billing_interval`.\n","properties":{"price_id":{"type":"string","format":"uuid","example":"7c6b5a49-3e2d-4c1b-9a8f-7e6d5c4b3a29"},"name":{"type":["string","null"],"example":"Yearly"},"amount":{"type":"integer","example":9900},"currency":{"type":"string","example":"EUR"},"tax_included":{"type":"boolean","example":true},"pricing_model":{"type":"string","enum":["one_time","subscription","installment","pay_what_you_want"],"example":"subscription"},"billing_interval":{"type":["string","null"],"enum":["day","week","month","year",null],"example":"month"},"billing_interval_count":{"type":["integer","null"],"example":3},"trial_days":{"type":["integer","null"],"example":14},"installment_count":{"type":["integer","null"],"example":12},"upfront_amount":{"type":["integer","null"],"example":5000},"pwyw_minimum_amount":{"type":["integer","null"],"example":1000},"is_primary":{"type":"b