"type":"boolean"},"cover":{"default":true,"type":"boolean"},"lyrics":{"default":true,"type":"boolean"},"badges":{"default":true,"type":"boolean"},"headline":{"type":"string","enum":["none","new-release","out-now","coming-soon","listen-now"]},"cover_scale":{"type":"number","minimum":0.75,"maximum":1.25},"text_scale":{"type":"number","minimum":0.85,"maximum":1.3},"artist_scale":{"type":"number","minimum":0.85,"maximum":1.5},"spacing_scale":{"type":"number","minimum":0.75,"maximum":1.5}},"additionalProperties":false},"trim":{"description":"Render only this section of the song (at least 8 seconds)","type":"object","properties":{"start_seconds":{"type":"number","minimum":0},"end_seconds":{"type":"number","exclusiveMinimum":0}},"required":["start_seconds","end_seconds"],"additionalProperties":false},"quote_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"The quote_id from the matching quote: the request must be identical"}},"required":["type","song_id","look","quote_id"]},{"type":"object","title":"Create a Canvas","properties":{"type":{"const":"canvas"},"song_id":{"type":"string","minLength":1,"maxLength":120,"description":"The song id"},"variations":{"default":1,"description":"1–4 different Canvases","type":"integer","minimum":1,"maximum":4},"callback_url":{"description":"An https URL to POST the finished video to (signed; see Callbacks). Quote and create with the same value","type":"string","maxLength":2000},"metadata":{"description":"Your own JSON (an order id, for example): kept with the video and returned in its request. Quote and create with the same value","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"source":{"default":"ai-video","description":"ai-video (default), ai-image, stock-photo or stock-video","type":"string","enum":["ai-video","ai-image","stock-photo","stock-video"]},"quality":{"default":"standard","description":"AI video model tier: standard or high","type":"string","enum":["standard","high"]},"resolution":{"default":"1080p","description":"1080p (1080×1920) or 720p","type":"string","enum":["720p","1080p"]},"style":{"description":"Optional visual style","type":"string","enum":["cinematic","dreamy","abstract","surreal","retro","minimal","dark","vibrant","nature","urban"]},"direction":{"description":"Optional mood, motifs or references; the concept still comes from the cover","type":"string","maxLength":2000},"feature_artist":{"default":"auto","description":"Whether the Canvas shows the artist: auto (the director decides), always or never (AI sources; needs artist photos for \"always\")","type":"string","enum":["auto","always","never"]},"seconds":{"default":8,"description":"Canvas length in whole seconds, 5–8 (default 8). Spotify loops it, so no part of the song is chosen","type":"integer","minimum":5,"maximum":8},"stock_id":{"description":"With a stock source: the Pexels photo or video (search_stock with seconds) to use instead of the director's pick","type":"string","pattern":"^\\d{1,20}$"},"quote_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"The quote_id from the matching quote: the request must be identical"}},"required":["type","song_id","quote_id"]}]}}}},"security":[{"bearer":[]},{"oauth2":["videos:write"]}],"x-operations":[{"id":"videos.create_lyric_video","mcpTool":"create_lyric_video","cli":"kinetune create lyric-video"},{"id":"videos.create_canvas","mcpTool":"create_canvas","cli":"kinetune create canvas"}],"responses":{"200":{"description":"OK"},"201":{"description":"Created"},"400":{"description":"Invalid request"},"401":{"description":"Missing or invalid credentials"},"402":{"description":"Not enough credits"},"403":{"description":"Missing scope"},"404":{"description":"Not found"},"409":{"description":"Conflict"},"422":{"description":"Unprocessable"},"503":{"description":"Temporarily unavailable (AI video): nothing was held; try again after Retry-After seconds"}}},"get":{"operationId":"videos.list","summary":"List videos","description":"Videos, newest first, with status and thumbnails","tags":["videos"],"parameters":[{"name":"song_id","in":"query","required":false,"schema":{"description":"Only this song’s videos","type":"string","minLength":1,"maxLength":120},"description":"Only this song’s videos"},{"name":"type","in":"query","required":false,"schema":{"type":"string","enum":["lyric-video","canvas"]}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":100}}],"security":[{"bearer":[]},{"oauth2":["videos:read"]}],"x-operations":[{"id":"videos.list","mcpTool":"list_videos","cli":"kinetune videos list"}],"responses":{"200":{"description":"OK"},"201":{"description":"Created"},"400":{"description":"Invalid request"},"401":{"description":"Missing or invalid credentials"},"402":{"description":"Not enough credits"},"403":{"description":"Missing scope"},"404":{"description":"Not found"},"409":{"description":"Conflict"},"422":{"description":"Unprocessable"},"503":{"description":"Temporarily unavailable (AI video): nothing was held; try again after Retry-After seconds"}}}},"/api/v1/videos/{video_id}":{"get":{"operationId":"videos.get","summary":"Get a video","description":"Status, progress, credits and, when completed, the download links\n\nstatus is queued, processing, completed, failed or cancelled. Completed videos have outputs with download_url (full quality), web_url (720p) and poster_url, signed for 7 days. Failed videos have error and error_code; AI_VIDEO_UNAVAILABLE means the AI video couldn’t be made for a reason on our side, so make it again later.","tags":["videos"],"parameters":[{"name":"video_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":120,"description":"The video id"},"description":"The video id"}],"security":[{"bearer":[]},{"oauth2":["videos:read"]}],"x-operations":[{"id":"videos.get","mcpTool":"get_video","cli":"kinetune videos get"}],"responses":{"200":{"description":"OK"},"201":{"description":"Created"},"400":{"description":"Invalid request"},"401":{"description":"Missing or invalid credentials"},"402":{"description":"Not enough credits"},"403":{"description":"Missing scope"},"404":{"description":"Not found"},"409":{"description":"Conflict"},"422":{"description":"Unprocessable"},"503":{"description":"Temporarily unavailable (AI video): nothing was held; try again after Retry-After seconds"}}},"delete":{"operationId":"videos.delete","summary":"Delete a video","description":"Delete a finished video and its files","tags":["videos"],"parameters":[{"name":"video_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":120,"description":"The video id"},"description":"The video id"}],"security":[{"bearer":[]},{"oauth2":["videos:write"]}],"x-operations":[{"id":"videos.delete","mcpTool":"delete_video","cli":"kinetune videos delete"}],"responses":{"200":{"description":"OK"},"201":{"description":"Created"},"400":{"description":"Invalid request"},"401":{"description":"Missing or invalid credentials"},"402":{"description":"Not enough credits"},"403":{"description":"Missing scope"},"404":{"description":"Not found"},"409":{"description":"Conflict"},"422":{"description":"Unprocessable"},"503":{"description":"Temporarily unavailable (AI video): nothing was held; try again after Retry-After seconds"}}}},"/api/v1/videos/{video_id}/cancel":{"post":{"operationId":"videos.cancel","summary":"Cancel a video","description":"Stop a queued or processing video (credits released)","tags":["videos"],"parameters":[{"name":"video_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":120,"description":"The video id"},"description":"The video id"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","title":"Cancel a video","properties":{},"required":[]}}}},"security":[{"bearer":[]},{"oauth2":["videos:write"]}],"x-operations":[{"id":"videos.cancel","mcpTool":"cancel_video","cli":"kinetune videos cancel"}],"responses":{"200":{"description":"OK"},"201":{"description":"Created"},"400":{"description":"Invalid request"},"401":{"description":"Missing or invalid credentials"},"402":{"description":"Not enough credits"},"403":{"description":"Missing scope"},"404":{"description":"Not found"},"409":{"description":"Conflict"},"422":{"description":"Unprocessable"},"503":{"description":"Temporarily unavailable (AI video): nothing was held; try again after Retry-After seconds"}}}},"/api/v1/videos/{video_id}/retry":{"post":{"operationId":"videos.retry","summary":"Make a video again","description":"Run a finished, failed or cancelled video again (new charge)\n\nReuses the Look it made, with its background media and loops, so nothing already made is paid for again. A video that failed before its Look was saved is designed afresh.","tags":["videos"],"parameters":[{"name":"video_id","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":120,"description":"The video id"},"description":"The video id"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","title":"Make a video again","properties":{},"required":[]}}}},"security":[{"bearer":[]},{"oauth2":["videos:write"]}],"x-operations":[{"id":"videos.retry","mcpTool":"retry_video","cli":"kinetune videos retry"}],"responses":{"200":{"description":"OK"},"201":{"description":"Created"},"400":{"description":"Invalid request"},"401":{"description":"Missing or invalid credentials"},"402":{"description":"Not enough credits"},"403":{"description":"Missing scope"},"404":{"description":"Not found"},"409":{"description":"Conflict"},"422":{"description":"Unprocessable"},"503":{"description":"Temporarily unavailable (AI video): nothing was held; try again after Retry-After seconds"}}}}}}