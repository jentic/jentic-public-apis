          "count"
        ],
        "title": "TopologyEdge"
      },
      "TopologyGraph": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/TopologyNode"
            },
            "type": "array",
            "title": "Nodes",
            "default": []
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/TopologyEdge"
            },
            "type": "array",
            "title": "Edges",
            "default": []
          }
        },
        "type": "object",
