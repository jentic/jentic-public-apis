            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Neighbors"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "query_address",
          "neighbors",
          "model_version"
        ],
        "title": "SimilarResponse"
      },
      "SimilarResponseSchema": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "chain": {
            "type": "string",
            "title": "Chain"
          },
          "neighbours": {
            "items": {
              "$ref": "#/components/schemas/SimilarNeighbour"
            },
            "type": "array",
            "title": "Neighbours"
          }
        },
        "type": "object",
        "required": [
          "query",
          "chain",
          "neighbours"
        ],
        "title": "SimilarResponseSchema",
        "description": "Shape of `/v1/similar` response — stable across embedding backends."
      },
      "SourceNote": {
        "properties": {
          "block": {
            "type": "string",
            "title": "Block"
          },
