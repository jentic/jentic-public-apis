          }
        },
        "type": "object",
        "required": [
          "address",
          "similarity"
        ],
        "title": "SimilarNeighbour",
        "description": "Single neighbour in the similarity response."
      },
      "SimilarRequest": {
        "properties": {
          "address": {
            "type": "string",
            "title": "Address"
          },
          "k": {
            "type": "integer",
