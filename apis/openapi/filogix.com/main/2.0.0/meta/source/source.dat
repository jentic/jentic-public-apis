{
  "openapi": "3.0.0",
  "info": {
    "title": "Exchange Pro Api",
    "version": "2.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Finastra52/ExchangePROv2/2.0.0"
  },
  "servers": [
    {
      "url": "https://exchange-pro.filogix.com/api/v1",
      "description": "Exchange Pro Api - TEST"
    }
  ],
  "paths": {
    "/applications/{applicationId}/documents": {
      "get": {
        "summary": "Get documents",
        "description": "Calling this endpoint will return the signed url for downloading or accessing multiple documents.",
        "parameters": [
          {
            "name": "applicationId",
            "description": "Application Id for the documents to be fetched.",
            "in": "path",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "systemCode",
            "description": "Parameter to identify the POS",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "docIds",
            "description": "Array of document Ids to be fetched else all the documents will be returned",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/getDocumentsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example": "Deal not found/Unable to fetch Documents"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example": "Unauthorized"
              }
            }
          },
          "204": {
            "description": "No content to return if document is deleted."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Create new documents",
        "description": "Calling this endpoint will return a presigned url for uploading document directly to S3",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "style": "simple",
            "explode": false,
            "description": "This parameter is the application id of the deal.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "systemCode",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "description": "This parameter identifies the POS",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/createDocumentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/createDocumentsResponse"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example": "Agent on deal does not exist / does not have permission"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example": "Unauthorized"
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "delete": {
        "summary": "Delete documents",
        "description": "Calling this endpoint will delete the documents from s3 bucket ",
        "parameters": [
          {
            "name": "applicationId",
            "description": "Application Id for the documents to be fetched.",
            "in": "path",
            "required": true,
            "style": "simple",
            "explode": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "systemCode",
            "description": "Parameter to identify the POS",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "docIds",
            "description": "Array of document Ids to be fetched else all the documents will be returned",
            "in": "query",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example": "DELETED"
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example": "Unable to delete Documents"
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example": "Unauthorized"
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "getDocumentsResponse": {
        "type": "object",
        "description": "Returns an array of metadata for the requested documents.",
        "properties": {
          "url": {
            "type": "string",
            "description": "The presigned url to access document."
          },
          "docId": {
            "type": "integer",
            "description": "The document id from exchange pro"
          },
          "s3Key": {
            "type": "string",
            "description": "The optional document s3 key value used to save the document provided by the POS, else will be saved by the original filename uploaded"
          },
          "docTypeName": {
            "type": "string",
            "description": "Describes the type of the document uploaded"
          },
          "size": {
            "type": "integer",
            "description": "Indicates the size of the file on disk"
          },
          "mimeType": {
            "type": "string",
            "description": "Indicates the file type"
          },
          "documentName": {
            "type": "string",
            "description": "Indicates the file name"
          }
        }
      },
      "createDocumentsRequest": {
        "type": "object",
        "properties": {
          "orgId": {
            "type": "integer",
            "description": "This parameter identifies the Organization (if there are multiple orgs) within a POS"
          },
          "agentOnDeal": {
            "type": "string",
            "description": "This parameter identifies the sender configured in Exchange"
          },
          "uploaderAgent": {
            "type": "string",
            "description": "his parameter identifies the uploader if different from agent on deal else same as agentOnDeal"
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/createDocumentsRequest_documents"
            }
          }
        }
      },
      "createDocumentsResponse": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The presigned url to upload document."
          },
          "docId": {
            "type": "integer",
            "description": "The document id generated in Exchange Pro"
          },
          "s3Key": {
            "type": "string",
            "description": "The document s3 key if sent by the sender"
          },
          "documentName": {
            "type": "string",
            "description": "The name of the document"
          }
        }
      },
      "createDocumentsRequest_documents": {
        "type": "object",
        "properties": {
          "documentName": {
            "type": "string",
            "description": "This is a mandatory field that identifies the file name being uploaded."
          },
          "mimeType": {
            "type": "string",
            "description": "This is a mandatory parameter used to identify the type of the document being uploaded",
            "example": "application/pdf or application/jpg etc"
          },
          "size": {
            "type": "integer",
            "description": "This is a mandatory parameter used to store the size of the document being uploaded"
          },
          "docTypeName": {
            "type": "string",
            "description": "This is an optional parameter to identify the type of the document being uploaded"
          },
          "s3Key": {
            "type": "string",
            "description": "This is a optional client generated name used to save as the document name in s3"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
