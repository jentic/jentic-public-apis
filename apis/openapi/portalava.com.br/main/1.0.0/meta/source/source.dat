{
  "openapi": "3.0.0",
  "info": {
    "title": "IESDE",
    "version": "1.0.0",
    "description": "",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/DANIELPETRIUH/IESDE/1.0.0"
