  "servers": [
    {
      "url": "https://ead.portalava.com.br/web_service"
    }
  ],
  "paths": {
    "/getMatriculas/format/json": {
      "post": {
        "summary": "Retornar Matrículas",
        "parameters": [
          {
            "name": "registros_pagina",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": "10"
          },
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "EAD-API-KEY",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "abc123def456ghi789jkl012mno345pq"
          }
        ],
        "responses": {
          "200": {
            "description": "successfull operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatriculasIESDE"
                }
              }
            }
          }
        }
      }
    },
    "/getDisciplinas/format/json": {
      "post": {
        "summary": "Retornar Disciplinas",
        "parameters": [
          {
            "name": "GradeID",
            "in": "query",
            "required": false,
            "deprecated": false,
            "schema": {},
            "example": "252599"
          },
          {
            "name": "EAD-API-KEY",
            "in": "header",
            "required": false,
            "deprecated": false,
            "schema": {},
            "example": "abc123def456ghi789jkl012mno345pq"
          }
        ],
        "responses": {
          "200": {
            "description": "successfull operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DisciplinasIESDE"
                }
              }
            }
          }
        },
        "security": [
          {
            "DigestAuth": []
          }
        ]
      }
    },
