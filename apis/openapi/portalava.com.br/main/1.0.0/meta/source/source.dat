  "components": {
    "securitySchemes": {
      "DigestAuth": {
        "type": "http",
        "scheme": "digest"
      }
    },
    "schemas": {
      "MatriculasIESDE": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "MatriculaID": {
              "type": "string",
              "example": "1938632"
            },
            "LoginID": {
              "type": "string",
              "example": "750434"
            },
            "Situacao": {
              "type": "string",
              "example": "A",
              "description": "Status da matrícula (A = Ativo)"
            },
            "DtCadastro": {
              "type": "string",
              "format": "date",
              "example": "19/08/2024",
              "description": "Data de cadastro no formato DD/MM/YYYY"
            },
            "ocultar_aluno_rel": {
              "type": "string",
              "example": "",
              "description": "Flag para ocultar aluno em relatórios"
            },
            "CursoID": {
              "type": "string",
              "example": "441643"
            },
            "GradeID": {
              "type": "string",
              "example": "405401"
            },
            "PoloID": {
              "type": "string",
              "example": "4"
            },
            "Curso": {
              "type": "string",
              "example": "ANÁLISE ECONÔMICA DO DIREITO - SANTA CRUZ - 6 MESES"
            },
            "CertificadoraID": {
              "type": "string",
              "example": "33"
            },
            "Aluno": {
              "type": "string",
              "example": "João Silva Santos"
            },
            "CPF": {
              "type": "string",
              "example": "98765432100",
              "description": "CPF sem formatação"
            },
            "Email": {
              "type": "string",
              "format": "email",
              "example": "joao.silva@exemplo.com"
            },
            "SituacaoDescricao": {
              "type": "string",
              "example": "MATRICULADO",
              "description": "Descrição da situação da matrícula"
            },
            "Sexo": {
              "type": "string",
              "example": ""
            },
            "DtInicio": {
              "type": "string",
              "format": "date",
              "example": "19/08/2024",
              "description": "Data de início no formato DD/MM/YYYY"
            },
            "DtFim": {
              "type": "string",
              "format": "date",
              "example": "19/02/2025",
              "description": "Data de término no formato DD/MM/YYYY"
            }
          }
        }
      },
      "DisciplinasIESDE": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "DisciplinaID": {
              "type": "string",
              "example": "103101"
            },
            "GradeID": {
              "type": "string",
              "example": "438607"
            },
            "CursoID": {
              "type": "string",
              "example": "472690"
            },
            "computed": {
              "type": "string",
              "example": "MODELAGEM DE BANCO DE DADOS E SQL",
              "description": "Nome computado da disciplina"
            },
            "Sigla": {
              "type": "string",
              "example": "",
              "description": "Sigla da disciplina"
            },
            "ModuloID": {
              "type": "string",
              "example": "1"
            },
            "Modulo": {
              "type": "string",
              "example": "MODELAGEM DE BANCO DE DADOS E SQL",
              "description": "Nome do módulo"
            },
            "Ordem": {
              "type": "string",
              "example": "1",
              "description": "Ordem da disciplina no curso"
            },
            "Situacao": {
              "type": "string",
              "example": "A",
              "description": "Situação da disciplina (A = Ativo)"
            },
            "CargaHoraria": {
              "type": "string",
              "example": "60",
              "description": "Carga horária em horas"
            },
            "Ementa": {
              "type": "string",
              "example": "Conceitos de modelagem de banco de dados. Sistemas gerenciadores de banco de dados. Modelagem de dados relacional. Linguagem SQL. Consultas SQL. Operadores de SQL. Implementação de sistemas. Conceitos avançados de bancos de dados.",
              "description": "Ementa da disciplina"
            },
            "PlanoAula": {
              "type": "string",
              "example": "1. <span>Conceitos gerais de modelagem de banco de dados</span><br>\n2. <span>Modelo relacional</span><br>\n3. <span>Linguagem SQL-DDL</span><br>",
              "description": "Plano de aula em formato HTML"
            },
            "DtCad": {
              "type": "string",
              "format": "date",
              "example": "31/07/2025",
              "description": "Data de cadastro no formato DD/MM/YYYY"
            },
            "Bibliografia": {
              "type": "string",
              "example": "<div class=\"wysiwyg-text-align-justify\">AMADEU, C. Banco de dados. São Paulo: Pearson Education do Brasil, 2014.</div>",
              "description": "Bibliografia da disciplina em formato HTML"
            }
          }
        }
      },
      "BancoQuestoesDisciplinasIESDE": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "QuestaoID": {
              "type": "string",
              "example": "84058"
            },
            "FormatoQuestaoID": {
              "type": "string",
              "example": "1",
              "description": "ID do formato da questão"
            },
            "FormatoQuestao": {
              "type": "string",
              "example": "Objetiva",
              "description": "Tipo/formato da questão"
            },
            "DisciplinaID": {
              "type": "string",
              "example": "103101"
            },
            "Enunciado": {
              "type": "string",
              "example": "<span>Analise as seguintes proposições e, depois, assinale a alternativa correta.<br><br>I. A tarefa de se modelar o banco de dados deve ser feita considerando três níveis de abstração...</span>",
              "description": "Enunciado da questão em formato HTML"
            },
            "Peso": {
              "type": "string",
              "example": "1",
              "description": "Peso da questão na avaliação"
            },
            "QtdQuestoes": {
              "type": "string",
              "example": "5",
              "description": "Quantidade de questões no conjunto"
            },
            "Anulada": {
              "type": "string",
              "example": "N",
              "description": "Indica se a questão foi anulada (S/N)"
            },
            "Situacao": {
              "type": "string",
              "example": "A",
              "description": "Situação da questão (A = Ativo)"
            },
            "AulaID": {
              "type": "string",
              "example": "386374"
            },
            "Justificativa": {
              "type": "string",
              "example": "<div class=\"wysiwyg-text-align-justify\">Apenas as proposições I e II estão corretas...</div>",
              "description": "Justificativa/gabarito da questão em formato HTML"
            }
          }
        }
      },
      "AlternativasQuestoesIESDE": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "AlternativaID": {
              "type": "string",
              "example": "9999",
              "description": "ID da alternativa"
            },
            "Texto": {
              "type": "string",
              "example": "texto da alternativa",
              "description": "texto referente a alternativa da questão"
            },
            "Correta": {
              "type": "string",
              "description": "alternativa correta"
            },
            "QuestaoID": {
              "type": "string",
              "example": "9999",
              "description": "Id da Questão"
            },
            "Order": {
              "type": "string",
              "example": "9999",
              "description": "Order da alternativa"
            }
          }
        }
      },
      "CursosIESDE": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "CursoID": {
              "type": "string",
              "example": "109721"
            },
            "Situacao": {
              "type": "string",
              "example": "A",
              "description": "Situação do curso (A = Ativo)"
            },
            "Nome": {
              "type": "string",
              "example": "INTERPRETAÇÃO DE TEXTOS - SANTA CRUZ - 6 MESES",
              "description": "Nome completo do curso"
            },
            "DescricaoCertificado": {
              "type": "string",
              "example": "INTERPRETAÇÃO DE TEXTOS",
              "description": "Descrição que aparecerá no certificado"
            },
            "DuracaoMeses": {
              "type": "string",
              "example": "6",
              "description": "Duração do curso em meses"
            },
            "MaterialDidatico": {
              "type": "string",
              "example": "N",
              "description": "Indica se possui material didático (S/N)"
            },
            "ImprimirTermo": {
              "type": "string",
              "example": "N",
              "description": "Permite impressão de termo (S/N)"
            },
            "GerarKitMatricula": {
              "type": "string",
              "example": "N",
              "description": "Gera kit de matrícula (S/N)"
            },
            "ImprimirTermoOnline": {
              "type": "string",
              "example": "N",
              "description": "Permite impressão de termo online (S/N)"
            },
            "ImprimirBoleto": {
              "type": "string",
              "example": "N",
              "description": "Permite impressão de boleto (S/N)"
            },
            "ImprimirGenerico": {
              "type": "string",
              "example": "N",
              "description": "Permite impressão genérica (S/N)"
            },
            "CampanhaComercial": {
              "type": "string",
              "example": "N",
              "description": "Vinculado a campanha comercial (S/N)"
            },
            "CategoriaID": {
              "type": "string",
              "example": "4"
            },
            "Categoria": {
              "type": "string",
              "example": "PED - PROGRAMA DE ESPECIALIZAÇÃO DOCENTE",
              "description": "Nome da categoria do curso"
            },
            "ProjCategoriaID": {
              "type": "string",
              "example": "4"
            },
            "ProjCategoria": {
              "type": "string",
              "example": "PÓS-GRADUAÇÃO",
              "description": "Categoria do projeto pedagógico"
            },
            "ProjSubCategoriaID": {
              "type": "string",
              "example": "5"
            },
            "ProjSubCategoria": {
              "type": "string",
              "example": "EDUCAÇÃO",
              "description": "Subcategoria do projeto pedagógico"
            },
            "DtCad": {
              "type": "string",
              "format": "date",
              "example": "21/02/2017",
              "description": "Data de cadastro no formato DD/MM/YYYY"
            },
            "QtdGradesAtivas": {
              "type": "string",
              "example": "0",
              "description": "Quantidade de grades curriculares ativas"
            }
          }
        }
      },
      "PDFDisciplinaIESDE": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "DisciplinaID": {
              "type": "integer",
              "example": 103101
            },
            "LivroDisciplinaID": {
              "type": "integer",
              "example": 40498
            },
            "Descricao": {
              "type": "string",
              "example": "Livro: Modelagem de Banco de Dados e SQ",
              "description": "Descrição do livro da disciplina"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "DigestAuth": []
    }
  ]
}
