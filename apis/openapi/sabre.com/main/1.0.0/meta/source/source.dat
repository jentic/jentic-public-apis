              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/lists/supported/shop/flights/compressedlookup": {
      "get": {
        "operationId": "getCompressedLookup",
        "summary": "Get compressed data lookup tables",
