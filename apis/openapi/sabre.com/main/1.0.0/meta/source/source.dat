{
  "openapi": "3.0.3",
  "info": {
    "title": "Sabre Travel API",
    "description": "Sabre Travel API provides access to Sabre's Global Distribution System (GDS) for air shopping, booking, hotel search and reservation, destination services, and utility operations. This spec covers the core REST API endpoints available through the Sabre Dev Studio.",
    "version": "1.0.0",
    "contact": {
      "name": "Sabre Dev Studio",
      "url": "https://developer.sabre.com/"
    },
    "x-jentic-source-url": "https://developer.sabre.com/"
  },
  "servers": [
    {
      "url": "https://api.havail.sabre.com",
      "description": "Sabre Production (certification) server"
    }
  ],
  "security": [
    {
      "oauth2": []
    }
  ],
  "tags": [
    {
      "name": "Air Shopping",
      "description": "Flight search, availability, pricing, and seat map endpoints"
    },
    {
      "name": "Air Booking",
      "description": "Create, read, modify, and cancel passenger name records (PNRs) and ticketing"
    },
    {
      "name": "Hotel",
      "description": "Hotel search, availability, rates, and booking endpoints"
    },
    {
      "name": "Destination",
      "description": "Location, airport, city, and geography lookup services"
    },
    {
      "name": "Utility",
      "description": "Authentication, health, and operational utility endpoints"
    }
  ],
  "paths": {
    "/v2/auth/token": {
      "post": {
        "operationId": "createAuthToken",
        "summary": "Generate OAuth 2.0 access token",
        "description": "Generates an OAuth 2.0 access token using client credentials grant. The token is required for all subsequent API calls.",
        "tags": ["Utility"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["grant_type"],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": ["client_credentials"],
                    "description": "OAuth 2.0 grant type"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid grant type or missing parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid client credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/shop/flights": {
      "post": {
        "operationId": "searchFlights",
        "summary": "Search for flight offers (Bargain Finder Max)",
        "description": "Searches for available flight itineraries and fares using the Bargain Finder Max engine. Supports one-way, round-trip, and multi-city searches with advanced filtering options.",
        "tags": ["Air Shopping"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BargainFinderMaxRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flight search results returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BargainFinderMaxResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v2/shop/flights/fares": {
      "post": {
        "operationId": "searchFlightFares",
        "summary": "Search for lowest available fares",
        "description": "Returns the lowest available fares for given origin-destination pairs across a range of dates.",
        "tags": ["Air Shopping"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadPriceCalendarRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fare search results returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadPriceCalendarResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/shop/flights/tags": {
      "post": {
        "operationId": "getFlightTags",
        "summary": "Get tagged flight groupings",
        "description": "Returns flight itineraries organized by tags such as cheapest, shortest, best value, and earliest/latest departure.",
        "tags": ["Air Shopping"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstaFlightsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tagged flight results returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstaFlightsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v4/offers/shop": {
      "post": {
        "operationId": "shopOffers",
        "summary": "Shop for air offers (NDC)",
        "description": "Searches for air offers using the NDC-based offers and orders model. Returns structured offer bundles with pricing and ancillaries.",
        "tags": ["Air Shopping"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferShopRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Offers returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferShopResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/shop/altdates/flights": {
      "post": {
        "operationId": "searchAlternateDateFlights",
        "summary": "Search flights across alternate dates",
        "description": "Returns flight availability and pricing across a flexible range of dates around the requested travel dates.",
        "tags": ["Air Shopping"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlternateDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Alternate date results returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlternateDateResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v3/shop/flights/revalidate": {
      "post": {
        "operationId": "revalidateFlightItinerary",
        "summary": "Revalidate a specific flight itinerary",
        "description": "Revalidates a previously retrieved itinerary to confirm current availability and pricing before booking.",
        "tags": ["Air Shopping"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevalidateItineraryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Revalidation result returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RevalidateItineraryResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v4/shop/flights/seatmaps": {
      "post": {
        "operationId": "getSeatMap",
        "summary": "Get seat map for a flight",
        "description": "Returns the seat map layout for a specific flight segment including seat availability, characteristics, and pricing.",
        "tags": ["Air Shopping"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SeatMapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Seat map returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SeatMapResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/lists/utilities/airlines": {
      "get": {
        "operationId": "getAirlines",
        "summary": "Get airline information",
        "description": "Returns airline details including name, IATA code, and ICAO code for all airlines or a specific airline.",
        "tags": ["Air Shopping"],
        "parameters": [
          {
            "name": "airlinecode",
            "in": "query",
            "description": "IATA airline code to filter results",
            "schema": {
              "type": "string",
              "example": "AA"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Airline information returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AirlineListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/lists/utilities/aircraft/equipment": {
      "get": {
        "operationId": "getAircraftEquipment",
        "summary": "Get aircraft equipment types",
        "description": "Returns aircraft equipment information including IATA equipment codes and descriptions.",
        "tags": ["Air Shopping"],
        "parameters": [
          {
            "name": "aircraftcode",
            "in": "query",
            "description": "IATA aircraft equipment code",
            "schema": {
              "type": "string",
              "example": "738"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Aircraft equipment information returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AircraftEquipmentResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v2/passenger/records": {
      "post": {
        "operationId": "createBooking",
        "summary": "Create a passenger name record (PNR)",
        "description": "Creates a new booking (PNR) with passenger details, flight segments, contact information, and optional ancillaries. This is the primary booking creation endpoint.",
        "tags": ["Air Booking"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePassengerRecordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PNR created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatePassengerRecordResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v2/passenger/records/{recordLocator}": {
      "get": {
        "operationId": "getBooking",
        "summary": "Retrieve a booking (PNR)",
        "description": "Retrieves a passenger name record by its record locator (confirmation number). Returns full PNR details including passengers, segments, tickets, and remarks.",
        "tags": ["Air Booking"],
        "parameters": [
          {
            "name": "recordLocator",
            "in": "path",
            "required": true,
            "description": "The six-character PNR record locator",
            "schema": {
              "type": "string",
              "example": "ABCDEF"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PNR retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPassengerRecordResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "PNR not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v2/passenger/records/{recordLocator}/cancel": {
      "post": {
        "operationId": "cancelBooking",
        "summary": "Cancel a booking (PNR)",
        "description": "Cancels a passenger name record and its associated segments. Supports full or partial cancellation.",
        "tags": ["Air Booking"],
        "parameters": [
          {
            "name": "recordLocator",
            "in": "path",
            "required": true,
            "description": "The six-character PNR record locator",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelBookingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PNR cancelled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelBookingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/trip/orders/createBooking": {
      "post": {
        "operationId": "createTripBooking",
        "summary": "Create a trip booking (enhanced workflow)",
        "description": "Creates a booking using the enhanced Create Booking workflow which combines air sell, passenger data, and end transaction in a single call.",
        "tags": ["Air Booking"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTripBookingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trip booking created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTripBookingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/trip/orders/getBooking": {
      "post": {
        "operationId": "getTripBooking",
        "summary": "Get trip booking details",
        "description": "Retrieves complete booking details using the enhanced Get Booking service including full itinerary, pricing, and ancillary information.",
        "tags": ["Air Booking"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetTripBookingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trip booking details returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTripBookingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/trip/orders/cancelBooking": {
      "post": {
        "operationId": "cancelTripBooking",
        "summary": "Cancel a trip booking",
        "description": "Cancels a booking using the enhanced Cancel Booking service. Supports segment-level cancellation.",
        "tags": ["Air Booking"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelTripBookingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking cancelled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelTripBookingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/air/ticket": {
      "post": {
        "operationId": "issueAirTicket",
        "summary": "Issue an air ticket",
        "description": "Issues electronic tickets for a confirmed PNR. Supports various ticketing options including future dated ticketing and ticket modifiers.",
        "tags": ["Air Booking"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AirTicketRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket issued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AirTicketResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/air/ticket/void": {
      "post": {
        "operationId": "voidAirTicket",
        "summary": "Void an air ticket",
        "description": "Voids a previously issued electronic ticket. The ticket must be voided within the void window, typically the same day of issuance.",
        "tags": ["Air Booking"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoidTicketRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket voided successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoidTicketResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v4/orders/create": {
      "post": {
        "operationId": "createOrder",
        "summary": "Create an order (NDC)",
        "description": "Creates an order from a previously shopped and priced offer using the NDC Offers and Orders model.",
        "tags": ["Air Booking"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOrderResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v4/orders/{orderId}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Get an order (NDC)",
        "description": "Retrieves the details of an existing NDC order by its order ID.",
        "tags": ["Air Booking"],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "The unique order identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order details returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrderResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v4/orders/{orderId}/cancel": {
      "post": {
        "operationId": "cancelOrder",
        "summary": "Cancel an order (NDC)",
        "description": "Cancels an existing NDC order and its associated offer items.",
        "tags": ["Air Booking"],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "description": "The unique order identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order cancelled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelOrderResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v2/shop/hotels": {
      "post": {
        "operationId": "searchHotels",
        "summary": "Search for hotels",
        "description": "Searches for hotels by location, dates, and guest count. Returns available properties with rates and descriptions.",
        "tags": ["Hotel"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HotelSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hotel search results returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotelSearchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v2/shop/hotels/availability": {
      "post": {
        "operationId": "getHotelAvailability",
        "summary": "Get hotel availability and rates",
        "description": "Returns detailed room availability, rate plans, and pricing for specific hotels and dates.",
        "tags": ["Hotel"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HotelAvailabilityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Hotel availability returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HotelAvailabilityResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
