      }
    },
    "/v1/lists/supported/shop/flights/destinations": {
      "get": {
        "operationId": "getSupportedDestinations",
        "summary": "Get supported flight destinations",
        "description": "Returns the list of origin-destination pairs supported by the InstaFlights and lead price calendar APIs.",
        "tags": ["Utility"],
        "parameters": [
          {
            "name": "origin",
            "in": "query",
            "description": "Origin airport code",
            "schema": {
              "type": "string",
              "example": "DFW"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "description": "Destination airport code",
            "schema": {
              "type": "string",
              "example": "LAX"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Supported destinations returned successfully",
