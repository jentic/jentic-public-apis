                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/lists/utilities/geoservices/countries": {
      "get": {
        "operationId": "getCountries",
        "summary": "Get country information",
        "description": "Returns country details including country code, name, and associated currencies.",
        "tags": ["Destination"],
        "parameters": [
          {
