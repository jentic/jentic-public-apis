                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/lists/utilities/geoservices/currencies": {
      "get": {
        "operationId": "getCurrencies",
        "summary": "Get currency information",
        "description": "Returns currency details including ISO currency code, name, and decimal places.",
        "tags": ["Utility"],
        "parameters": [
          {
            "name": "currencycode",
            "in": "query",
            "description": "ISO 4217 currency code",
            "schema": {
              "type": "string",
              "example": "USD"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Currency information returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrencyListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/lists/utilities/airlines/alliances": {
      "get": {
        "operationId": "getAirlineAlliances",
        "summary": "Get airline alliance information",
        "description": "Returns information about airline alliances and their member airlines.",
        "tags": ["Utility"],
        "responses": {
          "200": {
            "description": "Airline alliance information returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllianceListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/shop/flights/cheapest/fares/{destination}": {
      "get": {
        "operationId": "getCheapestFares",
        "summary": "Get cheapest fares to a destination",
        "description": "Returns the cheapest available fares from multiple origins to a specific destination city or airport.",
        "tags": ["Air Shopping"],
        "parameters": [
          {
            "name": "destination",
            "in": "path",
            "required": true,
            "description": "Destination airport or city IATA code",
            "schema": {
              "type": "string",
              "example": "LAX"
            }
          },
          {
            "name": "departuredate",
            "in": "query",
            "description": "Departure date in YYYY-MM-DD format",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "returndate",
            "in": "query",
            "description": "Return date in YYYY-MM-DD format",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "origin",
            "in": "query",
            "description": "Origin airport or city IATA code",
            "schema": {
              "type": "string",
              "example": "DFW"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cheapest fares returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheapestFaresResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v2/shop/flights/schedules": {
      "post": {
        "operationId": "getFlightSchedules",
        "summary": "Get flight schedules",
        "description": "Returns published flight schedules for given origin-destination pairs and dates, without pricing or availability.",
        "tags": ["Air Shopping"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FlightScheduleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Flight schedules returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlightScheduleResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.havail.sabre.com/v2/auth/token",
            "scopes": {}
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request - invalid or missing parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - invalid or expired access token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Error status",
            "example": "NotProcessed"
          },
          "type": {
            "type": "string",
            "description": "Error type"
          },
          "errorCode": {
            "type": "string",
            "description": "Specific error code"
          },
          "timeStamp": {
            "type": "string",
            "description": "Timestamp of the error"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "The OAuth 2.0 access token"
          },
          "token_type": {
            "type": "string",
            "description": "Token type, typically bearer",
            "example": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "description": "Token lifetime in seconds",
            "example": 604800
          }
        }
      },
      "BargainFinderMaxRequest": {
        "type": "object",
        "description": "Bargain Finder Max flight search request",
        "properties": {
          "OTA_AirLowFareSearchRQ": {
            "type": "object",
            "properties": {
              "Version": {
                "type": "string",
                "example": "5"
              },
              "POS": {
                "$ref": "#/components/schemas/PointOfSale"
              },
              "OriginDestinationInformation": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OriginDestinationInfo"
                }
              },
              "TravelPreferences": {
                "type": "object",
                "properties": {
                  "CabinPref": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "Cabin": {
                          "type": "string",
                          "enum": ["Y", "S", "C", "J", "F", "P"],
                          "description": "Cabin class preference (Y=Economy, S=PremiumEconomy, C/J=Business, F/P=First)"
                        },
                        "PreferLevel": {
                          "type": "string",
                          "enum": ["Preferred", "Only"]
                        }
                      }
                    }
                  },
                  "MaxStopsQuantity": {
                    "type": "integer",
                    "description": "Maximum number of stops"
                  }
                }
              },
              "TravelerInfoSummary": {
                "type": "object",
                "properties": {
                  "AirTravelerAvail": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "PassengerTypeQuantity": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "Code": {
                                "type": "string",
                                "description": "Passenger type code (ADT, CNN, INF, etc.)",
                                "example": "ADT"
                              },
                              "Quantity": {
                                "type": "integer",
                                "description": "Number of passengers of this type",
                                "example": 1
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "BargainFinderMaxResponse": {
        "type": "object",
        "description": "Bargain Finder Max flight search response",
        "properties": {
          "OTA_AirLowFareSearchRS": {
            "type": "object",
            "properties": {
              "PricedItineraries": {
                "type": "object",
                "properties": {
                  "PricedItinerary": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/PricedItinerary"
                    }
                  }
                }
              },
              "Statistics": {
                "type": "object",
                "properties": {
                  "Itinerary": {
                    "type": "object",
                    "properties": {
                      "Count": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "OriginDestinationInfo": {
        "type": "object",
        "properties": {
          "RPH": {
            "type": "string",
            "description": "Reference place holder for segment ordering"
          },
          "DepartureDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Departure date and time"
          },
          "OriginLocation": {
            "type": "object",
            "properties": {
              "LocationCode": {
                "type": "string",
                "description": "IATA airport or city code",
                "example": "DFW"
              }
            }
          },
          "DestinationLocation": {
            "type": "object",
            "properties": {
              "LocationCode": {
                "type": "string",
                "description": "IATA airport or city code",
                "example": "LHR"
              }
            }
          }
        }
      },
      "PricedItinerary": {
        "type": "object",
        "properties": {
          "SequenceNumber": {
            "type": "integer"
          },
          "AirItinerary": {
            "type": "object",
            "properties": {
              "OriginDestinationOptions": {
                "type": "object",
                "properties": {
                  "OriginDestinationOption": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "FlightSegment": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/FlightSegment"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "AirItineraryPricingInfo": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ItinTotalFare": {
                  "$ref": "#/components/schemas/Fare"
                },
                "FareInfos": {
                  "type": "object",
                  "properties": {
                    "FareInfo": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "FareReference": {
                            "type": "string"
                          },
                          "TPA_Extensions": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "FlightSegment": {
        "type": "object",
        "properties": {
          "DepartureAirport": {
            "type": "object",
            "properties": {
              "LocationCode": {
                "type": "string"
              }
            }
          },
          "ArrivalAirport": {
            "type": "object",
            "properties": {
              "LocationCode": {
                "type": "string"
              }
            }
          },
          "DepartureDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "ArrivalDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "FlightNumber": {
