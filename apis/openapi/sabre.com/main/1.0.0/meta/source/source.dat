          }
        }
      }
    },
    "/v1/lists/utilities/geosearch/locations": {
      "get": {
        "operationId": "searchLocations",
        "summary": "Search for locations by keyword",
        "description": "Searches for airports, cities, and multi-airport cities by keyword. Returns matching locations with codes and coordinates.",
        "tags": ["Destination"],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Search keyword (city name, airport name, or code)",
            "schema": {
              "type": "string",
              "example": "London"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Filter by location category",
            "schema": {
              "type": "string",
              "enum": ["AIR", "RAIL", "ALL"]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results to return",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Location search results returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationSearchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v2/shop/cars": {
      "post": {
        "operationId": "searchCars",
