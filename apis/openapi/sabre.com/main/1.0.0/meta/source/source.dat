    "/v1/lists/utilities/geoservices/airports": {
      "get": {
        "operationId": "getAirports",
        "summary": "Get airport information",
        "description": "Returns airport details by IATA code or by searching within a country. Includes coordinates, city, and country information.",
        "tags": ["Destination"],
        "parameters": [
          {
            "name": "airportcode",
            "in": "query",
            "description": "IATA airport code",
            "schema": {
              "type": "string",
              "example": "DFW"
            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "Two-letter country code to filter airports",
            "schema": {
              "type": "string",
              "example": "US"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Airport information returned successfully",
