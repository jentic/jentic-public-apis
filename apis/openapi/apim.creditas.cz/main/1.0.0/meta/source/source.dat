          "400": {
            "description": "Bad request",
            "headers": {
              "Content-Type": {
                "description": "Defines MIME media type of the response. For example application/json or application/xml in case of bulk payment initiation.\n",
                "required": true,
                "schema": {
                  "title": "contentType",
                  "description": "Defines MIME media type of the resource. For example application/json or application/x-www-form-urlencoded (OAuth2 /auth resources) and application/xml in case of bulk payment initiation.\n",
                  "type": "string",
                  "maxLength": 50,
                  "example": "application/json"
                }
              },
              "X-Request-ID": {
                "description": "Unique identifier for each request specified by TPP returned in response header.\n",
                "required": true,
                "schema": {
                  "title": "xRequestId",
                  "description": "Unique identifier for each request specified by TPP. It is recommended to use a UUID format with a length of 36 to 60 characters.\n",
                  "type": "string",
                  "maxLength": 60,
                  "example": "f713da2b-6908-4c3f-9461-784f74b86710"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "title": "error400_getAccountsTransactions",
                  "description": "This is an invalid query that cannot be answered. E.g., if JSON content is not valid for this resource.\n",
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "title": "error_DT01_400",
                            "description": "[InvalidDate] Invalid date.\n",
                            "type": "object",
                            "required": [
                              "error"
                            ],
                            "properties": {
                              "error": {
                                "type": "string",
                                "example": "DT01"
                              },
                              "parameters": {
                                "title": "errorParameters",
                                "description": "The field of additional elements specific for the given error code. These parameters are always specified in the description of a specific error code.\n",
                                "type": "object",
                                "example": {
                                  "AMOUNT_ENTERED": 10000,
                                  "CURRENCY": "EUR",
                                  "LIMIT": 500
                                }
                              },
                              "scope": {
                                "title": "scope",
                                "description": "It determines the JSON path of the request element that caused the error status.\n",
                                "type": "string",
                                "example": "account.amount.currency"
                              },
                              "message": {
                                "title": "errorMessage",
                                "description": "Optional text description. It is not intended for interpretation to the end user but, for example, to enrich the error log.\n",
                                "type": "string",
                                "example": "Requested amount is too large"
                              }
                            },
                            "example": [
                              {
                                "error": "DT01",
                                "scope": "fromDate",
                                "parameters": null,
                                "message": "The date will be in the future."
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                },
                "example": {
                  "errors": [
                    {
                      "error": "AC09",
                      "scope": "currency"
                    }
                  ]
                }
              }
            }
          },
