                  "description": "Unique identifier for each request specified by TPP. It is recommended to use a UUID format with a length of 36 to 60 characters.\n",
                  "type": "string",
                  "maxLength": 60,
                  "example": "f713da2b-6908-4c3f-9461-784f74b86710"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "headers": {
              "X-Request-ID": {
                "description": "Unique identifier for each request specified by TPP returned in response header.\n",
                "required": true,
                "schema": {
                  "title": "xRequestId",
                  "description": "Unique identifier for each request specified by TPP. It is recommended to use a UUID format with a length of 36 to 60 characters.\n",
                  "type": "string",
                  "maxLength": 60,
                  "example": "f713da2b-6908-4c3f-9461-784f74b86710"
                }
              }
            }
          }
        }
      }
    },
    "/v1/my/accounts/{accountId}/transactions": {
      "get": {
        "summary": "Overview of transactions",
        "description": "Paged list of transactions of a selected client account.\n\n**Resource characteristics:**\n  * **Authorization:**  request requires the authorization of user/client as part of API calling\n  * **Use certificate:**  request requires the use of the qualified third-party certificate\n",
        "operationId": "getAccountsTransactions",
        "tags": [
          "Account information"
        ],
        "security": [
          {
            "OAuth2": [
              "AISP",
              "aisp.transactions"
            ],
            "ClientCert": []
          }
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "description": "API payment account identifier from the response to a query on the list of accounts.\n",
            "required": true,
            "schema": {
              "title": "accountId",
              "description": "API Payment account identifier.\n",
              "type": "string",
              "example": "D2C8C1DCC51A3738538A40A4863CA288E0225E52"
            }
          },
          {
            "name": "Content-Type",
            "description": "Defines MIME media type of the resource. For example application/json or application/x-www-form-urlencoded (OAuth2 /auth resources) and application/xml in case of bulk payment initiation.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "application/json"
            }
          },
          {
            "name": "X-Request-ID",
            "description": "Unique identifier for each request specified by TPP. It is recommended to use a UUID format with a length of 36 to 60 characters.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "55d4fffc-2634-44d4-9f2b-3aa94fbd51a4"
            }
          },
          {
            "name": "Date",
            "description": "Each request of a transaction contains the date and time at which the message was originated. In timestamp format.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "Wed, 6 Jan 2019 07:21:01 GMT"
            }
          },
          {
            "name": "User-Involved",
            "description": "The flag identifies if the end user is online and the request was made based on his activity.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "boolean",
              "example": true
            }
          },
          {
            "name": "TPP-Name",
            "description": "The name of the original TPP that created the request. Eg. \"Star corporation, a.s.™\".\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Star corporation, a.s.™"
            }
          },
          {
            "name": "Authorization",
            "description": "Contains the credentials to authenticate a user agent with a server. Element is defined in RFC 6750 In the case of this specification as Bearer Token Usage.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer AbCdEf123456"
            }
          },
          {
            "name": "X-Certificate",
            "description": "The public TPP certificate used for signing the request, In base64 encoding (with the \"BEGIN CERTIFICATE\" and \"END CERTIFICATE\" markers).\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "MIIDdzCCAl+gAwIBAgIEUz1a..."
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "description": "Date and time of the start of required transaction history.\n",
            "required": false,
            "schema": {
              "title": "fromDate",
              "description": "Date and time of the start of required transaction history.\n",
              "type": "string",
              "example": "2018-12-02"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "description": "Date and time of the end of required transaction history [inclusive].\n",
            "required": false,
            "schema": {
              "title": "toDate",
              "description": "Date and time of the end of required transaction history [inclusive].\n",
              "type": "string",
              "example": "2018-12-15"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "description": "Required account currency for multi-currency accounts.\n",
            "required": false,
            "schema": {
              "title": "currencyCode",
              "description": "Defined account currency.\n\nCurrency code according to ISO 4217 = 3 capital letters.\n",
              "type": "string",
              "maxLength": 3,
              "pattern": "[A-Z]{3}",
              "example": "CZK"
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "It defines the required number of records on the page. If the parameter is not specified, the API returns the entire set.\n",
            "required": false,
            "schema": {
              "title": "pageSizeParam",
              "description": "It defines the required number of records on the page. If the parameter is not specified, the API returns the entire set.\n",
              "type": "integer",
              "example": 25
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "It defines the required page number. Pages are numbered from 0. If the parameter is not specified, the API returns the first (zero) page.\n",
            "required": false,
            "schema": {
              "title": "pageParam",
              "description": "It defines the required page number. Pages are numbered from 0. If the parameter is not specified, the API returns the first (zero) page.\n",
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "It defines a list of fields for sorting. The individual fields in the list are separated by a comma\n",
            "required": false,
            "schema": {
              "title": "sortParam",
              "description": "It defines a list of fields for sorting. The individual fields in the list are separated by a comma\n",
              "type": "string",
              "example": "iban"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "A list of arrangement methods (ASC, DESC) separated by comma. The order corresponds to the order of fields in the sort parameter.\n",
            "required": false,
            "schema": {
              "title": "orderParam",
              "description": "A list of arrangement methods (ASC, DESC) separated by comma. The order corresponds to the order of fields in the sort parameter.\n",
              "type": "string",
              "example": "ASC"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Content-Type": {
                "description": "Defines MIME media type of the response. For example application/json or application/xml in case of bulk payment initiation.\n",
                "required": true,
                "schema": {
                  "title": "contentType",
                  "description": "Defines MIME media type of the resource. For example application/json or application/x-www-form-urlencoded (OAuth2 /auth resources) and application/xml in case of bulk payment initiation.\n",
                  "type": "string",
                  "maxLength": 50,
                  "example": "application/json"
                }
              },
              "X-Request-ID": {
                "description": "Unique identifier for each request specified by TPP returned in response header.\n",
                "required": true,
                "schema": {
                  "title": "xRequestId",
                  "description": "Unique identifier for each request specified by TPP. It is recommended to use a UUID format with a length of 36 to 60 characters.\n",
                  "type": "string",
                  "maxLength": 60,
                  "example": "f713da2b-6908-4c3f-9461-784f74b86710"
                }
              },
              "Signature": {
                "description": "If the ASPSP signs the response, it contains a digital signature.\n",
                "required": false,
                "schema": {
                  "title": "signatureHeader",
                  "description": "If the TPP signs the request, it contains a digital signature.\n",
                  "type": "string",
                  "example": "ACDE666345014BB46003B0706277D9F0A407CC6815DE7F550CF83310F1A82D9C"
                }
              },
              "Digest": {
                "description": "When the ASPS in response includes a signature he also must include a \"Digest\" header as defined in [RFC3230].\n",
                "required": false,
                "schema": {
                  "title": "digestHeader",
                  "description": "When an TPP  includes a signature he also must include a \"Digest\" header as defined in [RFC3230].\n",
                  "type": "string",
                  "example": "F6A5CBE090AE0506D5EB1D0D38370FE8EC55591545F234B5B09F8832AF434CCA"
                }
              },
              "ASPSP-Signature-Certificate": {
                "description": "The public ASPSP certificate used for signing the request, In base64 encoding.\n",
                "required": false,
                "schema": {
                  "title": "aspspSignatureCertificate",
                  "description": "The public ASPSP certificate used for signing the request, In base64 encoding.\n",
                  "type": "string",
                  "example": "4710C3600CB14042ADE6EBA7194C2A2C01F6C2EEADF7894AF212797C53BB84D0..."
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "title": "getAccountsTransactions",
                  "description": "Response message list of client payment accounts transactions",
                  "type": "object",
                  "required": [
                    "pageNumber",
                    "pageCount",
                    "pageSize",
                    "transactions"
                  ],
                  "properties": {
                    "pageNumber": {
                      "title": "pageNumber",
                      "description": "Number of current page.\n",
                      "type": "integer",
                      "example": 1
                    },
                    "pageCount": {
                      "title": "pageCount",
                      "description": "Total number of query pages\n",
                      "type": "integer",
                      "example": 12
                    },
                    "nextPage": {
                      "title": "nextPage",
                      "description": "The number of the next page. If the current page is at the same time the last page of the list, then this parameter is not listed or is given with a null value.\n",
                      "type": "integer",
                      "example": 2
                    },
                    "pageSize": {
                      "title": "pageSize",
                      "description": "Number of entries per page. This parameter can match the required size value from the query, except for the cases when it is the last page, or when the requested page range exceeded the maximum limit defined for the particular API resource.\n",
                      "type": "integer",
                      "example": 25
                    },
                    "totalCount": {
                      "title": "totalCount",
                      "description": "Optional data about the total number of entries for all pages. If this value cannot be precisely determined, it is not stated.\n",
                      "type": "integer",
                      "example": 298
                    },
                    "transactions": {
                      "title": "transactionsList",
                      "description": "Set of transactions on clints account\n",
                      "type": "array",
                      "items": {
                        "title": "transactionInfo",
                        "description": "Tranasction info.\n",
                        "type": "object",
                        "required": [
                          "amount",
                          "creditDebitIndicator",
                          "status",
                          "bookingDate",
                          "valueDate",
                          "bankTransactionCode"
                        ],
                        "properties": {
                          "entryReference": {
                            "title": "entryReference",
                            "description": "Identification no. of the payment assigned by the bank.\n",
                            "maxLength": 35,
                            "type": "string"
                          },
                          "amount": {
                            "title": "balanceAmount",
                            "description": "Value/amount of account balance according to balance type. The currency corresponds to the currency of the account to which the balance information is generated.\n",
                            "type": "object",
                            "required": [
                              "value",
                              "currency"
                            ],
                            "properties": {
                              "value": {
                                "title": "value",
                                "description": "Amount value",
                                "type": "number",
                                "example": 10000
                              },
                              "currency": {
                                "title": "currencyCode",
                                "description": "Defined account currency.\n\nCurrency code according to ISO 4217 = 3 capital letters.\n",
                                "type": "string",
                                "maxLength": 3,
                                "pattern": "[A-Z]{3}",
                                "example": "CZK"
                              }
                            }
                          },
                          "creditDebitIndicator": {
                            "title": "creditDebitIndicator",
                            "description": "Indication of whether the balance in the account for which the balance information is generated.\n\nThe indication of whether this is a debit or credit payment is marked with one of the following codes:\n\n  - DBIT To the debit of\n  - CRDT In other cases\n",
                            "type": "string",
                            "enum": [
                              "DBIT",
                              "CRDT"
                            ],
                            "example": "DBIT"
                          },
                          "reversalIndicator": {
                            "title": "reversalIndicator",
                            "description": "Indication of whether it is a cancellation. An expression of whether it is a cancellation or not is marked with one of the codes below:\n\n  - **true:** It is cancellation\n  - **false:** It is not cancellation\n",
                            "type": "boolean",
                            "example": false
                          },
                          "status": {
                            "title": "transactionStatus",
                            "description": "Item status (debited or credited payments) of the account from the point of view of the bank. The statement will present only posted items, with the constant BOOK, or blocked items, with the constant PDNG.\n",
                            "type": "string",
                            "enum": [
                              "BOOK",
                              "PDNG"
                            ],
                            "example": "BOOK"
                          },
                          "bookingDate": {
                            "title": "bookingDate",
                            "description": "Date of processing/posting of payment by bank in the format ISODate, or ISODateTime, i.e. YYYY-MM-DD, or YYYY-MM-DDThh:mm:ss.sTZD.\n",
                            "type": "object",
                            "properties": {
                              "date": {
                                "description": "Date of processing/posting of payment by bank in the format ISODate, or ISODateTime, i.e. YYYY-MM-DD, or YYYY-MM-DDThh:mm:ss.sTZD, depending on the transaction type and method how the bank presents data (and time) of payment processing/posting. Mainly for card or cash transactions it is posted as ISODateTime.\n\nwhere:\n  - **YYYY** = four-digit year\n  - **MM**   = two-digit month (01=January, etc.)\n  - **DD**   = two-digit day of month (01 through 31)\n  - **hh**   = two digits of hour (00 through 23) (am/pm NOT allowed)\n  - **mm**   = two digits of minute (00 through 59)\n  - **ss**   = two digits of second (00 through 59)\n  - **TZD**  = time zone designator (Z or +hh:mm or -hh:mm)\n",
                                "type": "string",
                                "format": "date-time",
                                "example": "2025-01-31T00:00:00.000+01"
                              }
                            }
                          },
                          "valueDate": {
                            "title": "valueDate",
                            "description": "Due date/payment foreign currency in the format ISODate, or ISODateTime, i.e. YYYY-MM-DD, or YYYY-MM-DDThh:mm:ss.sTZD.\n",
                            "type": "object",
                            "properties": {
                              "date": {
                                "description": "Due date/payment foreign currency in the format ISODate, , or ISODateTime, i.e. YYYY-MM-DD, or YYYY-MM-DDThh:mm:ss.sTZD, depending on the transaction type and method how the bank presents data (and time) of due date/ payment foreign currency. Mainly for card or cash transactions it is posted as ISODateTime.\n\nwhere:\n  - **YYYY** = four-digit year\n  - **MM**   = two-digit month (01=January, etc.)\n  - **DD**   = two-digit day of month (01 through 31)\n  - **hh**   = two digits of hour (00 through 23) (am/pm NOT allowed)\n  - **mm**   = two digits of minute (00 through 59)\n  - **ss**   = two digits of second (00 through 59)\n  - **TZD**  = time zone designator (Z or +hh:mm or -hh:mm)\n",
                                "type": "string",
                                "format": "date-time",
                                "example": "2025-01-31T00:10:00.000+01"
                              }
                            }
                          },
                          "holdExpiration": {
                            "title": "holdExpiration",
                            "description": "Date when card transaction hold expire in the format ISODate. The element will present only in status code with the constant PDNG.\n",
                            "type": "object",
                            "properties": {
                              "date": {
                                "description": "The date when a card transaction hold will be expire.\n\nFormat YYYY-MM-DD.\n",
                                "type": "string",
                                "format": "date-time",
                                "example": "2023-02-03T02:55:16.000+01"
                              }
                            }
                          },
                          "bankTransactionCode": {
                            "title": "bankTransactionCode",
                            "description": "The code of banking transaction according to the code list of the Czech Banking Association assigned to a specific payment. Each bank uses an own code list to identify payments, which is, however, based on the 1st to 3rd level of transaction code list according to the CBA Standard for camt.053.\n",
                            "type": "object",
                            "properties": {
                              "proprietary": {
                                "title": "bankTransactionCodeProprietary",
                                "description": "The code of banking transaction according to the code list of the Czech Banking Association assigned to a specific payment. Each bank uses an own code list to identify payments, which is, however, based on the 1st to 3rd level of transaction code list according to the CBA Standard for camt.053.\n",
                                "type": "object",
                                "properties": {
                                  "code": {
                                    "title": "bankTransactionCodeCode",
                                    "description": "The code of banking transaction according to the code list of the Czech Banking Association assigned to a specific payment. Each bank uses an own code list to identify payments, which is, however, based on the 1st to 3rd level of transaction code list according to the CBA Standard for camt.053.\n",
                                    "maxLength": 35,
                                    "type": "string",
                                    "enum": [
                                      10000101000,
                                      10000102000,
                                      10000103000,
                                      10000104000,
                                      10000105000,
                                      10000106000,
                                      10000107000,
                                      10000201000,
                                      10000202000,
                                      10000301000,
                                      10000401000,
                                      10000402000,
                                      10000403000,
                                      10000501000,
                                      10000502000,
                                      10000503000,
                                      10000504000,
                                      20000101000,
                                      20000102000,
                                      20000103000,
                                      20000104000,
                                      20000201000,
                                      20000202000,
                                      20000203000,
                                      20000301000,
                                      20000302000,
                                      30000101000,
                                      30000102000,
                                      30000103000,
                                      30000201000,
                                      30000202000,
                                      30000203000,
                                      30000301000,
                                      40000101000,
                                      40000102000,
                                      40000103000,
                                      40000104000,
                                      40000201000,
                                      40000202000,
                                      40000203000,
                                      40000301000,
                                      40000302000,
                                      40000303000,
                                      40000304000,
                                      40000401000,
                                      40000402000,
                                      40000403000,
                                      40000501000,
                                      40000502000,
                                      40000503000,
                                      40000601000,
                                      40000602000,
                                      40000603000,
                                      40000604000,
                                      40000605000,
                                      50000201001,
                                      50000201002,
                                      50000201003,
                                      50000201004,
                                      50000201005,
                                      50000201006,
                                      50000201007,
                                      50000202001,
                                      50000202002,
                                      50000202003,
                                      50000202004,
                                      50000202005,
                                      50000202006,
                                      50000202007,
                                      90000101000,
                                      90000201000,
                                      90000301000,
                                      90000401000,
                                      90000501000,
                                      90000601000,
                                      90000701000
                                    ],
                                    "example": "40000501000"
                                  },
                                  "issuer": {
                                    "title": "bankTransactionCodeIssuer",
                                    "description": "Identification of the code list issuer for banking transactions which acquires the value of the CBA.\n",
                                    "maxLength": 35,
                                    "type": "string",
                                    "enum": [
                                      "CBA"
                                    ],
                                    "example": "CBA"
                                  }
                                }
                              }
                            }
                          },
                          "entryDetails": {
                            "title": "entryDetails",
                            "description": "Turnover details. The level repeats only for the given item.\n",
                            "type": "object",
                            "properties": {
                              "transactionDetails": {
                                "title": "transactionDetails",
                                "description": "Payment details. The level repeats only for the given item.\n",
                                "type": "object",
                                "properties": {
                                  "references": {
                                    "title": "transactionReferences",
                                    "description": "Payment details. The level repeats only for the given item.\n",
                                    "type": "object",
                                    "properties": {
                                      "messageIdentification": {
                                        "title": "messageIdentification",
                                        "description": "Assumed payment identification entered by the client on its initiation or order of the payment in the payment history.\n",
                                        "maxLength": 35,
                                        "type": "string"
                                      },
                                      "paymentId": {
                                        "title": "paymentId",
                                        "description": "Id of initiated payment. The identifier of the payment from the PISP service\n",
                                        "maxLength": 255,
                                        "type": "string"
                                      },
                                      "accountServicerReference": {
                                        "title": "accountServicerReference",
                                        "description": "A banking reference assigned to the payment, e.g., on initiation through direct banking services.\n",
                                        "maxLength": 35,
                                        "type": "string"
                                      },
                                      "paymentInformationIdentification": {
                                        "title": "paymentInformationIdentification",
                                        "description": "Another/next banking reference assigned to the payment assigned by the bank, for card payments, the card sequence number may be entered, or the specific symbol may be entered here.\n",
                                        "maxLength": 35,
                                        "type": "string"
                                      },
                                      "instructionIdentification": {
                                        "title": "instructionIdentification",
                                        "description": "Payment identification entered by a third party, or a constant symbol may be entered.\n",
                                        "maxLength": 35,
                                        "type": "string"
                                      },
                                      "endToEndIdentification": {
                                        "title": "endToEndIdentification",
                                        "description": "A unique identifier specified by the client initiating the payment that serves for unambiguous payment identification and is passed in the unchanged state throughout the payment chain, or, there may be a variable symbol filled in here.\n",
                                        "maxLength": 35,
                                        "type": "string"
                                      },
                                      "chequeNumber": {
                                        "title": "chequeNumber",
                                        "description": "For cheque transactions there may be a cheque number; for card transactions there may be a card number with asterisks. The card no. is each time in the format xxxxxxxxxxxx1234 where according to the standard, only 0-9 may be used (8-28 char.) i.e. without illustrative xxxx.\n",
                                        "maxLength": 35,
                                        "type": "string"
                                      },
                                      "clearingSystemReference": {
                                        "title": "clearingSystemReference",
                                        "description": "A bank-defined code list value identifying the type of payment or payment type used. For card transactions, card association identification may be indicated.\n",
                                        "maxLength": 35,
                                        "type": "string"
                                      },
                                      "mandateIdentification": {
                                        "title": "mandateIdentification",
                                        "description": "For SEPA collections, Unique Mandate Reference stated for the given SEPA collection, as a mandatory field [1..1].\n",
                                        "maxLength": 35,
                                        "type": "string"
                                      }
                                    }
                                  }
                                }
                              },
                              "amountDetails": {
                                "title": "amountDetails",
                                "description": "Details of the payment amount, especially if it is a conversion payment or cashback.\n",
                                "type": "object",
                                "properties": {
                                  "instructedAmount": {
                                    "title": "instructedAmount",
                                    "description": "Amount and currency of payment in the currency that was required by the client for transfer. E.g., for intra-bank payments, the payer account currency and the payment currency if the client required the payment in the payer account currency.\n",
                                    "type": "object",
                                    "properties": {
                                      "amount": {
                                        "description": "The original amount and currency of payment that was required by the client for transfer.\n",
                                        "type": "object",
                                        "properties": {
                                          "value": {
                                            "title": "value",
                                            "description": "Amount value",
                                            "type": "number",
                                            "example": 10000
                                          },
                                          "currency": {
                                            "title": "currencyCode",
                                            "description": "Defined account currency.\n\nCurrency code according to ISO 4217 = 3 capital letters.\n",
                                            "type": "string",
                                            "maxLength": 3,
                                            "pattern": "[A-Z]{3}",
                                            "example": "CZK"
                                          }
                                        }
                                      }
                                    }
                                  },
                                  "transactionAmount": {
                                    "title": "transactionAmount",
                                    "description": "The amount and currency of payment for cumulated payments and Cashback.\n",
                                    "type": "object",
                                    "properties": {
                                      "amount": {
                                        "description": "The amount and currency of payment for cumulated payments and Cashback, where the total amount of payment including the part for Cashback is entered here.\n",
                                        "type": "object",
                                        "properties": {
                                          "value": {
                                            "title": "value",
                                            "description": "Amount value",
                                            "type": "number",
                                            "example": 10000
                                          },
                                          "currency": {
                                            "title": "currencyCode",
                                            "description": "Defined account currency.\n\nCurrency code according to ISO 4217 = 3 capital letters.\n",
                                            "type": "string",
                                            "maxLength": 3,
                                            "pattern": "[A-Z]{3}",
                                            "example": "CZK"
                                          }
                                        }
                                      }
                                    }
                                  },
                                  "counterValueAmount": {
                                    "title": "counterValueAmount",
                                    "description": "The amount and currency of payment in the client account currency after conversion of amount that was required by the client for transfer.\n",
                                    "type": "object",
                                    "properties": {
                                      "amount": {
                                        "description": "The final amount and payment currency that was required by the client for transfer.\n",
                                        "type": "object",
                                        "properties": {
                                          "value": {
                                            "title": "value",
                                            "description": "Amount value",
                                            "type": "number",
                                            "example": 10000
                                          },
                                          "currency": {
                                            "title": "currencyCode",
                                            "description": "Defined account currency.\n\nCurrency code according to ISO 4217 = 3 capital letters.\n",
                                            "type": "string",
                                            "maxLength": 3,
                                            "pattern": "[A-Z]{3}",
                                            "example": "CZK"
                                          }
                                        }
                                      },
                                      "currencyExchange": {
                                        "description": "Information on currencies and exchange rates used.\n",
                                        "type": "object",
                                        "properties": {
                                          "sourceCurrency": {
                                            "title": "sourceCurrency",
                                            "description": "Client account currency (source/original currency/payer account currency for intrabank conversion payments).\n",
                                            "type": "string",
                                            "maxLength": 3,
                                            "pattern": "[A-Z]{3}",
                                            "example": "EUR"
                                          },
                                          "targetCurrency": {
                                            "title": "targetCurrency",
                                            "description": "Payment currency (End/target currency/payee account currency for intrabank conversion payments).\n",
                                            "type": "string",
                                            "maxLength": 3,
                                            "pattern": "[A-Z]{3}",
                                            "example": "CZK"
                                          },
                                          "exchangeRate": {
                                            "title": "exchangeRate",
                                            "description": "The exchange rate used to charge a payment. Only one rate is filled in, even in the case of cross conversion.\n",
                                            "type": "number",
                                            "example": 25.89
                                          }
                                        }
                                      }
                                    }
                                  },
                                  "proprietaryAmount": {
                                    "title": "proprietaryAmount",
                                    "description": "Amount of cash withdrawal through the Cashback service.\n",
                                    "type": "object",
                                    "properties": {
                                      "type": {
                                        "description": "The constant \"CASHBACK\" is to be filled in.\n",
                                        "type": "string",
                                        "example": "CASHBACK"
                                      },
                                      "amount": {
                                        "description": "Cashback amount and currency â€“ only the part of total payment, to which the cash amount withdrawn falls within the Cashback service.\n",
                                        "type": "object",
                                        "properties": {
                                          "value": {
                                            "title": "value",
                                            "description": "Amount value",
                                            "type": "number",
                                            "example": 10000
