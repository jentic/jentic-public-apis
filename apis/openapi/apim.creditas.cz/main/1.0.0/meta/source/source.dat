          {
            "name": "X-Certificate",
            "description": "The public TPP certificate used for signing the request, In base64 encoding (with the \"BEGIN CERTIFICATE\" and \"END CERTIFICATE\" markers).\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "MIIDdzCCAl+gAwIBAgIEUz1a..."
            }
          },
          {
            "name": "currency",
            "description": "Required account currency for multi-currency accounts.\n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "CZK"
            }
          }
        ],
