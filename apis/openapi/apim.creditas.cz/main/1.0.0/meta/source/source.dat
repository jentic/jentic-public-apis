{
  "openapi": "3.0.1",
  "info": {
    "title": "Creditas PSD2 Accounts API",
    "version": "1.0.0",
    "description": "",
    "contact": {
      "email": "apim@creditas.cz"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/creditas-92a/creditas-psd2-accounts-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://apim.creditas.cz/psd2api/",
      "description": "An openbanking server"
    }
  ],
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "description": "This API uses OAuth 2 with the implicit grant flow.\n",
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth2/authorize",
            "tokenUrl": "/oauth2/token",
            "scopes": {
              "AISP": "Access to all services within AISP",
              "aisp.accounts": "Access to an overview of accounts",
              "aisp.balances": "Access to information about balances",
              "aisp.transactions": "Access to the overview of transactions",
              "PISP": "Access to all services within PIS",
              "pisp.payments": "Option to initiate payment"
            }
          }
        }
      },
      "ClientCert": {
        "description": "Use of an x509 client certificate within mutual TLS\n",
        "type": "http",
        "scheme": "mutualTLS"
      }
    }
  },
  "paths": {
    "/v1/my/accounts": {
      "get": {
        "summary": "List of client payment accounts",
        "description": "Paged list of client accounts. Each account contains a unique id usable for URI referencing, e.g. for the account detail.\n",
        "operationId": "getAllAccounts",
        "tags": [
          "Account information"
        ],
        "security": [
          {
            "OAuth2": [
              "AISP",
              "aisp.accounts"
            ],
            "ClientCert": []
          }
        ],
        "parameters": [
          {
            "name": "Content-Type",
            "description": "Defines MIME media type of the resource. For example application/json or application/x-www-form-urlencoded (OAuth2 /auth resources) and application/xml in case of bulk payment initiation.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "application/json"
            }
          },
          {
            "name": "X-Request-ID",
            "description": "Unique identifier for each request specified by TPP. It is recommended to use a UUID format with a length of 36 to 60 characters.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "55d4fffc-2634-44d4-9f2b-3aa94fbd51a4"
            }
          },
          {
            "name": "Date",
            "description": "Each request of a transaction contains the date and time at which the message was originated. In timestamp format.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "Wed, 6 Jan 2019 07:21:01 GMT"
            }
          },
          {
            "name": "User-Involved",
            "description": "The flag identifies if the end user is online and the request was made based on his activity.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "boolean",
              "example": true
            }
          },
          {
            "name": "TPP-Name",
            "description": "The name of the original TPP that created the request. Eg. \"Star corporation, a.s.™\".\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Star corporation, a.s.™"
            }
          },
          {
            "name": "Authorization",
            "description": "Contains the credentials to authenticate a user agent with a server. Element is defined in RFC 6750 In the case of this specification as Bearer Token Usage.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "Bearer AbCdEf123456"
            }
          },
          {
            "name": "X-Certificate",
            "description": "The public TPP certificate used for signing the request, In base64 encoding (with the \"BEGIN CERTIFICATE\" and \"END CERTIFICATE\" markers).\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "MIIDdzCCAl+gAwIBAgIEUz1a..."
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "It defines the required number of records on the page. If the parameter is not specified, the API returns the entire set (max 100).\n",
            "required": false,
            "schema": {
              "title": "pageSizeParam",
              "description": "It defines the required number of records on the page. If the parameter is not specified, the API returns the entire set.\n",
              "type": "integer",
              "example": 25
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "It defines the required page number. Pages are numbered from 0. If the parameter is not specified, the API returns the first (zero) page.\n",
            "required": false,
            "schema": {
              "title": "pageParam",
              "description": "It defines the required page number. Pages are numbered from 0. If the parameter is not specified, the API returns the first (zero) page.\n",
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "It defines a list of fields for sorting. The individual fields in the list are separated by a comma\n",
            "required": false,
            "schema": {
              "title": "sortParam",
              "description": "It defines a list of fields for sorting. The individual fields in the list are separated by a comma\n",
              "type": "string",
              "example": "currency"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "A list of arrangement methods (ASC, DESC) separated by comma. The order corresponds to the order of fields in the sort parameter.\n",
            "required": false,
            "schema": {
              "title": "orderParam",
              "description": "A list of arrangement methods (ASC, DESC) separated by comma. The order corresponds to the order of fields in the sort parameter.\n",
              "type": "string",
              "example": "ASC"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Content-Type": {
                "description": "Defines MIME media type of the response. For example application/json or application/xml in case of bulk payment initiation.\n",
                "required": true,
                "schema": {
                  "title": "contentType",
                  "description": "Defines MIME media type of the resource. For example application/json or application/x-www-form-urlencoded (OAuth2 /auth resources) and application/xml in case of bulk payment initiation.\n",
                  "type": "string",
                  "maxLength": 50,
                  "example": "application/json"
                }
              },
              "X-Request-ID": {
                "description": "Unique identifier for each request specified by TPP returned in response header.\n",
                "required": true,
                "schema": {
                  "title": "xRequestId",
                  "description": "Unique identifier for each request specified by TPP. It is recommended to use a UUID format with a length of 36 to 60 characters.\n",
                  "type": "string",
                  "maxLength": 60,
                  "example": "f713da2b-6908-4c3f-9461-784f74b86710"
                }
              },
              "Signature": {
                "description": "If the ASPSP signs the response, it contains a digital signature.\n",
                "required": false,
                "schema": {
                  "title": "signatureHeader",
                  "description": "If the TPP signs the request, it contains a digital signature.\n",
                  "type": "string",
                  "example": "ACDE666345014BB46003B0706277D9F0A407CC6815DE7F550CF83310F1A82D9C"
                }
              },
              "Digest": {
                "description": "When the ASPS in response includes a signature he also must include a \"Digest\" header as defined in [RFC3230].\n",
                "required": false,
                "schema": {
                  "title": "digestHeader",
                  "description": "When an TPP  includes a signature he also must include a \"Digest\" header as defined in [RFC3230].\n",
                  "type": "string",
                  "example": "F6A5CBE090AE0506D5EB1D0D38370FE8EC55591545F234B5B09F8832AF434CCA"
                }
              },
              "ASPSP-Signature-Certificate": {
                "description": "The public ASPSP certificate used for signing the request, In base64 encoding.\n",
                "required": false,
                "schema": {
                  "title": "aspspSignatureCertificate",
                  "description": "The public ASPSP certificate used for signing the request, In base64 encoding.\n",
                  "type": "string",
                  "example": "4710C3600CB14042ADE6EBA7194C2A2C01F6C2EEADF7894AF212797C53BB84D0..."
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "title": "getAllAccounts",
                  "description": "Response message list of client payment accounts",
                  "type": "object",
                  "required": [
                    "pageNumber",
                    "pageCount",
                    "pageSize",
                    "accounts"
                  ],
                  "properties": {
                    "pageNumber": {
                      "title": "pageNumber",
                      "description": "Number of current page.\n",
                      "type": "integer",
                      "example": 1
                    },
                    "pageCount": {
                      "title": "pageCount",
                      "description": "Total number of query pages\n",
                      "type": "integer",
                      "example": 12
                    },
                    "nextPage": {
                      "title": "nextPage",
                      "description": "The number of the next page. If the current page is at the same time the last page of the list, then this parameter is not listed or is given with a null value.\n",
                      "type": "integer",
                      "example": 2
                    },
                    "pageSize": {
                      "title": "pageSize",
                      "description": "Number of entries per page. This parameter can match the required size value from the query, except for the cases when it is the last page, or when the requested page range exceeded the maximum limit defined for the particular API resource.\n",
                      "type": "integer",
                      "example": 25
                    },
                    "totalCount": {
                      "title": "totalCount",
                      "description": "Optional data about the total number of entries for all pages. If this value cannot be precisely determined, it is not stated.\n",
                      "type": "integer",
                      "example": 298
                    },
                    "accounts": {
                      "title": "accountsList",
                      "description": "Set of client accounts\n",
                      "type": "array",
                      "items": {
                        "title": "accountInfo",
                        "description": "Info about client account",
                        "type": "object",
                        "required": [
                          "id",
                          "identification",
                          "servicer"
                        ],
                        "properties": {
                          "id": {
                            "title": "accountId",
                            "description": "API Payment account identifier.\n",
                            "type": "string",
                            "example": "D2C8C1DCC51A3738538A40A4863CA288E0225E52"
                          },
                          "identification": {
                            "title": "identification",
                            "description": "Account identifier\n",
                            "type": "object",
                            "required": [
                              "iban"
                            ],
                            "properties": {
                              "iban": {
                                "title": "iban",
                                "description": "International Bank Account Number (IBAN)",
                                "type": "string",
                                "maxLength": 34,
                                "pattern": "[A-Z]{2,2}[0-9]{2,2}[a-zA-Z0-9]{1,30}",
                                "example": "CZ6822500000000104174013"
                              },
                              "other": {
                                "title": "other",
                                "description": "Another payer account identifier, e.g. the account number.",
                                "type": "string",
                                "maxLength": 35,
                                "example": "22500000000104174013"
                              }
                            }
                          },
                          "currency": {
                            "title": "currencyCode",
                            "description": "Defined account currency.\n\nCurrency code according to ISO 4217 = 3 capital letters.\n",
                            "type": "string",
                            "maxLength": 3,
                            "pattern": "[A-Z]{3}",
                            "example": "CZK"
                          },
                          "servicer": {
                            "title": "servicer",
                            "description": "Account servicer (bank)",
                            "type": "object",
                            "properties": {
                              "bankCode": {
                                "title": "bankCode",
                                "description": "Country Bank Code, provided when BIC is not specified.",
                                "type": "string",
                                "maxLength": 20,
                                "example": 2250
                              },
                              "countryCode": {
                                "title": "countryCode",
                                "description": "ISO 3166-1 alpha-2 country code of the bank.\n",
                                "type": "string",
                                "maxLength": 2,
                                "example": "CZ"
                              },
                              "bic": {
                                "title": "bicCode",
                                "description": "BIC code of bank managing PSU account\n",
                                "type": "string",
                                "pattern": "[A-Z]{6,6}[A-Z2-9][A-NP-Z0-9]([A-Z0-9]{3,3}){0,1}",
                                "example": "CTASCZ22"
                              }
                            }
                          },
                          "nameI18N": {
                            "title": "nameI18N",
                            "description": "Account name\n",
                            "type": "string",
                            "example": ""
                          },
                          "productI18N": {
                            "title": "productI18N",
                            "description": "Product name\n",
                            "type": "string",
                            "example": ""
                          },
                          "realtionship": {
                            "title": "relationship",
                            "description": "Account realtionship with user\n",
                            "type": "object",
                            "required": [
                              "isOwner"
                            ],
                            "properties": {
                              "isOwner": {
                                "title": "isOwner",
                                "description": "True/false if the authenticated person is/is not the owner (payer) of the account",
                                "type": "boolean",
                                "example": true
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "headers": {
              "Content-Type": {
                "description": "Defines MIME media type of the response. For example application/json or application/xml in case of bulk payment initiation.\n",
                "required": true,
                "schema": {
                  "title": "contentType",
                  "description": "Defines MIME media type of the resource. For example application/json or application/x-www-form-urlencoded (OAuth2 /auth resources) and application/xml in case of bulk payment initiation.\n",
                  "type": "string",
                  "maxLength": 50,
                  "example": "application/json"
                }
              },
              "X-Request-ID": {
                "description": "Unique identifier for each request specified by TPP returned in response header.\n",
                "required": true,
                "schema": {
                  "title": "xRequestId",
                  "description": "Unique identifier for each request specified by TPP. It is recommended to use a UUID format with a length of 36 to 60 characters.\n",
                  "type": "string",
                  "maxLength": 60,
                  "example": "f713da2b-6908-4c3f-9461-784f74b86710"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "title": "error400_getAllAccounts",
                  "description": "This is an invalid query that cannot be answered. E.g., if JSON content is not valid for this resource.\n",
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "title": "error_PARAMETER_INVALID_400",
                            "description": "The value of the parameter is not valid\n",
                            "type": "object",
                            "required": [
                              "error"
                            ],
                            "properties": {
                              "error": {
                                "type": "string",
                                "example": "PARAMETER_INVALID"
                              },
                              "parameters": {
                                "title": "errorParameters",
                                "description": "The field of additional elements specific for the given error code. These parameters are always specified in the description of a specific error code.\n",
                                "type": "object",
                                "example": {
                                  "AMOUNT_ENTERED": 10000,
                                  "CURRENCY": "EUR",
                                  "LIMIT": 500
                                }
                              },
                              "scope": {
                                "title": "scope",
                                "description": "It determines the JSON path of the request element that caused the error status.\n",
                                "type": "string",
                                "example": "account.amount.currency"
                              },
                              "message": {
                                "title": "errorMessage",
                                "description": "Optional text description. It is not intended for interpretation to the end user but, for example, to enrich the error log.\n",
                                "type": "string",
                                "example": "Requested amount is too large"
                              }
                            },
                            "example": [
                              {
                                "error": "PARAMETER_INVALID",
                                "scope": "page",
                                "parameters": null,
                                "message": null
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                },
                "example": {
                  "errors": [
                    {
                      "error": "PAGE_NOT_FOUND"
                    },
                    {
                      "error": "PARAMETER_INVALID",
                      "scope": "sort"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorised",
            "headers": {
              "Content-Type": {
                "description": "Defines MIME media type of the response. For example application/json or application/xml in case of bulk payment initiation.\n",
                "required": true,
                "schema": {
                  "title": "contentType",
                  "description": "Defines MIME media type of the resource. For example application/json or application/x-www-form-urlencoded (OAuth2 /auth resources) and application/xml in case of bulk payment initiation.\n",
                  "type": "string",
                  "maxLength": 50,
                  "example": "application/json"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "title": "error401",
                  "description": "Querying requires user authentication\n",
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "title": "error_UNAUTHORISED_401",
                            "description": "Invalid/missing access token = user is not authenticated\n  OR\nInvalid/missing certificate = provider is not authenticated/authorised\n",
                            "type": "object",
                            "required": [
                              "error"
                            ],
                            "properties": {
                              "error": {
                                "type": "string",
                                "example": "UNAUTHORISED"
                              },
                              "parameters": {
                                "title": "errorParameters",
                                "description": "The field of additional elements specific for the given error code. These parameters are always specified in the description of a specific error code.\n",
                                "type": "object",
                                "example": {
                                  "AMOUNT_ENTERED": 10000,
                                  "CURRENCY": "EUR",
                                  "LIMIT": 500
                                }
                              },
                              "scope": {
                                "title": "scope",
                                "description": "It determines the JSON path of the request element that caused the error status.\n",
                                "type": "string",
                                "example": "account.amount.currency"
                              },
                              "message": {
                                "title": "errorMessage",
                                "description": "Optional text description. It is not intended for interpretation to the end user but, for example, to enrich the error log.\n",
                                "type": "string",
                                "example": "Requested amount is too large"
                              }
                            },
                            "example": [
                              {
                                "error": "UNAUTHORISED"
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "headers": {
              "Content-Type": {
                "description": "Defines MIME media type of the response. For example application/json or application/xml in case of bulk payment initiation.\n",
                "required": true,
                "schema": {
                  "title": "contentType",
                  "description": "Defines MIME media type of the resource. For example application/json or application/x-www-form-urlencoded (OAuth2 /auth resources) and application/xml in case of bulk payment initiation.\n",
                  "type": "string",
                  "maxLength": 50,
                  "example": "application/json"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "title": "error403",
                  "description": "Authentication with an invalid certificate or expired access token, a call that does not match a third-party license.\n",
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "title": "error_FORBIDDEN_403",
                            "description": "Authentication with an invalid certificate or expired access token, a call that does not match a third-party license.\n",
                            "type": "object",
                            "required": [
                              "error"
                            ],
                            "properties": {
                              "error": {
                                "type": "string",
                                "example": "FORBIDDEN"
                              },
                              "parameters": {
                                "title": "errorParameters",
                                "description": "The field of additional elements specific for the given error code. These parameters are always specified in the description of a specific error code.\n",
                                "type": "object",
                                "example": {
                                  "AMOUNT_ENTERED": 10000,
                                  "CURRENCY": "EUR",
                                  "LIMIT": 500
                                }
                              },
                              "scope": {
                                "title": "scope",
                                "description": "It determines the JSON path of the request element that caused the error status.\n",
                                "type": "string",
                                "example": "account.amount.currency"
                              },
                              "message": {
                                "title": "errorMessage",
                                "description": "Optional text description. It is not intended for interpretation to the end user but, for example, to enrich the error log.\n",
                                "type": "string",
                                "example": "Requested amount is too large"
                              }
                            },
                            "example": [
                              {
                                "error": "FORBIDDEN"
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "headers": {
              "Content-Type": {
                "description": "Defines MIME media type of the response. For example application/json or application/xml in case of bulk payment initiation.\n",
                "required": true,
                "schema": {
                  "title": "contentType",
                  "description": "Defines MIME media type of the resource. For example application/json or application/x-www-form-urlencoded (OAuth2 /auth resources) and application/xml in case of bulk payment initiation.\n",
                  "type": "string",
                  "maxLength": 50,
                  "example": "application/json"
                }
              },
              "X-Request-ID": {
                "description": "Unique identifier for each request specified by TPP returned in response header.\n",
                "required": true,
                "schema": {
                  "title": "xRequestId",
                  "description": "Unique identifier for each request specified by TPP. It is recommended to use a UUID format with a length of 36 to 60 characters.\n",
                  "type": "string",
                  "maxLength": 60,
                  "example": "f713da2b-6908-4c3f-9461-784f74b86710"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "title": "error415",
                  "description": "Request contains a request for unsupported transmission type (e.g. in relation to headers Accept and Accept-Language).\n",
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "title": "error_UNSUPPORTED_MEDIA_TYPE_415",
                            "description": "Request contains a request for unsupported transmission type (e.g. in relation to headers Accept and Accept-Language).\n",
                            "type": "object",
                            "required": [
                              "error"
                            ],
                            "properties": {
                              "error": {
                                "type": "string",
                                "example": "UNSUPPORTED_MEDIA_TYPE"
                              },
                              "parameters": {
                                "title": "errorParameters",
                                "description": "The field of additional elements specific for the given error code. These parameters are always specified in the description of a specific error code.\n",
                                "type": "object",
                                "example": {
                                  "AMOUNT_ENTERED": 10000,
                                  "CURRENCY": "EUR",
                                  "LIMIT": 500
                                }
                              },
                              "scope": {
                                "title": "scope",
                                "description": "It determines the JSON path of the request element that caused the error status.\n",
                                "type": "string",
                                "example": "account.amount.currency"
                              },
                              "message": {
                                "title": "errorMessage",
                                "description": "Optional text description. It is not intended for interpretation to the end user but, for example, to enrich the error log.\n",
                                "type": "string",
                                "example": "Requested amount is too large"
                              }
                            },
                            "example": [
                              {
                                "error": "UNSUPPORTED_MEDIA_TYPE"
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "headers": {
              "X-Request-ID": {
                "description": "Unique identifier for each request specified by TPP returned in response header.\n",
                "required": true,
