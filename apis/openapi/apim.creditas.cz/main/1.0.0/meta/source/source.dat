    "/v1/my/accounts/{accountId}/balance": {
      "get": {
        "summary": "Account balance",
        "description": "The balance of the specific client account according to the reference id account.\n\n**Resource characteristics:**\n  * **Authorization:**  request requires the authorization of user/client as part of API calling\n  * **Use certificate:**  request requires the use of the qualified third-party certificate\n",
        "operationId": "getAccountsBalances",
        "tags": [
          "Account information"
        ],
        "security": [
          {
            "OAuth2": [
              "AISP",
              "aisp.balances"
            ],
            "ClientCert": []
          }
        ],
        "parameters": [
          {
            "name": "accountId",
            "description": "API payment account identifier from the response to a query on the list of accounts.\n",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "D2C8C1DCC51A3738538A40A4863CA288E0225E52"
            }
          },
          {
            "name": "Content-Type",
            "description": "Defines MIME media type of the resource. For example application/json or application/x-www-form-urlencoded (OAuth2 /auth resources) and application/xml in case of bulk payment initiation.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "application/json"
            }
          },
          {
            "name": "X-Request-ID",
            "description": "Unique identifier for each request specified by TPP. It is recommended to use a UUID format with a length of 36 to 60 characters.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "55d4fffc-2634-44d4-9f2b-3aa94fbd51a4"
            }
          },
          {
            "name": "Date",
            "description": "Each request of a transaction contains the date and time at which the message was originated. In timestamp format.\n",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "Wed, 6 Jan 2019 07:21:01 GMT"
            }
          },
          {
