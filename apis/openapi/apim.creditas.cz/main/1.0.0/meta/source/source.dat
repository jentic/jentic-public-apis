            "schema": {
              "type": "string",
              "example": "Star corporation, a.s.™"
            }
          },
          {
            "name": "Authorization",
            "description": "Contains the credentials to authenticate a user agent with a server. Element is defined in RFC 6750 In the case of this specification as Bearer Token Usage.\n",
            "in": "header",
