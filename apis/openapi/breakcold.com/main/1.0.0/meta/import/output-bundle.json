{
  "openapi": "3.1.0",
  "info": {
    "title": "Breakcold Public API",
    "version": "1.0.0",
    "description": "REST API for Breakcold CRM records, tasks, notes, inbox, meetings, and webhooks. The hosted MCP server exposes the same contract. See https://docs.breakcold.com/api/overview for the full reference.",
    "contact": {
      "name": "Breakcold",
      "url": "https://www.breakcold.com"
    },
    "x-jentic-source-url": "https://www.breakcold.com/.well-known/openapi.json"
  },
  "servers": [
    {
      "url": "https://rest.breakcold.com/api/v1"
    }
  ],
  "paths": {
    "/workspaces": {
      "get": {
        "tags": [
          "Workspaces"
        ],
        "summary": "List authorized workspaces",
        "operationId": "listAuthorizedWorkspaces",
        "responses": {
          "200": {
            "description": "Workspace list"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/records": {
      "get": {
        "tags": [
          "Records"
        ],
        "summary": "List or search records",
        "operationId": "listRecords",
        "responses": {
          "200": {
            "description": "Record list"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Records"
        ],
        "summary": "Create a record",
        "operationId": "createRecord",
        "responses": {
          "200": {
            "description": "Created record"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Breakcold API key (bc_live_…) or OAuth access token. See /auth.md."
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Workspaces"
    },
    {
      "name": "Records"
    },
    {
      "name": "Tasks"
    },
    {
      "name": "Notes"
    },
    {
      "name": "Inbox"
    },
    {
      "name": "Meetings"
    },
    {
      "name": "Webhooks"
    }
  ],
  "externalDocs": {
    "description": "Full Breakcold API reference",
    "url": "https://docs.breakcold.com/api/overview"
  }
}