{
  "openapi": "3.0.3",
  "info": {
    "title": "Viber Bot API",
    "description": "REST API for building bots on the Viber messaging platform. Supports sending and broadcasting messages, managing webhooks, and retrieving account and user information.",
    "version": "v1",
    "contact": {
      "name": "Viber Developers",
      "url": "https://developers.viber.com"
    },
    "x-jentic-source-url": "https://developers.viber.com/docs/api/rest-bot-api/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://chatapi.viber.com/pa",
      "description": "Viber Bot API production server"
    }
  ],
  "security": [
    {
      "authToken": []
    }
  ],
  "paths": {
    "/set_webhook": {
      "post": {
        "operationId": "setWebhook",
        "summary": "Set or remove webhook",
        "description": "Configure the webhook URL for receiving callback events. Send an empty URL string to remove the webhook.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["url"],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Webhook URL (HTTPS required). Empty string to remove webhook."
                  },
                  "event_types": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": ["delivered", "seen", "failed", "subscribed", "unsubscribed", "conversation_started"]
                    },
                    "description": "Event types to receive. Omit to receive all."
                  },
                  "send_name": {
                    "type": "boolean",
                    "default": false,
                    "description": "Include sender name in callbacks"
                  },
                  "send_photo": {
                    "type": "boolean",
                    "default": false,
                    "description": "Include sender photo in callbacks"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook set successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer", "example": 0 },
                    "status_message": { "type": "string", "example": "ok" },
                    "event_types": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/send_message": {
      "post": {
        "operationId": "sendMessage",
        "summary": "Send a message",
        "description": "Send a message to a subscribed user. Supports text, picture, video, file, location, contact, sticker, rich media, and URL message types.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["receiver", "type"],
                "properties": {
                  "receiver": {
                    "type": "string",
                    "description": "Unique Viber user ID of the receiver"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["text", "picture", "video", "file", "location", "contact", "sticker", "rich_media", "url"],
                    "description": "Message type"
                  },
                  "sender": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string", "maxLength": 28, "description": "Sender name (max 28 characters)" },
                      "avatar": { "type": "string", "format": "uri", "description": "Sender avatar URL" }
                    }
                  },
                  "tracking_data": {
                    "type": "string",
                    "maxLength": 4000,
                    "description": "Tracking data returned in callbacks (max 4000 characters)"
                  },
                  "min_api_version": {
                    "type": "integer",
                    "description": "Minimum API version required by the receiver"
                  },
                  "text": { "type": "string", "description": "Message text (for text type)" },
                  "media": { "type": "string", "format": "uri", "description": "Media URL (for picture, video, file types)" },
                  "thumbnail": { "type": "string", "format": "uri", "description": "Thumbnail URL" },
                  "size": { "type": "integer", "description": "File size in bytes" },
                  "file_name": { "type": "string", "description": "File name (for file type)" },
                  "duration": { "type": "integer", "description": "Video duration in seconds" },
                  "sticker_id": { "type": "integer", "description": "Sticker ID (for sticker type)" },
                  "location": {
                    "type": "object",
                    "properties": {
                      "lat": { "type": "number" },
                      "lon": { "type": "number" }
                    },
                    "description": "Location coordinates (for location type)"
                  },
                  "contact": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "phone_number": { "type": "string" }
                    },
                    "description": "Contact info (for contact type)"
                  },
                  "rich_media": {
                    "type": "object",
                    "description": "Rich media content (for rich_media type)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "status_message": { "type": "string" },
                    "message_token": { "type": "integer", "format": "int64" },
                    "billing_status": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/broadcast_message": {
      "post": {
        "operationId": "broadcastMessage",
        "summary": "Broadcast a message",
        "description": "Send a message to multiple subscribers at once (maximum 300 receivers per request).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["broadcast_list", "type"],
                "properties": {
                  "broadcast_list": {
                    "type": "array",
                    "items": { "type": "string" },
                    "maxItems": 300,
                    "description": "List of receiver user IDs (max 300)"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["text", "picture", "video", "file", "location", "contact", "sticker", "rich_media", "url"]
                  },
                  "sender": {
                    "type": "object",
                    "properties": {
                      "name": { "type": "string" },
                      "avatar": { "type": "string", "format": "uri" }
                    }
                  },
                  "text": { "type": "string" },
                  "media": { "type": "string", "format": "uri" },
                  "min_api_version": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Broadcast sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "status_message": { "type": "string" },
                    "message_token": { "type": "integer", "format": "int64" },
                    "failed_list": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "receiver": { "type": "string" },
                          "status": { "type": "integer" },
                          "status_message": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_account_info": {
      "post": {
        "operationId": "getAccountInfo",
        "summary": "Get account info",
        "description": "Retrieve the bot account details including name, URI, icon, background, webhook, subscribers count, and members.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "status_message": { "type": "string" },
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "uri": { "type": "string" },
                    "icon": { "type": "string" },
                    "background": { "type": "string" },
                    "category": { "type": "string" },
                    "subcategory": { "type": "string" },
                    "location": { "type": "object" },
                    "country": { "type": "string" },
                    "webhook": { "type": "string" },
                    "event_types": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "subscribers_count": { "type": "integer" },
                    "members": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "avatar": { "type": "string" },
                          "role": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_user_details": {
      "post": {
        "operationId": "getUserDetails",
        "summary": "Get user details",
        "description": "Fetch detailed information about a specific Viber user including their profile, device, and API version.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id"],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Unique Viber user ID"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "status_message": { "type": "string" },
                    "message_token": { "type": "integer", "format": "int64" },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "name": { "type": "string" },
                        "avatar": { "type": "string" },
                        "country": { "type": "string" },
                        "language": { "type": "string" },
                        "primary_device_os": { "type": "string" },
                        "api_version": { "type": "integer" },
                        "viber_version": { "type": "string" },
                        "mcc": { "type": "integer" },
                        "mnc": { "type": "integer" },
                        "device_type": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/get_online": {
      "post": {
        "operationId": "getOnlineStatus",
        "summary": "Get online status",
        "description": "Check the online status of up to 100 Viber users. Status codes: 0=online, 1=offline, 2=undisclosed, 3=try later, 4=unavailable.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ids"],
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": { "type": "string" },
                    "maxItems": 100,
                    "description": "Array of user IDs to check (max 100)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Online status results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer" },
                    "status_message": { "type": "string" },
                    "users": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "online_status": { "type": "integer", "description": "0=online, 1=offline, 2=undisclosed, 3=tryLater, 4=unavailable" },
                          "online_status_message": { "type": "string" },
                          "last_online": { "type": "integer", "format": "int64", "description": "Unix timestamp of last online" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "authToken": {
        "type": "apiKey",
        "name": "X-Viber-Auth-Token",
        "in": "header",
        "description": "Viber bot account authentication token"
      }
    }
  }
}