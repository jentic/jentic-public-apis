{
  "openapi": "3.1.0",
  "info": {
    "title": "IntelliBrief Backend API",
    "version": "1.0.0",
    "summary": "Personalized news briefing service used by the POOSD Team 12 project.",
    "description": "Complete REST API reference for the News Briefing backend. The service powers OTP-based\nauthentication, user preference management, and AI-generated news briefings sourced from\nNewsAPI plus OpenAI summarization.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ucfpoosdtm12largepro/news-briefing-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://poosdproj.xyz",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Deployment and diagnostics"
    },
    {
      "name": "Auth",
      "description": "OTP + password authentication workflows"
    },
    {
      "name": "User",
      "description": "Profile, preferences, and usage data for the authenticated user"
    },
    {
      "name": "Briefings",
      "description": "Generate, poll, and retrieve AI news briefings"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check",
        "description": "Returns deployment metadata and verifies the server is reachable.",
        "security": [],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "status": "ok",
                      "version": "1.0.4",
                      "environment": "development",
                      "message": "Deployment pipeline test - successful!",
                      "timestamp": "2025-10-23T12:00:00.000Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/check-user": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Check if user exists",
        "description": "Returns whether an email already has an account to help the client decide which login flow to show.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email lookup result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckUserResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register new user",
        "description": "Creates a user, captures onboarding preferences, and emits an OTP for verification.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Registration accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicSuccessResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/auth/login-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login with password + OTP",
        "description": "Verifies stored password, then sends an OTP to finish login.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password verified, OTP sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicSuccessResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/auth/verify": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Verify OTP and create session",
        "description": "Validates the emailed code and returns a JWT + user profile.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Start password reset",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset OTP sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicSuccessResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/auth/verify-reset-code": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Verify password reset code",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset code verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicSuccessResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Reset password with verified code",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset complete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BasicSuccessResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Get current user",
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      },
      "put": {
        "tags": [
          "User"
        ],
        "summary": "Update profile & preferences",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated user profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/me/usage": {
      "get": {
        "tags": [
          "User"
        ],
        "summary": "Get quota usage",
        "responses": {
          "200": {
            "description": "Usage counters for briefing generation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/briefings/generate-daily": {
      "post": {
        "tags": [
          "Briefings"
        ],
        "summary": "Generate daily briefing",
        "description": "Uses stored preferences with optional overrides to queue a daily briefing.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BriefingGenerateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Briefing queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BriefingGenerateResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/briefings/generate": {
      "post": {
        "tags": [
          "Briefings"
        ],
        "summary": "Generate custom news query",
        "description": "Ad-hoc news search with fine-grained filters and output format controls.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomNewsQueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Briefing queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BriefingGenerateResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/briefings/{briefingId}/status": {
      "get": {
        "tags": [
          "Briefings"
        ],
        "summary": "Get briefing status",
        "parameters": [
          {
            "$ref": "#/components/parameters/BriefingIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Current status for the queued briefing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BriefingStatus"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/briefings/{briefingId}": {
      "get": {
        "tags": [
          "Briefings"
        ],
        "summary": "Get briefing",
        "parameters": [
          {
            "$ref": "#/components/parameters/BriefingIdParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Full briefing payload with articles and summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Briefing"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "BriefingIdParam": {
        "name": "briefingId",
        "in": "path",
        "required": true,
        "description": "Identifier returned when the briefing was queued.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "ErrorResponse": {
        "description": "Error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "version",
          "environment",
          "message",
          "timestamp"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "VALIDATION_FAILED",
                  "RATE_LIMITED",
                  "QUOTA_EXCEEDED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "EmailRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "CheckUserResponse": {
        "type": "object",
        "properties": {
          "exists": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "exists",
          "message"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "jobIndustry": {
            "type": "string"
          },
          "demographic": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "lifeStage": {
            "type": "string"
          },
          "newsStyle": {
            "type": "string"
          },
          "newsScope": {
            "type": "string"
          },
          "preferredHeadlines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scrollPastTopics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LoginPasswordRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "OtpVerifyRequest": {
        "type": "object",
        "required": [
          "email",
          "code"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "code": {
            "type": "string",
            "minLength": 4,
            "maxLength": 8
          }
        }
      },
      "ResetPasswordRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/OtpVerifyRequest"
          },
          {
            "type": "object",
            "required": [
              "newPassword"
            ],
            "properties": {
              "newPassword": {
                "type": "string",
                "minLength": 8
              }
            }
          }
        ]
      },
      "BasicSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "default": true
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        },
        "required": [
          "token",
          "user"
        ]
      },
      "UserSummary": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "preferences": {
            "$ref": "#/components/schemas/UserPreferences"
          },
          "timezone": {
            "type": "string"
          },
          "notificationPrefs": {
            "$ref": "#/components/schemas/NotificationPrefs"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "_id",
          "email",
          "emailVerified",
          "preferences",
          "notificationPrefs",
          "createdAt",
          "updatedAt"
        ]
      },
      "NotificationPrefs": {
        "type": "object",
        "properties": {
          "onBriefingReady": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "onBriefingReady"
        ]
      },
      "User": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserSummary"
          },
          {
            "type": "object",
            "properties": {
              "limits": {
                "$ref": "#/components/schemas/UserLimits"
              },
              "otp": {
                "$ref": "#/components/schemas/OtpState"
              },
              "location": {
                "type": "string"
              },
              "lifeStage": {
                "type": "string"
              },
              "newsStyle": {
                "type": "string"
              },
              "newsScope": {
                "type": "string"
              },
              "preferredHeadlines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scrollPastTopics": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "acceptedTermsAt": {
                "type": "string",
                "format": "date-time"
              },
              "acceptedPrivacyAt": {
                "type": "string",
                "format": "date-time"
              },
              "lastLoginAt": {
                "type": "string",
                "format": "date-time"
              },
              "lastIp": {
                "type": "string"
              },
              "userAgent": {
                "type": "string"
              },
              "pushTokens": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PushToken"
                }
              }
            },
            "required": [
              "limits"
            ]
          }
        ]
      },
      "UserPreferences": {
        "type": "object",
        "properties": {
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "demographic": {
            "type": "string"
          },
          "jobIndustry": {
            "type": "string"
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "location": {
            "type": "string"
          },
          "lifeStage": {
            "type": "string"
          },
          "newsStyle": {
            "type": "string"
          },
          "newsScope": {
            "type": "string"
          },
          "preferredHeadlines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scrollPastTopics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "UserLimits": {
        "type": "object",
        "properties": {
          "dailyGenerateCap": {
            "type": "integer",
            "minimum": 1
          },
          "generatedCountToday": {
            "type": "integer",
            "minimum": 0
          },
          "resetAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "dailyGenerateCap",
          "generatedCountToday",
          "resetAt"
        ]
      },
      "OtpState": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "lastRequestedAt": {
            "type": "string",
            "format": "date-time"
          },
          "throttledUntil": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "hash",
          "expiresAt",
          "attempts"
        ]
      },
      "PushToken": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android"
            ]
          },
          "token": {
            "type": "string"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "platform",
          "token",
          "addedAt"
        ]
      },
      "ProfileUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "timezone": {
            "type": "string",
            "maxLength": 120
          },
          "notificationPrefs": {
            "type": "object",
            "properties": {
              "onBriefingReady": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "preferences": {
            "$ref": "#/components/schemas/UserPreferences"
          }
        },
        "additionalProperties": false
      },
      "Usage": {
        "type": "object",
        "properties": {
          "dailyGenerateCap": {
            "type": "integer",
            "minimum": 1
          },
          "generatedToday": {
            "type": "integer",
            "minimum": 0
          },
          "resetAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "dailyGenerateCap",
          "generatedToday",
          "resetAt"
        ]
      },
      "BriefingGenerateRequest": {
        "type": "object",
        "properties": {
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "jobIndustry": {
            "type": "string"
          },
          "demographic": {
