{
  "openapi": "3.0.3",
  "info": {
    "title": "Spreadshirt Public Shop API",
    "description": "The Spreadshirt Public Shop API enables developers to build custom e-commerce applications on the Spreadshirt print-on-demand platform. It provides access to shop configuration, sellable products, product types, baskets, and promotions across European and North American platforms.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://developer.spreadshirt.net/"
  },
  "servers": [
    {
      "url": "https://api.spreadshirt.net/api/v1",
      "description": "European platform"
    },
    {
      "url": "https://api.spreadshirt.com/api/v1",
      "description": "North American platform"
    }
  ],
  "security": [
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/shops/{shopId}": {
      "get": {
        "operationId": "getShop",
        "summary": "Retrieve shop details",
        "description": "Returns a shop's name, localization settings, country, language, and currency configuration.",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "description": "Unique shop identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mediaType",
            "in": "query",
            "description": "Response format. Use 'json' for JSON responses.",
            "schema": {
              "type": "string",
              "enum": ["json"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shop details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shop"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Shop not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/shops/{shopId}/sellables": {
      "get": {
        "operationId": "listSellables",
        "summary": "List sellable products",
        "description": "Retrieves a paginated collection of all sellable products available in a specific shop.",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "description": "Unique shop identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination (0-197 inclusive; maximum 9504 sellables)",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 197
            }
          },
          {
            "name": "mediaType",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["json"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of sellables",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellableList"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/shops/{shopId}/sellables/{sellableId}": {
      "get": {
        "operationId": "getSellable",
        "summary": "Get sellable product details",
        "description": "Retrieves comprehensive information about a specific sellable product in a particular color appearance.",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "description": "Unique shop identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sellableId",
            "in": "path",
            "required": true,
            "description": "Unique sellable identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "appearanceId",
            "in": "query",
            "description": "Color/appearance variant identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ideaId",
            "in": "query",
            "description": "Design identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mediaType",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["json"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sellable product details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellableDetail"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Sellable not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/shops/{shopId}/productTypeDepartments": {
      "get": {
        "operationId": "listProductTypeDepartments",
        "summary": "List product type departments and categories",
        "description": "Retrieves all available product type departments for a shop. A department groups product type categories, which in turn group product types, forming a three-level hierarchy.",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "description": "Unique shop identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fullData",
            "in": "query",
            "description": "Set to true to retrieve complete data and minimize additional requests",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "mediaType",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["json"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product type departments with nested categories",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductTypeDepartmentList"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/shops/{shopId}/productTypes/{productTypeId}": {
      "get": {
        "operationId": "getProductType",
        "summary": "Get product type details",
        "description": "Retrieves detailed information about a specific product type including appearances, sizes, views, stock states, print areas, and resources.",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "description": "Unique shop identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "productTypeId",
            "in": "path",
            "required": true,
            "description": "Product type identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Language locale for internationalized response fields",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mediaType",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["json"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product type details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductType"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Product type not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/shops/{shopId}/currentPromotion": {
      "get": {
        "operationId": "getCurrentPromotion",
        "summary": "Get current promotion",
        "description": "Retrieves the current active promotion for a shop, including the coupon code and validity period. Returns 404 when no promotion is active. Responses should be cached for 30 minutes.",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "description": "Unique shop identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mediaType",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["json"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current active promotion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Promotion"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No active promotion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/baskets": {
      "post": {
        "operationId": "createBasket",
        "summary": "Create a new basket",
        "description": "Creates a new shopping basket with initial items for a customer's first add-to-cart action.",
        "parameters": [
          {
            "name": "mediaType",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["json"],
              "default": "json"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBasketRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Basket created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Basket"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid basket items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/baskets/{basketId}": {
      "get": {
        "operationId": "getBasket",
        "summary": "Retrieve a basket",
        "description": "Retrieves complete basket data including pricing, items, shipping information, and checkout links.",
        "parameters": [
          {
            "name": "basketId",
            "in": "path",
            "required": true,
            "description": "Unique basket identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "description": "Locale affecting shipping cost calculations and localized descriptions",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mediaType",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["json"],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Basket details with items and pricing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Basket"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Basket not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateBasket",
        "summary": "Update a basket",
        "description": "Modifies an existing basket by replacing its content, including quantities and items.",
        "parameters": [
          {
            "name": "basketId",
            "in": "path",
            "required": true,
            "description": "Unique basket identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mediaType",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": ["json"],
              "default": "json"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Basket"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated basket",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Basket"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Basket not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Spreadshirt API key in format: SprdAuth apiKey=\"<your-api-key>\""
      }
    },
    "schemas": {
      "Shop": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string",
            "description": "Shop resource URL"
          },
          "id": {
            "type": "string",
            "description": "Shop identifier"
          },
          "name": {
            "type": "string",
            "description": "Shop name"
          },
          "descriptionName": {
            "type": "string",
            "description": "Shop description identifier"
          },
          "country": {
            "$ref": "#/components/schemas/ResourceReference"
          },
          "language": {
            "$ref": "#/components/schemas/ResourceReference"
          },
          "currency": {
            "$ref": "#/components/schemas/ResourceReference"
          }
        }
      },
      "ResourceReference": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string",
            "description": "Resource URL"
          },
          "id": {
            "type": "string",
            "description": "Resource identifier"
          }
        }
      },
      "SellableList": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "description": "Total number of sellables"
          },
          "limit": {
            "type": "integer",
            "description": "Maximum items per page"
          },
          "offset": {
            "type": "integer",
            "description": "Current offset"
          },
          "sellables": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Sellable"
            }
          }
        }
      },
      "Sellable": {
        "type": "object",
        "properties": {
          "sellableId": {
            "type": "string",
            "description": "Unique sellable identifier"
          },
          "ideaId": {
            "type": "string",
            "description": "Associated design idea identifier"
          },
          "mainDesignId": {
            "type": "string",
            "description": "Primary design identifier"
          },
          "productTypeId": {
            "type": "string",
            "description": "Product type identifier"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          },
          "name": {
            "type": "string",
            "description": "Product name"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags associated with the sellable"
          },
          "previewImage": {
            "$ref": "#/components/schemas/Image"
          },
          "appearanceIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Available appearance/color variant IDs"
          },
          "defaultAppearanceId": {
            "type": "string",
            "description": "Default appearance identifier"
          }
        }
      },
      "SellableDetail": {
        "type": "object",
        "properties": {
          "sellableId": {
            "type": "string"
          },
          "ideaId": {
            "type": "string"
          },
          "mainDesignId": {
            "type": "string"
          },
          "productTypeId": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          },
          "name": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "previewImage": {
            "$ref": "#/components/schemas/Image"
          },
          "appearanceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defaultAppearanceId": {
            "type": "string"
          },
          "sizeIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Available size IDs for this sellable"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Image"
            },
            "description": "Product images for different views"
          }
        }
      },
      "Price": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Price amount"
          },
          "currencyId": {
            "type": "string",
            "description": "Currency identifier"
          }
        }
      },
      "Image": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Image URL"
          },
          "type": {
            "type": "string",
            "description": "Image type"
          }
        }
      },
      "ProductTypeDepartmentList": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "count": {
            "type": "integer"
          },
          "productTypeDepartments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductTypeDepartment"
            }
          }
        }
      },
      "ProductTypeDepartment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Department identifier"
          },
          "name": {
            "type": "string",
            "description": "Department name"
          },
          "weight": {
            "type": "integer",
            "description": "Sort weight for ordering"
          },
          "lifeCycleState": {
            "type": "string",
            "description": "Lifecycle state of the department"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductTypeCategory"
            }
          }
        }
      },
      "ProductTypeCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Category identifier"
          },
          "name": {
            "type": "string",
            "description": "Category name"
          },
          "nameSingular": {
            "type": "string",
            "description": "Singular form of the category name"
          },
          "productTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductTypeSummary"
            }
          }
        }
      },
      "ProductTypeSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        }
      },
      "ProductType": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string",
            "description": "Resource URL"
          },
          "id": {
            "type": "string",
            "description": "Product type identifier"
          },
          "name": {
            "type": "string",
            "description": "Product type name"
          },
          "shortDescription": {
            "type": "string",
            "description": "Short description"
          },
          "description": {
            "type": "string",
            "description": "Full product description"
          },
          "categoryName": {
            "type": "string",
            "description": "Product category name"
          },
          "brand": {
            "type": "string",
            "description": "Product brand"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          },
          "appearances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Appearance"
            },
            "description": "Available color/pattern combinations"
          },
          "sizes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Size"
            },
            "description": "Available sizes"
          },
          "views": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/View"
            },
            "description": "Product views (front, back, left, right, etc.)"
          },
          "stockStates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockState"
            },
            "description": "Availability data for appearance/size combinations"
          },
          "printAreas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrintArea"
            },
            "description": "Regions where printing is possible"
          }
        }
      },
      "Appearance": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "printTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Size": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "measurements": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "View": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Image"
            }
          }
        }
      },
      "StockState": {
        "type": "object",
        "properties": {
          "appearanceId": {
            "type": "string"
          },
          "sizeId": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "PrintArea": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "width": {
            "type": "number",
            "format": "double"
          },
          "height": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Promotion": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Human-readable promotion text in the shop's language"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 promotion expiration timestamp (UTC)"
          },
          "code": {
            "type": "string",
            "description": "Coupon code for redemption via checkout URL parameter"
          }
        }
      },
      "CreateBasketRequest": {
        "type": "object",
        "required": ["basketItems"],
        "properties": {
          "basketItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BasketItem"
            }
          }
        }
      },
      "BasketItem": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "description": "Number of items"
          },
          "element": {
            "$ref": "#/components/schemas/BasketElement"
          }
        }
      },
      "BasketElement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Sellable ID"
          },
          "type": {
            "type": "string",
            "description": "Element type (e.g., sprd:sellable)"
          },
          "properties": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BasketElementProperty"
            },
            "description": "Properties like size and appearance"
          },
          "shop": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Shop identifier"
              }
            }
          }
        }
      },
      "BasketElementProperty": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Property name (e.g., size, appearance)"
          },
          "value": {
            "type": "string",
            "description": "Property value"
          }
        }
      },
      "Basket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Basket identifier"
          },
          "href": {
            "type": "string",
            "description": "Basket resource URL"
          },
          "basketItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BasketItem"
            }
          },
          "priceItems": {
            "type": "number",
            "format": "double",
            "description": "Total price of items"
          },
          "priceShipping": {
            "type": "number",
            "format": "double",
            "description": "Shipping cost"
          },
          "priceTotal": {
            "type": "number",
            "format": "double",
            "description": "Total price including shipping"
          },
          "currency": {
            "$ref": "#/components/schemas/ResourceReference"
          },
          "links": {
            "type": "object",
            "properties": {
              "checkout": {
                "type": "string",
                "format": "uri",
                "description": "Checkout URL"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "statusCode": {
            "type": "integer",
            "description": "HTTP status code"
          }
        }
      }
    }
  }
}