{
  "openapi": "3.0.3",
  "info": {
    "title": "Prospeo API",
    "description": "Prospeo B2B data API for person and company enrichment, search, and account information. Provides access to 200M+ contacts and 30M+ companies with verified emails, mobile numbers, and firmographic data.",
    "version": "1.0.0",
    "contact": {
      "name": "Prospeo",
      "url": "https://prospeo.io"
    },
    "x-jentic-source-url": "https://prospeo.io/api-docs"
  },
  "servers": [
    { "url": "https://api.prospeo.io" }
  ],
  "security": [
    { "ApiKeyAuth": [] }
  ],
  "tags": [
    { "name": "Enrichment" },
    { "name": "Search" },
    { "name": "Account" }
  ],
  "paths": {
    "/enrich-person": {
      "post": {
        "operationId": "enrichPerson",
        "summary": "Enrich Person",
        "description": "Enrich a single person from one or more datapoints (name, LinkedIn URL, email, company, etc.). At least one datapoint in the data object is required.",
        "tags": ["Enrichment"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EnrichPersonRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Enrichment result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EnrichPersonResponse" }
              }
            }
          }
        }
      }
    },
    "/bulk-enrich-person": {
      "post": {
        "operationId": "bulkEnrichPerson",
        "summary": "Bulk Enrich Person",
        "description": "Enrich up to 50 people in a single request. Each record must carry a unique identifier used to correlate the response.",
        "tags": ["Enrichment"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BulkEnrichPersonRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk enrichment result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BulkEnrichResponse" }
              }
            }
          }
        }
      }
    },
    "/enrich-company": {
      "post": {
        "operationId": "enrichCompany",
        "summary": "Enrich Company",
        "description": "Enrich a single company from a website, LinkedIn URL, name, or company ID. At least one datapoint is required; matching by name alone is discouraged.",
        "tags": ["Enrichment"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EnrichCompanyRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Company enrichment result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EnrichCompanyResponse" }
              }
            }
          }
        }
      }
    },
    "/bulk-enrich-company": {
      "post": {
        "operationId": "bulkEnrichCompany",
        "summary": "Bulk Enrich Company",
        "description": "Enrich up to 50 companies in a single request. Each record must carry a unique identifier used to correlate the response.",
        "tags": ["Enrichment"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/BulkEnrichCompanyRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk company enrichment result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/BulkEnrichResponse" }
              }
            }
          }
        }
      }
    },
    "/search-person": {
      "post": {
        "operationId": "searchPerson",
        "summary": "Search Person",
        "description": "Search the contact database using a filters object (30+ filters). Returns up to 25 results per page, up to 1000 pages (25,000 results). Email and mobile data require a separate Enrich Person call.",
        "tags": ["Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SearchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchResponse" }
              }
            }
          }
        }
      }
    },
    "/search-company": {
      "post": {
        "operationId": "searchCompany",
        "summary": "Search Company",
        "description": "Search the company database using a filters object. Returns up to 25 results per page, up to 1000 pages (25,000 results).",
        "tags": ["Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SearchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchResponse" }
              }
            }
          }
        }
      }
    },
    "/search-suggestions": {
      "post": {
        "operationId": "searchSuggestions",
        "summary": "Search Suggestions",
        "description": "Retrieve valid filter values for building search queries. Provide exactly one of the *_search fields (minimum 2 characters). Rate limited to 15 requests/second per account.",
        "tags": ["Search"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SearchSuggestionsRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Suggestion lists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SearchSuggestionsResponse" }
              }
            }
          }
        }
      }
    },
    "/account-information": {
      "get": {
        "operationId": "getAccountInformation",
        "summary": "Account Information",
        "description": "Retrieve the current account's plan, credit usage, and quota renewal information. Free to use.",
        "tags": ["Account"],
        "responses": {
          "200": {
            "description": "Account information",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountInformationResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-KEY",
        "description": "API key from the Prospeo dashboard, passed in the X-KEY header."
      }
    },
    "schemas": {
      "PersonDatapoints": {
        "type": "object",
        "description": "Person identification datapoints. At least one is required.",
        "properties": {
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "full_name": { "type": "string" },
          "linkedin_url": { "type": "string" },
          "email": { "type": "string" },
          "company_name": { "type": "string" },
          "company_website": { "type": "string" },
          "company_linkedin_url": { "type": "string" },
          "person_id": { "type": "string" }
        }
      },
      "CompanyDatapoints": {
        "type": "object",
        "description": "Company identification datapoints. At least one is required.",
        "properties": {
          "company_website": { "type": "string" },
          "company_linkedin_url": { "type": "string" },
          "company_name": { "type": "string" },
          "company_id": { "type": "string" }
        }
      },
      "EnrichPersonRequest": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/PersonDatapoints" },
          "only_verified_email": { "type": "boolean", "description": "Return results only if email is verified." },
          "enrich_mobile": { "type": "boolean", "description": "Include mobile number if available." },
          "only_verified_mobile": { "type": "boolean", "description": "Return results only if a mobile exists." }
        }
      },
      "BulkEnrichPersonRequest": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "description": "Up to 50 person objects to enrich.",
            "maxItems": 50,
            "items": {
              "allOf": [
                {
                  "type": "object",
                  "required": ["identifier"],
                  "properties": {
                    "identifier": { "type": "string", "description": "Alpha-numeric ID to track matches in the response." }
                  }
                },
                { "$ref": "#/components/schemas/PersonDatapoints" }
              ]
            }
          },
          "only_verified_email": { "type": "boolean", "default": false },
          "enrich_mobile": { "type": "boolean" },
          "only_verified_mobile": { "type": "boolean", "default": false }
        }
      },
      "EnrichCompanyRequest": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": { "$ref": "#/components/schemas/CompanyDatapoints" }
        }
      },
      "BulkEnrichCompanyRequest": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "description": "Up to 50 company objects to enrich.",
            "maxItems": 50,
            "items": {
              "allOf": [
                {
                  "type": "object",
                  "required": ["identifier"],
                  "properties": {
                    "identifier": { "type": "string", "description": "Alpha-numeric ID to track matches in the response." }
                  }
                },
                { "$ref": "#/components/schemas/CompanyDatapoints" }
              ]
            }
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "required": ["filters"],
        "properties": {
          "filters": {
            "type": "object",
            "description": "Filter configuration for the search query. Supports 30+ parameters (industry, seniority, job titles, locations, technologies, etc.). See the Filters Documentation.",
            "additionalProperties": true
          },
          "page": { "type": "integer", "description": "Page number (defaults to 1); max 1000 pages.", "default": 1, "minimum": 1, "maximum": 1000 }
        }
      },
      "SearchSuggestionsRequest": {
        "type": "object",
        "description": "Provide exactly one *_search field (minimum 2 characters).",
        "properties": {
          "location_search": { "type": "string", "minLength": 2 },
          "job_title_search": { "type": "string", "minLength": 2 },
          "technology_search": { "type": "string", "minLength": 2 },
          "industry_search": { "type": "string", "minLength": 2 },
          "naics_search": { "type": "string", "minLength": 2 },
          "sic_search": { "type": "string", "minLength": 2 },
          "company_operating_languages_search": { "type": "string", "minLength": 2 },
          "company_integrations_search": { "type": "string", "minLength": 2 },
          "company_awards_search": { "type": "string", "minLength": 2 },
          "company_funding_investors_search": { "type": "string", "minLength": 2 }
        }
      },
      "Person": {
        "type": "object",
        "properties": {
          "person_id": { "type": "string" },
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "full_name": { "type": "string" },
          "linkedin_url": { "type": "string" },
          "current_job_title": { "type": "string" },
          "headline": { "type": "string" },
          "job_history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "company_name": { "type": "string" },
                "current": { "type": "boolean" },
                "start_year": { "type": "integer" },
                "end_year": { "type": "integer" },
                "seniority": { "type": "string" }
              }
            }
          },
          "email": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "revealed": { "type": "boolean" },
              "email": { "type": "string" },
              "verification_method": { "type": "string" }
            }
          },
          "mobile": {
            "type": "object",
            "properties": {
              "status": { "type": "string" },
              "revealed": { "type": "boolean" },
              "mobile": { "type": "string" },
              "mobile_country": { "type": "string" }
            }
          },
          "location": {
            "type": "object",
            "properties": {
              "country": { "type": "string" },
              "state": { "type": "string" },
              "city": { "type": "string" }
            }
          }
        }
      },
      "Company": {
        "type": "object",
        "properties": {
          "company_id": { "type": "string" },
          "name": { "type": "string" },
          "website": { "type": "string" },
          "domain": { "type": "string" },
          "description": { "type": "string" },
          "type": { "type": "string" },
          "industry": { "type": "string" },
          "employee_count": { "type": "integer" },
          "employee_range": { "type": "string" },
          "location": {
            "type": "object",
            "properties": {
              "country": { "type": "string" },
              "country_code": { "type": "string" },
              "state": { "type": "string" },
              "city": { "type": "string" },
              "raw_address": { "type": "string" }
            }
          },
          "founded": { "type": "integer" },
          "linkedin_url": { "type": "string" },
          "logo_url": { "type": "string" },
          "funding": {
            "type": "object",
            "properties": {
              "total_funding": { "type": "number" },
              "latest_funding_stage": { "type": "string" }
            }
          },
          "technology": {
            "type": "object",
            "properties": {
              "count": { "type": "integer" },
              "technology_names": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "current_page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "total_page": { "type": "integer" },
          "total_count": { "type": "integer" }
        }
      },
      "EnrichPersonResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "boolean" },
          "free_enrichment": { "type": "boolean" },
          "person": { "$ref": "#/components/schemas/Person" },
          "company": { "$ref": "#/components/schemas/Company" }
        }
      },
      "EnrichCompanyResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "boolean" },
          "free_enrichment": { "type": "boolean" },
          "company": { "$ref": "#/components/schemas/Company" }
        }
      },
      "BulkEnrichResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "boolean" },
          "total_cost": { "type": "integer" },
          "not_matched": { "type": "array", "items": { "type": "string" } },
          "invalid_datapoints": { "type": "array", "items": { "type": "string" } },
          "matched": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "identifier": { "type": "string" },
                "person": { "$ref": "#/components/schemas/Person" },
                "company": { "$ref": "#/components/schemas/Company" }
              }
            }
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "boolean" },
          "free": { "type": "boolean" },
          "error_code": { "type": "string" },
          "filter_error": { "type": "string" },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "person": { "$ref": "#/components/schemas/Person" },
                "company": { "$ref": "#/components/schemas/Company" }
              }
            }
          },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "Suggestion": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" }
        }
      },
      "SearchSuggestionsResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "boolean" },
          "location_suggestions": { "type": "array", "nullable": true, "items": { "$ref": "#/components/schemas/Suggestion" } },
          "job_title_suggestions": { "type": "array", "nullable": true, "items": { "$ref": "#/components/schemas/Suggestion" } },
          "technology_suggestions": { "type": "array", "nullable": true, "items": { "$ref": "#/components/schemas/Suggestion" } },
          "industry_suggestions": { "type": "array", "nullable": true, "items": { "$ref": "#/components/schemas/Suggestion" } },
          "naics_suggestions": { "type": "array", "nullable": true, "items": { "$ref": "#/components/schemas/Suggestion" } },
          "sic_suggestions": { "type": "array", "nullable": true, "items": { "$ref": "#/components/schemas/Suggestion" } }
        }
      },
      "AccountInformationResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "boolean" },
          "response": {
            "type": "object",
            "properties": {
              "current_plan": { "type": "string" },
              "current_team_members": { "type": "integer" },
              "remaining_credits": { "type": "integer" },
              "used_credits": { "type": "integer" },
              "next_quota_renewal_days": { "type": "integer" },
              "next_quota_renewal_date": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
