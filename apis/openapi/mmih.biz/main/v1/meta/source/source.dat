            "schema": {
              "type": "string"
            }
          },
          {
            "name": "productCode",
            "in": "path",
            "description": "OIPA product Code identifier",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
