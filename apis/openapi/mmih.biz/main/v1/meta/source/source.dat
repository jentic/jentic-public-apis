{
  "openapi": "3.0.0",
  "servers": [
    {
      "description": "AWS API Gateway for OIPA ISS REST API",
      "url": "https://internal-dev.metretail.metmom.mmih.biz/api/oipa"
    }
  ],
  "info": {
    "version": "v1",
    "title": "MetRetail OIPA ISS API",
    "description": "This is the Metropolitan Retail OIPA Policy Administration System ISS API gateway service.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/DEVONSTANLEY/metretail-oipa-iss-api/v1"
  },
  "tags": [
    {
      "name": "Quote"
    },
    {
      "name": "Payment"
    },
    {
      "name": "Contract"
    },
    {
      "name": "Commission"
    },
    {
      "name": "Lisp"
    },
    {
      "name": "Death"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/quote/eac": {
      "post": {
        "summary": "Get effective annual cost calculations for quote",
        "description": "This is an example operation to show how to get eac calculations for quotes in OIPA.",
        "tags": [
          "Quote"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EacQuoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EacQuoteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/quote/gmv": {
      "post": {
        "summary": "Get effective annual cost calculations for quote",
        "description": "This is an example operation to show how to get gmv calculations for quotes in OIPA.",
        "tags": [
          "Quote"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
