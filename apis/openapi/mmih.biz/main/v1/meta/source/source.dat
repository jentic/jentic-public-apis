          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GmvQuoteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/quote/ris": {
      "post": {
        "summary": "Submit effective annual cost calculations for quote",
        "description": "This is an example operation to show how to get eac calculations for quotes in OIPA.",
        "tags": [
          "Quote"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RISQuoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quoteDetail": {
                      "$ref": "#/components/schemas/QuoteDetails"
                    },
                    "decreaseInGrossLifeCovPrem": {
                      "type": "number",
                      "format": "float"
                    },
                    "splitOfCapitalContribution": {
                      "$ref": "#/components/schemas/splitOfCapitalContributions"
                    },
                    "splitOfTax": {
                      "$ref": "#/components/schemas/splitOfTaxs"
                    },
                    "splitOfGrossIncome": {
                      "$ref": "#/components/schemas/splitOfTaxs"
                    },
                    "incomeBoosts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/incomeBoost"
                      }
                    },
                    "yieldRates": {
                      "$ref": "#/components/schemas/yieldRate"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/quote/ris/adhoc": {
      "post": {
        "summary": "Submit adhoc quote calculations",
        "description": "This is an example operation to show how to create adhoc quotes in OIPA.",
        "tags": [
          "Quote"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAdhocQuoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "adhocQuoteDetails": {
                      "$ref": "#/components/schemas/QuoteAdhocPaymentResponse"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/quote/ris/adhoc/accept": {
      "post": {
        "summary": "Submit adhoc quote acceptance",
        "description": "This is an example operation to show how to create adhoc quote acceptance in OIPA.",
        "tags": [
          "Quote"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAdhocQuoteAcceptanceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Adhoc Quote accepted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/quote/{referenceNumber}/{productCode}": {
      "get": {
        "summary": "Get quote calculations details from OIPA",
        "description": "This is an example operation to show how to get quote details for a client in OIPA.",
