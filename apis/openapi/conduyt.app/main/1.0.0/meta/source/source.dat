          schema:
            type: boolean
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - userId
              properties:
                userId:
                  type: string
                  minLength: 1
                  description: The team member to add.
                expectedRevision:
                  type: integer
                  minimum: 0
                  maximum: 2147483647
                  description: "Optional optimistic-concurrency pin: the contact's `revision` as the caller last read it (GET /contacts/{id}, the list, or the `revision` a previous collaborator or contact change returned). It is compared with the contact row once this request holds it, together with the caller's edit authority, so a change or a reassignment that committed in between is seen. When it no longer matches the request is refused with 409 `code: \"contact_changed\"` and nothing is changed. A malformed value (null, a string, a fraction, a negative number) is a 400: only an OMITTED field means unpinned. Omit it for today's behaviour."
      responses:
        "201":
          description: The collaborator was added. `revision` is the contact's new revision, the pin of the caller's next change.
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    type: object
                    required:
                      - added
                    properties:
                      added:
                        type: string
                      revision:
                        type: integer
        "400":
          $ref: "#/components/responses/BadRequest"
        "404":
          description: Nothing was changed. The contact does not exist or is not visible to the caller, or the caller no longer has edit authority over it (judged once the request holds the contact row, so a reassignment that committed in between is seen).
        "409":
          description: 'Nothing was changed. With `code: "contact_changed"` the contact changed after the revision pinned in `expectedRevision` (`revision` is its current revision): reload it, then retry with the new revision. The revision is checked before anything else, so a stale pin is always `contact_changed`. Other 409s have no `code` and are described by `error` (the user is already a collaborator).'
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - contact_changed
                  revision:
                    type: integer
        "413":
          description: The request body is larger than 16 KB (16,384 bytes), counted as it is read (a missing or understated Content-Length does not get a larger body through). Nothing was changed.
