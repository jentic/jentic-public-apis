  # ──────────────────────────────────────────────
  # Dashboard
  # ──────────────────────────────────────────────
  /dashboard:
    get:
      operationId: getDashboard
      summary: Get dashboard summary metrics
      description: The counts and totals are cached per server instance for 60 seconds per account, role and visibility scope; for 60 seconds after that a cached copy is still answered while one recompute runs in the background. Every list with a person or a deal (recent activity, needs follow-up, stale deals, overdue tasks, workload names) is read live on every request. generatedAt says when the counts were read. fresh=1 recomputes now. The X-Dashboard-Cache response header says hit, stale, miss or bypass.
      tags:
        - Dashboard
      responses:
        "200":
          description: Dashboard data (contacts count, deals, revenue, tasks, etc.)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: fresh
          in: query
          required: false
          description: "1 (or true) recomputes the dashboard now instead of answering from the 60-second cache, and stores the result. 0, false or absent: the cache may answer. Any other value, or two different values, is a 400."
          schema:
            type: string

