  # ──────────────────────────────────────────────
  /notifications:
    get:
      operationId: listNotifications
      summary: List notifications
      tags:
        - Notifications
      parameters:
        - name: isRead
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
          x-default-provenance: handler_literal
        - name: type
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
      responses:
        "200":
          description: Paginated notifications
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
    post:
      operationId: createNotification
      summary: Create a notification
      tags:
        - Notifications
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - type
                - title
                - message
              properties:
                userId:
                  type: string
                  format: uuid
                  description: Defaults to the caller when omitted
                type:
                  type: string
                  description: Notification type. Built-in types are documented in the API catalog; custom integration types are allowed.
                title:
                  type: string
                message:
                  type: string
                metadata:
                  type: object
                  description: Capped at 50 top-level keys and 10KB
                url:
                  type: string
                  description: Same-origin app path opened from push/notification clicks
                push:
                  type: boolean
                  description: Set false to skip web-push fan-out
      responses:
        "200":
          description: Success
          x-generated-status: true
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "201":
          description: Notification created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters: []

  /notifications/{id}:
