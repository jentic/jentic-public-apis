      responses:
        "200":
          description: Paginated calls
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
    post:
      operationId: createCallRecord
      summary: Create a call record
      tags:
        - Calls
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
