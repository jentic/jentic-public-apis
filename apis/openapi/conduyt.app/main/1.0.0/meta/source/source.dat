                    - rocket
                    - number-1
                    - number-2
                    - number-3
                    - number-4
                    - number-5
                    - number-6
                    - number-7
                    - number-8
                    - number-9
                    - flame
                    - zap
                    - alert-circle
                    - circle-alert
                    - bell
                    - filter
                    - trending-up
                    - list
                    - phone
                    - phone-off
                    - users
                    - tags
                    - tag
                    - mail-x
                    - calendar
                    - sparkles
                    - bookmark
                  default: heart
                  x-enum-current:
                    - heart
                    - star
                    - trophy
                    - badge
                    - target
                    - eye
                    - clock
                    - hourglass
                    - siren
                    - bolt
                    - fire
                    - rain
                    - funnel
                    - pyramid
                    - flag
                    - pin
                    - push-pin
                    - thumbs-up
                    - thumbs-down
                    - coffee
                    - rocket
                    - number-1
                    - number-2
                    - number-3
                    - number-4
                    - number-5
                    - number-6
                    - number-7
                    - number-8
                    - number-9
                  x-enum-deprecated:
                    - flame
                    - zap
                    - alert-circle
                    - circle-alert
                    - bell
                    - filter
                    - trending-up
                    - list
                    - phone
                    - phone-off
                    - users
                    - tags
                    - tag
                    - mail-x
                    - calendar
                    - sparkles
                    - bookmark
                  description: "The view's icon: one of heart, star, trophy, badge, target, eye, clock, hourglass, siren, bolt, fire, rain, funnel, pyramid, flag, pin, push-pin, thumbs-up, thumbs-down, coffee, rocket, number-1, number-2, number-3, number-4, number-5, number-6, number-7, number-8, number-9 (picker order). Deprecated inputs, accepted and stored as their mapped id: flame, zap, alert-circle, circle-alert, bell, filter, trending-up, list, phone, phone-off, users, tags, tag, mail-x, calendar, sparkles, bookmark. Responses always carry a current id. Anything else, null included, is 400 with code invalid_icon (field: \"icon\", allowed: the current ids). Omitted: heart."
              description: The icon is documented here; every other field of this endpoint's body is in GET /schema/api-catalog (authenticated).
      responses:
        "201":
          description: Created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          description: Invalid body. An icon outside the set answers code invalid_icon with field "icon" and allowed (the current ids).
          content:
            application/json:
              schema:
                type: object
                properties:
                  error:
                    type: string
                  code:
                    type: string
                  field:
                    type: string
                  allowed:
                    type: array
                    items:
                      type: string
                required:
                  - error

