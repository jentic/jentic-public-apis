      responses:
        "201":
          description: Created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  /users/invite:
    post:
      operationId: inviteUser
      summary: Invite a team member
      tags:
        - Users
      requestBody:
        required: true
