  /deals/lead-id:
    get:
      operationId: getDealsLeadId
      summary: Resolve a Lead ID to deals
      description: "Resolves a Lead ID (the first 8 to 32 hex characters of a deal id or of a contact id, dashes optional, any case; a whole id matches exactly) to the deals it names: deals whose id starts with it, and the deals of the contact whose id does. Uses the same read visibility as GET /deals/{id} (deals.view, owned or shared leads, the pipeline allowlist), not the board's assignee-only scope; a Lead ID the caller cannot see answers like one nobody has. Lists no text matches. Each deal carries matchedBy (deal or contact), its contact (null when hidden from the caller) and onBoard (whether the caller's pipeline board, whose scope is narrower, lists it). 400 when the term is not a Lead ID or more than 100 visible records share it; 403 without deals.view or for an API key whose scopes do not grant deals."
      tags:
        - Deals
      parameters:
        - name: limit
          in: query
          required: false
          description: Deals to list, 1 to 20 (default 5); total counts every match.
          schema:
            type: integer
            minimum: 1
            maximum: 20
            default: 5
          x-default-provenance: authored_operation
        - name: term
          in: query
          required: true
          description: The Lead ID.
          schema:
            type: string
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
