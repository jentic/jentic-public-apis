    post:
      x-generated: true
      operationId: postCallFlows
      summary: Create / invoke call-flows
      tags:
        - Call Flows
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - name
              properties:
                draftGraph:
                  type: object
                  required:
                    - entryId
                    - nodes
                  properties:
                    entryId:
                      type: string
                    nodes:
                      type: array
                      items:
                        type: object
                  description: "Optional { entryId, nodes[] } — omitted: seeded entry → voicemail; supplied (incl. null) it is validated like PATCH and malformed → 422"
                name:
                  type: string
                  description: Display name (required; trimmed, longer than 120 characters is cut)
                phoneNumber:
                  type: string
                  description: E.164 number this flow will answer (optional; must be unclaimed → 409 otherwise)
      responses:
        "201":
          description: Created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
