components:
  securitySchemes:
    BearerAuth:
      type: http
      scheme: bearer
      description: |
        API key authentication. Generate keys in Settings > API Keys.
        Keys use the `cdy_` prefix.

        Example: `Authorization: Bearer cdy_a1b2c3d4e5f6...`

  parameters:
    IdParam:
      name: id
      in: path
      required: true
      schema:
        type: string
        format: uuid
      description: Resource UUID
    PageParam:
      name: page
      in: query
      schema:
        type: integer
        minimum: 1
        default: 1
      description: Page number
    PerPageParam:
      name: per_page
      in: query
      schema:
        type: integer
        minimum: 1
        maximum: 200
        default: 50
      description: Items per page (max 200)
    SearchParam:
      name: search
      in: query
      schema:
        type: string
      description: Full-text search query

  responses:
    BadRequest:
      description: Bad request — validation error
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
    Unauthorized:
      description: Authentication required
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
    Forbidden:
      description: Insufficient permissions
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
    NotFound:
      description: Resource not found
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"
    RateLimited:
      description: Too many requests
      headers:
        Retry-After:
          schema:
            type: integer
          description: Seconds until next allowed request
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/ErrorResponse"

  schemas:
    CompanyDetails:
      type: object
      description: The account's Company details (Settings > Branding). An empty string = not set; signatures skip it.
      properties:
        website: { type: string, maxLength: 300 }
        phone: { type: string, maxLength: 40 }
        address: { type: string, maxLength: 300 }
        linkedin: { type: string, maxLength: 300 }
        instagram: { type: string, maxLength: 300 }
        facebook: { type: string, maxLength: 300 }
        youtube: { type: string, maxLength: 300 }
        disclaimer: { type: string, maxLength: 1000 }
    CompanyDetailsPatch:
      type: object
      additionalProperties: false
      description: Any of the eight fields; "" or null clears one.
      properties:
        website: { type: string, nullable: true, maxLength: 300 }
        phone: { type: string, nullable: true, maxLength: 40 }
        address: { type: string, nullable: true, maxLength: 300 }
        linkedin: { type: string, nullable: true, maxLength: 300 }
        instagram: { type: string, nullable: true, maxLength: 300 }
        facebook: { type: string, nullable: true, maxLength: 300 }
        youtube: { type: string, nullable: true, maxLength: 300 }
        disclaimer: { type: string, nullable: true, maxLength: 1000 }
    EmailSignatureInput:
      type: object
      additionalProperties: false
      properties:
        designId:
          type: string
          description: One of the 36 design ids (GET /email-signature/designs). Default classic.
        overrides:
          type: object
          additionalProperties: false
          description: Only the fields the member changed; an omitted (or null) field follows its source.
          properties:
            name: { type: string, maxLength: 100 }
            title: { type: string, maxLength: 120, description: Position (source = the workspace membership) }
            company: { type: string, maxLength: 120 }
            dept: { type: string, maxLength: 120, description: Department, signature only }
            phone: { type: string, maxLength: 40 }
            mobile: { type: string, maxLength: 40 }
            web: { type: string, maxLength: 300 }
            addr: { type: string, maxLength: 300 }
            social:
              type: object
              description: network key -> profile link. linkedin / instagram / facebook / youtube override the Company details; any other network is kept in this signature only.
              additionalProperties: { type: string, maxLength: 300 }
        options:
          type: object
          additionalProperties: false
          properties:
            accent: { type: string, nullable: true, description: "Hex colour; null = the account's brand colour" }
            font: { type: string, enum: [ Original, Arial, Helvetica, Georgia, Verdana, Trebuchet, Courier ] }
            fsize: { type: string, enum: [ s, m, l ] }
            psize: { type: integer, minimum: 40, maximum: 160 }
            shape: { type: string, enum: [ circle, rounded, square ] }
            lw: { type: integer, minimum: 40, maximum: 240 }
            istyle: { type: string, enum: [ tpl, brand, accent, outline ] }
            ishape: { type: string, enum: [ r, c ] }
            isz: { type: integer, minimum: 16, maximum: 40 }
            icol: { type: string, nullable: true }
            iglyph: { type: string, enum: [ auto, white, black, text ] }
            divider: { type: boolean }
            addons:
              type: object
              properties:
                book: { type: object, properties: { on: { type: boolean }, pageId: { type: string, format: uuid, nullable: true } } }
                signoff: { type: object, properties: { on: { type: boolean }, text: { type: string, maxLength: 80 } } }
                banner: { type: object, properties: { on: { type: boolean }, text: { type: string, maxLength: 160 }, url: { type: string, maxLength: 300 } } }
                meet: { type: object, properties: { on: { type: boolean }, text: { type: string, maxLength: 160 }, url: { type: string, maxLength: 300 } } }
                disclaimer: { type: object, properties: { on: { type: boolean } } }
                green: { type: object, properties: { on: { type: boolean } } }
                credit: { type: object, properties: { on: { type: boolean } } }
            compose:
              type: object
              properties:
                newEmails: { type: boolean }
                replies: { type: boolean }
        useInCompose: { type: boolean }
    EmailSignatureResponse:
      type: object
      properties:
        saved: { type: boolean }
        signature:
          type: object
          properties:
            designId: { type: string }
            overrides: { type: object }
            options: { type: object }
            useInCompose: { type: boolean }
            html: { type: string, nullable: true, description: Rendered now from the live sources; null for an unsaved draft or with renderError }
            plain: { type: string, nullable: true }
            renderError: { type: string, nullable: true, description: Why the saved signature cannot be rendered from the current sources (too large), else null }
            updatedAt: { type: string, format: date-time, nullable: true }
        fields:
          type: object
          description: Each field's value, source (profile, workspace, company, signature), whether it is custom, and its source value; the photo, logo, social links, disclaimer, brand colour and booking page in use.
        context:
          type: object
          description: What the signature is filled from (profile, membership, branding, Company details, the caller's own booking pages).
    BookingFormField:
      type: object
      required: [ id, label, type, show, required ]
      properties:
        id:
          type: string
          minLength: 1
          maxLength: 64
        label:
          type: string
          minLength: 1
          maxLength: 120
        type:
          type: string
          enum: [ text, email, tel, textarea ]
        show:
          type: boolean
        required:
          type: boolean
        locked:
          type: boolean
    BookingFieldMapping:
      type: object
      required: [ formFieldId, contactField ]
      properties:
        formFieldId:
          type: string
          minLength: 1
          maxLength: 64
        contactField:
          type: string
          maxLength: 96
          description: A standard contact field (firstName, lastName, email, phone, company, jobTitle, address, city, state, zip, country, source, notes, website) or customFields.<key>; protected stamp keys are refused.
          pattern: "^(firstName|lastName|email|phone|company|jobTitle|address|city|state|zip|country|source|notes|website|customFields\\.[a-zA-Z_][a-zA-Z0-9_]*)$"
    BookingCustomQuestion:
      type: object
      required: [ label, type ]
      properties:
        id:
          type: string
          maxLength: 57
          description: Generated from the label when absent.
        label:
          type: string
          minLength: 1
          maxLength: 500
        type:
          type: string
          enum: [ short_text, long_text, email, phone, select, checkbox, date, number, hidden ]
        required:
          type: boolean
          default: false
        options:
          type: array
          maxItems: 50
          items:
            type: string
            maxLength: 500
        defaultValue:
          type: string
          maxLength: 500
    BookingPagePatch:
      type: object
      description: >-
        The body of PATCH /booking-pages/{id}. Every field is optional; only supplied fields change. A field the route normalises (clamps, trims, falls back to a default) is documented with the value it stores.
      properties:
        title:
          type: string
          description: Ignored when blank.
        slug:
          type: string
          description: Normalised; a slug another page uses is refused with 409.
        description:
          type: string
          nullable: true
        durationMinutes:
          type: integer
        durationOptions:
          type: array
          nullable: true
          description: Selectable durations; entries with no label or outside 5 to 480 minutes are dropped; empty or null clears.
          items:
            type: object
            properties:
              label:
                type: string
              minutes:
                type: integer
                minimum: 5
                maximum: 480
        bufferBefore:
          type: integer
          nullable: true
          description: Minutes before each booking; clamped.
        bufferAfter:
          type: integer
          nullable: true
          description: Minutes after each booking; clamped.
        minimumNotice:
          type: integer
          minimum: 0
          description: Minutes of notice required; an invalid value keeps the current one.
        maxAdvanceDays:
          type: integer
          description: How many days ahead bookings open; clamped; an invalid value keeps the current one.
        maxBookingsPerDay:
          type: integer
          nullable: true
          minimum: 1
        location:
          type: string
          nullable: true
        videoProvider:
          type: string
          nullable: true
          enum: [ zoom ]
          description: "zoom, or null / empty for none."
        videoHostEmail:
          type: string
          nullable: true
          format: email
        color:
          type: string
          nullable: true
          description: A hex colour.
        thankYouMessage:
          type: string
          nullable: true
          maxLength: 2000
        redirectUrl:
          type: string
          nullable: true
          format: uri
        requirePhone:
          type: boolean
        embedEnabled:
          type: boolean
        customQuestions:
          type: array
          maxItems: 50
          description: The booking form's extra questions; an entry without a label or a known type is dropped; an empty list clears them.
          items:
            $ref: "#/components/schemas/BookingCustomQuestion"
        formFields:
          type: array
          nullable: true
          maxItems: 20
          description: The standard form fields; an invalid entry is dropped, and a list with no valid entry (or null) clears the configuration.
          items:
            $ref: "#/components/schemas/BookingFormField"
        fieldMappings:
          type: array
          nullable: true
          maxItems: 20
          description: Form field to contact field mappings; an invalid entry is dropped, and a list with no valid entry (or null) clears them.
          items:
            $ref: "#/components/schemas/BookingFieldMapping"
        availabilityRules:
          type: array
          nullable: true
          description: Availability windows overriding the host's global rules; null or an empty list uses the global rules.
          items:
            type: object
            properties:
              dayOfWeek:
                type: integer
                minimum: 0
                maximum: 6
              startTime:
                type: string
                pattern: "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              endTime:
                type: string
                pattern: "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        reminders:
          type: array
          maxItems: 10
          items:
            type: object
            properties:
              type:
                type: string
                enum: [ email, sms ]
              minutesBefore:
                type: integer
                minimum: 1
                maximum: 10080
        brandName:
          type: string
          nullable: true
          maxLength: 80
        logoUrl:
          type: string
          nullable: true
          format: uri
        hideBranding:
          type: boolean
        embedAllowedOrigins:
          type: array
          nullable: true
          items:
            type: string
        template:
          type: string
          nullable: true
          enum: [ bda ]
          description: null for the default page, "bda" for the BDA template; anything else is refused with 400.
        reviews:
          type: object
          nullable: true
          properties:
            badges:
              type: array
              items:
                type: object
            testimonials:
              type: array
              items:
                type: object
        leadSource:
          type: string
          nullable: true
        campaign:
          type: string
          nullable: true
        hyrosTag:
          type: string
          nullable: true
        documentsEnabled:
          type: boolean
          description: Turns the documents step on or off for this page's bookings.
        documentsPageUrl:
          type: string
          nullable: true
          format: uri
          description: The https page on the customer's site that hosts the upload step; an https URL or null (a supplied non-https value is refused with 400).
        morningOfReminderEnabled:
          type: boolean
          description: Turns the 9 AM (prospect-local) morning-of email on or off for this page's bookings; turning it off also withdraws the ones already scheduled. A non-boolean is refused with 400.
        isActive:
          type: boolean
        userId:
          type: string
          format: uuid
          description: The page owner; must be an active member of the account.
        eventType:
          type: string
          enum: [ one_on_one, round_robin, collective, group ]
        maxAttendees:
          type: integer
          nullable: true
          minimum: 1
        hostUserIds:
          type: array
          items:
            type: string
            format: uuid
          description: Users on this account who can host; anything else is refused with 400.
        hostGroupId:
          type: string
          format: uuid
          nullable: true
        hostPriorities:
          type: object
          nullable: true
          description: Host user id to priority; an invalid map clears to the default.
          additionalProperties:
            type: string
            enum: [ highest, high, low, lowest ]
        distributionMethod:
          type: string
          enum: [ maximize, equal ]
        paymentEnabled:
          type: boolean
          description: Accepted but payment checkout is not implemented yet; the page stays with payment disabled and the response carries a warning.
        paymentAmount:
          type: integer
          nullable: true
          minimum: 1
          description: Amount in cents.
        paymentCurrency:
          type: string
          nullable: true
          enum: [ usd, eur, gbp, cad, aud, mxn ]
          description: An unknown currency is stored as usd.
        stripeProductId:
          type: string
          nullable: true
        stripePriceId:
          type: string
          nullable: true
        gdprEnabled:
          type: boolean
        gdprText:
          type: string
          nullable: true
          maxLength: 2000
        gdprLinkUrl:
          type: string
          nullable: true
          format: uri
        waitlistEnabled:
          type: boolean
        enableIcalFeed:
          type: boolean
          description: true issues a new iCal feed token, false revokes it.
    MessageCheckRequest:
      type: object
      additionalProperties: false
      required: [ channel, body ]
      properties:
        channel:
          type: string
          enum: [ sms, email ]
        subject:
          type: string
          maxLength: 300
          description: Email only. Refused on a text.
        body:
          type: string
          maxLength: 10000
        context:
          type: string
          enum: [ template, first, conversation ]
          default: template
          description: Where the message sits. template (default) grades it as a reusable message; first is the first text to a contact; conversation is a reply in an existing thread, where the engine skips the opt-out and business-name checks (engine 2.1.0).
        clean:
          type: boolean
          description: true adds `cleaned` to the answer, the engine's cleaner version of the draft. It is a proposal only; the API never stores or applies it.
        provider:
          type: string
          enum: [ twilio ]
          description: SMS only (a 400 on an email check). The texting provider the notices are worded for; `twilio` gives Twilio's own wording and severities (for example sweepstakes are not carried), the same the contact and template composers show for a Twilio line. Omit for the generic wording. `cleaned` follows the same provider.
    MessageCheckHit:
      type: object
      required: [ start, end, word, level ]
      description: One flagged span. start and end are Unicode code-point offsets into the submitted text (the body for hits, the subject for subjectHits), end exclusive; an emoji counts as one, so text[start:end] in Python or [...text].slice(start, end) in JavaScript is the word.
      properties:
        start:
          type: integer
        end:
          type: integer
        word:
          type: string
          description: The exact text at start and end of the submitted text, always.
        display:
          type: string
          description: Optional (engine 2.0+). The word as the engine read it after decoding disguises (invisible characters, HTML tags and entities), for display; `word` is always the exact text at the offsets.
        level:
          type: string
          enum: [ r, a, y, n ]
          description: r likely blocked, a risky, y caution, n heads up
        label:
          type: string
        cat:
          type: string
        why:
          type: string
        alts:
          type: array
          items:
            type: string
          description: Safer wording (some entries are advice rather than a swap, e.g. "describe the specific benefit")
        restricted:
          type: boolean
          description: Prohibited in US business texting; no rewording makes it deliverable
        rule:
          type: integer
    MessageCheckBreakdownLine:
      type: object
      required: [ group, label, points, kind, field, start, end, level ]
      properties:
        group:
          type: string
          description: Promises, Pressure, Money/offers, Formatting, Links, Industry words, Repeats, Hidden characters or Missing pieces
        label:
          type: string
        detail:
          type: string
        points:
          type: integer
        count:
          type: integer
        level:
          type: [ string, "null" ]
          enum: [ r, a, y, n, null ]
          description: null on a check line (kind check)
        kind:
          type: string
          enum: [ word, check ]
        field:
          type: [ string, "null" ]
          enum: [ text, subject, null ]
          description: null on a check line (kind check)
        start:
          type: [ integer, "null" ]
          description: null on a check line (kind check)
        end:
          type: [ integer, "null" ]
          description: null on a check line (kind check)
    MessageCheckNotice:
      type: object
      required: [ group, text, severity ]
      properties:
        group:
          type: string
        text:
          type: string
        severity:
          type: string
          enum: [ not-carried, restricted, conditional ]
        provider:
          type: [ string, "null" ]
        triggers:
          type: array
          items:
            type: string
    MessageCheckUnicodeCulprit:
      type: object
      required: [ char, code, name, count, positions ]
      properties:
        char:
          type: string
        code:
          type: string
          description: e.g. U+1F600
        name:
          type: string
        count:
          type: integer
        positions:
          type: array
          description: Unicode code-point offsets into the body
          items:
            type: integer
        replace:
          type: [ string, "null" ]
          description: A safe swap, or null when there is none (emoji)
    MessageCheckCleanChange:
      type: object
      required: [ start, end, before, after, reason, field ]
      properties:
        start:
          type: integer
          description: Unicode code-point offset into the submitted field
        end:
          type: integer
        before:
          type: string
        after:
          type: string
        reason:
          type: string
        ruleId:
          description: The cleaner rule that made the change. A word rule's number, or a name for the formatting rules (caps, punct, hidden, typography).
          oneOf:
            - type: integer
            - type: string
        field:
          type: string
          enum: [ text, subject ]
    MessageCheckResult:
      type: object
      required: [ score, grade, verdict, hits, subjectHits, checks, sms, context, engine ]
      properties:
        score:
          type: integer
          minimum: 0
          maximum: 100
        grade:
          type: string
          enum: [ A, B, C, D, F ]
        verdict:
          type: string
          description: The engine's verdict, e.g. "Good to send", "Edit these words first", "Don't send"
        vclass:
          type: string
          enum: [ ok, mid, bad ]
        hits:
          type: array
          items:
            $ref: "#/components/schemas/MessageCheckHit"
        subjectHits:
          type: array
          description: The subject's flagged words (email); empty for a text
          items:
            $ref: "#/components/schemas/MessageCheckHit"
        checks:
          type: array
          items:
            type: object
            required: [ ok, label ]
            properties:
              ok:
                type: boolean
              label:
                type: string
              detail:
                type: string
              warn:
                type: boolean
        sms:
          type: [ object, "null" ]
          description: A text's count as the engine makes it; null for an email
          properties:
            chars:
              type: integer
            segments:
              type: integer
            unicode:
              type: boolean
            perSeg:
              type: integer
            units:
              type: integer
              description: Engine 2.0+. GSM extension characters count 2; Unicode counts UTF-16 units.
            estimate:
              type: boolean
              description: Engine 2.0+. true when merge fields are present, so the count is an estimate.
        context:
          type: string
          enum: [ template, first, conversation ]
          description: The context the draft was graded in (the request's, or template)
        breakdown:
          type: array
          description: Engine 2.0+. Where the points went. The `points` of all lines add up to exactly 100 minus the score. start and end are Unicode code-point offsets into the field named by `field`.
          items:
            $ref: "#/components/schemas/MessageCheckBreakdownLine"
        notices:
          type: array
          description: Engine 2.0+, texts only (an email answers an empty list). Provider notices; show `text` verbatim. Informational, never part of the score.
          items:
            $ref: "#/components/schemas/MessageCheckNotice"
        unicodeCulprits:
          type: array
          description: Engine 2.0+, texts only. The characters that force Unicode (and so 70-character segments).
          items:
            $ref: "#/components/schemas/MessageCheckUnicodeCulprit"
        englishDictionary:
          type: string
          enum: [ loaded, not_loaded ]
          description: Engine 2.2.1+. Whether the engine's English dictionary was loaded for this result (the "No recognizable English words" check). The server embeds it, so it is loaded; treat a result with any other value as provisional, never as a final grade.
        cleaned:
          type: [ object, "null" ]
          description: Present only when the request set clean true. The engine's cleaner version of the draft (a proposal; merge fields, links, opt-out lines and industry words are never touched). null when the cleaner could not run.
          required: [ text, changes, skipped ]
          properties:
            text:
              type: string
            subject:
              type: string
              description: Email only
            changes:
              type: array
              items:
                $ref: "#/components/schemas/MessageCheckCleanChange"
            skipped:
              type: array
              description: Flagged words the cleaner left alone, with why
              items:
                type: object
                required: [ word, reason ]
                properties:
                  word:
                    type: string
                  reason:
                    type: string
        engine:
          type: object
          required: [ version, updatedAt ]
          properties:
            version:
              type: string
            updatedAt:
              type: string
    ErrorResponse:
      type: object
      required: [ error ]
      properties:
        error:
          type: string
        code:
          type: string
          description: Machine-readable error code (e.g., TRIAL_EXPIRED, PLAN_LIMIT_REACHED)

    AutomationFlatErrorResponse:
      description: >-
        A plain flat error (`error`, optionally `code`) as the automation write endpoints answer it. It forbids the structured `errors` list, so it never overlaps AutomationActionConfigKeyError: a key-error-shaped body that lacks the required `code` matches neither branch.
      allOf:
        - $ref: "#/components/schemas/ErrorResponse"
        - not:
            required: [ errors ]

    AutomationActionConfigKeyError:
      type: object
      description: >-
        An action config key the action does not read is refused on every write path (POST /automations/validate answers 200 with valid false and this `errors` list; POST /automations/import and POST /automations answer 400, PATCH /automations/{id} answers 400, and the publish preflight and every version restore answer 422). Each entry names the node, the key and, when a declared key matches case-insensitively or is the unique nearest within a length-aware bound (none under 4 characters, distance 1 for 4-5, 2 for 6+), the suggestion ("Did you mean `laneSource`?"). An action `type` no registry entry defines (a v1 linear list never passes the graph validator) answers code `unknown_action_type` (`"not_an_action" is not an automation action.`, with `Did you mean` when a registered type is close). Stored workflows are never refused on read; only a write that carries the key is.
      required: [ error, code, errors ]
      properties:
        error:
          type: string
          example: 'unknown_action_config_key: assign_to_user does not read the config key "laneSoruce", so it would be ignored. Did you mean "laneSource"?'
        code:
          type: string
          enum: [ unknown_action_config_key, unknown_action_type ]
        errors:
          type: array
          items:
            type: object
            required: [ code, message ]
            properties:
              nodeId:
                type: string
                description: The graph node id (a linear list's action id, or action-N when it has none).
              field:
                type: string
                example: action.config.laneSoruce
              code:
                type: string
                enum: [ unknown_action_config_key, unknown_action_type ]
              message:
                type: string

    AutomationPreflightRefusal:
      type: object
      description: >-
        A blocking publish preflight refusal (POST /automations/{id}/publish, and a version restore that publishes), wrapped in the standard `data` envelope: `data.message` plus the `errors` (each with nodeId, field, code and message; an unknown action config key carries code `unknown_action_config_key`, an unregistered action type `unknown_action_type`) and `warnings` that applied. It has no top-level `error`, so it never overlaps ErrorResponse.
      required: [ data ]
      properties:
        data:
          type: object
          required: [ message ]
          properties:
            message:
              type: string
            errors:
              type: array
              items:
                type: object
                required: [ message ]
                properties:
                  nodeId:
                    type: string
                  field:
                    type: string
                  code:
                    type: string
                  message:
                    type: string
            warnings:
              type: array
              items:
                type: object
                additionalProperties: true

    PipelineHealth:
      type: object
      description: Pipeline health over a set of open deals (GET /deals/inspection, GET /deals?health_summary=true)
      required: [ totalOpenDeals, atRiskValue, checks, deals ]
      properties:
        totalOpenDeals:
          type: integer
        atRiskValue:
          type: number
          description: Total value of the High-value idle deals
        checks:
          type: array
          description: The six checks, ordered by money at risk
          items:
            type: object
            required: [ key, label, severity, color, rule, count, value ]
            properties:
              key:
                type: string
                enum: [ high_value_idle, stale, unassigned, needs_action, missing_close_date, missing_contact ]
              label:
                type: string
              severity:
                type: string
                enum: [ high, medium, low ]
              color:
                type: string
              rule:
                type: string
              count:
                type: integer
              value:
                type: number
        deals:
          description: The asked check's first page (with the check's total), or null when no check was asked for
          oneOf:
            - type: "null"
            - allOf:
                - $ref: "#/components/schemas/PipelineHealthDealsPage"
                - type: object
                  required: [ total ]
                  properties:
                    total:
                      type: integer
        summary:
          type: object
          description: (GET /deals/inspection) count per check
          additionalProperties:
            type: integer
        labels:
          type: object
          description: (GET /deals/inspection) label per check
          additionalProperties:
            type: string
        riskyDeals:
          type: array
          deprecated: true
          description: "Deprecated (GET /deals/inspection without `check` only, kept for a compatibility window): the 10 highest-scored risky deals. Use `check` with `deals` (or GET /deals?health_summary=true&health_check=...) instead."
          items:
            $ref: "#/components/schemas/PipelineHealthLegacyRiskyDeal"
    PipelineHealthDealsPage:
      type: object
      description: "One page of a check's deals, highest value first (value desc, then id): the rows and their issue icons. Continue with nextCursor (GET /deals health_cursor, GET /deals/inspection cursor) while hasMore is true. GET /deals?...&health_rows_only=true answers this alone."
      required: [ check, offset, items, hasMore, nextCursor ]
      properties:
        check:
          type: string
          enum: [ high_value_idle, stale, unassigned, needs_action, missing_close_date, missing_contact ]
        offset:
          type: integer
          description: The offset this page was read at (0 when read by cursor)
        items:
          type: array
          items:
            $ref: "#/components/schemas/PipelineHealthDeal"
        hasMore:
          type: boolean
        nextCursor:
          type: [ string, "null" ]
          description: "Opaque keyset cursor after this page's last row, signed and bound to this list (account, check, effective filters incl. a saved view's rules, the thresholds the check reads): pass it back unchanged; a list whose view or thresholds changed answers 400 health_cursor_context; null when hasMore is false"
    PipelineHealthDeal:
      type: object
      required: [ id, title, value, pipelineId, pipelineName, stageId, stageName, idleDays, assignedTo, contactId, expectedCloseDate, updatedAt, issues ]
      properties:
        id:
          type: string
          format: uuid
        title:
          type: string
        value:
          type: [ number, "null" ]
        pipelineId:
          type: string
        pipelineName:
          type: string
        stageId:
          type: string
        stageName:
          type: string
        idleDays:
          type: integer
        assignedTo:
          type: [ string, "null" ]
        contactId:
          type: [ string, "null" ]
        expectedCloseDate:
          type: [ string, "null" ]
          format: date-time
        updatedAt:
          type: string
          format: date-time
          description: The deal's version. Send it back as expectedUpdatedAt on PATCH /deals/{id} so a newer change is never overwritten (409 deal_changed).
        issues:
          type: array
          items:
            type: string
    PipelineHealthLegacyRiskyDeal:
      type: object
      deprecated: true
      properties:
        id:
          type: string
        title:
          type: string
        value:
          type: number
        stageName:
          type: string
        ownerName:
          type: [ string, "null" ]
        contactName:
          type: [ string, "null" ]
        idleDays:
          type: integer
        risks:
          type: array
          items:
            type: object
            properties:
              type:
                type: string
              label:
                type: string
    DialerCallMatch:
      type: object
      description: Why this row matched the search `q` (the best match; name, number, agent, transcript in that order).
      required: [ field ]
      properties:
        field:
          type: string
          enum: [ name, number, agent, transcript ]
        snippet:
          type: string
          description: Transcript matches only. About 90 characters around the first hit; a leading or trailing ellipsis marks a cut side.
        ranges:
          type: array
          description: >-
            [start, end) offsets in Unicode CODE POINTS (not UTF-16 units) of the matched words. For a transcript match they index into `snippet`; for a name or agent match they index into the contact's / agent's "First Last" name.
          items:
            type: array
            minItems: 2
            maxItems: 2
            items:
              type: integer
              minimum: 0
    DialerCallListItem:
      type: object
      required: [ id, direction, fromNumber, toNumber, status, hasRecording, hasVoicemail, createdAt ]
      properties:
        id: { type: string, format: uuid }
        contactId: { type: [ string, "null" ], format: uuid }
        userId: { type: [ string, "null" ], format: uuid }
        direction: { type: string }
        fromNumber: { type: string }
        toNumber: { type: string }
        status: { type: string }
        duration: { type: [ integer, "null" ] }
        notes: { type: [ string, "null" ] }
        hasRecording: { type: boolean }
        hasVoicemail: { type: boolean }
        voicemailReadAt: { type: [ string, "null" ], format: date-time }
        voicemailDeletedAt: { type: [ string, "null" ], format: date-time }
        transcriptionText: { type: [ string, "null" ] }
        transcriptionUrl: { type: [ string, "null" ] }
        disposition: { type: [ string, "null" ] }
        dncOverride: { type: boolean }
        destinationCallSid: { type: [ string, "null" ] }
        transferCallSid: { type: [ string, "null" ] }
        transferStatus: { type: [ string, "null" ] }
        transferTargetNumber: { type: [ string, "null" ] }
        conferenceSid: { type: [ string, "null" ] }
        startedAt: { type: [ string, "null" ], format: date-time }
        endedAt: { type: [ string, "null" ], format: date-time }
        createdAt: { type: string, format: date-time }
        contact:
          type: [ object, "null" ]
          description: The linked contact, or null (no contact, or one the caller may not see).
        user:
          type: [ object, "null" ]
          description: The agent, or null.
        match:
          description: Present only when `q` was sent. Null when the row matched by a rule that has nothing to show.
          oneOf:
            - $ref: "#/components/schemas/DialerCallMatch"
            - type: "null"
    DialerCallsPage:
      type: object
      required: [ data, meta ]
      properties:
        data:
          type: array
          items: { $ref: "#/components/schemas/DialerCallListItem" }
        meta:
          type: object
          required: [ page, perPage, total, totalPages ]
          properties:
            page: { type: integer }
            perPage: { type: integer }
            total: { type: integer }
            totalPages: { type: integer }
            incomplete:
              type: boolean
              description: True only when the NUMBER branch of a search matched more than 5,000 calls and only the newest 5,000 of those were used. Name, agent and transcript matches are never capped; `total` is then a lower bound. Narrow the period.
            incompleteReason:
              type: string
              enum: [ number_matches_capped ]
              description: Present with `incomplete`; names which branch was capped.
    DialerHistoryPage:
      type: object
      description: The `data` member of the response envelope.
      required: [ data, meta, stats ]
      properties:
        data:
          type: array
          items: { $ref: "#/components/schemas/DialerCallListItem" }
        meta:
          type: object
          required: [ page, per_page, total ]
          properties:
            page: { type: integer }
            per_page: { type: integer }
            total: { type: integer }
            incomplete:
              type: boolean
              description: True only when the NUMBER branch of a search matched more than 5,000 calls and only the newest 5,000 of those were used. Name, agent and transcript matches are never capped; `total` is then a lower bound. Narrow the period.
            incompleteReason:
              type: string
              enum: [ number_matches_capped ]
              description: Present with `incomplete`; names which branch was capped.
        stats:
          type: object
          required: [ total, inbound, outbound ]
          properties:
            total: { type: integer }
            inbound: { type: integer }
            outbound: { type: integer }
            avgTalkSeconds: { type: integer }
    DataEnvelope:
      type: object
      properties:
        data:
          description: Response payload (shape varies by endpoint)

    FormIntake:
      type: object
      description: A WordPress form intake address
      properties:
        id:
          type: string
          format: uuid
        name:
          type: string
        url:
          type: string
          format: uri
          nullable: true
          description: The full intake address while the intake is active (the credential); null once revoked
          example: https://conduyt.app/api/v1/webhooks/inbound/forms/wpf_0123456789abcdefghijklmnopqrstuvwxyzABCDEFG
        defaultTag:
          type: string
          nullable: true
        source:
          type: string
        assignedTo:
          type: string
          format: uuid
          nullable: true
        assignee:
          type: object
          nullable: true
          properties:
            id:
              type: string
              format: uuid
            name:
              type: string
        status:
          type: string
          enum: [ active, revoked ]
        createdAt:
          type: string
          format: date-time
        revokedAt:
          type: string
          format: date-time
          nullable: true
        lastReceivedAt:
          type: string
          format: date-time
          nullable: true
        receivedCount:
          type: integer

    FormIntakeError:
      type: object
      required: [ ok, error ]
      properties:
        ok:
          type: boolean
          enum: [ false ]
        error:
          type: string

    MeResponseData:
      type: object
      description: The `data` payload of GET /users/me and GET /auth/me — identical for both (one handler, re-exported).
      properties:
        user:
          type: object
          description: The caller's own User record (`isSuperAdmin` is checked server-side but stripped from this response).
          properties:
            id:
              type: string
              format: uuid
            email:
              type: string
              format: email
            firstName:
              type:
                - string
                - "null"
            lastName:
              type:
                - string
                - "null"
            avatarUrl:
              type:
                - string
                - "null"
            isActive:
              type: boolean
            emailVerified:
              type: boolean
            createdAt:
              type: string
              format: date-time
            tourSeenAt:
              type:
                - string
                - "null"
              format: date-time
              description: Null until this person's first product tour ends.
            phone:
              type:
                - string
                - "null"
            birthdayMonth:
              type:
                - integer
                - "null"
            birthdayDay:
              type:
                - integer
                - "null"
        account:
          type:
            - object
            - "null"
          description: The current account. `account.name` is the account's display name.
          properties:
            id:
              type: string
              format: uuid
            name:
              type: string
              description: The account's display name.
            slug:
              type: string
            plan:
              type: string
            domain:
              type:
                - string
                - "null"
            brandFavicon:
              type:
                - string
                - "null"
            createdAt:
              type: string
              format: date-time
        role:
          type: string
        permissions:
          description: >-
            The caller's resolved permission grant, stored and returned exactly as the account_members row holds it: either the legacy shape (an array of permission-key strings, commonly `[]`) or the current shape (an object map of module → action → boolean). Never a fixed set of keys — check which shape you got before reading it.
          oneOf:
            - type: array
              items:
                type: string
            - type: object
        leadVisibilityMode:
          type: string
          enum: [ owned, shared ]
          description: Mirrors server-side lead-visibility gating (e.g. whether the calendar's Manage View / other-people's-data views apply).
        apiKey:
          type:
            - object
            - "null"
          description: Present only when authenticated with an API key; null for a browser session.
          properties:
            id:
              type: string
            name:
              type: string
            tier:
              type: string
            scopes:
              type: array
              items:
                type: string
            role:
              type: string
            rateLimit:
              type: integer
            usageCount:
              type: integer
            lastUsedAt:
              type:
                - string
                - "null"
              format: date-time
        accounts:
          type: array
          description: Every account this caller is a member of. A scoped API key sees only the single account it belongs to.
          items:
            type: object
            properties:
              id:
                type: string
                format: uuid
              name:
                type: string
              slug:
                type: string
              plan:
                type: string
              isComp:
                type: boolean
              role:
                type: string
              isMember:
                type: boolean
        isImpersonating:
          type: boolean
        originalUserId:
          type:
            - string
            - "null"
          format: uuid
          description: The real super-admin's user id while impersonating another account; null otherwise.
        senderIdentity:
          type:
            - object
            - "null"
          description: Always null for an API-key caller (composers aren't rendered for agents). What a manual SMS/email send currently goes out as for a session caller.
          properties:
            sms:
              type:
                - object
                - "null"
              properties:
                fromNumber:
                  type: string
                dedicated:
                  type: boolean
                twilio:
                  type: boolean
                  description: Whether the account has native Twilio configured (a valid transport).
                iphoneLine:
                  type:
                    - object
                    - "null"
                  properties:
                    lineId:
                      type: string
                    phoneNumber:
                      type: string
                    name:
                      type:
                        - string
                        - "null"
                    voice:
                      type: object
                      properties:
                        transport:
                          type: string
                          enum: [ twilio, facetime ]
                        callerId:
                          type: string
                whatsapp:
                  type:
                    - object
                    - "null"
                  properties:
                    phoneNumber:
                      type: string
                fromk:
                  type:
                    - object
                    - "null"
                  properties:
                    phoneNumber:
                      type: string
            email:
              type:
                - object
                - "null"
              properties:
                address:
                  type: string
                name:
                  type:
                    - string
                    - "null"
                personal:
                  type: boolean
        repProfile:
          type:
            - object
            - "null"
          description: The caller's rep-profile merge fields on their CURRENT membership ({{user.position}}, {{user.mobilePhone}}, {{user.custom1..4}}).
          properties:
            position:
              type:
                - string
                - "null"
            mobilePhone:
              type:
                - string
                - "null"
            custom1:
              type:
                - string
                - "null"
            custom2:
              type:
                - string
                - "null"
            custom3:
              type:
                - string
                - "null"
            custom4:
              type:
                - string
                - "null"

    PublicBookingDocumentsError:
      type: object
      required: [ error ]
      properties:
        error:
          type: string
        code:
          type: string
          description: A machine code where one applies (documents_unavailable, documents_in_progress, booking_changed, booking_gone)
        reason:
          type: string
          description: With booking_gone — booking_cancelled, contact_forgotten or appointment_redacted
        drift:
          type: string
          description: With booking_changed — what moved (contact_changed, host_changed, page_changed, host_gone, contact_gone)
        retryAfter:
          type: integer
          description: With 429 — seconds until the limiter resets
    BookingDocumentMint:
      type: object
      required: [ uploadUrl, pointer, name, size, contentType, kind, expiresAt, expiresIn ]
      properties:
        uploadUrl:
          type: string
          description: The presigned PUT (10 minutes)
        pointer:
          type: string
          description: The private-storage pointer to bind with the documents operation
        name:
          type: string
        size:
          type: integer
        contentType:
          type: string
        kind:
          type: string
          enum: [ bank_statement, funding_agreement ]
        expiresAt:
          type: string
          format: date-time
        expiresIn:
          type: integer
    BookingDocumentMintEnvelope:
      type: object
      required: [ data ]
      properties:
        data:
          $ref: "#/components/schemas/BookingDocumentMint"
    BookingDocumentSkip:
      type: object
      required: [ pointer, reason ]
      properties:
        pointer:
          type: string
        reason:
          type: string
          enum: [ invalid_pointer, invalid_kind, duplicate, limit, upload_missing, rejected, pointer_in_use, storage_unavailable, budget ]
    BookingDocumentRecord:
      type: object
      required: [ pointer, name, kind, size, boundAt ]
      properties:
        pointer:
          type: string
        name:
          type: string
        kind:
          type: string
          enum: [ bank_statement, funding_agreement ]
        size:
          type: integer
        boundAt:
          type: string
          format: date-time
    BookingDocumentsBind:
      type: object
      required: [ attached, skipped, documents ]
      properties:
        attached:
          type: integer
          description: Documents attached by this call (a pointer already bound counts once)
        skipped:
          type: array
          items:
            $ref: "#/components/schemas/BookingDocumentSkip"
        documents:
          type: array
          description: Every document the booking holds after this call
          items:
            $ref: "#/components/schemas/BookingDocumentRecord"
    BookingDocumentsBindEnvelope:
      type: object
      required: [ data ]
      properties:
        data:
          $ref: "#/components/schemas/BookingDocumentsBind"

    DealBoardSnapshot:
      type: object
      description: "(GET /deals?board_snapshot=true) every column named in board_columns, in that order, read from one database snapshot: a deal is in exactly one column. Each column's deals are exactly what GET /deals?stage=<stageId>&per_page=<limit>&rows_only=true answers."
      required:
        - columns
        - meta
      additionalProperties: false
      properties:
        columns:
          type: array
          items:
            type: object
            required:
              - stageId
              - limit
              - deals
            additionalProperties: false
            properties:
              stageId:
                type: string
                format: uuid
              limit:
                type: integer
                minimum: 1
                maximum: 1000
                description: the rows asked for this column; deals.length equal to limit means the column may hold more
              deals:
                type: array
                items: {}
        meta:
          type: object
          required:
            - board_snapshot
          additionalProperties: false
          properties:
            board_snapshot:
              type: boolean
              enum:
                - true

    PaginatedResponse:
      type: object
      properties:
        data:
          type: object
          properties:
            data:
              type: array
              items: {}
            meta:
              $ref: "#/components/schemas/PaginationMeta"

    PaginationMeta:
      type: object
      properties:
        page:
          type: integer
        per_page:
          type: integer
        total:
          type: integer
        total_capped:
          type: boolean
          description: Present on lists that support a capped count (GET /activities?count_mode=capped). True when total is a lower bound (1000) because more rows match.

    AuthResponse:
      type: object
      properties:
        data:
          type: object
          properties:
            user:
              type: object
              properties:
                id:
                  type: string
                  format: uuid
                email:
                  type: string
                  format: email
                firstName:
                  type: string
                lastName:
                  type: string
            account:
              type: object
              properties:
                id:
                  type: string
                  format: uuid
                name:
                  type: string
                slug:
                  type: string
                plan:
                  type: string
            role:
              type: string
            accounts:
              type: array
              items:
                type: object
                properties:
                  id:
                    type: string
                    format: uuid
                  name:
                    type: string
                  slug:
                    type: string
                  plan:
                    type: string
                  role:
                    type: string

    # ── Core Entity Schemas ──

    ContactRead:
      description: GET /contacts/{id}. The stored contact row passes through as is (every column is typed here, nullable ones null when unset); only hasOutboundSms and hasOutboundEmail are guaranteed present. The tags, the owner and the facts the read computes are joined in beside it.
      type: object
      additionalProperties: true
      required: [ hasOutboundSms, hasOutboundEmail ]
      properties:
        id:
          type: string
          format: uuid
        accountId:
          type: string
          format: uuid
        firstName:
          type: [ string, "null" ]
        lastName:
          type: [ string, "null" ]
        email:
          type: [ string, "null" ]
        phone:
          type: [ string, "null" ]
        company:
          type: [ string, "null" ]
        companyId:
          type: [ string, "null" ]
          format: uuid
        jobTitle:
          type: [ string, "null" ]
        addressLine1:
          type: [ string, "null" ]
        addressLine2:
          type: [ string, "null" ]
        city:
          type: [ string, "null" ]
        state:
          type: [ string, "null" ]
        zip:
          type: [ string, "null" ]
        country:
          type: string
        timezone:
          type: [ string, "null" ]
        timezoneSource:
          type: [ string, "null" ]
        avatarUrl:
          type: [ string, "null" ]
        source:
          type: [ string, "null" ]
        territory:
          type: [ string, "null" ]
        customFields:
          type: object
          additionalProperties: true
        metadata:
          type: object
          additionalProperties: true
        leadScore:
          type: integer
        lineTypeClaimUntil:
          type: [ string, "null" ]
          format: date-time
        optedOutSms:
          type: boolean
        optedOutEmail:
          type: boolean
        emailOptInAt:
          type: [ string, "null" ]
          format: date-time
        lastContactedAt:
          type: [ string, "null" ]
          format: date-time
        lastCallDisposition:
          type: [ string, "null" ]
        lastInboundAt:
          type: [ string, "null" ]
          format: date-time
        lastOutboundAt:
          type: [ string, "null" ]
          format: date-time
        conversationLastReadAt:
          type: [ string, "null" ]
          format: date-time
        assignedTo:
          type: [ string, "null" ]
          format: uuid
        collaborators:
          type: array
          items:
            type: string
            format: uuid
        legacyStatus:
          type: [ string, "null" ]
        masterStatus:
          type: string
        wonDealId:
          type: [ string, "null" ]
          format: uuid
        masterStatusChangedAt:
          type: [ string, "null" ]
          format: date-time
        lastActionAt:
          type: [ string, "null" ]
          format: date-time
        lastContactAttemptAt:
          type: [ string, "null" ]
          format: date-time
        pooledAt:
          type: [ string, "null" ]
          format: date-time
        assignedAt:
          type: [ string, "null" ]
          format: date-time
        pooledFrom:
          type: [ string, "null" ]
          format: uuid
        pooledAttemptFloor:
          type: [ string, "null" ]
          format: date-time
        masterStatusReason:
          type: [ string, "null" ]
        externalBackend:
          type: [ boolean, "null" ]
        language:
          type: [ string, "null" ]
        doNotContact:
          type: [ boolean, "null" ]
        doNotContactReason:
          type: [ string, "null" ]
        doNotContactById:
          type: [ string, "null" ]
          format: uuid
        doNotContactAt:
          type: [ string, "null" ]
          format: date-time
        deletedAt:
          type: [ string, "null" ]
          format: date-time
        createdAt:
          type: string
          format: date-time
        revision:
          type: integer
        updatedAt:
          type: string
          format: date-time
        tags:
          type: array
          description: The contact's tags (the tag rows themselves, not the join rows).
          items:
            type: object
            required: [ id, accountId, name, color, description, createdAt, mergedIntoId, mergedAt ]
            properties:
              id:
                type: string
                format: uuid
              accountId:
                type: string
                format: uuid
              name:
                type: string
              color:
                type: string
              description:
                type: [ string, "null" ]
              createdAt:
                type: string
                format: date-time
              mergedIntoId:
                type: [ string, "null" ]
                format: uuid
              mergedAt:
                type: [ string, "null" ]
                format: date-time
        assignedUser:
          type: [ object, "null" ]
          description: The owning user, null when unassigned.
          required: [ id, firstName, lastName, email ]
          properties:
            id:
              type: string
              format: uuid
            firstName:
              type: [ string, "null" ]
            lastName:
              type: [ string, "null" ]
            email:
              type: string
        sourceLists:
          type: array
          description: Smart Lists this lead was imported from. Always empty for a caller who cannot manage Smart Lists.
          items:
            type: object
            required: [ id, name, addedAt ]
            properties:
              id:
                type: string
                format: uuid
              name:
                type: string
              addedAt:
                type: string
                format: date-time
        recentActivities:
          type: array
          description: The five newest activities, newest first.
          items:
            type: object
            required: [ id, type, title, description, createdAt ]
            properties:
              id:
                type: string
                format: uuid
              type:
                type: string
              title:
                type: string
              description:
                type: [ string, "null" ]
              createdAt:
                type: string
                format: date-time
        hasOutboundSms:
          type: boolean
          description: true when at least one outbound SMS to this contact was proven sent; drives the Message check context (false = the first text, true = a conversation).
        hasOutboundEmail:
          type: boolean
          description: true when at least one outbound email to this contact was proven sent; drives the email Message check context (true = a conversation, so a genuine "Re:" reply is not flagged as a fake one).
        doNotContactBy:
          type: [ object, "null" ]
          description: Who switched on Do not contact, null when nobody did or the user is gone.
          required: [ id, firstName, lastName ]
          properties:
            id:
              type: string
              format: uuid
            firstName:
              type: [ string, "null" ]
            lastName:
              type: [ string, "null" ]
        _visibility:
          type: object
          required: [ editable ]
          properties:
            editable:
              type: boolean
              description: Whether the caller may edit this contact.
    ContactCreate:
      type: object
      properties:
        firstName:
          type: string
          maxLength: 100
        lastName:
          type: string
          maxLength: 100
        email:
          type: string
          format: email
          maxLength: 254
        phone:
          type: string
          maxLength: 30
        company:
          type: string
          maxLength: 200
        companyId:
          type: string
          format: uuid
        jobTitle:
          type: string
          maxLength: 150
        source:
          type: string
          maxLength: 100
        addressLine1:
          type: string
          maxLength: 200
        addressLine2:
          type: string
          maxLength: 200
        city:
          type: string
          maxLength: 100
        state:
          type: string
          maxLength: 100
        zip:
          type: string
          maxLength: 20
        country:
          type: string
          maxLength: 2
        assignedTo:
          type: string
          format: uuid
        tags:
          type: array
          items:
            type: string
          maxItems: 100
        customFields:
          type: object
          description: Key-value pairs for custom fields. Max 100KB.

    ContactUpdate:
      allOf:
        - $ref: "#/components/schemas/ContactCreate"
        - type: object
          properties:
            country:
              type: string
              minLength: 1
              pattern: "\\S"
              description: A non-empty country. It cannot be cleared (null or blank is refused with `country_invalid`).
            avatarUrl:
              type: string
              format: uri
              maxLength: 2048
            optedOutSms:
              type: boolean
            optedOutEmail:
              type: boolean
            metadata:
              type: object
            expectedRevision:
              type: integer
              minimum: 0
              description: >-
                Optional optimistic-concurrency pin: the contact's `revision` as the caller last read it (returned by GET, list and PATCH). A database trigger bumps the revision whenever a column a person could be looking at changes, whichever writer ran it (so, unlike `updatedAt`, raw-SQL writers move it), and leaves it alone for background-maintained stamps (message clocks, Last Action, lead score, pool and assignment stamps), so an arriving text does not make a save conflict. When it no longer matches, the request is refused with 409 `code: "contact_changed"` and nothing is written. Omit it for last-write-wins per field.

    Company:
      type: object
      properties:
        id:
          type: string
          format: uuid
        name:
          type: string
        domain:
          type: string
        industry:
          type: string
        size:
          type: string
          enum: [ "1-10", "11-50", "51-200", "201-500", "501-1000", "1001+" ]
        website:
          type: string
          format: uri
        phone:
          type: string
        address:
          type: string
        city:
          type: string
        state:
          type: string
        zip:
          type: string
        country:
          type: string
          default: US
        description:
          type: string
        customFields:
          type: object
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time

    CompanyCreate:
      type: object
      required: [ name ]
      properties:
        name:
          type: string
        domain:
          type: string
        industry:
          type: string
        size:
          type: string
          enum: [ "1-10", "11-50", "51-200", "201-500", "501-1000", "1001+" ]
        website:
          type: string
          format: uri
        phone:
          type: string
        address:
          type: string
        city:
          type: string
        state:
          type: string
        zip:
          type: string
        country:
          type: string
        description:
          type: string
        customFields:
          type: object

    Deal:
      type: object
      properties:
        id:
          type: string
          format: uuid
        contactId:
          type: string
          format: uuid
        companyId:
          type: string
          format: uuid
        pipelineId:
          type: string
          format: uuid
        stageId:
          type: string
          format: uuid
        title:
          type: string
        value:
          type: number
          format: double
          description: Deal value as decimal
        currency:
          type: string
          default: USD
        status:
          type: string
          enum: [ open, won, lost ]
          default: open
        priority:
          type: string
          enum: [ low, medium, high, urgent ]
          default: medium
        expectedCloseDate:
          type: string
          format: date-time
        appointmentAt:
          type: string
          format: date-time
          nullable: true
          description: >-
            Appointment date/time for THIS deal (ISO 8601 with offset), pushed by the external booking/AI layer. Drives the missed-appointment clock. Send null or "" to clear.
        nextAppointmentAt:
          type: [ string, "null" ]
          format: date-time
          readOnly: true
          description: "(GET /deals) The booked appointment the deal's next step reads: the LINKED appointment's start while it is scheduled or confirmed, else appointmentAt when no appointment is linked. Authorisation: a linked appointment's time is shown only to a caller with calendar:view whose GET /appointments would show that appointment; for anyone else it is null (see hasNextStep)."
        hasNextStep:
          type: boolean
          readOnly: true
          description: "(GET /deals) Whether the deal has a next step booked (an open task, or a booked appointment from a day ago on): the Needs next action rule's own answer, given to every deals:view caller even when nextAppointmentAt is withheld."
        stageEnteredAt:
          type: string
          format: date-time
          nullable: true
          readOnly: true
          description: >-
            When the deal entered its CURRENT stage. Maintained by the database on every stage change; not client-writable. Dwell/chase automations read this instead of updatedAt, which any unrelated edit resets.
        stageEnteredAtExact:
          type: boolean
          readOnly: true
          description: >-
            True when stageEnteredAt is an observed stage transition; false when it is a backfill estimate. Dwell scheduling must require true.
        assignedTo:
          type: string
          format: uuid
        customFields:
          type: object
        lostReason:
          type: string
        wonAt:
          type: string
          format: date-time
        lostAt:
          type: string
          format: date-time
        sortOrder:
          type: integer
          description: Kanban column sort position
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time

    DealCreate:
      type: object
      required: [ title, pipelineId, stageId ]
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 200
        contactId:
          type: string
          format: uuid
        pipelineId:
          type: string
          format: uuid
        stageId:
          type: string
          format: uuid
        value:
          oneOf:
            - type: number
            - type: string
        currency:
          type: string
          maxLength: 10
        status:
          type: string
          maxLength: 30
        priority:
          type: string
          maxLength: 30
        expectedCloseDate:
          type: string
          format: date-time
        appointmentAt:
          type: string
          format: date-time
          nullable: true
          description: >-
            Appointment date/time for THIS deal (ISO 8601 with offset), pushed by the external booking/AI layer. Drives the missed-appointment clock. Send null or "" to clear.
        assignedTo:
          type: string
          format: uuid
        customFields:
          type: object

    DealUpdate:
      type: object
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 200
        contactId:
          type: string
          format: uuid
        stageId:
          type: string
          format: uuid
        value:
          oneOf:
            - type: number
            - type: string
        currency:
          type: string
        status:
          type: string
        priority:
          type: string
        expectedCloseDate:
          type: string
          format: date-time
        appointmentAt:
          type: string
          format: date-time
          nullable: true
          description: >-
            Appointment date/time for THIS deal (ISO 8601 with offset), pushed by the external booking/AI layer. Drives the missed-appointment clock. Send null or "" to clear.
        assignedTo:
          type: string
          format: uuid
        lostReason:
          type: string
          maxLength: 500
        customFields:
          type: object
          description: >-
            Patch semantics per key: the keys sent replace those keys (send null to clear one); keys not sent keep their current values, including values written by another writer while this request was in flight.
        sortOrder:
          type: integer
          description: Kanban column sort position
        expectedUpdatedAt:
          type: string
          format: date-time
          description: >-
            Optional optimistic-concurrency pin: the deal's `updatedAt` as the caller last read it. When it no longer matches, the request is refused with 409 `code: "deal_changed"` and nothing is written. Omit it for last-write-wins per field.
        expectedStageId:
          type: string
          format: uuid
          description: >-
            The stage the caller's move was chosen against: refused with 409 (nothing written) when the deal is no longer in it.
        checkOrigin:
          type: string
          enum: [ stale, unassigned, missing_close_date, missing_contact ]
          description: >-
            Pipeline health quick fix: the health check this edit fixes. The body must be exactly that check's fix and `expectedUpdatedAt`: stale = `stageId` (+ optional `expectedStageId`), unassigned = `assignedTo`, missing_close_date = `expectedCloseDate`, missing_contact = `contactId`, each set to a value; anything else is a 400 `health_fix_mismatch` (nothing read or written). A deal at another version is refused with 409 `deal_changed`, one that no longer fails the check with 409 `deal_check_cleared`, both carrying the deal's current health row (HealthFixRefusal).

    Pipeline:
      type: object
      properties:
        id:
          type: string
          format: uuid
        name:
          type: string
        description:
          type: string
        isDefault:
          type: boolean
        sortOrder:
          type: integer
        automationOnly:
          type: boolean
          description: "Automation-only pipeline: only automations, API keys and owners / admins move or edit its cards"
        color:
          type: string
          nullable: true
          description: "One of the pipeline palette colours (the dot in the board's pipeline menu); null = not chosen yet (shown with the first unused palette colour)"
        stages:
          type: array
          items:
            $ref: "#/components/schemas/PipelineStage"
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time

    PipelineStage:
      type: object
      properties:
        id:
          type: string
          format: uuid
        pipelineId:
          type: string
          format: uuid
        name:
          type: string
        color:
          type: string
          default: "#3B82F6"
        sortOrder:
          type: integer
        isWon:
          type: boolean
        isLost:
          type: boolean

    PipelineStageCreate:
      type: object
      required: [ name ]
      properties:
        name:
          type: string
        color:
          type: string
        sortOrder:
          type: integer
        isWon:
          type: boolean
        isLost:
          type: boolean

    Task:
      type: object
      properties:
        id:
          type: string
          format: uuid
        title:
          type: string
        description:
          type: string
        status:
          type: string
          enum: [ todo, in_progress, done ]
        priority:
          type: string
          enum: [ low, medium, high, urgent ]
        dueDate:
          type: string
          format: date-time
        assignedTo:
          type: string
          format: uuid
        contactId:
          type: string
          format: uuid
        dealId:
          type: string
          format: uuid
        completedAt:
          type: string
          format: date-time
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time

    TaskCreate:
      type: object
      description: "The POST /tasks body exactly as the route reads it (lib/validators/task.ts createTaskSchema); unknown keys are ignored. Any other shape is a 400 \"Invalid task payload\"; the health-fix fields are judged first (400 `health_fix_mismatch`)."
      required: [ title ]
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 500
          description: Trimmed; blank after trimming is refused.
        description:
          type: string
          maxLength: 5000
        status:
          type: string
          enum: [ todo, in_progress, done ]
          default: todo
        priority:
          type: string
          enum: [ low, medium, high, urgent ]
          default: medium
        dueDate:
          type: string
          description: "Any parseable date: a date-only `YYYY-MM-DD` is stored as noon UTC that day; a date-time is stored as given."
        assignedTo:
          description: "A member's user id, `@me` (the caller) or `@owner` (the account owner); null or absent = unassigned (the account's task assignment rules may still assign it). Assigning to someone else needs tasks.assign."
          oneOf:
            - type: string
              format: uuid
            - type: string
              enum: [ "@me", "@owner" ]
            - type: "null"
        contactId:
          type: string
          format: uuid
          nullable: true
        dealId:
          type: string
          format: uuid
          nullable: true
        checkOrigin:
          type: string
          enum: [ high_value_idle, needs_action ]
          description: "Pipeline health quick fix (\"Set next action\"): the health check this task fixes. Needs `dealId` and `expectedDealUpdatedAt`. The task is created only while, under the deal's next-action lock, the deal is still at that version (else 409 `deal_changed`), still has no next action, i.e. no open task and no appointment booked from a day ago on (else 409 `deal_has_next_action`), and still fails this check (else 409 `deal_check_cleared`). Send an Idempotency-Key so a retry after a lost response replays the first task."
        expectedDealUpdatedAt:
          type: string
          format: date-time
          description: "With `checkOrigin` only: the deal's `updatedAt` as the health row carried it (PipelineHealthDeal.updatedAt)."

    TaskUpdate:
      type: object
      description: "The PATCH /tasks/{id} body exactly as the route reads it (lib/validators/task.ts updateTaskSchema): every TaskCreate field optional, without the create-only health-fix fields (`checkOrigin`, `expectedDealUpdatedAt`)."
      properties:
        title:
          type: string
          minLength: 1
          maxLength: 500
        description:
          type: string
          maxLength: 5000
        status:
          type: string
          enum: [ todo, in_progress, done ]
        priority:
          type: string
          enum: [ low, medium, high, urgent ]
        dueDate:
          type: string
        assignedTo:
          oneOf:
            - type: string
              format: uuid
            - type: string
              enum: [ "@me", "@owner" ]
            - type: "null"
        contactId:
          type: string
          format: uuid
          nullable: true
        dealId:
          type: string
          format: uuid
          nullable: true

    HealthFixRefusal:
      type: object
      description: "A Pipeline health quick fix refused with nothing written (409). `row` is the deal's CURRENT health row (null when the caller can no longer see the deal), so the caller can show what changed and choose again against `row.updatedAt`."
      required: [ error, code, row ]
      properties:
        error:
          type: string
        code:
          type: string
          enum: [ deal_changed, deal_has_next_action, deal_check_cleared ]
          description: "deal_changed: the deal is no longer at the pinned version; deal_has_next_action: it already has an open task or an appointment booked from a day ago on; deal_check_cleared: it no longer fails the check the fix came from."
        updatedAt:
          type: string
          format: date-time
          description: "deal_changed only: the deal's current version."
        row:
          oneOf:
            - $ref: "#/components/schemas/PipelineHealthDeal"
            - type: "null"

    Note:
      type: object
      properties:
        id:
          type: string
          format: uuid
        body:
          type: string
        isPinned:
          type: boolean
        contactId:
          type: string
          format: uuid
        dealId:
          type: string
          format: uuid
        userId:
          type: string
          format: uuid
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time

    NoteCreate:
      type: object
      required: [ body ]
      properties:
        body:
          type: string
          description: Note body text (max 50KB)
        contactId:
          type: string
          format: uuid
        dealId:
          type: string
          format: uuid
        isPinned:
          type: boolean
          default: false

    Tag:
      type: object
      properties:
        id:
          type: string
          format: uuid
        name:
          type: string
        color:
          type: string
          default: "#6B7280"
        createdAt:
          type: string
          format: date-time

    MessageCreate:
      type: object
      required: [ contactId, channel, direction, body ]
      properties:
        contactId:
          type: string
          format: uuid
        channel:
          type: string
          enum: [ sms, email ]
        direction:
          type: string
          enum: [ inbound, outbound ]
        body:
          type: string
          description: Message body (max 100KB)
        subject:
          type: string
          maxLength: 500
        fromNumber:
          type: string
          maxLength: 30
        toNumber:
          type: string
          maxLength: 30
        fromEmail:
          type: string
          format: email
        toEmail:
          type: string
          format: email
        provider:
          type: string
        providerId:
          type: string
        status:
          type: string
        scheduledAt:
          type: string
          format: date-time
        bodyHtml:
          type: string
          description: The email's HTML body
        templateId:
          type: string
          format: uuid
          description: "Outbound email composed from an email template (active, this account's; else 404). bodyHtml stays the sender's own base; the template's metadata (subject B, preheader, custom head, footer; the marker in bodyHtml wins over body's) is applied when the email is sent or scheduled."
        subjectEdited:
          type: boolean
          description: "With templateId, a tri-state. true: the subject is the sender's own and is sent verbatim. false: the subject is the template's as inserted, so its A/B subject pick applies. Absent: a supplied subject is sent verbatim; an omitted subject gets the template's A/B pick."
        signature:
          type: string
          enum: [ new, reply ]
          description: "Outbound email only: append the sender's saved email signature (GET /me/email-signature), rendered at send time from the live sources (profile, membership, branding, Company details, booking pages), once, when useInCompose and the matching options.compose flag (newEmails for new, replies for reply) are on. A reply gets it above the quoted history; an earlier signature inside the quoted history never suppresses it. Absent = no signature. 422 signature_too_large when the current sources make the signature too large to render (nothing is sent)."

    Message:
      type: object
      description: The persisted message row. The database record carries additional bookkeeping columns beyond those listed here.
      properties:
        id:
          type: string
          format: uuid
        accountId:
          type: string
          format: uuid
        contactId:
          type: string
          format: uuid
        direction:
          type: string
          enum: [ inbound, outbound ]
        channel:
          type: string
          enum: [ sms, email ]
        subject:
          type:
            - string
            - "null"
        body:
          type: string
        bodyHtml:
          type:
            - string
            - "null"
        fromNumber:
          type:
            - string
            - "null"
        toNumber:
          type:
            - string
            - "null"
        fromEmail:
          type:
            - string
            - "null"
        toEmail:
          type:
            - string
            - "null"
        replyTo:
          type:
            - string
            - "null"
          description: The Reply-To address used for this send (email only).
        provider:
          type:
            - string
            - "null"
          description: The delivery provider, e.g. "resend".
        providerId:
          type:
            - string
            - "null"
          description: The provider's id for this send, once accepted.
        sentBy:
          type:
            - string
            - "null"
          format: uuid
          description: The user who sent this message, when sent by a human/API caller rather than an automation.
        status:
          type: string
        deliveredAt:
          type:
            - string
            - "null"
          format: date-time
        openedAt:
          type:
            - string
            - "null"
          format: date-time
        clickedAt:
          type:
            - string
            - "null"
          format: date-time
        openCount:
          type: integer
        clickCount:
          type: integer
        scheduledAt:
          type:
            - string
            - "null"
          format: date-time
          description: Always null for this endpoint — POST /email/send has no scheduling field and never sets it.
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time

    EmailTemplateCreate:
      description: |-
        Two shapes. Built from the editor's blocks (or plain): name, channel and body are required, bodyHtml optional,
        bodyMode "blocks" or omitted. Pasted HTML (email only): name, channel "email", bodyMode "html" and html are
        required; body is optional (it defaults to the HTML's visible text).
      oneOf:
        - $ref: "#/components/schemas/EmailTemplateCreateBlocks"
        - $ref: "#/components/schemas/EmailTemplateCreateHtml"
    EmailTemplateCreateBlocks:
      type: object
      required: [ name, channel, body ]
      properties:
        name:
          type: string
        channel:
          type: string
          enum: [ sms, email ]
        subject:
          type: string
        body:
          type: string
        bodyHtml:
          type: string
        bodyMode:
          type: string
          enum: [ blocks ]
          description: 'Email only. "blocks" = built from the editor blocks: send the builder bodyHtml. Omitted = bodyHtml stored as sent.'
        category:
          type: string
        isActive:
          type: boolean
          default: true
      not:
        required: [ html ]
    EmailTemplateCreateHtml:
      type: object
      required: [ name, channel, bodyMode, html ]
      properties:
        name:
          type: string
        channel:
          type: string
          enum: [ email ]
        subject:
          type: string
        body:
          type: string
          description: Optional; defaults to the HTML's visible text.
        bodyHtml:
          type: string
          description: Optional; only its builder markers (blocks, metadata) are read and kept.
        bodyMode:
          type: string
          enum: [ html ]
        html:
          type: string
          maxLength: 102400
          description: |-
            Your own email HTML. Up to 100 KB (UTF-8 bytes; Gmail clips emails over 102 KB); no <script>. Merge fields like {{contact.firstName}} work inside it. Outlook's conditional comments (<!--[if mso]> … <![endif]-->, <!--[if !mso]><!--> … <!--<![endif]-->) and the VML / Office elements inside them are kept with their content sanitised (scripts, frames, event handlers and javascript:/data: URLs removed), while a conditional comment that cannot be read safely (html_conditional_comment) or VML outside an Outlook-only block (html_office_markup) is refused with a 400 that names it.
        category:
          type: string
        isActive:
          type: boolean
          default: true
    EmailTemplateUpdate:
      type: object
      description: |-
        Partial update: send only the fields to change. html requires bodyMode "html"; bodyMode "html" requires html;
        bodyMode "blocks" requires bodyHtml. Builder markers the request leaves out are kept from the stored template.
      properties:
        name:
          type: string
        subject:
          type: string
        body:
          type: string
        bodyHtml:
          type: string
        bodyMode:
          type: string
          enum: [ blocks, html ]
        html:
          type: string
          maxLength: 102400
        category:
          type: string
        provider:
          type: string
        isActive:
          type: boolean
      dependentRequired:
        html: [ bodyMode ]
      allOf:
        - if:
            properties:
              bodyMode:
                const: html
            required: [ bodyMode ]
          then:
            required: [ html ]
        - if:
            properties:
              bodyMode:
                const: blocks
            required: [ bodyMode ]
          then:
            required: [ bodyHtml ]
            not:
              required: [ html ]

    AutomationCreate:
      type: object
      required: [ name, triggerEvent ]
      properties:
        name:
          type: string
        description:
          type: string
        kind:
          type: string
          enum: [ native, n8n ]
          default: n8n
        triggerEvent:
          type: string
          description: "Event that triggers this automation (e.g., contact.created, deal.stage_changed)"
        triggerConditions:
          type: object
        actions:
          description: Linear array of actions (v1) or graph object (v2)
        graphVersion:
          type: integer
          enum: [ 1, 2 ]
          default: 1
        isActive:
          type: boolean
          default: true
        n8nWorkflowId:
          type: string
        n8nWebhookUrl:
          type: string
          format: uri
        schedule:
          type: string
          description: "Cron expression (5-field, UTC) for scheduled automations"
        scheduleTimezone:
          type: string
        reenrollmentRule:
          type: string
          enum: [ every_time, once, cooldown ]
          default: every_time
        cooldownDays:
          type: integer
        executionTimezone:
          type: string
        executionWindowStart:
          type: integer
          description: Hour (0-23) to start executing
        executionWindowEnd:
          type: integer
          description: Hour (0-23) to stop executing
        stopOnResponse:
          type: boolean
          default: false

    Automation:
      type: object
      properties:
        id:
          type: string
          format: uuid
        name:
          type: string
        description:
          type: string
        kind:
          type: string
          enum: [ native, n8n ]
        triggerEvent:
          type: string
        triggerConditions:
          type: object
        actions: {}
        graphVersion:
          type: integer
        isActive:
          type: boolean
        triggerCount:
          type: integer
        lastTriggeredAt:
          type: string
          format: date-time
        publishedAt:
          type: string
          format: date-time
        reenrollmentRule:
          type: string
        createdAt:
          type: string
          format: date-time
        updatedAt:
          type: string
          format: date-time

    AppointmentCreate:
      type: object
      required: [ title, startTime, endTime ]
      properties:
        title:
          type: string
        description:
          type: string
        startTime:
          type: string
          format: date-time
        endTime:
          type: string
          format: date-time
        location:
          type: string
        status:
          type: string
          enum: [ scheduled, confirmed, completed, cancelled, no_show ]
          default: scheduled
        contactId:
          type: string
          format: uuid
          description: A contact of your account; when no contact has this id it is looked up as a deal (card) of your account, and the appointment is booked for that deal (see dealId).
        dealId:
          type: string
          format: uuid
          description: The deal (card) this appointment is for. It must be in your account, visible and editable to you, not deleted and open (409 deal_closed otherwise). The appointment takes the deal's contact and is linked to the deal; the appointment.booked event carries dealId. Disagreeing with contactId or deal_id is a 400.
        deal_id:
          type: string
          format: uuid
          description: Alias of dealId.
        assignedTo:
          type: string
          format: uuid
        calendarId:
          type: string
          format: uuid

    InvoiceCreate:
      type: object
      required: [ items ]
      properties:
        invoiceNumber:
          type: string
          minLength: 1
          maxLength: 200
          description: Optional; generated when omitted. 1 to 200 characters.
        contactId:
          type: string
          format: uuid
        companyId:
          type: string
          format: uuid
        dealId:
          type: string
          format: uuid
        status:
          type: string
          enum: [ draft, sent, viewed, paid, overdue, void ]
          default: draft
        issueDate:
          type: string
          format: date-time
        dueDate:
          type: string
          format: date-time
        taxRate:
          type: number
          format: double
        currency:
          type: string
          default: USD
        notes:
          type: string
        terms:
          type: string
        items:
          type: array
          minItems: 1
          items:
            type: object
            required: [ description, quantity, unitPrice ]
            properties:
              productId:
                type: string
                format: uuid
              description:
                type: string
              quantity:
                type: number
              unitPrice:
                type: number

    Invoice:
      type: object
      properties:
        id:
          type: string
          format: uuid
        invoiceNumber:
          type: string
        status:
          type: string
        issueDate:
          type: string
          format: date-time
        dueDate:
          type: string
          format: date-time
        subtotal:
          type: number
          format: double
        taxRate:
          type: number
        taxAmount:
          type: number
        total:
          type: number
          format: double
        amountPaid:
          type: number
          format: double
        currency:
          type: string
        paidAt:
          type: string
          format: date-time
        sentAt:
          type: string
          format: date-time
        createdAt:
          type: string
          format: date-time

    ProductCreate:
      type: object
      required: [ name, price ]
      properties:
        name:
          type: string
        description:
          type: string
        sku:
          type: string
        price:
          type: number
          format: double
        currency:
          type: string
          default: USD
        unit:
          type: string
          default: unit
        taxable:
          type: boolean
          default: true
        isActive:
          type: boolean
          default: true
        metadata:
          type: object

    Product:
      type: object
      properties:
        id:
          type: string
          format: uuid
        name:
          type: string
        description:
          type: string
        sku:
          type: string
        price:
          type: number
          format: double
        currency:
          type: string
        unit:
          type: string
        taxable:
          type: boolean
        isActive:
          type: boolean
        createdAt:
          type: string
          format: date-time

    CustomFieldCreate:
      type: object
      required: [ entityType, fieldKey, label, fieldType ]
      properties:
        entityType:
          type: string
          enum: [ contact, deal ]
        fieldKey:
          type: string
          description: Machine-readable key (e.g., "industry_vertical")
        label:
          type: string
          description: Human-readable label (e.g., "Industry Vertical")
        fieldType:
          type: string
          enum: [ text, number, date, select, multiselect, boolean ]
        options:
          type: array
          items:
            type: string
          description: Options for select/multiselect fields
        isRequired:
          type: boolean
          default: false
        sortOrder:
          type: integer

    DripCampaignCreate:
      type: object
      required: [ name, provider, urlSegment, baseUrl, tagPrefix ]
      properties:
        name:
          type: string
        provider:
          type: string
        urlSegment:
          type: string
        baseUrl:
          type: string
        tagPrefix:
          type: string
        isActive:
          type: boolean
          default: true
        totalSteps:
          type: integer
          default: 9
        stepDelays:
          type: array
          items:
            type: integer
          description: "Delay in days between steps (e.g., [0,2,2,2,3,4,4,7,10])"
        sendDays:
          type: array
          items:
            type: integer
          description: "Days of week to send (1=Mon, 5=Fri)"
        sendStartHour:
          type: integer
          default: 9
        sendEndHour:
          type: integer
          default: 17
        timezone:
          type: string
          default: America/New_York
        batchSize:
          type: integer
          default: 500

    SavedReportCreate:
      type: object
      required: [ name, entity ]
      properties:
        name:
          type: string
        description:
          type: string
        entity:
          type: string
          enum: [ contacts, deals, activities, tasks, messages ]
        columns:
          type: array
          items:
            type: string
        filters:
          type: array
          items:
            type: object
        groupBy:
          type: string
        sortBy:
          type: string
        sortDir:
          type: string
          enum: [ asc, desc ]
          default: desc
        chartType:
          type: string
          enum: [ bar, line, pie, table, funnel ]
        isShared:
          type: boolean
          default: false
        isPinned:
          type: boolean
          default: false

    Webhook:
      type: object
      properties:
        id:
          type: string
          format: uuid
        url:
          type: string
          format: uri
        events:
          type: array
          items:
            type: string
        isActive:
          type: boolean
        description:
          type: string
        lastFiredAt:
          type: string
          format: date-time
        failCount:
          type: integer
        createdAt:
          type: string
          format: date-time
