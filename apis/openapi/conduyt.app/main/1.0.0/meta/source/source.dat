  # ──────────────────────────────────────────────
  # Dialer
  # ──────────────────────────────────────────────
  /dialer/token:
    post:
      operationId: getDialerToken
      summary: Get a Twilio browser token for click-to-call
      tags:
        - Dialer
      responses:
        "200":
          description: Twilio client token
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters: []

  /dialer/call:
    post:
      operationId: initiateCall
      summary: Initiate an outbound call
      tags:
        - Dialer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - toNumber
              properties:
                toNumber:
                  type: string
                contactId:
                  type: string
                  format: uuid
      responses:
        "201":
          description: Call initiated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters: []

  /dialer/history:
    get:
      operationId: getDialerHistory
      summary: Get recent call history
      description: The Call History list, with search (`q`) and filters (`recorded_only`, `disposition`, `user_id`, `date_from`, `date_to`, `direction`, `status`, and the unknown-caller filters `unmatched` and `line`). Search results are AND-ed with the tenant and contact-visibility scope.
      tags:
        - Dialer
      responses:
        "200":
          description: Recent calls
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: "#/components/schemas/DialerHistoryPage"
        "400":
          description: q over 200 characters, a repeated q / recorded_only / disposition / user_id, a non-UUID user_id, or an invalid date
      parameters:
        - name: date_from
          in: query
          required: false
          description: ISO 8601 date or date-time — only calls created on or after it (invalid = 400)
          schema:
            type: string
        - name: date_to
          in: query
          required: false
          description: ISO 8601 date or date-time — only calls created on or before it (invalid = 400)
          schema:
            type: string
        - name: direction
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: disposition
          in: query
          required: false
          description: string — exact disposition value, max 100 characters (a repeated key is a 400)
          schema:
            type: string
        - name: line
          in: query
          required: false
          description: "Our line (any formatting): only INBOUND calls to it (board #35, the toll-free counter's link). Combined with another direction it is a 400 `line_direction_conflict`; a repeated key with different values is a 400 `line_conflict`."
          schema:
            type: string
          example: "+18005550199"
        - name: mine
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
          x-default-provenance: handler_literal
        - name: q
          in: query
          required: false
          description: "string — call search (trimmed, max 200 code points, empty ignored; a repeated q is a 400). Name and agent: every word (1 to 4 words) must appear in the first or last name, in either order. Transcript: the whole phrase, and for 2 to 4 words also a transcript that contains every word. Number: digits only, needs 3 or more digits, compared with the digits of the from / to numbers and the contact phone in any format. `%`, `_` and `\\` are literal characters. With q every row carries `match`; when the number lookup reaches its 5,000-row cap `meta.incomplete` is true."
          schema:
            type: string
        - name: recorded_only
          in: query
          required: false
          description: "boolean — 1 or true: only calls with a recording or a live voicemail (a repeated key is a 400)"
          schema:
            type: boolean
        - name: status
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: unmatched
          in: query
          required: false
          description: "`1` or `true`: only calls no contact is linked to (board #35, the unknown-caller prompt's not-matched calls). A repeated key with different values is a 400 `unmatched_conflict`."
          schema:
            type: string
            enum:
              - "1"
              - "true"
        - name: user_id
          in: query
          required: false
          description: uuid — only this agent's calls (a non-UUID or repeated user_id is a 400)
          schema:
            type: string
            format: uuid

  # ──────────────────────────────────────────────
  # Calls
  # ──────────────────────────────────────────────
  /calls:
