            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  /integrations/wordpress-forms/intakes:
    get:
      operationId: listFormIntakes
      summary: List WordPress form intake addresses
      description: "Every ACTIVE intake address of the account (newest first; at most 100 exist), then the revoked history (the newest 200 revocations). Each active row carries its full `url` (the credential, to paste into the form plugin); a revoked row's `url` is null. The URLs are credentials that create and edit contacts, so listing needs what creating needs: settings.edit, contacts.create and contacts.edit; API keys need the `form-intakes` AND `contacts` scopes on a write or admin tier key."
      tags:
        - Integrations
      parameters: []
      responses:
        "200":
          description: The intake addresses
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    type: array
                    items:
                      $ref: "#/components/schemas/FormIntake"
    post:
      operationId: createFormIntake
      summary: Create a WordPress form intake address
      description: Creates a per-form intake address. The response carries the full `url` (the credential; the list returns it too while the intake is active); paste it into the form plugin's webhook settings. Requires settings.edit, contacts.create and contacts.edit (the address creates and updates contacts) and active billing; API keys need the `form-intakes` AND `contacts` scopes on a write or admin tier key. At most 100 active addresses.
      tags:
        - Integrations
      parameters: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              additionalProperties: false
              required:
                - name
              properties:
                name:
                  type: string
                  maxLength: 120
                  description: What the customer calls the form, e.g. "Contact page, Smith Roofing"
                defaultTag:
                  type: string
                  nullable: true
                  maxLength: 100
                  description: A tag name applied to every submission (created on first use) unless the submission sends its own tags
                source:
                  type: string
                  maxLength: 64
                  description: The contact source for submissions that do not send one (default "wordpress")
                assignedTo:
                  type: string
                  format: uuid
                  nullable: true
                  description: An active member who owns new contacts; null = lead routing decides
      responses:
        "201":
          description: Created; `url` is the full intake address
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: "#/components/schemas/FormIntake"
        "400":
          description: Invalid body (unknown field, missing name, too long a value, assignedTo not an active member)
        "409":
          description: The account already has 100 active intake addresses
        "503":
          description: Another intake address is being created for this account right now (the 100-active cap is counted and created one at a time); retry after Retry-After seconds
          headers:
            Retry-After:
              description: Seconds to wait before retrying
              schema:
                type: integer
          content:
            application/json:
              schema:
                type: object
                properties:
                  error:
                    type: string

  /integrations/wordpress-forms/status:
    get:
      operationId: getFormIntakeStatus
      summary: WordPress forms intake status (count only)
      description: Whether the account has any ACTIVE WordPress forms intake address, and how many. Answers a boolean and a count only, never an intake, URL or token (the intake list returns the full URLs and needs the intake-address authority; this needs only settings.view). The Connections page's WordPress forms row reads it.
      tags:
        - Integrations
      parameters: []
      responses:
        "200":
          description: The intake status
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    type: object
                    properties:
                      hasActive:
                        type: boolean
                      activeCount:
                        type: integer
        "403":
          $ref: "#/components/responses/Forbidden"
  /integrations/wordpress-forms/intakes/{id}:
    delete:
      operationId: revokeFormIntake
      summary: Revoke a WordPress form intake address
      description: 'Revokes the address: it answers 404 from now on. The row is kept (status "revoked", revokedAt) for history. Revoking a revoked address returns it unchanged. Requires settings.edit; API keys need the `form-intakes` scope.'
      tags:
        - Integrations
      parameters:
        - $ref: "#/components/parameters/IdParam"
      responses:
        "200":
          description: The revoked intake
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: "#/components/schemas/FormIntake"
        "404":
          description: No such intake in this account

  /integrations/zapier/subscribe:
    get:
      operationId: listZapierSubscriptions
      summary: List Zapier webhook subscriptions
      tags:
        - Integrations
      responses:
        "200":
          description: Active subscriptions
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters: []
    post:
      operationId: createZapierSubscription
      summary: Create a Zapier webhook subscription
      tags:
        - Integrations
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - targetUrl
                - event
              properties:
                targetUrl:
                  type: string
                  format: uri
                event:
                  type: string
      responses:
        "201":
          description: Subscription created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters: []

  /integrations/zapier/subscribe/{id}:
    delete:
      operationId: deleteZapierSubscription
      summary: Delete a Zapier subscription
      tags:
        - Integrations
      parameters:
        - $ref: "#/components/parameters/IdParam"
      responses:
        "200":
          description: Subscription deleted
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  /integrations/zapier/sample/{event}:
    get:
      operationId: getZapierSampleData
      summary: Get sample data for a Zapier event
      tags:
        - Integrations
      parameters:
        - name: event
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Sample event payload
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

