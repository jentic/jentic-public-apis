  /webhooks/manage/{id}/test:
    post:
      operationId: testWebhook
      summary: Send a test payload to a webhook
      description: "Sends a manual test delivery (is_test true, header X-Conduyt-Test) whose payload carries the top-level key _test: true. That key is reserved for this route: an event payload carrying a top-level _test key is refused (a terminal delivery whose last error starts with reserved_payload_key), never stripped or sent."
      tags:
        - Webhooks
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: event
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      responses:
        "200":
          description: Test result with status code
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  /webhooks/manage/{id}/deliveries:
    get:
      operationId: listWebhookDeliveries
      summary: List deliveries for a webhook
      tags:
        - Webhooks
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 25
            minimum: 1
            maximum: 100
          x-default-provenance: handler_literal
        - name: status
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
      responses:
        "200":
          description: Paginated webhook delivery log
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  /webhooks/replay:
    get:
      operationId: listWebhookReplayDeliveries
      summary: List webhook deliveries for replay review
      tags:
        - Webhooks
      parameters:
        - name: event_type
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 25
            minimum: 1
            maximum: 100
          x-default-provenance: handler_literal
        - name: status
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
      responses:
        "200":
          description: Paginated delivery list
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
    post:
      operationId: replayWebhooks
      summary: Replay failed or selected webhook deliveries
      description: "Re-enqueues up to 100 matching deliveries (oldest first). At least one of deliveryIds, eventType or status is required. With no status, only failed deliveries are selected. Replaying succeeded deliveries requires forceSucceededReplay with confirmSucceededReplay REPLAY_SUCCEEDED. Settlement-unconfirmed deliveries (dispatched: the request left and no outcome was recorded; unconfirmed: the stale sweep's terminal form of the same ambiguity) may already have been accepted by the receiver: they are selected only with forceDispatchedReplay and confirmDispatchedReplay REPLAY_DISPATCHED, which states the receiver was checked and did not get them. Manual test deliveries are never replayed. A consent delivery (contact.sms_number_opt_in / opt_out) is replayed only while its consent event is still the latest for the number; one superseded by a newer consent event is refused (consentOrderSupersededIds), so a replay can never reverse the subscriber's current consent state."
      tags:
        - Webhooks
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                deliveryIds:
                  type: array
                  maxItems: 100
                  items:
                    type: string
                    maxLength: 64
                eventType:
                  type: string
                  maxLength: 100
                status:
                  type: string
                  description: dispatched and unconfirmed require forceDispatchedReplay with confirmDispatchedReplay.
                  enum:
                    - failed
                    - pending
                    - dispatched
                    - unconfirmed
                fromDate:
                  type: string
                  format: date-time
                toDate:
                  type: string
                  format: date-time
                forceSucceededReplay:
                  type: boolean
                confirmSucceededReplay:
                  type: string
                  description: Must be REPLAY_SUCCEEDED when forceSucceededReplay is true.
                forceDispatchedReplay:
                  type: boolean
                  description: Also selects settlement-unconfirmed (dispatched, unconfirmed) deliveries.
                confirmDispatchedReplay:
                  type: string
                  description: Must be REPLAY_DISPATCHED when forceDispatchedReplay is true, confirming the receiver was checked and did not get them.
                forceAmbiguousSmsReplay:
                  type: boolean
                  description: Legacy webhook log ids only; re-fires parked ambiguous drip SMS rows.
                confirmAmbiguousSmsReplay:
                  type: string
                  description: Must be REPLAY_AMBIGUOUS_SMS when forceAmbiguousSmsReplay is true.
      responses:
        "200":
          description: Replay applied. data.replayed and data.deliveryIds name the deliveries re-armed; skippedIds were changed or actively claimed since selection; requiresDispatchedConfirmationIds and refusedTestDeliveryIds name requested ids refused by rule; notFoundIds name requested ids that match no delivery of the account (or none the request's filters select); consentOrderSupersededIds (with consentOrderRefusals giving each reason) name consent deliveries the consent ordering refused.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          description: No filter, an invalid field, or a force flag without its confirmation string (including status dispatched or unconfirmed without forceDispatchedReplay).
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "409":
          description: Nothing was replayed because nothing requested was replayable and at least one requested id was refused by rule (settlement-unconfirmed without the dispatched confirmation, or a manual test delivery; requested ids that match no delivery are listed in notFoundIds), or because the consent deliveries selected are no longer the latest consent event for their number (consentOrderSupersededIds).
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                  - code
                  - replayed
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - webhook_replay_refused
                  replayed:
                    type: integer
                    enum:
                      - 0
                  requiresDispatchedConfirmationIds:
                    type: array
                    items:
                      type: string
                  dispatchedMessage:
                    type: string
                  refusedTestDeliveryIds:
                    type: array
                    items:
                      type: string
                  testMessage:
                    type: string
                  notFoundIds:
                    type: array
                    items:
                      type: string
                  consentOrderSupersededIds:
                    type: array
                    items:
                      type: string
                  consentOrderRefusals:
                    type: array
                    items:
                      type: object
                      properties:
                        id:
                          type: string
                        reason:
                          type: string
                          enum:
                            - superseded
                            - consent_event_in_progress
                            - consent_event_not_on_rail
                            - consent_event_unresolved
                  consentOrderMessage:
                    type: string
                  skipped:
                    type: integer
                  skippedIds:
                    type: array
                    items:
                      type: string
        "500":
          description: The re-arm failed and was rolled back; no delivery changed (code webhook_replay_not_applied). Retry the request.
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - webhook_replay_not_applied
                  replayed:
                    type: integer
                  deliveryIds:
                    type: array
                    items:
                      type: string
      parameters: []

  /webhook-logs:
