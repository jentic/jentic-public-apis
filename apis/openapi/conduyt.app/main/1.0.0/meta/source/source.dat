  # ──────────────────────────────────────────────
  # Activities
  # ──────────────────────────────────────────────
  /activities:
    get:
      operationId: listActivities
      summary: List activities
      tags:
        - Activities
      parameters:
        - name: contact_id
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: count_mode
          in: query
          required: false
          description: "exact (default) counts every matching activity. capped stops counting at 1,000: meta.total is then at most 1000 and meta.total_capped is true when more than 1,000 match (use it for list pages that do not need the exact total; it avoids a full count over very large accounts). Any other value is a 400."
          schema:
            type: string
            enum:
              - exact
              - capped
            default: exact
          x-default-provenance: authored_operation
        - name: deal_id
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: fromDate
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
          x-default-provenance: handler_literal
        - name: search
          in: query
          required: false
          description: Full-text search query
          schema:
            type: string
        - name: toDate
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: type
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
      responses:
        "200":
          description: Paginated activity feed
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PaginatedResponse"
    post:
      operationId: createActivity
      summary: Log an activity
      tags:
        - Activities
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - type
                - title
              properties:
                type:
                  type: string
                title:
                  type: string
                description:
                  type: string
                contactId:
                  type: string
                  format: uuid
                dealId:
                  type: string
                  format: uuid
                metadata:
                  type: object
      responses:
        "201":
          description: Activity logged
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  # ──────────────────────────────────────────────
  # Messages
  # ──────────────────────────────────────────────
  /messages:
    get:
      operationId: listMessages
      summary: List messages
      tags:
        - Messages
      parameters:
        - name: channel
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: contactId
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: direction
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
          x-default-provenance: handler_literal
        - name: status
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
      responses:
        "200":
          description: Paginated messages
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PaginatedResponse"
    post:
      operationId: createMessage
      summary: Create a message record
      tags:
        - Messages
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/MessageCreate"
      responses:
        "201":
          description: Message created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "202":
          description: Accepted
          x-generated-status: true
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"
      parameters:
        - name: Idempotency-Key
          in: header
          required: false
          description: "Optional: one key per message (1-255 printable ASCII characters, not blank), reused only to retry the SAME request. Same key + same request body replays the original response (Idempotent-Replay: true); same key + a different body is refused with 422. Two DISTINCT 409s under this key, never interchangeable: (1) the ORIGINAL attempt is still being processed — wait for the Retry-After seconds given, then retry with the SAME key; (2) the key was already SPENT by a prior attempt that failed or has an unknown outcome (code idempotency_key_spent) — verify whether that attempt took effect BEFORE sending a brand-new key; resending the SAME key here only replays this 409 again, it never re-runs the request. If the wrapper's OWN write to RELEASE a failed attempt's claim cannot be confirmed, the SAME key instead answers 503 idempotency_claim_held until the held claim expires — retry with a NEW key, never the same one. If the wrapper's OWN write to confirm a SUCCESSFUL completion cannot be confirmed, the mutation may have gone through anyway: the SAME key instead answers 503 idempotency_outcome_unknown — verify the outcome before any new-key retry, exactly as case (2) above. Any executed attempt spends the key, success or not, so a failed attempt usually lands in case (2) above. A blank or malformed key is refused with 400 idempotency_key_invalid, on dry_run requests too (a dry run never records the key)."
          schema:
            type: string
            pattern: ^[!-~](?:[ -~]{0,253}[!-~])?$
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  /messages/sms/{id}:
    get:
      operationId: getSmsMessage
      summary: Get an SMS message by ID
      tags:
        - Messages
      parameters:
        - $ref: "#/components/parameters/IdParam"
      responses:
        "200":
          description: SMS message details
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "404":
          $ref: "#/components/responses/NotFound"

  /messages/sms/send:
    post:
      operationId: sendSms
      summary: Send an SMS message
      tags:
        - Messages
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - contactId
                - body
              properties:
                contactId:
                  type: string
                  format: uuid
                body:
                  type: string
                  maxLength: 1600
      responses:
        "201":
          description: SMS sent
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"
      parameters:
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  /messages/check:
    post:
      operationId: checkMessage
      summary: Message check (grade a draft text or email before sending)
      description: Grades a draft with the same check the contact composers run as the rep types (the conduyt.com checker engine) and answers the score out of 100, the grade, the verdict, every flagged word with why and safer alternatives, the subject's flagged words (email), the checks, and for a text the engine's count. Nothing is stored and nothing is sent; it only suggests. Merge tokens such as {{contact.firstName}} are never flagged. Every hit offset (start, end) is a Unicode code-point offset into the submitted text, not a UTF-16 index. Any signed-in member may call it; an API key reaches it with the contacts, emails, sms or messages scope (a read-tier key too) when its member may view contacts or email templates. 20 requests per minute per account. Engine 2.1.0 also answers breakdown (the points taken off, grouped), notices and unicodeCulprits (texts only) and the text count's units and estimate; setting clean to true adds cleaned, the cleaner's proposal (never applied). Further fields an engine release adds are additive.
      tags:
        - Messages
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/MessageCheckRequest"
            example:
              channel: sms
              body: "Sunrise Realty: Hi {{contact.firstName}}, act now for guaranteed approval! Reply STOP to opt out."
      responses:
        "200":
          description: The check
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    $ref: "#/components/schemas/MessageCheckResult"
        "400":
          description: invalid_body. Not JSON, a missing or wrong field, an unknown key, or a subject on a text.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          description: forbidden. The API key's member may view neither contacts nor email templates, or the key's scopes do not reach the route.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "413":
          description: message_too_long (body over 10,000 or subject over 300 characters) or body_too_large (the request over 48 KB).
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "429":
          $ref: "#/components/responses/RateLimited"
      parameters: []

  # ──────────────────────────────────────────────
  # Email (send)
  # ──────────────────────────────────────────────
  /email/send:
    post:
      operationId: sendEmail
      summary: Send an email to a contact
      description: Sends one email through the account's connected Resend domain and logs it as a Message row linked to the contact. `to` must equal the linked contact's registered email address (case-insensitive) — this stops a caller from citing a contact's id but sending to a different address, which would bypass that contact's opt-out/CAN-SPAM status. Provide `html`, `text`, or both; at least one body is required. There is no scheduling field — this endpoint sends immediately or fails; it never queues a future send. This is a contact-bound send — `cc`/`bcc` are NOT supported, so a non-empty value is rejected with 400 (omitted, null, whitespace-only and [] are accepted as none), for the same reason as the `to` guard above — only `to` is checked against the contact's opt-out/registered-address status, so any other recipient would bypass it. Send to each additional contact as its own request.
      tags:
        - Email
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - to
                - subject
                - contactId
              anyOf:
                - required:
                    - html
                  properties:
                    html:
                      type: string
                      minLength: 1
                - required:
                    - text
                  properties:
                    text:
                      type: string
                      minLength: 1
              properties:
                to:
                  type: string
                  pattern: "@"
                  maxLength: 254
                  description: Recipient email address. Checked on the RAW value (max 254 characters, the RFC 5321 practical limit; must contain "@" — no further structure is validated here). Length is measured in UTF-16 code units, so characters outside the Basic Multilingual Plane count as two. Must equal the linked contact's registered email (case-insensitive, both sides trimmed) — a mismatch is rejected with 400, and a contact with no email on file is rejected with 422 (there is no address to prove a match against).
                subject:
                  type: string
                  pattern: \S
                  maxLength: 998
                  description: Email subject line. Checked on the raw value (max 998 characters); must contain at least one non-whitespace character — blank or whitespace-only is rejected as missing. Length is measured in UTF-16 code units, so characters outside the Basic Multilingual Plane count as two. The stored value is trimmed.
                html:
                  type:
                    - string
                    - "null"
                  maxLength: 500000
                  description: HTML body, sanitized server-side before sending. Checked on the raw value, no trim (max 500,000 characters — a sanity bound, not a product limit). Length is measured in UTF-16 code units, so characters outside the Basic Multilingual Plane count as two. `null` is accepted and treated as absent, same as omitting the field; an EMPTY string is also accepted here on its own, but does not by itself satisfy the "at least one of `html` or `text`" requirement below. A non-string, non-null value (object, number, boolean, array) is rejected with 400, never passed to the sanitizer.
                text:
                  type:
                    - string
                    - "null"
                  maxLength: 100000
                  description: Plain-text body. Checked on the raw value, no trim (max 100,000 characters). Length is measured in UTF-16 code units, so characters outside the Basic Multilingual Plane count as two. `null` is accepted and treated as absent, same as omitting the field; an EMPTY string is also accepted here on its own, but does not by itself satisfy the "at least one of `html` or `text`" requirement below. A non-string, non-null value is rejected with 400, never passed to the Message write.
                contactId:
                  type: string
                  pattern: ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$
                  description: The CRM contact this email is sent to and logged against. Checked on the raw value — no trimming, no whitespace tolerance, no "urn:uuid:" prefix. A non-string or non-UUID-shaped value (including one with surrounding whitespace) is rejected with 400 before any lookup runs. Must belong to the caller's account and be visible/editable to the caller, or the request 404s.
                replyTo:
                  type:
                    - string
                    - "null"
                  pattern: ^\s*(\S(?:.{0,252}\S)?)?\s*$
                  description: Override the Reply-To header. Trimmed before validation; omitted, `null`, or blank (including whitespace-only) all fall back to the account's reply-capture address, then the sending user's own email. Otherwise must be a valid email address of at most 254 characters AFTER TRIMMING (surrounding whitespace doesn't count against the limit; email validity itself is checked only by the server) — an invalid value is rejected with 422.
                cc:
                  type:
                    - string
                    - array
                    - "null"
                  pattern: ^\s*$
                  maxItems: 0
                  items:
                    type: string
                  description: Not supported — rejected with 400 if non-empty (a non-blank string, or an array with at least one entry; a non-string array item is also rejected). This is a contact-bound send and only `to` is checked against the contact's opt-out/registered-address status. Omitting the field, `null`, a blank string, or `[]` are all accepted. Send to each additional contact separately.
                bcc:
                  type:
                    - string
                    - array
                    - "null"
                  pattern: ^\s*$
                  maxItems: 0
                  items:
                    type: string
                  description: Not supported — rejected with 400 if non-empty, for the same reason as `cc`. Omitting the field, `null`, a blank string, or `[]` are all accepted.
                sendDomainId:
                  type:
                    - string
                    - "null"
                  pattern: ^\s*([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})?\s*$
                  description: "Optional — send from a specific verified extra sending domain (see GET /email-domains) instead of the account's primary verified domain. Trimmed before validation; omitted, `null`, or blank (including whitespace-only) are all the primary domain. A present, non-blank value that is not UUID-shaped (post-trim) is rejected with 400 before any lookup runs. A well-FORMED UUID that doesn't resolve falls back to the primary domain SILENTLY, never an error: it applies when the id does not resolve to a verified EmailDomain row on this account, when it resolves but falls outside the account's paid extra-domain allowance (the oldest N verified extra domains, N = the allowance), or when the lookup itself fails. The response does not report which domain was actually used."
      responses:
        "201":
          description: Email sent. `data` is the persisted Message record (see the Message schema) plus the linked contact.
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    allOf:
                      - $ref: "#/components/schemas/Message"
                      - type: object
                        properties:
                          contact:
                            type: object
                            description: The linked contact, trimmed to display fields.
                            properties:
                              id:
                                type: string
                                format: uuid
                              firstName:
                                type:
                                  - string
                                  - "null"
                              lastName:
                                type:
                                  - string
                                  - "null"
                              email:
                                type:
                                  - string
                                  - "null"
        "202":
          description: "Accepted but unconfirmed: the provider call failed in a way indistinguishable from a lost acknowledgement (e.g. a timeout after the provider may have already accepted the send). The Message row is left in a non-terminal status for the delivery webhook or sweeper to settle — do not resend on this response. `data` is the Message record plus a human-readable `pending` note."
          x-generated-status: true
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    allOf:
                      - $ref: "#/components/schemas/Message"
                      - type: object
                        properties:
                          contact:
                            type: object
                            properties:
                              id:
                                type: string
                                format: uuid
                              firstName:
                                type:
                                  - string
                                  - "null"
                              lastName:
                                type:
                                  - string
                                  - "null"
                              email:
                                type:
                                  - string
                                  - "null"
                          pending:
                            type: string
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "402":
          description: Billing is not active for this account (trial expired, or the subscription is canceled/past_due/unpaid).
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          description: The contact was not found, is not visible to the caller, or belongs to another account.
        "409":
          description: 'Two DISTINCT cases under an Idempotency-Key, never interchangeable. (1) The ORIGINAL attempt with this key is still being processed (body: `{ error: "A request with this Idempotency-Key is still being processed" }`, no `code`, a `Retry-After` header) — wait the given seconds, then retry with the SAME key. (2) The key was already SPENT by a prior attempt that failed or has an unknown outcome (body: `{ error, code: "idempotency_key_spent" }`) — verify whether that attempt actually sent the email before using a brand-new key; resending the SAME key here only replays this same 409, it never re-runs the send.'
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - idempotency_key_spent
                    description: Present only for case (2) above.
        "422":
          description: "Three distinct causes share this status, in two different body shapes. An invalid `replyTo` address, a contact with no email on file, or an Idempotency-Key reused with a different request body each answer a plain error object. A provider/send failure (e.g. the contact opted out, or a bounced/suppressed address) instead answers `{ data: <Message + contact> }` with the row's terminal `status` and `errorMessage` — not an error object — because the Message row already exists and that terminal state is the useful answer."
          content:
            application/json:
              schema:
                oneOf:
                  - type: object
                    description: An invalid `replyTo` address, a contact with no email on file, or the Idempotency-Key was reused with a different request body.
                    required:
                      - error
                    not:
                      required:
                        - data
                    properties:
                      error:
                        type: string
                  - type: object
                    description: The send was attempted and failed, or was refused by the provider/compliance gate. `data` is the Message row with its terminal status.
                    required:
                      - data
                    properties:
                      data:
                        allOf:
                          - $ref: "#/components/schemas/Message"
                          - type: object
                            properties:
                              errorMessage:
                                type:
                                  - string
                                  - "null"
                              contact:
                                type: object
                                properties:
                                  id:
                                    type: string
                                    format: uuid
                                  firstName:
                                    type:
                                      - string
                                      - "null"
                                  lastName:
                                    type:
                                      - string
                                      - "null"
                                  email:
                                    type:
                                      - string
                                      - "null"
        "429":
          $ref: "#/components/responses/RateLimited"
        "500":
          description: Internal server error. Once the provider has confirmed it accepted the send, a persistence failure answers 503 idempotency_outcome_unknown instead (see below) rather than this generic 500.
        "503":
          description: "Five distinct codes share this status, split across two different retry contracts. NOT safe to retry blindly: idempotency_outcome_unknown — the provider's own wire WAS (or may have been) contacted and the outcome could not be confirmed, either because sendEmailForAccount itself threw after reaching the wire, or because a later DB write/read of the Message row threw after the provider accepted the send (sendResult.success, or a webhook-recovered acceptance), or because an Idempotency-Key attempt failed ambiguously before this route's own logic ran (the wrapper's own outcome-unknown contract). Verify in the contact's timeline before retrying — with or without a new key. idempotency_claim_held (Idempotency-Key path only) means a failed attempt's claim could not be released: retry with a NEW key, since the SAME key answers 409 until it expires. PROVEN SAFE to retry (the provider's wire was NEVER contacted — nothing was sent): contact_lookup_failed — the contact lookup (verifying the linked contact belongs to this account) threw before the Message row even existed; reply_to_lookup_failed — the reply-capture address lookup threw before the Message row even existed; pre_wire_failure_unrecorded — sendEmailForAccount returned preWire: true (a litigator/opted-out/unverified-domain/quota/billing refusal that never reached the wire) and persisting or reading that refusal then threw. All three of these RELEASE a supplied Idempotency-Key instead of spending it, so the SAME key may be retried immediately."
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                  - code
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - idempotency_outcome_unknown
                      - idempotency_claim_held
                      - contact_lookup_failed
                      - reply_to_lookup_failed
                      - pre_wire_failure_unrecorded
      parameters:
        - name: Idempotency-Key
          in: header
          required: false
          description: "Optional: one key per send (1-255 printable ASCII characters, not blank), reused only to retry the SAME request. Same key + same request body replays the original response (Idempotent-Replay: true); same key + a different body is refused with 422. Two DISTINCT 409s under this key, never interchangeable: (1) the ORIGINAL attempt is still being processed — wait for the Retry-After seconds given, then retry with the SAME key; (2) the key was already SPENT by a prior attempt that failed or has an unknown outcome (code idempotency_key_spent) — verify whether that attempt took effect BEFORE sending a brand-new key; resending the SAME key here only replays this 409 again, it never re-runs the request. If the wrapper's OWN write to RELEASE a failed attempt's claim cannot be confirmed, the SAME key instead answers 503 idempotency_claim_held until the held claim expires — retry with a NEW key, never the same one. If the wrapper's OWN write to confirm a SUCCESSFUL completion cannot be confirmed, the mutation may have gone through anyway: the SAME key instead answers 503 idempotency_outcome_unknown — verify the outcome before any new-key retry, exactly as case (2) above. Any executed attempt spends the key, success or not, so a failed attempt usually lands in case (2) above. A refusal that fires BEFORE anything is read or written for the request itself — a validation error on the body, a lookup that comes back empty, mismatched, or inaccessible, or a lookup that fails outright — is not an executed attempt: it releases the key instead of spending it, and the SAME key may be retried immediately once the request is corrected. Further exceptions, released instead of spent: pre_wire_failure_unrecorded (a proven pre-wire refusal whose settlement failed, released ONLY once the row is confirmed disarmed (failed status + its replay envelope stripped) — an unconfirmed disarm keeps the key spent, as idempotency_outcome_unknown, instead) — the SAME key may be retried immediately after one of these. A blank or malformed key is refused with 400 idempotency_key_invalid, on dry_run requests too (a dry run never records the key)."
          schema:
            type: string
            pattern: ^[!-~](?:[ -~]{0,253}[!-~])?$
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  /email/send-bulk:
    post:
      operationId: sendBulkEmail
      summary: Send bulk emails
      tags:
        - Email
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              description: A subject and a body are required unless templateId names an email template, whose subject and HTML are used for what is omitted.
              required:
                - contactIds
              properties:
                contactIds:
                  type: array
                  items:
                    type: string
                    format: uuid
                subject:
                  type: string
                text:
                  type: string
                  description: Plain-text body. Falls back to the template's text when templateId is given.
                html:
                  type: string
                  description: HTML body. Falls back to the template's HTML when templateId is given.
                templateId:
                  type: string
                  format: uuid
                  description: An active email template of this account. Its HTML is used unless one is sent, and its metadata (subject B, preheader, custom head, footer; the marker in html wins over text's) is applied to every recipient.
                subjectEdited:
                  type: boolean
                  description: "With templateId, a tri-state. true: the subject is the caller's own and is sent verbatim. false: the subject was only copied from the template, so the template's A/B subject pick applies per recipient. Absent (the legacy behaviour): a supplied subject is sent verbatim; an omitted subject gets the template's A/B pick."
      responses:
        "201":
          description: Bulk send initiated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "202":
          description: Accepted
          x-generated-status: true
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "206":
          description: Partial content
          x-generated-status: true
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: Idempotency-Key
          in: header
          required: false
          description: "Optional: one key per bulk send (1-255 printable ASCII characters, not blank), reused only to retry the SAME request. Same key + same request body replays the original response (Idempotent-Replay: true); same key + a different body is refused with 422. Two DISTINCT 409s under this key, never interchangeable: (1) the ORIGINAL attempt is still being processed — wait for the Retry-After seconds given, then retry with the SAME key; (2) the key was already SPENT by a prior attempt that failed or has an unknown outcome (code idempotency_key_spent) — verify whether that attempt took effect BEFORE sending a brand-new key; resending the SAME key here only replays this 409 again, it never re-runs the request. If the wrapper's OWN write to RELEASE a failed attempt's claim cannot be confirmed, the SAME key instead answers 503 idempotency_claim_held until the held claim expires — retry with a NEW key, never the same one. If the wrapper's OWN write to confirm a SUCCESSFUL completion cannot be confirmed, the mutation may have gone through anyway: the SAME key instead answers 503 idempotency_outcome_unknown — verify the outcome before any new-key retry, exactly as case (2) above. Any executed attempt spends the key, success or not, so a failed attempt usually lands in case (2) above. A blank or malformed key is refused with 400 idempotency_key_invalid, on dry_run requests too (a dry run never records the key)."
          schema:
            type: string
            pattern: ^[!-~](?:[ -~]{0,253}[!-~])?$
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  /emails:
    get:
      operationId: listEmails
      summary: List email messages
      tags:
        - Email
      parameters: []
      responses:
        "200":
          description: Paginated email messages
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  # ──────────────────────────────────────────────
  # Email Templates
  # ──────────────────────────────────────────────
  /emails/templates:
    get:
      operationId: listEmailTemplates
      summary: List email templates
      tags:
        - Email Templates
      parameters:
        - name: category
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: channel
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: is_active
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
          x-default-provenance: handler_literal
        - name: provider
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
      responses:
        "200":
          description: Paginated templates
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
    post:
      operationId: createEmailTemplate
      summary: Create an email template
      description: |-
        Email templates built in the editor keep their builder state in hidden markers: CONDUYT_BLOCKS and CONDUYT_META
        (subject B, preheader, custom head HTML, footer HTML). Metadata precedence: the CONDUYT_META marker in bodyHtml
        wins over one in body; the editor writes it to bodyHtml only, and body's marker is read only when bodyHtml has
        none. A request that would leave DIFFERENT markers in body and bodyHtml is refused with 400
        template_meta_conflict ("body and bodyHtml both carry a CONDUYT_META marker and they differ"). Stored rows are
        never rewritten.

        Pasted HTML (email only): send bodyMode "html" with html (your own designed email, up to 100 KB). The
        stored bodyHtml is built from html: the builder's blocks (from bodyHtml in the request, else the stored row)
        are kept, and body defaults to the HTML's visible text when none is sent. Sends use the pasted HTML as the
        body with only what every email gets: merge fields rendered, the preheader / head / footer HTML from the
        metadata, open tracking, and an unsubscribe link unless the HTML already carries {{unsubscribe_url}} (or
        {{unsubscribeUrl}}). bodyMode "blocks" takes the builder's bodyHtml; switching back keeps the pasted HTML
        (returned as html). Refusals (400, nothing written): html_required (bodyMode html without html, or empty),
        html_too_large (over 100 KB: Gmail clips emails over 102 KB), html_script (a <script> anywhere in the HTML), html_without_html_mode (html
        without bodyMode html), invalid_body_mode (not "blocks" / "html", or on an SMS template), body_html_required
        (bodyMode blocks without bodyHtml), body_mode_conflict (bodyMode blocks with html-mode metadata in bodyHtml),
        html_conditional_comment (an Outlook conditional comment that ends before its <![endif]-->, is never closed, or
        has an unreadable condition), html_office_markup (VML / Office elements outside an Outlook-only block),
        html_duplicate_attribute (an element inside an Outlook-only block with the same attribute twice).
        A template returned by POST, PATCH or GET /emails/templates/{id} carries bodyMode ("blocks" / "html"; null
        for SMS) and html (the pasted HTML in html mode, the kept copy in blocks mode, else null); a LIST row carries
        bodyMode only (fetch the template by id for html).
      tags:
        - Email Templates
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/EmailTemplateCreate"
      responses:
        "201":
          description: Template created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"
      parameters:
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  /emails/templates/{id}:
    get:
      operationId: getEmailTemplate
      summary: Get an email template by ID
      tags:
        - Email Templates
      parameters:
        - $ref: "#/components/parameters/IdParam"
      responses:
        "200":
          description: Template details
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "404":
          $ref: "#/components/responses/NotFound"
    patch:
      operationId: updateEmailTemplate
      summary: Update an email template
      description: |-
        Email templates built in the editor keep their builder state in hidden markers: CONDUYT_BLOCKS and CONDUYT_META
        (subject B, preheader, custom head HTML, footer HTML). Metadata precedence: the CONDUYT_META marker in bodyHtml
        wins over one in body; the editor writes it to bodyHtml only, and body's marker is read only when bodyHtml has
        none. A request that would leave DIFFERENT markers in body and bodyHtml is refused with 400
        template_meta_conflict ("body and bodyHtml both carry a CONDUYT_META marker and they differ"). Stored rows are
        never rewritten.

        Pasted HTML (email only): send bodyMode "html" with html (your own designed email, up to 100 KB). The
        stored bodyHtml is built from html: the builder's blocks (from bodyHtml in the request, else the stored row)
        are kept, and body defaults to the HTML's visible text when none is sent. Sends use the pasted HTML as the
        body with only what every email gets: merge fields rendered, the preheader / head / footer HTML from the
        metadata, open tracking, and an unsubscribe link unless the HTML already carries {{unsubscribe_url}} (or
        {{unsubscribeUrl}}). bodyMode "blocks" takes the builder's bodyHtml; switching back keeps the pasted HTML
        (returned as html). Refusals (400, nothing written): html_required (bodyMode html without html, or empty),
        html_too_large (over 100 KB: Gmail clips emails over 102 KB), html_script (a <script> anywhere in the HTML), html_without_html_mode (html
        without bodyMode html), invalid_body_mode (not "blocks" / "html", or on an SMS template), body_html_required
        (bodyMode blocks without bodyHtml), body_mode_conflict (bodyMode blocks with html-mode metadata in bodyHtml),
        html_conditional_comment (an Outlook conditional comment that ends before its <![endif]-->, is never closed, or
        has an unreadable condition), html_office_markup (VML / Office elements outside an Outlook-only block),
        html_duplicate_attribute (an element inside an Outlook-only block with the same attribute twice).
        A template returned by POST, PATCH or GET /emails/templates/{id} carries bodyMode ("blocks" / "html"; null
        for SMS) and html (the pasted HTML in html mode, the kept copy in blocks mode, else null); a LIST row carries
        bodyMode only (fetch the template by id for html).
      tags:
        - Email Templates
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/EmailTemplateUpdate"
      responses:
        "200":
          description: Template updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"
    delete:
      operationId: deleteEmailTemplate
      summary: Delete an email template
      tags:
        - Email Templates
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      responses:
        "200":
          description: Template deleted
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  /emails/templates/test-send:
    post:
      operationId: testSendEmailTemplate
      summary: Send a test email from a template
      tags:
        - Email Templates
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - templateId
                - toEmail
              properties:
                templateId:
                  type: string
                  format: uuid
                toEmail:
                  type: string
                  format: email
      responses:
        "200":
          description: Test email sent
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  # ──────────────────────────────────────────────
  # Email Sequences
  # ──────────────────────────────────────────────
  /emails/sequences:
    get:
      operationId: listEmailSequences
      summary: List email sequences
      tags:
        - Email Sequences
      parameters:
        - name: archived
          in: query
          required: false
          description: true lists archived sequences only (they are left out otherwise).
          schema:
            type: boolean
        - name: is_active
          in: query
          required: false
          description: Pass true or false to list only sequences that are On, or Off.
          schema:
            type: string
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
          x-default-provenance: handler_literal
        - name: type
          in: query
          required: false
          description: Only sequences of this channel.
          schema:
            type: string
            enum:
              - email
              - sms
        - name: view
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
      responses:
        "200":
          description: Paginated sequences
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
    post:
      operationId: createEmailSequence
      summary: Create a sequence (email or SMS)
      description: |
        One model for Email and SMS sequences. Steps send saved templates (Email Templates or SMS Templates of the
        sequence's type) a number of days apart inside the send window; nothing is written inline. `type` is fixed at
        creation. Runs stop on a reply, a booked meeting, an opt-out (STOP for SMS), a closed deal (when
        `autoUnenrollOnDealClosed`), or a removal; see `GET /emails/sequences/{id}/enrollments` for how each run ended.
      tags:
        - Email Sequences
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - name
                - steps
              properties:
                name:
                  type: string
                description:
                  type: string
                type:
                  type: string
                  enum:
                    - email
                    - sms
                  default: email
                  description: The channel. Immutable after creation.
                isActive:
                  type: boolean
                  default: false
                  description: On or Off. Off keeps every run where it is; the steps resume when turned On.
                steps:
                  type: array
                  minItems: 1
                  description: In order. Every step names a template of the sequence's type; the first step's wait is 0.
                  items:
                    type: object
                    required:
                      - templateId
                    properties:
                      templateId:
                        type: string
                        format: uuid
                        description: An active template of the sequence's channel.
                      waitDays:
                        type: integer
                        minimum: 0
                        description: Days after the previous step.
                senderUserId:
                  type: string
                  format: uuid
                  nullable: true
                  description: The team member the messages are from (must be an active member). Email sends from their on-domain address, SMS from their assigned line; null = the workspace default.
                autoUnenrollOnReply:
                  type: boolean
                  default: true
                  description: Stop the contact's run when they reply to any message of the sequence.
                autoUnenrollOnMeeting:
                  type: boolean
                  default: true
                  description: Stop the run when a meeting is booked through any Conduyt calendar.
                autoUnenrollOnUnsubscribe:
                  type: boolean
                  default: true
                  description: Stop the run when the contact opts out (unsubscribe, or STOP for SMS).
                autoUnenrollOnBounce:
                  type: boolean
                  default: true
                  description: Email only. Stop the run on a hard bounce (a soft bounce waits and retries).
                autoUnenrollOnDealClosed:
                  type: boolean
                  default: true
                  description: Stop the contact's run when any of their deals closes, won or lost (any stage of a closed kind, custom stages included).
                allowAutomationEnroll:
                  type: boolean
                  default: true
                  description: Let the automation action enroll_in_sequence put contacts in.
                allowReenroll:
                  type: boolean
                  default: false
                  description: Let a contact go through it again once their earlier run ENDED (replied, meeting booked, deal closed, removed, completed). A live or paused run is never restarted.
                weekdaysOnly:
                  type: boolean
                  default: true
                  description: Send only Monday to Friday, in the contact's time zone (else the workspace's).
                sendStartHour:
                  type: integer
                  minimum: 0
                  maximum: 23
                  default: 9
                  description: First hour of the send window (local).
                sendEndHour:
                  type: integer
                  minimum: 1
                  maximum: 24
                  default: 17
                  description: End of the send window, exclusive (local). A step due outside the window waits for the next opening.
      responses:
        "201":
          description: Sequence created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  /emails/sequences/{id}:
    get:
      operationId: getEmailSequence
      summary: Get an email sequence by ID
      tags:
        - Email Sequences
      parameters:
        - $ref: "#/components/parameters/IdParam"
      responses:
        "200":
          description: Sequence details with steps
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "404":
          $ref: "#/components/responses/NotFound"
    patch:
      operationId: updateEmailSequence
      summary: Update a sequence, turn it On or Off, or archive it
      description: |
        Any field but `type` (400 when sent). `archived: true` turns the sequence Off and hides it from lists
        (`GET /emails/sequences?archived=true` shows archived ones); `archived: false` restores it. Changing
        `senderUserId` requires an active member.
      tags:
        - Email Sequences
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                description:
                  type: string
                isActive:
                  type: boolean
                archived:
                  type: boolean
                  description: true = Off and hidden; false = restored.
                steps:
                  type: array
                  items:
                    type: object
                    required:
                      - templateId
                    properties:
                      templateId:
                        type: string
                        format: uuid
                      waitDays:
                        type: integer
                        minimum: 0
                senderUserId:
                  type: string
                  format: uuid
                  nullable: true
                  description: The team member the messages are from (must be an active member). Email sends from their on-domain address, SMS from their assigned line; null = the workspace default.
                autoUnenrollOnReply:
                  type: boolean
                  default: true
                  description: Stop the contact's run when they reply to any message of the sequence.
                autoUnenrollOnMeeting:
                  type: boolean
                  default: true
                  description: Stop the run when a meeting is booked through any Conduyt calendar.
                autoUnenrollOnUnsubscribe:
                  type: boolean
                  default: true
                  description: Stop the run when the contact opts out (unsubscribe, or STOP for SMS).
                autoUnenrollOnBounce:
                  type: boolean
                  default: true
                  description: Email only. Stop the run on a hard bounce (a soft bounce waits and retries).
                autoUnenrollOnDealClosed:
                  type: boolean
                  default: true
                  description: Stop the contact's run when any of their deals closes, won or lost (any stage of a closed kind, custom stages included).
                allowAutomationEnroll:
                  type: boolean
                  default: true
                  description: Let the automation action enroll_in_sequence put contacts in.
                allowReenroll:
                  type: boolean
                  default: false
                  description: Let a contact go through it again once their earlier run ENDED (replied, meeting booked, deal closed, removed, completed). A live or paused run is never restarted.
                weekdaysOnly:
                  type: boolean
                  default: true
                  description: Send only Monday to Friday, in the contact's time zone (else the workspace's).
                sendStartHour:
                  type: integer
                  minimum: 0
                  maximum: 23
                  default: 9
                  description: First hour of the send window (local).
                sendEndHour:
                  type: integer
                  minimum: 1
                  maximum: 24
                  default: 17
                  description: End of the send window, exclusive (local). A step due outside the window waits for the next opening.
      responses:
        "200":
          description: Sequence updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  /emails/sequences/{id}/enroll:
    post:
      operationId: enrollInSequence
      summary: Enroll contacts in a sequence
      tags:
        - Email Sequences
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - contactIds
              properties:
                contactIds:
                  type: array
                  items:
                    type: string
                    format: uuid
      responses:
        "200":
          description: Contacts enrolled
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "201":
          description: Created
          x-generated-status: true
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  /emails/sequences/{id}/unenroll:
    post:
      operationId: unenrollFromSequence
      summary: Unenroll contacts from a sequence
      tags:
        - Email Sequences
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - contactId
              properties:
                contactId:
                  type: string
                  format: uuid
                  description: The contact to remove from the sequence (one contact per call).
      responses:
        "200":
          description: Contact unenrolled
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  /emails/sequences/{id}/enrollments:
    get:
      operationId: listSequenceEnrollments
