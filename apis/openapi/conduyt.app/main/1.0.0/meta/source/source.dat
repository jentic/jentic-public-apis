        "200":
          description: User removed
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  # ──────────────────────────────────────────────
  # Settings
  # ──────────────────────────────────────────────
  /settings:
    get:
      operationId: getSettings
      summary: Get account settings
      description: "Includes messageCheck.minimumGrade (admin only; default { enabled: false, channel: { sms: null, email: null }, adminOverride: true }). Not enforced yet."
      tags:
        - Settings
      responses:
        "200":
          description: Account settings
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: op
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
    patch:
      operationId: updateSettings
      summary: Update account settings
      tags:
        - Settings
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                domain:
                  type: string
                settings:
                  type: object
                messageCheck:
                  type: object
                  description: "Message check settings (owner or admin). Not enforced yet: the minimum grade is stored and read back, but no send is blocked. minimumGrade is required when this block is sent, and the block replaces the stored one. enabled: true is refused with 400 minimum_grade_not_available_yet until the feature is switched on."
                  additionalProperties: false
                  required:
                    - minimumGrade
                  properties:
                    minimumGrade:
                      type: object
                      description: Minimum Message check grade to send. Not enforced yet. Send the whole block.
                      additionalProperties: false
                      required:
                        - enabled
                        - channel
                        - adminOverride
                      properties:
                        enabled:
                          type: boolean
                          description: "Master switch. Default false. Not enforced yet: true is refused with 400 minimum_grade_not_available_yet."
                        channel:
                          type: object
                          description: "The minimum per channel: a grade letter (A, B, C, D, F), a score from 0 to 100, or null for no minimum."
                          additionalProperties: false
                          required:
                            - sms
                            - email
                          properties:
                            sms:
                              oneOf:
                                - type: string
                                  enum:
                                    - A
                                    - B
                                    - C
                                    - D
                                    - F
                                - type: integer
                                  minimum: 0
                                  maximum: 100
                                - type: "null"
                            email:
                              oneOf:
                                - type: string
                                  enum:
                                    - A
                                    - B
                                    - C
                                    - D
                                    - F
                                - type: integer
                                  minimum: 0
                                  maximum: 100
                                - type: "null"
                        adminOverride:
                          type: boolean
                          description: Whether an owner or admin may send below the minimum. Default true.
                pipelineRotDays:
                  type: object
                  description: "Per pipeline id: days without activity (1-90) before a deal in it reads Stale in stage. Only the pipelines sent change."
                  additionalProperties:
                    type: integer
                    minimum: 1
                    maximum: 90
      responses:
        "200":
          description: Settings updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          description: "A missing or malformed expectedSettingsRevision, or messageCheck.minimumGrade.enabled: true (code minimum_grade_not_available_yet: the minimum grade is not enforced yet and cannot be switched on)"
        "422":
          description: "Invalid settings; among them: a pipeline whose stage rules, outcome mapping or stale threshold is set must be an ACTIVE pipeline in this account (one archived meanwhile is refused; clearing its entries is allowed)"
      parameters: []

  /settings/branding:
    get:
      operationId: getBranding
      summary: Get white-label branding settings and the Company details
      description: The white-label branding (name, logo, favicon, colours, custom domain) and the account's Company details, the eight fields every member's email signature reads ("From company details"), with the settingsRevision they were read at. Needs settings.view (an API key needs the settings scope).
      tags:
        - Settings
      responses:
        "200":
          description: Branding settings and Company details
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    type: object
                    properties:
                      brandName:
                        type: string
                      brandLogo:
                        type: string
                        nullable: true
                      brandFavicon:
                        type: string
                        nullable: true
                      brandPrimaryColor:
                        type: string
                      brandAccentColor:
                        type: string
                      customDomain:
                        type: string
                        nullable: true
                      companyDetails:
                        $ref: "#/components/schemas/CompanyDetails"
                      settingsRevision:
                        type: string
                        description: The account settings revision the Company details were read at. Send it back as expectedSettingsRevision when you PATCH companyDetails.
              example:
                data:
                  brandName: Demolition Group
                  brandLogo: null
                  brandFavicon: null
                  brandPrimaryColor: "#E8572A"
                  brandAccentColor: "#0E1F3A"
                  customDomain: null
                  companyDetails:
                    website: demolitiongroup.com
                    phone: (206) 555-0100
                    address: 1200 Westlake Ave N, Seattle, WA 98109
                    linkedin: linkedin.com/company/demolitiongroup
                    instagram: ""
                    facebook: ""
                    youtube: ""
                    disclaimer: This email and any attachments are confidential.
                  settingsRevision: "42"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
      parameters: []
    patch:
      operationId: updateBranding
      summary: Update white-label branding, or the Company details
      description: |
        Two shapes. (1) The white-label fields (JSON or multipart with a logo / favicon upload); needs the premium plan.
        (2) The Company details on their own: { companyDetails, expectedSettingsRevision }. Any of the eight fields, each a
        string ("" or null clears it); website must be a web address, the four social fields profile links; unknown fields
        are refused 422. expectedSettingsRevision is required (400 expected_settings_revision_required) and must match the
        revision GET returned (409 stale_settings_revision when another save landed first). companyDetails cannot be sent
        together with the white-label fields (400 company_details_alone). Admins only (settings.edit; an API key needs the
        settings scope and a write tier). Nothing is re-rendered: every email signature is rendered from the live Company
        details at each use, so the next signature any rep reads or sends carries the new values.
      tags:
        - Settings
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                brandName:
                  type: string
                brandLogo:
                  type: string
                  format: uri
                brandFavicon:
                  type: string
                  format: uri
                brandPrimaryColor:
                  type: string
                  description: Hex color e.g. "#2E3B5B"
                brandAccentColor:
                  type: string
                customDomain:
                  type: string
                companyDetails:
                  $ref: "#/components/schemas/CompanyDetailsPatch"
                expectedSettingsRevision:
                  type: string
                  pattern: ^\d+$
                  description: Required with companyDetails. The settingsRevision GET /settings/branding returned with the values you edited.
            examples:
              companyDetails:
                summary: Save two Company details
                value:
                  companyDetails:
                    website: demolitiongroup.com
                    disclaimer: This email and any attachments are confidential.
                  expectedSettingsRevision: "42"
      responses:
        "200":
          description: Branding updated (white-label shape), or { companyDetails, settingsRevision } for a Company details save
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
              example:
                data:
                  companyDetails:
                    website: demolitiongroup.com
                    phone: ""
                    address: ""
                    linkedin: ""
                    instagram: ""
                    facebook: ""
                    youtube: ""
                    disclaimer: This email and any attachments are confidential.
                  settingsRevision: "43"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "409":
          description: stale_settings_revision, the Company details changed since they were loaded; GET again and retry with the new revision
        "422":
          description: invalid_company_details (an unknown field, a value too long, a website or profile link that is not one), or an invalid white-label value
      parameters: []

