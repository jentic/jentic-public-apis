  # ──────────────────────────────────────────────
  /booking-pages:
    get:
      operationId: listBookingPages
      summary: List booking pages
      tags:
        - Booking Pages
      responses:
        "200":
          description: All booking pages
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: is_active
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
          x-default-provenance: handler_literal
        - name: search
          in: query
          required: false
          description: Full-text search query
          schema:
            type: string
        - name: user_id
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
    post:
      operationId: createBookingPage
      summary: Create a booking page
      tags:
        - Booking Pages
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - title
                - slug
                - durationMinutes
              properties:
                title:
                  type: string
                slug:
                  type: string
                description:
                  type: string
                durationMinutes:
                  type: integer
                  default: 30
                bufferBefore:
                  type: integer
                bufferAfter:
                  type: integer
                customQuestions:
                  type: array
                  items:
                    type: object
                documentsEnabled:
                  type: boolean
                  description: Turns the documents step on for this page's bookings (the public upload-url and documents operations answer 404 while off).
                  default: false
                documentsPageUrl:
                  type: string
                  nullable: true
                  format: uri
                  description: The https page on the customer's site that hosts the upload step (the confirmation email links to it); an https URL or null.
                morningOfReminderEnabled:
                  type: boolean
                  default: true
                  description: The 9 AM (prospect-local) "your appointment is today" email on the appointment day. Even when on it is skipped when the booking was made less than 24 hours ahead or another email lands close to it. A non-boolean is refused with 400.
      responses:
        "201":
          description: Booking page created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  /booking-pages/{id}:
    get:
      operationId: getBookingPage
      summary: Get a booking page by ID
