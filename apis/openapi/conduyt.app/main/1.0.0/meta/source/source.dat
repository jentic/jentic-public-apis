  # ──────────────────────────────────────────────
  # Public Endpoints (no auth)
  # ──────────────────────────────────────────────
  /public/booking/{slug}:
    get:
      operationId: getPublicBookingPage
      summary: Get a public booking page by slug
      tags:
        - Public
      security: []
      parameters:
        - name: slug
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Booking page details with availability
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "404":
          $ref: "#/components/responses/NotFound"
    post:
      operationId: bookAppointment
      summary: Book an appointment via public page
      tags:
        - Public
      security: []
      parameters:
        - name: slug
          in: path
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - startTime
                - name
                - email
              properties:
                startTime:
                  type: string
                  format: date-time
                name:
                  type: string
                email:
                  type: string
                  format: email
                phone:
                  type: string
                answers:
                  type: object
      responses:
        "201":
          description: Appointment booked
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
    options:
      x-generated: true
      operationId: optionsPublicBookingSlug
      summary: OPTIONS public booking slug
      tags:
        - Public
      parameters:
        - name: slug
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  /public/booking/{slug}/upload-url:
    post:
      operationId: mintPublicBookingDocumentUpload
      summary: Mint a presigned upload for one document of a booking (the documents step, 3a)
      description: Public, no authentication — for a booking THIS page made. Answers a short-lived, size-bound presigned PUT into private storage; the browser PUTs the bytes there, then binds the pointer with the documents operation. 404 when the page does not take documents or the booking is not this page's live booking; 409 at the per-booking cap; 503 while the booking is being erased or merged, or when uploads are unavailable.
      tags:
        - Public
      security: []
      parameters:
        - name: slug
          in: path
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - appointmentId
                - filename
                - contentType
                - size
                - kind
                - documentsPass
              properties:
                appointmentId:
                  type: string
                  format: uuid
                documentsPass:
                  type: string
                  description: The booking's documents pass, from the booking answer (documents.pass) or the confirmation email's upload link (the documents query parameter). It proves the caller holds the booking's documents capability for its current contact; a missing or foreign pass is answered 404.
                filename:
                  type: string
                contentType:
                  type: string
                  enum:
                    - application/pdf
                    - image/jpeg
                    - image/png
                    - image/gif
                    - image/webp
                size:
                  type: integer
                  minimum: 1
                  maximum: 10485760
                kind:
                  type: string
                  enum:
                    - bank_statement
                    - funding_agreement
      responses:
        "201":
          description: The presigned PUT
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/BookingDocumentMintEnvelope"
        "400":
          description: A missing or invalid field
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
        "404":
          description: Booking page or booking not found, the page does not take documents, or the booking's person was erased
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
        "409":
          description: At most 20 documents per booking — bound documents plus live unbound uploads
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
        "413":
          description: The file is larger than 10 MB
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
        "429":
          description: Too many uploads from this address for this page (30 per 10 minutes); retryAfter in the body
          headers:
            Retry-After:
              schema:
                type: integer
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
        "500":
          description: Internal server error
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
        "503":
          description: Uploads unavailable (no private storage, the presign failed), or the booking is being erased or merged (code documents_unavailable, retry later)
          headers:
            Retry-After:
              schema:
                type: integer
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
    options:
      operationId: optionsPublicBookingDocumentUpload
      summary: CORS preflight for the upload mint
      tags:
        - Public
      security: []
      parameters:
        - name: slug
          in: path
          required: true
          schema:
            type: string
      responses:
        "204":
          description: Preflight answered from the page's embed allowlist

  /public/booking/{slug}/documents:
    post:
      operationId: bindPublicBookingDocuments
      summary: Bind uploaded documents to a booking (the documents step, 3c)
      description: Public, no authentication — binds pointers minted for THIS booking. Each pointer is proven (the minted row, the object's presence and size, the validated bytes copied to a final key), attached to the lead's files and recorded on the booking; idempotent by pointer. A pointer that cannot be bound is listed in skipped with a reason, never a 500. 409 documents_in_progress while another bind runs, 409 booking_changed when the booking's identities moved (retry), 410 booking_gone when the booking can no longer take documents, 503 while the booking is being erased or merged.
      tags:
        - Public
      security: []
      parameters:
        - name: slug
          in: path
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - appointmentId
                - documents
                - documentsPass
              properties:
                appointmentId:
                  type: string
                  format: uuid
                documentsPass:
                  type: string
                  description: The booking's documents pass, from the booking answer (documents.pass) or the confirmation email's upload link (the documents query parameter). It proves the caller holds the booking's documents capability for its current contact; a missing or foreign pass is answered 404.
                documents:
                  type: array
                  minItems: 1
                  maxItems: 20
                  items:
                    type: object
                    required:
                      - pointer
                      - name
                      - kind
                    properties:
                      pointer:
                        type: string
                      name:
                        type: string
                      kind:
                        type: string
                        enum:
                          - bank_statement
                          - funding_agreement
      responses:
        "200":
          description: attached, skipped (pointer + reason) and every document the booking holds
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/BookingDocumentsBindEnvelope"
        "400":
          description: A missing or invalid field
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
        "404":
          description: Booking page or booking not found, or the page does not take documents
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
        "409":
          description: code documents_in_progress (another bind runs — Retry-After 5) or booking_changed (the booking's identities moved — retry, drift says what)
          headers:
            Retry-After:
              schema:
                type: integer
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
        "410":
          description: code booking_gone — the booking can no longer take documents (reason)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
        "429":
          description: Too many requests from this address for this page (30 per 10 minutes)
          headers:
            Retry-After:
              schema:
                type: integer
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
        "500":
          description: Internal server error
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
        "503":
          description: code documents_unavailable — the booking is being erased or merged, or the lock connection is unavailable (Retry-After 30)
          headers:
            Retry-After:
              schema:
                type: integer
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PublicBookingDocumentsError"
    options:
      operationId: optionsPublicBookingDocuments
      summary: CORS preflight for the documents bind
      tags:
        - Public
      security: []
      parameters:
        - name: slug
          in: path
          required: true
          schema:
            type: string
      responses:
        "204":
          description: Preflight answered from the page's embed allowlist

  /public/booking/{slug}/slots:
    get:
      operationId: getPublicBookingSlots
      summary: Get available time slots for a booking page
      tags:
        - Public
      security: []
      parameters:
        - name: slug
          in: path
          required: true
          schema:
            type: string
        - name: date
          in: query
          required: true
          description: Query parameter read by this route.
          schema:
            type: string
        - name: duration
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: integer
        - name: host
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
      responses:
        "200":
          description: Available time slots
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
    options:
      x-generated: true
      operationId: optionsPublicBookingSlugSlots
      summary: OPTIONS public booking slug slots
      tags:
        - Public
      parameters:
        - name: slug
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  # ──────────────────────────────────────────────
  # Inbound Webhooks (external systems pushing data in)
  # ──────────────────────────────────────────────
  /webhooks:
    get:
      operationId: listWebhookEndpoints
      summary: List configured webhook endpoints (legacy alias)
      tags:
        - Webhooks
      responses:
        "200":
          description: Webhook endpoints
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
          x-default-provenance: handler_literal
    post:
      operationId: createWebhookLegacy
      summary: Create an outbound webhook endpoint (legacy alias)
      tags:
        - Webhooks
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - url
                - events
              properties:
                url:
                  type: string
                  format: uri
                events:
                  type: array
                  items:
                    type: string
                description:
                  type: string
                isActive:
                  type: boolean
      responses:
        "201":
          description: Webhook created and signing secret returned once
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  /webhooks/inbound/contacts:
    post:
      operationId: webhookInboundContact
      summary: Inbound webhook for contact data
      tags:
        - Webhooks
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                intakeDeal:
                  type: boolean
                  description: Optional. Send false to skip the account's intake deal (intakeDeals setting) for this contact; absent keeps the default. Any non-boolean value is a 400.
      responses:
        "200":
          description: Contact webhook processed
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "201":
          description: Created
          x-generated-status: true
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters: []

  /webhooks/inbound/forms/{token}:
    post:
      operationId: webhookInboundFormSubmission
      summary: WordPress form submission (intake address)
      description: "Public: no API key; the token in the URL is the credential (create one with POST /integrations/wordpress-forms/intakes). For Gravity Forms (Webhooks Add-On), WPForms (Webhooks addon) and Elementor Pro (Webhook action). Accepts JSON, application/x-www-form-urlencoded (Elementor's default and \"Advanced Data\" bracket forms) and multipart without files, up to 64 KB. Field names match case-insensitively with spaces and punctuation ignored: first name (firstName, first_name, first, \"First Name\"), last name, a single name / full_name / \"Your name\" (split on the first space), email (\"E-mail\", \"Email Address\"), phone (tel, telephone, \"Phone Number\"), company, message (comments, notes), utm_source / utm_medium / utm_campaign / utm_term / utm_content, \"Page URL\" and \"Page Title\" (attribution), tags (an array or a comma-separated string), source, form_name (names the timeline entry). Elementor's form_id, Date, Time, User Agent, Remote IP and Powered by are dropped. Any other field is saved to the contact custom field whose key or label matches it; every field is on the contact's timeline entry \"Submitted <form name>\". Creates or updates the contact by email then phone (a resend never creates a second contact or a second timeline entry) and applies the intake's default tag, source and owner (explicit source / tags in the body win)."
      tags:
        - Webhooks
      security: []
      parameters:
        - name: token
          in: path
          required: true
          schema:
            type: string
            pattern: ^wpf_[A-Za-z0-9_-]{43}$
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              type: object
              additionalProperties:
                type: string
            example: Name=Jane+Doe&Email=jane%40example.com&Phone=%28201%29+555-0147&Message=Looking+for+SEO+help&Page+URL=https%3A%2F%2Fstaging.example%2Fcontact%2F&Page+Title=Contact&form_id=7f3a2b1&form_name=Contact+form
          application/json:
            schema:
              type: object
              additionalProperties: true
      responses:
        "200":
          description: Saved (on create AND on update; never 201, which Elementor reports as a webhook error)
          content:
            application/json:
              schema:
                type: object
                required:
                  - ok
                  - contactId
                  - created
                properties:
                  ok:
                    type: boolean
                    enum:
                      - true
                  contactId:
                    type: string
                    format: uuid
                  created:
                    type: boolean
        "400":
          description: Unreadable body, conflicting values for one field, neither email nor phone ("Email or phone is required"), over 10 KB of custom field values, or more than 20 tags
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FormIntakeError"
        "402":
          description: The account's billing is not active
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FormIntakeError"
        "403":
          description: The account's contact limit is reached
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FormIntakeError"
        "404":
          description: Unknown or revoked address (no hint which)
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FormIntakeError"
        "413":
          description: Body over 64 KB
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FormIntakeError"
        "422":
          description: A contact custom field the account marks required is missing
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FormIntakeError"
        "429":
          description: Over 60 submissions a minute for this address, or over the account's inbound contacts limit (120 a minute per sending IP); see Retry-After
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FormIntakeError"
        "503":
          description: A transient conflict; retry after Retry-After seconds
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FormIntakeError"

  /webhooks/inbound/deals:
    post:
      operationId: webhookInboundDeal
      summary: Inbound webhook for deal data
      tags:
        - Webhooks
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
