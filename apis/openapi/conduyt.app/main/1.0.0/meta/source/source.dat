          application/json:
            schema:
              $ref: "#/components/schemas/BookingPagePatch"
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      responses:
        "200":
          description: Booking page updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
    delete:
      operationId: deleteBookingPage
      summary: Delete a booking page
