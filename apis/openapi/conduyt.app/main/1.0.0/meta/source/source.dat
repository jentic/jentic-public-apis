      responses:
        "200":
          description: Revenue metrics over time
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters: []

  /reports/activity:
    get:
      operationId: getActivityReport
      summary: Activity report
      tags:
        - Reports
      responses:
        "200":
          description: Activity metrics (calls, emails, tasks, etc.)
          content:
