  /deals/inspection:
    get:
      operationId: getDealsInspection
      summary: Pipeline health for a pipeline
      description: The six Pipeline health checks (High-value idle, Stale in stage, Unassigned, Needs next action, No close date, Missing contact) over the open deals of one pipeline (or every visible active pipeline), ordered by money at risk. With `check`, also that check's deals, highest value first. The Deal Pipeline page reads the same numbers through GET /deals?health_summary=true, which also takes every board filter.
      tags:
        - Deals
      parameters:
        - name: check
          in: query
          required: false
          description: "One of high_value_idle, stale, unassigned, needs_action, missing_close_date, missing_contact: adds `deals` for that check."
          schema:
            type: string
        - name: cursor
          in: query
          required: false
          description: "With check: continue after this cursor, the nextCursor of the previous page (keyset over value desc, then id). Signed and bound to its list like GET /deals health_cursor (400 health_cursor_invalid / _context / _blank / _needs_check). Not combined with offset, which stays for callers that page by position."
          schema:
            type: string
        - name: limit
          in: query
          required: false
          description: "With check: deals per page, 1-100 (default 5)."
          schema:
            type: integer
        - name: offset
          in: query
          required: false
          description: "With check: deals to skip (default 0)."
          schema:
            type: integer
        - name: pipeline
          in: query
          required: false
          description: Pipeline id; omit for every visible active pipeline.
          schema:
            type: string
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: "#/components/schemas/PipelineHealth"
        "400":
          description: Unknown check, out-of-range limit/offset, or a param given twice with different values
        "404":
          description: Pipeline not found
