  # ──────────────────────────────────────────────
  # Deals
  # ──────────────────────────────────────────────
  /deals:
    get:
      operationId: listDeals
      summary: List deals
      description: Returns deals with Kanban-optimized sort order (stage, sortOrder, then requested sort).
      tags:
        - Deals
      parameters:
        - name: assigned_to
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: assignedTo
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: board_columns
          in: query
          required: false
          description: "With board_snapshot=true: the columns to read, in answer order, as a comma list (repeats of the parameter are joined) of <stageId> or <stageId>:<limit>. limit is an integer 1-1000 (default per_page, itself default 50). Every stageId must be a live stage of the pipeline (400 naming the others); at least 1 and at most 50 columns, no stage twice, at most 5000 rows in total (400). Without board_snapshot=true it is a 400."
          schema:
            type: string
        - name: board_snapshot
          in: query
          required: false
          description: "true: answer every column named in board_columns from ONE database snapshot (one read-only REPEATABLE READ transaction), so a deal moved while the read runs is in exactly one column; each column's deals are exactly what ?stage=<stageId>&per_page=<limit>&rows_only=true answers (same filters, visibility, order and projection) and no aggregate is computed. Needs pipeline (or pipeline_name) and board_columns; cannot be combined with stage / stage_id / stage_name, rows_only, summary, health_summary, system_occupancy or a page other than 1 (400). A read that cannot finish inside its budget is a 503 code board_snapshot_busy with retryAfter and Retry-After (read the columns one by one instead, or retry). Any request to this endpoint, snapshot or not, can also be answered 503 code gate_busy (the access check could not finish in time) with retryAfter and Retry-After. Any value other than true or false, or the parameter repeated with different values, is a 400. The Deals board uses it for its first load and full reload."
          schema:
            type: boolean
        - name: contact_id
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: created_after
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: created_before
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: health
          in: query
          required: false
          description: "One Pipeline health check (high_value_idle, stale, unassigned, needs_action, missing_close_date, missing_contact): only open deals failing it, exactly the deals health_summary counts for it."
          schema:
            type: string
        - name: health_check
          in: query
          required: false
          description: "With health_summary: one check whose deals are added to `deals`, highest value first."
          schema:
            type: string
        - name: health_cursor
          in: query
          required: false
          description: "With health_summary and health_check: continue the list after this cursor, the nextCursor of the previous page (keyset over value desc, then id, so rows leaving the check between reads never shift it). The token is signed and bound to its list (account, check, the effective filters incl. a saved view's rules, and the thresholds the check reads; paging params aside): a forged one (health_cursor_invalid), one from another list (health_cursor_context), a blank one (health_cursor_blank) or one without health_check (health_cursor_needs_check) is a 400. Not combined with health_offset."
          schema:
            type: string
        - name: health_limit
          in: query
          required: false
          description: "With health_summary and health_check: deals per page, 1-100 (default 5)."
          schema:
            type: string
        - name: health_offset
          in: query
          required: false
          description: "With health_summary and health_check: deals to skip (positional paging; default 0). Prefer health_cursor to read a list page by page."
          schema:
            type: string
        - name: health_rows_only
          in: query
          required: false
          description: "With health_summary and health_check: true answers only the requested page of that check's deals (#/components/schemas/PipelineHealthDealsPage), without the summary, for a caller that already has it (the next page of a list)."
          schema:
            type: string
        - name: health_summary
          in: query
          required: false
          description: "true: answer the Pipeline health shape (#/components/schemas/PipelineHealth) for the board's filtered set: the same filters, validation and scope as the deal list; ?needsAction= and ?health= stay out. On this path status, contact_id, search, stale, value_min / minValue and value_max / maxValue given twice with different values are a 400 (health_filter_conflict)."
          schema:
            type: string
        - name: maxValue
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: minValue
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: needsAction
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: boolean
        - name: order
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 1000
          x-default-provenance: handler_literal
        - name: pipeline
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: pipeline_id
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: pipeline_name
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: pipelineId
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: pipelineName
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: rows_only
          in: query
          required: false
          description: "true returns the page of deals only: meta carries page, per_page and rows_only: true, and total, total_value, open_total, open_total_value, needs_action_count and stage_summary are omitted (none of those aggregates is computed). For callers that already hold the totals, such as the Deals board's per-stage columns. Default false: the response is unchanged. Any other value, the parameter given twice with different values, or rows_only=true with summary=true or health_summary=true (both answer aggregates, never the page) is a 400."
          schema:
            type: string
        - name: search
          in: query
          required: false
          description: "Text search over the deal title, the contact's name and company, and the linked company's name and domain. A Lead ID (8 to 32 hex characters of a deal id or of its contact's id, dashes optional, any case; a whole id matches exactly) is looked up by key first, inside the caller's visibility: when it names a deal or contact the caller may see, the list is those deals and that contact's deals; otherwise the term is searched as text, as if no such id existed."
          schema:
            type: string
        - name: sort
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: stage
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: stage_id
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: stage_name
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: stageId
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: stageName
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: stale
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: boolean
        - name: status
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: summary
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: system_occupancy
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: boolean
        - name: tag_ids
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: value_max
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: value_min
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: view
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: view_id
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: viewId
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
      responses:
        "200":
          description: Paginated list of deals; with health_summary=true, the Pipeline health of the same filtered set instead (an envelope whose data is a PipelineHealth); with board_snapshot=true, every named column from one database snapshot (an envelope whose data is a DealBoardSnapshot).
          content:
            application/json:
              schema:
                oneOf:
                  - description: the deal list (no health_summary); with rows_only=true meta is { page, per_page, rows_only, system_stage_occupancy? } and the aggregate keys are omitted
                    allOf:
                      - $ref: "#/components/schemas/PaginatedResponse"
                      - type: object
                        required:
                          - data
                        properties:
                          data:
                            type: object
                            required:
                              - data
                              - meta
                  - type: object
                    description: health_summary=true
                    required:
                      - data
                    properties:
                      data:
                        $ref: "#/components/schemas/PipelineHealth"
                  - type: object
                    description: health_summary=true&health_rows_only=true (the page alone, no summary)
                    required:
                      - data
                    properties:
                      data:
                        type: object
                        required:
                          - deals
                        additionalProperties: false
                        properties:
                          deals:
                            $ref: "#/components/schemas/PipelineHealthDealsPage"
                  - type: object
                    description: board_snapshot=true (every named column from one database snapshot, rows only)
                    required:
                      - data
                    properties:
                      data:
                        $ref: "#/components/schemas/DealBoardSnapshot"
        "503":
          description: "Temporarily busy; nothing was changed. Two codes: board_snapshot_busy (board_snapshot=true only: the snapshot could not finish inside its time budget; read the columns one by one with stage=<stageId>&rows_only=true, or retry) and gate_busy (any request, snapshot or not: the access check could not finish in time). Retry after the Retry-After seconds."
          headers:
            Retry-After:
              description: Seconds to wait before retrying
              schema:
                type: integer
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                  - code
                  - retryAfter
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - board_snapshot_busy
                      - gate_busy
                  retryAfter:
                    type: integer
    post:
      operationId: createDeal
      summary: Create a deal
      description: Creates a new deal in a pipeline stage. Rate limited to 30 requests per minute.
      tags:
        - Deals
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/DealCreate"
      responses:
        "201":
          description: Deal created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"
        "404":
          description: Pipeline or stage not found
        "409":
          description: 'Nothing was created. With `code: "oes_number_taken"` the `customFields.oes_number` submitted is already on another live card in the workspace (compared by its digits, 6 or more): `error` and `holder` name that card (title and id) and its contact only when the caller may see the card, otherwise `error` is the generic line "another deal card in this workspace already has this OES #"; a `dry_run` always answers the generic line. With an Idempotency-Key the key is released (retry it once the number is fixed). `stage_changed`: the stage left the pipeline while creating. `pipeline_archived`: the pipeline was archived or deleted.'
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - oes_number_taken
                      - stage_changed
                      - pipeline_archived
                  holder:
                    type: object
                    description: "With code oes_number_taken, present only when the caller may see the card that holds the number: that card and its contact (contactId / contactName null when the caller may not see the contact)."
                    required:
                      - dealId
                      - title
                    properties:
                      dealId:
                        type: string
                        format: uuid
                      title:
                        type: string
                      contactId:
                        type: string
                        format: uuid
                        nullable: true
                      contactName:
                        type: string
                        nullable: true
        "413":
          description: "customFields too large: the map as stored (PostgreSQL's jsonb form, where numbers like 1e300 expand to their full digits) would exceed 65,536 bytes. Nothing was written."
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                properties:
                  error:
                    type: string
        "429":
          $ref: "#/components/responses/RateLimited"
      parameters:
        - name: Idempotency-Key
          in: header
          required: false
          description: "Optional: one key per creation attempt (1-255 printable ASCII characters, not blank), reused only to retry the SAME request. Same key + same request body replays the original response (Idempotent-Replay: true); same key + a different body is refused with 422. Two DISTINCT 409s under this key, never interchangeable: (1) the ORIGINAL attempt is still being processed — wait for the Retry-After seconds given, then retry with the SAME key; (2) the key was already SPENT by a prior attempt that failed or has an unknown outcome (code idempotency_key_spent) — verify whether that attempt took effect BEFORE sending a brand-new key; resending the SAME key here only replays this 409 again, it never re-runs the request. If the wrapper's OWN write to RELEASE a failed attempt's claim cannot be confirmed, the SAME key instead answers 503 idempotency_claim_held until the held claim expires — retry with a NEW key, never the same one. If the wrapper's OWN write to confirm a SUCCESSFUL completion cannot be confirmed, the mutation may have gone through anyway: the SAME key instead answers 503 idempotency_outcome_unknown — verify the outcome before any new-key retry, exactly as case (2) above. A blank or malformed key is refused with 400 idempotency_key_invalid, on dry_run requests too (a dry run never records the key)."
          schema:
            type: string
            pattern: ^[!-~](?:[ -~]{0,253}[!-~])?$
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  /deals/{id}:
    get:
      operationId: getDeal
      summary: Get a deal by ID
      tags:
        - Deals
      parameters:
        - $ref: "#/components/parameters/IdParam"
      responses:
        "200":
          description: Deal details with contact, stage, pipeline, and assigned user
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "404":
          $ref: "#/components/responses/NotFound"
    patch:
      operationId: updateDeal
      summary: Update a deal
      tags:
        - Deals
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/DealUpdate"
      responses:
        "200":
          description: Deal updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          description: "Nothing was written. With `code: \"deal_changed\"` the deal changed after the version the caller pinned in `expectedUpdatedAt` (`updatedAt` is the deal's current version when known): read the deal again, then retry with the new `updatedAt`. With `code: \"oes_number_taken\"` the `customFields.oes_number` submitted is already on another live card in the workspace (compared by its digits, 6 or more): `error` and `holder` name that card (title and id) and its contact only when the caller may see the card, otherwise `error` is the generic line \"another deal card in this workspace already has this OES #\" and there is no `holder`; a `dry_run` always answers the generic line. A Pipeline health quick fix (`checkOrigin`) is refused as a HealthFixRefusal (`deal_changed` or `deal_check_cleared`, with the deal's current health row). Other 409s without that code (a stage move by another writer, a stale `expectedStageId`, an in-flight publication) are described by `error`."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/HealthFixRefusal"
                  - type: object
                    required:
                      - error
                    not:
                      required:
                        - row
                    properties:
                      error:
                        type: string
                      code:
                        type: string
                        enum:
                          - deal_changed
                          - oes_number_taken
                      updatedAt:
                        type: string
                        format: date-time
                      holder:
                        type: object
                        description: "With code oes_number_taken, present only when the caller may see the card that holds the number: that card and its contact (contactId / contactName null when the caller may not see the contact)."
                        required:
                          - dealId
                          - title
                        properties:
                          dealId:
                            type: string
                            format: uuid
                          title:
                            type: string
                          contactId:
                            type: string
                            format: uuid
                            nullable: true
                          contactName:
                            type: string
                            nullable: true
        "413":
          description: "customFields too large: the submitted customFields, or the map the deal would store (the deal's current map with the submitted keys applied, in PostgreSQL's jsonb form, where numbers like 1e300 expand to their full digits), would exceed 65,536 bytes. Nothing was written."
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                properties:
                  error:
                    type: string
    delete:
      operationId: deleteDeal
      summary: Soft-delete a deal
      tags:
        - Deals
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      responses:
        "200":
          description: Deal deleted
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "404":
          $ref: "#/components/responses/NotFound"

  # ──────────────────────────────────────────────
  # Pipelines
  # ──────────────────────────────────────────────
  /pipelines:
    get:
      operationId: listPipelines
      summary: List pipelines with stages
      tags:
        - Pipelines
      responses:
        "200":
          description: All pipelines with their stages
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: archived
          in: query
          required: false
          description: "true (owner or admin): list the ARCHIVED pipelines instead, as { id, name (the name before archiving), archivedName, color, archivedAt, openDeals, stageCount }, newest first, at most 200"
          schema:
            type: boolean
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 100
          x-default-provenance: handler_literal
    post:
      operationId: createPipeline
      summary: Create a pipeline
      description: Requires owner or admin role. Subject to plan limits.
      tags:
        - Pipelines
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - name
              properties:
                name:
                  type: string
                description:
                  type: string
                color:
                  type: string
                  enum:
                    - "#3845C9"
                    - "#43DFF6"
                    - "#2DD6B5"
                    - "#22C58B"
                    - "#9BD13B"
                    - "#F2B544"
                    - "#F07A2F"
                    - "#E6465A"
                    - "#FD88C0"
                    - "#956EFA"
                  description: "The pipeline's colour, the dot next to its name in the board's pipeline menu (any case accepted, stored in this spelling). Omitted: the first palette colour no active pipeline of the account uses."
                stages:
                  type: array
                  items:
                    type: object
                    required:
                      - name
                    properties:
                      name:
                        type: string
                      color:
                        type: string
                      isWon:
                        type: boolean
                      isLost:
                        type: boolean
      responses:
        "201":
          description: Pipeline created with stages
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "402":
          description: Trial expired
        "403":
          description: Pipeline limit reached or insufficient role
      parameters:
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  /pipelines/reorder:
    post:
      operationId: reorderPipelines
      summary: Reorder the pipelines (board menu order), atomically
      description: Writes every active pipeline's position in ONE transaction. order must list every active pipeline id exactly once; expectedRevision is the order the caller last read (the ids by position, comma-joined, as GET /pipelines returns them). Owner / admin.
      tags:
        - Pipelines
      parameters:
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - order
                - expectedRevision
              properties:
                order:
                  type: array
                  items:
                    type: string
                    format: uuid
                  description: Every active pipeline id, in the new order
                expectedRevision:
                  type: string
                  description: The current order as the caller read it (ids comma-joined); a mismatch is a 409
      responses:
        "200":
          description: "The canonical order and its new revision: { order, revision }"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          description: order is not a complete permutation of the active pipelines
        "409":
          description: "order_changed: the order moved since the caller read it (revision carries the current one); nothing written"

  /pipelines/{id}:
    get:
      operationId: getPipeline
      summary: Get a pipeline by ID
      tags:
        - Pipelines
      parameters:
        - $ref: "#/components/parameters/IdParam"
      responses:
        "200":
          description: Pipeline with stages
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "404":
          $ref: "#/components/responses/NotFound"
    patch:
      operationId: updatePipeline
      summary: Update a pipeline
      tags:
        - Pipelines
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                description:
                  type: string
                automationOnly:
                  type: boolean
                  description: "Automation-only pipeline: cards in it are moved and edited only by automations, API keys and owners / admins; a member's edit is refused with 403 pipeline_automation_only. Owner / admin only."
                color:
                  type: string
                  enum:
                    - "#3845C9"
                    - "#43DFF6"
                    - "#2DD6B5"
                    - "#22C58B"
                    - "#9BD13B"
                    - "#F2B544"
                    - "#F07A2F"
                    - "#E6465A"
                    - "#FD88C0"
                    - "#956EFA"
                  description: The pipeline's colour, the dot next to its name in the board's pipeline menu (any case accepted, stored in this spelling); anything else is a 400.
                sortOrder:
                  type: integer
                  minimum: 0
                  description: The pipeline's position in the board's pipeline menu (ascending). Reorder by sending each moved pipeline its new position.
      responses:
        "200":
          description: Pipeline updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "404":
          $ref: "#/components/responses/NotFound"
    delete:
      operationId: deletePipeline
      summary: Delete a pipeline
      tags:
        - Pipelines
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: force
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      responses:
        "200":
          description: "Pipeline deleted, or archived ({ id, archived: true }); a pipeline another request archived first answers { id, archived: true, alreadyArchived: true } untouched"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "404":
          $ref: "#/components/responses/NotFound"
        "409":
          description: "Refused, nothing changed: active deals without force, a live unattended-lead sweep or the DPP feed on the pipeline, or intake_target (enabled intake creates deal cards in this pipeline)"

  /pipelines/{id}/stages:
    get:
      operationId: listPipelineStages
      summary: List stages for a pipeline
      tags:
        - Pipelines
      parameters:
        - $ref: "#/components/parameters/IdParam"
      responses:
        "200":
          description: Ordered list of stages
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
    post:
      operationId: createPipelineStage
      summary: Add a stage to a pipeline
      tags:
        - Pipelines
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/PipelineStageCreate"
      responses:
        "201":
          description: Stage created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "409":
          description: 'pipeline_archived: the pipeline was archived while this request waited ("This pipeline was archived meanwhile."); nothing created'

  /pipelines/{id}/stages/reorder:
    post:
      operationId: reorderPipelineStages
      summary: Reorder a pipeline's stages (board columns), atomically
      description: Writes every stage's position in ONE transaction under the pipeline-stage lock. order must list every stage id of the pipeline exactly once and may not put a system holding stage first unless it already is; expectedRevision is the order the caller last read (stage ids by position, comma-joined). Owner / admin.
      tags:
        - Pipelines
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - order
                - expectedRevision
              properties:
                order:
                  type: array
                  items:
                    type: string
                    format: uuid
                expectedRevision:
                  type: string
      responses:
        "200":
          description: "The canonical order and its new revision: { order, revision }"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          description: Not a complete permutation, or a system holding stage moved first
        "409":
          description: "order_changed: the order moved since the caller read it; pipeline_archived: the pipeline was archived while this request waited. Nothing written"

  /pipelines/{id}/archive:
    post:
      operationId: archivePipeline
      summary: Archive a pipeline, moving its open deals, in one transaction
      description: "Every open deal moves to the first rep-facing stage of moveOpenDealsTo through the normal transition path (stage-entry rules, automation-only lock, stage-change activities and events, status taxonomy); won / lost deals stay in the pipeline as history; the pipeline is archived (renamed), never deleted, so it can be restored. Any refusal aborts everything: nothing moves, nothing is archived. The default pipeline is refused. Owner / admin."
      tags:
        - Pipelines
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                moveOpenDealsTo:
                  type: string
                  format: uuid
                  nullable: true
                  description: The pipeline the open deals move to; null when the pipeline has none
                expectedSettingsRevision:
                  type: string
                  description: Optional account settings revision the caller read; a mismatch is a 409 stale_settings_revision
      responses:
        "200":
          description: "{ id, archived: true, movedOpenDeals, movedTo }; when another request archived the pipeline first (before or while this one ran): { id, archived: true, alreadyArchived: true, movedOpenDeals: 0, movedTo: null }, nothing moved"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          description: The target is missing, archived, the pipeline itself, or has no rep-facing stage
        "409":
          description: "Refused, nothing changed: open_deals (no target given), target_not_open (the target's first rep-facing stage is won or lost), stage_requirements (a deal the target stage refuses; the message names it), archive_too_large (more than 500 open deals: move or close them in batches first), dpp_post_close (the DPP feed's Post-Close pipeline), target_archived (the destination pipeline was archived while this request waited: choose another), intake_target (enabled intake creates deal cards in this pipeline), default_pipeline, stale_settings_revision, archive_raced, or a live unattended-lead sweep on the pipeline"

  /pipelines/{id}/restore:
    post:
      operationId: restorePipeline
      summary: Restore an archived pipeline
      description: "Owner or admin. One transaction under the account's pipeline-order lock: the archived pipeline gets its name back, joins the end of the active order (positions renumbered dense) and is never the default; its stages and closed deals come back with it. Counts toward the plan's pipeline limit."
      tags:
        - Pipelines
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      responses:
        "200":
          description: The restored pipeline with its stages
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "403":
          description: PLAN_LIMIT_REACHED, or not an owner / admin
        "404":
          description: No archived pipeline with this id in the account (an active id is a 404 too)
        "409":
          description: "name_taken: an active pipeline already has its name (any case). Rename that one first."

  /pipelines/{id}/stages/{stageId}:
    patch:
      operationId: updatePipelineStage
      summary: Update a pipeline stage
      tags:
        - Pipelines
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: stageId
          in: path
          required: true
          schema:
            type: string
            format: uuid
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/PipelineStageCreate"
      responses:
        "200":
          description: Stage updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "409":
          description: "kind_change_blocked: isWon / isLost would change while open deals occupy the stage (openDeals carries the count); move them first. An empty stage changes freely. pipeline_archived: the pipeline was archived while this request waited; nothing changed"
    delete:
      operationId: deletePipelineStage
      summary: Delete a pipeline stage
      description: "Soft delete: the stage row is kept (so deal history, activities, audit rows and reports keep its name) and the stage disappears from every pipeline and stage list and cannot be moved into; its name may be reused by a new stage. Deleting a stage with no CURRENT deals always works, even if deals once used it (deal history never blocks). Refused (409) only while deals are currently in the stage, unless move_to names another stage of the same pipeline: then the stage's live deals move there and the stage is deleted in one transaction (the stage only: no status change). Also refused (409) while an active automation uses the stage (an action, trigger, condition or wait-until, or the N-day sweep), while the DPP status map selects it, or while enabled intake creates deal cards in it. Appointment-outcome mappings to the stage and its stage rule are removed, as is its status metadata. A run already parked or in flight before the delete is not tracked: at the step that targets the deleted stage it fails or is skipped with a clear reason in the execution log (recovering a failed run whose frozen graph uses a deleted stage is refused with 409). There is no restore in v1."
      tags:
        - Pipelines
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: stageId
          in: path
          required: true
          schema:
            type: string
            format: uuid
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: expected_settings_revision
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: expectedSettingsRevision
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: move_to
          in: query
          required: false
          description: Move the stage's live deals to this stage (same pipeline, not a system holding stage, same won / lost setting) and delete the stage.
          schema:
            type: string
            format: uuid
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      responses:
        "200":
          description: "Stage deleted (expected_settings_revision given): { id, deleted: true, settingsRevision }"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "204":
          description: Stage deleted
        "400":
          description: move_to is not a stage of the pipeline, is the stage itself or a system holding stage, or has another won / lost setting
        "409":
          description: Deals are currently in the stage (and no move_to was given), an active unattended-lead automation or the DPP status map selects it, intake_target (enabled intake creates deal cards in this stage), pipeline_archived (the pipeline was archived while this request waited; nothing moved or deleted), or stale_settings_revision
    get:
      x-generated: true
      operationId: getPipelinesIdStagesStageId
      summary: Get pipelines id stages stageId
      tags:
        - Pipelines
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
        - name: stageId
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  # ──────────────────────────────────────────────
  # Tasks
  # ──────────────────────────────────────────────
  /tasks:
    get:
      operationId: listTasks
      summary: List tasks
      tags:
        - Tasks
      parameters:
        - name: assigned_to
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
            format: uuid
        - name: assignedTo
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
            format: uuid
        - name: contact_id
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
            format: uuid
        - name: contactId
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
            format: uuid
        - name: deal_id
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
            format: uuid
        - name: dealId
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
            format: uuid
        - name: dueFrom
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: dueTo
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: order
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
            enum:
              - asc
              - desc
            default: desc
          x-default-provenance: schema
        - name: overdue
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: boolean
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: schema
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
          x-default-provenance: schema
        - name: priority
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
            enum:
              - low
              - medium
              - high
              - urgent
        - $ref: "#/components/parameters/SearchParam"
        - name: sort
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
            enum:
              - createdAt
              - updatedAt
              - dueDate
              - priority
              - title
              - status
            default: createdAt
          x-default-provenance: schema
        - name: status
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
            enum:
              - todo
              - in_progress
              - done
        - name: tab
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
            enum:
              - my_tasks
              - all
              - completed
      responses:
        "200":
          description: Paginated list of tasks
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PaginatedResponse"
    post:
      operationId: createTask
      summary: Create a task
      description: 'Creates a task, optionally on a contact and/or a deal. As a Pipeline health quick fix ("Set next action"), send `checkOrigin` + `expectedDealUpdatedAt` with `dealId`: the task is created only while the deal still needs it (see TaskCreate.checkOrigin); the database allows at most one non-done quick-fix task per deal (a second is refused 409 `deal_has_next_action`). Ordinary tasks are unconstrained: they may coexist with a quick-fix task, and may race one.'
      tags:
        - Tasks
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/TaskCreate"
      responses:
        "201":
          description: Task created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          description: "Invalid task payload, or (code `health_fix_mismatch`) a health-fix request that is not a next-action fix: `checkOrigin` not one of high_value_idle / needs_action, or without `dealId` or `expectedDealUpdatedAt`, or `expectedDealUpdatedAt` without `checkOrigin`. Nothing read or written."
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "409":
          description: "Nothing was written. A health quick fix refused (HealthFixRefusal: `deal_changed`, `deal_has_next_action`, `deal_check_cleared`, with the deal's current row), the contact was merged or deleted mid-request (no code: retry against the surviving record), or an Idempotency-Key conflict (see the header)."
          content:
            application/json:
              schema:
                oneOf:
                  - $ref: "#/components/schemas/HealthFixRefusal"
                  - type: object
                    required:
                      - error
                    not:
                      required:
                        - row
                    properties:
                      error:
                        type: string
                      code:
                        type: string
                        not:
                          enum:
                            - deal_changed
                            - deal_has_next_action
                            - deal_check_cleared
      parameters:
        - name: Idempotency-Key
          in: header
          required: false
          description: "Optional: one key per creation attempt (1-255 printable ASCII characters, not blank), reused only to retry the SAME request. Same key + same request body replays the original response (Idempotent-Replay: true); same key + a different body is refused with 422. Two DISTINCT 409s under this key, never interchangeable: (1) the ORIGINAL attempt is still being processed — wait for the Retry-After seconds given, then retry with the SAME key; (2) the key was already SPENT by a prior attempt that failed or has an unknown outcome (code idempotency_key_spent) — verify whether that attempt took effect BEFORE sending a brand-new key; resending the SAME key here only replays this 409 again, it never re-runs the request. If the wrapper's OWN write to RELEASE a failed attempt's claim cannot be confirmed, the SAME key instead answers 503 idempotency_claim_held until the held claim expires — retry with a NEW key, never the same one. If the wrapper's OWN write to confirm a SUCCESSFUL completion cannot be confirmed, the mutation may have gone through anyway: the SAME key instead answers 503 idempotency_outcome_unknown — verify the outcome before any new-key retry, exactly as case (2) above. A blank or malformed key is refused with 400 idempotency_key_invalid, on dry_run requests too (a dry run never records the key)."
          schema:
            type: string
            pattern: ^[!-~](?:[ -~]{0,253}[!-~])?$
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

