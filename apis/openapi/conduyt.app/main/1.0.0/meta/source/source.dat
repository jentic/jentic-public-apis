          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: expected_updated_at
          in: query
          required: false
          description: "The row's updatedAt as the caller read it: a row changed or moved since is a 409 metadata_changed (the settings page always sends it). Without it, only a move under this request is caught."
          schema:
            type: string
            format: date-time
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean
      responses:
        "204":
          description: Deleted
        "404":
          description: "status_metadata_not_found: no status metadata with this id that you can see (a malformed id, an unknown or hidden one, or one deleted while this request waited). Nothing deleted."
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                  - code
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - status_metadata_not_found
        "409":
          description: "pipeline_archived: the stage's pipeline was archived while this request waited on its stage lock (\"This pipeline was archived meanwhile.\"); metadata_changed: the row is not the version the caller named in expectedUpdatedAt (or it moved to another stage under the request); `current` is the row now. Nothing written."
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                  - code
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - pipeline_archived
                      - metadata_changed
                  current:
                    type: object
                    description: "With metadata_changed: the row as it is now (the version to retry against is its updatedAt)"
    get:
      x-generated: true
      operationId: getStatusMetadataId
      summary: Get status-metadata id
      tags:
        - Status Metadata
      parameters:
        - name: id
          in: path
