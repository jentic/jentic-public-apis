  /sms-providers/template-options:
    get:
      operationId: getSmsProvidersTemplateOptions
      summary: List the SMS providers a template can be bound to (redacted)
      description: |
        The redacted provider list the SMS Templates page loads: each ACTIVE provider's id, name and colour, ordered by name,
        for the caller's own account. Nothing else is returned: no webhook URL or headers, field mapping, counts or
        credentials. The caller needs email_templates.view OR settings.view (the management route GET /sms-providers
        needs settings.view only). An API key reaches it with an `emails`, `sms`, `messages` or `settings` scope (the member behind the key still needs one of the two permissions). Unlike GET /sms-providers/options (the send
        picker: usable, URL-safe webhook providers) this lists every active provider, builtin included.
      tags:
        - Sms Providers
      responses:
        "200":
          description: The active providers
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    type: array
                    items:
                      type: object
                      required:
                        - id
                        - name
                        - color
                      properties:
                        id:
                          type: string
                          format: uuid
                        name:
                          type: string
                        color:
                          type: string
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          description: Neither email_templates.view nor settings.view
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
      parameters: []
