  /forms/{id}/submissions:
    get:
      operationId: listFormSubmissions
      summary: List submissions for a form
      tags:
        - Forms
      parameters:
        - $ref: "#/components/parameters/IdParam"
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
          x-default-provenance: handler_literal
      responses:
        "200":
          description: Paginated form submissions
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  /forms/{id}/submit:
    post:
      operationId: submitForm
      summary: Submit a form (public, no auth)
      description: "Idempotent retries: send a random UUID v4 per attempt as _submissionKey. A lost response or a 409 submission_unconfirmed answer is retried with the same payload and the submissionKey that answer carries (it can differ from the key sent). A key whose submission committed answers 201 with replayed: true and runs nothing twice. Retrying without a key creates a second submission."
      tags:
        - Forms
      security: []
      parameters:
        - $ref: "#/components/parameters/IdParam"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - data
              properties:
                data:
                  type: object
                  additionalProperties: true
                  description: Key-value pairs matching the form's field definitions
                _submissionKey:
                  type: string
                  format: uuid
                  description: Idempotency key, a random UUID v4 generated per attempt; reuse it (or the one a 409 answer returns) on every retry. Other UUID versions are ignored.
                _hp_field:
                  type: string
                  description: Honeypot, leave empty
                consent:
                  type: object
                  additionalProperties: true
                utm:
                  type: object
                  additionalProperties: true
                attribution:
                  type: object
                  additionalProperties: true
                source:
                  type: string
      responses:
        "201":
          description: Submission accepted (replayed is true when the key's earlier attempt had already committed)
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    type: object
                    properties:
                      id:
                        type: string
                        format: uuid
                      contactId:
                        type: string
                        format: uuid
                        nullable: true
                      redirectUrl:
                        type: string
                        nullable: true
                      thankYouMessage:
                        type: string
                        nullable: true
                  warnings:
                    type: array
                    description: Present only when the submission was saved but an answer could not be stored. A phone answer that is not a valid number is not saved (the lead is never refused over it); the contact gets an activity naming it.
                    items:
                      type: object
                      required:
                        - field
                        - code
                        - value
                      properties:
                        field:
                          type: string
                        code:
                          type: string
                          enum:
                            - phone_invalid
                        value:
                          type: string
                  replayed:
                    type: boolean
        "400":
          description: Validation failed
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "404":
          description: Form not found or inactive
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
        "409":
          description: The attempt could not be confirmed. Retry the same payload with submissionKey; uploadsNeedReattach means the attempt's file uploads must be uploaded again first.
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                  - code
                  - submissionKey
                  - uploadsNeedReattach
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - submission_unconfirmed
                  submissionKey:
                    type: string
                    format: uuid
                  uploadsNeedReattach:
                    type: boolean
    options:
      x-generated: true
      operationId: optionsFormsIdSubmit
      summary: OPTIONS forms id submit
      tags:
        - Forms
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

