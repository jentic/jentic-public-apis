  # ──────────────────────────────────────────────
  # API Keys
  # ──────────────────────────────────────────────
  /api-keys:
    get:
      operationId: listApiKeys
      summary: List API keys (owner/admin only)
      description: Returns API key metadata. Never returns the full key.
      tags:
        - API Keys
      responses:
        "200":
          description: List of API keys
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "403":
          $ref: "#/components/responses/Forbidden"
      parameters:
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 25
            minimum: 1
            maximum: 100
          x-default-provenance: handler_literal
    post:
      operationId: createApiKey
      summary: Generate a new API key (owner/admin only)
      description: Returns the full key exactly once. Store it securely.
      tags:
        - API Keys
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - name
              properties:
                name:
                  type: string
                  minLength: 1
                  maxLength: 100
                scopes:
                  type: array
                  items:
                    type: string
      responses:
        "200":
          description: API key created (includes full key)
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    type: object
                    properties:
                      id:
                        type: string
                        format: uuid
                      name:
                        type: string
                      keyPrefix:
                        type: string
                      key:
                        type: string
                        description: Full API key (shown once)
                      createdAt:
                        type: string
                        format: date-time
        "403":
          $ref: "#/components/responses/Forbidden"
      parameters: []

  /api-keys/check:
    get:
      operationId: checkApiKey
      summary: Check current API key metadata
      description: Returns tier, scopes, rate limit, IP allowlist, and usage for the API key used on the request.
      tags:
        - API Keys
      responses:
        "200":
          description: API key metadata
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          description: Request was not authenticated with an API key
      parameters: []

  /api-keys/{id}:
    patch:
      operationId: updateApiKey
      summary: Update an API key
      description: Update key name, tier, scopes, IP allowlist, rate limit, and optional expiry. API-key auth cannot manage API keys.
      tags:
        - API Keys
      parameters:
        - $ref: "#/components/parameters/IdParam"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                  minLength: 1
                  maxLength: 100
                tier:
                  type: string
                  enum:
                    - read
                    - write
                    - admin
                scopes:
                  type: array
                  items:
                    type: string
                ipAllowlist:
                  type: array
                  items:
                    type: string
                rateLimit:
                  type: integer
                  minimum: 1
                  maximum: 10000
                expiresAt:
                  type: string
                  format: date-time
                  nullable: true
      responses:
        "200":
          description: API key updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "403":
          $ref: "#/components/responses/Forbidden"
    delete:
      operationId: revokeApiKey
      summary: Revoke an API key
      tags:
        - API Keys
      parameters:
        - $ref: "#/components/parameters/IdParam"
      responses:
        "200":
          description: API key revoked
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
    get:
      x-generated: true
      operationId: getApiKeysId
      summary: Get api-keys id
      tags:
        - Api Keys
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  # ──────────────────────────────────────────────
  # Users
  # ──────────────────────────────────────────────
  /users:
    get:
      operationId: listUsers
      summary: List team members
      tags:
        - Users
      responses:
        "200":
          description: Team member list
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: group_id
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: include_activity
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: boolean
        - name: include_stats
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: boolean
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
          x-default-provenance: handler_literal
        - name: roster
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: boolean
        - name: search
          in: query
          required: false
