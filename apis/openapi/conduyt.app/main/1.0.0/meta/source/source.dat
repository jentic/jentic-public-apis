  /imports/{id}/resubmit:
    post:
      x-generated: true
      operationId: postImportsIdResubmit
      summary: Create / invoke imports id resubmit
      tags:
        - Imports
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - corrections
              properties:
                corrections:
                  type: array
                  minItems: 1
                  items:
                    type: object
                    required:
                      - row
                      - corrections
                    properties:
                      row:
                        type: integer
                        minimum: 2
                        description: The spreadsheet row number of the failed row (the header is row 1)
                      corrections:
                        type: object
                        additionalProperties:
                          type: string
                        description: Field name to corrected value; every value is a string
                      fieldOverrides:
                        type: array
                        description: Re-map a source column to a different field for this row
                        items:
                          type: object
                          required:
                            - sourceColumn
                            - fromField
                            - toField
                          properties:
                            sourceColumn:
                              type: string
                            fromField:
                              type: string
                            toField:
                              type: string
                      workflowDecision:
                        type: string
                        enum:
                          - proceed
                          - reenroll
                          - skip
                      createAsNew:
                        type: boolean
                        description: "Reviewer-approved override for possible-duplicate rows: skip contact matching and create a new contact"
                  description: "Required, non-empty array of per-row fixes: { row (required, 2 or higher), corrections (required object of string values), fieldOverrides?, workflowDecision?, createAsNew? }"
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
