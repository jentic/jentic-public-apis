  /users/me:
    get:
      operationId: getUsersMe
      summary: Get the current user and account
      description: Returns the same response as GET /auth/me — this route re-exports that handler, so the two are identical, byte for byte, for the same caller and request. The caller's own user record, the current account, role, permissions and (for an API-key caller) the key's own metadata. The account's display name is at `data.account.name`.
      tags:
        - Users
      parameters: []
      responses:
        "200":
          description: The current user and account.
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: "#/components/schemas/MeResponseData"
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          description: "An API-key caller only: the key (or an ancestor in its lineage) denies this request — an IP outside the key's allowlist, a method its tier doesn't allow, a scope it lacks, or a child key that is unrestricted or missing an ancestor's explicit-only grant. Never returned for a browser session."
        "429":
          description: An API-key caller only — the key's own rate limit, or its lineage-wide rate limit, is exceeded. Never returned for a browser session.
        "500":
          description: Internal server error.
    patch:
      x-generated: true
      operationId: patchUsersMe
      summary: Update users me
      tags:
        - Users
      requestBody:
        required: false
        content:
          application/json:
            schema:
              type: object
              additionalProperties: true
              description: See GET /schema/api-catalog (authenticated) for the full field-level request schema of this endpoint.
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
  /me/email-signature:
    get:
      operationId: getMyEmailSignature
      summary: Get your own email signature in this workspace
      description: |
        One signature per workspace member. Returns the saved signature (or, when none is saved yet, the draft a first visit
        starts from: saved false, html null), every field's resolved value and source (fields: profile = the user, workspace
        = the membership's position and mobile, company = the Company details, signature = department and added networks),
        and the context the editor previews with (the caller's profile, position, the account's branding and Company
        details, the caller's own active booking pages). signature.html and signature.plain are RENDERED AT READ TIME from
        those live sources (exactly what Compose appends on the next send); a profile, membership, branding, Company
        details or booking page change shows here with no re-save. When the current sources make the saved signature too
        large to render, html and plain are null and renderError says why. A browser session, or an API key acting as its
        user (needs the emails scope).
      tags:
        - Email Signature
      parameters: []
      responses:
        "200":
          description: The caller's signature
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: "#/components/schemas/EmailSignatureResponse"
              example:
                data:
                  saved: true
                  signature:
                    designId: classic
                    overrides:
                      title: Head of Customer Support
                    options:
                      accent: null
                      font: Original
                      fsize: m
                      psize: 80
                      shape: circle
                      lw: 120
                      istyle: accent
                      ishape: c
                      isz: 22
                      icol: null
                      iglyph: auto
                      divider: true
                      addons:
                        book:
                          on: true
                          pageId: 9b2f1c4e-2a7d-4c2b-9b1e-3f5a6d7e8c90
                        signoff:
                          on: false
                          text: Best regards,
                        banner:
                          on: false
                          text: ""
                          url: ""
                        meet:
                          on: false
                          text: Join my video meeting
                          url: ""
                        disclaimer:
                          on: true
                        green:
                          on: false
                        credit:
                          on: true
                      compose:
                        newEmails: true
                        replies: true
                    useInCompose: true
                    html: <div data-conduyt-signature="v1"><table role="presentation">...</table></div>
                    plain: |-
                      Jordan Tate
                      Head of Customer Support
                      Demolition Group
                    renderError: null
                    updatedAt: 2026-10-15T17:02:11.000Z
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          description: not_a_member, the caller is not an active member of this workspace
    put:
      operationId: putMyEmailSignature
      summary: Save your own email signature (replaces it)
      description: |
        Saving replaces the caller's one signature in this workspace. Every part may be omitted and takes its default:
        designId classic, overrides {} (every field follows its source), the default options, useInCompose true. Only the
        choices are stored: the signature is rendered with the public generator's engine from the live sources at every
        use (this response, GET, and each send). Compose appends it (POST /messages with signature "new" or "reply"),
        rendered at send time, when useInCompose and the matching options.compose flag are on. email is never an override (it is the
        sign-in address). Links must be web addresses (overrides.web, banner and meeting links) or profile links (social).
        options.addons.book.pageId must be one of the caller's own active booking pages. A browser session, or an API key
        acting as its user (emails scope, write tier).
      tags:
        - Email Signature
      parameters: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/EmailSignatureInput"
            examples:
              basic:
                summary: Pick a design and change the position
                value:
                  designId: x02
                  overrides:
                    title: Head of Customer Support
                    dept: Support
                  options:
                    accent: "#0E1F3A"
                    addons:
                      disclaimer:
                        on: true
                  useInCompose: true
      responses:
        "200":
          description: Saved; the same shape as GET
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    $ref: "#/components/schemas/EmailSignatureResponse"
        "400":
          description: invalid_json
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
        "404":
          description: not_a_member
        "413":
          description: signature_too_large, the rendered signature is over 64 KB
        "422":
          description: invalid_signature (an unknown key, a value out of range, a link that is not one, an unknown design or network) or booking_page_not_yours
  /email-signature/designs:
    get:
      operationId: listEmailSignatureDesigns
      summary: List the 36 email signature designs and the 62 networks
      description: The 16 built-in designs and the 20 copied-style designs (the public generator's template file), each with its own accent, and the social networks a signature can link (the keys overrides.social takes). The same for every workspace. A browser session or an API key with the emails scope.
      tags:
        - Email Signature
      parameters: []
      responses:
        "200":
          description: Designs and networks
          content:
            application/json:
              schema:
                type: object
                properties:
                  data:
                    type: object
                    properties:
                      designs:
                        type: array
                        items:
                          type: object
                          properties:
                            id:
                              type: string
                            label:
                              type: string
                            desc:
                              type: string
                            group:
                              type: string
                              enum:
                                - builtin
                                - copied
                            groupLabel:
                              type: string
                              enum:
                                - Built-in
                                - Copied-style
                            accent:
                              type: string
                      counts:
                        type: object
                        properties:
                          all:
                            type: integer
                          builtin:
                            type: integer
                          copied:
                            type: integer
                      networks:
                        type: array
                        items:
                          type: object
                          properties:
                            key:
                              type: string
                            label:
                              type: string
                            placeholder:
                              type: string
              example:
                data:
                  designs:
                    - id: classic
                      label: Classic
                      desc: Photo, details and a social column
                      group: builtin
                      groupLabel: Built-in
                      accent: "#5961F9"
                    - id: x02
                      label: Charcoal
                      desc: Dark block with two outline buttons
                      group: copied
                      groupLabel: Copied-style
                      accent: "#292929"
                  counts:
                    all: 36
                    builtin: 16
                    copied: 20
                  networks:
                    - key: linkedin
                      label: LinkedIn
                      placeholder: linkedin.com/in/you
        "401":
          $ref: "#/components/responses/Unauthorized"
        "403":
          $ref: "#/components/responses/Forbidden"
