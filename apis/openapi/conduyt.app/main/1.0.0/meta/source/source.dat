          description: Available time slots
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"

  /availability:
    get:
      operationId: getAvailability
      summary: Get current user's availability rules
      tags:
        - Booking Pages
      responses:
        "200":
          description: Availability rules
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters: []
    put:
      operationId: setAvailability
      summary: Set availability rules
      tags:
        - Booking Pages
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - rules
              properties:
                rules:
                  type: array
                  items:
                    type: object
                    properties:
                      dayOfWeek:
                        type: integer
                        minimum: 0
                        maximum: 6
                      startTime:
                        type: string
                        description: HH:mm format
                      endTime:
                        type: string
                        description: HH:mm format
      responses:
        "200":
          description: Availability updated
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters: []

  # ──────────────────────────────────────────────
