          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: smartListId
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: source
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: tag
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: tags
          in: query
          required: false
          description: Query parameter read by this route.
