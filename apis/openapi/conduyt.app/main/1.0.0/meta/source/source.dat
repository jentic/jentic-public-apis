          description: "stage_not_found: the stage named (stage_id) does not exist in this account, or was deleted while this request waited; drip_track_not_found: likewise for drip_track_id. Nothing written."
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                  - code
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - stage_not_found
                      - drip_track_not_found
        "409":
          description: "pipeline_archived: the stage's pipeline was archived while this request waited on its stage lock (\"This pipeline was archived meanwhile.\"), nothing written"
          content:
            application/json:
              schema:
                type: object
                required:
                  - error
                  - code
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - pipeline_archived
                  current:
                    type: object
                    description: "With metadata_changed: the row as it is now (the version to retry against is its updatedAt)"
