    post:
      x-generated: true
      operationId: postBillingAddons
      summary: Create / invoke billing addons
      tags:
        - Billing
      parameters:
        - name: Idempotency-Key
          in: header
          required: true
          description: "One key per purchase attempt (8-64 characters of [A-Za-z0-9_-]). Reuse it only to retry the SAME request after an ambiguous answer; the server completes or replays your own attempt and refuses a different key that meets an add-on someone else already bought (409 addon_already_active with the live quantity: add more with PATCH). Missing or malformed: 400 idempotency_key_required."
          schema:
            type: string
            pattern: ^[A-Za-z0-9_-]{8,64}$
      requestBody:
        required: false
        content:
          application/json:
            schema:
              type: object
              additionalProperties: true
              description: See GET /schema/api-catalog (authenticated) for the full field-level request schema of this endpoint.
      responses:
        "201":
          description: Created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
    patch:
      x-generated: true
      operationId: patchBillingAddons
      summary: Update billing addons
      tags:
        - Billing
      parameters:
        - name: Idempotency-Key
          in: header
          required: false
          description: "Recommended: one key per quantity change (8-64 characters of [A-Za-z0-9_-]), reused only to retry the same request. With the required body field expectedQuantity, a different key from the same base is refused as stale (409 stale_quantity) instead of being reported as done."
          schema:
            type: string
            pattern: ^[A-Za-z0-9_-]{8,64}$
      requestBody:
        required: false
        content:
          application/json:
            schema:
              type: object
              additionalProperties: true
              description: See GET /schema/api-catalog (authenticated) for the full field-level request schema of this endpoint.
