  /contacts/score:
    get:
      operationId: scoreContactsBatch
      summary: Get lead scores for up to 100 contacts in one call
      description: Batch twin of GET /contacts/{id}/score, used by the contacts list so a page makes one request instead of one per row. A GET, so read-tier and sandbox keys reach it and it spends no mutation budget. Same permission (contacts view) and same visibility as the single-contact route. Ids that do not exist, belong to another account, are deleted or are not visible to the caller are absent from scores (never an error). More than 100 ids is a 400. Each entry carries contactId, score, tier, breakdown, signals and computedAt.
      tags:
        - Contacts
      parameters:
        - name: ids
          in: query
          required: true
          description: Contact ids to score, comma separated (the parameter may also repeat). At most 100; duplicates are scored once.
          schema:
            type: string
      responses:
        "200":
          description: Scores for the visible ids, under data.scores
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"

  /contacts/duplicates:
    get:
      operationId: findDuplicateContacts
      summary: Find duplicate contacts
      tags:
        - Contacts
      responses:
        "200":
          description: List of duplicate contact groups
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters: []

  /contacts/merge:
    post:
      operationId: mergeContacts
      summary: Merge two contacts
      tags:
        - Contacts
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - primaryId
                - secondaryId
              properties:
                primaryId:
                  type: string
                  format: uuid
                  description: Contact to keep
                secondaryId:
                  type: string
                  format: uuid
                  description: Contact to merge into primary (will be deleted)
      responses:
        "200":
          description: Contacts merged
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
        "400":
          $ref: "#/components/responses/BadRequest"
        "404":
          $ref: "#/components/responses/NotFound"
        "503":
          description: "Retryable, nothing was changed (every attempt rolled back). code merge_contacts_busy: a contact stayed busy for the merge's whole lock budget (a delivery in flight, or another merge or GDPR erasure of the same contact). code merge_budget_exhausted: the request's time budget left no room for another attempt. Retry after the Retry-After seconds."
          headers:
            Retry-After:
              description: Seconds to wait before retrying
              schema:
                type: integer
          content:
            application/json:
              schema:
                type: object
                properties:
                  error:
                    type: string
                  code:
                    type: string
                    enum:
                      - merge_contacts_busy
                      - merge_budget_exhausted
      parameters:
        - name: dry_run
          in: query
          required: false
          description: Validate the mutation without persisting changes.
          schema:
            type: boolean
        - name: sandbox
          in: query
          required: false
          description: Run the mutation in sandbox mode.
          schema:
            type: boolean

  /contacts/export:
    get:
      operationId: exportContacts
      summary: Export contacts as CSV
      tags:
        - Contacts
      responses:
        "200":
          description: CSV file download
          content:
            text/csv:
              schema:
                type: string
      parameters:
        - name: assigned_to
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: cf
          in: query
          required: false
          description: string — compact custom-field filters for generated clients. Use fieldKey=value pairs (comma-separated) or a JSON object; values can be exact, __notempty__, or __empty__.
          schema:
            type: string
        - name: company
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: company_id
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: created_from
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: created_to
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: email
          in: query
          required: false
          description: Exact email lookup, repeatable (?email=a@x.com&email=b@y.com; form style, exploded). Each value is trimmed and lower-cased, must be a valid address of at most 254 characters, and matches the contact's primary email or any secondary email slot (email_2 and up). Duplicates collapse; at most 20 distinct addresses. An invalid or empty value, or more than 20 distinct addresses, is a 400. Combines with every other filter (AND), inside the caller's account and visibility. Accounts whose identifier index is still being built answer from a slower lookup; if the stored spellings of the requested addresses exceed that lookup's bind budget (a count of spellings, not of contacts, and other filters do not reduce it), the answer is a 422 until the identifier backfill completes.
          style: form
          explode: true
          schema:
            type: array
            items:
              type: string
            uniqueItems: false
        - name: exclude_master_status
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: filters
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: format
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: import_id
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: master_status
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: min_score
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: integer
        - name: reachability
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: search
