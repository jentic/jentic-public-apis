  /automations/{id}/test-node:
    post:
      x-generated: true
      operationId: postAutomationsIdTestNode
      summary: Create / invoke automations id test-node
      tags:
        - Automations
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - nodeId
              properties:
                nodeId:
                  type: string
                  description: Required id of the node to simulate (the automation's v2 graph node)
                contactId:
                  type: string
                  format: uuid
                  description: "Optional contact the simulated event is about: merge tokens, contact-backed trigger filters and contact.* conditions are judged against this real contact (required when the occurrence or the graph reads the contact); refused (400) on a company occurrence, which carries no contact in production (the workflow is simulated without one)"
                triggerNodeId:
                  type: string
                  description: "Optional id of the trigger occurrence to simulate, one of the workflow's admitted occurrences (the column trigger, or a safely placed trigger node of a native v2 graph); omitted: the workflow's default occurrence. An unknown or unadmitted id is a 400"
                dealId:
                  type: string
                  format: uuid
                  description: "The event's deal for a DEAL occurrence (deal.created / stage_changed / won / lost / ...): REQUIRED, 400 without it (the contact's newest deal is never a substitute); must be a deal you can see (deals.view and pipeline visibility), 404 otherwise; refused (400) when the selected occurrence is not a deal event"
                previousStageId:
                  type: string
                  format: uuid
                  description: "For a deal.stage_changed occurrence whose trigger filter reads the stage the deal moved FROM (from_stage / previousStageId): the uuid of that stage. Without it such an occurrence is unjudgeable (409). Ignored elsewhere"
                previousPipelineId:
                  type: string
                  format: uuid
                  description: "For a deal.stage_changed occurrence whose trigger filter reads the pipeline the deal moved FROM: the uuid of that pipeline. Without it such an occurrence is unjudgeable (409). Ignored elsewhere"
                appointmentId:
                  type: string
                  format: uuid
                  description: "Optional appointment (owned by the contact; calendar.view): the event's appointment for an appointment occurrence, {{extras.*}} tokens and appointment-derived conditions are judged on it. Omitted: the dry run alone infers the contact's latest ACTIVE appointment (scheduled / confirmed, latest start time) for an appointment.booked occurrence and none for any other; the node test never infers one, so an appointment occurrence whose filter reads the appointment is unjudgeable (409) without it"
                executionId:
                  type: string
                  format: uuid
                  description: "Optional id of a stored run of THIS automation to replay (admin or owner only). The replay supplies ONE fact: the company carried by that run's stored payload, read the way the live runner reads it; nothing else about the subject comes from the run. The run must belong to this account and this automation, carry the same trigger event as the occurrence being previewed, and the same contact and deal as the preview; otherwise 404 (not found, or a deal run hidden from API keys without the deals scope) or 400 (other event or other subject). Runs that carry a deal are hidden from API keys without the deals scope. On a COMPANY occurrence companyId stays required and executionId does not replace it (it must equal the replayed payload's company). Omitted, on a non-company occurrence: the preview is a synthetic sample, company rules evaluate as unknown/absent, and the response says so"
                companyId:
                  type: string
                  format: uuid
                  description: "The event's company for a COMPANY occurrence (company.created / updated / stage_changed / deleted / tagged / tag_removed): REQUIRED, 400 without it; needs companies.view, 404 when not found in this account; executionId does not replace it. On any other occurrence it is accepted only when it equals the company carried by the replayed executionId payload, else refused (400). With executionId on a company occurrence it must equal the replayed payload's company (400 otherwise). Company producers carry no contact, so contact filters on such an occurrence are judged as production judges them, without one"
      responses:
        "200":
          description: Success
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
