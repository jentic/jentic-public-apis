        "200":
          description: All forms
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: include_archived
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: boolean
        - name: is_active
          in: query
          required: false
          description: Query parameter read by this route.
          schema:
            type: string
        - name: page
          in: query
          required: false
          description: Page number
          schema:
            type: integer
            default: 1
            minimum: 1
          x-default-provenance: handler_literal
        - name: per_page
          in: query
          required: false
          description: Items per page (max 200)
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
          x-default-provenance: handler_literal
        - name: search
          in: query
          required: false
          description: Full-text search query
          schema:
            type: string
    post:
      operationId: createForm
      summary: Create a form
      tags:
        - Forms
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - name
                - slug
                - fields
              properties:
                name:
                  type: string
                slug:
                  type: string
                description:
                  type: string
                fields:
                  type: array
                  items:
                    type: object
                settings:
                  type: object
                redirectUrl:
                  type: string
                thankYouMessage:
                  type: string
                template:
                  type: string
                  nullable: true
                  enum:
                    - bda
                  description: Hosted page template. null (default) renders the standard card; "bda" renders the BDA split panel. Any other value is a 400.
      responses:
        "201":
          description: Form created
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataEnvelope"
      parameters:
        - name: dry_run
          in: query
