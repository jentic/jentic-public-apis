  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A BulkTranscripts API key (bt_ak_...) created at /app -> MCP & API -> API keys, a license key from checkout, or an OAuth access token from the MCP sign-in."
      },
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "The same API key, if you prefer a dedicated header over Authorization."
      }
    },
    "schemas": {
      "BulkJob": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "stopped",
              "failed"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "discovering",
              "extracting",
              "finished"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "nullable": true
              },
              "title": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "videos_found": {
            "type": "integer",
            "nullable": true,
            "description": "null until the listing has finished."
          },
          "total": {
            "type": "integer"
          },
          "completed": {
            "type": "integer"
          },
          "cached": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "skipped": {
            "type": "integer",
            "description": "Videos without captions."
          },
          "quota": {
            "type": "integer",
            "description": "Not attempted for lack of credits."
          },
          "interrupted": {
            "type": "integer"
          },
          "remaining": {
            "type": "integer"
          },
          "error": {
            "type": "object",
            "nullable": true,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "check_again_in_seconds": {
