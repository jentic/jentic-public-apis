{
  "openapi": "3.0.3",
  "info": {
    "title": "BulkTranscripts API",
    "version": "1.1.0",
    "description": "YouTube transcripts, search, and channel/playlist listings. Every request needs an API key: create one free at https://bulktranscripts.co/app?tab=mcp (Google sign-in, 30 free credits, no card) and send it as Authorization: Bearer bt_ak_... or X-API-Key. A license key from checkout and an MCP OAuth access token work as Bearer tokens too. A request with no credential returns 401 missing_api_key. A transcript costs 1 credit the first time it enters your library, even if another caller already cached it; repeat reads from your own library are free. Rate limits: 120 requests/min per IP overall, 30/min under /api/v1. Docs: https://bulktranscripts.co/docs",
    "x-jentic-source-url": "https://bulktranscripts.co/openapi.json"
  },
  "servers": [
    {
      "url": "https://bulktranscripts.co"
    }
  ],
  "paths": {
    "/api/v1/transcript": {
      "get": {
        "operationId": "getTranscript",
        "summary": "Get a video's transcript",
        "description": "Get a video's transcript Cost: 1 credit on first library addition; repeat reads are free.",
        "parameters": [
          {
            "name": "video",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "YouTube URL or 11-char video id."
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Preferred caption language codes, comma-separated. Default en; falls back to whatever the video has."
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "json (default), txt, md, srt, vtt, csv, or ai. Non-JSON formats return the rendered file."
          },
          {
            "name": "segments",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "0 to omit the timestamped segment array."
          },
          {
            "name": "timestamps",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "1 to include timestamps in txt/md output."
          },
          {
            "name": "fresh",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "1 to bypass the cache (always charges a credit)."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transcript"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (invalid_input, resolution_failed, or empty_source)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing_api_key, invalid_api_key, or invalid_token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Out of credits (out_of_credits; carries purchase_url and reconnect_steps)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found (no_transcript (video has no captions; not charged) or not_found)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (rate_limited; honour the Retry-After header (seconds))",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "apiKeyHeader": []
          }
        ]
      }
    },
