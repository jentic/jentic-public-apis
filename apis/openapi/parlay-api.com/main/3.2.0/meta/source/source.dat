{
  "openapi": "3.1.0",
  "info": {
    "title": "ParlayAPI private research reads",
    "version": "3.2.0",
    "description": "Read-only sports discovery and available odds for private research using your own ParlayAPI account. Coverage varies by sport, bookmaker, market and time. Account allowances apply. No data redistribution rights are granted by this specification.",
    "termsOfService": "https://parlay-api.com/terms",
    "contact": {
      "name": "ParlayAPI support",
      "url": "https://parlay-api.com/support",
      "email": "support@parlay-api.com"
    },
    "license": {
      "name": "ParlayAPI Terms of Service",
      "url": "https://parlay-api.com/terms"
    }
  },
  "servers": [
    {
      "url": "https://parlay-api.com"
    }
  ],
  "paths": {
    "/v1/sports": {
      "get": {
        "summary": "List Sports",
        "description": "List sport identifiers. Catalog membership is not a guarantee of currently available odds.",
        "operationId": "list_sports_v1_sports_get",
        "parameters": [
          {
            "name": "all",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "All"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Sport"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "tags": [
          "Discovery"
        ],
        "security": []
      }
    },
    "/v1/sports/{sport_key}/odds": {
      "get": {
        "summary": "Get Odds",
        "description": "Retrieve available odds for a sport with optional market, bookmaker and event filters. Requires your own API key. Check the requested scope and account allowances; no fixed bookmaker count or freshness guarantee is implied.",
        "operationId": "get_odds_v1_sports__sport_key__odds_get",
        "parameters": [
          {
            "name": "sport_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Sport Key"
            }
          },
          {
            "name": "regions",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "us",
              "title": "Regions"
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "markets",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "h2h",
              "title": "Markets"
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "oddsFormat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "decimal",
              "title": "Oddsformat"
            }
          },
          {
            "name": "dateFormat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "iso",
              "title": "Dateformat"
            }
          },
          {
            "name": "bookmakers",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Bookmakers"
            },
            "style": "form",
            "explode": false
          },
          {
            "name": "eventIds",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Eventids"
            }
          },
          {
            "name": "commenceTimeFrom",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Commencetimefrom"
            }
          },
          {
            "name": "commenceTimeTo",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Commencetimeto"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Date"
            }
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "normalized",
              "title": "Include"
            }
          },
          {
            "name": "verified",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Verified"
            }
          },
          {
            "name": "live",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Live"
            }
          },
          {
            "name": "include_live",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Live"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-credit-cost-formula": "len(markets) x len(regions)",
        "x-credit-cost-floor": 1,
        "x-credit-cost-type": "variable",
        "x-credit-cost-example": "?markets=h2h,spreads&regions=us = 2x1 = 2 credits",
        "x-credit-cost-description": "Multi-market multi-region odds",
        "security": [
          {
            "apiKeyHeader": []
          },
          {
            "apiKeyQuery": []
          },
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "Sports & Odds"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Sport": {
        "type": "object",
        "properties": {
          "key": {
            "type": [
              "string",
              "null"
            ]
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "active": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "has_outrights": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "additionalProperties": true,
        "description": "Documented common fields only. Fields are optional and nullable to avoid asserting unverified runtime requirements; extensions are permitted."
      },
      "Outcome": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "price": {
            "type": [
              "number",
              "null"
            ]
          },
          "point": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": true,
        "description": "Documented common fields only. Fields are optional and nullable to avoid asserting unverified runtime requirements; extensions are permitted."
      },
      "Market": {
        "type": "object",
        "properties": {
          "key": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcomes": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Outcome"
            }
          }
        },
        "additionalProperties": true,
        "description": "Documented common fields only. Fields are optional and nullable to avoid asserting unverified runtime requirements; extensions are permitted."
      },
      "Bookmaker": {
        "type": "object",
        "properties": {
          "key": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_update": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "description": "Source timestamp representation; ISO strings or numeric timestamps may depend on dateFormat. Not a freshness guarantee."
          },
          "markets": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Market"
            }
          }
        },
        "additionalProperties": true,
        "description": "Documented common fields only. Fields are optional and nullable to avoid asserting unverified runtime requirements; extensions are permitted."
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "sport_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "sport_title": {
            "type": [
              "string",
              "null"
            ]
          },
          "commence_time": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "description": "Source timestamp representation; ISO strings or numeric timestamps may depend on dateFormat. Not a freshness guarantee."
          },
          "home_team": {
            "type": [
              "string",
              "null"
            ]
          },
          "away_team": {
            "type": [
              "string",
              "null"
            ]
          },
          "bookmakers": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Bookmaker"
            }
          }
        },
        "additionalProperties": true,
        "description": "Documented common fields only. Fields are optional and nullable to avoid asserting unverified runtime requirements; extensions are permitted."
      }
    },
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key passed in the X-API-Key header. Recommended."
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "apiKey",
        "description": "API key passed as the ?apiKey= query parameter. Useful for browser fetch() and webhooks where header control is limited. Equivalent to X-API-Key."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "APIKey",
        "description": "API key passed via Authorization: Bearer <key>. Equivalent to X-API-Key for compatibility with auth libraries that expect bearer tokens."
      }
    }
  }
}
