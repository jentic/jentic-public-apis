{
  "openapi": "3.0.3",
  "info": {
    "title": "Search Engine API",
    "description": "Multi-tenant search engine API for indexing, searching, and suggestion functionality",
    "version": "1.0.0",
    "contact": {
      "name": "Search Platform Team",
      "email": "search-support@company.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://company.com/terms"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/logituit-fae/search-engine-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://apigateway.search-engine.com/v1",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Search",
      "description": "Search operations"
    },
    {
      "name": "Suggestions",
      "description": "Autocomplete suggestions"
    },
    {
      "name": "Index Management",
      "description": "Document indexing operations"
    },
    {
      "name": "Administration",
      "description": "Administrative operations"
    },
    {
      "name": "Monitoring",
      "description": "System metrics and monitoring"
    }
  ],
  "paths": {
    "/search": {
      "post": {
        "tags": [
          "Search"
        ],
        "summary": "Perform search queries",
        "description": "Execute full-text search with filtering and faceting capabilities",
        "operationId": "search",
        "parameters": [
          {
            "name": "x-platform",
            "in": "header",
            "required": true,
            "description": "Platform identifier (e.g., web, ios, android)",
            "schema": {
              "type": "string",
              "example": "web"
            }
          },
          {
            "name": "x-version",
            "in": "header",
            "required": true,
            "description": "API version",
            "schema": {
              "type": "string",
              "example": "1.0.0"
            }
          },
          {
            "name": "x-appname",
            "in": "header",
            "required": true,
            "description": "Application name",
            "schema": {
              "type": "string",
              "example": "myapp"
            }
          },
          {
            "name": "x-Authorization",
            "in": "header",
            "required": false,
            "description": "Access token for authentication",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "description": "Unique request ID for tracking and debugging",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "daaffdc7-140c-4604-96bc-e50acf9b2e06"
            }
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              },
              "examples": {
                "racingSearch": {
                  "summary": "Search for racing games",
                  "value": {
                    "product": "play",
                    "version": "v1-desktop",
                    "tenant": "tenant1",
                    "q": "racing",
                    "filters": "category = 'racing'",
                    "facets": [
                      "category",
                      "tags"
                    ],
                    "limit": 20,
                    "offset": 0,
                    "user_id": "user_55"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful search operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                },
                "examples": {
                  "successResponse": {
                    "summary": "Successful search response",
                    "value": {
                      "success": true,
                      "data": {
                        "hits": [
                          {
                            "id": "game_998",
                            "title": "Battle Cars",
                            "description": "Fast-paced arena racing game.",
                            "category": "racing",
                            "tags": [
                              "multiplayer",
                              "cars"
                            ],
                            "rating": 4.2,
                            "thumbnail": "https://cdn.play/battlecars.png"
                          }
                        ],
                        "facets": {
                          "category": {
                            "racing": 12,
                            "sports": 4,
                            "arcade": 7
                          },
                          "tags": {
                            "cars": 8,
                            "multiplayer": 5,
                            "drift": 3
                          }
                        },
                        "processingTimeMs": 4,
                        "query": "racing",
                        "count": 20
                      },
                      "meta": {
                        "path": "/search",
                        "timestamp": "2024-01-15T10:30:00Z",
                        "request_id": "req_123456",
                        "api_version": "1.0.0",
                        "method": "POST",
                        "pagination": {
                          "limit": 20,
                          "offset": 0,
                          "total": 20
                        }
                      },
                      "error": {}
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid parameters",
            "content": {
              "application/json": {
                "examples": {
                  "invalidParameter": {
                    "summary": "Invalid parameter error",
                    "value": {
                      "success": false,
                      "message": "Provided parameter failed validation",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": 400,
                        "type": "Invalid Identifier",
                        "details": "The provided identifier is not valid"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid authentication",
            "content": {
              "application/json": {
                "examples": {
                  "unauthorized": {
                    "summary": "Unauthorized error",
                    "value": {
                      "success": false,
                      "message": "Authentication required",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": 401,
                        "type": "Unauthorized",
                        "details": "Valid authentication credentials are required to access this resource"
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Insufficient permissions",
            "content": {
              "application/json": {
                "examples": {
                  "forbidden": {
                    "summary": "Forbidden error",
                    "value": {
                      "success": false,
                      "message": "Access denied",
                      "data": {},
                      "meta": {},
                      "error": {
                        "code": 403,
                        "type": "Forbidden",
                        "details": "You do not have permission to access this resource"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
