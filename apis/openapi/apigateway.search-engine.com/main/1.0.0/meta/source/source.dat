                "indexSettings": {
                  "summary": "Example index settings",
                  "value": {
                    "tenant": "tenant1",
                    "product": "play",
                    "version": "v1",
                    "settings": {
                      "primaryKey": "id",
                      "searchableAttributes": [
                        "title",
                        "description",
                        "category"
                      ],
                      "filterableAttributes": [
                        "category",
                        "tags",
                        "rating",
                        "featured"
                      ],
                      "displayedAttributes": [
                        "id",
                        "title",
                        "description",
                        "thumbnail",
                        "category",
                        "tags",
                        "rating"
                      ],
                      "rankingRules": [
                        "words",
                        "typo",
                        "proximity",
                        "attribute",
                        "exactness",
                        "desc(rating)",
                        "desc(featured)"
                      ],
                      "typoTolerance": {
                        "enabled": true,
                        "disableOnWords": [
                          "fps",
                          "rpg"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
