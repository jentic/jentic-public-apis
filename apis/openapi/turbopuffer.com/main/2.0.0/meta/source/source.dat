{
  "openapi": "3.0.3",
  "info": {
    "title": "Turbopuffer API",
    "description": "Turbopuffer vector database REST API. A fast search engine supporting vector similarity search (ANN/kNN), BM25 full-text search, and filtered queries. Manage namespaces, upsert/patch/delete documents, and query with flexible ranking.",
    "version": "2.0.0",
    "x-jentic-source-url": "https://turbopuffer.com/docs",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://gcp-us-central1.turbopuffer.com",
      "description": "GCP US Central1 (default region)"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v2/namespaces/{namespace}": {
      "post": {
        "operationId": "writeDocuments",
        "summary": "Write Documents",
        "description": "Upsert, patch, or delete documents in a namespace. Supports row-based and column-based formats, conditional operations, and filter-based updates.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9\\-_.]{1,128}$"
            },
            "description": "Namespace identifier"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "upsert_rows": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "description": "Row-based document upsert (create or overwrite)"
                  },
                  "upsert_columns": {
                    "type": "object",
                    "description": "Column-based document upsert"
                  },
                  "upsert_condition": {
                    "type": "object",
                    "description": "Conditional logic for upserts"
                  },
                  "patch_rows": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "description": "Row-based partial attribute updates"
                  },
                  "patch_columns": {
                    "type": "object",
                    "description": "Column-based partial updates"
                  },
                  "patch_condition": {
                    "type": "object",
                    "description": "Conditional logic for patches"
                  },
                  "patch_by_filter": {
                    "type": "object",
                    "description": "Filter-based updates"
                  },
                  "patch_by_filter_allow_partial": {
                    "type": "boolean",
                    "description": "Allow partial completion of filter-based patches"
                  },
                  "deletes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Document IDs to delete"
                  },
                  "delete_condition": {
                    "type": "object",
                    "description": "Conditional deletion logic"
                  },
                  "delete_by_filter": {
                    "type": "object",
                    "description": "Filter-based deletion"
                  },
                  "delete_by_filter_allow_partial": {
                    "type": "boolean",
                    "description": "Allow partial filter-based deletion"
                  },
                  "distance_metric": {
                    "type": "string",
                    "enum": ["cosine_distance", "euclidean_squared"],
                    "description": "Distance metric for vector columns"
                  },
                  "schema": {
                    "type": "object",
                    "description": "Manual type/indexing configuration"
                  },
                  "encryption": {
                    "type": "object",
                    "description": "Customer-managed encryption settings"
                  },
                  "return_affected_ids": {
                    "type": "boolean",
                    "description": "Include affected document IDs in response"
                  },
                  "disable_backpressure": {
                    "type": "boolean",
                    "description": "Disable HTTP 429 backpressure"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Write results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WriteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited - too many concurrent writes"
          }
        }
      }
    },
    "/v2/namespaces/{namespace}/query": {
      "post": {
        "operationId": "queryDocuments",
        "summary": "Query Documents",
        "description": "Query documents in a namespace using vector similarity (ANN/kNN), BM25 full-text search, or attribute ordering. Supports filters, aggregations, multi-query, and diversification.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9\\-_.]{1,128}$"
            },
            "description": "Namespace identifier"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rank_by": {
                    "type": "array",
                    "description": "Ranking function: ANN vector, BM25, or attribute ordering"
                  },
                  "aggregate_by": {
                    "type": "object",
                    "description": "Aggregation query (alternative to rank_by)"
                  },
                  "filters": {
                    "type": "array",
                    "description": "Exact filters (SQL WHERE semantics)"
                  },
                  "limit": {
                    "description": "Maximum results (max 10000) or diversification config",
                    "oneOf": [
                      {
                        "type": "integer",
                        "maximum": 10000
                      },
                      {
                        "type": "object"
                      }
                    ]
                  },
                  "top_k": {
                    "type": "integer",
                    "description": "Alias for limit"
                  },
                  "include_attributes": {
                    "description": "Attributes to return",
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "exclude_attributes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Attributes to omit from response"
                  },
                  "group_by": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Group aggregation results"
                  },
                  "queries": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "maxItems": 16,
                    "description": "Multi-query execution (up to 16)"
                  },
                  "vector_encoding": {
                    "type": "string",
                    "enum": ["float", "base64"],
                    "description": "Vector serialization format"
                  },
                  "consistency": {
                    "type": "object",
                    "description": "Consistency level: strong (default) or eventual"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/v1/namespaces": {
      "get": {
        "operationId": "listNamespaces",
        "summary": "List Namespaces",
        "description": "List all namespaces, with optional prefix filtering and pagination.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Pagination cursor from previous response"
          },
          {
            "name": "prefix",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter namespaces matching a prefix"
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 1000
            },
            "description": "Results per page (default 100, max 1000)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of namespaces",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "namespaces": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "next_cursor": {
                      "type": "string",
                      "description": "Cursor for the next page"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/namespaces/{namespace}": {
      "delete": {
        "operationId": "deleteNamespace",
        "summary": "Delete Namespace",
        "description": "Permanently delete a namespace and all its documents. This operation is irreversible.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Namespace identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Namespace deleted"
          },
          "404": {
            "description": "Namespace not found"
          }
        }
      }
    },
    "/v1/namespaces/{namespace}/metadata": {
      "get": {
        "operationId": "getNamespaceMetadata",
        "summary": "Get Namespace Metadata",
        "description": "Get metadata about a namespace including schema, row count, storage size, and indexing status.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Namespace metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schema": {
                      "type": "object",
                      "description": "Field definitions"
                    },
                    "approx_logical_bytes": {
                      "type": "integer",
                      "description": "Approximate storage size"
                    },
                    "approx_row_count": {
                      "type": "integer",
                      "description": "Approximate number of records"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "last_write_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "updated_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "encryption": {
                      "type": "object"
                    },
                    "index": {
                      "type": "object",
                      "description": "Indexing status"
                    },
                    "pinning": {
                      "type": "object",
                      "description": "Reserved compute configuration"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/namespaces/{namespace}/hint_cache_warm": {
      "get": {
        "operationId": "warmCache",
        "summary": "Warm Cache",
        "description": "Signal turbopuffer to prepare infrastructure for upcoming latency-sensitive requests. Free if already warm, otherwise charged as a zero-row query.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cache warm hint accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ACCEPTED"]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/namespaces/{namespace}/_debug/recall": {
      "post": {
        "operationId": "debugRecall",
        "summary": "Debug Recall",
        "description": "Evaluate search recall by comparing ANN results against exhaustive ground-truth searches across randomly selected vectors.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "num": {
                    "type": "integer",
                    "default": 25,
                    "description": "Number of searches to run"
                  },
                  "top_k": {
                    "type": "integer",
                    "default": 10,
                    "description": "Search for top_k nearest neighbors"
                  },
                  "filters": {
                    "type": "object",
                    "description": "Optional attribute filters"
                  },
                  "rank_by": {
                    "type": "array",
                    "description": "Ranking function to evaluate"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recall evaluation results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "avg_recall": {
                      "type": "number",
                      "description": "Average recall (0 to 1)"
                    },
                    "avg_exhaustive_count": {
                      "type": "number",
                      "description": "Average exhaustive search result count"
                    },
                    "avg_ann_count": {
                      "type": "number",
                      "description": "Average ANN result count"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Turbopuffer API key as Bearer token"
      }
    },
    "schemas": {
      "WriteResponse": {
        "type": "object",
        "properties": {
          "rows_affected": {
            "type": "integer"
          },
          "rows_upserted": {
            "type": "integer"
          },
          "rows_patched": {
            "type": "integer"
          },
          "rows_deleted": {
            "type": "integer"
          },
          "rows_remaining": {
            "type": "boolean"
          },
          "upserted_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "patched_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deleted_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "billing": {
            "type": "object",
            "properties": {
              "billable_logical_bytes_written": {
                "type": "integer"
              }
            }
          },
          "performance": {
            "type": "object",
            "properties": {
              "server_total_ms": {
                "type": "integer"
              }
            }
          }
        }
      },
      "QueryResponse": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Matched documents"
          },
          "aggregations": {
            "type": "object",
            "description": "Aggregation results"
          },
          "aggregation_groups": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Multi-query results"
          },
          "billing": {
            "type": "object",
            "properties": {
              "billable_logical_bytes_queried": {
                "type": "integer"
              },
              "billable_logical_bytes_returned": {
                "type": "integer"
              }
            }
          },
          "performance": {
            "type": "object",
            "properties": {
              "cache_hit_ratio": {
                "type": "number"
              },
              "server_total_ms": {
                "type": "integer"
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["error"]
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
