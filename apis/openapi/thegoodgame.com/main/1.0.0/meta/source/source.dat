{
  "openapi": "3.0.3",
  "info": {
    "title": "TGG Public API",
    "description": "The API manages events for experts and provides public access to event information.\n\n## Features\n- Retrieve events by API key\n- Filter events by date range (startDate, endDate). By default startDate is now, and endDate 30 days from now.\n- Filter events by type (SINGLE, PROGRAM, RECURRING). By Default is returning all.\n- Filter events by status (CONFIRMED, PENDING, CANCELLED). By default is returning the CONFIRMED ones.\n- Formatted response with event details in CST timezone\n",
    "version": "1.0.0",
    "contact": {
      "name": "TGG Development Team"
    },
    "license": {
      "name": "Private"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/thegoodgame/tgg-public-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.thegoodgame.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/v1/events": {
      "get": {
        "summary": "Get events for an Expert",
        "description": "Retrieves events for a specific expert based on the provided API key.\nEvents are returned in CST timezone and can be filtered by date range, type, and status.\n",
        "operationId": "getEvents",
        "tags": [
          "Events"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "description": "Start date for filtering events (YYYY-MM-DD format). Defaults to current date.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2025-01-15"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "End date for filtering events (YYYY-MM-DD format). Defaults to 30 days from current date.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2025-02-15"
            }
          },
          {
            "name": "eventType",
            "in": "query",
            "description": "Filter events by type",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "SINGLE",
                "PROGRAM",
                "RECURRING"
              ],
              "example": "SINGLE"
            }
          },
          {
            "name": "eventStatus",
            "in": "query",
            "description": "Filter events by status. Defaults to CONFIRMED.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CONFIRMED",
                "PENDING",
                "CANCELLED"
              ],
              "example": "CONFIRMED"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  }
                },
                "examples": {
                  "success": {
                    "summary": "Successful response",
                    "value": [
                      {
                        "id": "205",
                        "title": "Tennis Camp",
                        "type": "SINGLE",
                        "subType": "CAMP",
                        "description": "Beginner tennis camp for kids",
                        "bannerImageUrl": "https://example.com/banner.jpg",
                        "startsAt": "2025-01-15 5:30 PM CST",
                        "endsAt": "2025-01-15 6:30 PM CST",
                        "startTime": "5:30 PM CST",
                        "startDate": "2025-01-15",
                        "endTime": "6:30 PM CST",
                        "endDate": "2025-01-15",
                        "capacity": {
                          "max": 20,
                          "current": 0
                        },
                        "location": {
                          "facilityName": "Tennis Court 1",
                          "address": "123 Main St",
                          "city": "Chicago",
                          "zip": "60601",
                          "state": "IL",
                          "country": "USA"
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalid_event_type": {
                    "summary": "Invalid event type",
                    "value": {
                      "message": "Invalid event type. Valid types are: SINGLE, CUSTOM, PROGRAM, RECURRING"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Coach not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "coach_not_found": {
                    "summary": "Coach not found",
                    "value": {
                      "message": "Coach not found"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "server_error": {
                    "summary": "Server error",
                    "value": {
                      "message": "Server error"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for coach authentication"
      }
    },
    "schemas": {
      "Event": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "startsAt",
          "endsAt",
          "capacity",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the event",
            "example": "205"
          },
          "title": {
            "type": "string",
            "description": "Title of the event",
            "example": "Tennis Camp"
          },
          "type": {
            "type": "string",
            "enum": [
              "SINGLE",
              "CUSTOM",
              "PROGRAM",
              "RECURRING"
            ],
            "description": "Type of the event",
            "example": "CUSTOM"
          },
          "subType": {
            "type": "string",
            "description": "Subtype of the event",
            "example": "CAMP"
          },
          "description": {
            "type": "string",
            "description": "Description of the event",
            "example": "Beginner tennis camp for kids"
          },
          "bannerImageUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL of the banner image for the event",
            "example": "https://example.com/banner.jpg"
          },
          "startsAt": {
            "type": "string",
            "description": "Start date and time in CST timezone",
            "example": "2025-01-15 5:30 PM CST"
          },
          "endsAt": {
            "type": "string",
            "description": "End date and time in CST timezone",
            "example": "2025-01-15 6:30 PM CST"
          },
          "startTime": {
            "type": "string",
            "description": "Start time in CST timezone",
            "example": "5:30 PM CST"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "Start date in YYYY-MM-DD format",
            "example": "2025-01-15"
          },
          "endTime": {
            "type": "string",
            "description": "End time in CST timezone",
            "example": "6:30 PM CST"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "End date in YYYY-MM-DD format",
            "example": "2025-01-15"
          },
          "capacity": {
            "$ref": "#/components/schemas/Capacity"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          }
        }
      },
      "Capacity": {
        "type": "object",
        "required": [
          "max",
          "current"
        ],
        "properties": {
          "max": {
            "type": "integer",
            "minimum": 0,
            "description": "Maximum number of participants allowed",
            "example": 20
          },
          "current": {
            "type": "integer",
            "minimum": 0,
            "description": "Current number of participants",
            "example": 0
          }
        }
      },
      "Location": {
        "type": "object",
        "required": [
          "facilityName",
          "address",
          "city",
          "zip",
          "state",
          "country"
        ],
        "properties": {
          "facilityName": {
            "type": "string",
            "description": "Name of the facility",
            "example": "Tennis Court 1"
          },
          "address": {
            "type": "string",
            "description": "Street address",
            "example": "123 Main St"
          },
          "city": {
            "type": "string",
            "description": "City name",
            "example": "Chicago"
          },
          "zip": {
            "type": "string",
            "description": "ZIP/postal code",
            "example": "60601"
          },
          "state": {
            "type": "string",
            "description": "State or province",
            "example": "IL"
          },
          "country": {
            "type": "string",
            "description": "Country name",
            "example": "USA"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "Error message describing what went wrong",
            "example": "Coach not found"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Events",
      "description": "Operations related to event management"
    }
  ]
}
