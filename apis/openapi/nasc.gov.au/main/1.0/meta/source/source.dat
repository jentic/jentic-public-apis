{
  "openapi": "3.0.1",
  "info": {
    "title": "NASC - Partner Data API",
    "description": "This data API is used to provide access to the NASC datasets.",
    "version": "1.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/RIAZAFRIDI_1/nasc-partner-data-api/1.0"
  },
  "servers": [
    {
      "url": "https://apidev.nasc.gov.au/partnerdata"
    },
    {
      "url": "https://apidev.nasc.gov.au/partnerdata"
    }
  ],
  "paths": {
    "/api/v1/ping": {
      "get": {
        "tags": [
          "Partner Data Service"
        ],
        "operationId": "ping",
        "parameters": [
          {
            "name": "RequestId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/operation_response_of_string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "499": {
            "description": "Client Closed Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/metadata": {
      "get": {
        "tags": [
          "Partner Data Service"
        ],
        "operationId": "metadata",
        "parameters": [
          {
            "name": "RequestId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/api_metadata"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "499": {
            "description": "Client Closed Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/datasets/submission": {
      "post": {
        "tags": [
          "Partner Data Service"
        ],
        "operationId": "datasets_submission",
        "parameters": [
          {
            "name": "RequestId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/submit_data"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/operation_response_of_submit_data_response"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Unprocessable Entity"
          },
          "499": {
            "description": "Client Closed Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/datasets/submission/{response_id}/response": {
      "get": {
        "tags": [
          "Partner Data Service"
        ],
        "operationId": "datasets_submission_status_response",
        "parameters": [
          {
            "name": "RequestId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "response_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/operation_response_of_submit_data_status_response"
                }
              }
            }
          },
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/operation_response_of_submit_data_status_response"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Unprocessable Entity"
          },
          "499": {
            "description": "Client Closed Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/datasets/retreivedata": {
      "post": {
        "tags": [
          "Partner Data Service"
        ],
        "operationId": "datasets_retreivedata",
        "parameters": [
          {
            "name": "RequestId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/retreive_data"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/operation_response_of_data_retreive_response"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Unprocessable Entity"
          },
          "499": {
            "description": "Client Closed Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/v1/datasets/retreivedata/{response_id}/results/{page}": {
      "get": {
        "tags": [
          "Partner Data Service"
        ],
        "operationId": "datasets_retreivedata_status_response",
        "parameters": [
          {
            "name": "RequestId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "response_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/operation_response_of_data_retreive_status_response"
                }
              }
            }
          },
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/operation_response_of_data_retreive_status_response"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "422": {
            "description": "Unprocessable Entity"
          },
          "499": {
            "description": "Client Closed Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "api_metadata": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "released_date": {
            "type": "string"
          },
          "documentation": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "data_retreive_request_status": {
        "enum": [
          "submitted",
          "in_progress",
          "completed",
          "failed"
        ]
      },
      "data_retreive_response": {
        "required": [
          "response_id",
          "response_status"
        ],
        "type": "object",
        "properties": {
          "response_id": {
            "type": "string",
            "format": "uuid"
          },
          "response_status": {
            "$ref": "#/components/schemas/data_retreive_request_status"
          },
          "payload_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/dataset_json_validation_error"
            }
          },
          "_links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/link"
            }
          }
        },
        "additionalProperties": false
      },
      "data_retreive_status_response": {
        "required": [
          "response_id",
          "response_status",
          "paged_payload"
        ],
        "type": "object",
        "properties": {
          "response_id": {
            "type": "string",
            "format": "uuid"
          },
          "response_status": {
            "$ref": "#/components/schemas/data_retreive_request_status"
          },
          "paged_payload": {
            "$ref": "#/components/schemas/payload_paged_result"
          },
          "_links": {
            "type": "array",
            "items": {}
          }
        },
        "additionalProperties": false
      },
      "dataset_json_validation_error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "line_number": {
            "type": "integer",
            "format": "int32"
          },
          "line_position": {
            "type": "integer",
            "format": "int32"
          },
          "path": {
            "type": "string"
          },
          "value": {},
          "schema_id": {
            "type": "string",
            "format": "uri"
          },
          "error_type": {
            "$ref": "#/components/schemas/dataset_json_validation_error_error_type"
          }
        },
        "additionalProperties": false
      },
      "dataset_json_validation_error_error_type": {
        "enum": [
          "none",
          "multiple_of",
          "maximum",
          "minimum",
          "maximum_length",
          "minimum_length",
          "pattern",
          "additional_items",
          "items",
          "maximum_items",
          "minimum_items",
          "unique_items",
          "maximum_properties",
          "minimum_properties",
          "required",
          "additional_properties",
          "dependencies",
          "enum",
          "type",
          "all_of",
          "any_of",
          "one_of",
          "not",
          "format",
          "id",
          "pattern_properties",
          "validator",
          "valid",
          "const",
          "contains",
          "content_encoding",
          "content_media_type",
          "then",
          "else",
          "maximum_contains",
          "minimum_contains",
          "unevaluated_items",
          "unevaluated_properties",
          "ref"
        ]
      },
      "link": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "method": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "notification": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "notification_type": {
            "$ref": "#/components/schemas/notification_type"
          }
        },
        "additionalProperties": false
      },
      "notification_type": {
        "enum": [
          "error",
          "warning",
          "information"
        ]
      },
      "operation_response_of_data_retreive_response": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/data_retreive_response"
          },
          "is_success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "notifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/notification"
            }
          }
        },
        "additionalProperties": false
      },
      "operation_response_of_data_retreive_status_response": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/data_retreive_status_response"
          },
          "is_success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "notifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/notification"
            }
          }
        },
        "additionalProperties": false
      },
      "operation_response_of_string": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string"
          },
          "is_success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "notifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/notification"
            }
          }
        },
        "additionalProperties": false
      },
      "operation_response_of_submit_data_response": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/submit_data_response"
          },
          "is_success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "notifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/notification"
            }
          }
        },
        "additionalProperties": false
      },
      "operation_response_of_submit_data_status_response": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/submit_data_status_response"
          },
          "is_success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "notifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/notification"
            }
          }
        },
        "additionalProperties": false
      },
      "payload_paged_result": {
        "required": [
          "page_number",
          "page_size"
        ],
        "type": "object",
        "properties": {
          "_links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/link"
            }
          },
          "page_number": {
            "type": "integer",
            "format": "int32"
          },
          "page_size": {
            "type": "integer",
            "format": "int32"
          },
          "total_pages": {
            "type": "integer",
            "format": "int32"
          },
          "total_records": {
            "type": "integer",
            "format": "int32"
          },
          "has_more_records": {
            "type": "boolean"
          },
          "paylaod": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/scam_reprot_retreive_response"
            }
          }
        },
        "additionalProperties": false,
        "nullable": true
      },
      "retreive_data": {
        "required": [
          "dataset_version_no",
          "dataset_filters_payload"
        ],
        "type": "object",
        "properties": {
          "dataset_version_no": {
            "type": "string",
            "nullable": true
          },
          "dataset_filters_payload": {
            "pattern": "^[a-z_][a-z0-9_]*$",
            "required": [
              "scam_reprot"
            ],
            "type": "object",
            "properties": {
              "scam_reprot": {
                "title": "scam_reprot",
                "pattern": "^[a-z_][a-z0-9_]*$",
                "required": [
                  "scam_reports_filter"
                ],
                "type": "object",
                "properties": {
                  "organisation_known_as_filter": {
                    "pattern": "^[a-z_][a-z0-9_]*$",
                    "required": [
                      "operator",
                      "value"
                    ],
                    "type": "object",
                    "properties": {
                      "operator": {
                        "title": "Operator",
                        "enum": [
                          "equal"
                        ],
                        "type": "string"
                      },
                      "value": {
                        "title": "Condition value",
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false,
                    "nullable": true
                  },
                  "scam_reports_filter": {
                    "pattern": "^[a-z_][a-z0-9_]*$",
                    "required": [
                      "date_of_scam_report"
                    ],
                    "type": "object",
                    "properties": {
                      "date_of_scam_report": {
                        "title": "Report Date",
                        "pattern": "^[a-z_][a-z0-9_]*$",
                        "required": [
                          "operator",
                          "value1",
                          "value2"
                        ],
                        "type": "object",
                        "properties": {
                          "operator": {
                            "title": "Operator",
                            "enum": [
                              "between"
                            ],
                            "type": "string"
                          },
                          "value1": {
                            "title": "Condition value1",
                            "type": "string",
                            "format": "date-time"
                          },
                          "value2": {
                            "title": "Condition value2",
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "additionalProperties": false,
                        "description": "Report Date"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "description": "ASIC Scam Report Out-Dataset v2 filters"
          }
        },
        "additionalProperties": false
      },
      "submit_data": {
        "required": [
          "dataset_version_no",
          "dataset_payload"
        ],
        "type": "object",
        "properties": {
          "dataset_version_no": {
            "type": "string",
            "nullable": true
          },
          "dataset_payload": {
            "maxItems": 100,
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/scam_reprot"
            }
          }
        },
        "additionalProperties": false
      },
      "submit_data_request_status": {
        "enum": [
          "submitted",
          "in_progress",
          "completed",
          "failed",
          "compeleted_with_errors"
        ]
      },
      "submit_data_response": {
        "required": [
          "response_id",
          "response_status"
        ],
        "type": "object",
        "properties": {
          "response_id": {
            "type": "string",
            "format": "uuid"
          },
          "response_status": {
            "$ref": "#/components/schemas/submit_data_request_status"
          },
          "payload_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/dataset_json_validation_error"
            }
          },
          "_links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/link"
            }
          }
        },
        "additionalProperties": false
      },
      "submit_data_status_response": {
        "required": [
          "response_id",
          "response_status",
          "payload"
        ],
        "type": "object",
        "properties": {
          "response_id": {
            "type": "string",
            "format": "uuid"
          },
          "response_status": {
            "$ref": "#/components/schemas/submit_data_request_status"
          },
          "payload": {
            "maxItems": 100,
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/scam_reprot_response"
            }
          },
          "_links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/link"
            }
          }
        },
        "additionalProperties": false
      },
      "property_error": {
        "pattern": "^[a-z_][a-z0-9_]*$",
        "type": "object",
        "properties": {
          "property_id": {
            "type": "string",
            "description": "Property id"
          },
          "property_name": {
            "type": "string",
            "description": "Property name"
          },
          "record_no": {
            "type": "string",
            "description": "Property name"
          },
          "errors": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "description": "Error description."
            },
            "description": "List of property errors."
          }
        },
        "additionalProperties": false,
        "description": "Property validation error"
      },
      "bank_transaction": {
        "pattern": "^[a-z_][a-z0-9_]*$",
        "type": "object",
        "properties": {
          "date_of_bank_transfer": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "x-spf-type": "Voluntarily"
          },
          "bank_account_name": {
            "maxLength": 255,
            "type": "string",
            "nullable": true,
            "x-spf-type": "Voluntarily"
          },
          "bank_bsb": {
            "maxLength": 6,
            "type": "string",
            "nullable": true,
            "x-spf-type": "Voluntarily"
          },
          "account_number": {
            "maxLength": 10,
            "type": "string",
            "nullable": true,
            "x-spf-type": "Voluntarily"
          },
          "bank_account_swift_code": {
            "maxLength": 255,
            "type": "string",
            "nullable": true,
            "x-spf-type": "Voluntarily"
          }
        },
        "additionalProperties": false
      },
      "crypto_transaction": {
        "pattern": "^[a-z_][a-z0-9_]*$",
        "type": "object",
        "properties": {
          "crypto_exchange": {
            "maxLength": 100,
            "type": "string",
            "nullable": true,
            "x-spf-type": "Voluntarily"
          },
          "scammer_crypto_wallet": {
            "maxLength": 100,
            "type": "string",
            "nullable": true,
            "x-spf-type": "Voluntarily"
          },
          "sender_crypto_wallet_address": {
            "maxLength": 100,
            "type": "string",
            "nullable": true,
            "x-spf-type": "Voluntarily"
          },
          "crypto_transaction_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "x-spf-type": "Voluntarily"
          },
          "crypto_type": {
            "maxLength": 100,
            "type": "string",
            "nullable": true,
            "x-spf-type": "Voluntarily"
          },
          "crypto_amount_lost": {
            "multipleOf": 0.01,
            "maximum": 999999999,
            "minimum": 0,
            "type": "number",
            "format": "decimal",
            "nullable": true,
