              },
              "match": {
                "type": "integer"
              },
              "change": {
                "type": "integer"
              },
              "mod": {
                "type": "integer"
              },
              "price": {
                "type": "integer"
              },
              "hash": {
                "type": "integer"
              }
            }
          },
          "pDate": {
            "type": "object",
            "properties": {
              "insert": {
                "type": "string",
                "description": "Y-m-d"
              },
              "seen": {
                "type": "string",
                "description": "Y-m-d"
              },
              "check": {
                "type": "string",
                "description": "Y-m-d"
              },
              "match": {
                "type": "string",
                "description": "Y-m-d"
              },
              "price": {
                "type": "string",
                "description": "Y-m-d"
              },
              "hash": {
                "type": "string",
                "description": "Y-m-d"
              }
            }
          },
          "pCity": {
            "type": "string",
            "description": "city Id"
          },
          "pZone": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "pValuations": {
            "type": "object",
            "additionalProperties": true
          },
          "pStock": {
            "type": "object",
            "additionalProperties": true
          },
          "pCross": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              }
            }
          },
          "pChanges": {
            "type": "object",
            "properties": {
