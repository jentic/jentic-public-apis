                }
              }
            }
          },
          "propertyMainImage": {
            "type": "string",
            "format": "uri"
          },
          "pTS": {
            "type": "object",
            "properties": {
              "insert": {
                "type": "integer"
              },
              "seen": {
                "type": "integer"
              },
              "check": {
