{
  "openapi": "3.0.4",
  "info": {
    "title": "Statefox Properties API",
    "version": "1.0.0",
    "description": "Statefox API for querying indexed properties and property snapshots.\n\n**Authentication:** This API uses a Bearer Token. Include it in the header:\n'Authorization: Bearer <YOUR_TOKEN>'.\nTo request/renew a token, contact **support@statefox.com**.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/panaderiapaco/statefox-properties-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://statefox.com/public/aapi/props"
    }
  ],
  "tags": [
    {
      "name": "Get Functions",
      "description": "Read-only endpoints"
    },
    {
      "name": "snapshot",
      "description": "Current snapshot of properties"
    }
  ],
  "paths": {
    "/properties": {
      "get": {
        "tags": [
          "Get Functions"
        ],
        "summary": "GetProperties",
        "description": "Returns a filterable index of properties by **source**, **listing type**, **housing**, and **insert date**.\nThe response includes an object with **dynamic keys by propertyId** and a **meta** block with pagination and price ranges.\n",
        "operationId": "getProperties",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "description": "Listing source (e.g. idealista, fotocasa, pisoscom, habitaclia, ...)",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "idealista",
                "fotocasa",
                "pisoscom",
                "habitaclia"
              ],
              "default": "idealista"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Listing type",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent"
              ],
              "default": "sale"
            }
          },
          {
            "name": "housing",
            "in": "query",
            "description": "Housing type",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "flat",
                "house",
                "countryhouse",
                "duplex",
                "penthouse",
                "studio",
                "loft",
                "garage",
                "office",
                "premises",
                "land",
                "building",
                "storage",
                "warehouse",
                "room"
              ]
            }
          },
          {
            "name": "items",
            "in": "query",
            "description": "Items per page (1..500)",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "insert",
            "in": "query",
            "description": "Insert date (Y-m-d)",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "properties": {
                      "type": "object",
                      "description": "Map of properties by ID",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/Property"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  },
                  "required": [
                    "properties",
                    "meta"
                  ]
                },
                "example": {
                  "properties": {
                    "id.es.r.109615299": {
                      "_id": "id.es.r.109615299",
                      "pType": "rent",
                      "pStatus": "active",
                      "pHousing": "flat",
                      "pDesc": "Piso en Alquiler en Las Américas...",
                      "pAdvert": {
                        "type": "professional",
                        "name": "TR",
                        "total": {
                          "sale": 0,
                          "rent": 0
                        }
                      },
                      "pPrice": 2000,
                      "pRooms": 2,
                      "pBaths": 1,
                      "pFloor": "0",
                      "pAddress": "Urb. 2000 Playa de las Américas",
                      "pMeters": {
                        "built": 80,
                        "usable": 75,
                        "plot": 0,
                        "buildable": 0,
                        "terrace": 0,
                        "garage": 0
                      },
                      "pExtras": {
                        "pool": true,
                        "condition": "good",
                        "exterior": true,
                        "terrace": true,
                        "wardrobes": true,
                        "furnished": true,
                        "deposit": 1,
                        "negotiable": true
                      },
                      "pPoint": {
                        "latitude": 28.0604368,
                        "longitude": -16.7301708
                      },
                      "pImages": {
                        "0": {
                          "src": "https://img3.idealista.com/blur/WEB_DETAIL-L-L/0/id.pro.es.image.master/23/be/a6/1380176764.jpg"
                        }
                      },
                      "pLink": "https://www.idealista.com/inmueble/109615299/"
                    },
                    "id.es.r.109615276": {
                      "_id": "id.es.r.109615276",
                      "pType": "rent",
                      "pStatus": "active",
                      "pHousing": "flat",
                      "pDesc": "Piso en Alquiler con Vistas al Mar - Primera Línea...",
                      "pAdvert": {
                        "type": "professional",
                        "name": "TR",
                        "total": {
                          "sale": 0,
                          "rent": 0
                        }
                      },
                      "pPrice": 1650,
                      "pRooms": 2,
                      "pBaths": 2,
                      "pFloor": "1",
                      "pAddress": "Urb. sotavento Los Abrigos",
                      "pPoint": {
                        "latitude": 28.0343306,
                        "longitude": -16.5630678
                      },
                      "pImages": {
                        "0": {
                          "src": "https://img3.idealista.com/blur/WEB_DETAIL-L-L/0/id.pro.es.image.master/ea/c9/20/1380175995.jpg"
                        }
                      },
                      "pLink": "https://www.idealista.com/inmueble/109615276/"
                    }
                  },
                  "meta": {
                    "page": 1,
                    "total": 2,
                    "items": 2,
                    "price": {
                      "min": 1650,
                      "max": 2000
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized – missing or invalid Bearer token"
          },
          "400": {
            "description": "Invalid query parameters"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/snapshot": {
      "get": {
        "tags": [
          "snapshot"
        ],
        "summary": "Properties snapshot",
        "description": "Returns a map of properties (key = 'propertyId') with the **current state** and a 'meta' object for pagination.\n",
        "operationId": "getSnapshot",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "Current ad status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive"
              ]
            }
          },
          {
            "name": "items",
            "in": "query",
            "description": "Items per page (1..250)",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 250,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Cursor for next page",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "properties": {
                      "type": "object",
                      "description": "Map of properties by ID",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/SnapshotProperty"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/SnapshotMeta"
                    }
                  },
                  "required": [
                    "properties",
                    "meta"
                  ]
                },
                "example": {
                  "properties": {
                    "id.es.s.109614905": {
                      "_id": "id.es.s.109614905",
                      "pStatus": "active",
                      "pType": "sale",
                      "pHousing": "house",
                      "pDescription": "Paraíso en primera línea de playa – Artola Baja, Marbella...",
                      "pAddress": "Calle Higueral de Artola",
                      "pRooms": 8,
                      "pBaths": 7,
                      "pPrice": 4999999,
                      "pPoint": {
                        "latitude": 36.4883659,
                        "longitude": -4.7479655
                      },
                      "pImages": [
                        "https://img4.idealista.com/blur/WEB_DETAIL-L-L/0/id.pro.es.image.master/d9/63/84/1380168942.webp"
                      ],
                      "pCity": {
                        "_id": "5c8ecf03936ec31bfd65ec71",
                        "cityName": "Marbella",
                        "cityRegion": "Málaga"
                      },
                      "pLink": "https://www.idealista.com/inmueble/109614905/"
                    },
                    "id.es.s.109614696": {
                      "_id": "id.es.s.109614696",
                      "pStatus": "active",
                      "pType": "sale",
                      "pHousing": "house",
                      "pDescription": "Casa de dos habitaciones en els AVETS...",
                      "pAddress": "Can Serrafossà - La Perla - Els Avets",
                      "pRooms": 2,
                      "pBaths": 1,
                      "pPrice": 249900,
                      "pPoint": {
                        "latitude": 41.4836888,
                        "longitude": 2.0199433
                      },
                      "pImages": [
                        "https://img4.idealista.com/blur/WEB_DETAIL-L-L/0/id.pro.es.image.master/c5/4c/51/1380162215.webp"
                      ],
                      "pCity": {
                        "_id": "5c8ecf02936ec31bfd65dee8",
                        "cityName": "Rubí",
                        "cityRegion": "Barcelona"
                      },
                      "pLink": "https://www.idealista.com/inmueble/109614696/"
                    }
                  },
                  "meta": {
                    "items": 2,
                    "sort": "createdAt",
                    "next": null,
                    "debug": null
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized – missing or invalid Bearer token"
          },
          "400": {
            "description": "Invalid query parameters"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Property": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
