            "type": "object",
            "properties": {
              "community": {
                "type": "integer",
                "description": "community fee"
              },
              "oHousing": {
                "type": "string",
                "description": "origin housing value"
              },
              "oCondition": {
                "type": "string",
                "description": "origin condition"
              },
              "condition": {
                "type": "string",
                "enum": [
                  "good",
                  "excellent",
                  "reform",
                  "new"
                ]
              },
              "certEfficiency": {
                "type": "string",
                "enum": [
                  "a",
                  "b",
                  "c",
                  "d",
                  "e",
                  "f",
                  "g",
                  "exempt",
                  "unavailable"
                ]
              },
              "garden": {
                "type": "boolean"
              },
              "pool": {
                "type": "boolean"
              },
              "lift": {
                "type": "boolean"
              },
              "balcony": {
                "type": "boolean"
              },
              "boxroom": {
                "type": "boolean"
              },
              "terrace": {
                "type": "boolean"
              },
              "furnished": {
                "type": "boolean"
              },
              "wardrobes": {
                "type": "boolean"
              },
              "centralHeating": {
                "type": "boolean"
              },
              "airConditioning": {
                "type": "boolean"
              },
              "deposit": {
                "type": "integer"
              },
              "negotiable": {
                "type": "boolean"
              },
              "exterior": {
                "type": "boolean"
              },
              "year": {
                "type": "string"
              }
            }
          },
          "pRef": {
            "type": "string"
          },
          "pPricePerMeter": {
            "type": "integer"
          },
          "pContact": {
            "type": "string"
          },
          "pPoint": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "format": "float"
              },
              "longitude": {
                "type": "number",
                "format": "float"
              }
            }
          },
          "pImages": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
