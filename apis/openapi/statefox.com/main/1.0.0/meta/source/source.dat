              "type": "string"
            }
          },
          "pAddress": {
            "type": "string"
          },
          "pMeters": {
            "type": "object",
            "properties": {
              "built": {
                "type": "integer"
              },
              "usable": {
                "type": "integer"
              },
              "plot": {
                "type": "integer"
              },
              "buildable": {
                "type": "integer"
              },
              "terrace": {
                "type": "integer"
              },
              "garage": {
                "type": "integer"
              }
            }
          },
          "pPhones": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
