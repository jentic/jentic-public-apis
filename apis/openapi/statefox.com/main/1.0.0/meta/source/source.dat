              }
            }
          },
          "has": {
            "type": "object",
            "properties": {
              "images": {
                "type": "boolean"
              },
              "reports": {
                "type": "boolean"
              },
              "contact": {
                "type": "boolean"
              },
              "follow": {
                "type": "boolean"
              },
              "stock": {
                "type": "boolean"
              }
            }
          }
        }
      },
