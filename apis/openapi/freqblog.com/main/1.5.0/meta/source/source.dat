       "description": "SVG height in pixels.",
       "default": 80,
       "title": "H"
      },
      "description": "SVG height in pixels."
     },
     {
      "name": "x-api-key",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string",
       "title": "X-Api-Key"
      }
     }
    ],
    "responses": {
