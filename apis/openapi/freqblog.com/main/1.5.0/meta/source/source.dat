      "schema": {
       "type": "string",
       "description": "Catalog track id (numeric iTunes id, or `mb:`/`apple_<hash>` synthetic id).",
       "title": "Itunes Track Id"
      },
      "description": "Catalog track id (numeric iTunes id, or `mb:`/`apple_<hash>` synthetic id)."
     },
     {
      "name": "size",
