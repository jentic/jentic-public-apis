      "schema": {
       "type": "number",
       "maximum": 300.0,
       "minimum": 0.0,
       "description": "Preferred `tempo` (BPM). Tracks nearer this value rank higher; unlike `min_`/`max_` it never removes a candidate.",
       "title": "Target Tempo",
       "nullable": true
      },
      "description": "Preferred `tempo` (BPM). Tracks nearer this value rank higher; unlike `min_`/`max_` it never removes a candidate."
     },
     {
      "name": "min_valence",
