    ],
    "title": "FreeKeyRequest"
   },
   "GenreInfo": {
    "properties": {
     "genre": {
      "type": "string",
      "title": "Genre",
      "example": "electronic"
     },
     "track_count": {
      "type": "integer",
      "title": "Track Count",
      "description": "Number of catalog tracks tagged with this genre."
     },
     "parent_genres": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Parent Genres",
      "description": "Top-level genre(s) this genre sits under in Apple's genre hierarchy (e.g. `urbano latino` -> `[\"latin\"]`). Empty for a top-level genre, or one outside the hierarchy. Can hold more than one: `latin jazz` is under both `jazz` and `latin`.",
      "example": [
       "latin"
      ]
     }
    },
    "type": "object",
    "required": [
     "genre",
     "track_count"
    ],
    "title": "GenreInfo"
   },
   "GenreTracksResponse": {
