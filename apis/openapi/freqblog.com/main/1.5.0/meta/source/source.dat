       }
      }
     },
     "401": {
      "description": "Missing, unrecognised, deactivated or superseded API key — `error_code` says which: `KEY_MISSING` / `KEY_DEACTIVATED` / `KEY_SUPERSEDED`",
      "content": {
       "application/json": {
        "schema": {
