      "default": ""
     },
     "utm_medium": {
      "type": "string",
      "title": "Utm Medium",
      "default": ""
     },
     "utm_campaign": {
      "type": "string",
      "title": "Utm Campaign",
      "default": ""
     },
     "ref": {
      "type": "string",
      "title": "Ref",
      "default": ""
     },
     "marketing_opt_out": {
      "type": "boolean",
      "title": "Marketing Opt Out",
      "default": false
     }
    },
    "type": "object",
    "required": [
