{
  "openapi": "3.0.4",
  "info": {
    "title": "MatuleApp - Supabase Version",
    "description": "Приложение matule\nМиграция на Supabase",
    "contact": {
      "email": "hello@world.ru"
    },
    "version": "2.0.00",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/BTPIT/matuleapp-supabase-version/2.0.00"
  },
  "servers": [
    {
      "url": "https://krbekvdfewpwkkfupayt.supabase.co",
      "description": "Supabase API"
    }
  ],
  "tags": [
    {
      "name": "user",
      "description": "Действия с пользователем"
    },
    {
      "name": "shop",
      "description": "Действия с магазином"
    },
    {
      "name": "project",
      "description": "Действия с проектами"
    },
    {
      "name": "backet",
      "description": "Действия с корзиной"
    },
    {
      "name": "order",
      "description": "Действия с заказом"
    }
  ],
  "paths": {
    "/auth/v1/signup": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Регистрация",
        "operationId": "createUser",
        "requestBody": {
          "description": "Регистрация",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupabaseSignUpRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupabaseAuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "400",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error400"
                }
              }
            }
          }
        }
      }
    },
    "/auth/v1/token": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Авторизация",
        "operationId": "auth",
        "requestBody": {
          "description": "Авторизация",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupabaseLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupabaseAuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/users": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "Получение информации о текущем пользователе",
        "operationId": "getCurrentUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          }
        }
      }
    },
    "/rest/v1/users/{id}": {
      "get": {
        "tags": [
          "user"
        ],
        "summary": "Получение информации о пользователе по ID",
        "operationId": "getUserById",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID пользователя"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "patch": {
        "tags": [
          "user"
        ],
        "summary": "Изменение профиля",
        "operationId": "updateUser",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID пользователя"
          }
        ],
        "requestBody": {
          "description": "Изменение профиля",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/rest/v1/products": {
      "get": {
        "tags": [
          "shop"
        ],
        "summary": "Список продуктов с поиском",
        "operationId": "listProductSearch",
        "parameters": [
          {
            "in": "query",
            "name": "title",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Поиск по названию (используйте ilike)",
            "example": "%футболка%"
          },
          {
            "in": "query",
            "name": "select",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "id,title,price,typeCloses,type"
          },
          {
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "price.asc"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProductItem"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/rest/v1/products/{id}": {
      "get": {
        "tags": [
          "shop"
        ],
        "summary": "Описание продукта",
        "operationId": "getProduct",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "id продукта"
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/rest/v1/projects": {
      "get": {
        "tags": [
          "project"
        ],
        "summary": "Список проектов",
        "operationId": "listProject",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "project"
        ],
        "summary": "Создание проекта",
        "operationId": "projectCreate",
        "requestBody": {
          "description": "Создание проекта",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProjectCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/rest/v1/cart": {
      "post": {
        "tags": [
          "backet"
        ],
        "summary": "Создание корзины",
        "operationId": "createBusket",
        "requestBody": {
          "description": "Создание",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CartCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CartItem"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/rest/v1/cart/{id}": {
      "patch": {
        "tags": [
          "backet"
        ],
        "summary": "Изменение корзины",
        "operationId": "updateCart",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "id записи корзины"
          }
        ],
        "requestBody": {
          "description": "Изменение корзины",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CartUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CartItem"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/rest/v1/orders": {
      "post": {
        "tags": [
          "order"
        ],
        "summary": "Создание заказа",
        "operationId": "createOrder",
        "requestBody": {
          "description": "Создание",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/rest/v1/news": {
      "get": {
        "tags": [
          "shop"
        ],
        "summary": "Акции и новости",
        "operationId": "getNews",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/News"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "description": "Bearer token using a JWT",
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey"
      }
    },
    "responses": {
      "Error400": {
        "description": "400",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error400"
            }
          }
        }
      }
    },
    "schemas": {
      "SupabaseSignUpRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "example@test.ru"
          },
          "password": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "firstname": {
                "type": "string"
              },
              "lastname": {
                "type": "string"
              }
            }
          }
        }
      },
      "SupabaseLoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "example@test.ru"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "SupabaseAuthResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "bearer"
          },
          "expires_in": {
            "type": "integer"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            }
          }
        }
      },
      "CartCreate": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "default": 1
          }
        }
      },
      "CartUpdate": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          }
        }
      },
      "CartItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "OrderCreate": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "default": 1
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "default": "pending"
          }
        }
      },
      "ProjectCreate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "dateStart": {
            "type": "string",
            "format": "date"
          },
          "dateEnd": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string"
          },
          "description_source": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "dateStart": {
            "type": "string",
            "format": "date"
          },
          "dateEnd": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string"
          },
          "description_source": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          }
        }
      },
      "News": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "newsImage": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "integer"
          },
          "typeCloses": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "approximateCost": {
            "type": "string"
          }
        }
      },
      "ProductItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "price": {
            "type": "integer"
          },
          "typeCloses": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "secondname": {
            "type": "string"
          },
          "datebirthday": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "UserUpdate": {
        "type": "object",
        "properties": {
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "secondname": {
            "type": "string"
          },
          "datebirthday": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "type": "string"
          }
        }
      },
      "Error400": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Failed to create record."
          },
          "code": {
            "type": "string",
            "example": "400"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ]
}
