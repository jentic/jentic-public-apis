              "type": "string"
            },
            "example": "id,title,created_at"
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "created_at.desc"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/News"
                  }
                }
              }
            }
          }
        }
      }
    },
