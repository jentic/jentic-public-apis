  "paths": {
    "/products": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "Get products",
        "parameters": [
          {
            "name": "select",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "id,title,price"
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "example": "price.asc"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "Get product by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                }
              }
            }
          }
        }
      }
    },
