{"openapi":"3.1.0","info":{"title":"DayOneLead API","version":"1.0.0","description":"Newly registered businesses plus a cold email engine. Browse is unlimited; contact details cost one of 200 daily credits per lead (shared with CSV export); campaigns send from your own mailbox and use no credits. Launch, reply, and end use preview-and-approve: call once without confirm to get a preview and approval_token, then again with confirm: true."},"servers":[{"url":"https://dayonelead.com/api/v1"}],"security":[{"bearer":[]}],"components":{"securitySchemes":{"bearer":{"type":"http","scheme":"bearer","description":"Personal API key (dl_live_...) from dayonelead.com/dashboard/agents, or an OAuth access token."}},"schemas":{"Error":{"type":"object","properties":{"error":{"type":"string"},"message":{"type":"string"}}},"LeadFilters":{"type":"object","properties":{"states":{"type":"string","description":"Comma-separated: FL,NY,CA,CO,TX,CT"},"categories":{"type":"string"},"cities":{"type":"string"},"counties":{"type":"string"},"filed_after":{"type":"string","format":"date"},"filed_before":{"type":"string","format":"date"},"processed_after":{"type":"string","format":"date"},"has_phone":{"type":"boolean"},"has_email":{"type":"boolean"},"has_website":{"type":"boolean"},"exclude_in_crm":{"type":"boolean"},"exclude_revealed":{"type":"boolean"},"query":{"type":"string"},"sort":{"type":"string","enum":["filing_date","created_at","processed_date"]},"dir":{"type":"string","enum":["asc","desc"]},"page":{"type":"integer"},"page_size":{"type":"integer","maximum":100}}},"Step":{"type":"object","required":["subject","body"],"properties":{"subject":{"type":"string"},"body":{"type":"string"},"wait_days":{"type":"integer"}}}}},"paths":{"/account":{"get":{"summary":"Account summary, budget, mailboxes, next_step"}},"/leads":{"get":{"summary":"Search leads (masked, no phone/email)","parameters":[{"in":"query","name":"filters","schema":{"$ref":"#/components/schemas/LeadFilters"},"style":"form","explode":true}]}},"/leads/{id}":{"get":{"summary":"Lead detail (masked)","parameters":[{"in":"path","name":"id","required":true,"schema":{"type":"string"}}]}},"/leads/reveal":{"post":{"summary":"Reveal phone and email for up to 50 leads (uses daily credits)","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["lead_ids"],"properties":{"lead_ids":{"type":"array","items":{"type":"string"},"maxItems":50}}}}}}}},"/contact-budget":{"get":{"summary":"Remaining reveal credits today"}},"/filter-options":{"get":{"summary":"Valid states, categories, cities, counties","parameters":[{"in":"query","name":"kind","required":true,"schema":{"type":"string","enum":["states","categories","cities","counties"]}},{"in":"query","name":"state","schema":{"type":"string"}},{"in":"query","name":"query","schema":{"type":"string"}}]}},"/picks":{"get":{"summary":"Recent AI-matched picks"}},"/icp":{"get":{"summary":"Matching profile"},"patch":{"summary":"Update matching profile (owner only)"}},"/crm":{"get":{"summary":"CRM rows","parameters":[{"in":"query","name":"status","schema":{"type":"string"}}]}},"/crm/{lead_id}":{"put":{"summary":"Set CRM status","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","enum":["new","working","followup","won","lost"]}}}}}}},"delete":{"summary":"Remove from CRM"}},"/crm/{lead_id}/notes":{"post":{"summary":"Add a note","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"body":{"type":"string"}}}}}}}},"/crm/funnel":{"get":{"summary":"CRM funnel tree"}},"/carts":{"get":{"summary":"List carts"},"post":{"summary":"Create a cart from lead_ids or filters"}},"/carts/{id}":{"get":{"summary":"Cart members (no emails)"},"post":{"summary":"Add leads to a cart"}},"/campaigns":{"get":{"summary":"List campaigns"},"post":{"summary":"Create a DRAFT campaign; returns preview + launch approval_token","requestBody":{"content":{"application/json":{"schema":{"type":"object","required":["name","cart_id","steps"],"properties":{"name":{"type":"string"},"cart_id":{"type":"string"},"steps":{"type":"array","items":{"$ref":"#/components/schemas/Step"}},"mailbox_ids":{"type":"array","items":{"type":"string"}},"daily_cap":{"type":"integer"}}}}}}}},"/campaigns/plan":{"post":{"summary":"Description to draft campaign in one call; returns preview + approval_token"}},"/campaigns/{id}":{"get":{"summary":"Campaign preview"}},"/campaigns/{id}/stats":{"get":{"summary":"Campaign stats"}},"/campaigns/{id}/launch":{"post":{"summary":"Preview (no body) or launch ({confirm:true, approval_token, postal_address?})"}},"/campaigns/{id}/pause":{"post":{"summary":"Pause"}},"/campaigns/{id}/resume":{"post":{"summary":"Resume"}},"/campaigns/{id}/end":{"post":{"summary":"Preview or end ({confirm:true, approval_token})"}},"/replies":{"get":{"summary":"Threads with replies","parameters":[{"in":"query","name":"since","schema":{"type":"string"}},{"in":"query","name":"unread_only","schema":{"type":"boolean"}}]}},"/replies/{thread_id}":{"get":{"summary":"Thread detail"},"patch":{"summary":"Mark read"}},"/replies/{thread_id}/send":{"post":{"summary":"Preview ({body}) or send ({body, confirm:true, approval_token})"}}}}