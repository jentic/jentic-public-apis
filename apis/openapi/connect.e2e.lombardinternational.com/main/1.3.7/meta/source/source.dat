{
  "openapi": "3.0.1",
  "info": {
    "title": "Document API",
    "description": "This Document API provides REST endpoints to access to documents",
    "contact": {
      "name": "IT Application Development",
      "url": "http://www.lombardinternational.com",
      "email": "IT_Application_Development@lombardinternational.com"
    },
    "license": {
      "name": "Lombard International Assurance",
      "url": "http://www.lombardinternational.com"
    },
    "version": "1.3.7",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Utmost-Worldwide-Ltd/document-api/1.3.7"
  },
  "servers": [
    {
      "url": "https://api.connect.e2e.lombardinternational.com/document/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/documents": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Get all documents",
        "description": "Get all documents",
        "operationId": "searchDocuments",
        "parameters": [
          {
            "name": "policyNumber",
            "in": "query",
            "description": "ID of the policy",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Name of the document",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "distributionPartner",
            "in": "query",
            "description": "ID of the distributionPartner",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "type of the document",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Zero-based page index (0..N)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "The size of the page to be returned",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sorting criteria in the format: property,(asc|desc). Default sort order is ascending. Multiple sort criteria are supported. The default value is 'id|asc'",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "distributionParterNumber",
                  "creationDate",
                  "type",
                  "name"
                ]
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentsPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID supplied",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "404": {
            "description": "Asset not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "405": {
            "description": "Validation exception",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/documents/{documentId}": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Get one document by documentId",
        "description": "Get one document by documentId",
        "operationId": "getDocumentMetadata",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "description": "Document ID of the desired document.<br> This one can be either the normal value, either a value encoded in base 64.<br>\n\"The normal one should only be used when the value does not contain any slash. If the normal case\n\"cannot be used, the base64 one should be used. To do so, it should be encoded in base64, all the potential\n\"slash should be changed in underscores and the prefix 'b64:' should be added.<br>\n\"Possible values: '1234-123456', 'b64:YWEvYmJiL2NjY2M='",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID supplied",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "404": {
            "description": "Document not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "405": {
            "description": "Validation exception",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/documents/{documentId}/content": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Download document by documentId",
        "description": "Download document by documentId",
        "operationId": "downloadDocument",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "description": "Document ID of the desired document.<br> This one can be either the normal value, either a value encoded in base 64.<br>\n\"The normal one should only be used when the value does not contain any slash. If the normal case\n\"cannot be used, the base64 one should be used. To do so, it should be encoded in base64, all the potential\n\"slash should be changed in underscores and the prefix 'b64:' should be added.<br>\n\"Possible values: '1234-123456', 'b64:YWEvYmJiL2NjY2M='",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID supplied",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "404": {
            "description": "Document not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "405": {
            "description": "Validation exception",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/documents/valuations/{date}": {
      "get": {
        "tags": [
          "Valuation Documents"
        ],
        "summary": "Get valuation statement document by policy number and date",
        "description": "Get valuation statement document by policy number and date",
        "operationId": "getValuationAtDate",
        "parameters": [
          {
            "name": "policyNumber",
            "in": "query",
            "description": "ID of the policy",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "official",
            "in": "query",
            "description": "if true, return latest official valuation",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "date",
            "in": "path",
            "description": "date of the valuation document",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID supplied",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "404": {
            "description": "Document not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "405": {
            "description": "Validation exception",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/documents/valuations/latest": {
      "get": {
        "tags": [
          "Valuation Documents"
        ],
        "summary": "Get latest valuation statement document by policy number",
        "description": "Get latest valuation statement document by policy number",
        "operationId": "getLatestValuation",
        "parameters": [
          {
            "name": "policyNumber",
            "in": "query",
            "description": "ID of the policy",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "official",
            "in": "query",
            "description": "if true, return latest official valuation",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID supplied",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "404": {
            "description": "Document not found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "405": {
            "description": "Validation exception",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResource"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResource": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Single reference of the document"
          },
          "type": {
            "type": "string",
            "description": "Type of document",
            "example": "quarterly_valuation",
            "enum": [
              "daily_valuation",
              "quarterly_valuation"
            ]
          },
          "name": {
            "type": "string",
            "description": "Document name",
            "example": "quarterly_valuation_123456-54684_18-10-2022.pdf"
          },
          "distributionPartnerNumber": {
            "type": "string",
            "description": "Lombard International Assurance's internal reference for partners for each target market",
            "example": "B/0001"
          },
          "policyNumber": {
            "type": "string",
            "description": "Unique reference of the policy",
            "example": "1401-15001"
          },
          "creationDate": {
            "type": "string",
            "description": "Date of creation of the documentation",
            "format": "date"
          },
          "metadata": {
            "type": "array",
            "description": "Useful information related to the document",
            "items": {
              "$ref": "#/components/schemas/DocumentMetadata"
            }
          }
        },
        "description": "Document"
      },
      "DocumentMetadata": {
        "required": [
          "key",
          "type",
          "value"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Key of the metadata"
          },
          "type": {
            "type": "string",
            "description": "Type of the metadata"
          },
          "value": {
            "type": "string",
            "description": "Value of the metadata"
          }
        },
        "description": "Useful information related to the document"
      },
      "DocumentsPage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          },
          "pageable": {
            "$ref": "#/components/schemas/PageableObject"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "last": {
            "type": "boolean"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "number": {
            "type": "integer",
            "format": "int32"
          },
          "sort": {
            "$ref": "#/components/schemas/SortObject"
          },
          "numberOfElements": {
            "type": "integer",
            "format": "int32"
          },
          "first": {
            "type": "boolean"
          },
          "empty": {
            "type": "boolean"
          }
        }
      },
      "PageableObject": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "format": "int64"
          },
          "sort": {
            "$ref": "#/components/schemas/SortObject"
          },
          "pageNumber": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "paged": {
            "type": "boolean"
          },
          "unpaged": {
            "type": "boolean"
          }
        }
      },
      "SortObject": {
        "type": "object",
        "properties": {
          "empty": {
            "type": "boolean"
          },
          "sorted": {
            "type": "boolean"
          },
          "unsorted": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "x-apidoc-icon": "fa fa-light fa-file"
}
