  "components": {
    "parameters": {
      "DetalhadoParams": {
        "name": "detalhado",
        "in": "query",
        "description": "Controla o retorno da consulta para trazer mais detalhes, somente ative se for necessário.",
        "required": false,
        "schema": {
          "type": "boolean",
          "example": true
        }
      },
      "PerPageParam": {
        "name": "per_page",
        "in": "query",
        "description": "Tamanho da página",
        "required": false,
        "schema": {
          "type": "integer",
          "example": 10
        }
      },
      "PageParam": {
        "name": "page",
        "in": "query",
        "description": "Número da página",
        "required": false,
        "schema": {
          "type": "integer",
          "example": 1
        }
      },
      "UpdatedAtLtParam": {
        "name": "updated_at_lt",
        "in": "query",
        "description": "Filtrar por registros atualizados antes de uma data",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time",
          "example": "2025-01-01T00:00:00Z"
        }
      },
      "UpdatedAtGtParam": {
        "name": "updated_at_gt",
        "in": "query",
        "description": "Filtrar por registros atualizados após uma data",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time",
          "example": "2023-01-01T00:00:00Z"
        }
      },
      "CreatedAtLtParam": {
        "name": "created_at_lt",
        "in": "query",
        "description": "Filtrar por registros criados antes de uma data",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time",
          "example": "2025-01-01T00:00:00Z"
        }
      },
      "CreatedAtGtParam": {
        "name": "created_at_gt",
        "in": "query",
        "description": "Filtrar por registros criados após uma data",
        "required": false,
        "schema": {
          "type": "string",
          "format": "date-time",
          "example": "2023-01-01T00:00:00Z"
        }
      },
      "Periodo": {
        "name": "periodo",
        "in": "query",
        "description": "Valor \"passado\" ou \"futuro\"",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "passado",
            "futuro"
          ]
        }
      }
    },
    "schemas": {
      "Pagination": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer",
            "example": 1
          },
          "per_page": {
            "type": "integer",
            "example": 20
          }
        }
      },
      "Plano": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "titulo": {
            "type": "string",
            "example": "Plano Premium",
            "nullable": false
          },
          "chamada": {
            "type": "string",
            "example": "Plano exclusivo para assinantes VIP.",
            "nullable": false
          },
          "valor_mensal": {
            "type": "number",
            "format": "float",
            "example": 99.99,
            "nullable": false
          },
          "valor_anual": {
            "type": "number",
            "format": "float",
            "example": 999.99,
            "nullable": false
          },
          "valor_mensal_dependente": {
            "type": "number",
            "format": "float",
            "example": 9.99,
            "nullable": false
          },
          "valor_anual_dependente": {
            "type": "number",
            "format": "float",
            "example": 99.99,
            "nullable": false
          },
          "multiplicador_de_pontuacao": {
            "type": "number",
            "format": "float",
            "example": 1.1,
            "nullable": false
          },
          "numero_maximo_dependentes": {
            "type": "integer",
            "example": 0,
            "nullable": false
          },
          "disponivel_para_venda": {
            "type": "boolean",
            "example": true,
            "nullable": false
          },
          "divulgado": {
            "type": "boolean",
            "example": false,
            "nullable": false
          },
          "possui_beneficios_na_compra_de_ingressos": {
            "type": "boolean",
            "example": false,
            "nullable": false
          },
          "permite_cobranca_anual": {
            "type": "boolean",
            "example": false,
            "nullable": true
          },
          "permite_cobranca_mensal": {
            "type": "boolean",
            "example": false,
            "nullable": true
          },
          "cobranca_anual_parcelada": {
            "type": "boolean",
            "example": false,
            "nullable": true
          },
          "beneficios": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Beneficio"
            }
          },
          "complementos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Complemento"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T10:00:00-03:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-02T12:00:00-03:00"
          }
        }
      },
      "Complemento": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 101
          },
          "nome": {
            "type": "string",
            "example": "Estacionamento VIP",
            "nullable": false
          },
          "valor_mensal": {
            "type": "number",
            "format": "float",
            "example": 29.99,
            "nullable": false
          },
          "valor_anual": {
            "type": "number",
            "format": "float",
            "example": 299.99,
            "nullable": false
          },
          "cobranca_unica": {
            "type": "boolean",
            "example": false,
            "nullable": false
          },
          "uso_unico": {
            "type": "boolean",
            "example": false,
            "nullable": false
          },
          "valor_cobranca_unica": {
            "type": "number",
            "format": "float",
            "example": 10.99,
            "nullable": true
          },
          "valor_dependente_mensal": {
            "type": "number",
            "format": "float",
            "example": 10.99,
            "nullable": false
          },
          "valor_dependente_anual": {
            "type": "number",
            "format": "float",
            "example": 100.99,
            "nullable": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T10:00:00-03:00",
            "nullable": false
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-02T12:00:00-03:00",
            "nullable": false
          }
        }
      },
      "Beneficio": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 201
          },
          "nome": {
            "type": "string",
            "example": "Desconto em ingressos",
            "nullable": false
          },
          "padrao": {
            "type": "boolean",
            "example": false,
            "nullable": false
          },
          "publico": {
            "type": "boolean",
            "example": false,
            "nullable": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T10:00:00-03:00",
            "nullable": false
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-02T12:00:00-03:00",
            "nullable": false
          }
        }
      },
      "Assinatura": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 303
          },
          "cliente_id": {
            "type": "integer",
            "example": 12345,
            "nullable": false
          },
          "plano_id": {
            "type": "integer",
            "example": 1,
            "nullable": false
          },
          "plano_titulo": {
            "type": "string",
            "example": "CABULOSO MAX",
            "nullable": false
          },
          "valor_mensal_total": {
            "type": "number",
            "format": "float",
            "example": 999.99,
            "nullable": false
          },
          "valor_anual_total": {
            "type": "number",
            "format": "float",
            "example": 999.99,
            "nullable": false
          },
          "data_inicio": {
            "type": "string",
            "format": "date",
            "example": "2023-01-01",
            "nullable": false
