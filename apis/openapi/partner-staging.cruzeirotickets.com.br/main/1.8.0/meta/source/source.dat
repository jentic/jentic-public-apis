          },
          {
            "name": "documento_tipo",
            "in": "query",
            "description": "Tipo do documento cliente para filtrar clientes",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CPF",
                "PASSPORT"
              ],
              "example": "CPF"
            }
          },
          {
            "name": "documento",
            "in": "query",
            "description": "Documento do cliente para busca",
            "required": false,
            "schema": {
              "type": "string",
              "example": "12345678901"
            }
          },
          {
            "name": "email",
            "in": "query",
            "description": "Email do cliente para filtrar anúncios",
            "required": false,
            "schema": {
              "type": "string",
              "format": "email",
              "example": "cliente@exemplo.com"
            }
