{
  "openapi": "3.0.3",
  "info": {
    "title": "BaladAPP - API de Integração para Parceiros",
    "description": "Prove acesso a planos de assinatura, assinaturas, ingressos e pedidos.",
    "version": "1.8.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/baladapp/baladapp-api-de-integracao-para-parceiros/1.8.0"
  },
  "servers": [
    {
      "url": "https://partner.cruzeiro.com.br/api/integracao/v1/",
      "description": "Servidor de Produção"
    }
  ],
  "tags": [
    {
      "name": "Assinaturas",
      "description": "Endpoints relacionados a planos, complementos, benefícios e assinaturas."
    },
    {
      "name": "Clientes",
      "description": "Endpoints relacionados aos clientes."
    },
    {
      "name": "Anuncios",
      "description": "Endpoints relacionados aos anuncios, ingressos e pedidos."
    }
  ],
  "security": [
    {
      "integracao_api_token": []
    }
  ],
