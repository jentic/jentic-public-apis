    "/v1/web3/subscribe": {
      "post": {
        "tags": [
          "Web3 Authentication"
        ],
        "summary": "Start Build or Pro access via x402 USDC payment",
        "description": "x402-protected endpoint for purchasing 30-day Build or Pro access with USDC on Base. Unknown wallets receive an account and API key only after successful payment settlement. Existing disabled wallets are rejected before facilitator verification or settlement.\n\n**Flow:**\n1. POST with `{ \"tier\": \"build\" }` (no payment header) \u2192 Server returns 402 with payment details (amount, pay_to address, network)\n2. Sign an EIP-712 `TransferWithAuthorization` (EIP-3009) on USDC Base for the specified amount\n3. Build x402 v2 payment payload, base64-encode it, and retry with `payment-signature` header\n4. Server verifies and settles payment via the facilitator \u2192 grants access \u2192 returns API key\n\nNo API key required. Payment establishes paid wallet access.",
        "operationId": "web3Subscribe",
        "security": [],
        "parameters": [
          {
            "name": "payment-signature",
            "in": "header",
            "description": "Base64-encoded x402 v2 payment payload containing the EIP-3009 signed USDC transfer authorization. Omit on first request to receive payment details.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Web3SubscribeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created successfully (returned when valid payment-signature header is provided)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Web3SubscribeResponse"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "402": {
            "description": "Payment required. Response includes payment details: amount (micro-USDC), pay_to address, and network. Sign and retry with payment-signature header.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "payment": {
                          "type": "object",
                          "properties": {
                            "amount": {
                              "type": "string",
                              "description": "Amount in micro-USDC (6 decimals)",
                              "example": "49000000"
                            },
                            "pay_to": {
                              "type": "string",
                              "description": "Treasury address to send USDC to",
                              "example": "0x..."
                            },
                            "network": {
                              "type": "string",
                              "description": "Blockchain network",
                              "example": "base"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "403": {
            "description": "The existing wallet account is disabled. No facilitator verification or settlement is attempted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "code": 403,
                  "error_code": "account_disabled",
                  "error": "Account is disabled",
                  "request_id": "00000000-0000-0000-0000-000000000000"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/hyperliquid/orders/{symbol}/history": {
      "get": {
        "tags": [
          "Hyperliquid - Orders"
        ],
        "summary": "Get Hyperliquid order history",
        "description": "Get order lifecycle events for a symbol. Includes order placements, modifications, fills, cancellations, and triggers.",
        "operationId": "getHyperliquidOrderHistory",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "description": "Trading pair symbol (e.g., BTC, ETH, SOL)",
            "schema": {
              "type": "string",
              "example": "BTC"
            },
            "example": "BTC"
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            },
            "example": 1767225600000
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            },
            "example": 1767225600000
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor: pass `meta.next_cursor` from the previous page unchanged, with the same filters. Omit it for the first page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results (default: 1000, max: 10000)",
            "schema": {
              "type": "integer",
              "default": 1000,
              "maximum": 10000
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Keep events whose status equals this value exactly (case-sensitive), as Hyperliquid names it: for example `open`, `filled`, `canceled`, `triggered`, `rejected`, `marginCanceled`, `reduceOnlyCanceled`, `selfTradeCanceled` or `siblingFilledCanceled`.",
            "schema": {
              "type": "string",
              "example": "filled"
            }
          },
          {
            "name": "order_type",
            "in": "query",
            "description": "Keep events whose order type equals this value exactly (case-sensitive), as Hyperliquid names it: for example `Limit`, `Stop Market`, `Stop Limit`, `Take Profit Market` or `Take Profit Limit`.",
            "schema": {
              "type": "string",
              "example": "Limit"
            }
          },
          {
            "name": "triggered",
            "in": "query",
            "description": "`true` keeps only events with status `triggered`; `false` keeps every other event. Omit it for all events.",
            "schema": {
              "type": "boolean"
            },
            "required": false
          },
          {
            "name": "user",
            "in": "query",
            "description": "Keep events for this wallet address. Exact match: send the address as it appears in responses (lowercase `0x` hex).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order lifecycle events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        },
                        "next_cursor": {
                          "type": "string"
                        },
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/hyperliquid/orders/{symbol}/flow": {
      "get": {
        "tags": [
          "Hyperliquid - Orders"
        ],
        "summary": "Get Hyperliquid order flow",
        "description": "Get order flow aggregation for a symbol, in buckets of `interval` (1m by default). Shows order placement and cancellation rates over time.\n\n**Buckets:** each bucket is labelled by its open time in UTC, and buckets open on multiples of the bucket width since the Unix epoch. A bucket with no order events is omitted. A bucket counts only the events inside `[start, end)`, so when `start` or `end` falls inside a bucket, that first or last bucket is partial; `start` and `end` on bucket opens give whole buckets.\n\n**Pagination:** results are oldest first. When `meta.has_more` is `true`, pass the string `meta.next_cursor` unchanged as `cursor` with the same filters to get the next page. Stop when `meta.has_more` is `false`.",
        "operationId": "getHyperliquidOrderFlow",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "description": "Trading pair symbol (e.g., BTC, ETH, SOL)",
            "schema": {
              "type": "string",
              "example": "BTC"
            },
            "example": "BTC"
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp, inclusive (default: 24 hours before now). Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            },
            "example": 1767225600000
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp, exclusive (default: now). Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            },
            "example": 1767225600000
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor: use the string `meta.next_cursor` returned when `meta.has_more` is `true`, passed back unchanged with the same filters. Do not parse or construct it. Stop when `meta.has_more` is `false`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of buckets, oldest first (default: 1000, max: 10000)",
            "schema": {
              "type": "integer",
              "default": 1000,
              "maximum": 10000
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "description": "Bucket width: `1m` (default), `5m`, `15m` or `1h`. Case-sensitive. Any other value answers 400.",
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "15m",
                "1h"
              ],
              "default": "1m"
            }
          },
          {
            "name": "granularity",
            "in": "query",
            "description": "Deprecated alias of `interval`. `interval` wins when both are sent.",
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "15m",
                "1h"
              ],
              "default": "1m"
            },
            "deprecated": true
          }
        ],
        "responses": {
          "200": {
            "description": "Order flow aggregation data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        },
                        "next_cursor": {
                          "type": "string"
                        },
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
