    "/v1/hyperliquid/positions": {
      "get": {
        "tags": [
          "Hyperliquid - Positions"
        ],
        "summary": "Get all Hyperliquid positions",
        "description": "Every open position across all markets at one committed hourly snapshot (default: the latest), for bulk loading. Each row carries `snapshot_ts`.  Billed at 1 credit per 1,000 rows returned, minimum 1 credit per request.",
        "operationId": "getHyperliquidAllPositions",
        "parameters": [
          {
            "name": "hour",
            "in": "query",
            "description": "Committed hourly snapshot to read, as an exact UTC hour in Unix milliseconds. Defaults to the latest committed hour.",
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1789999200000
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows per page (default 1000; max 2000 as JSON, 50,000 as Arrow).",
            "schema": {
              "type": "integer",
              "default": 1000,
              "minimum": 1,
              "maximum": 50000
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor: pass `meta.next_cursor` from the previous page unchanged, with the same filters. Omit it for the first page. Keep every other parameter unchanged.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "`arrow` returns an Apache Arrow IPC stream (`application/vnd.apache.arrow.stream`) with up to 50,000 rows per page and the page metadata in the `x-count`, `x-next-cursor`, and `x-schema-version: positions.v1` headers, where Arrow output is enabled for this route; otherwise the response is JSON. Sending `Accept: application/vnd.apache.arrow.stream` has the same effect.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "arrow"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get all Hyperliquid positions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMarketPositionArray"
                }
              },
              "application/vnd.apache.arrow.stream": {
                "schema": {
                  "type": "string",
                  "format": "binary",
                  "description": "Apache Arrow IPC stream of `MarketPosition` rows (schema version `positions.v1`)."
                }
              }
            },
            "headers": {
              "x-count": {
                "schema": {
                  "type": "integer"
                },
                "description": "Arrow responses: rows in this page."
              },
              "x-next-cursor": {
                "schema": {
                  "type": "string"
                },
                "description": "Arrow responses: cursor for the next page, absent on the last page."
              },
              "x-schema-version": {
                "schema": {
                  "type": "string"
                },
                "description": "Arrow responses: `positions.v1`."
              },
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "The snapshot a market cursor was paging has been replaced or has expired (`error_code` `snapshot_advanced`). Restart pagination without a cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "code": 409,
                  "error_code": "snapshot_advanced",
                  "error": "The snapshot this cursor was paging has been replaced or has expired. Restart pagination without a cursor.",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "description": "Positions, pagination, or an as-of reconstruction are temporarily unavailable (`error_code` `positions_unavailable`, `pagination_unavailable`, or `reconstruction_unavailable`). Retry shortly.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before retrying."
              },
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "code": 503,
                  "error_code": "positions_unavailable",
                  "error": "Account positions are not available right now.",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/hyperliquid/hip3/wallets/{address}/positions": {
      "get": {
        "tags": [
          "HIP-3 Builder Perps - Positions"
        ],
        "summary": "Get HIP-3 wallet positions",
        "description": "Open positions of one wallet: the latest live snapshot, or the state at `timestamp`. Scope to one dex with `dex` to also get that dex's account summary. An empty result reports `account_seen`. The change log starts October 13, 2025; hourly history starts June 7, 2026 18:00 UTC (later for some dexes); live snapshots refresh every 5 minutes. Billed at 1 credit per 1,000 rows returned, minimum 1 credit per request.",
        "operationId": "getHip3WalletPositions",
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "description": "Wallet address: 0x followed by 40 hex characters (case-insensitive).",
            "schema": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$",
              "example": "0x31ca8395cf837de08b24da3f660e77761dfb974b"
            },
            "required": true,
            "example": "0x31ca8395cf837de08b24da3f660e77761dfb974b"
          },
          {
            "name": "timestamp",
            "in": "query",
            "description": "As-of instant: the state after every event before it. An exact hour with a committed snapshot serves that snapshot; any other instant is reconstructed (`meta.source: reconstructed`) and clamped to `meta.built_through`. Omit for the latest live snapshot. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "description": "Only this market, in `dex:COIN` form (e.g. xyz:TSLA). Must agree with `dex` when both are set.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dex",
            "in": "query",
            "description": "Restrict to one HIP-3 dex (for example `xyz`).",
            "schema": {
              "type": "string",
              "example": "xyz"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows per page (default 500, max 5000).",
            "schema": {
              "type": "integer",
              "default": 500,
              "minimum": 1,
              "maximum": 5000
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor: pass `meta.next_cursor` from the previous page unchanged, with the same filters. Omit it for the first page. Keep every other parameter unchanged.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get HIP-3 wallet positions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWalletPositions"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "description": "Positions, pagination, or an as-of reconstruction are temporarily unavailable (`error_code` `positions_unavailable`, `pagination_unavailable`, or `reconstruction_unavailable`). Retry shortly.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before retrying."
              },
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "code": 503,
                  "error_code": "positions_unavailable",
                  "error": "Account positions are not available right now.",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
