    "/v1/rh-lighter/orderbook/{symbol}": {
      "get": {
        "tags": [
          "Lighter on Robinhood Chain - Order Book"
        ],
        "summary": "Get Lighter on Robinhood Chain order book",
        "description": "Get the latest Lighter on Robinhood Chain L2 order book, or the book at a specific timestamp. Returns price, size, and order count at each level. Served from August 22, 2026 18:43 UTC.",
        "operationId": "getRhLighterOrderbook",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "description": "Market symbol on Lighter on Robinhood Chain. Perpetuals use the uppercase base symbol (BTC); spot pairs are dashed and USDG-quoted (AAPL-USDG). List markets with GET /v1/rh-lighter/instruments.",
            "schema": {
              "type": "string",
              "example": "BTC"
            },
            "example": "BTC"
          },
          {
            "name": "timestamp",
            "in": "query",
            "description": "Instant to read. If not provided, returns latest snapshot. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            },
            "example": 1788000000000
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Requested price levels per side. The Lighter native L2 route includes all served levels.",
            "schema": {
              "type": "integer",
              "example": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order book snapshot",
