            "type": "integer"
          },
          "p99_24h_ms": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ApiLatency": {
        "type": "object",
        "properties": {
          "current_ms": {
            "type": "integer"
          },
          "avg_1h_ms": {
            "type": "integer"
          },
          "avg_24h_ms": {
            "type": "integer"
          }
        }
      },
      "DataFreshness": {
        "type": "object",
