            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/rh-lighter/orderbook/{symbol}/history": {
      "get": {
        "tags": [
          "Lighter on Robinhood Chain - Order Book"
        ],
        "summary": "Get Lighter on Robinhood Chain order book history",
        "description": "Get historical Lighter on Robinhood Chain L2 order book snapshots within a time range with configurable resolution. History starts August 22, 2026 18:43 UTC at every granularity. Use the `granularity` parameter to control data resolution.\n\n**Tick-Level Data:**\nWhen `granularity=tick`, the response format changes. Instead of returning snapshots in the `data` array, it returns:\n- `checkpoint`: Full orderbook state at the start of the time range\n- `deltas`: Array of incremental changes to apply to the checkpoint\n\nThis is the most efficient format for reconstructing high-frequency orderbook states. Use the SDK's `OrderBookReconstructor` class for client-side reconstruction.",
        "operationId": "getRhLighterOrderbookHistory",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "BTC"
            },
            "description": "Market symbol on Lighter on Robinhood Chain. Perpetuals use the uppercase base symbol (BTC); spot pairs are dashed and USDG-quoted (AAPL-USDG). List markets with GET /v1/rh-lighter/instruments.",
            "example": "BTC"
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp. Defaults to 24h ago. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp. Defaults to now. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor: pass `meta.next_cursor` from the previous page unchanged, with the same filters. Omit it for the first page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor_seq",
            "in": "query",
            "required": false,
            "description": "`granularity=tick` only: the `data.next_cursor_seq` of the previous page, sent with `cursor`. Many deltas share a millisecond, so tick paging needs both. Ignored at other granularities.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of results (default: 100, max: 1000)",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 1000
            }
          },
          {
            "name": "depth",
            "in": "query",
            "description": "Requested price levels per side. The Lighter native L2 route includes all served levels.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "granularity",
            "in": "query",
            "description": "Data resolution: checkpoint (1min, default), 30s, 10s, 1s, tick. History starts August 22, 2026 18:43 UTC at every granularity. Billed per row returned (about 1 credit per 1,000 rows, minimum 1 credit per request). Higher resolutions return more rows. **Note:** When granularity=tick, the response format changes to return `checkpoint` and `deltas` instead of a `data` array. `60s` and `1m` are accepted for `checkpoint`, and `delta` and `deltas` for `tick`. An unrecognised value is currently served as `checkpoint`.",
            "schema": {
              "type": "string",
              "enum": [
                "checkpoint",
                "30s",
                "10s",
                "1s",
                "tick"
              ],
              "default": "checkpoint"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of order book snapshots",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseOrderBookArray"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/rh-lighter/trades/{symbol}": {
      "get": {
        "tags": [
          "Lighter on Robinhood Chain - Trades"
        ],
        "summary": "Get Lighter on Robinhood Chain trades",
        "description": "Get canonical Lighter on Robinhood Chain trades (two fill rows per trade, one per account) within a time range. Served from the venue launch on June 26, 2026 20:10:26 UTC. History is canonical only: `end` is clamped to `meta.finalized_through`, about a day behind real time, and `meta.requested_end` plus `meta.clamped_to` report a clamp. Use `/recent` for the preliminary tier.\n\n**Pagination:** Use the `cursor` parameter with the value from the previous response's `next_cursor` for efficient pagination.",
        "operationId": "getRhLighterTrades",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "BTC"
            },
            "description": "Market symbol on Lighter on Robinhood Chain. Perpetuals use the uppercase base symbol (BTC); spot pairs are dashed and USDG-quoted (AAPL-USDG). List markets with GET /v1/rh-lighter/instruments.",
            "example": "BTC"
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp. Defaults to 24h ago. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp. Defaults to now. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            }
          },
          {
            "name": "side",
            "in": "query",
            "required": false,
            "description": "Keep one side of the tape: `buy` or `sell` (case-insensitive). Omit it for both. The filter runs before paging, so a full page still holds `limit` matching trades and the cursor pages the filtered tape. Any other value answers 400 `invalid_parameter` with `param` and `valid_values`.",
            "schema": {
              "type": "string",
              "enum": [
                "buy",
                "sell"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor: pass `meta.next_cursor` from the previous page unchanged, with the same filters. Omit it for the first page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of trades (default: 100, max: 50000).",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 50000,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of trades with cursor for next page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLighterTradeArray"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/rh-lighter/trades/{symbol}/recent": {
      "get": {
        "tags": [
          "Lighter on Robinhood Chain - Trades"
        ],
        "summary": "Get recent Lighter on Robinhood Chain trades",
        "description": "Get the most recent Lighter on Robinhood Chain trades, ordered by timestamp descending. Includes preliminary real-time rows (`source: \"ws\"`) past `meta.finalized_through`; `meta.preliminary_row_count` reports how many rows in the page are not final yet.",
        "operationId": "getRhLighterRecentTrades",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "BTC"
            },
            "description": "Market symbol on Lighter on Robinhood Chain. Perpetuals use the uppercase base symbol (BTC); spot pairs are dashed and USDG-quoted (AAPL-USDG). List markets with GET /v1/rh-lighter/instruments.",
            "example": "BTC"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of trades (default: 100, max: 50000).",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 50000,
              "minimum": 1
            }
          },
          {
            "name": "side",
            "in": "query",
            "required": false,
            "description": "Keep one side of the tape: `buy` or `sell` (case-insensitive). Omit it for both. The filter runs before paging, so a full page still holds `limit` matching trades and the cursor pages the filtered tape. Any other value answers 400 `invalid_parameter` with `param` and `valid_values`.",
            "schema": {
              "type": "string",
              "enum": [
                "buy",
                "sell"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of recent trades",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseLighterTradeArray"
                }
