    "/v1/hyperliquid/hip4/outcomes/{outcome_id}": {
      "get": {
        "tags": [
          "HIP-4 Outcomes - Outcomes"
        ],
        "summary": "Get HIP-4 outcome detail",
        "description": "Get a single HIP-4 outcome by `outcome_id`. Response uses `Hip4OutcomeAggregate` WITH `aggregated_oi` populated: latest both-sides OI snapshot including `outcome_display_open_interest_contracts` (sum of side0 + side1), `paired_set_supply_contracts` (paired-set notional), and `side_supply_parity` (whether side0 == side1 within tolerance). Currency is always `USDH`. Data available from May 2026.",
        "operationId": "getHip4Outcome",
        "parameters": [
          {
            "name": "outcome_id",
            "in": "path",
