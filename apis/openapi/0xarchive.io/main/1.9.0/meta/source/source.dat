    "/v1/rh-lighter/positions/{symbol}": {
      "get": {
        "tags": [
          "Lighter on Robinhood Chain - Positions"
        ],
        "summary": "Get Lighter on Robinhood Chain market positions",
        "description": "Every open position in one market at the latest live snapshot, or at the committed hourly snapshot `hour`, sorted by position value, largest first. The first page carries `meta.totals` over the whole filtered set. System accounts are excluded unless `include_system=true`.  Billed at 1 credit per 1,000 rows returned, minimum 1 credit per request.",
        "operationId": "getRhLighterMarketPositions",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "description": "Perpetual symbol on Lighter on Robinhood Chain (e.g. BTC). Spot pairs have no positions. Pass it exactly as the instruments route lists it, in uppercase.",
            "schema": {
              "type": "string",
              "example": "BTC"
            },
            "required": true,
            "example": "BTC"
          },
          {
            "name": "hour",
            "in": "query",
            "description": "Committed hourly snapshot to read, as an exact UTC hour in Unix milliseconds. Echoed as `meta.snapshot_ts`. Defaults to the latest live snapshot.",
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1789999200000
          },
          {
            "name": "side",
            "in": "query",
            "description": "Only long or only short positions.",
            "schema": {
              "type": "string",
              "enum": [
                "long",
                "short"
              ]
            }
          },
          {
            "name": "min_value",
            "in": "query",
            "description": "Only positions worth at least this much in USD.",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "include_system",
            "in": "query",
            "description": "Include settlement, insurance, and other system accounts (excluded by default).",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows per page (default 100, max 2000).",
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 2000
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor: pass `meta.next_cursor` from the previous page unchanged, with the same filters. Omit it for the first page. Keep every other parameter unchanged.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get Lighter on Robinhood Chain market positions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMarketPositionArray"
                }
              }
