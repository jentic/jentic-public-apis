            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/hyperliquid/hip3/cvd/{symbol}": {
      "get": {
        "tags": [
          "HIP-3 Builder Perps - Convenience"
        ],
        "summary": "Get HIP-3 cumulative volume delta",
        "description": "Get cumulative volume delta buckets for a HIP-3 builder-perp symbol: taker buy and sell notional per bucket, their difference, and a running total. Intervals of 1h and longer roll up hourly totals; 1m, 5m, 15m and 30m are summed from taker fills. Live responses currently meter this route at 1 credit per request. Preserve the builder prefix and symbol case.\n\n**Buckets:** each bucket is labelled by its open time in UTC and is omitted when it holds no trades. 4h, 1d and 1w buckets open on UTC epoch boundaries, so 1w buckets open on Thursdays. Below 1h, a bucket is returned when it opens inside `[start, end]`, and it always covers its full interval. From 1h up, each bucket sums the hours that open inside `[start, end]`, so at 4h, 1d and 1w the first and last buckets of a window can be partial.\n\n**Pagination:** a page holds up to `limit` buckets (default 500, max 10000). While more buckets may follow inside `[start, end]`, `meta.next_cursor` is set: pass it back as `cursor` with `start`, `end` and `interval` unchanged, and stop when it is absent. Below 1h a page can hold fewer than `limit` buckets and still carry a cursor, so stop on the cursor, not on a short page. At the default `limit`, a window of up to 500 buckets is always one page. Without `start` or `cursor`, the response is the newest `limit` buckets of the 24 hours before `end` (or before now, when `end` is later), with no cursor.\n\n**Running total:** `cumulative_delta` is a running total of `delta` from the first bucket of each response, so it restarts on every page. To join pages, rebuild it from `delta`. A response that is one page of several says so in `meta.notice`.",
        "operationId": "getHip3Cvd",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "description": "HIP-3 symbol with builder prefix. Case-sensitive.",
            "schema": {
              "type": "string",
              "example": "km:US500"
            },
            "example": "km:US500"
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp. When omitted, and no `cursor` is sent, the window is the 24 hours before `end` and the newest `limit` buckets of it are returned. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp. Defaults to now. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "description": "Bucket width (default: 1h). Intervals of 1h and longer roll up hourly totals; 1m, 5m, 15m and 30m are summed from taker fills. Any other value returns 400.",
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "15m",
                "30m",
                "1h",
                "4h",
                "1d",
                "1w"
              ],
              "default": "1h"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor: pass `meta.next_cursor` from the previous page unchanged, with the same filters. Omit it for the first page. Returns the buckets that open after it. Send it with the same `start`, `end` and `interval`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Buckets per page (default: 500, max: 10000)",
            "schema": {
              "type": "integer",
              "default": 500,
              "maximum": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HIP-3 CVD buckets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCvdBucketArray"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/hyperliquid/liquidations/{symbol}/levels": {
      "get": {
        "tags": [
          "Hyperliquid - Liquidations"
        ],
        "summary": "Get Hyperliquid liquidation levels",
        "description": "Projected forced-liquidation levels computed from clearinghouse positions and margin state, aggregated into price buckets around the snapshot mark price. Snapshots are computed roughly every 5 minutes; the response's snapshot_ts identifies the snapshot served. Historical snapshots are retained from 2026-07-27: use the at parameter for a point-in-time read, or the /history variant to enumerate snapshots with cursor pagination. Available on every plan; the endpoint carries a premium per-request credit cost. Note: before 2026-07-23 this path served a pending trigger-order map; that data now lives at /orders/{symbol}/trigger-levels.",
        "operationId": "getHyperliquidLiquidationLevels",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "description": "Trading pair symbol.",
            "schema": {
              "type": "string",
              "example": "BTC"
            },
            "example": "BTC"
          },
          {
            "name": "range_pct",
            "in": "query",
            "description": "Percentage range around the snapshot mid/mark price. Clamped between 1 and 50. Default 10.",
            "schema": {
              "type": "number",
              "default": 10,
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "buckets",
            "in": "query",
            "description": "Number of price buckets. Clamped between 10 and 200. Default 50.",
            "schema": {
              "type": "integer",
              "default": 50,
              "minimum": 10,
              "maximum": 200
            }
          },
          {
            "name": "side",
            "in": "query",
            "description": "Optional side filter. bid/buy/B keeps the long (or bid) side, ask/sell/A keeps the short (or ask) side; the other side is zeroed.",
            "schema": {
              "type": "string",
              "enum": [
                "bid",
                "ask",
                "buy",
                "sell",
                "B",
                "A"
              ]
            }
          },
          {
            "name": "at",
            "in": "query",
            "description": "Point-in-time read. Serves the newest snapshot at or before this instant. Omit for the latest snapshot. History begins 2026-07-27; earlier instants return 404. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            }
          }
        ],
        "responses": {
