        ],
        "summary": "Get spot OHLCV candles",
        "description": "Historical OHLCV candle data for a Hyperliquid spot pair, aggregated from archived spot trade data. Coverage matches archived spot trade history, beginning 2025-03-22.\n\n**Available Intervals:** 1m, 5m, 15m, 30m, 1h, 4h, 1d, 1w\n\n**Pagination:** Use the `cursor` parameter with the value from the previous response's `next_cursor`.",
        "operationId": "getSpotCandles",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "description": "Spot pair symbol. Accepts dashed canonical (`PURR-USDC`, `HYPE-USDC`), the wire-format coin (`@107`), or a bare base-token name (`HFUN`).",
            "schema": {
              "type": "string",
              "example": "PURR-USDC"
            },
            "example": "PURR-USDC"
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp. Defaults to 24h ago. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp. Defaults to now. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
