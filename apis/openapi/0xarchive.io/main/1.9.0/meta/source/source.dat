          },
          {
            "name": "dex",
            "in": "query",
            "description": "Restrict to one HIP-3 dex (for example `xyz`).",
            "schema": {
              "type": "string",
              "example": "xyz"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows per page (default 500, max 5000).",
            "schema": {
              "type": "integer",
              "default": 500,
              "minimum": 1,
              "maximum": 5000
            }
