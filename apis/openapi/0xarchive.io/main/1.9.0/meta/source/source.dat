          },
          "completeness_status": {
            "type": "string",
            "enum": [
              "met",
              "missed"
            ]
          },
          "api_latency_p99_ms": {
            "type": "integer"
          },
          "latency_status": {
            "type": "string",
            "enum": [
              "met",
              "missed"
            ]
