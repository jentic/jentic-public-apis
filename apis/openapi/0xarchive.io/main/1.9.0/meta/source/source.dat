    "/v1/hyperliquid/spot/trades/{symbol}": {
      "get": {
        "tags": [
          "Hyperliquid Spot"
        ],
        "summary": "Get Hyperliquid Spot trades",
        "description": "Get bounded historical trades for a Hyperliquid Spot pair.",
        "operationId": "getHyperliquidSpotTrades",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "description": "Hyperliquid Spot pair symbol, for example HYPE-USDC",
            "schema": {
              "type": "string",
              "example": "HYPE-USDC"
            },
            "example": "HYPE-USDC"
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp for bounded historical queries. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            },
            "example": 1704067200000
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp for bounded historical queries. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            },
            "example": 1704070800000
          },
          {
            "name": "side",
            "in": "query",
            "required": false,
            "description": "Keep one side of the tape: `buy` or `sell` (case-insensitive). Omit it for both. The filter runs before paging, so a full page still holds `limit` matching trades and the cursor pages the filtered tape. Any other value answers 400 `invalid_parameter` with `param` and `valid_values`.",
            "schema": {
              "type": "string",
              "enum": [
                "buy",
                "sell"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor: pass `meta.next_cursor` from the previous page unchanged, with the same filters. Omit it for the first page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of trades (default: 100, max: 50000).",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 50000,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of trades with cursor for next page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseTradeArray"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
