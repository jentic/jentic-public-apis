        "properties": {
          "orderbook_lag_ms": {
            "type": "integer",
            "nullable": true
          },
          "fills_lag_ms": {
            "type": "integer",
            "nullable": true
          },
          "funding_lag_ms": {
            "type": "integer",
            "nullable": true
          },
          "oi_lag_ms": {
            "type": "integer",
            "nullable": true
          }
