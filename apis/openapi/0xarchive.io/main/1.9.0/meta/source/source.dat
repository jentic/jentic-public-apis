    "/v1/rh-lighter/accounts/{account_index}/positions": {
      "get": {
        "tags": [
          "Lighter on Robinhood Chain - Positions"
        ],
        "summary": "Get Lighter on Robinhood Chain account positions",
        "description": "Open positions of one account: the latest live snapshot, or the state at `timestamp`. The first page of a snapshot read without `symbol` also returns the account's position aggregates. An empty result reports `account_seen`. The change log and hourly history start June 26, 2026; live snapshots refresh every 2 minutes. Values are in USDG. Rows past the trade finalization watermark are preliminary (`finalized: false`). Billed at 1 credit per 1,000 rows returned, minimum 1 credit per request.",
        "operationId": "getRhLighterAccountPositions",
        "parameters": [
          {
            "name": "account_index",
            "in": "path",
            "description": "Lighter account index (an integer). Resolve an L1 address on Lighter mainnet with GET /v1/lighter/accounts?l1_address=0x...",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$",
              "example": "513030"
            },
            "required": true,
            "example": "513030"
          },
          {
            "name": "timestamp",
            "in": "query",
            "description": "As-of instant: the state after every event before it. An exact hour with a committed snapshot serves that snapshot; any other instant is reconstructed (`meta.source: reconstructed`) and clamped to `meta.built_through`. Omit for the latest live snapshot. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "description": "Only this perpetual (e.g. BTC). Pass it exactly as the instruments route lists it, in uppercase.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows per page (default 500, max 5000).",
            "schema": {
              "type": "integer",
              "default": 500,
              "minimum": 1,
              "maximum": 5000
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor: pass `meta.next_cursor` from the previous page unchanged, with the same filters. Omit it for the first page. Keep every other parameter unchanged.",
            "schema": {
              "type": "string"
            }
          }
