        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/rh-lighter/candles/{symbol}": {
      "get": {
        "tags": [
          "Lighter on Robinhood Chain - Candles"
        ],
        "summary": "Get Lighter on Robinhood Chain OHLCV candles",
        "description": "Get Lighter on Robinhood Chain OHLCV candles derived from canonical trades, from June 26, 2026. Supports intervals from 1 minute to 1 week. Until candles are enabled for this deployment the route answers with an error instead of empty data.\n\n**Available Intervals:** 1m, 5m, 15m, 30m, 1h, 4h, 1d, 1w\n\n**Pagination:** Use the `cursor` parameter with the value from the previous response's `next_cursor` for efficient pagination.",
        "operationId": "getRhLighterCandles",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "BTC"
            },
            "description": "Market symbol on Lighter on Robinhood Chain. Perpetuals use the uppercase base symbol (BTC); spot pairs are dashed and USDG-quoted (AAPL-USDG). List markets with GET /v1/rh-lighter/instruments.",
            "example": "BTC"
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp. Defaults to 24h ago. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp. Defaults to now. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "description": "Candle interval (default: 1h)",
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "15m",
                "30m",
                "1h",
                "4h",
                "1d",
                "1w"
              ],
              "default": "1h"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor: pass `meta.next_cursor` from the previous page unchanged, with the same filters. Omit it for the first page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of candles (default: 100, max: 10000).",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 10000,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of OHLCV candles with cursor for next page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseCandleArray"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
