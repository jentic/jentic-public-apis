      "TimeInput": {
        "description": "An instant: Unix milliseconds, or an RFC 3339 string such as `2026-01-01T00:00:00Z` (encode a `+` offset as `%2B`). An unparsable value answers 400 `invalid_time_range`.",
        "oneOf": [
          {
            "type": "integer",
            "format": "int64",
            "description": "Unix milliseconds.",
            "example": 1767225600000
          },
          {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 instant.",
            "example": "2026-01-01T00:00:00Z"
          }
        ]
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable, machine-readable error code. Branch on this value, not on the `error` text.\n\n**Contract codes**\n\n| Code | HTTP | Meaning |\n|---|---|---|\n| `invalid_parameter` | 400 | A parameter failed to parse or validate. `param` names it and `valid_values` lists accepted values where the set is fixed. |\n| `invalid_symbol` | 400 | The symbol is not listed on this venue. |\n| `invalid_interval` | 400 | The `interval` (bucket width) is not one this route accepts. |\n| `invalid_cursor` | 400 | The `cursor` is malformed, stale, or was issued for other filters. Restart pagination without a cursor. Trades, liquidations, L2 and L4 diffs, order history and TP/SL routes currently return the first page for a malformed cursor instead. |\n| `invalid_time_range` | 400 | `start` is after `end`, or a time value could not be parsed. |\n| `range_before_coverage` | 400 | The whole requested range ends before the first instant this dataset is served from. |\n| `historical_range_exceeded` | 403 | The requested span is longer than the plan allows in one request or replay. |\n| `historical_depth_exceeded` | 403 | The request reaches further back than the plan's history window. |\n| `unsupported_for_venue` | 404 | The venue does not offer this datatype. The message, `datatype` and `available_on` name where it is served. |\n| `route_not_found` | 404 | No route matches the path or method. `GET /v1/capabilities` lists the routes each venue serves. |\n| `not_found` | 404 | The route exists but the requested resource (for example an incident, endpoint or outcome id) does not. |\n| `unauthorized` | 401 | The API key is missing or invalid. |\n| `forbidden` | 403 | The key is valid but not allowed to make this request. |\n| `insufficient_credits` | 429 | The monthly credit allowance is spent (402 on pay-per-request routes). |\n| `rate_limited` | 429 | Too many requests or concurrent queries. Retry after the interval in the rate-limit headers. |\n| `conflict` | 409 | The request conflicts with the current state of the resource. |\n| `upstream_unavailable` | 503 | A dependency is unavailable or saturated. Retry shortly; the response carries `Retry-After`. |\n| `internal_error` | 500 | An unexpected server error. Quote `request_id` when contacting support. |\n\n**WebSocket only** (sent in `{\"type\":\"error\"}` messages, never by REST)\n\n| Code | Where | Meaning |\n|---|---|---|\n| `endpoint_unsupported` | WebSocket | This WebSocket endpoint does not serve the channel or operation. The message names the endpoint that does. |\n| `slow_consumer` | WebSocket | The connection fell behind a stream and messages were dropped. Re-subscribe, or restart the replay, to resynchronise. |\n\n**Route-specific codes**\n\n| Code | HTTP | Meaning |\n|---|---|---|\n| `positions_unavailable` | 503 | Account positions are temporarily unavailable for this venue. |\n| `reconstruction_unavailable` | 503 | The as-of positions state for this instant cannot be reconstructed right now. |\n| `snapshot_advanced` | 409 | A positions market cursor pinned a snapshot that has since been replaced or expired. Restart pagination. |\n| `pagination_unavailable` | 503 | The next positions page cannot be served right now. Retry the same cursor shortly. |\n| `api_key_limit_reached` | 403 | The account already holds the maximum number of API keys for its plan. |\n| `wallet_requires_plan` | 402 | A wallet-authenticated key needs an active plan for this request. |\n| `wallet_account_required` | 403 | Wallet sign-in needs an existing account linked to the wallet. |\n| `wallet_free_signup_retired` | 410 | Free wallet sign-up is no longer offered. |\n| `account_disabled` | 403 | The account is disabled. |\n| `oauth_not_permitted` | 403 | This route is not available to OAuth access tokens. |\n| `insufficient_scope` | 403 | The OAuth access token lacks the scope this route requires. |\n\n**Legacy names.** Requests without `0xArchive-Version: 2026-10-01` keep the four names that predate the contract; with the header they receive the contract names instead.\n\n| Code | HTTP | Meaning |\n|---|---|---|\n| `invalid_query_params` | 400 | Legacy name of `invalid_parameter` (query parameter), or of `invalid_cursor` when the parameter is `cursor`, sent without the version header. |\n| `invalid_path_params` | 400 | Legacy name of `invalid_parameter` (path parameter), sent without the version header. |\n| `history_window_exceeded` | 403 | Legacy name of `historical_depth_exceeded`, sent without the version header. |\n| `request_range_exceeded` | 403 | Legacy name of `historical_range_exceeded`, sent without the version header. |\n\nTreat any value not listed here as a generic error of the HTTP status.",
        "enum": [
          "invalid_parameter",
          "invalid_symbol",
          "invalid_interval",
          "invalid_cursor",
          "invalid_time_range",
          "range_before_coverage",
          "historical_range_exceeded",
          "historical_depth_exceeded",
          "unsupported_for_venue",
          "route_not_found",
          "not_found",
          "unauthorized",
          "forbidden",
          "insufficient_credits",
          "rate_limited",
          "conflict",
          "upstream_unavailable",
          "internal_error",
          "endpoint_unsupported",
          "slow_consumer",
          "positions_unavailable",
          "reconstruction_unavailable",
          "snapshot_advanced",
          "pagination_unavailable",
          "api_key_limit_reached",
          "wallet_requires_plan",
          "wallet_account_required",
          "wallet_free_signup_retired",
          "account_disabled",
          "oauth_not_permitted",
          "insufficient_scope",
          "invalid_query_params",
          "invalid_path_params",
          "history_window_exceeded",
          "request_range_exceeded"
        ],
        "example": "invalid_parameter"
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Body of every non-2xx JSON response. `code` repeats the HTTP status, `error_code` is the stable machine-readable code (see `ErrorCode`), `error` is a human-readable message, and `request_id` identifies the request for support. Validation failures add `param` and, where the accepted set is fixed, `valid_values`. A 404 for a datatype the venue does not offer (`unsupported_for_venue`) adds `venue`, `datatype` and `available_on`; any other unknown path answers 404 `route_not_found`.",
        "required": [
          "success",
          "code",
          "error_code",
          "error",
          "request_id"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ],
            "description": "Always `false` on an error."
          },
          "code": {
            "type": "integer",
            "description": "HTTP status code.",
            "example": 400
          },
          "error_code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "error": {
            "type": "string",
            "description": "Human-readable message. Wording can change; do not parse it."
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique request ID for support."
          },
          "param": {
            "type": "string",
            "description": "The parameter that failed validation, when one did.",
            "example": "side"
          },
          "valid_values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Accepted values of `param`, when the set is fixed.",
            "example": [
              "buy",
              "sell"
            ]
          },
          "venue": {
            "type": "string",
            "description": "`unsupported_for_venue` only: the venue the request asked.",
            "example": "spot"
          },
          "datatype": {
            "type": "string",
            "description": "`unsupported_for_venue` only: the datatype the request asked for, as `GET /v1/capabilities` names it.",
            "example": "order_flow"
          },
          "available_on": {
            "type": "array",
            "description": "`unsupported_for_venue` only: the venues and routes that serve the datatype.",
            "items": {
              "type": "object",
              "required": [
                "venue",
                "route"
              ],
              "properties": {
                "venue": {
                  "type": "string",
                  "example": "hyperliquid"
                },
                "route": {
                  "type": "string",
                  "example": "/v1/hyperliquid/orders/{symbol}/flow"
                }
              }
            }
          },
          "credits_used": {
            "type": "integer",
            "format": "int64",
            "description": "`insufficient_credits` only: credits used this period."
          },
          "credits_limit": {
            "type": "integer",
            "format": "int64",
            "description": "`insufficient_credits` only: the period's credit allowance."
          },
          "max_concurrent": {
            "type": "integer",
            "description": "`rate_limited` concurrency refusals only: simultaneous queries the plan allows."
          },
          "suggestion": {
            "type": "object",
            "description": "Present when the symbol exists on another venue: where to request it instead.",
            "properties": {
              "venue": {
                "type": "string",
                "example": "hip3"
              },
              "symbol": {
                "type": "string",
                "example": "xyz:TSLA"
              },
              "endpoint": {
                "type": "string",
                "example": "/v1/hyperliquid/hip3/trades/xyz:TSLA"
              }
            }
          }
        }
      },
      "ResponseMeta": {
        "type": "object",
        "description": "Response metadata. Every 2xx JSON response carries `meta.request_id`; list payloads add `count`; cursor-paged routes add `has_more` and, when another page follows, `next_cursor`; per-symbol routes add `symbol` and `venue`. Fields that do not apply to a route are omitted.",
        "properties": {
          "count": {
            "type": "integer",
            "description": "Number of records returned"
          },
          "has_more": {
            "type": "boolean",
            "description": "Cursor-paged routes: whether another page follows. `next_cursor` is present exactly when this is `true`. A final page can be empty when the previous page was exactly full; `has_more` is `false` on it."
          },
          "next_cursor": {
            "type": "string",
            "description": "Opaque cursor for the next page, present exactly when `has_more` is `true`. Pass it back unchanged as `cursor` with the same filters. Do not parse or construct it."
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique request ID for support"
          },
          "symbol": {
            "type": "string",
            "description": "Per-symbol routes: the canonical public symbol the response describes (for example `BTC`, `xyz:TSLA`, `HYPE-USDC`, `#0`).",
            "example": "BTC"
          },
          "venue": {
            "type": "string",
            "enum": [
              "hyperliquid",
              "hip3",
              "hip4",
              "spot",
              "lighter",
              "rh-lighter"
            ],
            "description": "Per-symbol routes: the venue the response describes.",
            "example": "hyperliquid"
          },
          "coverage_from": {
            "type": "string",
            "format": "date-time",
            "description": "Earliest coverage for the requested symbol and data type. Present only when the requested window ends before coverage begins."
          },
          "notice": {
            "type": "string",
            "description": "Human-readable advisory about the response. Used when the requested window ends before coverage begins for the symbol, and on CVD responses that are one page of several; may carry other advisories in future."
          },
          "finalized_through": {
            "type": "string",
            "format": "date-time",
            "description": "Two-tier datasets (Lighter trades): data at or before this instant is final; later data is preliminary."
          },
          "requested_end": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "The `end` the request asked for, echoed when it was clamped to `finalized_through`."
          },
          "clamped_to": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "The boundary the request's `end` was clamped to, when clamping occurred."
          },
          "preliminary_row_count": {
            "type": "integer",
            "nullable": true,
            "description": "Number of preliminary rows in this response, on routes that intentionally serve preliminary data (Lighter `/recent`)."
          }
        },
        "required": [
          "request_id"
        ]
      },
      "Capability": {
        "type": "object",
        "description": "One venue and datatype the API serves: its REST routes, WebSocket channels, live and replay availability, the first served instant, cadence, page limit and accepted intervals.",
        "required": [
          "venue",
          "datatype",
          "rest_routes",
          "ws_channels",
          "live",
          "replay",
          "available_from",
          "cadence",
          "page_limit",
          "intervals",
          "notes"
        ],
        "properties": {
          "venue": {
            "type": "string",
            "enum": [
              "hyperliquid",
              "hip3",
              "hip4",
              "spot",
              "lighter",
              "rh-lighter"
            ],
            "description": "Venue, as `meta.venue` names it.",
            "example": "hyperliquid"
          },
          "datatype": {
            "type": "string",
            "description": "Datatype identifier, stable across venues (for example `l2_orderbook`, `l2_full_depth`, `l4_diffs`, `l4_orders`, `trades`, `candles`, `funding`, `oi`, `liquidations`, `order_flow`, `positions`). New datatypes can be added; treat unknown values as opaque.",
            "example": "trades"
          },
          "rest_routes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "REST route templates that serve the datatype on this venue.",
            "example": [
              "/v1/hyperliquid/trades/{symbol}"
            ]
          },
          "ws_channels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "WebSocket channels for this venue and datatype. Empty when the datatype is REST only.",
            "example": [
              "trades"
            ]
          },
          "live": {
            "type": "boolean",
            "description": "A WebSocket subscription streams it live.",
            "example": true
          },
          "replay": {
            "type": "boolean",
            "description": "A WebSocket replay serves its history.",
            "example": true
          },
          "available_from": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "First served instant, RFC 3339 UTC with milliseconds. Null where the datatype has no venue-wide floor; `/v1/symbols` gives per-symbol coverage.",
            "example": "2023-04-15T03:31:18.000Z"
          },
          "cadence": {
            "type": "string",
            "enum": [
              "event",
              "snapshot",
              "sample",
              "interval",
              "reference"
            ],
            "description": "`event`: one row per exchange event. `snapshot`: periodic state. `sample`: periodic metric readings. `interval`: buckets of the `interval` parameter. `reference`: catalog data.",
            "example": "event"
          },
          "page_limit": {
            "type": "integer",
            "nullable": true,
            "description": "Largest `limit` one page accepts. Null when the route is not paged.",
            "example": 50000
          },
          "intervals": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Values `interval` accepts. Empty when the datatype has no `interval` parameter.",
            "example": []
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "description": "Venue-specific notes, for example replay behaviour or a policy floor.",
            "example": null
          }
        }
      },
      "ApiResponseCapabilityArray": {
        "type": "object",
        "required": [
          "success",
          "data",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Capability"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        }
      },
      "OutlierEnvelopeKeys": {
        "type": "object",
        "description": "Keys added to the default body of the data quality routes and `/v1/status/coverage`: `success` first and `meta.request_id` last. The rest of the body is unchanged. With `0xArchive-Version: 2026-10-01` the body is the standard envelope instead, with the route's own object under `data`.",
        "required": [
          "success",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "meta": {
            "type": "object",
            "required": [
              "request_id"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid",
                "description": "Unique request ID for support."
              }
            }
          }
        },
        "not": {
          "required": [
            "data"
          ]
        }
      },
      "SymbolsEnvelope": {
        "type": "object",
        "description": "`/v1/symbols` with `0xArchive-Version: 2026-10-01`: the standard envelope, with the symbol entries under `data` and their number in `meta.count`.",
        "required": [
          "success",
          "data",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SymbolEntry"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        }
      },
      "LighterLiquidationVolume": {
        "type": "object",
        "description": "One Lighter liquidation volume bucket. Lighter and Lighter on Robinhood Chain report the total only (no long and short split).",
        "required": [
          "symbol",
          "timestamp",
          "total_usd",
          "count"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "example": "BTC"
          },
          "timestamp": {
            "description": "Bucket start (UTC). By default an integer, Unix milliseconds. With `0xArchive-Version: 2026-10-01` an RFC 3339 UTC string with millisecond precision, and the integer moves to `timestamp_ms`.",
            "oneOf": [
              {
                "type": "integer",
                "format": "int64",
                "description": "Default: Unix milliseconds.",
                "example": 1767225600000
              },
              {
                "type": "string",
                "format": "date-time",
                "description": "Version 2026-10-01: RFC 3339 UTC.",
                "example": "2026-01-01T00:00:00.000Z"
              }
            ]
          },
          "timestamp_ms": {
            "type": "integer",
            "format": "int64",
            "description": "With `0xArchive-Version: 2026-10-01` only: `timestamp` as Unix milliseconds.",
            "example": 1767225600000
          },
          "total_usd": {
            "type": "number",
            "format": "double",
            "description": "Liquidated notional in the bucket, USD.",
            "example": 125000.5
          },
          "count": {
            "type": "integer",
            "format": "int64",
            "description": "Liquidations in the bucket.",
            "example": 12
          }
        }
      },
      "ApiResponseLighterLiquidationVolumeArray": {
        "type": "object",
        "required": [
          "success",
          "data",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LighterLiquidationVolume"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        }
      },
      "WebhookDeliveryEnvelope": {
        "type": "object",
        "description": "Body of a webhook delivery to a `json` endpoint. The same `id` is sent on every retry and redelivery of the event; use it (or the `0xa-event-id` header) to deduplicate. Delivery is at least once.",
        "required": [
          "id",
          "type",
          "schema_version",
          "observed_at",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Event identifier, stable across retries and redeliveries. Equals the `0xa-event-id` header."
          },
          "type": {
            "type": "string",
            "description": "Event type from the catalog. Equals the `0xa-event-type` header.",
            "example": "market.liquidation"
          },
          "schema_version": {
            "type": "integer",
            "description": "Version of the `data` shape for this event type.",
            "example": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the event was detected."
          },
          "late_ms": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "How long after the underlying occurrence the event was detected, in milliseconds. Null when the occurrence carries no timestamp; absent on test, export and some operational events."
          },
          "late": {
            "type": "boolean",
            "description": "True when `late_ms` exceeds ten minutes. Absent where `late_ms` is absent."
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Event payload. Its fields are the metrics the catalog declares for the event type."
          }
        }
      },
      "TwapRecord": {
        "type": "object",
        "description": "One TWAP order status event.",
        "required": [
          "timestamp",
          "block_time",
          "block_number",
          "twap_id",
          "status",
          "coin",
          "user_address",
          "side",
          "size",
          "executed_size",
          "executed_notional",
          "minutes",
          "reduce_only",
          "randomize",
          "started_at"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "When the status event happened (RFC 3339, UTC)."
          },
          "block_time": {
            "type": "string",
            "format": "date-time",
            "description": "Time of the block that carried the event (RFC 3339, UTC)."
          },
          "block_number": {
            "type": "integer",
            "format": "int64",
            "description": "Hyperliquid block number."
          },
          "twap_id": {
            "type": "integer",
            "format": "int64",
            "description": "TWAP order ID. Every event of one TWAP carries the same ID."
          },
          "status": {
            "type": "string",
            "description": "`activated`, `waitingForTrigger`, `finished`, `terminated`, `stopped`, or `error`.",
            "example": "activated"
          },
          "coin": {
            "type": "string",
            "description": "Market symbol.",
            "example": "HYPE"
          },
          "user_address": {
            "type": "string",
            "description": "Wallet that placed the TWAP, lowercase."
          },
          "side": {
            "type": "string",
            "enum": [
              "B",
              "A"
            ],
            "description": "`B` (buy) or `A` (sell)."
          },
          "size": {
            "type": "number",
            "description": "Total TWAP size, in base units."
          },
          "executed_size": {
            "type": "number",
            "description": "Size filled so far, in base units."
          },
          "executed_notional": {
            "type": "number",
            "description": "Notional filled so far, in quote units."
          },
          "minutes": {
            "type": "integer",
            "description": "TWAP duration in minutes."
          },
          "reduce_only": {
            "type": "boolean",
            "description": "True for a reduce-only TWAP."
          },
          "randomize": {
            "type": "boolean",
            "description": "True when slice timing is randomized."
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the TWAP started (RFC 3339, UTC)."
          },
          "trigger_px": {
            "type": "number",
            "description": "Activation trigger price. Omitted for a TWAP without a trigger."
          },
          "trigger_above": {
            "type": "boolean",
            "description": "True when the TWAP activates at or above `trigger_px`. Omitted for a TWAP without a trigger."
          },
          "stop_px": {
            "type": "number",
            "description": "Price bound that ends the TWAP: the highest price for a buy, the lowest for a sell. Omitted when not set."
          }
        }
      },
      "ApiResponseTwapArray": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TwapRecord"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        }
      },
      "WalletProfileMetrics": {
        "type": "object",
        "description": "Behavioral metrics for one wallet. Ratios run from 0 to 1 unless noted; USD values use fill or order price times size.",
        "properties": {
          "total_orders": {
            "type": "integer",
            "description": "Orders placed."
          },
          "cancel_rate": {
            "type": "number",
            "description": "Share of orders canceled."
          },
          "fill_rate": {
            "type": "number",
            "description": "Share of orders filled."
          },
          "order_to_trade_ratio": {
            "type": "number",
            "description": "Orders placed per fill (0 when there are no fills)."
          },
          "ioc_ratio": {
            "type": "number",
            "description": "Share of orders that are immediate-or-cancel."
          },
          "post_only_ratio": {
            "type": "number",
            "description": "Share of orders that are post-only."
          },
          "tpsl_ratio": {
            "type": "number",
            "description": "Share of orders that are position TP/SL orders."
          },
          "trigger_order_ratio": {
            "type": "number",
            "description": "Share of orders that are trigger orders."
          },
          "unique_coins_traded": {
            "type": "integer",
            "description": "Markets with orders."
          },
          "uses_tpsl": {
            "type": "boolean",
            "description": "True when the wallet placed any position TP/SL order."
          },
          "uses_builder": {
            "type": "boolean",
            "description": "True when any order went through a builder."
          },
          "top_builder": {
            "type": "string",
            "description": "Builder address with the most orders. Omitted when no order used a builder."
          },
          "avg_order_size_usd": {
            "type": "number",
            "description": "Average order notional in USD."
          },
          "max_order_size_usd": {
            "type": "number",
            "description": "Largest order notional in USD."
          },
          "median_cancel_speed_ms": {
            "type": "number",
            "description": "Median time from placement to cancel, in milliseconds."
          },
          "active_hours": {
            "type": "integer",
            "description": "Hours with at least one order."
          },
          "total_fills": {
            "type": "integer",
            "description": "Fills."
          },
          "total_volume_usd": {
            "type": "number",
            "description": "Fill volume in USD."
          },
          "maker_ratio": {
            "type": "number",
            "description": "Share of fill volume that was maker volume."
          },
          "long_short_ratio": {
            "type": "number",
            "description": "Buy volume divided by sell volume (0 when there is no sell volume). Not bounded by 1."
          },
          "buy_volume_usd": {
            "type": "number",
            "description": "Buy fill volume in USD."
          },
          "sell_volume_usd": {
            "type": "number",
            "description": "Sell fill volume in USD."
          },
          "total_fees_usd": {
            "type": "number",
            "description": "Fees paid, net of rebates."
          },
          "realized_pnl_usd": {
            "type": "number",
            "description": "Realized PnL from closing fills."
          },
          "liquidation_count": {
            "type": "integer",
            "description": "Fills that were liquidations."
          },
          "max_single_fill_usd": {
            "type": "number",
            "description": "Largest single fill in USD."
          },
          "unique_fill_coins": {
            "type": "integer",
            "description": "Markets with fills."
          },
          "uses_twap": {
            "type": "boolean",
            "description": "True when any fill came from a TWAP."
          },
          "twap_fill_ratio": {
            "type": "number",
            "description": "Share of fills that came from a TWAP."
          },
          "uses_cloid": {
            "type": "boolean",
            "description": "True when any fill carried a client order ID."
          },
          "cloid_ratio": {
            "type": "number",
            "description": "Share of fills that carried a client order ID."
          },
          "uses_priority_gas": {
            "type": "boolean",
            "description": "True when any fill paid priority gas."
          },
          "total_priority_gas_paid": {
            "type": "number",
            "description": "Priority gas paid."
          },
          "total_builder_fees_paid": {
            "type": "number",
            "description": "Builder and deployer fees paid."
          }
        }
      },
      "WalletProfile": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "Wallet address, lowercase."
          },
          "metrics": {
            "$ref": "#/components/schemas/WalletProfileMetrics"
          },
          "period": {
            "type": "string",
            "description": "Lookback window that was applied, for example `24h`.",
            "example": "24h"
          }
        }
      },
      "ApiResponseWalletProfile": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "$ref": "#/components/schemas/WalletProfile"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request: a parameter, symbol, interval, cursor or time range failed validation. See `error_code`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "invalid_parameter": {
                "value": {
                  "success": false,
                  "code": 400,
                  "error_code": "invalid_parameter",
                  "error": "Invalid side 'up'. Use buy or sell.",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05",
                  "param": "side",
                  "valid_values": [
                    "buy",
                    "sell"
                  ]
                }
              },
              "invalid_symbol": {
                "value": {
                  "success": false,
                  "code": 400,
                  "error_code": "invalid_symbol",
                  "error": "The symbol 'ZZZ' does not exist. Please see /v1/hyperliquid/instruments for available symbols.",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05",
                  "param": "symbol"
                }
              },
              "invalid_time_range": {
                "value": {
                  "success": false,
                  "code": 400,
                  "error_code": "invalid_time_range",
                  "error": "start must be <= end",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                }
              },
              "legacy_invalid_query_params": {
                "value": {
                  "success": false,
                  "code": 400,
                  "error_code": "invalid_query_params",
                  "error": "Failed to deserialize query string: limit: invalid digit found in string",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                }
              },
              "current_main": {
                "value": {
                  "code": 400,
                  "error": "Failed to deserialize query string: limit: invalid digit found in string",
                  "error_code": "invalid_query_params",
                  "param": "limit",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05",
                  "success": false
                }
              }
            }
          }
        },
        "headers": {
          "0xArchive-Version": {
            "$ref": "#/components/headers/ApiVersion"
          }
        }
      },
      "Unauthorized": {
        "description": "Authentication required: the API key is missing or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": 401,
              "error_code": "unauthorized",
              "error": "Missing authentication credentials. Provide X-API-Key header or Bearer token.",
              "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
            }
          }
        },
        "headers": {
          "0xArchive-Version": {
            "$ref": "#/components/headers/ApiVersion"
          }
        }
      },
      "Forbidden": {
        "description": "The request is outside the plan's history window or per-request span, or the key is not allowed to make it.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "historical_depth_exceeded": {
                "value": {
                  "success": false,
                  "code": 403,
                  "error_code": "historical_depth_exceeded",
                  "error": "Your plan includes the most recent 30 days of history: this request starts at 2026-01-01T00:00:00Z, before the earliest allowed timestamp 2026-08-30T00:00:00Z. Requests cannot be chunked across the age boundary.",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                }
              },
              "historical_range_exceeded": {
                "value": {
                  "success": false,
                  "code": 403,
                  "error_code": "historical_range_exceeded",
                  "error": "Maximum range is 30 days per request on your plan. Requested range is 45 days.",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                }
              }
            }
          }
        },
        "headers": {
          "0xArchive-Version": {
            "$ref": "#/components/headers/ApiVersion"
          }
        }
      },
      "NotFound": {
        "description": "Not found. `not_found`: the resource id is unknown. `unsupported_for_venue`: the venue does not offer this datatype (`available_on` names where it is served). `route_not_found`: no route matches the path.",
