    "/v1/webhooks/event-types": {
      "get": {
        "tags": [
          "Webhooks - Catalog and Limits"
        ],
        "summary": "List webhook event types",
        "description": "Return the served event catalog: one declaration per event type, carrying its scope, covered venues, accepted filters, tunable parameters, the metrics conditions may be written against, the operator vocabulary for each metric type, and the smallest occurrence the type reports. Subscriptions are validated against these declarations, so this is the authority on what a configuration may contain. Types marked `live: false` are published but do not yet accept subscriptions. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "listWebhookEventTypes",
        "responses": {
          "200": {
            "description": "The served webhook event catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookEventTypeArray"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/limits": {
      "get": {
        "tags": [
          "Webhooks - Catalog and Limits"
        ],
        "summary": "Get webhook plan limits and usage",
        "description": "What this plan allows for webhooks and what is currently in use: endpoints, subscriptions, watched wallets, today's delivery budget and how many subscriptions are paused. Free has no webhook delivery, so `included` is false and every cap is zero. Build allows 1 endpoint, 8 subscriptions, 2 watched wallets and 5,000 deliveries a day; Pro allows 4, 40, 15 and 50,000; Scale allows 12, 200, 50 and 500,000; Enterprise allows 100, 2,000, 250 and deliveries without a daily ceiling. The estimate and the dry-run stay available on every plan, so `preview_included` is always true. The delivery budget resets on its own and a paused subscription does not, which is why the paused count is reported here next to it. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "getWebhookLimits",
        "responses": {
          "200": {
            "description": "Webhook plan limits and current usage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookLimits"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/endpoints": {
      "get": {
        "tags": [
          "Webhooks - Endpoints"
        ],
        "summary": "List webhook endpoints",
        "description": "Your delivery destinations, oldest first. The signing secret is never returned here: it is shown once when an endpoint is created and again when it is rotated. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "listWebhookEndpoints",
        "responses": {
          "200": {
            "description": "Your webhook delivery endpoints",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookEndpointArray"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "tags": [
          "Webhooks - Endpoints"
        ],
        "summary": "Create a webhook endpoint",
        "description": "Register an HTTPS destination and get its signing secret. The secret is returned in this response and in a rotation, and nowhere else, so store it now. Destinations that resolve to a private or internal address are refused, at creation and again on every delivery. A plan without webhook delivery, or one already at its endpoint cap, is refused with the reason and the way forward. Authenticate with an API key or a signed-in dashboard session. Costs no credits. Deliveries are signed with the secret in the `0xa-signature` header (see the `delivery` callback).",
        "operationId": "createWebhookEndpoint",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEndpointCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The new endpoint and its signing secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookEndpointCreated"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "callbacks": {
          "delivery": {
            "{$request.body#/url}": {
              "post": {
                "summary": "Webhook delivery",
                "description": "How 0xArchive delivers an event to a `json`, `discord` or `slack` endpoint. Any 2xx response acknowledges it. Redirects are not followed. Each attempt times out after 10 seconds. A failed delivery is retried after 5 s, 30 s, 2 min, 10 min, 1 h and then hourly, for up to 24 hours; a `Retry-After` header on a non-2xx response (1 to 300 seconds) replaces the next step. After at least 10 consecutive failures spanning six hours the endpoint is `auto_disabled`. Telegram endpoints receive a chat message instead, without these headers.",
                "operationId": "receiveWebhookDelivery",
                "parameters": [
                  {
                    "name": "0xa-signature",
                    "in": "header",
                    "required": true,
                    "description": "Signature of the delivery, in the form `t=<unix seconds>,v1=<hex>`. `v1` is the lowercase hex HMAC-SHA256 of the string `<t>.<raw body>`, keyed with the endpoint's signing secret (the full `whsec_...` string as UTF-8 bytes). Verify over the raw request bytes before parsing them. For 24 hours after a secret rotation the header carries two `v1` values, `t=<t>,v1=<new secret>,v1=<previous secret>`; accept the delivery when either matches. `t` is set on each attempt, so compare it with your clock to reject replays.",
                    "schema": {
                      "type": "string",
                      "example": "t=1767225600,v1=5257a869e7ecebeda32affa62cdca3fa51cad7e77a0e56ff536d0ce8e108d8bd"
                    }
                  },
                  {
                    "name": "0xa-event-id",
                    "in": "header",
                    "required": true,
                    "description": "Event identifier; equals the body `id` and is stable across retries.",
                    "schema": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  {
                    "name": "0xa-event-type",
                    "in": "header",
                    "required": true,
                    "description": "Event type; equals the body `type`.",
                    "schema": {
                      "type": "string",
                      "example": "market.liquidation"
                    }
                  },
                  {
                    "name": "User-Agent",
                    "in": "header",
                    "required": false,
                    "description": "`0xArchive-Webhooks/1.0`.",
                    "schema": {
                      "type": "string"
                    }
                  }
                ],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/WebhookDeliveryEnvelope"
                      }
                    }
                  }
                },
                "responses": {
                  "2XX": {
                    "description": "Delivered. The response body is ignored."
                  },
                  "default": {
                    "description": "Not delivered; the event is retried on the schedule above."
                  }
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/endpoints/{id}": {
      "delete": {
        "tags": [
          "Webhooks - Endpoints"
        ],
        "summary": "Delete a webhook endpoint",
        "description": "Remove a delivery destination and every subscription pointing at it. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "deleteWebhookEndpoint",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Endpoint identifier.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
            },
            "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
          }
        ],
        "responses": {
          "200": {
            "description": "The endpoint was deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookAck"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/endpoints/{id}/rotate": {
      "post": {
        "tags": [
          "Webhooks - Endpoints"
        ],
        "summary": "Rotate a webhook endpoint secret",
        "description": "Issue a new signing secret for the endpoint and return it. The previous secret keeps verifying for 24 hours, so a receiver can accept both while it rolls over. This and endpoint creation are the only responses that carry a secret. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "rotateWebhookEndpointSecret",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Endpoint identifier.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
            },
            "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
          }
        ],
        "responses": {
          "200": {
            "description": "The new signing secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookEndpointSecret"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/endpoints/{id}/enable": {
      "post": {
        "tags": [
          "Webhooks - Endpoints"
        ],
        "summary": "Enable a webhook endpoint",
        "description": "Put an endpoint back into service after you switched it off, or after a long run of failed deliveries switched it off for you. Deliveries resume on the next matching event; nothing that happened while it was off is replayed. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "enableWebhookEndpoint",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Endpoint identifier.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
            },
            "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
          }
        ],
        "responses": {
          "200": {
            "description": "The endpoint is active again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookAck"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/endpoints/{id}/test": {
      "post": {
        "tags": [
          "Webhooks - Endpoints"
        ],
        "summary": "Send a test delivery",
        "description": "Queue a `webhook.test` event to the endpoint so you can confirm your receiver and your signature verification work end to end. The delivery appears in the endpoint's delivery log like any other. It is a real signed delivery, so it is priced like one: it counts against today's delivery budget, and it is refused on a plan without webhook delivery or once that budget is spent. A refusal here never pauses a subscription. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "testWebhookEndpoint",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Endpoint identifier.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
            },
            "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
          }
        ],
        "responses": {
          "200": {
            "description": "The test delivery was queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookDeliveryQueued"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Today's delivery budget is already spent, so the test event was not queued. Send it after the budget resets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "code": 409,
                  "error_code": "conflict",
                  "error": "The account is at today's limit of 5000 webhook deliveries. A test event counts against that limit, so it would not be sent. The daily allowance resets at 2026-09-21 00:00 UTC.",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/endpoints/{id}/deliveries": {
      "get": {
        "tags": [
          "Webhooks - Deliveries"
        ],
        "summary": "List deliveries for an endpoint",
        "description": "The endpoint's delivery log, newest first, with the event payload as sent, the attempt count, the status your receiver returned and the timing of the last attempt. One event and one endpoint share a single record for their whole life, so a repeat delivery rewrites that record rather than adding another. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "listWebhookDeliveries",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Endpoint identifier.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
            },
            "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Deliveries to return, newest first. Values outside the range are clamped to it.",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 50,
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The endpoint's delivery log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookDeliveryArray"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/deliveries/{id}/redeliver": {
      "post": {
        "tags": [
          "Webhooks - Deliveries"
        ],
        "summary": "Send a past delivery again",
        "description": "Queue a delivery that has already been attempted for another attempt. The delivery and event identifiers are unchanged, so a receiver that already processed the event can deduplicate on the event identifier. The record is reset in place: the retry window and the attempt counter start again from now, and the previous attempt's status, error and timing are cleared, so the log entry then describes the repeat rather than the original failure. If the delivery's endpoint is switched off the request is refused rather than queued, because nothing would be sent. A repeat delivery is a real signed delivery, so it counts against today's delivery budget, and it is refused on a plan without webhook delivery or once that budget is spent. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "redeliverWebhookDelivery",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Delivery identifier.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
            },
            "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
          }
        ],
        "responses": {
          "200": {
            "description": "The delivery was queued for another attempt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookRedelivery"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "Nothing was queued, either because the delivery's endpoint is switched off or because today's delivery budget is already spent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "endpointSwitchedOff": {
                    "summary": "The delivery's endpoint is switched off, so nothing would be sent",
                    "value": {
                      "success": false,
                      "code": 409,
                      "error_code": "conflict",
                      "error": "This delivery's endpoint is disabled, so nothing would be sent. Re-enable it with POST /v1/webhooks/endpoints/3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10/enable, then redeliver.",
                      "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                    }
                  },
                  "budgetSpent": {
                    "summary": "Today's delivery budget is already spent",
                    "value": {
                      "success": false,
                      "code": 409,
                      "error_code": "conflict",
                      "error": "The account is at today's limit of 5000 webhook deliveries. This redelivery counts against that limit, so it would not be sent. The daily allowance resets at 2026-09-21 00:00 UTC.",
                      "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                    }
                  }
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/subscriptions": {
      "get": {
        "tags": [
          "Webhooks - Subscriptions"
        ],
        "summary": "List webhook subscriptions",
        "description": "Your rules across every endpoint, with their configuration and their pause state. A paused rule also carries `pause_message`, which says why it is paused and what clears it. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "listWebhookSubscriptions",
        "responses": {
          "200": {
            "description": "Your webhook subscriptions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookSubscriptionArray"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "tags": [
          "Webhooks - Subscriptions"
        ],
        "summary": "Create a webhook subscription",
        "description": "Subscribe an endpoint to an event type. The configuration is checked against the event type's catalog declaration before anything is stored, so an unknown key, an undeclared parameter, an out of range value or a condition on a metric the event does not carry is refused rather than quietly dropped. The endpoint must be one of yours. Addresses used in the configuration must already be on your watched list. A plan without webhook delivery, or one already at its subscription cap, is refused with the reason and the way forward. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "createWebhookSubscription",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookSubscriptionCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The new subscription",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookSubscription"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/subscriptions/dry-run": {
      "post": {
        "tags": [
          "Webhooks - Previews"
        ],
        "summary": "Dry-run a webhook subscription",
        "description": "Which occurrences in the last `lookback_s` seconds would this configuration have delivered? The configuration is validated and normalised exactly as a create, then evaluated against recent history. Nothing is stored and no delivery is sent. Available for `account.fill`, `account.transfer` and `market.liquidation`; another type is refused with the list of the ones that work. An address scoped type needs at least one watched wallet to report on. Authenticate with an API key or a signed-in dashboard session. Available on every plan, including Free, and metered like the market data it returns. At most six estimates and dry-runs a minute per account, shared between the two.",
        "operationId": "dryRunWebhookSubscription",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookDryRunRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Occurrences the configuration would have delivered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookDryRun"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "description": "The dry-run could not be produced right now. Retry shortly.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before retrying."
              },
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "code": 503,
                  "error_code": "upstream_unavailable",
                  "error": "dry-run is temporarily unavailable",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                }
              }
            }
          },
          "504": {
            "description": "The scan ran out of time before it could answer. Narrow the window or the configuration and try again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "code": 504,
                  "error_code": "upstream_unavailable",
                  "error": "dry-run timed out before it could scan the whole window; try a shorter lookback_s",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/subscriptions/estimate": {
      "post": {
        "tags": [
          "Webhooks - Previews"
        ],
        "summary": "Estimate a webhook subscription",
        "description": "How often would this configuration have fired over the last `lookback_days`? Returns the total, a count per day of the window, the median and busiest day, the distribution of the event's primary metric, a ladder of what the daily rate would be at other thresholds, and a sample of real matches, so a threshold can be chosen against history rather than guessed. The configuration is validated and normalised exactly as a create. Nothing is stored and no delivery is sent. Available for `account.fill`, `account.transfer`, `account.liquidated`, `market.liquidation`, `market.pga_payment`, `hip4.settlement`, `market.liquidation_burst`, `market.oi_delta`, `oracle.jump` and `market.funding_flip`; another type is refused with the list of the ones that work. An address scoped type needs at least one watched wallet to report on. Authenticate with an API key or a signed-in dashboard session. Available on every plan, including Free, and metered like the market data it returns. At most six estimates and dry-runs a minute per account, shared between the two.",
        "operationId": "estimateWebhookSubscription",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEstimateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "How often the configuration would have fired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookEstimate"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "description": "The estimate could not be produced right now. Retry shortly.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before retrying."
              },
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "code": 503,
                  "error_code": "upstream_unavailable",
                  "error": "estimate is temporarily unavailable",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/subscriptions/resume": {
      "post": {
        "tags": [
          "Webhooks - Subscriptions"
        ],
        "summary": "Resume every paused subscription",
        "description": "Put every paused rule on the account back into service in one call. The daily delivery limit is counted per account while the pause is written per rule, so one busy rule can pause all of them; this is how an account comes back without a call per rule. Nothing is buffered while a rule is paused, so the response hands back the window that was missed instead of replaying it. If nothing is paused, nothing changes and the response says so. If resuming would be undone within seconds, because the plan has no webhook delivery or today's budget is already spent, the request is refused with the reason rather than granted and reversed. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "resumeAllWebhookSubscriptions",
        "responses": {
          "200": {
            "description": "The rules that were put back into service, and the window they missed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseWebhookSubscriptionResumeAll"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Today's delivery budget is already spent, so the rules would pause again immediately. Resume after the budget resets.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "code": 409,
                  "error_code": "conflict",
                  "error": "You are still at today's delivery limit. These rules would pause again immediately. Resume after 2026-09-21 00:00 UTC.",
                  "request_id": "3f2a9c71-5b0e-4d68-9a4c-7e1d2b6f8a05"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/webhooks/subscriptions/{id}": {
      "patch": {
        "tags": [
          "Webhooks - Subscriptions"
        ],
        "summary": "Update a webhook subscription",
        "description": "Edit a rule in place. A configuration you send replaces the stored one and is validated exactly as it was at create; `enabled` switches the rule on or off without touching its configuration. A field you leave out is left alone. Authenticate with an API key or a signed-in dashboard session. Costs no credits.",
        "operationId": "updateWebhookSubscription",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Subscription identifier.",
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
            },
            "example": "3c1f0a52-8d6b-4f0e-9b1a-6f2c4d8e9a10"
          }
        ],
