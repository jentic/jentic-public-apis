        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/v1/hyperliquid/hip3/orders/{symbol}/flow": {
      "get": {
        "tags": [
          "HIP-3 Builder Perps - Orders"
        ],
        "summary": "Get HIP-3 order flow",
        "description": "Get order flow aggregation for a HIP-3 symbol, in buckets of `interval` (1m by default). Shows order placement and cancellation rates over time.\n\n**Buckets:** each bucket is labelled by its open time in UTC, and buckets open on multiples of the bucket width since the Unix epoch. A bucket with no order events is omitted. A bucket counts only the events inside `[start, end)`, so when `start` or `end` falls inside a bucket, that first or last bucket is partial; `start` and `end` on bucket opens give whole buckets.\n\n**Pagination:** results are oldest first. When `meta.has_more` is `true`, pass the string `meta.next_cursor` unchanged as `cursor` with the same filters to get the next page. Stop when `meta.has_more` is `false`.",
        "operationId": "getHip3OrderFlow",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "description": "HIP-3 symbol (case-sensitive, e.g., hyna:BTC, km:US500)",
            "schema": {
              "type": "string",
              "example": "hyna:BTC"
            },
            "example": "km:US500"
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp, inclusive (default: 24 hours before now). Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            },
            "example": 1767225600000
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp, exclusive (default: now). Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            },
            "example": 1767225600000
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Pagination cursor: use the string `meta.next_cursor` returned when `meta.has_more` is `true`, passed back unchanged with the same filters. Do not parse or construct it. Stop when `meta.has_more` is `false`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of buckets, oldest first (default: 1000, max: 10000)",
            "schema": {
              "type": "integer",
              "default": 1000,
              "maximum": 10000
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "description": "Bucket width: `1m` (default), `5m`, `15m` or `1h`. Case-sensitive. Any other value answers 400.",
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "15m",
                "1h"
              ],
              "default": "1m"
            }
          },
          {
            "name": "granularity",
            "in": "query",
            "description": "Deprecated alias of `interval`. `interval` wins when both are sent.",
            "schema": {
              "type": "string",
              "enum": [
                "1m",
                "5m",
                "15m",
                "1h"
              ],
              "default": "1m"
            },
            "deprecated": true
          }
        ],
        "responses": {
          "200": {
            "description": "Order flow aggregation data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        },
                        "next_cursor": {
                          "type": "string"
                        },
                        "request_id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
