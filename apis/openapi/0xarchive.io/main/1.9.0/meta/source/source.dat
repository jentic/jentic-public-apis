    "/v1/hyperliquid/hip3/orderbook/{symbol}/l2/history": {
      "get": {
        "tags": [
          "HIP-3 Builder Perps - Full-Depth L2 Order Book"
        ],
        "summary": "Get HIP-3 full-depth L2 order book history",
        "description": "Get paginated full-depth L2 checkpoint snapshots derived from L4 data for HIP-3 from March 11, 2026 01:03 UTC onward. The route returns full checkpoint depth; it does not currently accept a per-request depth override.",
        "operationId": "getHip3FullDepthL2History",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "description": "HIP-3 symbol (case-sensitive, e.g., hyna:BTC, km:US500)",
            "schema": {
              "type": "string",
              "example": "km:US500"
            },
            "example": "km:US500"
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp. Defaults to 24h ago. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            },
            "example": 1767225600000
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp. Defaults to now. Accepts Unix milliseconds or an RFC 3339 UTC string such as `2026-01-01T00:00:00Z`.",
            "schema": {
              "$ref": "#/components/schemas/TimeInput"
            },
            "example": 1767229200000
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor: pass `meta.next_cursor` from the previous page unchanged, with the same filters. Omit it for the first page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of checkpoint snapshots (default: 100, max: 100).",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 100,
              "minimum": 1
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Price levels per side in each snapshot, capped by the plan's order book depth. Omit it for the plan's depth. `bid_levels` and `ask_levels` still report the book's own level counts.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full-depth L2 checkpoint snapshots",
