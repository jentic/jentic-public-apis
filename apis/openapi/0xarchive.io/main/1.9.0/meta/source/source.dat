              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseHip4OutcomeAggregateArray"
                }
              }
            },
            "headers": {
              "0xArchive-Version": {
                "$ref": "#/components/headers/ApiVersion"
              }
