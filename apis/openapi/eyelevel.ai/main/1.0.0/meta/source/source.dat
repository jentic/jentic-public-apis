{"openapi":"3.1.0","info":{"title":"API Reference","version":"1.0.0"},"paths":{"/v1/ingest/documents/local":{"post":{"operationId":"documents_ingestLocal","summary":"ingest - Local Documents","description":"Upload documents hosted on a local file system into a GroundX bucket.\n\n[Supported Document Types and Ingest Capacities](https://docs.eyelevel.ai/documentation/fundamentals/document-types-and-ingest-capacities)\n","tags":["Documents"],"responses":{"200":{"description":"Documents successfully uploaded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IngestResponse"}}}},"400":{"description":"Invalid document type or source URL","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to update bucket with ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"403":{"description":"File access is disabled or the request is forbidden","content":{"application/json":{"schema":{"description":"Any type"}}}},"404":{"description":"Owned resource not found","content":{"application/json":{"schema":{"description":"Any type"}}}},"409":{"description":"Source ownership or reservation conflict","content":{"application/json":{"schema":{"description":"Any type"}}}},"503":{"description":"File access is enabled but temporarily unavailable. Retry after the delay in Retry-After.","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentLocalIngestRequest"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/ingest/documents/remote":{"post":{"operationId":"documents_ingestRemote","summary":"ingest - Remote Documents","description":"Ingest documents hosted on public URLs into a GroundX bucket.\n\n[Supported Document Types and Ingest Capacities](https://docs.eyelevel.ai/documentation/fundamentals/document-types-and-ingest-capacities)\n","tags":["Documents"],"responses":{"200":{"description":"Documents successfully uploaded","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IngestResponse"}}}},"400":{"description":"Invalid document type or source URL","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to update bucket with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"403":{"description":"File access is disabled or the request is forbidden","content":{"application/json":{"schema":{"description":"Any type"}}}},"503":{"description":"File access is enabled but temporarily unavailable. Retry after the delay in Retry-After.","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentRemoteIngestRequest"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/ingest/documents":{"put":{"operationId":"documents_update","summary":"update","description":"Update the attributes of documents that have been uploaded to GroundX.\nPolicy-bearing updates return 403 when file access is disabled; enabled\ntemporary failures return 503 with Retry-After.\n","tags":["Documents"],"responses":{"200":{"description":"Documents successfully submitted for updates","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IngestResponse"}}}},"400":{"description":"Invalid request type","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to update bucket with ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"403":{"description":"File access is disabled or the request is forbidden","content":{"application/json":{"schema":{"description":"Any type"}}}},"404":{"description":"Owned resource not found","content":{"application/json":{"schema":{"description":"Any type"}}}},"409":{"description":"Revision or ownership conflict","content":{"application/json":{"schema":{"description":"Any type"}}}},"503":{"description":"File access is enabled but temporarily unavailable. Retry after the delay in Retry-After.","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentUpdateRequest"}}}},"security":[{"ApiKeyAuth":[]}]},"get":{"operationId":"documents_list","summary":"list","description":"lookup all documents across all resources which are currently on GroundX\n","tags":["Documents"],"parameters":[{"name":"n","in":"query","description":"The maximum number of returned documents. Accepts 1-100 with a default of 20.","required":false,"schema":{"type":"integer"}},{"name":"filter","in":"query","description":"Return only documents whose names contain this string.","required":false,"schema":{"type":"string"}},{"name":"sort","in":"query","description":"The document attribute that will be used to sort the results.","required":false,"schema":{"$ref":"#/components/schemas/Sort"}},{"name":"sortOrder","in":"query","description":"Sort order. Requires sort.","required":false,"schema":{"$ref":"#/components/schemas/SortOrder"}},{"name":"status","in":"query","description":"Return only documents with this status.","required":false,"schema":{"$ref":"#/components/schemas/ProcessingStatus"}},{"name":"nextToken","in":"query","description":"Pass nextToken from the previous response to get the next page of up to n documents.","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Lookup successful","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentListResponse"}}}}},"security":[{"ApiKeyAuth":[]}]},"delete":{"operationId":"documents_delete","summary":"delete (multiple)","description":"Delete multiple documents hosted on GroundX\n","tags":["Documents"],"parameters":[{"name":"documentIds","in":"query","description":"A list of documentIds which correspond to documents ingested by GroundX","required":true,"schema":{"type":"array","items":{"type":"string","format":"uuid"}}}],"responses":{"200":{"description":"Documents are queued to be deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IngestResponse"}}}},"400":{"description":"Invalid document ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to delete document with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/ingest/copy":{"post":{"operationId":"documents_copy","summary":"copy","description":"Copy documents from one bucket to another.","tags":["Documents"],"responses":{"200":{"description":"Copy request successfully submitted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IngestResponse"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentCopyRequest"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/ingest/document/xray/{documentId}":{"get":{"operationId":"documents_getXray","summary":"get_xray","description":"Look up X-Ray data for an existing document by documentId.\n","tags":["Documents"],"parameters":[{"name":"documentId","in":"path","description":"The documentId of the document for which GroundX created an X-Ray.","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Lookup successful","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentXray"}}}},"400":{"description":"Invalid document ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to access document with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/ingest/document/extract/{documentId}":{"get":{"operationId":"documents_getExtract","summary":"get_extract","description":"Look up extractions for an existing document by documentId.\n","tags":["Documents"],"parameters":[{"name":"documentId","in":"path","description":"The documentId of the document for which GroundX extract has extracted information.","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Lookup successful","content":{"application/json":{"schema":{"$ref":"#/components/schemas/documents_getExtract_Response_200"}}}},"400":{"description":"Invalid document ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to access document with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/ingest/document/{documentId}/file-link":{"post":{"operationId":"documents_fileLink","summary":"fileLink","description":"Create a storage-signed download link for a saved asset you own. Anyone with the link can use or forward it until expiresAt. Revoking an API key or changing policy does not cancel issued links. The URL contains no GroundX API key. Returns 404 if file access is disabled, or 503 with Retry-After for temporary file-access failures.","tags":["Documents"],"parameters":[{"name":"documentId","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Private, no-store response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileLinkResponse"}}}},"400":{"description":"Invalid body, revision, selector or expiry","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"description":"Any type"}}}},"403":{"description":"Forbidden","content":{"application/json":{"schema":{"description":"Any type"}}}},"404":{"description":"File access is disabled, or the owned resource or saved asset was not found","content":{"application/json":{"schema":{"description":"Any type"}}}},"409":{"description":"Revision or ownership conflict","content":{"application/json":{"schema":{"description":"Any type"}}}},"503":{"description":"File access is enabled but temporarily unavailable. Retry after the delay in Retry-After.","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileLinkRequest"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/ingest/document/{documentId}/retry":{"post":{"operationId":"documents_retryFailedStage","summary":"retry_failed_stage","description":"Retry a failed HTTP callback using its saved output and settings. No request body is needed. Post-processing and manual retries must be enabled. Active or successfully delivered documents and other failed stages return 409. A 202 response confirms acceptance; get the document to check deliveryStatus. An earlier unconfirmed delivery may already have reached the receiver.","tags":["Documents"],"parameters":[{"name":"documentId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"202":{"description":"Retry request accepted; read the document to check deliveryStatus","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RetryFailedStageResponse"}}}},"400":{"description":"Invalid document ID or retry request","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Missing credentials or insufficient document permissions","content":{"application/json":{"schema":{"description":"Any type"}}}},"409":{"description":"Document is active, successfully delivered, or otherwise ineligible, or saved output is unavailable","content":{"application/json":{"schema":{"description":"Any type"}}}},"503":{"description":"Post-processing or manual retries are unavailable, or the retry request could not be accepted","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/ingest/{processId}":{"delete":{"operationId":"documents_cancelProcess","summary":"cancel_process","description":"Cancel an ingest process, along with any files that have not been completely ingested.\n","tags":["Documents"],"parameters":[{"name":"processId","in":"path","description":"the processId for the ingest process to be cancelled","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Cancel success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IngestResponse"}}}},"400":{"description":"Invalid process ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to access process with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]},"get":{"operationId":"documents_getProcessingStatusById","summary":"get_processing_status_by_id","description":"Get the current status of an ingest, initiated with documents.ingest_remote, documents.ingest_local, or documents.crawl_website, by specifying the processId (the processId is included in the response of the documents.ingest functions).\n","tags":["Documents"],"parameters":[{"name":"processId","in":"path","description":"the processId for the ingest process being checked","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Lookup successful","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IngestResponse"}}}},"400":{"description":"Invalid process ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to access process with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/ingest/documents/website":{"post":{"operationId":"documents_crawlWebsite","summary":"crawl_website","description":"Ingest a public website by following links from a starting URL, up to the requested depth or page limit. The source_url must start with http:// or https://. Website crawling is not supported on-prem. [Supported Document Types and Ingest Capacities](https://docs.eyelevel.ai/documentation/fundamentals/document-types-and-ingest-capacities)","tags":["Documents"],"responses":{"200":{"description":"Website successfully queued","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IngestResponse"}}}},"400":{"description":"Invalid source URL","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to update bucket with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"403":{"description":"File access is disabled or the request is forbidden","content":{"application/json":{"schema":{"description":"Any type"}}}},"503":{"description":"File access is enabled but temporarily unavailable. Retry after the delay in Retry-After.","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebsiteCrawlRequest"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/ingest/document/{documentId}":{"get":{"operationId":"documents_get","summary":"get","description":"Look up an existing document by documentId.\n","tags":["Documents"],"parameters":[{"name":"documentId","in":"path","description":"The documentId of the document for which GroundX information will be provided.","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Lookup successful","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentResponse"}}}},"400":{"description":"Invalid document ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to access document with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]},"delete":{"operationId":"documents_deleteById","summary":"delete (singular)","description":"Delete a single document hosted on GroundX\n","tags":["Documents"],"parameters":[{"name":"documentId","in":"path","description":"A documentId which correspond to a document ingested by GroundX","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Document successfully deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/IngestResponse"}}}},"400":{"description":"Invalid document ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to delete document with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/ingest/documents/{id}":{"get":{"operationId":"documents_lookup","summary":"lookup","description":"lookup the document(s) associated with a processId, bucketId, or groupId.\n","tags":["Documents"],"parameters":[{"name":"id","in":"path","description":"a processId, bucketId, or groupId","required":true,"schema":{"type":"integer"}},{"name":"n","in":"query","description":"The maximum number of returned documents. Accepts 1-100 with a default of 20.","required":false,"schema":{"type":"integer"}},{"name":"filter","in":"query","description":"Return only documents whose names contain this string.","required":false,"schema":{"type":"string"}},{"name":"sort","in":"query","description":"The document attribute that will be used to sort the results.","required":false,"schema":{"$ref":"#/components/schemas/Sort"}},{"name":"sortOrder","in":"query","description":"Sort order. Requires sort.","required":false,"schema":{"$ref":"#/components/schemas/SortOrder"}},{"name":"status","in":"query","description":"Return only documents with this status.","required":false,"schema":{"$ref":"#/components/schemas/ProcessingStatus"}},{"name":"nextToken","in":"query","description":"Pass nextToken from the previous response to get the next page of up to n documents.","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Lookup successful","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocumentLookupResponse"}}}},"400":{"description":"Invalid process, bucket, or group ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to access process, bucket, or group with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/ingest":{"get":{"operationId":"documents_getProcesses","summary":"get_processes","description":"Get a list of ingest process requests, sorted from most recent to least.\n","tags":["Documents"],"parameters":[{"name":"n","in":"query","description":"The maximum number of returned processes. Accepts 1-100 with a default of 20.","required":false,"schema":{"type":"integer"}},{"name":"status","in":"query","description":"Return only processes with this status.","required":false,"schema":{"$ref":"#/components/schemas/ProcessingStatus"}}],"responses":{"200":{"description":"Lookup successful","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProcessesStatusResponse"}}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/search/{id}":{"post":{"operationId":"search_content","summary":"search.content","description":"Search a bucket, group or document for information relevant to a query. Use result.search.text as context for a language model and result.search.results for matching text and citations.","tags":["Search"],"parameters":[{"name":"id","in":"path","description":"The bucketId, groupId, or documentId to be searched. The document or documents within the specified container will be compared to the query, and relevant information will be extracted.","required":true,"schema":{"$ref":"#/components/schemas/V1SearchIdPostParametersId"}},{"name":"n","in":"query","description":"The maximum number of returned search results. Accepts 1-100 with a default of 20.","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"nextToken","in":"query","description":"Pass nextToken from the previous response to get the next page of up to n search results.","required":false,"schema":{"type":"string"}},{"name":"verbosity","in":"query","description":"Response detail: 0 returns only recommended context; 1 adds search results without searchData; 2 includes searchData.","required":false,"schema":{"type":"integer","minimum":0,"maximum":2}}],"responses":{"200":{"description":"Search query success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchResponse"}}}},"400":{"description":"Invalid request data","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to access resource with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchRequest"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/search/documents":{"post":{"operationId":"search_documents","summary":"search.documents","description":"Search the specified document IDs for information relevant to a query. Use result.search.text as context for a language model and result.search.results for matching text and citations.","tags":["Search"],"parameters":[{"name":"n","in":"query","description":"The maximum number of returned search results. Accepts 1-100 with a default of 20.","required":false,"schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"nextToken","in":"query","description":"Pass nextToken from the previous response to get the next page of up to n search results.","required":false,"schema":{"type":"string"}},{"name":"verbosity","in":"query","description":"Response detail: 0 returns only recommended context; 1 adds search results without searchData; 2 includes searchData.","required":false,"schema":{"type":"integer","minimum":0,"maximum":2}}],"responses":{"200":{"description":"Search query success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchResponse"}}}},"400":{"description":"Invalid request data","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to access resource with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchDocumentsRequest"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/bucket":{"get":{"operationId":"buckets_list","summary":"list","description":"List all buckets within your GroundX account\n","tags":["Buckets"],"parameters":[{"name":"n","in":"query","description":"The maximum number of returned buckets. Accepts 1-100 with a default of 20.","required":false,"schema":{"type":"integer"}},{"name":"nextToken","in":"query","description":"Pass nextToken from the previous response to get the next page of up to n buckets.","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Lookup successful","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BucketListResponse"}}}}},"security":[{"ApiKeyAuth":[]}]},"post":{"operationId":"buckets_create","summary":"create","description":"Create a new bucket.\n","tags":["Buckets"],"responses":{"200":{"description":"Bucket successfully created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BucketResponse"}}}},"400":{"description":"Invalid body parameter","content":{"application/json":{"schema":{"description":"Any type"}}}},"403":{"description":"File access is disabled or the request is forbidden","content":{"application/json":{"schema":{"description":"Any type"}}}},"404":{"description":"Owned resource not found","content":{"application/json":{"schema":{"description":"Any type"}}}},"503":{"description":"File access is enabled but temporarily unavailable. Retry after the delay in Retry-After.","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BucketCreateRequest"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/bucket/{bucketId}":{"get":{"operationId":"buckets_get","summary":"get","description":"Look up a specific bucket by its bucketId.\n","tags":["Buckets"],"parameters":[{"name":"bucketId","in":"path","description":"The bucketId of the bucket to look up.","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"Lookup successful","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BucketResponse"}}}},"400":{"description":"Invalid bucket ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to access bucket with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]},"put":{"operationId":"buckets_update","summary":"update","description":"Rename a bucket or replace its file-access policy. Policy-bearing updates return 403 when file access is disabled; enabled temporary failures return 503 with Retry-After.\n","tags":["Buckets"],"parameters":[{"name":"bucketId","in":"path","description":"The bucketId of the bucket being updated.","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"Bucket successfully updated","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BucketUpdateResponse"}}}},"400":{"description":"Invalid body parameter","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to update bucket with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"403":{"description":"File access is disabled or the request is forbidden","content":{"application/json":{"schema":{"description":"Any type"}}}},"404":{"description":"Owned resource not found","content":{"application/json":{"schema":{"description":"Any type"}}}},"409":{"description":"Revision or ownership conflict","content":{"application/json":{"schema":{"description":"Any type"}}}},"503":{"description":"File access is enabled but temporarily unavailable. Retry after the delay in Retry-After.","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BucketUpdateRequest"}}}},"security":[{"ApiKeyAuth":[]}]},"delete":{"operationId":"buckets_delete","summary":"delete","description":"Delete a bucket.\n","tags":["Buckets"],"parameters":[{"name":"bucketId","in":"path","description":"The bucketId of the bucket being deleted.","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"Bucket successfully deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MessageResponse"}}}},"400":{"description":"Invalid bucket ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to delete bucket with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/bucket/{bucketId}/file-upload":{"post":{"operationId":"buckets_fileUpload","summary":"fileUpload","description":"Return a storage-signed PUT link for a public or protected bucket, valid for at most 900 seconds. Complete PUT before it expires. A private upload reservation also requires ingest submission before that deadline; an unreserved public source remains ingestible after PUT expiry. Available even when file-access protection is disabled. Uses this deployment and its configured storage. Include the requested per-file fileAccess policy so it is checked before upload; non-null policies return 403 when protection is disabled. Returns 503 with Retry-After for temporary verification failures.","tags":["Buckets"],"parameters":[{"name":"bucketId","in":"path","required":true,"schema":{"type":"integer"}}],"responses":{"201":{"description":"Private, no-store response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileUploadResponse"}}}},"400":{"description":"Invalid body, revision, selector or expiry","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"description":"Any type"}}}},"403":{"description":"Forbidden","content":{"application/json":{"schema":{"description":"Any type"}}}},"404":{"description":"The owned bucket was not found","content":{"application/json":{"schema":{"description":"Any type"}}}},"409":{"description":"Revision or ownership conflict","content":{"application/json":{"schema":{"description":"Any type"}}}},"503":{"description":"Upload signing or ownership verification is temporarily unavailable. Retry after the delay in Retry-After.","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileUploadRequest"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/group":{"get":{"operationId":"groups_list","summary":"list","description":"list all groups within your GroundX account.\n","tags":["Groups"],"parameters":[{"name":"n","in":"query","description":"The maximum number of returned groups. Accepts 1-100 with a default of 20.","required":false,"schema":{"type":"integer"}},{"name":"nextToken","in":"query","description":"Pass nextToken from the previous response to get the next page of up to n groups.","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful retrieval of groups","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GroupListResponse"}}}}},"security":[{"ApiKeyAuth":[]}]},"post":{"operationId":"groups_create","summary":"create","description":"create a new group, a group being a collection of buckets which can be searched.\n","tags":["Groups"],"responses":{"200":{"description":"Group successfully created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GroupResponse"}}}},"400":{"description":"Invalid body parameter","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GroupCreateRequest"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/group/{groupId}":{"get":{"operationId":"groups_get","summary":"get","description":"look up a specific group by its groupId.\n","tags":["Groups"],"parameters":[{"name":"groupId","in":"path","description":"The groupId of the group to look up.","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"Successful retrieval of group","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GroupResponse"}}}},"400":{"description":"Invalid group ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to access group with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]},"put":{"operationId":"groups_update","summary":"update","description":"Rename a group\n","tags":["Groups"],"parameters":[{"name":"groupId","in":"path","description":"The groupId of the group to update.","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"Successful update of group","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GroupResponse"}}}},"400":{"description":"Invalid body parameter","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to update group with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/GroupUpdateRequest"}}}},"security":[{"ApiKeyAuth":[]}]},"delete":{"operationId":"groups_delete","summary":"delete","description":"Delete a group.\n","tags":["Groups"],"parameters":[{"name":"groupId","in":"path","description":"The groupId of the group to be deleted.","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"Group successfully deleted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MessageResponse"}}}},"400":{"description":"Invalid group ID","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to delete group with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/group/{groupId}/bucket/{bucketId}":{"post":{"operationId":"groups_addBucket","summary":"addBucket","description":"Add an existing bucket to an existing group. Buckets and groups can be associated many to many.\n","tags":["Groups"],"parameters":[{"name":"groupId","in":"path","description":"The groupId of the group which the bucket will be added to.","required":true,"schema":{"type":"integer"}},{"name":"bucketId","in":"path","description":"The bucketId of the bucket being added to the group.","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"Successful update of group","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MessageResponse"}}}},"400":{"description":"Invalid path parameter","content":{"application/json":{"schema":{"description":"Any type"}}}},"401":{"description":"Unauthorized to update group with given ID","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]},"delete":{"operationId":"groups_removeBucket","summary":"removeBucket","description":"remove a bucket from a group. Buckets and groups can be associated many to many, this removes one bucket to group association without disturbing others.\n","tags":["Groups"],"parameters":[{"name":"groupId","in":"path","description":"The groupId of the group which the bucket will be removed from.","required":true,"schema":{"type":"integer"}},{"name":"bucketId","in":"path","description":"The bucketId of the bucket which will be removed from the group.","required":true,"schema":{"type"