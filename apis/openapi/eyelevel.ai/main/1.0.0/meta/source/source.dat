":{"schema":{"description":"Any type"}}}},"503":{"description":"File access is enabled but temporarily unavailable. Retry after the delay in Retry-After.","content":{"application/json":{"schema":{"description":"Any type"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/FileAccessUpdate"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/customer/usage":{"get":{"operationId":"customer_getUsage","summary":"get usage","description":"Get usage for the authenticated account over a time period. GroundX selects its subscription and usage meter; do not supply their IDs or a customer ID. startTime is inclusive and endTime is exclusive. Both must be RFC3339 timestamps on minute boundaries and are converted to UTC. endTime cannot be in the future. The window cannot exceed 366 days. usageAsOf identifies the latest usage summary available to GroundX.","tags":["Customer"],"parameters":[{"name":"metric","in":"query","description":"Supported usage metric to query.","required":true,"schema":{"$ref":"#/components/schemas/V1CustomerUsageGetParametersMetric"}},{"name":"startTime","in":"query","description":"Inclusive RFC3339 window start. Must be aligned to a minute boundary.","required":true,"schema":{"type":"string","format":"date-time"}},{"name":"endTime","in":"query","description":"Exclusive RFC3339 window end. Must be aligned to a minute boundary and cannot be in the future.","required":true,"schema":{"type":"string","format":"date-time"}}],"responses":{"200":{"description":"Usage query success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CustomerUsageResponse"}}}},"400":{"description":"Invalid metric or time period","content":{"application/json":{"schema":{"description":"Any type"}}}},"404":{"description":"Current subscription or usage meter not found for the authenticated customer","content":{"application/json":{"schema":{"description":"Any type"}}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/workflow":{"get":{"operationId":"workflows_list","summary":"list","description":"List workflow IDs, names, update times, and attachments. Use GET /v1/workflow/{id} to get the full workflow.\n","tags":["Workflows"],"responses":{"200":{"description":"Lookup successful","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowsResponse"}}}}},"security":[{"ApiKeyAuth":[]}]},"post":{"operationId":"workflows_create","summary":"create","description":"Create a workflow.\n","tags":["Workflows"],"responses":{"200":{"description":"Workflow successfully created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowResponse"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowRequest"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/workflow/validate":{"post":{"operationId":"workflows_validate","summary":"validate","description":"Validate a workflow without saving changes. Accepts the workflow-create request body, including authored YAML in yaml. Returns the compiled workflow or the same structured validation errors as create.","tags":["Workflows"],"responses":{"200":{"description":"Validation success","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowResponse"}}}}},"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowRequest"}}}},"security":[{"ApiKeyAuth":[]}]}},"/v1/workflow/relationship":{"get":{"operationId":"workflows_getAccount","summary":"get_account","description":"Get the workflow associated with customer account.\n","tags":["Workflows"],"responses":{"200":{"description":"Lookup successful","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowResponse"}}}}},"security":[{"ApiKeyAuth":[]}]},"post":{"operationId":"workflows_addToAccount","summary":"add_to_account","description":"Assigns the given workflow to the customer account and is applied by default to all files unless overridden by document or bucket workflows.\n","tags":["W