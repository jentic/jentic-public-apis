sts by the selected service"},"engineID":{"type":"string","description":"The model name that will be included in the request"},"maxImages":{"type":"integer","minimum":1,"description":"Maximum images per request for this engine. Defaults to 50. An explicit value overrides the default. If the limit is exceeded, GroundX removes earlier images and keeps text and later images. Normal workflow and step engine precedence applies; no route-specific image limit overrides the selected engine. The separate openai-base64 request-size limit still applies."},"reasoningEffort":{"$ref":"#/components/schemas/WorkflowEngineReasoningEffort","description":"An enumerated value that conforms to OpenAI '/chat/completion' specifications"},"requestHeaders":{"type":"object","additionalProperties":{"type":"string"},"description":"Extra LLM request headers with string values, such as OpenAI-Project for usage tracking. They override headers set by GroundX. Set apiKey on the same engine; workflow create and update reject requestHeaders without it. GroundX sends the headers unchanged, but the provider may ignore them."},"requestPassthrough":{"type":"object","additionalProperties":{"description":"Any type"},"description":"Extra JSON fields merged into the LLM request body. These values override fields generated by GroundX when names match."},"service":{"$ref":"#/components/schemas/WorkflowEngineService","description":"Selects how requests are configured for the provider. Anthropic uses the native Messages API with baseURL, apiKey, engineID, requestHeaders, and requestPassthrough."}},"description":"LLM settings for a workflow agent.","title":"WorkflowEngine"},"WorkflowStepConfigField":{"type":"string","enum":["doc-sum","doc-keys","sect-sum","sect-keys","chunk-sum","chunk-keys","chunk-instruct","text"],"description":"The field where agent output will be saved","title":"WorkflowStepConfigField"},"WorkflowPromptRole":{"type":"string","enum":["assistant","developer","system","user"],"description":"An enumerated value that conforms to OpenAI '/chat/completion' specifications","title":"WorkflowPromptRole"},"WorkflowPrompt":{"type":"object","properties":{"abbreviated":{"type":"string","description":"Short prompt included in the chat history as context."},"additionalContext":{"type":"string","maxLength":4096,"description":"Extra instructions appended to a default request or task prompt, limited to 4096 UTF-8 bytes. Omit to leave the prompt unchanged. This value overrides workflow-level template.CUSTOM_INSTRUCTIONS for the same prompt. Supported only on fixed default request and task prompts in GPT and EyeLevel workflows. The server rejects it under customSteps, useExtras or prompts that replace the full prompt, even where this shared schema appears."},"prompt":{"type":"string","description":"The prompt that is sent to the LLM"},"role":{"$ref":"#/components/schemas/WorkflowPromptRole","description":"An enumerated value that conforms to OpenAI '/chat/completion' specifications"}},"description":"Prompt settings for a workflow agent.","title":"WorkflowPrompt"},"WorkflowPromptGroup":{"type":"object","properties":{"request":{"$ref":"#/components/schemas/WorkflowPrompt","description":"The request prompt. On workflow update, omit this member to use the default and send null to remove it."},"task":{"$ref":"#/components/schemas/WorkflowPrompt","description":"The task prompt. On workflow update, omit this member to use the default and send null to remove it."}},"description":"Request and task prompts. On workflow update, omitted members use defaults; null removes a member.","title":"WorkflowPromptGroup"},"WorkflowStepConfig":{"type":"object","properties":{"engine":{"$ref":"#/components/schemas/WorkflowEngine"},"field":{"$ref":"#/components/schemas/WorkflowStepConfigField","description":"The field where agent output will be saved"},"includes":{"type":"object","additionalProperties":{"type":"boolean"}},"prompt":{"$ref":"#/components/schemas/WorkflowPromptGroup","description":"Prompts for this step. On update, omit prompt or send {} to use defaults. Send an object to customize its supplied members, or null to remove the prompt group."}},"description":"Agent settings, including its LLM and prompts.","title":"WorkflowStepConfig"},"WorkflowStep":{"type":"object","properties":{"all":{"$ref":"#/components/schemas/WorkflowStepConfig"},"figure":{"$ref":"#/components/schemas/WorkflowStepConfig"},"json":{"$ref":"#/components/schemas/WorkflowStepConfig"},"paragraph":{"$ref":"#/components/schemas/WorkflowStepConfig"},"table":{"$ref":"#/components/schemas/WorkflowStepConfig"},"table-figure":{"$ref":"#/components/schemas/WorkflowStepConfig"}},"description":"Agent settings, including its LLM and prompts.","title":"WorkflowStep"},"WorkflowSteps":{"type":"object","properties":{"chunk-instruct":{"$ref":"#/components/schemas/WorkflowStep"},"chunk-keys":{"$ref":"#/components/schemas/WorkflowStep"},"chunk-summary":{"$ref":"#/components/schemas/WorkflowStep"},"doc-keys":{"$ref":"#/components/schemas/WorkflowStep"},"doc-summary":{"$ref":"#/components/schemas/WorkflowStep"},"search-query":{"$ref":"#/components/schemas/WorkflowStep"},"sect-instruct":{"$ref":"#/components/schemas/WorkflowStep"},"sect-keys":{"$ref":"#/components/schemas/WorkflowStep"},"sect-summary":{"$ref":"#/components/schemas/WorkflowStep"}},"description":"A collection of workflow steps","title":"WorkflowSteps"},"CustomWorkflowStepLevel":{"type":"string","enum":["chunk","section","document"],"description":"Output level for the custom step.","title":"CustomWorkflowStepLevel"},"CustomWorkflowStepKind":{"type":"string","enum":["instruct","keys","summary"],"description":"Output kind for the custom step. Valid combinations are chunk/section with instruct, keys, or summary; document with keys or summary.","title":"CustomWorkflowStepKind"},"CustomWorkflowStepElementConfig":{"type":"object","properties":{"engine":{"$ref":"#/components/schemas/WorkflowEngine"},"includes":{"type":"object","additionalProperties":{"type":"boolean"}},"prompt":{"$ref":"#/components/schemas/WorkflowPromptGroup","description":"Prompts for this custom step element. On update, omit prompt or send {} to use defaults. Send an object to customize its supplied members, or null to remove the prompt group."}},"description":"Element-level custom workflow step config. It supports existing prompt, engine, and include settings; fixed-output field is omitted because custom output routing is defined by outputRoutes and leafFields.","title":"CustomWorkflowStepElementConfig"},"CustomWorkflowStepConfig":{"type":"object","properties":{"all":{"$ref":"#/components/schemas/CustomWorkflowStepElementConfig"},"figure":{"$ref":"#/components/schemas/CustomWorkflowStepElementConfig"},"json":{"$ref":"#/components/schemas/CustomWorkflowStepElementConfig"},"paragraph":{"$ref":"#/components/schemas/CustomWorkflowStepElementConfig"},"table":{"$ref":"#/components/schemas/CustomWorkflowStepElementConfig"},"table-figure":{"$ref":"#/components/schemas/CustomWorkflowStepElementConfig"}},"description":"Custom workflow step config keyed by element type. Element configs omit fixed-output field; custom output storage is derived from level, kind, outputRoutes, and leafFields.","title":"CustomWorkflowStepConfig"},"CustomWorkflowStep":{"type":"object","properties":{"name":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$","description":"Canonical lower-snake custom step name. Names are globally unique and cannot collide with fixed step names or reserved workflow metadata names."},"level":{"$ref":"#/components/schemas/CustomWorkflowStepLevel","description":"Output level for the custom step."},"kind":{"$ref":"#/components/schemas/CustomWorkflowStepKind","description":"Output kind for the custom step. Valid combinations are chunk/section with instruct, keys, or summary; document with keys or summary."},"config":{"$ref":"#/components/schemas/CustomWorkflowStepConfig"},"requiredTemplateKeys":{"type":"array","items":{"type":"string"},"description":"Workflow template keys required by this custom step. Keys follow the same normalization and validation rules as template keys."}},"required":["name","level","kind"],"description":"Workflow-level custom extraction step definition. Fixed workflow steps remain under steps.","title":"CustomWorkflowStep"},"CustomWorkflowOutputRouteLevel":{"type":"string","enum":["chunk","section","document"],"title":"CustomWorkflowOutputRouteLevel"},"CustomWorkflowOutputRouteOutputMap":{"type":"string","enum":["customChunkOutputs","customSectionOutputs","customDocumentOutputs"],"description":"Custom X-Ray output map that stores this route's values. The map must match level.","title":"CustomWorkflowOutputRouteOutputMap"},"CustomWorkflowOutputRoute":{"type":"object","properties":{"workflowGroup":{"type":"string","description":"Workflow extraction group that owns the routed field."},"workflowField":{"type":"string","description":"Workflow extraction field routed to the final JSON path."},"finalPath":{"type":"string","description":"RFC 6901 JSON Pointer to the final JSON field. Repeated item paths use a literal * segment as a schema wildcard; for example, the pointer with segments fees, *, and amount represents a repeated item amount."},"stepName":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$","description":"Canonical custom step name that produced the output."},"level":{"$ref":"#/components/schemas/CustomWorkflowOutputRouteLevel"},"outputMap":{"$ref":"#/components/schemas/CustomWorkflowOutputRouteOutputMap","description":"Custom X-Ray output map that stores this route's values. The map must match level."},"outputKey":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$","description":"Lower-snake output key for this custom step output."},"readbackPath":{"type":"string","description":"Canonical non-page X-Ray/readback path template for this routed output."}},"required":["workflowGroup","workflowField","finalPath","stepName","level","outputMap","outputKey","readbackPath"],"description":"Public custom output route metadata. Each route must have exactly one matching leafFields record on finalPath, workflowGroup, workflowField, stepName, level, and outputKey.","title":"CustomWorkflowOutputRoute"},"CustomWorkflowLeafFieldLevel":{"type":"string","enum":["chunk","section","document"],"title":"CustomWorkflowLeafFieldLevel"},"CustomWorkflowLeafFieldRepetitionScope":{"type":"string","enum":["none","field","item"],"description":"none is valid only for non-repeated leaves; field counts a repeated value as one prompted leaf; item uses literal * path segments for prompted item leaves.","title":"CustomWorkflowLeafFieldRepetitionScope"},"CustomWorkflowLeafField":{"type":"object","properties":{"finalPath":{"type":"string","description":"RFC 6901 JSON Pointer to the prompted final schema leaf. Repeated item paths use a literal * segment and count once per prompted schema leaf."},"workflowGroup":{"type":"string"},"workflowField":{"type":"string"},"stepName":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"level":{"$ref":"#/components/schemas/CustomWorkflowLeafFieldLevel"},"outputKey":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"fieldType":{"type":"string","description":"Final schema field type for this prompted leaf."},"isRepeated":{"type":"boolean","description":"Whether this leaf belongs to a repeated/list field definition."},"repetitionScope":{"$ref":"#/components/schemas/CustomWorkflowLeafFieldRepetitionScope","description":"none is valid only for non-repeated leaves; field counts a repeated value as one prompted leaf; item uses literal * path segments for prompted item leaves."}},"required":["finalPath","workflowGroup","workflowField","stepName","level","outputKey","fieldType","isRepeated","repetitionScope"],"description":"Public custom leaf-field metadata used for route integrity and executable-step field-count validation.","title":"CustomWorkflowLeafField"},"WorkflowDetailRelationships":{"type":"object","properties":{"account":{"type":"boolean","description":"A boolean indicating whether the workflow is associated with the account"},"documents":{"type":["array","null"],"items":{"type":"string","format":"uuid"},"description":"An array of documentIds associated with the workflow"},"ids":{"type":"array","items":{"type":"integer"},"description":"An array of bucketIds or groupIds associated with the workflow"}},"description":"Resources associated with this workflow.","title":"WorkflowDetailRelationships"},"WorkflowDetail":{"type":"object","properties":{"chunkStrategy":{"$ref":"#/components/schemas/WorkflowDetailChunkStrategy"},"documentId":{"type":"string","format":"uuid","description":"The documentId associated with the workflow"},"id":{"type":"integer","description":"The bucketId or groupId associated with the workflow"},"name":{"type":"string","description":"The human-readable name of the workflow"},"updatedAt":{"type":"string","format":"date-time","description":"The UTC timestamp when the workflow row was last updated."},"extract":{"$ref":"#/components/schemas/WorkflowDetailExtract","description":"Extract agent definitions."},"template":{"$ref":"#/components/schemas/WorkflowTemplate"},"sectionStrategy":{"$ref":"#/components/schemas/WorkflowDetailSectionStrategy"},"steps":{"$ref":"#/components/schemas/WorkflowSteps"},"customSteps":{"type":"array","items":{"$ref":"#/components/schemas/CustomWorkflowStep"},"description":"Workflow-level custom extraction steps. Legacy fixed steps remain under steps."},"outputRoutes":{"type":"array","items":{"$ref":"#/components/schemas/CustomWorkflowOutputRoute"},"description":"Custom output routes. Each record must have exactly one matching leafFields record on finalPath, workflowGroup, workflowField, stepName, level, and outputKey."},"leafFields":{"type":"array","items":{"$ref":"#/components/schemas/CustomWorkflowLeafField"},"description":"Custom leaf-field metadata used to validate route integrity and executable-step field counts."},"relationships":{"$ref":"#/components/schemas/WorkflowDetailRelationships","description":"Resources associated with this workflow."},"workflowId":{"type":"string","format":"uuid","description":"Unique system generated ID for the workflow"}},"description":"Workflow information","title":"WorkflowDetail"},"WorkflowsResponse":{"type":"object","properties":{"workflows":{"type":"array","items":{"$ref":"#/components/schemas/WorkflowDetail"}}},"required":["workflows"],"title":"WorkflowsResponse"},"WorkflowRequestChunkStrategy":{"type":"string","enum":["element","size"],"title":"WorkflowRequestChunkStrategy"},"WorkflowRequestExtract":{"type":"object","properties":{},"description":"Extract agent definitions.","title":"WorkflowRequestExtract"},"WorkflowRequestSectionStrategy":{"type":"string","enum":["chunks","page"],"title":"WorkflowRequestSectionStrategy"},"WorkflowRequest":{"type":"object","properties":{"chunkStrategy":{"$ref":"#/components/schemas/WorkflowRequestChunkStrategy"},"name":{"type":"string","description":"The name of the workflow being created."},"yaml":{"type":"string","description":"Workflow YAML. GroundX validates it and creates the workflow settings. When yaml is supplied, omit extract, customSteps, outputRoutes, leafFields, and steps. A v1 workflow declares extraction_policy_version, workflow.custom_steps, workflow.agent_chain, a workflow_step and role for each group, and a workflow_output_key for each routed field. repeats: true declares an array of records; unique_attrs names fields used to identify the same record. For related lists, match_attrs names the shared fields and passthrough.from names the parent group. String matching ignores capitalization and surrounding whitespace. Blank or missing values do not match. When several parents match, GroundX uses the first. Group names and workflow_output_key values become output names.\n"},"extract":{"$ref":"#/components/schemas/WorkflowRequestExtract","description":"Extract agent definitions."},"template":{"$ref":"#/components/schemas/WorkflowTemplate"},"sectionStrategy":{"$ref":"#/components/schemas/WorkflowRequestSectionStrategy"},"steps":{"$ref":"#/components/schemas/WorkflowSteps"},"customSteps":{"type":"array","items":{"$ref":"#/components/schemas/CustomWorkflowStep"},"description":"Workflow-level custom extraction steps. Legacy fixed steps remain under steps."},"outputRoutes":{"type":"array","items":{"$ref":"#/components/schemas/CustomWorkflowOutputRoute"},"description":"Custom output routes. Each record must have exactly one matching leafFields record on finalPath, workflowGroup, workflowField, stepName, level, and outputKey."},"leafFields":{"type":"array","items":{"$ref":"#/components/schemas/CustomWorkflowLeafField"},"description":"Custom leaf-field metadata used to validate route integrity and executable-step field counts."}},"title":"WorkflowRequest"},"WorkflowResponse":{"type":"object","properties":{"workflow":{"$ref":"#/components/schemas/WorkflowDetail"}},"required":["workflow"],"title":"WorkflowResponse"},"WorkflowApplyRequest":{"type":"object","properties":{"workflowId":{"type":"string","format":"uuid","description":"The id of the workflow that is being applied."}},"required":["workflowId"],"title":"WorkflowApplyRequest"},"V1WorkflowIdGetParametersId":{"oneOf":[{"type":"integer"},{"type":"string","format":"uuid"}],"title":"V1WorkflowIdGetParametersId"},"V1WorkflowIdGetParametersFormat":{"type":"string","enum":["json","yaml"],"title":"V1WorkflowIdGetParametersFormat"},"APIKeyDetail":{"type":"object","properties":{"apiKey":{"type":"string","format":"uuid","description":"The GroundX API key"},"created":{"type":"string","format":"date-time","description":"API key creation time in RFC3339 format."},"name":{"type":"string"}},"required":["apiKey"],"title":"APIKeyDetail"},"APIKeyResponse":{"type":"object","properties":{"apiKeys":{"type":"array","items":{"$ref":"#/components/schemas/APIKeyDetail"}}},"title":"APIKeyResponse"},"APIKeyRequest":{"type":"object","properties":{"name":{"type":"string"}},"required":["name"],"title":"APIKeyRequest"},"HealthServiceStatus":{"type":"string","enum":["healthy","degraded","down","unknown"],"description":"The health status of the service","title":"HealthServiceStatus"},"HealthService":{"type":"object","properties":{"lastUpdate":{"type":"string","format":"date-time","description":"Last service status update in RFC3339 format."},"service":{"type":"string","description":"The name of the service"},"status":{"$ref":"#/components/schemas/HealthServiceStatus","description":"The health status of the service"}},"required":["lastUpdate","service","status"],"title":"HealthService"},"HealthResponseHealth":{"type":"object","properties":{"services":{"type":"array","items":{"$ref":"#/components/schemas/HealthService"}}},"required":["services"],"title":"HealthResponseHealth"},"HealthResponse":{"type":"object","properties":{"health":{"$ref":"#/components/schemas/HealthResponseHealth"}},"required":["health"],"title":"HealthResponse"}},"securitySchemes":{"ApiKeyAuth":{"type":"apiKey","in":"header","name":"X-API-Key"}}}}