  "components": {
    "schemas": {
      "ApplePayInitiative": {
        "type": "string",
        "enum": [
          "web",
          "messaging",
          "in_app"
        ]
      },
      "ApplePayMerchantSession": {
        "type": "object",
        "required": [
          "epochTimestamp",
          "expiresAt",
          "merchantSessionIdentifier",
          "nonce",
          "merchantIdentifier",
          "domainName",
          "displayName",
          "signature",
          "operationalAnalyticsIdentifier",
          "retries",
          "pspId"
        ],
        "properties": {
          "epochTimestamp": {
            "type": "integer"
          },
          "expiresAt": {
            "type": "integer"
          },
          "merchantSessionIdentifier": {
            "type": "string"
          },
          "nonce": {
            "type": "string"
          },
          "merchantIdentifier": {
            "type": "string"
          },
          "domainName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "operationalAnalyticsIdentifier": {
            "type": "string"
          },
          "retries": {
            "type": "integer"
          },
          "pspId": {
            "type": "string"
          }
        }
      },
      "Order": {
        "type": "object"
      },
      "OrderAs": {
        "type": "string",
        "enum": [
          "buyer",
          "seller"
        ]
      },
      "PostPayment": {
        "type": "object",
        "required": [
          "carrier_id",
          "cart_id",
          "offer_id"
        ],
        "properties": {
          "carrier_id": {
            "type": "string"
          },
          "cart_id": {
            "type": "string"
          },
          "offer_id": {
            "type": "string"
          }
        }
      },
      "PostPaymentApplePay": {
        "type": "object",
        "required": [
          "payment_data"
        ],
        "properties": {
          "payment_data": {
            "type": "object",
            "properties": {
              "network": {
                "type": "string"
              },
              "token_data": {
                "type": "string"
              },
              "transaction_id": {
                "type": "string"
              }
            },
            "required": [
              "network",
              "token_data",
              "transaction_id"
            ]
          }
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/PostPayment"
          }
        ]
      },
      "PostPaymentApplePaySession": {
        "type": "object",
        "required": [
          "validation_url",
          "merchant_identifier",
          "display_name",
          "initiative",
          "initiative_context"
        ],
        "properties": {
          "validation_url": {
            "type": "string"
          },
          "merchant_identifier": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "initiative": {
            "$ref": "#/components/schemas/ApplePayInitiative"
          },
          "initiative_context": {
            "type": "string"
          }
        }
      },
      "PostPaymentGooglePay": {
        "type": "object",
        "required": [
          "ip_address",
          "secure_mode_return_url",
          "browser_info",
          "payment_data"
        ],
        "properties": {
          "ip_address": {
            "type": "string"
          },
          "secure_mode_return_url": {
            "type": "string"
          },
          "browser_info": {
            "type": "object"
          },
          "payment_data": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/PostPayment"
          }
        ]
      },
      "ResponseKo": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "message"
            ]
          }
        }
      },
      "ResponseOk": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      },
      "ResponseOkPostPayment": {
        "type": "object",
        "required": [
          "id",
          "status",
          "result_message"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "result_message": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/ResponseOk"
          }
        ]
      },
      "ResponseOkPostPaymentGooglePay": {
        "type": "object",
        "required": [
          "secure_mode_return_url",
          "secure_mode_redirect_url",
          "secure_mode_needed"
        ],
        "properties": {
          "secure_mode_return_url": {
            "type": "string"
          },
          "secure_mode_redirect_url": {
            "type": "string"
          },
          "secure_mode_needed": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "$ref": "#/components/schemas/ResponseOkPostPayment"
          }
        ]
      },
      "Versions": {
        "type": "string",
        "enum": [
          "1.5.0",
          "2.0.0"
        ]
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
  },
