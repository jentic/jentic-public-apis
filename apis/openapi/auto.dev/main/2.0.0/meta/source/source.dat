    "/apr/{vin}": {
      "get": {
        "operationId": "getInterestRates",
        "summary": "Interest Rates",
        "description": "Real-time automotive financing rates and lending information.\n\n**Plan:** Growth tier and above (10 requests/second, Unlimited monthly volume).\n\n**Docs:** https://docs.auto.dev/v2/products/interest-rates",
        "tags": [
          "Financial"
        ],
        "parameters": [
          {
            "name": "vin",
            "in": "path",
            "required": true,
            "description": "17-character Vehicle Identification Number (letters and digits, excluding I, O, and Q).",
            "schema": {
              "type": "string",
              "pattern": "[A-HJ-NPR-Z0-9]{17}",
              "minLength": 17,
              "maxLength": 17
            },
            "example": "1FTFW3LDXRFB40317"
          }
        ],
        "responses": {
          "200": {
            "description": "Success. Vehicle data for the requested identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "Product response object. See https://docs.auto.dev/v2/products/interest-rates for the full field-level schema."
                }
              }
            }
          },
          "302": {
            "description": "Unauthenticated browser request — redirected to the sign-in page. Send an API key (Authorization: Bearer, ?apiKey=, or X-API-Key) to receive JSON instead.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "The VIN or path parameters failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "The API key is missing or invalid. Browser requests are redirected to sign in instead (302).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The authenticated plan is not entitled to this endpoint.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No data is available for the requested vehicle.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded for the current plan. Retry after the interval in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before retrying."
              },
              "RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Requests permitted in the current window."
              },
              "RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                },
                "description": "Requests remaining in the current window."
              },
              "RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until the window resets."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
