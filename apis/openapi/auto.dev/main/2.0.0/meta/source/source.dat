  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key sent as `Authorization: Bearer <key>`."
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "apiKey",
        "description": "API key sent as the `apiKey` query parameter."
      },
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key sent as the `X-API-Key` request header."
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem detail. Returned as `application/problem+json` on any 4xx/5xx response.",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "URI identifying the problem type.",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "Short, human-readable summary of the problem.",
            "example": "Bad Request"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status code.",
            "example": 400
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation specific to this occurrence."
          },
          "instance": {
            "type": "string",
            "format": "uri",
            "description": "URI identifying this specific occurrence."
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code for programmatic handling."
          }
        },
        "required": [
          "title",
          "status"
        ]
      },
      "Vehicle": {
        "type": "object",
        "properties": {
          "vin": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "manufacturer": {
            "type": "string"
          }
        }
      },
      "VinDecodeResponse": {
        "type": "object",
        "description": "Decoded VIN with validation metadata and a normalized vehicle object.",
        "properties": {
          "vin": {
            "type": "string",
            "example": "3GCUDHEL3NG668790"
          },
          "vinValid": {
            "type": "boolean"
          },
          "wmi": {
            "type": "string",
            "description": "World Manufacturer Identifier (first 3 characters)."
          },
          "origin": {
            "type": "string"
          },
