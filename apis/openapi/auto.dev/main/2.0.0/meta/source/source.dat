{
  "openapi": "3.1.0",
  "info": {
    "title": "Auto.dev Vehicle Data API",
    "version": "2.0.0",
    "description": "Automotive data for developers and AI agents: VIN decoding, specifications, listings, photos, recalls, financing, taxes, and total cost of ownership. Every endpoint takes a VIN (or a US plate) and returns JSON.\n\n## Authentication\nSend your API key as `Authorization: Bearer <key>` (recommended), the `?apiKey=<key>` query parameter, or the `X-API-Key` header. Create keys in the dashboard at https://www.auto.dev/dashboard. Unauthenticated browser requests are redirected (302) to the sign-in page.\n\n## Rate limits\nThroughput is per plan. On 429, honor the `Retry-After` header.\n- **Free:** 5 requests/second — 1,000 API calls / month\n- **Growth:** 10 requests/second — Unlimited monthly volume\n- **Scale:** 50 requests/second — Unlimited monthly volume\n\n## Versioning & deprecation\nThe current major version is v2 (documented at https://docs.auto.dev). Breaking changes ship under a new major version. Endpoints scheduled for removal are announced in the docs and signaled at runtime with the `Deprecation` and `Sunset` response headers (RFC 8594) ahead of removal.\n\n## Errors\nErrors use `application/problem+json` (RFC 9457) with a machine-readable `code` and a human-readable `title`/`detail`.",
    "termsOfService": "https://www.auto.dev/terms",
    "contact": {
      "name": "Auto.dev Support",
      "url": "https://www.auto.dev",
      "email": "support@auto.dev"
    },
    "license": {
      "name": "Auto.dev API Terms of Service",
      "url": "https://www.auto.dev/terms"
    }
  },
  "servers": [
    {
      "url": "https://api.auto.dev",
      "description": "Production API gateway"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "apiKeyQuery": []
    },
    {
      "apiKeyHeader": []
    }
  ],
  "tags": [
    {
      "name": "Core",
      "description": "Core automotive data endpoints."
    },
    {
      "name": "Marketplace",
      "description": "Marketplace automotive data endpoints."
    },
    {
      "name": "Financial",
      "description": "Financial automotive data endpoints."
    },
    {
      "name": "Safety",
      "description": "Safety automotive data endpoints."
    }
  ],
  "paths": {
    "/vin/{vin}": {
      "get": {
        "operationId": "decodeVin",
        "summary": "Global VIN Decode",
        "description": "Decode any VIN to access comprehensive vehicle data and specifications.\n\n**Plan:** Free tier and above (5 requests/second, 1,000 API calls / month).\n\n**Docs:** https://docs.auto.dev/v2/products/vin-decode",
        "tags": [
          "Core"
        ],
        "parameters": [
          {
            "name": "vin",
            "in": "path",
            "required": true,
            "description": "17-character Vehicle Identification Number (letters and digits, excluding I, O, and Q).",
            "schema": {
              "type": "string",
              "pattern": "[A-HJ-NPR-Z0-9]{17}",
              "minLength": 17,
              "maxLength": 17
            },
            "example": "1FTFW3LDXRFB40317"
          }
        ],
        "responses": {
          "200": {
            "description": "Success. Vehicle data for the requested identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VinDecodeResponse"
                }
              }
            }
          },
          "302": {
            "description": "Unauthenticated browser request — redirected to the sign-in page. Send an API key (Authorization: Bearer, ?apiKey=, or X-API-Key) to receive JSON instead.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "The VIN or path parameters failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "The API key is missing or invalid. Browser requests are redirected to sign in instead (302).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The authenticated plan is not entitled to this endpoint.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No data is available for the requested vehicle.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded for the current plan. Retry after the interval in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before retrying."
              },
              "RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Requests permitted in the current window."
              },
              "RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                },
                "description": "Requests remaining in the current window."
              },
              "RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until the window resets."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/plate/{state}/{plate}": {
      "get": {
        "operationId": "plateToVin",
        "summary": "Plate-to-VIN",
        "description": "Decode US license plates to get VIN, year, make, model, and more.\n\n**Plan:** Scale tier and above (50 requests/second, Unlimited monthly volume).\n\n**Docs:** https://docs.auto.dev/v2/products/plate-to-vin",
        "tags": [
          "Core"
        ],
        "parameters": [
          {
            "name": "state",
            "in": "path",
            "required": true,
            "description": "Two-letter US state code of the plate's registration.",
            "schema": {
              "type": "string",
              "pattern": "[A-Za-z]{2}"
            },
            "example": "CA"
          },
          {
            "name": "plate",
            "in": "path",
            "required": true,
            "description": "License plate number.",
            "schema": {
              "type": "string"
            },
            "example": "ABC123"
          }
        ],
        "responses": {
          "200": {
            "description": "Success. Vehicle data for the requested identifier.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "Product response object. See https://docs.auto.dev/v2/products/plate-to-vin for the full field-level schema."
                }
              }
            }
          },
          "302": {
            "description": "Unauthenticated browser request — redirected to the sign-in page. Send an API key (Authorization: Bearer, ?apiKey=, or X-API-Key) to receive JSON instead.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "The VIN or path parameters failed validation.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "The API key is missing or invalid. Browser requests are redirected to sign in instead (302).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The authenticated plan is not entitled to this endpoint.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No data is available for the requested vehicle.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded for the current plan. Retry after the interval in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds to wait before retrying."
              },
              "RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Requests permitted in the current window."
              },
              "RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                },
                "description": "Requests remaining in the current window."
              },
              "RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Seconds until the window resets."
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
