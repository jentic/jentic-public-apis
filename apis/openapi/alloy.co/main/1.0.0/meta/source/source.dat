                                      "type": "string",
                                      "description": "External transaction ID of the linked transaction."
                                    },
                                    "transaction_token": {
                                      "type": "string",
                                      "description": "Transaction token of the linked transaction."
                                    },
                                    "reason": {
                                      "type": "string",
                                      "description": "Reason for linking the transaction.",
                                      "example": "Chargeback"
                                    }
                                  }
                                }
                              },
                              "return_code": {
                                "description": "This represents the Alphanumeric ACH return Code. (e.g. R01)",
                                "type": "string",
                                "nullable": true
                              },
                              "return_code_reason": {
                                "description": "Allowed values are (`\"Unauthorized\"`, `null`). Currently not used in decisioning.",
                                "type": "string",
                                "nullable": true,
                                "enum": [
                                  "Unauthorized"
                                ]
                              },
                              "status": {
                                "description": "Allowed values are (`\"Acknowledged\"`, `\"Accepted\"`, `\"Rejected\"`, `\"Paused\"`, `\"Pending\"`, `\"Completed\"`, `\"Declined\"`, `\"Cancelled\"`, `null`)",
                                "type": "string",
                                "nullable": true,
