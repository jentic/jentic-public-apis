                                "type": "string"
                              },
                              "entity_token": {
                                "type": "string"
                              },
                              "external_entity_id": {
                                "type": "string"
                              },
                              "external_account_id": {
                                "type": "string"
                              },
                              "counterparty": {
                                "type": "object",
