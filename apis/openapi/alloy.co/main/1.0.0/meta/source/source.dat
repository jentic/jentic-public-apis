                          "username",
                          "timestamp"
                        ],
                        "properties": {
                          "entity_token": {
                            "type": "string"
                          },
                          "external_entity_id": {
                            "type": "string"
                          },
                          "external_login_id": {
                            "type": "string",
                            "description": "Unique identifier for grouping multiple login events into a single login."
                          },
                          "username": {
                            "type": "string"
                          },
                          "login_method": {
                            "type": "string",
                            "enum": [
                              "biometric",
                              "password",
                              "sso",
                              "passwordless"
                            ]
                          },
                          "sso": {
                            "type": "string",
                            "enum": [
                              "okta",
                              "google",
                              "apple"
                            ]
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "attempted",
                              "failed",
                              "mfa",
                              "rejected",
                              "successful"
                            ]
                          },
                          "device": {
                            "allOf": [
                              {
                                "properties": {
                                  "external_device_id": {
                                    "type": "string"
                                  },
                                  "ip_address_v4": {
                                    "type": "string"
                                  },
                                  "ip_address_v6": {
                                    "type": "string"
                                  }
                                }
                              }
