                                  "Rejected",
                                  "Paused",
                                  "Pending",
                                  "Completed",
                                  "Declined",
                                  "Cancelled"
                                ]
                              },
                              "status_detail": {
                                "description": "Additional description on transaction status. Currently not used in decisioning.",
                                "type": "string",
                                "nullable": true
                              },
