{
  "openapi": "3.0.3",
  "info": {
    "title": "Last.fm API",
    "description": "The Last.fm music API provides access to music data including artist info, album data, track information, user listening history, charts, and scrobbling. All requests use a single endpoint with method-based dispatch via the 'method' query parameter. Over 50 methods are available across artist, album, track, user, chart, geo, tag, library, and auth packages.",
    "version": "2.0",
    "x-jentic-source-url": "https://www.last.fm/api",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://ws.audioscrobbler.com/2.0"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "callReadMethod",
        "summary": "Call a Last.fm read-only API method (artist, album, track, user, chart, geo, tag, library info)",
        "description": "All Last.fm read methods use GET on the root endpoint with a 'method' query parameter. Common methods include: artist.getInfo, artist.getSimilar, artist.getTopAlbums, artist.getTopTracks, artist.search, album.getInfo, album.search, track.getInfo, track.getSimilar, track.search, user.getInfo, user.getRecentTracks, user.getTopArtists, user.getTopTracks, user.getLovedTracks, chart.getTopArtists, chart.getTopTracks, chart.getTopTags, geo.getTopArtists, geo.getTopTracks, tag.getInfo, tag.getTopArtists, tag.getTopTracks, tag.getTopAlbums, library.getArtists, auth.getToken.",
        "parameters": [
          {
            "name": "method",
            "in": "query",
            "required": true,
            "description": "API method name in package.method format",
            "schema": {
              "type": "string",
              "enum": [
                "artist.getCorrection",
                "artist.getInfo",
                "artist.getSimilar",
                "artist.getTags",
                "artist.getTopAlbums",
                "artist.getTopTags",
                "artist.getTopTracks",
                "artist.search",
                "album.getInfo",
                "album.getTags",
                "album.getTopTags",
                "album.search",
                "track.getCorrection",
                "track.getInfo",
                "track.getSimilar",
                "track.getTags",
                "track.getTopTags",
                "track.search",
                "user.getFriends",
                "user.getInfo",
                "user.getLovedTracks",
                "user.getPersonalTags",
                "user.getRecentTracks",
                "user.getTopAlbums",
                "user.getTopArtists",
                "user.getTopTags",
                "user.getTopTracks",
                "user.getWeeklyAlbumChart",
                "user.getWeeklyArtistChart",
                "user.getWeeklyChartList",
                "user.getWeeklyTrackChart",
                "chart.getTopArtists",
                "chart.getTopTags",
                "chart.getTopTracks",
                "geo.getTopArtists",
                "geo.getTopTracks",
                "tag.getInfo",
                "tag.getSimilar",
                "tag.getTopAlbums",
                "tag.getTopArtists",
                "tag.getTopTags",
                "tag.getTopTracks",
                "tag.getWeeklyChartList",
                "library.getArtists",
                "auth.getToken",
                "auth.getSession"
              ]
            }
          },
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "description": "Your Last.fm API key",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artist",
            "in": "query",
            "description": "Artist name (for artist/track/album methods)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "album",
            "in": "query",
            "description": "Album name (for album methods)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "track",
            "in": "query",
            "description": "Track name (for track methods)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "user",
            "in": "query",
            "description": "Username (for user methods)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "description": "Tag name (for tag methods)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "Country name (for geo methods, ISO 3166-1)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mbid",
            "in": "query",
            "description": "MusicBrainz ID (alternative to name-based lookup)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "description": "Language for biography content (ISO 639 alpha-2)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "autocorrect",
            "in": "query",
            "description": "Correct misspelled names (0 or 1)",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for paginated results",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of results per page",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "period",
            "in": "query",
            "description": "Time period for user charts (overall, 7day, 1month, 3month, 6month, 12month)",
            "schema": {
              "type": "string",
              "enum": [
                "overall",
                "7day",
                "1month",
                "3month",
                "6month",
                "12month"
              ]
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Start timestamp (UNIX) for date-ranged queries",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "End timestamp (UNIX) for date-ranged queries",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Response format (default is XML)",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response (structure varies by method)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request or invalid method"
          },
          "403": {
            "description": "Invalid API key or insufficient permissions"
          }
        }
      },
      "post": {
        "operationId": "callWriteMethod",
        "summary": "Call a Last.fm write API method (scrobble, love, update now playing)",
        "description": "Write methods require authenticated sessions and use POST. Methods include: track.scrobble, track.updateNowPlaying, track.love, track.unlove, auth.getMobileSession. These require an API signature parameter (api_sig) computed from the method parameters and your API secret.",
        "parameters": [
          {
            "name": "method",
            "in": "query",
            "required": true,
            "description": "Write API method name",
            "schema": {
              "type": "string",
              "enum": [
                "track.scrobble",
                "track.updateNowPlaying",
                "track.love",
                "track.unlove",
                "artist.addTags",
                "artist.removeTag",
                "album.addTags",
                "album.removeTag",
                "track.addTags",
                "track.removeTag",
                "auth.getMobileSession"
              ]
            }
          },
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "api_sig",
            "in": "query",
            "required": true,
            "description": "Method signature (MD5 hash of sorted parameters + API secret)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sk",
            "in": "query",
            "required": true,
            "description": "Session key from auth.getSession or auth.getMobileSession",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "xml"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "artist": {
                    "type": "string",
                    "description": "Artist name"
                  },
                  "track": {
                    "type": "string",
                    "description": "Track name"
                  },
                  "album": {
                    "type": "string",
                    "description": "Album name"
                  },
                  "timestamp": {
                    "type": "integer",
                    "description": "UNIX timestamp of scrobble"
                  },
                  "tags": {
                    "type": "string",
                    "description": "Comma-separated tags"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful write operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Authentication required or invalid session"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "name": "api_key",
        "in": "query",
        "description": "Last.fm API key obtained from https://www.last.fm/api/account/create"
      }
    }
  }
}
