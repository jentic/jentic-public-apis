{
  "openapi": "3.0.3",
  "info": {
    "title": "Bodygram Platform API",
    "version": "0.2.0",
    "description": "Bodygram Platform API Specification\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ville5/bodygram-platform-api/0.2.0"
  },
  "servers": [
    {
      "url": "https://platform.bodygram.com"
    }
  ],
  "paths": {
    "/api/account": {
      "get": {
        "operationId": "getAccount",
        "summary": "Returns the current member's account information.\n",
        "security": [
          {
            "GeneralAuthorizer": []
          }
        ],
        "x-bg-scopes": [
          "api.platform.bodygram.com/account:self"
        ],
        "x-amazon-apigateway-integration": {
          "$ref": "#/components/x-amazon-apigateway-integrations/api"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/GetAccount"
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      },
      "delete": {
        "operationId": "deleteAccount",
        "summary": "Delete the current member's account\n",
        "security": [
          {
            "GeneralAuthorizer": []
          }
        ],
        "x-bg-scopes": [
          "api.platform.bodygram.com/account:self"
        ],
        "x-amazon-apigateway-integration": {
          "$ref": "#/components/x-amazon-apigateway-integrations/api"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/DeleteAccount"
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/orgs/{organizationId}/scan-tokens": {
      "parameters": [
        {
          "name": "organizationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$"
          },
          "style": "simple"
        }
      ],
      "post": {
        "operationId": "createScanToken",
        "summary": "Creates a new scan token\n",
        "security": [
          {
            "GeneralAuthorizer": []
          }
        ],
        "x-bg-scopes": [
          "api.platform.bodygram.com/scan-tokens:create"
        ],
        "x-amazon-apigateway-integration": {
          "$ref": "#/components/x-amazon-apigateway-integrations/api"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateScanTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/CreateScanToken"
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/orgs/{organizationId}/keys": {
      "parameters": [
        {
          "name": "organizationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$"
          },
          "style": "simple"
        }
      ],
      "get": {
        "operationId": "listKeys",
        "summary": "Returns a list of API keys belonging to the organizaion.\n",
        "security": [
          {
            "GeneralAuthorizer": []
          }
        ],
        "x-bg-scopes": [
          "api.platform.bodygram.com/keys:read"
        ],
        "x-amazon-apigateway-integration": {
          "$ref": "#/components/x-amazon-apigateway-integrations/api"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/PaginationAfter"
          },
          {
            "$ref": "#/components/parameters/PaginationLimit"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ListKeys"
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      },
      "post": {
        "operationId": "createKey",
        "summary": "Creates a new API key belonging to the organization.\n",
        "security": [
          {
            "GeneralAuthorizer": []
          }
        ],
        "x-bg-scopes": [
          "api.platform.bodygram.com/keys:create"
        ],
        "x-amazon-apigateway-integration": {
          "$ref": "#/components/x-amazon-apigateway-integrations/api"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateKeyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/CreateKey"
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/orgs/{organizationId}/keys/{id}": {
      "parameters": [
        {
          "name": "organizationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$"
          },
          "style": "simple"
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$"
          },
          "style": "simple"
        }
      ],
      "delete": {
        "operationId": "deleteKey",
        "summary": "Deletes an API key belonging to the organization.\n",
        "security": [
          {
            "GeneralAuthorizer": []
          }
        ],
        "x-bg-scopes": [
          "api.platform.bodygram.com/keys:delete"
        ],
        "x-amazon-apigateway-integration": {
          "$ref": "#/components/x-amazon-apigateway-integrations/api"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/DeleteKey"
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/orgs/{organizationId}/scans": {
      "parameters": [
        {
          "name": "organizationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$"
          },
          "style": "simple"
        }
      ],
      "get": {
        "operationId": "listScans",
        "summary": "Returns a list of scans that belong to the organization.\n",
        "security": [
          {
            "GeneralAuthorizer": []
          }
        ],
        "x-bg-scopes": [
          "api.platform.bodygram.com/scans:read"
        ],
        "x-amazon-apigateway-integration": {
          "$ref": "#/components/x-amazon-apigateway-integrations/api"
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/PaginationAfter"
          },
          {
            "$ref": "#/components/parameters/PaginationLimit"
          },
          {
            "name": "customScanId",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "my_custom_id_123"
            },
            "description": "Optional customScanId value provided by the client to filter by. Only entries with this exact customScanId will be returned."
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ListScans"
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      },
      "post": {
        "operationId": "createScan",
        "summary": "Creates a new scan belonging to the organization.\n",
        "security": [
          {
            "CreateScanAuthorizer": []
          }
        ],
        "x-bg-scopes": [
          "api.platform.bodygram.com/scans:create"
        ],
        "x-amazon-apigateway-integration": {
          "$ref": "#/components/x-amazon-apigateway-integrations/api"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateScanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/CreateScan"
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/orgs/{organizationId}/scans/{id}": {
      "parameters": [
        {
          "name": "organizationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$"
          },
          "style": "simple"
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$"
          },
          "style": "simple"
        }
      ],
      "get": {
        "operationId": "getScan",
        "summary": "Returns a single scan belonging to the organization.\n",
        "security": [
          {
            "CreateScanAuthorizer": []
          }
        ],
        "x-bg-scopes": [
          "api.platform.bodygram.com/scans:read"
        ],
        "x-amazon-apigateway-integration": {
          "$ref": "#/components/x-amazon-apigateway-integrations/api"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/GetScan"
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      },
      "patch": {
        "operationId": "updateScan",
        "summary": "Update properties of an existing scan.\n",
        "security": [
          {
            "GeneralAuthorizer": []
          }
        ],
        "x-bg-scopes": [
          "api.platform.bodygram.com/scans:update"
        ],
        "x-amazon-apigateway-integration": {
          "$ref": "#/components/x-amazon-apigateway-integrations/api"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateScanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      },
      "delete": {
        "operationId": "deleteScan",
        "summary": "Deletes a scan belonging to the organization.\n",
        "security": [
          {
            "GeneralAuthorizer": []
          }
        ],
        "x-bg-scopes": [
          "api.platform.bodygram.com/scans:delete"
        ],
        "x-amazon-apigateway-integration": {
          "$ref": "#/components/x-amazon-apigateway-integrations/api"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/DeleteScan"
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/orgs/{organizationId}/scans/{id}/adjust": {
      "parameters": [
        {
          "name": "organizationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$"
          },
          "style": "simple"
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$"
          },
          "style": "simple"
        }
      ],
      "post": {
        "operationId": "adjustScan",
        "summary": "Adjust body parameters of an existing scan to create a new scan.\n",
        "security": [
          {
            "GeneralAuthorizer": []
          }
        ],
        "x-bg-scopes": [
          "api.platform.bodygram.com/scans:create"
        ],
        "x-amazon-apigateway-integration": {
          "$ref": "#/components/x-amazon-apigateway-integrations/api"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdjustScanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/AdjustScan"
          },
          "default": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    }
  },
  "components": {
    "x-amazon-apigateway-integrations": {
      "api": {
        "uri": "arn:aws:apigateway:ap-northeast-1:lambda:path/2015-03-31/functions/arn:aws:lambda:ap-northeast-1:123456789012:function:Populated-From-CDK/invocations",
        "passthroughBehavior": "when_no_match",
        "httpMethod": "POST",
        "type": "aws_proxy"
      }
    },
    "schemas": {
      "CreateScanTokenRequest": {
        "description": "A request for creating a new Scan token",
        "required": [
          "scope"
        ],
        "properties": {
          "customScanId": {
            "description": "Customer supplied value to associate with this scan (such as a unique identifier).",
            "type": "string",
            "maxLength": 512,
            "example": "customId123456"
          },
          "lifetime": {
            "type": "number",
            "description": "The number of seconds the token will be valid for (default of 31536000 which is equivalent to 1 year). \nThis value is ignored if not authorizing using an API key, in which the token lifetime will always \nbe set to 10 minutes.\n",
            "example": 3600
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "api.platform.bodygram.com/scans:create",
                "api.platform.bodygram.com/scans:read"
              ]
            }
          }
        }
      },
      "CreateKeyRequest": {
        "description": "A request for creating a new API Key belonging to an organization.",
        "required": [
          "description",
          "scopes"
        ],
        "properties": {
          "description": {
            "description": "Customer supplied description defining the purpose of the key",
            "type": "string",
            "maxLength": 256,
            "example": "API key used for interacting with Bodygram Platform APIs"
          },
          "scopes": {
            "type": "array",
            "description": "The scopes this API key has permissions for.",
            "items": {
              "type": "string",
              "description": "A scope this API key has permission for.",
              "maxLength": 256,
              "example": "api.platform.bodygram.com/scans:read"
            }
          }
        }
      },
      "CreateScanRequest": {
        "type": "object",
        "description": "A request for a new scan",
        "properties": {
          "customScanId": {
            "description": "Customer supplied value to associate with this scan (such as a unique identifier).",
            "type": "string",
            "maxLength": 512,
            "example": "customId123456"
          },
          "photoScan": {
            "$ref": "#/components/schemas/CreateScanRequestPhotoFields"
          },
          "noStatsPhotoScan": {
            "$ref": "#/components/schemas/CreateScanRequestNoStatsPhotoFields"
          },
          "noWeightPhotoScan": {
            "$ref": "#/components/schemas/CreateScanRequestNoWeightPhotoFields"
          },
          "statsEstimations": {
            "$ref": "#/components/schemas/CreateScanRequestStatsFields"
          }
        }
      },
      "CreateScanRequestStatsFields": {
        "description": "A request for a new scan using stats generation methodology.",
        "required": [
          "age",
          "weight",
          "height",
          "gender"
        ],
        "properties": {
          "age": {
            "description": "Age in years",
            "type": "integer",
            "example": 29
          },
          "weight": {
            "description": "Weight in grams",
            "type": "integer",
            "example": 75000
          },
          "height": {
            "description": "Height in millimeters",
            "type": "integer",
            "example": 1780
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          }
        }
      },
      "CreateScanRequestPhotoFields": {
        "type": "object",
        "description": "A request for a new scan using photo generation methodology.",
        "required": [
          "age",
          "weight",
          "height",
          "gender",
          "frontPhoto",
          "rightPhoto"
        ],
        "properties": {
          "age": {
            "description": "Age in years",
            "type": "integer",
            "example": 29
          },
          "weight": {
            "description": "Weight in grams",
            "type": "integer",
            "example": 75000
          },
          "height": {
            "description": "Height in millimeters",
            "type": "integer",
            "example": 1780
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "frontPhoto": {
            "description": "Base64 encoded image of the front of the body",
            "type": "string",
            "format": "byte"
          },
          "rightPhoto": {
            "description": "Base64 encoded image of the right side of the body",
            "type": "string",
            "format": "byte"
          }
        }
      },
      "CreateScanRequestNoStatsPhotoFields": {
        "description": "A photo scan that only requires photos as input, without any additional stats.",
        "type": "object",
        "required": [
          "frontPhoto",
          "rightPhoto"
        ],
        "properties": {
          "frontPhoto": {
            "description": "Base64 encoded image of the front of the body",
            "type": "string",
            "format": "byte"
          },
          "rightPhoto": {
            "description": "Base64 encoded image of the right side of the body",
            "type": "string",
            "format": "byte"
          }
        }
      },
      "CreateScanRequestNoWeightPhotoFields": {
        "description": "A photo scan that requires photos and stats as input, but does not require weight.",
        "type": "object",
        "required": [
          "height",
          "age",
          "gender",
          "frontPhoto",
          "rightPhoto"
        ],
        "properties": {
          "age": {
            "description": "Age in years",
            "type": "integer",
            "example": 29
          },
          "height": {
            "description": "Height in millimeters",
            "type": "integer",
            "example": 1780
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          },
          "frontPhoto": {
            "description": "Base64 encoded image of the front of the body",
            "type": "string",
            "format": "byte"
          },
          "rightPhoto": {
            "description": "Base64 encoded image of the right side of the body",
            "type": "string",
            "format": "byte"
          }
        }
      },
      "AdjustScanRequest": {
        "type": "object",
        "description": "A request for a new scan created by adjusting parameters of an existing scan.",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "customScanId": {
                "description": "Customer supplied value to associate with this scan (such as a unique identifier).",
                "type": "string",
                "maxLength": 512,
                "example": "customId123456"
              }
            }
          },
          {
            "$ref": "#/components/schemas/AdjustScanRequestFields"
          }
        ]
      },
      "AdjustScanRequestFields": {
        "type": "object",
        "description": "Fields describing how to adjust a scan",
        "required": [
          "parameters"
        ],
        "properties": {
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdjustScanParameter"
            }
          }
        }
      },
      "AdjustScanParameter": {
        "type": "object",
        "description": "A parameter to adjust in the base scan",
        "required": [
          "name",
          "percentage"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the parameter (weight, or a MeasurementName) to adjust.\nOnly the listed measurements can be adjusted.\n",
            "enum": [
              "weight",
              "bellyWaistGirth",
              "waistGirth",
              "bustGirth",
              "upperArmGirthR",
              "hipGirth",
              "thighGirthR",
              "calfGirthR"
            ]
          },
          "percentage": {
            "type": "number",
            "description": "The percentage to adjust the parameter by (percentage format is -100.0 to\n100.0). A zero value means that the measurement in the new scan should have the\nsame value as the measurement in the base scan -- this is different from not\nproviding a parameter for the measurement, which allows the system to scale the\nmeasurement based on how the body is changed by the parameters that are set.\n",
            "format": "float",
            "example": 10.0
          }
        }
      },
      "UpdateScanRequest": {
        "type": "object",
        "description": "A request to update properties for an existing scan",
        "properties": {
          "customScanId": {
            "description": "Customer supplied value to associate with this scan (such as a unique identifier).",
            "type": "string",
            "maxLength": 512,
            "example": "customId123456"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "An error that occurred when calling the API.",
        "required": [
          "message"
        ],
        "properties": {
          "code": {
            "description": "An short upper-snake-case error code intended for the developers building on this API.\n",
            "example": "SCAN_TOKEN_ALREADY_USED",
            "type": "string",
            "enum": [
              "UNKNOWN",
              "SCAN_TOKEN_ALREADY_USED",
              "SCAN_LINK_NOT_FOUND",
              "SCAN_LINK_EXPIRED",
              "SCAN_LINK_CANCELLED",
              "SCAN_LINK_ALREADY_USED"
            ]
          },
          "message": {
            "description": "An error message intended for the developers building on this API. \nThis property should not be considered as part of the API per se as\nthe API does not provide any guarantee on the content of the field\nnor on its existence.\n",
            "type": "string"
          }
        }
      },
      "Key": {
        "description": "An API key of an organization.",
        "type": "object",
        "required": [
          "id",
          "key",
          "description",
          "scopes",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Id of the API key",
            "example": "key_123456789012"
          },
          "key": {
            "type": "string",
            "description": "The API key",
            "example": "1y2598y4395y3245823495632495v"
          },
          "description": {
            "type": "string",
            "description": "API key description",
            "example": "API key used for MyServiceRegionEMEA"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "The scopes this key has access to",
              "example": "api.platform.bodygram.com/scans:read"
            }
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix timestamp the key was created",
            "example": "1684763105 (which is equivalent to Monday, May 22, 2023 1:45:05 PM)"
          }
        }
      },
      "Organization": {
        "description": "An organization.",
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The Identifier of the organization",
            "example": "org_123456789012"
          },
          "name": {
            "type": "string",
            "description": "The customer supplied name of the organization",
            "example": "Bodygram Japan"
          }
        }
      },
      "Member": {
        "description": "A member of an organization.",
        "type": "object",
        "required": [
          "id",
          "name",
          "organizations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The identifier of the member",
            "example": "member_123456789012"
          },
          "name": {
            "type": "string",
            "description": "The name of the member",
            "example": "John Smith"
          },
          "organizations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Organization"
            }
          }
        }
      },
      "ScanOverview": {
        "description": "Basic scan details",
        "type": "object",
        "required": [
          "id",
          "memberId",
          "status",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The identifier of the scan",
            "example": "scan_xyz789"
          },
          "status": {
            "$ref": "#/components/schemas/ScanStatus"
          },
          "customScanId": {
            "type": "string",
            "description": "The optional customer provided value associated with this scan"
          },
          "memberId": {
            "type": "string",
            "description": "The identifier of the member who created this scan",
            "example": "member_123abc"
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix timestamp the scan was created",
            "example": "1684763105 (which is equivalent to Monday, May 22, 2023 1:45:05 PM)"
          }
        }
      },
      "ScanStatus": {
        "type": "string",
        "description": "The status of the scan",
        "enum": [
          "success",
          "failure"
        ],
        "example": "success"
      },
      "Gender": {
        "description": "Gender",
        "type": "string",
        "enum": [
          "male",
          "female"
        ]
      },
      "Scan": {
        "description": "The requested JSON object.",
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "allOf": [
          {
            "$ref": "#/components/schemas/ScanOverview"
          },
          {
            "$ref": "#/components/schemas/ScanResults"
          }
        ]
      },
      "ScanResults": {
        "description": "All results produced from a scan.",
        "type": "object",
        "properties": {
          "input": {
            "$ref": "#/components/schemas/ScanInput"
          },
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unknown",
                  "noEXIF",
                  "invalidPhotoFormat",
                  "imageTooDark",
                  "imageTooBright",
                  "imageTooBlurry",
                  "faceNotDetected",
                  "personNotDetected",
                  "multiplePeopleDetected",
                  "rightPhotoFacingWrongDirection",
                  "frontPhotoNotInFrame",
                  "rightPhotoNotInFrame",
                  "frontPhotoRightArmAngle",
                  "frontPhotoLeftArmAngle",
                  "headNotInFrame",
                  "rightArmNotInFrame",
                  "leftArmNotInFrame",
                  "rightLegNotInFrame",
                  "leftLegNotInFrame",
                  "feetNotInFrame"
                ]
              }
            }
          },
          "measurements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Measurement"
            }
          },
          "bodyComposition": {
            "$ref": "#/components/schemas/BodyComposition"
          },
          "posture": {
            "$ref": "#/components/schemas/Posture"
          },
          "avatar": {
            "$ref": "#/components/schemas/Avatar"
          },
          "outputStats": {
            "$ref": "#/components/schemas/OutputStats"
          }
        }
      },
      "ScanInput": {
        "description": "The input used for the scan.",
        "type": "object",
        "properties": {
          "photoScan": {
            "$ref": "#/components/schemas/CreateScanRequestPhotoFields"
          },
          "noStatsPhotoScan": {
            "$ref": "#/components/schemas/CreateScanRequestNoStatsPhotoFields"
          },
          "noWeightPhotoScan": {
            "$ref": "#/components/schemas/CreateScanRequestNoWeightPhotoFields"
          },
          "statsEstimations": {
            "$ref": "#/components/schemas/CreateScanRequestStatsFields"
          },
          "adjustedScan": {
            "$ref": "#/components/schemas/AdjustedScanInputFields"
          }
        }
      },
      "AdjustedScanInputFields": {
        "description": "The input that was used to create an adjusted scan. Note that this is expanded\nfrom what was provided in the AdjustScanRequest, because it contains information\nthat was determined from the base scan.\n",
        "type": "object",
        "allOf": [
          {
            "type": "object",
            "required": [
              "baseScanId",
              "baseScanType",
              "age",
              "weight",
              "height",
              "gender"
            ],
            "properties": {
              "baseScanId": {
                "type": "string",
                "description": "The identifier of the scan to adjust",
                "example": "scan_xyz789"
              },
              "baseScanType": {
                "type": "string",
                "enum": [
                  "photo",
                  "stats"
                ],
                "description": "The type of the base scan",
                "example": "photo"
              },
              "age": {
                "description": "Age in years",
                "type": "integer",
                "example": 29
              },
              "weight": {
                "description": "Weight in grams",
                "type": "integer",
                "example": 75000
              },
              "height": {
                "description": "Height in millimeters",
                "type": "integer",
                "example": 1780
              },
              "gender": {
                "$ref": "#/components/schemas/Gender"
              }
            }
          },
          {
            "$ref": "#/components/schemas/AdjustScanRequestFields"
          }
        ]
      },
      "Measurement": {
        "description": "A single body measurement.",
        "type": "object",
        "required": [
          "name",
          "value",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "acrossBackShoulderWidth",
              "backNeckHeight",
              "backNeckPointToGroundContoured",
              "backNeckPointToWaist",
              "backNeckPointToWristLengthR",
              "bellyWaistDepth",
              "bellyWaistGirth",
              "bellyWaistHeight",
              "bellyWaistWidth",
              "bustGirth",
              "bustHeight",
              "calfGirthR",
              "forearmGirthR",
              "hipGirth",
              "hipHeight",
              "insideLegHeight",
              "insideLegLengthR",
              "kneeGirthR",
              "kneeHeightR",
              "midThighGirthR",
              "neckBaseGirth",
              "neckGirth",
              "outerAnkleHeightR",
              "outerArmLengthR",
              "outseamR",
              "outsideLegLengthR",
              "shoulderToElbowR",
              "thighGirthR",
              "topHipGirth",
              "topHipHeight",
              "underBustGirth",
              "upperArmGirthR",
              "waistGirth",
              "waistHeight",
              "wristGirthR"
            ],
            "description": "The name of the measurement",
            "example": "height"
          },
          "value": {
            "type": "number",
            "description": "The numeric value of the measurement",
            "example": 1780
          },
          "unit": {
            "type": "string",
            "enum": [
              "mm"
            ],
            "description": "The unit of the measurement",
            "example": "mm"
          }
        }
      },
      "BodyComposition": {
        "type": "object",
        "required": [
          "skeletalMuscleMass",
          "bodyFatPercentage"
        ],
        "properties": {
          "skeletalMuscleMass": {
            "type": "integer",
            "description": "The skeletal muscle mass expressed in grams",
            "example": 35250
          },
          "bodyFatPercentage": {
            "type": "number",
            "description": "The amount of body fat expressed as percentage",
            "example": 25.45
          }
        }
      },
      "Posture": {
        "type": "object",
        "required": [
          "front",
          "right"
        ],
        "properties": {
          "front": {
            "$ref": "#/components/schemas/FrontPosture"
          },
          "right": {
            "$ref": "#/components/schemas/RightPosture"
          }
        }
      },
      "FrontPosture": {
        "type": "object",
        "required": [
          "angles",
          "lines"
        ],
        "properties": {
          "angles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "value",
                "unit"
              ],
              "properties": {
                "name": {
                  "$ref": "#/components/schemas/PostureFrontMeasurementName"
                },
                "value": {
                  "type": "number",
                  "description": "The value of the angle in degrees",
                  "example": 15.2
                },
                "unit": {
                  "$ref": "#/components/schemas/AngleUnit"
                }
              }
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "points"
              ],
              "properties": {
                "name": {
                  "$ref": "#/components/schemas/PostureFrontMeasurementName"
                },
                "points": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PosturePoint"
                  }
                }
              }
            }
          }
        }
      },
      "RightPosture": {
        "type": "object",
        "required": [
          "angles",
          "lines"
        ],
        "properties": {
          "angles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "angles",
                "unit"
              ],
              "properties": {
                "name": {
                  "$ref": "#/components/schemas/PostureRightMeasurementName"
                },
                "angles": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "example": 12.5
                  }
                },
                "unit": {
                  "$ref": "#/components/schemas/AngleUnit"
                }
              }
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "points"
              ],
              "properties": {
                "name": {
                  "$ref": "#/components/schemas/PostureRightMeasurementName"
                },
                "points": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PosturePoint"
                  }
                }
              }
            }
          }
        }
      },
      "PostureFrontMeasurementName": {
        "type": "string",
        "enum": [
          "ear",
          "shoulder",
          "topHip",
          "foot"
        ]
      },
      "AngleUnit": {
        "type": "string",
        "enum": [
          "degrees",
          "radians"
        ]
      },
      "PosturePoint": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number",
            "description": "The x coordinate of the point",
            "example": 0.5
          },
          "y": {
            "type": "number",
            "description": "The y coordinate of the point",
            "example": 0.5
          }
        }
      },
      "PostureRightMeasurementName": {
        "type": "string",
        "enum": [
          "bodyLine",
          "backWaistLine"
        ]
      },
      "Avatar": {
        "type": "object",
        "required": [
          "data",
          "type",
          "format"
        ],
        "properties": {
          "data": {
            "type": "string",
            "description": "Avatar data in specified format, base64 encoded"
          },
          "type": {
            "type": "string",
            "description": "The type of the avatar",
            "enum": [
              "highResolution"
            ]
          },
          "format": {
            "type": "string",
            "description": "The format of the avatar",
            "enum": [
              "obj"
            ]
          }
        }
      },
      "OutputStats": {
        "description": "Stats that are produced by the scan. These are either stats whose value changed from the input stats as a\nresult of the scan, or stats that were not provided in the input stats, but were inferred by the scan.\n",
        "type": "object",
        "properties": {
          "weight": {
            "description": "Weight in grams, if the output weight is different from the weight provided in the scan input.",
            "type": "integer",
            "example": 75000
          },
          "inferred": {
            "description": "Stats that were not provided in the scan input, but were inferred by BGP.",
            "$ref": "#/components/schemas/InferredOutputStats"
          }
        }
      },
      "InferredOutputStats": {
        "type": "object",
        "properties": {
          "weight": {
            "description": "Weight in grams",
            "$ref": "#/components/schemas/InferredIntValue"
          },
          "height": {
            "description": "Height in millimeters",
            "$ref": "#/components/schemas/InferredIntValue"
          },
          "age": {
            "description": "Age in years",
            "$ref": "#/components/schemas/InferredIntValue"
          },
          "gender": {
            "$ref": "#/components/schemas/InferredGender"
          }
        }
      },
      "InferredIntValue": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "description": "Inferred value",
            "type": "integer"
          },
          "confidenceScore": {
            "description": "Confidence score in (0, 1] for the inferred value. If omitted, treat as 1.0",
            "type": "number",
            "format": "float",
            "example": 0.75
          }
        }
      },
      "InferredGender": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "$ref": "#/components/schemas/Gender"
          },
          "confidenceScore": {
            "description": "Confidence score in (0, 1] for the inferred value. If omitted, treat as 1.0",
            "type": "number",
            "format": "float",
            "example": 0.75
          }
        }
      },
      "PaginationInfo": {
        "type": "object",
        "properties": {
          "nextOffsetId": {
            "type": "string",
            "example": "scan_xyz789",
            "description": "ID of the last element on this page. Pass it as the offsetId in your query to see the next page."
          }
        }
      }
    },
    "responses": {
      "GetAccount": {
        "description": "Response from fetching my user profile.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Member"
            }
          }
        }
      },
      "DeleteAccount": {
        "description": "Deleted account successfully",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The ID of the deleted member",
                  "example": "member_123456789012"
                }
              }
            }
          }
        }
      },
      "CreateScanToken": {
        "description": "Response from creating a new scan token",
        "content": {
          "application/json": {
            "schema": {
              "description": "The scan token response",
              "type": "object",
              "required": [
                "token"
              ],
              "properties": {
                "token": {
                  "type": "string",
                  "description": "The token to send when performing a scan."
                },
                "expiresAt": {
                  "type": "integer",
                  "description": "Unix timestamp the token will expire at, only if a lifetime was provided in the request. If omitted, the token will never expire.",
                  "example": 1684763105
                }
              }
            }
          }
        }
      },
      "ListKeys": {
        "description": "A list of all api keys in an organization",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/PaginationInfo"
                },
                {
                  "required": [
                    "results"
                  ]
                },
                {
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Key"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "CreateKey": {
        "description": "Response from creating a new key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Key"
            }
          }
        }
      },
      "DeleteKey": {
        "description": "Response from deleting a key.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "description": "The ID of the deleted key",
                  "type": "string",
                  "example": "1y2598y4395y3245823495632495v"
                }
              }
            }
          }
        }
      },
      "CreateScan": {
        "description": "The created entry.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "entry": {
                  "$ref": "#/components/schemas/Scan"
                }
              }
            }
          }
        }
      },
      "AdjustScan": {
        "description": "The scan created by adjusting a scan.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "entry": {
                  "$ref": "#/components/schemas/Scan"
                }
              }
            }
          }
        }
      },
      "ListScans": {
        "description": "A list of all scans",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/PaginationInfo"
                },
                {
                  "required": [
                    "results"
                  ]
                },
                {
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ScanOverview"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "GetScan": {
        "description": "The requested entry.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "entry"
              ],
              "properties": {
                "entry": {
                  "$ref": "#/components/schemas/Scan"
                }
              }
            }
          }
        }
      },
      "DeleteScan": {
        "description": "Response from deleting a scan.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "description": "The ID of the deleted scan",
                  "type": "string",
                  "example": "scan_xyz789"
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "description": "Error response.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "parameters": {
      "PaginationAfter": {
        "name": "after",
        "in": "query",
        "schema": {
          "type": "string",
          "example": "scan_xyz789"
        },
        "description": "Optional parameter for pagination. IDs after this ID will appear."
      },
      "PaginationLimit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 100
        },
        "description": "Max number of items that will be returned in a single request."
      }
    },
    "securitySchemes": {
      "GeneralAuthorizer": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "The value of this header should be an API key belonging to your organisation\n",
        "x-amazon-apigateway-authtype": "token",
        "x-amazon-apigateway-authorizer": {
          "type": "token",
          "authorizerUri": "arn:aws:cognito-idp:ap-northeast-1:123456789012:userpool/Populated-From-CDK",
          "authorizerCredentials": "arn:aws:iam::123456789012:IAM_role",
          "identitySource": "method.request.header.Authorization",
          "enableSimpleResponses": false,
          "authorizerResultTtlInSeconds": 0
        }
      },
      "CreateScanAuthorizer": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "The value of this header should be one of:\n* the ID token obtained from the Cognito User Pool\n* An API Key\n* A Scan token\n",
        "x-amazon-apigateway-authtype": "token",
        "x-amazon-apigateway-authorizer": {
          "type": "token",
          "authorizerUri": "arn:aws:cognito-idp:ap-northeast-1:123456789012:userpool/Populated-From-CDK",
          "authorizerCredentials": "arn:aws:iam::123456789012:IAM_role",
          "identitySource": "method.request.header.Authorization",
          "enableSimpleResponses": false,
          "authorizerResultTtlInSeconds": 0
        }
      }
    }
  }
}
