              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "short_message": {
                  "type": "string"
                },
                "context": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "length": {
                      "type": "integer"
                    }
                  }
                },
                "replacements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rule_id": {
                  "type": "string"
                },
                "rule_desc": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                }
              }
            }
          },
          "correction_count": {
            "type": "integer"
          }
        }
      },
      "RedactResult": {
        "type": "object",
        "properties": {
          "original_length": {
            "type": "integer"
          },
          "redacted": {
            "type": "string"
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "example": {
              "phone": 1,
              "email": 2
            }
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "phone"
                },
                "value": {
                  "type": "string"
                },
                "offset": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
