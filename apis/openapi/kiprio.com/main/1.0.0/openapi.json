{
  "openapi": "3.0.3",
  "info": {
    "title": "Kiprio API",
    "description": "30+ utility APIs for domain intelligence, email validation, SSL inspection, image generation, content processing, and more. Free tier included — no credit card required.\n\nBase URL: `https://kiprio.com/v1`\n\nAuthentication: Pass your API key in the `X-API-Key` header. Get a free key at https://kiprio.com/signup",
    "version": "1.0.0",
    "contact": {
      "name": "Kiprio",
      "url": "https://kiprio.com",
      "email": "support@kiprio.com"
    },
    "license": {
      "name": "Commercial",
      "url": "https://kiprio.com/terms"
    },
    "x-logo": {
      "url": "https://kiprio.com/logo.png"
    },
    "x-jentic-source-url": "https://kiprio.com/openapi.json"
  },
  "servers": [
    {
      "url": "https://kiprio.com/v1",
      "description": "Production"
    }
  ],
  "paths": {
    "/whois": {
      "get": {
        "tags": [
          "Domain"
        ],
        "summary": "WHOIS lookup",
        "description": "Returns domain registration data including registrar, expiry date, nameservers, and status. Uses RDAP with port-43 fallback for maximum TLD coverage.",
        "operationId": "whoisLookup",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "example.com"
            },
            "description": "Domain name to look up"
          }
        ],
        "responses": {
          "200": {
            "description": "WHOIS data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoisResult"
                },
                "example": {
                  "domain": "example.com",
                  "registered": true,
                  "registrar": "RESERVED-Internet Assigned Numbers Authority",
                  "status": [
                    "client delete prohibited"
                  ],
                  "created": "1995-08-14T04:00:00Z",
                  "updated": "2023-08-14T07:01:34Z",
                  "expires": "2024-08-13T04:00:00Z",
                  "nameservers": [
                    "a.iana-servers.net",
                    "b.iana-servers.net"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/dns-lookup": {
      "get": {
        "tags": [
          "Domain"
        ],
        "summary": "DNS records lookup",
        "description": "Returns DNS records for a domain. Supports A, AAAA, MX, TXT, CNAME, NS, SOA, and PTR record types.",
        "operationId": "dnsLookup",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "example.com"
            },
            "description": "Domain to look up"
          },
          {
            "name": "types",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "A,MX,TXT",
              "default": "A,AAAA,MX,TXT,CNAME,NS"
            },
            "description": "Comma-separated list of record types to fetch"
          }
        ],
        "responses": {
          "200": {
            "description": "DNS records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DnsResult"
                },
                "example": {
                  "domain": "example.com",
                  "records": {
                    "A": [
                      {
                        "value": "93.184.216.34",
                        "ttl": 3600
                      }
                    ],
                    "MX": [
                      {
                        "value": "mail.example.com",
                        "priority": 10,
                        "ttl": 3600
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/ssl": {
      "get": {
        "tags": [
          "Domain"
        ],
        "summary": "SSL certificate inspection",
        "description": "Returns SSL certificate details including issuer, expiry date, SANs, cipher, and TLS protocol. Flags certificates expiring within 30 days.",
        "operationId": "sslCheck",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "example.com"
            },
            "description": "Domain to inspect"
          },
          {
            "name": "port",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 443,
              "example": 443
            },
            "description": "Port to connect on"
          }
        ],
        "responses": {
          "200": {
            "description": "SSL certificate data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SslResult"
                },
                "example": {
                  "domain": "example.com",
                  "valid": true,
                  "issuer": "DigiCert Inc",
                  "subject": "example.com",
                  "sans": [
                    "example.com",
                    "www.example.com"
                  ],
                  "expires_at": "2025-01-15T12:00:00Z",
                  "days_remaining": 180,
                  "protocol": "TLSv1.3",
                  "grade": "A",
                  "cipher": "TLS_AES_256_GCM_SHA384"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/email-validate": {
      "get": {
        "tags": [
          "Email"
        ],
        "summary": "Email address validation",
        "description": "Validates an email address by checking syntax, MX record existence, disposable email detection, role-based address detection, and free provider identification.",
        "operationId": "emailValidate",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email",
              "example": "user@example.com"
            },
            "description": "Email address to validate"
          }
        ],
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailValidateResult"
                },
                "example": {
                  "email": "user@example.com",
                  "valid": true,
                  "syntax_ok": true,
                  "mx_found": true,
                  "disposable": false,
                  "free_provider": false,
                  "role_based": false,
                  "suggest": null,
                  "confidence": 0.95
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/ip": {
      "get": {
        "tags": [
          "IP"
        ],
        "summary": "IP geolocation",
        "description": "Returns geolocation and network data for an IP address. Omit the `ip` parameter to look up the caller's IP.",
        "operationId": "ipLookup",
        "security": [],
        "parameters": [
          {
            "name": "ip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "8.8.8.8"
            },
            "description": "IP address to look up. Omit for caller's IP."
          }
        ],
        "responses": {
          "200": {
            "description": "IP geolocation data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpResult"
                },
                "example": {
                  "ip": "8.8.8.8",
                  "country": "United States",
                  "country_code": "US",
                  "city": "Mountain View",
                  "latitude": 37.386,
                  "longitude": -122.0838,
                  "timezone": "America/Los_Angeles",
                  "org": "AS15169 Google LLC",
                  "asn": "AS15169"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/qr": {
      "get": {
        "tags": [
          "Generate"
        ],
        "summary": "QR code generator",
        "description": "Generates a QR code as PNG or SVG. No API key required for demo usage.",
        "operationId": "qrGenerate",
        "security": [],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "https://example.com"
            },
            "description": "Text or URL to encode"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 512,
              "minimum": 128,
              "maximum": 2048
            },
            "description": "Output size in pixels (PNG) or viewBox units (SVG)"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "png",
                "svg"
              ],
              "default": "png"
            },
            "description": "Output format"
          },
          {
            "name": "ec_level",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "L",
                "M",
                "Q",
                "H"
              ],
              "default": "M"
            },
            "description": "Error correction level"
          },
          {
            "name": "fg",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "#000000",
              "example": "#000000"
            },
            "description": "Foreground colour (hex)"
          },
          {
            "name": "bg",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "#ffffff",
              "example": "#ffffff"
            },
            "description": "Background colour (hex)"
          }
        ],
        "responses": {
          "200": {
            "description": "QR code image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/grammar": {
      "post": {
        "tags": [
          "Content"
        ],
        "summary": "Grammar and spell check",
        "description": "Checks text for grammar errors, spelling mistakes, and style issues. Returns a list of corrections with context and suggested replacements.",
        "operationId": "grammarCheck",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "example": "Teh cat sat on teh mat.",
                    "description": "Text to check"
                  },
                  "language": {
                    "type": "string",
                    "default": "en-US",
                    "example": "en-GB",
                    "description": "BCP 47 language tag"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Grammar check results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GrammarResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/redact": {
      "post": {
        "tags": [
          "Content"
        ],
        "summary": "PII redaction",
        "description": "Detects and redacts personally identifiable information (PII) from text. Supports names, email addresses, phone numbers, UK postcodes, NHS numbers, and credit card numbers.",
        "operationId": "redactPii",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "example": "Call John on 07911 123456 or email john@example.com",
                    "description": "Text to redact"
                  },
                  "redact": {
                    "type": "string",
                    "example": "phone,email",
                    "description": "Comma-separated PII types to redact. Omit for all types."
                  },
                  "entities": {
                    "type": "boolean",
                    "default": false,
                    "description": "Include detected entity positions in response"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redacted text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedactResult"
                },
                "example": {
                  "original_length": 50,
                  "redacted": "Call [NAME] on [PHONE] or email [EMAIL]",
                  "counts": {
                    "phone": 1,
                    "email": 1
                  },
                  "entities": [
                    {
                      "type": "phone",
                      "value": "07911 123456",
                      "offset": 15
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/barcode": {
      "get": {
        "tags": [
          "Generate"
        ],
        "summary": "Barcode generator",
        "description": "Generates 1D barcodes in multiple formats. Returns SVG or PNG.",
        "operationId": "barcodeGenerate",
        "security": [],
        "parameters": [
          {
            "name": "data",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "HELLO123"
            },
            "description": "Data to encode"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "code128",
                "ean13",
                "ean8",
                "upca",
                "code39",
                "itf"
              ],
              "default": "code128"
            },
            "description": "Barcode symbology"
          },
          {
            "name": "output",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "svg",
                "png"
              ],
              "default": "svg"
            },
            "description": "Output format"
          },
          {
            "name": "width",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 400
            },
            "description": "Output width in pixels"
          },
          {
            "name": "height",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 120
            },
            "description": "Output height in pixels"
          }
        ],
        "responses": {
          "200": {
            "description": "Barcode image",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/screenshot": {
      "get": {
        "tags": [
          "Generate"
        ],
        "summary": "Website screenshot",
        "description": "Captures a full-page screenshot of any URL. Returns a PNG image.",
        "operationId": "screenshotCapture",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri",
              "example": "https://example.com"
            },
            "description": "URL to screenshot"
          },
          {
            "name": "width",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1280
            },
            "description": "Viewport width in pixels"
          },
          {
            "name": "full_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Capture full scrollable page"
          }
        ],
        "responses": {
          "200": {
            "description": "PNG screenshot",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/hash": {
      "get": {
        "tags": [
          "Utility"
        ],
        "summary": "Hash a string",
        "description": "Returns the hash of a string using a specified algorithm. Supports MD5, SHA-1, SHA-256, SHA-384, SHA-512, SHA3-256, and SHA3-512. No API key required.",
        "operationId": "hashGet",
        "security": [],
        "parameters": [
          {
            "name": "input",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "hello world"
            },
            "description": "String to hash"
          },
          {
            "name": "algo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "md5",
                "sha1",
                "sha256",
                "sha384",
                "sha512",
                "sha3-256",
                "sha3-512"
              ],
              "default": "sha256"
            },
            "description": "Hash algorithm"
          }
        ],
        "responses": {
          "200": {
            "description": "Hash result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "string"
                    },
                    "algo": {
                      "type": "string"
                    },
                    "hash": {
                      "type": "string"
                    },
                    "length": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/robots-txt": {
      "get": {
        "tags": [
          "Domain"
        ],
        "summary": "robots.txt parser",
        "description": "Fetches and parses the robots.txt file for any domain. Returns crawl rules, sitemap URLs, and per-agent directives.",
        "operationId": "robotsTxtParse",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "https://example.com"
            },
            "description": "Domain URL to fetch robots.txt from"
          }
        ],
        "responses": {
          "200": {
            "description": "Parsed robots.txt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "sitemaps": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "agents": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "allow": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "disallow": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WhoisResult": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "example": "example.com"
          },
          "registered": {
            "type": "boolean",
            "nullable": true
          },
          "registrar": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "updated": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expires": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "nameservers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DnsResult": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "records": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "ttl": {
                    "type": "integer"
                  },
                  "priority": {
                    "type": "integer",
                    "description": "MX/SRV priority"
                  }
                }
              }
            }
          }
        }
      },
      "SslResult": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "valid": {
            "type": "boolean"
          },
          "issuer": {
            "type": "string",
            "nullable": true
          },
          "subject": {
            "type": "string",
            "nullable": true
          },
          "sans": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "days_remaining": {
            "type": "integer"
          },
          "protocol": {
            "type": "string",
            "example": "TLSv1.3",
            "nullable": true
          },
          "grade": {
            "type": "string",
            "example": "A"
          },
          "cipher": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EmailValidateResult": {
