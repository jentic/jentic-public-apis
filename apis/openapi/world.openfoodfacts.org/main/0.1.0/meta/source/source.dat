{
  "openapi": "3.1.0",
  "info": {
    "title": "Open Food Facts API (public)",
    "version": "0.1.0",
    "description": "Unofficial OpenAPI 3.1 spec for key public Open Food Facts endpoints. Covers the commonly used read endpoints. Some less-common endpoints may be missing because the upstream OpenAPI source could not be fetched in this environment.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Romado332/open-food-facts-api-public/0.1.0"
  },
  "servers": [
    {
      "url": "https://world.openfoodfacts.org"
    },
    {
      "url": "https://world.openfoodfacts.net"
    }
  ],
  "paths": {
    "/api/v2/product/{barcode}": {
      "get": {
        "summary": "Get a product by barcode (v2)",
        "parameters": [
          {
            "name": "barcode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Product barcode (e.g., EAN/UPC)"
          },
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated list of fields to include"
          },
          {
            "name": "lc",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Language code for localized fields"
          },
          {
            "name": "cc",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Country code context"
          }
        ],
        "responses": {
          "200": {
            "description": "Product response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductV2Response"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/search": {
      "get": {
        "summary": "Search products (v2)",
        "parameters": [
          {
            "name": "search_terms",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Free-text search query"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated fields projection"
          },
          {
            "name": "sort_by",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sort key (implementation-defined)"
          },
          {
            "name": "lc",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cc",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchV2Response"
                }
              }
            }
          }
        }
      }
    },
    "/api/v3/product/{barcode}": {
      "get": {
        "summary": "Get a product by barcode (v3)",
        "parameters": [
          {
            "name": "barcode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lc",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cc",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductV3Response"
                }
              }
            }
          }
        }
      }
    },
    "/api/v3/search": {
      "get": {
        "summary": "Search products (v3)",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Free-text query"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "fields",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lc",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cc",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchV3Response"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductV2Response": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "description": "0/1 status"
          },
          "code": {
            "type": "string"
          },
          "product": {
            "type": "object",
            "additionalProperties": true
          },
          "status_verbose": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "SearchV2Response": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "ProductV3Response": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "product": {
            "type": "object",
            "additionalProperties": true
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "SearchV3Response": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "security": []
