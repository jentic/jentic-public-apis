      "post": {
        "tags": [
          "Notification"
        ],
        "summary": "Register",
        "description": "Register",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_id": {
                    "type": "string",
                    "example": "unique_device_456"
                  },
                  "device_type": {
                    "type": "string",
                    "example": "ios"
                  },
                  "fcm_token": {
                    "type": "string",
                    "example": "e7hbasd-2i3ihdsufuyqiu3eghhjksdbcjkbhasjkdfrgh3223KYqd"
                  }
                }
              },
              "examples": {
                "135. editBillingAddress": {
                  "value": {
                    "account_type": 1,
                    "city": "New York",
                    "first_name": "John",
                    "id": 1,
                    "last_name": "Doe",
                    "postal_code": "10001",
                    "state": "NY",
                    "street": "123 Main Street",
                    "vat_number": "VAT123456789"
                  }
                },
                "138. saveDefaultBillingPaymentMethod": {
                  "value": {
                    "payment_method_id": 1
                  }
                },
                "Accept TeamMember Request": {
                  "value": {
                    "request_id": 11,
                    "response_message": "Full"
                  }
                },
                "Add Appointment Overview Service": {
