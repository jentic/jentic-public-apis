                    "type": "string",
                    "example": "[{\"id\":1,\"title\":\"Processing time\",\"description\":\"Team member becomes available during processing time. Included in duration shown to clients\",\"duration_type\":\"Processing time\",\"duration_time\":\"10min\"},{\"id\":1,\"title\":\"Processing time\",\"description\":\"Team member becomes available during processing time. Included in duration shown to clients\",\"duration_type\":\"Processing time\",\"duration_time\":\"1h 5min\"},{\"id\":2,\"title\":\"Blocked time\",\"description\":\"Team member remains occupied during blocked time. Excluded from durations shown to clients.\",\"duration_type\":\"Blocked time\",\"duration_time\":\"10min\"},{\"id\":3,\"title\":\"Extra servicing time\",\"description\":\"Team member remains occupied during servicing time. Included in durations shown to clients\",\"duration_type\":\"Extra servicing time\",\"duration_time\":\"10min\"}]"
                  },
                  "appointment_id": {
                    "type": "number",
                    "example": 388
                  },
                  "selected_service_id": {
                    "type": "number",
                    "example": 15
                  },
                  "service_duration": {
                    "type": "string",
