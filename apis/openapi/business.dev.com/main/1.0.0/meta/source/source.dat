          "401": {
            "description": "401 Unauthorized",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-cache, private"
                }
              },
              "Connection": {
                "schema": {
                  "type": "string",
                  "example": "Keep-Alive"
                }
              },
              "Date": {
                "schema": {
                  "type": "string",
                  "example": "Tue, 11 Mar 2025 13:31:47 GMT"
                }
              },
              "Keep-Alive": {
                "schema": {
                  "type": "string",
                  "example": "timeout=5, max=100"
                }
              },
              "Server": {
                "schema": {
                  "type": "string",
                  "example": "Apache/2.4.41 (Ubuntu)"
                }
              },
              "Transfer-Encoding": {
                "schema": {
                  "type": "string",
                  "example": "chunked"
                }
              },
              "Vary": {
                "schema": {
                  "type": "string",
                  "example": "Authorization"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Unauthenticated."
                    }
                  }
                },
                "examples": {
                  "401 Unauthorized": {
                    "value": {
                      "message": "Unauthenticated."
                    }
                  }
                }
              }
            }
          }
        }
      }
