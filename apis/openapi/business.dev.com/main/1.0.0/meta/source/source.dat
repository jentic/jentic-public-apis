                    "business_id": 13,
                    "description": "Christmas Day",
                    "end_date": "2024-12-25",
                    "start_date": "2024-12-25"
                  }
                },
                "Add Calender Filter": {
                  "value": "{\n    \"business_id\": 13,\n    \"filter_name\": \"My Filter\",\n    \"appointment_status\": [1],    // PENDING, CONFIRMED, CANCELLED, COMPLETED\n    \"appointment_type\": [1, 2],   // SINGLE GROUP\n    \"payment_status\": [1, 2],     //  UNPAID,PAID\n    \"services\": [65],            // Array of service I\n    \"appointment_date\": 1,         // anytime, today. last 24 hr, more than days\n    \"requested_team_member\": [1, 2]  //requested , not requested at time of b\n    //\"is_from_single_team\": true,    // true for single team view, false for all teams\n    //\"team_member_id\": 1   // Optional: Filter by specific team member\n}\n"
