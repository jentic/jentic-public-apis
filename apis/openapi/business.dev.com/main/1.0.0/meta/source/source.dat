                  },
                  "service_id": {
                    "type": "number",
                    "example": 48
                  },
                  "service_price": {
                    "type": "string",
                    "example": "75.00"
                  },
                  "service_start_time": {
                    "type": "string",
                    "example": "14:00"
                  },
                  "team_member_id": {
                    "type": "number",
                    "example": 3
                  }
