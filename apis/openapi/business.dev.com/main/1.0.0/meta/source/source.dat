                },
                "Add New Package": {
                  "value": "{\n    \"service_name\": \"package service\",\n    \"business_id\": 13,\n    \"service_category_id\": 3,\n    \"description\": \"Stylish Hair cut\",\n    \"package_service_id\": [5,6,7],\n    \"package_schedule_type\": \"sequence\", //'sequence', 'parallel', \n    \"package_price_type\": \"service\", // \"service,custom,percentag,free\"\n    \"package_onlinebooking\": true,\n    \"package_available_for\": \"all\",  // \"all/male,female\"   \n    \"duration\": 120,\n    \"price\": 2000,\n    \"price_type\": \"from\",\n    \"isfeatured\": true\n}"
                },
                "Add New Service From Menu": {
                  "value": "{\n    \"service_name\": \"Tapper hair Cut\",\n    \"business_id\": 13,\n    \"service_type_id\": 1,\n    \"service_category_id\": 8,\n    \"service_tag_id\": 15,\n    \"description\": \"Stylish Hair cut\",\n    \"duration\": 120,\n    \"price\": 2000,\n    \"price_type\": \"from\",\n    \"isfeatured\": true,\n    \"team_member\": [\n        1,\n        2\n    ],\n    \"patch_test\": true,\n    \"after_care_instruction\": true,\n    \"after_care_instruction_description\": \"Test\", //if after_care_instruction is true\n    \"reminder_rebook\": true,\n    \"reminder_count\": \"4\", //if reminder_rebook is true\n    \"reminder_type\": \"Weeks after\", //if reminder_rebook is true\n    \"sales_tax\": \"Test\",\n    \"cost_service\": \"5.00\",\n    \"sku\": \"ABC+123+F+SF\"\n}"
