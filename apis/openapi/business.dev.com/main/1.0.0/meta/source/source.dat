  "paths": {
    "/": {
      "get": {
        "tags": [
          "Billing Details"
        ],
        "summary": "Get Profile",
        "description": "Returns the profile of the currently logged-in user.",
        "operationId": "getProfile",
        "parameters": [
          {
            "name": "include",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "roles,roles.permissions"
            },
            "description": "Includes the specified relations for the requested user. Possible values: roles,roles.permissions ."
          },
          {
            "name": "fields[users]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "name,email,profile_image"
            },
            "description": "Only returns the specified user attributes."
          },
          {
            "name": "fields[roles]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "name"
            },
            "description": "Only returns the specified role relationship attributes."
          },
          {
            "name": "fields[permissions]",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "name"
            },
            "description": "Only returns the specified permission relationship attributes."
          },
          {
            "name": "ln",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "{{ln}}"
            }
          },
          {
            "name": "business_id",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "13"
            },
            "description": "ID of the business"
          },
          {
            "name": "token",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "eqxqhBBpyE8quobbJWe9er:APA91bGe-4qGzoq8UnLXH5H3-dybrI1CvjGzgHXnKBI2XhAm1aaYZJgHjL0-adrAx1dvsHFzmEJE43VF4t4fPvMt5phRaW9QFSqF9UU2xGROtWMVnl0LCd0"
            }
          },
          {
            "name": "image_url",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "https://cdn.pixabay.com/photo/2014/06/03/19/38/board-361516_1280.jpg"
            }
          },
          {
            "name": "apikey",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "5LTnyUIFs38DlEgS5Gl5z7ekHDCj8Slo"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rating": {
                    "type": "number",
                    "example": 0
                  }
                }
              },
              "examples": {
                "Get All Saloon": {
                  "value": ""
                },
                "Get All Service Type": {
                  "value": {
                    "search_type": "Beard"
                  }
                },
                "Get All Services List": {
                  "value": {
                    "business_id": 13,
                    "search_service": "",
                    "status": 1,
                    "team_member": 0,
                    "type": 1
                  }
                },
                "Get All Teammember": {
                  "value": ""
                },
                "Get Booking Order": {
                  "value": ""
                },
                "Get CalenderFilter": {
                  "value": {
                    "business_id": 13
                  }
                },
                "Get Discount Vouchers": {
                  "value": ""
                },
                "Get Gift Cards": {
                  "value": ""
                },
                "Get Memberships": {
                  "value": ""
                },
                "Get My Booked/Optedin Offers": {
                  "value": ""
                },
                "Get Rating/Review": {
                  "value": {
                    "rating": 0
                  }
                },
                "Get Sales Payment Methods": {
                  "value": ""
                },
                "Get Service Tags By Cat ID": {
                  "value": {
                    "category_id": 8
                  }
                },
                "Get Services Categories": {
                  "value": "{\n    // \"search_service_category\" : \"\"\n}"
                },
                "Get Time Calendar Settings": {
                  "value": ""
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / Get Memberships / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles / 200 - Get Profile Successful / 200 - Get Profile with Permissions / 200 - Get Profile with Roles",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-cache, private"
                }
              },
              "Connection": {
                "schema": {
                  "type": "string",
                  "example": "Keep-Alive"
                }
              },
              "Content-Length": {
                "schema": {
                  "type": "string",
                  "example": "1121"
                }
              },
              "Date": {
                "schema": {
                  "type": "string",
                  "example": "Wed, 03 Jun 2020 11:27:26 GMT"
                }
              },
              "Keep-Alive": {
                "schema": {
                  "type": "string",
                  "example": "timeout=5, max=99"
                }
              },
              "Server": {
                "schema": {
                  "type": "string",
                  "example": "Apache/2.4.35 (Win64) OpenSSL/1.1.1b PHP/7.2.19"
                }
              },
              "Vary": {
                "schema": {
                  "type": "string",
                  "example": "Authorization"
                }
              },
              "X-Powered-By": {
                "schema": {
                  "type": "string",
                  "example": "PHP/7.2.19"
                }
              },
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "string",
                  "example": "60"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "string",
                  "example": "58"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "attributes": {
                              "type": "object",
                              "properties": {
                                "created_at": {
                                  "type": "string",
                                  "example": "2020-01-01 00:00:00"
                                },
                                "email": {
                                  "type": "string",
                                  "example": "user@email.com"
                                },
                                "name": {
                                  "type": "string",
                                  "example": "User Name"
                                },
                                "profile_image": {
                                  "type": "string",
                                  "nullable": true,
                                  "example": null
                                },
                                "updated_at": {
                                  "type": "string",
                                  "example": "2020-01-01 00:00:00"
                                }
                              }
                            },
                            "id": {
                              "type": "string",
                              "example": "1"
                            },
                            "links": {
                              "type": "object",
                              "properties": {
                                "self": {
                                  "type": "string",
                                  "example": "http://localhost/api/v1/users/1"
                                }
                              }
                            },
                            "relationships": {
                              "type": "object",
                              "properties": {
                                "roles": {
                                  "type": "object",
                                  "properties": {
                                    "data": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "properties": {
                                          "id": {
                                            "type": "string",
                                            "example": "1"
                                          },
                                          "type": {
                                            "type": "string",
                                            "example": "roles"
                                          }
                                        }
                                      },
                                      "example": [
                                        {
                                          "id": "1",
                                          "type": "roles"
                                        }
                                      ]
                                    },
                                    "links": {
                                      "type": "object",
                                      "properties": {
                                        "related": {
                                          "type": "string",
                                          "example": "http://localhost/api/v1/users/1/roles"
                                        },
                                        "self": {
                                          "type": "string",
                                          "example": "http://localhost/api/v1/users/1/relationships/roles"
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            },
                            "type": {
                              "type": "string",
                              "example": "users"
                            }
                          }
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "background_image": {
                                "type": "string",
                                "example": "https://paadmin.kuts.io/storage/memberships/1749453627.png"
                              },
                              "best_price": {
                                "type": "string",
