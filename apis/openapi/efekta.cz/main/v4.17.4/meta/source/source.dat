      "EfektaAPIv3EntitiesAuthorizationRequestsAuthorizationRequestsResponseEntity": {
        "type": "object",
        "properties": {
          "id_auth": {
            "type": "integer",
            "description": "ID auth",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "description": "Name for the authorization request"
          },
          "description": {
            "type": "string",
            "description": "Description for the authorization request"
          },
          "uid": {
            "type": "string",
            "description": "Authorization requests UID"
          },
          "message": {
            "nullable": true,
            "type": "string",
            "description": "Message for authorization request"
          },
          "message_type": {
            "type": "string",
            "description": "Message type for authorization request"
          },
          "creator_name": {
            "type": "string",
            "description": "Name of the User who created the authorization request"
          },
          "renewable_to": {
            "type": "string",
            "description": "Datetime that represents the time left, broker has to renew the authorization request after the initial expiration of the auth request"
          },
          "allowed_to_renew": {
            "type": "boolean",
            "description": "Boolean that represents if the authorization request can be renewed"
          },
          "allowed_to_resend": {
            "type": "boolean",
            "description": "Boolean that represents if the authorization request can be resend via SMS or Email"
          },
          "date_created": {
            "type": "string",
            "format": "date-time",
            "description": "Date creation for Authorization request"
          },
          "show_documents": {
            "type": "boolean",
            "description": "Boolean that represents if the authorization request can show documents"
          },
          "documents": {
            "nullable": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EfektaAPIv3EntitiesCommonAuthorizationRequestsDocumentsResponseEntity"
            },
            "description": "Object with corresponding documents for authorization request (it is only visible if we provide partyUID)"
          },
          "party_status": {
            "nullable": true,
            "type": "string",
            "description": "Party status"
          },
          "status": {
            "type": "string",
            "description": "Party status"
          },
          "signatures": {
            "nullable": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EfektaAPIv3EntitiesAuthorizationRequestsAuthorizationRequestSignatureResponseEntity"
            },
            "description": "Array with signatures"
          },
          "parties": {
            "nullable": true,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EfektaAPIv3EntitiesCommonAuthorizationRequestPartyResponseEntity"
            },
            "description": "Array where are members of the party for the authorization request"
          },
          "authorization_mode": {
            "type": "string",
            "description": "Authorization mode"
          },
          "auth_check_url": {
            "type": "string",
            "description": "Returns an URL where the API has to check where to log user"
          },
          "active_party": {
            "nullable": true,
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name for the party member that is part of the authorization request"
              },
              "person_name": {
                "type": "string",
                "description": "Person name for the party member that is part of the authorization request"
              },
              "is_decision_person": {
                "type": "boolean",
                "description": "If the active party is also decision person for the client who is associated with the authorization request"
              },
              "person_relationship": {
                "nullable": true,
                "type": "string",
                "description": "Person Relationship"
              },
              "email": {
                "type": "string",
                "description": "Email address for the party member that is part of the authorization request"
              },
              "phone": {
                "type": "string",
                "description": "Phone number for the party member that is part of the authorization request"
              },
              "user_type": {
                "type": "string",
                "description": "Represents what type the user is for example (creator, user etc...)"
              },
              "sign_date": {
                "nullable": true,
                "type": "string",
                "description": "Date when the User/Party member signed the document",
                "format": "date-time"
              },
              "status": {
                "type": "string",
                "description": "Users party status"
              }
            },
            "required": [
              "name",
              "person_name",
              "is_decision_person",
              "email",
              "phone",
              "user_type",
              "status"
            ],
            "description": "Active party"
          }
        },
        "required": [
          "id_auth",
          "name",
          "description",
          "uid",
          "message_type",
          "creator_name",
          "renewable_to",
          "allowed_to_renew",
          "allowed_to_resend",
          "date_created",
          "show_documents",
          "status"
        ]
      },
      "EfektaAPIv3EntitiesCommonAuthorizationRequestsDocumentsResponseEntity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID for document",
            "format": "int64"
          },
          "id_user": {
            "type": "integer",
            "description": "ID for user",
            "format": "int64"
          },
          "id_user_creator": {
            "type": "integer",
            "description": "ID user creation",
            "format": "int64"
          },
          "name": {
            "type": "string",
            "description": "Document name"
          },
          "folder": {
            "type": "string",
            "description": "Folder name, where the document is located"
          },
          "file_name": {
            "type": "string",
            "description": "File name"
          },
          "file_type": {
            "type": "string",
            "description": "Type of the document for example \"pdf\""
          },
          "mimetype": {
            "type": "string",
            "description": "Documents mimetype"
          },
          "date_created": {
            "type": "string",
            "description": "Date for the document creation"
          },
          "last_change": {
            "type": "string",
            "description": "Date for the documents last change"
          },
          "attributes": {
            "nullable": true,
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Type"
              },
              "version": {
                "type": "integer",
                "description": "Version"
              },
              "visibility": {
                "type": "string",
                "description": "Visibility"
              },
              "description": {
