                    "summary": "",
                    "value": {
                      "code": 400,
                      "exception": "efekta-system-users-invalidinputexpiredexception",
                      "message": "At least one parameter must be filled in",
                      "context": "{}"
                    }
                  },
                  "More parameters needs to be sent": {
                    "summary": "",
                    "value": {
                      "code": 400,
                      "exception": "nette-security-authenticationexception",
                      "message": "Ambiguous user. Please enter more parameter",
                      "context": "{}"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EfektaAPIv3EntitiesSecurityExceptionsresetPassword404Exception"
                },
                "examples": {
                  "No parameters sent": {
                    "summary": "",
                    "value": {
                      "code": 404,
                      "exception": "efekta-system-users-ambiguoususerexception",
                      "message": "Unknown user system ID",
                      "context": "{}"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EfektaAPIv3EntitiesSecurityExceptionsresetPassword500Exception"
                },
                "examples": {
                  "default": {
                    "summary": "",
                    "value": {
                      "code": 500,
                      "exception": "efekta-mailing-senders-senderexception",
                      "message": "Mail couldnt be sent",
                      "context": "{}"
                    }
                  }
                }
              }
            }
          }
        }
      }
