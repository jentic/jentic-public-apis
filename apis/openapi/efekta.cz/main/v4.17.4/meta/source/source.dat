                      "context": "{}"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EfektaAPIv3EntitiesSecurityExceptionsChangePassword500Exception"
                },
                "examples": {
                  "default": {
                    "summary": "",
                    "value": {
                      "code": 500,
                      "exception": "efekta-security-securityexception",
                      "message": "Error when changing password.",
                      "context": "{}"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
