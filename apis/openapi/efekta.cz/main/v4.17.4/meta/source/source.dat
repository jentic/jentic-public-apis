                "schema": {
                  "$ref": "#/components/schemas/EfektaAPIv3EntitiesStatusEntity"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EfektaAPIv3EntitiesSecurityExceptionsChangePassword403Exception"
                },
                "examples": {
                  "user id not sent": {
                    "summary": "",
                    "value": {
                      "code": 403,
                      "exception": "nette-security-authenticationexception",
                      "message": "Incorrect password",
                      "context": "{}"
                    }
                  },
                  "too much wrong password attempts": {
                    "summary": "",
                    "value": {
                      "code": 403,
                      "exception": "nette-security-authenticationexception",
