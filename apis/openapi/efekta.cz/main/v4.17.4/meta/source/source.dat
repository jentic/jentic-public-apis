    "/api/v2/auth/access-token": {
      "post": {
        "tags": [
          "auth_not_required",
          "api_key_in_post_data",
          "access_token"
        ],
        "summary": "Gets access token",
        "operationId": "accessToken",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string"
                  },
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "client_secret": {
                    "type": "string"
                  },
                  "ip_address": {
                    "type": "string"
                  },
                  "device_uid": {
                    "type": "string"
                  },
                  "device_name": {
                    "type": "string"
                  },
                  "device_token": {
                    "type": "string"
                  },
                  "device_token_type": {
                    "type": "string"
                  },
                  "refresh_token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EfektaAPIEntitiesAuthenticationsAccessTokenResponseEntity"
                }
              }
            }
          },
          "400": {
            "description": "Unknown authentication modes!"
          },
          "401": {
            "description": "Unknown password!"
          },
          "403": {
            "description": "Authentication fail!"
          },
          "460": {
            "description": "Username parameter is required!"
          }
        }
      }
    },
    "/api/v2/auth/logout": {
      "get": {
        "tags": [
          "auth_not_required"
        ],
        "responses": {
          "200": {
            "description": "Success"
