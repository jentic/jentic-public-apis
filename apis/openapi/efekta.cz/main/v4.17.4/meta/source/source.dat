                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Security exception",
            "content": {
              "application/json": {
                "schema": {
