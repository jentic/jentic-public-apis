{"openapi":"3.1.0","info":{"title":"OrbitalWiki API","version":"v1","description":"Read-only, provenance-first REST API for satellites and orbital objects. Data from CelesTrak OMM/SATCAT, GCAT/McDowell (CC-BY 4.0), Wikidata (CC0), and SatNOGS DB (CC BY-SA 4.0). Orbital data is approximate and not for operational use. Reads work without a key at 50 requests per UTC day per network, shared with everyone on it; a free key raises that to 1,000 per day. Errors from the key-guarded endpoints carry a stable `code`: match on that and on the status line, never on the wording of `error` or `hint`, which may change at any time.","license":{"name":"ODbL-1.0","url":"https://www.orbitalwiki.com/license"}},"servers":[{"url":"https://www.orbitalwiki.com/api/v1","description":"Production"}],"security":[{"bearerAuth":[]},{"apiKey":[]}],"paths":{"/satellites":{"get":{"operationId":"listSatellites","summary":"List satellites","description":"Paginated list with optional filters. has_omm reports current OMM availability; has_tle is derived and false for six-digit catalog IDs that legacy TLE cannot encode.","parameters":[{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"offset","in":"query","schema":{"type":"integer","minimum":0,"default":0}},{"name":"orbit_class","in":"query","schema":{"type":"string","enum":["LEO","MEO","GEO","HEO","SSO","VLEO","UNKNOWN"]}},{"name":"status","in":"query","schema":{"type":"string","enum":["OPERATIONAL","NONOPERATIONAL","PARTIALLY_OPERATIONAL","STANDBY","SPARE","EXTENDED_MISSION","DECAYED","UNKNOWN"]}},{"name":"object_class","in":"query","schema":{"type":"string","enum":["PAYLOAD","ROCKET_BODY","DEBRIS","UNKNOWN"]}},{"name":"active","in":"query","schema":{"type":"boolean"}},{"name":"country","in":"query","schema":{"type":"string"}},{"name":"q","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"A quota-enforced paginated list of satellites","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlPrivate"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/RateLimitReset"},"X-Total-Count":{"$ref":"#/components/headers/TotalCount"},"X-OrbitalWiki-Completeness":{"$ref":"#/components/headers/Completeness"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SatelliteList"}}}},"400":{"description":"Invalid query parameter; the message names the allowed values","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"Database read failed","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/satellites/{norad_cat_id}":{"get":{"operationId":"getSatellite","summary":"Get a satellite by NORAD catalog ID","description":"Returns available claims plus format flags: has_omm reports current OMM availability; has_tle is derived and false when the legacy format cannot encode the catalog ID.","parameters":[{"name":"norad_cat_id","in":"path","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"Full satellite record with available claims and provenance","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlPrivate"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/RateLimitReset"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SatelliteEnvelope"}}}},"401":{"description":"Missing or invalid API key","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Not found","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Satellite or provenance storage is temporarily unavailable; retry after the supplied delay","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/satellites/{norad_cat_id}/tle":{"get":{"operationId":"getSatelliteTle","summary":"Get the current TLE for a satellite","description":"Two-line element set reconstructed from the stored CelesTrak OMM mean-elements. Includes element epoch, nullable fetched_at (per-record retrieval time is not stored), generic record_updated_at, and a stale_warning flag. The element-set number is a placeholder (not persisted). Legacy TLE cannot encode six-digit NORAD catalog IDs; use the OMM endpoint for those objects.","parameters":[{"name":"norad_cat_id","in":"path","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"Reconstructed TLE with epoch, nullable retrieval time, generic row-update time, and staleness flag","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlPrivate"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/RateLimitReset"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TleEnvelope"}}}},"401":{"description":"Missing or invalid API key","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Not found, or no orbital elements available for this object","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Current OMM exists but the legacy TLE format cannot encode this catalog ID","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Orbital storage is temporarily unavailable; Retry-After is 30 seconds","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/satellites/{norad_cat_id}/omm":{"get":{"operationId":"getSatelliteOmm","summary":"Get the current OMM (CCSDS Orbit Mean-Elements Message) for a satellite","description":"Current valid OMM JSON re-emitted from stored CelesTrak mean-elements. fetched_at is null until per-record retrieval time is persisted; record_updated_at is a generic row mutation timestamp.","parameters":[{"name":"norad_cat_id","in":"path","required":true,"schema":{"type":"integer"}}],"responses":{"200":{"description":"CCSDS OMM JSON with provenance and honest timestamp metadata","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlPrivate"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/RateLimitReset"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OmmEnvelope"}}}},"401":{"description":"Missing or invalid API key","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Not found, or no orbital elements available for this object","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Orbital storage is temporarily unavailable; Retry-After is 30 seconds","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/operators":{"get":{"operationId":"listOperators","summary":"List satellite operators","description":"Operators aggregated from the payload catalog, ranked by active satellite count.","parameters":[{"name":"sort","in":"query","schema":{"type":"string","enum":["active_count","name"],"default":"active_count"}},{"name":"country","in":"query","schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},{"name":"offset","in":"query","schema":{"type":"integer","minimum":0,"default":0}}],"responses":{"200":{"description":"A quota-enforced paginated list of operators","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlPrivate"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/RateLimitReset"},"X-Total-Count":{"$ref":"#/components/headers/TotalCount"},"X-OrbitalWiki-Completeness":{"$ref":"#/components/headers/Completeness"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OperatorList"}}}},"401":{"description":"Missing or invalid API key","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/operators/{slug}":{"get":{"operationId":"getOperator","summary":"Get an operator by slug, with its satellite list","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},{"name":"offset","in":"query","schema":{"type":"integer","minimum":0,"default":0}}],"responses":{"200":{"description":"Quota-enforced operator record with paginated satellite list","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlPrivate"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/RateLimitReset"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OperatorEnvelope"}}}},"401":{"description":"Missing or invalid API key","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Operator not found","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/search":{"get":{"operationId":"searchSatellites","summary":"Search satellites by name, alias, NORAD ID, COSPAR ID, operator, or country","description":"At least one of q, orbit_class, status, or country is required. q is matched on a normalised key, so separators and case do not matter: \"BEIJING-3B\", \"Beijing 3B\" and \"beijing3b\" are the same query. Sourced alternate designations are searched alongside the catalogue name, so the imagery product code \"BJ3N\" resolves to NORAD 53587. Results are ranked by match strength; each carries matched_on (norad_cat_id | cospar_id | name | alias | operator | fuzzy) and matched_value saying why it matched. A fuzzy match only appears when nothing else matched.","parameters":[{"name":"q","in":"query","required":false,"schema":{"type":"string"}},{"name":"orbit_class","in":"query","schema":{"type":"string","enum":["LEO","MEO","GEO","HEO","SSO","VLEO","UNKNOWN"]}},{"name":"status","in":"query","schema":{"type":"string","enum":["OPERATIONAL","NONOPERATIONAL","PARTIALLY_OPERATIONAL","STANDBY","SPARE","EXTENDED_MISSION","DECAYED","UNKNOWN"]}},{"name":"country","in":"query","schema":{"type":"string"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"offset","in":"query","schema":{"type":"integer","minimum":0,"default":0}}],"responses":{"200":{"description":"Quota-enforced paginated search results","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlPrivate"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/RateLimitReset"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchList"}}}},"400":{"description":"No search parameters provided, or an invalid one","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/sources":{"get":{"operationId":"listSources","summary":"List data sources, licence status and provenance credits","description":"Returns the canonical CelesTrak OMM/SATCAT, GCAT, Wikidata, SatNOGS, and manual-curation inventory. meta.source_catalog_state is live, hybrid, or fallback; meta.warning explains any static substitution and fallback rows have null last_fetched_at.","responses":{"200":{"description":"A quota-enforced list of data sources","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlPrivate"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/RateLimitReset"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SourceList"}}}},"401":{"description":"Missing or invalid API key","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/stats":{"get":{"operationId":"getStats","summary":"Catalogue summary statistics","description":"Object-class and operational-status composition, active payload count, OMM coverage, legacy-TLE-encodable coverage, and the newest recorded source-fetch timestamp. A single catalog-wide update timestamp is not stored.","responses":{"200":{"description":"Quota-enforced catalogue summary","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlPrivate"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/RateLimitReset"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StatsEnvelope"}}}},"401":{"description":"Missing or invalid API key","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/reentries":{"get":{"operationId":"listReentries","summary":"List DECAYED objects by catalogue update time","description":"Objects with operational_status=DECAYED, ordered by satellites.updated_at descending. That timestamp is a catalogue-change time, not a re-entry time. decay_date is from GCAT where available; meta.completeness, meta.warnings, and X-OrbitalWiki-Completeness expose a partial response if the bounded decay-claim read fails.","parameters":[{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"offset","in":"query","schema":{"type":"integer","minimum":0,"default":0}}],"responses":{"200":{"description":"A quota-enforced paginated list of re-entered objects","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlPrivate"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/RateLimitReset"},"X-Total-Count":{"$ref":"#/components/headers/TotalCount"},"X-OrbitalWiki-Completeness":{"$ref":"#/components/headers/Completeness"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReentryList"}}}},"401":{"description":"Missing or invalid API key","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/elements":{"get":{"operationId":"getElements","summary":"Mean elements for every active object, as parallel arrays","description":"The payload behind /globe. Index-aligned parallel arrays (id, name, orbit, cc, epoch, n, e, i, raan, argp, m, bstar) rather than an array of objects, which is roughly a quarter of the bytes. Angles in degrees, mean motion in revolutions per day, rounded to below SGP4 accuracy. Public and unkeyed, and cached for six hours to match the element refresh cadence. Capped at 500 requests per network per UTC day, because the edge cache keys on the whole URL and a cachebusting query string reaches the origin every time.","security":[],"responses":{"200":{"description":"Parallel-array element set with generated_at and count","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlCached"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/RateLimitReset"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Elements"}}}},"429":{"description":"Daily request limit for this network exceeded","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Orbital elements are temporarily unavailable; Retry-After is 60 seconds","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/events":{"get":{"operationId":"listEvents","summary":"Recent catalogue change events","description":"JSON form of the /events feed: new catalogued objects, recorded reentries and significant orbit changes, newest first. Published within a day of the catalogue updating, never in real time. Poll with ?since=<ISO 8601 timestamp>, exclusive, and send meta.latest_detected_at back as the next cursor. History is not paginated: only the newest entries in the change log are reachable, so a consumer that stops polling cannot recover the gap. Public and unkeyed, like the RSS version at /events/rss.xml.","security":[],"parameters":[{"name":"since","in":"query","description":"ISO 8601 timestamp; returns only events detected strictly after it","schema":{"type":"string","format":"date-time"}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":500,"default":100}}],"responses":{"200":{"description":"A list of change events with a polling cursor","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlCached"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EventList"}}}},"400":{"description":"Invalid since or limit","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"The event log is temporarily unavailable; Retry-After is 60 seconds","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/launches":{"get":{"operationId":"listLaunches","summary":"Every launch present in the catalogue","description":"Launches grouped from the COSPAR international designator prefix shared by their objects, with object count, earliest launch date and a page URL. Vehicle and launch site are not carried, because this catalogue does not hold them. Public and unkeyed, and derived from designators already published on the satellite endpoints. Cached for a day, so generated_at says when this copy was built and newest_launch_date says which launch it reaches.","security":[],"responses":{"200":{"description":"A list of launches","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlCached"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LaunchList"}}}},"503":{"description":"The launch index is temporarily unavailable; Retry-After is 60 seconds","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/dataset/{slice}":{"get":{"operationId":"downloadDatasetSlice","summary":"Bulk dataset download in Union of Concerned Scientists column names","description":"The full-catalogue download promoted on /data, emitted with the UCS Satellite Database column names where an equivalent exists, so a script written against that database keeps working after it stopped being updated in May 2023. Deliberately outside the API key guard: this is a published dataset meant to be cited and redistributed. Rate limited to 20 downloads per IP per UTC day, reported in the X-RateLimit-* headers; the file is rebuilt every six hours, so cache your copy.","security":[],"parameters":[{"name":"slice","in":"path","required":true,"schema":{"type":"string","enum":["all","active-payloads","starlink"],"example":"all"}},{"name":"format","in":"query","schema":{"type":"string","enum":["csv","json"],"default":"csv"}}],"responses":{"200":{"description":"CSV attachment, or a JSON envelope when format=json. X-OrbitalWiki-Rows carries the row count","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlCached"},"X-OrbitalWiki-Sources":{"$ref":"#/components/headers/Sources"},"X-OrbitalWiki-License":{"$ref":"#/components/headers/License"},"X-RateLimit-Limit":{"$ref":"#/components/headers/RateLimitLimit"},"X-RateLimit-Remaining":{"$ref":"#/components/headers/RateLimitRemaining"},"X-RateLimit-Reset":{"$ref":"#/components/headers/RateLimitReset"},"X-OrbitalWiki-Rows":{"$ref":"#/components/headers/DatasetRows"}},"content":{"text/csv":{"schema":{"type":"string","description":"UCS-named header row followed by one row per object"}},"application/json":{"schema":{"$ref":"#/components/schemas/DatasetSlice"}}}},"404":{"description":"Unknown slice; the response lists the available ones","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Daily download limit for this network exceeded","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"500":{"description":"This server cannot build the dataset because the database function behind it is not deployed. The body carries error, status_url and a hint saying the request was not counted against the daily download limit. No Retry-After: retrying will not clear it","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"The dataset is temporarily unavailable; Retry-After is 60 seconds","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"},"Retry-After":{"$ref":"#/components/headers/RetryAfter"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/keys":{"post":{"operationId":"createApiKey","summary":"Create an API key for the signed-in, email-confirmed account","description":"Not part of the read-only surface above: requires an authenticated Supabase session (cookie-based), not a bearer API key. The plaintext key is returned once and is not retrievable again. Always responds with Cache-Control: no-store.","security":[],"responses":{"201":{"description":"API key created"},"400":{"description":"Invalid burst_limit for this plan tier","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Not signed in","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Email not confirmed, account suspended, or device fingerprint collision","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Active key limit reached for this plan tier","headers":{"Cache-Control":{"$ref":"#/components/headers/CacheControlNoStore"}},"content":{"application/json":{"schema":{"$ref":"#/components/schem