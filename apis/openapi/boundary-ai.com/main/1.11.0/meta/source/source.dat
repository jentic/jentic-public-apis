      "LiveAnalysisResponse": {
        "additionalProperties": true,
        "description": "``GET /surveys/<id>/live-analysis`` \u2014 the field-dashboard cards (#2599).\n\n``enabled`` false means the survey has not opted in, and the dashboard\nsays so rather than showing an empty state that looks like a failure.\n\nEvery card is a PREVIEW. The authoritative analysis run is untouched\nand its numbers supersede these \u2014 the UI states that next to the\nfigures, because a research manager acting on a preview needs to know\nit is one.",
        "properties": {
          "enabled": {
            "default": false,
            "title": "Enabled",
            "type": "boolean"
          },
          "min_sample": {
            "default": 20,
            "title": "Min Sample",
            "type": "integer"
          },
          "questions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Questions",
            "type": "array"
          }
        },
        "title": "LiveAnalysisResponse",
        "type": "object"
      },
      "FollowupProbeResponse": {
        "additionalProperties": true,
        "description": "``POST .../followup`` \u2014 the probe, or nothing.\n\n``followup`` null is the NORMAL, expected answer, not an error: the\ntrigger did not fire, the budget is spent, the model timed out, the\ngenerated text failed validation, or probing is off. Every one of those\nresolves to the same payload on purpose \u2014 the client renders nothing\nand the interview continues, and a respondent must never be able to\ntell which happened.",
        "properties": {
          "followup": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Followup"
          },
          "followup_index": {
            "default": 1,
            "title": "Followup Index",
            "type": "integer"
          }
        },
        "title": "FollowupProbeResponse",
        "type": "object"
      },
      "FollowupAnswersSchema": {
        "type": "object",
        "properties": {
          "submission_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "followups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "additionalProperties": false,
        "required": [
          "followups"
        ]
      },
      "FollowupAnswersStoredResponse": {
        "additionalProperties": true,
        "description": "``POST .../followups`` \u2014 how many probe replies were persisted.\n\nCan legitimately be lower than the number sent: a reply whose parent\nanswer no longer exists (the respondent went back and changed it), or\nwhose slot was already filled by a retry, is dropped rather than\nstored. Both are ordinary outcomes of a public, retryable endpoint.",
        "properties": {
          "stored": {
            "default": 0,
            "title": "Stored",
            "type": "integer"
          },
          "requested": {
            "default": 0,
            "title": "Requested",
            "type": "integer"
          }
        },
        "title": "FollowupAnswersStoredResponse",
        "type": "object"
      },
      "UpdateExcludedSourcesRequest": {
        "additionalProperties": true,
        "description": "``PATCH /surveyseries/<org_id>/<series_id>/excluded-sources`` body.\n\nIds that are not current members of the group's ``survey_ids`` are\nsilently dropped by the repository's intersect step before persist.",
        "properties": {
