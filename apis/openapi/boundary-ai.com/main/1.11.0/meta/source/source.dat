      },
      "FlagTemplateBulkRow": {
        "example": {
          "description": "Mentions of price, cost, value-for-money",
          "name": "Pricing",
          "on_conflict": "duplicate"
        },
        "properties": {
          "name": {
            "description": "Flag name (required, trimmed, \u2264100 chars)",
            "maxLength": 100,
            "title": "Name",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
