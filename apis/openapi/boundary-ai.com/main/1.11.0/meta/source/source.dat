    "/analysis/{analysis_id}/{content_id}/themes/merge": {
      "patch": {
        "summary": "Merge 2+ depth-text themes into one",
        "description": "Fuse the selected persisted themes into a single merged theme (#2216): relevance columns are OR-ed (no comment is ever lost), the source KPI rows are replaced by one merged row, sentiment is recomputed and the summary regenerated. Similar themes get an LLM umbrella name; distinct ones a deterministic 'A \u00d7 B' name. Depth-text questions only. 409 while another edit holds the per-content lock.",
        "tags": [
          "Analysis"
        ],
        "operationId": "analysis_patch_themes_merge",
