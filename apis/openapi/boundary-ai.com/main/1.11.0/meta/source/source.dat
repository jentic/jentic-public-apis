      "ComputedVariablePayload": {
        "additionalProperties": true,
        "description": "A variable that lives on the response and is never shown.\n\n``name`` is an identifier: it is the ``{{var.name}}`` piping token,\nthe ``_sys_var_<name>`` system-question key the value is stored\nunder, and the export column header.",
        "properties": {
          "variable_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Variable Id"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "value_type": {
            "default": "text",
            "description": "text | number",
            "title": "Value Type",
            "type": "string"
          },
          "mode": {
            "default": "rules",
            "description": "rules | formula",
            "title": "Mode",
            "type": "string"
          },
          "position": {
            "default": 0,
            "title": "Position",
            "type": "integer"
          },
          "formula_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "mode=formula only: numeric/string literals, Q<n> question references, var.<name> variable references, + - * / ( ) and min/max/round/abs/count_selected",
            "title": "Formula Text"
          },
          "default_value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Used when no rule matches / the formula is undefined",
            "title": "Default Value"
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/ComputedVariableRulePayload"
            },
            "title": "Rules",
            "type": "array"
          }
        },
        "required": [
          "name"
        ],
        "title": "ComputedVariablePayload",
        "type": "object"
      },
      "ComputedVariableRulePayload": {
        "additionalProperties": true,
        "description": "One ``condition group -> value`` row of a rules-mode variable.\n\nRules are evaluated by ascending ``priority`` and the FIRST match\nwins; ``condition_group`` null is the unconditional catch-all.",
