          }
        ],
        "x-internal": true
      }
    },
    "/webhooks/sms/inbound/{org_id}": {
      "post": {
        "summary": "Receive an inbound SMS (STOP handling)",
        "description": "Signed provider callback carrying a reply. STOP keywords in EN and FR (STOP, STOPALL, UNSUBSCRIBE, ARRET/ARR\u00caT, DESABONNEMENT/D\u00c9SABONNEMENT, \u2026) are matched case-, accent- and whitespace-insensitively and add the number to the account's unsubscribe register, tagged with the originating survey and scoped by that survey's opt-out policy. UNLIKE every other webhook here, a processing failure returns 500 so the provider RETRIES: a dropped STOP is a legal problem, and the register insert is idempotent so a repeated delivery is free.",
        "tags": [
          "Webhooks"
        ],
        "operationId": "webhooks_post_sms_inbound",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "X-Twilio-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "base64 HMAC over the callback URL and its parameters"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsWebhookResult"
