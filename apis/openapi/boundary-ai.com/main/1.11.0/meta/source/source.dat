    "/weighting/surveys/{survey_id}/respondent-weights": {
      "get": {
        "summary": "Per-respondent weights for client-side weighted tallies",
        "description": "Post-stratification weight per respondent (user_weights, by user_id) and per answered depth-text comment (answer_weights, by answer_id) for the survey's active weighting config. Entries with weight 1.0 are omitted \u2014 clients default missing ids to 1.0. Powers display-only weighted cross-tabs (the qualitative theme/flag context panels); nothing server-side consumes it. enabled=false when no enabled config exists.",
        "tags": [
          "Weighting"
        ],
        "operationId": "weighting_respondent_weights",
        "parameters": [
          {
            "name": "survey_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "analysis_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Scope weights to this analysis's evolution period (bucket analyses)"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/RespondentWeightsResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/weighting/surveys/{survey_id}/weighted-results": {
      "get": {
        "summary": "Weighted quant aggregates for a survey's active weighting config",
        "description": "Recomputes choice/scale/NPS aggregates from raw answers with post-stratification weights applied, keyed by str(question_id) (str(content_id) with analysis_id). Stored analysis outputs stay unweighted; this is the weighted view's data source. With segment_ids, every quant entry also carries `segments`: the same aggregate per segmentation combo, computed over that combo's respondents with the survey's per-respondent weights (plus raw_n / effective_n / low_base).",
        "tags": [
          "Weighting"
        ],
        "operationId": "weighting_weighted_results",
        "parameters": [
          {
            "name": "survey_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "analysis_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "When given, results are keyed by content_id of this analysis instead of question_id"
          },
          {
            "name": "segment_ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated CONTENT ids of the active segmentation questions (1-4, same parameter as the /data/segment endpoints); requires analysis_id. Adds per-segment weighted aggregates to each quant entry."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/WeightedResultsResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/weighting/surveys/{survey_id}/weights-export": {
      "get": {
        "summary": "Export the survey's computed weights as XLSX",
        "description": "One row per respondent \u2014 weight-1.0 rows INCLUDED (unlike the respondent-weights endpoint, which omits them as a payload optimisation) \u2014 plus the derivation diagnostics (cells / raking marginals) and the originating config, so the file is auditable and reproducible (#2539 disclosure principle). Optionally scoped to an analysis's evolution period like weighted-results. The external_id column is present only when at least one respondent has one; metadata_question_ids adds the picked METADATA questions' answers as extra columns so the file carries the client's own join keys.",
        "tags": [
          "Weighting"
        ],
        "operationId": "weighting_export_weights",
        "parameters": [
          {
            "name": "survey_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "analysis_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Scope weights to this analysis's evolution period"
          },
          {
            "name": "metadata_question_ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated METADATA question ids to include as per-respondent columns; non-METADATA ids are silently dropped"
          }
        ],
        "responses": {
          "200": {
            "description": "XLSX file",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
