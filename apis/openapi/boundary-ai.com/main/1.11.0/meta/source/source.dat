    "/api/survey/partial": {
      "get": {
        "summary": "Public: resume an in-progress survey response",
        "description": "Returns the stored draft for an invitation token or session handle, but only while its schema fingerprint still matches the survey's current shape. Unknown keys return an empty payload \u2014 the endpoint is not an existence oracle.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_get_partial_response",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed survey id (the answer link's ?token=)"
          },
          {
            "name": "rtoken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Respondent-list token \u2014 keys the partial for cross-device resume"
          },
          {
            "name": "session",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Server-minted session handle for anonymous links (echoed by the client)"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/PartialResponseResumeResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate Limited \u2014 see Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": []
      },
      "post": {
        "summary": "Public: save an in-progress survey response",
        "description": "Upserts the respondent's draft for a survey, keyed by the invitation token (`rtoken`) or by an opaque server-minted `session` handle returned on the first save. Fire-and-forget: clients must ignore failures and keep their local draft.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_save_partial_response",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed survey id (the answer link's ?token=)"
          },
          {
            "name": "rtoken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Respondent-list token \u2014 keys the partial for cross-device resume"
          },
          {
            "name": "session",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Server-minted session handle for anonymous links (echoed by the client)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartialResponseSaveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/PartialResponseSaveResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate Limited \u2014 see Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": []
      },
      "delete": {
        "summary": "Public: discard an in-progress survey response",
        "description": "Deletes the stored draft for an invitation token or session handle \u2014 used by 'start over' and by #2581's `restart` resume policy. Idempotent.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_delete_partial_response",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed survey id (the answer link's ?token=)"
          },
          {
            "name": "rtoken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Respondent-list token \u2014 keys the partial for cross-device resume"
          },
          {
            "name": "session",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Server-minted session handle for anonymous links (echoed by the client)"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/PartialResponseDeleteResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate Limited \u2014 see Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": []
      }
    },
