          }
        },
        "required": [
          "name"
        ],
        "title": "QuotaRecountCellPayload",
        "type": "object"
      },
      "QuotaRecountResponse": {
        "additionalProperties": true,
        "description": "``POST /surveys/<survey_id>/quotas/recount``.\n\nReports the before/after per cell so the author can see what the\nrebuild moved \u2014 the point of running it is usually that they suspect it\nwill move something.\n\nTWO OUTCOMES, and the status says which. A rebuild has to visit every\ncountable response, so on a large survey it is DETACHED from the\nrequest rather than awaited inside it (see\n``quota_service.start_recount``): the response is then ``202`` with\n``status: \"started\"`` and an EMPTY ``cells`` list, because the numbers\ndo not exist yet. A client must branch on ``status`` and re-read\n``GET /quotas/status`` rather than render ``cells`` unconditionally.",
        "properties": {
          "status": {
            "default": "completed",
            "description": "completed \u2014 the rebuild finished and `cells` carries the before/after. started \u2014 the rebuild was detached (large survey, HTTP 202); `cells` is empty and the caller must re-read the quota status.",
            "title": "Status",
            "type": "string"
          },
          "cells": {
            "items": {
              "$ref": "#/components/schemas/QuotaRecountCellPayload"
            },
            "title": "Cells",
            "type": "array"
          },
          "responses_considered": {
            "default": 0,
            "description": "Responses the rebuild folded in. On a `started` response this is the count it is ABOUT to process, not a completed total.",
            "title": "Responses Considered",
            "type": "integer"
          }
        },
        "title": "QuotaRecountResponse",
        "type": "object"
      },
      "QuotaEvaluateSchema": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "object"
