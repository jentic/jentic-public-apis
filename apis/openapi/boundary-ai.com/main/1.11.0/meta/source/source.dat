    "/native-connectors/medallia/sync-configs/{sync_config_id}/dry-run": {
      "post": {
        "summary": "Rehearse a Medallia sync without writing anything",
        "description": "Runs the real pipeline \u2014 authentication, negotiated capabilities, query construction, the same bounded stable window, keyset pagination, normalization, segmentation and the dedup lookup \u2014 and reports what WOULD be imported. Creates no feedback, advances no checkpoint or watermark, triggers no analysis and mutates no source state. Samples carry structure rather than content by default; ?include_content=true adds a scrubbed preview. With `Prefer: respond-async` it runs in the background: answers 202 with a job_id to poll at GET /medallia/probe-jobs/{job_id}. Without the header it answers 200 with the report.",
        "tags": [
          "Native connectors"
        ],
        "operationId": "native_connectors_post_medallia_dry_run",
        "parameters": [
          {
            "name": "sync_config_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "include_content",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "respond-async"
            },
            "description": "Send `respond-async` to run the probe in the background: the answer is then 202 with a `job_id` to poll at GET /medallia/probe-jobs/{job_id}. Without it the request waits for the report (200), as before."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MedalliaDryRunResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "202": {
            "description": "Accepted \u2014 task queued for async processing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MedalliaProbeJobResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
