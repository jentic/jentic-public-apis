      "SuperThemesResponse": {
        "additionalProperties": true,
        "description": "``GET /surveyseries/<org_id>/<survey_series_id>/super-themes`` and\n``/recompute`` POST. Shape: ``{\"super_themes\": [...], \"metadata\": {...},\n\"computing\": bool, \"settling\": bool}``.\n\n``computing``: a recompute is in flight (or analyses are settling and\nthere is no stored grouping to show yet); the cards are not usable.\n``settling``: analyses of the scope are in flight while the last\ncompleted grouping is served; the cards stay usable and refresh once\nthe run lands.",
        "properties": {
          "super_themes": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Super Themes",
            "type": "array"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Metadata"
          },
          "computing": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Computing"
          },
          "settling": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Analyses of this scope are in flight; the stored grouping is the last completed one and stays usable until it refreshes.",
            "title": "Settling"
          }
        },
        "title": "SuperThemesResponse",
        "type": "object"
      },
      "SuperThemesRecomputeRequest": {
        "description": "``POST /surveyseries/<org_id>/<series_id>/super-themes/recompute`` body.\n\n``period_key`` is only valid together with ``timeframe=\"evolution\"``:\nper-bucket groupings exist under that timeframe alone, so any other\npairing addresses a scope nothing reads and is rejected with 400\n(``details.error_code = \"PERIOD_KEY_REQUIRES_EVOLUTION\"``).",
        "properties": {
          "timeframe": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "all",
            "description": "One of \"all\", \"week\", \"month\", \"3months\", \"6months\", \"12months\", \"evolution\". Must be \"evolution\" when ``period_key`` is supplied.",
            "title": "Timeframe"
          },
          "period_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Evolution bucket to recompute (e.g. \"2026-07\"). Requires timeframe=\"evolution\".",
            "title": "Period Key"
          }
        },
        "title": "SuperThemesRecomputeRequest",
        "type": "object"
      },
      "ResetGroupedThemesRequest": {
        "additionalProperties": true,
        "description": "``POST /surveyseries/<org_id>/<series_id>/super-themes/reset`` body.\n\n``timeframe`` defaults to ``\"all\"``; ``period_key`` scopes the reset\nto a single evolution bucket when supplied.\n\nThe two fields are not independent: per-bucket groupings exist only\nunder ``timeframe=\"evolution\"``, so ``period_key`` with any other\ntimeframe addresses a scope nothing reads and is rejected with 400\n(``details.error_code = \"PERIOD_KEY_REQUIRES_EVOLUTION\"``). Send the\nsame scope the view you are resetting reads.",
        "properties": {
          "timeframe": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "all",
