    "/surveys/{survey_id}/field": {
      "get": {
        "summary": "The whole field dashboard in one payload",
        "description": "Every panel at one instant, against one filter set. The tab fetches this rather than five endpoints so the panels can never describe different populations.",
        "tags": [
          "Field dashboard"
        ],
        "operationId": "field_get_snapshot",
        "parameters": [
          {
            "name": "survey_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive first day, in the org timezone"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Inclusive last day, in the org timezone"
          },
          {
            "name": "include_excluded",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Count quality-excluded responses (#2582)"
          },
          {
            "name": "refresh",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Skip the 60 s cache read"
          }
        ],
        "responses": {
          "200": {
            "description": "Summary, daily, drop-off, distributions, quota"
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
