    "/surveys/{survey_id}/respondent-lists/{list_id}/sms/estimate": {
      "post": {
        "summary": "Estimate an SMS send: recipients, segments, cost and skips",
        "description": "The panel an operator approves before a billable send. Reports SEGMENTS rather than messages \u2014 160 GSM-7 characters each, but 70 the moment one character falls outside that alphabet, which doubles the cost \u2014 plus every record that will be skipped and why. POST because the message body is the input; it writes nothing.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_post_respondent_list_sms_estimate",
        "parameters": [
          {
            "name": "survey_id",
