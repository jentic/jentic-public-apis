    "/analysis/{analysis_id}/other-responses/{content_id}": {
      "get": {
        "summary": "Get 'Other' responses for a content of an analysis",
        "tags": [
          "Analysis"
        ],
        "operationId": "analysis_get_other_responses_by_content",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "content_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "envelope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "v2"
              ]
            },
            "description": "Set to 'v2' to receive the canonical paginated envelope."
          },
          {
            "name": "legacy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Set to '1' to force the legacy flat shape (deprecated; see Sunset header)."
          }
        ],
        "responses": {
          "200": {
            "description": "Other-choice responses. Default shape is the canonical paginated envelope `{data: {items, nextCursor, totalCount?}}`; with `?legacy=1` the legacy `{other_responses, total_count}` body is returned. Legacy responses carry `Deprecation: true` and a `Sunset` header.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/OtherResponsesByContentResponse"
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
