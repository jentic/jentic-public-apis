    "/native-connectors/medallia/connections/{connection_id}/discovery": {
      "get": {
        "summary": "What is in this Medallia instance, from its own records",
        "description": "Samples the newest records with every answered field, looks up the fields the connector depends on by id, and returns: the populated fields with fill rates, the field that splits records into sources (feedback type, connector, survey) with its values and counts, and suggested text, metadata, watermark, tie-breaker and status choices. This is what lets the wizard open with the decisions made on a tenant whose catalogue is too large to browse. Cached per connection; ?refresh=1 re-samples.",
        "tags": [
          "Native connectors"
        ],
        "operationId": "native_connectors_get_medallia_discovery",
        "parameters": [
          {
            "name": "connection_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "lookback_days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sample_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "JSON list (max 5) of membership clauses ({fieldIds: [id], in: [...]}) shared by every source in the target group; discovery is recomputed inside them."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MedalliaDiscoveryResponse"
