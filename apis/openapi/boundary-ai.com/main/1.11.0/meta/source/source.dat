      },
      "ContentDistributionPageResponse": {
        "additionalProperties": true,
        "description": "GET /<analysis_id>/contents/<content_id>/distribution \u2014 one page of\ncount-ordered distribution rows for a (typically METADATA) content whose\nhydrated distribution is capped in the analysis payload.",
