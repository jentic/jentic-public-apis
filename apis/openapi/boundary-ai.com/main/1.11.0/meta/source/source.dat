            "default": false,
            "title": "Is Ses Active",
            "type": "boolean"
          },
          "shared_sends_used": {
            "default": 0,
            "title": "Shared Sends Used",
            "type": "integer"
          },
          "included_monthly_sends": {
            "default": 10000,
            "description": "Included monthly sends before overage billing applies",
            "title": "Included Monthly Sends",
            "type": "integer"
          },
          "overage_sends": {
            "default": 0,
            "description": "Sends past the included allowance this period (billed on usage)",
            "title": "Overage Sends",
            "type": "integer"
          },
          "remaining_included": {
            "default": 0,
            "title": "Remaining Included",
            "type": "integer"
          },
          "hard_cap_monthly_sends": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional hard stop (abuse valve); null = never blocked",
            "title": "Hard Cap Monthly Sends"
          },
          "monthly_cap": {
            "default": 10000,
            "description": "Deprecated alias of included_monthly_sends",
            "title": "Monthly Cap",
            "type": "integer"
          },
          "remaining_shared": {
            "default": 0,
            "description": "Deprecated alias of remaining_included",
            "title": "Remaining Shared",
            "type": "integer"
          },
          "period_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ISO-8601 end of the current allowance period",
            "title": "Period End"
          }
        },
