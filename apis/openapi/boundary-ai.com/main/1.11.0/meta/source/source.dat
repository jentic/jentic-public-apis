          },
          "aws_region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Aws Region"
          },
          "aws_external_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Server-generated ExternalId the customer pastes into the CloudFormation parameters",
            "title": "Aws External Id"
          },
          "aws_identity_status": {
            "default": "unconfigured",
            "description": "'unconfigured' | 'connected' | 'pending' | 'verified'",
