              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timezone"
          },
          "slot_hour": {
            "title": "Slot Hour",
            "type": "integer"
          },
          "pending": {
            "anyOf": [
              {
                "items": {
