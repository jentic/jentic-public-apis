    "/scrapers/executions/{execution_id}/retry": {
      "post": {
        "summary": "Retry a failed or cancelled execution",
        "description": "Creates a new execution that reuses the original scraper configuration. Preserves the original execution's max_comments_per_post override (if any) so the retry is billed at the same rate as the original run. An optional `platforms` body lists platform ids to re-run alone (billed for those platforms only). Executions that COMPLETED with failed platforms (e.g. one rate-limited AI Visibility provider) are also retryable, restricted to their failed platforms \u2014 by default all of them.",
        "tags": [
          "Scraper"
        ],
        "operationId": "scraper_history_post_retry",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
