    "/api/payments/history": {
      "get": {
        "summary": "Get organization credit transaction history",
        "description": "Return the calling org's web-scraper credit audit log, paginated and optionally filtered by operation type.",
        "tags": [
          "Payments"
        ],
        "operationId": "payments_get_credit_history",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Max records per page (default 50, max 100)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Pagination offset (default 0)",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "operation",
            "in": "query",
            "required": false,
            "description": "Optional filter by operation type",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "envelope",
            "in": "query",
            "required": false,
            "description": "Set to 'v2' to receive the canonical paginated envelope.",
            "schema": {
              "type": "string",
              "enum": [
                "v2"
              ]
            }
          },
          {
            "name": "legacy",
            "in": "query",
            "required": false,
            "description": "Set to '1' to force the legacy flat shape (deprecated; see Sunset header).",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Credit transaction history. Default shape is the canonical `{data: {items, nextCursor, totalCount?}}` paginated envelope; with `?legacy=1` the legacy `{transactions, total_count, limit, offset}` body is returned instead. Legacy responses carry `Deprecation: true` and a `Sunset` header indicating when legacy support will be removed.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/CreditHistoryResponse"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentsFlatErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/payments/webhook": {
      "post": {
        "summary": "Stripe webhook receiver",
        "description": "Anonymous Stripe webhook receiver. Verifies the ``Stripe-Signature`` header in-handler using ``STRIPE_WEBHOOK_SECRET``, deduplicates events via Redis (48h TTL covering Stripe's 72h retry window) and routes the event to the right handler (credit grants, refund clawbacks, auto-topup card setup and failures). Request body is the raw signed JSON payload sent by Stripe \u2014 do NOT parse it as a typed model or signature verification will fail.",
        "tags": [
          "Payments"
        ],
        "operationId": "payments_post_webhook",
        "parameters": [
          {
            "name": "Stripe-Signature",
            "in": "header",
            "required": true,
            "description": "Stripe webhook signature in the form ``t=...,v1=...``. Verified server-side via ``stripe.Webhook.construct_event``.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/StripeWebhookAckResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "webhookSignature": []
          }
        ]
      }
    },
