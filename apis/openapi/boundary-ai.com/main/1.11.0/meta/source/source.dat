      "MedalliaFieldUsageRequest": {
        "description": "Body for ``POST /medallia/connections/{id}/field-usage``.\n\nThe segmentation fields mirror a sync's mapping so the sample is\ndrawn from exactly the records that sync would see. A probe that read\na different population would answer confidently about the wrong\nthing.",
        "properties": {
          "field_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Field Ids",
            "type": "array"
