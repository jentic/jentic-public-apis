    "/surveyseries/{org_id}/{survey_series_id}/super-flags": {
      "get": {
        "summary": "Get cached super-flags (grouped flags) for a survey series",
        "description": "Read-only: returns the cached grouped-flag rows for the series + timeframe (never recomputes \u2014 use POST /super-flags/recompute). `computing: true` means a recompute lock is currently held; poll until it flips false.",
        "tags": [
          "SuperFlags"
        ],
        "operationId": "superflags_get_super_flags",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
