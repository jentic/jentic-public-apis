      "ViewContextModel": {
        "additionalProperties": true,
        "description": "Inbound view-context payload; every field is optional.\n\nThe route handler coerces this into the in-process ``ViewContext``\ndataclass. Declared fields are length-capped because thread-create\npersists them into ``frozen_view_context``; ``extra=\"allow\"`` stays\nfor wire tolerance and the persist site drops the extras.",
        "properties": {
          "page": {
            "default": "",
            "maxLength": 512,
            "title": "Page",
            "type": "string"
          },
          "group_id": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Group Id"
          },
          "source_id": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Id"
          },
          "datapoint_id": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Datapoint Id"
          },
          "super_theme_id": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Super Theme Id"
          },
          "theme_id": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Theme Id"
          },
          "flag_id": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Flag Id"
          },
          "report_id": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Report Id"
          },
          "survey_id": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Survey Id"
          },
          "analysis_id": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Analysis Id"
          },
          "period_key": {
            "anyOf": [
              {
                "maxLength": 512,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Period Key"
          },
          "timeframe": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ViewTimeframeModel"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "title": "ViewContextModel",
        "type": "object"
      },
      "ViewTimeframeModel": {
        "additionalProperties": false,
        "description": "Bounded inbound timeframe of the page the user is on.\n\n``ViewContextModel`` is persisted verbatim into the\n``frozen_view_context`` JSONB column on thread create, so its\ntimeframe cannot be an open dict. ``extra=\"forbid\"`` rejects unknown\nkeys and every string field is capped.",
        "properties": {
          "start": {
            "default": "",
            "maxLength": 512,
