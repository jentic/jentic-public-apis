        "properties": {
          "upload_url": {
            "description": "GCS resumable-session URL; PUT the file bytes here (one-time bearer, no additional auth).",
            "title": "Upload Url",
            "type": "string"
          },
          "object_path": {
            "description": "Hand back to POST /interviews/from-upload once the PUT completes.",
            "title": "Object Path",
            "type": "string"
          }
        },
        "required": [
          "upload_url",
