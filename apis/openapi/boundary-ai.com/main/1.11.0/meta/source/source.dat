    "/analysis/{analysis_id}/coding-matrix-xlsx": {
      "get": {
        "summary": "Export one coding matrix (.xlsx) covering several in-depth questions",
        "tags": [
          "Analysis"
        ],
        "operationId": "analysis_get_multi_question_coding_matrix_xlsx",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "content_ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated content ids of the in-depth questions to concatenate, at most 30. Emitted in survey question order."
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "fr",
                "es"
              ]
            },
            "description": "Export language for headers + sentiment labels. Defaults to the survey language."
          },
          {
            "name": "metadata_question_ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated METADATA question ids to add as respondent-metadata columns."
          },
          {
            "name": "columns",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated per-question core columns to include (comment_id, comment_text, sentiment, matrix). Absent \u21d2 all. The respondent-id column is always emitted \u2014 it is the key the questions are joined on."
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
