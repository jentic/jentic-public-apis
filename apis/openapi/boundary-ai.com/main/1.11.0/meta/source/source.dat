          },
          "masked": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "true when the question is protected and the caller is not an org admin: every value field is masked (text '\u2022\u2022\u2022\u2022', numeric null).",
            "title": "Masked"
          },
          "followups": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/AnswerFollowupItem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "AI follow-up probes asked after this answer, in order. Absent when none.",
            "title": "Followups"
          }
