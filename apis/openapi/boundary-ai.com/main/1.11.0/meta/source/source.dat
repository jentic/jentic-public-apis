              "total_tokens": 50000
            }
          ],
          "period_start": "2026-05-01T00:00:00+00:00",
          "recent": [
            {
              "aps_charged": 10.0,
              "created_at": "2026-05-18T12:00:00+00:00",
              "feature": "analysis",
              "rate_tokens_per_aps": 400.0,
              "success": true,
              "total_tokens": 4000
            }
          ],
          "status": {
            "limit": 1000,
            "remaining": 750,
