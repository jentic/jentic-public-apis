    "/canvas-documents/variables/preview": {
      "post": {
        "summary": "Resolve custom variables against one feedback group (builder preview)",
        "description": "Run the SAME resolver report generation uses over the group's current answers, so the builder shows the value a report generated now would print. Nothing is stored. A variable whose question the group does not ask resolves to a dash.",
        "tags": [
          "Reports"
        ],
        "operationId": "canvasdoc_variables_preview",
        "requestBody": {
