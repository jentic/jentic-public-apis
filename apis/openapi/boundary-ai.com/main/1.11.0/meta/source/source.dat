      "EmbedSurveyResponse": {
        "description": "Shape of ``GET /api/embed/survey/<token>``.\n\nThe handler returns a free-form payload from\n``EmbedService.get_survey_for_embed`` augmented with the survey\ntoken and a freshly-minted HMAC challenge token. The exact survey\npayload is intentionally typed as ``Any`` \u2014 it carries\nquestions, customization and embed config and varies by survey.\nFor a passcode-protected survey loaded without the right\n``pass_code`` it is the LOCKED payload: ``survey.passcode_required``\nis true and the questions, logic, end screens, name and description\nare empty (the prompt's styling only: no logo, redirect, custom CSS\nor theme text) and there is NO ``challenge_token`` \u2014 it is minted on\nthe load that sends the right passcode.",
        "example": {
          "challenge_token": "v1.eyJ...",
          "survey": {
            "id": 42,
            "title": "Example survey"
          },
          "token": "abc123"
        },
        "properties": {
          "token": {
            "description": "Opaque survey token used in the widget URL",
            "title": "Token",
            "type": "string"
          },
          "challenge_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Single-use HMAC challenge token. Must be sent back in the submission body to satisfy the hmacChallenge security scheme. Absent on a passcode survey's locked payload: the load that sends the right ``pass_code`` carries it.",
            "title": "Challenge Token"
          }
        },
        "required": [
          "token"
        ],
        "title": "EmbedSurveyResponse",
        "type": "object"
      },
      "EmbedFlatErrorEnvelope": {
        "description": "Flat ``{\"error\": \"...\", \"code\": \"...\"}`` shape used by every\nembed handler. Distinct from the canonical ``ErrorEnvelope``.",
        "example": {
          "code": "INVALID_TOKEN",
          "error": "Invalid survey token"
        },
        "properties": {
          "error": {
            "description": "Human-readable error message",
            "title": "Error",
            "type": "string"
          },
          "code": {
            "description": "Machine-readable error code",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional per-field validation errors (only set on VALIDATION_ERROR).",
            "title": "Details"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional secondary message (only set on RATE_LIMITED).",
            "title": "Message"
          },
          "challenge_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Re-armed single-use challenge token, present on submit refusals. The submit endpoint burns the nonce before the passcode, Turnstile and answer checks run, so the widget must retry with this token rather than the one it sent.",
            "title": "Challenge Token"
          }
        },
        "required": [
          "error",
          "code"
        ],
        "title": "EmbedFlatErrorEnvelope",
        "type": "object"
      },
      "EmbedLoadRefusalEnvelope": {
        "description": "403 of ``GET /api/embed/survey/<token>``: the widget may not start an\ninterview. ``code`` says why, and the widget acts on it:\n\n* ``SURVEY_CLOSED`` \u2014 the survey stopped accepting responses. Carries\n  ``end_screens`` so the widget shows the author's survey_closed screen\n  (piped, redirect honoured), like the hosted page's closed shell. For a\n  passcode-protected survey loaded without the right ``pass_code`` it\n  carries ``passcode_required: true`` and NO end screens instead: the\n  widget asks for the passcode, and the right one loads the screens.\n* ``LINK_EXPIRED`` \u2014 the campaign link (``?rtoken``) has expired; the\n  widget shows the expired-link screen.\n* ``SURVEY_ERROR`` \u2014 any other refusal: the survey is not published,\n  embedding is disabled for it, or the calling site's domain is not on\n  its allowlist.",
        "examples": [
          {
            "code": "SURVEY_CLOSED",
            "end_screens": {
              "survey_closed": {
                "message": "This survey is closed.",
                "mode": "message"
              }
            },
            "error": "Survey is not accepting responses"
          },
          {
            "code": "SURVEY_CLOSED",
            "error": "Survey is not accepting responses",
            "passcode_required": true
          },
          {
            "code": "LINK_EXPIRED",
            "error": "This invitation link has expired."
          },
          {
            "code": "SURVEY_ERROR",
            "error": "This domain is not authorized to embed this survey"
          }
        ],
        "properties": {
          "error": {
            "description": "Human-readable error message",
            "title": "Error",
            "type": "string"
          },
          "code": {
            "description": "Machine-readable error code",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional per-field validation errors (only set on VALIDATION_ERROR).",
            "title": "Details"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional secondary message (only set on RATE_LIMITED).",
            "title": "Message"
          },
          "challenge_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Re-armed single-use challenge token, present on submit refusals. The submit endpoint burns the nonce before the passcode, Turnstile and answer checks run, so the widget must retry with this token rather than the one it sent.",
            "title": "Challenge Token"
          },
          "end_screens": {
            "anyOf": [
              {
                "additionalProperties": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only with ``SURVEY_CLOSED``: the survey's end screens keyed by disposition (``{mode: 'message', message, message_key?}`` or ``{mode: 'redirect', redirect_url}``, the same runtime payload a successful load carries), so the widget can show the survey_closed screen.",
            "title": "End Screens"
          },
          "passcode_required": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only with ``SURVEY_CLOSED`` of a passcode-protected survey loaded without the right ``pass_code``: the end screens are withheld until the passcode is given.",
            "title": "Passcode Required"
          }
        },
        "required": [
          "error",
          "code"
        ],
        "title": "EmbedLoadRefusalEnvelope",
        "type": "object"
      },
      "EmbedSubmitRequest": {
        "description": "Request body for ``POST /api/embed/survey/<token>/submit``.\n\nMirrors the marshmallow ``EmbedSubmitSchema`` at runtime. The\nchallenge token, honeypot and turnstile token are required by the\nhmacChallenge security scheme.",
        "example": {
          "_hp": "",
          "answers": [
            {
              "question_id": 1,
              "value": "Great!"
            }
          ],
          "challenge_token": "v1.eyJ...",
          "passcode": null,
          "qr_code_id": null,
          "rtoken": null,
          "turnstile_token": "0.AAAA..."
        },
        "properties": {
          "answers": {
            "description": "Array of answer objects keyed by question id.",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Answers",
            "type": "array"
          },
          "challenge_token": {
            "description": "HMAC challenge token issued by the survey GET endpoint.",
            "title": "Challenge Token",
            "type": "string"
          },
          "turnstile_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Cloudflare Turnstile token (required when configured server-side).",
            "title": "Turnstile Token"
          },
          "passcode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional passcode for gated surveys.",
            "title": "Passcode"
          },
          "qr_code_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "QR-code segmentation slug (max 64 chars).",
            "title": "Qr Code Id"
          },
          "rtoken": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Identified respondent token for personalised surveys.",
            "title": "Rtoken"
          },
          "submission_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Idempotency key (UUID), one per interview. A retried or concurrent POST with the same key stores nothing and is acknowledged with the first delivery's outcome.",
            "title": "Submission Id"
          },
          "_hp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Honeypot field \u2014 must be empty/unset for humans.",
            "title": "Hp"
          }
        },
        "required": [
          "challenge_token"
        ],
        "title": "EmbedSubmitRequest",
        "type": "object"
      },
      "EmbedSubmitResponse": {
        "description": "Shape of the success branch of ``POST /api/embed/survey/<token>/submit``.",
        "example": {
          "disposition": "completed",
          "message": "Thanks for your response!",
          "over_quota": false,
          "redirect_url": "https://example.com/thank-you",
          "success": true
        },
        "properties": {
          "success": {
            "description": "True when the response was accepted",
            "title": "Success",
            "type": "boolean"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Human-readable confirmation",
            "title": "Message"
          },
          "redirect_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional URL the widget should navigate to after submit.",
            "title": "Redirect Url"
          },
          "disposition": {
            "default": "completed",
            "description": "completed | quota_full (#2580 x #2574). WHICH end screen the widget must show \u2014 the same field the hosted route returns. 'quota_full' means the answers were saved but the respondent matched a quota cell that was already full.",
            "title": "Disposition",
            "type": "string"
          },
          "over_quota": {
            "default": false,
            "description": "The response was accepted after its quota filled \u2014 kept and tagged so it can be dropped at export. Not an error, and never a reason to discard a completed interview.",
            "title": "Over Quota",
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "title": "EmbedSubmitResponse",
        "type": "object"
      },
      "EmbedCodePayload": {
        "description": "Shape of ``generate_embed_code()`` \u2014 the ready-to-paste snippets.\n\nThe old spec typed ``embed_code`` as a single string; the runtime has\nalways returned this dictionary of format variants, which the\nfrontend reads (``embedCode.script`` / ``.iframe`` / ``.widget_url``).",
        "example": {
          "api_url": "https://api.example.com/api/embed/survey/abc123",
          "component": "// Note: npm package coming soon",
          "iframe": "<iframe src=\"https://api.example.com/embed/survey/abc123\"></iframe>",
          "popup": "<script src=\"https://api.example.com/embed/widget.js\" data-token=\"abc123\" data-mode=\"popup\" async></script>",
          "script": "<div id=\"boundary-survey-abc\"></div>\n<script src=\"https://api.example.com/embed/widget.js\" data-token=\"abc123\" async></script>",
          "widget_url": "https://api.example.com/embed/widget.js"
        },
        "properties": {
          "script": {
            "description": "Standard <script> embed snippet.",
            "title": "Script",
            "type": "string"
          },
          "popup": {
            "description": "Floating-button popup embed snippet.",
            "title": "Popup",
            "type": "string"
          },
          "iframe": {
            "description": "Plain <iframe> embed snippet.",
            "title": "Iframe",
            "type": "string"
          },
          "component": {
            "description": "React component usage notes (package not yet published).",
            "title": "Component",
            "type": "string"
          },
          "widget_url": {
            "description": "Absolute URL of the widget.js bundle.",
            "title": "Widget Url",
            "type": "string"
          },
          "api_url": {
            "description": "Absolute URL of the anonymous survey-data endpoint.",
            "title": "Api Url",
            "type": "string"
          }
        },
        "required": [
          "script",
          "popup",
          "iframe",
          "component",
          "widget_url",
          "api_url"
        ],
        "title": "EmbedCodePayload",
        "type": "object"
      },
      "EmbedConfigPayload": {
        "description": "Shape of ``SurveyEmbedConfig.to_dict()``.\n\nField types mirror the entity exactly \u2014 ``max_width`` is an INTEGER\n(pixels, 200\u20132000) and ``layout`` one of the ``EmbedLayout`` enum\nvalues. The spec-validation middleware flags any drift between this\nmodel and the runtime payload ([SPEC_DRIFT] warnings), so keep it in\nlockstep with ``SurveyEmbedConfig.to_dict()``.",
        "example": {
          "allowed_domains": [
            "example.com"
          ],
          "auto_resize": true,
