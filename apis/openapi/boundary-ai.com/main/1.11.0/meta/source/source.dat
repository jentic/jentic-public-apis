    "/api/webhooks/{webhook_id}/secret/regenerate": {
      "post": {
        "summary": "Regenerate a webhook's HMAC secret",
        "description": "Generates a new HMAC signing key. The new secret is shown in the clear once and replaces the old one immediately \u2014 clients must update their signature verifier or they will start seeing signature-mismatch errors.",
        "tags": [
          "Webhooks"
        ],
        "operationId": "webhooks_post_secret_regenerate",
        "parameters": [
          {
            "name": "webhook_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            },
            "description": "Opaque retry key (24h window). Stops accidental double-rotations."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
