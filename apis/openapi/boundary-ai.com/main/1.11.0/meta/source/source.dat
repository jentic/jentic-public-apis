    "/reports/raw-data/{token}": {
      "get": {
        "summary": "Describe a report's raw-data download (no login)",
        "description": "PUBLIC endpoint behind the report's data-download card: the signed token IS the authorization. Returns what the download page shows before the access code is typed \u2014 report name, response and source counts, generation date, file name. Every failure mode returns the SAME opaque 404 so the endpoint cannot probe which reports exist.",
        "tags": [
          "Reports"
        ],
