            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SmsSendSchema"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted \u2014 task queued for async processing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SmsSendStartResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
