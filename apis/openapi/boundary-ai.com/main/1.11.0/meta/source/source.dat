    "/surveys/{survey_id}/respondent-lists/{list_id}/sms/send": {
      "post": {
        "summary": "Start an SMS send to a respondent list",
        "description": "Creates the send job and hands it to the SAME chunked, resumable engine that sends email \u2014 SMS is a second provider behind it, not a parallel sender. Refuses past the organisation's monthly segment cap (hard stop) and, above its recipient threshold, without an explicit `acknowledged` flag (speed bump). The estimate is recomputed here rather than trusted from the client, because the audience moves between being shown a number and approving it.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_post_respondent_list_sms_send",
        "parameters": [
          {
            "name": "survey_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "list_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
