    "/analysis/{analysis_id}/depth-text/{content_id}/segments/compare": {
      "get": {
        "summary": "Read the cached cross-segment comparison for an in-depth question",
        "description": "Cache lookup keyed on the sorted segment ids, each segment's updated_at and the locale \u2014 a re-run of any segment changes the key, so a stale comparison is never served. `status` is `completed`, `pending` (poll the in-depth task endpoint with `task_id`, then re-GET) or `missing` (POST to generate).",
        "tags": [
          "Analysis"
        ],
        "operationId": "analysis_get_depth_text_segment_compare",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Analysis ID"
          },
          {
            "name": "content_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Depth-text content ID (must belong to the analysis)"
          },
          {
            "name": "segment_ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated segment ids (2-6)"
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Viewer locale ISO code; defaults to the analysis language"
          },
          {
            "name": "weighted",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Look up the sample-weighted comparison (see the POST body flag)"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegmentCompareResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisFlatErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisFlatErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisFlatErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisFlatErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisFlatErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Generate (or serve cached) cross-segment comparison paragraph",
        "description": "One LLM call per distinct (segment set, content version, locale). Input is each segment's persisted themes (name, mention share, sentiment, one-line summary) plus its overview narrative \u2014 never raw comments. Serves the cache with `status: completed` when the current content version is already compared; otherwise submits the generation onto the shared in-depth summary pool and returns 202 with the `task_id` (poll the in-depth task endpoint, then re-GET). Costs 1 APS credit when a generation is submitted (402 when the org has none left).",
        "tags": [
          "Analysis"
        ],
        "operationId": "analysis_submit_depth_text_segment_compare",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Analysis ID"
          },
          {
            "name": "content_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Depth-text content ID (must belong to the analysis)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SegmentCompareRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegmentCompareResponse"
                }
              }
            }
          },
          "202": {
            "description": "Accepted \u2014 task queued for async processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegmentCompareResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisFlatErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisFlatErrorEnvelope"
                }
              }
            }
          },
          "402": {
            "description": "Payment Required \u2014 insufficient credits / APS",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisFlatErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisFlatErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisFlatErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisFlatErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/analysis/{analysis_id}/depth-text/{content_id}/segments/run": {
      "post": {
        "summary": "Queue (or return cached) the pipeline for one segment combo",
        "description": "202 with the segment row + task id. If the combo is already cached and `force_rerun` is false, no worker is submitted and the cached row comes back with `status: 'completed'` and `cached: true`. A combo matching no respondents returns `status: 'empty'` with a null segment_id.",
