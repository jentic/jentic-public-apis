    "/internal/cron/tick": {
      "post": {
        "summary": "Dispatch due cron jobs (Cloud Scheduler push target)",
        "description": "Machine-to-machine trigger for the externally-scheduled cron layer. Cloud Scheduler POSTs here on the backend service; auth is a Google OIDC bearer (or the shared-secret header), NOT a Clerk session. Claims each due registered job via an atomic cron_job_runs UPDATE and runs it on a daemon thread; extra ticks are no-ops. Not callable by end users or the frontend.",
        "tags": [
          "Internal"
        ],
        "operationId": "cron_tick",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "launched": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "skipped": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": []
      }
    },
    "/internal/jobs/execute": {
      "post": {
        "summary": "Execute a queued job (Cloud Tasks push target)",
        "description": "Machine-to-machine consumption endpoint for the durable job queue. Cloud Tasks POSTs the job envelope here on the worker service; auth is a Google OIDC bearer (or the QA shared-secret header), NOT a Clerk session. Not callable by end users or the frontend. Permanent failures are acknowledged with HTTP 200 and a `{\"status\": \"rejected\"}` body because Cloud Tasks retries any non-2xx response.",
        "tags": [
          "Internal"
        ],
        "operationId": "jobs_execute",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "done"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict (idempotency key reuse or resource conflict)",
