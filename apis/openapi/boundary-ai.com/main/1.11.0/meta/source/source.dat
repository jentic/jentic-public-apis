      "CreateCleaningRunRequest": {
        "additionalProperties": true,
        "description": "Body for ``POST /surveys/<survey_id>/cleaning-runs``.\n\nThere is deliberately no ``mode``: this endpoint can only ever create a\nDRY RUN. A destructive run is created by the apply endpoint, from a dry\nrun that is still fresh and still matches the survey's logic \u2014 making\n\"erase 4 000 answers\" unreachable from a single POST.",
        "properties": {
          "scope": {
            "additionalProperties": true,
            "description": "kind: all|completes|date_range|condition, plus date_from/date_to or condition_group, and include_simulated (default false)",
            "title": "Scope",
            "type": "object"
          }
        },
        "title": "CreateCleaningRunRequest",
        "type": "object"
      },
      "CleaningQuestionStatPayload": {
        "additionalProperties": true,
