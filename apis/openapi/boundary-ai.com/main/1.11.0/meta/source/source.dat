            "type": "string"
          },
          "connection_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Connection Name",
            "type": "string"
          },
          "datacenter_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "qualtrics: datacenter id (Account Settings > Qualtrics IDs)",
            "title": "Datacenter Id"
          },
          "auth_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "qualtrics: api_token (default) or oauth",
            "title": "Auth Method"
          },
          "api_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "qualtrics api_token auth: the API token",
            "title": "Api Token"
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "qualtrics oauth / inmoment: client id. surveymonkey: app client id (optional, enables webhooks)",
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "qualtrics oauth / inmoment: client secret. surveymonkey: app client secret (optional, enables webhooks)",
            "title": "Client Secret"
          },
          "api_base_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "inmoment: regional API host, e.g. https://api.inmoment.com",
            "title": "Api Base Url"
          },
          "inmoment_org_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "inmoment: numeric organization id (from the vendor discovery call)",
            "title": "Inmoment Org Id"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "inmoment: service user name if provisioned by the vendor",
            "title": "Username"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "inmoment: service user password if provisioned by the vendor",
            "title": "Password"
          },
          "data_center": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "surveymonkey: us (default), eu or ca \u2014 the account's API data center",
            "title": "Data Center"
          },
          "access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "surveymonkey: the private app's access token",
            "title": "Access Token"
          }
        },
        "required": [
          "provider",
          "connection_name"
        ],
        "title": "CxConnectionCreateRequest",
        "type": "object"
      },
