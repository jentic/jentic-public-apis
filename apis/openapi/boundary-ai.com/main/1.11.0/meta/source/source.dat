            },
            "title": "Quota Cells",
            "type": "array"
          }
        },
        "title": "UpdateQuotaCellsRequest",
        "type": "object"
      },
      "QuotaStatusResponse": {
        "additionalProperties": true,
        "description": "``GET /surveys/<survey_id>/quotas/status`` \u2014 the read-only view.\n\nCarries the response cap alongside the cells because a study manager\nasks one question (\"how full are we?\") that both answer.",
        "properties": {
          "quota_cells": {
