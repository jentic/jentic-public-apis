    "/report-style-templates": {
      "get": {
        "summary": "List the org's report style templates",
        "description": "Return the active org's style templates (optionally filtered by report_kind), plus the caller's per-kind default selection.\n\nEach template's `config` is a LIST PROJECTION, not the stored config: the embedded `customPages` canvas layout is replaced by a marker (everything the list UI reads \u2014 the branding colours \u2014 is kept), and a projected config carries `truncated: true`. The write-path validators reject that key, so a projected config cannot be saved back over the stored one. Use `GET /report-style-templates/{template_id}` for the full config.",
        "tags": [
          "Reports"
        ],
        "operationId": "reportstyle_list",
        "responses": {
