        "security": []
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "summary": "Download the live OpenAPI 3.1 spec (JSON)",
        "description": "Anonymous. Returns the FULL spec including operations tagged ``x-internal: true`` (e.g. the super-admin namespace) so external SDK codegen tools and auditors can consume it. The customer-facing FILTERED subset (drops the super-admin namespace) is at ``/api/v1/openapi-public.json``. Cached for 5 minutes.",
        "tags": [
          "OpenAPI"
        ],
        "operationId": "openapi_get_json",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Error",
