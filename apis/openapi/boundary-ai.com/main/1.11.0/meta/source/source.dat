            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "last_activity_at"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "envelope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "v2"
              ]
            },
            "description": "Set to 'v2' for the canonical paginated envelope."
          },
          {
            "name": "legacy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Set to '1' to force the legacy shape (deprecated; see Sunset header)."
          }
        ],
        "responses": {
          "200": {
            "description": "Enriched organization list. Default is the canonical `{data: {items, nextCursor, totalCount?}}` envelope; with `?legacy=1` the legacy `{organizations, total_count, total_pages, admin_role}` body is returned. Legacy responses carry `Deprecation: true` and a `Sunset` header.",
