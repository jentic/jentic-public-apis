{
  "openapi": "3.1.0",
  "info": {
    "title": "BoundaryAI API",
    "version": "1.11.0",
    "description": "Backend API for BoundaryAI. Operations marked `x-spec-pending: true` have route-level coverage but are awaiting domain owner schema enrichment.",
    "contact": {
      "name": "BoundaryAI Engineering",
      "email": "dev@boundary-ai.com"
    },
    "license": {
      "name": "Proprietary \u2014 BoundaryAI Terms of Service",
      "url": "https://baianalytics.com/terms-and-conditions/"
    },
    "termsOfService": "https://baianalytics.com/terms-and-conditions/"
  },
  "servers": [
    {
      "url": "https://api.boundary-ai.com",
      "description": "This deployment"
    }
  ],
  "tags": [
    {
      "name": "APIKeys",
      "description": "Customer-managed Input API keys (create, rotate, revoke, usage)."
    },
    {
      "name": "APS",
      "description": "APS (analytics processing seconds) credit accounting."
    },
    {
      "name": "AccessRequests"
    },
    {
      "name": "Analysis",
      "description": "Analysis lifecycle: runs, polling, flags, sub-flags, narratives, summaries."
    },
    {
      "name": "Auth",
      "description": "Account / authentication endpoints (Clerk JWT)."
    },
    {
      "name": "Chat"
    },
    {
      "name": "Client portal"
    },
    {
      "name": "Client portals (management)"
    },
    {
      "name": "Connectors",
      "description": "Inbound data connectors (web scraping orchestration)."
    },
    {
      "name": "Diagnostics",
      "description": "Internal health, readiness, and observability endpoints."
    },
    {
      "name": "Embed",
      "description": "Public embed widget surface (anonymous; HMAC-challenged)."
    },
    {
      "name": "Evolution",
      "description": "Time-series evolution tracking for super-themes."
    },
    {
      "name": "Field dashboard"
    },
    {
      "name": "FlagNotifications",
      "description": "Per-feedback-group flag notification subscriptions."
    },
    {
      "name": "FlagTemplates",
      "description": "Reusable flag-set templates for analysis."
    },
    {
      "name": "Health"
    },
    {
      "name": "InputAPI",
      "description": "Public customer-facing Input API (push content, manage surveys, webhooks)."
    },
    {
      "name": "Integrations",
      "description": "Third-party integrations (Merge.dev, etc.)."
    },
    {
      "name": "Internal"
    },
    {
      "name": "Library"
    },
    {
      "name": "MCP"
    },
    {
      "name": "Media"
    },
    {
      "name": "Native connectors"
    },
    {
      "name": "OpenAPI",
      "description": "OpenAPI 3.1 spec endpoints and Redoc UI."
    },
    {
      "name": "Organization",
      "description": "Org membership, theme settings, scoping."
    },
    {
      "name": "Payments",
      "description": "Stripe checkout, subscriptions, credit purchase."
    },
    {
      "name": "QualStudies"
    },
    {
      "name": "Report distribution"
    },
    {
      "name": "ReportDelivery"
    },
    {
      "name": "ReportSchedules",
      "description": "Scheduled report generation cadence + delivery."
    },
    {
      "name": "ReportSubscriptions"
    },
    {
      "name": "Reports",
      "description": "Generated report CRUD + scheduled report generation."
    },
    {
      "name": "SalesResources"
    },
    {
      "name": "Scraper",
      "description": "Scraper agent CRUD and execution lifecycle."
    },
    {
      "name": "SuperAdmin",
      "description": "Internal-only operations console (filtered from public spec)."
    },
    {
      "name": "SuperFlags"
    },
    {
      "name": "SurveySeries",
      "description": "Feedback group container CRUD + super-theme analytics."
    },
    {
      "name": "Surveys",
      "description": "Survey CRUD, translation, customization."
    },
    {
      "name": "Webhooks",
      "description": "Customer-facing webhook subscriptions for outbound events."
    },
    {
      "name": "Weighting"
    }
  ],
  "paths": {
    "/.well-known/oauth-protected-resource/api/mcp/oauth": {
      "get": {
        "summary": "OAuth protected resource discovery",
        "tags": [
          "MCP"
        ],
        "operationId": "mcp_oauth_metadata",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": []
      }
    },
    "/access-requests": {
      "post": {
        "summary": "Request demo access for an industry vertical",
        "tags": [
          "AccessRequests"
        ],
        "operationId": "access_requests_create",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAccessRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AccessRequestStatusResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Conflict (idempotency key reuse or resource conflict)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/access-requests/admin": {
      "get": {
        "summary": "List demo access requests (staff)",
        "tags": [
          "AccessRequests"
        ],
        "operationId": "access_requests_admin_list",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "declined"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AccessRequestListResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-internal": true
      }
    },
    "/access-requests/admin/{request_id}/approve": {
      "post": {
        "summary": "Approve a demo access request (staff) \u2014 sends the demo invite",
        "tags": [
          "AccessRequests"
        ],
        "operationId": "access_requests_admin_approve",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
