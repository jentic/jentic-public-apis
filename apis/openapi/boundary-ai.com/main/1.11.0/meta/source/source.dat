      "BulkQuestionContentPush": {
        "properties": {
          "question_id": {
            "description": "Target question id",
            "title": "Question Id",
            "type": "string"
          },
          "content": {
            "description": "Feedback entries \u2014 bare strings or structured items",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/components/schemas/ContentItem"
                }
              ]
            },
            "minItems": 1,
            "title": "Content",
            "type": "array"
          }
        },
        "required": [
          "question_id",
          "content"
        ],
        "title": "BulkQuestionContentPush",
        "type": "object"
      },
      "BulkContentPushRequest": {
        "example": {
          "questions": [
            {
              "content": [
                "Customer feedback line 1",
                "Customer feedback line 2"
              ],
              "question_id": "100"
            },
            {
              "content": [
                "Another verbatim from a different question"
              ],
              "question_id": "101"
            }
          ],
          "source_reference": "zendesk-ticket-9001",
          "survey_id": "42",
          "survey_series_id": "7"
        },
        "properties": {
          "survey_series_id": {
            "title": "Survey Series Id",
            "type": "string"
          },
          "survey_id": {
            "title": "Survey Id",
            "type": "string"
          },
          "questions": {
            "description": "Up to 100 question-content pairs in a single batch",
            "items": {
              "$ref": "#/components/schemas/BulkQuestionContentPush"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Questions",
            "type": "array"
          },
          "source_reference": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Reference"
          },
          "sync": {
            "default": false,
            "description": "Run the push inline and return the completed result (200) instead of a task id (202). Honoured for small batches only; larger ones fall back to the async path and still return 202, as do requests arriving while the inline slots are busy.\n\nEvery row must carry an `external_id` when this is true: an inline push can be interrupted by its timeout, and the id is what makes a retry converge on the same rows instead of duplicating them. Rows without one are rejected with `SYNC_REQUIRES_EXTERNAL_ID` (400) \u2014 omit `sync` to push them asynchronously.",
            "title": "Sync",
            "type": "boolean"
          }
        },
        "required": [
          "survey_series_id",
          "survey_id",
          "questions"
        ],
        "title": "BulkContentPushRequest",
        "type": "object"
      },
      "BulkPushAccepted": {
        "description": "202 body of POST /api/input/content/push/bulk.",
        "example": {
          "status": "accepted",
          "status_url": "/api/input/content/push/bulk/status/bp_abc123",
          "survey_id": 42,
          "survey_series_id": 7,
          "task_id": "bp_abc123"
        },
        "properties": {
          "status": {
            "const": "accepted",
            "title": "Status",
            "type": "string"
          },
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "survey_series_id": {
            "title": "Survey Series Id",
            "type": "integer"
          },
          "survey_id": {
            "title": "Survey Id",
            "type": "integer"
          },
          "status_url": {
            "title": "Status Url",
            "type": "string"
          }
        },
        "required": [
          "status",
          "task_id",
          "survey_series_id",
          "survey_id",
          "status_url"
        ],
        "title": "BulkPushAccepted",
        "type": "object"
      },
      "BulkPushResult": {
        "description": "200 body of a SYNCHRONOUS bulk push (``\"sync\": true``).\n\nSame shape the async path eventually exposes under\n``BulkPushStatus.result`` \u2014 one response model for one result, so a\nclient that starts synchronous and later grows into the async path\nparses the identical structure either way.",
        "example": {
          "questions": [
            {
              "inserted": 2,
              "question_id": 100,
              "status": "success"
            },
            {
              "inserted": 1,
              "question_id": 101,
              "status": "success"
            }
          ],
          "status": "success",
          "survey_id": 42,
          "survey_series_id": 7,
          "total_aps_deducted": 3,
          "total_inserted": 3,
          "total_rows_accepted": 3,
          "total_skipped_duplicates": 0
        },
        "properties": {
          "status": {
            "const": "success",
            "description": "Always 'success' on this body. Discriminates the synchronous 200 result from the asynchronous 202 acknowledgement, whose status is 'accepted' \u2014 a client that may send `sync` should branch on this rather than on the status code alone.",
            "title": "Status",
            "type": "string"
          },
          "survey_series_id": {
            "title": "Survey Series Id",
            "type": "integer"
          },
          "survey_id": {
            "title": "Survey Id",
            "type": "integer"
          },
          "total_inserted": {
            "description": "Rows actually written (excludes external_id duplicates)",
            "title": "Total Inserted",
            "type": "integer"
          },
          "total_rows_accepted": {
            "description": "Rows admitted for processing",
            "title": "Total Rows Accepted",
            "type": "integer"
          },
          "total_aps_deducted": {
            "description": "Deprecated: rows actually written (same value as total_inserted), matching the per-key usage log \u2014 no APS is pre-deducted under token billing, and a fully-deduplicated retry reports 0",
            "title": "Total Aps Deducted",
            "type": "integer"
          },
          "total_skipped_duplicates": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Rows skipped because their (question, external_id) pair already existed \u2014 the sum of the per-question skipped_duplicates counts. On a fully-deduplicated retry this equals the row count while total_inserted is 0, and the push is still a success.",
            "title": "Total Skipped Duplicates"
          },
          "questions": {
            "description": "Per-question outcome: {question_id, inserted, status, ...}",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Questions",
            "type": "array"
          }
        },
        "required": [
          "status",
          "survey_series_id",
          "survey_id",
          "total_inserted",
          "total_rows_accepted",
          "total_aps_deducted"
        ],
        "title": "BulkPushResult",
        "type": "object"
      },
      "BulkPushOutcome": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/BulkPushResult"
          },
          {
            "$ref": "#/components/schemas/BulkPushAccepted"
          }
        ],
        "description": "Either 2xx body of a bulk push, discriminated by ``status``.\n\nThe operation returns 202 + ``task_id`` by default and 200 + the\ncompleted result when the caller sends ``sync``. Declaring the two\nbodies against their own status codes is the accurate spec, but\ngenerators that type an operation from a single 2xx (openapi-typescript-\ncodegen picks the lowest) then emit the sync-only shape for the default\ncall \u2014 external consumers read ``total_inserted`` and get undefined with\nno compile error. Declaring this union on both codes costs a little\nprecision (a 200 never actually carries the accepted shape) and buys a\ncorrect type from every generator. Branch on ``status``:\n``\"accepted\"`` \u2192 still running, poll ``status_url``; ``\"success\"`` \u2192\nfinished, read ``total_inserted``.",
        "title": "BulkPushOutcome"
      },
      "BulkFieldContentPush": {
        "properties": {
          "field_id": {
            "title": "Field Id",
            "type": "string"
          },
          "content": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/components/schemas/ContentItem"
                }
              ]
            },
            "minItems": 1,
            "title": "Content",
            "type": "array"
          }
        },
        "required": [
          "field_id",
          "content"
        ],
        "title": "BulkFieldContentPush",
        "type": "object"
      },
      "BulkFeedbackPushRequest": {
        "properties": {
          "feedback_group_id": {
            "title": "Feedback Group Id",
            "type": "string"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/BulkFieldContentPush"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Fields",
            "type": "array"
          },
          "source_reference": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source Reference"
          },
          "sync": {
            "default": false,
            "description": "Run the push inline and return the completed result (200) instead of a task id (202). Honoured for small batches only; larger ones fall back to the async path and still return 202, as do requests arriving while the inline slots are busy.\n\nEvery row must carry an `external_id` when this is true: an inline push can be interrupted by its timeout, and the id is what makes a retry converge on the same rows instead of duplicating them. Rows without one are rejected with `SYNC_REQUIRES_EXTERNAL_ID` (400) \u2014 omit `sync` to push them asynchronously.",
            "title": "Sync",
            "type": "boolean"
          }
        },
        "required": [
          "feedback_group_id",
          "source_id",
          "fields"
        ],
        "title": "BulkFeedbackPushRequest",
        "type": "object"
      },
      "BulkFeedbackPushAccepted": {
        "properties": {
          "status": {
            "const": "accepted",
            "title": "Status",
            "type": "string"
          },
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "feedback_group_id": {
            "title": "Feedback Group Id",
            "type": "integer"
          },
          "source_id": {
            "title": "Source Id",
            "type": "integer"
          },
          "status_url": {
            "title": "Status Url",
            "type": "string"
          }
        },
        "required": [
          "status",
          "task_id",
          "feedback_group_id",
          "source_id",
          "status_url"
        ],
        "title": "BulkFeedbackPushAccepted",
        "type": "object"
      },
      "BulkFeedbackPushResult": {
        "description": "200 body of a SYNCHRONOUS partner-vocabulary bulk push.\n\nPartner projection of :class:`BulkPushResult` \u2014 the runtime key\ntranslation renames survey_series_id/survey_id/questions/question_id,\nso the model has to mirror that rename or the generated client would\ndescribe keys the wire never carries.",
        "properties": {
          "status": {
            "const": "success",
            "description": "Always 'success'; the 202 acknowledgement uses 'accepted'",
            "title": "Status",
            "type": "string"
          },
          "feedback_group_id": {
            "title": "Feedback Group Id",
            "type": "integer"
          },
          "source_id": {
            "title": "Source Id",
            "type": "integer"
          },
          "total_inserted": {
            "title": "Total Inserted",
            "type": "integer"
          },
          "total_rows_accepted": {
            "title": "Total Rows Accepted",
            "type": "integer"
          },
          "total_aps_deducted": {
            "title": "Total Aps Deducted",
            "type": "integer"
          },
          "total_skipped_duplicates": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Rows skipped because their (field, external_id) pair already existed \u2014 the sum of the per-field skipped_duplicates counts.",
            "title": "Total Skipped Duplicates"
          },
          "fields": {
            "description": "Per-field outcome: {field_id, inserted, status, ...}",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Fields",
            "type": "array"
          }
        },
        "required": [
          "status",
          "feedback_group_id",
          "source_id",
          "total_inserted",
          "total_rows_accepted",
          "total_aps_deducted"
        ],
        "title": "BulkFeedbackPushResult",
        "type": "object"
      },
      "BulkFeedbackPushOutcome": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/BulkFeedbackPushResult"
          },
          {
            "$ref": "#/components/schemas/BulkFeedbackPushAccepted"
          }
        ],
        "description": "Partner-vocabulary twin of :class:`BulkPushOutcome`. Same reasoning:\none union across both 2xx codes so every generator emits a correct type.\nDiscriminated by ``status`` \u2014 ``\"accepted\"`` or ``\"success\"``.",
        "title": "BulkFeedbackPushOutcome"
      },
      "BulkPushStatus": {
        "description": "200/202 body of GET /api/input/content/push/bulk/status/{task_id}.",
        "example": {
