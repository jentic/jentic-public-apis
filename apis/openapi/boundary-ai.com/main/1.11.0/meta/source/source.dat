      "QuotaCellPayload": {
        "additionalProperties": true,
        "description": "One quota cell: its definition AND its live counter.\n\nDefinition and status are one payload on purpose. An author adjusting a\ntarget needs to see how full the cell already is \u2014 splitting them would\nmean two reads of one thing and a UI that can render them out of step.",
        "properties": {
          "cell_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cell Id"
          },
          "survey_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Survey Id"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "condition_group": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "#2573 condition group; null = counts every complete",
            "title": "Condition Group"
          },
          "target": {
            "default": 0,
            "title": "Target",
            "type": "integer"
          },
          "on_full": {
            "default": "screen_out",
            "description": "screen_out | continue_and_flag",
            "title": "On Full",
            "type": "string"
          },
          "position": {
            "default": 0,
            "title": "Position",
            "type": "integer"
          },
          "current": {
            "default": 0,
            "description": "Slots taken (completed, not excluded, matching)",
            "title": "Current",
            "type": "integer"
          },
          "remaining": {
            "default": 0,
            "title": "Remaining",
            "type": "integer"
          },
          "percent_filled": {
            "default": 0.0,
            "title": "Percent Filled",
            "type": "number"
          },
          "is_full": {
            "default": false,
            "title": "Is Full",
            "type": "boolean"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Created At"
          }
        },
        "required": [
          "name"
        ],
        "title": "QuotaCellPayload",
        "type": "object"
      },
      "QuotaCellsResponse": {
        "additionalProperties": true,
        "properties": {
          "quota_cells": {
            "items": {
              "$ref": "#/components/schemas/QuotaCellPayload"
            },
            "title": "Quota Cells",
            "type": "array"
          }
        },
        "title": "QuotaCellsResponse",
        "type": "object"
      },
      "UpdateQuotaCellsRequest": {
        "additionalProperties": true,
        "description": "``PUT /surveys/<survey_id>/quotas`` \u2014 the WHOLE cell set, which\nreplaces whatever was stored.\n\nSend back each existing cell's ``cell_id``: it is what preserves that\ncell's counter through a rename, a target change or a reorder. A cell\nwithout one is created fresh with an empty counter.",
        "properties": {
          "quota_cells": {
            "items": {
