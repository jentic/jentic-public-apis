    "/api/keys/{key_id}/rotate": {
      "post": {
        "summary": "Rotate an API key \u2014 create a new one and revoke the old",
        "description": "Returns 201 with the new key (and its `plaintext_key` shown once). The old key is revoked atomically. Rotating a test key in production is blocked \u2014 operators must create a new live key.",
        "tags": [
          "APIKeys"
        ],
        "operationId": "apikeys_post_rotate",
        "parameters": [
          {
            "name": "key_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            },
            "description": "Opaque retry key (24h window) honoured by the @idempotent decorator."
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CreatedAPIKey"
