    "/api/embed/survey/{token}": {
      "get": {
        "summary": "Load survey data for an embedded widget",
        "description": "Anonymous endpoint used by the embed widget to load a survey's questions, customisation and embed config. Issues a single-use HMAC challenge token that the client must echo back when submitting answers. Rate limited by client IP. A 403 names why the widget may not start an interview: SURVEY_CLOSED (with the survey's end_screens, for the survey_closed screen), LINK_EXPIRED (expired campaign link), DOMAIN_NOT_ALLOWED (a domain outside the survey's allowlist, the submit path's code) or SURVEY_ERROR (not published or embedding disabled). A passcode-protected survey ships its content only with the right ``pass_code``: without it the 200 is a locked payload (``survey.passcode_required: true``, no questions, logic, end screens, name, description, logo, redirect, custom CSS or theme text, and no challenge_token: the load with the right passcode carries it) and a closed survey's SURVEY_CLOSED carries ``passcode_required: true`` instead of its end_screens. Wrong passcodes count toward the hosted page's failed-passcode budget; once it is spent a passcode is answered 429 RATE_LIMITED without being checked.",
        "tags": [
          "Embed"
        ],
        "operationId": "embed_get_survey",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Opaque survey-link token"
          },
          {
            "name": "rtoken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Respondent-list token; the payload then carries the referenced respondent metadata."
          },
          {
            "name": "pass_code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Survey passcode, for a passcode-protected survey."
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Caller origin for CORS reflection."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedSurveyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedFlatErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedLoadRefusalEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedFlatErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate Limited \u2014 see Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedFlatErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedFlatErrorEnvelope"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/embed/survey/{token}/followup": {
      "post": {
        "summary": "Request an AI follow-up question from an embedded survey widget",
        "description": "The widget's half of #2597, so probing behaves identically here and on the hosted respond page. Returns `{followup: null}` for EVERY outcome that is not a valid probe \u2014 trigger not met, probing off, budget spent, organisation out of credit, model timeout, failed validation. There is no error path: a respondent is waiting, and the interview must continue either way.\n\nDeliberately does NOT consume the HMAC challenge token. That token is single-use by design (its nonce is burned on validation) and it belongs to the SUBMISSION \u2014 spending it here would make the respondent's actual submit fail, which is a far worse outcome than an unauthenticated probe request. What bounds this endpoint instead is what bounds the spend: the per-question toggle, the per-survey master switch and call cap claimed atomically, and the organisation's APS credit pre-gate \u2014 plus the embed rate limiter. A caller learns nothing from probing it and gains nothing from replaying it.",
        "tags": [
          "Embed"
        ],
        "operationId": "embed_post_followup",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Opaque survey-link token"
          },
          {
            "name": "Origin",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Caller origin for CORS reflection."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FollowupProbeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedFlatErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedFlatErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Rate Limited \u2014 see Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedFlatErrorEnvelope"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbedFlatErrorEnvelope"
                }
              }
            }
          }
        },
        "security": []
      }
    },
