      "ThemeScoresBuildingResponse": {
        "additionalProperties": true,
        "description": "The 202 body of the theme-setup / scores / explore routes while the\ngroup or the payload builds (``theme_scores_reader.building_payload``).\nPoll again; ``reason`` says why (PR #3065 QA R2-NEW-24/16/26).",
        "properties": {
          "status": {
            "const": "building",
            "title": "Status",
            "type": "string"
          },
          "retry_after_seconds": {
            "description": "Seconds to wait before polling again.",
            "title": "Retry After Seconds",
            "type": "integer"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "first_build",
                  "first_payload",
                  "policy_changed",
                  "sources_changed"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "first_build: the group has no build of its current sources yet; first_payload: the group is built, this scope's first payload is computing; policy_changed: a response was excluded or erased, or a column protected, since the last build (never served stale); sources_changed: a source joined or left the group since the last build.",
            "title": "Reason"
          }
        },
        "required": [
          "status",
          "retry_after_seconds"
        ],
        "title": "ThemeScoresBuildingResponse",
        "type": "object"
      },
