              "type": "string"
            },
            "description": "One of VALID_TIMEFRAMES; defaults to 'all'."
          },
          {
            "name": "period_key",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional evolution bucket period key."
          },
          {
            "name": "language",
            "in": "query",
