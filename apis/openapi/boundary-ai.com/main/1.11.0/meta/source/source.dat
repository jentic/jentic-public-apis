                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/CreateSurveySeriesResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                },
                "example": {
                  "status": "success",
