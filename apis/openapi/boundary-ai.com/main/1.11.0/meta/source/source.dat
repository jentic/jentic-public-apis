                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timestamp Field"
          },
          "timestamp_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Timestamp Mode"
          },
          "tie_field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Tie Field"
          },
          "sample_size": {
            "default": 60,
            "maximum": 200,
            "minimum": 1,
            "title": "Sample Size",
            "type": "integer"
          },
          "population_fields": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Population Fields",
