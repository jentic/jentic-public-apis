      "delete": {
        "summary": "Delete a flag-template folder",
        "description": "Deletes a folder. `?contents=move` (default) moves its flags into its parent folder (Uncategorized for a top-level folder) and promotes its subfolders one level up, keeping their own flags; `?contents=delete` deletes every flag and every subfolder in the whole subtree. Flags and subfolders are never cascade-deleted unless explicitly requested.",
        "tags": [
          "FlagTemplates"
        ],
        "operationId": "flagtemplates_delete_folder",
        "parameters": [
          {
            "name": "folder_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "contents",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "move",
                "delete"
              ],
              "default": "move"
