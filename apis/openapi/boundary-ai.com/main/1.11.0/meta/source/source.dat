            "title": "Next Scheduled At"
          },
          "generated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "UTC datetime the report finished generating",
            "title": "Generated At"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "UTC datetime the report row was inserted",
            "title": "Created At"
          },
          "consecutive_failures": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Number of consecutive generation failures for retry/backoff bookkeeping",
            "title": "Consecutive Failures"
          },
          "last_error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Most recent failure message, when the last generation attempt failed",
            "title": "Last Error Message"
          },
          "last_error_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "UTC datetime of the most recent failure",
            "title": "Last Error At"
          },
          "producible_formats": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Formats the report can be sent as (pdf, word, xlsx, pptx). A file stored from a monitor or a survey result is only its own format; a send asking for another is refused.",
            "title": "Producible Formats"
          }
        },
        "title": "ReportResponse",
        "type": "object"
      },
      "ReportsFlatErrorEnvelope": {
        "description": "Flat ``{\"message\": \"...\"}`` error shape used across the reports\ndomain. Distinct from the canonical ``ErrorEnvelope`` whose top-level\nkey is ``error`` with a nested ``{code, message}`` object.",
        "example": {
          "message": "Report not found"
        },
        "properties": {
          "message": {
            "description": "Human-readable error message",
            "title": "Message",
            "type": "string"
          }
