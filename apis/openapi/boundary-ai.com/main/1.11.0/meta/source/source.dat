    "/native-connectors/medallia/connections/{connection_id}/field-usage": {
      "post": {
        "summary": "Which Medallia fields actually carry data for a given segment",
        "description": "Samples one bounded page of records through the same window and segmentation a live sync would use, and reports how often each requested field is populated. Medallia's field catalogue lists hundreds of fields and does NOT say which belong to which Experience Program, so this is the only reliable way to tell an operator which fields their records will actually have. Reads nothing but metadata counts; writes nothing. With `Prefer: respond-async` it runs in the background: answers 202 with a job_id to poll at GET /medallia/probe-jobs/{job_id}, and the same request while one is running joins it. Without the header it answers 200 with the report.",
        "tags": [
          "Native connectors"
        ],
        "operationId": "native_connectors_post_medallia_field_usage",
        "parameters": [
          {
            "name": "connection_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Prefer",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "respond-async"
            },
            "description": "Send `respond-async` to run the probe in the background: the answer is then 202 with a `job_id` to poll at GET /medallia/probe-jobs/{job_id}. Without it the request waits for the report (200), as before."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MedalliaFieldUsageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MedalliaFieldUsageResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "202": {
            "description": "Accepted \u2014 task queued for async processing",
            "content": {
