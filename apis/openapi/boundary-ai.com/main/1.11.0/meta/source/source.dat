            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Citation hash to locate; response carries its focus_index",
            "title": "Find Hash"
          },
          "cursor": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Opaque keyset cursor from a previous page's next_cursor; takes precedence over page",
            "title": "Cursor"
          },
          "sub_flag": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only comments matched under this sub-flag (sub-category)",
            "title": "Sub Flag"
          },
          "survey_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only comments from these sources (survey ids)",
            "title": "Survey Ids"
          }
        },
        "required": [
          "super_flag_name"
        ],
        "title": "SuperFlagCommentsRequest",
        "type": "object"
      },
      "SuperFlagCommentItem": {
