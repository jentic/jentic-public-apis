    "/analysis/{analysis_id}/depth-text/{content_id}/segments/run-all": {
      "post": {
        "summary": "Queue pipeline runs for every uncached, non-empty segment combo",
        "description": "Enumerates every combo of the active segmentation (`segmentation_question_ids`, or every segmentable question in the survey when omitted) and queues runs for the ones that aren't cached. Returns 202 with a `bundle_id` to poll via GET /segment-bundles/{bundle_id}. `status: 'too_large'` (with `total_candidates` + `cap`) means the combo space exceeded the hard cap and nothing was queued.",
