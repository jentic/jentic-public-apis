    "/webhooks/sendgrid/events": {
      "post": {
        "summary": "Receive SendGrid delivery events",
        "description": "Signed Event Webhook deliveries from SendGrid (ECDSA signature in `X-Twilio-Email-Event-Webhook-Signature`). Maps delivery outcomes onto respondent-send recipients: `delivered` updates status; `bounce`/`dropped` suppress the address for the survey; `spamreport` records a complaint (feeds the API-send auto-pause gate). Always 200 after signature verification \u2014 SendGrid retries non-2xx for up to 24h, and processing failures are bugs to fix, not conditions where retrying helps. 503 when SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY is unconfigured: unsigned ingestion would let a forged event suppress arbitrary addresses.",
        "tags": [
          "Webhooks"
        ],
        "operationId": "webhooks_post_sendgrid_events",
        "parameters": [
          {
            "name": "X-Twilio-Email-Event-Webhook-Signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ECDSA signature over timestamp+payload"
          },
          {
            "name": "X-Twilio-Email-Event-Webhook-Timestamp",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendGridEventsResult"
                }
              }
            }
