    "/surveys/survey-themes/{theme_id}/apply": {
      "post": {
        "summary": "Apply a theme to one or many surveys",
        "description": "Attaches the theme and CLEARS each survey's own overrides \u2014 applying a theme is the author's statement that the survey should look like the theme. Survey ids outside the caller's organisation are skipped in SQL, so the returned list can be shorter than the request. Last write wins: each applied survey's simple-mode colour and font are rewritten to the theme's (``simple_mode``); logos are kept.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_post_theme_apply",
