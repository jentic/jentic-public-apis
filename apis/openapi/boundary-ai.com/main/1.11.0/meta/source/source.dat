    "/surveys/{survey_id}/theme": {
      "get": {
        "summary": "Get a survey's resolved theme",
        "description": "``theme`` is null when the survey has no expert theme \u2014 the state every survey is in until its first expert-mode save, and the one in which the renderers emit no theme CSS at all. ``seed_tokens`` is what the editor should start from: today's colour and font already in token form, so the first expert save changes nothing on screen.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_get_survey_theme",
        "parameters": [
          {
            "name": "survey_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ResolvedSurveyThemeResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "summary": "Set a survey's theme reference and per-survey overrides",
        "description": "Both halves of the binding are written together. ``theme_id`` null with non-empty overrides is a survey styled on its own; both null returns the survey to the no-theme state it shipped in. Last write wins: the resolved primary colour and body font are copied into the survey's simple-mode ``color_code``/``font_family`` and returned as ``simple_mode`` for the builder to adopt.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_put_survey_theme",
        "parameters": [
          {
            "name": "survey_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SurveyThemeBindingSchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ResolvedSurveyThemeResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
