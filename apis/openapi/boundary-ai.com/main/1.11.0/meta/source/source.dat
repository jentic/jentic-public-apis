    "/surveys/{survey_id}/respondent-lists/{list_id}/phones": {
      "post": {
        "summary": "Detect and normalise a respondent list's phone column to E.164",
        "description": "Auto-detects the phone column by header name and content shape \u2014 the same two-rule detector the email column uses \u2014 and normalises every value to E.164 using the list's default country. Unparseable numbers are IMPORTED AND FLAGGED with a reported count, never dropped: a client's file is their record. Re-runnable, so correcting the country re-normalises the whole list.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_post_respondent_list_phones",
        "parameters": [
          {
            "name": "survey_id",
