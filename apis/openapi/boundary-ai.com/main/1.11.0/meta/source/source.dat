                  "type": "object",
                  "properties": {
                    "reportName": {
                      "type": "string"
                    },
                    "responses": {
                      "type": "integer"
                    },
                    "sources": {
                      "type": "integer"
                    },
                    "generatedAt": {
                      "type": "string",
                      "nullable": true
                    },
                    "filename": {
                      "type": "string"
                    }
