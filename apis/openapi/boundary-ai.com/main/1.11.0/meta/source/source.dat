    "/admin/relevance-audit/backtest": {
      "post": {
        "summary": "Backtest a proposed keep-rule edit against the real gate",
        "description": "Replays `proposals` \u2014 `{rule_index, old_text, new_text}` edits, applied in place against the scraper's live keep rules \u2014 through `apply_keep_rules_gate`, over the cluster's marked comments plus a bounded sample of currently-kept comments from the same execution. `mark_ids` scopes the replay to exactly the marks the caller adjudicated \u2014 omit it and the catch rate is measured against the whole current cluster, which is a different population. Pass the same `window_days` / `max_marks` used for the cluster export, or marks outside the server's default window will not resolve. Reports catch and collateral as a RANGE over repeated replays, because the gate is an LLM pass. Rejects the diff (`accepted: false`) when catch falls below, or collateral rises above, the configured thresholds. Writes nothing: applying an accepted diff is a separate, human-driven `PUT /scrapers/{id}`.",
        "tags": [
          "SuperAdmin"
        ],
        "operationId": "superadmin_relevance_audit_backtest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RelevanceAuditBacktestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/RelevanceAuditBacktestResponse"
