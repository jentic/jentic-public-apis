    "/native-connectors/medallia/connections/{connection_id}": {
      "patch": {
        "summary": "Edit a Medallia connection",
        "description": "Rename it, rotate the client secret, or repoint it. Without this, correcting a typo or handling a routine secret rotation meant DELETING the connection, which cascades to every sync config on it and orphans the sources they feed. Fields are optional; anything absent is left untouched, and an omitted client_secret keeps the stored one. Repointing at a different tenant resets each sync's saved position, because a position recorded in one tenant's data means nothing in another's.",
        "tags": [
          "Native connectors"
        ],
        "operationId": "native_connectors_patch_medallia_connection",
        "parameters": [
          {
            "name": "connection_id",
