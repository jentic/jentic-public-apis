      "SegmentCompareResponse": {
        "additionalProperties": true,
        "description": "``GET``/``POST .../segments/compare`` \u2014 cached-or-task comparison.\n\n``status`` is ``'completed'`` (paragraph + evidence present),\n``'pending'`` (a pool task is generating; poll the in-depth task\nendpoint with ``task_id``, then re-GET), or ``'missing'`` (GET only \u2014\nnothing cached for this segment set / locale / content version).",
        "properties": {
          "status": {
            "description": "'completed' | 'pending' | 'missing'",
            "title": "Status",
            "type": "string"
          },
          "cache_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Content-version storage key",
            "title": "Cache Key"
          },
          "paragraph": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The comparison paragraph",
            "title": "Paragraph"
          },
          "lang": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Lowercase ISO code the paragraph is written in",
            "title": "Lang"
          },
          "segment_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Segment Ids"
          },
          "segments": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SegmentCompareSegmentItem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Segments"
          },
          "aligned_rows": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "[{themes: {'<segment_id>': '<theme name>'|null}}] \u2014 row-aligned display aid",
            "title": "Aligned Rows"
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Present while status is 'pending'",
            "title": "Task Id"
          },
          "weighted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Whether the comparison was computed on sample-weighted figures",
            "title": "Weighted"
          }
        },
        "required": [
          "status"
        ],
        "title": "SegmentCompareResponse",
        "type": "object"
      },
      "SegmentCompareRequest": {
        "properties": {
          "segment_ids": {
            "description": "2-6 COMPLETED segment ids of this content to compare",
            "items": {
              "type": "integer"
            },
            "title": "Segment Ids",
            "type": "array"
          },
          "lang": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Viewer locale (ISO code) for the paragraph; defaults to the analysis language",
            "title": "Lang"
          },
          "weighted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": false,
            "description": "Compare sample-WEIGHTED figures (mention shares over the weighted N, effective-n low-sample flag) when the survey has an active weighting config; ignored otherwise. A weighted comparison is cached apart from the raw one.",
            "title": "Weighted"
          }
        },
        "required": [
          "segment_ids"
        ],
        "title": "SegmentCompareRequest",
        "type": "object"
      },
