    "/report-distribution/summary": {
      "get": {
        "summary": "What the organisation uses",
        "description": "Counts that decide which Reports hub tabs show: recipients, lots, lots waiting for review, planifications. `group_id` counts only what touches one feedback group (its Rapports view). `list_views` counts the organisation's source PDFs and sent monitor and survey-result PDFs, so the reports list only offers the views that have something in them.",
        "tags": [
