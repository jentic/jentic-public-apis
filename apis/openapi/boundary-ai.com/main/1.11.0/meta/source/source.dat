      "CxWebhookAckResponse": {
        "additionalProperties": true,
        "description": "Acknowledgement of a provider push callback.",
        "properties": {
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "queued | started | ignored | disabled (POST); absent on HEAD",
