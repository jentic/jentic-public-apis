      },
      "AnalysisLanguageRequest": {
        "additionalProperties": true,
        "description": "``PATCH /surveyseries/<org_id>/<series_id>/analysis-language`` body.\n\n``analysis_language`` is a lowercase ISO-639-1 code restricted to the\ngroup's supported analysis languages (``en``/``fr``/``es``); an\nunsupported or malformed value is a 400.",
        "properties": {
          "analysis_language": {
            "description": "Lowercase ISO-639-1 analysis language code (en/fr/es)",
            "title": "Analysis Language",
            "type": "string"
          }
