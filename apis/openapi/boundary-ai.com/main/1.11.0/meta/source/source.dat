      "ApplyCleaningRunRequest": {
        "additionalProperties": true,
        "description": "Body for ``POST .../cleaning-runs/<run_id>/apply``.\n\nBoth fields are required and both are re-checked server-side: a confirm\ndialog is a client-side courtesy, this is the gate.",
        "properties": {
          "confirm_name": {
            "description": "The survey's name, typed back verbatim",
            "title": "Confirm Name",
            "type": "string"
