      "put": {
        "summary": "Switch AI follow-ups and live analysis on or off for a survey",
        "description": "The one-click kill switch. Setting `ai_followups_enabled` false silences probing across the whole study mid-field without editing any question and without invalidating anything already collected. Setting `live_analysis_enabled` false stops the incremental sweep on its next tick and drops the preview rows, so no stale readout is left being refreshed by nothing.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_put_ai_settings",
        "parameters": [
          {
            "name": "survey_id",
            "in": "path",
