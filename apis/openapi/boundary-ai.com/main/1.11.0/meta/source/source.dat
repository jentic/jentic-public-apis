            "additionalProperties": true,
            "title": "Ai Followup Config",
            "type": "object"
          },
          "analyze_sentiment": {
            "default": true,
            "title": "Analyze Sentiment",
            "type": "boolean"
          },
          "analyze_topics": {
            "default": true,
            "title": "Analyze Topics",
            "type": "boolean"
          },
          "ai_followups_enabled": {
            "default": false,
            "title": "Ai Followups Enabled",
            "type": "boolean"
          },
          "ai_followup_call_cap": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
