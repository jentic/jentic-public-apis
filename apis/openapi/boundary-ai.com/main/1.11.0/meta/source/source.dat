    "/surveyseries/{org_id}/{survey_series_id}/super-flags/recompute": {
      "post": {
        "summary": "Kick off a background super-flag recompute (202)",
        "description": "Acquires the per-(series, timeframe) computation lock and schedules the recompute in the background. `lock_acquired: false` means another runner is already computing \u2014 poll GET /super-flags (it surfaces `computing: true`) either way. A group with no sources returns 200 with an empty super-flags payload instead. Costs 1 APS credit (402 when the org has none left). Parameters travel in the query string.",
        "tags": [
          "SuperFlags"
        ],
        "operationId": "superflags_recompute",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Organization ID"
          },
          {
            "name": "survey_series_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Survey series (feedback group) ID"
          },
          {
            "name": "timeframe",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "One of VALID_TIMEFRAMES; defaults to 'all'."
          },
          {
            "name": "period_key",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional evolution bucket period key."
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "DEPRECATED \u2014 accepted for backward compatibility but ignored: short summaries are generated in the group's analysis_language (super-theme parity)."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuperFlagsListResponse"
                }
              }
            }
          },
          "202": {
            "description": "Accepted \u2014 task queued for async processing",
