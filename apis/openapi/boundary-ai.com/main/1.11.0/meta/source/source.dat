    "/chat/{org_id}/ask": {
      "post": {
        "summary": "Ask a chat question (Server-Sent Events stream)",
        "description": "Returns a long-lived ``text/event-stream`` carrying typed chat events: ``plan_ready``, then ``tool_running`` / ``tool_result`` per tool call, ``keepalive`` while the model works, ``answer_token``*, ``answer_citations`` and exactly one ``done`` carrying the turn's ``outcome``; a disclosed failure precedes ``done`` with one ``error``.",
        "tags": [
          "Chat"
        ],
        "operationId": "chat_post_ask",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Organization ID"
          }
        ],
        "requestBody": {
          "required": true,
