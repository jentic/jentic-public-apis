          "language",
          "preferred_english",
          "alternatives"
        ],
        "title": "QualGlossaryConflict",
        "type": "object"
      },
      "QualGlossaryReport": {
        "description": "What the glossary cleanup did. Upload-only keys are absent on\ninline-JSON creates and edits.",
        "properties": {
          "duplicates_removed": {
            "description": "Rows dropped as verbatim repeats of an earlier (term, language).",
            "title": "Duplicates Removed",
            "type": "integer"
          },
          "conflicts": {
            "description": "Terms listed more than once with DIFFERENT preferred English; the first rendering is used, the others move to the notes.",
            "title": "Conflicts",
            "type": "integer"
          },
          "conflict_samples": {
            "description": "The first few conflicts, for the upload warning.",
            "items": {
              "$ref": "#/components/schemas/QualGlossaryConflict"
            },
            "title": "Conflict Samples",
            "type": "array"
          },
          "format": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Upload only: 'list' (Term | Preferred English | Notes | Language) or 'wide' (one column per language).",
            "title": "Format"
          },
          "term_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Upload only.",
            "title": "Term Count"
          },
          "languages": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Upload only.",
            "title": "Languages"
          },
          "empty_rows_skipped": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Upload only: blank rows between data rows.",
            "title": "Empty Rows Skipped"
          },
          "rows_without_term": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Upload only: rows with content but no term in any language column, skipped.",
            "title": "Rows Without Term"
          },
          "ignored_columns": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Upload only (wide layout): header names that are neither English, notes nor a recognised language, so their cells were not imported.",
            "title": "Ignored Columns"
          },
          "rows_not_read_after": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Upload only: set when the sheet has content below the row-scan ceiling (or runs too far past it to check); rows below this one were not read.",
            "title": "Rows Not Read After"
          }
        },
        "required": [
          "duplicates_removed",
          "conflicts",
          "conflict_samples"
        ],
        "title": "QualGlossaryReport",
        "type": "object"
      },
