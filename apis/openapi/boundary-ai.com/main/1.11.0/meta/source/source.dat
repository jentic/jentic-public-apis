          "sync_config": {
            "$ref": "#/components/schemas/SyncConfigModel"
          }
        },
        "required": [
          "sync_config"
        ],
        "title": "SyncConfigResponse",
        "type": "object"
      },
      "SyncConfigListResponse": {
        "properties": {
          "sync_configs": {
            "items": {
              "$ref": "#/components/schemas/SyncConfigModel"
            },
            "title": "Sync Configs",
            "type": "array"
          }
        },
        "required": [
          "sync_configs"
        ],
        "title": "SyncConfigListResponse",
        "type": "object"
      },
      "SyncConfigAddMetadataField": {
        "description": "One metadata field added to an existing sync.",
        "properties": {
          "field_id": {
            "title": "Field Id",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Display Name"
          },
          "value": {
            "anyOf": [
              {
                "enum": [
                  "label",
                  "id"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Medallia only: 'label' (default, the option / unit name) or 'id' (the option id / unit identifier).",
            "title": "Value"
          }
        },
        "required": [
          "field_id"
        ],
        "title": "SyncConfigAddMetadataField",
        "type": "object"
      },
      "SyncConfigAddScoreField": {
        "description": "One score field added to an existing sync (Medallia only).",
        "properties": {
          "field_id": {
            "title": "Field Id",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Display Name"
          },
          "min": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min"
          },
          "max": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max"
          },
          "kind": {
            "anyOf": [
              {
                "enum": [
                  "scale",
                  "nps",
                  "top_box",
                  "top2_box"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "scale (default, reported as an average) | nps | top_box (share at the scale max) | top2_box (share at max or max-1)",
            "title": "Kind"
          }
        },
        "required": [
          "field_id"
        ],
        "title": "SyncConfigAddScoreField",
        "type": "object"
      },
      "SyncConfigFallbackWatermark": {
        "description": "One fallback watermark stream of a Medallia sync.",
        "properties": {
          "field_id": {
            "maxLength": 128,
            "title": "Field Id",
            "type": "string"
          },
          "mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "epoch | datetime | date (default: derived, date)",
            "title": "Mode"
          }
        },
        "required": [
          "field_id"
        ],
        "title": "SyncConfigFallbackWatermark",
        "type": "object"
      },
      "SyncConfigFilterClause": {
        "additionalProperties": true,
        "description": "One Medallia ``Filter`` clause of a sync's record filter.\n\nThe grammar is the instance's own and is deliberately not modelled\n(the instance validates it when the clause is saved), so every other\nkey passes through: an operator with its operand (``in``, ``gte``,\n``lt``, ...) or a nested ``and`` / ``or`` / ``not``. A named model\nrather than a bare object so generated clients get a usable type.",
        "properties": {
          "fieldIds": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Field id(s) the clause's operator applies to.",
            "title": "Fieldids"
          }
        },
        "title": "SyncConfigFilterClause",
        "type": "object"
      },
      "SyncConfigFilterValues": {
        "description": "Values appended to one membership clause of a sync's record filter.",
        "properties": {
          "field_id": {
            "maxLength": 128,
            "title": "Field Id",
            "type": "string"
          },
          "values": {
            "items": {
              "type": "string"
            },
            "title": "Values",
            "type": "array"
          }
        },
        "required": [
          "field_id",
          "values"
        ],
        "title": "SyncConfigFilterValues",
        "type": "object"
      },
      "SyncConfigPatchRequest": {
        "additionalProperties": false,
        "description": "Body for PATCH sync-config routes (enable/disable, interval, backfill,\nfield additions). Closed: a key outside this set is refused (400)\nrather than ignored, so a misspelt or unsupported change (say\n``timestamp_field``) never answers 200 having changed nothing. An\nempty body is refused the same way.",
        "properties": {
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Enabled"
          },
          "sync_interval_minutes": {
            "anyOf": [
              {
                "maximum": 10080,
                "minimum": 15,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sync Interval Minutes"
          },
          "backfill_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ISO 8601 date or datetime to re-read history from. The next run starts there; already-imported feedback is skipped by source reference. Refused (409) while the sync is running, and unsupported (400) for warehouse syncs.",
            "title": "Backfill From"
          },
          "add_metadata_fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SyncConfigAddMetadataField"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Metadata fields to ADD to the mapping. Existing entries are never changed; an already-mapped field id is refused. Rows imported earlier get the new fields on the next run that reads them (combine with backfill_from to re-read history). Refused (409) while the sync is running.",
            "title": "Add Metadata Fields"
          },
          "add_score_fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SyncConfigAddScoreField"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Score fields to ADD to the mapping (Medallia only), same rules as add_metadata_fields.",
            "title": "Add Score Fields"
          },
          "monthly_response_target": {
            "anyOf": [
              {
                "maximum": 5000000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "CX syncs (SurveyMonkey, Qualtrics, InMoment): import an even sample of about this many responses per calendar month instead of every response. Months under the target are imported in full; above it each response is kept or skipped by a fixed draw on its id, at the rate that lands the month near the target, so every day stays represented. Applies to responses read from now on (combine with backfill_from to re-sample history; rows already imported stay). 0 or null turns sampling off.",
            "title": "Monthly Response Target"
          },
          "score_field_kinds": {
            "anyOf": [
              {
                "additionalProperties": {
                  "enum": [
                    "scale",
                    "nps",
                    "top_box",
                    "top2_box"
                  ],
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Medallia only: {field_id: kind} re-declares how already-mapped score fields are reported, without re-import. top_box / top2_box / scale switch the existing question's headline at once (share at the max, at max or max-1, or the average); nps converts it on the next sync. Top box / top 2 box kinds apply only here, never on a later sync.",
            "title": "Score Field Kinds"
          },
          "timestamp_fallback_fields": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SyncConfigFallbackWatermark"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Medallia only. Extra watermark streams, in order, for records whose watermark field is EMPTY (a filter never matches an empty field, so such records are otherwise never read). Stream N reads only records whose primary and earlier fallback fields are all empty. Replaces the list; [] clears it. A new stream starts at the initial lookback, or at backfill_from when given in the same body. Validated against the instance before it is stored; refused on a connection whose server-side filtering is not confirmed. Use a field that says when the record became readable, not when the respondent answered.",
            "title": "Timestamp Fallback Fields"
          },
          "event_date_field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Medallia only. Field that dates each imported response (e.g. the response date). Absent: the watermark value dates it. Applies to rows imported from now on; rows already imported keep their date. null or \"\" clears it.",
            "title": "Event Date Field"
          },
          "field_sources": {
            "anyOf": [
              {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Medallia only. {mapped field id: [candidate field ids]}: the mapped text, metadata or score column reads the first candidate answered on the record. The column, its display name and every row reference stay the same. Replaces the object; {} clears it.",
            "title": "Field Sources"
          },
          "add_record_filter_values": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SyncConfigFilterValues"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Medallia only. Values to ADD to the sync's single membership clause on field_id (widening only). Combine with backfill_from to read the newly covered history.",
            "title": "Add Record Filter Values"
          },
          "add_record_filter_clauses": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SyncConfigFilterClause"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Medallia only. Filter clauses to AND into the record filter (narrowing), e.g. {\"fieldIds\": [\"e_responsedate\"], \"gte\": \"2026-01-01 00:00:00\"}. Imported rows are never removed. Same size rails as at creation; the instance validates the clauses before they are stored, and an added clause cannot be removed afterwards.",
            "title": "Add Record Filter Clauses"
          }
        },
        "title": "SyncConfigPatchRequest",
        "type": "object"
      },
      "ManualSyncResponse": {
