    "/scrapers/review-geo-prompts": {
      "post": {
        "summary": "Grammar-review the built GEO prompt set",
        "description": "The GEO prompt variants are deterministic templates filled with a free-form category, so grammatical agreement can break (e.g. French gender: 'les meilleurs Compagnies' should be 'les meilleures compagnies'). This endpoint runs a Gemini copy-edit pass that fixes grammar/agreement WITHOUT changing meaning, count or order, and caches the result in Redis so identical input always yields the identical corrected set (re-saving an agent must never rotate its GEO prompts \u2014 trend comparability). On any LLM failure the original prompts are returned unchanged with ``reviewed: false`` \u2014 the raw templates are always usable.",
        "tags": [
          "Scraper"
        ],
        "operationId": "scraper_ai_post_review_geo_prompts",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewGeoPromptsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ReviewGeoPromptsResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScraperErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
