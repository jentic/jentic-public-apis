          "analysis_id": 5821,
          "content_flags_mapping": {
            "100": [
              901
            ]
          },
          "flag_definitions": [
            {
              "description": "Mentions of price, cost, or value-for-money",
              "flag_id": 901,
              "name": "Pricing",
              "options": [
                "positive",
                "negative",
                "neutral"
              ]
            }
          ],
          "survey_id": 42
        },
        "properties": {
          "analysis_id": {
            "title": "Analysis Id",
            "type": "integer"
          },
          "survey_id": {
            "title": "Survey Id",
            "type": "integer"
          },
          "flag_definitions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Flag Definitions",
            "type": "array"
          },
          "content_flags_mapping": {
            "additionalProperties": true,
            "title": "Content Flags Mapping",
            "type": "object"
          }
        },
        "required": [
          "analysis_id",
          "survey_id"
        ],
        "title": "FlagDefinitionsResponse",
        "type": "object"
      },
