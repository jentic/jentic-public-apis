      "post": {
        "summary": "Run preflight conformance checks against a Medallia tenant",
        "description": "Checks each prerequisite by name, because almost every Medallia misconfiguration returns an EMPTY RESULT SET rather than an error \u2014 a role without the Query API capability, an instance with no Experience Programs, missing social-review permission and a genuinely quiet location all look identical from the API. Findings that could not be established are reported as 'unknown' with remediation, never dressed up as a pass. Optionally scoped to one sync config's field mapping via ?sync_config_id=.",
        "tags": [
          "Native connectors"
        ],
        "operationId": "native_connectors_post_medallia_preflight",
        "parameters": [
          {
            "name": "connection_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "sync_config_id",
            "in": "query",
            "required": false,
            "schema": {
