        "title": "MedalliaFieldUsageResponse",
        "type": "object"
      },
      "MedalliaSyncConfigCreateRequest": {
        "description": "Body for ``POST /native-connectors/medallia/sync-configs``.",
        "properties": {
          "medallia_connection_id": {
            "title": "Medallia Connection Id",
            "type": "integer"
          },
          "survey_series_id": {
            "title": "Survey Series Id",
            "type": "integer"
          },
          "field_mapping": {
            "additionalProperties": true,
            "description": "{text_field | text_fields[], text_field_labels?, timestamp_field?, timestamp_mode?, tie_field?, metadata_fields: [{field_id, display_name}], record_filter?, status_filter?: {field_id, values[]}, source_name?, program_id?, program_name?}. ``text_fields`` maps SEVERAL verbatims \u2014 one response answering two questions becomes two pieces of feedback; ``text_field`` remains as the singular alias. ``record_filter`` is a list of Medallia Filter clauses, ANDed with the incremental window (never substituted for it) so one connection can feed several sources; they are re-emitted under the tenant's negotiated operator and validated against the instance when the sync is created. ``status_filter`` states the record-status scope explicitly instead of inheriting Medallia's default. ``source_name`` names the source this sync creates, so several syncs on one connection stay distinguishable. ``program_id``/``program_name`` are display-only Experience Program labels.",
            "title": "Field Mapping",
            "type": "object"
          },
          "sync_interval_minutes": {
            "default": 60,
            "maximum": 1440,
            "minimum": 15,
            "title": "Sync Interval Minutes",
            "type": "integer"
          }
        },
        "required": [
          "medallia_connection_id",
          "survey_series_id",
          "field_mapping"
        ],
        "title": "MedalliaSyncConfigCreateRequest",
        "type": "object"
      },
      "MedalliaDryRunResponse": {
        "additionalProperties": true,
        "description": "What a sync WOULD import. Nothing is written to produce this.\n\nThe 200 answer. With ``Prefer: respond-async`` the POST answers 202\nwith a ``MedalliaProbeJobResponse``, like the field-usage probe.",
        "properties": {
          "report": {
            "additionalProperties": true,
            "title": "Report",
            "type": "object"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          },
          "job_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Job Id"
          }
        },
        "required": [
          "report"
        ],
        "title": "MedalliaDryRunResponse",
        "type": "object"
      },
      "WarehouseSetupInfoResponse": {
        "description": "Body of ``GET /native-connectors/warehouse/setup-info``.",
        "properties": {
          "external_id": {
            "description": "Server-derived per-organization ExternalId (bai-wh-<hex>) to bake into the IAM role trust policy; create rejects any value not issued to the calling org",
            "title": "External Id",
            "type": "string"
          },
          "bai_aws_account_id": {
            "description": "BAI's AWS account id for the CloudFormation template (empty when unconfigured)",
            "title": "Bai Aws Account Id",
            "type": "string"
          },
          "bq_ingest_service_account": {
            "description": "bigquery: BAI's ingest service-account email to grant roles/bigquery.dataViewer on the dataset (empty when unconfigured)",
            "title": "Bq Ingest Service Account",
            "type": "string"
          }
        },
        "required": [
          "external_id",
          "bai_aws_account_id",
          "bq_ingest_service_account"
        ],
        "title": "WarehouseSetupInfoResponse",
        "type": "object"
      },
      "WarehouseConnectionCreateRequest": {
        "description": "Body for ``POST /native-connectors/warehouse/connections``.",
        "properties": {
          "connection_name": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Connection Name",
            "type": "string"
          },
          "connection_type": {
            "description": "redshift_provisioned, redshift_serverless, s3, snowflake, bigquery, databricks, sftp or bai_drop",
            "title": "Connection Type",
            "type": "string"
          },
          "aws_region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "AWS providers only: region, e.g. us-east-1",
            "title": "Aws Region"
          },
          "role_arn": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "AWS providers only: customer IAM role ARN BAI assumes",
            "title": "Role Arn"
          },
          "database_name": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required for Redshift and Snowflake; ignored for s3",
            "title": "Database Name"
          },
          "cluster_identifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required for provisioned clusters",
            "title": "Cluster Identifier"
          },
          "workgroup_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Required for serverless workgroups",
            "title": "Workgroup Name"
          },
          "db_user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Database user for provisioned clusters (temp credentials via GetClusterCredentials)",
            "title": "Db User"
          },
          "bucket": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "s3 only: bucket name",
            "title": "Bucket"
          },
          "prefix": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "s3 only: key prefix to watch",
            "title": "Prefix"
          },
          "kms_key_arn": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "s3 only: KMS key ARN if the bucket uses SSE-KMS",
            "title": "Kms Key Arn"
          },
          "account_identifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "snowflake only: account identifier (myorg-account or locator.region)",
            "title": "Account Identifier"
          },
          "snowflake_user": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "snowflake only: service user that carries the BAI public key",
            "title": "Snowflake User"
          },
          "warehouse_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "snowflake only: virtual warehouse to run queries on",
            "title": "Warehouse Name"
          },
          "snowflake_role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "snowflake only: optional role to assume for queries",
            "title": "Snowflake Role"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "bigquery only: customer Google Cloud project id",
            "title": "Project Id"
          },
          "dataset_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "bigquery only: dataset the BAI ingest SA was granted dataViewer on",
            "title": "Dataset Id"
          },
          "scan_budget_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "bigquery only: per-sync dry-run scan budget (default ~1 GB)",
            "title": "Scan Budget Bytes"
          },
          "workspace_host": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "databricks only: workspace host, e.g. dbc-xxx.cloud.databricks.com",
            "title": "Workspace Host"
          },
          "warehouse_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "databricks only: SQL warehouse id (Connection details tab)",
            "title": "Warehouse Id"
          },
          "oauth_client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "databricks only: service principal OAuth client id",
            "title": "Oauth Client Id"
          },
          "oauth_client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "databricks only: service principal OAuth secret (write-only; never returned in any response)",
            "title": "Oauth Client Secret"
          },
          "secret_expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "databricks only: OAuth secret expiry date (ISO, max 2 years out)",
            "title": "Secret Expires At"
          },
          "host": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "sftp only: server host name",
            "title": "Host"
          },
          "port": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "sftp only: server port (default 22)",
            "title": "Port"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "sftp only: account BAI logs in as",
            "title": "Username"
          },
          "base_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "sftp only: folder the vendor delivers files into, e.g. /ToValvoline/",
            "title": "Base Path"
          },
          "file_pattern": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "sftp only: optional file-name glob, e.g. feedback_*.csv",
            "title": "File Pattern"
          },
          "auth_method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "sftp only: 'key' (default; BAI mints a key pair and returns the public half) or 'password'",
            "title": "Auth Method"
          },
          "password": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "sftp only: account password when auth_method is 'password'",
            "title": "Password",
            "writeOnly": true
          },
          "expected_host_key_fingerprint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "sftp only: vendor-published host-key fingerprint (SHA256:...) checked before the server is pinned",
            "title": "Expected Host Key Fingerprint"
          },
          "vendor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "sftp only: preset slug the connection was created from, e.g. 'medallia'",
            "title": "Vendor"
          },
          "public_keys": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "bai_drop only: 1-10 OpenSSH public key lines the customer will authenticate with on BAI's file-drop endpoint (the customer keeps the private keys)",
            "title": "Public Keys"
          }
        },
        "required": [
          "connection_name",
          "connection_type"
        ],
        "title": "WarehouseConnectionCreateRequest",
        "type": "object"
      },
      "BaiDropEndpointModel": {
        "description": "What the customer needs to hand to their IT / export tool.",
        "properties": {
          "host": {
            "title": "Host",
            "type": "string"
          },
          "port": {
            "title": "Port",
            "type": "integer"
          },
          "username": {
            "title": "Username",
            "type": "string"
          },
          "host_key_fingerprint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "SHA256:... fingerprint of BAI's endpoint host key, to verify on first connect",
            "title": "Host Key Fingerprint"
          },
          "location": {
            "description": "sftp://user@host[:port]/ as typed into an SFTP client",
