      "QualityDecisionResponse": {
        "additionalProperties": true,
        "description": "What actually moved. Never a delete count \u2014 nothing is deleted.",
        "properties": {
          "updated": {
            "items": {
              "type": "string"
            },
            "title": "Updated",
            "type": "array"
          },
          "excluded": {
