    "/health": {
      "get": {
        "summary": "Aggregate dependency health probe (frontend MaintenanceGate)",
        "description": "Public (no auth) probe that actually exercises the dependencies the user-facing app needs \u2014 database connectivity and the Redis cache. ALWAYS returns HTTP 200; clients must read the body's `status` field (`operational` | `degraded` | `down`). Database down maps to overall `down`; cache down (DB up) maps to `degraded` once the failure persists beyond a short grace window \u2014 transient cache blips keep the overall status `operational` while `services.cache` always shows the real probe result. Results are cached in-process for a few seconds. Marked internal \u2014 it is an operational probe, not part of the public API surface.",
        "tags": [
          "Health"
        ],
        "operationId": "health_get_health",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "services",
                    "timestamp"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "operational",
                        "degraded",
                        "down"
                      ],
                      "description": "Overall status derived from the per-service probes"
                    },
                    "services": {
                      "type": "object",
                      "properties": {
                        "backend": {
                          "type": "string",
                          "enum": [
                            "operational",
                            "degraded",
                            "down"
                          ]
                        },
                        "database": {
                          "type": "string",
                          "enum": [
                            "operational",
                            "degraded",
                            "down"
                          ]
                        },
                        "cache": {
                          "type": "string",
                          "enum": [
                            "operational",
                            "degraded",
                            "down"
                          ]
                        }
                      }
                    },
                    "timestamp": {
                      "type": "integer",
                      "description": "Unix seconds"
                    },
                    "reason": {
                      "type": "string",
                      "description": "Only present when the probe itself failed (e.g. 'aggregation_failed')"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [],
        "x-internal": true
      }
    },
    "/integrations/bai-drop/webhooks/upload": {
      "post": {
        "summary": "File-drop upload webhook receiver (SFTPGo event manager)",
        "tags": [
          "Integrations"
        ],
        "operationId": "integrations_post_bai_drop_upload_webhook",
        "parameters": [
          {
            "name": "X-BAI-Drop-Signature",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "HMAC-SHA256 hex digest of the raw request body using BAI_DROP_WEBHOOK_SECRET (signing relays)."
          },
          {
            "name": "X-BAI-Drop-Token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Static shared token equal to BAI_DROP_WEBHOOK_TOKEN (SFTPGo's HTTP action sends it as a fixed header; it cannot sign its body). One of the two headers must validate."
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaiDropUploadWebhookRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted \u2014 task queued for async processing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BaiDropUploadWebhookResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [],
        "x-internal": true
      }
    },
