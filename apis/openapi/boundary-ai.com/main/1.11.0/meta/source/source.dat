    "/diagnostics": {
      "get": {
        "summary": "Live runtime snapshot for operators",
        "description": "Internal-secret-gated endpoint that mirrors the periodic [SYSTEM_HEARTBEAT] log line plus rolling-window percentiles. Requires the `X-Internal-Secret` header. Returns 401 if the header is missing or wrong. Returns NO PII \u2014 only integer counts and timing percentiles.",
        "tags": [
          "Diagnostics"
        ],
        "operationId": "diagnostics_get_snapshot",
        "parameters": [
          {
            "name": "X-Internal-Secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Operator-only secret; constant-time compared"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "instance": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "pools": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "timing": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "db_attribution": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "aps_lock_counters": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "process": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
