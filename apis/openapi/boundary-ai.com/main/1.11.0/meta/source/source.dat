      "QualInterviewUploadIntentRequest": {
        "description": "Ask for a browser-direct GCS resumable session for one recording.",
        "properties": {
          "filename": {
            "description": "Original audio filename; the extension is validated against the supported audio formats.",
            "maxLength": 255,
            "title": "Filename",
            "type": "string"
          },
          "content_type": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "application/octet-stream",
            "description": "MIME type the browser will PUT with.",
            "title": "Content Type"
          },
          "size_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Declared file size. Advisory (GCS does not enforce it) but anything over the 300 MB cap is refused before wasting the upload.",
            "title": "Size Bytes"
          }
        },
        "required": [
          "filename"
        ],
        "title": "QualInterviewUploadIntentRequest",
        "type": "object"
      },
