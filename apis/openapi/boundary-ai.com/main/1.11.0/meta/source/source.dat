    "/native-connectors/medallia/connections/{connection_id}/catalogue": {
      "get": {
        "summary": "The instance's full field catalogue, read a slice at a time",
        "description": "A real tenant lists thousands of fields at tens of seconds a page, so the catalogue is crawled in bounded slices that persist across requests. ?advance=1 reads more pages within a time budget and returns; the wizard calls it in a loop while open and shows the progress. ?include_fields=1 returns the fields read so far (minimal selection: no enum options; fetch one field by id for those).",
        "tags": [
          "Native connectors"
        ],
        "operationId": "native_connectors_get_medallia_catalogue",
        "parameters": [
          {
            "name": "connection_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
