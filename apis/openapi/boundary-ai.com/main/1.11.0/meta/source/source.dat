      "ExportJobRequest": {
        "additionalProperties": true,
        "description": "Body for ``POST``/``PUT`` of an export definition.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "format": {
            "description": "csv | xlsx | json | triple_s",
            "title": "Format",
            "type": "string"
          },
          "scope": {
            "default": "all",
            "description": "all | completes | subset",
            "title": "Scope",
            "type": "string"
          },
          "subset_condition": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "#2573 condition tree; required when scope=subset",
            "title": "Subset Condition"
          },
          "variables": {
            "additionalProperties": true,
            "description": "selected (empty = every variable), exclude_open_ended, exclude_protected (default true)",
            "title": "Variables",
            "type": "object"
          },
          "options": {
            "additionalProperties": true,
            "description": "Independent flags: values (codes|labels|both), question_text_row, header_row, split_multi, strip_html, variable_order (survey|alphabetical), include_other_text, apply_logic_cleaning, include_protected, include_excluded, include_simulated",
            "title": "Options",
            "type": "object"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Language"
          },
          "schedule": {
            "additionalProperties": true,
            "description": "frequency (off|daily|weekly|monthly), hour, minute, weekday, day_of_month. The timezone is the organisation's.",
            "title": "Schedule",
            "type": "object"
          },
          "notify_emails": {
            "items": {
              "type": "string"
            },
            "title": "Notify Emails",
            "type": "array"
          }
        },
        "required": [
          "name",
          "format"
        ],
        "title": "ExportJobRequest",
        "type": "object"
      },
