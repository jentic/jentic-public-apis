    "/admin/relevance-audit/clusters": {
      "get": {
        "summary": "Pending relevance-mark audit clusters",
        "description": "User \"not relevant\" marks from the last `window_days`, grouped by the scraper that surfaced them, together with that scraper's live keep-rule configuration. Marks with no captured search context, and marks whose snapshot keep rules no longer match the live ones, are dropped \u2014 the `stats` block names each kill point. Comment text is PII-redacted on this surface. Read-only: nothing is proposed or applied here.",
        "tags": [
          "SuperAdmin"
        ],
        "operationId": "superadmin_relevance_audit_clusters",
        "parameters": [
          {
            "name": "window_days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "description": "How far back to read the mark ledger. Omit to use the server's configured window (RELEVANCE_AUDIT_WINDOW_DAYS, 30 by default) \u2014 deliberately not declared as a schema default, since an operator can move it."
          },
          {
            "name": "max_marks",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "description": "Ceiling on ledger rows read for this request. Omit to use the server's configured cap (RELEVANCE_AUDIT_MAX_MARKS, 500 by default)."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/RelevanceAuditClustersResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
