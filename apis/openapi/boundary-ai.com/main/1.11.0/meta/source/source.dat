      "BranchingRulePayload": {
        "additionalProperties": true,
        "description": "One skip/branching rule.\n\n``condition_group`` is the #2573 condition-group dict (null = the\nunconditional catch-all). ``target_question_id`` is set for\nGO_TO_QUESTION, ``disposition`` for END_SURVEY \u2014 never both.",
        "properties": {
          "rule_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rule Id"
          },
          "survey_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Survey Id"
          },
          "source_question_id": {
            "title": "Source Question Id",
            "type": "integer"
          },
          "priority": {
            "default": 0,
            "title": "Priority",
            "type": "integer"
          },
          "condition_group": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Condition Group"
          },
          "action_type": {
            "description": "GO_TO_QUESTION | END_SURVEY",
            "title": "Action Type",
            "type": "string"
          },
          "target_question_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Question Id"
          },
          "disposition": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "completed | screened_out | quota_full | survey_closed",
            "title": "Disposition"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Created At"
          }
        },
        "required": [
          "source_question_id",
          "action_type"
        ],
        "title": "BranchingRulePayload",
        "type": "object"
