      },
      "EvolutionDisableRequest": {
        "properties": {
          "target_granularity": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only \"single\" (or omitted \u2014 same thing) is accepted: the series stays converted at the degenerate 'single' granularity of the unified analysis model (migration 244) \u2014 period buckets are archived and each source's canonical all-time analysis is restored, but the config row stays active so the unified frontend keeps rendering the series bar. The legacy enabled=false end state is no longer reachable through this route.",
            "title": "Target Granularity"
          }
        },
        "title": "EvolutionDisableRequest",
        "type": "object"
      },
      "EvolutionDisableResponse": {
        "description": "``POST /evolution/disable`` payload.",
        "properties": {
          "message": {
            "description": "Human-readable status message",
            "title": "Message",
            "type": "string"
          },
          "archived_buckets": {
            "description": "Count of buckets archived during disable",
            "title": "Archived Buckets",
            "type": "integer"
          },
          "reanalysis_skipped_insufficient_credits": {
            "default": false,
            "description": "True when the org had no APS credit, so the all-time analyses were not relaunched. Data is intact; the group needs a manual re-analysis after topping up.",
            "title": "Reanalysis Skipped Insufficient Credits",
            "type": "boolean"
          },
          "paused_report_subscriptions_count": {
            "default": 0,
            "description": "Saved automatic period reports kept but parked \u2014 they cannot fire while the group has no periods, and resume if period tracking is re-enabled",
            "title": "Paused Report Subscriptions Count",
            "type": "integer"
          },
          "rescheduled_period_synced_sources": {
            "default": 0,
            "description": "Period-synced sources whose next run was re-slotted onto the fallback cadence now that period boundaries are gone",
            "title": "Rescheduled Period Synced Sources",
            "type": "integer"
          }
        },
        "required": [
          "message",
          "archived_buckets"
        ],
        "title": "EvolutionDisableResponse",
        "type": "object"
      },
      "EvolutionGranularityRequest": {
        "properties": {
          "period_unit": {
            "description": "Only \"single\" is accepted here \u2014 it activates the analysis config at the degenerate non-bucketed granularity without archiving anything (the canonical all-time analysis stays live). Periodic units must go through POST /evolution/enable, which owns the dating/backfill flow.",
            "title": "Period Unit",
            "type": "string"
          }
        },
        "required": [
          "period_unit"
        ],
        "title": "EvolutionGranularityRequest",
        "type": "object"
      },
      "EvolutionGranularityResponse": {
        "description": "``POST /evolution/granularity`` payload.",
        "properties": {
          "config": {
            "additionalProperties": true,
            "description": "The activated config row (period_unit = 'single')",
            "title": "Config",
            "type": "object"
          }
        },
        "required": [
          "config"
        ],
        "title": "EvolutionGranularityResponse",
        "type": "object"
      },
      "EvolutionBucketsResponse": {
        "description": "``GET /evolution/buckets`` payload.",
        "example": {
          "analyzed_sources_total": 12,
          "buckets": [
            {
              "analysis_id": 5821,
              "analyzed_at": "2026-06-01T03:00:00Z",
              "period_key": "2026-05",
              "state": "analyzed",
              "verbatim_count": 1240
            },
            {
              "analysis_id": null,
              "analyzed_at": null,
              "period_key": "2026-06",
              "state": "running",
              "verbatim_count": 412
            }
          ],
          "evolution": {
            "enabled": true,
            "frequency": "monthly",
            "started_at": "2026-01-01T00:00:00Z"
          }
        },
        "properties": {
          "evolution": {
            "additionalProperties": true,
            "description": "Evolution config dict; ``{'enabled': False}`` when not enabled",
            "title": "Evolution",
            "type": "object"
          },
          "buckets": {
            "description": "Per-bucket dicts including state and counts. An analyzing bucket also carries run_state: running, or stale when every month in it has provably stopped (a whole-period analyze releases those months instead of refusing)",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Buckets",
            "type": "array"
          },
          "analyzed_sources_total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Distinct count of analyzed sources across the series",
            "title": "Analyzed Sources Total"
          }
        },
        "required": [
          "evolution",
          "buckets"
        ],
        "title": "EvolutionBucketsResponse",
        "type": "object"
      },
      "EvolutionProgressResponse": {
        "description": "``GET /evolution/progress`` payload.",
        "example": {
          "progress": [
            {
              "message": "Clustering themes\u2026",
              "percentage": 62.5,
              "period_key": "2026-06",
              "stage": "running",
              "task_id": "31:bucket:7:2026-06:42"
            }
          ]
        },
        "properties": {
          "progress": {
            "description": "Per-bucket progress rows (live polling tick)",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Progress",
            "type": "array"
          }
        },
        "required": [
          "progress"
        ],
        "title": "EvolutionProgressResponse",
        "type": "object"
      },
      "EvolutionSourcesResponse": {
        "description": "``GET /evolution/sources`` payload.",
        "properties": {
          "sources": {
            "description": "Per-source rows for the given period (or all-time). With a period_key each row also carries run_state (running | queued | finalizing | stale | failed | ready | dirty | pending | archived | null: the month's true state from its run lease and owner heartbeat; queued means a launch of a not-yet-analyzed or released month is waiting in the job queue for a worker slot; finalizing means the run's results are written and only its follow-ups (monitor scans, publication) still run; stale means the run stopped and the month can be analyzed again), queued (bool: a launch of the month is waiting in the job queue, also for a settled month whose run_state keeps its results visible), heartbeat_age_s and last_error",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "sources"
        ],
        "title": "EvolutionSourcesResponse",
        "type": "object"
      },
      "EvolutionSourceBucketsResponse": {
        "description": "``GET /evolution/sources/<id>/buckets`` payload.\n\nThe inverse pivot of ``GET /evolution/sources``: for ONE source,\nevery period bucket it has responses (or an analysis) in.",
        "example": {
          "buckets": [
            {
              "analysis_id": 4211,
              "bucket_state": "ready",
              "period_end": "2026-06-01T00:00:00+00:00",
              "period_key": "2026-05",
              "period_start": "2026-05-01T00:00:00+00:00",
              "response_count": 118
            },
            {
              "analysis_id": null,
              "bucket_state": null,
              "period_end": "2026-07-01T00:00:00+00:00",
              "period_key": "2026-06",
              "period_start": "2026-06-01T00:00:00+00:00",
              "response_count": 42
            }
          ],
          "custom_days": null,
          "period_unit": "month"
        },
        "properties": {
          "buckets": {
            "description": "Chronological per-bucket rows for the source: period_key, period bounds, response_count (distinct respondents in the period), and the source's analysis_id + bucket_state + responses_analyzed (answers the analysis processed) in that bucket (null when not analyzed), and run_state / queued / heartbeat_age_s / last_error (see GET /evolution/sources)",
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Buckets",
            "type": "array"
          },
          "period_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The series's period unit \u2014 for period-label formatting",
            "title": "Period Unit"
          },
          "custom_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Days per bucket when period_unit is 'custom'",
            "title": "Custom Days"
          },
          "period_schedule": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ScheduleChapter"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Chapter list when period_unit is 'schedule' \u2014 the picker needs it to render each chapter's end date (the open chapter reports period_end = null)",
            "title": "Period Schedule"
          }
        },
        "required": [
          "buckets"
        ],
        "title": "EvolutionSourceBucketsResponse",
        "type": "object"
      },
      "EvolutionAnalyzeSourceRequest": {
        "properties": {
          "period_key": {
            "description": "Bucket period key (YYYY-MM, YYYY-Qn, YYYY-Wnn, or custom)",
            "title": "Period Key",
            "type": "string"
          },
          "force_full": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": false,
            "description": "Force a full theme re-detection even when the period's inputs are unchanged. The bucket's series/period linkage is always preserved (the analysis row is rebuilt in place, or a fresh row is minted with the same linkage when the full-rebuild plan applies); re-runs the full LLM pipeline, so it consumes credits like a first analysis.",
            "title": "Force Full"
          }
        },
        "required": [
          "period_key"
        ],
        "title": "EvolutionAnalyzeSourceRequest",
        "type": "object"
      },
      "EvolutionAnalyzeSourceResponse": {
        "description": "``POST /evolution/sources/<id>/analyze`` payload (202).",
        "properties": {
          "status": {
            "description": "Launch status, e.g. 'launched'",
            "title": "Status",
            "type": "string"
          },
          "task_id": {
            "description": "Pool task id for the launched analysis",
            "title": "Task Id",
            "type": "string"
          },
          "period_key": {
            "description": "Period key that was analyzed",
            "title": "Period Key",
            "type": "string"
          },
          "survey_id": {
            "description": "Source survey id",
            "title": "Survey Id",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "task_id",
          "period_key",
          "survey_id"
        ],
        "title": "EvolutionAnalyzeSourceResponse",
        "type": "object"
      },
      "EvolutionCancelSourceRequest": {
        "properties": {
          "period_key": {
            "description": "Bucket period key to cancel",
            "title": "Period Key",
            "type": "string"
          },
          "analysis_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The analyses row the caller is looking at. When sent it must be this source's row for this period (409 otherwise), and a named row that finished while another run started is refused (409). It picks the row to retire; every running task of the bucket is stopped. When omitted and several rows are analyzing, the cancel is refused (409).",
            "title": "Analysis Id"
          }
        },
        "required": [
          "period_key"
        ],
        "title": "EvolutionCancelSourceRequest",
        "type": "object"
      },
      "EvolutionCancelSourceResponse": {
        "description": "``POST /evolution/sources/<id>/cancel`` payload.",
        "properties": {
          "status": {
            "description": "'completed': the period is out of 'analyzing'; 'accepted': a running task was told to stop and retires the row itself; 'not_found': nothing was running for this period (nothing changed)",
            "enum": [
              "completed",
              "accepted",
              "not_found"
            ],
            "title": "Status",
            "type": "string"
          },
          "cancelled": {
            "description": "True unless status is 'not_found'",
            "title": "Cancelled",
            "type": "boolean"
          },
          "task_id": {
            "description": "Pool task id that was targeted",
            "title": "Task Id",
            "type": "string"
          },
          "period_key": {
            "description": "Period key that was cancelled",
            "title": "Period Key",
            "type": "string"
          },
          "survey_id": {
            "description": "Source survey id",
            "title": "Survey Id",
            "type": "integer"
          },
          "analysis_deleted": {
            "description": "True if an in-flight analyses row was deleted",
            "title": "Analysis Deleted",
            "type": "boolean"
          },
          "kept_analysis_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The analysis this period still has after the cancel (the restored predecessor, the released row, or the untouched previous analysis when a running task was only told to stop); null when none",
            "title": "Kept Analysis Id"
          },
          "analysis_released": {
            "default": false,
            "description": "True if the in-flight row carried completed outputs and was released back to 'dirty' instead of deleted",
            "title": "Analysis Released",
            "type": "boolean"
          },
          "restored_analysis_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Archived analysis brought back after deleting the cancelled re-analysis, or None if there was nothing to restore",
            "title": "Restored Analysis Id"
          },
          "analysis_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Analyses row id that was retired (or None)",
            "title": "Analysis Id"
          },
          "queued_job_cancelled": {
            "default": false,
            "description": "True when nothing was running but a job for this period was still waiting in the worker queue: it is acknowledged without running at pickup (status stays 'not_found')",
            "title": "Queued Job Cancelled",
            "type": "boolean"
          },
          "pool_keys_removed": {
            "description": "Count of pool task ids removed",
            "title": "Pool Keys Removed",
            "type": "integer"
          }
        },
        "required": [
          "status",
          "cancelled",
          "task_id",
          "period_key",
          "survey_id",
          "analysis_deleted",
          "pool_keys_removed"
        ],
        "title": "EvolutionCancelSourceResponse",
        "type": "object"
      },
      "EvolutionAnalyzeBucketRequest": {
        "additionalProperties": true,
        "description": "``POST /evolution/buckets/<period_key>/analyze`` body (all optional).",
