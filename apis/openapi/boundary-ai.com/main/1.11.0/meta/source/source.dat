    "/reports/theme-flag-canvas-pdf": {
      "post": {
        "summary": "Render a theme/flag report through a canvas layout (server PDF)",
        "description": "Theme/flag reports are assembled client-side; when the user picks a canvas document, the client normalizes its report_data into the shared canvas vocabulary and posts it here to render server-side through the shared canvas PDF pipeline (the same headless path used by feedback-group + per-source canvas reports).\n\nTwo modes: send `theme_flag_data` to render the report's OWN document with the design's canvas pages placed in their section slots, or select a canvas document (`canvas_document_id` / `canvas_inline`, or an org/user default) to have it REPLACE the report. At least one must resolve \u2014 with neither, the client renders its own @react-pdf report and never calls this. Poll `status_url` and download from `download_url` (task-keyed pdf_pool).",
        "tags": [
          "Reports"
        ],
        "operationId": "reports_post_theme_flag_canvas_pdf",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThemeFlagCanvasPdfRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ThemeFlagCanvasPdfResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
