      "ReportResponse": {
        "description": "Shape of ``Report.to_dict()`` \u2014 used as the body of every\ncreate/get/update/status/generate endpoint that returns a single\nreport. Fields are intentionally permissive (``Any``) for nested JSON\nblobs (``report_data``, ``scope_details``) that can hold arbitrarily\ndeep structures produced by the analysis pipeline.",
        "example": {
          "account_id": 42,
          "clerk_org_id": "org_2abc...",
          "delivery_methods": [
            "dashboard"
          ],
          "email_recipients": [
            "pm@example.com"
          ],
          "end_date": "2026-03-31",
          "frequency": "ponctuel",
          "period_key": null,
          "report_data": {
            "language": "en",
            "report_format": [
              "pdf"
            ]
          },
          "report_id": 123,
          "report_name": "Q1 Insights",
          "schedule_id": null,
          "scope_org_names": [
            "Group A",
            "Group B"
          ],
          "start_date": "2026-01-01",
          "status": "completed"
        },
        "properties": {
          "report_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Report identifier",
            "title": "Report Id"
          },
          "account_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Creating user id",
            "title": "Account Id"
          },
          "clerk_org_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Clerk-issued organization id",
            "title": "Clerk Org Id"
          },
          "report_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Display name of the report",
            "title": "Report Name"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Report status (scheduled / generating / completed / failed)",
            "title": "Status"
          },
          "frequency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ponctuel / weekly / monthly / quarterly",
            "title": "Frequency"
          },
          "scope_org_names": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Feedback group names included in the scope",
            "title": "Scope Org Names"
          },
          "start_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ISO date \u2014 inclusive lower bound for analysed responses",
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ISO date \u2014 inclusive upper bound for analysed responses",
            "title": "End Date"
          },
          "delivery_methods": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "How the report is delivered (dashboard / email)",
            "title": "Delivery Methods"
          },
          "email_recipients": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Recipient emails when delivery includes 'email'",
            "title": "Email Recipients"
          },
          "report_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Arbitrary nested JSON blob (language, format, scope_details, generated content, etc.)",
            "title": "Report Data"
          },
          "schedule_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Owning report_schedules row id, when this report was spawned by a recurring schedule",
            "title": "Schedule Id"
          },
          "period_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Evolution period scope (YYYY-MM, YYYY-Qn, YYYY-Wnn, YYYY-MM-DD) or null for all-time",
            "title": "Period Key"
          },
          "scheduled_for": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Originally scheduled date for recurring runs",
            "title": "Scheduled For"
          },
          "next_scheduled_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
