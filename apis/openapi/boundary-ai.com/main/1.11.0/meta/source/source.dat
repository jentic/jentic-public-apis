    "/chat/{org_id}/threads": {
      "get": {
        "summary": "List the caller's recent chat threads",
        "description": "Returns the sidebar's recent-threads list, scoped to the authenticated user within the org. Soft-archived threads are omitted; non-archived threads are ordered by ``last_message_at DESC`` (ties broken by ``thread_id DESC``) so the client can group by Today/Yesterday/Older without an extra sort. Optional keyset pagination via ``limit`` (1-100, default 50) and ``before`` (opaque cursor \u2014 pass the previous page's ``next_cursor`` verbatim).",
        "tags": [
          "Chat"
        ],
        "operationId": "chat_list_threads",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Organization ID"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Page size (1-100, default 50); out-of-range values are clamped."
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Opaque keyset cursor \u2014 pass the previous page's ``next_cursor`` verbatim."
          }
