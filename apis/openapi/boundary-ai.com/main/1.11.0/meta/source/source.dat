      "ExportVariablesResponse": {
        "additionalProperties": true,
        "description": "``GET /surveys/<survey_id>/export-jobs/variables`` \u2014 the whole tree.\n\nGrouped client-side from ``group``; the server sends one flat, ordered\nlist because that is what preserves questionnaire order across the four\ngroups without the client having to re-sort.",
        "properties": {
          "default_protection": {
            "default": false,
            "title": "Default Protection",
            "type": "boolean"
          },
          "variables": {
            "items": {
              "$ref": "#/components/schemas/ExportVariablePayload"
            },
            "title": "Variables",
            "type": "array"
          }
        },
        "title": "ExportVariablesResponse",
        "type": "object"
      },
      "ExportPreviewCountResponse": {
        "additionalProperties": true,
        "description": "``POST .../preview-count`` \u2014 how many records this scope matches now.\n\nNot decoration: a subset condition that silently matches nothing\nproduces an empty file, and an empty file is the one delivery failure a\nclient notices on their side rather than ours.\n\n``matched_count`` is NULLABLE and that is the contract, not an\noversight. A ``subset`` scope is a #2573 condition tree evaluated per\nrespondent, so counting it exactly means folding every answer of the\nsurvey \u2014 worker work, not request work. Past ``inline_limit`` records\nthe endpoint says so (``status: \"too_large\"``) instead of holding the\nconnection open until the request times out. ``all`` and ``completes``\nare single indexed COUNTs and are always answered.",
        "properties": {
          "matched_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Records this scope matches, or null when status is too_large.",
            "title": "Matched Count"
          },
          "status": {
            "default": "counted",
            "description": "counted | too_large",
            "title": "Status",
            "type": "string"
          },
          "population": {
            "default": 0,
            "description": "Records the job's options admit before the scope filter \u2014 what was measured against inline_limit.",
            "title": "Population",
            "type": "integer"
          },
          "inline_limit": {
            "default": 0,
            "description": "Ceiling above which a subset preview is refused.",
            "title": "Inline Limit",
            "type": "integer"
          }
        },
        "title": "ExportPreviewCountResponse",
        "type": "object"
      },
      "ExportRunResponse": {
        "additionalProperties": true,
        "description": "``POST .../run`` \u2014 the opened run plus where it went.\n\n``dispatch`` is ``queued`` (the durable worker took it) or ``inline``\n(the queue was unavailable and this instance is building it detached).\nThe client polls the run either way; the field exists so a stuck run is\ndiagnosable without reading logs.",
        "properties": {
          "export_run": {
            "$ref": "#/components/schemas/ExportRunPayload"
          },
          "dispatch": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Dispatch"
          }
        },
        "required": [
          "export_run"
        ],
        "title": "ExportRunResponse",
        "type": "object"
      },
      "ExportRunsResponse": {
        "additionalProperties": true,
        "properties": {
          "export_runs": {
            "items": {
              "$ref": "#/components/schemas/ExportRunPayload"
            },
            "title": "Export Runs",
            "type": "array"
          }
        },
        "title": "ExportRunsResponse",
        "type": "object"
      },
      "SmsProviderConfigBody": {
        "additionalProperties": true,
        "description": "The organisation's SMS settings as the API returns them.\n\nNote the absence: there is no field here that could carry a credential.\n``account_ref`` / ``credentials_ref`` are the NAMES of secrets, and the\nvalues they point at are resolved at send time and never serialised \u2014\nso this response is safe by construction rather than by review.",
        "properties": {
          "org_id": {
            "title": "Org Id",
            "type": "integer"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
