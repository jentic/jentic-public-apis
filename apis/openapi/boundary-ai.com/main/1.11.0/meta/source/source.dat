            "title": "Read Path"
          }
        },
        "title": "SuperFlagCommentsResponse",
        "type": "object"
      },
      "EvolutionConfigGetResponse": {
        "description": "``GET /evolution`` payload.",
        "example": {
          "config": null,
          "data_span_days": null,
          "estimated_periods": null,
          "legacy_answer_count": 0
        },
        "properties": {
          "config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Current evolution config row (or None)",
            "title": "Config"
          },
          "legacy_answer_count": {
            "description": "Number of legacy answers needing backfill",
            "title": "Legacy Answer Count",
            "type": "integer"
          },
          "data_span_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Span of event_at values in days, or None",
            "title": "Data Span Days"
          },
          "estimated_periods": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Estimated bucket counts per non-custom unit",
            "title": "Estimated Periods"
          }
        },
        "required": [
          "legacy_answer_count"
        ],
        "title": "EvolutionConfigGetResponse",
        "type": "object"
      },
      "SurveysFlatErrorEnvelope": {
        "description": "Flat ``{\"message\": \"...\"}`` error shape used across the surveys\ndomain. Distinct from the canonical ``ErrorEnvelope`` whose top-level\nkey is ``error`` with a nested ``{code, message}`` object.",
        "example": {
          "message": "You are not allowed to access this organization"
        },
        "properties": {
          "message": {
            "description": "Human-readable error message",
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "SurveysFlatErrorEnvelope",
        "type": "object"
      },
      "ScheduleChapter": {
        "description": "One user-defined period (\"chapter\") of a 'schedule' series.",
        "properties": {
          "start": {
            "description": "Chapter start date (YYYY-MM-DD, local to the config timezone)",
            "title": "Start",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Display name, seeded into period_labels (max 60 chars)",
            "title": "Name"
          }
        },
        "required": [
          "start"
        ],
        "title": "ScheduleChapter",
        "type": "object"
      },
      "EvolutionEnableRequest": {
        "properties": {
          "period_unit": {
            "description": "\"month\", \"quarter\", \"week\", \"custom\", or \"schedule\"",
            "title": "Period Unit",
            "type": "string"
          },
          "timezone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "UTC",
            "title": "Timezone"
          },
          "sparse_threshold": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 10,
            "title": "Sparse Threshold"
          },
          "backfill_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "\"per_survey_upload_date\", \"single_bucket\", or null",
            "title": "Backfill Mode"
          },
          "backfill_anchor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ISO-8601 timestamp; required when backfill_mode = single_bucket",
            "title": "Backfill Anchor"
          },
          "custom_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Days per bucket (required when period_unit = 'custom')",
            "title": "Custom Days"
          },
          "period_schedule": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ScheduleChapter"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Ordered user-defined chapters (required when period_unit = 'schedule'). Each chapter runs from its start date to the next one's; the last is open-ended until a chapter is appended via POST /evolution/schedule/chapter.",
            "title": "Period Schedule"
          }
        },
        "required": [
          "period_unit"
        ],
        "title": "EvolutionEnableRequest",
        "type": "object"
      },
      "EvolutionEnableResponse": {
        "description": "``POST /evolution/enable`` payload.",
        "properties": {
          "config": {
            "additionalProperties": true,
            "description": "Newly written config row",
            "title": "Config",
            "type": "object"
          },
          "rows_backfilled": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Always None \u2014 read backfill_rows_done on the config row",
            "title": "Rows Backfilled"
          },
          "archived_buckets": {
            "description": "Count of pre-existing buckets archived on enable",
            "title": "Archived Buckets",
            "type": "integer"
          },
          "archived_canonicals": {
            "default": 0,
            "description": "Count of member surveys' live canonical (whole-survey) analyses archived on enable \u2014 the series is bucket-driven from enable on",
            "title": "Archived Canonicals",
            "type": "integer"
          },
          "resumed_report_subscriptions_count": {
            "default": 0,
            "description": "Saved automatic period reports that start firing again from the next closed period",
            "title": "Resumed Report Subscriptions Count",
            "type": "integer"
          },
          "rescheduled_period_synced_sources": {
            "default": 0,
            "description": "Period-synced sources re-slotted onto the new boundaries",
            "title": "Rescheduled Period Synced Sources",
            "type": "integer"
          }
        },
        "required": [
          "config",
          "archived_buckets"
        ],
        "title": "EvolutionEnableResponse",
        "type": "object"
      },
      "EvolutionBackfillConflictResponse": {
        "description": "409 conflict when a backfill is already in progress.",
        "properties": {
          "error_code": {
            "description": "i18n error key",
            "title": "Error Code",
            "type": "string"
          },
          "message": {
            "description": "Human-readable English message",
            "title": "Message",
            "type": "string"
          },
          "backfill_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Current backfill_status on the row",
            "title": "Backfill Status"
          },
          "backfill_started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ISO-8601 timestamp the in-progress run started",
            "title": "Backfill Started At"
          }
        },
        "required": [
          "error_code",
          "message"
        ],
        "title": "EvolutionBackfillConflictResponse",
        "type": "object"
      },
      "EvolutionReconfigureRequest": {
        "properties": {
          "period_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Period Unit"
          },
          "sparse_threshold": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sparse Threshold"
          },
          "custom_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Custom Days"
          },
          "period_schedule": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ScheduleChapter"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Full replacement chapter list for period_unit = 'schedule'. OMIT it to leave the chapters (and their display names) exactly as they are \u2014 useful when changing only sparse_threshold. When sent, the chapters already started (start date in the past) must be identical to the current config's for the analyzed history to be preserved; changing any started chapter archives every bucket, exactly like a granularity change. A chapter sent without a name clears that period's display name.",
            "title": "Period Schedule"
          },
          "reset_invalid_send_delays": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": false,
            "description": "Opt in to resetting the send delay of saved automatic period reports that the new (shorter) period would break. Without it such a change is refused with 409 and nothing is written; with it the delays and the grouping are updated in one transaction.",
            "title": "Reset Invalid Send Delays"
          }
        },
        "title": "EvolutionReconfigureRequest",
        "type": "object"
      },
      "EvolutionReconfigureResponse": {
        "description": "``POST /evolution/reconfigure`` payload.",
        "properties": {
          "config": {
            "additionalProperties": true,
            "description": "Updated config row",
            "title": "Config",
            "type": "object"
          },
          "archived_buckets": {
            "description": "Count of existing buckets archived during reconfigure",
            "title": "Archived Buckets",
            "type": "integer"
          },
          "adjusted_report_subscriptions": {
            "default": 0,
            "description": "Automatic period reports whose send delay was reset to 0 as part of this change, after the caller opted in via reset_invalid_send_delays (the delay no longer fit the shorter period). Zero unless a conflict was explicitly resolved.",
            "title": "Adjusted Report Subscriptions",
            "type": "integer"
          }
        },
        "required": [
          "config",
          "archived_buckets"
        ],
        "title": "EvolutionReconfigureResponse",
        "type": "object"
      },
      "EvolutionChapterRequest": {
        "properties": {
          "start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Start date of the new period (YYYY-MM-DD in the config timezone). Defaults to today. Must be after the current chapter's start date.",
            "title": "Start"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Display name for the new period (max 60 chars)",
            "title": "Name"
          },
          "reset_invalid_send_delays": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": false,
            "description": "Opt in to resetting the send delay of saved automatic period reports that the new (shorter) phase would break. Same contract as the reconfigure route: without it such an append is refused with 409 and nothing is written.",
            "title": "Reset Invalid Send Delays"
          }
        },
        "title": "EvolutionChapterRequest",
        "type": "object"
      },
      "EvolutionChapterResponse": {
        "description": "``POST /evolution/schedule/chapter`` payload.",
        "properties": {
          "config": {
            "additionalProperties": true,
            "description": "Updated config row",
            "title": "Config",
            "type": "object"
          },
          "previous_period_key": {
            "description": "Key of the chapter that just closed",
            "title": "Previous Period Key",
            "type": "string"
          },
          "period_key": {
            "description": "Key of the newly started chapter",
            "title": "Period Key",
            "type": "string"
          },
          "dirtied_buckets": {
            "default": 0,
            "description": "Analyzed rows of the closed chapter flagged dirty because the new boundary re-scoped data they had already absorbed",
            "title": "Dirtied Buckets",
            "type": "integer"
          },
          "adjusted_report_subscriptions": {
            "default": 0,
            "description": "Automatic period reports whose send delay was reset to 0 as part of this change, after the caller opted in via reset_invalid_send_delays (the new boundary made the shortest closed phase too short for the stored delay). Zero unless a conflict was explicitly resolved.",
            "title": "Adjusted Report Subscriptions",
            "type": "integer"
          }
        },
        "required": [
          "config",
          "previous_period_key",
          "period_key"
        ],
        "title": "EvolutionChapterResponse",
        "type": "object"
      },
      "EvolutionPeriodLabelRequest": {
        "properties": {
          "period_key": {
            "description": "Bucket period key the label applies to",
            "title": "Period Key",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Display name for the period (max 60 chars). Null or empty clears the label so the period shows its date range again.",
            "title": "Label"
          }
        },
        "required": [
          "period_key"
        ],
        "title": "EvolutionPeriodLabelRequest",
        "type": "object"
      },
      "EvolutionPeriodLabelResponse": {
        "description": "``PUT /evolution/period-label`` payload.",
