    "/surveys/sms/config": {
      "get": {
        "summary": "Get the organisation's SMS provider configuration",
        "description": "Returns provider, sender and cost settings plus this month's segment usage. Credential REFERENCES (secret names) are returned; credential VALUES are never stored here and never serialised.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_get_sms_config",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SmsConfigResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "summary": "Update the organisation's SMS provider configuration",
        "description": "Patch semantics: only the fields present in the body are written, so changing the per-segment rate cannot blank the credential references. The body carries secret NAMES, never secret values \u2014 a credential posted here would be stored in a database column, which is precisely what the reference indirection avoids.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_put_sms_config",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SmsProviderConfigSchema"
