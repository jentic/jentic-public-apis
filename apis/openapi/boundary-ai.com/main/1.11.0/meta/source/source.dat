      "ErrorObject": {
        "description": "The inner ``error`` field of an error envelope.\n\nSchema name in the OpenAPI document: ``ErrorObject``.",
        "example": {
          "code": "VALIDATION_ERROR",
          "message": "Invalid email address"
        },
        "properties": {
          "code": {
            "description": "Machine-readable error code drawn from ErrorCode enum",
            "examples": [
              "VALIDATION_ERROR"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "description": "Human-readable error message, safe to display",
            "examples": [
              "Invalid email address"
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorObject",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "Top-level error response.\n\nSchema name in the OpenAPI document: ``ErrorEnvelope``.",
        "example": {
          "details": {
            "field": "email"
          },
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid email address"
          }
        },
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorObject"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional structured details (e.g. validation field map)",
            "title": "Details"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "PaginationMeta": {
        "description": "Pagination metadata embedded inside ``data``.\n\nLives next to ``items`` rather than as a sibling key under ``data``\nso a single envelope shape covers paginated AND non-paginated\nresponses with the same ``{data: ...}`` outer wrapper.",
        "properties": {
          "items": {
            "description": "Page of results",
            "items": {},
            "title": "Items",
            "type": "array"
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Opaque cursor for the next page; null if this is the last page. Pass back in the ?cursor= query param.",
            "title": "Nextcursor"
          },
          "totalCount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Total number of items across all pages. Optional \u2014 omitted when computing it would require a costly COUNT(*).",
            "title": "Totalcount"
          }
        },
        "required": [
          "items"
        ],
        "title": "PaginationMeta",
        "type": "object"
      },
      "PaginatedEnvelope": {
        "description": "Top-level paginated response: ``{data: {items, nextCursor, totalCount?}}``.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        },
        "required": [
          "data"
        ],
        "title": "PaginatedEnvelope",
        "type": "object"
      },
      "AccountResponse": {
        "description": "Response payload for ``GET /accounts/account`` and the success\nbranch of ``PATCH /accounts/account``. Mirrors ``Account.to_dict()``.",
        "example": {
          "clerk_user_id": "user_2abc...",
          "cookie_consent": "all",
          "email": "user@example.com",
          "first_name": "Jane",
          "language": "English",
          "last_name": "Doe",
          "timezone": "Europe/Paris",
          "user_id": 42
        },
        "properties": {
          "user_id": {
            "description": "Internal user identifier",
            "title": "User Id",
            "type": "integer"
          },
          "email": {
            "description": "Account email",
            "title": "Email",
            "type": "string"
          },
          "first_name": {
            "title": "First Name",
            "type": "string"
          },
          "last_name": {
            "title": "Last Name",
            "type": "string"
          },
          "language": {
            "description": "Display language (English / French / Spanish)",
            "title": "Language",
            "type": "string"
          },
          "timezone": {
            "description": "IANA timezone string, e.g. Europe/Paris",
            "title": "Timezone",
            "type": "string"
          },
          "cookie_consent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "One of: 'all', 'essential', or null when unset",
            "title": "Cookie Consent"
          },
          "clerk_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Clerk-issued user identifier",
            "title": "Clerk User Id"
          },
          "is_active": {
            "default": true,
            "description": "False when the account is deactivated (SCIM/Directory-Sync deprovisioning or Clerk ban); deactivated accounts are rejected with 403 by the auth middleware",
            "title": "Is Active",
            "type": "boolean"
          }
        },
        "required": [
          "user_id",
          "email",
          "first_name",
          "last_name",
          "language",
          "timezone"
        ],
        "title": "AccountResponse",
        "type": "object"
      },
      "UpdateAccountRequest": {
        "description": "Request payload for ``PATCH /accounts/account``.\n\nMirrors the existing Marshmallow ``UpdateUserSchema``. We re-declare\nit here as pydantic so the generated TS SDK gets a real type.",
        "example": {
          "cookie_consent": "all",
          "email": "user@example.com",
          "first_name": "Jane",
          "language": "English",
          "last_name": "Doe",
          "timezone": "Europe/Paris"
        },
        "properties": {
          "email": {
            "maxLength": 60,
            "title": "Email",
            "type": "string"
          },
          "first_name": {
            "maxLength": 50,
            "minLength": 1,
            "title": "First Name",
            "type": "string"
          },
          "last_name": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Last Name",
            "type": "string"
          },
          "language": {
            "description": "Display language",
            "enum": [
              "English",
              "French",
              "Spanish"
            ],
            "title": "Language",
            "type": "string"
          },
          "timezone": {
            "description": "IANA timezone, validated server-side via pytz",
            "title": "Timezone",
            "type": "string"
          },
          "cookie_consent": {
            "description": "Cookie consent level",
            "title": "Cookie Consent",
            "type": "string"
          }
        },
        "required": [
          "email",
          "first_name",
          "last_name",
          "language",
          "timezone",
          "cookie_consent"
        ],
        "title": "UpdateAccountRequest",
        "type": "object"
      },
      "AccountPreferencesResponse": {
        "description": "Response payload for ``GET/PATCH /accounts/preferences``.\n\nMirrors ``merge_with_defaults`` in\n``entities/account_preferences.py``: every known preference key is\nalways present with a concrete value.",
        "example": {
          "expert_mode": false
        },
        "properties": {
          "expert_mode": {
            "description": "Per-user expert mode for the survey builder (#2570). Display preference only \u2014 never affects respondents or stored survey data. Default false.",
            "title": "Expert Mode",
            "type": "boolean"
          }
        },
        "required": [
          "expert_mode"
        ],
        "title": "AccountPreferencesResponse",
        "type": "object"
      },
      "UpdateAccountPreferencesRequest": {
        "description": "Request payload for ``PATCH /accounts/preferences``.\n\nPartial: only the keys being changed are sent. Mirrors the\nMarshmallow ``UpdateAccountPreferencesSchema``.",
