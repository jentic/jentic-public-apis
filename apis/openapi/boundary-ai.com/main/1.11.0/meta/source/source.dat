    "/analysis/{analysis_id}/segment-bundles/{bundle_id}": {
      "get": {
        "summary": "Poll the aggregate progress of a 'Run for all segments' bundle",
        "description": "Counts are reconciled against the database on every read (the Redis-tracked counters can lag under high parallelism) and the status is promoted to a terminal state once no rows are in flight. The bundle must belong to the analysis in the URL (404 otherwise, and 404 once the Redis entry expires).",
        "tags": [
          "Analysis"
        ],
        "operationId": "analysis_get_segment_bundle_status",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Analysis ID"
          },
          {
            "name": "bundle_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Bundle UUID from the run-all response"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SegmentBundleStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisFlatErrorEnvelope"
                }
              }
            }
