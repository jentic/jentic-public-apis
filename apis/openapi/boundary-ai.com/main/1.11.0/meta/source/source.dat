              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "webhookSignature": []
          }
        ],
        "x-internal": true
      }
    },
    "/webhooks/sms/status/{org_id}": {
      "post": {
        "summary": "Receive an SMS delivery receipt",
        "description": "Signed provider callback moving a recipient along queued \u2192 sent \u2192 delivered | undelivered | failed and recording the provider's own error code. A terminal failure also marks the RESPONDENT RECORD's number undeliverable, so the next wave does not pay to rediscover a dead line. Acknowledges with 200 after signature verification (same rationale as the SendGrid event webhook: a processing bug is not a condition where retrying helps). 503 when the organisation has no SMS configuration \u2014 unsigned ingestion would let a forged receipt rewrite a live campaign's delivery state.",
        "tags": [
          "Webhooks"
        ],
        "operationId": "webhooks_post_sms_status",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
