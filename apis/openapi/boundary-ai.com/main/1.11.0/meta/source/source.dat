            "default": null,
            "title": "Question Type"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Position"
          },
          "total_responses": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Responses"
          },
          "optional": {
            "default": false,
            "description": "True when the question is not mandatory. Stored answers cannot say whether an unanswered optional question was never shown or shown and skipped, so n = 0 on it may be either.",
            "title": "Optional",
            "type": "boolean"
          }
        },
        "required": [
          "question_id"
        ],
        "title": "SimulatedToplineQuestion",
        "type": "object"
      },
