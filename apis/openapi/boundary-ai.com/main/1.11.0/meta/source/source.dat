    "/surveys/answer-link/followup": {
      "post": {
        "summary": "Public: request an AI follow-up question for an open answer",
        "description": "Returns `{followup: null}` for EVERY outcome that is not a valid probe \u2014 trigger not met, probing off, budget spent, organisation out of credit, model timeout, failed validation. The respondent is waiting, so there is no error path: the interview continues either way and a respondent can never tell which case they hit.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_post_followup_probe",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed survey id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FollowupProbeSchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/FollowupProbeResponse"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": []
      }
    },
    "/surveys/answer-link/followups": {
      "post": {
        "summary": "Public: store a respondent's replies to AI follow-up questions",
        "description": "Flushed once, immediately AFTER the questionnaire submission has landed \u2014 that is the first moment the parent answers exist to hang follow-ups off, since both respondent runtimes submit the whole questionnaire at the end. `submission_id` must be the SAME idempotency key the submission carried; it is what resolves the respondent identity, so a caller cannot attach follow-ups to somebody else's response.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_post_followup_answers",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed survey id"
          }
        ],
        "requestBody": {
          "required": true,
