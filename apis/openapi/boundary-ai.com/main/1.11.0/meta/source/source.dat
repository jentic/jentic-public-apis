      "SourceInfoPayload": {
        "description": "Where one feedback group's data comes from.\n\nWritten for the partner/Merge pipeline, and now also answered for\nnative connectors. The overlap is deliberate: the panel reads\n``subscription.*`` and both pipelines can fill it, so the same\nfields describe both rather than the frontend branching on kind.\n\n``last_import`` stays REQUIRED even though a native connector has no\nimport job to describe: relaxing it to optional is a breaking change\nto an existing 200 response, and the oasdiff gate is right to say so.\nNative payloads send an empty ``LastImportInfo`` instead \u2014 every one\nof its fields is already optional, so an empty one reads as \"nothing\nto report\" to consumers that were already using optional chaining.\n\nDeliberately NOT ``extra=\"allow\"``: every native field is declared\nbelow instead. Opening the model up turns the generated TS type into\n``Record<string, any>``, which would quietly cost every existing\nconsumer of this payload its type checking \u2014 a steep price for\nsaving eleven lines.",
        "properties": {
          "linked_account": {
            "$ref": "#/components/schemas/LinkedAccountSafe"
          },
          "last_import": {
            "$ref": "#/components/schemas/LastImportInfo"
          },
          "subscription": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SubscriptionPayload"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "native_connector when a native connector feeds this group",
            "title": "Kind"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Provider"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Display Name"
          },
          "connection_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Connection Id"
          },
          "flow_kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Flow Kind"
          },
          "flow_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Flow Id"
          },
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Enabled"
          },
          "health": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Health"
          },
          "healthy": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Healthy"
          },
          "last_synced_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Last Synced At"
          },
          "has_ever_run": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Has Ever Run"
          }
        },
        "required": [
          "linked_account",
          "last_import"
        ],
        "title": "SourceInfoPayload",
        "type": "object"
      },
