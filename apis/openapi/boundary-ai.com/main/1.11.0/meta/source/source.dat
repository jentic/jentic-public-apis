    "/api/payments/aps-history": {
      "get": {
        "summary": "Get organization APS transaction history",
        "description": "Return the calling org's APS (AI/Analysis Per Survey) audit log, paginated and optionally filtered by APS operation type.",
        "tags": [
          "Payments"
        ],
        "operationId": "payments_get_aps_history",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Max records per page (default 50, max 100)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Pagination offset (default 0)",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "operation",
            "in": "query",
            "required": false,
            "description": "Optional filter by APS operation type",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "envelope",
            "in": "query",
            "required": false,
            "description": "Set to 'v2' to receive the canonical paginated envelope.",
            "schema": {
              "type": "string",
              "enum": [
                "v2"
              ]
            }
          },
          {
            "name": "legacy",
            "in": "query",
            "required": false,
            "description": "Set to '1' to force the legacy flat shape (deprecated; see Sunset header).",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "APS transaction history. Default shape is the canonical `{data: {items, nextCursor, totalCount?}}` paginated envelope; with `?legacy=1` the legacy `{transactions, total_count, limit, offset}` body is returned instead.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedEnvelope"
                    },
                    {
                      "$ref": "#/components/schemas/APSHistoryResponse"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentsFlatErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
