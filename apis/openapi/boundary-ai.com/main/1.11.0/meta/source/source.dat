    "/native-connectors/medallia/connections/{connection_id}/programs": {
      "get": {
        "summary": "List Experience Programs on a Medallia instance",
        "description": "Experience Programs are Medallia's schema containers. An enterprise instance runs several (Sales, Service, Social, Digital) and the same logical question carries a different field id in each, so naming the programme is what makes a large field catalogue and an auto-created source identifiable. Returns an empty list when the instance does not expose programs \u2014 never an error, because a programme is a labelling convenience, not a prerequisite for syncing.",
        "tags": [
          "Native connectors"
        ],
