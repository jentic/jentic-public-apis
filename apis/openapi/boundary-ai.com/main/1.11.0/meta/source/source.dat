    "/admin/ops/dead-jobs/replay": {
      "post": {
        "summary": "Replay a dead job from its stored envelope",
        "description": "Re-enqueues a job that exhausted its Cloud Tasks retries, using the envelope persisted in the jobs:dead:* record, then deletes the record. The replay gets a fresh job id and retry budget. Analysis jobs are refused (400) when their survey is gone or every period they target has completed since with unchanged inputs; otherwise the response lists the target periods.",
        "tags": [
          "SuperAdmin"
        ],
        "operationId": "superadmin_replay_dead_job",
        "responses": {
          "200": {
            "description": "Success",
