    "/surveyseries/{org_id}/{survey_series_id}/super-flags/apply": {
      "post": {
        "summary": "Apply (or remove) a flag across N sources at once",
        "description": "Fans out flag-detection reruns to the selected sources and/or tombstones the monitor's assignment on `remove_survey_ids`. Returns 202 with a per-survey results array; `recompute_required: true` tells the client to drive POST /super-flags/recompute afterwards. Each freshly-applied source costs one APS credit (402 when the org runs out; removals already applied at that point are kept).",
        "tags": [
          "SuperFlags"
        ],
        "operationId": "superflags_apply",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Organization ID"
          },
          {
            "name": "survey_series_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Survey series (feedback group) ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SuperFlagApplyRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted \u2014 task queued for async processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuperFlagApplyResponse"
                }
              }
            }
          },
