    "/canvas-documents": {
      "get": {
        "summary": "List the org's canvas documents",
        "description": "Return the active org's canvas documents (optionally filtered by report_kind), plus the caller's per-kind default selection.\n\nEach document's `config` is a LIST PROJECTION, not the stored layout: only page 1 plus the page settings are included (what the list thumbnail renders), and a projected config carries `truncated: true`. The write-path validators reject that key, so a projected config cannot be saved back over the stored one. Use `GET /canvas-documents/{document_id}` for the full config.",
        "tags": [
          "Reports"
