      "SurveyListResponse": {
        "description": "Top-level shape is a JSON array of ``SurveyListItem`` \u2014 declared\nas a pydantic v2 ``RootModel`` so the generated OpenAPI schema is\n``type: array`` (not ``type: object``). The handler returns the bare\narray via ``ok(survey_list)`` which wraps it as ``{\"data\": [...]}``\nper the canonical envelope. Each item carries answer/question\ncounts plus optional translation + sub-source metadata.",
        "example": [
          {
            "answer_count": 1240,
            "question_count": 5,
            "survey_id": 42,
            "survey_name": "CSAT \u2014 March 2026"
          },
          {
            "answer_count": 580,
            "question_count": 3,
            "survey_id": 43,
            "survey_name": "NPS \u2014 April 2026"
          }
        ],
        "items": {
          "$ref": "#/components/schemas/SurveyListItem"
        },
        "title": "SurveyListResponse",
        "type": "array"
      },
      "SurveyDict": {
        "additionalProperties": true,
        "description": "``Survey.to_dict()`` bundle \u2014 schema varies; keep permissive.",
        "example": {
          "blocks": [
            {
              "block_id": 12,
              "description": null,
              "name": "Screening",
              "options": {},
              "position": 0
            }
          ],
          "creation_type": "SURVEY",
          "questions": [
            {
              "block_id": 12,
              "is_mandatory": false,
              "question_id": 100,
              "question_text": "What could we improve?",
              "question_type": "DEPTH_TEXT",
              "ref": "Q1"
            },
            {
              "carry_forward_keep_fixed": true,
              "carry_forward_mode": "selected",
              "carry_forward_source_question_id": 100,
              "is_mandatory": false,
              "question_id": 102,
              "question_text": "And which of them do you use?",
              "question_type": "MULTI_CHOICE",
              "ref": "Q3"
            },
            {
              "choices": [
                {
                  "code": "1",
                  "label": "Dissatisfied"
                },
                {
                  "code": "2",
                  "label": "Satisfied"
                }
              ],
              "grid_config": {
                "mobile_layout": "stacked",
                "require_all_rows": true,
                "selection_mode": "single"
              },
              "grid_rows": [
                {
                  "code": "A1",
                  "label": "Punctuality"
                },
                {
                  "code": "A2",
                  "label": "Cleanliness"
                }
              ],
              "is_mandatory": true,
              "question_id": 101,
              "question_text": "Q6",
              "question_type": "GRID"
            }
          ],
          "survey_description": "Monthly post-ticket survey",
          "survey_id": 42,
          "survey_language": "EN",
          "survey_mode": "ACCESSIBLE",
          "survey_name": "CSAT \u2014 March 2026",
          "survey_series_id": 7,
          "survey_type": "ENTERPRISE"
        },
        "properties": {},
        "title": "SurveyDict",
        "type": "object"
      },
