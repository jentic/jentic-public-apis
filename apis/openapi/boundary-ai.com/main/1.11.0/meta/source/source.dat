      "ThemeFlagCanvasPdfRequest": {
        "description": "Body for POST /reports/theme-flag-canvas-pdf.\n\nTheme/flag reports are assembled client-side; when the user selects a\ncanvas document, the client normalizes its report_data into the shared\ncanvas vocabulary and posts it here to be rendered server-side through the\nshared canvas PDF pipeline. ``reportData`` is that normalized object;\n``canvas_document_id`` / ``canvas_inline`` select the effective theme_flag\ncanvas. The two style + two logo slots mirror the report generate flow\n(transient, never persisted).\n\nTWO MODES, and at least one of them must resolve or the route 400s:\n  * whole-canvas \u2014 a canvas document REPLACES the report; select it with\n    ``canvas_document_id`` / ``canvas_inline`` (or an org/user default).\n  * themed \u2014 the report's OWN document renders and places the design's\n    canvas pages in their section slots; requested by sending\n    ``theme_flag_data``, with ``report_type`` / ``orange_branding``\n    describing which variant to draw.",
        "properties": {
          "reportData": {
            "additionalProperties": true,
            "title": "Reportdata",
            "type": "object"
          },
          "design_mode": {
            "anyOf": [
              {
                "enum": [
                  "default",
                  "standard",
                  "specific"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Design Mode"
          },
          "canvas_document_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Canvas Document Id"
          },
          "canvas_inline": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Canvas Inline"
          },
          "style_template_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Style Template Id"
          },
          "style_inline": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Style Inline"
          },
          "logo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InlineLogoSlot"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "secondaryLogo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InlineLogoSlot"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Language"
          },
          "theme_flag_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Theme Flag Data"
          },
          "report_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "overview | raw_data",
            "title": "Report Type"
          },
          "orange_branding": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Orange Branding"
          },
          "report_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Report Title"
          }
        },
        "required": [
          "reportData"
        ],
        "title": "ThemeFlagCanvasPdfRequest",
        "type": "object"
      },
      "ThemeFlagCanvasPdfResponse": {
        "description": "Task handle for a server-side theme_flag canvas render. Poll\n``status_url`` and download from ``download_url`` (both task-keyed, served\nby the shared /surveys pdf-status + download-pdf routes).",
        "properties": {
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "status_url": {
            "title": "Status Url",
            "type": "string"
          },
          "download_url": {
            "title": "Download Url",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "status_url",
          "download_url"
        ],
        "title": "ThemeFlagCanvasPdfResponse",
        "type": "object"
      },
      "ReportGenerateRequest": {
        "description": "Optional body for POST /reports/<id>/generate (#2213, #2214).\n\nBoth slots are transient: baked into this one generation, never\npersisted. An empty slot falls back to the creator's saved default,\nthen the brand mark.",
