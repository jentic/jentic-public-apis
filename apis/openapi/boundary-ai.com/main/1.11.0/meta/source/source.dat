      "SimulationRunsResponse": {
        "additionalProperties": true,
        "description": "``GET /surveys/<survey_id>/simulations``.\n\n``simulated_response_count`` rides along because it is what the purge\nbutton counts and what the publish-time warning reads \u2014 launching a\nstudy whose dataset still holds 300 fake completes is a mistake nobody\nrecovers from quietly.",
        "properties": {
          "simulation_runs": {
            "items": {
              "$ref": "#/components/schemas/SimulationRunPayload"
            },
            "title": "Simulation Runs",
            "type": "array"
          },
          "simulated_response_count": {
            "default": 0,
            "title": "Simulated Response Count",
            "type": "integer"
          }
        },
        "title": "SimulationRunsResponse",
        "type": "object"
      },
      "SimulatedToplineQuestion": {
        "additionalProperties": true,
        "description": "One ``questions`` entry of the simulated toplines: a portal-shaped\ntopline (``options`` / ``distribution`` / ``response_count`` \u2026 by type\nride along as extra keys) plus ``optional``.",
        "properties": {
          "question_id": {
            "title": "Question Id",
            "type": "integer"
          },
          "question_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Question Text"
          },
          "question_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
