      "QuestionAiConfigResponse": {
        "additionalProperties": true,
        "description": "``GET``/``PUT /surveys/<id>/questions/<qid>/ai-config`` (#2597/#2599).\n\n``ai_followup_config`` is the FULL normalized object, including the\nauthor-only fields (``context``, ``avoid_topics``) that are deliberately\nstripped from the respondent-facing payload. This response is served\nbehind ``login_required`` to a survey editor, which is the only audience\nthe avoid-list may ever reach.",
        "properties": {
          "question_id": {
            "title": "Question Id",
            "type": "integer"
          },
          "ai_followup_enabled": {
            "default": false,
