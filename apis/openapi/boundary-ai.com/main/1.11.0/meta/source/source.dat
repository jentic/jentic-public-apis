          },
          "scrapers": [
            {
              "execution_mode": "weekly",
              "is_active": true,
              "is_mine": true,
              "is_template": false,
              "last_execution_status": "completed",
              "platforms": [
                "tripadvisor"
              ],
              "scraper_id": 91,
              "scraper_name": "TripAdvisor \u2014 Paris hotel",
              "survey_name": "Hotel reviews 2026",
              "survey_series_id": 7
            }
          ]
        },
        "properties": {
          "scrapers": {
            "description": "Agents the caller may open: their own, the org's, and (with show_templates) org templates. Each item is the scraper record plus evolution_enabled, has_live_survey, last_execution, source_item_count, last_analysis_at and is_mine (true when the caller created the agent; the UI lists those under My Agents and the rest under All agents).",
            "items": {},
