      "AutoAnalysisFrequencyResponse": {
        "additionalProperties": true,
        "description": "A feedback group's automatic analysis frequency (migration 356).\n\n``is_default`` is true when the group never chose one (daily applies).\n``next_run_at`` is when data arriving now would next be analyzed\nautomatically (UTC ISO; now for after_each_import, null for manual);\nwith ``period_key`` it also accounts for that period's close.\n``pending`` (only with a valid ``period_key``) lists that period's\nsources whose new data is waiting for an automatic update; a source\nwith new data that is not listed gets none (only \"Analyze\" updates it).",
        "properties": {
          "frequency": {
            "title": "Frequency",
            "type": "string"
          },
          "is_default": {
            "title": "Is Default",
