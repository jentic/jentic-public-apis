                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sender Id"
          },
          "per_segment_cost": {
            "default": 0.0,
            "title": "Per Segment Cost",
            "type": "number"
          },
          "currency": {
            "default": "EUR",
            "title": "Currency",
            "type": "string"
          },
          "monthly_segment_cap": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Monthly Segment Cap"
          },
          "confirm_threshold": {
            "default": 0,
            "title": "Confirm Threshold",
            "type": "integer"
          },
          "stop_reply_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Stop Reply Text"
