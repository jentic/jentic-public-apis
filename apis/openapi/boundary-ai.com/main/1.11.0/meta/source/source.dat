            "title": "Timeframe"
          },
          "period_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Evolution bucket to reset (e.g. \"2026-07\"). Requires timeframe=\"evolution\".",
            "title": "Period Key"
          }
        },
        "title": "ResetGroupedThemesRequest",
        "type": "object"
      },
