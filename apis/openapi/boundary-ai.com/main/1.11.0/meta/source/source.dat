          "answer_text"
        ]
      },
      "FollowupProbePreviewResponse": {
        "additionalProperties": true,
        "description": "``POST .../questions/<qid>/followup-preview`` \u2014 the builder preview's\nprobe (#2568 ruling 50).\n\nSame payload as the hosted probe, because it IS the hosted probe \u2014 the\nsame service call, the same triggers, the same budget and credit gates \u2014\nplus ``preview: true`` so a client can never mistake a preview probe for\na fieldwork one. Nothing is stored server-side: no answer row, no\nfollow-up record. The one model call it may cost is real.\n\n``reason`` is set exactly when ``followup`` is null: which gate stayed\nquiet, so the author can act on it. One of ``unsupported_question``,\n``simulated``, ``index_out_of_range``, ``empty_answer``,\n``trigger_not_met``, ``survey_switch_off``, ``no_org``,\n``out_of_credit``, ``budget_spent``, ``timeout``, ``model_error``,\n``model_declined``, ``probe_rejected``. Never present on the hosted\nroute \u2014 a respondent must not be able to tell which happened.",
        "properties": {
          "followup": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Followup"
          },
          "followup_index": {
            "default": 1,
            "title": "Followup Index",
            "type": "integer"
          },
          "preview": {
            "default": true,
            "title": "Preview",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          }
        },
        "title": "FollowupProbePreviewResponse",
        "type": "object"
      },
      "SurveyAiSettingsResponse": {
        "additionalProperties": true,
        "description": "``GET``/``PUT /surveys/<id>/ai-settings`` \u2014 the per-survey switches.",
        "properties": {
          "ai_followups_enabled": {
            "default": false,
            "title": "Ai Followups Enabled",
            "type": "boolean"
          },
          "ai_followup_call_cap": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ai Followup Call Cap"
          },
          "ai_followup_call_count": {
            "default": 0,
            "title": "Ai Followup Call Count",
            "type": "integer"
          },
          "live_analysis_enabled": {
            "default": false,
            "title": "Live Analysis Enabled",
            "type": "boolean"
          }
        },
