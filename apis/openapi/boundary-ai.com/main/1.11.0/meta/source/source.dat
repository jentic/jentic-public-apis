      "QualGlossaryConflict": {
        "properties": {
          "term": {
            "title": "Term",
            "type": "string"
          },
          "language": {
            "description": "Stored language code; blank = every language.",
            "title": "Language",
            "type": "string"
          },
          "preferred_english": {
            "description": "The rendering kept (first in the file).",
            "title": "Preferred English",
            "type": "string"
          },
          "alternatives": {
            "description": "Other renderings found for the same term, kept in its notes as 'also acceptable' (as many as fit the notes field).",
            "items": {
              "type": "string"
            },
            "title": "Alternatives",
            "type": "array"
          }
        },
        "required": [
