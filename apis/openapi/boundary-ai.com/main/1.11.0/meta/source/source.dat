    "/surveys/{survey_id}/respondent-lists/{list_id}/sms/test-send": {
      "post": {
        "summary": "Send one test SMS",
        "description": "Sends a single message to a chosen number, rendered against a sample recipient. Creates NO recipient rows and touches no list state \u2014 the rehearsal before an irreversible, billable action. The opt-out register is still honoured: a test is still a real message. Rate limited to 10 test sends per hour per user and 30 per hour per organisation (429), and to a default of 200 per organisation per calendar month (409, SMS_TEST_SENDS_MONTHLY_CAP).",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_post_respondent_list_sms_test_send",
        "parameters": [
          {
            "name": "survey_id",
