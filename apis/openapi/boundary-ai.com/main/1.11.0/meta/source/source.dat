      "AnswerItem": {
        "additionalProperties": true,
        "description": "One stored answer (``Answer.to_dict()``). Value fields depend on\n``answer_type``: TEXT -> ``answer_text``; NUMERIC -> ``answer_numeric``;\nCHOICE -> ``selected_choices`` + ``answer_other_text`` (+ ``sub_key`` for\na grid row).",
        "properties": {
          "answer_id": {
            "title": "Answer Id",
            "type": "integer"
          },
          "question_id": {
            "title": "Question Id",
            "type": "integer"
          },
          "user_id": {
            "description": "Respondent id (can exceed 64 bits; parse as a big integer).",
            "title": "User Id",
            "type": "integer"
          },
          "answer_type": {
            "enum": [
              "TEXT",
              "NUMERIC",
              "CHOICE"
            ],
            "title": "Answer Type",
            "type": "string"
          },
          "answer_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Answer Text"
          },
          "answer_numeric": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Answer Numeric"
          },
          "selected_choices": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Selected Choices"
          },
          "answer_other_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Answer Other Text"
          },
          "sub_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
