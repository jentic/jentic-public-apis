              }
            }
          }
        },
        "security": []
      }
    },
    "/reports/raw-data/{token}/download": {
      "post": {
        "summary": "Download a report's raw data with its access code (no login)",
        "description": "PUBLIC endpoint: the signed token plus the access code printed in the report authorize the download. The stored workbook is encrypted under the code; a wrong code is a 403 and counts against a failure-only rate bucket (per link and address). Dead links are an opaque 404.",
        "tags": [
          "Reports"
        ],
        "operationId": "reports_download_raw_export",
        "parameters": [
          {
            "name": "token",
