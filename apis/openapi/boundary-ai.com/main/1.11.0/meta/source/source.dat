          },
          "started": {
            "default": 0,
            "title": "Started",
            "type": "integer"
          },
          "completed": {
            "default": 0,
            "title": "Completed",
            "type": "integer"
          }
        },
        "title": "DistributionStatsPayload",
        "type": "object"
      },
