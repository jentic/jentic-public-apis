      "CreateSimulationRequest": {
        "additionalProperties": true,
        "description": "Body for ``POST /surveys/<survey_id>/simulations``.",
        "properties": {
          "count": {
            "default": 100,
            "maximum": 2000,
            "minimum": 1,
            "title": "Count",
            "type": "integer"
          },
          "disable_backward_jumps": {
            "default": true,
            "description": "Ignore jumps to an earlier question \u2014 they can make a random walker loop",
            "title": "Disable Backward Jumps",
            "type": "boolean"
          },
          "apply_quotas": {
            "default": false,
            "description": "Off by default: with quotas on, most simulated records screen out",
            "title": "Apply Quotas",
            "type": "boolean"
          },
          "abandon_pct": {
            "default": 0,
            "description": "Percentage of records that abandon partway, for drop-off tables",
            "maximum": 100,
            "minimum": 0,
            "title": "Abandon Pct",
            "type": "integer"
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Makes a run reproducible for a bug report",
            "title": "Seed"
          }
        },
        "title": "CreateSimulationRequest",
        "type": "object"
      },
      "SimulationReportPayload": {
        "additionalProperties": true,
        "description": "What the programmer reads: ``n`` per question, and the abort list.\n\n``zero_count_question_ids`` is the actual deliverable \u2014 a question no\nsimulated respondent could reach is either unreachable (a bug) or a path\nfar rarer than anyone intended.",
        "properties": {
          "completed": {
            "default": 0,
            "title": "Completed",
            "type": "integer"
          },
          "aborted": {
            "default": 0,
            "title": "Aborted",
            "type": "integer"
          },
          "screened_out": {
            "default": 0,
            "title": "Screened Out",
            "type": "integer"
          },
          "abandoned": {
            "default": 0,
            "title": "Abandoned",
            "type": "integer"
          },
          "question_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Question Counts",
            "type": "object"
          },
          "question_order": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Question Order",
            "type": "array"
          },
          "aborts": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Aborts",
            "type": "array"
          },
          "zero_count_question_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Zero Count Question Ids",
            "type": "array"
          },
          "reached_counts": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "question_id (as a string) -> simulated interviews that were SHOWN the question, answered or not. Tells 'never reached' (a condition bug) from 'reached, and every respondent skipped it' (an optional question). null for a run stored before reach was recorded.",
            "title": "Reached Counts"
          },
          "unreached_question_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Questions no simulated respondent was ever shown, in questionnaire order: check their display condition. null when reach was not recorded (older runs); read zero_count_question_ids then.",
            "title": "Unreached Question Ids"
          }
        },
        "title": "SimulationReportPayload",
        "type": "object"
      },
