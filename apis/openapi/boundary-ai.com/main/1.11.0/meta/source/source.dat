    "/chat/{org_id}/suggestions": {
      "get": {
        "summary": "Suggested questions for the empty chat panel",
        "description": "Returns 2-4 contextual questions the chat panel renders before the user has typed. Tuned to the page (``view_context``) and the requested language. Cached per (org, page, language).",
        "tags": [
          "Chat"
        ],
        "operationId": "chat_get_suggestions",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Organization ID"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Product surface the user is on (e.g. 'dashboard'); tunes the suggestions."
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 16,
              "default": "en"
            },
            "description": "Desired suggestion language (ISO-639-1)."
          },
          {
            "name": "group_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Feedback group the current page is scoped to."
          },
          {
            "name": "source_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Source the current page is scoped to."
          },
          {
            "name": "datapoint_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Datapoint the current page is scoped to."
          },
          {
            "name": "super_theme_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Super-theme the current page is scoped to."
          },
          {
            "name": "theme_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Theme the current page is scoped to."
          },
          {
            "name": "survey_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Survey the current page is scoped to."
          },
          {
            "name": "analysis_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Analysis the current page is scoped to."
          },
          {
            "name": "flag_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Flag the current page is scoped to."
          },
          {
            "name": "report_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "description": "Report the current page is scoped to."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
