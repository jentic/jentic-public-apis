        "type": "object"
      },
      "ClerkWebhookResult": {
        "additionalProperties": true,
        "description": "Body of POST /webhooks (after successful signature verification).\n\nThe 200 is intentional even on handler errors \u2014 see the route\ndocstring for the retry-storm rationale. The discriminating field is\n``status``, not the HTTP code.",
        "properties": {
          "status": {
            "enum": [
              "success",
              "unhandled",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "event_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The Clerk event type (e.g. user.created, organization.updated)",
            "title": "Event Type"
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Clerk's event ID",
            "title": "Event Id"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Handler error message \u2014 only present on status=error",
            "title": "Error"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Message"
          }
        },
        "required": [
          "status"
        ],
        "title": "ClerkWebhookResult",
        "type": "object"
      },
      "SendGridEventsResult": {
        "additionalProperties": true,
        "description": "Body of POST /webhooks/sendgrid/events (after signature verification).\n\nAlways 200 once the signature is verified; ``status`` discriminates.\nCounts describe the batch: ``processed`` events updated a recipient,\n``unmatched`` events referenced mail not sent through the\nrespondent-send pipeline (reports, alerts \u2014 expected), ``ignored``\nevent types carry no delivery meaning for us.",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "ignored",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "processed": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Processed"
          },
          "ignored": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ignored"
          },
          "unmatched": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Unmatched"
          },
          "errors": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          }
        },
        "required": [
          "status"
        ],
        "title": "SendGridEventsResult",
        "type": "object"
      },
      "SmsWebhookResult": {
        "additionalProperties": true,
        "description": "Body of POST /webhooks/sms/status/<org_id> and /webhooks/sms/inbound/<org_id>.\n\n``ok`` means the callback was applied. ``unmatched`` means it named a\nmessage we did not send (or one belonging to another tenant, which is\nrefused rather than crossed). ``ignored`` means it carried nothing we\nact on \u2014 an unrecognised delivery state, or an inbound message that is\nnot an opt-out keyword; this channel is not a conversation.",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "ignored",
              "unmatched",
              "error"
            ],
            "title": "Status",
            "type": "string"
          },
          "delivery_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Delivery Status"
          },
          "unsubscribed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Unsubscribed"
          },
          "new": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "New"
          },
          "auto_replied": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Auto Replied"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reason"
          }
        },
        "required": [
          "status"
        ],
        "title": "SmsWebhookResult",
        "type": "object"
      },
      "SupportedEventsResponse": {
        "properties": {
          "supported_events": {
