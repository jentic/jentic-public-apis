        "type": "object"
      },
      "AnswersListResponse": {
        "additionalProperties": true,
        "description": "One page of a survey's answers (``GET /surveys/{id}/answers``).\n\nPage with ``after=<next_cursor>`` (constant cost at any depth) until\n``has_more`` is false; ``offset`` paging still works but costs a full\nscan per page on large surveys.",
        "properties": {
          "answers": {
            "items": {
              "$ref": "#/components/schemas/AnswerItem"
            },
            "title": "Answers",
            "type": "array"
          },
          "total": {
            "description": "Answers matching the request (whole survey, not the page).",
            "title": "Total",
            "type": "integer"
          },
          "limit": {
            "description": "Page size used (default 1000, max 5000).",
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "description": "Offset used; always 0 in cursor (`after`) mode.",
            "title": "Offset",
            "type": "integer"
          },
          "has_more": {
            "description": "Another page follows. Stop paging when false.",
            "title": "Has More",
            "type": "boolean"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Last answer id of this page: pass it as `after` for the next page. Null on an empty page.",
            "title": "Next Cursor"
          },
          "after": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Echo of the `after` cursor; present only in cursor mode.",
            "title": "After"
          }
        },
        "required": [
          "total",
          "limit",
          "offset",
          "has_more"
        ],
        "title": "AnswersListResponse",
        "type": "object"
      },
