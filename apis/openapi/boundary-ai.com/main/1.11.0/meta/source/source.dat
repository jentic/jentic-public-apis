            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Durable apply-batch handle when >=1 source was queued; poll GET /super-flags/apply-status?batch_id=\u2026 for per-source scan state",
            "title": "Batch Id"
          },
          "server_coordinated": {
            "default": false,
            "description": "True when every dispatched source went through the durable queue: the backend fires the recompute itself when the batch drains, so the client must not chain POST /super-flags/recompute",
            "title": "Server Coordinated",
            "type": "boolean"
          },
          "recompute_required": {
            "description": "True when the client should trigger POST /super-flags/recompute",
            "title": "Recompute Required",
            "type": "boolean"
          }
        },
        "required": [
