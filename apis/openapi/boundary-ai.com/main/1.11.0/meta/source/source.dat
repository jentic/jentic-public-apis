    "/surveys/{survey_id}/duplicate": {
      "post": {
        "summary": "Duplicate a survey",
        "description": "Server-side copy of a survey into the SAME group: questions (with their piping refs, so every {{Qn}} token keeps naming the same question), display conditions, carry-forward, blocks, branching, end screens, computed variables, quotas, customization, theme and translations. Monitors are not copied: the copy is attached to the group's auto-covering monitors, like any new survey. The copy starts in EDITING with no passcode and no auto-close quota; responses are never copied. Only authored surveys can be duplicated \u2014 an upload, connection or API-endpoint source is refused with 400.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_post_duplicate",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "name": "survey_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
