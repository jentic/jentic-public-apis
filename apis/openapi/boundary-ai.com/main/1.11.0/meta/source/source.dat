      "ReplyDraftRequest": {
        "additionalProperties": true,
        "description": "POST /analysis/answers/<answer_id>/reply-draft.\n\nAll fields optional TONE hints \u2014 the factual substance is always the\nreview body the handler fetches server-side, never client-supplied text.\n``rating`` is the 1-5 star rating (review platforms); ``sentiment`` the\nanalysed sentiment label; ``source`` the platform display name;\n``language`` the UI locale used only as a fallback when the review's own\nlanguage can't be detected.",
        "properties": {
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Language"
          },
          "sentiment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sentiment"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Source"
          },
          "rating": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Rating"
          }
        },
        "title": "ReplyDraftRequest",
        "type": "object"
      },
      "ReplyDraftResponse": {
        "additionalProperties": true,
        "description": "GET/POST /analysis/answers/<answer_id>/reply-draft.\n\n``status`` is one of ``running`` / ``completed`` / ``failed`` /\n``empty_review`` / ``unavailable`` (POST only \u2014 no suggestion for this\ncaller, e.g. a demo-org viewer; fall back to manual compose). ``draft``\ncarries the suggested reply text on a ``completed`` (cache-hit)\nresponse; ``cached`` marks a replay.",
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          },
          "answer_id": {
            "title": "Answer Id",
            "type": "integer"
          },
          "draft": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Draft"
          },
          "cached": {
            "default": false,
            "title": "Cached",
            "type": "boolean"
          }
        },
        "required": [
          "status",
          "answer_id"
        ],
        "title": "ReplyDraftResponse",
        "type": "object"
      },
