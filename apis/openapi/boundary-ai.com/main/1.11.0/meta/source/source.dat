    "/aps/{org_id}/breakdown": {
      "get": {
        "summary": "Get APS usage breakdown for an organization",
        "description": "Returns APS consumption grouped by user-facing feature, plus a daily timeline and recent-calls list for drill-down. Scoped to the current billing period by default; ``days`` overrides with a rolling window.",
        "tags": [
          "APS"
        ],
        "operationId": "aps_get_breakdown",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Organization ID"
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            },
            "description": "Rolling window in days; overrides the billing-period default."
          },
          {
            "name": "recent_limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "description": "Maximum number of recent calls to return."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/APSBreakdownResponse"
                    }
