    "/api/v1/openapi-public.json": {
      "get": {
        "summary": "Download the public OpenAPI 3.1 spec (JSON)",
        "description": "Customer-facing subset of the full spec \u2014 strips operations tagged ``x-internal: true`` (e.g. the super-admin namespace) and filters out internal-only response components. Use this spec for external SDK codegen and customer-facing Redoc.",
        "tags": [
          "OpenAPI"
        ],
        "operationId": "openapi_get_public_json",
        "responses": {
          "200": {
            "description": "Public OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "security": []
      }
    },
