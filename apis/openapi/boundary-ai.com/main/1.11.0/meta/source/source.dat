    "/surveyseries/{org_id}/{survey_series_id}/monitors/scan-coverage": {
      "get": {
        "summary": "Live scan coverage for ALL flag monitors of a series (batch)",
        "description": "Batch form of the per-monitor scan-coverage endpoint: one request returns the coverage payload for every active FLAG monitor of the series (optionally narrowed via `monitor_ids`). Use THIS from any surface that shows several monitors at once \u2014 the per-monitor endpoint is expensive (reads per-comment dataframes) and its docstring forbids calling it in a loop; the page-load fan-out of per-monitor calls was a top executor-saturation source (#2348). Per-monitor failures degrade to `state: \"unknown\"` rows instead of failing the batch.",
        "tags": [
          "SuperFlags"
        ],
        "operationId": "superflags_series_scan_coverage",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Organization ID"
          },
          {
            "name": "survey_series_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Survey series (feedback group) ID"
          },
          {
            "name": "period_key",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional evolution bucket period key."
          },
          {
            "name": "monitor_ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated monitor ids to restrict the batch to."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonitorScanCoverageBatchResponse"
                }
              }
            }
