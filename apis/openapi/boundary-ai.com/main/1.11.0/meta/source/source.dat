      "ReportShareStateResponse": {
        "additionalProperties": true,
        "description": "Shape of ``GET /reports/<report_id>/share``: whether the report has an\nactive share link and how often it was opened. ``url`` and ``token`` are\ngiven to writers only, and only while the link is active.",
        "example": {
          "downloads": 1,
          "enabled": true,
          "expires_at": 1767225600,
          "ttl_seconds": 2592000,
          "views": 3
        },
        "properties": {
          "enabled": {
            "description": "The link is active",
            "title": "Enabled",
            "type": "boolean"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Public report page URL (writers only, while active)",
            "title": "Url"
          },
          "token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The signed link token (writers only, while active)",
            "title": "Token"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Unix timestamp (seconds) when the link expires",
            "title": "Expires At"
          },
          "ttl_seconds": {
            "default": 0,
            "description": "Token lifetime in seconds at signing time; 0 without an active link",
            "title": "Ttl Seconds",
            "type": "integer"
          },
          "views": {
            "default": 0,
            "description": "Times the report page was opened",
            "title": "Views",
            "type": "integer"
          },
          "downloads": {
            "default": 0,
            "description": "Times the file was downloaded",
            "title": "Downloads",
            "type": "integer"
          }
        },
        "required": [
          "enabled"
        ],
        "title": "ReportShareStateResponse",
        "type": "object"
      },
      "ReportShareCreateResponse": {
        "additionalProperties": true,
        "description": "Shape of ``POST /reports/<report_id>/share``: the report's active\nshare link, a delivery without a named recipient on ``/r/<token>``.",
        "example": {
          "downloads": 1,
          "enabled": true,
          "expires_at": 1767225600,
          "token": "eyJhbGciOi...",
          "ttl_seconds": 2592000,
          "url": "https://app.example.com/r/eyJhbGciOi...",
          "views": 3
        },
        "properties": {
          "enabled": {
            "description": "Sharing is now on for this report",
            "title": "Enabled",
            "type": "boolean"
          },
          "url": {
            "description": "Full public report page URL embedding the signed token",
            "title": "Url",
            "type": "string"
          },
          "token": {
            "description": "The signed share token (also embedded in ``url``)",
            "title": "Token",
            "type": "string"
          },
          "expires_at": {
            "description": "Unix timestamp (seconds) when the token expires",
            "title": "Expires At",
            "type": "integer"
          },
          "ttl_seconds": {
            "description": "Token lifetime in seconds at signing time (the token is signed when this answer is built, against the link's stored expiry)",
            "title": "Ttl Seconds",
            "type": "integer"
          },
          "views": {
            "default": 0,
            "description": "Times the report page was opened",
            "title": "Views",
            "type": "integer"
          },
          "downloads": {
            "default": 0,
            "description": "Times the file was downloaded",
            "title": "Downloads",
            "type": "integer"
          }
        },
        "required": [
          "enabled",
          "url",
          "token",
          "expires_at",
          "ttl_seconds"
        ],
        "title": "ReportShareCreateResponse",
        "type": "object"
      },
      "ReportShareRevokeResponse": {
        "additionalProperties": true,
        "description": "Shape of ``DELETE /reports/<report_id>/share``.",
