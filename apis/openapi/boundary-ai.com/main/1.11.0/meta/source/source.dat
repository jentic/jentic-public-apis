    "/surveys/{survey_id}/questions/{question_id}/followup-preview": {
      "post": {
        "summary": "Preview an AI follow-up probe for an open question in the builder",
        "description": "The builder preview's twin of the public probe (#2568 ruling 50). It calls the SAME service with the SAME arguments the hosted page would \u2014 same triggers, same organisation credit pre-gate, and a spent per-survey budget reported as `budget_spent` (the preview never draws that budget down itself) \u2014 so the author sees exactly the probe a respondent would get. Nothing is stored: no answer row, no follow-up record. Returns `{followup: null}` for every quiet miss (trigger not met, probing off, budget spent, out of credit, model timeout) with `reason` naming which, and `preview: true` always. One model call may be billed.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_post_followup_probe_preview",
        "parameters": [
          {
            "name": "survey_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
