              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "sftp (key auth): the one-line OpenSSH public key to register on the SFTP account; also kept in provider_config.public_key",
            "title": "Public Key"
          }
        },
        "required": [
