        "description": "Refused with 409 while any survey still follows the theme, listing them. Pass ``snapshot=true`` to delete anyway: each using survey first FREEZES its currently-resolved appearance into its own overrides and detaches, so no live questionnaire changes.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_delete_theme",
        "parameters": [
          {
            "name": "theme_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "snapshot",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Snapshot-and-detach using surveys instead of refusing"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/SurveysMessageResponse"
