          "period_key": {
            "description": "The period the label applies to",
            "title": "Period Key",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The stored display name, or None when the label was cleared",
            "title": "Label"
          },
          "period_labels": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "The series's full {period_key: label} map after the write",
            "title": "Period Labels",
