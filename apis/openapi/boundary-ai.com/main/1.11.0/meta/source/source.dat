    "/analysis/{survey_id}/questions/{question_id}/ai-generate-flags": {
      "post": {
        "summary": "Kick off AI flag generation for a question",
        "tags": [
          "Analysis"
        ],
        "operationId": "analysis_post_ai_generate_flags",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "name": "survey_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "question_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AIGenerateFlagsRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted \u2014 task queued for async processing",
            "content": {
