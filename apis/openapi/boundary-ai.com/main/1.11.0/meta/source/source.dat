      "CxSyncConfigCreateRequest": {
        "description": "Body for ``POST /native-connectors/cx/sync-configs``.",
        "properties": {
          "cx_connection_id": {
            "title": "Cx Connection Id",
            "type": "integer"
          },
          "survey_series_id": {
            "title": "Survey Series Id",
            "type": "integer"
          },
          "field_mapping": {
            "additionalProperties": true,
            "description": "Provider mapping. qualtrics: {survey_id, text_field, timestamp_field?, metadata_fields: [{field_id, display_name}]}. surveymonkey: {survey_id, text_fields[] (open-ended question ids; text_field is the singular alias), text_field_labels?, timestamp_field? (date_created | date_modified), metadata_fields: [{field_id, display_name}], source_name?}. With several text_fields one response becomes one record per answered question, each carrying a 'Question' metadata column.",
            "title": "Field Mapping",
            "type": "object"
          },
          "sync_interval_minutes": {
            "default": 60,
            "maximum": 1440,
            "minimum": 15,
            "title": "Sync Interval Minutes",
            "type": "integer"
          }
        },
        "required": [
          "cx_connection_id",
          "survey_series_id",
          "field_mapping"
        ],
        "title": "CxSyncConfigCreateRequest",
        "type": "object"
      },
      "SyncConfigModel": {
        "additionalProperties": true,
        "properties": {
          "sync_config_id": {
            "title": "Sync Config Id",
            "type": "integer"
          },
          "survey_series_id": {
            "title": "Survey Series Id",
            "type": "integer"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          }
        },
        "required": [
          "sync_config_id",
          "survey_series_id",
          "enabled"
        ],
        "title": "SyncConfigModel",
        "type": "object"
      },
