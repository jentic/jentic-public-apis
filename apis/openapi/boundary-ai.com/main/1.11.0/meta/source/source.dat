    "/analysis/{analysis_id}/themes/sub-themes/merge": {
      "patch": {
        "summary": "Merge 2+ sub-themes of one theme into one",
        "description": "Fuse the selected sub-themes of a single theme into one (#2795): their comment assignments are unioned (a comment attached to two sources ends up attached once), the merged item is named by the same rule as a theme merge \u2014 an LLM umbrella name when the sources are semantically close, a deterministic 'A x B' otherwise \u2014 and its description is regenerated. The parent theme's relevance is never touched. Depth-text questions only. 409 while another edit holds the per-content lock.",
        "tags": [
          "Analysis"
        ],
        "operationId": "analysis_patch_sub_themes_merge",
        "parameters": [
