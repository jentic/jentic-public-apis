    "/api/webhooks": {
      "get": {
        "summary": "List configured webhooks for the caller's org",
        "description": "Discriminated 200 body: admins see the full webhook list, non-admins see an admin-contact hint instead of a 403 so the frontend can render a useful empty state.",
        "tags": [
          "Webhooks"
        ],
        "operationId": "webhooks_get_list",
        "responses": {
          "200": {
            "description": "Success",
