      "CreateVerificationRunSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "static",
              "static_plus_llm"
            ]
          },
          "probe_interviews": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "seed": {
            "type": "integer"
          },
          "persona_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "purge_after_run": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "VerificationFindingPayload": {
        "additionalProperties": true,
        "description": "One thing wrong with the questionnaire, pointed at the question.\n\n``code`` is a STABLE identifier (``UNREACHABLE_QUESTION``,\n``CONTRADICTORY_CONDITION``, \u2026) so the UI and future tooling key off it\nrather than off the prose, and ``question_ids`` is what makes every\nfinding a link that scrolls to the offending card.",
        "properties": {
          "severity": {
            "description": "error | warning | info",
            "title": "Severity",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "description": "English explanation; the fallback text",
            "title": "Message",
            "type": "string"
          },
          "message_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "i18n key of the explanation (verification.message.*); absent on reports stored before findings were localised",
            "title": "Message Key"
          },
          "message_params": {
            "additionalProperties": true,
            "description": "Interpolation values for message_key. A value may be a nested {key, params, default} sub-message to translate first",
            "title": "Message Params",
            "type": "object"
          },
          "question_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Question Ids",
            "type": "array"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          }
        },
        "required": [
