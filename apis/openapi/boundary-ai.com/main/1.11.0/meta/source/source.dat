    "/reports/lots/{batch_id}/approve": {
      "post": {
        "summary": "Approve and send",
        "description": "Requires `confirm: true`. Pins the reviewed PDFs, holds recipients of reports with an open blocking point, and sends the rest. From a partly sent lot, sends the held ones whose points are resolved. Optional `send_at` (ISO 8601 with its offset, at least 10 minutes ahead): the run waits in `scheduled` until then. Optional `only` (`{\"group_ids\": [...]}` or `{\"attribute\": {\"key\", \"values\"}}`): the other recipients are held for later. 409 when the lot's state refuses it (`details.code`: `conflict`).",
        "tags": [
          "Reports"
