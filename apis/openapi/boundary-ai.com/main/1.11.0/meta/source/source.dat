                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportsFlatErrorEnvelope"
                }
              }
            }
          },
          "429": {
