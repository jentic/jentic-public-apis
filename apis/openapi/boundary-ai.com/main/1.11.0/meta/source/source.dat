      "VerificationRunPayload": {
        "additionalProperties": true,
        "description": "One verification report.\n\n``coverage`` carries the incidence table \u2014 per question, the share of\ngenerated interviews that reached it \u2014 which is the single most-used\noutput: it is what tells an author a branch will collect 10 answers at\nn=800 BEFORE the fieldwork money is spent.",
        "properties": {
          "run_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
