      "QuotaRecountCellPayload": {
        "additionalProperties": true,
        "properties": {
          "cell_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cell Id"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "previous": {
            "default": 0,
            "title": "Previous",
            "type": "integer"
          },
          "current": {
            "default": 0,
            "title": "Current",
            "type": "integer"
          },
          "target": {
            "default": 0,
            "title": "Target",
