    "/weighting/surveys/{survey_id}/imported-weights": {
      "post": {
        "summary": "Upload a per-respondent weight set (preview or commit)",
        "description": "Multipart upload of a .csv/.xlsx with an id column (user_id / external_id / respondent_id) and a weight column. With dry_run=true the file is validated and matched against the survey's respondents and only a report is returned (matched / unmatched counts and samples, weight range, effective sample size). Without it, a valid file is stored and becomes the survey's ACTIVE weighting method ('imported'), replacing the derived config's effect until weighting is reconfigured; the form field 'enabled' (default true) maps to the same master toggle derived configs use. Hard errors (invalid weights, duplicate or ambiguous ids, nothing matched) block the commit.",
        "tags": [
          "Weighting"
        ],
        "operationId": "weighting_import_weights",
        "parameters": [
          {
            "name": "survey_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "dry_run",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Validate and report only; store nothing"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/MultipartFileUpload"
              }
            }
          }
        },
        "responses": {
