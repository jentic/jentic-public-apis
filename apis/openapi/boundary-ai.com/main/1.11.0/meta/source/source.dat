                    "data"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelAnalysisResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict. `details.error_code` `PERIOD_CANCEL_REQUIRED`: the survey is an evolution-managed source, cancel its period with `POST /surveyseries/{org_id}/{survey_series_id}/evolution/sources/{source_survey_id}/cancel`. `error.code` `IDEMPOTENCY_ERROR`: the Idempotency-Key was already used and its first request is still running, or the key was reused with a different request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable: could not verify whether the survey is evolution-managed; nothing was cancelled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
