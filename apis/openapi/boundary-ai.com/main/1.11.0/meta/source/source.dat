    "/reports/{report_id}/send": {
      "post": {
        "summary": "Send a report",
        "description": "Emails a completed report to `emails` and/or `recipient_ids`, tracked per person (one email each, the report attached while it fits, else online, with a link). Optional `message`, `formats` (pdf, word, pptx, xlsx; default: the first of the report's `producible_formats`), `sender_profile_id`, `attachment_policy`. A format the report cannot produce is refused (400, `details.code` format_unavailable), never replaced by another file. Typed addresses are kept as recipients so opt-outs and bounces stick.",
        "tags": [
          "Reports"
        ],
        "operationId": "reports_send",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LotModel"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized \u2014 missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "409": {
            "description": "Conflict: the Idempotency-Key was already used and its first request is still running, or the key was reused with a different request (`error.code`: `IDEMPOTENCY_ERROR`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
