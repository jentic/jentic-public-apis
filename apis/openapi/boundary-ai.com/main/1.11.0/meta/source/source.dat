    "/native-connectors/medallia/connections/{connection_id}/capabilities": {
      "post": {
        "summary": "Negotiate this Medallia tenant's Query API capabilities",
        "description": "Establishes, from the tenant's own schema, the things this connector cannot verify from Medallia's published documentation: the membership filter operator, whether enum option ids and the multivalued flag are exposed, and whether introspection is available at all. Persisted on the connection so every later sync reads one answer instead of re-deriving it. Never raises for a schema reason \u2014 an instance that answers nothing yields a fallback profile with the gaps marked, which routes segmentation onto the client-side floor rather than letting a guess reach the tenant.",
        "tags": [
          "Native connectors"
        ],
        "operationId": "native_connectors_post_medallia_capabilities",
        "parameters": [
          {
            "name": "connection_id",
            "in": "path",
