                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "replayed": {
                          "type": "boolean"
                        },
                        "new_job_id": {
                          "type": "string"
                        },
                        "job_type": {
                          "type": "string"
                        },
                        "target_periods": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "period_key": {
                                "type": "string"
                              },
                              "done": {
                                "type": "boolean"
                              }
