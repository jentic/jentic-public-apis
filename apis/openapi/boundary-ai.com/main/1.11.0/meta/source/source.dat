            "title": "Close Reason"
          },
          "survey_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "EDITING | ACCESSIBLE | CLOSED (read-only)",
            "title": "Survey Mode"
