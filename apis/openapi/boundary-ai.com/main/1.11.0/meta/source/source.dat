      "CrossTabCellStats": {
        "additionalProperties": true,
        "description": "One cell of a categorical cross-tab: (answer category \u00d7 segment\nvalue) with its count and a Wilson confidence interval on the\nwithin-segment proportion (``count / column_total``).",
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "segment_value": {
            "title": "Segment Value",
            "type": "string"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "column_total": {
            "title": "Column Total",
            "type": "integer"
          },
          "proportion": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Proportion"
          },
          "ci_low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ci Low"
          },
          "ci_high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ci High"
          }
        },
        "required": [
          "category",
          "segment_value",
          "count",
          "column_total"
        ],
        "title": "CrossTabCellStats",
        "type": "object"
      },
      "CrossTabGroupStats": {
        "additionalProperties": true,
        "description": "One numeric (SCALE/NPS) segment group: descriptive stats plus a\nt-based confidence interval on the group mean. ``std`` is the sample\nstandard deviation (ddof=1); None when n < 2.",
        "properties": {
          "segment_value": {
            "title": "Segment Value",
            "type": "string"
          },
          "n": {
            "title": "N",
            "type": "integer"
          },
          "mean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Mean"
          },
          "std": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Std"
          },
          "ci_low": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ci Low"
          },
          "ci_high": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ci High"
          }
        },
        "required": [
          "segment_value",
          "n"
        ],
        "title": "CrossTabGroupStats",
        "type": "object"
      },
      "CrossTabQuestionStats": {
        "additionalProperties": true,
        "description": "Significance test for one (target question \u00d7 segmentation question)\npair (#2420).\n\n``test`` is ``chi_square`` (categorical targets), ``welch_t_test``\n(numeric target, 2 groups) or ``anova`` (numeric, >2 groups); None when\nthe test was withheld \u2014 ``guardrail_reason`` then says why (e.g.\n``sparse_cells`` per Cochran's rule, ``not_enough_groups``).\n``p_value_adjusted`` is Benjamini-Hochberg-corrected across every pair\nin the response, and ``significant`` keys off the ADJUSTED value at\nalpha = 1 - ``confidence_level``. ``cells``/``groups`` carry the\nconfidence intervals and are populated even when the test is withheld.",
        "properties": {
          "content_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Content Id"
          },
          "question_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Question Id"
          },
          "question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Question"
          },
          "question_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Question Type"
          },
          "segment_question_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Segment Question Id"
          },
          "segment_content_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Segment Content Id"
          },
          "test": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Test"
          },
          "statistic": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Statistic"
          },
          "degrees_of_freedom": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Degrees Of Freedom"
          },
          "degrees_of_freedom_within": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Degrees Of Freedom Within"
          },
          "p_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "P Value"
          },
          "p_value_adjusted": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "P Value Adjusted"
          },
          "significant": {
            "default": false,
            "title": "Significant",
            "type": "boolean"
          },
          "guardrail_passed": {
            "default": false,
            "title": "Guardrail Passed",
            "type": "boolean"
          },
          "guardrail_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Guardrail Reason"
          },
          "confidence_level": {
            "default": 0.95,
            "title": "Confidence Level",
            "type": "number"
          },
          "cells": {
            "items": {
              "$ref": "#/components/schemas/CrossTabCellStats"
            },
            "title": "Cells",
            "type": "array"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/CrossTabGroupStats"
            },
            "title": "Groups",
            "type": "array"
          }
        },
        "title": "CrossTabQuestionStats",
        "type": "object"
      },
