    "/report-fonts": {
      "get": {
        "summary": "List the org's custom report fonts",
        "description": "Every uploaded font for the active org, family-sorted. Pass ``include_data=1`` to receive each file as a data URL (a preview embeds them); the pickers omit it. Pass ``families=A,B`` to restrict the rows \u2014 a bytes-carrying read should always name the families it actually renders, or the response carries every upload.",
        "tags": [
          "Reports"
        ],
        "operationId": "reportfonts_list",
        "responses": {
          "200": {
            "description": "Success",
