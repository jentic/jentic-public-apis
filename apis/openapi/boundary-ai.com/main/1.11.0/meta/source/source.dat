    "/surveys/{survey_id}/canvas-report-data": {
      "get": {
        "summary": "Canvas report data of one source (design preview)",
        "description": "The per-source canvas report data a source design binds to \u2014 the SAME payload the PDF, Word and PowerPoint routes build \u2014 plus the source's question rows (ordinal, text, type, content id, key) for the report builder's Questions rail. Read-only: nothing is generated or stored. `analysis_id` selects a period-scoped analysis of this survey; omitted, the canonical analysis is used, else (a source of an evolution-tracking group) its newest ready period analysis. `periods` lists the ready period analyses to choose from.",
        "tags": [
          "Surveys"
        ],
        "operationId": "surveys_canvas_report_data",
        "parameters": [
          {
            "name": "survey_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "analysis_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "A period-scoped analysis of this survey; omitted = canonical, else newest ready period"
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
