          },
          "options": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional sub-categories, each {name, description?}; capped server-side",
            "title": "Options"
          },
          "on_conflict": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "duplicate",
            "description": "\"duplicate\" (default) or \"overwrite\"",
            "title": "On Conflict"
          },
          "overwrite_template_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Target template id; required when on_conflict == 'overwrite'",
            "title": "Overwrite Template Id"
          }
        },
        "required": [
          "name"
        ],
        "title": "FlagTemplateBulkRow",
        "type": "object"
      },
      "FlagTemplateBulkRequest": {
        "example": {
          "folder": {
            "name": "Q3 taxonomy",
            "on_conflict": "merge"
          },
          "templates": [
            {
