      "QualityRescanResponse": {
        "additionalProperties": true,
        "description": "``POST /surveys/<survey_id>/quality/rescan`` \u2014 backfill outcome.\n\nTWO OUTCOMES, and the status says which \u2014 the same contract as\n``QuotaRecountResponse`` and for the same reason. A re-scan has to\nvisit every response, so on a large survey it is DETACHED and the\nresponse is ``202`` with ``status: \"started\"``, ``flagged_responses``\n0 and an empty ``detectors`` list, because nothing has been counted\nyet. A client must branch on ``status`` and re-read the review payload\nrather than render these as results.",
        "properties": {
          "status": {
            "default": "completed",
            "description": "completed \u2014 the scan finished and the counters below are real. started \u2014 the scan was detached (large survey, HTTP 202); re-read the review payload for results.",
            "title": "Status",
            "type": "string"
          },
          "scanned_responses": {
            "default": 0,
            "description": "Responses evaluated. On a `started` response this is the count it is ABOUT to evaluate, not a completed total.",
            "title": "Scanned Responses",
            "type": "integer"
          },
          "flagged_responses": {
            "default": 0,
            "title": "Flagged Responses",
            "type": "integer"
          },
          "detectors": {
            "items": {
              "type": "string"
