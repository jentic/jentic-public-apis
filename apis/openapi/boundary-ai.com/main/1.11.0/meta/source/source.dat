      "VerificationRunsResponse": {
        "additionalProperties": true,
        "description": "``GET /surveys/<survey_id>/verifications`` \u2014 history, newest first.\n\nThe survey's CURRENT fingerprint rides along so every listed report can\nbe marked stale in one pass, rather than only after opening it.",
