      "PartialResponseSaveRequest": {
        "additionalProperties": true,
        "description": "Body for ``POST /api/survey/partial`` (public partial save).\n\n``answers`` is the client's draft envelope, stored and returned\nverbatim \u2014 the respond page keys it positionally, so the server does\nnot interpret it. ``schema_fingerprint`` is\n``\"<question_count>:<id>,<id>,\u2026\"``, the same value\n``respondPersistence.js`` computes; it is what decides whether the\ndraft may later be restored.",
        "properties": {
          "answers": {
            "additionalProperties": true,
            "title": "Answers",
            "type": "object"
          },
          "page_index": {
            "default": 0,
            "title": "Page Index",
            "type": "integer"
          },
          "schema_fingerprint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Schema Fingerprint"
          },
          "last_question_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Deepest question reached \u2014 feeds the drop-off table",
            "title": "Last Question Id"
          },
          "rtoken": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Respondent-list token (may also travel as ?rtoken)",
            "title": "Rtoken"
          },
          "session": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Server-minted session handle (may also travel as ?session)",
            "title": "Session"
          },
          "passcode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The survey passcode the respondent unlocked with. Required for a passcode-protected survey (same check and failed-attempt budget as the submit: 403 when wrong, 429 once the budget is spent); ignored otherwise.",
            "title": "Passcode"
          }
        },
        "title": "PartialResponseSaveRequest",
        "type": "object"
      },
      "PartialResponseSaveResponse": {
        "additionalProperties": true,
        "properties": {
          "saved": {
            "title": "Saved",
            "type": "boolean"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Set only on the call that MINTED it (anonymous first save). Store it and echo it as ?session on every later call.",
            "title": "Session Id"
          },
          "schema_stale": {
            "default": false,
