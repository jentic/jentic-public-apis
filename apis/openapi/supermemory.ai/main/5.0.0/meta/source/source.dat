{"openapi":"3.1.0","components":{"securitySchemes":{"bearerAuth":{"scheme":"bearer","type":"http"}},"schemas":{"ErrorResponse":{"type":"object","properties":{"error":{"type":"string","description":"Error message","example":"Invalid request parameters"},"details":{"type":"string","description":"Additional error details","example":"Query must be at least 1 character long"}},"required":["error"]},"FilterPredicate":{"anyOf":[{"type":"object","properties":{"field":{"type":"string","minLength":1,"pattern":"^[a-zA-Z0-9_.-]+$","description":"Metadata key to evaluate, matched literally. A period is part of the key name, not a path into nested metadata."},"operator":{"type":"string","enum":["eq","neq"],"description":"Compare the field for equality or inequality"},"value":{"type":"string","description":"String value to compare against"},"caseSensitive":{"default":true,"description":"Whether string comparison preserves letter case","type":"boolean"}},"required":["field","operator","value"],"additionalProperties":false},{"type":"object","properties":{"field":{"type":"string","minLength":1,"pattern":"^[a-zA-Z0-9_.-]+$","description":"Metadata key to evaluate, matched literally. A period is part of the key name, not a path into nested metadata."},"operator":{"type":"string","enum":["eq","neq"],"description":"Compare the field for equality or inequality"},"value":{"description":"Numeric or boolean value to compare against","type":["number","boolean"]}},"required":["field","operator","value"],"additionalProperties":false},{"type":"object","properties":{"field":{"type":"string","minLength":1,"pattern":"^[a-zA-Z0-9_.-]+$","description":"Metadata key to evaluate, matched literally. A period is part of the key name, not a path into nested metadata."},"operator":{"type":"string","enum":["gt","gte","lt","lte"],"description":"Numeric comparison to apply"},"value":{"type":"number","description":"Numeric value to compare against"}},"required":["field","operator","value"],"additionalProperties":false},{"type":"object","properties":{"field":{"type":"string","minLength":1,"pattern":"^[a-zA-Z0-9_.-]+$","description":"Metadata key to evaluate, matched literally. A period is part of the key name, not a path into nested metadata."},"operator":{"type":"string","enum":["contains","notContains"],"description":"Require or exclude a substring match"},"value":{"type":"string","description":"Substring to look for"},"caseSensitive":{"default":true,"description":"Whether substring matching preserves letter case","type":"boolean"}},"required":["field","operator","value"],"additionalProperties":false},{"type":"object","properties":{"field":{"type":"string","minLength":1,"pattern":"^[a-zA-Z0-9_.-]+$","description":"Metadata key to evaluate, matched literally. A period is part of the key name, not a path into nested metadata."},"operator":{"type":"string","enum":["arrayContains","arrayNotContains"],"description":"Require or exclude an exact array member"},"value":{"type":"string","description":"Array member to look for"}},"required":["field","operator","value"],"additionalProperties":false}]},"FilterExpression":{"description":"A type-safe metadata filter predicate or nested and/or expression. The API validates up to 5 levels of nesting.","anyOf":[{"$ref":"#/components/schemas/FilterPredicate"},{"type":"object","properties":{"operator":{"type":"string","const":"and","description":"Require every nested filter expression to match"},"operands":{"type":"array","minItems":1,"maxItems":200,"items":{"$ref":"#/components/schemas/FilterExpression"},"description":"Filter expressions combined with logical AND"}},"required":["operator","operands"],"additionalProperties":false},{"type":"object","properties":{"operator":{"type":"string","const":"or","description":"Require at least one nested filter expression to match"},"operands":{"type":"array","minItems":1,"maxItems":200,"items":{"$ref":"#/components/schemas/FilterExpression"},"description":"Filter expressions combined with logical OR"}},"required":["operator","operands"],"additionalProperties":false}]},"ValidationErrorResponse":{"type":"object","description":"Body returned when request input fails schema validation","properties":{"success":{"type":"boolean","enum":[false]},"error":{"type":"array","description":"Validation issues","items":{"type":"object","properties":{"message":{"type":"string"},"path":{"type":"array","items":{"oneOf":[{"type":"string"},{"type":"number"}]}}},"required":["message"]}},"data":{"description":"The input that failed validation"}},"required":["success","error"]}}},"info":{"title":"supermemory API","description":"The Memory API for the AI era. OpenAPI operations include x-codeSamples for the official TypeScript and Python SDKs (Mintlify-compatible).","version":"5.0.0"},"security":[{"bearerAuth":[]}],"servers":[{"description":"Production Server","url":"https://api.supermemory.ai"}],"tags":[{"name":"Ingest","description":"Ingest documents, files, URLs, conversations, and other content"},{"name":"Recall (Search)","description":"Semantic recall across your content — supports memories, hybrid, and documents modes"},{"name":"Profiles","description":"Maintained static, dynamic, and custom-bucket profiles scoped by namespace"},{"name":"Content Management","description":"List, get, update, and delete content and memories"},{"name":"Namespaces","description":"List and manage isolated namespaces and their settings"},{"name":"Connectors","description":"Sync external sources such as Google Drive, Notion and GitHub into a namespace"},{"name":"Organization","description":"Read and update organization-wide settings"},{"name":"Feedback","description":"Report bugs, request features, and flag documentation issues"}],"paths":{"/ns/{namespace}/document":{"post":{"operationId":"postNsByNamespaceDocument","description":"Turn text or a supported URL into searchable, evolving memory. Supply a new ID to create a document, or reuse an existing ID to append new information while preserving its history.","responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"description":"Document identifier to poll or retrieve"},"status":{"type":"string","enum":["unknown","queued","extracting","chunking","embedding","indexing","done","failed"],"description":"The document's processing state after this request. queued when new work was queued; otherwise its current state, e.g. done for an unchanged duplicate or failed for a metadata-only update to a failed document."}},"required":["id","status"],"additionalProperties":false}}},"description":"Document accepted for processing"},"400":{"description":"Invalid request parameters","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"402":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Insufficient processing credits"},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Namespace write access denied"},"409":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Namespace merge or filepath conflict"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Server error"}},"summary":"Add document","tags":["Ingest"],"parameters":[{"in":"path","name":"namespace","schema":{"example":"user_alex","type":"string","maxLength":100,"pattern":"^[a-zA-Z0-9_:-]+$"},"required":true,"description":"The isolated namespace. This can be an ID for your user, a project ID, or any other identifier you wish to use to scope documents."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"content":{"type":"string","description":"The content to process. This may be plaintext or a URL to supported rich content.","example":"Supermemory turns unstructured content into evolving memory."},"id":{"description":"An optional caller-defined document ID","type":"string","minLength":1,"maxLength":255,"example":"my-doc-123"},"supportingContext":{"description":"Context used to guide memory extraction within this namespace. Max 1500 characters.","example":"Focus on product decisions, dates, and owners.","type":"string","maxLength":1500},"metadata":{"description":"Arbitrary metadata attached to the document and derived data","example":{"source":"api-docs"},"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"array","items":{"type":"string"}}]}},"group":{"description":"Metadata values that isolate related context within the namespace","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"array","items":{"type":"string"}}]}},"date":{"description":"When the source content is from, in ISO 8601 format","example":"2026-01-15","type":"string"},"taskType":{"description":"Processing pipeline. \"memory\" builds durable learned context; \"superrag\" optimizes the document for retrieval without generating memories.","type":"string","enum":["memory","superrag"]},"dreaming":{"description":"Processing mode. \"dynamic\" (default) groups related documents so memories form from coherent context. \"instant\" processes each document independently right away and bills one extra operation per document.","type":"string","enum":["dynamic","instant"]}},"required":["content"],"additionalProperties":false}}}},"x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\nconst client = new Supermemory(); // reads SUPERMEMORY_API_KEY\n\nconst doc = await client.add(\"user_123\", {\n  content: \"Sarah is being promoted to VP of Product.\",\n  id: \"chat_session_1\",\n  metadata: { type: \"conversation\" },\n  dreaming: \"instant\",\n});\nconsole.log(doc.id, doc.status);"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\ndoc = client.add(\n    \"user_123\",\n    content=\"Sarah is being promoted to VP of Product.\",\n    id=\"chat_session_1\",\n    metadata={\"type\": \"conversation\"},\n    dreaming=\"instant\",\n)\nprint(doc.id, doc.status)"},{"lang":"bash","label":"cURL","source":"curl -X POST \"https://api.supermemory.ai/ns/user_123/document\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"content\": \"Sarah is being promoted to VP of Product.\",\n    \"id\": \"chat_session_1\",\n    \"metadata\": { \"type\": \"conversation\" },\n    \"dreaming\": \"instant\"\n  }'"}]},"delete":{"operationId":"deleteNsByNamespaceDocument","description":"Permanently remove documents and their derived knowledge by document ID or caller-defined ID. Each requested ID is handled independently so successful deletions are preserved when another ID fails.","responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"count":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Number of documents successfully deleted"},"errors":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":255,"example":"my-doc-123","description":"The requested document identifier"},"error":{"type":"string","minLength":1,"description":"Why this document could not be deleted"}},"required":["id","error"],"additionalProperties":false},"description":"Per-document failures; successful deletions are not rolled back"}},"required":["count","errors"],"additionalProperties":false}}},"description":"Document deletion completed"},"400":{"description":"Invalid delete request","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Write access required for this namespace"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Internal server error"}},"summary":"Delete documents","tags":["Content Management"],"parameters":[{"in":"path","name":"namespace","schema":{"example":"user_alex","type":"string","maxLength":100,"pattern":"^[a-zA-Z0-9_:-]+$"},"required":true,"description":"The isolated namespace. This can be an ID for your user, a project ID, or any other identifier you wish to use to scope documents."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"ids":{"minItems":1,"maxItems":100,"type":"array","items":{"type":"string","minLength":1,"maxLength":255,"example":"my-doc-123","description":"A document ID or caller-defined ID"},"description":"Document identifiers to permanently delete from this namespace","example":["my-doc-123"]}},"required":["ids"],"additionalProperties":false}}}},"x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\nconst client = new Supermemory(); // reads SUPERMEMORY_API_KEY\n\nconst res = await client.documents.delete(\"user_123\", {\n  ids: [\"chat_session_1\", \"doc_roadmap\"],\n});\nconsole.log(res.count, res.errors);"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\nres = client.documents.delete(\"user_123\", ids=[\"chat_session_1\", \"doc_roadmap\"])\nprint(res.count, res.errors)"},{"lang":"bash","label":"cURL","source":"curl -X DELETE \"https://api.supermemory.ai/ns/user_123/document\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{ \"ids\": [\"chat_session_1\", \"doc_roadmap\"] }'"}]}},"/ns/{namespace}/document/batch":{"post":{"operationId":"postNsByNamespaceDocumentBatch","description":"Build a knowledge base efficiently by ingesting up to 600 text or URL documents at once. Existing caller-defined IDs append new information using the same semantics as single-document ingestion.","responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"results":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"Document identifier"},"status":{"type":"string","enum":["unknown","queued","extracting","chunking","embedding","indexing","done","failed","error"],"description":"The document's processing state after this request, or error when this item failed"},"error":{"description":"Failure reason","type":"string"},"details":{"description":"Human-readable explanation of the failure","type":"string"},"url":{"description":"URL of the failed item, when it had one","type":"string"}},"required":["id","status"],"additionalProperties":false},"description":"One result per submitted document: accepted documents first, in request order, then failed ones. Match results by id, or by url for a failed item with no id."},"count":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Number of documents accepted"},"failed":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Number of documents that failed"}},"required":["results","count","failed"],"additionalProperties":false}}},"description":"Batch accepted for processing"},"400":{"description":"Invalid request parameters","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"402":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Insufficient processing credits"},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Namespace write access denied"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Server error"}},"summary":"Batch add documents","tags":["Ingest"],"parameters":[{"in":"path","name":"namespace","schema":{"example":"user_alex","type":"string","maxLength":100,"pattern":"^[a-zA-Z0-9_:-]+$"},"required":true,"description":"The isolated namespace. This can be an ID for your user, a project ID, or any other identifier you wish to use to scope documents."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"documents":{"minItems":1,"maxItems":600,"type":"array","items":{"type":"object","properties":{"content":{"type":"string","description":"The content to process. This may be plaintext or a URL to supported rich content.","example":"Supermemory turns unstructured content into evolving memory."},"id":{"description":"An optional caller-defined document ID","type":"string","minLength":1,"maxLength":255,"example":"my-doc-123"},"supportingContext":{"description":"Context used to guide memory extraction within this namespace. Max 1500 characters.","example":"Focus on product decisions, dates, and owners.","type":"string","maxLength":1500},"metadata":{"description":"Arbitrary metadata attached to the document and derived data","example":{"source":"api-docs"},"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"array","items":{"type":"string"}}]}},"group":{"description":"Metadata values that isolate related context within the namespace","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"array","items":{"type":"string"}}]}},"date":{"description":"When the source content is from, in ISO 8601 format","example":"2026-01-15","type":"string"}},"required":["content"],"additionalProperties":false},"description":"Documents to ingest or append in one request"},"taskType":{"description":"Processing pipeline. \"memory\" builds durable learned context; \"superrag\" optimizes the document for retrieval without generating memories.","type":"string","enum":["memory","superrag"]},"dreaming":{"description":"Processing mode. \"dynamic\" (default) groups related documents so memories form from coherent context. \"instant\" processes each document independently right away and bills one extra operation per document.","type":"string","enum":["dynamic","instant"]}},"required":["documents"],"additionalProperties":false}}}},"x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\nconst client = new Supermemory(); // reads SUPERMEMORY_API_KEY\n\nconst res = await client.documents.batchAdd(\"user_123\", {\n  documents: [\n    { content: \"Q3 roadmap notes\", id: \"doc_roadmap\" },\n    { content: \"Gift policy for VP promotions\", id: \"doc_gifts\" },\n  ],\n  dreaming: \"instant\",\n});\nconsole.log(res.count, res.failed);"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\nres = client.documents.batch_add(\n    \"user_123\",\n    documents=[\n        {\"content\": \"Q3 roadmap notes\", \"id\": \"doc_roadmap\"},\n        {\"content\": \"Gift policy for VP promotions\", \"id\": \"doc_gifts\"},\n    ],\n    dreaming=\"instant\",\n)\nprint(res.count, res.failed)"},{"lang":"bash","label":"cURL","source":"curl -X POST \"https://api.supermemory.ai/ns/user_123/document/batch\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"documents\": [\n      { \"content\": \"Q3 roadmap notes\", \"id\": \"doc_roadmap\" },\n      { \"content\": \"Gift policy for VP promotions\", \"id\": \"doc_gifts\" }\n    ],\n    \"dreaming\": \"instant\"\n  }'"}]}},"/ns/{namespace}/document/{id}":{"get":{"operationId":"getNsByNamespaceDocumentById","description":"Retrieve a document's canonical content, metadata, and processing state by document ID or caller-defined ID. Optionally include its source chunks, derived memories, or both in the same response.","responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"Stable document identifier","example":"doc_xyz789"},"title":{"description":"Extracted or caller-provided document title","example":"API Rate Limiting Policy","type":["string","null"]},"type":{"type":"string","description":"Detected source or content type","example":"text"},"summary":{"description":"Generated summary of the document, when available","type":["string","null"]},"content":{"description":"Canonical extracted text used for processing and recall","example":"Our API rate limits are 100 req/min on free and 1000 on pro.","type":["string","null"]},"metadata":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"Caller metadata with internal fields removed","example":{"source":"api-docs"}},"system":{"type":"object","properties":{"status":{"type":"string","enum":["unknown","queued","extracting","chunking","embedding","indexing","done","failed"],"description":"Current extraction and memory-processing status"},"dreamingStatus":{"type":"string","enum":["dreaming","done"],"description":"Memory generation state, separate from status. dreaming while memories for the latest content are queued, being generated, or waiting for a retry after a failure; done once they are generated or when none are needed. Under dynamic dreaming, status can reach done minutes before dreamingStatus does."},"createdAt":{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$","description":"ISO 8601 timestamp when the document was created"},"updatedAt":{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$","description":"ISO 8601 timestamp of the latest document update"}},"required":["status","dreamingStatus","createdAt","updatedAt"],"description":"Processing status, lifecycle timestamps, and storage path maintained by Supermemory"},"chunks":{"description":"Ordered document chunks; included only when requested","type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"Stable chunk identifier"},"position":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"Zero-based order within the document"},"content":{"type":"string","description":"Chunk text used for retrieval"},"type":{"type":"string","description":"Chunk content type"},"metadata":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"Chunk metadata; empty object when none"},"system":{"type":"object","properties":{"createdAt":{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$","description":"ISO 8601 timestamp when the chunk was created"}},"required":["createdAt"],"description":"Lifecycle timestamps maintained by Supermemory"}},"required":["id","position","content","type","metadata","system"],"description":"A chunk of source content belonging to a document"}},"memories":{"description":"Memories derived from the document; included only when requested","type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"Stable memory identifier"},"memory":{"type":"string","description":"Learned fact or context extracted from the document"},"metadata":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"Memory metadata, including temporal context; empty object when none"},"isStatic":{"type":"boolean","description":"Whether the memory belongs to the stable profile section"},"isInference":{"type":"boolean","description":"Whether the memory was inferred rather than explicitly stated"},"isLatest":{"type":"boolean","description":"Whether this is the newest version in its memory chain"},"isForgotten":{"type":"boolean","description":"Whether this memory has been excluded from normal recall"},"version":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"Version number within the memory chain"},"system":{"type":"object","properties":{"createdAt":{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$","description":"ISO 8601 timestamp when this memory version was created"},"updatedAt":{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$","description":"ISO 8601 timestamp of the latest update to this version"}},"required":["createdAt","updatedAt"],"description":"Lifecycle timestamps maintained by Supermemory"}},"required":["id","memory","metadata","isStatic","isInference","isLatest","isForgotten","version","system"],"description":"A memory formed from documents in this namespace"}}},"required":["id","title","type","summary","content","metadata","system"],"description":"Namespace-scoped document. Included keys are omitted unless requested and are empty arrays when requested without results."}}},"description":"Document retrieved successfully"},"400":{"description":"Invalid request","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Namespace access denied"},"404":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Document not found"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Internal server error"}},"summary":"Get document","tags":["Content Management"],"parameters":[{"in":"path","name":"namespace","schema":{"example":"user_alex","type":"string","maxLength":100,"pattern":"^[a-zA-Z0-9_:-]+$"},"required":true,"description":"The isolated namespace. This can be an ID for your user, a project ID, or any other identifier you wish to use to scope documents."},{"in":"path","name":"id","schema":{"type":"string","minLength":1,"maxLength":255,"example":"my-doc-123"},"required":true,"description":"The public document ID"},{"in":"query","name":"include","schema":{"type":"array","items":{"type":"string","enum":["chunks","memories"]},"style":"form","explode":false},"description":"Comma-separated child resources to include: chunks, memories, or both."}],"x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\nconst client = new Supermemory(); // reads SUPERMEMORY_API_KEY\n\nconst doc = await client.documents.get(\"user_123\", \"doc_abc123\", {\n  include: [\"chunks\", \"memories\"],\n});\nconsole.log(doc.system.status, doc.chunks?.length, doc.memories?.length);"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\ndoc = client.documents.get(\"user_123\", \"doc_abc123\", include=[\"chunks\", \"memories\"])\nprint(doc.system.status, len(doc.chunks or []), len(doc.memories or []))"},{"lang":"bash","label":"cURL","source":"curl \"https://api.supermemory.ai/ns/user_123/document/doc_abc123?include=chunks,memories\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\""}]},"patch":{"operationId":"patchNsByNamespaceDocumentById","description":"Refresh an existing document without changing its stable ID. Supplied content replaces the canonical content and is reprocessed; omitted fields remain unchanged.","responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"description":"Document identifier to poll or retrieve"},"status":{"type":"string","enum":["unknown","queued","extracting","chunking","embedding","indexing","done","failed"],"description":"The document's processing state after this request. queued when new work was queued; otherwise its current state, e.g. done for an unchanged duplicate or failed for a metadata-only update to a failed document."}},"required":["id","status"],"additionalProperties":false}}},"description":"Document updated successfully"},"400":{"description":"Invalid request parameters","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"402":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Insufficient processing credits"},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Namespace write access denied"},"404":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Document not found in this namespace"},"409":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Namespace merge or filepath conflict"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Server error"}},"summary":"Update document","tags":["Ingest"],"parameters":[{"in":"path","name":"namespace","schema":{"example":"user_alex","type":"string","maxLength":100,"pattern":"^[a-zA-Z0-9_:-]+$"},"required":true,"description":"The isolated namespace. This can be an ID for your user, a project ID, or any other identifier you wish to use to scope documents."},{"in":"path","name":"id","schema":{"type":"string","minLength":1,"maxLength":255,"example":"my-doc-123"},"required":true,"description":"The public document ID"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"content":{"type":"string","description":"The content to process. This may be plaintext or a URL to supported rich content.","example":"Supermemory turns unstructured content into evolving memory."},"supportingContext":{"description":"Context used to guide memory extraction within this namespace. Max 1500 characters.","example":"Focus on product decisions, dates, and owners.","type":"string","maxLength":1500},"metadata":{"description":"Arbitrary metadata attached to the document and derived data","example":{"source":"api-docs"},"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"array","items":{"type":"string"}}]}},"group":{"description":"Metadata values that isolate related context within the namespace","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"array","items":{"type":"string"}}]}},"date":{"description":"When the source content is from, in ISO 8601 format","example":"2026-01-15","type":"string"},"taskType":{"description":"Processing pipeline. \"memory\" builds durable learned context; \"superrag\" optimizes the document for retrieval without generating memories.","type":"string","enum":["memory","superrag"]},"dreaming":{"description":"Processing mode. \"dynamic\" (default) groups related documents so memories form from coherent context. \"instant\" processes each document independently right away and bills one extra operation per document.","type":"string","enum":["dynamic","instant"]}},"additionalProperties":false}}}},"x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\nconst client = new Supermemory(); // reads SUPERMEMORY_API_KEY\n\nconst updated = await client.documents.update(\"user_123\", \"chat_session_1\", {\n  content: \"Updated notes: Sarah is now VP of Product.\",\n  metadata: { type: \"conversation\" },\n});\nconsole.log(updated.status);"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\nupdated = client.documents.update(\n    \"user_123\",\n    \"chat_session_1\",\n    content=\"Updated notes: Sarah is now VP of Product.\",\n    metadata={\"type\": \"conversation\"},\n)\nprint(updated.status)"},{"lang":"bash","label":"cURL","source":"curl -X PATCH \"https://api.supermemory.ai/ns/user_123/document/chat_session_1\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"content\": \"Updated notes: Sarah is now VP of Product.\",\n    \"metadata\": { \"type\": \"conversation\" }\n  }'"}]}},"/ns/{namespace}/document/file":{"post":{"operationId":"postNsByNamespaceDocumentFile","description":"Transform an uploaded file into searchable knowledge and learned memory. The response returns as soon as ingestion is safely queued while extraction and memory formation continue asynchronously.","responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"description":"Document identifier to poll or retrieve"},"status":{"type":"string","enum":["unknown","queued","extracting","chunking","embedding","indexing","done","failed"],"description":"The document's processing state after this request. queued when new work was queued; otherwise its current state, e.g. done for an unchanged duplicate or failed for a metadata-only update to a failed document."}},"required":["id","status"],"additionalProperties":false}}},"description":"File accepted for processing"},"400":{"description":"Invalid file request","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"402":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Insufficient balance or document quota"},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"des