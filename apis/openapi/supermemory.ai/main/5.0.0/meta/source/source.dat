identifier. This can be an ID for your user, a project ID, or any other identifier you wish to use to scope documents and memories."},{"in":"path","name":"id","schema":{"type":"string","minLength":1,"example":"PTzGiUYei7pgzg5buzZHgA"},"required":true,"description":"Connector identifier returned when the connector was created"}],"description":"Start a sync now. Returns 409 while a sync for this connector is already running.","responses":{"202":{"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"Connector identifier"},"status":{"type":"string","const":"queued"}},"required":["id","status"]}}},"description":"Sync queued"},"400":{"description":"Invalid request","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"402":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Plan does not include this provider"},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Namespace access denied"},"404":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Connector not found"},"409":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"A sync is already running"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Internal server error"},"503":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Provider is temporarily unavailable"}},"summary":"Sync connector","tags":["Connectors"],"x-speakeasy-group":"connectors","x-speakeasy-name-override":"sync","x-codeSamples":[{"lang":"typescript","lab