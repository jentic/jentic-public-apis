:"Update connector","tags":["Connectors"],"x-speakeasy-group":"connectors","x-speakeasy-name-override":"update","x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\nconst client = new Supermemory(); // reads SUPERMEMORY_API_KEY\n\nawait client.connectors.update(\"user_123\", \"conn_abc123\", {\n  documentLimit: 500,\n  selection: { repos: [\"123456789\"] }, // provider-specific selection\n});"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\nclient.connectors.update(\n    \"user_123\",\n    \"conn_abc123\",\n    document_limit=500,\n    selection={\"repos\": [\"123456789\"]},  # provider-specific selection\n)"},{"lang":"bash","label":"cURL","source":"curl -X PATCH \"https://api.supermemory.ai/ns/user_123/connectors/conn_abc123\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{ \"documentLimit\": 500, \"selection\": { \"repos\": [\"123456789\"] } }'"}]},"delete":{"operationId":"deleteNsByNamespaceConnectorsById","parameters":[{"in":"path","name":"namespace","schema":{"example":"user_alex","type":"string","maxLength":100,"pattern":"^[a-zA-Z0-9_:-]+$"},"required":true,"description":"Namespace identifier. This can be an ID for your user, a project ID, or any other identifier you wish to use to scope documents and memories."},{"in":"path","name":"id","schema":{"type":"string","minLength":1,"example":"PTzGiUYei7pgzg5buzZHgA"},"required":true,"description":"Connector identifier returned when the connector was created"},{"in":"query","name":"deleteDocuments","schema":{"type":"boolean"},"description":"Also delete documents this connector imported. Defaults to true."}],"description":"Disconnect a connector and stop its webhooks. Its imported documents are deleted too unless deleteDocuments is false.","responses":{"200":{"content":{"application/json":{"sch