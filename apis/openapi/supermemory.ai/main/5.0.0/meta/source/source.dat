 moveTo: \"project_main\" }\nconst res = await client.namespaces.delete(\"project_old\");\nconsole.log(res.status); // \"deleted\", or \"queued\" when moving"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\n# Move everything into another namespace instead of deleting: add move_to=\"project_main\"\nres = client.namespaces.delete(\"project_old\")\nprint(res.status)  # \"deleted\", or \"queued\" when moving"},{"lang":"bash","label":"cURL","source":"curl -X DELETE \"https://api.supermemory.ai/ns/project_old?moveTo=project_main\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\""}]}},"/organization":{"get":{"operationId":"getOrganization","description":"Read the shared background that guides memory formation across the organization, together with the number of active namespaces.","responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"organizationalContext":{"description":"Shared background that helps Supermemory interpret content consistently across every namespace","type":["string","null"]},"namespaceCount":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Number of namespaces in the organization"}},"required":["organizationalContext","namespaceCount"]}}},"description":"Organization settings retrieved successfully"},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"403":{"description":"The API key cannot access this endpoint or namespace","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Internal server error"}},"summary":"Get organization settings","tags":["Organization"],"x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\n