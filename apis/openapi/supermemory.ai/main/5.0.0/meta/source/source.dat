additionalProperties":{},"description":"Public metadata associated with the related memory"},"system":{"type":"object","properties":{"updatedAt":{"type":"string","description":"ISO 8601 timestamp of the related memory's latest update"}},"required":["updatedAt"],"description":"Lifecycle details for the related memory"},"document":{"description":"Source document; present when include has both related and documents","type":"object","properties":{"id":{"type":"string","description":"Source document identifier"},"title":{"description":"Source document title","type":["string","null"]},"type":{"description":"Detected source or content type","type":["string","null"]},"metadata":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"Public metadata attached to the source document"},"summary":{"description":"Generated summary of the source document","type":["string","null"]},"system":{"type":"object","properties":{"createdAt":{"type":"string","description":"ISO 8601 timestamp when the source document was created"},"updatedAt":{"type":"string","description":"ISO 8601 timestamp of the source document's latest update"}},"required":["createdAt","updatedAt"],"description":"Lifecycle timestamps maintained by Supermemory"}},"required":["id","title","type","metadata","summary","system"]}},"required":["id","relation","memory","metadata","system"]},"description":"Memories connected by extends or derives"}},"required":["parents","children","siblings"]},"document":{"description":"Source document; present when include has documents and one exists","type":"object","properties":{"id":{"type":"string","description":"Source document identifier"},"title":{"description":"Source document title","type":["string","null"]},"type":{"description":"Detected source or content type","type":["string","null"]},"metadata":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"Public metadata attached to the source document"},"summary":{"description":"Generated summary of the source document","type":["string","null"]},"system":{"type":"object","properties":{"createdAt":{"type":"string","description":"ISO 8601 timestamp when the source document was created"},"updatedAt":{"type":"string","description":"ISO 8601 timestamp of the source document's latest update"}},"required":["createdAt","updatedAt"],"description":"Lifecycle timestamps maintained by Supermemory"}},"required":["id","title","type","metadata","summary","system"]}}}},"required":["id","memory","metadata","isStatic","isInference","isLatest","isForgotten","version","system"]}}},"description":"Memory retrieved"},"400":{"description":"Invalid request","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Namespace access denied"},"404":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Memory not found"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Server error"}},"summary":"Get memory","tags":["Content Management"],"parameters":[{"in":"path","name":"namespace","schema":{"example":"user_alex","type":"string","maxLength":100,"pattern":"^[a-zA-Z0-9_:-]+$"},"required":true,"description":"Namespace containing the memories to forget. This can be an ID for your user, a project ID, or any other identifier you wish to use to scope memories."},{"in":"path","name":"id","schema":{"type":"string","minLength":1,"example":"mem_abc123"},"required":true,"description":"Memory identifier"},{"in":"query","name":"include","schema":{"type":"array","items":{"type":"string","enum":["related","documents"]},"style":"form","explode":false},"description":"Comma-separated extras. related: the memory's version history and connected memories. documents: the source document, also attached to each related memory when both are requested."},{"in":"query","name":"relatedLimit","schema":{"default":10,"type":"integer","minimum":1,"maximum":100},"description":"Maximum parents, children and siblings to return, applied to each list separately. Parents and children are earlier and later versions up to three steps away, nearest first; siblings are direct extends or derives links."}],"x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\nconst client = new Supermemory(); // reads SUPERMEMORY_API_KEY\n\nconst memory = await client.memories.get(\"user_123\", \"mem_abc123\", {\n  include: [\"related\", \"documents\"],\n});\nconsole.log(memory.memory, memory.isLatest);"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\nmemory = client.memories.get(\"user_123\", \"mem_abc123\", include=[\"related\", \"documents\"])\nprint(memory.memory, memory.is_latest)"},{"lang":"bash","label":"cURL","source":"curl \"https://api.supermemory.ai/ns/user_123/memories/mem_abc123?include=related,documents\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\""}]}},"/ns/{namespace}/list/documents/memory-counts":{"post":{"operationId":"postNsByNamespaceListDocumentsMemoryCounts","parameters":[{"in":"path","name":"namespace","schema":{"example":"user_alex","type":"string","maxLength":100,"pattern":"^[a-zA-Z0-9_:-]+$"},"required":true,"description":"The isolated namespace. This can be an ID for your user, a project ID, or any other identifier you wish to use to scope documents."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"ids":{"minItems":1,"maxItems":100,"type":"array","items":{"type":"string","minLength":1,"maxLength":255}}},"required":["ids"],"additionalProperties":false}}}},"summary":"Count document memories","description":"Count live memories in this namespace for up to 100 public document IDs. Missing or inaccessible documents are omitted, not reported as zero.","tags":["Content Management"],"responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"counts":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"memoryCount":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["id","memoryCount"]}}},"required":["counts"]}}},"description":"Counts for accessible documents"},"400":{"description":"Invalid request","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"description":"Unauthorized"},"403":{"description":"Namespace access denied"},"500":{"description":"Internal server error"}}}},"/feedback":{"post":{"operationId":"postFeedback","summary":"Send feedback","description":"Report a bug, request a feature or flag a docs problem to the Supermemory team. Built for AI agents: send structured JSON and an engineer picks it up.\n\nAuthentication is optional for requests with a usable client IP. Cross-zone Cloudflare Worker requests and requests without a client IP must provide an API key. With an API key the limit is 3 submissions per organization per UTC day; without one it is 3 per IPv4 address or IPv6 /64, shared with everyone behind that address. Authenticated submissions have a separate 200/day pool; anonymous submissions share a 20/day pool. Pass your API key to get your own quota.","tags":["Feedback"],"security":[{},{"bearerAuth":[]}],"x-codeSamples":[{"lang":"bash","label":"cURL","source":"curl -X POST \"https://api.supermemory.ai/feedback\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"type\": \"bug\",\n    \"title\": \"Search misses documents added in the last minute\",\n    \"description\": \"Documents report status done but do not appear in /v4/search for about a minute.\",\n    \"endpoint\": \"POST /v4/search\",\n    \"client\": \"my-agent/1.0\"\n  }'"}],"responses":{"202":{"description":"Feedback received","content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"Feedback reference","example":"fb_k3m9q2x7wd"},"remaining":{"type":"number","description":"Submissions left for this caller until 00:00 UTC","example":2}},"required":["id","remaining"]}}}},"400":{"description":"Invalid request body","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"description":"An API key is invalid or required for this request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"The API key cannot access this endpoint or namespace","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Daily limit reached. The Retry-After header gives the seconds until it resets.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"502":{"description":"Slack rejected the feedback or delivery could not be confirmed. Only confirmed rejections are refunded; do not automatically retry uncertain deliveries.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"503":{"description":"Feedback is not available on this deployment","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}},"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"type":{"type":"string","enum":["bug","feature_request","docs","other"],"description":"Kind of feedback","example":"bug"},"title":{"type":"string","minLength":1,"maxLength":120,"description":"One-line summary","example":"Search returns no results for documents still in indexing"},"description":{"type":"string","minLength":1,"maxLength":5000,"description":"What happened, with enough detail for an engineer to act on it","example":"Documents added less than a minute ago are missing from /v4/search results even though GET /v3/documents/{id} reports status done."},"endpoint":{"description":"API operation the feedback is about","example":"POST /v4/search","type":"string","maxLength":200},"requestId":{"description":"Request ID of a failing call, if there is one","type":"string","maxLength":200},"expected":{"description":"What you expected to happen","type":"string","maxLength":2000},"actual":{"description":"What actually happened","type":"string","maxLength":2000},"client":{"description":"Agent, tool or SDK sending the feedback","example":"claude-code/2.1, supermemory-sdk-ts/5.0.0","type":"string","maxLength":200},"contactEmail":{"description":"Where to reach you about this feedback","type":"string","maxLength":320,"format":"email","pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"}},"required":["type","title","description"]}}}}}}}}