"description":"Unauthorized"},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Admin access required"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Internal server error"}},"summary":"Update organization settings","tags":["Organization"],"x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\nconst client = new Supermemory(); // reads SUPERMEMORY_API_KEY\n\nawait client.organization.update({\n  organizationalContext: \"Acme sells billing software to dental clinics.\",\n});"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\nclient.organization.update(\n    organizational_context=\"Acme sells billing software to dental clinics.\",\n)"},{"lang":"bash","label":"cURL","source":"curl -X PATCH \"https://api.supermemory.ai/organization\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{ \"organizationalContext\": \"Acme sells billing software to dental clinics.\" }'"}]}},"/ns/{namespace}/memories/{id}":{"get":{"operationId":"getNsByNamespaceMemoriesById","description":"Retrieve one memory by ID. Optionally include its versions (up to three steps away, nearest first), its direct extends and derives links, up to relatedLimit each, and its source document.","responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"Stable memory identifier"},"memory":{"type":"string","description":"Learned fact or context extracted from the document"},"metadata":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"Memory metadata, including temporal context; empty object when none"},"isStatic":{"type":"boolean","description":"Whether the memory belongs to the stable profile section"},"isInference":{"type":"boolean","description":"Whether the memory was inferred rather than explicitly stated"},"isLatest":{"type":"boolean","description":"Whether this is the newest version in its memory chain"},"isForgotten":{"type":"boolean","description":"Whether this memory has been excluded from normal recall"},"version":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"Version number within the memory chain"},"system":{"type":"object","properties":{"createdAt":{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$","description":"ISO 8601 timestamp when this memory version was created"},"updatedAt":{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$","description":"ISO 8601 timestamp of the latest update to this version"}},"required":["createdAt","updatedAt"],"description":"Lifecycle timestamps maintained by Supermemory"},"included":{"description":"Requested extras","type":"object","properties":{"related":{"description":"Present when include has related","type":"object","properties":{"parents":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"Related memory ID"},"relation":{"type":"string","enum":["updates","extends","derives"],"description":"How this memory is connected to the matched memory"},"version":{"description":"Version number within the related memory's history","type":["number","null"]},"memory":{"type":"string","description":"Related learned fact or context"},"metadata":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"Public metadata associated with the related memory"},"system":{"type":"object","properties":{"updatedAt":{"type":"string","description":"ISO 8601 timestamp of the related memory's latest update"}},"required":["updatedAt"],"description":"Lifecycle details for the related memory"},"document":{"description":"Source document; present when include has both related and documents","type":"object","properties":{"id":{"type":"string","description":"Source document identifier"},"title":{"description":"Source document title","type":["string","null"]},"type":{"description":"Detected source or content type","type":["string","null"]},"metadata":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"Public metadata attached to the source document"},"summary":{"description":"Generated summary of the source document","type":["string","null"]},"system":{"type":"object","properties":{"createdAt":{"type":"string","description":"ISO 8601 timestamp when the source document was created"},"updatedAt":{"type":"string","description":"ISO 8601 timestamp of the source document's latest update"}},"required":["createdAt","updatedAt"],"description":"Lifecycle timestamps maintained by Supermemory"}},"required":["id","title","type","metadata","summary","system"]}},"required":["id","relation","memory","metadata","system"]},"description":"Earlier versions this memory updates"},"children":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"Related memory ID"},"relation":{"type":"string","enum":["updates","extends","derives"],"description":"How this memory is connected to the matched memory"},"version":{"description":"Version number within the related memory's history","type":["number","null"]},"memory":{"type":"string","description":"Related learned fact or context"},"metada