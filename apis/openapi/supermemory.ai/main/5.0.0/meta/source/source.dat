ecycle timestamps"}},"required":["id","namespace","documentCount","memoryCount","description","system"]},"description":"Namespaces on this page, newest first"},"pagination":{"type":"object","properties":{"currentPage":{"type":"number"},"limit":{"default":10,"type":"number","maximum":1100},"totalItems":{"type":"number"},"totalPages":{"type":"number"}},"required":["currentPage","totalItems","totalPages"],"description":"Pagination metadata","example":{"currentPage":1,"limit":10,"totalItems":100,"totalPages":10}}},"required":["namespaces","pagination"]}}},"description":"Namespaces available to the caller"},"400":{"description":"Invalid request","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"403":{"description":"The API key cannot access this endpoint or namespace","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Internal server error"}},"summary":"List namespaces","tags":["Namespaces"],"parameters":[{"in":"query","name":"page","schema":{"default":1,"type":"integer","minimum":1,"maximum":9007199254740991},"description":"One-based page number"},{"in":"query","name":"limit","schema":{"default":10,"type":"integer","minimum":1,"maximum":100},"description":"Maximum namespaces to return per page"}],"x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\nconst client = new Supermemory(); // reads SUPERMEMORY_API_KEY\n\nconst { namespaces } = await client.namespaces.list({ page: 1, limit: 50 });\nconsole.log(namespaces.map((ns) => ns.namespace));"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\npage = client.namespaces.list(page=1, limit=50)\nprint([ns.namespace for ns in page.namespaces])"},{"lang":"bash","label":"cURL","source":"curl \"https://api.supermemory.ai/namespaces?page=1&limit=50\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\""}]}},"/ns":{"get":{"operationId":"getNs","description":"Discover every namespace available to the caller, including its purpose, document volume, memory count, and lifecycle timestamps.","responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"namespaces":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"Internal identifier for the namespace"},"namespace":{"type":"string","description":"Namespace identifier used in API paths"},"documentCount":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Number of active source documents in the namespace"},"memoryCount":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Number of current, recallable memories in the namespace"},"description":{"description":"Human-readable purpose or scope of the namespace","type":["string","null"]},"system":{"type":"object","properties":{"createdAt":{"type":"string","format":"date-time","description":"ISO 8601 timestamp when the namespace was created"},"updatedAt":{"type":"string","format":"date-time","description":"ISO 8601 timestamp of the latest namespace update"}},"required":["createdAt","updatedAt"],"description":"Namespace lifecycle timestamps"}},"required":["id","namespace","documentCount","memoryCount","description","system"]},"description":"Namespaces on this page, newest first"},"pagination":{"type":"object","properties":{"currentPage":{"type":"number"},"limit":{"default":10,"type":"number","maximum":1100},"totalItems":{"type":"number"},"totalPages":{"type":"number"}},"required":["currentPage","totalItems","totalPages"],"description":"Pagination metadata","example":{"currentPage":1,"limit":10,"totalItems":100,"totalPages":10}}},"required":["namespaces","pagination"]}}},"description":"Namespaces available to the caller"},"400":{"description":"Invalid request","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"403":{"description":"The API key cannot access this endpoint or namespace","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Internal server error"}},"summary":"List namespaces","tags":["Namespaces"],"parameters":[{"in":"query","name":"page","schema":{"default":1,"type":"integer","minimum":1,"maximum":9007199254740991},"description":"One-based page number"},{"in":"query","name":"limit","schema":{"default":10,"type":"integer","minimum":1,"maximum":100},"description":"Maximum namespaces to return per page"}],"x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\nconst client = new Supermemory(); // reads SUPERMEMORY_API_KEY\n\nconst { namespaces, pagination } = await client.namespaces.list({ page: 1, limit: 50 });\nfor (const ns of namespaces) console.log(ns.namespace, ns.documentCount, ns.memoryCount);\nconsole.log(pagination.totalPages);"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\npage = client.namespaces.list(page=1, limit=50)\nfor ns in page.namespaces:\n    print(ns.namespace, ns.document_count, ns.memory_count)\nprint(page.pagination.total_pages)"},{"lang":"bash","label":"cURL","source":"curl \"https://api.supermemory.ai/ns?page=1&limit=50\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\""}]}},"/ns/{namespace}":{"get":{"operationId":"getNsByNamespace","description":"Read the supporting context that helps Supermemory understand content and form better memories inside this namespace.","responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"namespace":{"type":"string","description":"Namespace identifier used in API paths"},"supportingContext":{"description":"Background that helps Supermemory interpret documents and form better memories in this namespace","type":["string","null"]},"system":{"type":"object","properties":{"createdAt":{"type":"string","format":"date-time","description":"ISO 8601 timestamp when the namespace was created"},"updatedAt":{"type":"string","format":"date-time","description":"ISO 8601 timestamp of the latest settings update"}},"required":["createdAt","updatedAt"],"description":"Namespace lifecycle timestamps"}},"required":["namespace","supportingContext","system"]}}},"description":"Namespace settings"},"400":{"description":"Invalid request","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Namespace access denied"},"404":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Namespace not found"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Internal server error"}},"summary":"Get namespace settings","tags":["Namespaces"],"parameters":[{"in":"path","name":"namespace","schema":{"example":"user_alex","type":"string","maxLength":100,"pattern":"^[a-zA-Z0-9_:-]+$"},"required":true,"description":"Namespace identifier. This can be an ID for your user, a project ID, or any other identifier you wish to use to scope documents and memories."}],"x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\nconst client = new Supermemory(); // reads SUPERMEMORY_API_KEY\n\nconst ns = await client.namespaces.get(\"user_123\");\nconsole.log(ns.supportingContext, ns.system.createdAt);"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\nns = client.namespaces.get(\"user_123\")\nprint(ns.supporting_context, ns.system.created_at)"},{"lang":"bash","label":"cURL","source":"curl \"https://api.supermemory.ai/ns/user_123\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\""}]},"patch":{"operationId":"patchNsByNamespace","parameters":[{"in":"path","name":"namespace","schema":{"example":"user_alex","type":"string","maxLength":100,"pattern":"^[a-zA-Z0-9_:-]+$"},"required":true,"description":"Namespace identifier. This can be an ID for your user, a project ID, or any other identifier you wish to use to scope documents and memories."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"supportingContext":{"description":"Background that guides how Supermemory interprets documents and forms memories. Max 1500 characters. Set null to clear it.","example":"This namespace holds Acme Corp support tickets.","anyOf":[{"type":"string","maxLength":1500},{"type":"null"}]}},"additionalProperties":false}}}},"description":"Shape how Supermemory understands an existing namespace by updating the background context used during ingestion and memory formation.","responses":{"200":{"content":{"application/json":{"schema":{"type":"object","properties":{"namespace":{"type":"string","description":"Namespace identifier used in API paths"},"supportingContext":{"description":"Background that helps Supermemory interpret documents and form better memories in this namespace","type":["string","null"]},"system":{"type":"object","properties":{"createdAt":{"type":"string","format":"date-time","description":"ISO 8601 timestamp when the namespace was created"},"updatedAt":{"type":"string","format":"date-time","description":"ISO 8601 timestamp of the latest settings update"}},"required":["createdAt","updatedAt"],"description":"Namespace lifecycle timestamps"}},"required":["namespace","supportingContext","system"]}}},"description":"Updated namespace settings"},"400":{"description":"Invalid namespace settings","content":{"application/json":{"schema":{"oneOf":[{"$ref":"#/components/schemas/ErrorResponse"},{"$ref":"#/components/schemas/ValidationErrorResponse"}]}}}},"401":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Unauthorized"},"403":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Write access required"},"404":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Namespace not found"},"500":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}},"description":"Internal server error"}},"summary":"Update namespace settings","tags":["Namespaces"],"x-codeSamples":[{"lang":"typescript","label":"TypeScript SDK","source":"import { Supermemory } from \"supermemory\";\n\nconst client = new Supermemory(); // reads SUPERMEMORY_API_KEY\n\nawait client.namespaces.update(\"user_123\", {\n  supportingContext: \"A paying customer on the Pro plan; prefers concise answers.\",\n});"},{"lang":"python","label":"Python SDK","source":"from supermemory import Supermemory\n\nclient = Supermemory()  # reads SUPERMEMORY_API_KEY\n\nclient.namespaces.update(\n    \"user_123\",\n    supporting_context=\"A paying customer on the Pro plan; prefers concise answers.\",\n)"},{"lang":"bash","label":"cURL","source":"curl -X PATCH \"https://api.supermemory.ai/ns/user_123\" \\\n  -H \"Authorization: Bearer $SUPERMEMORY_API_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{ \"supportingContext\": \"A paying customer on the Pro plan; prefers concise answers.\" }'"}]},"delete":{"operationId":"deleteNsByNamespace","description":"Retire a namespace by permanently deleting its content, or preserve that knowledge by moving everything into another namespace first. Moves are queued and complete asynchronously.","responses":{"200":{"content":{"application/json":{"schema":{"oneOf":[{"type":"object","properties":{"status":{"type":"string","const":"deleted","description":"The namespace and its content are gone"},"namespace":{"type":"string","description":"Deleted namespace identifier"},"deletedDocumentsCount":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Number of documents permanently removed"},"deletedMemoriesCount":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Number of memories permanently removed"}},"required":["status","namespace","deletedDocumentsCount","deletedMemoriesCount"]},{"type":"object","properties":{"status":{"type":"string","const":"queued","description":"The move continues asynchronously after this response"},"operationId":{"type":"string","description":"Identifier used to trace the asynchronous move operation"},"namespace":{"type":"string","description":"Source namespace being removed"},"moveTo":{"type":"string","description":"Destination namespace receiving the content"}},"required":["status","operationId","namespace","moveTo"]}]}}},"description":"Namespace permanently deleted (status \"deleted\"). A move answers 202 with status \"queued\"."},"202":{"content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","const":"queued","description":"The move continues asynchronously after this response"},"operationId":{"type":"string","description":"Identifier used to trace the asynchronous move operation"},"namespace":{"type":