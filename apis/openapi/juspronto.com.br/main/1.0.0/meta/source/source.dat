{
  "openapi": "3.1.0",
  "info": {
    "title": "Juspronto: superfície pública para agentes (conector MCP e OAuth)",
    "version": "1.0.0",
    "summary": "Servidor MCP autenticado, OAuth 2.1 com PKCE e documentos públicos de descoberta.",
    "description": "Superfície pública do Juspronto para agentes de IA. O Juspronto é um software de gestão jurídica para escritórios de advocacia brasileiros. O acesso de um agente aos dados do escritório existe apenas pelo conector MCP: o advogado entra com o login do Juspronto, escolhe as permissões na tela de autorização e cada chamada fica registrada. Este documento descreve esse transporte (um endpoint MCP, autenticado), o OAuth que o autoriza e os documentos públicos de descoberta. Não cataloga as APIs internas do aplicativo logado, que não são contrato público. Testado como cliente com o Claude e, em 04/10/2026, com o ChatGPT Pro, na web. Nada é protocolado no tribunal pelo conector. Política de versão e erros em https://juspronto.com.br/developers; índice para agentes em https://juspronto.com.br/llms.txt.",
    "termsOfService": "https://juspronto.com.br/termos",
    "contact": {
      "name": "Suporte Juspronto",
      "email": "contato@juspronto.com.br",
      "url": "https://juspronto.com.br/contato"
    },
    "license": {
      "name": "Uso do serviço conforme os Termos de uso",
      "url": "https://juspronto.com.br/termos"
    },
    "x-politica-versao": "https://juspronto.com.br/developers#versao"
  },
  "externalDocs": {
    "description": "Juspronto para desenvolvedores",
    "url": "https://juspronto.com.br/developers"
  },
  "servers": [
    {
      "url": "https://juspronto.com.br",
      "description": "Site: documentos públicos de descoberta (esta especificação, catálogo de APIs, server card, llms.txt)."
    },
    {
      "url": "https://api.juspronto.com.br",
      "description": "API: servidor MCP e OAuth do conector."
    }
  ],
  "tags": [
    {
      "name": "MCP",
      "description": "Transporte Streamable HTTP do conector (autenticado)."
    },
    {
      "name": "OAuth",
      "description": "Metadados e endpoints do OAuth 2.1 com PKCE que autoriza o conector."
    },
    {
      "name": "Descoberta",
      "description": "Documentos públicos, sem autenticação, para agentes e scanners."
    }
  ],
  "paths": {
    "/api/mcp": {
      "servers": [
        {
          "url": "https://api.juspronto.com.br",
          "description": "API: servidor MCP e OAuth do conector."
        }
      ],
      "post": {
        "tags": [
          "MCP"
        ],
        "operationId": "chamar_servidor_mcp",
        "summary": "Envia uma mensagem JSON-RPC ao servidor MCP (Streamable HTTP).",
        "description": "Transporte Streamable HTTP do servidor MCP do conector, sem sessão: cada requisição leva UMA mensagem JSON-RPC 2.0 (lote é recusado com 400) e nenhum `Mcp-Session-Id` é emitido. O cliente precisa mandar `Content-Type: application/json` e `Accept: application/json, text/event-stream`, senão recebe 415 ou 406. A resposta a uma requisição vem sempre como `text/event-stream`, com a resposta JSON-RPC no `data` do evento `message`; notificações recebem 202 sem corpo. Autenticação: OAuth 2.1 com PKCE (metadados em /.well-known/oauth-authorization-server), com o mínimo de escopos prazos:read, processos:read, dashboard:read, autos:read; ou, como caminho avançado, uma chave criada por sócio ou gestor no próprio Juspronto. Sem credencial o servidor responde 401 com `WWW-Authenticate`, que aponta os metadados do recurso. As ferramentas se descobrem pelo protocolo: chame `initialize`, depois `tools/list` e `tools/call`. A lista varia com as permissões que a pessoa autorizou; com as quatro marcadas são 32 ferramentas. O servidor também oferece leituras prontas (resources) e comandos (prompts). Com a assinatura do escritório vencida o servidor responde 402. O conector não protocola nada no tribunal.",
        "security": [
          {
            "oauth2": [
              "prazos:read",
              "processos:read",
              "dashboard:read",
              "autos:read"
            ]
          },
          {
            "chave_de_api": []
          }
        ],
        "parameters": [
          {
            "name": "MCP-Protocol-Version",
            "in": "header",
            "required": false,
            "description": "Revisão do protocolo negociada no `initialize`. O servidor atende 2025-11-25, 2025-06-18, 2025-03-26 em streamable-http.",
            "schema": {
              "type": "string",
              "examples": [
                "2025-11-25",
                "2025-06-18",
                "2025-03-26"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Uma mensagem JSON-RPC 2.0. Um array (lote) é recusado com 400.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequisicaoJsonRpc"
              },
              "examples": {
                "initialize": {
                  "summary": "Handshake do protocolo MCP",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 1,
                    "method": "initialize",
                    "params": {
                      "protocolVersion": "2025-11-25",
                      "capabilities": {},
                      "clientInfo": {
                        "name": "agente-exemplo",
                        "version": "1.0.0"
                      }
                    }
                  }
                },
                "listarFerramentas": {
                  "summary": "Listar as ferramentas disponíveis nesta conexão",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 2,
                    "method": "tools/list"
                  }
                },
                "chamarFerramenta": {
                  "summary": "Chamar uma ferramenta de leitura",
                  "value": {
                    "jsonrpc": "2.0",
                    "id": 3,
                    "method": "tools/call",
                    "params": {
                      "name": "agenda",
                      "arguments": {
                        "dias": 7
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resposta JSON-RPC 2.0 em fluxo SSE: o evento `message` traz em `data` um objeto no formato de #/components/schemas/RespostaJsonRpc. Erro de negócio de uma ferramenta vem como `isError: true` dentro do `result`, não como status HTTP.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Fluxo SSE. Cada evento `message` tem o `data` em JSON no formato de RespostaJsonRpc."
                },
                "x-schema-do-evento": {
                  "$ref": "#/components/schemas/RespostaJsonRpc"
                },
                "example": "event: message\ndata: {\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"tools\":[]}}\n\n"
              }
            }
          },
          "202": {
            "description": "Notificação ou resposta de cliente aceita. Sem corpo.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            }
          },
          "400": {
            "description": "Requisição inválida: lote JSON-RPC (recusado antes da autenticação), JSON malformado ou mensagem fora do formato JSON-RPC.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErroJsonRpc"
                    },
                    {
                      "$ref": "#/components/schemas/ErroDaApi"
                    }
                  ]
                },
                "example": {
                  "jsonrpc": "2.0",
                  "error": {
                    "code": -32600,
                    "message": "Lote JSON-RPC não é aceito: envie uma mensagem por requisição."
                  },
                  "id": null
                }
              }
            }
          },
          "401": {
            "description": "Sem credencial, credencial inválida ou expirada, ou sem o escopo autos:read. O `WWW-Authenticate` aponta os metadados do recurso protegido (RFC 9728) e traz `scope` com o mínimo para usar o conector. O corpo não é JSON-RPC: o erro acontece antes de a requisição chegar ao servidor MCP.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "WWW-Authenticate": {
                "$ref": "#/components/headers/WwwAuthenticate"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDaApi"
                },
                "example": {
                  "error": "Token não fornecido. Use Bearer jp_at_… (conector) ou jp_live_… (API key)"
                }
              }
            }
          },
          "402": {
            "description": "A assinatura do escritório não permite a operação (por exemplo, assinatura vencida). É cobrança, não permissão da pessoa.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDeAssinatura"
                }
              }
            }
          },
          "406": {
            "description": "O cliente não aceita os dois formatos: `Accept` precisa listar application/json e text/event-stream.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroJsonRpc"
                }
              }
            }
          },
          "415": {
            "description": "`Content-Type` precisa ser application/json.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroJsonRpc"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições atingido. A espera em segundos vem em `Retry-After`; o teto e a janela vêm em `RateLimit-Policy`. Aguarde antes de repetir: não é falha do servidor.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDaApi"
                },
                "example": {
                  "error": "Muitas requisições. Tente novamente em alguns minutos.",
                  "statusCode": 429
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor. Tente de novo mais tarde.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDaApi"
                },
                "example": {
                  "error": "Erro interno do servidor",
                  "statusCode": 500
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "MCP"
        ],
        "operationId": "abrir_fluxo_de_eventos_mcp",
        "summary": "Abre o fluxo SSE do servidor para o cliente (opcional no protocolo).",
        "description": "Parte opcional do Streamable HTTP: abre um fluxo `text/event-stream` por onde o servidor poderia mandar mensagens por iniciativa própria. O servidor não mantém sessão, então o cliente pode ignorar este método e usar só o POST. Exige `Accept: text/event-stream` (senão 406) e a mesma autenticação do POST.",
        "security": [
          {
            "oauth2": [
              "prazos:read",
              "processos:read",
              "dashboard:read",
              "autos:read"
            ]
          },
          {
            "chave_de_api": []
          }
        ],
        "responses": {
          "200": {
            "description": "Fluxo SSE aberto.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Fluxo SSE."
                }
              }
            }
          },
          "401": {
            "description": "Sem credencial ou credencial inválida. Mesmo corpo e mesmo `WWW-Authenticate` do POST.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "WWW-Authenticate": {
                "$ref": "#/components/headers/WwwAuthenticate"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDaApi"
                }
              }
            }
          },
          "402": {
            "description": "A assinatura do escritório não permite a leitura.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDeAssinatura"
                }
              }
            }
          },
          "406": {
            "description": "O cliente não aceita `text/event-stream`.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroJsonRpc"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições atingido. A espera em segundos vem em `Retry-After`; o teto e a janela vêm em `RateLimit-Policy`. Aguarde antes de repetir: não é falha do servidor.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDaApi"
                },
                "example": {
                  "error": "Muitas requisições. Tente novamente em alguns minutos.",
                  "statusCode": 429
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "MCP"
        ],
        "operationId": "encerrar_sessao_mcp",
        "summary": "Encerra a sessão MCP (sem efeito: o servidor não mantém sessão).",
        "description": "Parte opcional do Streamable HTTP. Como o servidor não mantém sessão, não há o que encerrar e a resposta é 200 sem corpo. Mesma autenticação do POST.",
        "security": [
          {
            "oauth2": [
              "prazos:read",
              "processos:read",
              "dashboard:read",
              "autos:read"
            ]
          },
          {
            "chave_de_api": []
          }
        ],
        "responses": {
          "200": {
            "description": "Aceito. Sem corpo e sem efeito.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            }
          },
          "401": {
            "description": "Sem credencial ou credencial inválida. Mesmo corpo e mesmo `WWW-Authenticate` do POST.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "WWW-Authenticate": {
                "$ref": "#/components/headers/WwwAuthenticate"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDaApi"
                }
              }
            }
          },
          "402": {
            "description": "A assinatura do escritório não permite a operação.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDeAssinatura"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições atingido. A espera em segundos vem em `Retry-After`; o teto e a janela vêm em `RateLimit-Policy`. Aguarde antes de repetir: não é falha do servidor.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDaApi"
                },
                "example": {
                  "error": "Muitas requisições. Tente novamente em alguns minutos.",
                  "statusCode": 429
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/oauth-protected-resource": {
      "servers": [
        {
          "url": "https://juspronto.com.br",
          "description": "Espelho idêntico no site, para quem procura no domínio do produto."
        },
        {
          "url": "https://api.juspronto.com.br",
          "description": "Origem canônica, a que o WWW-Authenticate do servidor MCP aponta."
        }
      ],
      "get": {
        "tags": [
          "OAuth",
          "Descoberta"
        ],
        "operationId": "obter_recurso_protegido",
        "summary": "Metadados do recurso protegido (RFC 9728).",
        "description": "Descreve o recurso /api/mcp: onde está o servidor de autorização, os escopos que o conector concede (9) e o método de envio do token. Público, sem autenticação.",
        "security": [],
        "responses": {
          "200": {
            "description": "Documento RFC 9728.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadadosRecursoProtegido"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/oauth-protected-resource/api/mcp": {
      "servers": [
        {
          "url": "https://juspronto.com.br",
          "description": "Espelho idêntico no site, para quem procura no domínio do produto."
        },
        {
          "url": "https://api.juspronto.com.br",
          "description": "Origem canônica, a que o WWW-Authenticate do servidor MCP aponta."
        }
      ],
      "get": {
        "tags": [
          "OAuth",
          "Descoberta"
        ],
        "operationId": "obter_recurso_protegido_do_mcp",
        "summary": "Metadados do recurso protegido, com o sufixo do caminho (RFC 9728 §3.1).",
        "description": "O mesmo documento do endereço raiz, na forma que insere o caminho do recurso (/api/mcp) depois de .well-known. É o endereço que o `WWW-Authenticate` do servidor MCP anuncia.",
        "security": [],
        "responses": {
          "200": {
            "description": "Documento RFC 9728.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadadosRecursoProtegido"
                }
              }
            }
          }
        }
      }
    },
