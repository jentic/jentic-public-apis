      ],
      "get": {
        "tags": [
          "OAuth",
          "Descoberta"
        ],
        "operationId": "obter_configuracao_openid",
        "summary": "Configuração OpenID Connect do servidor de autorização (OIDC Discovery 1.0).",
        "description": "O mesmo servidor de autorização descrito no vocabulário do OpenID Connect: traz tudo do metadado RFC 8414, o `userinfo_endpoint` e os campos que o Discovery exige. O servidor NÃO emite ID Token: `response_types_supported` é só `code` e o `jwks_uri` publica um conjunto vazio de chaves. Quem é a pessoa se lê no endereço userinfo. Só a API publica este documento. Público, sem autenticação.",
        "security": [],
        "responses": {
          "200": {
            "description": "Documento OpenID Connect Discovery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfiguracaoOpenId"
                }
              }
            }
          }
        }
      }
    },
