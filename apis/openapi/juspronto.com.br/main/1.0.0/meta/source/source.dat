  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "OAuth 2.1 com PKCE S256, cliente público (sem segredo) e consentimento da pessoa na tela de autorização do Juspronto. O cliente se registra sozinho em /api/mcp-oauth/register (RFC 7591). Os primeiros 9 escopos abaixo são os que o conector concede, os mesmos de `scopes_supported` nos metadados do recurso protegido (RFC 9728). O mínimo para usar o conector é prazos:read, processos:read, dashboard:read, autos:read. Além deles, `openid` e `email` identificam a pessoa no endereço userinfo e não dão permissão nenhuma sobre o escritório. O escopo `escrita:externa`, que existe na plataforma, só uma chave criada à mão recebe: nenhuma conexão por OAuth o concede, e por isso não está nesta lista.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.juspronto.com.br/api/mcp-oauth/authorize",
            "tokenUrl": "https://api.juspronto.com.br/api/mcp-oauth/token",
            "refreshUrl": "https://api.juspronto.com.br/api/mcp-oauth/token",
            "scopes": {
              "prazos:read": "Consultar os prazos do escritório, inclusive os atrasados.",
              "processos:read": "Consultar processos, andamentos e publicações.",
              "dashboard:read": "Consultar a agenda e as leituras prontas do dia (prazos em aberto, audiências, reuniões).",
              "autos:read": "Buscar e ler os autos já importados, com a folha de origem. Exigido em toda conexão ao endpoint MCP.",
              "autos:write": "Pedir a leitura dos autos no tribunal e gravar o resumo do processo para a equipe.",
              "autos:analisar": "Pedir a análise dos autos no servidor do Juspronto, com cada citação conferida na página.",
              "minutas:write": "Salvar e atualizar minutas pendentes, para o advogado revisar e aprovar no Juspronto. Nada é protocolado.",
              "escrita:interna": "Criar e editar prazos, compromissos, tarefas, clientes e processos no escritório. O que foi escrito pode ser desfeito por 24 horas.",
              "prazos:write": "Criar e cumprir prazos.",
              "openid": "Identificar quem conectou: o endereço userinfo devolve um identificador opaco e estável da pessoa. Não dá acesso a dado nenhum do escritório.",
              "email": "Receber, no endereço userinfo, o e-mail da pessoa e se ele foi confirmado. Não dá acesso a dado nenhum do escritório."
            }
          }
        }
      },
      "chave_de_api": {
        "type": "http",
        "scheme": "bearer",
        "description": "Caminho avançado, que não testamos com clientes de terceiros: uma chave de API criada por sócio ou gestor em Configurações, aba API keys, dentro do Juspronto, enviada como Bearer. Consulta e lê os autos, mas não escreve. Não há criação por API: a chave nasce na tela, com a pessoa logada. O caminho recomendado é o OAuth."
      }
    },
    "headers": {
      "RateLimitLimit": {
        "description": "Teto de requisições da janela atual (RateLimit-Limit).",
        "schema": {
          "type": "integer",
          "examples": [
            300
          ]
        }
      },
      "RateLimitRemaining": {
        "description": "Requisições que ainda cabem na janela atual (RateLimit-Remaining).",
        "schema": {
          "type": "integer",
          "examples": [
            298
          ]
        }
      },
      "RateLimitReset": {
        "description": "Segundos até a janela atual reiniciar (RateLimit-Reset).",
        "schema": {
          "type": "integer",
          "examples": [
            636
          ]
        }
      },
      "RateLimitPolicy": {
        "description": "Política da janela, no formato \"<teto>;w=<segundos>\" (RateLimit-Policy).",
        "schema": {
          "type": "string",
          "examples": [
            "300;w=900"
          ]
        }
      },
      "RetryAfter": {
        "description": "Segundos a esperar antes de repetir a requisição, nas respostas 429.",
        "schema": {
          "type": "integer",
          "examples": [
            636
          ]
        }
      },
      "WwwAuthenticate": {
        "description": "Desafio Bearer (RFC 6750) com `resource_metadata` apontando os metadados do recurso protegido (https://api.juspronto.com.br/.well-known/oauth-protected-resource/api/mcp) e `scope` com o mínimo para usar o conector.",
        "schema": {
          "type": "string"
        }
      },
      "ApiVersion": {
        "description": "Versão da superfície de descoberta do site: 1. Mudança incompatível sobe o número, e a anterior é descontinuada com Deprecation e Sunset, com no mínimo 90 dias de aviso. Hoje nada está descontinuado.",
        "schema": {
          "type": "string",
          "const": "1"
        }
      },
      "AccessControlAllowOrigin": {
        "description": "Sempre `*`: documento público, que clientes em navegador precisam poder ler.",
        "schema": {
          "type": "string",
          "const": "*"
        }
      },
      "CacheControlPublico": {
        "description": "Documento estável: `public, max-age=3600, s-maxage=86400`.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "RequisicaoJsonRpc": {
        "type": "object",
        "description": "Mensagem JSON-RPC 2.0 do protocolo MCP. Uma por requisição.",
        "required": [
          "jsonrpc",
          "method"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0",
            "description": "Sempre \"2.0\"."
          },
          "id": {
            "type": "integer",
            "description": "Identificador da requisição, devolvido na resposta. Ausente em notificações. O JSON-RPC aceita também texto; o inteiro é a forma mais simples."
          },
          "method": {
            "type": "string",
            "description": "Método do protocolo MCP, por exemplo `initialize`, `notifications/initialized`, `ping`, `tools/list`, `tools/call`, `resources/list`, `resources/read`, `prompts/list` e `prompts/get`.",
            "examples": [
              "initialize",
              "tools/list",
              "tools/call"
            ]
          },
          "params": {
            "type": "object",
            "description": "Parâmetros do método. Em `tools/call`: `name` (a ferramenta) e `arguments` (os argumentos dela, conforme o `inputSchema` que `tools/list` devolve).",
            "additionalProperties": true
          }
        }
      },
      "RespostaJsonRpc": {
        "type": "object",
        "description": "Resposta JSON-RPC 2.0, no `data` do evento SSE `message`.",
        "required": [
          "jsonrpc",
          "id"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "type": "integer",
            "description": "O mesmo identificador da requisição."
          },
          "result": {
            "type": "object",
            "description": "Resultado do método, no formato do protocolo MCP. Em `tools/call`, erro de negócio vem como `isError: true` aqui dentro.",
            "additionalProperties": true
          },
          "error": {
            "$ref": "#/components/schemas/ErroJsonRpcInterno"
          }
        }
      },
      "ErroJsonRpcInterno": {
        "type": "object",
        "description": "Objeto de erro do JSON-RPC 2.0.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "description": "Código do erro JSON-RPC (por exemplo -32600, -32700)."
          },
          "message": {
            "type": "string",
            "description": "Descrição curta do erro."
          },
          "data": {
            "description": "Detalhe opcional."
          }
        }
      },
      "ErroJsonRpc": {
        "type": "object",
        "title": "Erro JSON-RPC do transporte",
        "description": "Corpo dos erros que o transporte MCP devolve (400, 406, 415): um envelope JSON-RPC 2.0 com `id` nulo.",
        "required": [
          "jsonrpc",
          "error"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "type": "null"
          },
          "error": {
            "$ref": "#/components/schemas/ErroJsonRpcInterno"
          }
        }
      },
      "ErroDaApi": {
        "type": "object",
        "title": "Erro da API",
        "description": "Formato dos erros do servidor da API fora dos endpoints OAuth: um texto em `error` e, na maioria dos casos, o status em `statusCode`. Não é problem+json: é o que o servidor devolve. Nunca traz stack trace, caminho de arquivo ou detalhe de infraestrutura.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Mensagem legível, em português."
          },
          "statusCode": {
            "type": "integer",
            "description": "O mesmo código de status HTTP da resposta, quando presente."
          }
        }
      },
      "ErroDeAssinatura": {
        "type": "object",
        "title": "Assinatura necessária",
        "description": "Corpo do 402: a assinatura do escritório não permite a operação.",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Motivo, em português."
          },
          "code": {
            "type": "string",
            "const": "ASSINATURA_NECESSARIA"
          },
          "estado": {
            "type": "string",
            "description": "Estado da assinatura do escritório."
          },
          "podeLer": {
            "type": "boolean",
            "description": "Se o escritório ainda pode consultar (somente leitura)."
          }
        }
      },
      "ErroOAuth": {
        "type": "object",
        "title": "Erro OAuth (RFC 6749)",
        "description": "Corpo dos erros dos endpoints OAuth: um código em `error` e, em geral, uma descrição.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Código do erro OAuth, por exemplo `invalid_request`, `invalid_grant`, `invalid_token`, `invalid_target`, `unsupported_grant_type`, `invalid_client_metadata`, `invalid_redirect_uri` ou `too_many_requests`."
          },
          "error_description": {
            "type": "string",
            "description": "Descrição curta e estável do motivo."
          }
        }
      },
      "Problema": {
        "type": "object",
        "title": "Problema HTTP (RFC 9457)",
        "description": "Corpo `application/problem+json` dos erros dos documentos de descoberta do site (405 e 404). Nunca traz stack trace, caminho de arquivo ou detalhe de infraestrutura.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference",
            "description": "URI que identifica o tipo do problema; aponta a documentação em /developers."
          },
          "title": {
            "type": "string",
            "description": "Resumo curto e estável do problema."
          },
          "status": {
            "type": "integer",
            "description": "O mesmo código de status HTTP da resposta."
          },
          "detail": {
            "type": "string",
            "description": "Explicação legível desta ocorrência."
          },
          "instance": {
            "type": "string",
            "format": "uri-reference",
            "description": "Caminho da requisição que gerou o problema."
          }
        }
      },
      "MetadadosRecursoProtegido": {
        "type": "object",
        "description": "Metadados do recurso protegido (RFC 9728).",
        "required": [
          "resource",
          "authorization_servers",
          "scopes_supported",
          "bearer_methods_supported"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "format": "uri",
            "description": "O recurso protegido: https://api.juspronto.com.br/api/mcp."
          },
          "resource_name": {
            "type": "string",
            "description": "Nome legível do recurso."
          },
          "authorization_servers": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "O servidor de autorização: a API, que publica o metadado RFC 8414."
          },
          "bearer_methods_supported": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Sempre [\"header\"]: o token vai no cabeçalho Authorization."
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "prazos:read",
                "processos:read",
                "dashboard:read",
                "autos:read",
                "autos:write",
                "autos:analisar",
                "minutas:write",
                "escrita:interna",
                "prazos:write"
              ]
            },
            "description": "Os 9 escopos que o conector concede."
          },
          "resource_documentation": {
            "type": "string",
            "format": "uri",
            "description": "Página do conector."
          }
        }
      },
      "MetadadosServidorAutorizacao": {
        "type": "object",
        "description": "Metadados do servidor de autorização (RFC 8414).",
        "required": [
          "issuer",
          "authorization_endpoint",
          "token_endpoint",
          "response_types_supported",
          "code_challenge_methods_supported"
        ],
        "properties": {
          "issuer": {
            "type": "string",
            "format": "uri",
            "description": "O emissor: a API."
          },
          "authorization_endpoint": {
            "type": "string",
            "format": "uri"
          },
          "token_endpoint": {
            "type": "string",
            "format": "uri"
          },
          "registration_endpoint": {
            "type": "string",
            "format": "uri",
            "description": "Registro dinâmico de cliente (RFC 7591)."
          },
          "userinfo_endpoint": {
            "type": "string",
            "format": "uri",
            "description": "OIDC UserInfo: quem é a pessoa por trás do token."
          },
          "response_types_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "grant_types_supported": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code_challenge_methods_supported": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Sempre [\"S256\"]: PKCE S256 é obrigatório."
          },
          "token_endpoint_auth_methods_supported": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Sempre [\"none\"]: cliente público."
          },
          "authorization_response_iss_parameter_supported": {
            "type": "boolean",
            "description": "Sempre true (RFC 9207): toda resposta de autorização que volta ao cliente leva `iss`, igual ao `issuer`."
          },
          "scopes_supported": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Escopos que o servidor de autorização conhece, mais `openid` e `email` no fim. Os que o conector concede são os de `scopes_supported` do recurso protegido, que a especificação lista em `securitySchemes`; `openid` e `email` só identificam a pessoa."
          },
          "service_documentation": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "ConfiguracaoOpenId": {
        "description": "Configuração OpenID Connect Discovery 1.0: tudo do metadado RFC 8414 do servidor de autorização, mais os campos que o Discovery exige. Não há ID Token, e por isso o `jwks_uri` é um conjunto vazio.",
        "allOf": [
          {
            "$ref": "#/components/schemas/MetadadosServidorAutorizacao"
          },
          {
            "type": "object",
            "required": [
              "jwks_uri",
              "subject_types_supported",
              "id_token_signing_alg_values_supported"
            ],
            "properties": {
              "jwks_uri": {
                "type": "string",
                "format": "uri",
                "description": "Conjunto de chaves, sempre vazio: o servidor não assina nada."
              },
              "subject_types_supported": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Sempre [\"public\"]."
              },
              "id_token_signing_alg_values_supported": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Exigido pelo Discovery. Nenhum ID Token é emitido."
              },
              "claims_supported": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "As claims do userinfo: `sub`, `email` e `email_verified`."
              }
            }
          }
        ]
      },
      "DadosDaPessoaConectada": {
        "type": "object",
        "description": "Claims do OIDC UserInfo. `email` e `email_verified` só saem se a conexão pediu o escopo `email`.",
        "required": [
          "sub"
        ],
        "properties": {
          "sub": {
            "type": "string",
            "description": "Identificador opaco e estável da pessoa. Não muda com reconexão, renovação ou troca de e-mail."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "E-mail da pessoa. Só com o escopo `email`."
          },
          "email_verified": {
            "type": "boolean",
            "description": "Verdadeiro só quando o e-mail foi confirmado; sem confirmação, falso. Só com o escopo `email`."
          }
        }
      },
      "RegistroDeClienteRequisicao": {
        "type": "object",
        "required": [
          "redirect_uris"
        ],
        "properties": {
          "redirect_uris": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Endereços de retorno do cliente. Só hosts de uma lista fechada e localhost são aceitos."
          },
          "client_name": {
            "type": "string",
            "maxLength": 120,
            "description": "Nome do cliente, mostrado na tela de consentimento."
          }
        }
      },
      "RegistroDeClienteResposta": {
        "type": "object",
        "required": [
          "client_id",
          "redirect_uris",
          "token_endpoint_auth_method",
          "grant_types",
          "response_types"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "description": "Identificador do cliente."
          },
          "client_name": {
            "type": "string"
          },
          "redirect_uris": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "token_endpoint_auth_method": {
            "type": "string",
            "const": "none"
          },
          "grant_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "response_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TokenRequisicao": {
        "type": "object",
        "required": [
          "grant_type"
        ],
        "properties": {
          "grant_type": {
            "type": "string",
            "enum": [
              "authorization_code",
              "refresh_token"
            ],
            "description": "Qual troca fazer."
          },
          "code": {
            "type": "string",
            "description": "Código recebido no retorno da autorização. Obrigatório em authorization_code."
          },
          "redirect_uri": {
            "type": "string",
            "format": "uri",
            "description": "O mesmo endereço de retorno da autorização. Obrigatório em authorization_code."
          },
          "client_id": {
            "type": "string",
            "description": "Identificador do cliente registrado. Obrigatório em authorization_code."
          },
          "code_verifier": {
            "type": "string",
            "description": "Verificador PKCE original. Obrigatório em authorization_code."
          },
          "refresh_token": {
            "type": "string",
            "description": "Refresh token da conexão. Obrigatório em refresh_token."
          },
          "resource": {
            "type": "string",
            "description": "Recurso para o qual o token vale (RFC 8707). Opcional; se vier, tem de ser o da autorização (https://api.juspronto.com.br/api/mcp)."
          }
        }
      },
      "TokenResposta": {
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in",
          "scope"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Token de acesso opaco, para o cabeçalho Authorization: Bearer."
          },
          "refresh_token": {
            "type": "string",
            "description": "Token de renovação, rotativo."
          },
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "description": "Segundos de validade do token de acesso (1 hora)."
          },
          "scope": {
            "type": "string",
            "description": "Escopos que a conexão realmente recebeu, separados por espaço, com `openid` e `email` quando foram pedidos."
          }
        }
      },
      "StatusDaApi": {
        "type": "object",
        "required": [
          "status",
          "timestamp",
          "service"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "`ok`, `degraded`, `down` ou `desligando`."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "string",
            "description": "Identificador da versão no ar."
          },
          "service": {
            "type": "string"
          },
          "subsystems": {
            "type": "object",
            "description": "Estado de cada subsistema de que a API depende.",
            "additionalProperties": true
          }
        }
      },
      "ServerCard": {
        "type": "object",
        "description": "Server card MCP do conector.",
        "required": [
          "name",
          "title",
          "version",
          "remotes"
        ],
        "properties": {
          "$schema": {
            "type": "string",
            "format": "uri"
          },
          "name": {
            "type": "string",
            "description": "Nome no formato de domínio reverso."
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "websiteUrl": {
            "type": "string",
            "format": "uri"
          },
          "remotes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type",
                "url"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "const": "streamable-http"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "supportedProtocolVersions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "2025-11-25",
                      "2025-06-18",
                      "2025-03-26"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "CatalogoDeApis": {
        "type": "object",
        "description": "Catálogo de APIs no formato linkset (RFC 9264), perfil do RFC 9727.",
        "required": [
          "linkset"
        ],
        "properties": {
          "linkset": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "anchor"
              ],
              "description": "Uma API: o `anchor` é o endereço dela e as demais chaves são relações com os recursos que a descrevem.",
              "properties": {
                "anchor": {
                  "type": "string",
                  "format": "uri"
                },
                "service-desc": {
                  "$ref": "#/components/schemas/AlvoDeLink"
                },
                "service-doc": {
                  "$ref": "#/components/schemas/AlvoDeLink"
                },
                "service-meta": {
                  "$ref": "#/components/schemas/AlvoDeLink"
                },
                "status": {
                  "$ref": "#/components/schemas/AlvoDeLink"
                }
              },
              "additionalProperties": false
            }
          }
        }
      },
      "AlvoDeLink": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "type": "string",
              "format": "uri"
            },
            "type": {
              "type": "string",
              "description": "Media type do recurso apontado."
            },
            "title": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}