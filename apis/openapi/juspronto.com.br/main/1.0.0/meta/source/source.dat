    "/api/mcp-oauth/register": {
      "servers": [
        {
          "url": "https://api.juspronto.com.br",
          "description": "API: servidor MCP e OAuth do conector."
        }
      ],
      "post": {
        "tags": [
          "OAuth"
        ],
        "operationId": "registrar_cliente_oauth",
        "summary": "Registro dinâmico de cliente OAuth (RFC 7591).",
        "description": "Registra um cliente público e devolve o `client_id`. Só aceita endereços de retorno (`redirect_uris`) de uma lista fechada de hosts conhecidos, mais localhost para ferramentas locais; qualquer outro é recusado. Há um teto de registros por endereço por hora (429). Sem autenticação.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistroDeClienteRequisicao"
              },
              "example": {
                "redirect_uris": [
                  "http://localhost:8123/callback"
                ],
                "client_name": "Agente de exemplo"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cliente registrado.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistroDeClienteResposta"
                }
              }
            }
          },
          "400": {
            "description": "Corpo sem `redirect_uris` (`invalid_client_metadata`) ou com endereços de retorno não aceitos (`invalid_redirect_uri`).",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroOAuth"
                },
                "example": {
                  "error": "invalid_client_metadata",
                  "error_description": "redirect_uris é obrigatório"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições atingido. A espera em segundos vem em `Retry-After`; o teto e a janela vêm em `RateLimit-Policy`. Aguarde antes de repetir: não é falha do servidor.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroOAuth"
                },
                "example": {
                  "error": "too_many_requests",
                  "error_description": "Muitos registros de cliente a partir deste endereço. Tente de novo em uma hora."
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp-oauth/authorize": {
      "servers": [
        {
          "url": "https://api.juspronto.com.br",
          "description": "API: servidor MCP e OAuth do conector."
        }
      ],
      "get": {
        "tags": [
          "OAuth"
        ],
        "operationId": "iniciar_autorizacao_oauth",
        "summary": "Início do fluxo de autorização (navegador).",
        "description": "O navegador da pessoa chega aqui vindo do cliente. O servidor valida o par `client_id` e `redirect_uri` e manda a pessoa para a tela de consentimento do Juspronto (/conectar), onde ela entra com o login, confere quem pede o acesso e marca as permissões. O parâmetro `scope` enviado pelo cliente NÃO concede permissão nenhuma: quem escolhe as permissões é a pessoa, na tela. Só `openid` e `email`, se pedidos, ficam registrados na conexão, e apenas habilitam o endereço userinfo. PKCE S256 é obrigatório. Toda resposta que volta ao cliente, de sucesso ou de erro, leva `iss` (RFC 9207). Cliente ou endereço de retorno não registrados nunca redirecionam: respondem 400 com uma página de erro.",
        "security": [],
        "parameters": [
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "description": "Identificador devolvido pelo registro de cliente.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "description": "Endereço de retorno registrado para este cliente.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "description": "Sempre `code`.",
            "schema": {
              "type": "string",
              "enum": [
                "code"
              ]
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "required": true,
            "description": "Desafio PKCE: SHA-256 do `code_verifier` em base64url.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "required": true,
            "description": "Sempre `S256`.",
            "schema": {
              "type": "string",
              "enum": [
                "S256"
              ]
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "Valor opaco devolvido ao cliente no retorno.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "Escopos que o cliente gostaria de receber. Não concede permissão: vale o que a pessoa marcar na tela. `openid` e `email` só habilitam o userinfo.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resource",
            "in": "query",
            "required": false,
            "description": "Recurso para o qual o token vale (RFC 8707). Opcional; o do conector é https://api.juspronto.com.br/api/mcp. Outro valor volta ao cliente como `invalid_target`.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redireciona para a tela de consentimento (https://juspronto.com.br/conectar) ou, em erro de protocolo (`response_type` diferente de `code`, PKCE ausente, `resource` não aceito), para o `redirect_uri` com `?error=`. Nos dois casos o retorno ao cliente leva `iss`.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Location": {
                "description": "Destino do redirecionamento.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetros ausentes, cliente ou endereço de retorno não registrados. Página HTML de erro.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições atingido. A espera em segundos vem em `Retry-After`; o teto e a janela vêm em `RateLimit-Policy`. Aguarde antes de repetir: não é falha do servidor.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDaApi"
                },
                "example": {
                  "error": "Muitas requisições. Tente novamente em alguns minutos.",
                  "statusCode": 429
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp-oauth/token": {
      "servers": [
        {
          "url": "https://api.juspronto.com.br",
          "description": "API: servidor MCP e OAuth do conector."
        }
      ],
      "post": {
        "tags": [
          "OAuth"
        ],
        "operationId": "trocar_codigo_por_token",
        "summary": "Troca o código de autorização por token, ou renova o token.",
        "description": "Dois usos. `grant_type=authorization_code`: troca o código (de uso único, 10 minutos) por um par de tokens, com `code`, `redirect_uri`, `client_id` e `code_verifier` (PKCE S256). `grant_type=refresh_token`: renova com `refresh_token`. O token de acesso é opaco e dura 1 hora; o refresh dura 30 dias e é rotativo: reaproveitar um refresh já usado revoga os tokens da conexão e responde 401. O corpo é `application/x-www-form-urlencoded`, como manda o OAuth. Cliente público, sem segredo.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequisicao"
              },
              "examples": {
                "codigo": {
                  "summary": "Troca do código",
                  "value": {
                    "grant_type": "authorization_code",
                    "code": "CODIGO_RECEBIDO_NO_RETORNO",
                    "redirect_uri": "http://localhost:8123/callback",
                    "client_id": "jpc_EXEMPLO",
                    "code_verifier": "VERIFICADOR_PKCE"
                  }
                },
                "renovacao": {
                  "summary": "Renovação",
                  "value": {
                    "grant_type": "refresh_token",
                    "refresh_token": "REFRESH_RECEBIDO"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Par de tokens.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResposta"
                }
              }
            }
          },
          "400": {
            "description": "Pedido inválido: `invalid_request` (campo ausente), `unsupported_grant_type`, ou `invalid_grant` (código usado, expirado, de outro cliente, PKCE que não confere, ou refresh vencido).",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroOAuth"
                },
                "example": {
                  "error": "unsupported_grant_type"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token já usado: tratado como roubo. Os tokens da conexão foram revogados e é preciso refazer a autorização.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroOAuth"
                },
                "example": {
                  "error": "invalid_grant",
                  "error_description": "refresh_reuso"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições atingido. A espera em segundos vem em `Retry-After`; o teto e a janela vêm em `RateLimit-Policy`. Aguarde antes de repetir: não é falha do servidor.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDaApi"
                },
                "example": {
                  "error": "Muitas requisições. Tente novamente em alguns minutos.",
                  "statusCode": 429
                }
              }
            }
          }
        }
      }
    },
    "/api/mcp-oauth/userinfo": {
      "servers": [
        {
          "url": "https://api.juspronto.com.br",
          "description": "API: servidor MCP e OAuth do conector."
        }
      ],
      "get": {
        "tags": [
          "OAuth"
        ],
        "operationId": "obter_dados_da_pessoa_conectada",
        "summary": "Quem é a pessoa que conectou (OIDC UserInfo).",
        "description": "Devolve o identificador opaco e estável da pessoa (`sub`) e, só se a conexão pediu o escopo `email`, o e-mail e se ele foi confirmado (`email_verified`, falso enquanto não houver confirmação). Autentica com o token de acesso do conector no cabeçalho `Authorization: Bearer`, nunca na URL. Um token sem `openid`, como o das conexões antigas, também recebe 200, só com `sub`. A chave de API criada à mão não tem pessoa por trás e não serve aqui. O POST responde igual. Não dá acesso a dado nenhum do escritório.",
        "security": [
          {
            "oauth2": []
          }
        ],
        "responses": {
          "200": {
            "description": "Os dados da pessoa que o escopo da conexão permite.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Cache-Control": {
                "description": "Sempre `no-store`: a resposta é de uma pessoa e não pode ser guardada.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DadosDaPessoaConectada"
                },
                "example": {
                  "sub": "jpu_0123456789abcdef0123456789abcdef",
                  "email": "pessoa@exemplo.com.br",
                  "email_verified": true
                }
              }
            }
          },
          "401": {
            "description": "Sem o cabeçalho `Authorization: Bearer` (`invalid_request`), ou com um token que não é um token de acesso do conector, expirado ou revogado (`invalid_token`).",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "WWW-Authenticate": {
                "description": "Desafio Bearer (RFC 6750): `Bearer realm=\"juspronto-mcp-oauth\"`, com `error=\"invalid_token\"` quando havia um token e ele não vale. Sem credencial nenhuma, o desafio não leva `error`.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroOAuth"
                },
                "example": {
                  "error": "invalid_request",
                  "error_description": "Authorization: Bearer ausente"
                }
              }
            }
          },
          "429": {
            "description": "Limite de requisições atingido. A espera em segundos vem em `Retry-After`; o teto e a janela vêm em `RateLimit-Policy`. Aguarde antes de repetir: não é falha do servidor.",
            "headers": {
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
              "RateLimit-Remaining": {
                "$ref": "#/components/headers/RateLimitRemaining"
              },
              "RateLimit-Reset": {
                "$ref": "#/components/headers/RateLimitReset"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroDaApi"
                },
                "example": {
                  "error": "Muitas requisições. Tente novamente em alguns minutos.",
                  "statusCode": 429
                }
              }
            }
          }
        }
      }
    },
