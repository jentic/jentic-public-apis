{
  "openapi": "3.0.3",
  "info": {
    "title": "Verdi Flows Webhook External API",
    "version": "1.0.1",
    "description": "Webhook endpoint to receive Solman revision events.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Vantiesp/verdi-flows-webhook-external-api/1.0.1"
  },
  "servers": [
    {
      "url": "https://api.mercadolibre.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/workspace/genai/verdi-flows/webhook/8112f51a-97ca-45a0-b198-05b2365a2a05/external": {
      "post": {
        "operationId": "postVerdiFlowsWebhookExternal",
        "summary": "Receive webhook event",
        "description": "Receives webhook payload containing Solman identifier and revision number.",
        "tags": [
          "VerdiFlowsWebhook"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerdiFlowsWebhookRequest"
              },
              "examples": {
                "webhookExample": {
                  "summary": "Webhook request example",
                  "value": {
                    "solman": "ASUASC2314",
                    "revision": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Webhook received"
          },
          "401": {
            "description": "Unauthorized – Invalid IAP credentials"
          },
          "403": {
            "description": "Authorization failed"
          },
          "404": {
            "description": "Endpoint not found"
          },
          "405": {
            "description": "Method not allowed"
          },
          "504": {
            "description": "Workflow did not respond in time"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VerdiFlowsWebhookRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "solman",
          "revision"
        ],
        "properties": {
          "solman": {
            "type": "string",
            "description": "Solman identifier.",
            "minLength": 1,
            "example": "ASUASC2314"
          },
          "revision": {
            "type": "integer",
            "description": "Revision number.",
            "minimum": 0,
            "example": 1
          }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.mercadolibre.com/oauth/token",
            "tokenUrl": "https://api.mercadolibre.com/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  },
  "security": [
    {
      "oauth2": []
    }
  ]
}
