          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListCoursesRequest"
              },
              "examples": {
                "allCourses": {
                  "summary": "Все курсы организации",
                  "value": {
                    "organization_id": 5,
                    "is_global": false,
                    "pagination": {
                      "page": 1,
                      "page_size": 20
                    }
                  }
                },
                "globalCoursesOnly": {
                  "summary": "Только глобальные курсы",
                  "value": {
                    "organization_id": 0,
                    "is_global": true,
                    "pagination": {
                      "page": 1,
                      "page_size": 10
                    }
                  }
                }
              }
            }
          }
