    "/courses/progress/complete": {
      "post": {
        "tags": [
          "Progress"
        ],
        "summary": "Отметить тему как пройденную",
        "description": "Отметка темы как завершенной для пользователя",
        "operationId": "completeTopicForUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteTopicRequest"
              },
              "example": {
                "user_id": 123,
                "topic_id": 501
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Тема отмечена как завершенная",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseProgressResponse"
                },
                "example": {
                  "status": "in_progress",
                  "progress_percent": 15,
                  "completed_topics": [
                    501,
                    502,
                    503
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
