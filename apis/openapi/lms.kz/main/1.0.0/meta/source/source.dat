    "/courses/topics": {
      "post": {
        "tags": [
          "Topics"
        ],
        "summary": "Создать тему",
        "description": "Создание новой темы/урока в секции (только Admin/Manager)",
        "operationId": "createTopic",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTopicRequest"
              },
              "examples": {
                "videoLesson": {
                  "summary": "Урок с видео (мультиязычный)",
                  "value": {
                    "section_id": 101,
                    "title_ru": "Урок 1: Что такое информационная безопасность?",
                    "title_kz": "Сабақ 1: Ақпараттық қауіпсіздік дегеніміз не?",
                    "title_en": "Lesson 1: What is Information Security?",
                    "title_uz": "Dars 1: Axborot xavfsizligi nima?",
                    "short_description_ru": "Основные понятия и термины",
                    "short_description_kz": "Негізгі ұғымдар мен терминдер",
                    "short_description_en": "Basic concepts and terms",
                    "short_description_uz": "Asosiy tushunchalar va atamalar",
                    "content_ru": "# Информационная безопасность\n\nИнформационная безопасность (ИБ) - это комплекс мер, направленных на защиту информации от несанкционированного доступа...",
                    "content_kz": "# Ақпараттық қауіпсіздік\n\nАқпараттық қауіпсіздік (АҚ) - ақпаратты рұқсатсыз қолжетімділіктен қорғауға бағытталған шаралар кешені...",
                    "content_en": "# Information Security\n\nInformation Security (IS) is a set of measures aimed at protecting information from unauthorized access...",
                    "content_uz": "# Axborot xavfsizligi\n\nAxborot xavfsizligi (AX) - axborotni ruxsatsiz kirishdan himoya qilishga qaratilgan choralar majmui...",
                    "youtube_url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
                    "google_slides_url": "",
                    "is_required": true,
                    "order_index": 1
                  }
                },
                "presentationLesson": {
                  "summary": "Урок с презентацией (только русский)",
                  "value": {
                    "section_id": 101,
                    "title_ru": "Урок 2: Триада ИБ (CIA)",
                    "short_description_ru": "Конфиденциальность, Целостность, Доступность",
                    "content_ru": "# CIA Triad\n\n**Конфиденциальность** - защита от несанкционированного доступа...",
                    "youtube_url": "",
                    "google_slides_url": "https://docs.google.com/presentation/d/1abc123/edit",
                    "is_required": true,
                    "order_index": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Тема успешно создана",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Topic"
                },
                "example": {
                  "id": 501,
                  "section_id": 101,
                  "title_ru": "Урок 1: Что такое информационная безопасность?",
                  "title_kz": "Сабақ 1: Ақпараттық қауіпсіздік дегеніміз не?",
                  "title_en": "Lesson 1: What is Information Security?",
                  "title_uz": "Dars 1: Axborot xavfsizligi nima?",
                  "short_description_ru": "Основные понятия и термины",
                  "short_description_kz": "Негізгі ұғымдар мен терминдер",
                  "short_description_en": "Basic concepts and terms",
                  "short_description_uz": "Asosiy tushunchalar va atamalar",
                  "content_ru": "# Информационная безопасность...",
                  "content_kz": "# Ақпараттық қауіпсіздік...",
                  "content_en": "# Information Security...",
                  "content_uz": "# Axborot xavfsizligi...",
                  "youtube_url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
                  "google_slides_url": "",
                  "is_required": true,
                  "order_index": 1,
                  "created_at": "2024-12-18T11:30:00Z",
                  "updated_at": "2024-12-18T11:30:00Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
