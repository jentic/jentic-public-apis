      "put": {
        "tags": [
          "Courses"
        ],
        "summary": "Обновить курс",
        "description": "Обновление информации о курсе (только Admin/Manager)",
        "operationId": "updateCourse",
        "parameters": [
          {
            "name": "id",
            "in": "path",
