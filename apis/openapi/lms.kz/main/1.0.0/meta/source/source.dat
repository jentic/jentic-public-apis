        "operationId": "getCourseProgress",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "description": "ID пользователя",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 123
            }
          },
          {
            "name": "course_id",
            "in": "query",
            "required": true,
            "description": "ID курса",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 42
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Прогресс пользователя",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseProgressResponse"
                },
                "example": {
                  "status": "in_progress",
                  "progress_percent": 45,
                  "completed_topics": [
                    501,
                    502,
                    503,
                    504,
                    505,
                    506,
                    507,
                    508,
                    509
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
