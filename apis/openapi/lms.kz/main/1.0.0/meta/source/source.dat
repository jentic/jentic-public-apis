    "/courses/{id}": {
      "get": {
        "tags": [
          "Courses"
        ],
        "summary": "Получить курс по ID",
        "description": "Получение детальной информации о курсе со всеми секциями",
        "operationId": "getCourse",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID курса",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 42
            }
          }
        ],
