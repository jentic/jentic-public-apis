  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT токен полученный при авторизации.\nФормат: `Bearer <token>`\n"
      }
    },
    "schemas": {
      "Course": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Уникальный идентификатор курса",
            "example": 42
          },
          "title_ru": {
            "type": "string",
            "maxLength": 500,
            "description": "Название курса на русском",
            "example": "Основы кибербезопасности"
          },
          "title_kz": {
            "type": "string",
            "maxLength": 500,
            "description": "Название курса на казахском",
            "example": "Киберқауіпсіздік негіздері"
          },
          "title_en": {
            "type": "string",
            "maxLength": 500,
            "description": "Название курса на английском",
            "example": "Fundamentals of Cybersecurity"
          },
          "title_uz": {
            "type": "string",
            "maxLength": 500,
            "description": "Название курса на узбекском",
            "example": "Kiberxavfsizlik asoslari"
          },
          "short_description_ru": {
            "type": "string",
            "description": "Краткое описание на русском",
            "example": "Введение в информационную безопасность"
          },
          "short_description_kz": {
            "type": "string",
            "description": "Краткое описание на казахском",
            "example": "Ақпараттық қауіпсіздікке кіріспе"
          },
          "short_description_en": {
            "type": "string",
            "description": "Краткое описание на английском",
            "example": "Introduction to Information Security"
          },
          "short_description_uz": {
            "type": "string",
            "description": "Краткое описание на узбекском",
            "example": "Axborot xavfsizligiga kirish"
          },
          "full_description_ru": {
            "type": "string",
            "description": "Полное описание на русском (Markdown)",
            "example": "Полный курс по основам кибербезопасности включает 5 модулей..."
          },
          "full_description_kz": {
            "type": "string",
            "description": "Полное описание на казахском (Markdown)",
            "example": "Киберқауіпсіздік негіздері бойынша толық курс 5 модульді қамтиды..."
          },
          "full_description_en": {
            "type": "string",
            "description": "Полное описание на английском (Markdown)",
            "example": "Complete course on cybersecurity fundamentals includes 5 modules..."
          },
          "full_description_uz": {
            "type": "string",
            "description": "Полное описание на узбекском (Markdown)",
            "example": "Kiberxavfsizlik asoslari bo'yicha to'liq kurs 5 modulni o'z ichiga oladi..."
          },
          "is_global": {
            "type": "boolean",
            "description": "Глобальный курс (доступен всем организациям).\nТолько Admin может создавать глобальные курсы.\n",
            "example": false
          },
          "organization_id": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "ID организации (null для глобальных курсов)",
            "example": 5
          },
          "created_by_user_id": {
            "type": "integer",
            "format": "int64",
            "description": "ID пользователя создавшего курс",
            "example": 10
          },
          "certification_enabled": {
            "type": "boolean",
            "description": "Выдается ли сертификат после прохождения",
            "example": true
          },
          "passing_score": {
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 100,
            "description": "Минимальный процент правильных ответов для получения сертификата.\nИспользуется для итогового экзамена курса.\n",
            "default": 70,
            "example": 80
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Дата создания",
            "example": "2024-12-18T10:30:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Дата последнего обновления",
            "example": "2024-12-18T10:30:00Z"
          }
        }
      },
      "CourseDetail": {
        "type": "object",
        "properties": {
          "course": {
            "$ref": "#/components/schemas/Course"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "description": "Список секций курса"
          }
        }
      },
