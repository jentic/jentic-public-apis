{
  "openapi": "3.0.3",
  "info": {
    "title": "LMS Aqparattyq Sana - Course Service API",
    "description": "API для управления курсами, секциями, темами и прогрессом обучения.\n\n## Возможности\n- Создание и управление курсами\n- Организация контента в секции и темы\n- Отслеживание прогресса пользователей\n- Назначение курсов учебным группам\n- Поддержка мультиязычности (RU, KZ, EN, UZ)\n\n## Аутентификация\nВсе endpoints требуют JWT токен в заголовке Authorization.\n",
    "version": "1.0.0",
    "contact": {
      "name": "Backend Team",
      "email": "support@lms.kz"
    },
    "license": {
      "name": "Proprietary"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/polpolpol/lms-aqparattyq-sana-course-service-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.lms.kz/api/v1",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Courses",
      "description": "Управление курсами"
    },
    {
      "name": "Sections",
      "description": "Управление секциями курса"
    },
    {
      "name": "Topics",
      "description": "Управление темами/уроками"
    },
    {
      "name": "Progress",
      "description": "Отслеживание прогресса обучения"
    }
  ],
  "paths": {
    "/courses": {
      "post": {
        "tags": [
          "Courses"
        ],
        "summary": "Создать новый курс",
        "description": "Создание курса (только Admin/Manager)",
        "operationId": "createCourse",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCourseRequest"
              },
              "examples": {
                "organizationCourse": {
                  "summary": "Курс для организации (мультиязычный)",
                  "value": {
                    "title_ru": "Основы кибербезопасности",
                    "title_kz": "Киберқауіпсіздік негіздері",
                    "title_en": "Fundamentals of Cybersecurity",
                    "title_uz": "Kiberxavfsizlik asoslari",
                    "short_description_ru": "Введение в информационную безопасность",
                    "short_description_kz": "Ақпараттық қауіпсіздікке кіріспе",
                    "short_description_en": "Introduction to Information Security",
                    "short_description_uz": "Axborot xavfsizligiga kirish",
                    "full_description_ru": "Полный курс по основам кибербезопасности включает 5 модулей: защита данных, сетевая безопасность, криптография, социальная инженерия, реагирование на инциденты.",
                    "full_description_kz": "Киберқауіпсіздік негіздері бойынша толық курс 5 модульді қамтиды: деректерді қорғау, желілік қауіпсіздік, криптография, әлеуметтік инженерия, оқиғаларға жауап беру.",
                    "full_description_en": "Complete course on cybersecurity fundamentals includes 5 modules: data protection, network security, cryptography, social engineering, incident response.",
                    "full_description_uz": "Kiberxavfsizlik asoslari bo'yicha to'liq kurs 5 modulni o'z ichiga oladi: ma'lumotlarni himoya qilish, tarmoq xavfsizligi, kriptografiya, ijtimoiy muhandislik, hodisalarga javob berish.",
                    "is_global": false,
                    "organization_id": 5,
                    "created_by_user_id": 10,
                    "certification_enabled": true,
                    "passing_score": 80
                  }
                },
                "globalCourse": {
                  "summary": "Глобальный курс (только английский)",
                  "value": {
                    "title_en": "Phishing Awareness Training",
                    "short_description_en": "Learn to identify and avoid phishing attacks",
                    "full_description_en": "Comprehensive training on recognizing phishing emails, suspicious links, and social engineering tactics.",
                    "is_global": true,
                    "organization_id": null,
                    "created_by_user_id": 1,
                    "certification_enabled": true,
                    "passing_score": 75
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Курс успешно создан",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Course"
                },
                "example": {
                  "id": 42,
                  "title_ru": "Основы кибербезопасности",
                  "title_kz": "Киберқауіпсіздік негіздері",
                  "title_en": "Fundamentals of Cybersecurity",
                  "title_uz": "Kiberxavfsizlik asoslari",
                  "short_description_ru": "Введение в информационную безопасность",
                  "short_description_kz": "Ақпараттық қауіпсіздікке кіріспе",
                  "short_description_en": "Introduction to Information Security",
                  "short_description_uz": "Axborot xavfsizligiga kirish",
                  "full_description_ru": "Полный курс по основам кибербезопасности включает 5 модулей...",
                  "full_description_kz": "Киберқауіпсіздік негіздері бойынша толық курс 5 модульді қамтиды...",
                  "full_description_en": "Complete course on cybersecurity fundamentals includes 5 modules...",
                  "full_description_uz": "Kiberxavfsizlik asoslari bo'yicha to'liq kurs 5 modulni o'z ichiga oladi...",
                  "is_global": false,
                  "organization_id": 5,
                  "created_by_user_id": 10,
                  "certification_enabled": true,
                  "passing_score": 80,
                  "created_at": "2024-12-18T10:30:00Z",
                  "updated_at": "2024-12-18T10:30:00Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/courses/list": {
      "post": {
        "tags": [
          "Courses"
        ],
        "summary": "Получить список курсов",
        "description": "Получение списка курсов с фильтрацией и пагинацией",
        "operationId": "listCourses",
