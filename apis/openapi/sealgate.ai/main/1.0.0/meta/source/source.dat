                    "server_name": {
                        "type": "string"
                    },
                    "acl_level": {
                        "type": "string"
                    },
                    "risk_level": {
                        "type": ["string", "null"],
                        "description": "Severity: low, medium, high, or critical"
                    },
                    "policy_rule": {
                        "type": ["string", "null"]
                    },
                    "source": {
                        "type": "string",
