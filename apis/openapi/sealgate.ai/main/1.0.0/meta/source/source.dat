                "responses": {
                    "201": {
                        "description": "The created role definition",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RoleDefinition"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "409": {
                        "$ref": "#/components/responses/Conflict"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/v1/access-control/summary": {
            "get": {
                "tags": ["Access Control"],
                "summary": "Access-control summary counts",
                "description": "Counts of roles and enablement overrides for the caller's domain. Requires the admin role.",
                "operationId": "accessControlSummary",
                "responses": {
                    "200": {
                        "description": "Access-control summary",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AccessControlSummary"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    }
                }
            }
        },
        "/api/v1/api-keys/{api_key_param}/status": {
            "parameters": [
                {
                    "name": "api_key_param",
                    "in": "path",
                    "required": true,
                    "description": "The target API key to modify",
                    "schema": {
                        "type": "string"
                    }
                }
            ],
            "patch": {
                "tags": ["API Keys"],
                "summary": "Enable or disable an API key",
                "description": "Set an API key's active status. Requires the admin role.",
