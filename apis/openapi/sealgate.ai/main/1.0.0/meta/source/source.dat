                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": ["id", "rule_id", "name", "phase", "status", "priority", "principal_scope", "resource_scope", "actions", "created_at", "updated_at"]
            },
            "CreatePolicyRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
