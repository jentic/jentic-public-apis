                    "title": {
                        "type": "string"
                    },
                    "headline": {
                        "type": "string"
                    },
                    "summary": {
                        "type": "string"
                    },
                    "legs": {
                        "type": ["object", "null"],
                        "additionalProperties": {
                            "type": "string"
                        },
