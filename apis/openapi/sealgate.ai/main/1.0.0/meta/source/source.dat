                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/v1/api-keys/{api_key_param}/role": {
            "parameters": [
                {
                    "name": "api_key_param",
                    "in": "path",
                    "required": true,
                    "description": "The target API key to modify",
                    "schema": {
                        "type": "string"
                    }
                }
            ],
            "patch": {
                "tags": ["API Keys"],
                "summary": "Change an API key's role",
                "description": "Change an API key's role (admin, user, owner). Requires the admin role.",
                "operationId": "updateApiKeyRole",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateApiKeyRoleRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Updated role (API key returned masked)",
