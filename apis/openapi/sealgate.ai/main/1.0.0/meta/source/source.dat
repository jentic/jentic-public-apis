{
    "openapi": "3.1.0",
    "info": {
        "title": "SealGate Management API",
        "version": "1.0.0",
        "summary": "REST API for managing the SealGate agentic-AI data-leak-prevention platform.",
        "description": "The SealGate Management API is the REST control plane for the SealGate agentic-AI security gateway and data firewall. It lets security, IT, and compliance teams manage MCP servers, sessions, access-control roles, deterministic policy rules, approvals, agents, API keys, and observability data programmatically.\n\n## Authentication\nAll endpoints require an HTTP Bearer credential: send `Authorization: Bearer <your-sealgate-api-key>`, where the token is a SealGate API key (obtained from the SealGate dashboard). This management API key is distinct from the MCP gateway credentials used by AI clients. Requests without a valid, active key receive `401`. A key whose role lacks the required permission receives `403`.\n\n## Versioning and deprecation policy\nThe API is versioned in the URL path: every operation lives under `/api/v1`. Breaking changes (removing a field, changing a type, removing an endpoint) are shipped only under a new path prefix such as `/api/v2`; additive changes (new endpoints, new optional fields) are made in place under `/api/v1`. When an endpoint or field is scheduled for removal it is first marked `deprecated: true` in this specification and announced in the changelog at https://docs.sealgate.ai; deprecated surfaces continue to function for a published sunset window before a new major version drops them.\n\n## Error model\nErrors use standard HTTP status codes with a JSON body. Application errors raised by the API return `{\"detail\": {\"error\": <human-readable message>, \"code\": <machine-readable code>, \"details\": <object or null>}}`. Request-validation failures return `422` with `{\"detail\": [{\"loc\": [...], \"msg\": \"...\", \"type\": \"...\"}]}`. Every non-2xx response documents a typed JSON schema.\n\n## Pagination\nList endpoints are page-based. Pass `page` (1-indexed) and `per_page` query parameters; responses return an envelope with `items`, `total`, `page`, `per_page`, and `total_pages`.",
        "termsOfService": "https://sealgate.ai/terms-of-service",
        "contact": {
            "name": "SealGate",
            "email": "hello@sealgate.ai",
            "url": "https://sealgate.ai"
        },
        "license": {
            "name": "Proprietary",
            "url": "https://sealgate.ai/terms-of-service"
        },
        "x-source-of-truth": {
            "description": "This published spec is a curated, human-reviewed mirror of the SealGate management API. The authoritative, always-current OpenAPI schema is generated live from the backend Pydantic models and served at generatedSpecUrl. Regenerate this mirror from the backend source when the API changes; do not hand-edit it to diverge from the generated schema.",
            "generatedSpecUrl": "https://dashboard.sealgate.ai/api/v1/openapi.json",
            "backendSource": "SealGate backend, src/api/v1/ (routes and Pydantic schemas)"
        }
    },
    "externalDocs": {
        "description": "SealGate product documentation",
        "url": "https://docs.sealgate.ai"
    },
    "servers": [
        {
            "url": "https://dashboard.sealgate.ai",
            "description": "SealGate management API - release"
        },
        {
            "url": "https://demo-dashboard.sealgate.ai",
            "description": "SealGate management API - demo"
        }
    ],
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "tags": [
        {
            "name": "Servers",
            "description": "Manage connected MCP servers and their configuration."
        },
        {
            "name": "Sessions",
            "description": "Inspect agent sessions, tool-call history, and risk analysis."
        },
        {
            "name": "Policies",
            "description": "CEL-based deterministic policy rules for agent tool calls."
        },
        {
            "name": "Access Control",
            "description": "Roles, role assignments, and enablement scoping."
        },
        {
            "name": "API Keys",
            "description": "Enable, disable, and re-role API keys."
        },
        {
            "name": "Approvals",
            "description": "Review and resolve gated (lethal-trifecta and policy) approval requests."
        },
        {
            "name": "Agents",
            "description": "Register and manage AI agents."
        },
        {
            "name": "Observability",
            "description": "Trifecta event summaries and the audit log."
        },
        {
            "name": "System",
            "description": "Service health."
        }
    ],
    "paths": {
        "/api/v1/health": {
            "get": {
                "tags": ["System"],
                "summary": "Service health check",
                "operationId": "getHealth",
                "security": [],
                "responses": {
                    "200": {
                        "description": "Service is healthy",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/servers": {
            "get": {
                "tags": ["Servers"],
                "summary": "List MCP servers",
                "description": "List MCP servers visible to the caller, with pagination and optional name search.",
                "operationId": "listServers",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/PageParam"
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "description": "Items per page",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 200,
                            "default": 50
                        }
                    },
                    {
                        "name": "q",
                        "in": "query",
                        "required": false,
                        "description": "Search by server name or display name",
                        "schema": {
                            "type": "string",
                            "maxLength": 200
                        }
                    },
                    {
                        "name": "my_mcps",
                        "in": "query",
                        "required": false,
                        "description": "When true, hide globally-disabled stdio_tunnel servers with no override for the caller",
                        "schema": {
                            "type": "boolean",
                            "default": false
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of server summaries",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ServerSummaryPage"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            },
            "post": {
                "tags": ["Servers"],
                "summary": "Create an MCP server",
                "description": "Register a new MCP server. Requires the admin role.",
                "operationId": "createServer",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateServerRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The created server",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ServerDetail"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "409": {
                        "$ref": "#/components/responses/Conflict"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/v1/servers/{name}": {
            "parameters": [
                {
                    "name": "name",
                    "in": "path",
                    "required": true,
                    "description": "Server MCP prefix name",
                    "schema": {
                        "type": "string"
                    }
                }
            ],
            "get": {
                "tags": ["Servers"],
                "summary": "Get an MCP server",
                "operationId": "getServer",
                "responses": {
                    "200": {
                        "description": "Server detail",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ServerDetail"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            },
            "put": {
                "tags": ["Servers"],
                "summary": "Update an MCP server",
                "description": "Update an MCP server's configuration. Requires the admin role.",
                "operationId": "updateServer",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateServerRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The updated server",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ServerDetail"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            },
            "delete": {
                "tags": ["Servers"],
                "summary": "Delete an MCP server",
                "description": "Delete an MCP server. Requires the admin role.",
                "operationId": "deleteServer",
                "responses": {
                    "204": {
                        "description": "Server deleted"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            }
        },
        "/api/v1/sessions": {
            "get": {
                "tags": ["Sessions"],
                "summary": "List agent sessions",
                "description": "List agent sessions the caller may see, with pagination, filtering, sorting, and full-text search.",
                "operationId": "listSessions",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/PageParam"
                    },
                    {
                        "$ref": "#/components/parameters/PerPageParam"
                    },
                    {
                        "name": "user_id",
                        "in": "query",
                        "required": false,
                        "description": "Filter by user ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "agent_name",
                        "in": "query",
                        "required": false,
                        "description": "Filter by agent name",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "description": "Filter by session status",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "sort_by",
                        "in": "query",
                        "required": false,
                        "description": "Sort field",
                        "schema": {
                            "type": "string",
                            "enum": ["created_at", "last_activity_at", "duration_ms", "tool_call_count"],
                            "default": "created_at"
                        }
                    },
                    {
                        "name": "sort_order",
                        "in": "query",
                        "required": false,
                        "description": "Sort order",
                        "schema": {
                            "type": "string",
                            "enum": ["asc", "desc"],
                            "default": "desc"
                        }
                    },
                    {
                        "name": "q",
                        "in": "query",
                        "required": false,
                        "description": "Text search over session ID, agent name, user email, and tool names",
                        "schema": {
                            "type": "string",
                            "maxLength": 200
                        }
                    },
                    {
                        "name": "risk",
                        "in": "query",
                        "required": false,
                        "description": "Filter by risk level(s), comma-separated (Low, Medium, High)",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of session summaries",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SessionSummaryPage"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/v1/sessions/{session_id}": {
            "parameters": [
                {
                    "name": "session_id",
                    "in": "path",
                    "required": true,
                    "description": "Session identifier",
                    "schema": {
                        "type": "string"
                    }
                }
            ],
            "get": {
                "tags": ["Sessions"],
                "summary": "Get a session",
                "description": "Fetch a single session with its full tool-call history and risk analysis.",
                "operationId": "getSession",
                "responses": {
                    "200": {
                        "description": "Session detail",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SessionDetail"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            }
        },
        "/api/v1/sessions/{session_id}/end": {
            "parameters": [
                {
                    "name": "session_id",
                    "in": "path",
                    "required": true,
                    "description": "Session identifier",
                    "schema": {
                        "type": "string"
                    }
                }
            ],
            "post": {
                "tags": ["Sessions"],
                "summary": "End a session",
                "description": "Mark an active session as ended.",
                "operationId": "endSession",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EndSessionRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Session ended",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OkResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/v1/policies": {
            "get": {
                "tags": ["Policies"],
                "summary": "List policy rules",
                "description": "List CEL-based policy rules. Requires the admin role.",
                "operationId": "listPolicies",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/PageParam"
                    },
                    {
                        "$ref": "#/components/parameters/PerPageParam"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of policy rules",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PolicyRulePage"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            },
            "post": {
                "tags": ["Policies"],
                "summary": "Create a policy rule",
                "description": "Create a CEL-based policy rule. Requires the admin role.",
                "operationId": "createPolicy",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreatePolicyRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The created policy rule",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PolicyRule"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "409": {
                        "$ref": "#/components/responses/Conflict"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/v1/policies/overview": {
            "get": {
                "tags": ["Policies"],
                "summary": "Policy overview statistics",
                "description": "Aggregate counts of policy rules by status, phase, and action type. Requires the admin role.",
                "operationId": "policyOverview",
                "responses": {
                    "200": {
                        "description": "Policy overview statistics",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PolicyOverviewStats"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    }
                }
            }
        },
        "/api/v1/policies/{rule_id}": {
            "parameters": [
                {
                    "name": "rule_id",
                    "in": "path",
                    "required": true,
                    "description": "Unique policy rule identifier",
                    "schema": {
                        "type": "string"
                    }
                }
            ],
            "delete": {
                "tags": ["Policies"],
                "summary": "Delete a policy rule",
                "description": "Delete a policy rule by its rule_id. Requires the admin role.",
                "operationId": "deletePolicy",
                "responses": {
                    "204": {
                        "description": "Policy rule deleted"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            }
        },
        "/api/v1/access-control/roles": {
            "get": {
                "tags": ["Access Control"],
                "summary": "List roles and assignments",
                "description": "Return role definitions and user-to-role assignments for the caller's domain. Requires the admin role.",
                "operationId": "listRoles",
                "responses": {
                    "200": {
                        "description": "Role definitions and assignments",
                        "content": {
                            "application/json": {
                                "schema": {
