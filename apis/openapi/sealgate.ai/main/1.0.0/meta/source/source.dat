                        "type": ["string", "null"],
                        "description": "CEL filter expression"
                    },
                    "phase": {
                        "type": "string",
                        "default": "pre",
                        "description": "Evaluation phase: pre or post"
                    },
                    "status": {
                        "type": "string",
                        "default": "enabled",
                        "description": "Rule status: enabled, disabled, or tentative"
                    },
                    "priority": {
                        "type": "integer",
                        "default": 0,
                        "description": "Rule priority (higher evaluated first)"
                    },
                    "domain": {
                        "type": ["string", "null"],
                        "description": "Domain scope (null = global)"
                    },
                    "principal_scope": {
                        "$ref": "#/components/schemas/PrincipalScope"
                    },
                    "resource_scope": {
                        "$ref": "#/components/schemas/ResourceScope"
                    },
                    "actions": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PolicyAction"
                        }
                    },
