            "PolicyAction": {
                "type": "object",
                "properties": {
                    "action_type": {
                        "type": "string",
                        "description": "Action type: block, require_approval, allow_override, mark_private, mark_untrusted, mark_write, set_acl, add_tag"
                    },
                    "acl_level": {
                        "type": ["string", "null"],
                        "description": "ACL level for set_acl action"
                    },
                    "tag_key": {
                        "type": ["string", "null"]
                    },
                    "tag_value": {
                        "type": ["string", "null"]
                    },
                    "block_reason": {
                        "type": ["string", "null"]
                    },
                    "approval_reason": {
                        "type": ["string", "null"],
