                    },
                    "approval_channels": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Channels to pin the approval prompt to"
                    },
                    "approval_timeout_s": {
                        "type": ["number", "null"],
                        "description": "How long to hold the call awaiting a decision; null uses the server default"
                    },
                    "approval_on_timeout": {
                        "type": ["string", "null"],
                        "enum": ["deny", "allow", null],
                        "description": "What happens when nobody answers in time; null means deny (fail closed). 'allow' is deprecated and reported as 'deny'"
                    }
                },
                "required": ["action_type"]
            },
            "PolicyRule": {
                "type": "object",
                "description": "A CEL-based policy rule.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Database row ID"
                    },
