                    },
                    "user_email": {
                        "type": "string",
                        "description": "User email address"
                    },
                    "agent_name": {
                        "type": "string",
                        "description": "Name of the AI agent"
                    },
                    "agent_type": {
                        "type": "string",
                        "description": "Type/category of the agent"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Session start timestamp"
                    },
                    "last_activity_at": {
                        "type": ["string", "null"],
                        "format": "date-time",
                        "description": "Timestamp of the last tool call activity"
                    },
                    "duration_ms": {
                        "type": ["integer", "null"],
                        "description": "Total session duration in milliseconds"
                    },
                    "tool_call_count": {
                        "type": "integer",
                        "description": "Number of tool calls in this session"
                    },
                    "status": {
                        "type": "string",
