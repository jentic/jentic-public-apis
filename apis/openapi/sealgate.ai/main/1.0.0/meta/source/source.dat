        "/api/v1/approvals": {
            "get": {
                "tags": ["Approvals"],
                "summary": "List approval requests",
                "description": "List gated approval requests. USER sees their own; ADMIN and OWNER see their domain.",
                "operationId": "listApprovals",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/PageParam"
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "description": "Results per page",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "default": 20
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "description": "Filter by status: pending, approved, denied",
                        "schema": {
                            "type": "string",
                            "enum": ["pending", "approved", "denied"]
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of approval requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApprovalRequestPage"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/v1/approvals/{approval_id}/approve": {
            "parameters": [
                {
                    "name": "approval_id",
                    "in": "path",
                    "required": true,
                    "description": "Approval request ID",
                    "schema": {
                        "type": "integer"
                    }
                }
            ],
            "post": {
                "tags": ["Approvals"],
                "summary": "Approve a gated action",
                "description": "Approve a blocked trifecta or policy action. Requires the admin role.",
                "operationId": "approveRequest",
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ApproveAction"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The approved request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApprovalRequest"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/v1/approvals/{approval_id}/deny": {
            "parameters": [
                {
                    "name": "approval_id",
                    "in": "path",
                    "required": true,
                    "description": "Approval request ID",
                    "schema": {
                        "type": "integer"
                    }
                }
            ],
            "post": {
                "tags": ["Approvals"],
                "summary": "Deny a gated action",
                "description": "Deny a blocked trifecta or policy action. Requires the admin role.",
                "operationId": "denyRequest",
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/DenyAction"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The denied request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApprovalRequest"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/v1/agents": {
            "get": {
                "tags": ["Agents"],
                "summary": "List agents",
                "description": "List registered agents. ADMIN sees domain agents; OWNER sees all. Requires the admin role.",
                "operationId": "listAgents",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/PageParam"
                    },
                    {
                        "$ref": "#/components/parameters/PerPageParam"
                    },
                    {
                        "name": "q",
                        "in": "query",
                        "required": false,
                        "description": "Search by agent name",
                        "schema": {
                            "type": "string",
                            "maxLength": 200
                        }
                    },
                    {
                        "name": "agent_type",
                        "in": "query",
                        "required": false,
                        "description": "Filter by agent type",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "include_archived",
                        "in": "query",
                        "required": false,
                        "description": "Include archived agents (owner only)",
                        "schema": {
                            "type": "boolean",
                            "default": false
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of agent summaries",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AgentSummaryPage"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            },
            "post": {
                "tags": ["Agents"],
                "summary": "Register an agent",
                "description": "Register a new agent. OWNER may target a specific domain. Requires the admin role.",
                "operationId": "createAgent",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateAgentRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "The registered agent",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AgentDetail"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "409": {
                        "$ref": "#/components/responses/Conflict"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/v1/observability/trifecta": {
            "get": {
                "tags": ["Observability"],
                "summary": "Trifecta event summary",
                "description": "Summary counts of lethal-trifecta events within a rolling window. Requires the admin role.",
                "operationId": "getTrifectaSummary",
                "parameters": [
                    {
                        "name": "time_period",
                        "in": "query",
                        "required": false,
                        "description": "Rolling window: 24h, 7d, or 30d",
                        "schema": {
                            "type": "string",
                            "enum": ["24h", "7d", "30d"],
                            "default": "24h"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Trifecta summary",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TrifectaSummary"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    }
                }
            }
        },
        "/api/v1/observability/trifecta/events": {
            "get": {
                "tags": ["Observability"],
                "summary": "List trifecta events",
                "description": "List lethal-trifecta events with pagination and date filters. Requires the admin role.",
                "operationId": "listTrifectaEvents",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/PageParam"
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "description": "Results per page",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "default": 20
                        }
                    },
                    {
                        "name": "created_after",
                        "in": "query",
                        "required": false,
                        "description": "Filter events after this date-time",
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "created_before",
                        "in": "query",
                        "required": false,
                        "description": "Filter events before this date-time",
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of trifecta events",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TrifectaEventPage"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        },
        "/api/v1/observability/audit-log": {
            "get": {
                "tags": ["Observability"],
                "summary": "List audit log entries",
                "description": "List audit-log entries with pagination and filters. Requires the admin role.",
                "operationId": "listAuditLog",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/PageParam"
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "required": false,
                        "description": "Results per page",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "default": 20
                        }
                    },
                    {
                        "name": "actor",
                        "in": "query",
                        "required": false,
                        "description": "Filter by actor user ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "action",
                        "in": "query",
                        "required": false,
                        "description": "Filter by action type",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "resource_type",
                        "in": "query",
                        "required": false,
                        "description": "Filter by resource type",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A page of audit-log entries",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuditEntryPage"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "SealGate API key",
                "description": "SealGate API key sent as `Authorization: Bearer <your-sealgate-api-key>`."
            }
        },
        "parameters": {
            "PageParam": {
                "name": "page",
                "in": "query",
                "required": false,
                "description": "Page number (1-indexed)",
                "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 1
                }
            },
            "PerPageParam": {
                "name": "per_page",
                "in": "query",
                "required": false,
                "description": "Items per page",
                "schema": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 50
                }
            }
        },
        "responses": {
            "BadRequest": {
                "description": "The request was invalid",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorResponse"
                        }
                    }
                }
            },
            "Unauthorized": {
                "description": "Missing or invalid API key",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorResponse"
                        }
                    }
                }
            },
            "Forbidden": {
                "description": "The caller's role is not permitted to perform this action",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorResponse"
                        }
                    }
                }
            },
            "NotFound": {
                "description": "The requested resource was not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorResponse"
                        }
                    }
                }
            },
            "Conflict": {
                "description": "The resource already exists or conflicts with current state",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorResponse"
                        }
                    }
                }
            },
            "ValidationError": {
                "description": "Request validation failed",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/HTTPValidationError"
                        }
                    }
                }
            }
        },
        "schemas": {
            "ErrorDetail": {
                "type": "object",
                "description": "Application error body carried under `detail`.",
                "properties": {
                    "error": {
                        "type": "string",
                        "description": "Human-readable error message"
                    },
                    "code": {
                        "type": "string",
                        "description": "Machine-readable error code"
                    },
                    "details": {
                        "type": ["object", "null"],
                        "description": "Additional error details",
                        "additionalProperties": true
                    }
                },
                "required": ["error", "code"]
            },
            "ErrorResponse": {
                "type": "object",
                "description": "Standard error envelope returned on 4xx and 5xx responses.",
                "properties": {
                    "detail": {
                        "$ref": "#/components/schemas/ErrorDetail"
                    }
                },
                "required": ["detail"]
            },
            "ValidationError": {
                "type": "object",
                "description": "A single request-validation error.",
                "properties": {
                    "loc": {
                        "type": "array",
                        "items": {
                            "type": ["string", "integer"]
                        },
                        "description": "Location of the invalid field"
                    },
                    "msg": {
                        "type": "string",
                        "description": "Validation error message"
                    },
                    "type": {
                        "type": "string",
                        "description": "Validation error type"
                    }
                },
                "required": ["loc", "msg", "type"]
            },
            "HTTPValidationError": {
                "type": "object",
                "description": "Body returned for a 422 request-validation failure.",
                "properties": {
                    "detail": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        }
                    }
                }
            },
            "HealthResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "description": "Service status",
                        "examples": ["ok"]
                    }
                },
                "required": ["status"]
            },
            "OkResponse": {
                "type": "object",
                "properties": {
                    "ok": {
                        "type": "boolean",
                        "description": "Whether the operation succeeded"
                    }
                },
                "required": ["ok"]
            },
            "ServerRuntimeHealth": {
                "type": "object",
                "description": "Live runtime health of a mounted MCP server.",
                "properties": {
                    "state": {
                        "type": "string",
                        "enum": ["ok", "starting", "degraded"],
                        "description": "Runtime state"
                    },
                    "error_kind": {
                        "type": ["string", "null"],
                        "enum": ["auth_required", "forbidden", "rate_limited", "upstream_error", "http_error", "timeout", "unreachable", "mount_failed", "no_tools", "unknown", null],
                        "description": "Discriminating reason when state is degraded; null otherwise"
                    },
                    "reason": {
                        "type": ["string", "null"],
                        "description": "Short user-facing label derived from error_kind"
                    },
                    "detail": {
                        "type": ["string", "null"],
                        "description": "Longer error message tail"
                    },
                    "last_check_at": {
                        "type": ["string", "null"],
                        "format": "date-time"
                    },
                    "consecutive_failures": {
                        "type": "integer",
                        "default": 0
                    },
                    "next_check_at": {
                        "type": ["string", "null"],
                        "format": "date-time"
                    }
                },
                "required": ["state"]
            },
            "ServerElement": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Element ID"
                    },
                    "name": {
                        "type": "string",
                        "description": "Element name (permission_key)"
                    },
                    "compacted_name": {
                        "type": ["string", "null"],
                        "description": "Client-facing tool name after prefixing and length compaction"
                    },
                    "type": {
                        "type": "string",
                        "description": "Element type: tool, resource, or prompt"
                    },
                    "permission_key": {
                        "type": "string",
                        "description": "Permission key for this element"
                    },
                    "server_name": {
                        "type": "string",
                        "description": "Parent server name"
                    }
                },
                "required": ["id", "name", "type", "permission_key", "server_name"]
            },
            "TemplateFieldSchema": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "field_type": {
                        "type": "string",
                        "description": "Field type: arg or env"
                    },
                    "template_key": {
                        "type": "string"
                    },
                    "description": {
                        "type": ["string", "null"]
                    },
                    "example": {
                        "type": ["string", "null"]
                    },
                    "required": {
                        "type": "boolean",
                        "default": false
                    },
                    "set_by_user": {
                        "type": "boolean",
                        "default": true
                    },
                    "has_admin_value": {
                        "type": "boolean",
                        "default": false
                    },
                    "has_user_value": {
                        "type": "boolean",
                        "default": false
                    }
                },
                "required": ["id", "field_type", "template_key"]
            },
            "ServerSummary": {
                "type": "object",
                "description": "Summary view of a connected MCP server.",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Server ID"
                    },
                    "name": {
                        "type": "string",
                        "description": "Server MCP prefix name (alphanumeric)"
                    },
                    "display_name": {
                        "type": "string",
                        "description": "Human-readable display name"
                    },
                    "command": {
                        "type": "string",
                        "description": "Server command"
                    },
                    "enabled": {
                        "type": "boolean",
                        "description": "Whether the server is enabled at the admin/global level"
                    },
                    "tool_count": {
                        "type": "integer",
                        "description": "Number of registered tools/elements"
                    },
                    "needs_config": {
                        "type": "boolean",
                        "description": "Whether the server has unconfigured required template fields"
                    },
                    "domain": {
                        "type": "string",
                        "description": "Domain this server belongs to"
                    },
                    "is_builtin": {
                        "type": "boolean",
                        "default": false,
                        "description": "Whether this is the auto-provisioned builtin server"
                    },
                    "user_enabled": {
                        "type": ["boolean", "null"],
                        "description": "User-level enablement override; null means no override"
                    },
                    "parent_enabled": {
                        "type": "boolean",
                        "description": "Effective enabled state from the role/global hierarchy, ignoring any user override"
                    },
                    "user_locked": {
                        "type": "boolean",
                        "default": false,
                        "description": "Whether the caller's enablement override is admin-locked"
                    },
                    "config_warnings": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Human-readable warnings about missing configuration"
                    },
                    "icon_url": {
                        "type": ["string", "null"],
                        "description": "Remote icon URL"
                    },
                    "runtime_health": {
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/ServerRuntimeHealth"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "description": "Live mount and ping health, or null when no per-user MCP instance exists yet"
                    },
                    "authenticated_user_emails": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Emails of users who have invoked tools on this server"
                    },
                    "transport_type": {
                        "type": "string",
                        "default": "http",
                        "description": "Transport: 'http' (remote URL) or 'stdio_tunnel' (proxied via daemon)"
                    },
                    "device_id": {
                        "type": ["string", "null"],
                        "description": "Human-readable device label for a bound stdio_tunnel device"
                    },
                    "device_owner_email": {
                        "type": ["string", "null"],
                        "description": "Email of the device owner for a stdio_tunnel server"
                    }
                },
                "required": ["id", "name", "display_name", "command", "enabled", "tool_count", "needs_config", "domain", "parent_enabled"]
            },
            "ServerDetail": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/ServerSummary"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "elements": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/ServerElement"
                                },
                                "description": "Server elements (tools, resources, prompts)"
                            },
                            "template_fields": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/TemplateFieldSchema"
                                },
                                "description": "Template fields requiring configuration"
                            },
                            "args": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Command-line arguments"
                            },
                            "env": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": ["string", "null"]
                                },
                                "description": "Environment variables"
                            },
                            "url": {
                                "type": ["string", "null"],
                                "description": "Remote server URL (direct mode)"
                            },
                            "headers": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "string"
                                },
                                "description": "Custom HTTP headers"
                            },
                            "version": {
                                "type": ["string", "null"],
                                "description": "Server version"
                            },
                            "from_marketplace_id": {
                                "type": ["string", "null"],
                                "description": "Marketplace ID this server was installed from"
                            }
                        }
                    }
                ]
            },
            "CreateServerRequest": {
                "type": "object",
                "description": "Body for creating an MCP server.",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Server MCP prefix name (alphanumeric only)"
                    },
                    "display_name": {
                        "type": ["string", "null"],
                        "description": "Human-readable display name (defaults to name)"
                    },
                    "command": {
                        "type": "string",
                        "default": "",
                        "description": "Server command (required for local servers)"
                    },
                    "args": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Command-line arguments"
                    },
                    "env": {
                        "type": "object",
                        "additionalProperties": {
                            "type": ["string", "null"]
                        },
                        "description": "Environment variables"
                    },
                    "url": {
                        "type": ["string", "null"],
                        "description": "Remote server URL (direct mode, no mcp-remote)"
                    },
                    "headers": {
                        "type": ["object", "null"],
                        "additionalProperties": {
                            "type": "string"
                        },
                        "description": "Custom HTTP headers for remote servers"
                    },
                    "enabled": {
                        "type": "boolean",
                        "default": true,
                        "description": "Whether to enable the server"
                    },
                    "version": {
                        "type": ["string", "null"],
                        "description": "Server version"
                    },
                    "transport_type": {
                        "type": "string",
                        "default": "http",
                        "description": "Transport: 'http' or 'stdio_tunnel'"
                    },
                    "device_ref_id": {
                        "type": ["integer", "null"],
                        "description": "Target device id, required when transport_type is 'stdio_tunnel'"
                    },
                    "working_dir": {
                        "type": ["string", "null"],
                        "description": "Optional working directory for stdio_tunnel subprocesses"
                    },
                    "icon_url": {
