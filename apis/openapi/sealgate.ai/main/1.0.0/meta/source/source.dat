                            "type": "string"
                        },
                        "description": "Trifecta security flags triggered"
                    },
                    "trifecta_disposition": {
                        "type": "string",
                        "default": "none",
                        "description": "Worst outcome of any trifecta write gated for approval: none, pending, approved, expired, denied"
                    },
                    "trifecta_block_count": {
                        "type": "integer",
                        "default": 0,
                        "description": "Number of trifecta writes gated for approval this session"
                    },
                    "block_severity": {
                        "type": "string",
                        "default": "none",
                        "description": "Severity of trifecta blocks: none, low, medium, high"
                    },
                    "acl_level": {
                        "type": "string",
                        "default": "PUBLIC",
                        "description": "Highest ACL level (PUBLIC, PRIVATE, SECRET)"
                    },
                    "tool_names": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Distinct tool names invoked in this session"
                    }
                },
                "required": ["id", "correlation_id", "user_id", "user_email", "agent_name", "agent_type", "created_at", "tool_call_count", "status", "trifecta_flags"]
            },
            "SessionDetail": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/SessionSummary"
