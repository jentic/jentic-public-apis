            "ToolCall": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique tool call identifier"
                    },
                    "tool_name": {
                        "type": "string",
                        "description": "Name of the MCP tool invoked"
                    },
                    "parameters": {
                        "type": "object",
                        "additionalProperties": true,
                        "description": "Parameters passed to the tool"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time",
                        "description": "When the tool call was made"
                    },
                    "duration_ms": {
                        "type": ["integer", "null"],
                        "description": "Execution time in milliseconds"
                    },
                    "status": {
                        "type": "string",
                        "description": "Outcome status (e.g. success, blocked, error)"
                    },
                    "result": {
                        "description": "Tool call result payload"
                    },
                    "read_private_data": {
                        "type": "boolean",
                        "default": false
                    },
                    "read_untrusted_public_data": {
                        "type": "boolean",
                        "default": false
                    },
                    "write_operation": {
                        "type": "boolean",
                        "default": false
                    },
                    "acl": {
                        "type": "string",
                        "default": "PUBLIC",
                        "description": "Tool ACL level (PUBLIC, PRIVATE, SECRET)"
                    }
                },
                "required": ["id", "tool_name", "parameters", "timestamp", "status"]
            },
            "RiskInfo": {
                "type": "object",
                "description": "Plain-language risk explanation for a blocked action.",
