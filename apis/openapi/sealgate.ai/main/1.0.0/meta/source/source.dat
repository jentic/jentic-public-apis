                        "description": "Email domain the agent belongs to"
                    },
                    "archived": {
                        "type": "boolean",
                        "description": "Whether the agent is archived"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": ["id", "name", "agent_id", "domain", "archived", "created_at"]
            },
            "AgentDetail": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/AgentSummary"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "user_id": {
                                "type": "string",
                                "description": "User ID of the agent creator"
                            },
                            "updated_at": {
                                "type": "string",
                                "format": "date-time",
                                "description": "When the agent was last updated"
                            }
                        },
                        "required": ["user_id", "updated_at"]
                    }
                ]
            },
            "CreateAgentRequest": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Agent name (must be unique per domain)"
                    },
                    "agent_type": {
                        "type": ["string", "null"],
                        "description": "Optional agent type/category"
                    },
                    "domain": {
                        "type": ["string", "null"],
                        "description": "Target domain (owner only; must be in owner domain list)"
                    }
                },
                "required": ["name"]
            },
            "AgentSummaryPage": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/AgentSummary"
                        }
                    },
                    "total": {
                        "type": "integer"
                    },
                    "page": {
                        "type": "integer"
                    },
                    "per_page": {
                        "type": "integer"
                    },
                    "total_pages": {
                        "type": "integer"
                    }
                },
                "required": ["items", "total", "page", "per_page", "total_pages"]
            },
            "TrifectaSummary": {
                "type": "object",
                "properties": {
                    "total_events": {
                        "type": "integer",
                        "description": "Total trifecta events in the time period"
                    },
                    "blocked": {
                        "type": "integer"
                    },
                    "pending": {
                        "type": "integer"
                    },
                    "approved": {
                        "type": "integer"
                    },
                    "time_period": {
                        "type": "string",
                        "description": "Time period for the summary (e.g. '24h', '7d', '30d')"
                    }
                },
                "required": ["total_events", "blocked", "pending", "approved", "time_period"]
            },
            "TrifectaEvent": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "session_id": {
                        "type": "string"
                    },
                    "tool_name": {
                        "type": "string"
                    },
                    "user_id": {
                        "type": "string"
                    },
                    "user_email": {
                        "type": ["string", "null"]
                    },
                    "trifecta_flags": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "status": {
                        "type": "string",
                        "description": "Event status: blocked, pending, or approved"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": ["id", "session_id", "tool_name", "user_id", "status", "timestamp"]
            },
            "AuditEntry": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "user_id": {
                        "type": "string"
                    },
                    "user_email": {
                        "type": ["string", "null"]
                    },
                    "domain": {
                        "type": "string"
                    },
                    "action": {
                        "type": "string",
                        "description": "Action performed (e.g. approve_user, create_role, update_policy)"
                    },
                    "resource_type": {
                        "type": "string",
                        "description": "Type of resource affected (e.g. user, role, policy, server)"
                    },
                    "resource_id": {
                        "type": "string"
                    },
                    "old_value": {
                        "type": ["object", "null"],
                        "additionalProperties": true
                    },
                    "new_value": {
                        "type": ["object", "null"],
                        "additionalProperties": true
                    },
                    "request_status": {
                        "type": "string",
                        "description": "HTTP status of the request (e.g. success, error)"
                    }
                },
                "required": ["id", "timestamp", "user_id", "domain", "action", "resource_type", "resource_id", "request_status"]
            },
            "TrifectaEventPage": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TrifectaEvent"
                        }
                    },
                    "total": {
                        "type": "integer"
                    },
                    "page": {
                        "type": "integer"
                    },
                    "per_page": {
                        "type": "integer"
                    },
                    "total_pages": {
                        "type": "integer"
                    }
                },
                "required": ["items", "total", "page", "per_page", "total_pages"]
            },
            "AuditEntryPage": {
                "type": "object",
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/AuditEntry"
                        }
                    },
                    "total": {
                        "type": "integer"
                    },
                    "page": {
                        "type": "integer"
                    },
                    "per_page": {
                        "type": "integer"
                    },
                    "total_pages": {
                        "type": "integer"
                    }
                },
                "required": ["items", "total", "page", "per_page", "total_pages"]
            }
        }
    }
}
