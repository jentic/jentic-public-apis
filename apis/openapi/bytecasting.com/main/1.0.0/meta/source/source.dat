{
  "openapi": "3.0.3",
  "info": {
    "title": "Bytecasting LMS - FAQ API",
    "description": "Comprehensive FAQ Management API for Bytecasting LMS.\n\n## Authentication\nAll endpoints require Bearer Token authentication using Laravel Sanctum.\nInclude the token in the Authorization header: `Bearer {your-token}`\n\n## Features\n- FAQ CRUD operations\n- FAQ Category management\n- Advanced filtering and search\n- Pagination support\n- Bulk operations\n- Version management\n",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@bytecasting.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/sbc-bec/bytecasting-lms-faq-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.bytecasting.com/api",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "FAQ Categories",
      "description": "Operations related to FAQ categories"
    },
    {
      "name": "FAQs",
      "description": "Operations related to FAQs"
    }
  ],
  "paths": {
    "/faq-categories": {
      "get": {
        "tags": [
          "FAQ Categories"
        ],
        "summary": "List All FAQ Categories",
        "description": "Retrieve a paginated list of FAQ categories with optional filtering and sorting.\nSupports filtering by parent category, status, and search functionality.\n",
        "operationId": "listFaqCategories",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of items per page (max 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 15
            }
          },
          {
            "name": "parent_id",
            "in": "query",
            "description": "Filter by parent category ID",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "active",
                "inactive"
              ],
              "default": "all"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search query for category name or description",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Sort field",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "created",
                "updated",
                "name"
              ],
              "default": "created"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "description": "Sort order",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaqCategoryListResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "tags": [
          "FAQ Categories"
        ],
        "summary": "Create FAQ Category",
        "description": "Create a new FAQ category",
        "operationId": "createFaqCategory",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFaqCategoryRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Basic Category",
                  "value": {
                    "name": "Technical Support",
                    "description": "Technical support related FAQs",
                    "active": true
                  }
                },
                "with_parent": {
                  "summary": "Subcategory",
                  "value": {
                    "name": "API Issues",
                    "description": "API related technical issues",
                    "parent_id": 1,
                    "active": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaqCategoryResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/faq-categories/{id}": {
      "get": {
        "tags": [
          "FAQ Categories"
        ],
        "summary": "Get FAQ Category Details",
        "description": "Retrieve detailed information about a specific FAQ category including subcategories",
        "operationId": "getFaqCategory",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "FAQ Category ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaqCategoryDetailResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "tags": [
          "FAQ Categories"
        ],
        "summary": "Update FAQ Category",
        "description": "Update an existing FAQ category",
        "operationId": "updateFaqCategory",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "FAQ Category ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFaqCategoryRequest"
              },
              "examples": {
                "update_name": {
                  "summary": "Update Name Only",
                  "value": {
                    "name": "Updated Category Name"
                  }
                },
                "update_status": {
                  "summary": "Update Status Only",
                  "value": {
                    "active": false
                  }
                },
                "full_update": {
                  "summary": "Full Update",
                  "value": {
                    "name": "Updated Category",
                    "description": "Updated description",
                    "parent_id": 2,
                    "active": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Category updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "409": {
            "$ref": "#/components/responses/ConflictError"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "FAQ Categories"
        ],
        "summary": "Delete FAQ Category",
        "description": "Delete an FAQ category. Cannot delete if it has subcategories or FAQs.",
        "operationId": "deleteFaqCategory",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "FAQ Category ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Category deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/faqs": {
      "get": {
        "tags": [
          "FAQs"
        ],
        "summary": "List All FAQs",
        "description": "Retrieve a paginated list of FAQs with advanced filtering, searching, and sorting options.\nSupports filtering by category, owner, status, and full-text search.\n",
        "operationId": "listFaqs",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Number of items per page (max 100)",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 15
            }
          },
          {
            "name": "owner_id",
            "in": "query",
            "description": "Filter by owner/user ID",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "category_id",
            "in": "query",
            "description": "Filter by category ID",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "active",
                "inactive"
              ],
              "default": "all"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Search query for FAQ subject or solution content",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Sort field",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "created",
                "updated",
                "subject",
                "owner_id"
              ],
              "default": "created"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "description": "Sort order",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaqListResponse"
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "tags": [
          "FAQs"
        ],
        "summary": "Create FAQ",
        "description": "Create a new FAQ. If `faq_id` is provided, creates a new version of an existing FAQ.\nOtherwise, creates a new FAQ with version 1.\n",
        "operationId": "createFaq",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFaqRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Basic FAQ",
                  "value": {
                    "subject": "How do I reset my password?",
                    "solution": "To reset your password, follow these steps:\n\n1. Go to the login page\n2. Click on 'Forgot Password' link\n3. Enter your email address\n4. Check your email for reset instructions",
                    "owner": 1,
                    "category_id": 1,
                    "active": true
                  }
                },
                "technical": {
                  "summary": "Technical FAQ",
                  "value": {
                    "subject": "How to configure API authentication?",
                    "solution": "API authentication can be configured using several methods:\n\n**Bearer Token Authentication:**\n1. Generate an API token from your account settings\n2. Include the token in the Authorization header\n3. Format: 'Bearer YOUR_TOKEN_HERE'",
                    "owner": 1,
                    "category_id": 1,
                    "active": true
                  }
                },
                "new_version": {
                  "summary": "Create New Version",
                  "value": {
                    "subject": "How do I reset my password? (Updated)",
                    "solution": "To reset your password, follow these updated steps...",
                    "owner": 1,
                    "category_id": 1,
                    "active": true,
                    "faq_id": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "FAQ created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaqCreateResponse"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/ConflictError"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/faqs/{id}": {
      "get": {
        "tags": [
          "FAQs"
        ],
        "summary": "Get FAQ Details",
        "description": "Retrieve detailed information about a specific FAQ including:\n- FAQ details\n- Owner information\n- Category information\n- All versions\n- Statistics (word count, character count, version count)\n",
        "operationId": "getFaq",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "FAQ ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaqDetailResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "tags": [
          "FAQs"
        ],
        "summary": "Update FAQ",
        "description": "Update an existing FAQ. Only the owner or admin can update.\nAll fields are optional - only provided fields will be updated.\n",
        "operationId": "updateFaq",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "FAQ ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFaqRequest"
              },
              "examples": {
                "full_update": {
                  "summary": "Full Update",
                  "value": {
                    "subject": "How do I reset my password? (Updated 2024)",
                    "solution": "To reset your password, follow these updated steps...",
                    "category_id": 1
                  }
                },
                "status_only": {
                  "summary": "Update Status Only",
                  "value": {
                    "active": false
                  }
                },
                "category_only": {
                  "summary": "Update Category Only",
                  "value": {
                    "category_id": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "FAQ updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "409": {
            "$ref": "#/components/responses/ConflictError"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "FAQs"
        ],
        "summary": "Delete FAQ",
        "description": "Delete an FAQ. Only the owner or admin can delete.\nCannot delete if FAQ has multiple versions.\n",
        "operationId": "deleteFaq",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "FAQ ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "FAQ deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/faqs/bulk-update": {
      "post": {
        "tags": [
          "FAQs"
        ],
        "summary": "Bulk Update FAQs",
        "description": "Update multiple FAQs with the same changes in a single request.\nOnly the owner or admin can update each FAQ.\n",
        "operationId": "bulkUpdateFaqs",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUpdateFaqRequest"
              },
              "example": {
                "faq_ids": [
                  1,
                  2,
                  3
                ],
                "updates": {
                  "active": true,
                  "owner": 1,
                  "category_id": 1
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk update completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkUpdateResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Laravel Sanctum Bearer Token"
      }
    },
    "schemas": {
      "CreateFaqCategoryRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "description": "Category name",
            "example": "Technical Support"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Category description",
            "example": "Technical support related FAQs"
          },
          "parent_id": {
            "type": "integer",
            "nullable": true,
            "description": "Parent category ID (for subcategories)",
            "example": 1
          },
          "active": {
            "type": "boolean",
            "default": true,
            "description": "Whether the category is active",
            "example": true
          }
        }
      },
      "UpdateFaqCategoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "description": "Category name"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Category description"
          },
          "parent_id": {
            "type": "integer",
            "nullable": true,
            "description": "Parent category ID"
          },
          "active": {
            "type": "boolean",
            "description": "Whether the category is active"
          }
        }
      },
      "FaqCategoryItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Category ID",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Category name",
            "example": "Technical Support"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Category description"
          },
          "parent_id": {
            "type": "integer",
            "nullable": true,
            "description": "Parent category ID"
          },
          "parent_name": {
            "type": "string",
            "nullable": true,
            "description": "Parent category name"
          },
          "active": {
            "type": "string",
            "enum": [
              "Active",
              "Inactive"
            ],
            "description": "Category status"
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Creation timestamp"
          },
          "updated": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Last update timestamp"
          }
        }
      },
      "FaqCategoryListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "current_page": {
                "type": "integer",
                "example": 1
              },
              "per_page": {
                "type": "integer",
                "example": 15
              },
              "total": {
                "type": "integer",
                "example": 50
              },
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FaqCategoryItem"
                }
              },
              "category_summary": {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer"
                  },
                  "active": {
                    "type": "integer"
                  },
                  "inactive": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "message": {
            "type": "string",
            "example": "FAQ categories retrieved successfully"
          }
        }
      },
      "FaqCategoryDetailResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "nullable": true
              },
              "parent_id": {
                "type": "integer",
                "nullable": true
              },
              "parent_name": {
                "type": "string",
                "nullable": true
              },
              "active": {
                "type": "string",
                "enum": [
                  "Active",
                  "Inactive"
                ]
              },
              "subcategories": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "name": {
                      "type": "string"
                    },
                    "parent_id": {
                      "type": "integer"
                    }
                  }
                }
              },
              "created": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "updated": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              }
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "FaqCategoryResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "nullable": true
              },
              "parent_id": {
                "type": "integer",
                "nullable": true
              },
              "active": {
                "type": "string",
                "enum": [
                  "Active",
                  "Inactive"
                ]
              },
              "status": {
                "type": "string",
                "example": "created"
              }
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "CreateFaqRequest": {
        "type": "object",
        "required": [
          "subject",
          "solution",
          "owner"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 10000,
            "description": "FAQ subject/question",
            "example": "How do I reset my password?"
          },
          "solution": {
            "type": "string",
            "maxLength": 50000,
            "description": "FAQ solution/answer",
            "example": "To reset your password, follow these steps..."
          },
          "owner": {
            "type": "integer",
            "description": "Owner/creator user ID",
            "example": 1
          },
          "category_id": {
            "type": "integer",
            "nullable": true,
            "description": "FAQ category ID",
            "example": 1
          },
          "active": {
            "type": "boolean",
            "default": true,
            "description": "Whether the FAQ is active",
            "example": true
          },
          "faq_id": {
            "type": "integer",
            "nullable": true,
            "description": "FAQ ID for creating a new version (if creating a version of existing FAQ)",
            "example": 1
          }
        }
      },
      "UpdateFaqRequest": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 10000,
            "description": "FAQ subject/question"
          },
          "solution": {
            "type": "string",
            "maxLength": 50000,
            "description": "FAQ solution/answer"
          },
          "owner": {
            "type": "integer",
            "description": "Owner/creator user ID"
          },
          "category_id": {
            "type": "integer",
            "nullable": true,
            "description": "FAQ category ID"
          },
          "active": {
            "type": "boolean",
            "description": "Whether the FAQ is active"
          }
        }
      },
      "BulkUpdateFaqRequest": {
        "type": "object",
        "required": [
          "faq_ids",
          "updates"
        ],
        "properties": {
          "faq_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer"
            },
            "description": "Array of FAQ IDs to update",
            "example": [
              1,
              2,
              3
            ]
          },
          "updates": {
            "type": "object",
            "required": true,
            "properties": {
              "active": {
                "type": "boolean",
                "description": "Update active status"
              },
              "owner": {
                "type": "integer",
                "description": "Update owner ID"
              },
              "category_id": {
                "type": "integer",
                "description": "Update category ID"
              }
            }
          }
        }
      },
      "FaqItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "FAQ ID",
            "example": 1
          },
          "faq_id": {
            "type": "integer",
            "nullable": true,
            "description": "Parent FAQ ID (for versions)",
            "example": 1
          },
          "subject": {
            "type": "string",
            "description": "FAQ subject/question",
            "example": "How do I reset my password?"
          },
          "solution": {
            "type": "string",
            "description": "FAQ solution/answer"
          },
          "version": {
            "type": "integer",
            "description": "FAQ version number",
            "example": 1
          },
          "category_id": {
            "type": "integer",
            "nullable": true,
            "description": "Category ID",
            "example": 1
          },
          "category_name": {
            "type": "string",
            "description": "Category name",
            "example": "Technical Support"
          },
          "owner_id": {
            "type": "integer",
            "description": "Owner user ID",
            "example": 1
          },
          "owner_name": {
            "type": "string",
            "description": "Owner name",
            "example": "John Doe"
          },
          "owner_email": {
            "type": "string",
            "format": "email",
            "description": "Owner email",
            "example": "john@example.com"
          },
          "owner_status": {
            "type": "string",
            "enum": [
              "Active",
              "Inactive"
            ],
            "description": "Owner status"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Inactive"
            ],
            "description": "FAQ status"
          },
          "word_count": {
            "type": "integer",
            "description": "Word count of the solution",
            "example": 45
          },
          "created": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Creation timestamp"
          },
          "updated": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Last update timestamp"
          }
        }
      },
      "FaqListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "type": "object",
            "properties": {
              "current_page": {
                "type": "integer"
              },
              "per_page": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FaqItem"
                }
              },
              "faq_summary": {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer"
                  },
                  "active": {
                    "type": "integer"
                  },
                  "inactive": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "FaqDetailResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "faq_id": {
                "type": "integer",
                "nullable": true
              },
              "subject": {
                "type": "string"
              },
              "solution": {
                "type": "string"
              },
              "version": {
                "type": "integer"
              },
              "owner_details": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "Active",
                      "Inactive"
                    ]
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "updated_at": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  }
                }
              },
              "category_details": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "active": {
                    "type": "string",
                    "enum": [
                      "Active",
                      "Inactive"
                    ]
                  }
                }
              },
              "versions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "version": {
                      "type": "integer"
                    },
                    "subject": {
                      "type": "string"
                    },
                    "solution": {
                      "type": "string"
                    },
                    "created": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    },
                    "updated": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    }
                  }
                }
              },
              "statistics": {
                "type": "object",
                "properties": {
                  "word_count": {
                    "type": "integer"
                  },
                  "character_count": {
                    "type": "integer"
                  },
                  "version_count": {
                    "type": "integer"
                  }
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "Active",
                  "Inactive"
                ]
              },
              "timestamps": {
                "type": "object",
                "properties": {
                  "created": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  },
                  "updated": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true
                  }
                }
              }
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "FaqCreateResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "subject": {
                "type": "string"
              },
              "owner": {
                "type": "integer"
              },
              "version": {
                "type": "integer"
              },
              "status": {
                "type": "string",
                "example": "created"
              }
            }
          }
        }
      },
      "BulkUpdateResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "updated_count": {
                "type": "integer",
                "description": "Number of FAQs successfully updated"
              },
              "total_requested": {
                "type": "integer",
                "description": "Total number of FAQs requested to update"
              }
            }
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operation completed successfully"
          },
          "data": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "nullable": true,
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "Validation failed",
              "errors": {
                "subject": [
                  "The subject field is required."
                ],
                "owner": [
                  "The owner field must be an integer."
                ]
              }
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "FAQ not found"
            }
          }
        }
      },
      "BadRequestError": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "Cannot delete FAQ with multiple versions. Please delete all versions first."
            }
          }
        }
      },
      "ConflictError": {
        "description": "Conflict (e.g., duplicate resource)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "FAQ with this subject already exists"
            }
          }
        }
      },
      "ForbiddenError": {
        "description": "Forbidden (insufficient permissions)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "Unauthorized to update this FAQ"
            }
          }
        }
      },
      "ServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "message": "An error occurred while processing the request",
              "error": "Database connection failed"
            }
          }
        }
      }
    }
  }
}
