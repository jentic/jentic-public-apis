    "/api/v1/comparisons": {
      "get": {
        "operationId": "listComparisons",
        "summary": "Technology comparisons",
        "description": "Dribba's position on the technology trade-offs clients ask about. Paginated: pass `limit` to slice it and follow `next_cursor` until it is null.",
        "tags": [
          "Public read (v1)"
        ],
        "security": [],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Maximum number of items to return (1-100). Omit it and the whole collection comes back with `next_cursor: null`.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "description": "Opaque cursor from a previous response's `next_cursor`. Pass it back verbatim; never construct or parse it.",
            "schema": {
              "type": "string"
            }
          }
