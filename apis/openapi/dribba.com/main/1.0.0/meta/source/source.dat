            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "EstimateEmailRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "complexity": {
            "type": "string",
            "enum": [
              "mvp",
              "standard",
              "complex"
            ]
          },
          "design": {
            "type": "string",
            "enum": [
              "basic",
              "custom",
              "premium"
            ]
          },
          "timeline": {
            "type": "string",
            "enum": [
              "rush",
              "normal",
              "relaxed"
            ]
          }
        }
      },
      "ResourceRequest": {
        "type": "object",
        "required": [
          "slug",
          "email"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ApplicationRequest": {
        "type": "object",
        "required": [
          "name",
