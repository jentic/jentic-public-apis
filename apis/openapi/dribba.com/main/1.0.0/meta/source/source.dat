    "/api/v1/sandbox/estimate": {
      "post": {
        "operationId": "estimateProjectSandbox",
        "summary": "Sandbox estimate (constant response)",
        "description": "Returns a fixed range whatever the input, so an integration test does not break when the real multipliers change. Same schema as the production estimator.",
        "tags": [
          "Batch (v1)"
        ],
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "description": "Client-generated key (a UUID is fine). Repeating a request with the same key and the same body replays the stored response and adds `Idempotency-Replayed: true`. The same key with a different body is rejected with 400.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
