      "EstimateRequest": {
        "type": "object",
        "required": [
          "platforms"
        ],
        "additionalProperties": false,
        "properties": {
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "ios",
                "android",
                "web",
                "desktop"
              ]
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Feature ids from GET /api/v1/pricing."
          },
          "complexity": {
            "type": "string",
            "enum": [
              "mvp",
              "standard",
              "complex"
            ],
            "default": "standard"
          },
          "design": {
            "type": "string",
            "enum": [
              "basic",
              "custom",
              "premium"
            ],
            "default": "custom"
          },
          "timeline": {
            "type": "string",
            "enum": [
              "rush",
              "normal",
              "relaxed"
            ],
            "default": "normal"
          }
        }
      },
      "Estimate": {
        "type": "object",
        "required": [
          "currency",
          "min",
          "max",
          "mid"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "enum": [
              "EUR"
            ]
          },
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "mid": {
            "type": "integer"
          },
          "below_floor": {
            "type": "boolean",
            "description": "True when the raw maths landed under the €30,000 floor."
          },
          "minimum_project_budget": {
            "type": "integer"
          },
          "input": {
            "$ref": "#/components/schemas/EstimateRequest"
          },
          "note": {
            "type": "string"
          },
          "next_step": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "BatchOperation": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Echoed back on the matching result. Defaults to the array index."
          },
          "method": {
            "type": "string",
            "enum": [
              "GET"
            ],
            "default": "GET"
          },
          "path": {
            "type": "string",
            "description": "A /api/v1 path, query string included, e.g. /api/v1/cases?limit=2",
            "pattern": "^/api/v1(/.*)?$"
          }
        }
      },
      "BatchRequest": {
        "type": "object",
        "required": [
          "operations"
        ],
        "properties": {
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/BatchOperation"
            }
          }
        }
      },
      "BatchResult": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "description": "Per-operation HTTP status."
          },
          "body": {
            "description": "The operation's response body, when it succeeded."
          },
          "error": {
            "type": "object",
            "description": "Present instead of `body` when the operation failed.",
            "properties": {
              "code": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      },
      "BatchResponse": {
        "type": "object",
        "required": [
          "count",
          "results"
        ],
        "properties": {
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchResult"
            }
          }
        }
      },
      "ExportRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "pattern": "^/"
            },
            "description": "Site paths to export, as listed in /sitemap.xml. Omit it and the first 50 pages by sitemap priority are used."
          }
        }
      },
      "ExportJob": {
        "type": "object",
        "required": [
          "id",
          "status",
          "status_url",
          "progress"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "running",
              "completed",
              "failed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "progress": {
            "type": "object",
            "required": [
              "done",
              "total"
            ],
            "properties": {
              "done": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              }
            }
          },
          "status_url": {
            "type": "string",
            "format": "uri"
          },
          "result_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "instance_scoped": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          },
          "requested_pages": {
            "type": "integer"
          },
          "unknown_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SandboxIndex": {
        "type": "object",
        "required": [
