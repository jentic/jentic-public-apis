{
  "openapi": "3.1.0",
  "info": {
    "title": "Dribba Public API",
    "version": "1.0.0",
    "summary": "Read-only JSON access to Dribba's services, cases, articles, jobs and project estimator.",
    "description": "Public HTTP surface of dribba.com, the site of Dribba — an end-to-end digital product studio in Barcelona and Andorra (Flutter, Go backends, AI integration).\n\n**Authentication:** none. Every `/api/v1` operation is public and read-only.\n**Errors:** RFC 9457 problem details (`application/problem+json`) with a stable `code` and a `resolution` hint.\n**Rate limit:** 120 requests per 60s per client IP, advertised through the IETF `RateLimit` fields on every response.\n**Versioning:** major version in the path (`/api/v1`). Additive changes land inside v1; breaking changes get a new major path, announced with RFC 9745 `Deprecation`/`Sunset` headers at least 90 days ahead.\n\nThe legacy form endpoints (`/api/contact`, `/api/apply`…) enforce same-origin and are documented for completeness. For agent-initiated writes use the remote MCP server at https://dribba.com/mcp.\n\nOther machine surfaces: OKF bundle at https://dribba.com/okf, `Accept: text/markdown` on any page URL (or append `.md`: https://dribba.com/index.md), https://dribba.com/llms.txt.\nConventions answered explicitly, including the ones that do not apply: authentication (https://dribba.com/auth.md), pricing (https://dribba.com/pricing.md), pagination, idempotency, async jobs and batching — see the `x-api-conventions` extension below.",
    "termsOfService": "https://dribba.com/aviso-legal",
    "license": {
      "name": "CC BY 4.0",
      "url": "https://creativecommons.org/licenses/by/4.0/"
    },
    "contact": {
      "name": "Dribba developer contact",
      "email": "hola@dribba.com",
      "url": "https://dribba.com/docs"
    }
  },
  "externalDocs": {
    "description": "Dribba developer docs: errors, rate limits, versioning, MCP",
    "url": "https://dribba.com/docs"
  },
  "servers": [
    {
      "url": "https://dribba.com",
      "description": "Production"
    },
    {
      "url": "https://dribba.com/sandbox",
      "description": "Sandbox — same paths, frozen fixture data, X-Sandbox: true on every response. Nothing here writes, so it is a stable target for integration tests rather than an isolated copy of production."
    }
  ],
  "tags": [
    {
      "name": "Discovery",
      "description": "Machine-readable entry points."
    },
    {
      "name": "Public read (v1)",
      "description": "Versioned, unauthenticated read operations."
    },
    {
      "name": "Estimator (v1)",
      "description": "Ballpark project budget."
    },
    {
      "name": "Batch (v1)",
      "description": "Many reads in one request, plus the sandbox fixtures."
    },
    {
      "name": "Exports (v1)",
      "description": "Asynchronous markdown export of the site: 202, poll, read."
    },
    {
      "name": "Site forms (same-origin)",
      "description": "Form endpoints used by dribba.com itself."
    }
  ],
  "x-rate-limit-policy": {
    "name": "public-read",
    "quota": 120,
    "window_seconds": 60,
    "partition": "client IP address",
    "headers": [
      "RateLimit-Policy",
      "RateLimit",
      "RateLimit-Limit",
      "RateLimit-Remaining",
      "RateLimit-Reset",
      "Retry-After"
    ],
    "documentation_url": "https://dribba.com/docs#limites"
  },
  "x-api-conventions": {
    "authentication": {
      "required": false,
      "schemes": [],
      "documentation_url": "https://dribba.com/auth.md",
      "note": "Every /api/v1 operation is public and read-only. No API keys, no OAuth, no tokens."
    },
    "sandbox": {
      "separate_environment": true,
      "base_url": "https://dribba.com/api/v1/sandbox",
      "production_base_url": "https://dribba.com/api/v1",
      "response_marker": {
        "header": "X-Sandbox: true",
        "body_field": "sandbox"
      },
      "note": "Frozen fixtures with production shapes. It is not about isolating writes — /api/v1 has none — it is about data that does not move under your tests."
    },
    "pagination": {
      "supported": true,
      "style": "cursor",
      "parameters": [
        "limit",
        "cursor"
      ],
      "response_fields": [
        "count",
        "total",
        "next_cursor",
        "items"
      ],
      "max_limit": 100,
      "note": "Omit `limit` and the whole collection comes back with next_cursor: null — the collections are bounded, so paging is offered rather than imposed."
    },
    "idempotency": {
      "supported": true,
      "header": "Idempotency-Key",
      "scope": "POST operations under /api/v1",
      "replay_header": "Idempotency-Replayed",
      "retention_hours": 24,
      "note": "Same key + same body replays the stored response; same key + different body is a 400. Today's only POST is a pure calculation, so this guards the convention rather than a charge."
    },
    "async_jobs": {
      "supported": true,
      "pattern": "202 Accepted + Location header + poll the status URL",
      "endpoint": "https://dribba.com/api/v1/exports",
      "terminal_statuses": [
        "completed",
        "failed"
      ],
      "retry_after_header": true,
      "note": "Only the markdown export is asynchronous, because it is the only operation that does not fit in one response (N pages means N fetches and conversions). Everything else answers synchronously. Jobs are instance-scoped and expire after 15 minutes."
    },
    "batch": {
      "supported": true,
      "endpoint": "https://dribba.com/api/v1/batch",
      "max_operations": 20,
      "note": "GET operations only, resolved in-process. A batch that could write would be a way around the same-origin rule on the form endpoints."
    },
    "webhooks": {
      "supported": false,
      "note": "No events to subscribe to. Content changes are visible through the sitemap, the RSS/JSON feeds and the OKF bundle."
    },
    "pricing": {
      "free": true,
      "documentation_url": "https://dribba.com/pricing.md"
    }
  },
  "x-api-lifecycle": {
    "current_major_version": "v1",
    "status": "stable",
    "versioning": "URL path (/api/v1)",
    "breaking_change_policy": "A breaking change ships as a new major path (/api/v2); v1 keeps working.",
    "deprecation_signal": "RFC 9745 Deprecation and Link headers, then a dated Sunset header at least 90 days before removal.",
    "sunset": null,
    "deprecation_policy_url": "https://dribba.com/docs#versionado"
  },
