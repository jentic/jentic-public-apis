  "components": {
    "headers": {
      "RateLimitPolicy": {
        "description": "Quota policy as an IETF structured field, e.g. `\"public-read\";q=120;w=60`.",
        "schema": {
          "type": "string"
        }
      },
      "RateLimit": {
        "description": "Remaining quota and reset for this client, e.g. `\"public-read\";r=118;t=47`.",
        "schema": {
          "type": "string"
        }
      },
      "RateLimitLimit": {
        "description": "Compatibility form of the quota.",
        "schema": {
          "type": "integer"
        }
      },
      "RateLimitRemaining": {
        "description": "Compatibility form of the remaining quota.",
        "schema": {
          "type": "integer"
        }
      },
      "RateLimitReset": {
        "description": "Seconds until the window resets.",
        "schema": {
          "type": "integer"
        }
      },
      "RetryAfter": {
        "description": "Seconds to wait before retrying.",
        "schema": {
          "type": "integer"
        }
      },
      "Allow": {
        "description": "Methods this endpoint accepts.",
        "schema": {
          "type": "string"
        }
      },
      "Link": {
        "description": "RFC 8288 links to the contract (`service-desc`), the docs (`service-doc`), the API catalog and the deprecation policy.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 9457 problem details. Returned by every 4xx and 5xx response as `application/problem+json`.",
        "additionalProperties": true,
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "resolution"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "Anchor in /docs describing this error class."
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "description": "What went wrong, in prose."
          },
          "instance": {
            "type": "string",
            "format": "uri",
            "description": "The exact URL that failed."
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code. Branch on this, never on `title`.",
            "enum": [
              "api_route_not_found",
              "resource_not_found",
              "method_not_allowed",
              "invalid_request",
              "unsupported_media_type",
              "rate_limit_exceeded",
              "origin_not_allowed",
              "internal_error"
            ]
          },
          "resolution": {
            "type": "string",
            "description": "The concrete next step that fixes it."
          },
          "documentation_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "RateLimitInfo": {
        "type": "object",
        "required": [
          "policy",
          "quota",
          "window_seconds"
        ],
        "properties": {
          "policy": {
            "type": "string"
          },
          "quota": {
            "type": "integer"
          },
          "window_seconds": {
            "type": "integer"
          },
          "partition": {
            "type": "string"
          },
          "headers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ApiIndex": {
        "type": "object",
        "required": [
          "name",
          "versions",
          "current_version",
          "openapi_url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "documentation_url": {
            "type": "string",
            "format": "uri"
          },
          "developer_portal_url": {
            "type": "string",
            "format": "uri"
          },
          "openapi_url": {
            "type": "string",
            "format": "uri"
          },
          "api_catalog_url": {
            "type": "string",
            "format": "uri"
          },
          "current_version": {
            "type": "string"
          },
          "deprecation_policy_url": {
            "type": "string",
            "format": "uri"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "version",
                "status",
                "base_url"
              ],
              "properties": {
                "version": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "stable",
                    "deprecated"
                  ]
                },
                "base_url": {
                  "type": "string",
                  "format": "uri"
                },
                "sunset": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date"
                }
              }
            }
          },
          "rate_limit": {
            "$ref": "#/components/schemas/RateLimitInfo"
          },
          "errors": {
            "type": "object",
            "properties": {
              "media_type": {
                "type": "string"
              },
              "specification": {
                "type": "string"
              },
              "documentation_url": {
                "type": "string"
              }
            }
          },
          "other_surfaces": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "write_endpoints": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "VersionIndex": {
        "type": "object",
        "required": [
          "version",
          "status",
          "endpoints"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "stable",
              "deprecated"
            ]
          },
          "documentation_url": {
            "type": "string",
            "format": "uri"
          },
          "openapi_url": {
            "type": "string",
            "format": "uri"
          },
          "mcp_url": {
            "type": "string",
            "format": "uri"
          },
          "deprecation_policy_url": {
            "type": "string",
            "format": "uri"
          },
          "rate_limit": {
            "$ref": "#/components/schemas/RateLimitInfo"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "title",
                "methods"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "methods": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "Company": {
        "type": "object",
        "required": [
          "name",
          "legal_name",
          "url",
          "positioning",
          "offices"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "legal_name": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "vat_id": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "positioning": {
            "type": "string"
          },
          "founded": {
            "type": "integer"
          },
          "offices": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "projectsDelivered": {
            "type": "string"
          },
          "team": {
            "type": "string"
          },
          "distinctions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "specialties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selectedClients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model": {
            "type": "string"
          },
          "minProjectBudget": {
            "type": "string"
          },
          "responseTime": {
            "type": "string"
          },
          "website": {
            "type": "string",
            "format": "uri"
          },
          "contact": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "Service": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "url",
          "summary"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "ServiceList": {
        "type": "object",
        "description": "Paginated service catalog.",
        "required": [
          "count",
          "total",
          "items",
          "next_cursor"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "description": "Items in this page."
          },
          "total": {
            "type": "integer",
