    "/api/v1/services": {
      "get": {
        "operationId": "listServices",
        "summary": "Service catalog",
        "description": "Every service Dribba sells, with slug, name, one-line summary and canonical URL. Paginated: pass `limit` to slice it and follow `next_cursor` until it is null.",
        "tags": [
          "Public read (v1)"
        ],
        "security": [],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Maximum number of items to return (1-100). Omit it and the whole collection comes back with `next_cursor: null`.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "description": "Opaque cursor from a previous response's `next_cursor`. Pass it back verbatim; never construct or parse it.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Service catalog",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Limit": {
                "$ref": "#/components/headers/RateLimitLimit"
              },
