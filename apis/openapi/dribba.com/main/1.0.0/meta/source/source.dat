    "/api/v1/batch": {
      "post": {
        "operationId": "batchRead",
        "summary": "Run up to 20 read operations in one request",
        "description": "Resolves each operation in-process — no internal HTTP round trip — and returns one result per operation, in order. GET operations on /api/v1 paths only: a batch that could write would be a way around the same-origin rule on the form endpoints. Per-operation failures do not fail the batch; each result carries its own status.",
        "tags": [
          "Batch (v1)"
        ],
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "description": "Client-generated key (a UUID is fine). Repeating a request with the same key and the same body replays the stored response and adds `Idempotency-Replayed: true`. The same key with a different body is rejected with 400.",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-operation results",
            "headers": {
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
