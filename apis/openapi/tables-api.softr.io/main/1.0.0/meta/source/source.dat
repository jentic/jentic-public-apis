{
  "components": {
    "schemas": {
      "Database": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tablesCount": {
            "description": "Number of tables in this database.",
            "type": "integer"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Error": {
        "properties": {
          "details": {
            "additionalProperties": true,
            "description": "Additional context about the error (e.g. fieldId, traceId).",
            "type": "object"
          },
          "errorCode": {
            "description": "A machine-readable error code (e.g. BAD_REQUEST, VALIDATION_ERROR, RESOURCE_NOT_FOUND).",
            "type": "string"
          },
          "message": {
            "description": "A human-readable error message.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "FilterCondition": {
        "description": "A condition for filtering records. Text-related conditions are case-insensitive.",
        "properties": {
          "conditions": {
            "description": "Used for AND/OR operators to nest conditions.",
            "items": {
              "$ref": "#/components/schemas/FilterCondition"
            },
            "type": "array"
          },
          "leftSide": {
            "description": "The Field ID to apply the operator on.",
            "type": "string"
          },
          "lowerBound": {
            "description": "Lower bound for IS_BETWEEN operator.",
            "type": "string"
          },
          "operator": {
            "enum": [
              "AND",
              "OR",
              "IS_EMPTY",
              "IS_NOT_EMPTY",
              "IS_BETWEEN",
              "IS_NOT_BETWEEN",
              "IS_WITHIN",
              "IS_NOT_WITHIN",
              "IS",
              "IS_NOT",
              "GREATER_THAN",
              "GREATER_THAN_OR_EQUALS",
              "LESS_THAN",
              "LESS_THAN_OR_EQUALS",
              "CONTAINS",
              "DOES_NOT_CONTAIN",
              "STARTS_WITH",
              "DOES_NOT_START_WITH",
              "ENDS_WITH",
              "DOES_NOT_END_WITH",
              "IS_ONE_OF",
              "IS_NOT_ONE_OF",
              "HAS_ANY_OF",
              "HAS_ALL_OF",
              "HAS_NONE_OF"
            ],
            "type": "string"
          },
          "rightSide": {
            "description": "The value to compare against. Can be a string, number, or an array for operators like IS_ONE_OF.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "upperBound": {
            "description": "Upper bound for IS_BETWEEN operator.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Record": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "fields": {
            "additionalProperties": true,
            "description": "A map of Field IDs to their values for this record.",
            "type": "object"
          },
          "id": {
            "type": "string"
          },
          "tableId": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "RecordListMetadata": {
        "properties": {
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Table": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "defaultViewId": {
            "type": "string"
          },
          "description": {
            "nullable": true,
            "type": "string"
          },
          "fields": {
            "items": {
              "$ref": "#/components/schemas/TableField"
            },
            "type": "array"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "primaryFieldId": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TableField": {
        "properties": {
          "aiOptions": {
            "description": "AI-powered auto-fill configuration. Null if not configured.",
            "nullable": true,
            "properties": {
              "aiFillable": {
                "type": "boolean"
              },
              "aiModel": {
                "type": "string"
              },
              "aiOnly": {
                "type": "boolean"
              },
              "allowWebSearch": {
                "type": "boolean"
              },
              "canBeTriggeredManually": {
                "type": "boolean"
              },
              "prompt": {
                "type": "string"
              },
              "runWhenRecordIsCreated": {
                "type": "boolean"
              },
              "runWhenRecordIsUpdated": {
                "type": "boolean"
              }
            },
            "type": "object"
          },
          "allowMultipleEntries": {
            "type": "boolean"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "defaultValue": {
            "nullable": true,
            "type": "string"
          },
          "description": {
            "description": "Optional description of the field.",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "locked": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "options": {
            "additionalProperties": true,
            "description": "Configuration options for the field, specific to its type. See the official documentation for the structure of each type.",
            "type": "object"
          },
          "readonly": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "type": {
            "description": "The type of the field.",
            "enum": [
              "SINGLE_LINE_TEXT",
              "CHECKBOX",
              "CURRENCY",
              "DATE",
              "DATETIME",
              "DURATION",
              "EMAIL",
              "SELECT",
              "NUMBER",
              "ATTACHMENT",
              "RATING",
              "LINKED_RECORD",
              "LONG_TEXT",
              "URL",
              "PERCENT",
              "PHONE",
              "LOOKUP",
              "ROLLUP",
              "FORMULA",
              "CREATED_AT",
              "UPDATED_AT",
              "CREATED_BY",
              "UPDATED_BY",
              "AUTONUMBER",
              "RECORD_ID",
              "USER"
            ],
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "TableView": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tableId": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "in": "header",
        "name": "Softr-Api-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Public API to communicate with Softr Databases. The API follows REST semantics and uses JSON to encode objects.\n\n**Rate Limiting:**\nAll calls are subject to rate limiting. On exceeding the limit, you will receive a 429 HTTP Response Status Code.\n- **Reads** (GET, POST /search): 40 requests/second per token.\n- **Writes** (POST, PUT, PATCH, DELETE): 30 requests/second per token.\n",
    "title": "Softr Database API",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.softr.io/openapi.yaml"
  },
  "openapi": "3.0.0",
  "paths": {
    "/databases": {
      "get": {
        "description": "Retrieve a list of all databases accessible to the authenticated user.",
        "operationId": "getDatabases",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/Database"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A list of databases."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Get Databases",
        "tags": [
          "Databases"
        ]
      },
      "post": {
        "description": "Create a new database in the specified workspace.",
        "operationId": "createDatabase",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "workspaceId": {
                    "type": "string"
                  }
                },
                "required": [
                  "workspaceId",
                  "name"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Database"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The newly created database."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Create a Database",
        "tags": [
          "Databases"
        ]
      }
    },
    "/databases/{databaseId}": {
      "delete": {
        "description": "Delete a specific database by its ID. It can only be deleted if it is empty, unless the 'force' parameter is used.",
        "operationId": "deleteDatabase",
        "parameters": [
          {
            "in": "query",
            "name": "force",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Database deleted successfully."
          },
          "400": {
            "description": "Bad Request - Database is not empty and force=true was not provided."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Delete Database",
        "tags": [
          "Databases"
        ]
      },
      "get": {
        "description": "Retrieve details of a specific database by its ID.",
        "operationId": "getDatabaseById",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Database"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Database details."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Get Single Database",
        "tags": [
          "Databases"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "databaseId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "description": "Update the details of an existing database.",
        "operationId": "updateDatabase",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Database"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The updated database."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Update Database",
        "tags": [
          "Databases"
        ]
      }
    },
    "/databases/{databaseId}/tables": {
      "get": {
        "description": "Retrieve a list of all tables in the specified database.",
        "operationId": "getTables",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/Table"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A list of tables."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Get Tables",
        "tags": [
          "Tables"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "databaseId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "description": "Create a new table in the specified database.",
        "operationId": "createTable",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "fields": {
                    "items": {
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "options": {
                          "additionalProperties": true,
                          "type": "object"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "name": {
                    "type": "string"
                  },
                  "primaryFieldName": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Table"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The newly created table."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Create Table",
        "tags": [
          "Tables"
        ]
      }
    },
    "/databases/{databaseId}/tables/{tableId}": {
      "delete": {
        "description": "Delete a specific table by its ID. It can only be deleted if it is empty, unless the 'force' parameter is used.",
        "operationId": "deleteTable",
        "parameters": [
          {
            "in": "query",
            "name": "force",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Table deleted successfully."
          },
          "400": {
            "description": "Bad Request - Table is not empty and force=true was not provided."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Delete Table",
        "tags": [
          "Tables"
        ]
      },
      "get": {
        "description": "Retrieve details of a specific table by its ID.",
        "operationId": "getTableById",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Table"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Table details."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Get Single Table",
        "tags": [
          "Tables"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "databaseId",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "tableId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "description": "Update a table's name and/or description. To modify fields, use the field-specific endpoints.",
        "operationId": "updateTable",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Table"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The updated table."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Update Table",
        "tags": [
          "Tables"
        ]
      }
    },
    "/databases/{databaseId}/tables/{tableId}/fields": {
      "parameters": [
        {
          "in": "path",
          "name": "databaseId",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "tableId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "description": "Add a new field to a table.",
        "operationId": "addTableField",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "options": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "type"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TableField"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The newly created field."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Add Table Field",
        "tags": [
          "Table Fields"
        ]
      }
    },
    "/databases/{databaseId}/tables/{tableId}/fields/{fieldId}": {
      "delete": {
        "description": "Delete a specific field from a table.",
        "operationId": "deleteTableField",
        "responses": {
          "204": {
            "description": "Field deleted successfully."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Delete Table Field",
        "tags": [
          "Table Fields"
        ]
      },
      "get": {
        "description": "Retrieve details of a specific field.",
        "operationId": "getTableField",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TableField"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Field details."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Get Table Field",
        "tags": [
          "Table Fields"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "databaseId",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "tableId",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "fieldId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "description": "Update the properties of a specific field.",
        "operationId": "updateTableField",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "options": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/TableField"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "The updated field."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Update Table Field",
        "tags": [
          "Table Fields"
        ]
      }
    },
    "/databases/{databaseId}/tables/{tableId}/records": {
      "get": {
        "description": "Retrieve a list of all records in the specified table.",
        "operationId": "getRecords",
        "parameters": [
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "default": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 10,
              "type": "integer"
            }
          },
          {
            "description": "If true, use field names as keys in the fields object instead of field IDs.",
            "in": "query",
            "name": "fieldNames",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "description": "Filter records by a specific view.",
            "in": "query",
            "name": "viewId",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/Record"
                      },
                      "type": "array"
                    },
                    "metadata": {
                      "$ref": "#/components/schemas/RecordListMetadata"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A paginated list of records."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Get Records",
        "tags": [
          "Records"
        ]
      },
      "parameters": [
        {
          "in": "path",
          "name": "databaseId",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "tableId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "description": "Create a new record in the specified table.",
        "operationId": "createRecord",
        "parameters": [
          {
            "description": "If true, use field names as keys in the response fields object instead of field IDs.",
            "in": "query",
