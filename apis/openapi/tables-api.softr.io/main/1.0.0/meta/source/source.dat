            "type": "string"
          }
        },
        {
          "in": "path",
          "name": "tableId",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "description": "Search for records in the specified table based on filter, sort, and pagination criteria.",
        "operationId": "searchRecords",
        "parameters": [
          {
            "description": "If true, use field names as keys in the fields object instead of field IDs.",
            "in": "query",
            "name": "fieldNames",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "filter": {
                    "properties": {
                      "condition": {
                        "$ref": "#/components/schemas/FilterCondition"
                      }
                    },
                    "type": "object"
                  },
                  "paging": {
                    "properties": {
                      "limit": {
                        "default": 10,
                        "type": "integer"
                      },
                      "offset": {
                        "default": 0,
                        "type": "integer"
                      }
                    },
                    "type": "object"
                  },
                  "sort": {
                    "items": {
                      "properties": {
                        "sortType": {
                          "enum": [
                            "ASC",
                            "DESC"
                          ],
                          "type": "string"
                        },
                        "sortingField": {
                          "description": "The Field ID to apply the sorting on",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/Record"
                      },
                      "type": "array"
                    },
                    "metadata": {
                      "$ref": "#/components/schemas/RecordListMetadata"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "A paginated list of matching records."
          },
          "429": {
            "description": "Rate limit exceeded."
          }
        },
        "summary": "Search Records",
        "tags": [
          "Records"
        ]
      }
    },
