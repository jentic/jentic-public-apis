        "x-meter-cost": 1,
        "x-idempotent": false,
        "parameters": [
          {
            "in": "path",
            "name": "page_id",
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Page ID from List pages"
            },
            "required": true,
            "description": "Page ID from List pages"
