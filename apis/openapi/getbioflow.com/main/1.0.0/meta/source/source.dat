          {
            "apiKeyBearer": []
          },
          {
            "apiKeyHeader": []
          }
        ],
        "x-scopes": [
          "contacts:read"
        ],
        "x-entitlement": "public_api",
        "x-meter-cost": 1,
        "x-idempotent": false,
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "in": "query",
            "name": "after",
            "schema": {
              "description": "Opaque cursor from a previous response",
              "type": "string"
            },
            "description": "Opaque cursor from a previous response"
