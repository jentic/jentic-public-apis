{
  "openapi": "3.0.1",
  "info": {
    "title": "Ses Questionarios",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/AURELIOCCAMARA/ses-questionarios/1.0.0"
  },
  "servers": [
    {
      "url": "https://ses-questionarios.api-hml.rota.sp.gov.br",
      "description": "Homologação"
    }
  ],
  "security": [
    {
      "IdpSP": []
    }
  ],
  "paths": {
    "/questionario/{id}": {
      "get": {
        "tags": [
          "questionarios"
        ],
        "summary": "Retorna o questionário",
        "description": "Retorna o questionário a ser respondido",
        "security": [
          {
            "IdpSP": [
              "api:integrador.ses-questionarios"
            ]
          }
        ],
        "operationId": "retornaQuestionario",
        "responses": {
          "200": {
            "description": "Retorna o questionário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Questionarios"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "description": "Acesso negado"
          },
          "204": {
            "description": "Nenhum questionário encontrado"
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/questionario/resultado": {
      "post": {
        "tags": [
          "questionarios"
        ],
        "summary": "Envia o resultado do questionário",
        "description": "Envia o resultado do questionário",
        "security": [
          {
            "IdpSP": [
              "api:integrador.ses-questionarios"
            ]
          }
        ],
        "operationId": "enviaResultadoQuestionario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResultadoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Envia o resultado do questionário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultadoResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "description": "Acesso negado"
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/paciente": {
      "post": {
        "tags": [
          "pacientes"
        ],
        "summary": "Cria um paciente",
        "description": "Cria ou atualiza um paciente com base no seu cpf",
        "security": [
          {
            "IdpSP": [
              "api:integrador.ses-questionarios"
            ]
          }
        ],
        "operationId": "criaPaciente",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Paciente"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cria um paciente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paciente"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "description": "Acesso negado"
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "UnauthorizedError": {
        "description": "Access token é invalido ou expirado"
      }
    },
    "securitySchemes": {
      "IdpSP": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://rhsso.idp-hml.sp.gov.br/auth/realms/idpsp/protocol/openid-connect/token",
            "scopes": {
              "api:integrador.ses-agendamento-mamografia": "Scope utilizado para todas as rotas",
              "api:integrador.ses-questionarios": "api:integrador.ses-questionarios"
            }
          },
          "authorizationCode": {
            "authorizationUrl": "https://rhsso.idp-hml.sp.gov.br/auth/realms/idpsp/protocol/openid-connect/auth",
            "tokenUrl": "https://rhsso.idp-hml.sp.gov.br/auth/realms/idpsp/protocol/openid-connect/token",
            "scopes": {
              "api:integrador.ses-agendamento-mamografia": "Scope utilizado para todas as rotas",
              "api:integrador.ses-questionarios": "api:integrador.ses-questionarios"
            }
          }
        }
      }
    },
    "schemas": {
      "Questionarios": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Questionário"
          },
          "description": {
            "type": "string",
            "example": "Descricão do questionário"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "example": 1
                },
                "text": {
                  "type": "string",
                  "example": "Pergunta 1"
                },
                "responses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 1
                      },
                      "text": {
                        "type": "string",
                        "example": "Resposta 1"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ResultadoRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "idAnswer": {
                  "type": "integer",
                  "example": 1
                },
                "idResponse": {
                  "type": "integer",
                  "example": 1
                }
              }
            }
          }
        }
      },
      "ResultadoResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "example": "Obteve o resultado"
          },
          "level": {
            "type": "string",
            "example": "Alto"
          }
        }
      },
      "Paciente": {
        "type": "object",
        "properties": {
          "federalId": {
            "type": "string",
            "example": "12345678901"
          },
          "address": {
            "type": "object",
            "properties": {
              "zipCode": {
                "type": "string",
                "example": "12345678"
              },
              "street": {
                "type": "string",
                "example": "Rua A"
              },
              "number": {
                "type": "integer",
                "example": "123"
              },
              "complement": {
                "type": "string"
              },
              "neighborhood": {
                "type": "string",
                "example": "Bairro A"
              },
              "city": {
                "type": "string",
                "example": "Cidade A"
              },
              "state": {
                "type": "string",
                "example": "SP"
              }
            }
          },
          "lifeWithoutAlcool": {
            "type": "object",
            "properties": {
              "dependencyLevel": {
                "type": "string",
                "example": "HIGH",
                "enum": [
                  "LOW_RISK",
                  "RISK",
                  "HIGH_RISK",
                  "HIGHEST_RISK"
                ]
              }
            }
          },
          "lifeWithoutNicotine": {
            "type": "object",
            "properties": {
              "dependencyLevel": {
                "type": "string",
                "example": "HIGH",
                "enum": [
                  "VERY_LOW_RISK",
                  "LOW_RISK",
                  "RISK",
                  "HIGH_RISK",
                  "HIGHEST_RISK"
                ]
              },
              "cigaretteType": {
                "type": "string",
                "example": "CIGARETTE",
                "enum": [
                  "CIGARETTE",
                  "ELETRONIC_CIGARETTE",
                  "HOOKAH",
                  "STRAW_CIGARETTE",
                  "CIGAR",
                  "CHEWABLE_TOBACCO",
                  "OTHER"
                ]
              }
            }
          },
          "patientName": {
            "type": "string",
            "example": "João da Silva"
          },
          "email": {
            "type": "string",
            "example": "8FtQ2@example.com"
          },
          "phone": {
            "type": "string",
            "example": "11912345678"
          },
          "motherName": {
            "type": "string",
            "example": "Maria da Silva"
          },
          "birthDate": {
            "type": "string",
            "example": "1980-01-01"
          },
          "maritalStatus": {
            "type": "string",
            "example": "SINGLE",
            "enum": [
              "SINGLE",
              "MARRIED",
              "SEPARATED",
              "DIVORCED",
              "CONSENSUAL_UNION",
              "LEGALLY_SEPARATED",
              "WIDOWED"
            ]
          },
          "gender": {
            "type": "string",
            "example": "MALE",
            "enum": [
              "MALE",
              "FEMALE"
            ]
          },
          "sexualOrientation": {
            "type": "string",
            "example": "HETEROSSEXUAL",
            "enum": [
              "HETEROSSEXUAL",
              "HOMOSSEXUAL",
              "BISSEXUAL",
              "PANSEXUAL",
              "ASSEXUAL",
              "DEMISSEXUAL",
              "QUEER",
              "ANOTHER",
              "NONE"
            ]
          },
          "race": {
            "type": "string",
            "example": "BLACK",
            "enum": [
              "BLACK",
              "BROWN",
              "WHITE",
              "INDIGENOUS",
              "YELLOW"
            ]
          },
          "education": {
            "type": "string",
            "example": "ELEMENTARY_INCOMPLETE",
            "enum": [
              "ELEMENTARY_INCOMPLETE",
              "ELEMENTARY_COMPLETE",
              "MIDDLE_INCOMPLETE",
              "MIDDLE_COMPLETE",
              "HIGH_SCHOOL_INCOMPLETE",
              "HIGH_SCHOOL_COMPLETE",
              "UNDERGRAD_INCOMPLETE",
              "UNDERGRAD_COMPLETE"
            ]
          },
          "monthlyIncome": {
            "type": "string",
            "example": "NO_INCOME",
            "enum": [
              "NO_INCOME",
              "UP_TO_2000",
              "FROM_2001_TO_5000",
              "FROM_5001_TO_7000",
              "FROM_7001_TO_9999",
              "ABOVE_10000",
              "PREFER_NOT_TO_ANSWER"
            ]
          },
          "canShareData": {
            "type": "boolean",
            "example": true
          }
        }
      }
    }
  }
}
