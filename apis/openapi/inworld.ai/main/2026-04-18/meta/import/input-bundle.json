{
  "openapi": "3.1.0",
  "info": {
    "title": "Inworld Public API",
    "version": "2026-04-18",
    "summary": "Public API entrypoints for Inworld voice and model APIs.",
    "description": "Machine-readable discovery document for the primary public API surfaces exposed by Inworld.",
    "x-jentic-source-url": "https://inworld.ai/.well-known/openapi.json"
  },
  "servers": [
    {
      "url": "https://api.inworld.ai"
    }
  ],
  "paths": {
    "/tts/v1/voice": {
      "post": {
        "summary": "Synthesize speech from text.",
        "description": "Returns JSON with base64-encoded audio content.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "voiceId": {
                    "type": "string"
                  },
                  "modelId": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Speech synthesis result."
          }
        }
      }
    },
    "/tts/v1/voice:stream": {
      "post": {
        "summary": "Stream synthesized speech.",
        "description": "Returns newline-delimited JSON chunks with base64-encoded audio content.",
        "responses": {
          "200": {
            "description": "Streaming speech synthesis result."
          }
        }
      }
    },
    "/voices/v1/voices": {
      "get": {
        "summary": "List available voices.",
        "responses": {
          "200": {
            "description": "Voice catalog."
          }
        }
      }
    },
    "/voices/v1/voices:clone": {
      "post": {
        "summary": "Clone a voice from reference audio.",
        "responses": {
          "200": {
            "description": "Voice clone created."
          }
        }
      }
    },
    "/stt/v1/transcribe": {
      "post": {
        "summary": "Transcribe audio to text.",
        "responses": {
          "200": {
            "description": "Transcription result."
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "OpenAI-compatible chat completions.",
        "description": "Routes requests across supported LLM providers.",
        "responses": {
          "200": {
            "description": "Completion result."
          }
        }
      }
    },
    "/v1/realtime/calls": {
      "post": {
        "summary": "Create a realtime WebRTC session.",
        "responses": {
          "200": {
            "description": "Realtime session negotiation result."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Send your Inworld API key in the Authorization header using the exact format `Basic <API_KEY>`. The API key is a raw value and must not be RFC7617 base64-encoded as `username:password` credentials."
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}