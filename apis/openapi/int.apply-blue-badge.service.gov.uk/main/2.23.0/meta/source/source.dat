          }
        }
      },
      "nonCustServ-LAContactFields": {
        "type": "object",
        "properties": {
          "contactName": {
            "type": "string",
            "example": "John Smith"
          },
          "contactNumber": {
            "type": "string",
            "example": 1616548765
          },
          "emailAddress": {
            "type": "string",
            "example": "june@bigbrainknitting.com"
          }
        }
      },
      "custServ-LAContactFields": {
        "type": "object",
        "properties": {
          "contactNumber": {
            "type": "string",
            "example": 1616548765
          },
          "emailAddress": {
            "type": "string",
            "example": "june@bigbrainknitting.com"
          }
        }
      },
      "SingleReferenceDataResponse": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/ReferenceData"
              }
            }
          }
        ]
      },
      "LADetails-Response": {
        "type": "object",
        "allOf": [
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/LADetailsResponse"
              }
            }
          },
          {
            "$ref": "#/components/schemas/CommonResponse"
          }
        ]
      },
      "ReferenceData": {
        "type": "object",
        "properties": {
          "shortCode": {
            "type": "string",
            "description": "Identifier of data item",
            "example": "AFRFCS"
          },
          "description": {
            "type": "string",
            "description": "Display value of data item",
            "example": "Armed Forces Compensation scheme"
          },
          "metaData": {
            "type": "object",
            "additionalProperties": true,
            "description": "JSON block of meta data for the item",
            "example": "{\"nation\":\"Scotland\"}"
          },
          "groupShortCode": {
            "type": "string",
            "description": "Group of data.",
            "example": "ELIGIBILIT"
          },
          "groupDescription": {
            "type": "string",
            "description": "Description of group",
            "example": "Eligibility"
          },
          "subgroupShortCode": {
            "type": "string",
            "description": "Id of a subgroup",
            "example": "ELIG_AUTO"
          },
          "subgroupDescription": {
            "type": "string",
            "description": "Display value of a sub group",
            "example": "Automatic"
          },
          "displayOrder": {
            "type": "integer",
            "description": "Order to display"
          }
        }
      },
      "LADetailsResponse": {
        "type": "object",
        "properties": {
          "shortCode": {
            "type": "string",
            "description": "Short code of the LA",
            "example": "ABERD"
          },
          "description": {
            "type": "string",
            "description": "Full name of the LA",
            "example": "Aberdeenshire Council"
          },
          "metaData": {
            "$ref": "#/components/schemas/LAMetaData-Response"
          },
          "dpoContactDetails": {
            "$ref": "#/components/schemas/DPOContactDetails"
          },
          "nfiDataReturn": {
            "$ref": "#/components/schemas/NFIDataReturn"
          },
          "laContactDetails": {
            "$ref": "#/components/schemas/LAContactDetails"
          },
          "groupShortCode": {
            "type": "string",
            "description": "Group of data."
          },
          "groupDescription": {
            "type": "string",
            "description": "Description of group"
          },
          "subgroupShortCode": {
            "type": "string",
            "description": "Id of a subgroup"
          },
          "subgroupDescription": {
            "type": "string",
            "description": "Display value of a sub group"
          },
          "displayOrder": {
            "type": "integer",
            "description": "Order to display"
          }
        }
      },
      "LAMetaData-Response": {
        "type": "object",
        "properties": {
          "town": {
            "type": "string",
            "description": "Town name to which the LA belongs to.",
            "example": "Inverurie"
          },
          "county": {
            "type": "string",
            "description": "County name to which the LA belongs to.",
            "example": "Aberdeenshire"
          },
          "nation": {
            "type": "string",
            "description": "Nation code to which the LA belongs to.",
            "example": "SCO"
          },
          "country": {
            "type": "string",
            "description": "Country to which the LA belongs to.",
            "example": "United Kingdom"
          },
          "postcode": {
            "type": "string",
            "description": "Postcode to which the LA belongs to.",
            "example": "AB51 5WX"
          },
          "badgeCost": {
            "type": "string",
            "description": "Cost of issuing badge by the LA.",
            "example": 20
          },
          "clockType": {
            "type": "string"
          },
          "nameLine2": {
            "type": "string",
            "description": "Name line 2."
          },
          "contactUrl": {
            "type": "string",
            "description": "Contact URL or website of the LA.",
            "example": "https://www.gov.uk"
          },
          "addressLine1": {
            "type": "string",
            "description": "Address line 1 of the address to which the LA belongs to.",
            "example": "Nothern Quarter"
          },
          "addressLine2": {
            "type": "string",
            "description": "Address line 2 of the address to which the LA belongs to.",
            "example": "January Street"
          },
          "addressLine3": {
            "type": "string",
            "description": "Address line 3 of the address to which the LA belongs to.",
            "example": "Near Tom Pizza house"
          },
          "addressLine4": {
            "type": "string",
            "description": "Address line 4 of the address to which the LA belongs to.",
            "example": "James Avenue"
          },
          "emailAddress": {
            "type": "string",
            "description": "Generic Email address of the LA.",
            "example": "june@bigbrainknitting.com"
          },
          "contactNumber": {
            "type": "string",
            "description": "Generic contact number of the LA.",
            "example": "01616548765"
          },
          "paymentsEnabled": {
            "type": "boolean",
            "description": "Whether payment enbaled for LA.",
            "example": true
          },
          "autoDeleteBadges": {
            "type": "boolean",
            "description": "Whether data retention rules apply for LA's badges. If they apply, then badges will be deleted from the system after set number of months.",
            "example": false
          },
          "welshDescription": {
            "type": "string",
            "description": "Full name of the LA in welsh language if applicable.",
            "example": "Cyngor Sir Aberdeen"
          },
          "autoDeleteApplications": {
            "type": "boolean",
            "description": "Whether data retention rules apply for LA's applications. If they apply, then applications will be deleted from the system after set number of months.",
            "example": true
          },
          "autoDeleteBadgesMonths": {
            "type": "integer",
            "description": "If data retention rules apply for LA's badges then they will be deleted from the system after this number of months.",
            "example": 28
          },
          "autoDeleteApplicationsMonths": {
            "type": "integer",
            "description": "If data retention rules apply for LA's applications then they will be deleted from the system after this number of months.",
            "example": 30
          },
          "badgeOrderedEmailEnabled": {
            "type": "boolean",
            "description": "Whether badge order email enabled for the LA.",
            "example": true
          },
          "badgeRenewalEmailEnabled": {
            "type": "boolean",
            "description": "Whether badge renewal email enabled for the LA.",
            "example": false
          },
          "differentServiceSignpostUrl": {
            "type": "string",
            "description": "Signpost website URL, if the LA is accepting new or renewal applications from, other than BBDS Gov.Uk site.",
            "example": "https://www.gov.uk"
          },
          "replacementDifferentServiceSignpostUrl": {
            "type": "string",
            "description": "Signpost website URL, if the LA is accepting replacement applications from, other than BBDS Gov.Uk site.",
            "example": "https://www.gov.uk"
          },
          "streamlinedCitizenReapplicationJourneyEnabled": {
            "type": "boolean",
            "description": "If the LA accepts streamlined reapplications from citizens on BBDS Gov.Uk site.",
            "example": true
          }
        }
      },
