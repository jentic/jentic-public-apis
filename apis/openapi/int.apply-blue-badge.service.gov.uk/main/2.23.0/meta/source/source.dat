            "type": "array",
            "items": {
              "$ref": "#/components/schemas/contact-details"
            }
          },
          "blueBadgeServiceManager": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/contact-details"
            }
          },
          "mobilityAssessmentManager": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/contact-details"
            }
          }
