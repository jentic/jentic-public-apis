      },
      "PartyTypeCodeField": {
        "type": "string",
        "enum": [
          "PERSON",
          "ORG"
        ],
        "example": "PERSON",
        "description": "This field mentions which party(PERSON/ORG) details are provided in the party section. This field is mandatory while submitting an application."
      },
      "ApplicationTypeCodeField": {
        "type": "string",
        "enum": [
          "NEW",
          "RENEW",
          "CANCEL",
          "REPLACE"
        ],
        "description": "The type of application being submitted. This needs to be passed in all submit application request.",
        "example": "NEW"
      },
      "EligibilityCodeField": {
        "type": "string",
        "enum": [
          "PIP",
          "PIPPLAN",
          "DLA",
          "AFRFCS",
          "WPMS",
          "BLIND",
          "WALKD",
          "ARMS",
          "CHILDBULK",
          "CHILDVEHIC",
          "TERMILL",
          "HIDDEN",
          "COMBINED",
          "CDP",
          "ADP",
          "SRTIADP"
        ],
        "example": "PIP"
      },
      "GenderCodeField": {
        "type": "string",
        "enum": [
          "FEMALE",
          "MALE",
          "UNSPECIFIE"
        ],
        "description": "Gender of the applicant. This is mandatory while submitting an application.",
        "example": "FEMALE"
      },
      "VehicleTypeCodeField": {
        "type": "string",
        "enum": [
          "CAR",
          "PEOPLECAR",
          "MINIBUS",
          "OTHERVEH"
        ],
        "example": "CAR",
        "description": "This field is applicable only for Organisation application and is optional while submitting an application."
      },
      "BulkyMedicalEquipmentTypeCodeField": {
        "type": "string",
        "enum": [
          "CAST",
          "OXYSAT",
          "OXYADMIN",
          "SYRINGE",
          "PARENT",
          "PUMP",
          "SUCTION",
          "VENT",
          "OTHER",
          "NONE"
        ],
        "example": "CAST",
        "description": "NONE is deprecated"
      },
      "WalkingDifficultyTypeCodeField": {
        "type": "string",
        "enum": [
          "PAIN",
          "BREATH",
          "BALANCE",
          "DANGER",
          "STRUGGLE",
          "SOMELSE",
          "LONGTIME"
        ],
        "example": "PAIN"
      },
      "WalkingLengthOfTimeCodeField": {
        "type": "string",
        "enum": [
          "CANTWALK",
          "LESSMIN",
          "FEWMIN",
          "MORETEN",
          "ONEFIVE",
          "FIVETEN"
        ],
        "example": "CANTWALK"
      },
      "WalkingPainTypeCodeField": {
        "type": "string",
        "enum": [
          "COPE",
          "BREAKS",
          "SICK",
          "UNBEARABLE",
          "OTHER"
        ],
        "example": "BREAKS"
      },
      "WalkingBalanceTypeCodeField": {
        "type": "string",
        "enum": [
          "SUPERMARKE",
          "STAIRS",
          "INDOORS",
          "SHOPPING",
          "OTHER"
        ]
      },
      "WalkingSpeedCodeField": {
        "description": "Required if able to walk, i.e. Walking length of time not cannot walk.",
        "type": "string",
        "enum": [
          "MSLOW",
          "SLOW",
          "SAME",
          "FAST"
        ],
        "example": "SLOW"
      },
      "HowProvidedCodeField": {
        "type": "string",
        "enum": [
          "PRESCRIBE",
          "PRIVATE",
          "SOCIAL",
          "PERSON"
        ],
        "example": "PRIVATE"
      },
      "ApplicationStatusField": {
        "type": "string",
        "enum": [
          "TODO",
          "INPROGRESS",
          "COMPLETED"
        ],
        "example": "TODO",
        "description": "The new application status"
      },
      "BreathlessnessTypeCodeField": {
        "type": "string",
        "enum": [
          "UPHILL",
          "KEEPUP",
          "OWNPACE",
          "DRESSED",
          "OTHER"
        ],
        "example": "UPHILL",
        "description": "Further breathlessness information"
      },
      "AssessmentTypeField": {
        "type": "string",
        "example": "PHONE",
        "description": "**A short code to describe type of assessment performed on any discretionary eligibilities. This is REQUIRED only for discretionary eligibilities.**<br> \nPossible values are -\n* DESK (Desk based assessment)\n* PHONE (Phone assessment)\n* PERSON (In person assessment)\n* APPEAL (After appeal)\n* GP<br>\nGP is ONLY accepted by Welsh authorities.\n"
      },
      "PlanningFrequencyCodeField": {
        "type": "string",
        "description": "A short code to describe how frequently an applicant struggles to plan a journey.",
        "enum": [
          "UNFAMILIAR",
          "EVERY"
        ],
        "example": "EVERY"
      },
      "JourneyFrequencyCodeField": {
        "type": "string",
        "description": "A short code to describe how frequently an applicant finds it difficult in a journey",
        "enum": [
          "ALMOSNEVER",
          "SOMETIMES",
          "ALMOSEVERY",
          "EVERY"
        ]
      },
      "ReplaceReasonCodeField": {
        "type": "string",
        "description": "A short code to explain why badge replacement application is needed. This is mandatory for a REPLACE type of application being submitted.",
        "enum": [
          "DAMAGED",
          "LOST",
          "STOLEN",
          "UNDELIVER"
        ]
      },
      "PipPlanningJourneyCodeField": {
        "type": "string",
        "description": "A short code to indicate which option was selected by applicant after entering score for planning and following journey activity of assessment.",
        "enum": [
          "UNFAMILIAR",
          "OVERWHELM"
        ],
        "example": "OVERWHELM"
      },
      "BenefitEntitlementCheckCodeField": {
        "type": "string",
        "description": "Optional short codes which allow an LA to indicate how a PIP or DLA application was checked for eligibility. This field can be excluded from payload if not applicable. One or more values can be passed at a time for this field as applicable.",
        "enum": [
          "SEARCHLIGHT",
          "APOLLOPHONE",
          "APOLLOEMAIL",
          "DOCUPLOAD"
        ],
        "example": "SEARCHLIGHT"
      },
      "ChangedPersonalDetailsCodeField": {
        "type": "string",
        "description": "Optional short codes representing the details that have changed since the badge was issued.",
        "enum": [
          "ADDRESS",
          "NAME",
          "PHONE",
          "EMAIL"
        ],
        "example": "ADDRESS"
      },
      "EligibilityQualificationData": {
        "type": "object",
        "description": "'Any qualifying data related to the eligibility is present within this object. It has another object within it specific to a eligibility. That object will contain the data.'\n",
        "properties": {
          "dla": {
            "type": "object",
            "description": "'Any qualifying data relating to DLA eligibility only.'\n",
            "properties": {
              "isSADLABadge": {
                "type": "boolean",
                "example": true,
                "description": "'This field will indicate whether the badge was ordered under SADLA category of DLA eligibility. This is only applicable in Scotland so only applies when applying to Scottish LA.'"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "OAuth2": [
        "admin"
      ]
    }
  ]
}
