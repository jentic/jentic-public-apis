    "/reference-data/authorities/nfi-preference/{shortCode}": {
      "parameters": [
        {
          "in": "path",
          "name": "shortCode",
          "description": "Local Authority short code",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "tags": [
          "Reference Data"
        ],
        "summary": "Update Local Authority NFI Preference",
        "description": "Restricted to admin Web App",
        "operationId": "updateLocalAuthorityNFIPreference",
        "security": [
          {
            "OAuth2": [
              "admin"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Ok."
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          },
          "404": {
            "description": "Local Authority not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalAuthorityNFIPreference"
              }
            }
          },
          "description": "Local authority NFI preference",
          "required": true
        }
      }
    },
    "/reference-data/authorities/contactDetails/{shortCode}": {
      "parameters": [
        {
          "in": "path",
          "name": "shortCode",
          "description": "Local Authority short code",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "tags": [
          "Reference Data"
        ],
        "summary": "Update Local Authority Contact Details",
        "description": "Restricted to Admin Web App but other roles can access details in read-only mode in Web App",
        "operationId": "updateLocalAuthorityContactDetails",
        "security": [
          {
            "OAuth2": [
              "admin"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Ok."
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          },
          "404": {
            "description": "Local Authority not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocalAuthorityContactDetails"
              }
            }
          },
          "description": "Local authority Contact Details - though each contact type is an array/list type, currently only one set of contact detail is accepted under each contact type.",
          "required": true
        }
      }
    }
  },
  "servers": [
    {
      "url": "https://api.int.apply-blue-badge.service.gov.uk/",
      "description": "Test environment"
    },
    {
      "url": "https://virtserver.swaggerhub.com/dft-bluebadge/blue-badge/1.0.0"
    }
  ],
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.int.apply-blue-badge.service.gov.uk/oauth/token",
            "scopes": {
              "admin": "admin"
            }
          },
          "authorizationCode": {
            "authorizationUrl": "https://api.int.apply-blue-badge.service.gov.uk/oauth/token",
            "tokenUrl": "https://api.int.apply-blue-badge.service.gov.uk/oauth/token",
            "scopes": {
              "admin": "Admin access"
            }
          }
        }
      }
    },
    "parameters": {
      "BadgeNumberParam": {
        "in": "query",
        "name": "badgeNumber",
        "description": "A valid badge number.",
        "schema": {
          "type": "string"
        }
      },
      "BadgeNumberPathParam": {
        "in": "path",
        "name": "badgeNumber",
        "description": "A valid badge number.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "NameParam": {
        "in": "query",
        "name": "name",
        "description": "Search the badge holder's name.",
        "schema": {
          "type": "string",
          "maxLength": 100
        }
      },
      "PostCodeParam": {
        "in": "query",
        "name": "postCode",
        "description": "A valid postcode with or without spaces. It should be an exact match.",
        "schema": {
          "type": "string",
          "maxLength": 20
        }
      },
      "NinoParam": {
        "in": "query",
        "name": "nino",
        "description": "A valid nino with or without spaces. It should be an exact match.",
        "example": "BN102966C",
        "schema": {
          "type": "string"
        }
      },
      "PartyTypeCodeParam": {
        "in": "query",
        "name": "partyTypeCode",
        "description": "A valid party type code. It should be an exact match",
        "example": "PERSON",
        "schema": {
          "type": "string",
          "enum": [
            "PERSON",
            "ORG"
          ]
        }
      },
      "StatusesParam": {
        "in": "query",
        "name": "statuses",
        "description": "A valid status or comma separated list of statuses. It will return any badges in any of the provided statuses.",
        "example": "ORDERED,ISSUED",
        "schema": {
          "type": "string",
          "enum": [
            "ISSUED",
            "CANCELLED",
            "REPLACED",
            "ORDERED",
            "PREPROCESS",
            "PROCESSED",
            "REJECT"
          ]
        }
      },
      "StartDateFromParam": {
        "in": "query",
        "name": "startDateFrom",
        "description": "A valid date in format 'yyyy-MM-dd'. It will return all badges which start date is equal or after the startDateFrom.",
        "example": "2019-05-01",
        "schema": {
          "type": "string",
          "format": "date"
        }
      },
      "StartDateToParam": {
        "in": "query",
        "name": "startDateTo",
        "description": "A valid date in format 'yyyy-MM-dd'. It will return all badges which start date is equal or before the startDateTo.",
        "example": "2019-05-31",
        "schema": {
          "type": "string",
          "format": "date"
        }
      },
      "ExpiryDateFromParam": {
        "in": "query",
        "name": "expiryDateFrom",
        "description": "A valid date in format 'yyyy-MM-dd'. It will return all badges which expiry date is equal or after the expiryDateFrom.",
        "example": "2019-05-01",
        "schema": {
          "type": "string",
          "format": "date"
        }
      },
      "ExpiryDateToParam": {
        "in": "query",
        "name": "expiryDateTo",
        "description": "A valid date in format 'yyyy-MM-dd'. It will return all badges which expiry date is equal or before the expiryDateTo.",
        "example": "2019-05-31",
        "schema": {
          "type": "string",
          "format": "date"
        }
      },
      "EligibilityCodeParam": {
        "in": "query",
        "name": "eligibilityCode",
        "description": "A single and valid eligibility code. It will return any badges in belonging to the this eligibility code.",
        "example": "BLIND",
        "schema": {
          "type": "string",
          "enum": [
            "AFRFCS",
            "ARMS",
            "BLIND",
            "CHILDBULK",
            "CHILDVEHIC",
            "COGNITIVE",
            "DLA",
            "PIP",
            "PIPPLAN",
            "TRAF_RISK",
            "WALKD",
            "WPMS",
            "HIDDEN",
            "ADP"
          ]
        }
      },
      "OrderedDateFromParam": {
        "in": "query",
        "name": "orderedDateFrom",
        "description": "A valid date in format 'yyyy-MM-dd'. It will return all badges where order date is equal or after the orderedDateFrom.",
        "example": "2019-05-01",
        "schema": {
          "type": "string",
          "format": "date"
        }
      },
      "OrderedDateToParam": {
        "in": "query",
        "name": "orderedDateTo",
        "description": "A valid date in format 'yyyy-MM-dd'. It will return all badges where order date is equal or before the orderedDateTo.",
        "example": "2019-05-31",
        "schema": {
          "type": "string",
          "format": "date"
        }
      },
      "IssuedDateFromParam": {
        "in": "query",
        "name": "issuedDateFrom",
        "description": "A valid date in format 'yyyy-MM-dd'. It will return all badges where issued date is equal or after the issuedDateFrom.",
        "example": "2019-05-01",
        "schema": {
          "type": "string",
          "format": "date"
        }
      },
      "IssuedDateToParam": {
        "in": "query",
        "name": "issuedDateTo",
        "description": "A valid date in format 'yyyy-MM-dd'. It will return all badges where issued date is equal or before the issuedDateTo.",
        "example": "2019-05-31",
        "schema": {
          "type": "string",
          "format": "date"
        }
      },
      "PageNumParam": {
        "in": "query",
        "name": "pageNum",
        "description": "The page to return. Must be a positive number. Default is 1.",
        "schema": {
          "type": "integer"
        }
      },
      "PageSizeParam": {
        "in": "query",
        "name": "pageSize",
        "description": "The number of results. Min 1 max 200. Default 50",
        "schema": {
          "type": "integer"
        }
      },
      "ApplicationIdPathParam": {
        "in": "path",
        "name": "applicationId",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "CommonResponse": {
        "type": "object",
        "properties": {
          "context": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          },
          "pagingInfo": {
            "$ref": "#/components/schemas/PagingInfo"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "locationType": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "PagingInfo": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "The total number of results for the search."
          },
          "count": {
            "type": "integer",
            "description": "The number of results included within the response"
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of results per page. Equivalent to the page limit"
          },
          "pageNum": {
            "type": "integer",
            "description": "The index of the first result included within the response, within the total results"
          },
          "pages": {
            "type": "integer",
            "description": "Total number of pages for the given page limit"
          }
        }
      },
      "BadgeNumberResponse": {
        "description": "Returns a badge number.",
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "string",
                "example": 95715,
                "description": "The unique badge number for this badge."
              }
            }
          }
        ]
      },
      "BadgeCancelRequest": {
        "type": "object",
        "properties": {
          "badgeNumber": {
            "type": "string",
            "example": "72B9HA",
            "description": "The unique badge number for this badge."
          },
          "cancelReasonCode": {
            "type": "string",
            "enum": [
              "REVOKE",
              "DECEASE",
              "NOLONG",
              "UNDELIVER",
              "LOST",
              "STOLE",
              "DAMAGED"
            ],
            "description": "The reason for cancelling the badge expressed in codes. It is one of the following - REVOKE (Revoked), DECEASE (Deceased), NOLONG (No longer needed), UNDELIVER (Undelivered - Lost in post), LOST (Lost), STOLE (Stolen), DAMAGED (Damaged).\n",
            "example": "REVOKE"
          }
        },
        "required": [
          "badgeNumber",
          "cancelReasonCode"
        ]
      },
      "BadgeReplaceRequest": {
        "type": "object",
        "properties": {
          "badgeNumber": {
            "type": "string",
            "description": "The unique badge number for this badge.",
            "example": "72B9HA"
          },
          "replaceReasonCode": {
            "type": "string",
            "maxLength": 10,
            "enum": [
              "STOLE",
              "LOST",
              "DAMAGED",
              "UNDELIVER"
            ],
            "description": "The reason for replacing the provided Blue Badge expressed in code. It is one of the following - STOLE (Stolen), LOST (Lost), DAMAGED (Damaged), UNDELIVER (Undelivered - Lost in post).",
            "example": "STOLE"
          },
          "deliverToCode": {
            "type": "string",
            "maxLength": 10,
            "enum": [
              "COUNCIL",
              "HOME"
            ],
            "description": "To whom would the new Blue Badge be delivered expressed in code. It is one of the following - COUNCIL, HOME.",
            "example": "HOME"
          },
          "deliveryOptionCode": {
            "type": "string",
            "maxLength": 10,
            "enum": [
              "STAND",
              "FAST"
            ],
            "description": "Through which mode of delivery (Standard / Fasttrack) would the new Blue Badge be delivered expressed in code. It is one of the following - STAND, FAST.",
            "example": "STAND"
          }
        },
        "required": [
          "badgeNumber",
          "replaceReasonCode",
          "deliverToCode",
          "deliveryOptionCode"
        ]
      },
      "BadgeNumbersResponse": {
        "description": "Contains a list of Badge numbers.",
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "string",
                  "example": 95215,
                  "description": "The unique badge number for this badge."
                }
              }
            }
          }
        ]
      },
      "BadgesResponse": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/BadgeSummary"
                }
              }
            }
          }
        ]
      },
      "BadgeResponse": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/Badge"
              }
            }
          }
        ]
      },
      "BadgeEnforcementResponse": {
        "$ref": "#/components/schemas/BadgeEnforcement"
      },
      "BadgeSummary": {
        "type": "object",
        "properties": {
          "badgeNumber": {
            "type": "string",
            "description": "The unique badge number for this badge.",
            "example": 95215
          },
          "partyTypeCode": {
            "type": "string",
            "enum": [
              "PERSON",
              "ORG"
            ],
            "description": "The party to which the badge details belong to. It is either for a Person (PERSON) or an Organisation (ORG).",
            "example": "PERSON"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "description": "The name of the badge holder Organisation or Person",
            "example": "Ms Mary Inglethorpe"
          },
          "nino": {
            "type": "string",
            "pattern": "^(?!BG)(?!GB)(?!NK)(?!KN)(?!TN)(?!NT)(?!ZZ)(?:[A-CEGHJ-PR-TW-Z][A-CEGHJ-NPR-TW-Z])(?:\\s*\\d\\s*){6}([A-D]|\\s)$",
            "description": "The badge holder's National Insurance number.",
            "example": "NY186548E"
          },
          "localAuthorityShortCode": {
            "type": "string",
            "description": "Short code of local authority",
            "pattern": "^[A-Z]+$",
            "example": "BLACK"
          },
          "postCode": {
            "type": "string",
            "example": "SK6 8GH",
            "pattern": "^[A-Za-z]{1,2}[0-9][0-9A-Za-z]?\\s?[0-9][A-Za-z]{2}$"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "The date the Blue Badge starts.",
            "example": "2018-06-10"
          },
          "expiryDate": {
            "type": "string",
            "format": "date",
            "description": "The date the Blue Badge expires.",
            "example": "2019-06-10"
          },
          "statusCode": {
            "type": "string",
            "enum": [
              "ISSUED",
              "CANCELLED",
              "REPLACED",
              "ORDERED",
              "PREPROCESS",
              "PROCESSED",
              "REJECT"
            ],
            "description": "The current status of the badge. It can be one of the following - ISSUED, CANCELLED, REPLACED, ORDERED, PREPROCESS (internal transient status), PROCESSED, REJECT.",
            "example": "ISSUED"
          },
          "eligibilityCode": {
            "type": "string",
            "enum": [
              "ADP",
              "AFRFCS",
              "CDP",
              "CHILDVEHIC",
              "CHILDBULK",
              "COGNITIVE",
              "DLA",
              "ARMS",
              "HIDDEN",
              "PIP",
              "PIPPLAN",
              "BLIND",
              "TRAF_RISK",
              "WALKD",
              "WPMS"
            ],
            "description": "**The eligibility under which the badge was awarded. It can be one of the following ** - \n  * ADP (Adult Disability Payment)\n  * AFRFCS (Armed Forces Compensation Scheme)\n  * CDP (Child Disability Payment)\n  * CHILDVEHIC (Child under 3 who needs to be near a vehicle)\n  * CHILDBULK (Child under 3 with bulky medical equipment)\n  * COGNITIVE (Cognitive impairment)\n  * DLA (Disability Living Allowance)\n  * ARMS (Disability in both arms)\n  * HIDDEN (Non-visible (hidden))\n  * PIP (Personal Independence Payment)\n  * PIPPLAN (PIP - Non-visible (hidden))\n  * BLIND (Registered blind)\n  * TRAF_RISK (Risk in traffic)\n  * WALKD (Walking ability)\n  * WPMS (War Pensioners' Mobility Supplement)\n",
            "example": "BLIND"
          },
          "orderedDate": {
            "type": "string",
            "format": "date",
            "description": "The date the Blue Badge was ordered.",
            "example": "2019-06-10"
          },
          "issuedDate": {
            "type": "string",
            "format": "date-time",
            "description": "The datetime the badge was issued.",
            "example": "2019-06-11T11:14:00"
          },
          "benefitEntitlementCheck": {
            "$ref": "#/components/schemas/BenefitEntitlementCheckCodeField"
          }
        }
      },
      "Badge": {
        "type": "object",
        "properties": {
          "badgeNumber": {
            "type": "string",
            "example": 91215,
            "description": "The unique badge number for this badge."
          },
          "party": {
            "$ref": "#/components/schemas/Party"
          },
          "localAuthorityShortCode": {
            "type": "string",
            "description": "Short code of local authority",
            "pattern": "^[A-Z]+$",
            "example": "BLACK"
          },
          "localAuthorityRef": {
            "type": "string",
            "description": "A reference to enable local authorities to link this badge to records in other systems",
            "example": "YOURREF"
          },
          "applicationDate": {
            "type": "string",
            "format": "date",
            "description": "The date that the initial application was received by the issuing local authority.",
            "example": "2017-07-21"
          },
          "applicationChannelCode": {
            "type": "string",
            "enum": [
              "ONLINE",
              "PAPER",
              "PHONE",
              "INPERSON"
            ],
            "description": "The channel through which the application was received, expressed as code. It can be one of the following - ONLINE, PAPER, PHONE or INPERSON.",
            "example": "INPERSON"
          },
          "orderDate": {
            "type": "string",
            "format": "date",
            "description": "The date that the badge was ordered by the issuing local authority.",
            "example": "2018-07-07"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "The date that the badge comes into effect.",
            "example": "2018-07-07"
          },
          "expiryDate": {
            "type": "string",
            "format": "date",
            "description": "The date the badge expires.",
            "example": "2019-06-31"
          },
          "eligibilityCode": {
            "type": "string",
            "enum": [
              "ADP",
              "AFRFCS",
              "CDP",
              "CHILDVEHIC",
              "CHILDBULK",
              "COGNITIVE",
              "DLA",
              "ARMS",
              "HIDDEN",
              "PIP",
              "PIPPLAN",
              "BLIND",
              "TRAF_RISK",
              "WALKD",
              "WPMS"
            ],
            "description": "**The eligibility under which the badge was awarded. It can be one of the following ** - \n  * ADP (Adult Disability Payment)\n  * AFRFCS (Armed Forces Compensation Scheme)\n  * CDP (Child Disability Payment)\n  * CHILDVEHIC (Child under 3 who needs to be near a vehicle)\n  * CHILDBULK (Child under 3 with bulky medical equipment)\n  * COGNITIVE (Cognitive impairment)\n  * DLA (Disability Living Allowance)\n  * ARMS (Disability in both arms)\n  * HIDDEN (Non-visible (hidden))\n  * PIP (Personal Independence Payment)\n  * PIPPLAN (PIP - Non-visible (hidden))\n  * BLIND (Registered blind)\n  * TRAF_RISK (Risk in traffic)\n  * WALKD (Walking ability)\n  * WPMS (War Pensioners' Mobility Supplement)\n",
            "example": "WALKD"
          },
          "notForReassessment": {
            "type": "boolean",
            "nullable": true,
            "description": "A flag to indicate future re-assessment is required for this applicant. This flag is NULL for organisation and automatic eligible person.",
            "example": true
          },
          "imageLink": {
            "type": "string",
            "maxLength": 255,
            "description": "A URL for the badge photo.",
            "example": "http://tiny.url?q=ab63fg"
          },
          "cancelReasonCode": {
            "type": "string",
            "enum": [
              "REVOKE",
              "DECEASE",
              "NOLONG",
              "UNDELIVER",
              "LOST",
              "STOLE",
              "DAMAGED"
            ],
            "description": "The reason for cancelling the badge expressed in codes. It is one of the following - REVOKE (Revoked), DECEASE (Deceased), NOLONG (No longer needed), UNDELIVER (Undelivered - Lost in post), LOST (Lost), STOLE (Stolen), DAMAGED (Damaged).\n",
            "example": "NOLONG"
          },
          "replaceReasonCode": {
            "type": "string",
            "maxLength": 10,
            "enum": [
              "STOLE",
              "LOST",
              "DAMAGED",
              "UNDELIVER"
            ],
            "description": "The reason for replacing the provided Blue Badge expressed in code. It is one of the following - STOLE (Stolen), LOST (Lost), DAMAGED (Damaged), UNDELIVER (Undelivered - Lost in post).",
            "example": "STOLE"
          },
          "statusCode": {
            "type": "string",
            "enum": [
              "ISSUED",
              "CANCELLED",
              "REPLACED",
              "ORDERED",
              "PREPROCESS",
              "PROCESSED",
              "REJECT"
            ],
            "description": "The current status of the badge. It can be one of the following - ISSUED, CANCELLED, REPLACED, ORDERED, PREPROCESS (internal transient status), PROCESSED, REJECT.",
            "example": "CANCELLED"
          },
          "issuedDate": {
            "type": "string",
            "format": "date-time",
            "description": "The datetime the badge was issued.",
            "example": "2019-03-07T01:01:00"
          },
          "printRequestDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "The datetime the badge was sent to print.",
            "example": "2019-03-07T01:01:00"
          },
          "rejectedReason": {
            "type": "string",
            "description": "The reason a badge was rejected by print provider",
            "example": "missing values"
          },
          "transferredFromLaCode": {
            "type": "string",
            "description": "Local Authority that transferred the badge to current Authority.",
            "example": "ABCD"
          },
          "deliverToCode": {
            "type": "string",
            "example": "HOME",
            "enum": [
              "COUNCIL",
              "HOME"
            ],
            "description": "To whom would the new Blue Badge be delivered expressed in code. It is one of the following - COUNCIL, HOME."
          },
          "transferredFromDateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2019-03-07T01:01:00"
          },
          "cancelledDateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2019-03-07T01:01:00Z"
          },
          "replacedDateTime": {
            "type": "string",
            "format": "date-time",
            "example": "2019-03-07T01:01:00Z"
          },
          "benefitEntitlementCheck": {
            "$ref": "#/components/schemas/BenefitEntitlementCheckCodeField"
          },
          "eligibilityQualificationData": {
            "$ref": "#/components/schemas/EligibilityQualificationData"
          }
        }
      },
      "BadgeEnforcement": {
        "type": "object",
        "properties": {
          "badgeNumber": {
            "type": "string",
            "example": "NNNNNN",
            "description": "The unique badge number for this badge."
          },
          "partyTypeCode": {
            "type": "string",
            "maxLength": 10,
            "enum": [
              "PERSON",
              "ORG"
            ],
            "description": "The party to which the badge details belong to. It is either for a Person (PERSON) or an Organisation (ORG).",
            "example": "PERSON"
          },
          "holderName": {
            "type": "string",
            "example": "Dwight Appleman",
            "description": "Badge holder name - Person or Organisation name"
          },
          "gender": {
            "$ref": "#/components/schemas/GenderCodeField"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "example": "1972-09-13"
          },
          "localAuthority": {
            "type": "string",
            "description": "Short code of local authority",
            "pattern": "^[A-Z]+$",
            "example": "NIRE"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "The date that the badge comes into effect.",
            "example": "2018-07-07"
          },
          "expiryDate": {
            "type": "string",
            "format": "date",
            "description": "The date the badge expires.",
            "example": "2019-06-31"
          },
          "statusCode": {
            "type": "string",
            "enum": [
              "ISSUED",
              "CANCELLED",
              "REPLACED",
              "ORDERED",
              "PREPROCESS",
              "PROCESSED",
              "REJECT"
            ],
            "description": "The current status of the badge. It can be one of the following - ISSUED, CANCELLED, REPLACED, ORDERED, PREPROCESS (internal transient status), PROCESSED, REJECT.",
            "example": "CANCELLED"
          },
          "cancelledReason": {
            "type": "string",
            "enum": [
              "REVOKE",
              "DECEASE",
              "NOLONG",
              "UNDELIVER",
              "LOST",
              "STOLE",
              "DAMAGED"
            ],
            "description": "The reason for cancelling the badge expressed in codes. It is one of the following - REVOKE (Revoked), DECEASE (Deceased), NOLONG (No longer needed), UNDELIVER (Undelivered - Lost in post), LOST (Lost), STOLE (Stolen), DAMAGED (Damaged).\n",
            "example": "NOLONG"
          },
          "replacedReason": {
            "type": "string",
            "enum": [
              "STOLE",
              "LOST",
              "DAMAGED",
              "UNDELIVER"
            ],
            "description": "The reason for replacing the provided Blue Badge expressed in code. It is one of the following - STOLE (Stolen), LOST (Lost), DAMAGED (Damaged), UNDELIVER (Undelivered - Lost in post).",
            "example": "STOLE"
          },
          "rejectedReason": {
            "type": "string",
            "description": "The reason a badge was rejected by print provider",
            "example": "missing values"
          },
          "imageLink": {
            "type": "string",
            "description": "Pre-signed AWS S3 URL of the badge holder photo if it exists on BBDS. If the badge currently belongs to Northern Ireland, the photo is not returned, even though it exists, due to policy."
          }
        }
      },
      "BadgeOrderRequest": {
        "type": "object",
        "properties": {
          "party": {
            "$ref": "#/components/schemas/Party"
          },
          "localAuthorityShortCode": {
            "type": "string",
            "example": "ABERD",
            "pattern": "^[A-Z]+$",
            "description": "Short code of local authority."
          },
          "localAuthorityRef": {
            "type": "string",
            "maxLength": 100,
            "example": "YOURCODE"
          },
          "applicationDate": {
            "type": "string",
            "format": "date",
            "example": "2017-07-21",
            "description": "The date that the initial application was received by the issuing local authority."
          },
          "applicationChannelCode": {
            "type": "string",
            "maxLength": 10,
            "example": "ONLINE",
            "enum": [
              "ONLINE",
              "PAPER",
              "PHONE",
              "INPERSON"
            ],
            "description": "The channel through which the application was received, expressed as code. It can be one of the following - ONLINE, PAPER, PHONE or INPERSON."
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "example": "2019-06-30",
            "description": "Cannot be in the past."
          },
          "expiryDate": {
            "type": "string",
            "format": "date",
            "example": "2019-07-01",
            "description": "The date the Blue Badge expires. Must be greater than 7 days and within 3 years of start date.\n"
          },
          "eligibilityCode": {
            "type": "string",
            "example": "CHILDBULK",
            "description": "**A shortcode for the badge eligibility.**<br> Possible values - \n  * ADP (Adult Disability Payment)\n  * AFRFCS (Armed Forces Compensation Scheme)\n  * CDP (Child Disability Payment)\n  * CHILDVEHIC (Child under 3 who needs to be near a vehicle)\n  * CHILDBULK (Child under 3 with bulky medical equipment)\n  * COGNITIVE (Cognitive impairment)\n  * DLA\n  * ARMS (Disability in both arms)\n  * HIDDEN (Non-visible (hidden))\n  * PIP\n  * PIPPLAN (PIP - Non-visible (hidden))\n  * BLIND (Registered blind)\n  * TRAF_RISK (Risk in traffic)\n  * WALKD (Walking ability)\n  * WPMS (War Pensioners' Mobility Supplement)\n"
          },
          "notForReassessment": {
            "type": "boolean",
            "nullable": true,
            "description": "A flag to indicate future re-assessment is not required for this applicant. This flag is NULL for organisation and automatic eligibility person. It is optional for discretionary eligibility person badges. NULL, true or false can be set for discretionary eligibility person badges.",
            "example": true
          },
          "assessmentType": {
            "$ref": "#/components/schemas/AssessmentTypeField"
          },
          "imageFile": {
            "type": "string",
            "description": "Base64 encoded.  Must be less than 20MB, and of format JPG, PNG, or GIF."
          },
          "deliverToCode": {
            "type": "string",
            "maxLength": 10,
            "example": "HOME",
            "enum": [
              "COUNCIL",
              "HOME"
            ],
            "description": "To whom would the new Blue Badge be delivered expressed in code. It is one of the following - COUNCIL, HOME."
          },
          "deliveryOptionCode": {
            "type": "string",
            "maxLength": 10,
            "example": "STAND",
            "enum": [
              "STAND",
              "FAST"
            ],
            "description": "Through which mode of delivery (Standard / Fasttrack) would the new Blue Badge be delivered expressed in code. It is one of the following - STAND, FAST."
          },
          "numberOfBadges": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999,
            "example": 1,
            "description": "Must be 1 for a person, can be multiple for an organisation."
          },
          "benefitEntitlementCheck": {
            "type": "array",
            "description": "'Optional short codes which allow an LA to indicate how a PIP or DLA application was checked for eligibility. This field can be excluded from payload if not applicable. One or more values can be passed at a time for this field as applicable'\n",
            "items": {
              "$ref": "#/components/schemas/BenefitEntitlementCheckCodeField"
            }
          },
          "preferredLanguage": {
            "type": "string",
            "description": "A langauge code for either English (en) or Welsh (cy). Email correspondance with the badge owner will be sent in this language.",
            "example": "en"
          },
          "eligibilityQualificationData": {
            "$ref": "#/components/schemas/EligibilityQualificationData"
          }
        },
        "required": [
          "party",
          "partyTypeCode",
          "name",
          "contactNumber",
          "startDate",
          "expiryDate",
          "applicationDate",
          "applicationChannelCode",
          "deliverToCode",
          "deliveryOptionCode"
        ]
      },
      "UpdateBadgeRequest": {
        "type": "object",
        "description": "Note. The party type code cannot be updated. Badge status must be ORDERED or ISSUED. Badge expiry must be in the future.",
        "properties": {
          "badgeNumber": {
            "type": "string",
            "description": "The badge to update."
          },
          "party": {
            "$ref": "#/components/schemas/Party"
          },
          "transferToLaShortCode": {
            "type": "string",
            "description": "Local Authority shortcode to transfer the badge to."
          },
          "notForReassessment": {
            "type": "boolean",
            "nullable": true,
            "description": "A flag to indicate future re-assessment is not required for this applicant. This flag is NULL for organisation and automatic eligibility person. It is optional for discretionary eligibility person badges. NULL, true or false can be set for discretionary eligibility person badges.",
            "example": true
          }
        },
        "required": [
          "party"
        ]
      },
      "Party": {
        "type": "object",
        "description": "If the party type code is PERSON, then the person field is mandatory and the organisation field must be null. And vice versa for type code of ORG.",
        "properties": {
          "typeCode": {
            "$ref": "#/components/schemas/PartyTypeCodeField"
          },
          "contact": {
            "$ref": "#/components/schemas/Contact"
          },
          "person": {
            "$ref": "#/components/schemas/Person"
          },
          "organisation": {
            "$ref": "#/components/schemas/Organisation"
          }
        },
        "required": [
          "typeCode",
          "contact"
        ]
      },
      "Person": {
        "type": "object",
        "properties": {
          "badgeHolderName": {
            "type": "string",
            "example": "Dwight Appleman",
            "maxLength": 100
          },
          "nino": {
            "type": "string",
            "description": "The badge holder's National Insurance number.",
            "example": "NY188796B",
            "pattern": "^(?!BG)(?!GB)(?!NK)(?!KN)(?!TN)(?!NT)(?!ZZ)(?:[A-CEGHJ-PR-TW-Z][A-CEGHJ-NPR-TW-Z])(?:\\s*\\d\\s*){6}([A-D]?\\s*)$"
          },
          "dob": {
            "type": "string",
            "format": "date",
            "example": "1972-09-13",
            "description": "Date of birth in YYYY-MM-DD format and can only be upto 120 years in the past."
          },
          "genderCode": {
            "$ref": "#/components/schemas/GenderCodeField"
          }
        },
        "required": [
          "badgeHolderName",
          "dob",
          "genderCode"
        ],
        "example": {
          "badgeHolderName": "Fred Bloggs",
          "nino": "NY188796B",
          "dob": "1972-09-12",
          "genderCode": "MALE"
        }
      },
      "Organisation": {
        "type": "object",
        "properties": {
          "badgeHolderName": {
            "type": "string"
          }
        },
        "required": [
          "badgeHolderName"
        ],
        "example": {
          "badgeHolderName": "The Monroe Institute"
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "maxLength": 100,
            "description": "The administrative contact for the badge(s). Note - this is mandatory for Organisation badges",
            "example": "June Whitfield"
          },
          "buildingStreet": {
            "type": "string",
            "maxLength": 50,
            "example": "65 Basil Chambers"
          },
          "line2": {
            "type": "string",
            "maxLength": 40,
            "example": "Northern Quarter"
          },
          "townCity": {
            "type": "string",
            "maxLength": 40,
            "example": "Manchester"
          },
          "postCode": {
            "type": "string",
            "example": "SK6 8GH",
            "pattern": "^[A-Za-z]{1,2}[0-9][0-9A-Za-z]?\\s?[0-9][A-Za-z]{2}$"
          },
          "primaryPhoneNumber": {
            "type": "string",
            "example": "01632 960 001, 07700 900 982 or +44 808 157 0192",
            "maxLength": 20,
            "pattern": "^\\s*$|^[\\s()\\[\\]. —–-]*(?:0|(?:\\+[\\s()\\[\\]. —–-]*([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?|(0[\\s()\\[\\]. —–-]*){2}([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?)|(?:1[\\s()\\[\\]. —–-]*8[\\s()\\[\\]. —–-]*0[\\s()\\[\\]. —–-]*0[\\s()\\[\\]. —–-]*[12][\\s()\\[\\]. —–-]*0?)[\\s()\\[\\]. —–-]*(?:\\+[\\s()\\[\\]. —–-]*([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?|(0[\\s()\\[\\]. —–-]*){2}([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?)?)[\\s()\\[\\]. —–-]*[1-9][\\s()\\[\\]. —–-]*(?:[0-9][\\s()\\[\\]. —–-]*){8,9}[\\s()\\[\\]. —–-]*$"
          },
          "secondaryPhoneNumber": {
            "type": "string",
            "example": "01632 960 001, 07700 900 982 or +44 808 157 0192",
            "maxLength": 20,
            "pattern": "^\\s*$|^[\\s()\\[\\]. —–-]*(?:0|(?:\\+[\\s()\\[\\]. —–-]*([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?|(0[\\s()\\[\\]. —–-]*){2}([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?)|(?:1[\\s()\\[\\]. —–-]*8[\\s()\\[\\]. —–-]*0[\\s()\\[\\]. —–-]*0[\\s()\\[\\]. —–-]*[12][\\s()\\[\\]. —–-]*0?)[\\s()\\[\\]. —–-]*(?:\\+[\\s()\\[\\]. —–-]*([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?|(0[\\s()\\[\\]. —–-]*){2}([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?)?)[\\s()\\[\\]. —–-]*[1-9][\\s()\\[\\]. —–-]*(?:[0-9][\\s()\\[\\]. —–-]*){8,9}[\\s()\\[\\]. —–-]*$"
          },
          "emailAddress": {
            "type": "string",
            "pattern": "aligns with GOV.UK Notify email validation - further information available at https://github.com/alphagov/notifications-utils/blob/master/notifications_utils/recipients.py#L442th GOV.UK Notify email validation - further information available at https://github.com/alphagov/notifications-utils/blob/master/notifications_utils/recipients.py#L442",
            "maxLength": 100,
            "example": "june@bigbrainknitting.com"
          }
        },
        "required": [
          "buildingStreet",
          "townCity",
          "postCode"
        ]
      },
      "DPOContactDetails": {
        "type": "object",
        "properties": {
          "dpoName": {
            "type": "string",
            "maxLength": 50,
            "example": "June Whitfield"
          },
          "dpoPrimaryContactNumber": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^\\s*(?:0\\s?|\\+?44\\s?)(?:\\d\\s?){9,10}\\s*$",
            "example": 1616548765
          },
          "dpoSecondaryContactNumber": {
            "type": "string",
            "maxLength": 20,
            "pattern": "^\\s*(?:0\\s?|\\+?44\\s?)(?:\\d\\s?){9,10}\\s*$",
            "example": 1616548765
          },
          "dpoPrimaryEmail": {
            "type": "string",
            "pattern": "aligns with GOV.UK Notify email validation - further information available at https://github.com/alphagov/notifications-utils/blob/master/notifications_utils/recipients.py#L442th GOV.UK Notify email validation - further information available at https://github.com/alphagov/notifications-utils/blob/master/notifications_utils/recipients.py#L442",
            "maxLength": 100,
            "example": "june@bigbrainknitting.com"
          },
          "dpoSecondaryEmail": {
            "type": "string",
            "pattern": "aligns with GOV.UK Notify email validation - further information available at https://github.com/alphagov/notifications-utils/blob/master/notifications_utils/recipients.py#L442th GOV.UK Notify email validation - further information available at https://github.com/alphagov/notifications-utils/blob/master/notifications_utils/recipients.py#L442",
            "maxLength": 100,
            "example": "june@bigbrainknitting.com"
          },
          "dpoAddressLine1": {
            "type": "string",
            "maxLength": 50,
            "example": "Northern Quarter"
          },
          "dpoAddressLine2": {
            "type": "string",
            "maxLength": 50,
            "example": "January street"
          },
          "dpoAddressLine3": {
            "type": "string",
            "maxLength": 50,
            "example": "Near Monday corner"
          },
          "dpoTown": {
            "type": "string",
            "maxLength": 50,
            "example": "Manchester"
          },
          "dpoCounty": {
            "type": "string",
            "maxLength": 50,
            "example": "Lancashire"
          },
          "dpoPostcode": {
            "type": "string",
            "example": "SK6 8GH",
            "pattern": "^[A-Za-z]{1,2}[0-9][0-9A-Za-z]?\\s?[0-9][A-Za-z]{2}$"
          }
        }
      },
      "application-CreateApplicationResponse": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "string",
                "example": "12341234-1234-1234-1234-123412341234"
              }
            }
          }
        ]
      },
      "application-ApplicationSummaryResponse": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/application-ApplicationSummary"
                }
              }
            }
          }
        ]
      },
      "application-ApplicationResponse": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/CommonResponse"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/application-Application"
              }
            }
          }
        ]
      },
      "application-ApplicationTransferRequest": {
        "type": "object",
        "properties": {
          "transferToLaShortCode": {
            "type": "string",
            "description": "The code for the new local authority.",
            "example": "BIRM"
          }
        },
        "required": [
          "transferToLaShortCode"
        ]
      },
      "application-ApplicationSummary": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "description": "The unique badge number for this application - a UUID",
            "example": "12345678-1234-1234-1234-123412341234"
          },
          "partyTypeCode": {
            "$ref": "#/components/schemas/PartyTypeCodeField"
          },
          "applicationTypeCode": {
            "$ref": "#/components/schemas/ApplicationTypeCodeField"
          },
          "nino": {
            "type": "string",
            "description": "The badgeholders national insurance number",
            "example": "NS123458S",
            "pattern": "^(?!BG)(?!GB)(?!NK)(?!KN)(?!TN)(?!NT)(?!ZZ)(?:[A-CEGHJ-PR-TW-Z][A-CEGHJ-NPR-TW-Z])(?:\\s*\\d\\s*){6}([A-D]|\\s)$"
          },
          "dob": {
            "type": "string",
            "format": "date",
            "example": "1972-09-13",
            "description": "Date of birth YYYY-MM-DD"
          },
          "name": {
            "type": "string",
            "description": "The name of the badge holder Organisation or Person",
            "example": "John Smith",
            "maxLength": 100
          },
          "submissionDate": {
            "type": "string",
            "format": "date-time",
            "description": "Submitted date and time",
            "example": "2018-12-25T12:30:45Z"
          },
          "eligibilityCode": {
            "$ref": "#/components/schemas/EligibilityCodeField"
          },
          "applicationStatus": {
            "$ref": "#/components/schemas/ApplicationStatusField"
          }
        }
      },
      "application-Application": {
        "type": "object",
        "properties": {
          "preferredLanguage": {
            "type": "string",
            "description": "A langauge code for either English (en) or Welsh (cy). Email correspondance with the badge owner will be sent in this language.",
            "example": "en"
          },
          "applicationId": {
            "type": "string",
            "description": "The unique identification number for this application returned during fetch for a single application - a UUID. This field is not passed during submit application request.",
            "example": "871d2607-fe43-4c03-8765-9c558ceaa460"
          },
          "applicationTypeCode": {
            "$ref": "#/components/schemas/ApplicationTypeCodeField"
          },
          "localAuthorityCode": {
            "type": "string",
            "description": "The code for the local authority.",
            "example": "BIRM"
          },
          "transferredLaFromCode": {
            "type": "string",
            "description": "The code for the local authority transferred from. This field will be present in the retrieved application if the application was transferred from this LA to the current LA.",
            "example": "BIRM"
          },
          "transferredFromLaDate": {
            "type": "string",
            "format": "date-time",
            "description": "Transferred from LA date. This field will be present in the retrieved application if the application was transferred from this LA to the current LA.",
            "example": "2018-12-25T12:30:45Z"
          },
          "paymentTaken": {
            "type": "boolean",
            "example": true,
            "description": "Indicates whether or not payment was taken as part of the application. This field is mandatory while submitting application. This could be set to false , if the payment has not been done or completed. If the payment status could not be determined, in which case paymentReference will be set to Unknown."
          },
          "paymentReference": {
            "type": "string",
            "example": "PVAUETDW43CM",
            "description": "The reference number of the payment taken as part of the application. This field cannot be null when paymentTaken field is true while submitting an application. Will be set to Unknown if the status of the payment could not be determined when application is retrieved."
          },
          "submissionDate": {
            "type": "string",
            "format": "date-time",
            "description": "Submitted date and time of the application being retrieved. This field is not required to be passed during submitting an application.",
            "example": "2018-12-25T12:30:45Z"
          },
          "existingBadgeNumber": {
            "type": "string",
            "description": "Any existing badge to be associated with the application being submitted can be provided here. If the value is provided, it will be returned during fetch application details.",
            "example": "ABC123"
          },
          "applicationReplaceReasonCode": {
            "$ref": "#/components/schemas/ReplaceReasonCodeField"
          },
          "referenceNumber": {
            "type": "string",
            "description": "An optional crime reference number in case badge lost or stolen.  This is applicable for a REPLACE type of application being submitted and is optional. "
          },
          "hasPersonalDetailsChanged": {
            "type": "boolean",
            "example": true,
            "description": "Optional field applicable only during REPLACE application submission, which indicates whether citizen details have changed since the badge was issued. This field can be ignored or set to false if the details have not changed."
          },
          "changedPersonalDetails": {
            "type": "array",
            "description": "Short codes representing the details that have changed since the badge was issued. This field is applicable only for REPLACE application submission. This field is mandatory if hasPersonalDetailsChanged field is set to true.",
            "items": {
              "$ref": "#/components/schemas/ChangedPersonalDetailsCodeField"
            }
          },
          "party": {
            "$ref": "#/components/schemas/application-Party"
          },
          "eligibility": {
            "$ref": "#/components/schemas/application-Eligibility"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/application-Artifact"
            }
          },
          "applicationStatus": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ApplicationStatusField"
              },
              {
                "description": "This field is optional for all type of applicable submissions - NEW, RENEW and REPLACE."
              }
            ]
          }
        },
        "required": [
          "applicationTypeCode",
          "paymentTaken",
          "localAuthorityCode",
          "party"
        ]
      },
      "application-ApplicationUpdate": {
        "type": "object",
        "properties": {
          "applicationStatus": {
            "$ref": "#/components/schemas/ApplicationStatusField"
          }
        }
      },
      "application-Party": {
        "type": "object",
        "properties": {
          "typeCode": {
            "$ref": "#/components/schemas/PartyTypeCodeField"
          },
          "contact": {
            "$ref": "#/components/schemas/application-Contact"
          },
          "person": {
            "$ref": "#/components/schemas/application-Person"
          },
          "organisation": {
            "$ref": "#/components/schemas/application-Organisation"
          }
        },
        "required": [
          "typeCode",
          "contact"
        ]
      },
      "application-Person": {
        "type": "object",
        "properties": {
          "badgeHolderName": {
            "type": "string",
            "example": "John Smith",
            "description": "Badge holder name to be printed on the physical badge. This is mandatory while submitting an application.",
            "maxLength": 100
          },
          "nino": {
            "type": "string",
            "description": "The badge holder's National Insurance number. This is optional while submitting an application.",
            "example": "NY188796B",
            "pattern": "^(?!BG)(?!GB)(?!NK)(?!KN)(?!TN)(?!NT)(?!ZZ)(?:[A-CEGHJ-PR-TW-Z][A-CEGHJ-NPR-TW-Z])(?:\\s*\\d\\s*){6}([A-D]?\\s*)$"
          },
          "dob": {
            "type": "string",
            "format": "date",
            "example": "1970-05-29",
            "description": "Date of birth in YYYY-MM-DD format and can only be upto 120 years in the past. This is mandatory while submitting an application."
          },
          "nameAtBirth": {
            "type": "string",
            "example": "John Smith",
            "description": "Name at birth of the applicant. This is optional while submitting an application.",
            "maxLength": 100
          },
          "genderCode": {
            "$ref": "#/components/schemas/GenderCodeField"
          },
          "assessedAs3YearOld": {
            "type": "boolean",
            "example": false,
            "description": "This optional field is used to indicate if the child applicant(within three months of turning three years old) is to be assessed as a three or two year old. Applicable for NEW & RENEW application submissions for Person type only and is an optional field."
          }
        },
        "required": [
          "badgeHolderName",
          "dob",
          "genderCode"
        ]
      },
      "application-Organisation": {
        "type": "object",
        "properties": {
          "badgeHolderName": {
            "type": "string",
            "example": "Trotters Independant Traders",
            "description": "Badge holder name to be printed on the physical badge. This is mandatory while submitting an application.",
            "maxLength": 100
          },
          "isCharity": {
            "type": "boolean",
            "description": "Specifies whether the organisation is a charity or not. This field is only applicable for an Organisation application. This is optional while submitting an application.",
            "example": false
          },
          "charityNumber": {
            "type": "string",
            "maxLength": 100,
            "description": "mentions the organisation charity reference number. This field is only applicable for an Organisation application. This is mandatory while submitting an application only if isCharity field is true, else its optional.",
            "example": "12345"
          },
          "vehicles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/application-Vehicle"
            }
          },
          "numberOfBadges": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999,
            "description": "Must be 1 for a person, can be multiple for an organisation. This is optional field while submitting an application.",
            "example": 1
          },
          "organisationNeeds": {
            "type": "string",
            "example": "Description of conditions",
            "description": "This is applicable to Organisation applications only as and  is optional while submitting an application.",
            "maxLength": 10000
          }
        },
        "required": [
          "badgeHolderName"
        ]
      },
      "application-Vehicle": {
        "type": "object",
        "description": "This section is applicable only for Organisation application and is optional while submitting an application.",
        "properties": {
          "registrationNumber": {
            "type": "string",
            "maxLength": 7,
            "description": "This field is applicable only for Organisation application and is optional while submitting an application.",
            "example": "VK61VZZ"
          },
          "typeCode": {
            "$ref": "#/components/schemas/VehicleTypeCodeField"
          },
          "usageFrequency": {
            "type": "string",
            "maxLength": 100,
            "description": "This field is applicable only for Organisation application and is optional while submitting an application.",
            "example": "Daily"
          }
        }
      },
      "application-Contact": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "maxLength": 100,
            "example": "Mabel Jones",
            "description": "Contact name for the application being submitted. This is mandatory while submitting application for Organisation while optional for Person type."
          },
          "buildingStreet": {
            "type": "string",
            "maxLength": 100,
            "description": "Contact address building and street details for the application being submitted. This is mandatory while submitting application.",
            "example": "65 Basil Chambers"
          },
          "line2": {
            "type": "string",
            "maxLength": 100,
            "description": "Contact address line 2 for the application being submitted. This is optional while submitting application.",
            "example": "Northern Quarter"
          },
          "townCity": {
            "type": "string",
            "maxLength": 100,
            "description": "Contact address town or city for the application being submitted. This is mandatory while submitting application.",
            "example": "Manchester"
          },
          "postCode": {
            "type": "string",
            "description": "Contact address postcode for the application being submitted. This is mandatory while submitting application.",
            "example": "SK6 8GH",
            "pattern": "^$|^([Gg][Ii][Rr] 0[Aa]{2})|((([A-Za-z][0-9]{1,2})|(([A-Za-z][A-Ha-hJ-Yj-y][0-9]{1,2})|(([AZa-z][0-9][A-Za-z])|([A-Za-z][A-Ha-hJ-Yj-y][0-9]?[A-Za-z]))))[\\s]*[0-9][A-Za-z]{2})$"
          },
          "primaryPhoneNumber": {
            "type": "string",
            "description": "Primary contact phone number for the application being submitted. This is mandatory while submitting application.",
            "example": "01632 960 001, 07700 900 982 or +44 808 157 0192",
            "maxLength": 20,
            "pattern": "^$|^[\\s()\\[\\]. —–-]*(?:0|(?:\\+[\\s()\\[\\]. —–-]*([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?|(0[\\s()\\[\\]. —–-]*){2}([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?)|(?:1[\\s()\\[\\]. —–-]*8[\\s()\\[\\]. —–-]*0[\\s()\\[\\]. —–-]*0[\\s()\\[\\]. —–-]*[12][\\s()\\[\\]. —–-]*0?)[\\s()\\[\\]. —–-]*(?:\\+[\\s()\\[\\]. —–-]*([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?|(0[\\s()\\[\\]. —–-]*){2}([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?)?)[\\s()\\[\\]. —–-]*[1-9][\\s()\\[\\]. —–-]*(?:[0-9][\\s()\\[\\]. —–-]*){8,9}[\\s()\\[\\]. —–-]*$"
          },
          "secondaryPhoneNumber": {
            "type": "string",
            "description": "Secondary contact phone number for the application being submitted. This is optional while submitting application.",
            "example": "01632 960 001, 07700 900 982 or +44 808 157 0192",
            "maxLength": 20,
            "pattern": "^$|^[\\s()\\[\\]. —–-]*(?:0|(?:\\+[\\s()\\[\\]. —–-]*([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?|(0[\\s()\\[\\]. —–-]*){2}([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?)|(?:1[\\s()\\[\\]. —–-]*8[\\s()\\[\\]. —–-]*0[\\s()\\[\\]. —–-]*0[\\s()\\[\\]. —–-]*[12][\\s()\\[\\]. —–-]*0?)[\\s()\\[\\]. —–-]*(?:\\+[\\s()\\[\\]. —–-]*([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?|(0[\\s()\\[\\]. —–-]*){2}([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?)?)[\\s()\\[\\]. —–-]*[1-9][\\s()\\[\\]. —–-]*(?:[0-9][\\s()\\[\\]. —–-]*){8,9}[\\s()\\[\\]. —–-]*$"
          },
          "emailAddress": {
            "type": "string",
            "pattern": "aligns with GOV.UK Notify email validation - further information available at https://github.com/alphagov/notifications-utils/blob/master/notifications_utils/recipients.py#L442th GOV.UK Notify email validation - further information available at https://github.com/alphagov/notifications-utils/blob/master/notifications_utils/recipients.py#L442",
            "maxLength": 100,
            "description": "Contact email address for the application being submitted. This is optional while submitting application.",
            "example": "nobody@blancmange.com"
          }
        },
        "required": [
          "buildingStreet",
          "townCity",
          "postCode"
        ]
      },
      "application-Eligibility": {
        "type": "object",
        "description": "This section is mandatory for a Person application and for NEW and RENEW submissions only. It should not be present for Person REPLACE application and Organisation application submissions.",
        "properties": {
          "typeCode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EligibilityCodeField"
              },
              {
                "description": "This field is mandatory for a Person application and for NEW and RENEW submissions only."
              }
            ]
          },
          "descriptionOfConditions": {
            "type": "string",
            "maxLength": 15000,
            "description": "This field is only valid and passed for discretionary eligibility types application submission and is optional. This field should not be passed for non-discretionary eligibility application submission.",
            "example": "Freetext"
          },
          "benefit": {
            "$ref": "#/components/schemas/application-Benefit"
          },
          "disabilityPayment": {
            "$ref": "#/components/schemas/application-DisabilityPaymentBenefit"
          },
          "benefitEntitlement": {
            "$ref": "#/components/schemas/application-BenefitEntitlement"
          },
          "walkingDifficulty": {
            "$ref": "#/components/schemas/application-WalkingDifficulty"
          },
          "disabilityArms": {
            "$ref": "#/components/schemas/application-DisabilityArms"
          },
          "healthcareProfessionals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/application-HealthcareProfessional"
            }
          },
          "blind": {
            "$ref": "#/components/schemas/application-Blind"
          },
          "childUnder3": {
            "$ref": "#/components/schemas/application-ChildUnder3"
          },
          "combined": {
            "$ref": "#/components/schemas/application-Combined"
          },
          "hiddenDisability": {
            "$ref": "#/components/schemas/application-HiddenDisability"
          }
        }
      },
      "application-ChildUnder3": {
        "type": "object",
        "description": "bulkyMedicalEquipmentTypeCode is DEPRECATED - use the array version.  Until removed One entry will be put in the non array field by citizen application if there are multiple codes entered. All entered values will be in the array version. This section is mandatory for NEW application submission and optional for RENEW application submission. This section is not applicable for REPLACE application submission.",
        "properties": {
          "bulkyMedicalEquipmentTypeCode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BulkyMedicalEquipmentTypeCodeField"
              },
              {
                "description": "This field is mandatory for NEW application submission and optional for RENEW application submission."
              }
            ]
          },
          "bulkyMedicalEquipmentTypeCodes": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/BulkyMedicalEquipmentTypeCodeField"
                },
                {
                  "description": "This field is mandatory for NEW application submission and optional for RENEW application submission. This field will be not mandatory for NEW application submission until bulkyMedicalEquipmentTypeCode field is present and not removed."
                }
              ]
            }
          },
          "otherMedicalEquipment": {
            "type": "string",
            "description": "A short description of the medical equipment. This field is mandatory if bulkyMedicalEquipmentTypeCode (until removed) or bulkyMedicalEquipmentTypeCodes field value is selected as OTHER.",
            "maxLength": 100,
            "example": "Oxygen cylinders"
          }
        }
      },
      "application-Blind": {
        "type": "object",
        "description": "This section is applicable for BLIND eligibility only. It is optional for both NEW and RENEW Person application submissions. This section is not applicable for REPLACE Person application submissions",
        "properties": {
          "registeredAtLaId": {
            "type": "string",
            "description": "Local Authority applicant is registered blind at (provide the LA short code). This field is optional for both NEW and RENEW Person application submissions. This field is only populated when the users have given permission to contact their local council to confirm that they have registered as blind in that local council.",
            "example": "BIRM"
          }
        }
      },
      "application-Benefit": {
        "type": "object",
        "description": "This section is applicable for PIP, PIPPLAN, DLA and WPMS eligibilities. It is mandatory during NEW Person application submission for above mentioned eligibilities. It is valid if this section is not present in a RENEW Person application and optional for the above mentioned eligibilities. This section is not applicable for REPLACE Person application submissions",
        "properties": {
          "isIndefinite": {
            "type": "boolean",
            "description": "could be true, false or empty. \n\nEmpty ('') means the applicant did not know if the benefit was indefinite or not. If they know, you should use true or false. It can also be empty ('') if the question was not asked in that eligibility.\n",
            "example": true
          },
          "expiryDate": {
            "type": "string",
            "format": "date",
            "description": "This field is mandatory only if isIndefinite field value is false. \n\nEmpty ('') can represent 3 cases:\n  1. The applicant chose the benefit was not ongoing but did not know what was the expiry date. \n  2. The applicant chose the benefit was ongoing, so they don't need to specify the expiryDate. \n  3. The applicant did not have to answer that question for the chosen eligibility.\n",
            "example": "2022-03-30"
          }
        }
      },
      "application-DisabilityPaymentBenefit": {
        "type": "object",
        "description": "This section is applicable for ADP, CDP and SRTIADP eligibilities. This section is mandatory for NEW and RENEW Person application submissions for the above mentioned eligibilities. This section is not applicable for REPLACE Person application submissions",
        "properties": {
          "hasReviewDate": {
            "type": "boolean",
            "description": "This field denotes the presence of benefit review date. This is mandatory for CDP, ADP and SRTIADP eligibilities However, for SRTIADP, only false is valid value",
            "example": true
          },
          "reviewDate": {
            "type": "string",
            "format": "date",
            "description": "For CDP eligiblity, if hasReviewDate field is true then this field is mandatory For ADP eligibility, if hasReviewDate field is true then this field is optional",
            "example": "2022-03-30"
          }
        },
        "required": [
          "hasReviewDate"
        ]
      },
      "application-BenefitEntitlement": {
        "type": "object",
        "description": "This section is optional for NEW and RENEW Person application submissions and not applicable for REPLACE Person application submissions. This section contains fields whose values are to be provided only if they are applicable to the applicant, else skip them.",
        "properties": {
          "pipMovePoints": {
            "type": "integer",
            "description": "How many points did the applicant score in the 'moving around' activity of mobility assessment in the PIP award letter Points score can only be one of these values - 0, 4, 8, 10, 12. \n\nIf it is empty ('') it could mean the user did answer they did not know how many pip points they have. It will also be empty if the question was not asked\n",
            "example": 2
          },
          "pipPlanPoints": {
            "type": "integer",
            "description": "How many points did the applicant score in the 'planning and following a journey' activity of mobility assessment in the PIP award letter.\n\nPoints score can only be one of these values - 0, 4, 8, 10, 12. \n\nIf it is empty ('') it could mean the user did answer they did not know how many pip points they have. It will also be empty if the question was not asked\n",
            "example": 4
          },
          "pipPlanPointsDetail": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PipPlanningJourneyCodeField"
              },
              {
                "description": "This field is applicable if applicant scored 10 points in the 'planning and following a journey' activity of mobility assessment. Did the applicant feel OVERWHELM ( overwhelming psychological distress) or UNFAMILIAR (unfamiliar with journey route) while undertaking journey during the assessment."
              }
            ]
          },
          "dlaHigherRate": {
            "type": "boolean",
            "description": "Was the applicant awarded the higher rate of the mobility component for Disability Living Allowance",
            "example": true
          },
          "afcsLumpSum": {
            "type": "boolean",
            "description": "Has the applicant received a lump sum payment within tariff levels 1 to 8 of the Armed Forces Compensation Scheme",
            "example": false
          },
          "cdpHigherRate": {
            "type": "boolean",
            "description": "Was the applicant awarded the higher rate of the mobility component for Child Disability Payment",
            "example": true
          },
          "adpPointsOnMoving": {
            "type": "integer",
            "example": 10,
            "description": "How many points did the applicant score in the ''moving around'' activity of mobility assessment for Adult Disability Payment. \n\nPoints score can only be one of these values - 0, 4, 8, 10, 12\n"
          },
          "adpPointsOnPlanning": {
            "type": "integer",
            "example": 12,
            "description": "How many points did the applicant score in the 'planning and following a journey' activity of mobility assessment for Adult Disability Payment. Points score can only be one of these values - 0, 4, 8, 10, 12"
          },
          "adpEnhancedRate": {
            "type": "boolean",
            "example": true,
            "description": "Was the applicant awarded the enhanced rate of the mobility component for Adult Disability Payment. Note - for SRTIADP eligibility, only valid if passed as true"
          },
          "isSADLAApplication": {
            "type": "boolean",
            "example": true,
            "description": "Was the applicant receiving benefit under Scottish Adult Disability Living Allowance (SADLA). Note - this is applicable only while applying to Scottish LAs."
          },
          "dlaInThePast": {
            "type": "boolean",
            "example": false,
            "description": "Contains the answer to the question about if the applicant had dla in the past. \n\nNote - this is applicable only while applying to Scottish LAs and only asked for some of the eligibilities.\n"
          },
          "pipMandatoryReconsideration": {
            "type": "boolean",
            "example": false,
            "description": "Contains the answer to the question about if the applicant had pip mandatory reconsideration.\n\nNote - this is applicable only while applying to Scottish LAs and only asked for some of the eligibilities.\n"
          }
        }
      },
      "application-Combined": {
        "type": "object",
        "description": "This section is applicable and mandatory for COMBINED eligibility and mandatory for NEW but optional for RENEW application submissions. So for a RENEW application retrieved, the values of fields under this section may be all null. This section is not applicable for REPLACE application submissions.",
        "properties": {
          "risk": {
            "type": "boolean",
            "example": true,
            "description": "This field is mandatory for NEW and RENEW application submissions."
          },
          "riskWhen": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JourneyFrequencyCodeField"
              },
              {
                "description": "This field is mandatory for NEW and RENEW application submissions only if risk field value is true."
              }
            ]
          },
          "riskExample": {
            "type": "string",
            "maxLength": 3000,
            "example": "Freetext",
            "description": "This field is mandatory for NEW and RENEW application submissions only if risk field value is true."
          },
          "planning": {
            "type": "boolean",
            "example": false,
            "description": "This field is mandatory for NEW and RENEW application submissions."
          },
          "planningJourneys": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlanningFrequencyCodeField"
              },
              {
                "description": "This field is mandatory for NEW and RENEW application submissions only if planning field value is true."
              }
            ]
          },
          "anxiety": {
            "type": "boolean",
            "example": true,
            "description": "This field is mandatory for NEW and RENEW application submissions."
          },
          "anxietyFrequency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JourneyFrequencyCodeField"
              },
              {
                "description": "This field is mandatory for NEW and RENEW application submissions only if anxiety field value is true."
              }
            ]
          },
          "anxietyDescription": {
            "type": "string",
            "maxLength": 3000,
            "description": "A short description on when an applicant becomes extremely anxious/fearful. This field is mandatory for NEW and RENEW application submissions only if anxiety field value is true."
          },
          "awareness": {
            "type": "boolean",
            "example": true,
            "description": "This field is mandatory for NEW and RENEW application submissions."
          },
          "awarenessFrequency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JourneyFrequencyCodeField"
              },
              {
                "description": "This field is mandatory for NEW and RENEW application submissions only if awareness field value is true."
              }
            ]
          },
          "awarenessDescription": {
            "type": "string",
            "maxLength": 3000,
            "description": "A short description on when an applicant finds it difficult or impossible to control his/her actions and lack awareness of the impact they could have on others. This field is mandatory for NEW and RENEW application submissions only if awareness field value is true."
          },
          "control": {
            "type": "boolean",
            "example": true,
            "description": "This field is mandatory for NEW and RENEW application submissions."
          },
          "controlFrequency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JourneyFrequencyCodeField"
              },
              {
                "description": "This field is mandatory for NEW and RENEW application submissions only if control field value is true."
              }
            ]
          },
          "controlDescription": {
            "type": "string",
            "maxLength": 3000,
            "description": "A short description to give examples of the situations that cause the meltdowns. This field is mandatory for NEW and RENEW application submissions only if control field value is true."
          },
          "somethingElse": {
            "type": "boolean",
            "example": true,
            "description": "This field is mandatory for NEW and RENEW application submissions."
          },
          "somethingElseDescription": {
            "type": "string",
            "maxLength": 3000,
            "description": "A short description to describe what affects you taking a journey. This field is mandatory for NEW and RENEW application submissions only if somethingElse field value is true."
          },
          "stepsToImprove": {
            "type": "string",
            "maxLength": 5000,
            "description": "A short description to describe steps are currently taken to try to improve journeys. This field is mandatory for NEW and RENEW application submissions."
          },
          "stepsEffective": {
            "type": "string",
            "description": "A short description to describe how effective are these steps. This field is mandatory for NEW and RENEW application submissions.",
            "maxLength": 1000
          },
          "walkingDifficulty": {
            "$ref": "#/components/schemas/application-WalkingDifficultyUnderHidden"
          },
          "treatments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/application-Treatment"
            }
          },
          "medications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/application-Medication"
            }
          }
        }
      },
      "application-HiddenDisability": {
        "type": "object",
        "description": "This section is applicable and mandatory for HIDDEN eligibility and for NEW and RENEW application submissions. This section is not applicable for REPLACE application submissions. So for a RENEW application retrieved, the values of fields under this section may be all null.",
        "properties": {
          "risk": {
            "type": "boolean",
            "example": true,
            "description": "This field is mandatory for NEW and RENEW application submissions."
          },
          "riskWhen": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JourneyFrequencyCodeField"
              },
              {
                "description": "This field is mandatory for NEW and RENEW application submissions only if risk field value is true."
              }
            ]
          },
          "riskExample": {
            "type": "string",
            "maxLength": 3000,
            "example": "Freetext",
            "description": "This field is mandatory for NEW and RENEW application submissions only if risk field value is true."
          },
          "planning": {
            "type": "boolean",
            "example": false,
            "description": "This field is mandatory for NEW and RENEW application submissions."
          },
          "planningJourneys": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PlanningFrequencyCodeField"
              },
              {
                "description": "This field is mandatory for NEW and RENEW application submissions only if planning field value is true."
              }
            ]
          },
          "anxiety": {
            "type": "boolean",
            "example": true,
            "description": "This field is mandatory for NEW and RENEW application submissions."
          },
          "anxietyFrequency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JourneyFrequencyCodeField"
              },
              {
                "description": "This field is mandatory for NEW and RENEW application submissions only if anxiety field value is true."
              }
            ]
          },
          "anxietyDescription": {
            "type": "string",
            "maxLength": 3000,
            "description": "A short description on when an applicant becomes extremely anxious/fearful. This field is mandatory for NEW and RENEW application submissions only if anxiety field value is true."
          },
          "awareness": {
            "type": "boolean",
            "example": true,
            "description": "This field is mandatory for NEW and RENEW application submissions."
          },
          "awarenessFrequency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JourneyFrequencyCodeField"
              },
              {
                "description": "This field is mandatory for NEW and RENEW application submissions only if awareness field value is true."
              }
            ]
          },
          "awarenessDescription": {
            "type": "string",
            "maxLength": 3000,
            "description": "A short description on when an applicant finds it difficult or impossible to control his/her actions and lack awareness of the impact they could have on others. This field is mandatory for NEW and RENEW application submissions only if awareness field value is true."
          },
          "control": {
            "type": "boolean",
            "example": true,
            "description": "This field is mandatory for NEW and RENEW application submissions."
          },
          "controlFrequency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/JourneyFrequencyCodeField"
              },
              {
                "description": "This field is mandatory for NEW and RENEW application submissions only if control field value is true."
              }
            ]
          },
          "controlDescription": {
            "type": "string",
            "maxLength": 3000,
            "description": "A short description to give examples of the situations that cause the meltdowns. This field is mandatory for NEW and RENEW application submissions only if control field value is true."
          },
          "somethingElse": {
            "type": "boolean",
            "example": true,
            "description": "This field is mandatory for NEW and RENEW application submissions."
          },
          "somethingElseDescription": {
            "type": "string",
            "maxLength": 3000,
            "description": "A short description to describe what affects you taking a journey. This field is mandatory for NEW and RENEW application submissions only if somethingElse field value is true."
          },
          "stepsToImprove": {
            "type": "string",
            "maxLength": 5000,
            "description": "A short description to describe steps are currently taken to try to improve journeys. This field is mandatory for NEW and RENEW application submissions."
          },
          "stepsEffective": {
            "type": "string",
            "description": "A short description to describe how effective are these steps. This field is mandatory for NEW and RENEW application submissions.",
            "maxLength": 1000
          },
          "walkingDifficulty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/application-WalkingDifficultyUnderHidden"
              },
              {
                "description": "ONLY available for retrieval (Get requests) of old applications which used to contain walkingDifficulty section for HIDDEN eligibility applications. Currently, HIDDEN applications do not expect walkingDifficulty section to be present in the request."
              }
            ]
          },
          "treatments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/application-Treatment"
            }
          },
          "medications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/application-Medication"
            }
          }
        }
      },
      "application-HealthcareProfessional": {
        "type": "object",
        "description": "This section is applicable only for the eligibilities - WALKD, HIDDEN, COMBINED, TERMILL, CHILDBULK and CHILDVEHIC. This section is optional for NEW and RENEW applications submissions. Hence the fields under this section could be null for a retrieved application.",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "Freetext",
            "description": "This field is optional"
          },
          "location": {
            "type": "string",
            "maxLength": 100,
            "example": "Freetext",
            "description": "This field is optional"
          },
          "email": {
            "type": "string",
            "pattern": "aligns with GOV.UK Notify email validation - further information available at https://github.com/alphagov/notifications-utils/blob/master/notifications_utils/recipients.py#L442th GOV.UK Notify email validation - further information available at https://github.com/alphagov/notifications-utils/blob/master/notifications_utils/recipients.py#L442",
            "maxLength": 100,
            "example": "june@bigbrainknitting.com",
            "description": "This field is optional"
          },
          "phoneNumber": {
            "type": "string",
            "pattern": "^\\s*$|^[\\s()\\[\\]. —–-]*(?:0|(?:\\+[\\s()\\[\\]. —–-]*([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?|(0[\\s()\\[\\]. —–-]*){2}([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?)|(?:1[\\s()\\[\\]. —–-]*8[\\s()\\[\\]. —–-]*0[\\s()\\[\\]. —–-]*0[\\s()\\[\\]. —–-]*[12][\\s()\\[\\]. —–-]*0?)[\\s()\\[\\]. —–-]*(?:\\+[\\s()\\[\\]. —–-]*([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?|(0[\\s()\\[\\]. —–-]*){2}([0-9][\\s()\\[\\]. —–-]*){2,3}[\\s()\\[\\]. —–-]*0?)?)[\\s()\\[\\]. —–-]*[1-9][\\s()\\[\\]. —–-]*(?:[0-9][\\s()\\[\\]. —–-]*){8,9}[\\s()\\[\\]. —–-]*$",
            "example": "01632 960 001, 07700 900 982 or +44 808 157 0192",
            "description": "This field is optional"
          },
          "buildingStreet": {
            "type": "string",
            "maxLength": 50,
            "example": "65 Basil Chambers",
            "description": "This field is optional"
          },
          "line2": {
            "type": "string",
            "maxLength": 40,
            "example": "Northern Quarter",
            "description": "This field is optional"
          },
          "townCity": {
            "type": "string",
            "maxLength": 40,
            "example": "Manchester",
            "description": "This field is optional"
          },
          "postCode": {
            "type": "string",
            "example": "SK6 8GH",
            "pattern": "^[A-Za-z]{1,2}[0-9][0-9A-Za-z]?\\s?[0-9][A-Za-z]{2}$",
            "description": "This field is optional"
          }
        }
      },
      "nfiPreference": {
        "type": "object",
        "description": "This section contains information regarding the year, NFI Data return opted or not and corresponding email to contact in case Data return not opted by the LA.",
        "properties": {
          "optedIn": {
            "type": "boolean",
            "example": true,
            "description": "Whether LA had opted in or opted out of NFI Data return process for the applicable year."
          },
          "emailAddressWhenOptedOut": {
            "type": "string",
            "example": "june@bigbrainknitting.com",
            "description": "If the LA had opted out of the NFI Data Return process, then the contact email provided."
          },
          "year": {
            "type": "integer",
            "example": 2020,
            "description": "The calendar year for which the NFI Data return information is applicable."
          }
        }
      },
      "contact-details": {
        "type": "object",
        "description": "This section contains contact details such as name, email and phone number of each department under LA like finance, customer services.",
        "properties": {
          "contactName": {
            "type": "string",
            "example": "John Smith"
          },
          "emailAddress": {
            "type": "string",
            "example": "mail@abc.com"
          },
          "contactNumber": {
            "type": "string",
            "example": "08041190800"
          }
        }
      },
      "application-DisabilityArms": {
        "type": "object",
        "description": "This section is applicable for ARMS eligibility and for NEW and RENEW application submissions. This section is mandatory during NEW Person application submission. This section may or may not be present for a RENEW Person application. This section is not applicable for REPLACE application submissions.",
        "properties": {
          "drivingFrequency": {
            "type": "string",
            "maxLength": 100,
            "description": "This field is optional"
          },
          "isAdaptedVehicle": {
            "type": "boolean",
            "example": true,
            "description": "This field is mandatory to be passed for a NEW application submission where as it is optional for a RENEW application submission. If this field is passed and the value is false, adaptedVehicleDescription field value should not be passed."
          },
          "adaptedVehicleDescription": {
            "type": "string",
            "maxLength": 255,
            "description": "This field is optional"
          }
        }
      },
      "application-WalkingDifficulty": {
        "type": "object",
        "description": "This section is mandatory for NEW application submissions whereas its optional for RENEW application submissions. This section is not applicable for REPLACE application submissions. So for a RENEW application retrieved, the values of fields under this section may be all null.",
        "properties": {
          "typeCodes": {
            "type": "array",
            "description": "**This field is mandatory for NEW application submissions and can be absent or null for RENEW application submissions. Short codes from the below list are to be passed based on the satisfying conditions. At least 1 required.**<br>\nPossible values are -\n  * PAIN (Excessive pain)\n  * BREATH (Breathlessness)\n  * BALANCE (Balance or coordination)\n  * LONGTIME (Takes a long time)\n  * DANGER (Dangerous to my health)\n  * STRUGGLE (Struggle planning or following a journey)\n  * SOMELSE (Something else)\n",
            "items": {
              "$ref": "#/components/schemas/WalkingDifficultyTypeCodeField"
            }
          },
          "always": {
            "type": "boolean",
            "description": "Whether applicant always has walking difficulty. This field is mandatory for NEW application submissions. It is also mandatory for RENEW application submissions if eligibility is WALKD."
          },
          "frequencyDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "Description of how frequently applicant has difficulty This field value is mandatory if value of field always under walkingDifficulty section is false"
          },
          "durationDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "Description of how long applicant has difficulty. This field value is mandatory if value of field always under walkingDifficulty section is false"
          },
          "painDescription": {
            "description": "Only entered if 'PAIN' type selected and then mandatory.",
            "type": "string",
            "maxLength": 2000
          },
          "balanceDescription": {
            "description": "Only entered if 'BALANCE' type selected and then mandatory.",
            "type": "string",
            "maxLength": 2000
          },
          "healthProfessionsForFalls": {
            "description": "Whether the applicant has seen a health proffession for a fall. Only entered if 'BALANCE' type selected and then mandatory.",
            "type": "boolean"
          },
          "dangerousDescription": {
            "description": "Only entered if 'DANGER' type selected and then mandatory.",
            "type": "string",
            "maxLength": 2000
          },
          "chestLungHeartEpilepsy": {
            "description": "Whether the applicant has a chest, lung or heart condition or they have epilepsy. Only entered if 'DANGER' type selected and then mandatory.",
            "type": "boolean"
          },
          "otherDescription": {
            "description": "Only entered if 'SOMELSE' type selected and then mandatory.",
            "type": "string",
            "maxLength": 2000
          },
          "walkingPain": {
            "$ref": "#/components/schemas/application-WalkingPain"
          },
          "walkingBalance": {
            "$ref": "#/components/schemas/application-WalkingBalance"
          },
          "walkingAids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/application-WalkingAid"
            }
          },
          "walkingLengthOfTimeCode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WalkingLengthOfTimeCodeField"
              },
              {
                "description": "This field is mandatory for a NEW application submission and optional for a RENEW application submission. Hence this field can be null for a retrieved RENEW application."
              }
            ]
          },
          "walkingSpeedCode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WalkingSpeedCodeField"
              },
              {
                "description": "This field is optional for a NEW and RENEW application submissions. Hence this field can be null for a retrieved RENEW application."
              }
            ]
          },
          "treatments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/application-Treatment"
            }
          },
          "medications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/application-Medication"
            }
          },
          "breathlessness": {
            "$ref": "#/components/schemas/application-Breathlessness"
          }
        }
      },
      "application-WalkingDifficultyUnderHidden": {
        "type": "object",
        "description": "This section is mandatory for NEW whereas optional for RENEW application submissions. This section is not applicable for REPLACE application submissions.",
        "properties": {
          "typeCodes": {
            "type": "array",
            "description": "**This field is mandatory for NEW application submissions and can be absent or null for RENEW application submissions. Short codes from the below list are to be passed based on the satisfying conditions. At least 1 required.**<br>\nPossible values are -\n  * PAIN (Excessive pain)\n  * BREATH (Breathlessness)\n  * BALANCE (Balance or coordination)\n  * LONGTIME (Takes a long time)\n  * DANGER (Dangerous to my health)\n  * STRUGGLE (Struggle planning or following a journey)\n  * SOMELSE (Something else)\n",
            "items": {
              "$ref": "#/components/schemas/WalkingDifficultyTypeCodeField"
            }
          },
          "always": {
            "type": "boolean",
            "description": "Whether applicant always has walking difficulty. This field is mandatory for NEW and RENEW application submissions if eligibility is COMBINED."
          },
          "frequencyDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "Description of how frequently applicant has difficulty. This field value is mandatory if value of field always under walkingDifficulty section is false"
          },
          "durationDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "Description of how long applicant has difficulty. This field value is mandatory if value of field always under walkingDifficulty section is false"
          },
          "painDescription": {
            "description": "Only entered if 'PAIN' type selected and then mandatory.",
            "type": "string",
            "maxLength": 2000
          },
          "balanceDescription": {
            "description": "Only entered if 'BALANCE' type selected and then mandatory.",
            "type": "string",
            "maxLength": 2000
          },
          "healthProfessionsForFalls": {
            "description": "Whether the applicant has seen a health proffession for a fall. Only entered if 'BALANCE' type selected and then mandatory.",
            "type": "boolean"
          },
          "dangerousDescription": {
            "description": "Only entered if 'DANGER' type selected and then mandatory.",
            "type": "string",
            "maxLength": 2000
          },
          "chestLungHeartEpilepsy": {
            "description": "Whether the applicant has a chest, lung or heart condition or they have epilepsy. Only entered if 'DANGER' type selected and then mandatory.",
            "type": "boolean"
          },
          "otherDescription": {
            "description": "Only entered if 'SOMELSE' type selected and then mandatory.",
            "type": "string",
            "maxLength": 2000
          },
          "walkingPain": {
            "$ref": "#/components/schemas/application-WalkingPain"
          },
          "walkingBalance": {
            "$ref": "#/components/schemas/application-WalkingBalance"
          },
          "walkingAids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/application-WalkingAid"
            }
          },
          "walkingLengthOfTimeCode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WalkingLengthOfTimeCodeField"
              },
              {
                "description": "This field is mandatory for a NEW and RENEW application submissions."
              }
            ]
          },
          "walkingSpeedCode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/WalkingSpeedCodeField"
              },
              {
                "description": "This field is optional for a NEW and RENEW application submissions. Hence this field can be null for a retrieved RENEW application."
              }
            ]
          },
          "breathlessness": {
            "$ref": "#/components/schemas/application-Breathlessness"
          }
        }
      },
      "application-WalkingPain": {
        "type": "object",
        "description": "This section is not mandatory to be passed during NEW and RENEW applications submissions for WALKD and COMBINED eligibilities. So the values of fields within this section may be null for a retrieved application.",
        "properties": {
          "typeCodes": {
            "type": "array",
            "description": "**One or more reasons due to which the applicant experiences pain while walking, expressed as short code. At least one short code is required if this field is present.**<br> Possible values - \n  * COPE (Able to cope with the pain)\n  * BREAKS (Have to stop and take regular breaks)\n  * SICK (Sometimes physically sick due to pain)\n  * UNBEARABLE (Frequently in so much pain that walking for more than 2 minutes is unbearable)\n  * OTHER (Other)\n",
            "items": {
              "$ref": "#/components/schemas/WalkingPainTypeCodeField"
            }
          },
          "relief": {
            "type": "boolean",
            "description": "Whether applicant takes pain relief. This field is required if this section(walkingPain) is present"
          },
          "copeDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "'Description of how applicant is able to cope with pain. This field is not mandatory even if COPE is selected as a pain type'\n"
          },
          "breaksDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "'Description of how applicant take breaks in walking to cope with pain. This field is not mandatory even if BREAKS is selected as a pain type'\n"
          },
          "sickDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "'Description of how pain may cause applicant feel sick. This field is not mandatory even if SICK is selected as a pain type'\n"
          },
          "unbearableDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "'Description of how the pain is unbearable to applicant. This field is not mandatory even if UNBEARABLE is selected as a pain type'\n"
          },
          "otherDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "'Other description of walking pain. This field is mandatory if OTHER is selected as a pain type'\n"
          }
        }
      },
      "application-WalkingBalance": {
        "type": "object",
        "description": "This section is not mandatory to be passed during NEW and RENEW applications submissions for WALKD and COMBINED eligibilities. So the values of fields within this section may be null for a retrieved application.",
        "properties": {
          "typeCodes": {
            "type": "array",
            "description": "**One or more reasons that describe the balance and coordination for the applicant while walking, expressed as short code. At least one short code is required if this field is present.**<br> Possible values - \n  * SUPERMARKE (Can walk around a supermarket, with the support of a trolley)\n  * STAIRS (Can walk up/down a single flight of stairs in a house)\n  * INDOORS (Can only walk around indoors)\n  * SHOPPING (Can walk around a small shopping centre)\n  * OTHER (Other)\n",
            "items": {
              "$ref": "#/components/schemas/WalkingBalanceTypeCodeField"
            }
          },
          "supermarketDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "'Description of how applicant can move around supermarkets with supporting trolley. This field is not mandatory even if SUPERMARKE is selected as a balance type'\n"
          },
          "stairsDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "'Description of how applicant can walk up/down a single flight of stairs in a house. This field is not mandatory even if STAIRS is selected as a balance type'\n"
          },
          "indoorsDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "'Description of how applicant can walk around indoors. This field is not mandatory even if INDOORS is selected as a balance type'\n"
          },
          "shoppingDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "'Description whether applicant can walk around a small shopping centre. This field is not mandatory even if SHOPPING is selected as a balance type'\n"
          },
          "otherDescription": {
            "type": "string",
            "maxLength": 1000,
            "description": "'Other description of walking balance. This field is mandatory if OTHER is selected as a balance type'\n"
          }
        }
      },
      "application-Breathlessness": {
        "type": "object",
        "description": "This section is mandatory for NEW and RENEW application submissions if BREATH is one of the codes under walking difficulty for WALKD and COMBINED eligibilities.",
        "properties": {
          "typeCodes": {
            "type": "array",
            "description": "**One or more reasons that describe when the applicant feels breathlessness while walking, expressed as short code. At least one short code is required if this field is present.**<br> Possible values - \n  * UPHILL (Walking up a slight hill)\n  * KEEPUP (Trying to keep up with others on level ground)\n  * OWNPACE (Walking on level ground at my own pace)\n  * DRESSED (Getting dressed or trying to leave my home)\n  * OTHER (Other)\n",
            "items": {
              "$ref": "#/components/schemas/BreathlessnessTypeCodeField"
            }
          },
          "otherDescription": {
            "description": "Only mandatory if OTHER is selected as one of the breathlessness type code.",
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "application-Medication": {
        "type": "object",
        "description": "This section is not mandatory to be passed during NEW and RENEW applications submissions. So the values of fields within this section may be null for a retrieved application.",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "Paracetamol"
          },
          "isPrescribed": {
            "type": "boolean",
            "example": true
          },
          "frequency": {
            "type": "string",
            "maxLength": 100,
            "example": "Twice daily.",
            "description": "Number of times medication is taken"
          },
          "quantity": {
            "type": "string",
            "maxLength": 100,
            "example": "1 tablet, 20mg"
          }
        },
        "required": [
          "name",
          "isPrescribed",
          "frequency",
          "quantity"
        ]
      },
      "application-Treatment": {
        "type": "object",
        "description": "This section is not mandatory to be passed during NEW and RENEW applications submissions. So the values of fields within this section may be null for a retrieved application.",
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 100,
            "description": "This field is optional"
          },
          "time": {
            "type": "string",
            "maxLength": 100,
            "example": "6 months",
            "description": "This field is optional"
          }
        }
      },
      "application-WalkingAid": {
        "type": "object",
        "description": "This section is not mandatory to be passed during NEW and RENEW applications submissions for WALKD and COMBINED eligibilities. So the values of fields within this section may be null for a retrieved application.",
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 100,
            "description": "This field is optional."
          },
          "usage": {
            "type": "string",
            "maxLength": 1000,
            "description": "This field is optional."
          },
          "howProvidedCode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HowProvidedCodeField"
              },
              {
                "description": "This field is mandatory if this section(walkingAid) is present."
              }
            ]
          }
        }
      },
      "application-Artifact": {
        "description": "Provided files/evidence. This section is optional while submitting an application.",
        "type": "object",
        "properties": {
          "type": {
            "description": "The artifact type. This field is optional while submitting an application.",
            "type": "string",
            "enum": [
              "PROOF_ELIG",
              "SUPPORT_DOCS",
              "PROOF_ADD",
              "PROOF_ID",
              "PHOTO"
            ],
            "example": "PROOF_ADD"
          },
          "link": {
            "description": "The link to the artifact. This field is mandatory while submitting an application only if type field is present. This value must be a valid S3 bucket link.",
            "type": "string"
          }
        }
      },
      "LocalCouncil": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Council name",
            "maxLength": 100
          },
          "welshDescription": {
            "type": "string",
            "description": "Council name in Welsh",
            "maxLength": 100
          }
        }
      },
      "LocalAuthority": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "welshDescription": {
            "type": "string"
          },
          "paymentsEnabled": {
            "type": "boolean"
          },
          "nameLine2": {
            "type": "string",
            "description": "name line 2",
            "example": null
          },
          "addressLine1": {
            "type": "string",
            "description": "address line 1",
            "example": "high street 1"
          },
          "addressLine2": {
            "type": "string",
            "description": "address line 2",
            "example": "borough"
          },
          "addressLine3": {
            "type": "string",
            "description": "address line 3",
            "example": "city"
          },
          "addressLine4": {
            "type": "string",
            "description": "address line 4",
            "example": "other"
          },
          "town": {
            "type": "string",
            "description": "town",
            "example": "Manchester"
          },
          "county": {
            "type": "string",
            "description": "county",
            "example": "Lancashire"
          },
          "postcode": {
            "type": "string",
            "description": "postcode",
            "example": "SW1P 4DR"
          },
          "country": {
            "type": "string",
            "description": "country",
            "example": "United Kingdom"
          },
          "nation": {
            "type": "string",
            "description": "ENG, WLS, SCO or NIR",
            "example": "ENG"
          },
          "contactNumber": {
            "type": "string",
            "description": "contact phone number",
            "example": "01632 960493"
          },
          "contactUrl": {
            "type": "string",
            "description": "web site url",
            "example": "https://www.gov.uk/"
          },
          "emailAddress": {
            "type": "string",
            "description": "email address",
            "example": "abc@abcdefghijk.co.uk"
          },
          "dpoContactDetails": {
            "$ref": "#/components/schemas/DPOContactDetails"
          },
          "badgePackType": {
            "type": "string",
            "description": "badge pack type STANDARD, WALLET",
            "example": "STANDARD"
          },
          "badgeCost": {
            "type": "number",
            "minimum": 0,
            "maximum": 999.99,
            "description": "badge cost",
            "example": 100
          },
          "differentServiceSignpostUrl": {
            "type": "string",
            "description": "Service signpost url",
            "example": "http://tiny.url?q=ab63fg"
          },
          "streamlinedCitizenReapplicationJourneyEnabled": {
            "type": "boolean",
            "description": "when true, enables streamlined citizen reapplication journey"
          }
        },
        "required": [
          "description",
          "postcode",
          "country",
          "nation",
          "contactUrl"
        ]
      },
      "LocalAuthorityNFIPreference": {
        "type": "object",
        "properties": {
          "optedIn": {
            "type": "boolean",
            "example": false
          },
          "emailAddressWhenOptedOut": {
            "type": "string",
            "description": "when optedIn is false, this email address is mandatory, when optedIn is true, it should not be passed",
            "example": "abc@abcdefghijk.co.uk"
          }
        },
        "required": [
          "optedIn"
        ]
      },
      "LocalAuthorityContactDetails": {
        "type": "object",
