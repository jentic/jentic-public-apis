{
  "openapi": "3.0.3",
  "info": {
    "title": "Sonos Control API",
    "description": "Cloud-based REST API for controlling Sonos speakers. Provides household discovery, group management, playback control, volume control, favorites, audio clips, and home theater configuration.",
    "version": "v1",
    "contact": {
      "name": "Sonos Developer",
      "url": "https://developer.sonos.com"
    },
    "x-jentic-source-url": "https://developer.sonos.com/reference",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.ws.sonos.com/control/api/v1",
      "description": "Sonos Cloud Control API"
    }
  ],
  "security": [
    {
      "oauth2": ["playback-control-all"]
    }
  ],
  "paths": {
    "/households": {
      "get": {
        "operationId": "getHouseholds",
        "summary": "Get all households",
        "description": "Retrieve all households associated with the authenticated user's Sonos account.",
        "responses": {
          "200": {
            "description": "List of households",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "households": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/households/{householdId}/groups": {
      "get": {
        "operationId": "getGroups",
        "summary": "Get groups in a household",
        "description": "Retrieve all groups and their players within a household.",
        "parameters": [
          {
            "name": "householdId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Household identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Groups and players in the household",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "coordinatorId": { "type": "string" },
                          "playerIds": {
                            "type": "array",
                            "items": { "type": "string" }
                          }
                        }
                      }
                    },
                    "players": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "websocketUrl": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Household not found" }
        }
      }
    },
    "/households/{householdId}/groups/createGroup": {
      "post": {
        "operationId": "createGroup",
        "summary": "Create a new group",
        "description": "Create a new speaker group within a household.",
        "parameters": [
          {
            "name": "householdId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["playerIds"],
                "properties": {
                  "playerIds": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Player IDs to include in the group"
                  },
                  "musicContextGroupId": {
                    "type": "string",
                    "description": "Group ID to copy music context from"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Group created successfully" },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/groups/{groupId}/groups/modifyGroupMembers": {
      "post": {
        "operationId": "modifyGroupMembers",
        "summary": "Modify group membership",
        "description": "Add or remove players from an existing group.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "playerIdsToAdd": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "playerIdsToRemove": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Group membership modified" },
          "400": { "description": "Bad request" },
          "404": { "description": "Group not found" }
        }
      }
    },
    "/groups/{groupId}/playback": {
      "get": {
        "operationId": "getPlaybackStatus",
        "summary": "Get playback status",
        "description": "Retrieve the current playback state of a group.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Current playback status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "playbackState": { "type": "string", "enum": ["PLAYBACK_STATE_IDLE", "PLAYBACK_STATE_BUFFERING", "PLAYBACK_STATE_PLAYING", "PLAYBACK_STATE_PAUSED"] },
                    "positionMillis": { "type": "integer" },
                    "playModes": {
                      "type": "object",
                      "properties": {
                        "repeat": { "type": "boolean" },
                        "repeatOne": { "type": "boolean" },
                        "shuffle": { "type": "boolean" },
                        "crossfade": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Group not found" }
        }
      }
    },
    "/groups/{groupId}/playback/play": {
      "post": {
        "operationId": "play",
        "summary": "Start playback",
        "description": "Start or resume playback on a group.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Playback started" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Group not found" }
        }
      }
    },
    "/groups/{groupId}/playback/pause": {
      "post": {
        "operationId": "pause",
        "summary": "Pause playback",
        "description": "Pause playback on a group.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Playback paused" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Group not found" }
        }
      }
    },
    "/groups/{groupId}/playback/togglePlayPause": {
      "post": {
        "operationId": "togglePlayPause",
        "summary": "Toggle play/pause",
        "description": "Toggle between play and pause states on a group.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Playback state toggled" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/groups/{groupId}/playback/skipToNextTrack": {
      "post": {
        "operationId": "skipToNextTrack",
        "summary": "Skip to next track",
        "description": "Skip to the next track in the queue.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Skipped to next track" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/groups/{groupId}/playback/skipToPreviousTrack": {
      "post": {
        "operationId": "skipToPreviousTrack",
        "summary": "Skip to previous track",
        "description": "Skip to the previous track in the queue.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Skipped to previous track" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/groups/{groupId}/playback/seek": {
      "post": {
        "operationId": "seek",
        "summary": "Seek to position",
        "description": "Seek to a specific position in the current track.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "positionMillis": { "type": "integer", "description": "Position in milliseconds" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Seek completed" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/groups/{groupId}/playback/setPlayModes": {
      "post": {
        "operationId": "setPlayModes",
        "summary": "Set play modes",
        "description": "Set repeat, shuffle, and crossfade modes for a group.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "repeat": { "type": "boolean" },
                  "repeatOne": { "type": "boolean" },
                  "shuffle": { "type": "boolean" },
                  "crossfade": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Play modes updated" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/groups/{groupId}/playbackMetadata": {
      "get": {
        "operationId": "getMetadataStatus",
        "summary": "Get playback metadata",
        "description": "Retrieve metadata for the currently playing track in a group.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Current playback metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "container": { "type": "object" },
                    "currentItem": { "type": "object" },
                    "nextItem": { "type": "object" },
                    "streamInfo": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/groups/{groupId}/groupVolume": {
      "get": {
        "operationId": "getGroupVolume",
        "summary": "Get group volume",
        "description": "Get the current volume level and mute state for a group.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Group volume state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "volume": { "type": "integer", "minimum": 0, "maximum": 100 },
                    "muted": { "type": "boolean" },
                    "fixed": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/groups/{groupId}/groupVolume/setVolume": {
      "post": {
        "operationId": "setGroupVolume",
        "summary": "Set group volume",
        "description": "Set the volume level for a group.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["volume"],
                "properties": {
                  "volume": { "type": "integer", "minimum": 0, "maximum": 100 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Volume set" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/groups/{groupId}/groupVolume/setMute": {
      "post": {
        "operationId": "setGroupMute",
        "summary": "Mute/unmute group",
        "description": "Set the mute state for a group.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["muted"],
                "properties": {
                  "muted": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Mute state set" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/groups/{groupId}/groupVolume/setRelativeVolume": {
      "post": {
        "operationId": "setRelativeGroupVolume",
        "summary": "Adjust group volume relatively",
        "description": "Adjust the group volume by a relative delta value.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["volumeDelta"],
                "properties": {
                  "volumeDelta": { "type": "integer", "description": "Volume adjustment delta" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Volume adjusted" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/players/{playerId}/playerVolume": {
      "get": {
        "operationId": "getPlayerVolume",
        "summary": "Get player volume",
        "description": "Get the current volume level and mute state for an individual player.",
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Player volume state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "volume": { "type": "integer" },
                    "muted": { "type": "boolean" },
                    "fixed": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/players/{playerId}/playerVolume/setVolume": {
      "post": {
        "operationId": "setPlayerVolume",
        "summary": "Set player volume",
        "description": "Set the volume level for an individual player.",
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "volume": { "type": "integer", "minimum": 0, "maximum": 100 },
                  "muted": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Volume set" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/households/{householdId}/favorites": {
      "get": {
        "operationId": "getFavorites",
        "summary": "Get favorites",
        "description": "Retrieve the list of Sonos favorites for a household.",
        "parameters": [
          {
            "name": "householdId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of favorites",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": { "type": "string" },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "description": { "type": "string" },
                          "imageUrl": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/groups/{groupId}/favorites": {
      "post": {
        "operationId": "loadFavorite",
        "summary": "Load a favorite",
        "description": "Load and play a favorite on a group.",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["favoriteId"],
                "properties": {
                  "favoriteId": { "type": "string", "description": "The ID of the favorite to load" },
                  "playOnCompletion": { "type": "boolean" },
                  "playModes": {
                    "type": "object",
                    "properties": {
                      "shuffle": { "type": "boolean" },
                      "repeat": { "type": "boolean" },
                      "repeatOne": { "type": "boolean" },
                      "crossfade": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Favorite loaded" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/players/{playerId}/audioClip": {
      "post": {
        "operationId": "loadAudioClip",
        "summary": "Load an audio clip",
        "description": "Play an audio clip on a specific player, optionally ducking current playback.",
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "appId"],
                "properties": {
                  "name": { "type": "string", "description": "Clip display name" },
                  "appId": { "type": "string", "description": "App identifier" },
                  "priority": { "type": "string", "enum": ["LOW", "HIGH"], "description": "Clip priority" },
                  "clipType": { "type": "string", "description": "Clip type (CHIME, CUSTOM)" },
                  "streamUrl": { "type": "string", "format": "uri", "description": "URL of the audio clip" },
                  "httpAuthorization": { "type": "string", "description": "Auth header for streamUrl" },
                  "volume": { "type": "integer", "minimum": 0, "maximum": 100 },
                  "clipLEDBehavior": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Audio clip loaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" },
                    "appId": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/players/{playerId}/homeTheater": {
      "get": {
        "operationId": "getHomeTheaterOptions",
        "summary": "Get home theater options",
        "description": "Retrieve the home theater configuration for a player.",
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Home theater options",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nightMode": { "type": "boolean" },
                    "enhanceDialog": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "operationId": "setHomeTheaterOptions",
        "summary": "Set home theater options",
        "description": "Configure home theater settings for a player.",
        "parameters": [
          {
            "name": "playerId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nightMode": { "type": "boolean" },
                  "enhanceDialog": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Home theater options set" },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Sonos OAuth 2.0 authorization. Requires developer program enrollment.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://api.sonos.com/login/v3/oauth",
            "tokenUrl": "https://api.sonos.com/login/v3/oauth/token",
            "refreshUrl": "https://api.sonos.com/login/v3/oauth/refresh",
            "scopes": {
              "playback-control-all": "Full playback control access"
            }
          }
        }
      }
    }
  }
}