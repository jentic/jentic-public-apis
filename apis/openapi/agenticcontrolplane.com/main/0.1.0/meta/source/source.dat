{
  "openapi": "3.1.0",
  "info": {
    "title": "Agentic Control Plane — Gateway API",
    "version": "0.1.0",
    "description": "The public, gsk_-key-authenticated surface of the ACP gateway: agent profiles, run summaries,\nself-introspection (cost / usage / decisions / traces), delegation-chain child-key minting,\nscoped-token issuance, the governed model proxy, and the MCP endpoint.\n\n**Rate limits.** Rate-limited endpoints return IETF draft-7 `RateLimit` / `RateLimit-Policy`\nheaders on every response and a 429 with the same headers when exceeded.\n\n**Errors.** Three envelopes coexist and are documented per-endpoint: `{ error: string }` on\n/api/v1/*, `{ error: 'validation_failed', details }` on schema-validated bodies, and the\nOpenAI-compatible `{ error: { message, type, param, code } }` on the model proxy.\n\n**Feature-flagged surfaces.** `/api/v1/keys/child`, `/api/v1/scoped-tokens`, and\n`/v1/sandbox-tenants` are deployment-flagged; when disabled they 404.\n\nHuman docs: https://agenticcontrolplane.com/agents/configure-as-code — agent-facing site\nindex: https://agenticcontrolplane.com/llms.txt",
    "contact": {
      "name": "Agentic Control Plane",
      "email": "hello@agenticcontrolplane.com",
      "url": "https://agenticcontrolplane.com/contact"
    }
  },
  "servers": [
    {
      "url": "https://api.agenticcontrolplane.com"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "agents",
      "description": "Agent profiles — the governed identity + limits an agent runs under."
    },
    {
      "name": "runs",
      "description": "Run summaries — the same pre-aggregated data the console reads."
    },
    {
      "name": "introspect",
      "description": "Read-only self-introspection over the caller's own governed footprint."
    },
    {
      "name": "delegation",
      "description": "Agent-to-agent delegation: scope-narrowed child API keys (ADCS)."
    },
    {
      "name": "credentials",
      "description": "Short-lived scoped tokens bound to a user's stored OAuth credential."
    },
    {
      "name": "sandbox",
      "description": "Zero-signup sandbox workspaces for agents with no tenant yet."
    },
    {
      "name": "proxy",
      "description": "Governed model proxy — OpenAI- and Anthropic-compatible."
    },
    {
      "name": "mcp",
      "description": "Model Context Protocol endpoint (streamable HTTP)."
    },
    {
      "name": "meta",
      "description": "Service metadata."
    }
  ],
  "paths": {
    "/api/v1/agents": {
      "post": {
        "tags": [
          "agents"
        ],
        "operationId": "createAgentProfile",
        "summary": "Create an agent profile",
        "description": "Creates a governed agent profile. `name` and `model` are required; budget/limit fields default conservatively.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Agent profile fields. On PATCH the body is strict (unknown fields rejected) and `model` must be on the platform allowlist; see /api/v1 docs for per-field bounds.",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "icon": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "model": {
                    "type": "string",
                    "description": "Must be an allow-listed model id."
                  },
                  "systemPrompt": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "enabledTools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 200
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 100
                  },
                  "maxToolCalls": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "maxBudgetCents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "maxDurationMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxToolRounds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "delegatable": {
                    "type": "boolean"
                  },
                  "canDelegate": {
                    "type": "boolean"
                  },
                  "maxDelegationDepth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Missing required field.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or revoked gsk_ API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "agents"
        ],
        "operationId": "listAgentProfiles",
        "summary": "List agent profiles",
        "responses": {
          "200": {
            "description": "Profiles, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "profiles": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or revoked gsk_ API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "tags": [
          "agents"
        ],
        "operationId": "getAgentProfile",
        "summary": "Get one agent profile",
        "responses": {
          "200": {
            "description": "The profile.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "profile": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or revoked gsk_ API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "agents"
        ],
        "operationId": "replaceAgentProfileFields",
        "summary": "Update agent profile (lenient)",
        "description": "Field-by-field update; unknown fields ignored. Prefer PATCH, which validates strictly.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Agent profile fields. On PATCH the body is strict (unknown fields rejected) and `model` must be on the platform allowlist; see /api/v1 docs for per-field bounds.",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "icon": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "model": {
                    "type": "string",
                    "description": "Must be an allow-listed model id."
                  },
                  "systemPrompt": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "enabledTools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 200
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 100
                  },
                  "maxToolCalls": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "maxBudgetCents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "maxDurationMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxToolRounds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "delegatable": {
                    "type": "boolean"
                  },
                  "canDelegate": {
                    "type": "boolean"
                  },
                  "maxDelegationDepth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or revoked gsk_ API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "agents"
        ],
        "operationId": "patchAgentProfile",
        "summary": "Update agent profile (strict, validated)",
        "description": "Strict zod-validated patch: unknown fields rejected, `model` checked against the platform allowlist, numeric bounds enforced. Rate limited per tenant.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Agent profile fields. On PATCH the body is strict (unknown fields rejected) and `model` must be on the platform allowlist; see /api/v1 docs for per-field bounds.",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "icon": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "model": {
                    "type": "string",
                    "description": "Must be an allow-listed model id."
                  },
                  "systemPrompt": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "enabledTools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 200
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 100
                  },
                  "maxToolCalls": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "maxBudgetCents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "maxDurationMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxToolRounds": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "delegatable": {
                    "type": "boolean"
                  },
                  "canDelegate": {
                    "type": "boolean"
                  },
                  "maxDelegationDepth": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Patched.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or revoked gsk_ API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited. Standard draft-7 RateLimit / RateLimit-Policy headers are set; retry after the window resets.",
            "headers": {
              "RateLimit": {
                "schema": {
                  "type": "string"
                },
                "description": "IETF draft-7 rate-limit header."
              },
              "RateLimit-Policy": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "agents"
        ],
        "operationId": "deleteAgentProfile",
        "summary": "Delete an agent profile",
        "responses": {
          "200": {
            "description": "Deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or revoked gsk_ API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{id}/run": {
      "post": {
        "tags": [
          "agents"
        ],
        "operationId": "runAgent",
        "summary": "Run an agent",
        "description": "Triggers a governed run of the profile. The run executes under the profile's limits (budget, tool rounds, duration) and every tool call is policy-checked and audited.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Run result / run reference.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or revoked gsk_ API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs": {
      "get": {
        "tags": [
          "runs"
        ],
        "operationId": "listRuns",
        "summary": "List run summaries",
        "parameters": [
          {
            "name": "agent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by agent name."
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "24h",
                "7d",
                "30d",
                "90d"
              ],
              "default": "30d"
            },
            "description": "Time window (endpoints accept the subset that makes sense for them; default 30d)."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Runs, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "window": {
                      "type": "string"
                    },
                    "runs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or revoked gsk_ API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{runKey}": {
      "get": {
        "tags": [
          "runs"
        ],
        "operationId": "getRun",
        "summary": "Get one run summary (with ordered steps)",
        "parameters": [
          {
            "name": "runKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The run.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "run": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or revoked gsk_ API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/introspect/usage": {
      "get": {
        "tags": [
          "introspect"
        ],
        "operationId": "introspectUsage",
        "summary": "Plan meter + caller's own share",
        "description": "The workspace-shared plan meter (used / limit / state) plus the caller's own contribution. Lets an agent answer \"am I about to lose governance?\" itself.",
        "responses": {
          "200": {
            "description": "Usage.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or revoked gsk_ API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/introspect/cost": {
      "get": {
        "tags": [
          "introspect"
        ],
        "operationId": "introspectCost",
        "summary": "Model spend, by model",
        "description": "Principal-scoped by default; a key with the `admin` scope may pass `?scope=workspace`.",
        "parameters": [
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "24h",
                "7d",
                "30d",
                "90d"
              ],
              "default": "30d"
            },
            "description": "Time window (endpoints accept the subset that makes sense for them; default 30d)."
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "workspace"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Spend.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, invalid, or revoked gsk_ API key.",
