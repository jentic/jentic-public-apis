pe":"string","enum":["title","subtitle","description","image","entity_type"]}},"takeover_fields":{"maxItems":5,"type":"array","items":{"type":"string","enum":["title","subtitle","description","image","entity_type"]}},"relinquish_handles":{"description":"Only while Wikidata lists the value.","maxItems":50,"type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","minLength":1,"description":"The platform id, e.g. \"twitter\": one the platform catalog has (get_entry with include_platforms lists the enabled ones; platform_catalog, every one). A new handle on an unknown or disabled platform is refused (400 invalid_platform)."},"value":{"type":"string","minLength":1,"description":"The handle as stored, e.g. \"nasa\"."}},"required":["platform_id","value"]}},"takeover_handles":{"maxItems":50,"type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","minLength":1,"description":"The platform id, e.g. \"twitter\": one the platform catalog has (get_entry with include_platforms lists the enabled ones; platform_catalog, every one). A new handle on an unknown or disabled platform is refused (400 invalid_platform)."},"value":{"type":"string","minLength":1,"description":"The handle as stored, e.g. \"nasa\"."}},"required":["platform_id","value"]}},"release_held_handles":{"maxItems":50,"type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","minLength":1,"description":"The platform id, e.g. \"twitter\": one the platform catalog has (get_entry with include_platforms lists the enabled ones; platform_catalog, every one). A new handle on an unknown or disabled platform is refused (400 invalid_platform)."},"value":{"type":"string","minLength":1,"description":"The handle as stored, e.g. \"nasa\"."}},"required":["platform_id","value"]}},"summary":{"description":"Why you made this edit, in a few plain words; shown in the entry’s public history. At most 200 characters. Never an internal tracking ID (a backlog or