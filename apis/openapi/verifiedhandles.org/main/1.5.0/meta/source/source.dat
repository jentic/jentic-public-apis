s"]}},"additionalProperties":false},"example":{"copy_handle_only":"1","save_recent_searches":"1","name_visibility":"public"}}}},"responses":{"302":{"description":"Done: back to /management-console/account, `done=prefs`. (With no key and nobody signed in, a 302 to sign in instead.)","headers":{"Location":{"description":"/management-console/account, with the outcome in its query.","schema":{"type":"string"}}}},"400":{"description":"The request sent a key and a session cookie together (`bearer_with_cookie`): send one.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"401":{"description":"The key was refused: unknown, revoked or expired, its holder may no longer use keys, or this instance takes none. Carries `WWW-Authenticate: Bearer`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"403":{"description":"The key’s account lacks the capability, or is blocked: the body is the word `Forbidden`. A read-only key that tries to change something is refused first, as JSON: `{\"error\":\"read_only_key\"}`.","content":{"text/plain":{"schema":{"type":"string","const":"Forbidden"}}}},"429":{"description":"Too many changes in the last minute: counted per IP address, per account and per key (an admin key’s per key alone, at the limit set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}},"503":{"description":"The site is down for maintenance. The body is the maintenance page, as HTML. Try again later: `Retry-After` gives the seconds.","content":{"text/html":{}}}},"security":[{"bearerAuth":[]}],"x-audience":"public","x-capability":null,"x-read-only-key":false,"x-auth":"required","x-rate-limit":null,"x-cache":{"cache-control":"no-store","etag":false,"notes":"Never cached: it is about the caller. An answer to a key also carries `Vary: Authorization`."},"x-cors":false}},"/management-console/account/email-resume":{"post":{"operationId":"resumeMyEmail","tags":["Your account"],"summary":"Have the site email your address again","description":"Takes your own address off the email suppression list, after Amazon SES reported it as a permanent bounce or a spam complaint. Nothing changes when it is not on the list. The next bounce or complaint lists it again.","parameters":[],"requestBody":{"description":"Nothing but the CSRF token.","required":true,"content":{"application/x-www-form-urlencoded":{"schema":{"type":"object","properties":{},"additionalProperties":false},"example":{}}}},"responses":{"302":{"description":"Done: back to /management-console/account, `done=email-resumed`. (With no key and nobody signed in, a 302 to sign in instead.)","headers":{"Location":{"description":"/management-console/account, with the outcome in its query.","schema":{"type":"string"}}}},"400":{"description":"The request sent a key and a session cookie together (`bearer_with_cookie`): send one.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"401":{"description":"The key was refused: unknown, revoked or expired, its holder may no longer use keys, or this instance takes none. Carries `WWW-Authenticate: Bearer`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"403":{"description":"The key’s account lacks the capability, or is blocked: the body is the word `Forbidden`. A read-only key that tries to change something is refused first, as JSON: `{\"error\":\"read_only_key\"}`.","content":{"text/plain":{"schema":{"type":"string","const":"Forbidden"}}}},"429":{"description":"Too many changes in the last minute: counted per IP address, per account and per key (an admin key’s per key alone, at the limit set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}},"503":{"description":"The site is down for maintenance. The body is the maintenance page, as HTML. Try again later: `Retry-After` gives the seconds.","content":{"text/html":{}}}},"security":[{"bearerAuth":[]}],"x-audience":"public","x-capability":null,"x-read-only-key":false,"x-auth":"required","x-rate-limit":null,"x-cache":{"cache-control":"no-store","etag":false,"notes":"Never cached: it is about the caller. An answer to a key also carries `Vary: Authorization`."},"x-cors":false}},"/management-console/account/data.json":{"get":{"operationId":"downloadMyData","tags":["Your account"],"summary":"Download everything the site holds about you","description":"Your account, preferences, submissions, comments, notes, API keys (never a secret), your entries in the audit log, the edits you made, proposed or hid, what you reviewed, claimed and uploaded, your permission history, your Wikidata changes, the emails queued to you and when your sessions began, as one JSON file. Each download is audited (row counts only). 5 an hour per account. A blocked account may download its own too.","parameters":[],"responses":{"200":{"description":"The file, with `Content-Disposition: attachment`.","headers":{"Content-Disposition":{"description":"`attachment; filename=\"verifiedhandles-data-<date>.json\"`.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AccountData"}}}},"302":{"description":"No key was sent: the console sends a browser to sign in. A script should send its key.","headers":{"Location":{"description":"/management-console/auth/login?next=<the path asked for>","schema":{"type":"string"}}}},"400":{"description":"The request sent a key and a session cookie together (`bearer_with_cookie`): send one.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"401":{"description":"The key was refused: unknown, revoked or expired, its holder may no longer use keys, or this instance takes none. Carries `WWW-Authenticate: Bearer`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"403":{"description":"The key’s account lacks the capability, or is blocked: the body is the word `Forbidden`.","content":{"text/plain":{"schema":{"type":"string","const":"Forbidden"}}}},"429":{"description":"More than 5 downloads in the last hour: wait a while.","content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}},"503":{"description":"The site is down for maintenance. The body is the maintenance page, as HTML. Try again later: `Retry-After` gives the seconds.","content":{"text/html":{}}}},"security":[{"bearerAuth":[]}],"x-audience":"public","x-capability":null,"x-read-only-key":true,"x-auth":"required","x-rate-limit":{"bucket":"json","max":120,"window_seconds":60,"per":"IP address"},"x-cache":{"cache-control":"no-store","etag":false,"notes":"Never cached: it is about the caller. An answer to a key also carries `Vary: Authorization`."},"x-cors":false}},"/management-console/account/delete":{"post":{"operationId":"deleteMyAccount","tags":["Your account"],"summary":"Delete your account","description":"Deletes the account at once and for good: every session and API key (this one too), the profile, preferences and unpublished submissions and unsaved drafts. What it added to entries stays on the record under an anonymous deleted account. A blocked account may delete itself. There is no undo and no dry run.","parameters":[],"requestBody":{"description":"Nothing: it is your own account.","required":true,"content":{"application/x-www-form-urlencoded":{"schema":{"type":"object","properties":{},"additionalProperties":false}}}},"responses":{"302":{"description":"No key was sent: the console sends a browser to sign in. A script should send its key.","headers":{"Location":{"description":"/management-console/auth/login?next=<the path asked for>","schema":{"type":"string"}}}},"303":{"description":"Deleted: on to the page that confirms it. `?err=blocked_no_key` on the account page instead when a blocked account’s block could not be kept, and nothing was deleted.","headers":{"Location":{"description":"/management-console/account/deleted","schema":{"type":"string"}}}},"400":{"description":"The request sent a key and a session cookie together (`bearer_with_cookie`): send one.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"401":{"description":"The key was refused: unknown, revoked or expired, its holder may no longer use keys, or this instance takes none. Carries `WWW-Authenticate: Bearer`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"403":{"description":"The key’s account lacks the capability, or is blocked: the body is the word `Forbidden`. A read-only key that tries to change something is refused first, as JSON: `{\"error\":\"read_only_key\"}`.","content":{"text/plain":{"schema":{"type":"string","const":"Forbidden"}}}},"429":{"description":"Too many changes in the last minute: counted per IP address, per account and per key (an admin key’s per key alone, at the limit set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}},"503":{"description":"The site is down for maintenance. The body is the maintenance page, as HTML. Try again later: `Retry-After` gives the seconds.","content":{"text/html":{}}}},"security":[{"bearerAuth":[]}],"x-audience":"public","x-capability":null,"x-read-only-key":false,"x-auth":"required","x-rate-limit":null,"x-cache":{"cache-control":"no-store","etag":false,"notes":"Never cached: it is about the caller. An answer to a key also carries `Vary: Authorization`."},"x-cors":false}},"/management-console/account/api-keys.json":{"get":{"operationId":"listMyApiKeys","tags":["Your account"],"summary":"List your API keys","description":"Every key your account has made, live or not, newest first; `this_key` marks the one making the request. Never a secret. Any account may list its own, even one that may no longer make keys. `apps` are the apps connected to the account through OAuth: the live ones, then the 20 that ended most recently.","parameters":[],"responses":{"200":{"description":"Your keys and connected apps.","content":{"application/json":{"schema":{"type":"object","properties":{"sub":{"type":"string"},"keys":{"type":"array","items":{"$ref":"#/components/schemas/ApiKeyRow"}},"apps":{"type":"array","items":{"$ref":"#/components/schemas/ConnectedAppRow"}}},"required":["sub","keys","apps"],"additionalProperties":false}}}},"302":{"description":"No key was sent: the console sends a browser to sign in. A script should send its key.","headers":{"Location":{"description":"/management-console/auth/login?next=<the path asked for>","schema":{"type":"string"}}}},"400":{"description":"The request sent a key and a session cookie together (`bearer_with_cookie`): send one.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"401":{"description":"The key was refused: unknown, revoked or expired, its holder may no longer use keys, or this instance takes none. Carries `WWW-Authenticate: Bearer`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"403":{"description":"The key’s account lacks the capability, or is blocked: the body is the word `Forbidden`.","content":{"text/plain":{"schema":{"type":"string","const":"Forbidden"}}}},"503":{"description":"The site is down for maintenance. The body is the maintenance page, as HTML. Try again later: `Retry-After` gives the seconds.","content":{"text/html":{}}}},"security":[{"bearerAuth":[]}],"x-audience":"public","x-capability":null,"x-read-only-key":true,"x-auth":"required","x-rate-limit":{"bucket":"json","max":120,"window_seconds":60,"per":"IP address"},"x-cache":{"cache-control":"no-store","etag":false,"notes":"Never cached: it is about the caller. An answer to a key also carries `Vary: Authorization`."},"x-cors":false}},"/management-console/account/api-keys/{id}/revoke":{"post":{"operationId":"revokeMyApiKey","tags":["Your account"],"summary":"Revoke one of your API keys","description":"Revokes the key at once, audited: anything using it stops working. Revoking the key that makes the request is allowed, and is its last request. Back to the API keys page, `done=revoked`, or `err=gone` when it was not one of your live keys. A connected app is disconnected the same way, with its `key`: its tokens stop working at once (with `kind=app`, the page answers `done=disconnected` or `err=app_gone`).","parameters":[{"name":"id","in":"path","required":true,"description":"The key’s id (`id` in the list).","schema":{"type":"string","pattern":"^\\d+$"},"example":"1"}],"requestBody":{"description":"Nothing but, from the Connected apps list, which page to answer with: the address says which key.","required":true,"content":{"application/x-www-form-urlencoded":{"schema":{"type":"object","properties":{"kind":{"description":"`app`: a connected app is being disconnected, so the answer is `done=disconnected` or `err=app_gone`.","type":"string","const":"app"}},"additionalProperties":false},"example":{}}}},"responses":{"302":{"description":"No key was sent: the console sends a browser to sign in. A script should send its key.","headers":{"Location":{"description":"/management-console/auth/login?next=<the path asked for>","schema":{"type":"string"}}}},"303":{"description":"Done: back to /management-console/account/api-keys, `done=revoked` or `err=gone`.","headers":{"Location":{"description":"/management-console/account/api-keys, with the outcome in its query.","schema":{"type":"string"}}}},"400":{"description":"The request sent a key and a session cookie together (`bearer_with_cookie`): send one.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"401":{"description":"The key was refused: unknown, revoked or expired, its holder may no longer use keys, or this instance takes none. Carries `WWW-Authenticate: Bearer`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"403":{"description":"The key’s account lacks the capability, or is blocked: the body is the word `Forbidden`. A read-only key that tries to change something is refused first, as JSON: `{\"error\":\"read_only_key\"}`.","content":{"text/plain":{"schema":{"type":"string","const":"Forbidden"}}}},"429":{"description":"Too many changes in the last minute: counted per IP address, per account and per key (an admin key’s per key alone, at the limit set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}},"503":{"description":"The site is down for maintenance. The body is the maintenance page, as HTML. Try again later: `Retry-After` gives the seconds.","content":{"text/html":{}}}},"security":[{"bearerAuth":[]}],"x-audience":"public","x-capability":null,"x-read-only-key":false,"x-auth":"required","x-rate-limit":null,"x-cache":{"cache-control":"no-store","etag":false,"notes":"Never cached: it is about the caller. An answer to a key also carries `Vary: Authorization`."},"x-cors":false}},"/management-console/account/api-keys/{id}/activity.json":{"get":{"operationId":"myApiKeyActivity","tags":["Your account"],"summary":"What one of your API keys did","description":"Every change made with one of your keys (the audit log’s rows that name it), newest first, 50 a page. Changes, not reads: reading writes no row. Page with `before` (the `next` of the page before) and back with `after` (`prev`). Only your own keys: any other id is a 404, whoever holds it. No other capability is needed.","parameters":[{"name":"id","in":"path","required":true,"description":"The key’s id (`id` in the list).","schema":{"type":"string","pattern":"^\\d+$"},"example":"1"},{"name":"before","in":"query","required":false,"description":"Rows older than this one (a row id: `next`).","schema":{"type":"string"}},{"name":"after","in":"query","required":false,"description":"Rows newer than this one (a row id: `prev`).","schema":{"type":"string"}}],"responses":{"200":{"description":"The key and a page of its rows.","content":{"application/json":{"schema":{"type":"object","properties":{"key":{"type":"object","properties":{"id":{"type":"string","pattern":"^\\d+$"},"name":{"type":"string"},"prefix":{"type":"string"},"state":{"type":"string","enum":["live","revoked","expired"]}},"required":["id","name","prefix","state"],"additionalProperties":false},"rows":{"type":"array","items":{"$ref":"#/components/schemas/KeyActivityRow"}},"next":{"anyOf":[{"type":"string","pattern":"^\\d+$"},{"type":"null"}],"description":"Pass as `before` for older rows; null on the last page."},"prev":{"anyOf":[{"type":"string","pattern":"^\\d+$"},{"type":"null"}],"description":"Pass as `after` for newer rows; null on the first page."}},"required":["key","rows","next","prev"],"additionalProperties":false}}}},"302":{"description":"No key was sent: the console sends a browser to sign in. A script should send its key.","headers":{"Location":{"description":"/management-console/auth/login?next=<the path asked for>","schema":{"type":"string"}}}},"400":{"description":"The request sent a key and a session cookie together (`bearer_with_cookie`): send one.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"401":{"description":"The key was refused: unknown, revoked or expired, its holder may no longer use keys, or this instance takes none. Carries `WWW-Authenticate: Bearer`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"403":{"description":"The key’s account lacks the capability, or is blocked: the body is the word `Forbidden`.","content":{"text/plain":{"schema":{"type":"string","const":"Forbidden"}}}},"404":{"description":"Not one of your keys.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string","enum":["not_found"],"description":"Not found."}},"required":["error"],"additionalProperties":{}},"examples":{"not_mine":{"summary":"A key that is not yours","description":"GET /management-console/account/api-keys/999999999/activity.json","value":{"error":"not_found"}}}}}},"503":{"description":"The site is down for maintenance. The body is the maintenance page, as HTML. Try again later: `Retry-After` gives the seconds.","content":{"text/html":{}}}},"security":[{"bearerAuth":[]}],"x-audience":"public","x-capability":null,"x-read-only-key":true,"x-auth":"required","x-rate-limit":{"bucket":"json","max":120,"window_seconds":60,"per":"IP address"},"x-cache":{"cache-control":"no-store","etag":false,"notes":"Never cached: it is about the caller. An answer to a key also carries `Vary: Authorization`."},"x-cors":false}},"/{key}/freshness":{"get":{"operationId":"getFreshness","tags":["Entries"],"summary":"When an entry last changed","description":"When the entry last changed, never cached: a cheap way to tell whether a copy you hold is stale. An old name answers for the entry it leads to. Each call counts as someone reading the entry, which helps decide what the Wikidata sync refreshes first; add `quiet` to a call that should not count.","parameters":[{"name":"key","in":"path","required":true,"description":"The entry’s VHID (11 digits), its short name, or one of its old names. Short names are matched exactly.","schema":{"type":"string","minLength":1,"maxLength":255},"example":"james"},{"name":"quiet","in":"query","required":false,"description":"Present (any value): do not count this call as a read.","schema":{"type":"string"},"example":"1"}],"responses":{"200":{"description":"When it last changed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Freshness"},"examples":{"james":{"summary":"An entry","description":"GET /james/freshness?quiet=1","value":{"updated_at":"2026-09-19T12:00:00.000Z"}}}}}},"404":{"description":"No public entry answers to that key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFound"},"examples":{"missing":{"summary":"No such entry","description":"GET /no-such-entry-here/freshness","value":{"error":"not_found"}}}}}},"503":{"description":"The site is down for maintenance. The body is the maintenance page, as HTML. Try again later: `Retry-After` gives the seconds.","content":{"text/html":{}}}},"security":[{},{"bearerAuth":[]}],"x-audience":"public","x-capability":null,"x-read-only-key":true,"x-auth":"optional","x-rate-limit":null,"x-cache":{"cache-control":"no-store","etag":false,"notes":"Never cached, so it is always current."},"x-cors":false}},"/{key}/history.json":{"get":{"operationId":"getEntityHistoryJson","tags":["History"],"summary":"Get an entry’s history, at its history page’s address","description":"The entry’s public revision history as its history page shows it: newest first, 50 to a page, by page number. `GET /api/v1/entities/{vhid}/history` gives the same revisions with `limit` and `offset` instead. An old name redirects (301) to the same address under the entry’s canonical key, query kept. A merged entry’s key answers with that entry’s own history, and `merged_into` names the entry it became. An entry whose history has been hidden answers 403 `history_hidden`, saying how to ask for it through the contact page.\n\nSame-origin only: it sends no CORS headers. A key is not needed. One that is sent is checked: a bad one is refused (400 or 401) before the route runs, and a good one makes the answer private (`Cache-Control: no-store`, `Vary: Authorization`).","parameters":[{"name":"key","in":"path","required":true,"description":"The entry’s VHID (11 digits), its short name, or one of its old names. Short names are matched exactly.","schema":{"type":"string","minLength":1,"maxLength":255},"example":"james"},{"name":"p","in":"query","required":false,"description":"The page, from 1 to 201: the list reads no further than its first 10,000 revisions, as `GET /api/v1/entities/{vhid}/history` does. Anything below 1 or non-numeric reads as 1; a page past 201 answers as page 202, with an empty `history` and `hasMore` false.","schema":{"default":1,"type":"integer","minimum":1,"maximum":201}}],"responses":{"200":{"description":"A page of the history.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EntityHistoryPage"},"examples":{"firstPage":{"summary":"The first page","description":"GET /james/history.json","value":{"vhid":"53500361835","key":"james","page":1,"hasMore":false,"history":[{"ref_id":"r1","kind":"forward","ts":"2026-09-19T12:00:00.000Z","actor":null,"summary":null,"is_bot":false,"source":"import","hidden":false,"deleted":false,"proposer":null}]}}}}}},"301":{"description":"The key is an old name: the same request under the entry’s canonical key.","headers":{"Location":{"description":"The canonical address, query kept.","schema":{"type":"string"}}}},"400":{"description":"A key and a session cookie were both sent.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"401":{"description":"The key sent was refused.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"403":{"description":"The entry’s history is hidden: not public, and how to ask for it.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HistoryHidden"}}}},"404":{"description":"No public entry answers to that key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFound"}}}},"429":{"description":"Too many requests from this IP address in the last minute (at a route that takes a key, an admin key’s are counted per key instead, at the limits set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}},"503":{"description":"The site is down for maintenance. The body is the maintenance page, as HTML. Try again later: `Retry-After` gives the seconds.","content":{"text/html":{}}}},"security":[{},{"bearerAuth":[]}],"x-audience":"public","x-capability":null,"x-read-only-key":true,"x-auth":"optional","x-rate-limit":{"bucket":"json","max":120,"window_seconds":60,"per":"IP address"},"x-cache":{"cache-control":"public, max-age=0, s-maxage=300, stale-while-revalidate=300","surrogate-keys":["entity:<vhid>","entity:<merged_into>"],"etag":false,"notes":"Shared caches keep it for 5 minutes, and an edit purges it at once. Browsers revalidate on every request. `Vary: Accept`; the representation is chosen by the address, never by `Accept`."},"x-cors":false}},"/oauth/token":{"post":{"operationId":"oauthToken","tags":["Connecting an app"],"summary":"Exchange a code, or refresh a connection","description":"The OAuth 2.1 token endpoint, for MCP clients a person has connected to their account. `grant_type=authorization_code` redeems the one-time code the person’s consent sent the client (it works once, for 60 seconds), with the PKCE `code_verifier` whose S256 challenge came with the authorization request, the same `redirect_uri` and `client_id`, and optionally the `resource` (the MCP address the consent was for). `grant_type=refresh_token` swaps the current refresh token for a new pair; the old pair stops working at once. A code presented a second time, or a refresh token that has been replaced, ends the connection: one copy of it was stolen. The connection acts as the person, never above the role ceiling they chose or their role of the moment, read-only if they chose that, until the 7, 30 or 90 days they chose; a refresh never extends it. Public clients only: send `client_id`, and no `Authorization` header, `client_secret` or `client_assertion` (each is refused `invalid_client`, 401).","parameters":[],"requestBody":{"description":"The token request, as a form (at most 8 KB; each field at most once).","required":true,"content":{"application/x-www-form-urlencoded":{"schema":{"type":"object","properties":{"grant_type":{"type":"string","enum":["authorization_code","refresh_token"]},"client_id":{"type":"string","description":"The client’s id: the URL of its Client ID Metadata Document, or the `vhdcr_…` id registration issued it."},"code":{"description":"`authorization_code`: the code (`vhc_…`).","type":"string"},"redirect_uri":{"description":"`authorization_code`: exactly the `redirect_uri` the code was sent to.","type":"string"},"code_verifier":{"description":"`authorization_code`: the PKCE verifier, 43 to 128 characters.","type":"string"},"refresh_token":{"description":"`refresh_token`: the current refresh token (`vhr_…`).","type":"string"},"resource":{"description":"The MCP address the connection is for. When sent, it must be the one the consent named (`invalid_target`).","type":"string"},"scope":{"description":"Ignored: every connection has the one scope, `mcp`.","type":"string"}},"required":["grant_type","client_id"],"additionalProperties":false},"example":{"grant_type":"authorization_code"}}}},"responses":{"200":{"description":"A new access and refresh token.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthTokens"}}}},"400":{"description":"`invalid_request`: not a form, a field sent twice, or a required field missing. `unsupported_grant_type`. `invalid_grant`: the code or refresh token is unknown, expired, already used or replaced, was issued to another client or `redirect_uri`, the verifier does not match, or the person may no longer connect apps at that ceiling. `invalid_target`: the `resource` is not the one the consent named.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthError"},"examples":{"missing-fields":{"summary":"A code exchange with nothing but its grant type","description":"POST /oauth/token","value":{"error":"invalid_request","error_description":"code, redirect_uri, code_verifier and client_id are required."}},"unknown-code":{"summary":"A code the server never issued","description":"POST /oauth/token","value":{"error":"invalid_grant","error_description":"The grant is invalid, expired, already used, or was issued to another client."}},"password-grant":{"summary":"A grant type the server does not offer","description":"POST /oauth/token","value":{"error":"unsupported_grant_type","error_description":"Only authorization_code and refresh_token are supported."}}}}}},"401":{"description":"`invalid_client`. Public clients only: send `client_id`, and no `Authorization` header, `client_secret` or `client_assertion` (each is refused `invalid_client`, 401).","headers":{"WWW-Authenticate":{"description":"In the scheme the client tried.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthError"}}}},"429":{"description":"Too many requests from this IP address in the last minute (at a route that takes a key, an admin key’s are counted per key instead, at the limits set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}},"503":{"description":"Connecting apps is switched off for now (`temporarily_unavailable`). (While the site is down for maintenance, the answer is the maintenance page, as HTML.)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthError"}}}}},"security":[],"x-audience":"public","x-capability":null,"x-read-only-key":false,"x-auth":"ignored","x-rate-limit":{"bucket":"oauth","max":60,"window_seconds":60,"per":"IP address"},"x-cache":{"cache-control":"no-store","etag":false,"notes":"Never cached, and `Pragma: no-cache`: every answer is about one connection."},"x-cors":false}},"/oauth/revoke":{"post":{"operationId":"oauthRevoke","tags":["Connecting an app"],"summary":"Disconnect","description":"Token revocation (RFC 7009). Either of a connection’s current tokens ends the whole connection: the person consented once, so there is one thing to end. A token that is unknown, malformed, replaced, already revoked or expired answers the same empty 200, as the RFC asks. A token issued to another client is refused (`invalid_client`, 401) and nothing is revoked. Public clients only: send `client_id`, and no `Authorization` header, `client_secret` or `client_assertion` (each is refused `invalid_client`, 401).","parameters":[],"requestBody":{"description":"The revocation request, as a form (at most 8 KB; each field at most once).","required":true,"content":{"application/x-www-form-urlencoded":{"schema":{"type":"object","properties":{"token":{"type":"string","description":"The access (`vho_…`) or refresh (`vhr_…`) token."},"client_id":{"type":"string","description":"The client’s id, as it was connected."},"token_type_hint":{"description":"Ignored: the token says which kind it is.","type":"string"}},"required":["token","client_id"],"additionalProperties":false},"example":{"token":"vho_000000000000_AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","client_id":"https://client.example/oauth/metadata.json"}}}},"responses":{"200":{"description":"Done, or there was nothing to do. No body."},"400":{"description":"`invalid_request`: not a form, a field sent twice, or `token` or `client_id` missing.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthError"},"examples":{"no-token":{"summary":"No token sent","description":"POST /oauth/revoke","value":{"error":"invalid_request","error_description":"token and client_id are required."}}}}}},"401":{"description":"`invalid_client`. Public clients only: send `client_id`, and no `Authorization` header, `client_secret` or `client_assertion` (each is refused `invalid_client`, 401).","headers":{"WWW-Authenticate":{"description":"In the scheme the client tried.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthError"}}}},"429":{"description":"Too many requests from this IP address in the last minute (at a route that takes a key, an admin key’s are counted per key instead, at the limits set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}},"503":{"description":"Connecting apps is switched off for now (`temporarily_unavailable`). (While the site is down for maintenance, the answer is the maintenance page, as HTML.)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthError"}}}}},"security":[],"x-audience":"public","x-capability":null,"x-read-only-key":false,"x-auth":"ignored","x-rate-limit":{"bucket":"oauth","max":60,"window_seconds":60,"per":"IP address"},"x-cache":{"cache-control":"no-store","etag":false,"notes":"Never cached, and `Pragma: no-cache`: every answer is about one connection."},"x-cors":false}},"/oauth/register":{"post":{"operationId":"oauthRegister","tags":["Connecting an app"],"summary":"Register a client","description":"Dynamic Client Registration (RFC 7591), for an MCP client without a Client ID Metadata Document (Cursor is one). It sends its `client_name` and `redirect_uris` and gets a `client_id` back; there is no secret, and nothing is checked about who made it, so when a person connects such an app the consent page marks it unverified and shows where it returns them to. A redirect URI is kept when it is `https:`, loopback `http:` (127.0.0.1, [::1] or localhost; any port then matches) or a private-use scheme with a dot (RFC 8252 §7.1, such as `com.example.app:/callback`; never one that is or starts with http, https, javascript, data, file, vbscript, about or blob), and dropped otherwise. Only `client_name`, `redirect_uris`, `token_endpoint_auth_method` (`none` or absent), `grant_types` and `response_types` are read; nothing in the request is ever fetched. A client never used for a consent is deleted 24 hours after it registered; a used one once none of its connections has been live for 90 days. Any `Authorization` header is ignored: a registration acts for no account.","parameters":[],"requestBody":{"description":"The client’s metadata, as JSON (at most 32 KB).","required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"client_name":{"type":"string","description":"Required: 1 to 100 characters, shown to the person as the name the app gave itself."},"redirect_uris":{"minItems":1,"maxItems":10,"type":"array","items":{"type":"string"},"description":"Where the person may be sent back to; at least one must be kept."},"token_endpoint_auth_method":{"type":"string","const":"none"},"grant_types":{"description":"When sent, must include `authorization_code`.","type":"array","items":{"type":"string"}},"response_types":{"description":"When sent, must include `code`.","type":"array","items":{"type":"string"}}},"required":["client_name","redirect_uris"],"additionalProperties":{}},"example":{"client_name":"Example MCP Client","redirect_uris":["https://client.example/oauth/callback","http://localhost:8787/callback","example://oauth/callback"],"grant_types":["authorization_code","refresh_token"],"response_types":["code"],"token_endpoint_auth_method":"none"}}}},"responses":{"201":{"description":"Registered.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthRegisteredClient"},"examples":{"cursor":{"summary":"A client registering an https, a loopback and a dotless custom redirect URI (the last is dropped)","description":"POST /oauth/register","value":{"client_id":"vhdcr_AAAAAAAAAAAAAAAAAAAAAA","client_id_issued_at":1791460800,"client_name":"Example MCP Client","redirect_uris":["https://client.example/oauth/callback","http://localhost:8787/callback"],"grant_types":["authorization_code","refresh_token"],"response_types":["code"],"token_endpoint_auth_method":"none"}}}}}},"400":{"description":"`invalid_client_metadata`: not JSON, not an object, no usable `client_name`, a client secret asked for, or `grant_types`/`response_types` without the code flow. `invalid_redirect_uri`: `redirect_uris` missing, more than 10, or none of them one the server accepts.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthRegisterError"},"examples":{"no-usable-redirect":{"summary":"A registration whose only redirect URI is one the server never sends a code to","description":"POST /oauth/register","value":{"error":"invalid_redirect_uri","error_description":"None of the redirect_uris is one this server accepts: https:, loopback http: (127.0.0.1, [::1] or localhost), or a private-use scheme with a dot, such as com.example.app:/callback."}},"confidential-client":{"summary":"A client that wants a secret","description":"POST /oauth/register","value":{"error":"invalid_client_metadata","error_description":"Only public clients can register: token_endpoint_auth_method must be none."}}}}}},"429":{"description":"Too many registrations from this IP address in the last hour (10), as plain text; or, while 1,000 registered clients have never been used, `temporarily_unavailable` as JSON. Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until it may succeed.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}},"503":{"description":"Connecting apps is switched off for now (`temporarily_unavailable`).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthRegisterError"}}}}},"security":[],"x-audience":"public","x-capability":null,"x-read-only-key":false,"x-auth":"ignored","x-rate-limit":{"bucket":"oauth-register","max":10,"window_seconds":3600,"per":"IP address"},"x-cache":{"cache-control":"no-store","etag":false,"notes":"Never cached, and `Pragma: no-cache`: every answer is about one connection."},"x-cors":false}},"/.well-known/oauth-protected-resource/mcp/account":{"get":{"operationId":"oauthProtectedResourceAccount","tags":["Connecting an app"],"summary":"Where to sign in for /mcp/account","description":"RFC 9728 protected resource metadata for the MCP address `/mcp/account`, the one that signs a person in: with no token it answers `401`. A `401` from that address names this document in its `WWW-Authenticate` header (`resource_metadata`), so an MCP client finds it by itself.","parameters":[],"responses":{"200":{"description":"The document.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthProtectedResource"},"examples":{"document":{"summary":"The document for /mcp/account","description":"GET /.well-known/oauth-protected-resource/mcp/account","value":{"resource":"https://verifiedhandles.org/mcp/account","authorization_servers":["https://verifiedhandles.org"],"scopes_supported":["mcp"],"bearer_methods_supported":["header"],"resource_name":"Verified Handles","resource_documentation":"https://verifiedhandles.org/developers/mcp"}}}}}},"429":{"description":"Too many requests from this IP address in the last minute (at a route that takes a key, an admin key’s are counted per key instead, at the limits set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}}},"security":[],"x-audience":"public","x-capability":null,"x-read-only-key":true,"x-auth":"ignored","x-rate-limit":{"bucket":"json","max":120,"window_seconds":60,"per":"IP address"},"x-cache":{"cache-control":"public, max-age=3600","surrogate-keys":["static:oauth-metadata"],"etag":false,"notes":"The same for everyone; it changes only with a release, whose cache ban clears it."},"x-cors":false}},"/.well-known/oauth-protected-resource/mcp":{"get":{"operationId":"oauthProtectedResourceMcp","tags":["Connecting an app"],"summary":"Where to sign in for /mcp","description":"RFC 9728 protected resource metadata for the MCP address `/mcp`, which also answers with no token at all, with the public reads. A `401` from that address names this document in its `WWW-Authenticate` header (`resource_metadata`), so an MCP client finds it by itself.","parameters":[],"responses":{"200":{"description":"The document.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthProtectedResource"},"examples":{"document":{"summary":"The document for /mcp","description":"GET /.well-known/oauth-protected-resource/mcp","value":{"resource":"https://verifiedhandles.org/mcp","authorization_servers":["https://verifiedhandles.org"],"scopes_supported":["mcp"],"bearer_methods_supported":["header"],"resource_name":"Verified Handles","resource_documentation":"https://verifiedhandles.org/developers/mcp"}}}}}},"429":{"description":"Too many requests from this IP address in the last minute (at a route that takes a key, an admin key’s are counted per key instead, at the limits set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}}},"security":[],"x-audience":"public","x-capability":null,"x-read-only-key":true,"x-auth":"ignored","x-rate-limit":{"bucket":"json","max":120,"window_seconds":60,"per":"IP address"},"x-cache":{"cache-control":"public, max-age=3600","surrogate-keys":["static:oauth-metadata"],"etag":false,"notes":"The same for everyone; it changes only with a release, whose cache ban clears it."},"x-cors":false}},"/.well-known/oauth-authorization-server":{"get":{"operationId":"oauthAuthorizationServer","tags":["Connecting an app"],"summary":"The authorization server","description":"RFC 8414 authorization server metadata: where to send the person (`authorization_endpoint`), where to get and refresh tokens, and what the server supports. The authorization code flow with PKCE (S256), for public clients that identify themselves with a Client ID Metadata Document; one scope, `mcp`. What a connection may do is the person’s choice when they connect it (a role ceiling, read only, 7, 30 or 90 days), not a scope.","parameters":[],"responses":{"200":{"description":"The document.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/OAuthAuthorizationServer"},"examples":{"document":{"summary":"The document","description":"GET /.well-known/oauth-authorization-server","value":{"issuer":"https://verifiedhandles.org","authorization_endpoint":"https://verifiedhandles.org/management-console/oauth/authorize","token_endpoint":"https://verifiedhandles.org/oauth/token","revocation_endpoint":"https://verifiedhandles.org/oauth/revoke","registration_endpoint":"https://verifiedhandles.org/oauth/register","response_types_supported":["code"],"grant_types_supported":["authorization_code","refresh_token"],"code_challenge_methods_supported":["S256"],"token_endpoint_auth_methods_supported":["none"],"revocation_endpoint_auth_methods_supported":["none"],"scopes_supported":["mcp"],"client_id_metadata_document_supported":true,"authorization_response_iss_parameter_supported":true,"service_documentation":"https://verifiedhandles.org/developers/mcp"}}}}}},"429":{"description":"Too many requests from this IP address in the last minute (at a route that takes a key, an admin key’s are counted per key instead, at the limits set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}}},"security":[],"x-audience":"public","x-capability":null,"x-read-only-key":true,"x-auth":"ignored","x-rate-limit":{"bucket":"json","max":120,"window_seconds":60,"per":"IP address"},"x-cache":{"cache-control":"public, max-age=3600","surrogate-keys":["static:oauth-metadata"],"etag":false,"notes":"The same for everyone; it changes only with a release, whose cache ban clears it."},"x-cors":false}},"/{key}.json":{"get":{"operationId":"getEntityJson","tags":["Entries"],"summary":"Get an entry, at its page’s address","description":"The entry as data, at its page’s address plus `.json`: the same body as `GET /api/v1/entities/{vhid}`. An old name or a merged entry’s key answers with the entry it now leads to, without a redirect; `url` is that entry’s canonical page, and its own `.json` is that plus `.json`. A key nothing answers to is a JSON 404 and is never redirected to a guess, as the page would be.\n\nSame-origin only: it sends no CORS headers (use `/api/v1` from a browser on another site). A key is not needed. One that is sent is checked: a bad one is refused (400 or 401) before the route runs, and a good one makes the answer private (`Cache-Control: no-store`, `Vary: Authorization`).","parameters":[{"name":"key","in":"path","required":true,"description":"The entry’s VHID (11 digits), its short name, or one of its old names. Short names are matched exactly. Written before `.json`, so `/james.json` or `/53500361835.json`.","schema":{"type":"string","minLength":1,"maxLength":255},"example":"james"}],"responses":{"200":{"description":"The entry.","headers":{"ETag":{"description":"The version of this representation.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Entity"},"examples":{"byShort":{"summary":"An entry by its short name","description":"GET /james.json","value":{"vhid":"53500361835","short":"james","title":"James Haworth","subtitle":null,"entity_type":"person","entity_kind":"person","verified":true,"description":null,"description_source":null,"description_license":null,"url":"https://verifiedhandles.org/james","image":"/img/w/480q75/3","image_rights":{"source":"upload","license":null,"license_name":null,"license_url":null,"freely_licensed":null,"credit":null,"source_page":null,"details_url":"https://verifiedhandles.org/james/image"},"images":[{"url":"/img/w/480q75/3","main":true,"image_rights":{"source":"upload","license":null,"license_name":null,"license_url":null,"freely_licensed":null,"credit":null,"source_page":null,"details_url":"https://verifiedhandles.org/james/image"},"link":null}],"handles":[{"platform":"twitter","name":"X (Twitter)","category":"social","value":"james","display":null,"url":"https://x.com/james","verified":false},{"platform":"linkedin","name":"LinkedIn","category":"social","value":"james-haworth","display":null,"url":"https://www.linkedin.com/in/james-haworth","verified":false},{"platform":"instagram","name":"Instagram","category":"social","value":"jameshaworth","display":null,"url":"https://instagram.com/jameshaworth","verified":false},{"platform":"email","name":"Email","category":"messaging","value":null,"display":null,"url":null,"verified":false}]}}}}}},"304":{"description":"Unchanged since the ETag sent in `If-None-Match`. No body."},"400":{"description":"A key and a session cookie were both sent.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"401":{"description":"The key sent was refused.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"404":{"description":"No public entry answers to that key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotFoundKey"},"examples":{"notFound":{"summary":"A key nothing answers to","description":"GET /no-such-entry.json","value":{"error":"not_found","key":"no-such-entry"}}}}}},"429":{"description":"Too many requests from this IP address in the last minute (at a route that takes a key, an admin key’s are counted per key instead, at the limits set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}},"503":{"description":"The site is down for maintenance. The body is the maintenance page, as HTML. Try again later: `Retry-After` gives the seconds.","content":{"text/html":{}}}},"security":[{},{"bearerAuth":[]}],"x-audience":"public","x-capability":null,"x-read-only-key":true,"x-auth":"optional","x-rate-limit":{"bucket":"json","max":120,"window_seconds":60,"per":"IP address"},"x-cache":{"cache-control":"public, max-age=60, s-maxage=2592000, stale-while-revalidate=86400, stale-if-error=604800","surrogate-keys":["entity:<vhid>","kind:<entity_kind>","type:<entity_type>"],"etag":true,"notes":"Shared caches may keep it for 30 days; an edit to the entry purges it at once. Browsers keep it for a minute. A strong ETag answers `If-None-Match` with a 304. `Vary: Accept`, as every page with a twin sends: the representation is chosen by the address, never by `Accept`."},"x-cors":false}},"/get_data":{"get":{"operationId":"typeahead","tags":["Search"],"summary":"Suggest entries as a name is typed","description":"What the search box suggests: up to 10 entries whose name starts with, contains or nearly matches the text, best first. With no text, the trending entries. A blocked word answers `[\"block\"]`. Its shape is the old site’s, kept for the search box; for anything else `GET /api/v1/search` is the better read, with paging and the entries’ details.\n\nSame-origin only: it sends no CORS headers. A key is not needed. One that is sent is checked: a bad one is refused (400 or 401) before the route runs, and a good one makes the answer private (`Cache-Control: no-store`, `Vary: Authorization`).","parameters":[{"name":"search_query","in":"query","required":false,"description":"The text typed so far; cut to 100 characters. Empty: the trending entries.","schema":{"type":"string","maxLength":100},"example":"jam"}],"responses":{"200":{"description":"The suggestions, or `[\"block\"]`.","content":{"application/json":{"schema":{"anyOf":[{"type":"array","items":{"$ref":"#/components/schemas/TypeaheadRow"}},{"type":"array","prefixItems":[{"type":"string","const":"block"}],"items":false,"minItems":1,"maxItems":1}]},"examples":{"jam":{"summary":"Part of a name","description":"GET /get_data?search_query=jam","value":[{"VHID":"53500361835","Title":"James Haworth","Subtitle":null,"short":"james","V":"1","S":"0","T":""}]}}}}},"400":{"description":"A key and a session cookie were both sent.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"401":{"description":"The key sent was refused.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"429":{"description":"Too many requests from this IP address in the last minute (at a route that takes a key, an admin key’s are counted per key instead, at the limits set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}},"503":{"description":"The site is down for maintenance. The body is the maintenance page, as HTML. Try again later: `Retry-After` gives the seconds.","content":{"text/html":{}}}},"security":[{},{"bearerAuth":[]}],"x-audience":"public","x-capability":null,"x-read-only-key":true,"x-auth":"optional","x-rate-limit":{"bucket":"json","max":120,"window_seconds":60,"per":"IP address"},"x-cache":{"cache-control":"public, max-age=0, s-maxage=60, stale-while-revalidate=60","surrogate-keys":["listing"],"etag":false,"notes":"Shared caches keep it for a minute (with no text: `public, max-age=0, s-maxage=60`), and any change to an entry’s listing purges it. A blocked word is never cached."},"x-cors":false}},"/{key}/report":{"post":{"operationId":"reportEntry","tags":["Reporting an entry"],"summary":"Report an entry","description":"Reports a problem with an entry to the site’s reviewers. It is the report page’s own form, so it answers as the form does: a 303 back to the page, `?sent=1` when the report was taken, `?error=<what>` when it was not (`reason`: no such reason, or an image report on an entry with no image; `note`: an image report needs a note; `blocked`: the note has a word the site does not take). An image report names the image (`media`), or the lead image is meant.","parameters":[{"name":"key","in":"path","required":true,"description":"The entry’s VHID or short name.","schema":{"type":"string","minLength":1,"maxLength":255},"example":"james"}],"requestBody":{"description":"The report, as a form.","required":true,"content":{"application/x-www-form-urlencoded":{"schema":{"type":"object","properties":{"reason":{"type":"string","enum":["impersonation","incorrect","outdated","abuse","image","image_link","other"],"description":"`impersonation`: a handle is not the real account. `incorrect`, `outdated`, `abuse`, `other`. `image`: the image is used without permission, credited or licensed wrongly, or shows me. `image_link`: an image’s link goes somewhere wrong."},"note":{"description":"What is wrong, in your words. Needed for `image`. Cut to 1,000 characters.","type":"string","maxLength":1000},"media":{"description":"For `image` or `image_link`: which of the entry’s images, by media id.","type":"string"}},"required":["reason"],"additionalProperties":false},"example":{"reason":"outdated","note":"The Instagram account was renamed."}}}},"responses":{"301":{"description":"An old name: the same request belongs at the entry’s current key.","headers":{"Location":{"description":"The report page at the current key.","schema":{"type":"string"}}}},"303":{"description":"Back to the report page: `?sent=1` when taken, `?error=<what>` when not.","headers":{"Location":{"description":"The report page, with the outcome in its query.","schema":{"type":"string"}}}},"400":{"description":"Or the request sent a key and a session cookie together (`bearer_with_cookie`): send one.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyRefusal"}}}},"401":{"description":"No key was sent (`auth_required`), or the key was refused: unknown, revoked or expired, its holder may no longer use keys, or this instance takes none. Carries `WWW-Authenticate: Bearer`. After 60 refused keys from one IP address in a minute, every key from there is answered `429` (text, with `Retry-After`) until the minute is up.","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/AuthRequired"},{"$ref":"#/components/schemas/ApiKeyRefusal"}]}}}},"403":{"description":"A read-only key tried to change something (`read_only_key`), or the account is blocked (`forbidden`).","content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/Forbidden"},{"$ref":"#/components/schemas/ApiKeyRefusal"}]}}}},"404":{"description":"No public entry answers to that key. The body is a page.","content":{"text/html":{}}},"429":{"description":"Too many changes in the last minute: counted per IP address, per account and per key (an admin key’s per key alone, at the limit set on Console → Rate limits). Wait the number of seconds `Retry-After` gives.","headers":{"Retry-After":{"description":"Seconds until the window resets.","schema":{"type":"string"}}},"content":{"text/plain":{"schema":{"type":"string","const":"Too Many Requests"}}}},"503":{"description":"The site is down for maintenance. The body is the maintenance page, as HTML. Try again later: `Retry-After` gives the seconds.","content":{"text/html":{}}}},"security":[{"bearerAuth":[]}],"x-audience":"public","x-capability":null,"x-read-only-key":false,"x-auth":"required","x-rate-limit":{"bucket":"mutation"},"x-cache":{"cache-control":"no-store","etag":false,"notes":"A redirect, never cached."},"x-cors":false}}},"x-mcp-tools":{"endpoint":"https://verifiedhandles.org/mcp","transport":"streamable-http","authentication":"An API key, as `Authorization: Bearer`: the tools listed are the ones the key may use. With no `Authorization` header at all, only the tools marked `keyless: true`, as a signed-out visitor.","docs":"https://verifiedhandles.org/developers/mcp","contract":"A tool that changes something (`write: true`) writes nothing unless called with `dry_run: false`: by default it answers what it would change and the exact request it would send. A tool with `confirm: true` also needs `confirm` set to the exact target its dry run names. A read-only key is shown no write tool. Every call goes through the site’s own routes as the key’s account, and every change is audited with the key and the tool.","tools":[{"name":"get_entry","title":"Get an entry","description":"One entry, by VHID, short name or Wikidata QID: its public record (title, description, handles, image, URL) and, as `editing`, what the editor would load for this key — the current revision, the editable fields, every handle with who manages it (the Wikidata sync or the site), which fields the sync manages, and whether this key may edit it live. Without an API key, the public record alone.","write":false,"confirm":false,"capabilities":[],"role":null,"keyless":true,"liveEdit":false,"linkImages":false,"input":{"type":"object","properties":{"entry":{"type":"string","minLength":1,"maxLength":200,"pattern":"^(?!\\.{1,2}$)","description":"The entry: its VHID (11 digits), its short name (as in verifiedhandles.org/<short>), or its Wikidata QID (Q42)."},"include_platforms":{"default":false,"description":"Also list every platform a handle can be on (id, name, URL prefix). Needs an API key.","type":"boolean"}},"required":["entry"]},"output":{"type":"object","properties":{"vhid":{"type":"string","pattern":"^\\d{11}$","description":"The entry’s VHID: 11 digits, permanent."},"entry":{"anyOf":[{"type":"object","properties":{"vhid":{"type":"string","pattern":"^\\d{11}$","description":"The entry’s VHID: 11 digits, permanent."},"short":{"description":"The entry’s short name (`/<short>`), if it has one.","type":["string","null"]},"title":{"type":"string"},"subtitle":{"type":["string","null"]},"entity_type":{"description":"What it is, from its Wikidata item: `person`, `organization` or `brand`; null when unknown. `entity_kind` says more.","type":["string","null"]},"entity_kind":{"anyOf":[{"type":"string","enum":["person","musical_group","sports_organization","broadcaster","publisher","educational_institution","research_organization","religious_organization","museum","financial_institution","chain","nonprofit","company","organization","show","website","brand"]},{"type":"null"}],"description":"The finer kind of thing it is, from its Wikidata item’s classes; null when unknown (an organisation or a brand not yet read since kinds were added reads null until the sync next reads its item). Each kind belongs to one `entity_type`, and `person`, `organization` and `brand` are also the kinds of an entry of that type with no finer one. The kinds, with their type: `person` (person: person), `musical_group` (organization: musical group), `sports_organization` (organization: sports organisation), `broadcaster` (organization: broadcaster), `publisher` (organization: publisher), `educational_institution` (organization: educational institution), `research_organization` (organization: research organisation), `religious_organization` (organization: religious organisation), `museum` (organization: museum), `financial_institution` (organization: financial institution), `chain` (organization: retail or hospitality chain), `nonprofit` (organization: charity or non-profit), `company` (organization: company), `organization` (organization: organisation), `show` (brand: show), `website` (brand: website or app), `brand` (brand: brand). New kinds may be added; treat an unknown value as its `entity_type`."},"verified":{"type":"boolean","description":"Verified Handles has verified the entry."},"description":{"description":"The description as sanitised HTML, links to other entries named as they are today.","type":["string","null"]},"description_source":{"anyOf":[{"type":"object","properties":{"kind":{"type":"string","description":"The source’s kind (`wikipedia`)."},"title":{"type":"string","description":"The page’s title, underscored (`Draft:` first for a draft)."},"url":{"type":"string","description":"The page."},"adapted":{"description":"Present and true when the text has been edited on the site since.","type":"boolean"},"revision":{"description":"The page’s revision the text was taken from: its permalink is `https://en.wikipedia.org/w/index.php?title=<title>&oldid=<revision>`. Absent on a credit from before revisions were kept.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"draft":{"description":"Present and true when the page is an English Wikipedia draft (the Draft namespace), not yet an article.","type":"boolean","const":true}},"required":["kind","title","url"],"additionalProperties":{},"description":"The English Wikipedia page an entry’s description was taken from: an article, or a draft (`draft: true`)."},{"type":"null"}]},"description_license":{"anyOf":[{"type":"string","const":"CC-BY-SA-4.0"},{"type":"null"}],"description":"The description’s licence, as an SPDX id: `CC-BY-SA-4.0` when it was taken from Wikipedia (`description_source` is set), which means crediting the article and sharing alike. Null otherwise: the description is CC0 like the rest of the text."},"url":{"type":"string","description":"The entry’s canonical page."},"image":{"description":"The lead image (the same as `images[0].url`), or null.","type":["string","null"]},"image_rights":{"anyOf":[{"type":"object","properties":{"source":{"type":"string","enum":["wikimedia_commons","upload"],"description":"Where the image came from."},"license":{"anyOf":[{"type":"string","enum":["cc0-1.0","public-domain","cc-by-4.0","cc-by-sa-4.0","supplied","permission","none"]},{"type":"null"}],"description":"An upload’s licence, by id. Null for a Commons image (see `license_name`) or when none was recorded."},"license_name":{"description":"The licence’s name, e.g. \"CC BY-SA 4.0\". Null until it is known.","type":["string","null"]},"license_url":{"description":"The licence’s text.","type":["string","null"]},"freely_licensed":{"description":"May be reused under a free licence. Null when no licence is recorded.","type":["boolean","null"]},"credit":{"description":"The credit line to show when reusing the image.","type":["string","null"]},"source_page":{"description":"The image’s Wikimedia Commons file page, which states its licence and author.","type":["string","null"]},"details_url":{"type":"string","description":"The entry’s \"About this image\" page."}},"required":["source","license","license_name","license_url","freely_licensed","credit","source_page","details_url"],"additionalProperties":{},"description":"Who owns an image and how it may be reused. An entry’s text is CC0 (bar a description taken from Wikipedia); its images are licensed separately, by their owners."},{"type":"null"}],"description":"The lead image’s rights, or null when there is no image."},"images":{"type":"array","items":{"type":"object","properties":{"url":{"type":"string","description":"The image, as a path on this site (`/img/w/480q75/<id>`)."},"main":{"type":"boolean","description":"True for the lead image, false for the gallery images after it."},"image_rights":{"type":"object","properties":{"source":{"type":"string","enum":["wikimedia_commons","upload"],"description":"Where the image came from."},"license":{"anyOf":[{"type":"string","enum":["cc0-1.0","public-domain","cc-by-4.0","cc-by-sa-4.0","supplied","permission","none"]},{"type":"null"}],"description":"An upload’s licence, by id. Null for a Commons image (see `license_name`) or when none was recorded."},"license_name":{"description":"The licence’s name, e.g. \"CC BY-SA 4.0\". Null until it is known.","type":["string","null"]},"license_url":{"description":"The licence’s text.","type":["string","null"]},"freely_licensed":{"description":"May be reused under a free licence. Null when no licence is recorded.","type":["boolean","null"]},"credit":{"description":"The credit line to show when reusing the image.","type":["string","null"]},"source_page":{"description":"The image’s Wikimedia Commons file page, which states its licence and author.","type":["string","null"]},"details_url":{"type":"string","description":"The entry’s \"About this image\" page."}},"required":["source","license","license_name","license_url","freely_licensed","credit","source_page","details_url"],"additionalProperties":{},"description":"Who owns an image and how it may be reused. An entry’s text is CC0 (bar a description taken from Wikipedia); its images are licensed separately, by their owners."},"link":{"description":"Where the image links on the entry page instead of opening the full-screen viewer, or null.","type":["string","null"]}},"required":["url","main","image_rights","link"],"additionalProperties":{},"description":"One image an entry shows."},"description":"Every image the entry shows, the lead first. Empty when it shows none."},"handles":{"type":"array","items":{"type":"object","properties":{"platform":{"type":"string","description":"The platform’s id (`twitter`, `instagram`, `wikidata`, …)."},"name":{"type":"string","description":"The platform’s display name."},"category":{"type":"string","enum":["social","messaging","website","identifier"],"description":"How the entry page groups it."},"value":{"description":"The handle as stored (a username, an id, a URL). Null for an email address, which is never published as data.","type":["string","null"]},"display":{"description":"The label the entry page shows instead of the value, if an editor set one. Null for email.","type":["string","null"]},"url":{"description":"The profile’s address, built from the platform’s URL pattern. Null for email.","type":["string","null"]},"verified":{"type":"boolean","description":"Verified Handles has checked that this account belongs to the entry."},"checked":{"description":"What Verified Handles’ own handle checker found when it last looked at this account, from the platform’s official API: only on YouTube (channel and handle), Deezer and GitHub, and only for a look at most 7 days old. Absent otherwise. The entry page shows it only for `dead` (“Not found when checked …”) and `renamed`.","type":"object","properties":{"verdict":{"type":"string","enum":["live","dead","renamed","unknown"],"description":"`live`: the profile was there. `dead`: the platform did not find it. `renamed`: it answers under another name. `unknown`: the platform gave no answer a rule could read."},"at":{"type":"string","description":"When it looked (ISO 8601, UTC)."},"now":{"description":"For `renamed`, the name it answers to now, when the platform gave one. A YouTube handle’s is lowercase.","type":"string"}},"required":["verdict","at"],"additionalProperties":{}}},"required":["platform","name","category","value","display","url","verified"],"additionalProperties":{},"description":"One account or identifier of an entry, in the order the entry page shows them. A Wikidata item linked to the entry comes last, as platform `wikidata`."}}},"required":["vhid","short","title","subtitle","entity_type","entity_kind","verified","description","description_source","description_license","url","image","image_rights","images","handles"],"additionalProperties":{},"description":"An entry: the same data its page shows, from the same code. Email addresses are masked. The text is CC0, except a description taken from Wikipedia (`description_license`)."},{"type":"null"}],"description":"The entry’s public record, as GET /api/v1/entities/{vhid} answers it. Null for a VHID that is not public (a deleted entry): `editing` says more."},"editing":{"description":"With an API key: what the editor loads for this key (GET /api/editor/{vhid}): `baseRevisionId`, `capabilities` (whether it may edit live or propose), `editable`, `handles`, `provenance` (which fields the Wikidata sync manages), `qid`, and `platforms` with include_platforms. Where the key may not open the editor, the route’s `status` and `error`. Absent with no key.","type":"object","properties":{},"additionalProperties":{}}},"required":["vhid","entry"],"additionalProperties":{},"description":"One entry: its public record and, with an API key, what the editor would load for it."}},{"name":"search_entries","title":"Search entries","description":"Search the entries as the site search does: words match titles, subtitles and descriptions; a Wikidata QID finds the entries linked to it; a VHID finds that entry and the entries that link to it.","write":false,"confirm":false,"capabilities":[],"role":null,"keyless":true,"liveEdit":false,"linkImages":false,"input":{"type":"object","properties":{"query":{"type":"string","minLength":1,"maxLength":100},"limit":{"default":20,"type":"integer","minimum":1,"maximum":50},"offset":{"default":0,"type":"integer","minimum":0,"maximum":10000}},"required":["query"]},"output":{"type":"object","properties":{"query":{"type":"string","description":"The query as it was read: trimmed and cut to 100 characters."},"total":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"How many entries matched in all."},"limit":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"The page size used: the `limit` asked for, clamped to the endpoint’s range."},"offset":{"type":"integer","minimum":0,"maximum":10000,"description":"The offset used: the `offset` asked for, clamped to 0–10,000."},"next_offset":{"anyOf":[{"type":"integer","minimum":1,"maximum":9007199254740991},{"type":"null"}],"description":"The `offset` of the next page, or null when this is the last one. Follow it rather than computing it."},"results":{"type":"array","items":{"type":"object","properties":{"vhid":{"type":"string","pattern":"^\\d{11}$","description":"The entry’s VHID: 11 digits, permanent."},"short":{"description":"The entry’s short name (`/<short>`), if it has one.","type":["string","null"]},"title":{"type":"string"},"subtitle":{"type":["string","null"]},"verified":{"type":"boolean"},"snippet":{"description":"Plain text from the description around the words that matched, or null when the match was not in it.","type":["string","null"]},"highlighted":{"type":"boolean","description":"`snippet` is a real excerpt (true), or there is none (false)."},"url":{"type":"string","description":"The entry’s page."}},"required":["vhid","short","title","subtitle","verified","snippet","highlighted","url"],"additionalProperties":{},"description":"One entry that matched."},"description":"Best match first."}},"required":["query","total","results"],"additionalProperties":{}}},{"name":"find_by_handle","title":"Find entries by handle","description":"Which public entries list a handle: “is x.com/someone an official account, and whose?”. Give a profile’s address as url (https://x.com/someone), or platform (its catalog id: twitter, instagram, youtube, …) and value (someone or @someone). Answers each entry’s VHID, title and URL, the handle as the entry lists it, and whether that handle is verified; an empty list when no entry lists it. Case is ignored where the platform ignores it. Email addresses are not looked up.","write":false,"confirm":false,"capabilities":[],"role":null,"keyless":true,"liveEdit":false,"linkImages":false,"input":{"type":"object","properties":{"url":{"description":"A profile’s address, such as https://x.com/someone. Instead of platform and value.","type":"string","minLength":1,"maxLength":1000},"platform":{"description":"The platform’s catalog id, such as twitter. With value.","type":"string","minLength":1,"maxLength":100},"value":{"description":"The handle on that platform, such as someone or @someone.","type":"string","minLength":1,"maxLength":1000}}},"output":{"type":"object","properties":{"platform":{"type":"string","description":"The platform looked on: the one asked, or the one whose address `url` is."},"value":{"type":"string","description":"The handle looked up, as the site stores one: from `url`, what follows the platform’s address."},"results":{"type":"array","items":{"type":"object","properties":{"vhid":{"type":"string","description":"The entry’s VHID."},"title":{"type":"string","description":"The entry’s title."},"url":{"type":"string","description":"The entry’s page."},"value":{"type":"string","description":"The handle as the entry lists it: on a platform that ignores case, its case may differ from the value asked."},"verified":{"type":"boolean","description":"Whether the handle itself is verified on this entry (not the entry’s own badge)."}},"required":["vhid","title","url","value","verified"],"additionalProperties":{},"description":"An entry that lists the handle."},"description":"Verified handles first, then by VHID; at most 50. Empty when no public entry lists it."}},"required":["platform","value","results"],"additionalProperties":{},"description":"The public entries that list a handle."}},{"name":"get_entry_history","title":"Entry history","description":"An entry’s public edit history, newest first (`next_offset` pages on). A merged entry’s key gives its own history.","write":false,"confirm":false,"capabilities":[],"role":null,"keyless":true,"liveEdit":false,"linkImages":false,"input":{"type":"object","properties":{"entry":{"type":"string","minLength":1,"maxLength":200,"pattern":"^(?!\\.{1,2}$)","description":"The entry: its VHID (11 digits), its short name (as in verifiedhandles.org/<short>), or its Wikidata QID (Q42)."},"limit":{"default":50,"type":"integer","minimum":1,"maximum":200},"offset":{"default":0,"type":"integer","minimum":0,"maximum":10000}},"required":["entry"]},"output":{"type":"object","properties":{"vhid":{"type":"string","pattern":"^\\d{11}$","description":"The entry’s VHID: 11 digits, permanent."},"merged_into":{"description":"Present when the entry was merged into another: that entry’s VHID. The history is still the merged entry’s own.","type":"string","pattern":"^\\d{11}$"},"limit":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"The page size used: the `limit` asked for, clamped to the endpoint’s range."},"offset":{"type":"integer","minimum":0,"maximum":10000,"description":"The offset used: the `offset` asked for, clamped to 0–10,000."},"next_offset":{"anyOf":[{"type":"integer","minimum":1,"maximum":9007199254740991},{"type":"null"}],"description":"The `offset` of the next page, or null when this is the last one. Follow it rather than computing it."},"history":{"type":"array","items":{"type":"object","properties":{"ref_id":{"type":"string","pattern":"^[ar]\\d+$","description":"The revision’s id: `a<n>` for the history kept from the old wiki, `r<n>` for an edit made since."},"kind":{"type":"string","enum":["archive","forward"],"description":"`archive`: from the old wiki. `forward`: made on Verified Handles."},"ts":{"anyOf":[{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"},{"type":"null"}],"description":"When it was made."},"actor":{"description":"Who made it, as they chose to be named in public; null when they keep their name private.","type":["string","null"]},"summary":{"description":"The edit summary.","type":["string","null"]},"is_bot":{"description":"Made by an automated process (the Wikidata sync, an import).","type":["boolean","null"]},"source":{"type":"string","enum":["import","mediawiki","sync","admin","trusted","submission","claim"],"description":"How the edit was made."},"hidden":{"type":"boolean","const":false,"description":"Always false here: a hidden revision is never in the public history."},"deleted":{"type":"boolean","const":false,"description":"Always false here: a deleted revision is never in the public history."},"proposer":{"description":"For an approved proposal, who proposed it, as they chose to be named; null otherwise.","type":["string","null"]}},"required":["ref_id","kind","ts","actor","summary","is_bot","source","hidden","deleted","proposer"],"additionalProperties":{},"description":"One revision in an entry’s public history."},"description":"Newest first."}},"required":["vhid","limit","offset","next_offset","history"],"additionalProperties":{},"description":"A page of an entry’s public revision history, newest first."}},{"name":"get_entries","title":"Get many entries","description":"Up to 50 entries’ public records in one call, by VHID or short name (not a Wikidata QID: get_entry or search_entries finds an entry by its item), each answered as get_entry answers it signed out — the entry, or not_found — in the order given. A name given twice is answered once.","write":false,"confirm":false,"capabilities":[],"role":null,"keyless":true,"liveEdit":false,"linkImages":false,"input":{"type":"object","properties":{"entries":{"minItems":1,"maxItems":50,"type":"array","items":{"type":"string","minLength":1,"maxLength":255,"allOf":[{"pattern":"^(?!\\.{1,2}$)"},{"pattern":"^[^,]*$"}]},"description":"The entries: each a VHID (11 digits) or a short name."}},"required":["entries"]},"output":{"type":"object","properties":{"results":{"type":"array","items":{"anyOf":[{"type":"object","properties":{"key":{"type":"string","description":"The key as asked for, trimmed."},"status":{"type":"string","const":"ok"},"entity":{"type":"object","properties":{"vhid":{"type":"string","pattern":"^\\d{11}$","description":"The entry’s VHID: 11 digits, permanent."},"short":{"description":"The entry’s short name (`/<short>`), if it has one.","type":["string","null"]},"title":{"type":"string"},"subtitle":{"type":["string","null"]},"entity_type":{"description":"What it is, from its Wikidata item: `person`, `organization` or `brand`; null when unknown. `entity_kind` says more.","type":["string","null"]},"entity_kind":{"anyOf":[{"type":"string","enum":["person","musical_group","sports_organization","broadcaster","publisher","educational_institution","research_organization","religious_organization","museum","financial_institution","chain","nonprofit","company","organization","show","website","brand"]},{"type":"null"}],"description":"The finer kind of thing it is, from its Wikidata item’s classes; null when unknown (an organisation or a brand not yet read since kinds were added reads null until the sync next reads its item). Each kind belongs to one `entity_type`, and `person`, `organization` and `brand` are also the kinds of an entry of that type with no finer one. The kinds, with their type: `person` (person: person), `musical_group` (organization: musical group), `sports_organization` (organization: sports organisation), `broadcaster` (organization: broadcaster), `publisher` (organization: publisher), `educational_institution` (organization: educational institution), `research_organization` (organization: research organisation), `religious_organization` (organization: religious organisation), `museum` (organization: museum), `financial_institution` (organization: financial institution), `chain` (organization: retail or hospitality chain), `nonprofit` (organization: charity or non-profit), `company` (organization: company), `organization` (organization: organisation), `show` (brand: show), `website` (brand: website or app), `brand` (brand: brand). New kinds may be added; treat an unknown value as its `entity_type`."},"verified":{"type":"boolean","description":"Verified Handles has verified the entry."},"description":{"description":"The description as sanitised HTML, links to other entries named as they are today.","type":["string","null"]},"description_source":{"anyOf":[{"type":"object","properties":{"kind":{"type":"string","description":"The source’s kind (`wikipedia`)."},"title":{"type":"string","description":"The page’s title, underscored (`Draft:` first for a draft)."},"url":{"type":"string","description":"The page."},"adapted":{"description":"Present and true when the text has been edited on the site since.","type":"boolean"},"revision":{"description":"The page’s revision the text was taken from: its permalink is `https://en.wikipedia.org/w/index.php?title=<title>&oldid=<revision>`. Absent on a credit from before revisions were kept.","type":"integer","exclusiveMinimum":0,"maximum":9007199254740991},"draft":{"description":"Present and true when the page is an English Wikipedia draft (the Draft namespace), not yet an article.","type":"boolean","const":true}},"required":["kind","title","url"],"additionalProperties":{},"description":"The English Wikipedia page an entry’s description was taken from: an article, or a draft (`draft: true`)."},{"type":"null"}]},"description_license":{"anyOf":[{"type":"string","const":"CC-BY-SA-4.0"},{"type":"null"}],"description":"The description’s licence, as an SPDX id: `CC-BY-SA-4.0` when it was taken from Wikipedia (`description_source` is set), which means crediting the article and sharing alike. Null otherwise: the description is CC0 like the rest of the text."},"url":{"type":"string","description":"The entry’s canonical page."},"image":{"description":"The lead image (the same as `images[0].url`), or null.","type":["string","null"]},"image_rights":{"anyOf":[{"type":"object","properties":{"source":{"type":"string","enum":["wikimedia_commons","upload"],"description":"Where the image came from."},"license":{"anyOf":[{"type":"string","enum":["cc0-1.0","public-domain","cc-by-4.0","cc-by-sa-4.0","supplied","permission","none"]},{"type":"null"}],"description":"An upload’s licence, by id. Null for a Commons image (see `license_name`) or when none was recorded."},"license_name":{"description":"The licence’s name, e.g. \"CC BY-SA 4.0\". Null until it is known.","type":["string","null"]},"license_url":{"description":"The licence’s text.","type":["string","null"]},"freely_licensed":{"description":"May be reused under a free licence. Null when no licence is recorded.","type":["boolean","null"]},"credit":{"description":"The credit line to show when reusing the image.","type":["string","null"]},"source_page":{"description":"The image’s Wikimedia Commons file page, which states its licence and author.","type":["string","null"]},"details_url":{"type":"string","description":"The entry’s \"About this image\" page."}},"required":["source","license","license_name","license_url","freely_licensed","credit","source_page","details_url"],"additionalProperties":{},"description":"Who owns an image and how it may be reused. An entry’s text is CC0 (bar a description taken from Wikipedia); its images are licensed separately, by their owners."},{"type":"null"}],"description":"The lead image’s rights, or null when there is no image."},"images":{"type":"array","items":{"type":"object","properties":{"url":{"type":"string","description":"The image, as a path on this site (`/img/w/480q75/<id>`)."},"main":{"type":"boolean","description":"True for the lead image, false for the gallery images after it."},"image_rights":{"type":"object","properties":{"source":{"type":"string","enum":["wikimedia_commons","upload"],"description":"Where the image came from."},"license":{"anyOf":[{"type":"string","enum":["cc0-1.0","public-domain","cc-by-4.0","cc-by-sa-4.0","supplied","permission","none"]},{"type":"null"}],"description":"An upload’s licence, by id. Null for a Commons image (see `license_name`) or when none was recorded."},"license_name":{"description":"The licence’s name, e.g. \"CC BY-SA 4.0\". Null until it is known.","type":["string","null"]},"license_url":{"description":"The licence’s text.","type":["string","null"]},"freely_licensed":{"description":"May be reused under a free licence. Null when no licence is recorded.","type":["boolean","null"]},"credit":{"description":"The credit line to show when reusing the image.","type":["string","null"]},"source_page":{"description":"The image’s Wikimedia Commons file page, which states its licence and author.","type":["string","null"]},"details_url":{"type":"string","description":"The entry’s \"About this image\" page."}},"required":["source","license","license_name","license_url","freely_licensed","credit","source_page","details_url"],"additionalProperties":{},"description":"Who owns an image and how it may be reused. An entry’s text is CC0 (bar a description taken from Wikipedia); its images are licensed separately, by their owners."},"link":{"description":"Where the image links on the entry page instead of opening the full-screen viewer, or null.","type":["string","null"]}},"required":["url","main","image_rights","link"],"additionalProperties":{},"description":"One image an entry shows."},"description":"Every image the entry shows, the lead first. Empty when it shows none."},"handles":{"type":"array","items":{"type":"object","properties":{"platform":{"type":"string","description":"The platform’s id (`twitter`, `instagram`, `wikidata`, …)."},"name":{"type":"string","description":"The platform’s display name."},"category":{"type":"string","enum":["social","messaging","website","identifier"],"description":"How the entry page groups it."},"value":{"description":"The handle as stored (a username, an id, a URL). Null for an email address, which is never published as data.","type":["string","null"]},"display":{"description":"The label the entry page shows instead of the value, if an editor set one. Null for email.","type":["string","null"]},"url":{"description":"The profile’s address, built from the platform’s URL pattern. Null for email.","type":["string","null"]},"verified":{"type":"boolean","description":"Verified Handles has checked that this account belongs to the entry."},"checked":{"description":"What Verified Handles’ own handle checker found when it last looked at this account, from the platform’s official API: only on YouTube (channel and handle), Deezer and GitHub, and only for a look at most 7 days old. Absent otherwise. The entry page shows it only for `dead` (“Not found when checked …”) and `renamed`.","type":"object","properties":{"verdict":{"type":"string","enum":["live","dead","renamed","unknown"],"description":"`live`: the profile was there. `dead`: the platform did not find it. `renamed`: it answers under another name. `unknown`: the platform gave no answer a rule could read."},"at":{"type":"string","description":"When it looked (ISO 8601, UTC)."},"now":{"description":"For `renamed`, the name it answers to now, when the platform gave one. A YouTube handle’s is lowercase.","type":"string"}},"required":["verdict","at"],"additionalProperties":{}}},"required":["platform","name","category","value","display","url","verified"],"additionalProperties":{},"description":"One account or identifier of an entry, in the order the entry page shows them. A Wikidata item linked to the entry comes last, as platform `wikidata`."}}},"required":["vhid","short","title","subtitle","entity_type","entity_kind","verified","description","description_source","description_license","url","image","image_rights","images","handles"],"additionalProperties":{},"description":"Exactly what `GET /api/v1/entities/{key}` answers for this key."}},"required":["key","status","entity"],"additionalProperties":{}},{"type":"object","properties":{"key":{"type":"string","description":"The key as asked for, trimmed."},"status":{"type":"string","const":"not_found","description":"No public entry answers to the key: where the single read answers 404."}},"required":["key","status"],"additionalProperties":{}}],"description":"What one requested key answers."},"description":"One element per key asked for, in the order asked, a repeated key once (where it first appears)."}},"required":["results"],"additionalProperties":{},"description":"Many entries at once: each key’s answer, in request order."}},{"name":"search_commons_images","title":"Search Wikimedia Commons","description":"Search Wikimedia Commons for an image to put on an entry, as the editor’s image picker does. An exact file name finds that file first, even one uploaded minutes ago. Each hit has a `token`: pass it to set_entry_image as `commons_token`.","write":false,"confirm":false,"capabilities":[],"role":null,"keyless":false,"liveEdit":false,"linkImages":false,"input":{"type":"object","properties":{"query":{"type":"string","minLength":2,"maxLength":200}},"required":["query"]},"output":{"type":"object","properties":{"results":{"type":"array","items":{"type":"object","properties":{"filename":{"type":"string"},"width":{"anyOf":[{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"null"}]},"height":{"anyOf":[{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"null"}]},"mime":{"type":["string","null"]},"token":{"type":"string","description":"The file, signed for 30 minutes: what `POST /api/media/commons` and the preview take."},"commonsPage":{"type":"string","description":"The file’s page on Commons, with its licence and author."}},"required":["filename","width","height","mime","token","commonsPage"],"additionalProperties":{},"description":"A Wikimedia Commons file a search found."}}},"required":["results"],"additionalProperties":{}}},{"name":"update_entry_fields","title":"Edit an entry’s text","description":"Change an entry’s title, subtitle, description or short name, or remove its “from Wikipedia” credit or name the Wikipedia page it came from — a live edit, as the editor saves one: a new revision, audited. Give only what changes; null clears a field. The description is HTML (sanitised on save). A field you change here is no longer managed by the Wikidata sync; to hand one back, so the next sync refreshes it from the item, use set_wikidata_ownership (relinquish_fields). Dry run by default. To ask a reviewer instead, use propose_entry_change.","write":true,"confirm":false,"capabilities":[],"role":null,"keyless":false,"liveEdit":true,"linkImages":false,"input":{"type":"object","properties":{"entry":{"type":"string","minLength":1,"maxLength":200,"pattern":"^(?!\\.{1,2}$)","description":"The entry: its VHID (11 digits), its short name (as in verifiedhandles.org/<short>), or its Wikidata QID (Q42)."},"title":{"type":"string","minLength":1,"maxLength":500},"subtitle":{"anyOf":[{"type":"string","maxLength":500},{"type":"null"}]},"description":{"anyOf":[{"type":"string","maxLength":65536},{"type":"null"}]},"short":{"description":"The short name in the entry’s URL; null removes it (the VHID URL stays).","anyOf":[{"type":"string","maxLength":100},{"type":"null"}]},"remove_wikipedia_credit":{"description":"true: remove the “from Wikipedia” credit from the description.","type":"boolean"},"credit_wikipedia_page":{"description":"Credit the description “from Wikipedia”: an English Wikipedia article or draft, by title (\"Draft:Dominic McLaughlin\") or address. The server reads the page (redirects followed) and refuses it unless at least half of the description’s three-word phrases are the page’s lead (credit_text_differs, with the share).","type":"string","minLength":1,"maxLength":2000},"credit_let_wikidata_manage":{"description":"With a draft named in credit_wikipedia_page: false keeps the description site-authored. By default a draft’s credit hands the description to the Wikidata sync, which leaves it alone until the draft is an article linked from the entry’s Wikidata item.","type":"boolean"},"summary":{"description":"Why you made this edit, in a few plain words; shown in the entry’s public history. At most 200 characters. Never an internal tracking ID (a backlog or ticket number); a VHID is fine.","type":"string","minLength":1,"maxLength":200},"base_revision_id":{"description":"The revision you read (get_entry → editing.baseRevisionId). If the entry has changed since, the edit is refused as a conflict. Left out, the current revision is used.","type":"string","pattern":"^[0-9]+$"},"idempotency_key":{"description":"Optional: a key you choose (1–255 printable ASCII, e.g. a UUID), sent as the write’s Idempotency-Key. Calling again with the same key and the same change within 24 hours answers the first call’s result (replayed: true) and writes nothing; the same key with another change is refused (422).","type":"string","pattern":"^[\\x20-\\x7E]{1,255}$"},"dry_run":{"default":true,"description":"true (the default): write nothing — show the change and the exact request it would send. false: make the change.","type":"boolean"}},"required":["entry"]},"output":{"type":"object","properties":{"dry_run":{"description":"true: a dry run, which wrote nothing. Absent from a real run.","type":"boolean"},"would_send":{"description":"A dry run: the exact request the real run would send (`method`, `path`, any `headers` such as an Idempotency-Key, and its `body`, `form` or `query`), or the requests, in order."},"note":{"description":"A dry run: what to do next to make the change, in words."},"confirm":{"description":"A dry run of a change that needs it: the exact target to send back as `confirm` with dry_run: false.","type":"string"},"replayed":{"description":"A real run with an idempotency_key already used for this change: the first call’s answer, given back; nothing was written now.","type":"boolean","const":true},"may_edit_live":{"description":"A dry run of a live edit: whether this key’s account may edit this entry live.","type":"boolean"},"refused_because":{"description":"A dry run the real run would be refused for: why, in words.","type":"string"},"result":{"description":"A real run: the route’s own answer, where the tool adds facts of its own beside it."}},"additionalProperties":{},"description":"A dry run (`dry_run: true`): what the change would be and the exact request it would send. A real run: what the route answered."}},{"name":"update_entry_handles","title":"Add or remove handles","description":"Add handles to an entry or remove them — a live edit. Only the handles named are sent (add_handles / remove_handles), and the server applies them to the entry’s list as it is when it saves: an added handle goes at the end, one the entry has already, or one to remove that it has not, changes nothing (the answer’s handle_ops says which), and nothing is read first, so a handle someone else saved meanwhile is never undone. A handle you remove that the Wikidata sync supplied is held back so the sync does not bring it back. Dry run by default. To ask a reviewer instead, use propose_entry_change.","write":true,"confirm":false,"capabilities":[],"role":null,"keyless":false,"liveEdit":true,"linkImages":false,"input":{"type":"object","properties":{"entry":{"type":"string","minLength":1,"maxLength":200,"pattern":"^(?!\\.{1,2}$)","description":"The entry: its VHID (11 digits), its short name (as in verifiedhandles.org/<short>), or its Wikidata QID (Q42)."},"add":{"maxItems":50,"type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","minLength":1,"description":"The platform id, e.g. \"twitter\": one the platform catalog has (get_entry with include_platforms lists the enabled ones; platform_catalog, every one). A new handle on an unknown or disabled platform is refused (400 invalid_platform)."},"value":{"type":"string","minLength":1,"description":"The handle as stored, e.g. \"nasa\"."},"display":{"description":"Text to show instead of the value.","type":"string","maxLength":200}},"required":["platform_id","value"]}},"remove":{"description":"Handles to take off, each by its value — or, for an email this key may not see, by {platform_id: \"email\", ref}.","maxItems":50,"type":"array","items":{"anyOf":[{"type":"object","properties":{"platform_id":{"type":"string","minLength":1,"description":"The platform id, e.g. \"twitter\": one the platform catalog has (get_entry with include_platforms lists the enabled ones; platform_catalog, every one). A new handle on an unknown or disabled platform is refused (400 invalid_platform)."},"value":{"type":"string","minLength":1,"description":"The handle as stored, e.g. \"nasa\"."}},"required":["platform_id","value"]},{"type":"object","properties":{"platform_id":{"type":"string","minLength":1,"description":"The masked handle’s platform: \"email\"."},"ref":{"type":"string","pattern":"^[0-9]{1,18}$","description":"A masked handle’s `ref` (get_entry → editing.handles, where its value is null): it names the stored handle without its address."}},"required":["platform_id","ref"]}]}},"summary":{"description":"Why you made this edit, in a few plain words; shown in the entry’s public history. At most 200 characters. Never an internal tracking ID (a backlog or ticket number); a VHID is fine.","type":"string","minLength":1,"maxLength":200},"base_revision_id":{"description":"Not needed, and not sent: handles are added and removed against the entry as it is when the edit is saved.","type":"string","pattern":"^[0-9]+$"},"idempotency_key":{"description":"Optional: a key you choose (1–255 printable ASCII, e.g. a UUID), sent as the write’s Idempotency-Key. Calling again with the same key and the same change within 24 hours answers the first call’s result (replayed: true) and writes nothing; the same key with another change is refused (422).","type":"string","pattern":"^[\\x20-\\x7E]{1,255}$"},"dry_run":{"default":true,"description":"true (the default): write nothing — show the change and the exact request it would send. false: make the change.","type":"boolean"}},"required":["entry"]},"output":{"type":"object","properties":{"dry_run":{"description":"true: a dry run, which wrote nothing. Absent from a real run.","type":"boolean"},"would_send":{"description":"A dry run: the exact request the real run would send (`method`, `path`, any `headers` such as an Idempotency-Key, and its `body`, `form` or `query`), or the requests, in order."},"note":{"description":"A dry run: what to do next to make the change, in words."},"confirm":{"description":"A dry run of a change that needs it: the exact target to send back as `confirm` with dry_run: false.","type":"string"},"replayed":{"description":"A real run with an idempotency_key already used for this change: the first call’s answer, given back; nothing was written now.","type":"boolean","const":true},"may_edit_live":{"description":"A dry run of a live edit: whether this key’s account may edit this entry live.","type":"boolean"},"refused_because":{"description":"A dry run the real run would be refused for: why, in words.","type":"string"},"result":{"description":"A real run: the route’s own answer, where the tool adds facts of its own beside it."}},"additionalProperties":{},"description":"A dry run (`dry_run: true`): what the change would be and the exact request it would send. A real run: what the route answered."}},{"name":"update_entries","title":"Edit many entries live","description":"Live edits to up to 25 entries in one request, each as update_entry_fields and update_entry_handles make one (the text fields, handles added and removed): a new revision each, audited with one batch id. Whether this key may edit each entry live is decided entry by entry, as for one edit (the dry run’s may_edit_live). By default each edit stands alone and the answer gives each one’s outcome; with atomic: true, any refused edit means none is made. Dry run by default: it reads each entry and lists what would change. The real run needs confirm set to the batch digest the dry run names. To ask a reviewer instead, use propose_entry_changes.","write":true,"confirm":true,"capabilities":[],"role":null,"keyless":false,"liveEdit":true,"linkImages":false,"input":{"type":"object","properties":{"edits":{"minItems":1,"maxItems":25,"type":"array","items":{"type":"object","properties":{"entry":{"type":"string","minLength":1,"maxLength":200,"pattern":"^(?!\\.{1,2}$)","description":"The entry: its VHID (11 digits), its short name (as in verifiedhandles.org/<short>), or its Wikidata QID (Q42)."},"title":{"type":"string","minLength":1,"maxLength":500},"subtitle":{"anyOf":[{"type":"string","maxLength":500},{"type":"null"}]},"description":{"anyOf":[{"type":"string","maxLength":65536},{"type":"null"}]},"short":{"description":"The short name in the entry’s URL; null removes it (the VHID URL stays).","anyOf":[{"type":"string","maxLength":100},{"type":"null"}]},"remove_wikipedia_credit":{"description":"true: remove the “from Wikipedia” credit from the description.","type":"boolean"},"add_handles":{"maxItems":50,"type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","minLength":1,"description":"The platform id, e.g. \"twitter\": one the platform catalog has (get_entry with include_platforms lists the enabled ones; platform_catalog, every one). A new handle on an unknown or disabled platform is refused (400 invalid_platform)."},"value":{"type":"string","minLength":1,"description":"The handle as stored, e.g. \"nasa\"."},"display":{"description":"Text to show instead of the value.","type":"string","maxLength":200}},"required":["platform_id","value"]}},"remove_handles":{"description":"Handles to take off, each by its value — or, for an email this key may not see, by {platform_id: \"email\", ref}.","maxItems":50,"type":"array","items":{"anyOf":[{"type":"object","properties":{"platform_id":{"type":"string","minLength":1,"description":"The platfo