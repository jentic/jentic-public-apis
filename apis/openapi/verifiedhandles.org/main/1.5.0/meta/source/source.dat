m."}},"required":["id","submission_id","on_your_submission","body","created_at","author"],"additionalProperties":false},"description":"Every comment on your submissions, and those you wrote on anyone else’s."},"notes":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^\\d+$"},"entry_vhid":{"type":"string"},"body":{"type":"string"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},"required":["id","entry_vhid","body","created_at","updated_at"],"additionalProperties":false},"description":"The internal notes you wrote."},"api_keys":{"type":"array","items":{"type":"object","properties":{"name":{"type":"string"},"prefix":{"type":"string"},"role_ceiling":{"type":"string","enum":["registered","trusted_editor","admin"]},"read_only":{"type":"boolean"},"created_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"last_used_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"revoked_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]}},"required":["name","prefix","role_ceiling","read_only","created_at","expires_at","last_used_at","revoked_at"],"additionalProperties":false},"description":"Your keys, never a secret. Not your connected apps’ keys: they are under `connected_apps`."},"connected_apps":{"type":"array","items":{"type":"object","properties":{"client_id":{"type":"string"},"client_name":{"type":"string"},"redirect_uri":{"type":"string"},"resource":{"type":"string"},"role_ceiling":{"type":"string","enum":["registered","trusted_editor","admin"]},"read_only":{"type":"boolean"},"days":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"created_at":{"type":"string","format":"date-time"},"connected_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"last_refreshed_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"key_prefix":{"type":["string","null"]},"expires_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"revoked_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]}},"required":["client_id","client_name","redirect_uri","resource","role_ceiling","read_only","days","created_at","connected_at","last_refreshed_at","key_prefix","expires_at","revoked_at"],"additionalProperties":false},"description":"The apps you connected with OAuth (and consents not yet completed), never a token."},"wikimedia_account":{"anyOf":[{"type":"object","properties":{"wiki":{"type":"string","enum":["wikidata","testwikidata"]},"username":{"type":"string"},"grants":{"type":"array","items":{"type":"string"}},"linked_at":{"type":"string","format":"date-time"},"checked_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]}},"required":["wiki","username","grants","linked_at","checked_at"],"additionalProperties":false},{"type":"null"}],"description":"The Wikimedia account linked to yours (never its token), or null."},"drafts":{"type":"array","items":{"type":"object","properties":{"entry_vhid":{"type":"string"},"entry_title":{"type":"string"},"base_revision_id":{"anyOf":[{"type":"string","pattern":"^\\d+$"},{"type":"null"}]},"draft":{"$ref":"#/components/schemas/EntryDraft"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"}},"required":["entry_vhid","entry_title","base_revision_id","draft","created_at","updated_at","expires_at"],"additionalProperties":false},"description":"Your unsaved entry drafts, each whole, as kept."},"audit":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^\\d+$"},"ts":{"type":"string","format":"date-time"},"action":{"type":"string"},"target_type":{"type":"string"},"target_id":{"type":"string"},"detail":{"anyOf":[{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},{"type":"null"}],"description":"What changed, in the action’s own shape (lib/audit.ts names each action’s): it varies by action, and a row keeps the shape it was written with. A row written with an API key also carries `key` (its id), `via: \"api_key\"` where the writer named no surface, and `mcp_tool` when an MCP tool made the request."},"by":{"type":"string","description":"`you`, `Verified Handles (automatic)`, or the actor as a signed-out visitor would see them."},"ip":{"description":"On your own rows only: the address it came from, until it is erased after a year.","type":["string","null"]},"surface":{"description":"On your own rows only: what it came through (see the audit log).","anyOf":[{"type":"string","enum":["editor","console","api","mcp","site","worker","migration"]},{"type":"null"}]},"api_key_id":{"description":"On your own rows only: your API key it was made with, if any.","anyOf":[{"type":"string","pattern":"^\\d+$"},{"type":"null"}]},"mcp_tool":{"description":"On your own rows only: the MCP tool that made it, if one did.","type":["string","null"]},"user_agent":{"description":"On your own rows only: your browser or client, cut to 200 characters.","type":["string","null"]},"request_id":{"description":"On your own rows only: the request’s id.","type":["string","null"]}},"required":["id","ts","action","target_type","target_id","detail","by"],"additionalProperties":false},"description":"The audit rows by you or about you."},"edits":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^\\d+$"},"entry_vhid":{"type":"string"},"entry_title":{"type":"string"},"ts":{"type":"string","format":"date-time"},"source":{"type":"string"},"summary":{"type":["string","null"]},"made_by_you":{"type":"boolean"},"proposed_by_you":{"type":"boolean"},"hidden":{"type":"boolean"}},"required":["id","entry_vhid","entry_title","ts","source","summary","made_by_you","proposed_by_you","hidden"],"additionalProperties":false},"description":"Every revision you made or proposed: its 