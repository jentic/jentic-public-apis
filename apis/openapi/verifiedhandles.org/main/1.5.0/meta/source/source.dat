l"}]},"gallery":{"description":"The images after the lead, when changed.","maxItems":5,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^\\d{1,19}$","description":"The image’s id."},"kind":{"type":"string","enum":["commons","local"]},"commons_filename":{"type":["string","null"]}},"required":["id","kind","commons_filename"],"additionalProperties":false}},"imageLinks":{"description":"Image id → link as typed, when changed.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"relinquish":{"description":"Fields to hand to Wikidata on save.","type":"array","items":{"type":"string","enum":["title","subtitle","description","image"]}},"takeover":{"description":"Fields to take back from Wikidata on save.","type":"array","items":{"type":"string","enum":["title","subtitle","description","image"]}},"dropCredit":{"description":"Remove the Wikipedia credit on save.","type":"boolean","const":true},"creditPage":{"description":"A Wikipedia page named for the credit, as typed.","type":"string"},"creditManage":{"description":"With `creditPage`: the description is not to go to the sync.","type":"boolean","const":false},"handleTakeover":{"type":"array","items":{"type":"string"}},"handleRelinquish":{"type":"array","items":{"type":"string"}},"handleRelease":{"type":"array","items":{"type":"string"}}},"required":["fields"],"additionalProperties":false,"description":"An unsaved edit to an entry, in the editor’s own shape."},"Forbidden":{"type":"object","properties":{"error":{"type":"string","const":"forbidden"}},"required":["error"],"additionalProperties":false,"description":"The key’s account may not do this: it lacks the capability, or the account is blocked."},"Freshness":{"type":"object","properties":{"updated_at":{"type":"string","format":"date-time","description":"The entry’s last change."}},"required":["updated_at"],"additionalProperties":false,"description":"When an entry last changed."},"Handle":{"type":"object","properties":{"platform":{"type":"string","description":"The platform’s id (`twitter`, `instagram`, `wikidata`, …)."},"name":{"type":"string","description":"The platform’s display name."},"category":{"type":"string","enum":["social","messaging","website","identifier"],"description":"How the entry page groups it."},"value":{"description":"The handle as stored (a username, an id, a URL). Null for an email address, which is never published as data.","type":["string","null"]},"display":{"description":"The label the entry page shows instead of the value, if an editor set one. Null for email.","type":["string","null"]},"url":{"description":"The profile’s address, built from the platform’s URL pattern. Null for email.","type":["string","null"]},"verified":{"type":"boolean","description":"Verified Handles has checked that this account belongs to the entry."},"checked":{"description":"What Verified Handles’ own handle checker found when it last looked at this account, from the platform’s official API: only on YouTube (channel and handle), Deezer and GitHub, and only for a look at most 7 days old. Absent otherwise. The entry page shows it only for `dead` (“Not found when checked …”) and `renamed`.","type":"object","properties":{"verdict":{"type":"string","enum":["live","dead","renamed","unknown"],"description":"`live`: the profile was there. `dead`: the platform did not find it. `renamed`: it answers under another name. `unknown`: the platform gave no answer a rule could read."},"at":{"type":"string","description":"When it looked (ISO 8601, UTC)."},"now":{"description":"For `renamed`, the name it answers to now, when the platform gave one. A YouTube handle’s is lowercase.","type":"string"}},"required":["verdict","at"],"additionalProperties":false}},"required":["platform","name","category","value","display","url","verified"],"additionalProperties":false,"description":"One account or identifier of an entry, in the order the entry page shows them. A Wikidata item linked to the entry comes last, as platform `wikidata`."},"HandleHolder":{"type":"object","properties":{"vhid":{"type":"string","description":"The entry’s VHID."},"title":{"type":"string","description":"The entry’s title."},"url":{"type":"string","description":"The entry’s page."},"value":{"type":"string","description":"The handle as the entry lists it: on a platform that ignores case, its case may differ from the value asked."},"verified":{"type":"boolean","description":"Whether the handle itself is verified on this entry (not the entry’s own badge)."}},"required":["vhid","title","url","value","verified"],"additionalProperties":false,"description":"An entry that lists the handle."},"HandleLookupResponse":{"type":"object","properties":{"platform":{"type":"string","description":"The platform looked on: the one asked, or the one whose address `url` is."},"value":{"type":"string","description":"The handle looked up, as the site stores one: from `url`, what follows the platform’s address."},"results":{"type":"array","items":{"$ref":"#/components/schemas/HandleHolder"},"description":"Verified handles first, then by VHID; at most 50. Empty when no public entry lists it."}},"required":["platform","value","results"],"additionalProperties":false,"description":"The public entries that list a handle."},"HandleOpsReport":{"type":"object","properties":{"added":{"type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","description":"The platform’s id."},"value":{"type":"string","description":"The handle as stored."}},"required":["platform_id","value"],"additionalProperties":false},"description":"Put on the entry, at the end of its list."},"removed":{"type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","description":"The platform’s id."},"value":{"description":"The handle, as stored or in any case the platform folds.","type":"string"},"ref":{"description":"Instead of `value`, for an email the caller may not see: the `ref` `GET /api/editor/{vhid}` gives it.","type":"string"}},"required":["platform_id"],"additionalProperties":false},"description":"Taken off, as the op named them."},"already_present":{"type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","description":"The platform’s id."},"value":{"type":"string","description":"The handle as stored."}},"required":["platform_id","value"],"additionalProperties":false},"description":"Adds of a handle the entry has already: nothing changed."},"not_present":{"type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","description":"The platform’s id."},"value":{"description":"The handle, as stored or in any case the platform folds.","type":"string"},"ref":{"description":"Instead of `value`, for an email the caller may not see: the `ref` `GET /api/editor/{vhid}` gives it.","type":"string"}},"required":["platform_id"],"additionalProperties":false},"description":"Removes of a handle the entry does not have: nothing changed."}},"required":["added","removed","already_present","not_present"],"additionalProperties":false,"description":"What each of a change’s `add_handles` / `remove_handles` came to."},"HistoryHidden":{"type":"object","properties":{"error":{"type":"string","const":"history_hidden"},"message":{"type":"string","description":"What the history page says: the history isn’t public, and how to ask for it."},"contact":{"type":"string","description":"The contact page, where a request for the history goes."},"subject":{"type":"string","description":"The subject to give the request, naming the entry: `History request: <title> (<vhid>)`."}},"required":["error","message","contact","subject"],"additionalProperties":false,"description":"The entry is public but its history has been hidden."},"ImageRights":{"type":"object","properties":{"source":{"type":"string","enum":["wikimedia_commons","upload"],"description":"Where the image came from."},"license":{"anyOf":[{"type":"string","enum":["cc0-1.0",