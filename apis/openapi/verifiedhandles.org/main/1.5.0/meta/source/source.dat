:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"},{"type":"null"}]},"review_notes":{"description":"What the reviewer wrote when deciding it.","type":["string","null"]},"mine":{"type":"boolean","description":"You sent it."},"payload":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"What it asks for, in its kind’s shape: for `correction`, `new_entity` and `application`, an `EditPayload` (the fields to set, and for a revert or an approval the server’s own); for `report`, `{reason, note?, media_id?, link?}`; for `claim`, `{method}`."},"comments":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","pattern":"^\\d+$"},"author_name":{"description":"The writer’s name, where you may see it.","type":["string","null"]},"author_role":{"description":"`reviewer` for a reviewer’s comment; null for the submitter’s own.","type":["string","null"]},"body":{"type":"string"},"created_at":{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"}},"required":["id","author_name","author_role","body","created_at"],"additionalProperties":{}}}},"required":["status"],"additionalProperties":{}}},{"name":"retract_my_submission","title":"Retract my own submission","description":"Withdraw one of this key’s own account’s submissions while it is still open (waiting for a reviewer, or for your answer): no reviewer acts on it after, and it cannot be reopened. Only your own, whatever the key’s role. Audited. Dry run by default: it says whether the submission is yours and still open.","write":true,"confirm":false,"capabilities":[],"role":null,"keyless":false,"liveEdit":false,"linkImages":false,"input":{"type":"object","properties":{"id":{"type":"string","pattern":"^[0-9]{1,18}$","description":"The submission’s id (list_my_submissions, or the tool that sent it)."},"dry_run":{"default":true,"description":"true (the default): write nothing — show the change and the exact request it would send. false: make the change.","type":"boolean"}},"required":["id"]},"output":{"type":"object","properties":{"dry_run":{"description":"true: a dry run, which wrote nothing. Absent from a real run.","type":"boolean"},"would_send":{"description":"A dry run: the exact request the real run would send (`method`, `path`, any `headers` such as an Idempotency-Key, and its `body`, `form` or `query`), or the requests, in order."},"note":{"description":"A dry run: what to do next to make the change, in words."},"confirm":{"description":"A dry run of a change that needs it: the exact target to send back as `confirm` with dry_run: false.","type":"string"},"replayed":{"description":"A real run with an idempotency_key already used for this change: the first call’s answer, given back; nothing was written now.","type":"boolean","const":true},"may_edit_live":{"description":"A dry run of a live edit: whether this key’s account may edit this entry live.","type":"boolean"},"refused_because":{"description":"A dry run the real run would be refused for: why, in words.","type":"string"},"result":{"description":"A real run: the route’s own answer, where the tool adds facts of its own beside it."}},"additionalProperties":{},"description":"A dry run (`dry_run: true`): what the change would be and the exact request it would send. A real run: what the route answered."}},{"name":"comment_on_my_submission","title":"Comment on my own submission","description":"Add a message to one of this key’s own account’s submissions (or, for a reviewer, any they may see): the reviewer reads it with the submission, and the submitter sees it on theirs. Answering a question a reviewer asked on your application sends it back to them. Audited. Dry run by default.","write":true,"confirm":false,"capabilities":[],"role":null,"keyless":false,"liveEdit":false,"linkImages":false,"input":{"type":"object","properties":{"id":{"type":"string","pattern":"^[0-9]{1,18}$","description":"The submission’s id (list_my_submissions, or the tool that sent it)."},"text":{"type":"string","minLength":1,"maxLength":2000,"description":"The message, in plain words; at most 2,000 characters."},"dry_run":{"default":true,"description":"true (the default): write nothing — show the change and the exact request it would send. false: make the change.","type":"boolean"}},"required":["id","text"]},"output":{"type":"object","properties":{"dry_run":{"description":"true: a dry run, which wrote nothing. Absent from a real run.","type":"boolean"},"would_send":{"description":"A dry run: the exact request the real run would send (`method`, `path`, any `headers` such as an Idempotency-Key, and its `body`, `form` or `query`), or the requests, in order."},"note":{"description":"A dry run: what to do next to make the change, in words."},"confirm":{"description":"A dry run of a change that needs it: the exact target to send back as `confirm` with dry_run: false.","type":"string"},"replayed":{"description":"A real run with an idempotency_key already used for this change: the first call’s answer, given back; nothing was written now.","type":"boolean","const":true},"may_edit_live":{"description":"A dry run of a live edit: whether this key’s account may edit this entry live.","type":"boolean"},"refused_because":{"description":"A dry run the real run would be refused for: why, in words.","type":"string"},"result":{"description":"A real run: the route’s own answer, where the tool adds facts of its own beside it."}},"additionalProperties":{},"description":"A dry run (`dry_run: true`): what the change would be and the exact request it would send. A real run: what the route answered."}},{"name":"revoke_api_key","title":"Revoke an API key","description":"Revoke an API key: anything using it stops working at once, and it cannot be brought back (its owner makes a new one). One of your own account’s keys, or — with `sub`, and the permission to manage users — one of another account’s. The dry run lists the account’s keys (never more than a key’s public prefix) and says if it is the key this call is made with. Audited. Dry run by default; the real run needs confirm set to the key’s id.","write":true,"confirm":true,"capabilities":[],"role":null,"keyless":false,"liveEdit":false,"linkImages":false,"input":{"type":"object","properties":{"key_id":{"type":"string","pattern":"^[0-9]{1,18}$","description":"The key’s id, as the dry run lists it."},"sub":{"description":"Another account’s id (`sub`), to revoke one of its keys. Left out: one of your own.","type":"string","minLength":1,"maxLength":200,"pattern":"^(?!\\.{1,2}$)"},"confirm":{"description":"Needed with dry_run: false: this change’s exact target, as the dry run gives it in `confirm`.","type":"string","maxLength":300},"dry_run":{"default":true,"description":"true (the default): write nothing — show the change and the exact request it would send. false: make the change.","type":"boolean"}},"required":["key_id"]},"output":{"type":"object","properties":{"dry_run":{"description":"true: a dry run, which wrote nothing. Absent from a real run.","type":"boolean"},"would_send":{"description":"A dry run: the exact request the real run would send (`method`, `path`, any `headers` such as an Idempotency-Key, and its `body`, `form` or `query`), or the requests, in order."},"note":{"description":"A dry run: what to do next to make the change, in words."},"confirm":{"description":"A dry run of a change that needs it: the exact target to send back as `confirm` with dry_run: false.","type":"string"},"replayed":{"description":"A real run with an idempotency_key already used for this change: the first call’s answer, given back; nothing was written now.","type":"boolean","const":true},"may_edit_live":{"description":"A dry run of a live edit: whether this key’s account may edit this entry live.","type":"boolean"},"refused_because":{"description":"A dry run the real run would be refused for: why, in words.","type":"string"},"result":{"description":"A real run: the route’s own answer, where the tool adds facts of its own beside it."}},"additionalProperties":{},"description":"A dry run (`dry_run: true`): what the change would be and the exact request it would send. A real run: what the route answered."}},{"name":"propose_from_wikidata","title":"Propose what a Wikidata item says","description":"Propose, for a reviewer to decide, what a Wikidata item says for an entry: its identifier handles, and when asked its label (as the title), its description (as the subtitle) and its image. `qid` defaults to the item the entry is linked to. For that item, unless the entry is protected or claimed, it proposes handing the values to the Wikidata sync instead of copying them (the sync then writes and keeps them up to date), and says so. For another item it copies the values, which become the site’s own: the sync will not keep them up to date. Handles the entry already has (by each platform’s own rule for letter case) are left out. The entry’s description comes from Wikipedia, not from the item, so it is only ever handed to the sync. Warns when the item is another entry’s. `note` tells the reviewer why. Audited. Dry run by default: it shows what the item has, what the entry has, and the proposal.","write":true,"confirm":false,"capabilities":["propose"],"role":null,"keyless":false,"liveEdit":false,"linkImages":false,"input":{"type":"object","properties":{"entry":{"type":"string","minLength":1,"maxLength":200,"pattern":"^(?!\\.{1,2}$)","description":"The entry: its VHID (11 digits), its short name (as in verifiedhandles.org/<short>), or its Wikidata QID (Q42)."},"qid":{"description":"The Wikidata item, e.g. \"Q42\". Default: the item the entry is linked to.","type":"string","pattern":"^[Qq][1-9][0-9]*$"},"take":{"description":"What to take from the item: \"handles\" (the default), \"title\" (its label), \"subtitle\" (its description), \"description\" (only by handing it to the sync), \"image\".","minItems":1,"maxItems":5,"type":"array","items":{"type":"string","enum":["handles","title","subtitle","description","image"]}},"note":{"description":"Why you propose this, in plain words: posted as the proposal’s first comment, which the reviewer reads with it. At most 2,000 characters. Never an internal tracking ID (a backlog or ticket number); a VHID is fine.","type":"string","minLength":1,"maxLength":2000},"idempotency_key":{"description":"Optional: a key you choose (1–255 printable ASCII, e.g. a UUID), sent as the write’s Idempotency-Key. Calling again with the same key and the same change within 24 hours answers the first call’s result (replayed: true) and writes nothing; the same key with another change is refused (422).","type":"string","pattern":"^[\\x20-\\x7E]{1,255}$"},"dry_run":{"default":true,"description":"true (the default): write nothing — show the change and the exact request it would send. false: make the change.","type":"boolean"}},"required":["entry"]},"output":{"type":"object","properties":{"dry_run":{"description":"true: a dry run, which wrote nothing. Absent from a real run.","type":"boolean"},"would_send":{"description":"A dry run: the exact request the real run would send (`method`, `path`, any `headers` such as an Idempotency-Key, and its `body`, `form` or `query`), or the requests, in order."},"note":{"description":"A dry run: what to do next to make the change, in words."},"confirm":{"description":"A dry run of a change that needs it: the exact target to send back as `confirm` with dry_run: false.","type":"string"},"replayed":{"description":"A real run with an idempotency_key already used for this change: the first call’s answer, given back; nothing was written now.","type":"boolean","const":true},"may_edit_live":{"description":"A dry run of a live edit: whether this key’s account may edit this entry live.","type":"boolean"},"refused_because":{"description":"A dry run the real run would be refused for: why, in words.","type":"string"},"result":{"description":"A real run: the route’s own answer, where the tool adds facts of its own beside it."}},"additionalProperties":{},"description":"A dry run (`dry_run: true`): what the change would be and the exact request it would send. A real run: what the route answered."}}]},"components":{"schemas":{"AccountData":{"type":"object","properties":{"format":{"type":"string","const":"verifiedhandles-account-data"},"version":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"Bumped when a field changes meaning or goes; a new field does not bump it."},"exported_at":{"type":"string","format":"date-time"},"account":{"type":"object","properties":{"id":{"type":"string","description":"Your account’s id (its OIDC `sub`)."},"email":{"type":["string","null"]},"display_name":{"type":["string","null"]},"role":{"type":"string","enum":["registered","trusted_editor","admin"]},"blocked":{"type":"boolean"},"created_at":{"type":"string","format":"date-time"},"last_sign_in":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"role_granted_at":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"capability_overrides":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"boolean"},"description":"Capabilities granted (true) or taken away (false) beyond your role’s."},"preferences":{"type":"object","properties":{"copy_handle_only":{"type":"boolean"},"email_notifications":{"type":"boolean"},"save_recent_searches":{"type":"boolean"},"name_visibility":{"type":"string","enum":["public","trusted","admins"]}},"required":["copy_handle_only","email_notifications","save_recent_searches","name_visibility"],"additionalProperties":false}},"required":["id","email","display_name"