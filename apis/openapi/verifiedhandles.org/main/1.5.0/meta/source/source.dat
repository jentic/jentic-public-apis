ude Code”), from its user agent.","type":["string","null"]}},"required":["id","ts","label","sentence","surface","mcp_tool","ip","client"],"additionalProperties":false,"description":"One change made with one of your API keys, as its activity page shows it."},"LibraryImage":{"type":"object","properties":{"id":{"type":"string","pattern":"^\\d+$","description":"The image’s id: what a proposal names as `image_id`."},"kind":{"type":"string","enum":["commons","local"],"description":"`commons`: a Wikimedia Commons file; `local`: an upload."},"filename":{"description":"A Commons file’s name; null for an upload.","type":["string","null"]},"width":{"anyOf":[{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"null"}]},"height":{"anyOf":[{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"null"}]},"license":{"description":"An upload’s licence id; null for a Commons file.","type":["string","null"]},"license_name":{"type":["string","null"]},"license_url":{"type":["string","null"]},"credit":{"type":["string","null"]},"commons_page":{"type":["string","null"]},"used_by":{"type":"array","items":{"type":"object","properties":{"vhid":{"type":"string"},"short":{"type":["string","null"]},"title":{"type":"string"}},"required":["vhid","short","title"],"additionalProperties":false},"description":"Entries showing it now."},"used_before":{"type":"array","items":{"type":"object","properties":{"vhid":{"type":"string"},"short":{"type":["string","null"]},"title":{"type":"string"}},"required":["vhid","short","title"],"additionalProperties":false},"description":"Entries that showed it before."},"restricted":{"description":"Present only to an account that may use restricted images.","type":"boolean","const":true}},"required":["id","kind","filename","width","height","license","license_name","license_url","credit","commons_page","used_by","used_before"],"additionalProperties":false,"description":"An image the site holds, as the picker lists 