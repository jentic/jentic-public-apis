icy","editPolicy","accountBlocked","signInHost","draft","baseRevisionId","editable","handles","heldBack","heldBackNotListed","linkNames","provenance","qid","syncLocked","descriptionSource","image","gallery","galleryLogo","platforms"],"additionalProperties":false,"description":"An entry as the editor opens it, and what the caller may do to it."},"EditPayload":{"type":"object","properties":{"title":{"type":"string"},"subtitle":{"type":["string","null"]},"description":{"description":"HTML, sanitised on the way in by the same allowlist as every description. At most 64 KiB.","type":["string","null"]},"description_source":{"description":"Only `null`, which takes the \"from Wikipedia\" credit off. A credit is never sent: name its page with `wikipedia_credit`.","type":"null"},"wikipedia_credit":{"description":"Credit the description “from Wikipedia”. The server reads the page itself (redirects followed, so a draft since moved is its article), and refuses it unless at least half of the description’s three-word phrases are the page’s lead (`409 credit_text_differs`, with `page` and `share`). Not with `description_source: null`. Errors: `400 bad_wikipedia_title` / `not_english_wikipedia`; `409 wikipedia_page_missing`, `wikipedia_namespace` (not an article or a draft), `wikipedia_section`, `wikipedia_no_lead`, `no_description`, `draft_has_article` (the entry’s item already has an English article, named in `article`: credit that); `502 wikipedia_unreachable`.","type":"object","properties":{"page":{"type":"string","description":"An English Wikipedia article or draft, by title (`Draft:Dominic McLaughlin`) or address (`https://en.wikipedia.org/wiki/…`)."},"let_wikidata_manage":{"description":"For a draft only: `false` keeps the description site-authored. By default a draft’s credit hands the description to the Wikidata sync, which leaves it alone until the draft is an article linked from the entry’s Wikidata item.","type":"boolean"}},"required":["page"],"additionalProperties":false},"short":{"description":"The short name (`/<short>`); `null` removes it.","type":["string","null"]},"image_id":{"description":"The lead image, by media id; `null` removes it.","type":["string","null"]},"gallery":{"description":"The whole gallery after the lead, in order, by media id: it replaces the one there.","type":"array","items":{"type":"string"}},"image_links":{"description":"The whole map of links on the entry’s images, media id → absolute http(s) address. Needs the `link_images` capability.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"custom_handle_order":{"description":"Keep `handles` in the order given, rather than the site’s order.","type":"boolean"},"handles":{"description":"The whole list of handles, in order: it replaces the one there. Not with `add_handles` / `remove_handles`.","type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string"},"value":{"type":"string"},"display":{"description":"A label to show instead of the value.","type":["string","null"]}},"required":["platform_id","value"],"additionalProperties":false}},"add_handles":{"description":"Handles to put on the entry, at the end of its list as it is when the change is applied (a proposal: when it is approved). One the entry has already (the same value, in any case the platform folds) changes nothing. No base revision is needed for it. Not with `handles` (400 `handles_with_ops`).","type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string"},"value":{"type":"string","description":"Not blank. A website is completed to an address, as in `handles`."},"display":{"description":"A label to show instead of the value.","type":["string","null"]}},"required":["platform_id","value"],"additionalProperties":false}},"remove_handles":{"description":"Handles to take off, by value — or, for an email the caller may not see, by `ref` (an address is refused: `masked_handle_needs_ref`). One the entry does not have changes nothing. A value the Wikidata sync supplied is held back from it, as when a list leaves it out. Not with `handles`.","type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","description":"The platform’s id."},"value":{"description":"The handle, as stored or in any case the platform folds.","type":"string"},"ref":{"description":"Instead of `value`, for an email the caller may not see: the `ref` `GET /api/editor/{vhid}` gives it.","type":"string"}},"required":["platform_id"],"additionalProperties":false}},"relinquish":{"description":"Fields to hand back to the Wikidata sync.","type":"array","items":{"type":"string"}},"takeover":{"description":"Fields to take from the Wikidata sync, keeping their value.","type":"array","items":{"type":"string"}},"handle_takeover":{"description":"Handles to take from the Wikidata sync.","type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","description":"The platform’s id."},"value":{"type":"string","description":"The handle as stored."}},"required":["platform_id","value"],"additionalProperties":false}},"handle_relinquish":{"description":"Handles to hand to the Wikidata sync, while Wikidata lists them.","type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","description":"The platform’s id."},"value":{"type":"string","description":"The handle as stored."}},"required":["platform_id","value"],"additionalProperties":false}},"handle_release":{"description":"Values held back from the sync that it may add again.","type":"array","items":{"type":"object","properties":{"platform_id":{"type":"string","description":"The platform’s id."},"value":{"type":"string","description":"The handle as stored."}},"required":["platform_id","value"],"additionalProperties":false}}},"additionalProperties":false,"description":"A change to an entry, as the editor sends it. Every field is optional: send only what changes. `handles` and `gallery` are whole lists, which replace the entry’s; `add_handles` / `remove_handles` name single handles instead, applied to the list as it is then, so a change of nothing else needs no base revision and never undoes a handle saved meanwhile. A field the server does not know is ignored."},"EmptySearch":{"type":"object","properties":{"query":{"type":"string","const":""},"total":{"type":"number","const":0},"results":{"type":"array","prefixItems":[],"items":false,"maxItems":0}},"required":["query","total","results"],"additionalProperties":false,"description":"An empty `q`: nothing is searched."},"Entity":{"type":"object","properties":{"vhid":{"type":"string","pattern":"^\\d{11}$","description":"The entry’s VHID: 11 digits, permanent."},"short":{"description":"The entry’s short name (`/<short>`), if it has one.","type":["string","null"]},"title":{"type":"string"},"subtitle":{"type":["string","null"]},"entity_type":{"description":"What it is, from its Wikidata item: `person`, `organization` or `brand`; null when unknown. `entity_kind` says more.","type":["string","null"]},"entity_kind":{"anyOf":[{"type":"string","enum":["person","musical_group","sports_organization","broadcaster","publisher","educational_institution","research_organization","religious_organization","museum","financial_institution","chain","nonprofit","company","organization","show","website","brand"]},{"type":"null"}],"description":"The finer kind of thing it is, from its Wikidata item’s classes; null when unknown (an organisation or a brand not yet read since kinds were added reads null until the sync next reads its item). Each kind belongs to one `entity_type`, and `person`, `organization` and `brand` are also the kinds of an entry of that type with no finer one. The kinds, with their type: `person` (person: person), `musical_group` (organization: musical group), `sports_organization` (organization: sports organisation), `broadcaster` (organization: broadcaster), `publisher` (organization: publisher), `educational_institution` (organization: educational institution), `research_organization` (organization: research organisation), `religious_organization` (organization: religious organisation), `museum` (organization: museum), `financial_institution` (organization: financial institution), `chain` (organization: retail or hospitality chain), `nonprofit` (organization: charity or non-profit), `company` (organization: company), `organization` (organization: organisation), `show` (brand: show), `website` (brand: website or app), `brand` (brand: brand). New kinds may be added; treat an unknown value as its `entity_type`."},"verified":{"type":"boolean","description":"Verified Handles has verified the entry."},"description":{"description":"The description as sanitised HTML, links to other entries named as they are today.","type":["string","null"]},"description_source":{"anyOf":[{"$ref":"#/components/schemas/DescriptionSource"},{"type":"null"}]},"description_license":{"anyOf":[{"type":"string","const":"CC-BY-SA-4.0"},{"type":"null"}],"description":"The description’s licence, as an SPDX id: `CC-BY-SA-4.0` when it was taken from Wikipedia (`description_source` is set), which means crediting the article and sharing alike. Null otherwise: the description is CC0 like the rest of the text."},"url":{"type":"string","description":"The entry’s canonical page."},"image":{"description":"The lead image (the same as `images[0].url`), or null.","type":["string","null"]},"image_rights":{"anyOf":[{"$ref":"#/components/schemas/ImageRights"},{"type":"null"}],"description":"The lead image’s rights, or null when there is no image."},"images":{"type":"array","items":{"$ref":"#/components/schemas/EntityImage"},"description":"Every image the entry shows, the lead first. Empty when it shows none."},"handles":{"type":"array","items":{"$ref":"#/components/schemas/Handle"}}},"required":["vhid","short","title","subtitle","entity_type","entity_kind","verified","description","description_source","description_license","url","image","image_rights","images","handles"],"additionalProperties":false,"description":"An entry: the same data its page shows, from the same code. Email addresses are masked. The text is CC0, except a description taken from Wikipedia (`description_license`)."},"EntityBatch":{"type":"object","properties":{"results":{"type":"array","items":{"$ref":"#/components/schemas/EntityBatchResult"},"description":"One element per key asked for, in the order asked, a repeated key once (where it first appears)."}},"required":["results"],"additionalProperties":false,"description":"Many entries at once: each key’s answer, in request order."},"EntityBatchResult":{"oneOf":[{"type":"object","properties":{"key":{"type":"string","description":"The key as asked for, trimmed."},"status":{"type":"string","const":"ok"},"entity":{"description":"Exactly what `GET /api/v1/entities/{key}` answers for this key.","$ref":"#/components/schemas/Entity"}},"required":["key","status","entity"],"additionalProperties":false},{"type":"object","properties":{"key":{"type":"string","description":"The key as asked for, trimmed."},"status":{"type":"string","const":"not_found","description":"No public entry answers to the key: where the single read answers 404."}},"required":["key","status"],"additionalProperties":false}],"description":"What one requested key answers."},"EntityHandles":{"type":"object","properties":{"vhid":{"type":"string","pattern":"^\\d{11}$","description":"The entry’s VHID: 11 digits, permanent."},"handles":{"type":"array","items":{"$ref":"#/components/schemas/Handle"}}},"required":["vhid","handles"],"additionalProperties":false,"description":"An entry’s handles alone: the same list as the entry’s `handles`."},"EntityHistory":{"type":"object","properties":{"vhid":{"type":"string","pattern":"^\\d{11}$","description":"The entry’s VHID: 11 digits, permanent."},"merged_into":{"description":"Present when the entry was merged into another: that entry’s VHID. The history is still the merged entry’s own.","type":"string","pattern":"^\\d{11}$"},"limit":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"The page size used: the `limit` asked for, clamped to the endpoint’s range."},"offset":{"type":"integer","minimum":0,"maximum":10000,"description":"The offset used: the `offset` asked for, clamped to 0–10,000."},"next_offset":{"anyOf":[{"type":"integer","minimum":1,"maximum":9007199254740991},{"type":"null"}],"description":"The `offset` of the next page, or null when this is the last one. Follow it rather than computing it."},"history":{"type":"array","items":{"$ref":"#/components/schemas/Revision"},"description":"Newest first."}},"required":["vhid","limit","offset","next_offset","history"],"additionalProperties":false,"description":"A page of an entry’s public revision history, newest first."},"EntityHistoryPage":{"type":"object","properties":{"vhid":{"type":"string","pattern":"^\\d{11}$","description":"The entry’s VHID: 11 digits, permanent."},"key":{"type":"string","description":"The entry’s canonical key: its short name, or its VHID when it has none."},"merged_into":{"description":"Present when the entry was merged into another: that entry’s VHID. The history is still the merged entry’s own.","type":"string","pattern":"^\\d{11}$"},"page":{"type":"integer","minimum":1,"maximum":9007199254740991,"description":"The page, 50 revisions each."},"hasMore":{"type":"boolean","description":"There is a next page (`?p=` one more)."},"history":{"type":"array","items":{"$ref":"#/components/schemas/Revision"},"description":"Newest first."}},"required":["vhid","key","page","hasMore","history"],"additionalProperties":false,"description":"A page of an entry’s public history, as its history page shows it: 50 a page, by page number."},"EntityImage":{"type":"object","properties":{"url":{"type":"string","description":"The image, as a path on this site (`/img/w/480q75/<id>`)."},"main":{"type":"boolean","description":"True for the lead image, false for the gallery images after