{
  "openapi": "3.0.3",
  "info": {
    "title": "Play.ht Text to Speech API",
    "description": "Play.ht API for text-to-speech synthesis, voice cloning, and audio transcription.",
    "version": "2.3.0",
    "x-jentic-source-url": "https://docs.play.ht",
    "contact": {
      "name": "Play.ht",
      "url": "https://play.ht"
    }
  },
  "servers": [
    {
      "url": "https://api.play.ht",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    },
    {
      "UserId": []
    }
  ],
  "paths": {
    "/api/v2/tts": {
      "post": {
        "operationId": "generateAudio",
        "summary": "Generate Audio From Text",
        "description": "Creates an asynchronous TTS job converting text to audio. Text limit is 20k characters for Play3.0-mini or 2000 characters for other engines.",
        "tags": [
          "Text-to-Speech"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text",
                  "voice"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Content to convert to audio"
                  },
                  "voice": {
                    "type": "string",
                    "description": "Voice ID to use"
                  },
                  "quality": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "low",
                      "medium",
                      "high",
                      "premium"
                    ]
                  },
                  "output_format": {
                    "type": "string",
                    "enum": [
                      "mp3",
                      "wav",
                      "ogg",
                      "flac",
                      "mulaw"
                    ]
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 5.0
                  },
                  "voice_engine": {
                    "type": "string",
                    "enum": [
                      "PlayHT2.0",
                      "PlayHT1.0",
                      "Play3.0-mini"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "TTS job created successfully"
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/v2/tts/{id}": {
      "get": {
        "operationId": "getTtsJob",
        "summary": "Get Text-To-Speech Job Data",
        "description": "Retrieve job status, progress, and audio file information.",
        "tags": [
          "Text-to-Speech"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "TTS job ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Job data retrieved successfully"
          },
          "404": {
            "description": "Job not found"
          }
        }
      }
    },
    "/api/v2/tts/stream": {
      "post": {
        "operationId": "streamAudio",
        "summary": "Stream Audio From Text",
        "description": "HTTP streaming endpoint for real-time audio bytes.",
        "tags": [
          "Text-to-Speech"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text",
                  "voice"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "voice": {
                    "type": "string"
                  },
                  "quality": {
                    "type": "string"
                  },
                  "output_format": {
                    "type": "string"
                  },
                  "speed": {
                    "type": "number"
                  },
                  "voice_engine": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Audio stream"
          }
        }
      }
    },
    "/api/v2/tts/batches": {
      "post": {
        "operationId": "batchTts",
        "summary": "Batch TTS Jobs",
        "description": "Process multiple TTS conversions (1-50 jobs per batch).",
        "tags": [
          "Text-to-Speech"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "jobs": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "minItems": 1,
                    "maxItems": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch created successfully"
          }
        }
      }
    },
    "/api/v2/voices": {
      "get": {
        "operationId": "listVoices",
        "summary": "List PlayHT Voices",
        "description": "Retrieve available PlayHT voices.",
        "tags": [
          "Voices"
        ],
        "responses": {
          "200": {
            "description": "List of voices"
          }
        }
      }
    },
    "/api/v2/cloned-voices/instant": {
      "post": {
        "operationId": "createInstantVoiceClone",
        "summary": "Create Instant Voice Clone",
        "description": "Create an instant voice clone from an uploaded audio file.",
        "tags": [
          "Voice Cloning"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "sample_file",
                  "voice_name"
                ],
                "properties": {
                  "sample_file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "voice_name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Voice clone created"
          }
        }
      }
    },
    "/api/v2/cloned-voices": {
      "get": {
        "operationId": "listClonedVoices",
        "summary": "List Cloned Voices",
        "description": "List all cloned voices.",
        "tags": [
          "Voice Cloning"
        ],
        "responses": {
          "200": {
            "description": "List of cloned voices"
          }
        }
      }
    },
    "/api/v2/cloned-voices/{voice_id}": {
      "delete": {
        "operationId": "deleteClonedVoice",
        "summary": "Delete Cloned Voice",
        "description": "Delete a cloned voice.",
        "tags": [
          "Voice Cloning"
        ],
        "parameters": [
          {
            "name": "voice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Voice deleted"
          }
        }
      }
    },
    "/api/v2/transcriptions": {
      "post": {
        "operationId": "createTranscription",
        "summary": "Timestamp From Audio",
        "description": "Create a transcription job from audio.",
        "tags": [
          "Transcription"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "audio_url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transcription job created"
          }
        }
      }
    },
    "/api/v2/transcriptions/{id}": {
      "get": {
        "operationId": "getTranscription",
        "summary": "Get Transcription Job Data",
        "description": "Retrieve transcription job data.",
        "tags": [
          "Transcription"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transcription job data"
          }
        }
      }
    },
    "/api/v1/convert": {
      "post": {
        "operationId": "convertTextToSpeechV1",
        "summary": "Convert Plain Text To Speech",
        "description": "Convert plain text to speech using v1 API.",
        "tags": [
          "Legacy"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "voice": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversion started"
          }
        }
      }
    },
    "/api/v1/articleStatus": {
      "get": {
        "operationId": "getConversionStatus",
        "summary": "Get Conversion Job Status",
        "description": "Get the status of a text-to-speech conversion job.",
        "tags": [
          "Legacy"
        ],
        "parameters": [
          {
            "name": "transcriptionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status"
          }
        }
      }
    },
    "/api/v1/getVoices": {
      "get": {
        "operationId": "getVoicesV1",
        "summary": "Get Available Voices",
        "description": "Get available voices (v1 API).",
        "tags": [
          "Legacy"
        ],
        "responses": {
          "200": {
            "description": "List of voices"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token from Play.ht API access page"
      },
      "UserId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-USER-ID",
        "description": "User ID from Play.ht API access page"
      }
    }
  }
}
