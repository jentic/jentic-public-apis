  "components": {
    "schemas": {
      "IBanResponse": {
        "type": "object",
        "properties": {
          "accountData": {
            "$ref": "#/components/schemas/AccountData"
          },
          "metadata": {
            "$ref": "#/components/schemas/ResponseMetadata"
          }
        }
      },
      "AccountData": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Summary"
            }
          },
          "currencyAccounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrencyAccounts"
            }
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "totalCount": {
            "type": "integer",
            "description": "Total number of IBANs"
          },
          "availableCount": {
            "type": "integer",
            "description": "Number of available IBANs"
          },
          "usedCount": {
            "type": "integer",
            "description": "Number of used IBANs"
          }
        }
      },
      "CurrencyAccounts": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "description": "Currency code",
            "example": "USD"
          },
          "accounts": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "example": [
              "22-666645-23",
              "33-666645-44"
            ]
          }
        }
      },
      "AccountDetails": {
        "type": "object",
        "required": [
          "currency",
          "openingBalance",
          "applicationId",
          "userId"
        ],
        "properties": {
          "currency": {
            "type": "string",
            "description": "Currency code (e.g., USD, EUR, GBP)",
            "example": "USD"
          },
          "openingBalance": {
            "type": "string",
            "description": "Opening balance for the account",
            "example": "0.00"
          },
          "applicationId": {
            "type": "string",
            "description": "Application identifier",
            "example": "APP123"
          },
          "userId": {
            "type": "string",
            "description": "User identifier",
            "example": "USER456"
          },
          "accountNo": {
            "type": "string",
            "description": "Account number"
          },
          "bankId": {
            "type": "string",
            "description": "Bank identifier"
          },
          "countryCode": {
            "type": "string",
            "description": "Country code"
          },
          "parentAccountNo": {
            "type": "string",
            "description": "Parent account number"
          },
          "name": {
            "type": "string",
            "description": "Account holder name"
          },
          "addressLine1": {
            "type": "string",
            "description": "Address line 1"
          },
          "addressLine2": {
            "type": "string",
            "description": "Address line 2"
          },
          "addressLine3": {
            "type": "string",
            "description": "Address line 3"
          },
          "addressLine4": {
            "type": "string",
            "description": "Address line 4"
          },
          "initialStatus": {
            "type": "string",
            "description": "Initial account status"
          },
          "requestDate": {
            "type": "string",
            "format": "date-time",
            "description": "Request date"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time",
