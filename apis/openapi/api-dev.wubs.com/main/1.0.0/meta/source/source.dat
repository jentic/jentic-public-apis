                  "metadata": {
                    "timestamp": "2023-11-21T22:39:06Z",
                    "statusCode": 400,
                    "statusDescription": "Bad Request",
                    "path": "/accounts/{clientId}",
                    "errors": [
                      {
                        "errorCode": 400,
                        "errorMessage": "Backend resource not found",
                        "errorDetails": "No Record Found",
                        "serviceName": "Virtual Account Management Service"
                      }
                    ],
                    "correlationId": "c3edd22c-74e2-4d14-91e7-210b2a60c1a4"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://api.swaggerhub.com/domains/Convera/CommonResponse/v0#/components/schemas/CommonResponse"
                },
                "example": {
                  "data": {},
