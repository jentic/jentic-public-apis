    "/accounts/{clientId}": {
      "post": {
        "tags": [
          "Virtual Accounts"
        ],
        "summary": "Create a virtual account",
        "description": "Creates a new virtual account for the specified client",
        "operationId": "createVirtualAccount",
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "description": "Client identifier",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "correlationId",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Account details for creating virtual account",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountDetails"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Virtual account created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAccountRespone"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Mandatory element is missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "https://api.swaggerhub.com/domains/Convera/CommonResponse/v0#/components/schemas/CommonResponse"
                },
                "example": {
