{
  "openapi": "3.0.3",
  "info": {
    "title": "Virtual Account Management API",
    "description": "API for managing virtual accounts, including creating accounts, retrieving account information, managing IBANs, and accessing client and currency reference data.",
    "version": "1.0.0",
    "contact": {
      "name": "WUBS VAM Team",
      "email": "support@wubs.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Convera/VirtualAccountManagement/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.wubs.com",
      "description": "Production Server"
    }
  ],
  "tags": [
    {
      "name": "IBAN Management",
      "description": "Operations for managing IBANs (available, used, and all)"
    },
    {
      "name": "Virtual Accounts",
      "description": "Operations for creating and retrieving virtual accounts"
    },
    {
      "name": "Currencies",
      "description": "Operations for retrieving currency information"
    }
  ],
  "paths": {
    "/ibans/available": {
      "get": {
        "tags": [
          "IBAN Management"
        ],
        "summary": "Get available IBANs (alternate endpoint)",
        "description": "Retrieves all available (unassigned) IBANs",
