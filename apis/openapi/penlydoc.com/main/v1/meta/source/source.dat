{"openapi":"3.1.0","info":{"title":"PenlyDoc API","description":"Send documents for signature from your product, show the signing page inside it, and get the signed PDF back. Step-by-step guide: [/docs](/docs). Embedding from A to Z: [/docs/embed](/docs/embed).\n\nAuthorize with your API key (Console → Developers). Keep it on your server.","contact":{"name":"PenlyDoc support","email":"support@penlydoc.com"},"version":"v1"},"servers":[{"url":"https://penlydoc.com","description":"Generated server url"}],"security":[{"apiKey":[]}],"tags":[{"name":"Organisation","description":"Check the key and see which organisation it belongs to."},{"name":"Envelopes","description":"One document sent to one or more people: create, send, follow, download."},{"name":"Templates","description":"A document prepared once, with boxes and data boxes, sent with plain JSON."},{"name":"Webhooks","description":"PenlyDoc calls your server when something happens to an envelope."},{"name":"Branding and embedding","description":"Name, colour, logo, language, and the websites allowed to show the signing page."},{"name":"Settings","description":"Organisation defaults."},{"name":"Verification","description":"Public: check that a signed PDF has not been changed."}],"paths":{"/v1/webhook":{"get":{"tags":["Webhooks"],"summary":"Show the webhook URL","operationId":"webhookInfo","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/WebhookInfo"}}}}}},"put":{"tags":["Webhooks"],"summary":"Set the webhook URL (returns a new signing secret)","operationId":"webhook","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/WebhookConfig"}}}}}}},"/v1/templates/{id}/fields":{"put":{"tags":["Templates"],"summary":"Replace the boxes and data boxes of a template","operationId":"fields","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TemplateFields"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/TemplateView"}}}}}}},"/v1/settings/reminders":{"get":{"tags":["Settings"],"summary":"Default reminder interval","operationId":"reminders","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Reminders"}}}}}},"put":{"tags":["Settings"],"summary":"Change the default reminder interval","operationId":"saveReminders","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Reminders"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Reminders"}}}}}}},"/v1/envelopes/{id}/fields":{"put":{"tags":["Envelopes"],"summary":"Replace the boxes of a draft","operationId":"fields_1","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/FieldInput"}}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/EnvelopeView"}}}}}}},"/v1/branding":{"get":{"tags":["Branding and embedding"],"summary":"Show branding and embed origins","operationId":"get","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Branding"}}}}}},"put":{"tags":["Branding and embedding"],"summary":"Change branding and embed origins","operationId":"update","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BrandingUpdate"}}},"required":true},"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Branding"}}}}}}},"/v1/branding/logo":{"get":{"tags":["Branding and embedding"],"summary"