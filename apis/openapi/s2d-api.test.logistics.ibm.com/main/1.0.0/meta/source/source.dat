      "importCustomsCleared": {
        "description": "Brokerage Shipment data to be sent back upon clearance of the customs import declaration",
        "type": "object",
        "required": [
          "process",
          "shipment",
          "userRole"
        ],
        "properties": {
          "shipment": {
            "type": "object",
            "properties": {
              "shipmentID": {
                "type": "string",
                "description": "IBM shipment reference number"
              },
              "totalCases": {
                "type": "string",
                "description": "Total number of cases included in the shipment"
              },
              "countryOfOrigin": {
                "type": "string",
                "description": "Country of origin at shipment level. Calculated if several items."
              },
              "customsDocuments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "docType": {
                      "type": "string",
                      "description": "Code describing the type of document (LBL, ILR etc)"
                    },
                    "docNames": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "docBusinessProperties": {
                      "type": "object",
                      "properties": {
                        "docApproved": {
                          "type": "string",
                          "description": "Date the document was approved (i.e. customs cleared)"
                        },
                        "docNumber": {
                          "type": "string",
                          "description": "Document reference or identification number"
                        },
                        "docSubmitted": {
                          "type": "string",
                          "description": "Date document was officially submitted"
                        }
                      }
                    }
                  }
                }
              },
              "freightTotal": {
                "type": "string",
                "description": "Total international freight cost at shipment level"
              },
              "invoiceTotalValueOfGoods": {
                "type": "string",
                "description": "Total value of all the goods included in the shipment and across all invoices"
              },
              "customsDutiesTotal": {
                "type": "object",
                "description": "All customs duties amounts paid",
                "properties": {
                  "currency": {
                    "type": "string",
                    "description": "currency of the duties paid"
                  },
                  "exchangeRateCustoms": {
                    "type": "string",
                    "description": "exchange rate applied from local to USD at the time of import"
                  },
                  "localCurrencyType": {
                    "type": "string",
                    "description": "currency if duties were paid in local currency - P22"
                  },
                  "dutiesCharges": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "Code describing the duties"
                        },
                        "description": {
                          "type": "string",
                          "description": "Long description for the duties paid"
                        },
                        "value": {
                          "type": "string",
                          "description": "Amount paid for the specific duties category"
                        },
                        "valueLocal": {
                          "type": "string",
                          "description": "Amount in local currency for the duties paid"
                        }
                      }
                    }
                  }
                }
              },
              "customsCode": {
                "type": "string",
                "description": "Customs code"
              },
              "insuranceValue": {
                "type": "string",
                "description": "Total insurance value declared for the shipment"
              },
              "incoTerms": {
                "type": "string",
                "description": "Shipment incoterms"
              },
              "invoices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "invoiceNumber": {
                      "type": "string",
                      "description": "Invoice number/s within the shipment"
                    },
                    "date": {
                      "type": "string",
                      "description": "Invoice date"
                    },
                    "invoiceToAddress": {
                      "type": "object",
                      "description": "Importer of records address information",
                      "properties": {
                        "name1": {
                          "type": "string",
                          "description": "Buyer company name"
                        }
                      }
                    },
                    "cases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "caseNum": {
                            "type": "string",
                            "description": "Case identifier"
                          },
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "goodID": {
                                  "type": "string",
                                  "description": "Part number or FRU"
                                },
                                "itemNum": {
                                  "type": "string",
                                  "description": "Item sequence number"
                                },
                                "itemCondition": {
                                  "type": "string",
                                  "description": "Condition of the item if USED or NEW"
                                },
                                "itemModel": {
                                  "type": "string",
                                  "description": "Manufacturer model name,, defaulted to IBM part number if not known"
                                },
                                "itemSupBrand": {
                                  "type": "string",
                                  "description": "Manufacturer name, defaulted to IBM if not known"
                                },
                                "qty": {
                                  "type": "string",
                                  "description": "Number of items per line in the case"
                                },
                                "uom": {
                                  "type": "string",
                                  "description": "Unit of measure"
                                },
                                "orderNum": {
                                  "type": "string",
                                  "description": "IBM order number"
                                },
                                "hsClassification": {
                                  "type": "string",
                                  "description": "Import HS codes used for destination country"
                                },
                                "hsClassificationExt": {
                                  "type": "string",
                                  "description": "Extended Import HS codes for destination country"
                                },
                                "coo": {
                                  "type": "string",
                                  "description": "Country of origin of the item"
                                },
                                "price": {
                                  "type": "string",
                                  "description": "total price per item line.Same as qty * unitPrice"
                                },
                                "toBeDeclared": {
                                  "type": "string",
                                  "description": "Flag to determine if item part of shipping group deos not need to be declared seperately"
                                },
                                "foBValueItem": {
                                  "type": "string",
                                  "description": "freight on board value for item"
                                },
                                "upliftValueItem": {
                                  "type": "string",
                                  "description": "uplift value added on item line on top of value shown on invoice"
                                },
                                "freeTradeAgreementFlag": {
                                  "type": "string",
                                  "description": "Item belongs to free trade agreement"
                                },
                                "freeTradeAgreementName": {
                                  "type": "string",
                                  "description": "Name of free trade agreement"
                                },
                                "customsDutiesTotal": {
                                  "type": "object",
                                  "description": "All customs duties amounts paid",
                                  "properties": {
                                    "currency": {
                                      "type": "string",
                                      "description": "currency of the duties paid"
                                    },
                                    "localCurrencyType": {
                                      "type": "string",
                                      "description": "currency if duties were paid in local currency"
                                    },
                                    "dutiesCharges": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "properties": {
                                          "code": {
                                            "type": "string",
                                            "description": "Code describing the duties"
                                          },
                                          "description": {
                                            "type": "string",
                                            "description": "Long description for the duties paid"
                                          },
                                          "value": {
                                            "type": "string",
                                            "description": "Amount paid for the specific duties category"
                                          },
                                          "valueLocal": {
                                            "type": "string",
                                            "description": "Amount in local currency for the duties paid"
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "invoiceTotalDeclared": {
                "type": "string",
                "description": "Customs Value of a shipment to be declared (county specific calculation)"
              },
              "upliftValueTotal": {
                "type": "string",
                "description": "Uplift on shipment level"
              },
              "fOBValueTotal": {
                "type": "string",
                "description": "Freight on board value for total shipment"
              },
              "brokerName": {
                "type": "string",
                "description": "Broker company name in charge of shipment"
              },
              "importCustomsProcedureCode": {
                "type": "string",
                "description": "Import customs procedure code"
              },
              "customsChannel": {
                "type": "string",
                "description": "Channel color, red, amber etc"
              },
              "customsPaymentTicket": {
                "type": "string",
                "description": "Ticket number pertaining to the payment performed at customs (EC)"
              },
              "currentCarrier": {
                "type": "object",
                "properties": {
                  "houseAirwayBillNumber": {
                    "type": "string",
                    "description": "House AirwayBill number"
                  }
                }
              }
            }
          },
          "process": {
            "type": "string",
            "description": "GL - fixed value"
          },
          "userRole": {
            "type": "string",
            "description": "Import Broker - fixed value"
          }
        }
      },
      "customsReleaseEvent": {
        "description": "Event to be sent when the goods are released at customs",
        "type": "object",
        "required": [
          "process",
          "shipment",
          "userRole"
        ],
        "properties": {
          "shipment": {
            "type": "object",
            "required": [
              "shipmentID",
              "customsReleaseEvent"
            ],
            "properties": {
              "shipmentID": {
                "type": "string",
                "description": "IBM shipment reference number"
              },
              "customsReleaseEvent": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string",
                    "description": "Import customs location where the shipment was released. Country and City"
                  },
                  "locationDateTime": {
                    "type": "string",
                    "description": "Date and time the shipment was released in import customs in local time +/- UTC offset"
                  },
                  "locationDateTimeUTC": {
                    "type": "string",
                    "description": "Date and time the shipment was released in import customs in UTC time ending in Z"
                  },
                  "locationTimeZone": {
                    "type": "string",
                    "description": "Timezone for local time"
                  }
                }
              }
            }
          },
          "process": {
            "type": "string",
            "description": "GL"
          },
          "userRole": {
            "type": "string",
            "description": "Import Broker"
          }
        }
      },
      "customsPickUpEvent": {
        "description": "Event to be sent by Carrier when shipment was collected from customs",
        "type": "object",
        "required": [
          "process",
          "shipment",
          "userRole"
        ],
        "properties": {
          "shipment": {
            "type": "object",
            "required": [
              "shipmentID",
              "customsPickupEvent"
            ],
            "properties": {
              "shipmentID": {
                "type": "string"
              },
              "customsPickupEvent": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string",
                    "description": "Import customs location where the shipment was picked up by the carrier. Country and City"
                  },
                  "locationDateTime": {
                    "type": "string",
                    "description": "Date and time the shipment was picked up by the carrier from import customs in local time +/- UTC offset"
                  },
                  "locationDateTimeUTC": {
                    "type": "string",
                    "description": "Date and time the shipment was picked up by the carrier from import customs in UTC time ending in Z"
                  },
                  "locationTimeZone": {
                    "type": "string",
                    "description": "Timezone for local time"
                  }
                }
              }
            }
          },
          "process": {
            "type": "string",
            "description": "GL"
          },
          "userRole": {
            "type": "string",
            "description": "Carrier"
          }
        }
      },
      "crossDoc": {
        "description": "Package has been delivered at destination, event information returned by carrier",
        "type": "object",
        "properties": {
          "process": {
            "type": "string",
            "description": "GL"
          },
          "role": {
            "type": "string",
            "description": "Carrier"
          },
          "shipment": {
            "type": "object",
            "properties": {
              "shipmentID": {
                "type": "string"
              },
              "actualDeliveryEvent": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string"
                  },
                  "locationDateTime": {
                    "type": "string"
                  },
                  "locationDateTimeUTC": {
                    "type": "string"
                  },
                  "locationTimeZone": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "finalDeliveryEvent": {
        "description": "Package has been delivered at destination, event information returned by carrier",
        "type": "object",
        "required": [
          "process",
          "shipment",
          "userRole"
        ],
        "properties": {
          "process": {
            "type": "string",
            "description": "GL"
          },
          "userRole": {
            "type": "string",
            "description": "Carrier"
          },
          "shipment": {
            "type": "object",
            "required": [
              "shipmentID",
              "actualDeliveryEvent"
            ],
            "properties": {
              "shipmentID": {
                "type": "string"
              },
              "actualDeliveryEvent": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string",
                    "description": "Location where the shipment was delivered. Country and City"
                  },
                  "locationDateTime": {
                    "type": "string",
                    "description": "Date and time the shipment was delivered to destination in local time +/- UTC offset"
                  },
                  "locationDateTimeUTC": {
                    "type": "string",
                    "description": "Date and time the shipment was delivered to destination in UTC time ending in Z"
                  },
                  "locationTimeZone": {
                    "type": "string",
                    "description": "Timezone for local time"
                  }
                }
              }
            }
          }
        }
      },
      "fullShipmentAsset": {
        "description": "Full shipment schema",
        "type": "object",
        "properties": {
          "process": {
            "type": "string",
            "description": "GL"
          }
        }
      }
    },
    "parameters": {
      "grant_type": {
        "name": "grant_type",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "client_id": {
        "name": "client_id",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "client_secret": {
        "name": "client_secret",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "Process": {
        "name": "process",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "GL"
          ]
        }
      },
      "shipmentID": {
        "name": "shipmentID",
        "in": "query",
        "description": "Enter the shipment number below",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "FromCountry": {
        "name": "fromCountry",
        "in": "query",
        "description": "Add full country name",
        "schema": {
          "type": "string"
        }
      },
      "docType": {
        "name": "docType",
        "required": true,
        "in": "query",
        "description": "Document types available:\n\n- ALL - All documents for a shipment\n\n- HZMT - Hazardous Materials document\n\n- CRT - Certifications or product documentation\n\n- PI - Proforma Invoice document\n\n- INV - Invoice document\n\n- SINV - Single document containing all Invoices on a shipment\n\n- LBL - Case Label\n\n- PL- Packing List document\n\n- HAWB - House Airway Bill document\n\n- ILR - Import License Requested document\n\n- EDDS - Export Declaration Document Stampped (Cleared)\n\n- MRN - Export Document\n\n- DDR - Declaration Document when Requested \n\n- DDS - Declaration Document Stampped when clearance provided \n\n- POD - Proof of Delivery\n\n- AOD - Advice of Delivery\n\n- MIS - Miscelaneous\n",
        "schema": {
          "type": "string",
          "enum": [
            "ALL",
            "LBL",
            "DDS",
            "MRN",
            "EDDS",
            "POD",
            "MIS",
            "ILR",
            "DDR",
            "HZMT",
            "HAWB",
            "CRT",
            "PL",
            "INV",
            "SINV",
            "PI"
          ]
        }
      },
      "identifier": {
        "required": true,
        "name": "identifier",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "shipmentID, Invoice number, Case number or item"
      },
      "getFile": {
        "name": "getFile",
        "in": "query",
        "description": "retrieve file",
        "schema": {
          "type": "string",
          "properties": {
            "docType": {
              "type": "string",
              "description": "- Documents needed for shipping:INV, DDR, DDS, ILR, HAWB, PL, HZMT, PI, CRT, LBL, SINV\n- Documents for Brokerage:\n"
            }
          }
        }
      },
      "fileContent": {
        "name": "filecontent",
        "in": "query",
        "description": "Select file",
        "required": true,
        "schema": {
          "type": "string",
          "format": "binary"
        }
      },
      "fileName": {
        "name": "fileName",
        "required": true,
        "schema": {
          "type": "string"
        },
        "in": "query",
        "description": "enter the full file name in the format filename.pdf"
      }
    },
    "responses": {
      "200error": {
        "description": "Success",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "400error": {
        "description": "Bad Request- The server cannot or will not process the request due to an apparent client error (e.g., malformed request syntax, size too large, invalid request message framing, or deceptive request routing)",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "401error": {
        "description": "Unauthorized - authentication is required and has failed or has not yet been provided.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "403error": {
        "description": "Forbidden - The request contained valid data and was understood by the server, but the server is refusing action. This may be due to the user not having the necessary permissions for a resource or needing an account of some sort, or attempting a prohibited action (e.g. creating a duplicate record where only one is allowed)",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "404error": {
        "description": "Not Found - The requested resource could not be found but may be available in the future. Subsequent requests by the client are permissible.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "408error": {
        "description": "Timeout - The server timed out waiting for the request. The client did not produce a request within the time that the server was prepared to wait. The client MAY repeat the request without modifications at any later time.\"",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "500error": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "518error": {
        "description": "blockchain connection error, currentcarrier not defined is not connection",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
