                    }
                  }
                }
              }
            }
          }
        }
      },
      "importLicenseApproved": {
        "description": "Data and document to be returned once the import license has been officially approved for applicable countries. Level will depend on the country ( can be at shipment or item)",
        "type": "object",
        "properties": {
          "customsDocuments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "docType": {
