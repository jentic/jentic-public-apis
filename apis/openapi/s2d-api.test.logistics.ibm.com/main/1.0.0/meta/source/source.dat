      "shipReqConfirmed": {
        "description": "Acknowledgment of shipping request. Note that invoice array and content is required for shipments where tracking number is needed at case level. Tracking number is mostly for GSP shipments.",
        "type": "object",
        "required": [
          "process",
          "shipment",
          "userRole"
        ],
        "properties": {
          "shipment": {
            "type": "object",
            "required": [
              "shipmentID"
            ],
            "properties": {
              "shipmentID": {
                "type": "string",
                "description": "Shipment identifier"
              },
              "currentCarrier": {
                "type": "object",
                "required": [
                  "houseAirwayBillNumber"
                ],
                "properties": {
                  "houseAirwayBillNumber": {
                    "type": "string",
                    "description": "Airwaybill can be provided at this point or once the booking is confirmed"
                  }
                }
              },
              "invoices": {
                "type": "array",
                "description": "invoice array and below contents are needed when case level information is to be provided",
                "items": {
                  "type": "object",
                  "required": [
                    "invoiceNumber"
                  ],
                  "properties": {
                    "invoiceNumber": {
                      "type": "string",
                      "description": "Invoice number/s in the shipment"
                    },
                    "cases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "caseNum",
                          "trackingNumber"
                        ],
                        "properties": {
                          "caseNum": {
                            "type": "string",
                            "description": "Case identifier contained in the invoice"
                          },
                          "trackingNumber": {
                            "type": "string",
                            "description": "Carrier identifier to track the case in the shipment"
                          },
                          "carrierCaseNum": {
                            "type": "string",
                            "description": "Carrier case id. Used in case there is a need to void the case in carrier system."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "process": {
            "type": "string",
            "description": "GL - fixed value"
          },
          "userRole": {
            "type": "string",
            "description": "Role performing the shipment update",
            "example": {
              "process": "Carrier"
            }
          }
        }
      },
      "sendLables": {
        "type": "object"
      },
      "pickupEvent": {
        "description": "Package picked up, event information returned by carrier",
        "type": "object",
        "required": [
          "process",
          "userRole",
          "shipment"
        ],
        "properties": {
          "shipment": {
            "type": "object",
            "required": [
              "shipmentID",
              "pickupEvent"
            ],
            "properties": {
              "shipmentID": {
                "description": "Shipment identifier",
                "type": "string"
              },
              "pickupEvent": {
                "type": "object",
                "required": [
                  "location",
                  "locationDateTimeUTC"
                ],
                "description": "Date and time shipment was picked up and handed over to carrier",
                "properties": {
                  "location": {
                    "type": "string",
                    "description": "Location where the pickup took place, city and country"
                  },
                  "locationDateTime": {
                    "type": "string",
                    "description": "Date and time pick up took place in local time +/- UTC offset"
                  },
                  "locationDateTimeUTC": {
                    "type": "string",
                    "description": "Date and time pick up took place in UTC time ending in Z"
                  },
                  "locationTimeZone": {
                    "type": "string",
                    "description": "TimeZone for local pickup date optional, if sent should be standard timeZone format"
                  }
                }
              }
            }
          },
          "process": {
            "type": "string",
            "description": "GL - fixed value"
          },
          "userRole": {
            "type": "string",
            "description": "Carrier"
          }
        }
      },
      "importLicenseRequested": {
        "description": "Data and document to be returned once the import license has been officially requested for applicable countries. Level will depend on the country ( can be at shipment or item)",
        "type": "object",
