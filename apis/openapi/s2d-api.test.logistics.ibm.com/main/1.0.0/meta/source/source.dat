              "shipmentID",
              "flightEvent"
            ],
            "properties": {
              "shipmentID": {
                "type": "string"
              },
              "flightEvent": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string",
                    "description": "Location where the flight left, city and country"
                  },
                  "locationDateTime": {
                    "type": "string",
                    "description": "Date and time flight left origin country in local time +/- UTC offset"
                  },
                  "locationDateTimeUTC": {
                    "type": "string",
                    "description": "Date and time flight left origin country in UTC time ending in Z"
                  },
                  "locationTimeZone": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "process": {
            "type": "string",
            "description": "GL"
          },
          "userRole": {
            "type": "string",
            "description": "Carrier"
          }
        }
      },
      "actualArrivalEvent": {
        "description": "Package has arrived at destination, event information returned by carrier",
        "type": "object",
        "required": [
          "process",
          "shipment",
          "userRole"
        ],
        "properties": {
          "shipment": {
            "type": "object",
            "required": [
              "shipmentID",
              "actualArrivalEvent"
            ],
            "properties": {
              "shipmentID": {
                "type": "string"
              },
              "actualArrivalEvent": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string",
                    "description": "Location where the flight arrived, city and country"
                  },
                  "locationDateTime": {
                    "type": "string",
                    "description": "Date and time flight arrived to destination country in local time +/- UTC offset"
                  },
                  "locationDateTimeUTC": {
                    "type": "string",
                    "description": "Date and time flight arrived to destination country in UTC time ending in Z"
                  },
                  "locationTimeZone": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "process": {
            "type": "string",
            "description": "GL"
          },
          "userRole": {
            "type": "string",
            "description": "Carrier"
          }
        }
      },
      "handOverEvent": {
        "description": "Package and/or documentation has been handed over to the Broker for clearance",
        "type": "object",
        "required": [
          "process",
          "shipment",
          "userRole"
        ],
        "properties": {
          "shipment": {
            "type": "object",
            "required": [
              "shipmentID",
              "handOverBrokerEvent"
            ],
            "properties": {
              "shipmentID": {
                "type": "string"
              },
              "handOverBrokerEvent": {
                "type": "object",
                "properties": {
                  "location": {
                    "type": "string",
                    "description": "Location where the shipment was handed over to the Broker, city and country"
                  },
                  "locationDateTime": {
                    "type": "string",
                    "description": "Date and time the shipment was handed over to the Broker in local time +/- UTC offset"
                  },
                  "locationDateTimeUTC": {
                    "type": "string",
                    "description": "Date and time he shipment was handed over to the Broker in UTC time ending in Z"
                  },
                  "locationTimeZone": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "process": {
            "type": "string",
            "description": "GL"
          },
          "userRole": {
            "type": "string",
            "description": "Carrier"
          }
        }
      },
      "getShipmentBrokerage": {
        "description": "Get shipment data for Brokerage",
        "type": "object",
        "required": [
          "process",
          "shipment",
          "userRole"
        ],
        "properties": {
          "shipment": {
            "type": "object",
            "required": [
              "shipmentID"
            ],
            "properties": {
              "shipmentID": {
                "type": "string",
                "description": "IBM shipment reference number"
              },
              "shipmentType": {
                "type": "string",
                "description": "Describes if the shipment is intercompany or vendor"
              },
              "brokerName": {
                "type": "string",
                "description": "Name of broker company"
              },
              "currentCarrier": {
                "type": "object",
                "properties": {
                  "houseAirwayBillNumber": {
                    "type": "string",
                    "description": "House airwaybill number"
                  },
                  "supplier": {
                    "type": "string",
                    "description": "Carrier name or Freight Forwarder"
                  }
                }
              },
              "exportCustomsIdentifier": {
                "type": "string",
                "description": "Number or ID used at customs"
              },
              "flightOrigin": {
                "type": "string",
                "description": "Port of exit code"
              },
              "foreignDestination": {
                "type": "string",
                "description": "Destination airport code"
              },
              "incoTerms": {
                "type": "string",
                "description": "Shipment incoterms"
              },
              "netWeight": {
                "type": "string",
                "description": "Total net weight of shipment- Sum of the net weight of all cases"
              },
              "grossWeight": {
                "type": "string",
                "description": "Total gross weight of shipment- Sum of the gross weight of all cases"
              },
              "weightUnitOfMeasure": {
                "type": "string",
                "description": "Unit of measure for weights in shipment"
              },
              "countryOfOrigin": {
                "type": "string",
                "description": "Country of origin of the shipment (Chile only)"
              },
              "totalInvoices": {
                "type": "string",
                "description": "Total number of invoices contained in the shipment"
              },
              "totalCases": {
                "type": "string",
                "description": "Total number of cases contained in the shipment"
              },
              "totalItems": {
                "type": "string",
                "description": "Total number of items contained in the shipment"
              },
              "invoiceTotalValueOfGoods": {
                "type": "string",
                "description": "Total value of the goods within the shipment - Sum of all invoices"
              },
              "invoiceTotal": {
                "type": "string",
                "description": "Sum of total invoices value on the shipment if more than one invoice"
              },
              "insurance": {
                "type": "string",
                "description": "Insurance % to be applied"
              },
              "upliftValueTotal": {
                "type": "string",
                "description": "Added value on top of Customs values for intra companies invoices"
              },
              "shipFromAddress": {
                "type": "object",
                "description": "Shipping address",
                "properties": {
                  "name1": {
                    "type": "string",
                    "description": "Shipper"
                  },
                  "shipFromStreet": {
                    "type": "string",
                    "description": "Shipping street & number"
                  },
                  "shipFromCity": {
                    "type": "string",
                    "description": "Shipping City"
                  },
                  "shipFromZipCode": {
                    "type": "string",
                    "description": "Shipping zip code"
                  },
                  "shipFromState": {
                    "type": "string",
                    "description": "Shipping State"
                  },
                  "shipFromCountryName": {
                    "type": "string",
                    "description": "Shipping Country Name"
                  },
                  "shipFromCountryCodeIso": {
                    "type": "string",
                    "description": "Shipping country in ISO char2 format"
                  }
                }
              },
              "shipToAddress": {
                "type": "object",
                "description": "Consignee address",
                "properties": {
                  "name1": {
                    "type": "string",
                    "description": "Consignee"
                  },
                  "shipToStreet": {
                    "type": "string",
                    "description": "Consignee street & number"
                  },
                  "shipToCity": {
                    "type": "string",
                    "description": "Consignee City"
                  },
                  "shipToZipCode": {
                    "type": "string",
                    "description": "Consignee zip code"
                  },
                  "regionCode": {
                    "type": "string",
                    "description": "Region code - Chile only"
                  },
                  "shipToState": {
                    "type": "string",
                    "description": "Consignee State"
                  },
                  "shipToCountryName": {
                    "type": "string",
                    "description": "Consignee Country Name"
                  },
                  "shipToCountryCodeIso": {
                    "type": "string",
                    "description": "Consignee country code in ISO format"
                  }
                }
              },
              "productType": {
                "type": "string",
                "description": "Brief description of the contents of the shipment"
              },
              "invoices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "invoiceNumber": {
                      "type": "string",
                      "description": "Invoice number/s within the shipment"
                    },
                    "date": {
                      "type": "string",
                      "description": "Invoice date"
                    },
                    "methodOfTransport": {
                      "type": "string",
                      "description": "Method of transport, A- Air, T-Truck etc."
                    },
                    "invoiceFromAddress": {
                      "type": "object",
                      "description": "Exporter of records address information",
                      "properties": {
                        "name1": {
                          "type": "string",
                          "description": "Seller company name"
                        },
                        "invoiceFromStreet": {
                          "type": "string",
                          "description": "Seller address street and number"
                        },
                        "invoiceFromCity": {
                          "type": "string",
                          "description": "Seller address city"
                        },
                        "invoiceFromZipCode": {
                          "type": "string",
                          "description": "Seller address zip code"
                        },
                        "invoiceFromState": {
                          "type": "string",
                          "description": "Seller address State"
                        },
                        "invoiceFromCountryName": {
                          "type": "string",
                          "description": "Seller address country name"
                        },
                        "invoiceFromCountryCodeIso": {
                          "type": "string",
                          "description": "Seller address country code in ISO format"
                        }
                      }
                    },
                    "sellerVATReference": {
                      "type": "string",
                      "description": "Seller Tax reference"
                    },
                    "invoiceToAddress": {
                      "type": "object",
                      "description": "Importer of records address information",
                      "properties": {
                        "name1": {
                          "type": "string",
                          "description": "Buyer company name"
                        },
                        "invoiceToStreet": {
                          "type": "string",
                          "description": "Buyer address street and number"
                        },
                        "invoiceToCity": {
                          "type": "string",
                          "description": "Buyer address city"
                        },
                        "invoiceToZipCode": {
                          "type": "string",
                          "description": "Buyer address zip code"
                        },
                        "invoiceToState": {
                          "type": "string",
                          "description": "Buyer address State"
                        },
                        "invoiceToCountryName": {
                          "type": "string",
                          "description": "Buyer address country name"
                        },
                        "invoiceToCountryCodeIso": {
                          "type": "string",
                          "description": "Buyer address country code in ISO format"
                        }
                      }
                    },
                    "buyerVATReference": {
                      "type": "string",
                      "description": "Buyer Tax reference number"
                    },
                    "valueOfGoods": {
                      "type": "string",
                      "description": "Total value of the goods in the invoice"
                    },
                    "totalPrice": {
                      "type": "string",
                      "description": "Total invoice value"
                    },
                    "invoiceCharges": {
                      "type": "array",
                      "description": "Split of all additional charges besides the goods",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "description": "Type of charge"
                          },
                          "charge": {
                            "type": "string",
                            "description": "Amount charged"
                          }
                        }
                      }
                    },
                    "totalFreightCost": {
                      "type": "string",
                      "description": "Total freight cost per invoice"
                    },
                    "currency": {
                      "type": "string",
                      "description": "Currency of invoice"
                    },
                    "invoiceType": {
                      "type": "string",
                      "description": "Indicator to show if this is a charge or no charge invoice"
                    },
                    "paymentTerms": {
                      "type": "string",
                      "description": "Number of days for when the invoice is due to be paid"
                    },
                    "cases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "caseNum": {
                            "type": "string",
                            "description": "case identifier"
                          },
                          "caseProductType": {
                            "type": "string",
                            "description": "Short description of case contents"
                          },
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "goodID": {
                                  "type": "string",
                                  "description": "Part number or FRU"
                                },
                                "itemNum": {
                                  "type": "string",
                                  "description": "Item sequence number"
                                },
                                "qty": {
                                  "type": "string",
                                  "description": "qty of items per line"
                                },
                                "orderNum": {
                                  "type": "string",
                                  "description": "IBM order number"
                                },
                                "hsClassification": {
                                  "type": "string",
                                  "description": "Import HS codes used for destination country"
                                },
                                "hsClassificationExt": {
                                  "type": "string",
                                  "description": "Extended Import HS codes for destination country"
                                },
                                "itemDescription": {
                                  "type": "string",
                                  "description": "Item description in English"
                                },
                                "itemDescriptionL2": {
                                  "type": "string",
                                  "description": "Item description in local language"
                                },
                                "itemCondition": {
                                  "type": "string",
                                  "description": "Condition of item if NEW or USED (aka Certified spare part)"
                                },
                                "presentation": {
                                  "type": "string",
                                  "description": "Assembled or unassembled such tems not included as a seperate line on the invoice for being part of another item such as a machine."
                                },
                                "itemSupBrand": {
                                  "type": "string",
                                  "description": "Manufacturer of item"
                                },
                                "itemModel": {
                                  "type": "string",
                                  "description": "Manufacturer model or reference number"
                                },
                                "manufacturedDate": {
                                  "type": "string",
                                  "description": "Date item was manufactured"
                                },
                                "manufacturerAddress": {
                                  "type": "object",
                                  "properties": {
                                    "name1": {
                                      "type": "string",
                                      "description": "Manufacturer Name"
                                    },
                                    "manufacturerStreet": {
                                      "type": "string",
                                      "description": "Manufacturer's address street & number"
                                    },
                                    "manufacturerCity": {
                                      "type": "string",
                                      "description": "Manufacturer's address City"
                                    },
                                    "manufacturerZipCode": {
                                      "type": "string",
                                      "description": "Manufacturer's address Zip Code"
                                    },
                                    "manufacturerState": {
                                      "type": "string",
                                      "description": "Manufacturer's address State"
                                    },
                                    "manufacturerCountryName": {
                                      "type": "string",
                                      "description": "Manufacturer's address Country name"
                                    },
                                    "manufacturerCountryCodeIso": {
                                      "type": "string",
                                      "description": "Manufacturer's address Country code in ISO format"
                                    }
                                  }
                                },
                                "coo": {
                                  "type": "string",
                                  "description": "Country of origin of the item"
                                },
                                "uom": {
                                  "type": "string",
                                  "description": "Unit of measure of the item"
                                },
                                "unitPrice": {
                                  "type": "string",
                                  "description": "Unit price of the item"
                                },
                                "price": {
                                  "type": "string",
                                  "description": "total price for item line"
                                },
                                "eccn": {
                                  "type": "string",
                                  "description": "Export control classification number"
                                },
                                "freeTradeAgreementFlag": {
                                  "type": "string",
                                  "description": "Item belongs to free trade agreement"
                                },
                                "freeTradeAgreementName": {
                                  "type": "string",
                                  "description": "Free trade agreement is a pact between two or more nations to reduce barriers to imports and exports among them"
                                },
                                "toBeDeclared": {
                                  "type": "string",
                                  "description": "Flag to determine if item part of shipping group deos not need to be declared seperately"
                                },
                                "certArray": {
                                  "type": "array",
                                  "description": "certificates pertaining to part if needed",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "certType": {
                                        "type": "string",
                                        "description": "Type of certificate required (if any)"
                                      },
                                      "certificateSubmittedDate": {
                                        "type": "string",
                                        "description": "Date the certificate was requested"
                                      },
                                      "certificateReferenceNumber": {
                                        "type": "string",
                                        "description": "Certificate reference number"
                                      },
                                      "certificateApprovedDate": {
                                        "type": "string",
                                        "description": "Date the certificate was approved"
                                      }
                                    }
                                  }
                                },
                                "customsDocuments": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "docType": {
                                        "type": "string",
                                        "description": "Code describing the type of document (DDR)"
                                      },
                                      "docNames": {
                                        "type": "array",
                                        "items": {
                                          "type": "string"
                                        }
                                      },
                                      "docBusinessProperties": {
                                        "type": "object",
                                        "properties": {
                                          "docApproved": {
                                            "type": "string",
                                            "description": "Date the document was approved (i.e. customs cleared)"
                                          },
                                          "docNumber": {
                                            "type": "string",
                                            "description": "Document reference or identification number"
                                          },
                                          "docSubmitted": {
                                            "type": "string",
                                            "description": "Date document was officially submitted"
                                          },
                                          "docNeeded": {
                                            "type": "string",
                                            "description": "Flag if document is required"
                                          },
                                          "docExpiry": {
                                            "type": "string",
                                            "description": "If document is valid for a period of time, date it expires"
                                          },
                                          "docStatus": {
                                            "type": "string",
                                            "description": "Status of the document (submitted, approved, cancelled ect)"
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "customsDocuments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "docType": {
                      "type": "string",
                      "description": "Code describing the type of document (DDR)"
                    },
                    "docNames": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "docBusinessProperties": {
                      "type": "object",
                      "properties": {
                        "docApproved": {
                          "type": "string",
                          "description": "Date the document was approved (i.e. customs cleared)"
                        },
                        "docNumber": {
                          "type": "string",
                          "description": "Document reference or identification number"
                        },
                        "docSubmitted": {
                          "type": "string",
                          "description": "Date document was officially submitted"
                        },
                        "docNeeded": {
                          "type": "string",
                          "description": "Flag if document is required"
                        },
                        "docExpiry": {
                          "type": "string",
                          "description": "If document is valid for a period of time, date it expires"
                        },
                        "docStatus": {
                          "type": "string",
                          "description": "Status of the document (submitted, approved, cancelled ect)"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "process": {
            "type": "string",
            "description": "GL"
          },
          "userRole": {
            "type": "string",
            "description": "Carrier"
          }
        }
      },
