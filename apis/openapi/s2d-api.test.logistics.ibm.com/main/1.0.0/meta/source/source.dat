{
  "openapi": "3.0.0",
  "servers": [
    {
      "description": "Token",
      "url": "https://us-south.appid.cloud.ibm.com/oauth/v4/0e35b23f-70a7-4879-9e5c-4866963c4c1c"
    },
    {
      "description": "Ship To Delivery API Production Environment",
      "url": "https://s2d-api.logistics.ibm.com"
    },
    {
      "description": "SwaggerHub API Auto Mocking",
      "url": "https://virtserver.swaggerhub.com/IBM122/S2DAPIDoc/1.0.0"
    }
  ],
  "info": {
    "version": "1.0.0",
    "title": "Ship To Delivery API",
    "description": "API documentation for the **Ship to Delivery** platform",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/IBM122/S2DAPIDoc/1.0.0"
  },
  "paths": {
    "/token": {
      "post": {
        "tags": [
          "Authenticate"
        ],
        "description": "To obtain the token first select the url ending in the word Token from the Servers drop down above, then add your client and secret below",
        "responses": {
          "400": {
            "description": "Error",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": {
                    "message": "unknown client_id or tenantId",
                    "name": "invalid_client",
                    "statusCode": "400"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": {
                    "message": "Invalid Credentials",
                    "name": "invalid_client",
                    "statusCode": "401"
                  }
                }
              }
            }
          }
        },
        "operationId": "token",
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "default": "client_credentials"
                  }
                },
                "required": [
                  "grant_type"
                ]
              }
            }
          }
        }
      }
    },
    "/queries/selectShipments": {
      "get": {
        "tags": [
          "Get shipment data"
        ],
        "description": "Returns the details for a given shipment; shipment data, invoices within the shipment, cases within the invoice and items within the case. Details of data available will depend on usage and can be seen in Schema below.",
        "parameters": [
          {
            "$ref": "#/components/parameters/shipmentID"
          },
          {
            "$ref": "#/components/parameters/Process"
          }
        ],
        "responses": {
          "200": {
            "description": "Succesfully returned the shipment asset",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/getShippingData"
                    },
                    {
                      "$ref": "#/components/schemas/getShipmentBrokerage"
                    }
                  ]
                },
                "examples": {
                  "shipConfirmed": {
                    "$ref": "#/components/examples/getShippingData"
                  },
                  "getDeclaration": {
                    "$ref": "#/components/examples/getShipmentBrokerage"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/500error"
          }
        }
      }
    },
    "/retrieve-gl-document/shipment-id": {
      "get": {
        "tags": [
          "Get all documents for a shipment"
        ],
        "description": "Returns all the documents for a given shipment in a ZIP format",
        "parameters": [
          {
            "$ref": "#/components/parameters/shipmentID"
          },
          {
            "$ref": "#/components/parameters/docType"
          }
        ],
        "responses": {
          "200": {
            "description": "Documents retrieved in zip format for shipment"
          },
          "500": {
            "$ref": "#/components/responses/500error"
          }
        }
      }
    },
    "/retrieve-gl-document": {
      "get": {
        "tags": [
          "Get a document"
        ],
        "description": "Returns a specific document for a given shipment",
        "parameters": [
          {
            "$ref": "#/components/parameters/fileName"
          },
          {
            "$ref": "#/components/parameters/docType"
          }
        ],
        "responses": {
          "200": {
            "description": "Document retrieved"
          },
          "500": {
            "$ref": "#/components/responses/500error"
          }
        }
      }
    },
    "/UpdateShipment": {
      "post": {
        "tags": [
          "Update shipment data"
        ],
        "description": "Transaction used to provide data back for a given shipment such as Carrier information or Brokerage. Data elements expected are found in the schema section below.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": {
                    "message": "updated Shipment MOC21123PFA2424 to Blockchain",
                    "statusCode": "200"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": {
                    "message": "Unexpected token } in JSON at position 185",
                    "name": "SyntaxError",
                    "statusCode": "400"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Error",
            "content": {
              "test/plain": {
                "schema": {
                  "type": "string",
                  "example": {
                    "message": "Shipment was not updated, case: ME284899 not found on invoice: 00210937",
                    "statusCode": "422"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/500error"
          }
        },
        "requestBody": {
          "description": "Select a transaction from the Examples below to see example value to be sent for each. schemas section to see data expected and descriptions for each transaction. You can also select a sample from below drop down for data to be sent.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/shipReqConfirmed"
                  },
                  {
                    "$ref": "#/components/schemas/sendLables"
                  },
                  {
                    "$ref": "#/components/schemas/pickupEvent"
                  },
                  {
                    "$ref": "#/components/schemas/flightBooking"
                  },
                  {
                    "$ref": "#/components/schemas/exportCleared"
                  },
                  {
                    "$ref": "#/components/schemas/reasonCodeUpdate"
                  },
                  {
                    "$ref": "#/components/schemas/flightEvent"
                  },
                  {
                    "$ref": "#/components/schemas/actualArrivalEvent"
                  },
                  {
                    "$ref": "#/components/schemas/handOverEvent"
                  },
                  {
                    "$ref": "#/components/schemas/importCustomsSubmitted"
                  },
                  {
                    "$ref": "#/components/schemas/importCustomsCleared"
                  },
                  {
                    "$ref": "#/components/schemas/customsReleaseEvent"
                  },
                  {
                    "$ref": "#/components/schemas/customsPickUpEvent"
                  },
                  {
                    "$ref": "#/components/schemas/finalDeliveryEvent"
                  }
                ]
              },
              "examples": {
                "shipConfirmed": {
                  "$ref": "#/components/examples/shipReqConfirmed"
                },
                "pickUpEvent": {
                  "$ref": "#/components/examples/pickupEvent"
                },
                "booked": {
                  "$ref": "#/components/examples/bookingConfirmed"
                },
                "reasonCode": {
                  "$ref": "#/components/examples/reasonCodeUpdate"
                },
                "exportCleared": {
                  "$ref": "#/components/examples/exportCleared"
                },
                "inflight": {
                  "$ref": "#/components/examples/flightEvent"
                },
                "arrival": {
                  "$ref": "#/components/examples/actualArrivalEvent"
                },
                "handOver": {
                  "$ref": "#/components/examples/handOverEvent"
                },
                "impDeclarationSubmitted": {
                  "$ref": "#/components/examples/importCustomsSubmitted"
                },
                "impDeclarationCleared": {
                  "$ref": "#/components/examples/importCustomsCleared"
                },
                "impCustomsReleasedEvent": {
                  "$ref": "#/components/examples/customsReleaseEvent"
                },
                "impCustomsPickupEvent": {
                  "$ref": "#/components/examples/customsPickUpEvent"
                },
                "finalDeliveryEvent": {
                  "$ref": "#/components/examples/finalDeliveryEvent"
                }
              }
            }
          }
        }
      }
    },
    "/UpdateCCCSCertData": {
      "post": {
        "tags": [
          "Update items"
        ],
        "description": "Transaction used to provide item data such as import license ILR. Data elements expected are found in the schema section below.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": {
                    "message": "updated Shipment MOC21123PFA2424 to Blockchain",
                    "statusCode": "200"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": {
                    "message": "Unexpected token } in JSON at position 185",
                    "name": "SyntaxError",
                    "statusCode": "400"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Error",
            "content": {
              "test/plain": {
                "schema": {
                  "type": "string",
                  "example": {
                    "message": "Shipment was not updated, case: ME284899 not found on invoice: 00210937",
                    "statusCode": "422"
                  }
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/500error"
          }
        },
        "requestBody": {
          "description": "Select a transaction from the Examples below to see example value to be sent for each. schemas section to see data expected and descriptions for each transaction. You can also select a sample from below drop down for data to be sent.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/importLicenseRequested"
                  },
                  {
                    "$ref": "#/components/schemas/importLicenseApproved"
                  }
                ]
              },
              "examples": {
                "impLicenseSub": {
                  "$ref": "#/components/examples/importLicenseSubmittedItem"
                },
                "impLicenseApp": {
                  "$ref": "#/components/examples/importLicenseApprovedItem"
                }
              }
            }
          }
        }
      }
    },
    "/upload-gl-document": {
      "post": {
        "tags": [
          "Upload documents"
        ],
        "description": "Transaction used to upload a document to a shipment",
        "responses": {
          "200": {
            "description": "doctypeXXX uploaded successfully! docName.pdf"
          },
          "500": {
            "$ref": "#/components/responses/500error"
          }
        },
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "identifier",
                  "docType",
                  "fileContent"
                ],
                "properties": {
                  "identifier": {
                    "type": "string",
                    "description": "Enter the identifier for the document. Please note that some countries may have specfic requirements for customs documents such as import license or import declarations:\n- Identifier= shipmentID for docTypes: EDDS, HAWB, HZMT, DDS, DDR, ,ILR, PL, POD,DDS_CALC,DDS_SIMP,DDS_SUMM,GOOD_INFO,DOC_PR,DDS_PS,INV_DOMTRAN,DDS_PR,PAY_PS,PAY_PR,AOD or MIS\n- Identifier= invoiceNumber for docTypes: INV, PI  \n- Identifier= caseNum for docType: LBL \n- Identifier= itemNum-caseNum-shipmentID for docType: ILR & DDS at item level\n- Identifier= goodID for docType: CRT\n"
                  },
                  "fileContent": {
                    "type": "string",
                    "format": "binary"
                  },
                  "docType": {
                    "type": "string",
                    "description": "select document type:\n- PL - Packing List\n- LBL - Case label\n- EDDS - Export declaration document stampped/ Cleared Customs\n- HAWB - House AirwayBill document\n- ILR - Import License Requested\n- DDR - Import Declaration document Requested\n- DDS - Import Declaration document Stampped/ Cleared Customs\n- MIS - Miscellaneous/ used for several countries with different ad hoc documents\n - DDS_CALC - Several uses, for Colombia Andina de Valor\n",
                    "enum": [
                      "LBL",
                      "HAWB",
                      "ILR",
                      "DDR",
                      "DDS",
                      "DDS_CALC",
                      "HZMT",
                      "MIS",
                      "PL",
                      "CRT"
                    ]
                  },
                  "docBusinessProperties": {
                    "type": "object",
                    "properties": {
                      "docNeeded": {
                        "type": "string",
                        "description": "Document required or mandatory"
                      },
                      "docNumber": {
                        "type": "string",
                        "description": "Document reference number"
                      },
                      "docSubmitted": {
                        "type": "string",
                        "description": "Date document was submitted"
                      },
                      "docApproved": {
                        "type": "string",
                        "description": "Date document was approved"
                      },
                      "docExpiry": {
                        "type": "string",
                        "description": "Date document expires"
                      },
                      "docStatus": {
                        "type": "string",
                        "description": "Status of document (Submitted, Approved, Exipred etc)"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
