      "flightBooking": {
        "description": "Shipment flight booking details confirmed",
        "type": "object",
        "required": [
          "process",
          "shipment",
          "userRole"
        ],
        "properties": {
          "shipment": {
            "required": [
              "shipmentID",
              "estimatedDepartureDate",
              "estimatedArrivalDate",
              "estimatedDeliveryDate",
              "flightOrigin",
              "currentCarrier"
            ],
            "type": "object",
            "properties": {
              "shipmentID": {
                "type": "string"
              },
              "estimatedDepartureDate": {
                "type": "string",
                "description": "Date and time the flight is estimated to depart in local time +/- UTC offset"
              },
              "estimatedArrivalDate": {
                "type": "string",
                "description": "Date and time the flight is estimated to arrive in local time +/- UTC offset"
              },
              "estimatedDeliveryDate": {
                "type": "string",
                "description": "Date and time the shipment is estimated to be delivered in local time +/- UTC offset"
              },
              "flightNumber": {
                "type": "string",
                "description": "Flight identifier"
              },
              "flightOrigin": {
                "type": "string",
                "description": "Port of exit"
              },
              "currentCarrier": {
                "required": [
                  "carrierCode",
                  "carrierName"
                ],
                "type": "object",
                "properties": {
                  "carrierCode": {
                    "type": "string",
                    "description": "Airline IATA code"
                  },
                  "carrierName": {
                    "description": "Airline ful name"
                  }
                }
              }
            }
          },
          "process": {
            "type": "string",
            "description": "GL - fixed value"
          },
          "userRole": {
            "type": "string",
            "description": "Role performing the shipment update"
          }
        }
      },
      "exportCleared": {
        "description": "Shipment has been cleared for export",
        "type": "object",
        "required": [
          "process",
          "shipment",
          "userRole"
        ],
        "properties": {
          "shipment": {
            "type": "object",
            "required": [
              "shipmentID"
            ],
            "properties": {
              "shipmentID": {
                "type": "string"
              },
              "customsDocuments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "docType": {
                      "type": "string",
                      "description": "hardcode to EDDS. Export declaration document stampped"
                    },
                    "docBusinessProperties": {
                      "type": "object",
                      "properties": {
                        "docNumber": {
                          "type": "string",
                          "description": "Export declaration number (ITN for US exports)"
                        },
                        "docSubmitted": {
                          "type": "string",
                          "description": "date the export was submitted to customs"
                        },
                        "docApproved": {
                          "type": "string",
                          "description": "clearance date"
                        },
                        "docStatus": {
                          "type": "string",
                          "description": "status of the export declaration SUBMITTED or CLEARED"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "process": {
            "type": "string",
            "description": "GL - fixed value"
          },
          "userRole": {
            "type": "string",
            "description": "Role performing the shipment update"
          }
        }
      },
      "reasonCodeUpdate": {
        "type": "object",
        "required": [
          "process",
          "shipment",
          "userRole",
          "reasonCode",
          "reasonCodeDescription",
          "reasonCodeDescriptionTimestamp"
        ],
        "description": "Reason codes to describe changes occured to shipment. These can be weather issues or anticipated deliveries etc",
        "properties": {
          "shipment": {
            "type": "object",
            "required": [
              "shipmentID"
            ],
            "properties": {
              "shipmentID": {
                "type": "string"
              }
            }
          },
          "process": {
            "type": "string",
            "description": "Default to GL"
          },
          "userRole": {
            "type": "string",
            "description": "Role performing the shipment update"
          },
          "reasonCode": {
            "type": "string",
            "description": "unified code per reason"
          },
          "reasonCodeDescription": {
            "type": "string",
            "description": "Description of reason"
          },
          "reasonCodeDescriptionTimestamp": {
            "type": "string",
            "description": "Timestamp when issue or event occured"
          }
        }
      },
