{
  "openapi": "3.0.3",
  "info": {
    "title": "UK Police Data API",
    "description": "Provides access to street-level crime, outcome, and stop-and-search data, as well as information about police forces and neighbourhoods across England, Wales, and Northern Ireland.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://data.police.uk/docs/",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://data.police.uk/api"
    }
  ],
  "paths": {
    "/crimes-street/{crime_category}": {
      "get": {
        "operationId": "getStreetLevelCrimes",
        "summary": "Get street-level crimes within a specific area",
        "description": "Returns crimes at street-level within a 1 mile radius of a single point or within a custom area.",
        "parameters": [
          {
            "name": "crime_category",
            "in": "path",
            "required": true,
            "description": "Crime category identifier (e.g., 'all-crime', 'burglary').",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude of the requested crime area.",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "description": "Longitude of the requested crime area.",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "poly",
            "in": "query",
            "required": false,
            "description": "Custom area defined by lat/lng pairs separated by colons (e.g., '52.268,0.543:52.794,0.238:52.130,0.478').",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Limit results to a specific month (YYYY-MM). Defaults to latest available.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of street-level crime objects.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Crime"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          },
          "503": {
            "description": "Too many results (over 10,000 crimes)."
          }
        }
      }
    },
    "/crimes-at-location": {
      "get": {
        "operationId": "getCrimesAtLocation",
        "summary": "Get crimes at a specific location",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Month in YYYY-MM format.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location_id",
            "in": "query",
            "required": false,
            "description": "Location ID from a previous API call.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude.",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "description": "Longitude.",
            "schema": {
              "type": "number",
              "format": "float"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of crimes at the specified location.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Crime"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/outcomes-for-crime/{crime_id}": {
      "get": {
        "operationId": "getOutcomesForCrime",
        "summary": "Get outcomes for a specific crime",
        "parameters": [
          {
            "name": "crime_id",
            "in": "path",
            "required": true,
            "description": "64-character crime persistent ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Crime details with outcomes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "crime": {
                      "$ref": "#/components/schemas/Crime"
                    },
                    "outcomes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "category": {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          },
                          "date": {
                            "type": "string"
                          },
                          "person_id": {
                            "type": "string",
                            "nullable": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/crime-categories": {
      "get": {
        "operationId": "getCrimeCategories",
        "summary": "Get list of valid crime categories",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Month in YYYY-MM format.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of crime categories.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/crime-last-updated": {
      "get": {
        "operationId": "getCrimeLastUpdated",
        "summary": "Get the date when crime data was last updated",
        "responses": {
          "200": {
            "description": "Date of last update.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string",
                      "format": "date"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/forces": {
      "get": {
        "operationId": "listForces",
        "summary": "List all police forces",
        "responses": {
          "200": {
            "description": "Array of police forces.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/forces/{force_id}": {
      "get": {
        "operationId": "getForce",
        "summary": "Get details of a specific police force",
        "parameters": [
          {
            "name": "force_id",
            "in": "path",
            "required": true,
            "description": "Unique force identifier.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Force details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    },
                    "telephone": {
                      "type": "string"
                    },
                    "engagement_methods": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Force not found."
          }
        }
      }
    },
    "/forces/{force_id}/senior-officers": {
      "get": {
        "operationId": "getSeniorOfficers",
        "summary": "Get senior officers of a police force",
        "parameters": [
          {
            "name": "force_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of senior officers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "bio": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "rank": {
                        "type": "string"
                      },
                      "contact_details": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{force_id}/neighbourhoods": {
      "get": {
        "operationId": "listNeighbourhoods",
        "summary": "List neighbourhoods for a police force",
        "parameters": [
          {
            "name": "force_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of neighbourhoods.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{force_id}/{neighbourhood_id}": {
      "get": {
        "operationId": "getNeighbourhood",
        "summary": "Get details of a specific neighbourhood",
        "parameters": [
          {
            "name": "force_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "neighbourhood_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Neighbourhood details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "url_force": {
                      "type": "string"
                    },
                    "population": {
                      "type": "string"
                    },
                    "centre": {
                      "type": "object",
                      "properties": {
                        "latitude": {
                          "type": "string"
                        },
                        "longitude": {
                          "type": "string"
                        }
                      }
                    },
                    "contact_details": {
                      "type": "object"
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/stops-street": {
      "get": {
        "operationId": "getStopAndSearchByArea",
        "summary": "Get stop and searches at street level in an area",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "poly",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Month in YYYY-MM format.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of stop and search records.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "involved_person": {
                        "type": "boolean"
                      },
                      "datetime": {
                        "type": "string"
                      },
                      "operation": {
                        "type": "boolean",
                        "nullable": true
                      },
                      "operation_name": {
                        "type": "string",
                        "nullable": true
                      },
                      "location": {
                        "type": "object",
                        "properties": {
                          "latitude": {
                            "type": "string"
                          },
                          "longitude": {
                            "type": "string"
                          },
                          "street": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      },
                      "gender": {
                        "type": "string"
                      },
                      "age_range": {
                        "type": "string"
                      },
                      "self_defined_ethnicity": {
                        "type": "string"
                      },
                      "officer_defined_ethnicity": {
                        "type": "string"
                      },
                      "legislation": {
                        "type": "string"
                      },
                      "object_of_search": {
                        "type": "string"
                      },
                      "outcome": {
                        "type": "string"
                      },
                      "outcome_linked_to_object_of_search": {
                        "type": "boolean",
                        "nullable": true
                      },
                      "removal_of_more_than_outer_clothing": {
                        "type": "boolean",
                        "nullable": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/stops-force": {
      "get": {
        "operationId": "getStopAndSearchByForce",
        "summary": "Get stop and searches by police force",
        "parameters": [
          {
            "name": "force",
            "in": "query",
            "required": true,
            "description": "Police force identifier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of stop and search records.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Crime": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "persistent_id": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "month": {
            "type": "string"
          },
          "location_type": {
            "type": "string"
          },
          "location_subtype": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "location": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "string"
              },
              "longitude": {
                "type": "string"
              },
              "street": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "outcome_status": {
            "type": "object",
            "nullable": true,
            "properties": {
              "category": {
                "type": "string"
              },
              "date": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "security": []
}
