  "components": {
    "parameters": {
      "CurrentCompany": {
        "name": "X-CURRENT-COMPANY-ID",
        "in": "header",
        "description": "L'ID dell'azienda sulla quale si vuole operare",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "required": true
      },
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Numero di pagina",
        "schema": {
          "type": "integer",
          "default": 1,
          "minimum": 1
        }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "description": "Numero di elementi per pagina che si vogliono recuperare",
        "schema": {
          "type": "integer",
          "default": 10,
          "minimum": 1,
          "maximum": 100
        }
      },
      "SimOrderFilter": {
        "name": "filter",
        "in": "query",
        "style": "deepObject",
        "explode": true,
        "description": "<strong>NB: Il filtro search filtra il campo iccid</strong>",
        "schema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string"
            }
          }
        }
      },
      "SimOrderSort": {
        "name": "sort",
        "in": "query",
        "style": "form",
        "description": "<strong>NB: Il segno - come prefisso serve per ordinare in maniera discendente</strong>",
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "minItems": 1,
            "enum": [
              "iccid",
              "-iccid"
            ]
          }
        }
      },
      "SimFilter": {
        "name": "filter",
        "in": "query",
        "style": "deepObject",
        "description": "<strong>NB: Il filtro search filtra il campo iccid</strong>",
        "explode": true,
        "schema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        }
      },
      "SimSort": {
        "name": "sort",
        "in": "query",
        "style": "form",
        "description": "<strong>NB: Il segno - come prefisso serve per ordinare in maniera discendente</strong>",
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "minItems": 1,
            "enum": [
              "iccid",
              "-iccid",
              "sim_type",
              "-sim_type"
            ]
          }
        }
      },
      "LineFilter": {
        "name": "filter",
        "in": "query",
        "style": "deepObject",
        "explode": true,
        "description": "<strong>NB: Il filtro search filtra i campi: msisdn, sim.iccid</strong>",
        "schema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string"
            },
            "status": {
              "type": "string"
            }
          }
        }
      },
      "LineSort": {
        "name": "sort",
        "in": "query",
        "style": "form",
        "description": "<strong>NB: Il segno - come prefisso serve per ordinare in maniera discendente</strong>",
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "minItems": 1,
            "enum": [
              "msisdn",
              "-msisdn",
              "iccid",
              "-iccid"
            ]
          }
        }
      },
      "OrderFilter": {
        "name": "filter",
        "in": "query",
        "style": "deepObject",
        "description": "<strong>NB: Il filtro search filtra i campi: number, username, sim_type</strong>",
        "explode": true,
        "schema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string"
            }
          }
        }
      },
      "OrderSort": {
        "name": "sort",
        "in": "query",
        "style": "form",
        "description": "<strong>NB: Il segno - come prefisso serve per ordinare in maniera discendente</strong>",
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "minItems": 1,
            "enum": [
              "created_at",
              "-created_at",
              "number",
              "-number",
              "username",
              "-username",
              "sim_type",
              "-sim_type",
              "quantity",
              "-quantity",
              "shipping_date",
              "-shipping_date",
              "delivery_date",
              "-delivery_date",
              "status",
              "-status"
            ]
          }
        },
        "explode": false
      },
      "TrafficStatisticFilter": {
        "name": "filter",
        "in": "query",
        "style": "deepObject",
        "explode": true,
        "schema": {
          "type": "object",
          "properties": {
            "msisdn": {
              "type": "string"
            },
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "from",
            "to"
          ]
        }
      },
      "TrafficStatisticSort": {
        "name": "sort",
        "in": "query",
        "style": "form",
        "description": "<strong>NB: Il segno - come prefisso serve per ordinare in maniera discendente</strong>",
        "schema": {
          "type": "string",
          "enum": [
            "msisdn",
            "-msisdn",
            "gb",
            "-gb",
            "sec_in",
            "-sec_in",
            "sec_out",
            "-sec_out",
            "sms_in",
            "-sms_in",
            "sms_out",
            "-sms_out",
            "extra",
            "-extra"
          ]
        },
        "explode": false
      },
      "TrafficStatisticDetailFilter": {
        "name": "filter",
        "in": "query",
        "style": "deepObject",
        "explode": true,
        "schema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "from",
            "to"
          ]
        }
      },
      "MsisdnFilter": {
        "name": "filter",
        "in": "query",
        "style": "deepObject",
        "explode": true,
        "schema": {
          "type": "object",
          "properties": {
            "status": {
              "$ref": "#/components/schemas/MsisdnStatus"
            }
          }
        }
      },
      "IpAddressFilter": {
        "name": "filter",
        "in": "query",
        "style": "deepObject",
        "explode": true,
        "schema": {
          "type": "object",
          "properties": {
            "status": {
              "$ref": "#/components/schemas/IpAddressStatus"
            }
          }
        }
      },
      "LogsSort": {
        "name": "sort",
        "in": "query",
        "style": "form",
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "created_at",
              "-created_at",
              "sim",
              "-sim",
              "number",
              "-number",
              "user",
              "-user",
              "profile",
              "-profile",
              "created_by",
              "-created_by"
            ]
          },
          "minItems": 1
        },
        "explode": false,
        "description": "Precedere il nome del campo con \"-\" per ordinare in modo discendente"
      },
      "LogsFilter": {
        "name": "filter",
        "in": "query",
        "style": "deepObject",
        "explode": true,
        "schema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string"
            },
            "operation_type": {
              "$ref": "#/components/schemas/LogOperation"
            },
            "from": {
              "type": "string",
              "format": "date"
            },
            "to": {
              "type": "string",
              "format": "date"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "meta": {
            "type": "object",
            "nullable": true
          }
        },
        "required": [
          "code",
          "meta"
        ]
      },
      "FieldValidationError": {
        "type": "string",
        "enum": [
          "UNSUPPORTED_VALUE",
          "REQUIRED",
          "STRING",
          "VATNUMBER",
          "TAXCODE",
          "PRESENT",
          "ARRAY",
          "FILE",
          "EMAIL",
          "UUID",
          "INTEGER",
          "MAX_VALUE_EXCEEDED",
          "DECIMAL",
          "INVALID_VALUE"
        ]
      },
      "PaginationLinks": {
        "type": "object",
        "properties": {
          "first": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "last": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "prev": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "next": {
            "type": "string",
            "format": "uri",
            "nullable": true
          }
        },
        "required": [
          "first",
          "last",
          "prev",
          "next"
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "nullable": true
          },
          "last_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "nullable": true
          },
          "from": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "to": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "path": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "nullable": true
          },
          "total": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          }
        },
        "required": [
          "current_page",
          "last_page",
          "from",
          "to",
          "path",
          "per_page",
          "total"
        ]
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "links": {
            "$ref": "#/components/schemas/PaginationLinks"
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "links",
          "meta",
          "data"
        ]
      },
      "SimpleProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ]
      },
      "LineStatus": {
        "type": "string",
        "enum": [
          "shipped",
          "available",
          "documentation_verification",
          "documentation_rejected",
          "active",
          "mnp_in_progress",
          "mnp_discarded",
          "suspended",
          "deleted",
          "in_activation",
          "transferred",
          "transformed",
          "sim_replacement_scheduled",
          "activation_failed"
        ]
      },
      "SimStatus": {
        "type": "string",
        "enum": [
          "not_assigned",
          "shipped",
          "available"
        ]
      },
      "SimType": {
        "type": "string",
        "enum": [
          "sim",
          "esim"
        ]
      },
      "SimVolte": {
        "type": "string",
        "enum": [
          "active",
          "unavailable",
          "available"
        ]
      },
      "Line": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "msisdn": {
            "type": "string",
            "nullable": true
          },
          "user": {
            "$ref": "#/components/schemas/LineUser"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SimpleProfile"
              },
              {
                "nullable": true
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/LineStatus"
          },
          "device": {
            "type": "string",
            "nullable": true
          },
          "volte": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SimVolte"
              },
              {
                "nullable": true
              }
            ]
          },
          "delivery_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "updating": {
            "type": "boolean"
          },
          "ip_address": {
            "type": "string",
            "format": "ipv4",
            "nullable": true
          },
          "sim": {
            "$ref": "#/components/schemas/Sim"
          }
        },
        "required": [
          "id",
          "msisdn",
          "user",
          "profile",
          "status",
          "device",
          "volte",
          "delivery_date",
          "notes",
          "updating",
          "ip_address",
          "sim"
        ]
      },
      "LineMnpDiscaredError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "LineMnp": {
        "type": "object",
        "properties": {
          "operator_id": {
            "type": "integer"
          },
          "payment_type": {
            "$ref": "#/components/schemas/SimPaymentType"
          },
          "invoice_tax_code": {
            "type": "string",
            "nullable": true
          },
          "real_owner": {
            "type": "boolean",
            "nullable": true
          },
          "real_owner_tax_code_vat_number": {
            "type": "string",
            "nullable": true
          },
          "transfer_remaining_credit": {
            "type": "boolean",
            "nullable": true
          },
          "cutover_date": {
            "type": "string",
            "format": "date"
          },
          "discarded_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineMnpDiscaredError"
            }
          }
        },
        "required": [
          "operator_id",
          "payment_type",
          "invoice_tax_code",
          "real_owner",
          "real_owner_tax_code_vat_number",
