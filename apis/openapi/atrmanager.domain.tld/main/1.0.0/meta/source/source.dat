    "requestBodies": {
      "CreateOrder": {
        "description": "Un oggetto contenente le informazioni dell'ordine",
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "sim_type": {
                      "type": "string",
                      "pattern": "sim"
                    },
                    "quantity": {
                      "type": "integer"
                    },
                    "address": {
                      "type": "string"
                    },
                    "company_sign": {
                      "type": "string",
                      "nullable": true
                    },
                    "province": {
                      "type": "string"
                    },
                    "city": {
                      "type": "string"
                    },
                    "zip_code": {
                      "type": "string",
                      "pattern": "^\\d{5}(-\\d{4})?$"
                    },
                    "contact_person_name": {
                      "type": "string"
                    },
                    "contact_person_phone_number": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "sim_type",
                    "quantity",
                    "address",
                    "province",
                    "city",
                    "zip_code",
                    "contact_person_name",
                    "contact_person_phone_number"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "sim_type": {
                      "type": "string",
                      "pattern": "esim"
                    },
                    "quantity": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "sim_type",
                    "quantity"
                  ]
                }
              ]
            }
          }
        }
      },
      "UpdateOrder": {
        "description": "Un oggetto contenente le informazioni da aggiornare nell'ordine",
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "pattern": "shipped"
                    },
                    "iccid": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "action",
                    "iccid"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "action": {
                      "type": "string",
                      "pattern": "delivered"
                    }
                  },
                  "required": [
                    "action"
                  ]
                }
              ]
            }
          }
        }
      },
      "ActivateLine": {
        "description": "Un oggetto contenente le informazioni di attivazione di una linea<br><strong>NB: il campo ip_address è obbligatorio e viene preso in considerazione solo se è stato contrattualizzato l'utilizzo di IP statici</strong><br><strong>NB: usare \"action\" (dentro number)<ul><li>new: per generare un nuovo numero di telefono</li><li>mnp: per eseguire la portabilità di un numero esistente</li></ul></strong>",
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "number": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "action": {
                          "type": "string",
                          "pattern": "new"
                        },
                        "msisdn": {
                          "type": "string"
                        },
                        "ip_address": {
                          "type": "string",
                          "format": "ipv4"
                        }
                      },
                      "required": [
                        "action"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "action": {
                          "type": "string",
                          "pattern": "mnp"
                        },
                        "msisdn": {
                          "type": "string"
                        },
                        "ip_address": {
                          "type": "string",
                          "format": "ipv4"
                        },
                        "operator_id": {
                          "type": "integer"
                        },
                        "payment_type": {
                          "$ref": "#/components/schemas/SimPaymentType"
                        },
                        "invoice_tax_code": {
                          "type": "string",
                          "nullable": true
                        },
                        "real_owner": {
                          "type": "boolean",
                          "nullable": true
                        },
                        "real_owner_tax_code_vat_number": {
                          "type": "string",
                          "nullable": true
                        },
                        "transfer_remaining_credit": {
                          "type": "boolean"
                        },
                        "cutover_date": {
                          "type": "string",
                          "format": "date",
                          "nullable": true
                        }
                      },
                      "required": [
                        "action",
                        "msisdn",
                        "operator_id",
                        "payment_type",
                        "real_owner",
                        "real_owner_tax_code_vat_number",
                        "transfer_remaining_credit"
                      ]
                    }
                  ]
                }
              },
              "required": [
                "number"
              ]
            }
          }
        }
      },
      "UpdateLine": {
        "description": "Un oggetto contenente le informazioni di aggiornamento di una linea<br><strong>NB:</strong><ul><li><strong>se inviato il campo profile, il campo 'profile.id' è obbligatorio se la linea non ha ancora un profilo associato</strong></li><li><strong>se inviato il campo profile, il campo 'profile.id' verrà preso in considerazione solo se la linea non è ancora stata attivata, altrimenti verrà ignorato perché sarà possibile solo modificare i campi consumption_services e packages</strong></li><li><strong>se il campo new_profile viene inviato null, verrà cancellato e sarà ripristinato il profilo corrente</strong></li><li><strong>se il campo auto_recharge viene inviato null, verrà cancellata l'autoricarica</strong></li></ul>",
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "user": {
                  "$ref": "#/components/schemas/LineUserBody"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "delivery_date": {
                  "type": "string",
                  "format": "date-time"
                },
                "notes": {
                  "type": "string",
                  "nullable": true
                },
                "profile": {
                  "$ref": "#/components/schemas/CurrentLineProfileBody"
                },
                "new_profile": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/LineProfileBody"
                    },
                    {
                      "nullable": true
                    }
                  ]
                },
                "auto_recharge": {
                  "$ref": "#/components/schemas/LineAutoRecharge"
                }
              }
            }
          }
        }
      },
      "RechargeLine": {
        "description": "Un oggetto contenente le informazioni di ricarica di una linea",
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "amount": {
                  "type": "number",
                  "format": "float"
                }
              },
              "required": [
                "amount"
              ]
            }
          }
        }
      },
      "ReplaceLineSim": {
        "description": "Un oggetto contenente le informazioni di sostituzione della SIM di una linea",
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "new_iccid": {
                  "type": "string"
                }
              },
              "required": [
                "new_iccid"
              ]
            }
          }
        }
      }
    },
