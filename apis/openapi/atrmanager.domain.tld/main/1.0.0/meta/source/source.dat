                }
              ]
            },
            "example": {
              "code": "SERVER_ERROR",
              "meta": {
                "error": "Example error"
              }
            }
          }
        }
      },
      "Deleted": {
        "description": "La risorsa è stata eliminata correttamente"
      },
      "NoContent": {
        "description": "L'operazione è avvenuta con successo"
      }
