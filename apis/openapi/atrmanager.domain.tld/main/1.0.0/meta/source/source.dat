            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Error"
                }
              ]
            },
            "example": {
              "code": "UNAUTHENTICATED",
              "meta": null
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Errore restituito quando non si è autorizzati ad effettuare l'operazione richiesta",
        "content": {
          "application/json": {
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Error"
                }
              ]
            },
            "example": {
              "code": "UNAUTHORIZED",
              "meta": null
            }
          }
        }
      },
      "Validation": {
