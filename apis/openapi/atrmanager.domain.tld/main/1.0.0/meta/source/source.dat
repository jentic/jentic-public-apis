{
  "openapi": "3.0.1",
  "info": {
    "title": "ATR Manager API",
    "description": "Documentazione dell'API di ATR Manager<br><br><strong>Per poter utilizzare queste API è necessario autenticarsi tramite OAuth 2.0 con flusso Client Credentials</strong>",
    "version": "1.0.0",
    "contact": {
      "name": "Vianova"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/fiberwide/atr-manager-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://atrmanager.domain.tld/api/v1"
    }
  ],
  "tags": [
    {
      "name": "Cities",
      "description": "Endpoint per gestire le città"
    },
    {
      "name": "Orders",
      "description": "Endpoint per gestire gli ordini di SIM ed eSIM"
    },
    {
      "name": "SIMs",
      "description": "Endpoint per gestire SIM ed eSIM"
    },
    {
      "name": "Logs",
      "description": "Endpoint per esporre dati sui log delle operazioni"
    },
    {
      "name": "Statistics",
      "description": "Endpoint per ottenere dati sulle statistiche"
    },
    {
      "name": "Lines",
      "description": "Endpoint per gestire le linee delle SIM"
    },
    {
      "name": "Profiles",
      "description": "Endpoint per gestire i profili"
    },
    {
      "name": "Msisdns",
      "description": "Endpoint per gestire gli MSISDN"
    },
    {
      "name": "IPAddresses",
      "description": "Endpoint per gestire gli indirizzi IP"
    },
    {
      "name": "Operators",
      "description": "Endpoint per gestire gli operatori"
    },
    {
      "name": "MNP",
      "description": "Endpoint per ottenere dati riguardanti la portabilità"
    }
  ],
  "paths": {
    "/cities": {
      "get": {
        "summary": "Elenco delle città italiane",
        "description": "Questo metodo serve per recuperare l'elenco delle città italiane con le relative province e CAP",
        "tags": [
          "Cities"
        ],
        "operationId": "GetCities",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Cities"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "5XX": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      }
    },
    "/orders": {
      "get": {
        "summary": "Elenco degli ordini",
        "description": "Questo metodo serve per recuperare l'elenco degli ordini effettuati",
        "tags": [
          "Orders"
        ],
        "operationId": "GetOrders",
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentCompany"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PerPage"
          },
          {
            "$ref": "#/components/parameters/OrderFilter"
          },
          {
            "$ref": "#/components/parameters/OrderSort"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/PaginatedOrders"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "5XX": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      },
      "post": {
        "summary": "Nuovo ordine",
        "description": "Questo metodo serve per inserire un nuovo ordine",
        "tags": [
          "Orders"
        ],
        "operationId": "CreateOrder",
        "parameters": [
          {
            "$ref": "#/components/parameters/CurrentCompany"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/CreateOrder"
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Order"
          },
          "400": {
            "$ref": "#/components/responses/NoESimsAvailable"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "5XX": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      }
    },
    "/orders/{orderId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/CurrentCompany"
        },
        {
          "in": "path",
          "name": "orderId",
          "description": "L'ID dell'ordine",
          "schema": {
            "type": "string",
            "format": "uuid"
          },
          "required": true
        }
      ],
      "get": {
        "summary": "Dettaglio di un ordine",
        "description": "Questo metodo serve per recuperare il dettaglio di un ordine effettuato",
        "tags": [
          "Orders"
        ],
        "operationId": "GetOrder",
        "responses": {
          "200": {
            "$ref": "#/components/responses/OrderDetail"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "5XX": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      },
      "put": {
        "summary": "Aggiornamento di un ordine",
        "description": "Questo metodo serve per aggiornare i dati di un ordine",
        "tags": [
          "Orders"
        ],
        "operationId": "UpdateOrder",
        "requestBody": {
          "$ref": "#/components/requestBodies/UpdateOrder"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Order"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/Validation"
          },
          "5XX": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      },
      "delete": {
        "summary": "Eliminazione di un ordine",
        "description": "Questo metodo serve per eliminare un ordine (possibile solo per ordini in stato: ready_for_shipping)",
        "tags": [
          "Orders"
        ],
        "operationId": "DeleteOrder",
        "responses": {
          "204": {
            "$ref": "#/components/responses/Deleted"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "5XX": {
            "$ref": "#/components/responses/Unexpected"
          }
        }
      }
    },
