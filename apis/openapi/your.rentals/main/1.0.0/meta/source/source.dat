            "type": "string",
            "description": "Sales Channel ID (channel managers only)"
          },
          "salesBrand": {
            "type": "string",
            "description": "Sales brand, if the channel has multiple brands"
          },
          "ownReference": {
            "type": "string",
            "description": "Your custom reference for the booking"
          },
          "notes": {
            "type": "string",
            "description": "Additional custom booking information"
          },
          "ip": {
            "type": "string",
            "description": "Customer IP address"
          }
        }
