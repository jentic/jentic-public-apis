        ],
        "properties": {
          "listingId": {
            "type": "string",
            "description": "ID of the listing to create the booking for"
          },
          "from": {
            "type": "string",
            "format": "date",
            "description": "Arrival date (YYYY-MM-DD)"
          },
          "to": {
            "type": "string",
            "format": "date",
            "description": "Departure date (YYYY-MM-DD)"
          },
          "adults": {
            "type": "integer",
            "description": "Number of adults"
          },
          "children": {
            "type": "integer",
            "description": "Number of children"
          },
          "childrenAges": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "Ages of children, 0 to 12"
          },
          "guest": {
            "$ref": "#/components/schemas/Guest"
          },
          "creditCard": {
            "$ref": "#/components/schemas/CreditCard",
            "description": "Include when Your.Rentals is Merchant of Record; omit when the Sales Channel is Merchant of Record"
          },
