{
  "openapi": "3.0.3",
  "info": {
    "title": "Your.Rentals API",
    "version": "1.0.0",
    "description": "The Your.Rentals API provides access to high quality holiday rentals inventory for Holiday Rentals websites, Sales Channels and Channel Managers. It exposes listings, availability, rates, bookings, quotes and reference dictionaries. To request access, contact api@your.rentals. All prices are returned in EUR.",
    "x-jentic-source-url": "https://docs.your.rentals/"
  },
  "servers": [
    {
      "url": "https://{apiDomain}",
      "description": "Your.Rentals API. Use api.your.rentals for production and api-dev.your.rentals for the test environment.",
      "variables": {
        "apiDomain": {
          "default": "api.your.rentals",
          "enum": [
            "api.your.rentals",
            "api-dev.your.rentals"
          ],
          "description": "API host. Production: api.your.rentals. Test: api-dev.your.rentals. Each environment requires its own access token."
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Listings",
      "description": "Retrieve listing inventory and manage sales-channel references"
    },
    {
      "name": "Availability",
      "description": "Query property availability calendars"
    },
    {
      "name": "Rates",
      "description": "Query nightly rates and rate rules"
    },
    {
      "name": "Bookings",
      "description": "Create, pay, cancel and retrieve bookings, and generate live quotes"
    },
    {
      "name": "Dictionaries",
      "description": "Predefined enum values used across listing data models"
    }
  ],
  "paths": {
    "/v1/listings/{pageNumber}": {
      "get": {
        "operationId": "getAllListings",
        "summary": "Get all listings",
        "description": "Returns all data for all listings with pagination. Listings are sorted by id. There are 200 listings per page. GET /v1/listings/0 returns the total number of listings. The Link response header contains the URL of the next page. All prices are in EUR.",
        "tags": [
          "Listings"
        ],
        "parameters": [
          {
            "name": "pageNumber",
            "in": "path",
            "required": true,
            "description": "Page number. Use 0 for the first page (default). Requesting /v1/listings/0 returns the total number of listings.",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of listings",
            "headers": {
              "Link": {
                "description": "Link to the next page. Example <https://api.your.rentals/v1/listings/2>; rel=\"next\"",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Listing"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/listings/delta/{timestamp}/{pageNumber}": {
      "get": {
        "operationId": "getListingsByTimestamp",
        "summary": "Get listings by timestamp",
        "description": "Returns a paginated list of listing updates since the specified Unix timestamp. One listing has one entry in the delta response. Returns an empty array if nothing changed. The Link response header contains the URL of the next page.",
        "tags": [
          "Listings"
        ],
        "parameters": [
          {
            "name": "timestamp",
            "in": "path",
            "required": true,
            "description": "Unix timestamp. All changes since this date will be returned.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageNumber",
            "in": "path",
            "required": true,
            "description": "Page number. Use 0 for the first page (default).",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of changed listings (empty array if none changed)",
            "headers": {
              "Link": {
                "description": "Link to the next page. Example <https://api.your.rentals/v1/listings/delta/{timestamp}/2>; rel=\"next\"",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Listing"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/listing/{listingId}": {
      "get": {
        "operationId": "getListingDetail",
        "summary": "Get listing detail",
        "description": "Returns the listing detail for the provided id.",
        "tags": [
          "Listings"
        ],
        "parameters": [
          {
            "name": "listingId",
            "in": "path",
            "required": true,
            "description": "id of the listing to get detail for",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array containing the listing detail",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Listing"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/listing/{listingId}/reference": {
      "patch": {
        "operationId": "updateListingReference",
        "summary": "Update listing reference",
        "description": "Saves the consumer's listing reference after import.",
        "tags": [
          "Listings"
        ],
        "parameters": [
          {
            "name": "listingId",
            "in": "path",
            "required": true,
            "description": "Your.Rentals listingId",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListingReferenceUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reference saved successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/listing/references": {
      "patch": {
        "operationId": "updateListingsReferences",
        "summary": "Update listings references",
        "description": "Saves multiple consumer listing references at the same time.",
        "tags": [
          "Listings"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ListingReferencesBatchUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "References saved successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/availability/{pageNumber}": {
      "get": {
        "operationId": "getFullAvailability",
        "summary": "Get full availability",
        "description": "Returns availability for all properties from today and two years ahead, with pagination. The Link response header contains the URL of the next page.",
        "tags": [
          "Availability"
        ],
        "parameters": [
          {
            "name": "pageNumber",
            "in": "path",
            "required": true,
            "description": "Page number. Use 0 for the first page (default).",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of availability objects",
            "headers": {
              "Link": {
                "description": "Link to the next page. Example <https://api.your.rentals/v1/availability/2>; rel=\"next\"",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ListingAvailability"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/availability/delta/{timestamp}/{pageNumber}": {
      "get": {
        "operationId": "getAvailabilityByTimestamp",
        "summary": "Get availability by timestamp",
        "description": "Returns availability updates since the specified Unix timestamp, with pagination via the Link response header.",
        "tags": [
          "Availability"
        ],
        "parameters": [
          {
            "name": "timestamp",
            "in": "path",
            "required": true,
            "description": "Unix timestamp. All changes since this date will be returned.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageNumber",
            "in": "path",
            "required": true,
            "description": "Page number. Use 0 for the first page (default).",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of changed availability objects",
            "headers": {
              "Link": {
                "description": "Link to the next page. Example <https://api.your.rentals/v1/availability/delta/{timestamp}/2>; rel=\"next\"",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ListingAvailability"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/availability/listing/{listingId}": {
      "get": {
        "operationId": "getAvailabilityForListing",
        "summary": "Get availability for listing",
        "description": "Returns the availability of a specific listing.",
        "tags": [
          "Availability"
        ],
        "parameters": [
          {
            "name": "listingId",
            "in": "path",
            "required": true,
            "description": "Your.Rentals listingId",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Availability wrapper object",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "list": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ListingAvailability"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/availability/listings/{fromDate}/{toDate}": {
      "get": {
        "operationId": "getAvailableListingsInPeriod",
        "summary": "Get available listings in a period",
        "description": "Returns available listings of the caller (PM or collaborator) in a given period.",
        "tags": [
          "Availability"
        ],
        "parameters": [
          {
            "name": "fromDate",
            "in": "path",
            "required": true,
            "description": "Start date of the period to look for available listings (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "toDate",
            "in": "path",
            "required": true,
            "description": "End date of the period to look for available listings (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of available listings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Listing"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/rates/{pageNumber}": {
      "get": {
        "operationId": "getRates",
        "summary": "Get rates",
        "description": "Returns rates and rate rules for one year upfront. Rates are sorted by listing id. There are 200 rates per page. All prices are in EUR. The Link response header contains the URL of the next page.",
        "tags": [
          "Rates"
        ],
        "parameters": [
          {
            "name": "pageNumber",
            "in": "path",
            "required": true,
            "description": "Page number. Use 0 for the first page (default).",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of rates",
            "headers": {
              "Link": {
                "description": "Link to the next page. Example <https://api.your.rentals/v1/rates/2>; rel=\"next\"",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Rate"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/rates/delta/{timestamp}/{pageNumber}": {
      "get": {
        "operationId": "getRatesByTimestamp",
        "summary": "Get rates by timestamp",
        "description": "Returns a paginated list of rate updates since the specified Unix timestamp. One rate has one entry in the delta response. Returns an empty array if nothing changed. The Link response header contains the URL of the next page.",
        "tags": [
          "Rates"
        ],
        "parameters": [
          {
            "name": "timestamp",
            "in": "path",
            "required": true,
            "description": "Unix timestamp. All changes since this date will be returned.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageNumber",
            "in": "path",
            "required": true,
            "description": "Page number. Use 0 for the first page (default).",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of changed rates (empty array if none changed)",
            "headers": {
              "Link": {
                "description": "Link to the next page. Example <https://api.your.rentals/v1/rates/delta/1543302590/2>; rel=\"next\"",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Rate"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/rates/listing/{listingId}": {
      "get": {
        "operationId": "getListingRate",
        "summary": "Get listing rate",
        "description": "Returns rate information for a specific listing.",
        "tags": [
          "Rates"
        ],
        "parameters": [
          {
            "name": "listingId",
            "in": "path",
            "required": true,
            "description": "id of the listing to get detail for",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of rates for the listing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Rate"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/booking": {
      "post": {
        "operationId": "createBooking",
        "summary": "Create booking",
        "description": "Creates a booking. Supports two merchant models: (1) Your.Rentals as Merchant of Record - include a creditCard object; if omitted or payment fails the booking is created in pendingPayment state and a paymentUrl is returned, valid until expiresAt. (2) Sales Channel as Merchant of Record - omit creditCard; only Sales Channels approved to act as Merchant of Record can use this. All prices are in EUR.",
        "tags": [
          "Bookings"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateBookingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/booking/{bookingId}/pay": {
      "post": {
        "operationId": "payBooking",
        "summary": "Pay booking",
        "description": "Sends a new credit card (a new payment) for a booking if a previous payment failed.",
        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "required": true,
            "description": "Your.Rentals bookingId",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "creditCard"
                ],
                "properties": {
                  "creditCard": {
                    "$ref": "#/components/schemas/CreditCard"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "bookingId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "paymentStatus": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/booking/{cancelledBy}/cancel": {
      "post": {
        "operationId": "cancelBooking",
        "summary": "Cancel booking",
        "description": "Allows a Sales Channel or Channel Manager to cancel a booking (requested by either Guest or Property Manager). If cancellation fails, an error message is returned, e.g. { \"message\": \"Booking state is not valid for this request\" }.",
        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
            "name": "cancelledBy",
            "in": "path",
            "required": true,
            "description": "Actor for the booking cancellation.",
            "schema": {
              "type": "string",
              "enum": [
                "guest",
                "pm"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelBookingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelBookingResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/booking/{bookingId}/{salesChannelId}": {
      "get": {
        "operationId": "getBookingDetails",
        "summary": "Get booking details",
        "description": "Retrieves booking details, which may be used to communicate to the guest via emails or vouchers.",
        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
            "name": "bookingId",
            "in": "path",
            "required": true,
            "description": "Your.Rentals booking id",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "salesChannelId",
            "in": "path",
            "required": true,
            "description": "Sales Channel ID (4 characters)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingDetails"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/quote": {
      "post": {
        "operationId": "getQuote",
        "summary": "Get quote",
        "description": "Live request that returns the exact final price and availability status for a property. If there is a discount, it is already included in rentalRate. Cleaning is NOT included in rentalRate; total = rentalRate + cleaning only if cleaningFeeBasis is mandatory. localTax and other taxes are always mandatory, paid upon check-in, and must not be added to the total. All prices are in EUR.",
        "tags": [
          "Bookings"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote result. Returns pricing when available, or an availability object with reasons when not available.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/QuoteResponse"
                    },
                    {
                      "$ref": "#/components/schemas/QuoteUnavailableResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/dictionary": {
      "get": {
        "operationId": "getDictionaries",
        "summary": "Get dictionaries data",
        "description": "Returns a JSON object containing predefined values used in the listing data models (countries, languages, listing enums, rooms, photos, optional extras, facilities and taxes).",
        "tags": [
          "Dictionaries"
        ],
        "responses": {
          "200": {
            "description": "Dictionary object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dictionary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer access token provided by Your.Rentals. Each environment (production and test) requires its own token. Contact api@your.rentals to obtain credentials."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - missing or invalid access token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          }
        }
      },
      "ListingDescription": {
        "type": "object",
        "description": "Listing description in a given language",
        "required": [
          "headline",
          "summary",
          "description",
          "autoTranslated"
        ],
        "properties": {
          "headline": {
            "type": "string",
            "description": "Listing headline"
          },
          "summary": {
            "type": "string",
            "description": "Listing summary"
          },
          "description": {
            "type": "string",
            "description": "Listing description"
          },
          "autoTranslated": {
            "type": "boolean",
            "description": "Whether the description was auto translated or entered by the owner"
          }
        }
      },
      "AdditionalGuests": {
        "type": "object",
        "description": "Additional guest information",
        "properties": {
          "amount": {
            "type": "integer",
            "description": "Maximum number of extra guests who can stay in the listing"
          },
          "price": {
            "type": "number",
            "description": "Nightly rate per extra guest"
          }
        }
      },
      "PMDetail": {
        "type": "object",
        "description": "Contact details for the Property Manager. You need to be approved to receive this data.",
        "required": [
          "firstName"
        ],
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "Two-letter ISO country code, e.g. VN, SG"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postalCode": {
            "type": "string"
          }
        }
      },
      "Location": {
        "type": "object",
        "description": "Listing location information",
        "required": [
          "rentalLicenseNumber",
          "city",
          "region",
          "zip",
          "country",
          "latitude",
          "longitude",
          "countryISO"
        ],
        "properties": {
          "rentalLicenseNumber": {
            "type": "string",
            "description": "Registration number required by law in some regions"
          },
          "address": {
            "type": "string"
          },
          "addressDetails": {
            "type": "string",
            "description": "Details about the address (apartment number etc.)"
          },
          "city": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "zip": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "countryISO": {
            "type": "string",
            "description": "Two-letter ISO country code"
          },
          "placeId": {
            "type": "string",
            "description": "Google place id (present in booking property address)"
          },
          "number": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "en": {
            "type": "object",
            "description": "Localised (English) address fields",
            "properties": {
              "country": {
                "type": "string"
              },
              "number": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "street": {
                "type": "string"
              }
            }
          }
        }
      },
      "ListingImage": {
        "type": "object",
        "description": "Listing image",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Listing image HTTP url"
          },
          "labels": {
            "type": "array",
            "description": "Pre-defined labels defining the image (outdoor or indoor label values).",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Facilities": {
        "type": "object",
        "description": "Listing facilities",
        "properties": {
          "kitchen": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Kitchen facilities. Possible values: Coffee machine, Dish-washer, Electric kettle, Electric oven, Electric stove / cooktop, Freezer, Fridge, Gas oven, Gas stove / cooktop, Kitchenware, Microwave, Toaster, Wood fired oven"
          },
          "livingDining": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Living / dining facilities. Possible values: Armchair, CD-player, Children highchair, Computer, Dining chairs, Dining table, DVD player, Games console, Laptop, Radio, Satellite / Cable TV, Seating area, Sofa, Stereo system, Telephone, TV, Video games"
          },
          "outdoor": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Outdoor facilities. Possible values: Balcony, BBQ / Grill, Bicycles, Boat, Children's play equipment, Fishing, Garden, Outdoor furniture, Patio, Sunbed, Tennis court, Terrace"
          },
          "miscellaneous": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Miscellaneous facilities (e.g. Hair dryer, Iron & ironing board, Elevator in building, View - city, etc.)"
          },
          "guestSafety": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Guest safety equipment (e.g. Smoke detector, First aid kit, Fire extinguisher, etc.)"
          },
          "airConditioning": {
            "type": "string",
            "enum": [
              "Central air-conditioning",
              "No air-conditioning",
              "Partial air-conditioning"
            ]
          },
          "heating": {
            "type": "string",
            "enum": [
              "Central heating",
              "Electric heating",
              "Gas heating",
              "No heating",
              "Stove or fireplace"
            ]
          },
          "internet": {
            "type": "string",
            "enum": [
              "No internet",
              "Wired internet",
              "Wireless internet (WIFI)"
            ]
          },
          "parking": {
            "type": "string",
            "enum": [
              "Covered parking on site",
              "No parking",
              "Parking lot/garage (free)",
              "Parking lot/garage (paid)",
              "Parking on street (free)",
              "Parking on street (paid)",
              "Uncovered parking on site"
            ]
          },
          "swimmingPool": {
            "type": "string",
            "enum": [
              "No swimming pool",
              "Private indoor pool",
              "Private outdoor pool",
              "Shared indoor pool",
              "Shared outdoor pool"
            ]
          },
          "washingMachine": {
            "type": "string",
            "enum": [
              "No washing machine",
              "Shared washing machine",
              "Washing machine"
            ]
          }
        }
      },
      "BedDetail": {
        "type": "object",
        "description": "Bed detail",
        "properties": {
          "name": {
            "type": "string",
            "description": "Bed type",
            "enum": [
              "Bunk-bed",
              "Double bed",
              "King-sized bed",
              "Queen-sized bed",
              "Single bed (adult)",
              "Single bed (child)",
              "Sofa-bed (double)",
              "Sofa-bed (single)"
            ]
          },
          "number": {
            "type": "integer",
            "description": "Number of beds"
          }
        }
      },
      "Bedroom": {
        "type": "object",
        "description": "Bedroom detail",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the bedroom"
          },
          "beds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BedDetail"
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "Bedroom",
              "Living room",
              "Other room"
            ]
          }
        }
      },
      "Bathroom": {
        "type": "object",
        "description": "Bathroom detail",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the bathroom"
          },
          "shower": {
            "type": "string",
            "enum": [
              "Shower over bath",
              "Separate shower",
              "No shower"
            ]
          },
          "toilet": {
            "type": "string",
            "enum": [
              "No toilet",
              "Toilet"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "En-suite bathroom",
              "Full bathroom",
              "WC"
            ]
          },
          "bath": {
            "type": "string",
            "enum": [
              "Standard bath",
              "No bath",
              "Jacuzzi",
              "Whirlpool"
            ]
          }
        }
      },
      "Kitchen": {
        "type": "object",
        "description": "Kitchen detail",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Kitchenette",
              "Open plan kitchen",
              "Outdoor kitchen",
              "Separate kitchen"
            ]
          }
        }
      },
      "Rooms": {
        "type": "object",
        "description": "Listing rooms",
        "properties": {
          "bedrooms": {
            "type": "object",
            "properties": {
              "numbers": {
                "type": "integer",
                "description": "Number of bedrooms"
              },
              "rooms": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Bedroom"
                }
              }
            }
          },
          "bathrooms": {
            "type": "object",
            "properties": {
              "numbers": {
                "type": "integer",
                "description": "Number of bathrooms"
              },
              "rooms": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Bathroom"
                }
              }
            }
          },
          "kitchens": {
            "type": "object",
            "properties": {
              "numbers": {
                "type": "integer",
                "description": "Number of kitchens"
              },
              "rooms": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Kitchen"
                }
              }
            }
          },
          "others": {
            "type": "array",
            "description": "Other rooms. Possible values: Common area, Dining room, Drying room, Eating area, Fitness room, Games room, Hall, Laundry, Library, Living room, Lounge, Office, Pantry, Rumpus room, Sauna, Studio, Study, TV room, Work studio",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Suitability": {
        "type": "object",
        "description": "Listing suitability policies",
        "required": [
          "wheelchair",
          "eventsOrParties",
          "children",
          "smoking"
        ],
        "properties": {
          "pets": {
            "type": "string",
            "enum": [
              "No pets allowed",
              "Pets allowed",
              "Pets considered"
            ]
          },
          "wheelchair": {
            "type": "string",
            "enum": [
              "Full access for wheelchairs",
              "No access for wheelchairs",
              "Some access for wheelchairs"
            ]
          },
          "eventsOrParties": {
            "type": "string",
            "enum": [
              "Allowed",
              "Not allowed"
            ]
          },
          "children": {
            "type": "string",
            "enum": [
              "Children welcome",
              "Great for children",
              "Not suitable for children"
            ]
          },
          "smoking": {
            "type": "string",
            "enum": [
              "No smoking",
              "Smoking allowed",
              "Smoking outside"
            ]
          },
          "petsCount": {
            "type": "integer",
            "description": "How many pets can stay in the listing"
          },
          "petFee": {
            "type": "number",
            "description": "Fee for bringing a pet"
          },
          "petFeeBasis": {
            "type": "string",
            "enum": [
              "Per day",
              "Per week",
              "Per stay",
              "Per pet / day",
              "Per pet / stay",
              "Per pet / week"
            ]
          }
        }
      },
      "CancellationPolicy": {
        "type": "object",
        "description": "Cancellation policy",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Policy type",
            "enum": [
              "Flexible",
              "Moderate",
              "Strict",
              "SuperStrict"
            ]
          },
          "textList": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Policy text"
                },
                "value": {
                  "type": "string",
                  "description": "Policy text value"
                }
              }
            }
          }
        }
      },
      "ListingExtra": {
        "type": "object",
        "description": "Extra fee or service on the listing",
        "properties": {
          "name": {
            "type": "string",
            "description": "Extra type",
            "enum": [
              "Airport shuttle",
              "Baby cot",
              "Barbecue",
              "Bed linen",
              "Bike rental",
              "Boat berth",
              "Car rental",
              "High chair",
              "Internet",
              "Kitchen linen",
              "Laundry service",
              "Linen package (bed linen + towel)",
              "Pet",
              "Sunbed",
              "Towel",
              "Transfer",
              "Umbrella"
            ]
          },
          "feeBasis": {
            "type": "string",
            "description": "Extra fee basis",
            "enum": [
              "Per day",
              "Per night",
              "Per person",
              "Per person / night",
              "Per person / stay",
              "Per person / week",
              "Per pet / day",
              "Per pet / stay",
              "Per pet / week",
              "Per stay",
              "Per unit",
              "Per week"
            ]
          },
          "fee": {
            "type": "number",
            "description": "Extra price in the listing's currency"
          }
        }
      },
      "Tax": {
        "type": "object",
        "description": "Tax applied to the property",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the tax. Possible values: Destination fee, Tourism fee, Tax, Local tax, Goods and services tax, Government tax, City tax, VAT (Value Added Tax), Resort fee"
          },
          "feeBasis": {
            "type": "string",
            "description": "Tax basis. Possible values: % of Rental Amount, Per adult / day, Per adult / stay, Per adult / week, Per day, Per person / day, Per person / stay, Per person / week, Per stay, Per week"
          },
          "fee": {
            "type": "number",
            "description": "Tax amount (EUR if a fixed amount)"
          }
        }
      },
      "Cleaning": {
        "type": "object",
        "description": "Cleaning fee information",
        "properties": {
          "feeBasis": {
            "type": "string",
            "enum": [
              "included",
              "mandatory",
              "optional"
            ],
            "description": "Whether a guest needs to pay for cleaning"
          },
          "fee": {
            "type": "number",
            "description": "Cleaning price in the listing's currency"
          }
        }
      },
      "SCReference": {
        "type": "object",
        "description": "Sales channel reference",
        "properties": {
          "scId": {
            "type": "string",
            "description": "Sales channel id (sales channel code)"
          },
          "scAccountReference": {
            "type": "string"
          },
          "scListingReference": {
            "type": "string",
            "description": "Property reference number on the sales channel side"
          },
          "scListingUrl": {
            "type": "string",
            "description": "URL of the listing on the sales channel's website"
          }
        }
      },
      "ListingInstructions": {
        "type": "object",
        "description": "Property check-in/check-out instructions",
        "properties": {
          "checkIn": {
            "type": "string",
            "description": "Check-in time (HH:mm)"
          },
          "checkOut": {
            "type": "string",
            "description": "Check-out time (HH:mm)"
          },
          "checkinContact": {
            "type": "string",
            "description": "Name of the contact person for check-in/out"
          },
          "collectionPoint": {
            "type": "string",
            "description": "Where to collect the key"
          },
          "checkinInstructions": {
            "type": "string",
            "description": "Detailed check-in instructions"
          },
          "phone": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Phone country code"
              },
              "number": {
                "type": "string",
                "description": "Phone number"
              },
              "country": {
                "type": "string",
                "description": "Two-letter ISO country code"
              }
            }
          },
          "collectionLocation": {
            "type": "object",
            "description": "Key collection location (if not at the property)",
            "properties": {
              "country": {
                "type": "string"
              },
              "countryISO": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "latitude": {
                "type": "string"
              },
              "longitude": {
                "type": "string"
              }
            }
          },
          "closestAirportsList": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "iata": {
                  "type": "string"
                },
                "distance": {
                  "type": "integer",
                  "description": "Distance in metres"
                },
                "city": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Listing": {
        "type": "object",
        "description": "A holiday rental listing",
        "required": [
          "id",
          "active",
          "lastModified",
          "created",
          "rentalType",
          "rentalBasis",
          "entrance",
          "floorspace",
          "maxGuest",
          "location",
          "images",
          "description",
          "rooms",
          "suitability",
          "bookingType",
          "cancellationPolicy",
          "advanceNotice"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Listing id"
          },
          "active": {
            "type": "boolean",
            "description": "Whether the listing is published"
          },
          "referenceNumber": {
            "type": "string",
            "description": "Listing name"
          },
          "rentalType": {
            "type": "string",
            "enum": [
              "Apartment",
              "B&B",
              "Boat",
              "Bungalow",
              "Cabin",
              "Castle",
              "Chalet",
              "Condo",
              "Farmhouse",
              "Guest room",
              "Holiday house",
              "Holiday park",
              "House",
              "Lodge",
              "Mobile home",
              "Villa"
            ]
          },
          "rentalBasis": {
            "type": "string",
            "enum": [
              "Room with own facilities",
              "Room with shared facilities",
              "Entire house or apartment"
            ]
          },
          "entrance": {
            "type": "string",
            "enum": [
              "Private",
              "Common - without security",
              "Common - with security"
            ]
          },
          "bookingType": {
            "type": "string",
            "enum": [
              "instant",
              "onRequest"
            ],
            "description": "Whether a booking is confirmed instantly or within 24 hours"
          },
          "maxGuest": {
            "type": "integer",
            "description": "Maximum number of guests"
          },
          "additionalGuests": {
            "$ref": "#/components/schemas/AdditionalGuests"
          },
          "pmDetails": {
            "$ref": "#/components/schemas/PMDetail"
          },
          "description": {
            "type": "object",
            "description": "Listing descriptions keyed by two-letter language code",
            "additionalProperties": {
              "$ref": "#/components/schemas/ListingDescription"
            }
          },
          "facilities": {
            "$ref": "#/components/schemas/Facilities"
          },
          "rooms": {
            "$ref": "#/components/schemas/Rooms"
          },
          "suitability": {
            "$ref": "#/components/schemas/Suitability"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListingImage"
            }
          },
          "floorsBuilding": {
            "type": "integer",
            "description": "Number of floors in the building"
          },
          "floorsProperty": {
            "type": "integer",
            "description": "Floor the listing is on"
          },
          "floorspace": {
            "type": "number",
            "description": "Floorspace in square metres"
          },
          "grounds": {
            "type": "number",
            "description": "Total ground area in square metres"
          },
          "specialRates": {
            "type": "object",
            "properties": {
              "earlyBirdRule": {
                "type": "object",
                "properties": {
                  "discount": {
                    "type": "number"
                  },
                  "checkIn": {
                    "type": "integer"
                  }
                }
              },
              "lastMinuteRule": {
                "type": "object",
                "properties": {
                  "discount": {
                    "type": "number"
                  },
                  "checkIn": {
                    "type": "integer"
                  }
                }
              },
              "seasonPriceRules": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "ratesSameAllYearRound": {
                "type": "boolean"
              }
            }
          },
          "basicRates": {
            "type": "object",
            "properties": {
              "maximumStay": {
                "type": "integer"
              },
              "minimumStay": {
                "type": "integer"
              },
              "checkInDays": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "checkOutDays": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "maximumGuests": {
                "type": "integer"
              },
              "weekendNight": {
                "type": "number"
              },
              "basicNight": {
                "type": "number"
              }
            }
          },
          "created": {
            "type": "integer",
            "description": "Unix timestamp of listing creation"
          },
          "lastModified": {
            "type": "integer",
            "description": "Unix timestamp of last modification"
          },
          "status": {
            "type": "string",
            "description": "Listing status, e.g. listed"
          },
          "cancellationPolicy": {
            "$ref": "#/components/schemas/CancellationPolicy"
          },
          "advanceNotice": {
            "type": "integer",
            "description": "Minimum number of days prior to check-in when booking is possible"
          },
          "houseRules": {
            "type": "string"
          },
          "instructions": {
            "$ref": "#/components/schemas/ListingInstructions"
          },
          "cleaning": {
            "$ref": "#/components/schemas/Cleaning"
          },
          "securityDeposit": {
            "type": "number",
            "description": "Amount the guest is liable for in case of damages (EUR)"
          },
          "extras": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListingExtra"
            }
          },
          "extrasAndServices": {
            "type": "object",
            "properties": {
              "cleaning": {
                "$ref": "#/components/schemas/Cleaning"
              },
              "securityDeposit": {
                "type": "number"
              },
              "extras": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ListingExtra"
                }
              },
              "taxes": {
