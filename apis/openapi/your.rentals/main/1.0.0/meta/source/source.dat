      "AvailabilityDay": {
        "type": "object",
        "description": "Availability for a single day",
        "required": [
          "available",
          "checkInDay",
          "checkOutDay",
          "minStay",
          "maxStay"
        ],
        "properties": {
          "available": {
            "type": "boolean",
            "description": "Whether the listing is available to book that day"
          },
          "checkInDay": {
            "type": "boolean",
            "description": "Whether a guest can arrive that day"
          },
          "checkOutDay": {
            "type": "boolean",
            "description": "Whether a guest can depart that day"
          },
          "minStay": {
            "type": "integer",
            "description": "Minimum nights if checking in that day"
          },
          "maxStay": {
            "type": "integer",
            "description": "Maximum nights if checking in that day"
          }
        }
      },
      "ListingAvailability": {
        "type": "object",
        "description": "Availability calendar for a listing",
        "required": [
          "listingId",
          "availability"
        ],
        "properties": {
          "listingId": {
            "type": "integer",
            "description": "Listing id"
          },
          "availability": {
            "type": "object",
            "description": "Map of date (YYYY-MM-DD) to that day's availability",
            "additionalProperties": {
              "$ref": "#/components/schemas/AvailabilityDay"
            }
          }
        }
      },
      "Rate": {
        "type": "object",
        "description": "Rates and rate rules for a listing (one year upfront). Prices in EUR.",
        "required": [
          "listingId",
          "rate"
        ],
        "properties": {
          "listingId": {
            "type": "integer",
            "description": "Listing id"
          },
          "rate": {
            "type": "object",
            "description": "Map of date (YYYY-MM-DD) to nightly price",
            "additionalProperties": {
              "type": "number"
            }
          },
          "longerStay": {
            "type": "object",
            "description": "Discount percentage keyed by minimum number of days",
            "additionalProperties": {
              "type": "number"
            }
          },
          "longerStayExclusionPeriods": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startDate": {
                  "type": "string",
                  "format": "date"
                },
                "endDate": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          },
          "lastMinute": {
            "type": "object",
            "description": "Discount percentage keyed by number of days before check-in",
            "additionalProperties": {
              "type": "number"
            }
          },
          "earlyBird": {
            "type": "object",
            "description": "Discount percentage keyed by number of days before check-in",
            "additionalProperties": {
              "type": "number"
            }
          },
          "additionalGuests": {
            "$ref": "#/components/schemas/AdditionalGuests"
          },
          "cleaning": {
            "$ref": "#/components/schemas/Cleaning"
          },
          "securityDeposit": {
            "type": "number",
