          },
          "extras": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListingExtra"
            }
          },
          "localTax": {
            "$ref": "#/components/schemas/Tax"
          },
          "taxes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tax"
            }
          }
        }
