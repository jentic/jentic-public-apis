  "components": {
    "schemas": {
      "Error": {
        "required": [
          "code",
          "status",
          "title"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Error HTTP status code",
            "example": "400"
          },
          "code": {
            "type": "string",
            "description": "Error code",
            "example": "API-008"
          },
          "title": {
            "type": "string",
            "description": "Error short description",
            "example": "Validation Error"
          },
          "details": {
            "type": "string",
            "description": "Error details",
            "example": "A field is invalid"
          },
          "source": {
            "$ref": "#/components/schemas/ErrorSource"
          },
          "links": {
            "$ref": "#/components/schemas/ErrorLink"
          }
        }
      },
      "ErrorLink": {
        "required": [
          "about"
        ],
        "type": "object",
        "properties": {
          "about": {
            "type": "string",
            "description": "A link to more information about the error",
            "readOnly": true,
            "example": "http://go/customerapiserrors#API-008"
          }
        },
        "description": "A link to more information about this error"
      },
      "ErrorSource": {
        "type": "object",
        "properties": {
          "parameter": {
            "type": "string",
            "description": "Indicates which URI query parameter caused the error",
            "example": "customerId"
          },
          "pointer": {
            "type": "string",
            "description": "A JSON Pointer [RFC6901] to the associated entity in the request document",
            "example": "/data/attributes/contract/detail"
          }
        },
        "description": "The source of the error"
      },
      "Errors": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Audit": {
        "type": "object",
        "properties": {
          "lastModifiedBy": {
            "type": "string",
            "description": "Contract Update User",
            "example": "u123456"
          }
        },
        "description": "Contract audit information"
      },
      "ComponentAttributes": {
        "required": [
          "issueDate",
          "roles"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Contract Component Id - internal identifier",
            "format": "int64",
            "readOnly": true,
            "example": 12345
          },
          "statusType": {
            "type": "string",
            "description": "Contract Component Status Type, for example ACTIVE, INACTIVE. By default status is set to N/A",
            "example": "N/A"
          },
          "productType": {
            "type": "string",
            "description": "Product Type - type of product associated with the contract, for example:\nHLTH : Health Insurance\nMPA - Car (Insurance)\nSPLATE : Service (Suncorp Service)\nDDA : A7 Everyday Options (Banking)\nCDA : TS Term Deposit (Banking)\n",
            "example": "HLTH"
          },
          "issueDate": {
            "type": "string",
            "description": "Issue Date - a date when this component was issued. Date format used is 'yyyy-mm-dd'",
            "format": "date",
            "example": "2015-02-08"
          },
          "expiryDate": {
            "type": "string",
            "description": "Expiry Date - date when this component becomes inactive. Date format used is using format 'yyyy-mm-dd'",
            "format": "date",
            "example": "2017-10-08"
          },
          "componentType": {
            "type": "string",
            "description": "Contract Component Type - code representing type of coverage for the product, for example:\nC-5 : APIA Essential Hospital\nSA5 : SUNCORP Basic Hospital",
            "example": "C-5"
          },
          "componentValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "Contract Component Values - contains any additional values relevant to the contract component\nExample:\nLifetime Health Cover Age = 30\n;Loading = 0%\n;Skip Days Permitted = NIL\n;Mobility Bonus = false\n\nJSON Example:\ncomponentValues: [\n\t{\t\t\"Life Time Health Cover Age\":\"30\"\n,\t\t\"Loading\":\"0%\"\n,\t\t\"Skip Days Permitted\":\"NIL\"\n,\t\t\"Mobility Bonus\":\"false\"\n\t}]\n"
            },
            "description": "Contract Component Values - contains any additional values relevant to the contract component\nExample:\nLifetime Health Cover Age = 30\n;Loading = 0%\n;Skip Days Permitted = NIL\n;Mobility Bonus = false\n\nJSON Example:\ncomponentValues: [\n\t{\t\t\"Life Time Health Cover Age\":\"30\"\n,\t\t\"Loading\":\"0%\"\n,\t\t\"Skip Days Permitted\":\"NIL\"\n,\t\t\"Mobility Bonus\":\"false\"\n\t}]\n"
          },
          "roles": {
            "type": "array",
            "description": "Contract Roles",
            "items": {
              "$ref": "#/components/schemas/RoleAttributes"
            }
          }
        },
        "description": "Contract Components"
      },
      "Contract": {
        "required": [
          "data"
        ],
        "type": "object",
        "properties": {
          "included": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductDefinition"
            }
          },
          "data": {
            "$ref": "#/components/schemas/ContractData"
          }
        }
      },
      "ContractAttributes": {
        "required": [
          "brand",
          "components",
          "contractValues",
          "executedDate",
          "nativeKeys",
          "referenceId",
          "roles",
          "source",
          "type"
        ],
        "type": "object",
        "properties": {
          "brand": {
            "type": "string",
            "description": "Brand - contract brand",
            "example": "AAMI"
          },
          "source": {
            "type": "string",
            "description": "Source - originating source of a Contract, for example NIB or Smart Plates",
            "example": "NIB"
          },
          "referenceId": {
            "type": "string",
            "description": "Reference Identifier - text or number that is used in the source system to identify a contract",
            "example": "1234H"
          },
          "type": {
            "type": "string",
            "description": "Type - type of contract, for example: SERVICE or HLTH",
            "example": "HLTH"
          },
          "executedDate": {
            "type": "string",
            "description": "Executed Date, using format 'yyyy-mm-dd'",
            "format": "date",
            "example": "2015-02-08"
          },
          "components": {
            "type": "array",
            "description": "Contract Components",
            "items": {
              "$ref": "#/components/schemas/ComponentAttributes"
            }
          },
          "roles": {
            "type": "array",
            "description": "Contract Roles",
            "items": {
              "$ref": "#/components/schemas/RoleAttributes"
            }
          },
          "nativeKeys": {
            "type": "array",
            "description": "Native Keys",
            "writeOnly": true,
            "items": {
              "$ref": "#/components/schemas/NativeKey"
            }
          },
          "contractValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "Contract Values"
            },
            "description": "Contract Values"
          },
          "systemCode": {
            "type": "string",
            "description": "Contract System Code - Identifies the administrative source system for a contract, for example: NIB, SMARTPLATES",
            "example": "NIB"
          },
          "agreementStatusTypeCode": {
            "type": "string",
            "description": "Agreement Status Type Code",
            "example": "A"
          },
          "agreementTypeCode": {
            "type": "string",
            "description": "Agreement Type Code",
            "example": "agreementTypeCode"
          },
          "issueLocation": {
            "type": "string",
            "description": "Issue Location - location where the contract was issued",
            "example": "Australia"
          },
          "businessOrganizationUnitId": {
            "type": "string",
            "description": "Business Organisation Unit Id",
            "example": "NIB"
          },
          "nextBillDate": {
            "type": "string",
            "description": "Next Bill Date, using format 'yyyy-mm-dd'",
            "format": "date",
            "example": "2017-02-08"
          },
          "replacesContract": {
            "type": "integer",
            "description": "Replaces Contract - identifies a contract in the system replacing this contract",
            "format": "int64",
            "example": 28343623
          },
          "replacedByContract": {
            "type": "integer",
            "description": "Replaced By Contract - identifies a contract in the system that is replaced by this contract",
            "format": "int64",
            "example": 97878623
          },
          "billTypeCode": {
            "type": "string",
            "description": "Billing Type Code, for example Regular, Direct, etc",
            "example": "Direct"
          },
          "paymentFrequency": {
            "type": "string",
            "description": "Payment Frequency",
            "example": "WEEKLY",
            "enum": [
              "SINGLE",
              "WEEKLY",
              "FORTNIGHTLY",
              "MONTHLY",
              "QUARTERLY",
              "HALFYEARLY",
              "YEARLY"
            ]
          },
          "currencyType": {
            "type": "string",
            "description": "Currency Type - currency used for amounts on this contract",
            "example": "AUD"
          },
          "currencyCashValueAmount": {
            "type": "number",
            "description": "Currency Cash Value Amount - cash value of the contract",
            "example": 1000.99
          },
          "premiumAmount": {
            "type": "number",
            "description": "Premium Amount - premium amount payable at the intervals identified by payment frequency",
            "example": 999.99
          },
          "terminationReason": {
            "type": "string",
            "description": "Termination Reason, for example, 'no contract', 'cancelled', etc",
            "example": "no contact"
          },
          "terminationDate": {
            "type": "string",
            "description": "Termination Date, using format 'yyyy-mm-dd'",
            "format": "date",
            "example": "2018-02-08"
          },
          "endDate": {
            "type": "string",
            "description": "End Date, using format 'yyyy-mm-dd'",
            "format": "date",
            "example": "2018-02-08"
          },
          "audit": {
            "$ref": "#/components/schemas/Audit"
          }
        },
        "description": "Contract Attributes"
      },
      "ContractData": {
        "required": [
          "attributes"
        ],
        "type": "object",
        "properties": {
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "attributes": {
            "$ref": "#/components/schemas/ContractAttributes"
          }
        },
        "description": "Contract Data"
      },
      "Links": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/components/schemas/Link"
        }
      },
      "Meta": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Contract Status is a derived value based on expiry and termination dates and therefore is not editable.",
            "readOnly": true,
            "enum": [
              "OPEN",
              "CLOSED"
            ]
          }
        },
        "description": "Customer Resource's Version Number",
        "readOnly": true
      },
      "NativeKey": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Native Key Id - internal identifier",
            "format": "int64",
            "readOnly": true,
            "example": 12345
          },
          "adminContractId": {
            "type": "string",
            "description": "Value of the Native Key",
            "readOnly": true
          },
          "contractCompInd": {
            "type": "string",
            "description": "Is Native key at contract or component level",
            "readOnly": true
          },
          "adminFieldNameTypeCode": {
            "type": "string",
            "description": "Reference code key",
            "readOnly": true
          }
        },
        "description": "Native Keys"
      },
      "ProductDefinition": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ProductDefinitionData"
          }
        }
      },
      "ProductDefinitionAttributes": {
        "type": "object",
        "properties": {
          "brand": {
            "type": "string"
          },
          "productType": {
            "type": "string"
          },
          "productSystemCode": {
            "type": "string"
          },
          "productSystemProductCode": {
            "type": "string"
          },
          "productSystemProductSubCode": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "marketplaceProductType": {
            "type": "string"
          }
        }
      },
      "ProductDefinitionData": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "attributes": {
            "$ref": "#/components/schemas/ProductDefinitionAttributes"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          }
        }
      },
      "RoleAttributes": {
        "required": [
          "contractSystemCustomerId",
          "customerId",
          "type"
        ],
        "type": "object",
        "properties": {
          "customerId": {
            "type": "integer",
            "description": "Customer Id - Suncorp Group Brand Customer Identifier, typically GCIS ID, which can be retrieved via Customer API",
            "format": "int64",
            "example": 123
          },
          "type": {
            "type": "string",
            "description": "Contract Role Type - type of role that a party can have on a contract, for example PRI",
            "example": "PRI"
          },
          "contractSystemCustomerId": {
            "type": "string",
            "description": "Contract System Customer Id - Customer Identifier supplied by source system, for example, for NIB contract, this will be NIB Customer Identifier",
            "example": "9876"
          },
          "startDate": {
            "type": "string",
            "description": "Start Date, using format 'yyyy-mm-dd'",
            "format": "date",
            "readOnly": true,
            "example": "2015-02-08"
          },
          "endDate": {
            "type": "string",
            "description": "End Date, using format 'yyyy-mm-dd'",
            "format": "date",
            "example": "2016-02-08"
          },
          "roleValues": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "role Component Values - contains any additional values relevant to the contract role\nExample:\nlifeInsuredSmokingStatus = Smoker\n;lifeInsuredOccupationCode = 1234\n;lifeInsuredOccupationDescription = Business Analyst\n;Mobility Bonus = false\n\nJSON Example:\nroleComponentValues: [\n\t{\t\t\"lifeInsuredSmokingStatus\":\"Smoker\"\n,\t\t\"lifeInsuredOccupationCode\":\"1234\"\n,\t\t\"lifeInsuredOccupationDescription\":\"Business Analyst\"\n,\t}]\n"
            },
            "description": "role Component Values - contains any additional values relevant to the contract role\nExample:\nlifeInsuredSmokingStatus = Smoker\n;lifeInsuredOccupationCode = 1234\n;lifeInsuredOccupationDescription = Business Analyst\n;Mobility Bonus = false\n\nJSON Example:\nroleComponentValues: [\n\t{\t\t\"lifeInsuredSmokingStatus\":\"Smoker\"\n,\t\t\"lifeInsuredOccupationCode\":\"1234\"\n,\t\t\"lifeInsuredOccupationDescription\":\"Business Analyst\"\n,\t}]\n"
          }
        },
        "description": "Contract Roles"
      },
      "ContractResult": {
        "required": [
          "contracts"
        ],
        "type": "object",
        "properties": {
          "contracts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contract"
            }
          }
        }
      },
      "Contracts": {
        "required": [
          "data",
          "meta"
        ],
        "type": "object",
        "properties": {
          "included": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductDefinition"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PagingMeta"
          },
          "data": {
            "type": "array",
            "description": "Contracts Information",
            "items": {
              "$ref": "#/components/schemas/ContractData"
            }
          }
        }
      },
      "PagingMeta": {
        "required": [
          "total-elements"
        ],
        "type": "object",
        "properties": {
          "total-elements": {
            "type": "integer",
            "description": "Total Number of Resources",
            "format": "int32",
            "readOnly": true,
            "example": 1
          }
        },
        "description": "Pagination Information",
        "readOnly": true
      },
      "Link": {
        "type": "object",
        "properties": {
          "href": {
            "type": "string"
          },
          "hreflang": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "deprecation": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "templated": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}
