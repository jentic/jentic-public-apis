    "/v2/brands/{brand}/contracts": {
      "get": {
        "tags": [
          "Contract Resource"
        ],
        "summary": "Retrieve contracts by contract attributes. Included attributes: source, sourceSystemCustomerId, referenceId.\nMinimum search criteria: one primary search attribute and at least one secondary search attribute.\n\nPlease see the parameters section below for a reference of available search attributes.\n",
        "description": "Retrieve Contracts by contract attributes.",
        "operationId": "searchContracts",
        "parameters": [
          {
            "name": "brand",
            "in": "path",
            "description": "Brand",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "AAMI",
                "APIA",
                "GIO",
                "SUNCORP",
                "BINGLE"
              ]
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Originating source system of the Contract. Primary search attribute",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sourceSystemCustomerId",
            "in": "query",
            "description": "SourceSystemCustomerId. Secondary search attribute used in conjunction with sourceSystem",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "referenceId",
            "in": "query",
            "description": "ReferenceId. Secondary search attribute used in conjunction with sourceSystem",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Status of the contract. Secondary search attribute",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "OPEN",
                "CLOSED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Contracts"
                }
              }
            }
          },
          "400": {
            "description": "Code: 008<br />Invalid parameter.",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "412": {
            "description": "Precondition Failed",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "Contract Resource"
        ],
        "summary": "Supports adding a contract to the Contracts Master.\n\n  - A contract must be assigned to an active Customer.\n  - When a contract is created, a unique identifier (Contract ID) is created for the contract.\n  - A new Contract can be created as long as there is no other OPEN Contract with the same reference Id. If a contract exists,\n  it can be updated via the update contract end point.\n\n###Validation Rules\n\n####Mandatory Attributes:\n\n  - Contract: brand, source, referenceId, type, executedDate, at least one open component and one open role.\n  - Component: statusType, productType, componentType and issueDate.\n  - Role: customerId, type and contractSystemCustomerId.\n\n####Dates\n\n  - Contract\n    - executedDate should not be after endDate.\n    - executedDate should not be after terminationDate.\n    - endDate may be set to null for open-ended contracts.\n    - terminationDate should be before or the same as endDate.\n\n  - Component\n    - issueDate should not be after expiryDate.\n    - Component executedDate should not be after Contract issueDate.\n\n  - Role\n    - startDate should not be after endDate.\n",
        "description": "Create Contract",
        "operationId": "createContract",
        "parameters": [
          {
            "name": "brand",
            "in": "path",
            "description": "Brand",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "AAMI",
                "APIA",
                "GIO",
                "SUNCORP",
                "BINGLE"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "$ref": "#/components/schemas/Contract"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Contract"
                }
              }
            }
          },
          "400": {
            "description": "Code: 008<br />Invalid payload.",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "404": {
            "description": "Code: 003<br />No customer found with customer id.",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "409": {
            "description": "Code: 008<br />Contract already exists.",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "412": {
            "description": "Precondition Failed",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "502": {
            "description": "Code: 009<br />Error communicating to Customer API.",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    },
