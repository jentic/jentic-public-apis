  "paths": {
    "/v2/contracts/{contractId}": {
      "get": {
        "tags": [
          "Contract Resource"
        ],
        "summary": "Retrieve single contract by contract id.\n",
        "description": "Retrieve Single Contract",
        "operationId": "retrieveSingleContract",
        "parameters": [
          {
            "name": "contractId",
            "in": "path",
            "description": "ContractId",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Contract"
                }
              }
            }
          },
          "400": {
            "description": "Code: 008<br />Invalid parameter.",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "404": {
            "description": "Code: 031<br />No contract found with contract id.",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "412": {
            "description": "Precondition Failed",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Contract Resource"
        ],
        "summary": "##General\n\n  - Only open contracts can be updated.\n  - Please see 'Create Contract' validation rules.\n  - To close a contract update the TerminationDate and TerminationReason.\n  - There must be at least one open Role and one open Component on an open Contract.\n\n###Create Role:\n  - To add a new role to the contract, add a role into the list of roles.\n\n###Update/Close Role:\n  - If a role is not present in the request, it will be deleted.\n\n###Create Component:\n  - To add a new component to a contract, add a component (without a component id) to the list of components.\n\n###Update/Remove Component:\n  - If a component is not present in the request, it will be deleted.\n\n###Read Only Attributes:\n  - Contract: brand, source, referenceId, systemCode, type, executedDate.\n\n  - Component: productType, componentType, issueDate.\n\n  - Role: customerId, contractSystemCustomerId, startDate.\n",
        "description": "Update a contract",
        "operationId": "updateContract",
        "parameters": [
          {
            "name": "contractId",
            "in": "path",
            "description": "contractId",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "Version number of Contract",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/vnd.api+json": {
              "schema": {
                "$ref": "#/components/schemas/Contract"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Contract"
                }
              }
            }
          },
          "400": {
            "description": "Code: 008<br />Invalid parameter.",
            "headers": {
              "ETag": {
                "description": "New version of the contract",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "404": {
            "description": "Code: 031<br />No contract found with contract id.",
            "headers": {
              "ETag": {
                "description": "New version of the contract",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/vnd.api+json": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "412": {
            "description": "Precondition Failed",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Errors"
                }
              }
            }
          }
