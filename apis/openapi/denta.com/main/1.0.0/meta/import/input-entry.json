{
  "openapi": "3.1.0",
  "info": {
    "title": "Denta",
    "version": "1.0.0",
    "summary": "Buy and manage a self-funded dental plan for a company.",
    "description": "A fixed, ordered sequence. Requests sent out of order are refused with a 409 naming the step you are on, so the order cannot be broken by guessing — but it also cannot be skipped. GET /api/v1/start returns the same sequence in prose, written for an agent.",
    "x-jentic-source-url": "https://www.denta.com/api/v1/openapi.json"
  },
  "servers": [
    {
      "url": "https://www.denta.com"
    },
    {
      "url": "https://denta.com"
    }
  ],
  "paths": {
    "/api/v1/start": {
      "get": {
        "operationId": "start",
        "summary": "The sequence, and where this company stands in it",
        "description": "Anonymous, it returns the published sequence and how to authenticate. With a bearer token it also returns position, completion, and the figures. Read it once at the beginning; every write response repeats the position half, so there is no need to poll it between steps.",
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The flow, and optionally your place in it"
          }
        }
      }
    },
    "/api/v1/auth/device": {
      "post": {
        "operationId": "startDeviceAuthorization",
        "summary": "Begin authorization (RFC 8628)",
        "description": "Needs nothing about the human — no email, no existing account. Hand them verification_uri_complete: it signs them in or creates an account, then asks them to authorize the client by name. The code is in that URL; do not display user_code or ask anyone to check it, which assumes they can see your output.",
        "security": [
          {}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_name": {
                    "type": "string",
                    "maxLength": 60
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "device_code, user_code, and where to approve"
          }
        }
      }
    },
    "/api/v1/auth/device/token": {
      "post": {
        "operationId": "awaitDeviceToken",
        "summary": "Wait for the human, and receive a bearer token",
        "description": "One blocking call: it holds for up to 50 seconds while the human authorizes, and answers as soon as they do. Do not build a polling loop around it. A 202 means they are still deciding — send the identical request again, with no delay. Repeating this call is always safe, including after it has already succeeded, which returns the same token rather than refusing.",
        "security": [
          {}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "device_code"
                ],
                "properties": {
                  "device_code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The bearer token. access_token and token are the same value under both names.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "access_token",
                    "token",
                    "token_type"
                  ],
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string",
                      "enum": [
                        "Bearer"
                      ]
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Still with the human. Send the identical request again.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending"
                      ]
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/restart": {
      "post": {
        "operationId": "restart",
        "summary": "Clear the application and return to step one",
        "description": "The escape hatch, not the way to change an answer — a correctable step is simply written again. Voids every signature.",
        "responses": {
          "200": {
            "description": "What was destroyed, and the new step one"
          }
        }
      }
    },
    "/api/v1/application": {
      "get": {
        "operationId": "application",
        "summary": "The complete record on file",
        "responses": {
          "200": {
            "description": "Company, plan, signatures, payments"
          }
        }
      }
    },
    "/api/v1/signup": {
      "post": {
        "operationId": "step_signup",
        "summary": "Step 1 of 5: Company and seats",
        "description": "Ask for the company name and number of employees. This sets the membership price before payment. Address and coverage are collected during setup after payment.",
        "tags": [
          "onboarding"
        ],
        "responses": {
          "200": {
            "description": "Saved, plus which step comes next"
          },
          "409": {
            "description": "Out of order, or a step that is not a correction. The message names the step you are actually on."
          },
          "422": {
            "description": "Validation failed; see the fields object"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "legal_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "formation_state": {
                    "type": "string",
                    "enum": [
                      "AL",
                      "AK",
                      "AZ",
                      "AR",
                      "CA",
                      "CO",
                      "CT",
                      "DE",
                      "DC",
                      "FL",
                      "GA",
                      "HI",
                      "ID",
                      "IL",
                      "IN",
                      "IA",
                      "KS",
                      "KY",
                      "LA",
                      "ME",
                      "MD",
                      "MA",
                      "MI",
                      "MN",
                      "MS",
                      "MO",
                      "MT",
                      "NE",
                      "NV",
                      "NH",
                      "NJ",
                      "NM",
                      "NY",
                      "NC",
                      "ND",
                      "OH",
                      "OK",
                      "OR",
                      "PA",
                      "RI",
                      "SC",
                      "SD",
                      "TN",
                      "TX",
                      "UT",
                      "VT",
                      "VA",
                      "WA",
                      "WV",
                      "WI",
                      "WY"
                    ]
                  },
                  "employee_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                },
                "required": [
                  "legal_name",
                  "employee_count"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/checkout": {
      "post": {
        "operationId": "step_checkout",
        "summary": "Step 2 of 5: Start the Denta membership",
        "description": "Returns a Stripe URL. Say the amount (monthly_fee_cents) and that it bills monthly from today, then hand over the link and stop. Card or bank transfer both work; a card clears at once, while a bank debit takes about four business days and can still fail, so on the bank path do not call it paid. This starts the Denta membership. Setup still requires an address, spending limit, and card-funding authorization. Do not tell them setup is finished.",
        "tags": [
          "onboarding"
        ],
        "responses": {
          "200": {
            "description": "Saved, plus which step comes next"
          },
          "409": {
            "description": "Out of order, or a step that is not a correction. The message names the step you are actually on."
          }
        }
      }
    },
    "/api/v1/company/address": {
      "patch": {
        "operationId": "step_address",
        "summary": "Step 3 of 5: Company address",
        "description": "Where the company physically operates. This picks the state whose insurance mandates apply, so a mailing address or a registered agent's address is wrong. Never guess it.",
        "tags": [
          "onboarding"
        ],
        "responses": {
          "200": {
            "description": "Saved, plus which step comes next"
          },
          "409": {
            "description": "Out of order, or a step that is not a correction. The message names the step you are actually on."
          },
          "422": {
            "description": "Validation failed; see the fields object"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "address_line1": {
                    "type": "string",
                    "minLength": 1
                  },
                  "address_line2": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string",
                    "minLength": 1
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "AL",
                      "AK",
                      "AZ",
                      "AR",
                      "CA",
                      "CO",
                      "CT",
                      "DE",
                      "DC",
                      "FL",
                      "GA",
                      "HI",
                      "ID",
                      "IL",
                      "IN",
                      "IA",
                      "KS",
                      "KY",
                      "LA",
                      "ME",
                      "MD",
                      "MA",
                      "MI",
                      "MN",
                      "MS",
                      "MO",
                      "MT",
                      "NE",
                      "NV",
                      "NH",
                      "NJ",
                      "NM",
                      "NY",
                      "NC",
                      "ND",
                      "OH",
                      "OK",
                      "OR",
                      "PA",
                      "RI",
                      "SC",
                      "SD",
                      "TN",
                      "TX",
                      "UT",
                      "VT",
                      "VA",
                      "WA",
                      "WV",
                      "WI",
                      "WY"
                    ]
                  },
                  "postal_code": {
                    "type": "string"
                  }
                },
                "required": [
                  "address_line1",
                  "city",
                  "state",
                  "postal_code"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/plan/coverage": {
      "put": {
        "operationId": "step_coverage",
        "summary": "Step 4 of 5: Coverage election",
        "description": "One thing: the annual maximum. Do NOT ask how many employees -- that was elected at signup, it is what the membership is billed on, and this endpoint ignores it. Do NOT ask who the plan covers -- it always covers employees and their dependants, dependent_coverage defaults to that, and asking invites an agent to talk somebody out of coverage that costs them nothing. Lead with the recommendation rather than the range: say Denta recommends $1,500 per person and ask whether that is what they want, so somebody with no view can agree in one word; only if they say no offer that anything from $100 to $5,000 works. The response carries the security deposit in cents -- quote it, never compute. The deposit falls due later, before the plan can be used.",
        "tags": [
          "onboarding"
        ],
        "responses": {
          "200": {
            "description": "Saved, plus which step comes next"
          },
          "409": {
            "description": "Out of order, or a step that is not a correction. The message names the step you are actually on."
          },
          "422": {
            "description": "Validation failed; see the fields object"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "annual_maximum": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 5000
                  },
                  "dependent_coverage": {
                    "type": "string",
                    "enum": [
                      "employee_only",
                      "employee_plus_dependents"
                    ]
                  }
                },
                "required": [
                  "annual_maximum"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/documents/sign-request": {
      "post": {
        "operationId": "step_sign",
        "summary": "Step 5 of 5: Authorize card funding",
        "description": "Last step: review the service terms and authorize ACH funding for the company’s cards. GET the documents, then POST a sign-request with every sha256 as returned and a proposed effective_date no earlier than earliest_effective_date. Hand over the returned link for an authorized account representative to accept. No bank debit occurs merely from accepting.",
        "tags": [
          "onboarding"
        ],
        "responses": {
          "200": {
            "description": "Saved, plus which step comes next"
          },
          "409": {
            "description": "Out of order, or a step that is not a correction. The message names the step you are actually on."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "accepted",
                  "effective_date"
                ],
                "properties": {
                  "effective_date": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "properties": {
                      "effective_date": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "effective_date"
                    ]
                  },
                  "accepted": {
                    "type": "array",
                    "description": "Every document from the read_first call, with its sha256 exactly as returned.",
                    "items": {
                      "type": "object",
                      "required": [
                        "document_id",
                        "sha256"
                      ],
                      "properties": {
                        "document_id": {
                          "type": "string"
                        },
                        "sha256": {
                          "type": "string",
                          "minLength": 64,
                          "maxLength": 64
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/documents": {
      "get": {
        "operationId": "read_sign",
        "summary": "Read what step 5 is about to act on",
        "tags": [
          "onboarding"
        ],
        "responses": {
          "200": {
            "description": "The document text, and a sha256 of each"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Minted by the device flow. Sent as Authorization: Bearer <token>. Note that both hosts above serve the API directly: an apex-to-www redirect would strip this header."
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}