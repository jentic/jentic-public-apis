      "ChartRequest": {
        "type": "object",
        "properties": {
          "query": {
            "description": "What you want to see, in plain words: «blue dollar this week», «Milei vs Bullrich coverage», «prices in my catalog».",
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "data": {
            "type": "object",
            "properties": {
              "series": {
                "default": [],
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "points": {
                      "minItems": 1,
                      "maxItems": 1000,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 120
                              },
                              {
                                "type": "number"
                              }
                            ]
                          },
                          "y": {
                            "type": "number"
                          },
                          "r": {
                            "type": "number",
                            "minimum": 0
                          },
                          "label": {
                            "type": "string",
                            "maxLength": 120
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ]
                      }
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "positive",
                        "neutral",
                        "negative",
                        "other"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "points"
                  ]
                }
              },
              "x": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "time",
                      "category",
                      "number"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "unit": {
                    "type": "string",
                    "maxLength": 16
                  },
                  "granularity": {
                    "type": "string",
                    "enum": [
                      "hour",
                      "day",
                      "week",
                      "month",
                      "year"
                    ]
                  }
                }
              },
              "y": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "unit": {
                    "type": "string",
                    "maxLength": 16
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "number",
                      "percent",
                      "currency"
                    ]
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{3}$"
                  },
                  "decimals": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                  },
                  "higher_is_better": {
                    "type": "boolean"
                  }
                }
              },
              "x_measure": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "unit": {
                    "type": "string",
                    "maxLength": 16
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "number",
                      "percent",
                      "currency"
                    ]
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{3}$"
                  },
                  "decimals": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 6
                  },
                  "higher_is_better": {
                    "type": "boolean"
                  }
                }
              },
              "events": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    "end": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
