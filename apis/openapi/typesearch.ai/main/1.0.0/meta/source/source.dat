              "maxLength": 200,
              "pattern": "^(https?:\\/\\/)?(\\*\\.)?[\\w-]+(\\.[\\w-]+)+(\\/\\S*)?$"
            }
          },
          "exclude_domains": {
            "description": "Never these domains or paths.",
