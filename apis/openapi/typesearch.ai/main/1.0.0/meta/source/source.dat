                    "enum": [
                      "line",
                      "area",
                      "bar",
                      "bar_horizontal",
                      "stacked_bar",
                      "pie",
                      "donut",
                      "scatter",
                      "funnel",
                      "timeline",
                      "kpi",
                      "table"
                    ]
                  },
                  "part_of_whole": {
                    "type": "boolean"
                  },
                  "confidence": {
                    "type": "number"
                  },
                  "alternatives": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "line",
                            "area",
                            "bar",
                            "bar_horizontal",
                            "stacked_bar",
                            "pie",
                            "donut",
                            "scatter",
                            "funnel",
                            "timeline",
                            "kpi",
                            "table"
                          ]
                        },
                        "probability": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "type",
                        "probability"
                      ],
                      "additionalProperties": false
                    },
                    "description": "Other chart types that fit: switch with PATCH, free."
                  },
                  "topic": {
                    "type": "string"
                  },
                  "entities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "needs": {
                    "type": "object",
                    "properties": {
                      "queries": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "mode": {
                        "type": "string",
                        "enum": [
                          "ultra",
                          "fast",
                          "normal",
                          "deep"
                        ]
                      },
                      "days": {
                        "type": "number"
                      },
                      "min_points": {
                        "type": "number"
                      },
                      "max_results": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "queries",
                      "mode",
                      "days",
                      "min_points",
                      "max_results"
                    ],
                    "additionalProperties": false,
                    "description": "The data it needs before drawing."
                  }
                },
                "required": [
                  "recipe",
                  "intent",
                  "measure",
                  "x_axis",
                  "type",
                  "part_of_whole",
                  "confidence",
                  "alternatives",
                  "topic",
                  "entities",
                  "needs"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "From a query: what was measured and why this chart. Null for your own data."
          },
          "interpretation": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "What we understood you expect to see: «Finishing positions of the last Formula 1 race»."
                  },
                  "confidence": {
                    "type": "number"
                  },
                  "alternatives": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "probability": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "label",
                        "probability"
                      ],
                      "additionalProperties": false
                    },
                    "description": "Other readings of the query: pass one as `interpretation` to chart it instead."
                  }
                },
                "required": [
                  "label",
                  "confidence",
                  "alternatives"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "From a query in words. Null for your own data, a custom index or a typed question."
          },
          "rung": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "exact",
                  "partial",
                  "related",
                  "coverage",
                  "stories"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "How close the chart is to what was asked. exact: the data itself, complete and verified; partial: a verified part (the podium); related: another view of the same question (the most mentioned names); coverage: the coverage or the timeline; stories: the top stories. Null for your own data."
          },
          "improving": {
            "type": "boolean",
            "description": "Still looking for what was asked: the stored chart (embed, image) updates itself if it arrives. Poll GET /v1/charts/{id} or use stream: true."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "source": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "published_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "url",
                "title",
                "source",
                "published_at"
              ],
              "additionalProperties": false
            }
          },
          "embed_url": {
            "description": "An iframe that adapts to its width, with tooltips. Add ?theme= to change the theme.",
            "type": [
              "string",
              "null"
            ]
          },
          "image_url": {
            "description": "PNG at twice the resolution, for chat, email or slides.",
            "type": [
              "string",
              "null"
            ]
          },
          "svg_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "svg": {
            "description": "The SVG, with include_svg or store: false.",
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "cached": {
            "type": "boolean",
            "description": "The same request in the last 10 minutes: the same chart, not billed."
          },
          "usage": {
            "type": "object",
            "properties": {
              "cost_usd": {
                "type": "number"
              },
              "mode": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "ultra",
                      "fast",
                      "normal",
                      "deep",
                      "data"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "queries": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "duration_ms": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "cost_usd",
              "mode",
              "queries",
              "duration_ms"
            ],
            "additionalProperties": false
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "object",
          "type",
          "theme",
          "locale",
          "chart",
          "compatible_types",
          "plan",
          "interpretation",
          "rung",
          "improving",
          "sources",
          "embed_url",
          "image_url",
          "svg_url",
          "svg",
          "created_at",
          "expires_at",
          "cached",
          "usage",
          "warnings"
        ],
        "additionalProperties": false
      },
      "ChartList": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "theme": {
                  "type": "string"
                },
                "locale": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string"
                },
                "expires_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "embed_url": {
                  "type": "string"
                },
                "image_url": {
                  "type": "string"
                },
                "svg_url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type",
                "title",
                "theme",
                "locale",
                "created_at",
                "expires_at",
                "embed_url",
                "image_url",
                "svg_url"
              ],
              "additionalProperties": false
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_before": {
            "description": "Pass it as `before` for the next page.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "object",
          "data",
          "has_more",
          "next_before"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/v1/search": {
      "post": {
        "summary": "Search the index for one topic, or up to five",
        "description": "When the index has fewer than 3 good matches for a single query, discovery looks for sources beyond it within a time budget (3 s in normal, 8 s in deep; ultra and fast add at most 0.8 s: the open news index and one relevance check, the rest keeps learning in the background): outlets proposed by a topic model and by an open news index, read at the original site with robots.txt respected and judged by the same relevance model; in deep, also the search that those sites declare, with a topic keyword. Discovered results come with `found_in: discovery`; `discovery` says what it did and `incomplete` whether the time ran out. With stream: true, index results arrive first and discovered ones in later partial events. Open news index built from the GDELT Project (gdeltproject.org).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The result; with stream: true, server-sent events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Server-sent events: step, partial, result or error; `data` is JSON."
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search/site": {
      "post": {
        "summary": "Search a live site for a topic",
        "description": "Can take up to a minute: returns a job (202) to poll at /v1/jobs/{id}, or server-sent events with stream: true.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SiteSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "With stream: true, server-sent events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Server-sent events: step, partial, result or error; `data` is JSON."
                }
              }
            }
          },
          "202": {
            "description": "The job that was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{id}": {
      "get": {
        "summary": "Get a job’s status and result",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The job id returned by POST /v1/search/site.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The job.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/similar": {
      "post": {
        "summary": "Find index articles about the same story as a URL",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimilarRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/contents": {
      "post": {
        "summary": "Get metadata and short excerpts for up to 10 URLs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One entry per URL, each with its own status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContentsResponse"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/usage": {
      "get": {
        "summary": "Get this key’s usage and limits",
        "responses": {
          "200": {
            "description": "The usage.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usage"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/indexes": {
      "post": {
        "summary": "Create a custom index",
        "description": "A custom index is your own list of URLs, searched with the same relevance model as the news index: pass its id as `index` to POST /v1/search. Pay as you go allows 3 indexes and 100 URLs; the Monthly credit plan 50 and 10,000; Enterprise, unlimited.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndexRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The index that was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Index"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`index_limit_reached`: your plan allows no more indexes.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List your custom indexes",
        "responses": {
          "200": {
            "description": "Your indexes and your plan’s limits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexList"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/indexes/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The index id, idx_…",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Get a custom index",
        "responses": {
          "200": {
            "description": "The index.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Index"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a custom index and its URLs",
        "responses": {
          "200": {
            "description": "`{ id, deleted: true }`"
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/indexes/{id}/urls": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The index id, idx_…",
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Add URLs, a sitemap or a feed",
        "description": "Up to 1,000 URLs per request, and sitemaps or feeds (read every hour: new URLs are added, updated ones re-read). New URLs are read within a minute and every URL is re-read daily, honoring robots.txt and publisher exclusions. URLs beyond your plan’s limit are counted in `over_limit`, with a warning; if none fits, 409 `url_limit_reached`. Billed daily: US$2.00 per 1,000 URLs per month.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndexUrlsRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "What was added.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexUrlsResponse"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "`url_limit_reached`: your plan’s URL limit is full.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List the URLs of a custom index",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "ready",
                "failed",
                "blocked"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The next_cursor of the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of URLs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexUrlList"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove URLs or sources",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndexUrlsDeleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`{ removed, removed_sources }`"
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/charts": {
      "post": {
        "summary": "Create a chart card from a query or your own data",
        "description": "Ask in plain words («blue dollar this week», «standings last Formula 1 race», «elections in Brazil», «Milei vs Bullrich coverage», «news in The Guardian this week», «prices in my catalog» with `index`). It first works out what you expect to see (`interpretation`, with other readings you can ask for), then gets that data: the finishing positions of the latest race, poll or result shares, wins in the season, coverage, tone, outlets, a timeline or the figures the articles publish, verified against the sources. It never fails while there are articles on the topic: if the exact data is not published or takes too long, it shows the closest thing (`rung`: exact, partial, related, coverage, stories) with a warning, and a stored chart keeps `improving` until the exact data arrives. With `stream: true`, server-sent events: `step`, `result` and `improved`. Or send `data` (series, events, or columns and rows) and it picks the chart, sorts, summarizes and titles it. `type` forces one of 12 types while the data allows. From a query it costs its search (the mode it ended in, one per compared name; free if cached) plus the chart add-on; from your data, the data price (see `x-pricing`, per_1000_charts). The same request within 10 minutes returns the same card, free. No articles at all: 422 `insufficient_data`, not billed.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChartRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "With plan_only, store: false, or the same request within 10 minutes (cached: true). With stream: true, text/event-stream: `step`, `result` (a Chart), `improved` (a Chart) or `error` (a Problem).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chart"
                }
              }
            }
          },
          "201": {
            "description": "The chart that was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chart"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "`insufficient_data`: no articles about the topic in the period. Not billed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List your charts",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "The next_before of the previous page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of charts, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChartList"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/charts/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The chart id, chart_…",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Get a chart",
        "responses": {
          "200": {
            "description": "The chart.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chart"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "`chart_not_found`: no chart with that id for this key, or it expired.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Change a chart’s type, theme, title or language",
        "description": "Redraws from the same data: free, no new search. `type` must be one of `compatible_types`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChartUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated chart.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chart"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a chart",
        "description": "Its embed and image stop working.",
        "responses": {
          "200": {
            "description": "`{ id, deleted: true }`"
          },
          "402": {
            "description": "Payment required: `insufficient_credits` (no credit left), `spend_limit_reached` (the key hit its monthly limit) or `budget_too_small`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "default": {
            "description": "Error (RFC 9457). In English unless the request sends `Accept-Language: es`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/embed/{file}": {
      "get": {
        "summary": "A chart’s public embed, image or SVG",
        "description": "`chart_…` is the iframe page (it switches to a compact layout under 480 px and posts `typesearch:chart:resize` with its height); `chart_….png` the image at 2×; `chart_….svg` the SVG. Query: `theme` (light, dark, editorial, electric) and, for png and svg, `size=compact`. No key needed.",
        "security": [],
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "HTML, PNG or SVG."
          },
          "404": {
            "description": "No such chart, or it expired."
          }
        }
      }
    }
  }
}
