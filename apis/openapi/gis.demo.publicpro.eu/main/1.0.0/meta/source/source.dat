{
  "openapi": "3.0.3",
  "info": {
    "title": "Contracts-gis API",
    "version": "1.0.0",
    "description": "API για ανάκτηση στοιχείων σύμβασης και της προσυμβατικής φάσης βάσει ID.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/PublicSoft-PC/GIS/1.0.0"
  },
  "servers": [
    {
      "description": "Demo",
      "url": "https://gis.demo.publicpro.eu/gis/PublicPro1.0.0/api"
    },
    {
      "description": "SwaggerHub API Auto Mocking",
      "url": "https://virtserver.swaggerhub.com/PublicSoft-PC/GIS/1.0.0"
    }
  ],
  "paths": {
    "/contracts/{id}": {
      "get": {
        "summary": "Ανάκτηση σύμβασης βάσει ID",
        "description": "Επιστρέφει λεπτομέρειες σύμβασης.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Μοναδικό αναγνωριστικό σύμβασης",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Επιτυχής απόκριση",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Contract"
                }
              }
            }
          },
          "400": {
            "description": "Μη έγκυρο αίτημα",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Δεν βρέθηκε σύμβαση",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/procurements/{id}": {
      "get": {
        "summary": "Ανάκτηση Procurement φάσης βάσει ID προσυμβατικής.",
        "description": "Επιστρέφει στοιχεία της φάσης προμήθειας/διαγωνισμού για συγκεκριμένη προσυμβατική.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Μοναδικό αναγνωριστικό σύμβασης",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Επιτυχής απόκριση",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Procurement"
                },
                "examples": {
                  "demo": {
                    "value": {
                      "id": "589",
                      "process_title": "Ανοικτός Ηλεκτρονικός Διαγωνισμός για προμήθεια Η/Υ",
                      "contract_type": "Προμήθεια",
                      "award_procedure": "Ανοικτή Διαδικασία",
                      "budget_net": 50000.0,
                      "budget_gross": 62000.0,
                      "process_step": "Αξιολόγηση Προσφορών",
                      "tender_date": "2025-02-10"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Μη έγκυρο αίτημα",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Δεν βρέθηκαν δεδομένα procurement για τη σύμβαση",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Contract": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "12345"
          },
          "title": {
            "type": "string",
            "example": "Προμήθεια εξοπλισμού Η/Υ"
          },
          "contractor_name": {
            "type": "string",
            "example": "Δείγμα Α.Ε."
          },
          "contractor_vat": {
            "type": "string",
            "pattern": "^\\d{9}$",
            "example": "094259836"
          },
          "contract_type": {
            "type": "string",
            "example": "Προμήθεια"
          },
          "amount_net": {
            "type": "number",
            "example": 12000.0
          },
          "amount_gross": {
            "type": "number",
            "example": 14880.0
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "example": "2025-01-15"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "example": "2026-01-14"
          },
          "status": {
            "type": "string",
            "example": "Ενεργή"
          },
          "procurement": {
            "$ref": "#/components/schemas/Procurement"
          }
        }
      },
      "Procurement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Αναγνωριστικό προσυμβατικής",
            "example": "12345"
          },
          "process_title": {
            "type": "string",
            "description": "Τίτλος διαδικασίας (διαγωνισμού/προμήθειας)",
            "example": "Ανοικτός Ηλεκτρονικός Διαγωνισμός για προμήθεια Η/Υ"
          },
          "contract_type": {
            "type": "string",
            "description": "Τύπος σύμβασης (π.χ. Προμήθεια, Υπηρεσία, Έργο)",
            "example": "Προμήθεια"
          },
          "award_procedure": {
            "type": "string",
            "description": "Διαδικασία ανάθεσης (π.χ. Ανοικτή, Πρόχειρος, Διαπραγμάτευση)",
            "example": "Ανοικτή Διαδικασία"
          },
          "budget_net": {
            "type": "number",
            "format": "float",
            "description": "Προϋπολογισμός χωρίς ΦΠΑ",
            "example": 50000.0
          },
          "budget_gross": {
            "type": "number",
            "format": "float",
            "description": "Προϋπολογισμός με ΦΠΑ",
            "example": 62000.0
          },
          "process_step": {
            "type": "string",
            "description": "Τρέχον βήμα διαδικασίας (π.χ. Προκήρυξη, Υποβολή Προσφορών, Αξιολόγηση, Κατακύρωση)",
            "example": "Αξιολόγηση Προσφορών"
          },
          "tender_date": {
            "type": "string",
            "format": "date",
            "description": "Ημερομηνία διαγωνισμού (YYYY-MM-DD)",
            "example": "2025-02-10"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "NOT_FOUND"
          },
          "message": {
            "type": "string",
            "example": "Resource not found."
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
