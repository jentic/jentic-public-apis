.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.034"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"query","in":"query","required":false,"description":"Search terms (e.g. 'diffusion models image generation', 'transformer attention mechanism', 'graph neural networks'). Natural language or keywords.","schema":{"type":"string"}},{"name":"field","in":"query","required":false,"description":"Which field to search. 'all' searches title+abstract+authors. Default: all.","schema":{"type":"string","enum":["all","title","abstract","author"],"default":"all"}},{"name":"category","in":"query","required":false,"description":"arXiv category filter (e.g. 'cs.AI', 'cs.LG', 'stat.ML', 'quant-ph', 'math.CO'). Optional.","schema":{"type":"string"}},{"name":"sort","in":"query","required":false,"description":"Sort order. relevance = arXiv relevance score; lastUpdatedDate = most recently updated; submittedDate = newest submissions first. Default: relevance.","schema":{"type":"string","enum":["relevance","lastUpdatedDate","submittedDate"],"default":"relevance"}},{"name":"limit","in":"query","required":false,"description":"Number of papers to return (1–10). Default: 5.","schema":{"type":"integer","default":5,"minimum":1,"maximum":10}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"query":{"type":"string"},"total_results":{"type":"integer"},"papers":{"type":"array","items":{"type":"object","properties":{"arxiv_id":{"type":"string"},"title":{"type":"string"},"authors":{"type":"array","items":{"type":"string"}},"abstract":{"type":"string"},"categories":{"type":"array","items":{"type":"string"}},"primary_category":{"type":"string"},"published":{"type":"string"},"updated":{"type":"string"},"arxiv_url":{"type":"string"},"pdf_url":{"type":"string"}}}},"generated_at":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/audio-transcribe-long":{"get":{"operationId":"audio-transcribe-long","summary":"Transcribe LONG audio (15-30 minutes) from any publicly accessible URL using OpenAI Whisper. Supports mp3, mp4, m4a, wav, webm, ogg, flac, and wma up to 24 MB and 30 minutes duration (whichever limit is hit first). Returns the full transcript text, detected language, and estimated duration in seconds. For audio under 15 minutes use audio-transcribe (5-15 min, cheaper) or audio-transcribe-short (0-5 min, cheaper still) — this route rejects out-of-band audio before incurring transcription cost. Useful for full podcast episodes and long-form recordings.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.209"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"url","in":"query","required":true,"description":"Public URL of the audio file to transcribe (mp3, mp4, m4a, wav, webm, ogg, flac, wma). Must be directly accessible without authentication. Max 24 MB. This route accepts audio between 15 and 30 minutes (900-1800s) duration only.","schema":{"type":"string"}},{"name":"language","in":"query","required":false,"description":"Optional ISO 639-1 language code hint (e.g. 'en', 'es', 'fr', 'de', 'ja'). Improves accuracy when the audio language is known. Omit to auto-detect.","schema":{"type":"string"}},{"name":"source_rights_confirmed","in":"query","required":true,"description":"Required confirmation that the caller owns the audio or is authorized to have it transcribed.","schema":{"type":"boolean","const":true}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"transcript":{"type":"string"},"language":{"type":"string"},"duration_s":{"type":"number"},"word_count":{"type":"integer"},"source_url":{"type":"string"},"model":{"type":"string"},"generated_at":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/audio-transcribe-short":{"get":{"operationId":"audio-transcribe-short","summary":"Transcribe SHORT audio clips (0-5 minutes) from any publicly accessible URL using OpenAI Whisper. Supports mp3, mp4, m4a, wav, webm, ogg, flac, and wma up to 24 MB. Returns the full transcript text, detected language, and estimated duration in seconds. For audio longer than 5 minutes, use audio-transcribe (5-15 min) or audio-transcribe-long (15-30 min) instead — this route rejects out-of-band audio before incurring transcription cost. Useful for voice memos, short clips, and social media audio snippets.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/pay