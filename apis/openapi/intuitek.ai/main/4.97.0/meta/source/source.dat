92×1024). $0.289/image. Output is base64-encoded PNG or a direct URL depending on response_format.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.289"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"prompt","in":"query","required":false,"description":"Text description of the image to generate. Be specific — include subject, style, lighting, mood, and composition for best results. Max 4000 characters.","schema":{"type":"string","maxLength":4000}},{"name":"style","in":"query","required":false,"description":"Image style. 'vivid' produces hyper-real, dramatic compositions. 'natural' produces softer, more realistic images. Default: vivid.","schema":{"type":"string","enum":["vivid","natural"]}},{"name":"size","in":"query","required":false,"description":"Image dimensions. '1024x1024' is square (default), '1024x1792' is portrait, '1792x1024' is landscape.","schema":{"type":"string","enum":["1024x1024","1024x1792","1792x1024"]}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"url":{"type":"string","description":"Public URL of the generated image. Valid for 1 hour — download promptly."},"revised_prompt":{"type":["string","null"],"description":"The prompt as reinterpreted by DALL-E 3, which may include additional detail."},"model":{"type":"string"},"style":{"type":"string"},"size":{"type":"string"},"duration_ms":{"type":"integer"},"ts":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/ai-pipeline-brief":{"get":{"operationId":"ai-pipeline-brief","summary":"AI pipeline architecture brief: finds the best HuggingFace models for your ML task, validates or generates your cron schedule, and synthesizes a deployment guide — all in one call. Serves AI developers and agent builders who need model selection + scheduling together. Input: task description (e.g. 'classify customer sentiment hourly from social media feeds') plus optional HuggingFace pipeline task filter and schedule. Returns: top model recommendations, validated cron expression, pipeline steps, deployment notes, and cost estimate.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"1.75"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"task_description","in":"query","required":true,"description":"What the AI pipeline should do. Be specific (e.g. 'classify customer support tickets into 5 categories every 15 minutes' or 'generate daily summaries of earnings call transcripts'). Required.","schema":{"type":"string"}},{"name":"pipeline_task","in":"query","required":false,"description":"Optional HuggingFace pipeline task filter to narrow model search. Common values: text-classification, text-generation, summarization, token-classification, question-answering, sentence-similarity, image-classification, zero-shot-classification.","schema":{"type":"string"}},{"name":"schedule","in":"query","required":false,"description":"When to run the pipeline. Accepts: named shortcuts (@hourly, @daily, @weekly, @monthly), natural language ('every 4 h