URE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.059"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"from_chain","in":"query","required":false,"description":"Source chain — name (ethereum, base, polygon, arbitrum, optimism, bsc, avalanche) or chain ID integer.","schema":{"type":"string"}},{"name":"to_chain","in":"query","required":false,"description":"Destination chain. Same as from_chain for same-chain swaps. Use chain name or ID.","schema":{"type":"string"}},{"name":"from_token","in":"query","required":false,"description":"Source token — symbol (ETH, USDC, WBTC, USDT, MATIC, LINK) or ERC-20 contract address.","schema":{"type":"string"}},{"name":"to_token","in":"query","required":false,"description":"Destination token — symbol or ERC-20 contract address.","schema":{"type":"string"}},{"name":"from_amount","in":"query","required":false,"description":"Amount to quote, in human-readable source-token units: '3' means 3 USDC, whether from_token is USDC or its contract address. Decimals are resolved from chain-specific token metadata. Prefix an integer with '!' for explicit smallest units: '!3000000' means 3 USDC with 6 decimals. Plain '3000000' means 3 million tokens. Positive amounts only; excess decimal places are rejected without rounding.","schema":{"type":"string","maxLength":100,"pattern":"^(?:[0-9]+(?:\\.[0-9]+)?|![0-9]+)$"}},{"name":"slippage","in":"query","required":false,"description":"Max slippage tolerance as a decimal (0.005 = 0.5%). Default 0.03 (3%).","schema":{"type":"number","minimum":0.0001,"maximum":0.5}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"from_chain":{"type":"string"},"to_chain":{"type":"string"},"from_token":{"type":"string"},"to_token":{"type":"string"},"from_amount":{"type":"number","description":"Human-readable input amount."},"from_amount_atomic":{"type":"string","description":"Exact integer source-token amount sent to the quote provider."},"from_token_decimals":{"type":"integer","description":"Source token decimal places confirmed by token metadata or the returned quote."},"to_amount":{"type":"number","description":"Expected output amount (before slippage)."},"to_amount_min":{"type":"number","description":"Minimum guaranteed output (after slippage)."},"exchange_rate":{"type":"number","description":"toToken per fromToken."},"price_impact":{"type":"string","description":"Estimated price impact percentage, if available."},"gas_cost_usd":{"type":"number","description":"Estimated gas cost in USD."},"fee_usd":{"type":"number","description":"Protocol/integrator fees in USD."},"route":{"type":"array","items":{"type":"string"},"description":"Ordered list of DEX/bridge names used."},"cross_chain":{"type":"boolean","description":"True if this is a cross-chain swap/bridge."},"execution_time_seconds":{"type":"number","description":"Estimated execution time (bridge + swap)."},"quote_ts":{"type":"string","description":"ISO-8601 timestamp of this quote."}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/dex-trending-pools":{"get":{"operationId":"dex-trending-pools","summary":"Trending DEX liquidity pools with buy/sell pressure data across multiple timeframes (5m, 1h, 6h, 24h). Sourced from GeckoTerminal (free, no key). Supports 100+ networks: eth, base, bsc, arbitrum, polygon_pos, solana, etc. Returns pool name, price, price change %, volume, buy vs sell transaction counts, and a buy_pressure_24h_pct metric (% of transactions that are buys — above 50% = net accumulation, below 50% = net distribution). Useful for spotting early momentum, identifying which on-chain tokens agents are accumulating, and validating signals from price feeds with raw flow data.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-cre