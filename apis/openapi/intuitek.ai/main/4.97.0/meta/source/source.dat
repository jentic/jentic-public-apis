 level, key pinning strikes, and vol regime signal (positive GEX = pinning, negative = acceleration). Free CBOE delayed data, no API key. Standard SpotGamma-style calculation: calls subtract gamma, puts add gamma. Use with options-snapshot for full options context.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.040"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"ticker","in":"query","required":false,"description":"US equity or ETF ticker (e.g. SPY, QQQ, AAPL, NVDA). Case-insensitive.","schema":{"type":"string"}},{"name":"days_out","in":"query","required":false,"description":"Include only options expiring within this many calendar days. Default: 45 (captures standard monthly + weekly expiries).","schema":{"type":"integer","minimum":0,"maximum":90}},{"name":"top_n","in":"query","required":false,"description":"Number of top positive and negative GEX strikes to return. Default: 10.","schema":{"type":"integer","minimum":3,"maximum":20}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"ticker":{"type":"string"},"spot":{"type":"number","description":"Current underlying price."},"total_gex":{"type":"number","description":"Aggregate dealer gamma exposure in USD. Positive = net long gamma; negative = net short gamma."},"call_gex":{"type":"number","description":"Total call-side GEX contribution."},"put_gex":{"type":"number","description":"Total put-side GEX contribution."},"gamma_flip":{"type":["number","null"],"description":"Strike where net GEX crosses zero (gamma flip level). Null if no crossing found."},"vol_regime":{"type":"string","description":"Volatility regime: 'pinned' (GEX > 0), 'acceleration' (GEX < 0), or 'neutral'."},"key_strikes":{"type":"array","description":"Top strikes by absolute GEX (both positive and negative), sorted by abs GEX descending."},"positive_gex_wall":{"type":["number","null"],"description":"Highest aggregate positive-GEX strike — acts as upside resistance/pin."},"negative_gex_wall":{"type":["number","null"],"description":"Lowest aggregate negative-GEX strike — acts as downside acceleration level."},"options_count":{"type":"integer","description":"Number of options included in the analysis."},"expiry_range":{"type":"string","description":"Date range of expiries included."},"data_delay_min":{"type":"integer"},"ts":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_neg