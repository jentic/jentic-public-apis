ll 166 supported currencies, or a filtered subset. Sourced from open.er-api.com (free, no key, daily updates ~00:00 UTC). Supports any ISO 4217 base: EUR, GBP, JPY, KRW, CNY, AUD, etc. Use for: USD→KRW conversion when reading Korean exchange data, cross-border payment amounts, international price normalization, or any multi-currency DeFi workflow.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.059"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"base","in":"query","required":false,"description":"Base currency ISO 4217 code (e.g. USD, EUR, GBP, JPY). Default: USD.","schema":{"type":"string","default":"USD"}},{"name":"symbols","in":"query","required":false,"description":"Specific currency codes to return (e.g. ['KRW','EUR','GBP']). If omitted, returns all 166+ currencies.","schema":{"type":"array","items":{"type":"string"}}},{"name":"convert","in":"query","required":false,"description":"Optional: convert an amount. E.g. {amount: 1000, from: 'USD', to: 'KRW'}.","schema":{"type":"object","properties":{"amount":{"type":"number"},"from":{"type":"string"},"to":{"type":"string"}},"required":["amount","from","to"]}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"base":{"type":"string"},"rates":{"type":"object","description":"Currency code → rate (how many units of currency per 1 base currency unit)."},"rate_count":{"type":"integer"},"last_updated":{"type":"string","description":"UTC timestamp of last rate update."},"next_update":{"type":"string"},"conversion":{"type":["object","null"],"properties":{"amount":{"type":"number"},"from":{"type":"string"},"to":{"type":"string"},"result":{"type":"number"},"rate":{"type":"number"}}},"ts":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/form-144-intel":{"get":{"operationId":"form-144-intel","summary":"Retrieves SEC Form 144 planned insider sale filings for a US public company — earlier signal than Form 4 (post-trade). Returns seller name, role, shares planned for sale, market value, approximate sale date, and acquisition type (RSU, open market, etc.).","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-s