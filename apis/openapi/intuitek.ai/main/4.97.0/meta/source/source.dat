","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.05"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"route_class","in":"query","required":true,"description":"One of: ENTITY, CONTRACTOR, CODE, FINANCIAL, COMPOSITE","schema":{"type":"string"}},{"name":"predicate_object","in":"query","required":false,"description":"Client-authored predicate fields per the route_class template. Omit to receive the template + an example for that route_class instead of compiling.","schema":{"type":"object"}},{"name":"notes","in":"query","required":false,"description":"Optional freeform context — scanned for unresolved vague terms (e.g. 'high quality') even in Mode A.","schema":{"type":"string"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","description":"COMPILED | REFUSED | TEMPLATE"},"policy_hash":{"type":"string"},"predicate_object":{"type":"object"},"compile_receipt":{"type":"object"},"valid_for_routes":{"type":"array"},"refusal":{"type":"object"},"mode":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/policy-compile-b":{"get":{"operationId":"policy-compile-b","summary":"Acceptance-Policy Compiler, Mode B (STALL-assisted, joint ratification). Describe a job in plain language for one of five route classes (ENTITY, CONTRACTOR, CODE, FINANCIAL, COMPOSITE) — STALL drafts a machine-evaluable predicate object. The policy_hash only finalizes once BOTH client_sig and provider_sig are supplied (call once to get the draft + share it, call again with both signatures to finalize) — STALL's LLM assistance is editorial, the signing parties are the authors. Non-compilable specs are refused with the exact unresolved terms, never guessed.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.20"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"route_class","in":"query","required":true,"description":"One of: ENTITY, CONTRACTOR, CODE, FINANCIAL, COMPOSITE","schema":{"type":"string"}},{"name":"job_description","in":"query","required":true,"description":"Plain-language description of the job to be delivered.","schema":{"type":"string"}},{"name":"client_sig","in":"query","required":false,"description":"Client's signature/attestation over the draft (any wallet-signature or nominal attestation string the two parties agree on off-chain). Required to receive anything beyond a preview draft.","schema":{"type":"string"}},{"name":"provider_sig","in":"query","required":false,"description":"Provider's countersignature. Omit on the first call (draft-only, unsigned). Supply on a second call with the SAME route_class + job_description + client_sig to finalize the jointly-signed policy_hash.","schema":{"type":"string"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":"string","description":"COMPILED_UNSIGNED | COMPILED_FINALIZED | REFUSED"},"policy_hash":{"type":"string"},"predicate_object":{"type":"object"},"requires_provider_countersign":{"type":"boolean"},"compile_receipt":{"type":"object"},"refusal":{"type":"object"},"mode":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verific