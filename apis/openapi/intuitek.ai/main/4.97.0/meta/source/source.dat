_history': all published versions with release dates, newest first. 'compare': package_info + download_stats for 2–4 packages side-by-side. Default: 'package_info'.","schema":{"type":"string","enum":["package_info","download_stats","version_history","compare"]}},{"name":"package","in":"query","required":false,"description":"PyPI package name (case-insensitive). Required for package_info, download_stats, and version_history. Examples: 'requests', 'numpy', 'langchain', 'fastapi', 'pydantic'.","schema":{"type":"string"}},{"name":"packages","in":"query","required":false,"description":"List of 2–4 package names for the 'compare' action. Example: ['aiohttp', 'httpx', 'requests'] to compare HTTP client libraries.","schema":{"type":"array","items":{"type":"string"}}},{"name":"limit","in":"query","required":false,"description":"Max versions to return in version_history (default 20, max 50).","schema":{"type":"number"}},{"name":"include_downloads","in":"query","required":false,"description":"Whether to include download stats in 'compare' action (default true). Set false to skip the pypistats.org call and get faster metadata-only comparison.","schema":{"type":"boolean"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"action":{"type":"string","description":"Action that was performed."},"name":{"type":"string","description":"Canonical PyPI package name."},"version":{"type":"string","description":"Latest published version."},"summary":{"type":"string","description":"One-sentence package description."},"author":{"type":["string","null"],"description":"Package author or maintainer name."},"license":{"type":["string","null"],"description":"SPDX license identifier (e.g. 'MIT', 'Apache-2.0')."},"dev_status":{"type":["string","null"],"description":"PyPI development status (e.g. '5 - Production/Stable', '4 - Beta')."},"python_versions":{"type":"array","description":"Supported Python versions from classifiers."},"requires_python":{"type":["string","null"],"description":"Python version constraint (e.g. '>=3.8')."},"dependencies":{"type":"array","description":"Direct dependencies (requires_dist, optional deps excluded), up to 20."},"project_urls":{"type":"object","description":"Project URLs: Documentation, Source, Changelog, etc."},"pypi_url":{"type":"string","description":"Direct link to PyPI package page."},"recent_versions":{"type":"array","description":"5 most recently published versions with release dates.","items":{"type":"object","properties":{"version":{"type":"string"},"released":{"type":"string","description":"Release date YYYY-MM-DD."}}}},"vulnerabilities":{"type":"array","description":"Known security vulnerabilities from PyPI advisory database.","items":{"type":"object","properties":{"id":{"type":"string"},"details":{"type":"string"},"fixed_in":{"type":"array"}}}},"total_releases":{"type":"number","description":"Total number of published versions."},"last_day":{"type":["number","null"],"description":"Downloads in last 24 hours."},"last_week":{"type":["number","null"],"description":"Downloads in last 7 days."},"last_month":{"type":["number","null"],"description":"Downloads in last 30 days."},"versions":{"type":"array","description":"Paginated version list for version_history action.","items":{"type":"object","properties":{"version":{"type":"string"},"released":{"type":"string"}}}},"comparison":{"type":"array","description":"Per-package results for compare action."}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/pypi-lookup":{"get":{"operationId":"pypi-lookup","summary":"Python package metadata from PyPI. Returns latest version, summary, author, license, Python version requirement, install dependencies, release date, and download URLs. Also supports fetching a specific version. Use before integrating a Python library: check if it's actively maintained, what license it uses, and whether it's compatible with your Python version. Free upstream: PyPI JSON API (no key, no rate limit for normal use).","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.034"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"package","in":"query","required":false,"description":"PyPI package name (e.g. 'requests', 'numpy', '