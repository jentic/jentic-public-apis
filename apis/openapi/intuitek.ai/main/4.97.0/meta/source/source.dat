rex-rates (real-time) with retrospective data.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.059"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"date","in":"query","required":false,"description":"Date in YYYY-MM-DD format (e.g. '2023-03-15'). Use 'latest' for today's ECB rate. Historical data available from 1999-01-04.","schema":{"type":"string"}},{"name":"end_date","in":"query","required":false,"description":"Optional end date YYYY-MM-DD for a time-series range. Max recommended range: 365 days. Returns rates keyed by date.","schema":{"type":"string"}},{"name":"base","in":"query","required":false,"description":"Base currency ISO 4217 (e.g. USD, EUR, GBP). Default: USD.","schema":{"type":"string","default":"USD"}},{"name":"symbols","in":"query","required":false,