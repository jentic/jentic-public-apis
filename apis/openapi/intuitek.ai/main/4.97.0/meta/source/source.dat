k.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.021"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"query","in":"query","required":false,"description":"Address or place name to geocode (forward lookup). Example: '1600 Pennsylvania Ave Washington DC' or 'Eiffel Tower Paris'.","schema":{"type":"string"}},{"name":"lat","in":"query","required":false,"description":"Latitude for reverse geocoding. Requires 'lon' also.","schema":{"type":"number"}},{"name":"lon","in":"query","required":false,"description":"Longitude for reverse geocoding. Requires 'lat' also.","schema":{"type":"number"}},{"name":"limit","in":"query","required":false,"description":"Max results for forward geocode (default 3, max 10). Ignored for reverse.","schema":{"type":"integer"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"mode":{"type":"string","d