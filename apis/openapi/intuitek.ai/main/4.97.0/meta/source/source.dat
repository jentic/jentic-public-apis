":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.034"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[],"requestBody":{"required":false,"description":"No parameters required.","content":{"application/json":{"schema":{"type":"object","properties":{}}}}},"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"current_rate_pct":{"type":"number","description":"FEDFUNDS monthly effective rate, latest available (%). Tracks target range midpoint."},"rate_date":{"type":"string","description":"Date of the latest FEDFUNDS observation (YYYY-MM-01, monthly series)."},"rate_trend":{"type":"string","description":"Rate direction over last 6 months: 'hiking', 'holding', or 'cutting'."},"rate_change_6m_pct":{"type":"number","description":"Rate change over last 6 months in percentage points (negative = cuts)."},