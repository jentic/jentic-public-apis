ript":{"type":"string"},"language":{"type":"string"},"duration_s":{"type":"number"},"word_count":{"type":"integer"},"source_url":{"type":"string"},"model":{"type":"string"},"generated_at":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/audio-transcribe":{"get":{"operationId":"audio-transcribe","summary":"Transcribe MEDIUM-length audio (5-15 minutes) from any publicly accessible URL using OpenAI Whisper. Supports mp3, mp4, m4a, wav, webm, ogg, flac, and wma up to 24 MB. Returns the full transcript text, detected language, and estimated duration in seconds. For audio under 5 minutes use audio-transcribe-short (cheaper); for 15-30 minutes use audio-transcribe-long — this route rejects out-of-band audio before incurring transcription cost. Useful for meeting recordings, podcast snippets, and interview clips.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and