), merger proxies (DEFM14A/PREM14A), and issuer self-tenders (SC TO-I); mode=recent gives a market-wide feed. Returns filing dates, forms, parties, SEC links, and a polling cursor. Reuse next_filed_after after next_poll_after_utc for incremental monitoring. Primary-source SEC data. $0.021/call.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.021"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"ticker","in":"query","required":false,"description":"US public company ticker symbol (e.g. TSLA, AAPL, T). Case-insensitive. Check if a specific company has M&A filings.","schema":{"type":"string"}},{"name":"mode","in":"query","required":false,"description":"'company' (default when ticker given) returns M&A filings for that ticker. 'recent' returns market-wide M&A activity in the last N days.","schema":{"type":"string","enum":["company","recent"]}},{"name":"days","in":"query","required":false,"description":"For mode=recent: calendar days back to search (default 30, max 365).","schema":{"type":"integer","minimum":1,"maximum":365}},{"name":"limit","in":"query","required":false,"description":"Max results to return (default 20, max 50).","schema":{"type":"integer","minimum":1,"maximum":50}},{"name":"filed_after","in":"query","required":false,"description":"Optional inclusive date cursor. Return filings on or after this YYYY-MM-DD date; reuse next_filed_after and deduplicate by accession.","schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"examples":[{"total_filings_in_period":0,"days_searched":30,"forms_searched":["SC TO-T (tender offers)","SC 13E-3 (going-private)","DEFM14A (merger proxies)"],"returned":0,"filings":[],"next_filed_after":null,"recommended_poll_interval_hours":6,"next_poll_after_utc":"2000-01-01T06:00:00.000Z","source":"SEC EDGAR EFTS full-text search (efts.sec.gov)"}],"x-stall-example-provenance":{"kind":"synthetic contract example","current_data":false},"type":"object","properties":{"ticker":{"type":"string"},"company":{"type":"string"},"ma_filings_found":{"type":"integer"},"filings":{"type":"array"},"total_filings_in_period":{"type":"integer"},"interpretation":{"type":"string"},"next_filed_after":{"type":["string","null"]},"recommended_poll_interval_hours":{"type":"integer"},"next_poll_after_utc":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiat