ode(s), semicolon-separated for multiple (e.g. 'US', 'US;CN;DE'). Use 'WLD' for world average.","schema":{"type":"string"}},{"name":"indicator","in":"query","required":false,"description":"Indicator alias or WB code. Aliases: gdp, gdp_growth, gdp_per_capita, population, inflation, unemployment, fdi, debt_gdp, exports_gdp, imports_gdp, co2_per_capita, internet_users, life_expectancy, gini, literacy, ease_of_biz, current_account, market_cap_gdp, forex_reserves. Or any WB indicator code like 'NY.GDP.MKTP.CD'.","schema":{"type":"string"}},{"name":"years","in":"query","required":false,"description":"Number of most-recent years to return (1–10). Default: 5.","schema":{"type":"integer","default":5,"minimum":1,"maximum":10}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"indicator_code":{"type":"string"},"indicator_name":{"type":"string"},"indicator_unit":{"type":"string"},"series":{"type":"array","description":"One entry per country, with yearly values.","items":{"type":"object","properties":{"country_code":{"type":"string"},"country_name":{"type":"string"},"latest_year":{"type":"string"},"latest_value":{},"latest_formatted":{"type":"string"},"trend":{"type":"array","items":{"type":"object"},"description":"Year-value pairs, most-recent first."},"yoy_change_pct":{"type":"number","description":"% change from previous year (null if only 1 data point)."}}}},"note":{"type":"string"},"generated_at":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/x402-endpoint-intel":{"get":{"operationId":"x402-endpoint-intel","summary":"Market intelligence for any x402 endpoint or operator wallet. Returns settlement volume, unique payer count, price range, reputation tier, activity window, and endpoint description — drawn from 4.1M+ Base mainnet settlements in the Stall's proprietary on-chain dataset. Use before routing agent spend, vetting a counterparty operator, or benchmarking competitor pricing. No external API. Covers 80,000+ operators across 10+ days of live traffic.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.040"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"target","in":"query","required":false,"description":"Resource URL (https://…) or operator wallet address (0x…40 hex chars). Type is auto-detected.","schema":{"type":"string"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"target":{"type":"string","description":"Input target as provided."},"target_type":{"type":"string","description":"url | wallet"},"settlements":{"type":"integer","description":"Total settled calls observed in archive."},"unique_payers":{"type":"integer","description":"Distinct wallets that paid this endpoint/operator."},"unique_resources":{"type":"integer","description":"Number of distinct endpoints operated by this wallet (wallet queries only)."},"avg_price_usd":{"type":"number","description":"Average amount paid per call in USD."},"price_range":{"type":"object","description":"Min and max observed price.","properties":{"min":{"type":"number"},"max":{"type":"number"}}},"reputation_tier":{"type":"string","description":"HIGH_VOLUME (≥10K) | ESTABLISHED (≥1K) | ACTIVE (≥100) | EMERGING (≥10) | LISTED (≥1) | UNKNOWN (0)"},"first_seen":{"type":"string","description":"ISO-8601 timestamp of first observed settlement."},"last_seen":{"type":"string","description":"ISO-8601 timestamp of most recent settlement."},"active_days":{"type":"integer","description":"Number of distinct calendar days with at least one settlement."},"name":{"type":"string","description":"Endpoint name from x402 bazaar catalog (if indexed)."},"description":{"type":"string","description":"Endpoint description from x402 bazaar catalog (if indexed)."},"category":{"type":"string","description":"Endpoint category from bazaar catalog (if indexed)."},"endpoints":{"type":"array","description":"Endpoint list for wallet queries (up to 20).","items":{"type":"object"}},"archive_window":{"type":"object","description":"Coverage window of the archive this response was drawn from.","properties":{"earliest":{"type":"string"},"latest":{"type":"string"},"total_settlements":{"type":"integer"}}},"ts":{"type":"string","description":"ISO-8601 timestamp of this response."}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/yield-farming-active":{"get":{"operationId":"yield-farming-active","summary":"Returns active DeFi yield farming pools sorted by 30-day average APY. Sourced from DeFiLlama (free, no key). Each pool includes protocol, chain, symbol, TVL, current APY, 30-day mean APY, impermanent-loss risk, and stablecoin flag. Filter by chain, protocol, minimum TVL, minimum APY, or stablecoin-only pools. Use for portfolio yield research, pre-trade DeFi reconnaissance, or capital allocation decisions.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.059"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"chain","in":"query","required":false,"description":"Filter by blockchain (e.g. 'Ethereum', 'Base', 'Polygon', 'Arbitrum', 'Solana'). Case-insensitive. Omit for all chains.","schema":{"type":"string"}},{"name":"protocol","in":"query","required":false,"description":"Filter by protocol name (e.g. 'aave-v3', 'uniswap-v3', 'curve', 'lido'). Case-insensitive substring match.","schema":{"type":"string"}},{"name":"min_tvl_usd","in":"query","required":false,"description":"Minimum Total Value Locked in USD. Default 1000000 ($1M). Lower values include smaller pools with potentially higher (but riskier) yields.","schema":{"type":"number","default":1000000,"minimum":0}},{"name":"min_apy","in":"query","required":false,"description":"Minimum APY percentage to include (based on 30-day mean). Default 0. E.g. 5 returns pools yielding ≥5% annualized.","schema":{"type":"number","default":0,"minimum":0}},{"name":"stablecoin_only","in":"query","required":false,"description":"If true, returns only stablecoin pools (no impermanent loss from token price volatility). Default false.","schema":{"type":"boolean"}},{"name":"sort_by","in":"query","required":false,"description":"Sort order: 'apy_30d' (30-day average APY, default and most stable), 'apy_current' (live APY, more volatile), 'tvl' (largest pools first).","schema":{"type":"string","enum":["apy_30d","apy_current","tvl"],"default":"apy_30d"}},{"name":"limit","in":"query","required":false,"description":"Number of pools to return (1–50, default 20).","schema":{"t