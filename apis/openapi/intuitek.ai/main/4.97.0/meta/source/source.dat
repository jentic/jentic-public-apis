{"openapi":"3.1.0","info":{"title":"The Stall","description":"Domain-agnostic x402 capability chassis by IntuiTek¹. 301 AI-callable data services — pay USDC on Base mainnet. No accounts or API keys required.","version":"4.97.0","contact":{"url":"https://the-stall.intuitek.ai"},"x-guidance":"Call capability GET routes with the query parameters declared for each operation. For a public company's reported cash, debt, assets, liabilities and equity, use /cap/balance-sheet with ticker; cash-flow-statement answers a different question about cash flows over a reporting period. Balance-sheet monitoring is caller-operated polling: retain latest_period_end and use the declared known_latest_period_end input on a later call. The endpoint does not schedule jobs or send notifications. Its period comparison does not establish whether values for an existing period were revised. For market breadth use /cap/market-breadth; for dealer gamma exposure use /cap/market-gex. Read each operation's source, freshness, input and output descriptions before selecting it. The current research-synthesis output does not include a claim-to-source citation map. Declared USD prices are in each operation's x-payment-info; obtain the current runtime payment challenge before paying."},"x-discovery":{"ownershipProofs":["0x03d773c52B67993e60Ecb3134b17436fE03B584c"]},"servers":[{"url":"https://the-stall.intuitek.ai","description":"Production (Base mainnet)"}],"components":{"securitySchemes":{"x402Payment":{"type":"http","scheme":"x402","description":"Send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output requires successful settlement."},"bearerToken":{"type":"http","scheme":"bearer","description":"Bearer token issued after a Stripe card purchase. Buy credits via POST /v1/fiat/checkout, then GET /v1/fiat/token to retrieve your token. Send as Authorization: Bearer <token> on any /cap/* endpoint — 1 credit consumed per call."}}},"paths":{"/health":{"get":{"operationId":"health","summary":"Health check","description":"Returns network, capability list, and ok:true.","security":[],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"network":{"type":"string"},"capabilities":{"type":"array","items":{"type":"string"}}},"required":["ok","network","capabilities"]}}}}}}},"/catalog":{"get":{"operationId":"catalog","summary":"Full capability catalog","description":"Returns all capabilities with names, paths, prices, descriptions, and input/output schemas.","security":[],"responses":{"200":{"description":"Catalog","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/stats":{"get":{"operationId":"stats","summary":"Aggregated usage statistics","security":[],"responses":{"200":{"description":"Stats","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/metrics":{"get":{"operationId":"metrics","summary":"Discovery-to-payment funnel metrics","security":[],"responses":{"200":{"description":"Metrics","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/research-funnel.json":{"get":{"operationId":"research_funnel","summary":"Research discovery-to-synthesis funnel","description":"Free machine-readable sequence from research-paper-search or github-intel into research-synthesis, including exact request templates, live per-call prices, and the input handoff mapping.","tags":["research-funnel"],"security":[],"responses":{"200":{"description":"Research funnel manifest","content":{"application/json":{"schema":{"type":"object","properties":{"schema":{"type":"string","const":"the-stall-research-funnel/v2"},"objective":{"type":"string"},"steps":{"type":"array","items":{"type":"object"}},"handoff":{"type":"object"},"constraints":{"type":"object"}},"required":["schema","objective","steps","handoff","constraints"]}}}}}}},"/openapi.json":{"get":{"operationId":"openapi","summary":"This OpenAPI specification","security":[],"responses":{"200":{"description":"OpenAPI 3.1.0 spec","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/payment-methods":{"get":{"operationId":"payment_method_registry","summary":"Canonical payment/value acceptance registry","description":"Returns exact VERIFIED_LIVE, DISCOVERY_ONLY, CANDIDATE, DISABLED, and GOVERNANCE_REVIEW rail truth. Only VERIFIED_LIVE entries can be selected for settlement.","security":[],"responses":{"200":{"description":"Value acceptance registry","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/v1/payment-negotiations":{"post":{"operationId":"payment_negotiate","summary":"Select a verified payment recovery method for an existing rescue incident","description":"Strictly schema-validates non-secret client payment capabilities and deterministically issues the next challenge. Client text cannot alter price, payTo, registry status, or security policy.","security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false}}}},"responses":{"200":{"description":"Deterministic next payment challenge","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"description":"Invalid or secret-bearing capability declaration"},"404":{"description":"Unknown rescue incident or capability"},"409":{"description":"Rescue binding mismatch"},"422":{"description":"No compatible VERIFIED_LIVE method"}}}},"/a2a/message:send":{"post":{"operationId":"a2a_send_message","summary":"A2A v1.0 payment-recovery message","description":"Stateful HTTP+JSON A2A Message/Task surface for the optional STALL payment-negotiation extension.","security":[],"requestBody":{"required":true,"content":{"application/a2a+json":{"schema":{"type":"object"}}}},"responses":{"200":{"description":"A2A Task with deterministic payment-recovery Message","content":{"application/a2a+json":{"schema":{"type":"object"}}}}}}},"/v1/fiat/checkout":{"post":{"operationId":"fiat_checkout","summary":"Buy prepaid call credits with a card (Stripe)","description":"Creates a Stripe Checkout Session for a prepaid credit bundle. Redirect the buyer to the returned checkout_url. After payment completes, retrieve the bearer token via GET /v1/fiat/token?session_id=. Credits are consumed at 1 per /cap/* call — no wallet, no gas, no per-call signing.","tags":["fiat"],"security":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"bundle":{"type":"string","enum":["starter","pro","scale"],"description":"Credit bundle to purchase. starter=$5/100 credits ($0.05/call), pro=$30/1,000 credits ($0.03/call), scale=$200/10,000 credits ($0.02/call).","default":"starter"}}}}}},"responses":{"200":{"description":"Stripe checkout session created","content":{"application/json":{"schema":{"type":"object","properties":{"checkout_url":{"type":"string","description":"Redirect buyer to this URL to complete card payment."},"session_id":{"type":"string","description":"Pass to GET /v1/fiat/token?session_id= after payment to retrieve your bearer token."},"bundle":{"type":"string"},"credits":{"type":"integer","description":"Credits included in this bundle."},"amount_usd":{"type":"number","description":"Price in USD."}},"required":["checkout_url","session_id","bundle","credits","amount_usd"]}}}},"400":{"description":"Unknown bundle key — use starter, pro, or scale."}}}},"/v1/fiat/token":{"get":{"operationId":"fiat_token","summary":"Retrieve bearer token after Stripe payment","description":"Poll after the buyer completes checkout. Returns a bearer token for use as Authorization: Bearer <token> on any /cap/* call. Each call consumes 1 credit.","tags":["fiat"],"security":[],"parameters":[{"name":"session_id","in":"query","required":true,"schema":{"type":"string"},"description":"Stripe session_id returned by POST /v1/fiat/checkout."}],"responses":{"200":{"description":"Token ready","content":{"application/json":{"schema":{"type":"object","properties":{"token":{"type":"string","description":"Bearer token — use as Authorization: Bearer <token> on any /cap/* endpoint."},"credits":{"type":"integer","description":"Remaining call credits."},"jti":{"type":"string"}},"required":["token","credits"]}}}},"404":{"description":"Payment not yet confirmed. Retry in 2-5 seconds."}}}},"/cap/action-receipt":{"get":{"operationId":"action-receipt","summary":"Issue a self-verifying action receipt: sha256-chained record binding actor, action, subject, and result hash to a timestamp and nonce. Returns the receipt plus the exact recompute recipe so any third party can verify it offline. Durable proof for agent actions, dispute defense, and audit trails.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.05"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"action","in":"query","required":true,"description":"what was done, e.g. 'sent_quote', 'published_listing', 'completed_job'","schema":{"type":"string"}},{"name":"actor","in":"query","required":true,"description":"who/what did it — agent id, wallet, or name","schema":{"type":"string"}},{"name":"subject","in":"query","required":false,"description":"what it was done to/for (optional)","schema":{"type":"string"}},{"name":"result_hash","in":"query","required":false,"description":"sha256 of the work product, if any (optional)","schema":{"type":"string"}},{"name":"meta","in":"query","required":false,"description":"freeform context, max 500 chars (optional)","schema":{"type":"string"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"receipt_id":{"type":"string"},"chain_hash":{"type":"string"},"issued_at":{"type":"string"},"verify_recipe":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/activist-investor-intel":{"get":{"operationId":"activist-investor-intel","summary":"SEC EDGAR Schedule 13D/13G beneficial ownership disclosures for US equities. Mode 1 (ticker): returns all 5%+ shareholders for a company — activist funds (13D) vs passive holders (13G), with ownership %, share count, and EDGAR filing URL. Mode 2 (recent): returns market-wide Schedule 13D disclosures in the last N days. Authoritative US government data, updated within minutes of SEC acceptance.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.021"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"ticker","in":"query","required":false,"description":"US public company ticker symbol (e.g. TSLA, AAPL, CRM). Case-insensitive. Provide to get 5%+ holders for that specific company.","schema":{"type":"string"}},{"name":"mode","in":"query","required":false,"description":"'company' (default when ticker provided) returns 5%+ shareholders for that ticker. 'recent' returns market-wide Schedule 13D filings in the last N days.","schema":{"type":"string","enum":["company","recent"]}},{"name":"days","in":"query","required":false,"description":"For mode=recent: how many calendar days back to search (default 30, max 365).","schema":{"type":"integer","minimum":1,"maximum":365}},{"name":"limit","in":"query","required":false,"description":"Max results to return (default 20, max 50).","schema":{"type":"integer","minimum":1,"maximum":50}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"ticker":{"type":"string"},"company":{"type":"string"},"holders":{"type":"array"},"filings":{"type":"array"},"activist_count":{"type":"integer"},"total_disclosures":{"type":"integer"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/address-intel":{"get":{"operationId":"address-intel","summary":"On-chain intelligence for any Base network wallet. Classifies EOA vs contract, profiles USDC transfer activity over a configurable block window, scores payer diversity (distinct counterparties / total transfers, 0–100), detects sybil vanity-lookalike address clusters (same first-4 + last-4 hex chars), identifies x402 facilitator SKIM legs (same-block receive+re-send), and assigns a risk label (ORGANIC / ORGANIC_LIKELY / SEEDER_PATTERN / FACILITATOR_SKIM / SYBIL_CLUSTER / FRESH_WALLET / INACTIVE). Three modes: quick (address type+balance+24h USDC summary), standard (+full transfer history+diversity score), deep (+sybil/SKIM detection+risk label). Zero data COGS — Base public RPC only.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.050"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"address","in":"query","required":false,"description":"Base wallet address to analyze (0x-prefixed, 42 hex chars). EOA or contract. Example: 0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045","schema":{"type":"string","pattern":"^0x[a-fA-F0-9]{40}$"}},{"name":"mode","in":"query","required":false,"description":"Analysis depth. quick: address type + USDC balance + 24h USDC summary. standard: + full USDC transfer history + diversity score + counterparty map. deep: + sybil vanity-lookalike detection + SKIM-leg detection + risk label. Default: standard.","schema":{"type":"string","enum":["quick","standard","deep"],"default":"standard"}},{"name":"lookback_blocks","in":"query","required":false,"description":"Block window for USDC transfer history. Base is approximately 2s/block: 43200 is about 24h. Default and maximum 43200. Larger windows are rejected before scanning; unavailable pages fail instead of reporting incomplete history as complete.","schema":{"type":"integer","default":43200,"minimum":1000,"maximum":43200}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"address":{"type":"string"},"address_type":{"type":"string"},"nonce":{"type":["integer","null"]},"usdc_balance":{"type":["number","null"]},"mode":{"type":"string"},"lookback_blocks":{"type":"integer"},"block_range":{"type":"object"},"coverage":{"type":"object","description":"Complete requested block range for both transfer directions; incomplete scans fail instead of reporting false zero activity."},"summary":{"type":"object"},"transfers_received":{"type":"array"},"transfers_sent":{"type":"array"},"counterparties":{"type":"object"},"diversity":{"type":"object"},"sybil_lookalikes":{"type":"array"},"skim_legs":{"type":"array"},"risk_label":{"type":"string"}},"required":[]}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/address-security":{"get":{"operationId":"address-security","summary":"Wallet/address security and reputation check. Detects phishing, sanctions, cybercrime, money laundering, dark-web activity, and blacklisted wallets using GoPlus Labs + SlowMist + BlockSec data. Returns risk score (0-100) and per-flag breakdown. Supports Ethereum, Base, BSC, Polygon, Arbitrum, Optimism, Avalanche, and more.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.136"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"address","in":"query","required":false,"description":"EVM wallet address (0x...)","schema":{"type":"string"}},{"name":"chain","in":"query","required":false,"description":"Chain name or EIP-155 chain ID. Supported names: ethereum, base, bsc, polygon, arbitrum, optimism, avalanche. Default: ethereum","schema":{"type":"string","default":"ethereum"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"address":{"type":"string"},"chain_id":{"type":"string"},"risk_score":{"type":"integer","description":"0 = clean, 100 = critical risk"},"risk_label":{"type":"string","description":"CLEAN | LOW | MEDIUM | HIGH | CRITICAL"},"is_contract":{"type":["boolean","null"]},"flags":{"type":"object","properties":{"sanctioned":{"type":["boolean","null"]},"phishing_activities":{"type":["boolean","null"]},"cybercrime":{"type":["boolean","null"]},"stealing_attack":{"type":["boolean","null"]},"money_laundering":{"type":["boolean","null"]},"darkweb_transactions":{"type":["boolean","null"]},"blackmail_activities":{"type":["boolean","null"]},"financial_crime":{"type":["boolean","null"]},"mixer":{"type":["boolean","null"]},"fake_kyc":{"type":["boolean","null"]},"blacklist_doubt":{"type":["boolean","null"]},"malicious_mining_activities":{"type":["boolean","null"]},"gas_abuse":{"type":["boolean","null"]},"reinit":{"type":["boolean","null"]},"fake_token":{"type":["boolean","null"]},"fake_standard_interface":{"type":["boolean","null"]},"honeypot_related_address":{"type":["boolean","null"]}}},"malicious_contracts_created":{"type":["integer","null"]},"data_sources":{"type":"string"},"ts":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/agent-access-check":{"get":{"operationId":"agent-access-check","summary":"Checks whether a website is accessible and agent-friendly. Fetches robots.txt, .well-known/ai.txt, and sitemap.xml; inspects HTTP headers (CORS, CSP, rate-limit); and returns a readiness verdict. Useful for agents that need to decide whether to scrape, crawl, or interact with a domain before committing to a workflow. Returns allowed/blocked status, disallowed paths, crawl delay, AI-specific rules, and sitemap URL if present.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.034"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"url","in":"query","required":false,"description":"Domain or URL to check. Can be a bare domain (example.com) or full URL (https://example.com/path).","schema":{"type":"string"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"domain":{"type":"string"},"reachable":{"type":"boolean"},"http_status":{"type":"integer"},"robots_txt":{"type":"object","description":"Parsed robots.txt summary."},"ai_txt":{"type":"object","description":"Parsed .well-known/ai.txt if present."},"has_sitemap":{"type":"boolean"},"sitemap_url":{"type":"string"},"headers_intel":{"type":"object","description":"Key HTTP headers relevant to agents."},"agent_verdict":{"type":"string","description":"'OPEN' | 'RESTRICTED' | 'BLOCKED' | 'UNREACHABLE'"},"generated_at":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/agent-kya-score":{"get":{"operationId":"agent-kya-score","summary":"Know Your Agent (KYA) trust score for any EVM wallet. Returns a 0–100 score, tier (trusted/verified/unknown), sanctions screening result, per-dimension score breakdown (wallet age, activity, sanctions, ERC-8004 identity, KYB, tx history, trust bond, endpoint quality), on-chain attestations (Coinbase KYC, Gitcoin Passport, USDC balance), wallet stats (balance, tx count, estimated age), and per-transaction spending limits. Use before accepting payment from an agent or before dispatching a sub-agent with funds. Answers: is this agent wallet sanctioned? how established is it? has it passed KYC?","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.136"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"address","in":"query","required":false,"description":"EVM wallet address to score (0x-prefixed, 42 chars). Works on any EVM chain — score is chain-agnostic.","schema":{"type":"string"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"address":{"type":"string"},"trust_score":{"type":"integer","minimum":0,"maximum":100},"tier":{"type":"string","description":"trusted | verified | unknown | suspended"},"sanctioned":{"type":"boolean"},"blacklisted":{"type":"boolean"},"allowed":{"type":"boolean","description":"Whether AsterPay would allow transactions from this wallet"},"limits":{"type":"object","properties":{"max_per_tx_usd":{"type":"number"},"max_daily_usd":{"type":"number"}}},"breakdown":{"type":"object","properties":{"wallet_age":{"type":"integer"},"wallet_activity":{"type":"integer"},"sanctions_clean":{"type":"integer"},"erc8004_identity":{"type":"integer"},"operator_kyb":{"type":"integer"},"tx_history":{"type":"integer"},"trust_bond":{"type":"integer"},"endpoint_quality":{"type":"integer"},"endpoint_signals":{"type":"integer