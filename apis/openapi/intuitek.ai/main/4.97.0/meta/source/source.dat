s","summary":"Returns active prediction markets from Limitless Exchange with current Yes/No probabilities. Covers short-duration crypto markets (5-min, 15-min BTC/ETH direction), plus longer-term markets. Returns title, implied yes/no prices, expiration, volume, categories, and slug. $0.034/call — free upstream, no API key.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.034"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"limit","in":"query","required":false,"description":"Number of markets to return (1–20, default 10).","schema":{"type":"integer","default":10,"minimum":1,"maximum":20}},{"name":"page","in":"query","required":false,"description":"Page number for pagination (default 1).","schema":{"type":"integer","default":1,"minimum":1}},{"name":"query","in":"que