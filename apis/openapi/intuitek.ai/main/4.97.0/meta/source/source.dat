lt","content":{"application/json":{"schema":{"type":"object","properties":{"query":{"type":"string"},"results":{"type":"array","items":{"type":"object","properties":{"type":{"type":"string","description":"post or comment"},"title":{"type":["string","null"]},"body":{"type":["string","null"]},"score":{"type":"integer"},"comments":{"type":["integer","null"]},"url":{"type":["string","null"]},"author":{"type":"string"},"subreddit":{"type":"string"},"created_utc":{"type":["string","null"]},"permalink":{"type":["string","null"]}}}},"total":{"type":"integer"},"ts":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/regex-tester":{"get":{"operationId":"regex-tester","summary":"Safe regex testing and extraction. Validates a pattern, finds all matches (with capture groups), replaces text, and explains what the pattern matches. Zero external API calls — instant, deterministic. Useful for agents generating or debugging regex patterns mid-task, validating extracted data, or transforming text with precision.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.034"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"pattern","in":"query","required":false,"description":"Regular expression pattern (without delimiters). Example: '(\\\\d{3})-?(\\\\d{4})'","schema":{"type":"string"}},{"name":"flags","in":"query","required":false,"description":"Regex flags: g (global), i (case-insensitive), m (multiline), s (dotAll), u (unicode). Default: 'g'.","schema":{"type":"string"}},{"name":"input","in":"query","required":false,"description":"Text to test the pattern against. Max 50,000 chars.","schema":{"type":"string"}},{"name":"replace_with","in":"query","required":false,"description":"Optional replacement string. Uses $1, $2, etc. for capture groups. When provided, returns replaced output.","schema":{"type":"string"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"pattern_valid":{"type":"boolean"},"match_count":{"type":"integer"},"matches":{"type":"array","description":"Up to 100 matches with index and capture groups."},"replaced_output":{"type":"string","description":"Result of replace operation (when replace_with is provided)."},"has_more_matches":{"type":"boolean"},"generated_at":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/research-automation-brief":{"get":{"operationId":"research-automation-brief","summary":"Automated research intelligence: combines deep topic synthesis (Hacker News, OpenAlex academic papers, Reddit, arXiv, DuckDuckGo) with scheduling guidance in a single call. Returns a structured research report — executive summary, key findings, sentiment, emerging trends, and recommendations — plus a validated cron schedule, recommended cadence, freshness window, and automation notes for recurring unattended runs. Ideal for developers building scheduled intelligence pipelines, agent builders setting up recurring research feeds, and teams that need to monitor a topic on autopilot. Works across any domain: markets, technology, science, geopolitics, and more.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"3.00"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"query","in":"query","required":false,"description":"Research topic or question. Works across any domain: financial markets ('Fed rate policy impact on equities'), technology ('AI agent protocols 2025'), science ('CRISPR therapeutic applications'), geopolitics, and more. Omit for a default AI agents & autonomous systems report.","schema":{"type":"string"}},{"name":"focus","in":"query","required":false,"description":"Optional analytical focus direction (e.g. 'risks and challenges', 'market adoption', 'technical implementation'). Narrows the synthesis lens.","schema":{"type":"string"}},{"name":"schedule","in":"query","required":false,"description":"When to run this research recurringly. Accepts: named shortcuts (@hourly, @daily, @weekly, @monthly), natural language ('every 4 hours', 'daily', 'every 30 minutes'), or a raw cron expression (e.g. '0 8 * * 1'). Omit to get an AI-recommended cadence for your topic.","schema":{"type":"string"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"query":{"type":"string"},"focus":{"type":["string","null"]},"summary":{"type":"string"},"key_findings":{"type":"array","items":{"type":"string"}},"sentiment":{"type":"string"},"trends":{"type":"array","items":{"type":"string"}},"recommendations":{"type":"array","items":{"type":"string"}},"cron_schedule":{"type":["object","null"],"description":"Resolved cron schedule (if provided). null if none given."},"recommended_cron":{"type":"string","description":"AI-recommended cron expression for recurring runs."},"recommended_cadence":{"type":"string","description":"Plain-English cadence recommendation with rationale."},"freshness_window":{"type":"string","description":"How long before this research goes stale."},"schedule_fit":{"type":"string","description":"Assessment of the provided schedule (or confirmation of recommendation)."},"automation_notes":{"type":"string","description":"Guidance for running this research unattended."},"sources_queried":{"type":"integer"},"sources_responded":{"type":"integer"},"source_breakdown":{"type":"object"},"synthesis_error":{"type":"string"},"ts":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/research-paper-search":{"get":{"operationId":"research-paper-search","summary":"Academic paper search via OpenAlex, subject to its limited keyless usage budget. Returns top papers with title, authors, year, DOI, citation count, open-access status, and primary research topic. Covers all disciplines: AI/ML, medicine, physics, economics, law, biology, and more. Supports relevance, citation-count, and publication-year sorting; open-access filtering; and minimum-year constraints. Open access describes readability, not reuse permission or guaranteed PDF availability. Use for literature review, prior-art search, citation building, or finding seminal papers. Every response includes a recommended_next pointer to research-synthesis ($0.20) for cross-source synthesis of the returned papers.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.059"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"x-stall-research-funnel":{"role":"discovery","manifest":"https://the-stall.intuitek.ai/research-funnel.json","nextCapability":"research-synthesis","nextUrl":"https://the-stall.intuitek.ai/cap/research-synthesis","handoff":"Reuse the discovery topic or summarize returned findings as the research-synthesis query."},"parameters":[{"name":"query","in":"query","required":false,"description":"Search query. Natural-language or keyword (e.g. 'transformer attention mechanism', 'CRISPR gene editing cancer', 'bitcoin game theory').","schema":{"type":"string","minLength":1,"maxLength":512}},{"name":"limit","in":"query","required":false,"description":"Number of papers to return (1–10). Default: 5.","schema":{"type":"integer","default":5,"minimum":1,"maximum":10}},{"name":"sort","in":"query","required":false,"description":"Sort order. relevant = OpenAlex relevance score; cited = most-cited first; recent = newest first. Default: relevant.","schema":{"type":"string","enum":["relevant","cited","recent"],"default":"relevant"}},{"name":"min_year","in":"query","required":false,"description":"Only return papers published this year or later (e.g. 2020). Optional.","schema":{"type":"integer","minimum":1,"maximum":9999}},{"name":"open_access_only","in":"query","required":false,"description":"If true, request works with free-to-read full text. An OA URL may be a landing page, not a PDF; this is not a reuse license. Default: false.","schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"Capability result","headers":{"X-Stall-Related":{"description":"Machine-readable next-capability hint returned on successful discovery responses.","schema":{"type":"string","example":"https://the-stall.intuitek.ai/cap/research-synthesis"}}},"content":{"application/json":{"schema":{"type":"object","properties":{"query":{"type":"string"},"total_in_index":{"type":["integer","null"],"description":"Upstream total matching works, or null if missing/invalid; not the returned page length."},"papers":{"type":"array","items":{"type":"object","properties":{"title":{"type":["string","null"]},"authors":{"type":"array","items":{"type":"string"},"description":"Up to 5 author display names."},"year":{"type":["integer","null"]},"doi":{"type":["string","null"]},"cited_by_count":{"type":["integer","null"]},"open_access":{"type":["boolean","null"]},"oa_url":{"type":["string","null"],"description":"Reported free-to-read HTTP(S) link (PDF or landing page), not fetched or license-verified."},"primary_topic":{"type":["string","null"],"description":"OpenAlex primary research topic."},"abstract":{"type":["string","null"],"description":"Up to 500 abstract characters from a bounded valid index; null for missing, malformed or over-limit data. Reuse rights are not established here."}}}},"generated_at":{"type":"string"},"recommended_next":{"type":"object","description":"Upgrade path to research-synthesis ($0.20) for cross-source synthesis of these results.","properties":{"capability":{"type":"string"},"endpoint":{"type":"string"},"price_usdc":{"type":"string"},"when":{"type":"string"},"suggested_input":{"type":"object"}}}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/research-synthesis":{"get":{"operationId":"research-synthesis","summary":"AI-synthesized intelligence report on any topic — aggregates Hacker News, OpenAlex academic papers, Reddit, arXiv preprints, and DuckDuckGo in parallel, then distills into a structured report: executive summary, key findings, market sentiment, emerging trends, and recommendations. Works across domains: financial markets, macroeconomics, technology, life sciences, geopolitics, and more. Pass ?query=your+topic for targeted research. Omit query for a default AI agents & autonomous systems report. This is the deeper cross-source synthesis step for research-paper-search and github-intel — run one of those first for a targeted entry query, then send the same query here for synthesis, implications, risks, and recommendations.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"2.500"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"x-stall-research-funnel":{"role":"synthesis","manifest":"https://the-stall.intuitek.ai/research-funnel.json","acceptsFrom":["research-paper-search","github-intel"]},"parameters":[{"name":"query","in":"query","required":false,"description":"Research query or topic — works across any domain: financial markets (e.g. 'S&P 500 earnings outlook Q3 2026'), macroeconomics ('Fed rate policy impact on equities'), technology ('AI agent protocols 2025'), and more. Omit for default AI agents report.","schema":{"type":"string"}},{"name":"focus","in":"query","required":false,"description":"O