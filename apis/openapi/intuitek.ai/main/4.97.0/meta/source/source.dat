},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"ticker","in":"query","required":true,"description":"US equity ticker symbol (e.g. AAPL, TSLA, NVDA). Case-insensitive.","schema":{"type":"string"}},{"name":"mode","in":"query","required":false,"description":"'holders' (default) returns top institutional funds with shares and value. 'summary' returns aggregate breakdown: % institutional, % insider, float size, concentration. 'full' returns both in one call.","schema":{"type":"string","enum":["holders","summary","full"]}},{"name":"limit","in":"query","required":false,"description":"Max number of institutional holders to return in holders/full mode (default 15, max 30).","schema":{"type":"integer","minimum":1,"maximum":30}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"ticker":{"type":"string"},"holders":{"type":"array"},"summary":{"type":"object"},"total_institutions":{"type":"integer"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/institutional-ownership":{"get":{"operationId":"institutional-ownership","summary":"Institutional and insider ownership snapshot for any US stock. Returns: (1) major holders breakdown — % insiders, % institutions, float coverage, total institution count; (2) up to 10 largest institutional holders — name, pct of shares held, share count, total value (USD), pct change since prior 13F quarter, reporting date; (3) up to 10 insider holders — officer/director name, relation, shares held directly, latest transaction description and date. Inverts hedge-fund-holdings: given a ticker, who are the owners? Institutional momentum (pct change) and insider alignment are standard inputs to equity research and conviction scoring. Free upstream: Yahoo Finance.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.021"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"symbol","in":"query","required":true,"description":"US equity ticker symbol (e.g. 'AAPL', 'MSFT', 'NVDA').","schema":{"type":"string"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"symbol":{"type":"string"},"major_holders":{"type":"object","properties":{"inside