cale":{"usd":200,"credits":10000}}},"parameters":[{"name":"url","in":"query","required":false,"description":"URL of the webpage to extract links from (http or https).","schema":{"type":"string"}},{"name":"same_domain_only","in":"query","required":false,"description":"Pass \"true\" to return only links pointing to the same domain as the input URL. Default: false.","schema":{"type":"string"}},{"name":"include_anchors","in":"query","required":false,"description":"Pass \"true\" to include anchor-only links (#section). Default: false.","schema":{"type":"string"}},{"name":"deduplicate","in":"query","required":false,"description":"Pass \"false\" to allow duplicate hrefs. Default: true (each unique URL returned once).","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Maximum links to return (default 200, max 500).","schema":{"type":"integer"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"url":{"type":"string","description":"Input URL."},"final_url":{"type":"string","description":"URL after redirects."},"domain":{"type":"string","description":"Hostname of the input URL."},"total_found":{"type":"integer","description":"Total distinct links extracted before limit."},"returned":{"type":"integer","description":"Links returned in this response."},"truncated":{"type":"boolean","description":"True if page body was capped at 512 KB."},"links":{"type":"array","description":"Extracted links.","items":{"type":"object","properties":{"href":{"type":"string","description":"Absolute URL."},"text":{"type":"string","description":"Visible link text (stripped of HTML tags)."},"scheme":{"type":"string","description":"URL scheme: http or https."}}}},"ts":{"type":"string","description":"ISO-8601 timestamp."}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/whale-radar":{"get":{"operationId":"whale-radar","summary":"Polymarket whale intelligence for a given proxy wallet address. Returns recent prediction-market trades (market title, outcome, side, size in USDC, price, timestamp) and current open positions (title, size, avg price, current value, unrealized PnL). Infers whale tier (whale/shark/dolphin/minnow) from trade sizes. Use for copy-trading signal generation, market-sentiment cross-reference, or on-chain agent behavior profiling. Free upstream: Polymarket public data API.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.117"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"wallet","in":"query","required":false,"description":"Polymarket proxy wallet address (0x, 42 hex chars). Obtain from recent Polymarket trades or on-chain Polygon activity. Example: 0x7a9dc87be2c72791fd86fad5f67be7c5dc89ba5d","schema":{"type":"string","pattern":"^0x[a-fA-F0-9]{40}$"}},{"name":"activity_limit","in":"query","required":false,"description":"Max recent trades to return (1–50, default 10).","schema":{"type":"integer","default":10,"minimum":1,"maximum":50}},{"name":"positions_limit","in":"query","required":false,"description":"Max open positions to return (1–50, default 10).","schema":{"type":"integer","default":10,"minimum":1,"maximum":50}},{"name":"include_closed","in":"query","required":false,"description":"If true, include zero-value (closed/redeemable) positions. Default false.","schema":{"type":"boolean","default":false}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"wallet":{"type":"string"},"whale_tier":{"type":"string","enum":["whale","shark","dolphin","minnow","unknown"]},"activity_count":{"type":"integer"},"positions_count":{"type":"integer"},"recent_trades":{"type":"array"},"open_positions":{"type":"array"},"summary":{"type":"object"}},"required":[]}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/wikipedia-intel":{"get":{"operationId":"wikipedia-intel","summary":"Wikipedia article lookup and search. Given a search query, returns the top matching Wikipedia articles with title, plain-text extract (~800 chars), description, thumbnail URL, page URL, and last-modified date. Use for rapid factual lookup, entity enrichment, concept explanation, or pre-flight research on any topic. Entity-parametric — accepts one query per call; parallel-safe for enriching lists of companies, people, or places in distributed agentic pipelines. No API key required.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.034"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"query","in":"query","required":false,"description":"Search query or article title (e.g. 'transformer neural network', 'Warren Buffett', 'CRISPR'). Used for full-text search when exact=false.","schema":{"type":"string"}},{"name":"exact","in":"query","required":false,"description":"If true, treat 'query' as an exact page title for a direct lookup (faster, returns one article). If false, run a search and return the top matches.","schema":{"type":"boolean","default":false}},{"name":"limit","in":"query","required":false,"description":"Number of articles to return when exact=false (1–8). Default: 3.","schema":{"type":"integer","default":3,"minimum":1,"maximum":8}},{"name":"lang","in":"query","required":false,"description":"Wikipedia language edition (ISO 639-1 code, e.g. 'en', 'es', 'fr', 'de'). Default: 'en'.","schema":{"type":"string","default":"en"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"query":{"type":"string"},"articles":{"type":"array","items":{"type":"object","properties":{"title":{"type":"string"},"display_title":{"type":"string"},"description":{"type":"string"},"extract":{"type":"string","description":"First ~800 chars of the article extract."},"thumbnail":{"type":"string"},"url":{"type":"string"},"pageid":{"type":"integer"},"last_modified":{"type":"string"}}}},"generated_at":{"type":"string"}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap