call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.030"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"mode","in":"query","required":true,"description":"icao24: lookup by transponder hex | callsign: find flight by ICAO callsign | area: all flights near a location","schema":{"type":"string","enum":["icao24","callsign","area"]}},{"name":"icao24","in":"query","required":false,"description":"6-hex ICAO24 transponder code for icao24 mode. Example: 'a6a7ad' (N-registered US aircraft). Find at planefinder.net or flightaware.com.","schema":{"type":"string"}},{"name":"callsign","in":"query","required":false,"description":"ICAO airline callsign for callsign mode. Use 3-letter ICAO codes: 'AAL123' (American), 'UAL456' (United), 'DAL789' (Delta), 'SWA101' (Southwest), 'BAW7' (British Airways).","schema":{"type":"string"}},{"name":"global","in":"query","required":false,"description":"For callsign mode: search globally instead of CONUS-only. Default false. Set true for international flights.","schema":{"type":"boolean"}},{"name":"airport","in":"query","required":false,"description":"IATA airport code for area mode. Examples: 'ORD', 'LAX', 'JFK', 'LHR', 'DXB'. Searches within radius_deg of the airport.","schema":{"type":"string"}},{"name":"radius_deg","in":"query","required":false,"description":"Radius in degrees for area mode with airport. Default 0.5 (~30 nmi). Use 0.25 for approach/departure, 1.0 for broader traffic picture.","schema":{"type":"number"}},{"name":"lamin","in":"query","required":false,"description":"Min latitude (south bound) for area mode bounding box. Example: 33.0","schema":{"type":"number"}},{"name":"lomin","in":"query","required":false,"description":"Min longitude (west bound) for area mode bounding box. Example: -88.0","schema":{