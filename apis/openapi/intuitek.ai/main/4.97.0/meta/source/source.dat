ayment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.045"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"ticker","in":"query","required":false,"description":"US stock ticker (e.g. AAPL, NVDA, MSFT). Case-insensitive.","schema":{"type":"string"}},{"name":"bear_growth_pct","in":"query","required":false,"description":"Bear-case annual FCF growth rate in % (e.g. 5.0 = 5%). Default: 50% of analyst consensus 5Y EPS CAGR.","schema":{"type":"number"}},{"name":"base_growth_pct","in":"query","required":false,"description":"Base-case annual FCF growth rate in % (e.g. 15.0 = 15%). Default: analyst consensus 5Y EPS CAGR.","schema":{"type":"number"}},{"name":"bull_growth_pct","in":"query","required":false,"description":"Bull-case annual FCF growth rate in % (e.g. 25.0 = 25%). Default: 150% of analyst consensus 5Y EPS CAGR.","schema":{"type":"number"}},{"name":"terminal_growth_pct","in":"query","required":false,"description":"Perpetuity growth rate after year 5 in % (default 3.0). Use 2.0–3.5 for mature companies.","schema":{"type":"number"}},{"name":"erp","in":"query","required":false,"description":"Equity risk premium in % (default 5.5 — Damodaran mature market ERP).","schema":{"type":"number"}},{"name":"bear_weight_pct","in":"query","required":false,"description":"Probability weight for bear scenario in % (default 25). Weights must sum to 100.","schema":{"type":"number"}},{"name":"base_weight_pct","in":"query","required":false,"description":"Probability weight for base scenario in % (default 50).","schema":{"type":"number"}},{"name":"bull_weight_pct","in":"query","required":false,"description":"Probability weight for bull scenario in % (default 25).","schema":{"type":"number"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"ticker":{"type":"string"},"name":{"type":"string"},"current_price_usd":{"type":"number"},"scenarios":{"type":"object","description":"Intrinsic value and margin of safety for each scenario.","properties":{"bear":{"type":"object"},"base":{"type":"object"},"bull":{"type":"object"}}},"weighted_intrinsic_usd":{"type":"number","description":"Probability-weighted composite intrinsic value across all three scenarios."},"weighted_margin_of_safety_pct":{"type":"number"},"weighted_verdict":{"type":"string","description":"UNDERVALUED | FAIRLY_VALUED | OVERVALUED based on weighted intrinsic."},"scenario_weights":{"type":"object","properties":{"bear_pct":{"type":"number"},"base_pct":{"type":"number"},"bull_pct":{"type":"number"}}},"sensitivity_table":{"type":"object","description":"Grid of intrinsic values: growth_rate rows × wacc_offset columns. WACC offsets from base: -2%, -1%, 0%, +1%, +2%.","properties":{"growth_rates":{"type":"array","items":{"type":"number"}},"wacc_offsets_pct":{"type":"array","items":{"type":"number"}},"values_usd":{"type":"array","description":"Row = growth rate (index