lobal earthquake events from USGS. Filter by magnitude, depth, location radius, or time window. Returns location, magnitude, depth, PAGER alert, and USGS event URL. Free primary source — no API key.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.059"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"min_magnitude","in":"query","required":false,"description":"Minimum Richter magnitude to include. Default 4.5.","schema":{"type":"number"}},{"name":"days_back","in":"query","required":false,"description":"How many days of events to fetch (1–30). Default 7.","schema":{"type":"number"}},{"name":"limit","in":"query","required":false,"description":"Maximum number of events to return (1–100). Default 20.","schema":{"type":"number"}},{"name":"latitude","in":"query","required":false,"description":"Center latitude for radius search (decimal degrees). Requires longitude and radius_km.","schema":{"type":"number"}},{"name":"longitude","in":"query","required":false,"description":"Center longitude for radius search (decimal degrees). Requires latitude and radius_km.","schema":{"type":"number"}},{"name":"radius_km","in":"query","required":false,"description":"Search radius in km around lat/lon. Max 20001. Default 500 when lat/lon provided.","schema":{"type":"number"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"type":"object","properties":{"count":{"type":"integer","description":"Number of events returned."},"window_days":{"type":"number","description":"Time window searched (days back from now)."},"min_magnitude":{"type":"number","description":"Minimum magnitude filter applied."},"events":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"USGS event ID."},"time":{"type":"string","description":"ISO-8601 UTC event time."},"magnitude":{"type":"number","description":"Magnitude (Richter scale)."},"mag_type":{"type":"string","description":"Magnitude type (mww, ml, mb, etc.)."},"depth_km":{"type":"number","description":"Hypocenter depth in km."},"place":{"type":"string","description":"Human-readable location description."},"latitude":{"type":"number","description":"Epicenter latitude."},"longitude":{"type":"number","description":"Epicenter longitude."},"alert":{"type":"string","description":"PAGER alert level: green/yellow/orange/red (null if not assessed)."},"tsunami":{"type":"integer","description":"Tsunami warning flag: 1 = warning issued, 0 = none."},"felt":{"type":"integer","description":"Number of 'Did You Feel It?' responses (null if none)."},"sig":{"type":"integer","description":"USGS significance score (0–1000). Higher = more impactful."},"url":{"type":"string","description":"USGS event detail page URL."}}}},"ts":{"type":"string","description":"ISO-8601 timestamp of this response."}}}}}},"402":{"description":"Payment required — send a complete v2 PaymentPayload in PAYMENT-SIGNATURE using the current challenge. Legacy X-PAYMENT accepts the same v2 envelope and verification.","content":{"application/json":{"schema":{"type":"object","properties":{"x402Version":{"type":"integer","example":2},"error":{"type":"string"},"accepts":{"type":"array","items":{"type":"object"}},"payment_negotiation":{"type":"object","description":"Optional stall-payment-negotiation/v1 extension; canonical x402 fields remain unchanged."}},"required":["x402Version","accepts"]}}}}}}},"/cap/vc-funding-intel":{"get":{"operationId":"vc-funding-intel","summary":"Track private fundraising via official SEC Form D filings, normally filed within 15 days of first sale. Find VC rounds, PE buyouts, startup raises, hedge funds, and real-estate syndications. Use company_name for issuer history or mode=recent for a market feed; filter by days and min_amount_millions. Reuse next_filed_after and poll after next_poll_after_utc for incremental automation. Returns amount raised, industry, exemption, investor count, state, and filing link. No API key. $0.021/call.","tags":["capabilities"],"security":[{"x402Payment":[]},{"bearerToken":[]}],"x-payment-info":{"registry":"https://the-stall.intuitek.ai/v1/payment-methods","negotiation":"https://the-stall.intuitek.ai/v1/payment-negotiations","protocols":[{"x402":{"method_id":"base-usdc-x402","network":"eip155:8453","scheme":"exact","currency":"USDC","paymentHeader":"PAYMENT-SIGNATURE","challengeHeader":"PAYMENT-REQUIRED","receiptHeader":"PAYMENT-RESPONSE","payloadEncoding":"base64-json","x402Version":2,"instructions":"Send the complete v2 PaymentPayload using the current challenge. Legacy X-PAYMENT is accepted only for a v2 envelope and receives the same verification and settlement checks. Paid output is returned only after successful settlement."}},{"mpp":{"method_id":"stripe-mpp-spt","network":"stripe","scheme":"charge","currency":"USD","method":"stripe","intent":"charge"}},{"internal-credit":{"method_id":"stall-prepaid-bearer","network":"STALL ledger","scheme":"prepaid-bearer","currency":"call credits"}}],"protocolNames":["x402","MPP","internal-credit"],"methods":["base-usdc-x402","stripe-mpp-spt","stall-prepaid-bearer"],"price":{"mode":"fixed","currency":"USD","amount":"0.021"},"fiatBundles":{"starter":{"usd":5,"credits":100},"pro":{"usd":30,"credits":1000},"scale":{"usd":200,"credits":10000}}},"parameters":[{"name":"company_name","in":"query","required":false,"description":"Company or fund name to search (partial match OK, quoted exact phrase). Used in company mode.","schema":{"type":"string"}},{"name":"mode","in":"query","required":false,"description":"'company' (default when company_name given): Form D filings for that company with full detail. 'recent': market-wide Form D feed in last N days.","schema":{"type":"string","enum":["company","recent"]}},{"name":"days","in":"query","required":false,"description":"For mode=recent: calendar days back to search (default 14, max 90).","schema":{"type":"integer","minimum":1,"maximum":90}},{"name":"min_amount_millions","in":"query","required":false,"description":"For mode=recent: filter to raises with total_amount_sold >= this many USD millions (e.g., 5 = $5M+ raises only). Default 0 = no filter.","schema":{"type":"number","minimum":0}},{"name":"limit","in":"query","required":false,"description":"Max results to return (default 20, max 50).","schema":{"type":"integer","minimum":1,"maximum":50}},{"name":"filed_after","in":"query","required":false,"description":"Optional inclusive date cursor. Return filings on or after this YYYY-MM-DD date; reuse next_filed_after and deduplicate by accession.","schema":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}}],"responses":{"200":{"description":"Capability result","content":{"application/json":{"schema":{"examples":[{"total_form_d_in_edgar":0,"days_searched":14,"min_amount_filter_millions":