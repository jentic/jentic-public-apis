{
  "openapi": "3.0.0",
  "info": {
    "title": "API de verticalização",
    "description": "API de verticalização",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/sandro_tceorganizati/api-de-verticalizacao/1.0.0"
  },
  "tags": [
    {
      "name": "authentication",
      "description": "Obtenção de access_token"
    },
    {
      "name": "custom_objects",
      "description": "Objetos personalizados"
    }
  ],
  "servers": [
    {
      "url": "https://api.rd.services/verticalization",
      "description": "Servidor de produção"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/oauth2/token": {
      "post": {
        "tags": [
          "authentication"
        ],
        "summary": "Obtém access_token",
        "description": "Retorna um access_token para autenticação nas demais rotas da API.\nUse o fluxo **client credentials** (grant_type=client_credentials) com client_id e client_secret.\nO token retornado tem duração de 2 horas e deve ser enviado no header `Authorization: Bearer {access_token}` nas requisições subsequentes.\n",
        "operationId": "getAccessToken",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type",
                  "client_id",
                  "client_secret"
                ],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "client_credentials"
                    ],
                    "default": "client_credentials",
                    "description": "client_credentials"
                  },
                  "client_id": {
                    "type": "string",
                    "description": "client_id do aplicativo."
                  },
                  "client_secret": {
                    "type": "string",
                    "format": "password",
                    "description": "client_secret do aplicativo."
                  }
                }
              },
              "encoding": {
                "grant_type": {
                  "style": "form"
                },
                "client_id": {
                  "style": "form"
                },
                "client_secret": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token obtido com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                },
                "example": {
                  "token_type": "bearer",
                  "access_token": "XLso581FR6T1We3PKO1Wep3w8lYkM4fR",
                  "expires_in": 7200
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida ou falha na autenticação do cliente. Retornado quando client_id/client_secret estão incorretos ou ausentes, grant_type não é client_credentials, ou o body não é application/x-www-form-urlencoded.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuth2Error"
                },
                "examples": {
                  "invalid_credentials": {
                    "summary": "Credenciais inválidas",
                    "value": {
                      "error": "invalid_client",
                      "error_description": "Invalid client authentication"
                    }
                  },
                  "missing_grant": {
                    "summary": "grant_type ausente ou inválido",
                    "value": {
                      "error": "invalid_client",
                      "error_description": "Invalid client authentication"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/custom_objects": {
      "get": {
        "tags": [
          "custom_objects"
        ],
        "summary": "Lista objetos personalizados",
        "description": "Retorna uma lista paginada de objetos personalizados, com suporte a filtros por slug, label e description.",
        "operationId": "listCustomObjects",
        "parameters": [
          {
            "name": "filter[slug]",
            "in": "query",
            "description": "Filtro por slug do objeto personalizado (busca parcial case-insensitive).",
            "required": false,
            "schema": {
              "type": "string",
              "example": "casa"
            }
          },
          {
            "name": "filter[label]",
            "in": "query",
            "description": "Filtro por label do objeto personalizado (busca parcial case-insensitive).",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Imóvel"
            }
          },
          {
            "name": "filter[description]",
            "in": "query",
            "description": "Filtro por description do objeto personalizado (busca parcial case-insensitive).",
            "required": false,
            "schema": {
              "type": "string",
              "example": "imóveis"
            }
          },
          {
            "name": "page[number]",
            "in": "query",
            "description": "Número da página (mínimo 1). Padrão é 1.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "page[size]",
            "in": "query",
            "description": "Tamanho da página (mínimo 1, máximo 20). Padrão é 20.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20,
              "example": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta",
                    "links"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "description": "Lista de objetos personalizados.",
                      "items": {
                        "$ref": "#/components/schemas/CustomObject"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "page_number",
                        "page_size",
                        "total"
                      ],
                      "properties": {
                        "page_number": {
                          "type": "integer",
                          "description": "Número da página atual.",
                          "example": 1
                        },
                        "page_size": {
                          "type": "integer",
                          "description": "Tamanho da página.",
                          "example": 20
                        },
                        "total": {
                          "type": "integer",
                          "description": "Total de registros encontrados.",
                          "example": 4
                        }
                      }
                    },
                    "links": {
                      "type": "object",
                      "required": [
                        "first",
                        "last",
                        "next",
                        "prev"
                      ],
                      "properties": {
                        "first": {
                          "type": "string",
                          "nullable": false,
                          "description": "URL da primeira página.",
                          "example": "/v1/custom_objects?page[number]=1&page[size]=20"
                        },
                        "last": {
                          "type": "string",
                          "nullable": false,
                          "description": "URL da última página.",
                          "example": "/v1/custom_objects?page[number]=1&page[size]=20"
                        },
                        "next": {
                          "type": "string",
                          "nullable": true,
                          "description": "URL da próxima página (null se não houver próxima página).",
                          "example": "/v1/custom_objects?page[number]=2&page[size]=20"
                        },
                        "prev": {
                          "type": "string",
                          "nullable": true,
                          "description": "URL da página anterior (null se não houver página anterior).",
                          "example": null
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "success_with_results": {
                    "summary": "Lista com resultados",
                    "value": {
                      "data": [
                        {
                          "id": "68dd7cd7e7f2aa1710495c5e",
                          "platform_account_id": "172349059697101672",
                          "external_id": "totvs_rm_tcgi_imoveis",
                          "slug": "buildings",
                          "label": "Imóvel",
                          "description": "Estrutura para representar os imóveis do TOTVS construção e gerenciamento de imóveis",
                          "created_at": "2025-09-04T10:01:30.000Z",
                          "updated_at": "2025-09-04T10:15:45.000Z",
                          "deleted_at": null,
                          "attributes": []
                        }
                      ],
                      "meta": {
                        "page_number": 1,
                        "page_size": 20,
                        "total": 1
                      },
                      "links": {
                        "first": "/v1/custom_objects?page[number]=1&page[size]=20",
                        "last": "/v1/custom_objects?page[number]=1&page[size]=20",
                        "next": null,
                        "prev": null
                      }
                    }
                  },
                  "success_empty": {
                    "summary": "Lista vazia",
                    "value": {
                      "data": [],
                      "meta": {
                        "page_number": 1,
                        "page_size": 20,
                        "total": 0
                      },
                      "links": {
                        "first": "/v1/custom_objects?page[number]=1&page[size]=20",
                        "last": "/v1/custom_objects?page[number]=1&page[size]=20",
                        "next": null,
                        "prev": null
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "UnprocessableEntity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/ErrorsResponse"
                },
                "examples": {
                  "invalid_filter": {
                    "summary": "Filtro inválido",
                    "value": {
                      "errors": [
                        {
                          "type": "VALIDATION",
                          "title": "Invalid Attribute",
                          "detail": "The filter invalid is invalid.",
                          "source": {
                            "parameter": "filter[invalid]"
                          }
                        }
                      ]
                    }
                  },
                  "invalid_page_number": {
                    "summary": "Número de página inválido",
                    "value": {
                      "errors": [
                        {
                          "type": "VALIDATION",
                          "title": "Invalid Attribute",
                          "detail": "'page[number]' must be greater than or equal to 1",
                          "source": {
                            "parameter": "page[number]"
                          }
                        }
                      ]
                    }
                  },
                  "invalid_page_size": {
                    "summary": "Tamanho de página inválido",
                    "value": {
                      "errors": [
                        {
                          "type": "VALIDATION",
                          "title": "Invalid Attribute",
                          "detail": "'page[size]' must be less than or equal to 20",
                          "source": {
                            "parameter": "page[size]"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "custom_objects"
        ],
        "summary": "Cria objeto personalizado",
        "description": "Cria um novo objeto personalizado com seus atributos opcionais.",
        "operationId": "createCustomObject",
        "requestBody": {
          "description": "Payload para criar um objeto personalizado. O campo 'attributes' é opcional e permite definir os atributos que compõem o objeto personalizado.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCustomObject"
              },
              "examples": {
                "with_attributes": {
                  "summary": "Criação com atributos",
                  "value": {
                    "data": {
                      "external_id": "sistema_imoveis",
                      "slug": "buildings",
                      "label": "Imóvel",
                      "description": "Estrutura para representar os imóveis do sistema",
                      "attributes": [
                        {
                          "external_id": "sistema_imoveis.descricao",
                          "label": "Descrição do imóvel",
                          "slug": "description",
                          "data_type": "string",
                          "required": true
                        },
                        {
                          "external_id": "sistema_imoveis.preco",
                          "label": "Preço",
                          "slug": "price",
                          "data_type": "number",
                          "required": false
                        }
                      ]
                    }
                  }
                },
                "without_attributes": {
                  "summary": "Criação sem atributos",
                  "value": {
                    "data": {
                      "external_id": "sistema_imoveis_sem_atributos",
                      "slug": "buildings_without_attrs",
                      "label": "Imóvel Sem Atributos",
                      "description": "Estrutura para representar imóveis sem atributos"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Container para os atributos do objeto personalizado criado.",
                      "$ref": "#/components/schemas/CustomObject"
                    }
                  }
                },
                "examples": {
                  "success_with_attributes": {
                    "summary": "Objeto criado com atributos",
                    "value": {
                      "data": {
                        "id": "68dd7cd7e7f2aa1710495c5e",
                        "platform_account_id": "172349059697101672",
                        "external_id": "sistema_imoveis",
                        "slug": "buildings",
                        "label": "Imóvel",
                        "description": "Estrutura para representar os imóveis do sistema",
                        "created_at": "2025-09-04T10:01:30.000Z",
                        "updated_at": "2025-09-04T10:01:30.000Z",
                        "deleted_at": null,
                        "attributes": [
                          {
                            "id": "6613f6c8f51bb4362eea1a4",
                            "custom_object_id": "68dd7cd7e7f2aa1710495c5e",
                            "external_id": "sistema_imoveis.descricao",
                            "label": "Descrição do imóvel",
                            "slug": "description",
                            "data_type": "string",
                            "required": true,
                            "created_at": "2025-09-04T10:01:30.000Z",
                            "updated_at": "2025-09-04T10:01:30.000Z"
                          }
                        ]
                      }
                    }
                  },
                  "success_without_attributes": {
                    "summary": "Objeto criado sem atributos",
                    "value": {
                      "data": {
                        "id": "68dd7cd7e7f2aa1710495c5e",
                        "platform_account_id": "172349059697101672",
                        "external_id": "sistema_imoveis_sem_atributos",
                        "slug": "buildings_without_attrs",
                        "label": "Imóvel Sem Atributos",
                        "description": "Estrutura para representar imóveis sem atributos",
                        "created_at": "2025-09-04T10:01:30.000Z",
                        "updated_at": "2025-09-04T10:01:30.000Z",
                        "deleted_at": null,
                        "attributes": []
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/ErrorsResponse"
                },
                "examples": {
                  "invalid_or_missing_request_body": {
                    "summary": "Corpo da requisição vazio, inválido ou sem o parâmetro obrigatório data",
                    "value": {
                      "errors": [
                        {
                          "type": "BAD_REQUEST",
                          "title": "Bad Request",
                          "detail": "The request body must be properly formatted and include all required parameters",
                          "source": {
                            "pointer": "/data"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "UnprocessableEntity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/ErrorsResponse"
                },
                "examples": {
                  "missing_external_id": {
                    "summary": "external_id ausente",
                    "value": {
                      "errors": [
                        {
                          "type": "VALIDATION",
                          "title": "Invalid Attribute",
                          "detail": "'external_id' is missing",
                          "source": {
                            "pointer": "/data/external_id"
                          }
                        }
                      ]
                    }
                  },
                  "missing_slug": {
                    "summary": "slug ausente",
                    "value": {
                      "errors": [
                        {
                          "type": "VALIDATION",
                          "title": "Invalid Attribute",
                          "detail": "'slug' is missing",
                          "source": {
                            "pointer": "/data/slug"
                          }
                        }
                      ]
                    }
                  },
                  "missing_label": {
                    "summary": "label ausente",
                    "value": {
                      "errors": [
                        {
                          "type": "VALIDATION",
                          "title": "Invalid Attribute",
                          "detail": "'label' is missing",
                          "source": {
                            "pointer": "/data/label"
                          }
                        }
                      ]
                    }
                  },
                  "empty_external_id": {
                    "summary": "external_id vazio",
                    "value": {
                      "errors": [
                        {
                          "type": "VALIDATION",
                          "title": "Invalid Attribute",
                          "detail": "'external_id' must be filled",
                          "source": {
                            "pointer": "/data/external_id"
                          }
                        }
                      ]
                    }
                  },
                  "empty_slug": {
                    "summary": "slug vazio",
                    "value": {
                      "errors": [
                        {
                          "type": "VALIDATION",
                          "title": "Invalid Attribute",
                          "detail": "'slug' must be filled",
                          "source": {
                            "pointer": "/data/slug"
                          }
                        }
                      ]
                    }
                  },
                  "empty_label": {
                    "summary": "label vazio",
                    "value": {
                      "errors": [
                        {
                          "type": "VALIDATION",
                          "title": "Invalid Attribute",
                          "detail": "'label' must be filled",
                          "source": {
                            "pointer": "/data/label"
                          }
                        }
                      ]
                    }
                  },
                  "invalid_data_type": {
                    "summary": "data_type inválido nos atributos",
                    "value": {
                      "errors": [
                        {
                          "type": "VALIDATION",
                          "title": "Invalid Attribute",
                          "detail": "data_type must be one of: string, number, date",
                          "source": {
                            "pointer": "/data/attributes/0/data_type"
                          }
                        }
                      ]
                    }
                  },
                  "duplicated_slug": {
                    "summary": "slug já em uso",
                    "value": {
                      "errors": [
                        {
                          "type": "UNPROCESSABLE_CONTENT",
                          "title": "Unprocessable Content",
                          "detail": "Slug is already in use"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/custom_objects/{id}": {
      "get": {
        "tags": [
          "custom_objects"
        ],
        "summary": "Retorna detalhes de um objeto personalizado",
        "description": "Retorna os detalhes de um objeto personalizado específico.",
        "operationId": "getCustomObject",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Id do objeto personalizado.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "description": "Container para os atributos do objeto personalizado.",
                      "$ref": "#/components/schemas/CustomObject"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "NotFound",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/ErrorsResponse"
                },
                "example": {
                  "errors": [
                    {
                      "type": "NOT_FOUND",
                      "title": "Not Found",
                      "detail": "Custom object not found or inexistent.",
                      "source": {
                        "parameter": "id"
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/custom_objects/{custom_object_id}/records": {
      "get": {
        "tags": [
          "custom_objects"
        ],
        "summary": "Lista de registros de objetos personalizados",
        "description": "Retorna uma lista paginada de registros de objetos personalizados.",
        "operationId": "listCustomObjectRecords",
        "parameters": [
          {
            "name": "custom_object_id",
            "in": "path",
            "description": "Id do objeto personalizado.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page[number]",
            "in": "query",
            "description": "Número da página (mínimo 1). Padrão é 1.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "page[size]",
            "in": "query",
            "description": "Tamanho da página (mínimo 1, máximo 20). Padrão é 20.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20,
              "example": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "meta",
                    "links"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "description": "Lista de registros de objetos personalizados.",
                      "items": {
                        "$ref": "#/components/schemas/CustomObjectRecord"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "required": [
                        "page_number",
                        "page_size",
                        "total"
                      ],
                      "properties": {
                        "page_number": {
                          "type": "integer",
                          "description": "Número da página atual.",
                          "example": 1
                        },
                        "page_size": {
                          "type": "integer",
                          "description": "Tamanho da página.",
                          "example": 20
                        },
                        "total": {
                          "type": "integer",
                          "description": "Total de registros encontrados.",
                          "example": 4
                        }
                      }
                    },
                    "links": {
                      "type": "object",
                      "required": [
                        "first",
                        "last",
                        "next",
                        "prev"
                      ],
                      "properties": {
                        "first": {
                          "type": "string",
                          "nullable": false,
                          "description": "URL da primeira página.",
                          "example": "/v1/custom_objects/680fafe8d6e105009c1ff0bb/records?page[number]=1&page[size]=20"
                        },
                        "last": {
                          "type": "string",
                          "nullable": false,
                          "description": "URL da última página.",
                          "example": "/v1/custom_objects/680fafe8d6e105009c1ff0bb/records?page[number]=2&page[size]=20"
                        },
                        "next": {
                          "type": "string",
                          "nullable": true,
                          "description": "URL da próxima página (null se não houver próxima página).",
                          "example": "/v1/custom_objects/680fafe8d6e105009c1ff0bb/records?page[number]=2&page[size]=20"
                        },
                        "prev": {
                          "type": "string",
                          "nullable": true,
                          "description": "URL da página anterior (null se não houver página anterior).",
                          "example": null
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "NotFound",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/ErrorsResponse"
                },
                "example": {
                  "errors": [
