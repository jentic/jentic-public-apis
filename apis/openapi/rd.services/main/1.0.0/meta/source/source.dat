  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token obtido via POST /oauth2/token (client_credentials). Use no header Authorization com o valor \"Bearer {access_token}\"."
      }
    },
    "schemas": {
      "TokenResponse": {
        "type": "object",
        "required": [
          "access_token",
          "token_type"
        ],
        "properties": {
          "token_type": {
            "type": "string",
            "example": "bearer",
            "description": "Tipo do token. Sempre \"bearer\" para uso em Authorization Bearer."
          },
          "access_token": {
            "type": "string",
            "description": "Token a ser enviado no header Authorization das requisições à API (Authorization Bearer {access_token})."
          },
          "expires_in": {
            "type": "integer",
            "description": "Tempo de vida do token em segundos (ex. 7200)."
          }
        }
      },
      "OAuth2Error": {
        "type": "object",
        "required": [
          "error",
          "error_description"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Código do erro OAuth2 (ex. invalid_client).",
            "example": "invalid_client"
          },
          "error_description": {
            "type": "string",
            "description": "Descrição legível do erro.",
            "example": "Invalid client authentication"
          }
        }
      },
      "ErrorsResponse": {
        "type": "object",
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "type",
          "title",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Uma string com todos os caracters em maiúsculo que indica o tipo de erro que ocorreu e que esteja relacionado ao title.",
            "example": "VALIDATION"
          },
          "title": {
            "type": "string",
            "description": "Uma descrição breve do erro.",
            "example": "Invalid attribute"
          },
          "detail": {
            "type": "string",
            "description": "Descrição com detalhes do erro (opcional).",
            "example": "Name can't be blank."
          },
          "source": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string",
                "description": "Indica onde no corpo do JSON da request o erro ocorreu, seguindo a sintaxe de JSON Pointer (RFC 6901)",
                "example": "/data/name"
              },
              "parameter": {
                "type": "string",
                "description": "Uma string indicando qual parâmetro (query string ou parâmetro de URL) causou o erro.",
                "example": "page[size]"
              },
              "header": {
                "type": "string",
                "description": "Uma string indicando o nome do header request que causou o erro.",
                "example": "Authorization"
              }
            }
          }
        }
      },
      "CreateCustomObject": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "external_id",
              "slug",
              "label"
            ],
            "properties": {
              "external_id": {
                "type": "string",
                "description": "Identificador exclusivo do objeto personalizado no sistema externo.",
                "example": "sistema_imoveis"
              },
              "slug": {
                "type": "string",
                "description": "Identificador legível do objeto personalizado. Será usado para referenciar o objeto nas APIs. Não pode ser alterado após criação.",
                "example": "buildings"
              },
              "label": {
                "type": "string",
                "description": "Nome do objeto personalizado.",
                "example": "Imóvel"
              },
              "description": {
                "type": "string",
                "nullable": true,
                "description": "Descrição do objeto personalizado.",
                "example": "Estrutura para representar os imóveis do sistema"
              },
              "attributes": {
                "type": "array",
                "description": "Lista opcional de atributos que compõem o objeto personalizado.",
                "items": {
                  "type": "object",
                  "required": [
                    "external_id",
                    "label",
                    "slug",
                    "data_type",
                    "required"
                  ],
                  "properties": {
                    "external_id": {
                      "type": "string",
                      "description": "Identificador exclusivo do atributo no sistema externo.",
                      "example": "sistema_imoveis.descricao"
                    },
                    "label": {
                      "type": "string",
                      "description": "Nome do atributo.",
                      "example": "Descrição do imóvel"
                    },
                    "slug": {
                      "type": "string",
                      "description": "Identificador legível do atributo. Será usado para referenciar o atributo nas APIs. Não pode ser alterado após criação.",
                      "example": "description"
                    },
                    "data_type": {
                      "type": "string",
                      "enum": [
                        "string",
                        "number",
                        "date"
                      ],
                      "description": "Tipo de dado que o atributo permite. Valores possíveis: string (texto), number (numérico), date (data no formato ISO 8601, ex: 'YYYY-MM-DDTHH:mm:ss.sssZ').",
                      "example": "string"
                    },
                    "required": {
                      "type": "boolean",
                      "description": "Flag para definir se o atributo é obrigatório.",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        },
        "example": {
          "data": {
            "external_id": "sistema_imoveis",
            "slug": "buildings",
            "label": "Imóvel",
            "description": "Estrutura para representar os imóveis do sistema",
            "attributes": [
              {
                "external_id": "sistema_imoveis.descricao",
                "label": "Descrição do imóvel",
                "slug": "description",
                "data_type": "string",
                "required": true
              },
              {
                "external_id": "sistema_imoveis.preco",
                "label": "Preço",
                "slug": "price",
                "data_type": "number",
                "required": false
              }
            ]
          }
        }
      },
      "RecordMetadata": {
        "type": "object",
        "required": [
          "contact"
        ],
        "properties": {
          "contact": {
            "$ref": "#/components/schemas/RecordMetadataContact"
          }
        },
        "example": {
          "contact": {
            "name": "Maria Silva",
            "email": "maria.silva@rdstation.com",
            "personal_phone": "54999999999",
            "mobile_phone": "54999999999",
            "birthdate": "2010-10-10"
          }
        }
      },
      "RecordMetadataContact": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do contato.",
            "example": "Maria Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "E-mail do contato.",
            "example": "maria.silva@rdstation.com"
          },
          "personal_phone": {
            "type": "string",
            "description": "Telefone pessoal do contato.",
            "example": "54999999999"
          },
          "mobile_phone": {
            "type": "string",
            "description": "Telefone celular do contato.",
            "example": "54999999999"
          },
          "birthdate": {
            "type": "string",
            "format": "date",
            "description": "Data de nascimento no formato YYYY-MM-DD.",
            "example": "2010-10-10"
          }
        }
      },
      "CreateCustomObjectRecord": {
        "type": "object",
        "required": [
          "data",
          "metadata"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "external_id"
            ],
            "properties": {
              "external_id": {
                "type": "string",
                "description": "Identificador exclusivo do registro no sistema externo.",
                "example": "123556"
              },
              "relationships": {
                "type": "array",
                "description": "Lista opcional de relacionamentos a serem criados com o registro.",
                "items": {
                  "type": "object",
                  "properties": {
                    "related_object_id": {
                      "type": "string",
                      "description": "Identificador do objeto relacionado (ex. 'tcgi_contact_email').",
                      "example": "tcgi_contact_email"
                    },
                    "related_record_id": {
                      "type": "string",
                      "description": "Identificador do registro no objeto referenciado (ex. email do contato).",
                      "example": "test@gmail.com"
                    }
                  }
                }
              }
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Valores de texto (string)"
                },
                {
                  "type": "number",
                  "format": "float",
                  "description": "Valores numéricos (inteiros ou decimais)"
                },
                {
                  "type": "string",
                  "format": "date-time",
                  "description": "String representando datetime no formato YYYY-MM-DDThh:mm:ss"
                }
              ]
            }
          },
          "metadata": {
            "$ref": "#/components/schemas/RecordMetadata"
          }
        },
        "example": {
          "data": {
            "external_id": "123556",
            "description": "Casa de praia",
            "price": 1234567.99,
            "available_date": "2025-05-09T00:00:00",
            "quantity": 2,
            "relationships": [
              {
                "related_object_id": "tcgi_contact_email",
                "related_record_id": "test@gmail.com"
              }
            ]
          },
          "metadata": {
            "contact": {
              "name": "Maria Silva",
              "email": "maria.silva@rdstation.com",
              "personal_phone": "54999999999",
              "mobile_phone": "54999999999",
              "birthdate": "2010-10-10"
            }
          }
        }
      },
      "CreateCustomObjectRelationship": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "related_object_id",
              "related_record_id"
            ],
            "properties": {
              "related_object_id": {
                "type": "string",
                "description": "Identificador do objeto relacionado (ex: 'rdsm_contact', 'rdsm_lead').",
                "example": "rdsm_contact"
              },
              "related_record_id": {
                "type": "string",
                "description": "Identificador do registro relacionado no objeto referenciado.",
                "example": "joao@email.com"
              }
            }
          }
        },
        "example": {
          "data": {
            "related_object_id": "rdsm_contact",
            "related_record_id": "joao@email.com"
          }
        }
      },
      "UpdateCustomObjectRecord": {
        "type": "object",
        "required": [
          "data",
          "metadata"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "Valores de texto (string)"
                },
                {
                  "type": "number",
                  "format": "float",
                  "description": "Valores numéricos (inteiros ou decimais)"
                },
                {
                  "type": "string",
                  "format": "date-time",
                  "description": "String representando datetime no formato YYYY-MM-DDThh:mm:ss"
                }
              ]
            }
          },
          "metadata": {
            "$ref": "#/components/schemas/RecordMetadata"
          }
        },
        "example": {
          "data": {
            "description": "Casa de praia",
            "price": 1234567.99,
            "available_date": "2025-05-09T00:00:00",
            "quantity": 2
          },
          "metadata": {
            "contact": {
              "name": "Maria Silva",
              "email": "maria.silva@rdstation.com",
              "personal_phone": "54999999999",
              "mobile_phone": "54999999999",
              "birthdate": "2010-10-10"
            }
          }
        }
      },
      "CustomObject": {
        "type": "object",
        "required": [
          "id",
          "platform_account_id",
          "external_id",
          "slug",
          "label",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único do objeto dentro da plataforma. Gerado automaticamente.",
            "example": "68dd7cd7e7f2aa1710495c5e"
          },
          "platform_account_id": {
            "type": "string",
            "description": "Identificador da conta de plataforma. O identificador de plataforma comporta um slot de cada produto, ou seja, esse vínculo pode disponibilizar a estrutura para uma instância de até 3 produtos atualmente (RDS CRM, RDS Marketing e RDS Conversas). Este atributo é uma string numérica",
            "example": "172349059697101672"
          },
          "external_id": {
            "type": "string",
            "description": "Identificador externo do objeto personalizado, referência para encontrar no sistema que está sendo integrado.",
            "example": "totvs_rm_tcgi_imoveis"
          },
          "slug": {
            "type": "string",
            "description": "Identificador legível, é como será referenciado nas APIs. Não pode ser alterado após criação.",
            "example": "buildings"
          },
          "label": {
            "type": "string",
            "description": "Nome do objeto personalizado.",
            "example": "Imóvel"
          },
          "description": {
            "type": "string",
            "description": "Descrição do objeto personalizado.",
            "example": "Estrutura para representar os imóveis do TOTVS construção e gerenciamento de imóveis"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Momento da criação do objeto personalizado. Preenchido automaticamente.",
            "example": "2025-09-04T10:01:30.000Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Momento da última atualização do objeto personalizado. Preenchido automaticamente.",
            "example": "2025-09-04T10:15:45.000Z"
          },
          "deleted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Momento do delete do objeto personalizado. Preenchido automaticamente. Representa um delete lógico, para exclusão definitiva deve existir um processo de expurgo.",
            "example": "2025-09-04T10:20:05.000Z"
          },
          "attributes": {
            "type": "array",
            "description": "Lista de atributos que compõem o objeto personalizado.",
            "items": {
              "$ref": "#/components/schemas/CustomObjectAttribute"
            }
          }
