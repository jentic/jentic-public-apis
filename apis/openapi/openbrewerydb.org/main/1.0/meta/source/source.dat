{
  "openapi": "3.0.3",
  "info": {
    "title": "Open Brewery DB API",
    "version": "1.0",
    "description": "Open Brewery DB is a free dataset and API for US and international breweries. No authentication required. Public API with open data.",
    "contact": {
      "url": "https://www.openbrewerydb.org"
    },
    "license": {
      "name": "MIT"
    },
    "x-jentic-source-url": "https://www.openbrewerydb.org/documentation",
    "x-no-auth-reason": "Open Brewery DB is a genuinely public, free API with no authentication required"
  },
  "servers": [
    {
      "url": "https://api.openbrewerydb.org",
      "description": "Open Brewery DB API"
    }
  ],
  "paths": {
    "/v1/breweries": {
      "get": {
        "summary": "List Breweries",
        "operationId": "listBreweries",
        "description": "Returns a list of breweries with optional filtering.",
        "parameters": [
          {
            "name": "by_city",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by city name"
          },
          {
            "name": "by_country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by country"
          },
          {
            "name": "by_dist",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sort by distance from point (lat,lon)"
          },
          {
            "name": "by_ids",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated list of brewery IDs"
          },
          {
            "name": "by_name",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by brewery name"
          },
          {
            "name": "by_state",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by state"
          },
          {
            "name": "by_postal",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by postal code"
          },
          {
            "name": "by_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "micro",
                "nano",
                "regional",
                "brewpub",
                "large",
                "planning",
                "bar",
                "contract",
                "proprietor",
                "closed"
              ]
            },
            "description": "Filter by brewery type"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sort field and direction"
          }
        ],
        "responses": {
          "200": {
            "description": "List of breweries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Brewery"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/breweries/{obdb_id}": {
      "get": {
        "summary": "Get Brewery by ID",
        "operationId": "getBrewery",
        "parameters": [
          {
            "name": "obdb_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Open Brewery DB ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Brewery details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Brewery"
                }
              }
            }
          }
        }
      }
    },
    "/v1/breweries/random": {
      "get": {
        "summary": "Get Random Brewery",
        "operationId": "getRandomBrewery",
        "parameters": [
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "maximum": 50
            },
            "description": "Number of random breweries"
          }
        ],
        "responses": {
          "200": {
            "description": "Random brewery(s)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Brewery"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/breweries/search": {
      "get": {
        "summary": "Search Breweries",
        "operationId": "searchBreweries",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search query"
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Brewery"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/breweries/meta": {
      "get": {
        "summary": "Get Breweries Metadata",
        "operationId": "getBreweriesMeta",
        "description": "Returns metadata about the filtered brewery results.",
        "parameters": [
          {
            "name": "by_city",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "by_country",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "by_name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "by_state",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "by_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metadata about breweries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "string"
                    },
                    "page": {
                      "type": "string"
                    },
                    "per_page": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Brewery": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "brewery_type": {
            "type": "string",
            "enum": [
              "micro",
              "nano",
              "regional",
              "brewpub",
              "large",
              "planning",
              "bar",
              "contract",
              "proprietor",
              "closed"
            ]
          },
          "address_1": {
            "type": "string"
          },
          "address_2": {
            "type": "string",
            "nullable": true
          },
          "address_3": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string"
          },
          "state_province": {
            "type": "string"
          },
          "postal_code": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "longitude": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "website_url": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "security": []
}
