{
  "openapi": "3.0.3",
  "info": {
    "title": "Tuya Cloud API",
    "description": "Tuya Cloud API provides IoT device management, control, and user management capabilities. Authentication uses HMAC-SHA256 signature-based authentication with client_id, timestamp, and access_token headers.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://developer.tuya.com/en/docs/cloud",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://openapi.tuyaus.com",
      "description": "Americas data center"
    },
    {
      "url": "https://openapi.tuyaeu.com",
      "description": "Europe data center"
    },
    {
      "url": "https://openapi.tuyacn.com",
      "description": "China data center"
    },
    {
      "url": "https://openapi.tuyain.com",
      "description": "India data center"
    }
  ],
  "security": [
    {
      "tuyaSignature": []
    }
  ],
  "paths": {
    "/v1.0/token": {
      "get": {
        "operationId": "getAccessToken",
        "summary": "Get an access token",
        "description": "Obtains an access token using client credentials. This token is required for all subsequent API calls.",
        "parameters": [
          {
            "name": "grant_type",
            "in": "query",
            "required": false,
            "description": "Authorization type. Use 1 for simple token.",
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Token response.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "access_token": { "type": "string" },
                        "expire_time": { "type": "integer", "description": "Token expiration in seconds." },
                        "refresh_token": { "type": "string" },
                        "uid": { "type": "string" }
                      }
                    },
                    "success": { "type": "boolean" },
                    "t": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1.0/token/{refresh_token}": {
      "get": {
        "operationId": "refreshAccessToken",
        "summary": "Refresh an access token",
        "parameters": [
          { "name": "refresh_token", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Refreshed token.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "access_token": { "type": "string" },
                        "expire_time": { "type": "integer" },
                        "refresh_token": { "type": "string" },
                        "uid": { "type": "string" }
                      }
                    },
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1.0/devices/{device_id}": {
      "get": {
        "operationId": "getDeviceDetails",
        "summary": "Get device details",
        "description": "Retrieve comprehensive information for a specific device.",
        "parameters": [
          { "name": "device_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Device details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": { "$ref": "#/components/schemas/Device" },
                    "success": { "type": "boolean" },
                    "t": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "modifyDeviceProperties",
        "summary": "Modify basic device properties",
        "description": "Update device metadata and settings such as name.",
        "parameters": [
          { "name": "device_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": { "type": "boolean" },
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteDevice",
        "summary": "Delete a device",
        "parameters": [
          { "name": "device_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Device deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": { "type": "boolean" },
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1.0/devices/{device_id}/status": {
      "get": {
        "operationId": "getDeviceStatus",
        "summary": "Get device status",
        "description": "Retrieve the current operational status of a device.",
        "parameters": [
          { "name": "device_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Device status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": { "type": "string" },
                          "value": {}
                        }
                      }
                    },
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1.0/devices/{device_id}/commands": {
      "post": {
        "operationId": "sendDeviceCommands",
        "summary": "Send commands to a device",
        "description": "Send control commands (properties/actions) to a device.",
        "parameters": [
          { "name": "device_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "commands": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string", "description": "Command code (data point code)." },
                        "value": { "description": "Command value." }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Commands sent.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": { "type": "boolean" },
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1.0/devices/{device_id}/functions": {
      "get": {
        "operationId": "getDeviceFunctions",
        "summary": "Get instruction set of a device",
        "description": "Retrieve the available functions/instruction set for a device.",
        "parameters": [
          { "name": "device_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Device functions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "category": { "type": "string" },
                        "functions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "code": { "type": "string" },
                              "desc": { "type": "string" },
                              "name": { "type": "string" },
                              "type": { "type": "string" },
                              "values": { "type": "string" }
                            }
                          }
                        }
                      }
                    },
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1.0/devices/{device_id}/specification": {
      "get": {
        "operationId": "getDeviceSpecification",
        "summary": "Get device specification and attributes",
        "parameters": [
          { "name": "device_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Device specification.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "category": { "type": "string" },
                        "functions": { "type": "array", "items": { "type": "object" } },
                        "status": { "type": "array", "items": { "type": "object" } }
                      }
                    },
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1.0/devices/details": {
      "post": {
        "operationId": "getDeviceDetailsBulk",
        "summary": "Query device details in bulk",
        "description": "Fetch details for multiple devices simultaneously.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_ids": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "List of device IDs (max 20)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk device details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Device" }
                    },
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1.0/devices/{device_id}/freeze-state": {
      "put": {
        "operationId": "setDeviceFreezeState",
        "summary": "Freeze or unfreeze a device",
        "parameters": [
          { "name": "device_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "freeze_state": { "type": "boolean", "description": "true to freeze, false to unfreeze." }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Freeze state updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": { "type": "boolean" },
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1.0/users/{uid}/devices": {
      "get": {
        "operationId": "getUserDevices",
        "summary": "Get devices for a user",
        "description": "Retrieve all devices associated with a specific user.",
        "parameters": [
          { "name": "uid", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "User devices.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Device" }
                    },
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1.0/users/{uid}": {
      "get": {
        "operationId": "getUserInfo",
        "summary": "Get user information",
        "parameters": [
          { "name": "uid", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "User details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "uid": { "type": "string" },
                        "username": { "type": "string" },
                        "email": { "type": "string" },
                        "mobile": { "type": "string" },
                        "country_code": { "type": "string" },
                        "create_time": { "type": "integer" },
                        "update_time": { "type": "integer" }
                      }
                    },
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "tuyaSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "sign",
        "description": "Tuya uses HMAC-SHA256 signature authentication. Required headers: client_id (your app ID), sign (HMAC-SHA256 signature), t (13-digit Unix timestamp in milliseconds), sign_method (HMAC-SHA256), access_token (for service API calls). The signature is computed as: sign = HMAC-SHA256(client_id + access_token + t + stringToSign, secret).toUpperCase(), where stringToSign = HTTPMethod + '\\n' + Content-SHA256 + '\\n' + Headers + '\\n' + URL."
      }
    },
    "schemas": {
      "Device": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "uid": { "type": "string" },
          "local_key": { "type": "string" },
          "category": { "type": "string" },
          "product_id": { "type": "string" },
          "product_name": { "type": "string" },
          "name": { "type": "string" },
          "icon": { "type": "string" },
          "ip": { "type": "string" },
          "lat": { "type": "string" },
          "lon": { "type": "string" },
          "sub": { "type": "boolean" },
          "time_zone": { "type": "string" },
          "online": { "type": "boolean" },
          "active_time": { "type": "integer" },
          "create_time": { "type": "integer" },
          "update_time": { "type": "integer" },
          "status": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": { "type": "string" },
                "value": {}
              }
            }
          }
        }
      }
    }
  }
}
