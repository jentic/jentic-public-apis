{"openapi":"3.1.0","info":{"title":"Caliu API","version":"1.0.0","description":"API-first notes app. Access your notes programmatically using an API key.\n\nCreate an API key in the app settings, then pass it as `Authorization: Bearer caliu_xxx` header.","contact":{"name":"Caliu","url":"https://caliuapp.com"}},"servers":[{"url":"https://api.caliuapp.com","description":"Production"}],"security":[{"bearerAuth":[]}],"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"API key (caliu_xxx) or session token"},"cookieAuth":{"type":"apiKey","in":"cookie","name":"caliu_session"}},"schemas":{"User":{"type":"object","properties":{"id":{"type":"string"},"email":{"type":"string","nullable":true,"format":"email"},"name":{"type":"string","nullable":true},"avatarUrl":{"type":"string","nullable":true},"createdAt":{"type":"string"},"updatedAt":{"type":"string"},"drawing_enabled":{"type":"boolean"}},"required":["id","email","name","createdAt","updatedAt"]},"UpdateMeRequest":{"type":"object","properties":{"name":{"type":"string","nullable":true,"maxLength":100}},"required":["name"]},"Note":{"type":"object","properties":{"id":{"type":"string"},"title":{"type":"string"},"content":{"type":"string"},"isPinned":{"type":"boolean"},"isEncrypted":{"type":"boolean"},"encryptionHint":{"type":"string","nullable":true},"wordCount":{"type":"number"},"createdAt":{"type":"string"},"updatedAt":{"type":"string"},"deletedAt":{"type":"string","nullable":true},"archivedAt":{"type":"string","nullable":true},"sharedAt":{"type":"string","nullable":true},"sortOrder":{"type":"number","nullable":true},"tags":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"}},"required":["id","name"]}}},"required":["id","title","content","isPinned","isEncrypted","encryptionHint","wordCount","createdAt","updatedAt","deletedAt","archivedAt","sharedAt","sortOrder"]},"Tag":{"type":"object","properties":{"id":{"type":"string"},"name":{"type"