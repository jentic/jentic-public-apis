d. Keyset pagination is a planned follow-up; mirrors GET /notes/trash today.","security":[{"bearerAuth":[]},{"cookieAuth":[]}],"responses":{"200":{"description":"Archived notes","content":{"application/json":{"schema":{"type":"object","properties":{"notes":{"type":"array","items":{"$ref":"#/components/schemas/Note"}}},"required":["notes"]}}}}}}},"/notes/{id}":{"get":{"tags":["Notes"],"summary":"Get note","security":[{"bearerAuth":[]},{"cookieAuth":[]}],"parameters":[{"schema":{"type":"string","description":"Resource ID","example":"abc123"},"required":true,"description":"Resource ID","name":"id","in":"path"}],"responses":{"200":{"description":"Note details","content":{"application/json":{"schema":{"type":"object","properties":{"note":{"$ref":"#/components/schemas/Note"}},"required":["note"]}}}},"404":{"description":"Not found","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}}}},"put":{"tags":["Notes"],"summary":"Update note","description":"Update a note. Supports optimistic concurrency via `expected_updated_at`.","security":[{"bearerAuth":[]},{"cookieAuth":[]}],"parameters":[{"schema":{"type":"string","description":"Resource ID","example":"abc123"},"required":true,"description":"Resource ID","name":"id","in":"path"}],"requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"content":{"type":"string","description":"Note content in markdown. Title is derived from the first line."},"is_pinned":{"type":"boolean"},"expected_updated_at":{"type":"string","description":"For optimistic concurrency — rejected if server version is newer"},"auto_sync_tags":{"type":"boolean","description":"Opt-in: when content is provided, extract #hashtags and replace the note's tags. Default false for backward compatibility — existing clients managing tags via /tags endpoints are unaffected."},"auto_link_notes":{"type":"boolean","description":"Opt-in: when content is provided, resolve bare [[No