        "responses": {
          "200": {
            "description": "Returns a list of GroupedPlayerStats \r\n***\r\nIncluded fields as default:\n* alternativeTeamNames\r\n* league\r\n* leagueName\r\n* alternativeLeagueNames\r\n* leagueType\r\n* firstSeason\r\n* lastSeason\r\n* numberOfSeasons\r\n* firstRegularSeason\r\n* lastRegularSeason\r\n* numberOfRegularSeasons\r\n* regularStats\r\n* firstPostseasonSeason\r\n* lastPostseasonSeason\r\n* numberOfPostseasonSeasons\r\n* postseasonType\r\n* postseasonName\r\n* postseasonStats\r\n***\r\nExcluded fields as default:\n* incompleteRegularStats\r\n* incompletePostseasonStats\r\n* totalStats\r\n* incompleteTotalStats\r\n* isActiveInScope\r\n* updatedAt\r\n***\r\nNot supported fields for this endpoint:\n* player\r\n* team\r\n* teamName\r\n* teamLogo\r\n* teamLogoUrl",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        },
                        {
                          "$ref": "#/components/schemas/ListMeta"
                        }
                      ]
                    },
                    "_links": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/PaginationLinks"
                        }
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GroupedPlayerStats"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/players/{id}/stats/all-time-team": {
      "get": {
        "tags": [
          "Player"
        ],
        "summary": "Returns a list of GroupedPlayerStats",
