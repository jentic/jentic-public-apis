              },
              "PTS": {
                "type": "number"
              },
              "PIM": {
                "type": "number"
              }
            },
            "nullable": true
          },
          "postseasonType": {
            "type": "string",
            "nullable": true
          },
          "postseasonName": {
            "type": "string",
            "nullable": true
          },
          "postseasonStats": {
            "properties": {
              "GP": {
