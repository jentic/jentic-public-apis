        "responses": {
          "200": {
            "description": "Returns a list of GroupedPlayerStats \r\n***\r\nIncluded fields as default:\n* player\r\n* firstSeason\r\n* lastSeason\r\n* numberOfSeasons\r\n* firstRegularSeason\r\n* lastRegularSeason\r\n* numberOfRegularSeasons\r\n* regularStats\r\n* firstPostseasonSeason\r\n* lastPostseasonSeason\r\n* numberOfPostseasonSeasons\r\n* postseasonType\r\n* postseasonName\r\n* postseasonStats\r\n***\r\nExcluded fields as default:\n* incompleteRegularStats\r\n* incompletePostseasonStats\r\n* totalStats\r\n* incompleteTotalStats\r\n* isActiveInScope\r\n* updatedAt\r\n***\r\nNot supported fields for this endpoint:\n* team\r\n* teamName\r\n* teamLogo\r\n* teamLogoUrl\r\n* alternativeTeamNames\r\n* league\r\n* leagueName\r\n* alternativeLeagueNames\r\n* leagueType",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        },
                        {
                          "$ref": "#/components/schemas/ListMeta"
                        }
                      ]
                    },
                    "_links": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/PaginationLinks"
                        }
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GroupedPlayerStats"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/teams/{id}/{season}/player-experiences/leagues": {
      "get": {
        "tags": [
          "Team"
        ],
        "summary": "Returns a list of LeagueExperiences",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "Numeric ID of the Team to get LeagueExperiences for"
          },
          {
            "in": "path",
            "name": "season",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Season of the {id} to get LeagueExperiences for"
          },
          {
            "in": "query",
            "name": "fields",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "league",
                  "GP",
                  "eliteprospectsUrlPath",
                  "league.*",
                  "*"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Specify custom response with available response fields.\r\n***\r\n*Fields included as default:* league, GP, eliteprospectsUrlPath"
          },
          {
            "$ref": "#/components/parameters/offsetParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          },
          {
            "in": "query",
            "name": "league",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
