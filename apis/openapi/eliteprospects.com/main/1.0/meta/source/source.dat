    "/teams/{id}/{season}/player-experiences": {
      "get": {
        "tags": [
          "Team"
        ],
        "summary": "Returns a list of GroupedPlayerStats",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "Numeric ID of the Team to get GroupedPlayerStats for"
          },
