                          "$ref": "#/components/schemas/PaginationLinks"
                        }
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Season"
                      }
                    }
                  }
                }
              }
            }
          }
        }
