        "responses": {
          "200": {
            "description": "Returns a list of PlayerStats \r\n***\r\nIncluded fields as default:\n* id\r\n* player\r\n* season\r\n* statsType\r\n* status\r\n* team\r\n* teamName\r\n* league\r\n* leagueName\r\n* leagueType\r\n* jerseyNumber\r\n* playerRole\r\n* contractType\r\n* regularStats\r\n* postseasonType\r\n* postseasonName\r\n* postseasonStats\r\n***\r\nExcluded fields as default:\n* playerAge\r\n* teamLogo\r\n* teamLogoUrl\r\n* leagueFullName\r\n* totalStats\r\n* statsProvider\r\n* clubTeamPlayerStats\r\n* isActiveSeason\r\n* updatedAt\r\n***\r\nNot supported fields for this endpoint:\n* coaches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        },
                        {
                          "$ref": "#/components/schemas/ListMeta"
                        }
                      ]
                    },
                    "_links": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/PaginationLinks"
                        }
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PlayerStats"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/player-stats/leagues": {
      "get": {
        "tags": [
          "PlayerStats"
        ],
        "summary": "Returns a list of CountByLeagues",
        "parameters": [
          {
            "in": "query",
            "name": "fields",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "league",
                  "count",
                  "league.*",
                  "*"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Specify custom response with available response fields.\r\n***\r\n*Fields included as default:* league, count"
          },
          {
            "$ref": "#/components/parameters/offsetParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "league",
                  "-league",
                  "count",
                  "-count"
                ]
              },
              "default": "league"
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Order of data set."
          },
          {
            "in": "query",
            "name": "id",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "required": false,
            "description": "Filter by id",
            "style": "form",
            "explode": false
          },
          {
            "in": "query",
            "name": "id:gt",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Filter by id greater than"
          },
          {
            "in": "query",
            "name": "statsType",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PlayerStatsType"
              }
            },
            "required": false,
            "description": "Filter by statsType",
            "style": "form",
            "explode": false
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "$ref": "#/components/schemas/PlayerStatsStatus"
            },
            "required": false,
            "description": "Filter by status"
          },
          {
            "in": "query",
            "name": "status:not",
            "schema": {
              "$ref": "#/components/schemas/PlayerStatsStatus"
            },
            "required": false,
            "description": "Filter by status not equal to"
          },
          {
            "in": "query",
