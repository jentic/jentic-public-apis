        "responses": {
          "200": {
            "description": "Returns a list of GroupedPlayerStats \r\n***\r\nIncluded fields as default:\n* player\r\n* alternativeTeamNames\r\n* leagueName\r\n* alternativeLeagueNames\r\n* firstSeason\r\n* lastSeason\r\n* numberOfSeasons\r\n* firstRegularSeason\r\n* lastRegularSeason\r\n* numberOfRegularSeasons\r\n* regularStats\r\n* firstPostseasonSeason\r\n* lastPostseasonSeason\r\n* numberOfPostseasonSeasons\r\n* postseasonType\r\n* postseasonName\r\n* postseasonStats\r\n***\r\nExcluded fields as default:\n* incompleteRegularStats\r\n* incompletePostseasonStats\r\n* totalStats\r\n* incompleteTotalStats\r\n* isActiveInScope\r\n* updatedAt\r\n***\r\nNot supported fields for this endpoint:\n* team\r\n* teamName\r\n* teamLogo\r\n* teamLogoUrl\r\n* league\r\n* leagueType",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        },
                        {
                          "$ref": "#/components/schemas/ListMeta"
                        }
                      ]
                    },
                    "_links": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/PaginationLinks"
                        }
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GroupedPlayerStats"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/teams/{id}/draft-selections": {
      "get": {
        "tags": [
          "Team"
        ],
        "summary": "Returns a list of DraftSelections",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "Numeric ID of the Team to get DraftSelections for"
          },
          {
            "in": "query",
            "name": "fields",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "draftType",
                  "year",
                  "round",
                  "overall",
                  "teamName",
                  "teamLogo",
                  "teamLogoUrl",
                  "player",
                  "playerTeamBeforeDraft",
                  "playerTeamStatsBeforeDraft",
                  "eliteprospectsUrlPath",
                  "updatedAt",
                  "_links",
                  "draftType.*",
                  "teamLogo.*",
                  "player.*",
                  "playerTeamBeforeDraft.*",
                  "playerTeamStatsBeforeDraft.*",
                  "*"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Specify custom response with available response fields.\r\n***\r\n*Fields included as default:* id, draftType, year, round, overall, teamName, teamLogo, teamLogoUrl, player, playerTeamBeforeDraft, playerTeamStatsBeforeDraft, eliteprospectsUrlPath, updatedAt, _links"
          },
          {
            "$ref": "#/components/parameters/offsetParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "-id",
                  "year",
                  "-year",
                  "round",
                  "-round",
                  "overall",
                  "-overall",
                  "player",
                  "-player",
                  "updatedAt",
                  "-updatedAt"
                ]
              },
              "default": "-year"
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Order of data set."
          },
          {
            "in": "query",
            "name": "id",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "required": false,
            "description": "Filter by id",
            "style": "form",
            "explode": false
          },
          {
            "in": "query",
            "name": "id:gt",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Filter by id greater than"
          },
          {
            "in": "query",
            "name": "draftType",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter by draftType slug"
          },
          {
            "in": "query",
            "name": "draftType:not",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter by draftType slug not equal to"
          },
          {
            "in": "query",
            "name": "player",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "required": false,
            "description": "Filter by player ID",
            "style": "form",
            "explode": false
          },
          {
            "in": "query",
            "name": "player.nationality",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter by player.nationality slug in ISO 3166-1 alpha-3"
          },
          {
            "in": "query",
            "name": "player.playerType",
            "schema": {
              "$ref": "#/components/schemas/PlayerType"
            },
            "required": false,
            "description": "Filter by player.playerType"
          },
          {
            "in": "query",
            "name": "player.position",
            "schema": {
              "$ref": "#/components/schemas/Position"
            },
            "required": false,
            "description": "Filter by player.position"
          },
          {
            "in": "query",
            "name": "player.dateOfBirth",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter by player.dateOfBirth"
          },
          {
            "in": "query",
            "name": "player.youthTeam",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter by player.youthTeam"
          },
          {
            "in": "query",
            "name": "year",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Filter by year"
          },
          {
            "in": "query",
            "name": "year:from",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Filter by year greater or equal to"
          },
          {
            "in": "query",
            "name": "year:to",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Filter by year less than or equal to"
          },
          {
            "in": "query",
            "name": "year:lastX",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Filter by year only last x"
          },
          {
            "in": "query",
            "name": "round",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Filter by round"
          },
          {
            "in": "query",
            "name": "playerTeamStatsBeforeDraft.league",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter by playerTeamStatsBeforeDraft.league slug"
          },
          {
            "in": "query",
            "name": "updatedAt:min",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "description": "Filter by updatedAt greater or equal to in ISO-8601 format for date and time"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a list of DraftSelections \r\n***\r\nIncluded fields as default:\n* id\r\n* draftType\r\n* year\r\n* round\r\n* overall\r\n* teamName\r\n* player\r\n* _links\r\n***\r\nExcluded fields as default:\n* teamLogo\r\n* teamLogoUrl\r\n* playerTeamBeforeDraft\r\n* playerTeamStatsBeforeDraft\r\n* eliteprospectsUrlPath\r\n* updatedAt\r\n***\r\nNot supported fields for this endpoint:\n* team",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        },
                        {
                          "$ref": "#/components/schemas/ListMeta"
                        }
                      ]
                    },
                    "_links": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/PaginationLinks"
                        }
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DraftSelection"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
