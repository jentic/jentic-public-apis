    "/teams/{id}/in-the-system/leagues": {
      "get": {
        "tags": [
          "Team"
        ],
        "summary": "Returns a list of CountByLeagues",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "Numeric ID of the Team to get CountByLeagues for"
          },
          {
            "in": "query",
            "name": "fields",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "league",
                  "count",
                  "league.*",
                  "*"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Specify custom response with available response fields.\r\n***\r\n*Fields included as default:* league, count"
          },
          {
            "$ref": "#/components/parameters/offsetParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "league",
                  "-league",
                  "count",
                  "-count"
                ]
              },
              "default": "league"
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Order of data set."
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a list of CountByLeagues \r\n***\r\nIncluded fields as default:\n* league\r\n* count\r\n***\r\nExcluded fields as default:\n",
