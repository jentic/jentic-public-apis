                  "playoffMedalClass",
                  "stats",
                  "postseason",
                  "info",
                  "updatedAt",
                  "season.*",
                  "team.*",
                  "teamLogo.*",
                  "stats.*",
                  "*"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Specify custom response with available response fields.\r\n***\r\n*Fields included as default:* id, season, team, teamSlug, teamName, teamLogo, teamLogoUrl, leagueSlug, leagueName, leagueFullName, group, position, medalClass, playoffMedalClass, stats, postseason, info, updatedAt"
          },
