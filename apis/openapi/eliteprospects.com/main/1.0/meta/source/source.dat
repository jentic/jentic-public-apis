        "responses": {
          "200": {
            "description": "Returns a list of Players \r\n***\r\nIncluded fields as default:\n* id\r\n* firstName\r\n* lastName\r\n* name\r\n* gender\r\n* status\r\n* playerType\r\n* position\r\n* dateOfBirth\r\n* nationality\r\n* _links\r\n***\r\nExcluded fields as default:\n* alternativeFirstName\r\n* alternativeLastName\r\n* alternativeName\r\n* initialOfFirstName\r\n* initialOfLastName\r\n* detailedPosition\r\n* shoots\r\n* catches\r\n* yearOfBirth\r\n* age\r\n* placeOfBirth\r\n* youthTeam\r\n* secondaryNationality\r\n* weight\r\n* height\r\n* contract\r\n* capHit\r\n* gameStatus\r\n* gameStatusInfo\r\n* views\r\n* imageUrl\r\n* imageCopyright\r\n* pronunciationUrl\r\n* verified\r\n* verifiedStyle\r\n* contactable\r\n* staff\r\n* latestStats\r\n* latestGameLogsAggregated\r\n* nhlRights\r\n* draftSelection\r\n* agencies\r\n* profileDescriptionAsHTML\r\n* scoutingReportUrl\r\n* scoutingReportThumbnailUrl\r\n* biographyAsHTML\r\n* playerStyles\r\n* links\r\n* eliteprospectsUrlPath\r\n* slug\r\n* isIndexable\r\n* updatedAt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        },
                        {
                          "$ref": "#/components/schemas/ListMeta"
                        }
                      ]
                    },
                    "_links": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/PaginationLinks"
                        }
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Player"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/players/{id}": {
      "get": {
        "tags": [
          "Player"
        ],
        "summary": "Returns a Player",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "Numeric ID of the Player to get"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a Player \r\n---\r\n## All fields are included by default",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        }
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Player"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/players/{id}/awards": {
      "get": {
        "tags": [
          "Player"
        ],
        "summary": "Returns a list of PlayerAwards",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "Numeric ID of the Player to get PlayerAwards for"
          },
          {
            "in": "query",
            "name": "fields",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "awardType",
                  "awardTypeName",
                  "awardTypeLeague",
                  "awardTypeLeagueSlug",
                  "season",
                  "extra",
                  "updatedAt",
                  "awardType.*",
                  "season.*",
                  "*"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Specify custom response with available response fields.\r\n***\r\n*Fields included as default:* id, awardType, awardTypeName, awardTypeLeague, awardTypeLeagueSlug, season, extra, updatedAt"
          },
          {
            "$ref": "#/components/parameters/offsetParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "id",
                  "-id",
                  "awardType",
                  "-awardType",
                  "awardType.league",
                  "-awardType.league",
                  "season",
                  "-season",
                  "extra",
                  "-extra",
                  "updatedAt",
                  "-updatedAt"
                ]
              },
              "default": "season"
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Order of data set."
          },
          {
            "in": "query",
            "name": "id",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
