            "explode": false,
            "required": false,
            "description": "Specify custom response with available response fields.\r\n***\r\n*Fields included as default:* team, teamName, teamLogo, teamLogoUrl, alternativeTeamNames, leagueName, alternativeLeagueNames, firstSeason, lastSeason, numberOfSeasons, firstRegularSeason, lastRegularSeason, numberOfRegularSeasons, regularStats, incompleteRegularStats, firstPostseasonSeason, lastPostseasonSeason, numberOfPostseasonSeasons, postseasonType, postseasonName, postseasonStats, incompletePostseasonStats, totalStats, incompleteTotalStats, isActiveInScope, updatedAt"
