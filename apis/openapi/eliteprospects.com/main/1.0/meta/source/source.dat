        "responses": {
          "200": {
            "description": "Returns a list of PlayerAwards \r\n***\r\nIncluded fields as default:\n* id\r\n* awardType\r\n* awardTypeName\r\n* awardTypeLeague\r\n* awardTypeLeagueSlug\r\n* season\r\n* extra\r\n***\r\nExcluded fields as default:\n* updatedAt\r\n***\r\nNot supported fields for this endpoint:\n* player",
