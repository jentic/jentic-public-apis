            "required": false,
            "description": "Filter by player.gender"
          },
          {
            "in": "query",
            "name": "showOnTransfersPage",
            "schema": {
              "type": "boolean"
            },
            "required": false,
            "description": "Filter by showOnTransfersPage"
          },
          {
            "in": "query",
            "name": "updatedAt:min",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "description": "Filter by updatedAt greater or equal to in ISO-8601 format for date and time"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a list of Years \r\n***\r\nIncluded fields as default:\n\r\n***\r\nExcluded fields as default:\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        },
                        {
                          "$ref": "#/components/schemas/ListMeta"
                        }
                      ]
                    },
                    "_links": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/PaginationLinks"
                        }
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/transfers/{id}": {
      "get": {
        "tags": [
          "Transfer"
        ],
        "summary": "Returns a Transfer",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "integer"
            },
            "required": true,
            "description": "Numeric ID of the Transfer to get"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a Transfer \r\n---\r\n## All fields are included by default",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        }
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/Transfer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
