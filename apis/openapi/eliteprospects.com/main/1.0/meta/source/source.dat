    "/leagues/{slug}": {
      "get": {
        "tags": [
          "League"
        ],
        "summary": "Returns a League",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Slug of the League to get"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a League \r\n---\r\n## All fields are included by default",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        }
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/League"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/leagues/{slug}/award-types": {
      "get": {
        "tags": [
          "League"
        ],
        "summary": "Returns a list of AwardTypes",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Slug of the League to get AwardTypes for"
          },
          {
            "in": "query",
            "name": "fields",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "slug",
                  "name",
                  "leagueSlug",
                  "types",
                  "links",
                  "eliteprospectsUrlPath",
                  "_links",
                  "updatedAt",
                  "links.*",
                  "*"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Specify custom response with available response fields.\r\n***\r\n*Fields included as default:* slug, name, leagueSlug, types, links, eliteprospectsUrlPath, _links, updatedAt"
          },
          {
            "$ref": "#/components/parameters/offsetParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "name",
                  "-name",
                  "updatedAt",
                  "-updatedAt"
                ]
              },
              "default": "name"
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Order of data set."
          },
          {
            "in": "query",
            "name": "name",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter by name"
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter by q"
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "$ref": "#/components/schemas/AwardType_Type"
            },
            "required": false,
            "description": "Filter by type"
          },
          {
            "in": "query",
            "name": "type:not",
            "schema": {
              "$ref": "#/components/schemas/AwardType_Type"
            },
            "required": false,
            "description": "Filter by type not equal to"
          },
          {
            "in": "query",
            "name": "updatedAt:min",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false,
            "description": "Filter by updatedAt greater or equal to in ISO-8601 format for date and time"
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a list of AwardTypes \r\n***\r\nIncluded fields as default:\n* slug\r\n* name\r\n* leagueSlug\r\n* _links\r\n***\r\nExcluded fields as default:\n* types\r\n* links\r\n* eliteprospectsUrlPath\r\n* updatedAt\r\n***\r\nNot supported fields for this endpoint:\n* league",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        },
                        {
                          "$ref": "#/components/schemas/ListMeta"
                        }
                      ]
                    },
                    "_links": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/PaginationLinks"
                        }
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AwardType"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/leagues/{slug}/demographics": {
      "get": {
        "tags": [
          "League"
        ],
        "summary": "Returns a list of Demographics",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Slug of the League to get Demographics for"
          },
          {
            "in": "query",
            "name": "fields",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "type",
                  "label",
                  "graphType",
                  "data",
                  "data.*",
                  "*"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "required": false,
            "description": "Specify custom response with available response fields.\r\n***\r\n*Fields included as default:* type, label, graphType, data"
          },
          {
            "$ref": "#/components/parameters/offsetParam"
          },
          {
            "$ref": "#/components/parameters/limitParam"
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "description": "Filter by type",
            "style": "form",
            "explode": false
          },
          {
            "in": "query",
            "name": "season",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter by season slug"
          },
          {
            "in": "query",
            "name": "LEAGUE_EXPERIENCE.leagues",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "description": "Filter by LEAGUE_EXPERIENCE.leagues",
            "style": "form",
            "explode": false
          },
          {
            "in": "query",
            "name": "LEAGUE.EXPERIENCE.leagues",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "required": false,
            "description": "Filter by LEAGUE.EXPERIENCE.leagues",
            "style": "form",
            "explode": false
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a list of Demographics \r\n***\r\nIncluded fields as default:\n* type\r\n* label\r\n* graphType\r\n* data\r\n***\r\nExcluded fields as default:\n",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        },
                        {
                          "$ref": "#/components/schemas/ListMeta"
                        }
                      ]
                    },
                    "_links": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/PaginationLinks"
                        }
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Demographics"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
