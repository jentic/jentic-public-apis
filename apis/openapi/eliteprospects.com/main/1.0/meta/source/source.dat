        "responses": {
          "200": {
            "description": "Returns a list of PlayerStats \r\n***\r\nIncluded fields as default:\n* id\r\n* season\r\n* statsType\r\n* status\r\n* team\r\n* teamName\r\n* league\r\n* leagueName\r\n* leagueType\r\n* jerseyNumber\r\n* playerRole\r\n* contractType\r\n* regularStats\r\n* postseasonType\r\n* postseasonName\r\n* postseasonStats\r\n***\r\nExcluded fields as default:\n* playerAge\r\n* teamLogo\r\n* teamLogoUrl\r\n* leagueFullName\r\n* totalStats\r\n* statsProvider\r\n* clubTeamPlayerStats\r\n* coaches\r\n* isActiveSeason\r\n* updatedAt\r\n***\r\nNot supported fields for this endpoint:\n* player",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "_meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Meta"
                        },
                        {
                          "$ref": "#/components/schemas/ListMeta"
                        }
                      ]
                    },
                    "_links": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/PaginationLinks"
                        }
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PlayerStats"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
