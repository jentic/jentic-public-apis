              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Provider"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado"
          }
        }
      }
    },
    "/v1/api/update_provider/{RUC}/{DNI}/": {
      "patch": {
        "summary": "Actualizar usuario del proveedor",
        "tags": [
          "Proveedores - Usuario"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "RUC",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "DNI",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuario actualizado correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Provider"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "No autorizado"
          },
          "404": {
            "description": "Usuario no encontrado"
          }
        }
      }
    },
    "/v1/api/delete_provider/{RUC}/{DNI}/": {
      "delete": {
        "summary": "Eliminar usuario del proveedor",
        "tags": [
          "Proveedores - Usuario"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "RUC",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "DNI",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Usuario eliminado correctamente"
          },
          "401": {
            "description": "No autorizado"
          },
          "404": {
            "description": "Usuario no encontrado"
          }
        }
      }
    },
    "/v1/api/change_password/{RUC}/{DNI}/": {
      "patch": {
        "summary": "Cambiar contraseña de usuario proveedor",
        "description": "Permite cambiar la contraseña de un usuario en base al **RUC** de la empresa y el **DNI** del usuario.",
        "tags": [
          "Proveedores - Usuario"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "RUC",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Número de RUC de la empresa."
          },
          {
            "name": "DNI",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "DNI del usuario que requiere el cambio de contraseña."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "password"
                ],
                "properties": {
                  "password": {
                    "type": "string",
                    "example": "nu3v4_C0ntr4$3ñ4"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contraseña cambiada exitosamente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string",
                      "example": "Contraseña actualizada con éxito."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error en la petición (RUC o DNI inválido)."
          },
          "401": {
            "description": "No autorizado (Token inválido o expirado)."
          },
          "500": {
            "description": "Error interno del servidor."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Invoice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "serie": {
            "type": "string"
          },
          "correlativo": {
            "type": "string"
          },
          "fecha_emision": {
            "type": "string"
          },
          "estado_evaluacion": {
            "type": "string"
          },
          "moneda": {
            "type": "string"
          },
          "fecha_recepcion": {
            "type": "string"
          }
        }
      },
      "ActualizarOrdenCompraRequest": {
        "type": "object",
        "properties": {
          "ordenCompra": {
            "type": "object",
            "properties": {
              "numeroOrden": {
                "type": "string",
                "example": "OC-1001"
              },
              "tipoOrden": {
                "type": "string",
                "example": "Suministro"
              },
              "fechaEmision": {
                "type": "string",
                "format": "date",
                "example": "2025-04-21"
              },
              "observaciones": {
                "type": "string",
                "example": "Observación general de la orden"
              },
              "total": {
                "type": "string",
                "example": "330.40"
              },
              "moneda": {
                "type": "string",
                "example": "PEN"
              },
              "proveedor": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "example": "Empresa Proveedora S.A.C."
                  },
                  "ruc": {
                    "type": "string",
                    "example": "20123456789"
                  },
                  "correo": {
                    "type": "string",
                    "format": "email",
                    "example": "proveedor@example.com"
                  },
                  "direccion": {
                    "type": "string",
                    "example": "Av. Prolongación Industrial 123, Lima, Perú"
                  }
                }
              },
              "cliente": {
                "type": "object",
                "properties": {
                  "nombre": {
                    "type": "string",
                    "example": "Empresa Cliente S.A.C."
                  },
                  "ruc": {
                    "type": "string",
                    "example": "20987654321"
                  },
                  "direccion": {
                    "type": "string",
                    "example": "Calle Comercial 456, Lima, Perú"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "contacto@cliente.com"
                  }
                }
              },
              "pdfOrden": {
                "type": "string",
                "format": "byte",
                "description": "Contenido del PDF codificado en Base64",
                "example": "JVBERi0xLjQKJc..."
              },
              "nombrePdfOrden": {
                "type": "string",
                "example": "OC-1001.pdf"
              }
            }
          },
          "detallesOrden": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "numeroNEC": {
                  "type": "string",
                  "example": "NEC-00001"
                },
                "montoNEC": {
                  "type": "string",
                  "example": "330.40"
                },
                "monedaNEC": {
                  "type": "string",
                  "example": "PEN"
                },
                "detalles": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "orden": {
                        "type": "string",
                        "example": "1"
                      },
                      "descripcion": {
                        "type": "string",
                        "example": "Descripción del producto o servicio"
                      },
                      "cantidad": {
                        "type": "string",
                        "example": "1"
                      },
                      "precioUnitario": {
                        "type": "string",
                        "example": "280.00"
                      },
                      "igv": {
                        "type": "string",
                        "example": "50.40"
                      },
                      "total": {
                        "type": "string",
                        "example": "330.40"
                      },
                      "moneda": {
                        "type": "string",
                        "example": "PEN"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "PurchaseOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "number": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "description": "Moneda (PEN, USD, EUR)"
          },
          "status": {
            "type": "string"
          },
          "total": {
            "type": "number",
            "format": "float"
          },
          "issue_date": {
            "type": "string",
            "format": "date"
          },
          "oc_type": {
            "type": "string"
          },
          "sn": {
            "type": "string"
          },
          "sn_number": {
            "type": "string"
          },
          "eval_status": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3
            ]
          },
          "reception_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "Company": {
        "type": "object",
        "required": [
          "ruc",
          "name",
          "direccion",
          "telefono",
          "correo"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "PROVEEDORES Y SERVICIOS SAC"
          },
          "ruc": {
            "type": "string",
            "example": "20481234567"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "jgonzales@demo.com"
          },
          "description": {
            "type": "string",
            "example": "Descripcion"
          },
          "active": {
            "type": "boolean",
            "example": true
          },
          "phone": {
            "type": "string",
            "example": "987654321"
          },
          "first_name": {
            "type": "string",
            "example": "-"
          },
          "last_name": {
            "type": "string",
            "example": "-"
          }
        }
      },
      "CompanyUpdate": {
        "type": "object",
        "properties": {
          "razon_social": {
            "type": "string",
            "example": "NUEVA RAZÓN SOCIAL SAC"
          },
          "direccion": {
            "type": "string",
            "example": "Av. Nueva Dirección 456 - Arequipa"
          },
          "telefono": {
            "type": "string",
            "example": "012345679"
          },
          "correo": {
            "type": "string",
            "format": "email",
            "example": "nuevo-contacto@proveedores.com"
          }
        }
      },
      "Provider": {
        "type": "object",
        "required": [
          "dni",
          "nombres",
          "apellidos",
          "correo",
          "telefono"
        ],
        "properties": {
          "username": {
            "type": "string",
            "format": "email",
            "example": "jgonzales@demo.com"
          },
          "first_name": {
            "type": "string",
            "example": "Juan Carlos"
          },
          "last_name": {
            "type": "string",
            "example": "González Ríos"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "jgonzales@demo.com"
          },
          "dni": {
            "type": "string",
            "example": "71023568"
          },
          "phone": {
            "type": "string",
            "example": "999999999"
          },
          "address": {
            "type": "string",
            "example": "Av. Del Aire 123"
          },
          "is_active": {
            "type": "boolean",
            "enum": [
              true,
              false
            ],
            "example": true
          }
        }
      },
      "ProviderUpdate": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "format": "email",
            "example": "jgonzales@demo.com"
          },
          "first_name": {
            "type": "string",
            "example": "Juan Carlos"
          },
          "last_name": {
            "type": "string",
            "example": "González Ríos"
          },
          "phone": {
            "type": "string",
            "example": "999999999"
          },
          "ruc": {
            "type": "string",
            "example": "20202020202"
          },
          "address": {
            "type": "string",
            "example": "Av. Del Aire 123"
          },
          "dni": {
            "type": "string",
            "example": "71023568"
          },
          "is_active": {
            "type": "boolean",
            "enum": [
              true,
              false
            ],
            "example": true
          }
        }
      }
    }
  }
}