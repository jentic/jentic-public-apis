  "paths": {
    "/api/token/": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Obtener token de autenticación",
        "description": "Token de Autenticación para el uso de los APIs. Este token se usa en el header `Authorization: Bearer <TOKEN>` en las demás solicitudes.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ruc": {
                    "type": "string",
                    "example": "20123456789"
                  },
                  "username": {
                    "type": "string",
                    "example": "usuario@demo.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "tu_contraseña"
                  }
                },
                "required": [
                  "ruc",
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token generado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "refresh": {
                      "type": "string"
                    },
                    "access": {
                      "type": "string"
                    },
                    "username": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "is_staff": {
                      "type": "boolean"
                    },
                    "is_superuser": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "refresh": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "access": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                  "username": "usuario@demo.com",
                  "email": "usuario@demo.com",
                  "is_staff": true,
                  "is_superuser": true
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "detail": "No active account found with the given credentials"
                }
              }
            }
          },
          "400": {
            "description": "Error de parseo JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "detail": "..."
                }
              }
            }
          }
        }
      }
    },
    "/api/purchase_order/": {
      "post": {
        "tags": [
          "Órdenes de Compra"
        ],
        "summary": "Crear una nueva orden de compra",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ordenCompra": {
                    "type": "object",
                    "properties": {
                      "numeroOrden": {
                        "type": "string",
                        "example": "OC-0001"
                      },
                      "tipoOrden": {
                        "type": "string",
                        "example": "Suministro"
                      },
                      "fechaEmision": {
                        "type": "string",
                        "format": "date",
                        "example": "2025-06-06"
                      },
                      "observaciones": {
                        "type": "string",
                        "example": "Orden de compra de prueba"
                      },
                      "total": {
                        "type": "string",
                        "example": "1234.56"
                      },
                      "moneda": {
                        "type": "string",
                        "example": "USD"
                      },
                      "proveedor": {
                        "type": "object",
                        "properties": {
                          "nombre": {
                            "type": "string",
                            "example": "PROVEEDOR S.A.C."
                          },
                          "ruc": {
                            "type": "string",
                            "example": "20123456789"
                          },
                          "correo": {
                            "type": "string",
                            "example": "proveedor@example.com"
                          },
                          "direccion": {
                            "type": "string",
                            "example": "Av. Principal 123, Lima"
                          }
                        }
                      },
                      "cliente": {
                        "type": "object",
                        "properties": {
                          "nombre": {
                            "type": "string",
                            "example": "CLIENTE S.R.L."
                          },
                          "ruc": {
                            "type": "string",
                            "example": "20987654321"
                          },
                          "direccion": {
                            "type": "string",
                            "example": "Calle Secundaria 456, Arequipa"
                          },
                          "email": {
                            "type": "string",
                            "example": "cliente@example.com"
                          }
                        }
                      },
                      "pdfOrden": {
                        "type": "string",
                        "example": "base64_pdf_aqui"
                      },
                      "nombrePdfOrden": {
                        "type": "string",
                        "example": "OC-0001.pdf"
                      }
                    }
                  },
                  "detallesOrden": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "numeroNEC": {
                          "type": "string",
                          "example": "NEC-00001"
                        },
                        "montoNEC": {
                          "type": "string",
                          "example": "1234.56"
                        },
                        "monedaNEC": {
                          "type": "string",
                          "example": "USD"
                        },
                        "detalles": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "orden": {
                                "type": "string",
                                "example": "1"
                              },
                              "descripcion": {
                                "type": "string",
                                "example": "Producto A - Descripción genérica"
                              },
                              "cantidad": {
                                "type": "string",
                                "example": "2"
                              },
                              "precioUnitario": {
                                "type": "string",
                                "example": "500.00"
                              },
                              "igv": {
                                "type": "string",
                                "example": "234.56"
                              },
                              "total": {
                                "type": "string",
                                "example": "1234.56"
                              },
                              "moneda": {
                                "type": "string",
                                "example": "USD"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Orden de compra creada exitosamente (sin response body)"
          },
          "400": {
            "description": "Error en los datos enviados"
          },
          "401": {
            "description": "No autorizado - Token inválido o ausente"
          }
        }
      },
      "get": {
        "tags": [
          "Órdenes de Compra"
        ],
        "summary": "Consultar órdenes de compra",
        "description": "Consulta las órdenes de compra mediante filtros opcionales.",
        "operationId": "getPurchaseOrders",
        "parameters": [
          {
            "name": "number",
            "in": "query",
            "description": "Número de orden de compra",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "description": "Moneda (Soles=1, Dólares=2, Euros=3)",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Estado de la orden de compra (Pendiente=0, Observado=1, Completado=2, En Revisión=3, Parcial=4)",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1,
                2,
                3,
                4
              ]
            }
          },
          {
            "name": "total",
            "in": "query",
            "description": "Total de la orden de compra",
            "required": false,
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "issue_date",
            "in": "query",
            "description": "Fecha de emisión de inicio (dd-mm-yyyy)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "issue_date_end",
            "in": "query",
            "description": "Fecha de emisión final (dd-mm-yyyy)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "oc_type",
            "in": "query",
            "description": "Tipo de orden de compra (Suministro=0, Servicio=1)",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          {
            "name": "sn",
            "in": "query",
            "description": "Número de serie",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sn_number",
            "in": "query",
            "description": "Número correlativo",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "eval_status",
            "in": "query",
            "description": "Estado de evaluación (Pendiente=0, Observado=1, Aceptado=2, Rechazado=3)",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1,
                2,
                3
              ]
            }
          },
          {
            "name": "reception_date",
            "in": "query",
            "description": "Fecha de recepción inicial (dd-mm-yyyy)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "reception_date_end",
            "in": "query",
            "description": "Fecha de recepción final (dd-mm-yyyy)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de órdenes de compra",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PurchaseOrder"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Parámetros inválidos"
          },
          "401": {
            "description": "No autorizado - Token inválido o ausente"
          }
        }
      }
    },
    "/purchase_order/{numeroOrden}/": {
      "put": {
        "summary": "Actualizar orden de compra",
        "description": "Actualiza una Orden de compra existente. Para actualizar la información, debe de enviar todos los tags. En caso de que se desee adicionar información adicional configurada previamente en el Configurador de Órdenes de Compra, enviar todos los tags más los nuevos campos.",
        "tags": [
          "Órdenes de Compra"
        ],
        "parameters": [
          {
            "name": "numeroOrden",
            "in": "path",
            "required": true,
            "description": "Número único de la orden de compra a actualizar",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActualizarOrdenCompraRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Orden actualizada exitosamente"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "Token inválido o expirado"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "summary": "Eliminar orden de compra",
        "description": "Elimina una orden de compra según su número único.",
        "tags": [
          "Órdenes de Compra"
        ],
        "parameters": [
          {
            "name": "numeroOrden",
            "in": "path",
            "required": true,
            "description": "Número único de la orden de compra a eliminar",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Orden eliminada exitosamente"
          },
          "404": {
            "description": "Orden no encontrada"
          },
          "401": {
            "description": "Token inválido o expirado"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
