            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sn_number",
            "in": "query",
            "description": "Número correlativo",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "issue_date",
            "in": "query",
            "description": "Fecha de emisión de inicio (formato DD-MM-YYYY)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "issue_date_end",
            "in": "query",
            "description": "Fecha de emisión de fin (formato DD-MM-YYYY)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "eval_status",
            "in": "query",
            "description": "Estado de evaluación (Pendiente=0, Observado=1, Aceptado=2, Rechazado=3)",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1,
                2,
                3
              ]
            }
          },
          {
            "name": "currency",
            "in": "query",
            "description": "Moneda (Soles=1, Dólares=2, Euros=3)",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3
              ]
            }
          },
          {
            "name": "reception_date",
            "in": "query",
            "description": "Fecha de recepción de inicio (formato DD-MM-YYYY)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reception_date_end",
            "in": "query",
            "description": "Fecha de recepción de fin (formato DD-MM-YYYY)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
