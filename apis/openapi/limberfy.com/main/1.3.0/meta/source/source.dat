                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "next": {
                      "type": "string",
                      "nullable": true
                    },
                    "previous": {
                      "type": "string",
                      "nullable": true
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Invoice"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado - Token inválido o ausente"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/api/register_company/": {
      "post": {
        "summary": "Registrar empresa del proveedor",
        "tags": [
          "Proveedores - Empresa"
        ],
        "description": "Crea una nueva empresa asociada a un proveedor utilizando su razón social, RUC y otros datos representativos.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "ruc",
                  "phone",
                  "address",
                  "first_name",
                  "last_name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "4.0 TECNOLOGIA Y MARKETING E.I.R.L"
                  },
                  "ruc": {
                    "type": "string",
                    "example": "20602997040"
                  },
                  "phone": {
                    "type": "string",
                    "example": "123456789"
                  },
                  "address": {
                    "type": "string",
                    "example": "direccion fiscal"
                  },
                  "first_name": {
                    "type": "string",
                    "example": "Danny"
                  },
                  "last_name": {
                    "type": "string",
                    "example": "Caldas"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Empresa registrada exitosamente."
          },
          "400": {
            "description": "Error en la solicitud. Validar campos requeridos."
          },
          "401": {
            "description": "No autorizado. Token inválido o ausente."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/api/get_companies/": {
      "get": {
        "summary": "Listar empresas del proveedor",
        "tags": [
          "Proveedores - Empresa"
        ],
        "responses": {
          "200": {
            "description": "Lista de empresas proveedoras obtenida exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Company"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autorizado"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/api/update_company/{RUC}/": {
      "patch": {
        "summary": "Actualizar empresa proveedora",
        "tags": [
          "Proveedores - Empresa"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "RUC",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompanyUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Empresa actualizada correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "No autorizado"
          },
