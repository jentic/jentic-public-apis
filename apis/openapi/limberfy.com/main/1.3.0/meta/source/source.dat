          }
        }
      }
    },
    "/v1/api/delete_company/{RUC}/": {
      "delete": {
        "summary": "Eliminar empresa proveedora",
        "tags": [
          "Proveedores - Empresa"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "RUC",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Empresa eliminada correctamente"
          },
          "401": {
            "description": "No autorizado"
          },
          "404": {
            "description": "Empresa no encontrada"
          }
        }
      }
    },
    "/v1/api/register_provider/": {
      "post": {
        "summary": "Registrar usuario de la empresa del proveedor",
        "tags": [
          "Proveedores - Usuario"
        ],
        "description": "Crea una cuenta de usuario asociada a una empresa proveedora. Este usuario podrá gestionar órdenes y documentos dentro de la plataforma.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "first_name",
                  "last_name",
                  "phone",
                  "password",
                  "ruc",
                  "address",
                  "dni",
                  "role"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "format": "email",
                    "example": "danny.caldas123456@4puntocero.com.pe"
                  },
                  "first_name": {
                    "type": "string",
                    "example": "Danny"
                  },
                  "last_name": {
                    "type": "string",
                    "example": "Caldas"
                  },
                  "phone": {
                    "type": "string",
                    "example": "987654321"
                  },
                  "password": {
                    "type": "string",
                    "example": "123456789"
                  },
                  "ruc": {
                    "type": "string",
                    "example": "20602997040"
                  },
                  "address": {
                    "type": "string",
                    "example": "direccion"
                  },
                  "dni": {
                    "type": "string",
                    "example": "71528612"
                  },
                  "role": {
                    "type": "integer",
                    "enum": [
                      4
                    ],
                    "example": 4,
                    "description": "Rol del usuario. Actualmente debe enviarse el valor `4` para usuarios proveedores."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario registrado exitosamente."
          },
          "400": {
            "description": "Error en la solicitud. Validar campos requeridos."
          },
          "401": {
            "description": "No autorizado. Token inválido o ausente."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/api/get_providers/{RUC}/": {
      "get": {
        "summary": "Listar usuarios de la empresa proveedora",
        "tags": [
          "Proveedores - Usuario"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "RUC",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de usuarios obtenida exitosamente",
