      "KsefTaxReportSetting": {
        "type": "object",
        "description": "Represents a tax report settings for 'KSeF (Krajowy System e-Faktur)' as an object",
        "properties": {
          "code": {
            "type": "string",
            "example": "ksef",
            "description": "The Tax Report Authority code.",
            "enum": [
              "ksef"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date-time",
            "example": "2024-07-09T00:00:00.000Z",
            "description": "Date when the Tax Report Setting was enabled. If not provided, the current date and time will be used..",
            "nullable": true
          },
          "auto_generate": {
            "type": "boolean",
            "example": true,
            "default": true,
            "description": "Generate the Tax Report automatically"
          },
          "auto_send": {
            "type": "boolean",
            "example": true,
            "default": true,
            "description": "Send the Tax Report automatically"
          },
          "enabled": {
            "type": "boolean",
            "example": true,
            "default": true,
            "description": "Represents if the tax report setting is enabled"
          },
          "credit_note_code": {
            "type": "string",
            "example": "1",
            "enum": [
              "1",
              "2",
              "3"
            ],
            "nullable": false,
            "description": "Default type of effect of correction in the records for VAT:\n* `1` - Correction with effect on the date of recognition of the original invoice.\n* `2` - Correction with effect on the date of issue of the corrective invoice.\n* `3` - Correction with effect on a different date, including when the dates are different for different items of the corrective invoice.\n\nThis setting applies to invoices with type codes KOR, KOR_ZAL, or KOR_ROZ. When creating a corrective invoice,\nyou must also specify the `amended_ksef_number` field in the TaxReport with the KSeF reference number of the original invoice.\n"
          },
          "type_operation": {
            "type": "string",
            "example": "services",
            "description": "Default type of Operation.",
            "enum": [
              "services",
              "goods"
            ],
            "nullable": true
          },
          "certificate": {
            "type": "string",
            "format": "byte",
            "description": "[BETA] Self-signed certificate in PKCS#12 (.p12 or .pfx) format encoded in base64 (without padding or line breaks).\n\n**Requirements:**\n- Must contain both the certificate and private key\n- Subject must match your account's Polish NIP (Tax Identification Number)\n- Required only when creating a KSeF tax report setting for the first time\n- For updates, this field is optional and can be omitted to keep the existing certificate\n\n**How to encode your certificate:**\n```bash\nbase64 -w 0 your-certificate.p12\n```\n",
            "example": "MIIKZAIBAzCCCh4GCSqGSIb3DQEHAaCCCg8EggoLMIIKBzCCBXcGCSqGSIb3...",
            "nullable": false,
            "writeOnly": true
          },
          "certificate_pin": {
            "type": "string",
            "description": "[BETA] Password/PIN for the PKCS#12 certificate. Required when creating a KSeF tax report setting.\n",
            "example": "MySecurePassword123",
            "nullable": false,
            "writeOnly": true
          },
          "locked": {
            "type": "boolean",
            "example": true,
            "description": "Cannot be completely modified or deleted",
            "readOnly": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2024-06-06T11:51:57Z",
            "description": "Date when the Tax Report Setting was created",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2024-06-06T11:51:57Z",
            "description": "Date when the Tax Report Setting was updated",
            "readOnly": true
          }
        }
      },
