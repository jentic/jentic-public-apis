                "type": "string",
                "example": "xml.ubl.invoice.bis3",
                "description": "Document type code defined for the Company"
              },
              "other_document_type_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "example": "xml.ubl.invoice.pint.billing.aunz.v1"
