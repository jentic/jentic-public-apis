                }
              }
            }
          }
        },
        "x-scopes": [
          "voice:webrtc"
        ],
        "x-required-scopes": [
          "voice:webrtc"
        ],
        "x-rate-limit": {
          "requestsPerMinute": 600
        },
        "x-demo-eligible": true
      }
    }
