                                  "text"
                                ],
                                "additionalProperties": {}
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "transcript_provider": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
