    "/v1/calls/{id}/hangup": {
      "post": {
        "operationId": "v1_calls_id_hangup_post",
        "tags": [
          "Calls"
        ],
        "summary": "Hang up a call",
        "description": "Ends a call or cancels an unused browser calling ticket. Idempotent for terminal calls. mode=setup_failed records a browser setup error and cancels only unused tickets; mode=cancel_setup cancels only unused tickets. Both setup modes leave originated calls untouched. With no mode, active calls are hung up normally.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": true,
            "schema": {
              "default": "hangup",
              "type": "string",
              "enum": [
                "hangup",
                "cancel_setup",
                "setup_failed"
              ]
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "UUID — when present, deduplicates repeat submissions. See /api-reference/idempotency.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              }
