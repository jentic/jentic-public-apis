    "/v1/phone-numbers/{id}/cnam-status": {
      "get": {
        "operationId": "v1_phone_numbers_id_cnam_status_get",
        "tags": [
          "Phone Numbers"
        ],
        "summary": "Check live CNAM status",
        "description": "Queries the carrier for the current CNAM status. A pending name is promoted to APPROVED only when the carrier reports that same name as enabled.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
