      "get": {
        "operationId": "v1_phone_numbers_search_get",
        "tags": [
          "Phone Numbers"
        ],
        "summary": "Search available phone numbers",
        "description": "Query carrier inventory for numbers matching the given filters. Returns up to 50 results per call.",
        "parameters": [
