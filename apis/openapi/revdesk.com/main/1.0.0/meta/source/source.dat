    "/v1/calls/{id}/test-result": {
      "patch": {
        "operationId": "v1_calls_id_test_result_patch",
        "tags": [
          "Calls",
          "Phone Numbers"
        ],
        "summary": "Record a spam-label test result",
        "description": "Records what a recipient handset displayed for a call placed through the spam-label test endpoint. Only calls already marked as spam-label tests can be annotated.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "UUID — when present, deduplicates repeat submissions. See /api-reference/idempotency.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "BUSINESS_NAME",
                      "LOCATION",
                      "NUMBER_ONLY",
                      "SPAM",
                      "NO_CALL"
                    ]
                  },
                  "observed_label": {
                    "default": "",
                    "type": "string",
                    "maxLength": 160
                  },
                  "callback_verified": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "outcome",
                  "observed_label",
                  "callback_verified"
                ],
                "additionalProperties": false
