      "post": {
        "operationId": "v1_number_health_sets_post",
        "tags": [
          "Number Health"
        ],
        "summary": "Create a Number Set",
        "description": "Creates an organization-scoped clinic/purpose set from owned phone numbers.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "UUID — when present, deduplicates repeat submissions. See /api-reference/idempotency.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120
                  },
                  "team_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "use_case": {
                    "default": "Expected customer communications",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 240
                  },
                  "expected_daily_calls": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "identification_guidance": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "members": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "phone_id": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "PRIMARY",
                            "ALTERNATE"
                          ]
                        },
                        "state": {
                          "default": "ACTIVE",
                          "type": "string",
                          "enum": [
                            "PREPARING",
                            "ACTIVE",
                            "STANDBY"
                          ]
                        },
                        "outbound_enabled": {
                          "default": true,
                          "type": "boolean"
                        },
                        "priority": {
                          "default": 0,
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "phone_id",
                        "role",
                        "state",
                        "outbound_enabled",
                        "priority"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "name",
                  "use_case",
                  "members"
                ],
                "additionalProperties": false
              }
            }
          }
        },
