              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "objective": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contact_id": {
                    "type": "string"
                  },
                  "opportunity_id": {
                    "type": "string"
                  },
                  "deadline": {},
                  "success_criteria": {
                    "type": "object",
                    "properties": {
                      "outcome_kinds": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "additionalProperties": false
                  },
                  "guardrails": {
                    "type": "object",
                    "properties": {
                      "channels": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "quiet_hours": {
