    "/v1/number-health/sessions/{id}": {
      "get": {
        "operationId": "v1_number_health_sessions_id_get",
        "tags": [
          "Number Health"
        ],
        "summary": "Resume a Number Health test session",
        "description": "Returns the saved session scope, tester, queue, and server-backed attempts.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
