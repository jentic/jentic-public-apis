    "/v1/number-health/sessions": {
      "post": {
        "operationId": "v1_number_health_sessions_post",
        "tags": [
          "Number Health"
        ],
        "summary": "Start a resumable Number Health test session",
        "description": "Saves a consented tester, test mode, and immutable selected-number queue for a workspace.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "UUID — when present, deduplicates repeat submissions. See /api-reference/idempotency.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tester": {
                    "type": "object",
                    "properties": {
                      "alias": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 80
                      },
                      "phone_number": {
                        "type": "string",
                        "pattern": "^\\+[1-9]\\d{1,14}$"
                      },
                      "carrier": {
                        "type": "string",
                        "enum": [
                          "ATT",
                          "TMOBILE",
                          "VERIZON",
                          "OTHER",
                          "UNKNOWN"
                        ]
                      },
                      "consented": {
                        "type": "boolean",
                        "const": true
                      }
                    },
                    "required": [
                      "alias",
                      "phone_number",
                      "carrier",
                      "consented"
                    ],
                    "additionalProperties": false
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "RAPID_AUDIT",
                      "HUMAN_READINESS",
                      "CONNECTIVITY_QA"
                    ]
                  },
                  "scope": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "ALL",
                          "TEAM",
                          "NUMBER_SET",
                          "AREA_CODE",
                          "FLAGGED",
                          "NEEDS_DATA"
                        ]
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  "compare_alternates": {
                    "default": true,
                    "type": "boolean"
