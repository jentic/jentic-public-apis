                      "type": "object",
                      "properties": {
                        "call_id": {
                          "type": "string"
                        },
                        "outcome": {
                          "type": "string",
                          "enum": [
                            "BUSINESS_NAME",
                            "LOCATION",
                            "NUMBER_ONLY",
                            "SPAM",
                            "NO_CALL"
