    "/v1/sms/config": {
      "get": {
        "operationId": "v1_sms_config_get",
        "tags": [
          "SMS"
        ],
        "summary": "Get workspace SMS auto-reply settings",
        "description": "Returns the workspace-wide SMS auto-reply configuration. `auto_reply_enabled: false` is one-way SMS — inbound texts are still received, the AI just doesn't auto-respond. Per-number overrides are managed on /v1/phone-numbers/{id}/sms-config.",
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/XRateLimitLimit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/XRateLimitRemaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/XRateLimitReset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "auto_reply_enabled": {
                          "type": "boolean"
                        },
                        "reply_delay_seconds": {
                          "type": "number"
                        },
                        "default_prompt": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "auto_reply_enabled",
                        "reply_delay_seconds",
                        "default_prompt"
                      ],
                      "additionalProperties": false
                    }
                  },
