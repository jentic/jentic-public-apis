                        "required": [
                          "from",
                          "to"
                        ],
                        "additionalProperties": false
                      },
                      "max_touches": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "max_touches_since_reply": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "min_hours_between_touches": {
                        "type": "number",
                        "exclusiveMinimum": 0
