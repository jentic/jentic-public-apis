{
  "openapi": "3.0.1",
  "info": {
    "title": "GDSO Ambassador Service API",
    "description": "This API shows how you can access the features of the TLDS service without using a UI. ",
    "termsOfService": "https://gdso.org/getattachment/Members-description/Technical-documentation/Section/Terms-of-Use/GDSO-GeneralTermsofUse_Production_FEB2023-(1).pdf?lang=en-US",
    "contact": {
      "email": "info@gdso.org"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/gdso.org/gdso-ambassador-service-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://tlds-dev.onboard.tlds.gdso.org",
      "description": "Dev environment"
    }
  ],
  "tags": [
    {
      "name": "tyres",
      "description": "Contains endpoints for retrieving tyre history and sending tyre declarations",
      "externalDocs": {
        "description": "Find out more",
        "url": "https://docs.onboard.tlds.gdso.org"
      }
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/ambassador/api/tyres/history/{tyreUii}": {
      "get": {
        "parameters": [
          {
            "name": "tyreUii",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "tags": [
          "tyres"
        ],
        "summary": "Retrieve Tyre History from Manufacturer",
        "description": "",
        "operationId": "getTyreHistory",
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetHistoryResponseData"
                },
                "examples": {
                  "Tyres with several declaration types": null,
                  "Tyres with only birth declaration": null
                }
              }
            }
          },
          "404": {
            "description": "Tyre UII not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Tyre UII not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ambassador/api/declarations/{declarationType}": {
      "post": {
        "parameters": [
          {
            "name": "declarationType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "collection",
                "retreading",
                "recycling"
              ]
            }
          }
        ],
        "tags": [
          "tyres"
        ],
        "summary": "Send declaration to manufacturer",
        "description": "Send a collection, retreading, or recycling declaration for a tyre",
        "operationId": "postDeclaration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/CollectionDeclaration"
                  },
                  {
                    "$ref": "#/components/schemas/RetreadingDeclaration"
                  },
                  {
                    "$ref": "#/components/schemas/RecyclingDeclaration"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "guid": {
                      "type": "string",
                      "example": "6B29FC40-CA47-1067-B31D-00DD010662DA"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "GUID is missing"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Tyre UII not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetHistoryResponseData": {
        "type": "object",
        "properties": {
          "birth": {
            "$ref": "#/components/schemas/BirthDeclaration"
          },
          "collection": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectionDeclaration"
            }
          },
          "retreading": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RetreadingDeclaration"
            }
          },
          "recycling": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecyclingDeclaration"
            }
          }
        }
      },
      "InputData": {
        "type": "object",
        "description": "Input data for declaration",
        "required": [
          "declarationType",
          "guid"
        ],
        "properties": {
          "declarationType": {
            "type": "string",
            "enum": [
              "collection",
              "retreading",
              "recycling"
            ],
            "description": "Type of declaration"
          },
          "guid": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the declaration"
          },
          "correction": {
            "type": "string",
            "format": "uuid",
            "description": "GUID of the declaration to correct (if this is a correction)"
          }
        },
        "additionalProperties": true
      },
      "BirthDeclaration": {
        "type": "object",
        "description": "Birth declaration",
        "properties": {
          "uii": {
            "type": "string",
            "description": "(Private) Unique Item Identifier - SGTIN-96 following Pure identity EPC URN (GS1 EPCIS) format",
            "example": "urn:epc:id:sgtin:12345678.04444.2222222"
          },
          "product": {
            "$ref": "#/components/schemas/BirthProduct"
          },
          "dotTin": {
            "type": "object",
            "properties": {
              "factoryCode": {
                "type": "string",
                "description": "Production zone/plant of the tire",
                "example": "B3"
              },
              "sizeCode": {
                "type": "string",
                "description": "tire size code",
                "example": "8U"
              },
              "optionalCode": {
                "type": "string",
                "description": "tire optional code",
                "example": "005X"
              },
              "weekYear": {
                "type": "string",
                "description": "tire production week",
                "example": "1020"
              }
            },
            "description": "(Private) Tire Identification Number (consisting of Plant Code, Size Code and Type Code) (US Market )"
          },
          "countryOfOrigin": {
            "type": "string",
            "description": "(Private) ISO code on 3 characters that indicates the tire's country of origin",
            "example": "ITA"
          },
          "tmsContainerPresence": {
            "type": "boolean",
            "description": "Indicates whether a rubber container for the sensor is present on the tyre updated at each tyre inspection",
            "example": true
          },
          "tmsSensorPresence": {
            "type": "boolean",
            "description": "Indicates whether an electronic sensor is present on the tyre updated at each tyre inspection",
            "example": false
          },
          "birthDate": {
            "type": "string",
            "description": "Date when the tyre is born following ISO-8601 format \"YYYY-MM-DD\"",
            "example": "2021-09-27"
          }
        }
      },
      "BirthProduct": {
        "type": "object",
        "properties": {
          "itemIDS": {
            "$ref": "#/components/schemas/ItemIDS"
          },
          "commercialNameLongDescription": {
            "type": "string",
            "description": "Marketing text / Commercial name of the product",
            "example": "195/65 R 17 87H TL Dakota Spring"
          },
          "brandName": {
            "type": "string",
            "description": "Manufacturerâ€™s name or brand name",
            "example": "Bravetyre"
          },
          "commercialName": {
            "type": "string",
            "description": "Commercial Name",
            "example": "Dakota Spring"
          },
          "dimensions": {
            "$ref": "#/components/schemas/BirthDimensions"
          },
          "specifications": {
            "$ref": "#/components/schemas/BirthSpecifications"
          },
          "markings": {
            "$ref": "#/components/schemas/BirthMarkings"
          },
          "labelling": {
            "$ref": "#/components/schemas/BirthLabelling"
          }
        }
      },
      "BirthLabelling": {
        "type": "array",
        "description": "Labelling",
        "items": {
          "type": "object",
          "properties": {
            "noisePerformance": {
              "type": "integer",
              "description": "Labelling noise performance",
              "example": 70
            },
            "noiseClass": {
              "type": "string",
              "description": "Labelling noise class",
              "example": "C4"
            },
            "rollingResistanceClass": {
              "type": "string",
              "description": "Labelling Rolling Resistance class",
              "example": "B"
            },
            "wetClass": {
              "type": "string",
              "description": "Labelling wet class",
              "example": "C"
            },
            "labellingReferenceRegulation": {
              "type": "string",
              "description": "Regulation to which the labelling level of the tire for wet, noise and rolling resistance is given.",
              "example": "EUR DIR 1222/2009"
            },
            "eprelRecordReferenceUrl": {
              "type": "string",
              "description": "URL to the EPREL record of the tire",
              "example": "https://www.eprel.com/reference/123456"
            },
            "labelPictureUrl": {
              "type": "string",
              "description": "URL to the label picture",
              "example": "https://www.michelin.com/label/product/123456"
            }
          }
        }
      },
      "ItemIDS": {
        "type": "object",
        "properties": {
          "eanCode": {
            "type": "string",
            "description": "European Article number according to GS1 standard",
            "example": "3528709789509"
          },
          "upcCode": {
            "type": "string",
            "description": "(Private) Universal Product code according to GS1 standard",
            "example": "00412345678"
          }
        },
        "description": "various Item/article IDs"
      },
      "BirthDimensions": {
        "type": "object",
        "properties": {
          "geometricalTyreSize": {
            "type": "string",
            "description": "Tyre size designation",
            "example": "195/65 R 17"
          },
          "sectionWidth": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "description": "section width value",
                "example": 195.0
              },
              "uom": {
                "type": "string",
                "description": "unit of measure for section width",
                "example": "MILLIMETER",
                "enum": [
                  "MILLIMETER",
                  "INCH"
                ]
              }
            },
            "description": "Nominal section width of the tire"
          },
          "aspectRatio": {
            "type": "integer",
            "description": "Aspect Ratio",
            "example": 65
          },
          "rimCode": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "description": "Rim diameter",
                "example": 17.0
              },
              "uom": {
                "type": "string",
                "description": "unit of measure for the rim diameter",
                "example": "INCH",
                "enum": [
                  "MILLIMETER",
                  "INCH"
                ]
              }
            }
          }
        },
        "description": "dimensions of the tire"
      },
      "BirthSpecifications": {
        "type": "object",
        "description": "specifications of the tire (load index, speed symbol ...)",
        "properties": {
          "loadIndex": {
            "type": "integer",
            "description": "Load index",
            "example": 87
          },
          "loadIndexForDualFitment": {
            "type": "integer",
            "description": "Load index for dual fitment",
            "example": 88
          },
          "speedSymbol": {
            "type": "string",
            "description": "Speed symbol",
            "example": "H"
          },
          "speedSymbolSupplementaryServiceCondition": {
            "type": "string",
            "description": "For commercial tires, load adjusted speed",
            "example": "I"
          },
          "loadIndexSupplementaryServiceCondition": {
            "type": "integer",
            "description": "For commercial tires, speed adjusted load",
            "example": 85
          },
          "loadIndexSupplementaryServiceConditionDualFitment": {
            "type": "integer",
            "description": "For commercial tires, speed adjusted load for dual fitment",
            "example": 86
          },
          "structure": {
            "type": "string",
            "description": "Structure Radial or Bias",
            "example": "R",
            "enum": [
              "R",
              "B"
            ]
          },
          "tubeCharacteristic": {
            "type": "string",
            "description": "It indicates tubeless or tube type tyres",
            "example": "TL",
            "enum": [
              "TT",
              "TL"
            ]
          },
          "extraLoadOrReinforced": {
            "type": "boolean",
            "description": "Extra Load symbol to be associated to the load index if needed",
            "example": true
          },
          "sealant": {
            "type": "boolean",
            "description": "It indicates the fact that the tire is equipped with a puncture sealant",
            "example": true
          },
          "acousticStructure": {
            "type": "boolean",
            "description": "it indicates the presence of an internal structure with specific characteristics added to a “conventional” tyre with the aim to reduce the tyre cavity noise (not necessarily external rolling noise)",
            "example": true
          },
          "hlpc": {
            "type": "boolean",
            "description": "Indicates if the tire meets the UN R.30 definition of High Load (HL), values according to ETRTO standard",
            "example": true
          }
        }
      },
      "BirthMarkings": {
        "type": "object",
        "properties": {
          "mudAndSnow": {
            "type": "boolean",
            "description": "Mud and Snow (M+S) marking",
            "example": true
          },
          "3pmsf": {
            "type": "boolean",
            "description": "3PMSF marking to indicate if the tire is designed for use in severe snow conditions",
            "example": true
          },
          "iceGrip": {
            "type": "boolean",
            "description": "Ice grip marking to indicate the tire performance on ice",
            "example": true
          },
          "tractionTire": {
            "type": "boolean",
            "description": "Traction regulatory marking (UNECE R117) Tires primarly designed for the drive axle to maximise torque transmission in various circumstances",
            "example": true
          },
          "freeRollingTire": {
            "type": "boolean",
            "description": "FRT marking Tire designed for equipment of trailer axles, axles of motor vehicles other than front steering and drive axles.",
            "example": true
          },
          "professionnalOfRoad": {
            "type": "boolean",
            "description": "POR marking Tire designed for service in severe off road conditions",
            "example": true
          },
          "sizeSuffix": {
            "type": "string",
            "description": "Part of identification marking of the tire (see G9 ETRTO Std Manual T = temporary, P = Passenger for TRA std, LT = light truck (alternative to C Marking of R54)",
            "example": "CP",
            "enum": [
              "C",
              "CP"
            ]
          },
          "sizePrefix": {
            "type": "string",
            "description": "Part of identification marking of tire (see G9 ETRTO Std Manual T = temporary, P ou LT)",
            "example": "T",
            "enum": [
              "T",
              "P",
              "LT"
            ]
          },
          "OEMarking": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "oemName": {
                  "type": "string",
                  "description": "Specific original equipment marking - OEM Name",
                  "example": "Mercedes"
                },
                "tireMarking": {
                  "type": "string",
                  "description": "Specific original equipment marking",
                  "example": "MO"
                }
              }
            }
          },
          "maxInflationPressure": {
            "type": "integer",
            "description": "(Private) Max tyre inflation pressure in kPa",
            "example": 530
          }
        },
        "description": "different markings on tire"
      },
      "CollectionDeclaration": {
        "type": "object",
        "description": "UsedTyreCollection declaration",
        "required": [
          "guid",
          "declarationType",
          "tyreUII",
          "eltReuseStatus",
          "eltCollectionCountry",
          "eltCollectionDate"
        ],
        "properties": {
          "guid": {
            "type": "string",
            "format": "uuid",
            "example": "b51efa55-343a-4b16-9df2-826edecc5975"
          },
          "correction": {
            "type": "string",
            "format": "uuid",
            "description": "GUID of the declaration to correct (if this is a correction)"
          },
          "declarationType": {
            "type": "string",
            "example": "collection"
          },
          "tyreUII": {
            "type": "string",
            "example": "urn:epc:id:sgtin:012345.0987654.123456789"
          },
          "eltReuseStatus": {
            "type": "boolean",
            "description": "Indicates whether the ELT has been sent back to the market because partly worn out or to be sent to a retreader",
            "example": true
          },
          "eltCollectionCountry": {
            "type": "string",
            "description": "Country of collection (ISO 3166-1 alpha-3) of the used tyre",
            "example": "ITA"
          },
          "eltCollectionDate": {
            "type": "string",
            "description": "Date when the ELT has been collected by the used tyre collector following ISO-8601 format \"YYYY-MM-DD\"",
            "example": "2024-03-25"
          },
          "eltRemainingTreadDepth": {
            "$ref": "#/components/schemas/RemainingTreadDepth"
          }
        }
      },
      "RecyclingDeclaration": {
        "type": "object",
        "description": "Recycling declaration",
        "required": [
          "declarationType",
          "guid",
          "recyclingChannelDestination",
          "recyclingCountry",
          "recyclingDate"
        ],
        "properties": {
          "guid": {
            "type": "string",
            "format": "uuid",
            "example": "b51efa55-343a-4b16-9df2-826edecc5975"
          },
          "declarationType": {
            "type": "string",
            "example": "recycling"
          },
          "tyreUII": {
            "type": "string",
            "example": "urn:epc:id:sgtin:012345.0987654.123456789"
          },
          "remainingTreadDepth": {
            "$ref": "#/components/schemas/RemainingTreadDepth"
          },
          "recyclingChannelDestination": {
            "type": "string",
            "description": "indicates to which recycling channel category the used tyre has been sent (Cement , Pyrolisis, etc.))",
            "example": "Pyrolisis",
            "enum": [
              "Cement",
              "Pyrolisis"
            ]
          },
          "recyclingDate": {
            "type": "string",
            "description": "Date when the ELT has been deconstructed  following ISO-8601 format \"YYYY-MM-DD\"",
            "example": "2021-09-27"
          },
          "recyclingCountry": {
            "type": "string",
            "description": "Country of deconstruction (ISO 3166-1 alpha-3) of the used tyre",
            "example": "ITA"
          }
        }
      },
      "RetreadingDeclaration": {
        "type": "object",
        "description": "Retreading declaration",
        "properties": {
          "guid": {
            "type": "string",
            "format": "uuid",
            "example": "b51efa55-343a-4b16-9df2-826edecc5975"
          },
          "declarationType": {
            "type": "string",
            "example": "retreading"
          },
          "tyreUII": {
            "type": "string",
            "example": "urn:epc:id:sgtin:012345.0987654.123456789"
          },
          "product": {
            "$ref": "#/components/schemas/RetreadingProduct"
          },
          "typeApprovalCode": {
            "type": "string",
            "description": "Regulatory identification code of the retreader alpha-numeric code accordin to UN R 109",
            "example": "109 R - 002439"
          },
          "retreadType": {
            "type": "string",
            "enum": [
              "cold",
              "hot"
            ],
            "description": "Type of retreading operation occurred (Cold/Hot)",
            "example": "cold"
          },
          "retreadingDateCode": {
            "type": "string",
            "description": "Retreading production Week/Year (WWYY) according to UN R109",
            "example": "2723"
          },
          "retreadSerialNumber": {
            "type": "string",
            "description": "Retread Serial Number",
            "example": "4343"
          },
          "amountOfActualRepairs": {
            "type": "integer",
            "description": "An incremental counter to record the number of repairs/patch occurred during the tyre's life - starting with zero",
            "example": 2
          },
          "regrooved": {
            "type": "boolean",
            "description": "Indicates whether the tyre has been regrooved according to ECE R54 definition",
            "example": false
          },
          "retreadingCycle": {
            "type": "integer",
            "description": "An incremental counter to record the number of retreading operations occurred during the tyre's life - starting with zero",
            "example": 1
          },
          "tmsContainerPresence": {
            "type": "boolean",
            "description": "Indicates whether a rubber container for the sensor is present onthe tyre updated at each tyre inspection",
            "example": true
          },
          "tmsSensorPresence": {
            "type": "boolean",
            "description": "Indicates whether an electronic sensor is present on the tyre updated at each tyre inspection",
            "example": false
          },
          "retreadingDate": {
            "description": "Date when the tyre has been retreaded following ISO-8601 format \"YYYY-MM-DD\"",
            "example": "2021-09-27"
          },
          "createdAt": {
            "type": "string",
            "description": "date of creation of the declaration following following ISO-8601",
            "example": "2020-01-01 00:00:00"
          }
        }
      },
      "RetreadingProduct": {
        "type": "object",
        "description": "Retreading product",
        "required": [
          "brandName",
          "commercialName"
        ],
        "properties": {
          "brandName": {
            "type": "string",
            "description": "Retread technology name or brand name",
            "example": "COLMEC"
          },
          "commercialName": {
            "type": "string",
            "description": "Retread Commercial Name",
            "example": "BZAW/65"
          },
          "commercialNameLongDescription": {
            "type": "string",
            "description": "Marketing text / Commercial name of the product",
            "example": "195/65 R 17 87H TL Dakota Spring"
          },
          "dimensions": {
            "$ref": "#/components/schemas/RetreadingDimensions"
          },
          "specifications": {
            "$ref": "#/components/schemas/RetreadingSpecifications"
          },
          "markings": {
            "$ref": "#/components/schemas/RetreadingMarkings"
          }
        }
      },
      "RetreadingDimensions": {
        "type": "object",
        "properties": {
          "geometricalTyreSize": {
            "type": "string",
            "description": "Tyre size designation",
            "example": "195/65 R 17"
          }
        },
        "description": "dimensions of the tire"
      },
      "RetreadingSpecifications": {
        "type": "object",
        "description": "specifications of the tire (load index, speed symbol ...)",
        "required": [
          "loadIndex",
          "speedSymbol"
        ],
        "properties": {
          "loadIndex": {
            "type": "integer",
            "description": "Load index value to be uploaded also in case it does not change",
            "example": 160
          },
          "loadIndexForDualFitment": {
            "type": "integer",
            "description": "Load index value for dual fitment (CV tyre)",
            "example": 158
          },
          "speedSymbol": {
            "type": "string",
            "description": "Speed Symbol character to be uploaded also in case it does not change",
            "example": "M"
          }
        }
      },
      "RetreadingMarkings": {
        "type": "object",
        "description": "different markings of the tire (M+S, POR ...)",
        "required": [
          "3pmsf"
        ],
        "properties": {
          "mudAndSnow": {
            "type": "boolean",
            "description": "Mud and Snow (M+S) marking",
            "example": true
          },
          "3pmsf": {
            "type": "boolean",
            "description": "3PMSF marking - It indicates tyres designed for use in severe snow conditions",
            "example": true
          }
        }
      },
      "RemainingTreadDepth": {
        "type": "object",
        "description": "Remaining tread depth",
        "properties": {
          "values": {
            "type": "number",
            "description": "Value of remaining tread depth",
            "example": 34
          },
          "uom": {
            "type": "string",
            "description": "Unit of measurement",
            "example": "mm",
            "enum": [
              "mm",
              "in"
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
