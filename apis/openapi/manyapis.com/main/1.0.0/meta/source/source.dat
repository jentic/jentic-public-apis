{
  "openapi": "3.0.2",
  "info": {
    "title": "manyapis.com - API Documentation",
    "description": "API Documentation for manyapis.com. manyapis.com is a collection of APIs for developers to integrate into their applications. We provide APIs for Country Details, Currency Information, Currency Exchange Rates, Domain Tools, Email Validation, IP2Location, IP GeoLocation, Phone Number Validation, Url Shortener and more.",
    "contact": {
      "name": "manyapis.com team",
      "url": "https://manyapis.com",
      "email": "hello@manyapis.com"
    },
    "license": {
      "name": "Proprietary license",
      "url": "https://manyapis.com/legal/terms"
    },
    "termsOfService": "https://manyapis.com/legal/terms",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.manyapis.com",
      "description": "production"
    }
  ],
  "security": [
    {
      "APIKeyHeader": []
    },
    {
      "APIKeyQueryParam": []
    }
  ],
  "components": {
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Send this header with your api key to authenticate your self. To get the api key, please visit https://manyapis.com/account/api-key"
      },
      "APIKeyQueryParam": {
        "type": "apiKey",
        "in": "query",
        "name": "x-api-key",
        "description": "Send this query param with your api key to authenticate your self. You can either send the API key as query param or in the header for authentication. To get the api key, please visit https://manyapis.com/account/api-key"
      }
    },
    "schemas": {
      "Country": {
        "description": "Country details",
        "type": "object",
        "properties": {
          "iso2": {
            "description": "Country code ISO 3166-1 alpha-2",
            "type": "string"
          },
          "iso3": {
            "description": "Country code ISO 3166-1 alpha-3",
            "type": "string"
          },
          "name": {
            "description": "Country name",
            "type": "string"
          }
        }
      },
      "Currency": {
        "description": "Currency details",
        "type": "object",
        "properties": {
          "code": {
            "description": "Currency code ISO 4217",
            "type": "string"
          },
          "name": {
            "description": "Currency name",
            "type": "string"
          },
          "symbol": {
            "description": "Currency symbol",
            "type": "string"
          },
          "symbolName": {
            "description": "Currency symbol name",
            "type": "string"
          },
          "country": {
            "$ref": "#/components/schemas/Country"
          }
        }
      },
      "ConvertCurrency": {
        "description": "Convert currency response",
        "type": "object",
        "properties": {
          "from": {
            "description": "Currency to convert from",
            "type": "string"
          },
          "to": {
            "description": "Currency to convert to",
            "type": "string"
          },
          "exchangeRate": {
            "description": "Exchange rate",
            "type": "number"
          },
          "rateTime": {
            "description": "Time of the exchange rate",
            "type": "string"
          },
          "originalAmount": {
            "description": "Original amount input",
            "type": "number"
          },
          "convertedAmount": {
            "description": "Converted amount",
            "type": "number"
          }
        }
      },
      "GetDomainWhoisOut": {
        "description": "Domain WHOIS details",
        "type": "object",
        "properties": {
          "domain": {
            "description": "Domain name",
            "type": "string"
          },
          "whoisJson": {
            "description": "WHOIS JSON",
            "type": "object"
          }
        }
      },
      "Email": {
        "description": "Email validation details",
        "type": "object",
        "properties": {
          "email": {
            "description": "email address",
            "type": "string"
          },
          "validMx": {
            "description": "is the domain is valid with dns MX record",
            "type": "boolean"
          },
          "validSmtp": {
            "description": "is email address valid with SMTP Connect and Reply",
            "type": "boolean"
          },
          "validFormat": {
            "description": "is email valid format",
            "type": "boolean"
          },
          "isDisposable": {
            "description": "is disposable email",
            "type": "boolean"
          }
        }
      },
      "IP": {
        "description": "IP GEO Location details",
        "type": "object",
        "properties": {
          "ip": {
            "description": "IP Address",
            "type": "string"
          },
          "city": {
            "type": "object",
            "properties": {
              "name": {
                "description": "City Name",
                "type": "string"
              },
              "latitude": {
                "description": "City latitude",
                "type": "number"
              },
              "longitude": {
                "description": "City longitude",
                "type": "number"
              },
              "state1": {
                "description": "City state1",
                "type": "string"
              },
              "state2": {
                "description": "City state2",
                "type": "string"
              },
              "timezone": {
                "description": "City timezone",
                "type": "string"
              }
            }
          },
          "country": {
            "type": "object",
            "properties": {
              "iso2": {
                "description": "Country code ISO 3166-1 alpha-2",
                "type": "string"
              },
              "iso3": {
                "description": "Country code ISO 3166-1 alpha-3",
                "type": "string"
              },
              "name": {
                "description": "Country name",
                "type": "string"
              }
            }
          },
          "asn": {
            "type": "string",
            "description": "Carrier ASN"
          },
          "aso": {
            "type": "string",
            "description": "Carrier organization"
          }
        }
      },
      "Continent": {
        "description": "Continent details",
        "type": "object",
        "properties": {
          "code": {
            "description": "Continent code ISO 3166-1 alpha-2",
            "type": "string"
          },
          "name": {
            "description": "Continent name",
            "type": "string"
          }
        }
      },
      "City": {
        "type": "object",
        "properties": {
          "name": {
            "description": "City Name",
            "type": "string"
          },
          "region": {
            "description": "City region name",
            "type": "string"
          },
          "longitude": {
            "description": "City longitude",
            "type": "number"
          },
          "latitude": {
            "description": "City latitude",
            "type": "number"
          },
          "accuracyRadius": {
            "description": "City radius",
            "type": "number"
          },
          "timezone": {
            "description": "City time zone",
            "type": "string"
          },
          "postalCode": {
            "description": "City postal code",
            "type": "string"
          }
        }
      },
      "Phone": {
        "description": "Phone validation details",
        "type": "object",
        "properties": {
          "number": {
            "description": "Phone number",
            "type": "string"
          },
          "valid": {
            "description": "Is phone number valid",
            "type": "boolean"
          },
          "country": {
            "description": "Country code associated with phone number ISO 3166-1 alpha-2",
            "type": "string"
          },
          "callingCode": {
            "description": "Country calling code associated with phone number",
            "type": "string"
          },
          "nationalNumber": {
            "description": "National number associated with phone number",
            "type": "string"
          },
          "type": {
            "description": "Phone number type",
            "type": "string"
          }
        }
      },
      "CreateShortUrl": {
        "description": "Create short url request",
        "type": "object",
        "properties": {
          "url": {
            "description": "long url",
            "type": "string"
          },
          "expiry": {
            "description": "Short url expiry after which it will be deleted",
            "type": "string",
            "enum": [
              "5m",
              "30m",
              "1h",
              "4h",
              "12h",
              "1d",
              "3d",
              "7d",
              "never"
            ]
          }
        }
      },
      "UpdateShortUrl": {
        "description": "Update short url request",
        "type": "object",
        "properties": {
          "sid": {
            "description": "short url sid",
            "type": "string"
          },
          "expiry": {
            "description": "Short url expiry after which it will be deleted",
            "type": "string",
            "enum": [
              "5m",
              "30m",
              "1h",
              "4h",
              "12h",
              "1d",
              "3d",
              "7d",
              "never"
            ]
          }
        }
      },
      "ShortUrl": {
        "type": "object",
        "properties": {
          "url": {
            "description": "Original url",
            "type": "string"
          },
          "shortUrl": {
            "description": "Short url",
            "type": "string"
          },
          "sid": {
            "description": "Short url sid",
            "type": "string"
          },
          "expiry": {
            "description": "Short url expiry after which it will be deleted",
            "type": "string",
            "enum": [
              "5m",
              "30m",
              "1h",
              "4h",
              "12h",
              "1d",
              "3d",
              "7d",
              "never"
            ]
          },
          "expireAt": {
            "description": "Short url expiry timestamp",
            "type": "string"
          },
          "createdAt": {
            "description": "Created at timestamp",
            "type": "string"
          },
          "updatedAt": {
            "description": "Updated at timestamp",
            "type": "string"
          }
        }
      },
      "Me": {
        "type": "object",
        "properties": {
          "_id": {
            "description": "User id",
            "type": "string"
          },
          "name": {
            "description": "User name",
            "type": "string"
          },
          "email": {
            "description": "User email",
            "type": "string"
          },
          "authProvider": {
            "description": "User auth provider",
            "type": "string",
            "enum": [
              "google",
              "github",
              "email"
            ]
          },
          "metadata": {
            "description": "User metadata",
            "type": "object"
          },
          "verifiedAt": {
            "description": "User verified at timestamp",
            "type": "string"
          },
          "createdAt": {
            "description": "User created at timestamp",
            "type": "string"
          },
          "updatedAt": {
            "description": "User updated at timestamp",
            "type": "string"
          },
          "subscription": {
            "description": "User subscription details",
            "type": "object",
            "properties": {
              "planId": {
                "description": "Plan id to which the user is subscribed",
                "type": "string"
              },
              "name": {
                "description": "Plan name to which the user is subscribed",
                "type": "string"
              },
              "amount": {
                "description": "Plan amount to which the user is subscribed",
                "type": "number"
              },
              "currency": {
                "description": "Plan currency to which the user is subscribed",
                "type": "string"
              },
              "interval": {
                "description": "Plan interval",
                "type": "string",
                "enum": [
                  "monthly",
                  "yearly"
                ]
              },
              "status": {
                "description": "Plan status",
                "type": "string",
                "enum": [
                  "active",
                  "canceled",
                  "expired"
                ]
              },
              "requestsPerMonth": {
                "description": "Plan requests per month",
                "type": "number"
              },
              "metadata": {
                "description": "Plan metadata",
                "type": "object"
              },
              "createdAt": {
                "description": "Plan created at timestamp",
                "type": "string"
              },
              "updatedAt": {
                "description": "Plan updated at timestamp",
                "type": "string"
              }
            }
          }
        }
      },
      "CreateUrlScreenshot": {
        "type": "string"
      },
      "CreateUrlScreenshotRequest": {
        "description": "Create url screenshot request",
        "type": "object",
        "properties": {
          "websiteUrl": {
            "description": "Website url to take screenshot of",
            "type": "string"
          },
          "responseFormat": {
            "description": "Response format",
            "type": "string",
            "enum": [
              "base64",
              "binary"
            ],
            "default": "base64"
          },
          "modifications": {
            "description": "Modifications to apply to the screenshot",
            "type": "object",
            "properties": {
              "type": {
                "description": "Screenshot format",
                "type": "string",
                "enum": [
                  "jpeg",
                  "png"
                ],
                "default": "png"
              },
              "width": {
                "description": "Screenshot width",
                "type": "number",
                "default": "1280"
              },
              "height": {
                "description": "Screenshot height",
                "type": "number",
                "default": "800"
              },
              "fullPage": {
                "description": "Screenshot full page",
                "type": "boolean",
                "default": false
              },
              "quality": {
                "description": "Screenshot quality. Note: Only applicable for jpeg format",
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      },
      "GetTextFromImageResponse": {
        "type": "object",
        "properties": {
          "text": {
            "description": "Parsed text from image",
            "type": "string"
          }
        }
      },
      "GetTextFromImageRequest": {
        "type": "object",
        "properties": {
          "image": {
            "description": "image",
            "type": "object",
            "format": "Base64 encoded image"
          },
          "url": {
            "description": "url",
            "type": "string",
            "format": "Remote Image URL"
          },
          "lang": {
            "description": "language",
            "type": "string",
            "format": "Language of the text"
          },
          "psm": {
            "description": "page",
            "type": "string",
            "format": "Page segmentation mode"
          }
        }
      },
      "HttpError": {
        "description": "",
        "type": "object",
        "properties": {
          "status": {
            "description": "http status code",
            "type": "number"
          },
          "name": {
            "description": "error name",
            "type": "string"
          },
          "message": {
            "description": "error message",
            "type": "string"
          },
          "errors": {
            "description": "array of errors",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error": {
        "description": "",
        "type": "object",
        "properties": {
          "value": {
            "description": "error value",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "msg": {
            "description": "error message",
            "type": "string"
          },
          "param": {
            "description": "error parameters",
            "type": "string"
          },
          "location": {
            "description": "location of the error",
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/v1-get-country": {
      "get": {
        "deprecated": false,
        "summary": "",
        "description": "Get country detail by country code ISO 4217",
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "APIKeyQueryParam": []
          }
        ],
        "responses": {
          "200": {
            "description": "country details response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Country"
                }
              }
            }
          },
          "400": {
            "description": "invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpError"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "description": "code - country code ISO 4217",
            "required": true,
            "deprecated": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "tags": [
          "Country"
        ],
        "operationId": "v1GetCountry"
      }
