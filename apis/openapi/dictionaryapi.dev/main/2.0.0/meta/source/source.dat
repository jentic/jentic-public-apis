{
  "openapi": "3.0.3",
  "info": {
    "title": "Free Dictionary API",
    "description": "A free, open-source API for English dictionary definitions, phonetics, and audio pronunciations. No authentication required.",
    "version": "2.0.0",
    "x-jentic-source-url": "https://dictionaryapi.dev/",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.dictionaryapi.dev/api/v2"
    }
  ],
  "paths": {
    "/entries/{language}/{word}": {
      "get": {
        "operationId": "getWordDefinition",
        "summary": "Get definitions, phonetics, and meanings for a word",
        "parameters": [
          {
            "name": "language",
            "in": "path",
            "required": true,
            "description": "Language code (e.g. 'en' for English)",
            "schema": {
              "type": "string",
              "example": "en"
            }
          },
          {
            "name": "word",
            "in": "path",
            "required": true,
            "description": "The word to look up",
            "schema": {
              "type": "string",
              "example": "hello"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Word definitions found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "word": {
                        "type": "string"
                      },
                      "phonetic": {
                        "type": "string"
                      },
                      "phonetics": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "text": {
                              "type": "string"
                            },
                            "audio": {
                              "type": "string",
                              "format": "uri"
                            },
                            "sourceUrl": {
                              "type": "string",
                              "format": "uri"
                            },
                            "license": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "url": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      },
                      "origin": {
                        "type": "string"
                      },
                      "meanings": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "partOfSpeech": {
                              "type": "string"
                            },
                            "definitions": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "definition": {
                                    "type": "string"
                                  },
                                  "example": {
                                    "type": "string"
                                  },
                                  "synonyms": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  },
                                  "antonyms": {
                                    "type": "array",
                                    "items": {
                                      "type": "string"
                                    }
                                  }
                                }
                              }
                            },
                            "synonyms": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "antonyms": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      },
                      "license": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "url": {
                            "type": "string"
                          }
                        }
                      },
                      "sourceUrls": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Word not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "resolution": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": []
}
