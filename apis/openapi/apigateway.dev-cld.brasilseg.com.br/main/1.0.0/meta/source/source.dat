{
  "openapi": "3.0.3",
  "info": {
    "title": "Brasilseg API Gateway - ServiceNow Bedrock Proxy",
    "version": "1.0.0",
    "description": "Especificação OpenAPI (Swagger) baseada no Script Include de teste do ServiceNow.\n\nFluxo resumido:\n1) Autenticar em **/oauth/login** (query **APP_NAME**) enviando **userName/password**.\n2) Usar o token retornado em **Authorization: Bearer <token>** para chamar o endpoint protegido.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/MAURICIOARAUJO77/brasilseg-api-gateway-servicenow-bedrock-proxy/1.0.0"
  },
  "servers": [
    {
      "url": "https://apigateway.dev-cld.brasilseg.com.br",
      "description": "Ambiente DEV (conforme script)"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Autenticação e obtenção de token"
    },
    {
      "name": "Bedrock",
      "description": "Proxy para Lambda/Bedrock (prompt + anexos em base64)"
    }
  ],
  "paths": {
    "/oauth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Autentica e retorna token JWT",
        "description": "Endpoint de login utilizado pelo ServiceNow para obter o token.\nO script chama: **/oauth/login?APP_NAME=cg-user-app**.\n",
        "operationId": "login",
        "parameters": [
          {
            "in": "query",
            "name": "APP_NAME",
            "required": true,
            "schema": {
              "type": "string",
              "example": "cg-user-app"
            },
            "description": "Identificador do client/aplicação."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "examples": {
                "exemplo": {
                  "value": {
                    "userName": "usr_app_servicenow_integracao",
                    "password": "<senha>"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "examples": {
                  "exemplo": {
                    "value": {
                      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericError"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericError"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/arquitetura-poc-servicenow-epicos-ia-backend-lambda": {
      "post": {
        "tags": [
          "Bedrock"
        ],
        "summary": "Executa prompt (com ou sem anexos) via Lambda/Bedrock",
        "description": "Endpoint protegido por **Bearer Token**.\n\nO script aceita dois formatos de payload:\n- **Single file**: campos `contentType`, `base64`, `fileName`.\n- **Multi file**: campo `files` (array de objetos com `contentType`, `base64`, `fileName`).\n\nO retorno é repassado pelo ServiceNow como JSON parseado quando possível.\n",
        "operationId": "invokeBedrock",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/BedrockInvokeSingle"
                  },
                  {
                    "$ref": "#/components/schemas/BedrockInvokeMulti"
                  }
                ],
                "description": "Payload para invocação (single ou multi)"
              },
              "examples": {
                "single_pdf": {
                  "value": {
                    "bedrock_invoke": true,
                    "prompt": "O que está vendo no documento em anexo?",
                    "contentType": "application/pdf",
                    "base64": "<base64_do_arquivo>",
                    "fileName": "arquivo.pdf",
                    "max_tokens": 8000
                  }
                },
                "multi": {
                  "value": {
                    "bedrock_invoke": true,
                    "prompt": "Analise todos os anexos em conjunto e produza um resumo único.",
                    "files": [
                      {
                        "contentType": "application/pdf",
                        "base64": "<base64_pdf>",
                        "fileName": "anexo1.pdf"
                      },
                      {
                        "contentType": "image/png",
                        "base64": "<base64_png>",
                        "fileName": "imagem.png"
                      }
                    ],
                    "max_tokens": 5000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvokeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericError"
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado (token ausente/inválido)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericError"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "userName",
          "password"
        ],
        "properties": {
          "userName": {
            "type": "string",
            "description": "Usuário para autenticação"
          },
          "password": {
            "type": "string",
            "description": "Senha do usuário",
            "format": "password"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token JWT retornado pelo login"
          }
        },
        "required": [
          "token"
        ]
      },
      "BedrockFile": {
        "type": "object",
        "required": [
          "contentType",
          "base64",
          "fileName"
        ],
        "properties": {
          "contentType": {
            "type": "string",
            "description": "MIME type do arquivo (ex.: image/png, application/pdf)",
            "example": "application/pdf"
          },
          "base64": {
            "type": "string",
            "description": "Conteúdo do arquivo em Base64",
            "format": "byte"
          },
          "fileName": {
            "type": "string",
            "description": "Nome do arquivo",
            "example": "arquivo.pdf"
          }
        }
      },
      "BedrockInvokeSingle": {
        "type": "object",
        "description": "Invocação com um único arquivo (campos top-level)",
        "required": [
          "bedrock_invoke",
          "prompt"
        ],
        "properties": {
          "bedrock_invoke": {
            "type": "boolean",
            "example": true
          },
          "prompt": {
            "type": "string",
            "example": "O que está vendo na imagem em anexo?"
          },
          "contentType": {
            "type": "string",
            "description": "MIME type do arquivo (quando houver anexo)",
            "example": "image/png"
          },
          "base64": {
            "type": "string",
            "description": "Conteúdo do arquivo em Base64 (quando houver anexo)",
            "format": "byte"
          },
          "fileName": {
            "type": "string",
            "description": "Nome do arquivo (quando houver anexo)",
            "example": "imagem.png"
          },
          "max_tokens": {
            "type": "integer",
            "description": "Parâmetro de controle de tokens",
            "minimum": 1,
            "example": 5000
          }
        }
      },
      "BedrockInvokeMulti": {
        "type": "object",
        "description": "Invocação com múltiplos arquivos",
        "required": [
          "bedrock_invoke",
          "prompt",
          "files"
        ],
        "properties": {
          "bedrock_invoke": {
            "type": "boolean",
            "example": true
          },
          "prompt": {
            "type": "string",
            "example": "Analise todos os anexos em conjunto e produza um resumo único."
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BedrockFile"
            }
          },
          "max_tokens": {
            "type": "integer",
            "description": "Parâmetro de controle de tokens",
            "minimum": 1,
            "example": 5000
          }
        }
      },
      "InvokeResponse": {
        "type": "object",
        "description": "Resposta variável (depende do Lambda). O script retorna o JSON parseado quando possível.\n",
        "additionalProperties": true
      },
      "GenericError": {
        "type": "object",
        "description": "Estrutura genérica de erro (exemplo)",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": false
          },
          "status": {
            "type": "integer",
            "example": 0
          },
          "error": {
            "type": "string",
            "example": "Não foi possível obter o token"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
