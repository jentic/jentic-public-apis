{
  "openapi": "3.0.3",
  "info": {
    "title": "LEVPawnShop",
    "version": "1.0.0",
    "description": "QuickPawn / LEV Pawn Shop API – users, storefront, uploads, password reset, email verification, iOS helpers, and AI pricing.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/aaa-984/levpawnshop/1.0.0"
  },
  "servers": [
    {
      "url": "https://bibe.stream"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Storefront"
    },
    {
      "name": "Uploads"
    },
    {
      "name": "Password Reset"
    },
    {
      "name": "Email"
    },
    {
      "name": "iOS"
    },
    {
      "name": "AI Pricing"
    },
    {
      "name": "Other Helpers"
    }
  ],
  "paths": {
    "/api/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register",
        "description": "Register a new user account.",
        "operationId": "register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/api_register_body"
              },
              "examples": {
                "Register": {
                  "value": {
                    "email": "test1@example.com",
                    "firstName": "Test",
                    "lastName": "User",
                    "login": "testuser1",
                    "password": "Password123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or user already exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "description": "Login with username or email and password. Sets HTTP-only auth cookies.",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/api_login_body"
              },
              "examples": {
                "Login": {
                  "value": {
                    "loginOrEmail": "test1@example.com",
                    "password": "Password123!"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login success. Cookies are set on the response.",
            "headers": {
              "Set-Cookie": {
                "description": "accessToken and refreshToken cookies.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Email not verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Profile",
        "description": "Get the logged-in user's profile.",
        "operationId": "profile",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Logout",
        "description": "Clear auth cookies and logout.",
        "operationId": "logout",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logged out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh access token",
        "description": "Use the refreshToken cookie to get a new accessToken.",
        "operationId": "refreshToken",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "New access token issued.",
            "headers": {
              "Set-Cookie": {
                "description": "Updated accessToken cookie.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "401": {
            "description": "Refresh token missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/storefront": {
      "get": {
        "tags": [
          "Storefront"
        ],
        "summary": "List storefront items",
        "description": "List active storefront items with optional cursor-based pagination.",
        "operationId": "listStorefrontItems",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 24
            },
            "description": "Maximum number of items to return (capped at 60)."
          },
          {
            "name": "afterId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "MongoDB _id of the last item from the previous page (for pagination)."
          }
        ],
        "responses": {
          "200": {
            "description": "List of storefront items.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorefrontListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Storefront"
        ],
        "summary": "Create storefront item",
        "description": "Create a new storefront item. Requires cookie auth or iOS key.",
        "operationId": "createStorefrontItem",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "iosKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/api_storefront_body"
              },
              "examples": {
                "Create storefront item": {
                  "value": {
                    "active": true,
                    "description": "Used, good condition",
                    "imageUrl": "https://example.com/test-watch.jpg",
                    "name": "Test Watch",
                    "price": 150,
                    "tags": [
                      "watch",
                      "test"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorefrontCreateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error (e.g. missing name, bad price, missing image).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Auth required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/storefront/{id}": {
      "get": {
        "tags": [
          "Storefront"
        ],
        "summary": "Get storefront item by id",
        "description": "Get a single active storefront item by its id.",
        "operationId": "getStorefrontItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Item id (_id from MongoDB)."
          }
        ],
        "responses": {
          "200": {
            "description": "Item found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "item": {
                      "$ref": "#/components/schemas/StorefrontItem"
                    }
                  },
                  "required": [
                    "ok",
                    "item"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Item not found or inactive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Storefront"
        ],
        "summary": "Delete storefront item (soft delete)",
        "description": "Soft-delete a storefront item (set active=false). Web users must be the owner; iOS key can delete any item.",
        "operationId": "deleteStorefrontItem",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "iosKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Item id (_id from MongoDB)."
          }
        ],
        "responses": {
          "200": {
            "description": "Item deleted (soft).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not owner (web) or unauthorized.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Item not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/uploads/sign": {
      "post": {
        "tags": [
          "Uploads"
        ],
        "summary": "Get upload signature",
        "description": "Get a Cloudinary upload signature. Requires cookie auth or iOS key.",
        "operationId": "getUploadSignature",
        "security": [
          {
            "cookieAuth": []
          },
          {
            "iosKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Signature created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadSignResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error during signing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/forgot-password": {
      "post": {
        "tags": [
          "Password Reset"
        ],
        "summary": "Forgot password",
        "description": "Send a password reset email if the user exists and is verified. Always returns ok to avoid leaking existence.",
        "operationId": "forgotPassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/api_forgotpassword_body"
              },
              "examples": {
                "Forgot password": {
                  "value": {
                    "email": "test1@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reset email queued (or hidden no-op).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/reset-password": {
      "post": {
        "tags": [
          "Password Reset"
        ],
        "summary": "Reset password",
        "description": "Reset password using a reset token from email.",
        "operationId": "resetPassword",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/api_resetpassword_body"
              },
              "examples": {
                "Reset password": {
                  "value": {
                    "password": "NewPassword123!",
                    "token": "PUT_A_REAL_TOKEN_HERE"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing fields or invalid/expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/resend-verification": {
      "post": {
        "tags": [
          "Email"
        ],
        "summary": "Resend verification",
        "description": "Resend email verification link/code if user exists and is not verified.",
        "operationId": "resendVerification",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/api_resendverification_body"
              },
              "examples": {
                "Resend verification": {
                  "value": {
                    "email": "test1@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification email resent or already verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResendVerificationResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/verify-email": {
      "get": {
        "tags": [
          "Email"
        ],
        "summary": "Verify email (browser redirect)",
        "description": "Verify email using a token and redirect to the web app. This returns an HTML/redirect, not JSON.",
        "operationId": "verifyEmail",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "b29545989c6105bf783227797eab3401107b8be3321b6f30e21495691d026883"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to login page."
          },
          "400": {
            "description": "Invalid or expired token."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    },
    "/api/verify-email-code": {
      "post": {
        "tags": [
          "Email"
        ],
        "summary": "Verify email with 6-digit code",
        "description": "Verify email using a 6-digit code, for iOS or web.",
        "operationId": "verifyEmailCode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing fields or invalid/expired code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ios/urls/insert": {
      "post": {
        "tags": [
          "iOS"
        ],
        "summary": "iOS insert URL",
        "description": "Insert a URL record for the iOS demo app. Requires x-ios-key header.",
        "operationId": "iosInsertUrl",
        "parameters": [
          {
            "name": "x-ios-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "super-temp-class-key"
            }
          }
        ],
        "security": [
          {
            "iosKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/urls_insert_body"
              },
              "examples": {
                "iOS insert URL": {
                  "value": {
                    "slug": "iphone-15",
                    "targetUrl": "https://apple.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "URL inserted (example stub).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/recover-identity": {
      "post": {
        "tags": [
          "Other Helpers"
        ],
        "summary": "Recover identity",
        "description": "Given an email or username, look up the account and return email/username if found.",
        "operationId": "recoverIdentity",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/api_recoveridentity_body"
              },
              "examples": {
                "Recover identity": {
                  "value": {
                    "value": "test1@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Either ok=false (not found) or ok=true with identity details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoverIdentityResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/estimate-price": {
      "post": {
        "tags": [
          "AI Pricing"
        ],
        "summary": "Estimate item price with Gemini",
        "description": "Call Gemini to estimate a cash offer and listing range for an item. Currently open (no auth) in server.js.",
        "operationId": "estimatePrice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EstimatePriceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI pricing estimate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EstimatePriceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing item data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "AI not configured (missing Gemini API key).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server or Gemini error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken",
        "description": "JWT access token stored as HTTP-only cookie."
      },
      "iosKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-ios-key",
        "description": "Static key used by the demo iOS app."
      }
    },
    "schemas": {
      "api_register_body": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "test1@example.com"
          },
          "firstName": {
            "type": "string",
            "example": "Test"
          },
          "lastName": {
            "type": "string",
            "example": "User"
          },
          "login": {
            "type": "string",
            "example": "testuser1"
          },
          "password": {
            "type": "string",
            "example": "Password123!"
          }
        },
        "required": [
          "email",
          "login",
          "password"
        ]
      },
      "api_login_body": {
        "type": "object",
        "properties": {
          "loginOrEmail": {
            "type": "string",
            "example": "test1@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!"
          }
        },
        "required": [
          "loginOrEmail",
          "password"
        ]
      },
      "api_storefront_body": {
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean",
            "example": true
          },
          "description": {
            "type": "string",
            "example": "Used, good condition"
          },
          "imageUrl": {
            "type": "string",
            "example": "https://example.com/test-watch.jpg"
          },
          "name": {
            "type": "string",
            "example": "Test Watch"
          },
          "price": {
