{"openapi":"3.1.0","info":{"title":"FilmeeAi API","version":"2026-09-17","description":"Add AI video editing to your own app. Edit recorded talking-head videos (explainer animation that matches what is said, burned-in subtitles, skin beautify, background music) or generate narrated anime videos from text. Every job is asynchronous: create it, poll GET /videos/{id} (or receive a webhook), then POST /videos/{id}/result to get the file. Credits are consumed only by the first successful result call; failed jobs are free.","contact":{"url":"https://filmee.app/developers"},"termsOfService":"https://filmee.app/terms"},"servers":[{"url":"https://filmee.app/api/v1"}],"security":[{"bearerAuth":[]}],"paths":{"/account":{"get":{"summary":"Credit balance, plan and prices","responses":{"200":{"description":"Account"},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/talk-videos":{"post":{"summary":"Edit a recorded talking-head video","description":"Pass a direct link to the video file (≤15 minutes, ≤2 GB; YouTube/TikTok/Instagram/Vimeo pages are not accepted). Silence at the start and end is always trimmed for free. Set explainer_animation=false to skip AI animation entirely (e.g. subtitles-only or beautify-only).","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["video_url"],"additionalProperties":false,"properties":{"video_url":{"type":"string","format":"uri"},"explainer_animation":{"type":"boolean","default":true,"description":"Insert AI explainer animation that matches the speech."},"layout":{"type":"string","enum":["auto","A","B-right","B-left","C"],"default":"auto","description":"auto = AI mixes layouts; A = person only; B-right/B-left = side-by-side; C = animation full screen. Only when explainer_animation is true."},"style":{"type":"string","enum":["cute","elegant","feminine","cool","clean","masculine","future","classic","anime","ghibli"],"default":"clean"},"energy":{"type":"string","enum":["calm","active","mixed"],"default":"mixed"},"subtitles":{"type":"boolean","default":true,"description":"+1 credit/min"},"caption_style":{"type":"string","enum":["normal","word"],"default":"normal"},"beautify":{"type":"boolean","default":false,"description":"Skin smoothing, brightening and contour. +2 credits/min"},"beautify_level":{"type":"string","enum":["light","normal","strong"],"default":"normal"},"bgm":{"type":"boolean","default":false,"description":"Royalty-free music ducked under the voice. +2 credits/min"},"bgm_volume":{"type":"string","enum":["quiet","standard","loud"],"default":"standard"},"bgm_category":{"type":"string","enum":["any","calm","upbeat","cinematic","tech","acoustic","inspirational"],"default":"any"},"language":{"type":"string","enum":["ja","en","zh","es","fr","de","pt","th"],"default":"ja","description":"Spoken language of the video."},"aspect":{"type":"string","enum":["16:9","9:16"],"default":"16:9"},"talk_speed":{"type":"number","enum":[1,1.3,1.5],"default":1},"zoom":{"type":"string","enum":["off","subtle","strong"],"default":"off"},"webhook_url":{"type":"string","format":"uri","description":"https endpoint that receives video.completed / video.failed."}}}}}},"responses":{"202":{"description":"Job accepted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Video"}}}},"400":{"description":"Invalid parameters or video URL","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Not enough credits","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/anime-videos":{"post":{"summary":"Generate a narrated anime video from text","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["prompt"],"additionalProperties":false,"properties":{"prompt":{"type":"string","minLength":1,"maxLength":4000},"length_minutes":{"type":"integer","enum":[1,3,5,10],"default":1},"style":{"type":"string","enum":["cute","serious","comical","storybook"],"default":"cute"},"language":{"type":"string","enum":["ja","en","zh","es","fr","de","pt","th"],"default":"ja"},"aspect":{"type":"string","enum":["16:9","9:16"],"default":"16:9"},"bgm_mood":{"type":"string","enum":["auto","calm","inspirational","acoustic","upbeat","cinematic","tech"],"default":"auto"},"subtitles":{"type":"boolean","default":true},"narration_speed":{"type":"string","enum":["normal","fast"],"default":"normal"},"webhook_url":{"type":"string","format":"uri"}}}}}},"responses":{"202":{"description":"Job accepted","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Video"}}}},"400":{"description":"Invalid parameters","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid API key","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Not enough credits","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/videos/{id}":{"get":{"summary":"Job status (free)","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Video","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Video"}}}},"404":{"description":"Not found or expired","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/videos/{id}/result":{"post":{"summary":"Get the finished file (charges credits on the first call only)","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VideoResult"}}}},"404":{"description":"Not found or expired","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Not ready yet, or the job failed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}},"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"API key from https://filmee.app/account (fk_live_...)"}},"schemas":{"Error":{"type":"object","properties":{"error":{"type":"object","required":["code","message"],"properties":{"code":{"type":"string"},"message":{"type":"string"}}}}},"Video":{"type":"object","properties":{"id":{"type":"string","examples":["talk_Ab12Cd34Ef56"]},"object":{"const":"video"},"type":{"type":"string","enum":["talk","anime"]},"status":{"type":"string","enum":["processing","completed","failed"]},"progress":{"type":"integer","minimum":0,"maximum":100},"stage":{"type":"string"},"credits_cost":{"type":["integer","null"],"description":"Known once the video has been analysed."},"credits_charged":{"type":"boolean"},"error":{"type":["object","null"]},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"result_url":{"type":["string","null"],"description":"POST here to receive the file once completed."}}},"VideoResult":{"type":"object","properties":{"id":{"type":"string"},"object":{"const":"video_result"},"video_url":{"type":"string","description":"Direct MP4. Download and store it on your side."},"watch_url":{"type":"string","description":"FilmeeAi-hosted playback page (not indexed by search engines)."},"credits_charged":{"type":"integer"},"balance_after":{"type":["integer","null"]}}}}},"x-webhooks":{"signature":"Header FilmeeAi-Signature: t=<unix seconds>,v1=<hex HMAC-SHA256 of `${t}.${raw body}` using your key's webhook secret>. Delivery is best-effort (3 attempts); always treat GET /videos/{id} as the source of truth.","events":["video.completed","video.failed"]}}