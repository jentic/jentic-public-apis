{
  "openapi": "3.0.3",
  "info": {
    "title": "Truck Movements API",
    "description": "API for retrieving truck movement and reception data. Access is secured using an API Key provided via the `x-api-key` header.\n",
    "version": "1.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/tclaircargo-5aa/BffApi/1.0"
  },
  "servers": [
    {
      "url": "https://bff-api-tclaircargo.transoceanica.link/v1",
      "description": "Production (AWS API Gateway)"
    },
    {
      "description": "SwaggerHub API Auto Mocking",
      "url": "https://virtserver.swaggerhub.com/tclaircargo-5aa/BffApi/1.0"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Verifies that the API is up and running.",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/truck-movements": {
      "get": {
        "summary": "List truck movements",
        "description": "Returns truck movement and cargo reception data. Pagination is page-based and all query parameters are optional.\n",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number (1-based)",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 1
            }
          },
          {
            "name": "elementsPerPage",
            "in": "query",
            "description": "Number of elements per page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "example": 10
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "Filter by local date (YYYY-MM-DD)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-01-13"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of truck movements",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TruckMovementsResponse"
                },
                "example": {
                  "data": [
                    {
                      "id": "e97b0a3a-5bce-47e8-a5f4-f17f270b4ece",
                      "localDate": "2026-01-13T00:00:00.000Z",
                      "airline": "LATAM CARGO",
                      "agency": null,
                      "licensePlate": "PAB-6923",
                      "dockingAt": "2026-01-13T05:00:00.000Z",
                      "dockingTimeMin": 4,
                      "receptionStart": "2026-01-13T10:08:00.000Z",
                      "receptionEnd": "2026-01-13T12:48:00.000Z",
                      "receptionTimeMin": 160,
                      "totalReceptionTimeMin": 164,
                      "piecesCount": 893,
                      "receivedWeightKg": 5284.15,
                      "updatedAt": "2026-01-13T16:05:51.198Z"
                    }
                  ],
                  "total": 52
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "TruckMovementsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TruckMovement"
            }
          },
          "total": {
            "type": "integer",
            "description": "Total number of records matching the query",
            "example": 52
          }
        },
        "required": [
          "data",
          "total"
        ]
      },
      "TruckMovement": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "localDate": {
            "type": "string",
            "format": "date-time"
          },
          "airline": {
            "type": "string"
          },
          "agency": {
            "type": "string",
            "nullable": true
          },
          "licensePlate": {
            "type": "string"
          },
          "dockingAt": {
            "type": "string",
            "format": "date-time"
          },
          "dockingTimeMin": {
            "type": "integer",
            "minimum": 0
          },
          "receptionStart": {
            "type": "string",
            "format": "date-time"
          },
          "receptionEnd": {
            "type": "string",
            "format": "date-time"
          },
          "receptionTimeMin": {
            "type": "integer",
            "minimum": 0
          },
          "totalReceptionTimeMin": {
            "type": "integer",
            "minimum": 0
          },
          "piecesCount": {
            "type": "integer",
            "minimum": 0
          },
          "receivedWeightKg": {
            "type": "number",
            "format": "float",
            "minimum": 0
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "localDate",
          "airline",
          "licensePlate",
          "dockingAt",
          "dockingTimeMin",
          "receptionStart",
          "receptionEnd",
          "receptionTimeMin",
          "totalReceptionTimeMin",
          "piecesCount",
          "receivedWeightKg",
          "updatedAt"
        ]
      }
    }
  }
}
