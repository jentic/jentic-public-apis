{
  "openapi": "3.0.3",
  "info": {
    "title": "Emineo Download Center Folders Files API",
    "description": "API for uploading and deleting files in product folders",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/nueva.ch/folders-files-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.emineo-download.nueva.io",
      "description": "API Server"
    }
  ],
  "tags": [
    {
      "name": "Folders",
      "description": "Folder and file operations"
    }
  ],
  "security": [
    {
      "apiTokenAuth": []
    }
  ],
  "paths": {
    "/folders/files": {
      "post": {
        "deprecated": false,
        "summary": "Upload files into parent folder",
        "description": "Upload file(s) into an existing parent folder linked to a product.",
        "tags": [
          "Folders"
        ],
        "security": [
          {
            "apiTokenAuth": []
          }
        ],
        "requestBody": {
          "description": "Multipart upload payload",
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/NewFolderFileUpload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uploaded file(s) and resolved folder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderFileUploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/folders/files/{id}": {
      "delete": {
        "deprecated": false,
        "summary": "Delete uploaded file",
        "description": "Delete a single uploaded file by id. The folder itself remains. You can get the file id from POST /folders/files response (file.id), or from GET /upload/files.",
        "tags": [
          "Folders"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Upload file id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delete result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderFileDeleteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/folders/files/by-url": {
      "delete": {
        "deprecated": false,
        "summary": "Delete uploaded file by URL",
        "description": "Delete a single uploaded file by exact file URL. Send the URL as query parameter (?url=...).",
        "tags": [
          "Folders"
        ],
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "description": "Exact file URL as stored in upload_file.url.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "https://emineo-download-api.sos-ch-dk-2.exo.io/Test_48f4dd9cb3.pdf"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delete result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteFileByUrlResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiTokenAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "api-token",
        "description": "Static API token."
      }
    },
    "schemas": {
      "NewFolderFileUpload": {
        "type": "object",
        "required": [
          "productId",
          "files"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "description": "Product id that owns the folder tree."
          },
          "parentFolderId": {
            "type": "string",
            "description": "Optional existing folder id where files are uploaded. If omitted, API use rootFolderName for creating a new folder on the root level."
          },
          "rootFolderName": {
            "type": "string",
            "description": "Optional root folder name to use when parentFolderId is empty. If omitted, product title is used."
          },
          "name": {
            "type": "string",
            "description": "Optional display filename."
          },
          "alternativeText": {
            "type": "string",
            "description": "Optional alt text."
          },
          "caption": {
            "type": "string",
            "description": "Optional caption."
          },
          "files": {
            "type": "string",
            "format": "binary",
            "description": "File payload (multipart field files)."
          }
        }
      },
      "FolderFileUploadResponse": {
        "type": "object",
        "properties": {
          "product": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "folder": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          },
          "file": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/UploadFile"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/UploadFile"
                }
              }
            ]
          }
        }
      },
      "FolderFileDeleteResponse": {
        "type": "object",
        "required": [
          "id",
          "deleted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          }
        }
      },
      "DeleteFileByUrlResponse": {
        "type": "object",
        "required": [
          "id",
          "url",
          "deleted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          }
        }
      },
      "UploadFile": {
        "type": "object",
        "required": [
          "id",
          "name",
          "hash",
          "mime",
          "size",
          "url",
          "provider"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "alternativeText": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "ext": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "url": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
