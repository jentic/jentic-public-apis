{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Autotransportes Pilot Autorizacion",
    "description": "El proposito del siguiente  endpoit es para obtener  el token y el refresh token para poder realizar las consultas a los diferentes Endpoints que utiliza la compañia. ",
    "contact": {
      "name": "Jose Rodriguez Gutierrez",
      "url": "",
      "email": "jose.gutierrez@atpilot.mx"
    },
    "termsOfService": "",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/autotransportespilot-a51/AUTH/1.0.0"
  },
  "paths": {
    "Auth/Challenge": {
      "post": {
        "summary": "Challenge",
        "tags": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "x-stoplight": {
                        "id": "5b1oojk4hkpxu"
                      },
                      "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpYXQiOjE3NzAyMzQwNDIsImV4cCI6MTc3MDIzNzY0Miwic3ViIjoxLCJlbWFpbCI6InNpc3RlbWFzQGF0cGlsb3QubXgifQ.noCqhGO4-7o5L90Dna5zEuUzXZVLLOo131qExbyaYXo"
                    },
                    "refresh_token": {
                      "type": "string",
                      "x-stoplight": {
                        "id": "6j3t9fpj8bpwz"
                      },
                      "example": "6b2b344cb5862975096e40a5e8344387f9f7e16dc12daf09707cdea02b48500e8e2fc1d7d6ec86e71f9703bdf586db9ebeef48d615d8b5abbe5d0f77f84e6730"
                    },
                    "message": {
                      "type": "string",
                      "x-stoplight": {
                        "id": "setidkylzo13l"
                      },
                      "example": "Autenticación exitosa"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "x-stoplight": {
                        "id": "1ypaeg45yqb9k"
                      },
                      "example": "Usuario o conrtaseña incorrectos"
                    }
                  }
                }
              }
            },
            "headers": {}
          }
        },
        "operationId": "post-Challenge",
        "description": "En el siguiente Path sirve para obtener un token y el refreshtoken.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "Accept",
            "description": "application/json"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Usuario": {
                    "type": "string",
                    "x-stoplight": {
                      "id": "qk3e2buamf9zb"
                    },
                    "example": "sistemas@atpilot.mx"
                  },
                  "Password": {
                    "type": "string",
                    "x-stoplight": {
                      "id": "kfgjxqf0q2652"
                    },
                    "example": "ai0QNWjLyW9Ew5uFXEJEF6bLUGNRHwu0"
                  }
                }
              },
              "examples": {}
            }
          },
          "description": "El usuario y password son proporcionados por el area de IT de la compañia.\n\nEl token solo tiene un tiempo de duracion de 1 hora para obtener un nuevo token pueden soliciarlot consuiltando neuvmanete el Challenge o envuado el refrestoken al otro endpoint.\nPara obtener el primer token y refresh token debe ser por este endpoint."
        }
      },
      "parameters": []
    },
    "Auth/RefreshToken": {
      "post": {
        "summary": "RefreshToken",
        "tags": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "x-stoplight": {
                        "id": "l9dqtlpo85x5t"
                      },
                      "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpYXQiOjE3NzAyMzkxMTEsImV4cCI6MTc3MDI0MjcxMSwic3ViIjoxLCJlbWFpbCI6InNpc3RlbWFzQGF0cGlsb3QubXgifQ.0pFhdeGJbDOgVn3X2A7juNZvOTZNWOO1pilAOd8N-uo"
                    },
                    "refresh_token": {
                      "type": "string",
                      "x-stoplight": {
                        "id": "ld3hb3tnejwdh"
                      },
                      "example": "7c564419252b32bbab41b9dcdeff7616586b8d003aff47f751c565f104778dd08e68920ab328b570d8cd72bb34e0c6a2fba4565725a652a7fae990f88c998227"
                    },
                    "message": {
                      "type": "string",
                      "x-stoplight": {
                        "id": "n7f4tanoug3af"
                      },
                      "example": "Autenticación exitosa"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "x-stoplight": {
                        "id": "vehjgwkt4wd55"
                      },
                      "example": "Refresh token inválido"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "post-RefreshToken",
        "description": "El siguiente endponint de regresa un token y un refreshtoken actualizado enviando un refreshtoken anterior.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "Accept",
            "description": "application/json"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "x-stoplight": {
                      "id": "qc9139ksixs7p"
                    },
                    "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpYXQiOjE3NzAyMzg5NjMsImV4cCI6MTc3MDI0MjU2Mywic3ViIjoxLCJlbWFpbCI6InNpc3RlbWFzQGF0cGlsb3QubXgifQ.wgdqFzl1Txo-xqS63YlFq7I6WvSMbmim_FxRCE9-atQ"
                  },
                  "refresh_token": {
                    "type": "string",
                    "x-stoplight": {
                      "id": "km384k62bk997"
                    },
                    "example": "ef67bef9029e6d62f49f7f09eaf403146d166e93ae7115623b8f25a9f7974e165026ab8e64e056b690c99f2d34fc060528b8c22c488b338f0c50693ee93970ce\""
                  },
                  "message": {
                    "type": "string",
                    "x-stoplight": {
                      "id": "7nr8um5i63h9z"
                    },
                    "example": "Autenticación exitosa"
                  }
                }
              }
            }
          }
        }
      },
      "parameters": []
    }
  },
  "servers": [
