              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/activities": {
      "get": {
        "summary": "List project activities",
        "tags": [
          "Activities"
        ],
        "description": "Retrieve an array of activities related to a carbon project",
        "parameters": [
          {
            "schema": {
              "type": "array",
              "items": {
                "description": "Project involved in the activity",
                "type": "string"
              }
            },
            "in": "query",
            "name": "projectId",
            "required": false
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "description": "Type of activity",
                "anyOf": [
                  {
                    "title": "CreatedListing",
                    "type": "string",
                    "enum": [
                      "CreatedListing"
                    ]
                  },
                  {
                    "title": "DeletedListing",
                    "type": "string",
                    "enum": [
                      "DeletedListing"
                    ]
                  },
                  {
                    "title": "Purchase",
                    "type": "string",
                    "enum": [
                      "Purchase"
                    ]
                  },
                  {
                    "title": "Sold",
                    "type": "string",
                    "enum": [
                      "Sold"
                    ]
                  },
                  {
                    "title": "UpdatedExpiration",
                    "type": "string",
                    "enum": [
                      "UpdatedExpiration"
                    ]
                  },
                  {
                    "title": "UpdatedMinFillAmount",
                    "type": "string",
                    "enum": [
                      "UpdatedMinFillAmount"
                    ]
                  },
                  {
                    "title": "UpdatedPrice",
                    "type": "string",
                    "enum": [
                      "UpdatedPrice"
                    ]
                  },
                  {
                    "title": "UpdatedQuantity",
                    "type": "string",
                    "enum": [
                      "UpdatedQuantity"
                    ]
                  }
                ]
              }
            },
            "in": "query",
            "name": "activityType",
            "required": false
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "description": "Address of the seller or the buyer involved in the activity",
                "type": "string"
              }
            },
            "in": "query",
            "name": "walletAddress",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "List of project activities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Activity"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Categories",
        "description": "A list of all methodology categories used to delineate every project in the marketplace. A project may belong to one or more of these categories.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                },
                "examples": [
                  [
                    {
                      "id": "Blue Carbon"
                    },
                    {
                      "id": "Forestry"
                    },
                    {
                      "id": "Other"
                    }
                  ]
                ]
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/countries": {
      "get": {
        "summary": "Countries",
        "description": "Retrieve an array containing the countries that carbon projects originate from",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Country"
                  }
                },
                "examples": {
                  "example1": {
                    "value": [
                      {
                        "id": "Brazil"
                      },
                      {
                        "id": "Bulgaria"
                      },
                      {
                        "id": "China"
                      }
                    ]
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
