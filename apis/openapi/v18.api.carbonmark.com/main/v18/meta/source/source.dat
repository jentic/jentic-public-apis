          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIInfo"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/listings": {
      "get": {
        "summary": "List listings",
        "tags": [
          "Listings"
        ],
        "description": "Retrieve an array of listings filtered by desired query parameters",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "example": "0x71C7656EC7ab88b098defB751B7401B5f6d8976F",
            "in": "query",
            "name": "sellerWallet",
            "required": false,
            "description": "Filter listings by seller wallet address"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "description": "Desired IDs of the related projects.",
                "type": "string"
              }
            },
            "in": "query",
            "name": "projectIds",
            "required": false
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "description": "IDs of the listings.",
                "type": "string"
              }
            },
            "in": "query",
            "name": "ids",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "example": "1620000000",
            "in": "query",
            "name": "expiresAfter",
            "required": false,
            "description": "Only return listings that expire after this timestamp (Unix seconds)"
          },
          {
            "schema": {
              "minimum": 0,
              "type": "number"
            },
            "example": "0",
            "in": "query",
            "name": "minSupply",
            "required": false,
            "description": "Only consider listings that contains at least this amount of credits (Tonnes)"
          },
          {
            "schema": {
              "minimum": 0,
              "type": "number"
            },
            "examples": {
              "2": {
                "value": "2"
              },
              "0.5": {
                "value": "0.5"
              },
              "1.5": {
                "value": "1.5"
              }
            },
            "in": "query",
            "name": "minPriceUSD",
            "required": false,
            "description": "Exclude listings with a per-tonne price lower than this amount (USD)"
          },
          {
            "schema": {
              "type": "string"
            },
            "example": "137-erc20-0x3c499c542cef5e3811e1192ce70d8cc03d5c3359",
            "in": "query",
            "name": "tokenIdentifier",
            "required": false,
            "description": "Returns listings that concern this token"
          },
          {
            "schema": {
              "type": "boolean"
            },
            "example": true,
            "in": "query",
            "name": "active",
            "required": false,
            "description": "If true, return only active listings. Otherwise return all listings"
          }
        ],
        "responses": {
          "200": {
            "description": "List of listings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Listing"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "summary": "Order list",
        "tags": [
          "Orders"
        ],
        "description": "Get a list of retirement orders optionally filtered by id",
        "parameters": [
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "example": 74,
            "in": "query",
            "name": "ids",
            "required": false,
            "description": "IDs of specific orders"
          },
          {
            "schema": {
              "type": "string"
            },
            "example": "a18ea1ed-5909-46f2-aba5-242852fd7f85",
            "in": "query",
            "name": "quote_uuid",
            "required": false,
            "description": "UUID of the quote related to the order"
          },
          {
            "schema": {
              "type": "string"
            },
            "examples": {
              "Bearer cm_api_d286bc5a-9980-43b7-9507-7fc013fecca8": {
                "value": "Bearer cm_api_d286bc5a-9980-43b7-9507-7fc013fecca8"
              },
              "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..uRi8T-GSlYDIoYIAmHnRxYKrgK483CBDUkaItopCUko": {
                "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..uRi8T-GSlYDIoYIAmHnRxYKrgK483CBDUkaItopCUko"
              }
            },
            "in": "header",
            "name": "Authorization",
            "required": false,
            "description": "Authorization header bearing either a session token or an API key prefixed with 'Bearer ' in either case."
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create order",
        "tags": [
          "Orders"
        ],
        "description": "Consume a Quote and convert it into an Order. Creates a retirement at the quoted price and quantity.\n\nIf you are using sandbox mode, you can provide the `retirement_message` with value `-- I will fail --` to simulate a failed transaction \nor `-- I will be slow --` to simulate a slow resolving transaction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quote_uuid": {
                    "description": "UUID of the quote you want to create an order from",
                    "type": "string",
                    "example": "e632eafd-9a67-4af1-8acc-16d72f5a738f"
                  },
                  "beneficiary_name": {
                    "maxLength": 255,
                    "minLength": 1,
                    "description": "Name of the person or organization who is claiming the environmental benefit of the retired credits. Note: this name is a permanent public record.",
                    "type": "string",
                    "example": "Mother Nature"
                  },
                  "beneficiary_address": {
                    "anyOf": [
                      {
                        "maxLength": 42,
                        "minLength": 42,
                        "description": "Wallet address to which the retirement will be attributed to.",
                        "examples": [
                          "0x6fb0e62afB345951997bd5149a313df9fcB72C2d"
                        ],
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "retirement_message": {
                    "maxLength": 500,
                    "minLength": 1,
                    "description": "A message to attach to the retirement, displayed on the final Carbonmark certificate. Note: this message is a permanent public record.",
                    "type": "string",
                    "example": "This is a retirement message"
                  },
                  "consumption_metadata": {
                    "anyOf": [
                      {
                        "description": "Consumption metadata for the order. This is required to retire credits from the Puro.Earth registry.",
                        "type": "object",
                        "properties": {
                          "country_of_consumption_code": {
                            "description": "ISO 3166 Alpha 2 country of consumption code.",
                            "type": "string"
                          },
                          "consumption_period_start": {
                            "description": "Start of the consumption period in unix seconds.",
                            "type": "number"
                          },
                          "consumption_period_end": {
                            "description": "End of the consumption period in unix seconds.",
                            "type": "number"
                          }
                        },
                        "required": [
                          "country_of_consumption_code",
                          "consumption_period_start",
                          "consumption_period_end"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "quote_uuid",
                  "beneficiary_name",
                  "retirement_message"
                ]
              }
            }
          },
          "required": true
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "example": "Bearer cm_api_d286bc5a-9980-43b7-9507-7fc013fecca8",
            "in": "header",
            "name": "Authorization",
            "required": true,
            "description": "Bearer token"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                },
                "examples": {
                  "Consume a Quote and convert it into an Order. Creates a retirement at the quoted price and quantity.": {
                    "value": {
                      "created_at": "2024-03-25T22:01:23.236141+00:00",
                      "updated_at": "2024-03-25T22:01:23.236141+00:00",
                      "status": "SUBMITTED",
                      "transaction_hash": null,
                      "polygonscan_url": null,
                      "view_retirement_url": null,
                      "quote": {
                        "asset_price_source_id": "listing-137-0x12dbdff6fa065abc002324b5f2c1546b06e0440b1906438669a492e1987690f4",
                        "uuid": "07495f6c-8b02-465d-8fdd-4bcc2d2047e9",
                        "created_at": "2024-03-25T22:01:23.236141+00:00",
                        "updated_at": "2024-03-25T22:01:23.236141+00:00",
                        "credential_id": 93,
                        "quantity_tonnes": 1,
                        "cost_usdc": 0.5,
                        "consumed": 0
                      },
                      "consumption_metadata": {},
                      "registry_specific_data": {}
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/prices": {
      "get": {
        "summary": "List asset prices",
        "tags": [
          "Prices"
        ],
        "description": "Retrieve a list of listing prices created by sellers.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "example": "1620000000",
            "in": "query",
            "name": "expiresAfter",
            "required": false,
            "description": "Only return projects listings that expire after this timestamp (Unix seconds)"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "description": "Desired IDs of the related projects.",
                "examples": [
                  "VCS-191"
                ],
                "type": "string"
              }
            },
            "in": "query",
            "name": "projectIds",
            "required": false
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "description": "Desired listing ids",
                "examples": [
                  "0x7eee78739d79f7a2ac9f995f7d3e96e4abb453125d0f2283ac5eba3b6d05199e"
                ],
                "type": "string"
              }
            },
            "in": "query",
            "name": "listingIds",
            "required": false
          },
          {
            "schema": {
              "minimum": 0,
              "type": "number"
            },
            "example": "100",
            "in": "query",
            "name": "minSupply",
            "required": false,
            "description": "Only return projects with a purchaseable supply greater than this amount (Tonnes)"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "in": "query",
            "name": "vintage",
            "required": false,
            "description": "Desired vintages of carbon projects"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "in": "query",
            "name": "assetPriceSourceIds",
            "required": false,
            "description": "Filter prices matching specific asset_price_source_ids"
          }
        ],
        "responses": {
          "200": {
            "description": "List of prices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssetPrice"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
