{
  "openapi": "3.1.0",
  "info": {
    "title": "Carbonmark REST API",
    "license": {
      "name": "Proprietary"
    },
    "description": "\nWelcome to the API Reference docs for **version v18** of the Carbonmark REST API.\n \nUse this API to view assets, prices, supply, activity and more.\n\nTo find the latest stable version, visit [docs.carbonmark.com](https://docs.carbonmark.com).\n\n## Quick start\nBe sure to prefix a version number, otherwise your application will be exposed to breaking changes.\n\n~~~ts\nconst res = await fetch(\"https://v18.api.carbonmark.com/projects\");\nconst projects = await res.json();\n~~~\n\nFor a developer guides and example implementations, or to learn more about Carbonmark and the Carbon Market, view our product knowledge base at <a href=\"https://docs.carbonmark.com\">docs.carbonmark.com</a>.\n## \n",
    "termsOfService": "https://www.carbonmark.com/terms-of-use",
    "contact": {
      "name": "Support",
      "url": "https://www.carbonmark.com/contact-us"
    },
    "version": "v18",
    "x-jentic-source-url": "https://api.carbonmark.com/openapi.json"
  },
  "components": {
    "schemas": {
      "Activity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "project": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "vintage": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "vintage"
            ]
          },
          "amount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "previousAmount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "price": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "previousPrice": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "timeStamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "activityType": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "seller": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "handle": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "buyer": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "handle": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "project"
        ]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "title": "Renewable Energy",
                "type": "string",
                "enum": [
                  "Renewable Energy"
                ]
              },
              {
                "title": "Forestry",
                "type": "string",
                "enum": [
                  "Forestry"
                ]
              },
              {
                "title": "Other Nature Based",
                "type": "string",
                "enum": [
                  "Other Nature Based"
                ]
              },
              {
                "title": "Other",
                "type": "string",
                "enum": [
                  "Other"
                ]
              },
              {
                "title": "Energy Efficiency",
                "type": "string",
                "enum": [
                  "Energy Efficiency"
                ]
              },
              {
                "title": "Agriculture",
                "type": "string",
                "enum": [
                  "Agriculture"
                ]
              },
              {
                "title": "Industrial Processing",
                "type": "string",
                "enum": [
                  "Industrial Processing"
                ]
              },
              {
                "title": "Blue Carbon",
                "type": "string",
                "enum": [
                  "Blue Carbon"
                ]
              },
              {
                "title": "Waste Disposal",
                "type": "string",
                "enum": [
                  "Waste Disposal"
                ]
              },
              {
                "title": "Biochar",
                "type": "string",
                "enum": [
                  "Biochar"
                ]
              }
            ]
          }
        },
        "required": [
          "id"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "statusCode": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "statusCode",
          "error"
        ]
      },
      "Country": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "Listing": {
        "description": "Marketplace listing with per-tonne price and project info.",
        "type": "object",
        "properties": {
          "id": {
            "description": "Unique listing identifier",
            "type": "string"
          },
          "leftToSell": {
            "description": "Remaining supply. Unformatted 18 decimal string",
            "type": "string"
          },
          "tokenAddress": {
            "description": "Address of the asset being sold",
            "type": "string"
          },
          "singleUnitPrice": {
            "description": "USDC.e price per tonne. Unformatted 6 decimal string. e.g. 1000000",
            "type": "string"
          },
          "totalAmountToSell": {
            "type": "string"
          },
          "active": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "deleted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "seller": {
            "type": "object",
            "properties": {
              "handle": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "username": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "profileImgUrl": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "id"
            ]
          },
          "creditId": {
            "description": "Identifier of the credit related to this listing",
            "type": "string"
          },
          "expiration": {
            "description": "Unix Timestamp (seconds) when the listing expires.",
            "type": "number"
          },
          "minFillAmount": {
            "description": "Minimum quantity for purchase transaction to succeed.",
            "type": "string"
          },
          "project": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "vintage": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "country": {
                "type": "string"
              },
              "methodology": {
                "type": "string"
              },
              "isExAnte": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "key",
              "vintage",
              "name",
              "category",
              "country",
              "methodology",
              "isExAnte"
            ]
          },
          "token": {
            "$ref": "#/components/schemas/Token"
          }
        },
        "required": [
          "id",
          "leftToSell",
          "tokenAddress",
          "singleUnitPrice",
          "totalAmountToSell",
          "seller",
          "creditId",
          "expiration",
          "minFillAmount",
          "project",
          "token"
        ]
      },
      "Methodology": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "status": {
            "description": "Status of the order.",
            "anyOf": [
              {
                "title": "SUBMITTED",
                "description": "Status of the order: Order created.",
                "type": "string",
                "enum": [
                  "SUBMITTED"
                ]
              },
              {
                "title": "INITIATED",
                "description": "Status of the order: Order taken into account by our bots.",
                "type": "string",
                "enum": [
                  "INITIATED"
                ]
              },
              {
                "title": "COMMITTED",
                "description": "Status of the order: Transaction committed to the blockchain.",
                "type": "string",
                "enum": [
                  "COMMITTED"
                ]
              },
              {
                "title": "MINTED",
                "description": "Status of the order: Transaction confirmed on the blockchain.",
                "type": "string",
                "enum": [
                  "MINTED"
                ]
              },
              {
                "title": "COMPLETED",
                "description": "Status of the order: Transaction indexed.",
                "type": "string",
                "enum": [
                  "COMPLETED"
                ]
              },
              {
                "title": "FAILED",
                "description": "Transaction failed.",
                "type": "string",
                "enum": [
                  "FAILED"
                ]
              }
            ],
            "type": "string"
          },
          "consumption_metadata": {
            "description": "Puro.Earth specific data for the order.",
            "type": "object",
            "properties": {
              "retiring_address": {
                "description": "Address to retire the carbon credits to.",
                "type": "string"
              },
              "country_of_consumption": {
                "description": "ISO 3166 country of consumption.",
                "type": "string"
              },
              "country_of_consumption_code": {
                "description": "ISO 3166 Alpha 2 country of consumption code.",
                "type": "string"
              },
              "consumption_period_start": {
                "description": "Start of the consumption period in unix seconds",
                "type": "number"
              },
              "consumption_period_end": {
                "description": "End of the consumption period in unix seconds.",
                "type": "number"
              }
            }
          },
          "registry_specific_data": {
            "description": "Registry specific data for the order.",
            "type": "object",
            "properties": {
              "puro_earth": {
                "description": "Puro specific data for the order.",
                "type": "object",
                "properties": {
                  "puro_batch_token_id": {
                    "description": "Puro batch token ID.",
                    "type": "string"
                  }
                }
              }
            }
          },
          "completed_at": {
            "anyOf": [
              {
                "description": "Time the transaction was confirmed on the blockchain if the transaction completed successfully.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "transaction_hash": {
            "anyOf": [
              {
                "description": "Hash of the transaction related to this order.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "retirement_message": {
            "anyOf": [
              {
                "description": "Message associated with the retirement.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "retirement_index": {
            "anyOf": [
              {
                "description": "Index of the retirement for the given beneficiary address",
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "beneficiary_name": {
            "anyOf": [
              {
                "description": "Beneficiary of the retirement.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "beneficiary_address": {
            "anyOf": [
              {
                "description": "Wallet address to which the retirement will be attributed to.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "polygonscan_url": {
            "anyOf": [
              {
                "description": "URL on polygonscan to access transaction details.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "view_retirement_url": {
            "anyOf": [
              {
                "description": "URL on Carbonmark to view and download the retirement certificate.",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "quote": {
            "$ref": "#/components/schemas/Quote"
          }
        },
        "required": [
          "created_at",
          "updated_at",
          "status",
          "consumption_metadata",
          "registry_specific_data",
          "quote"
        ]
      },
      "Quote": {
        "type": "object",
        "properties": {
          "uuid": {
            "description": "Reference of the quote. use this in the `POST /orders` endpoint if you want to create an order from this quote.",
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "credential_id": {
            "description": "ID of the credentials used to create this quote.",
            "type": "number"
          },
          "asset_price_source_id": {
            "description": "ID of the asset price source.",
            "examples": [
              "listing-137-0x886289a280cd265093215ff2893c29ff24c1381e830f63b0c71a335a7f15b362"
            ],
            "type": "string"
          },
          "quantity_tonnes": {
            "description": "Number of tonnes quoted.",
            "type": "number"
          },
          "cost_usdc": {
            "description": "Amount in USD which will be invoiced if this quote is converted to an order.",
            "type": "number"
          },
          "consumed": {
            "description": "Equals 1 if this quote was used to create an order, 0 otherwise. A consumed quote can no longer be used to create an order.",
            "type": "number"
          }
        },
        "required": [
          "uuid",
          "created_at",
          "updated_at",
          "credential_id",
          "asset_price_source_id",
          "quantity_tonnes",
          "cost_usdc",
          "consumed"
        ]
      },
      "Team": {
        "type": "object",
        "properties": {
          "uuid": {
            "description": "UUID of the team",
            "type": "string"
          },
          "name": {
            "description": "Name or handle of the team",
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "created_by": {
            "description": "Id of the creator of the team",
            "type": "string"
          },
          "deleted_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "updated_at": {
            "type": "string"
          },
          "description": {
            "description": "A description for the team",
            "type": "string"
          },
          "display_name": {
            "description": "Display name of the team",
            "type": "string"
          },
          "is_onboarded": {
            "description": "True if this team has gone though the onboarding process",
            "type": "boolean"
          },
          "profile_image_url": {
            "description": "A url pointing to a profile image for this team",
            "type": "string"
          },
          "wallets": {
            "description": "Wallet UUIDs of the team",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "beneficiary_address": {
            "description": "Beneficiary address associated with this team",
            "type": "string"
          }
        },
        "required": [
          "uuid",
          "name",
          "created_at",
          "created_by",
          "updated_at",
          "description",
          "display_name",
          "is_onboarded",
          "profile_image_url",
          "wallets",
          "beneficiary_address"
        ]
      },
      "Wallet": {
        "type": "object",
        "properties": {
          "address": {
            "description": "Blockchain address of the wallet",
            "type": "string"
          },
          "uuid": {
            "format": "uuid",
            "description": "UUID of the wallet",
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "address",
          "uuid",
          "created_at",
          "updated_at"
        ]
      },
      "AllowanceModel": {
        "type": "object",
        "properties": {
          "walletUuid": {
            "description": "ID of the wallet",
            "type": "string"
          },
          "tokenIdentifier": {
            "description": "Identifier of the token",
            "type": "string"
          },
          "allowance": {
            "description": "Amount allowed for transfer",
            "type": "number"
          },
          "spenderAddress": {
            "description": "Address of the spender",
            "type": "string"
          }
        },
        "required": [
          "walletUuid",
          "tokenIdentifier",
          "allowance",
          "spenderAddress"
        ]
      },
      "WalletTransactionModel": {
        "type": "object",
        "properties": {
          "id": {
            "description": "ID of the transaction. This ID is generated internally",
            "type": "string"
          },
          "refId": {
            "description": "refId of the transaction. This ID is provided by the client",
            "type": "string"
          },
          "walletId": {
            "description": "ID of the wallet",
            "type": "string"
          },
          "status": {
            "description": "Status of the transaction",
            "anyOf": [
              {
                "title": "INITIATED",
                "type": "string",
                "enum": [
                  "INITIATED"
                ]
              },
              {
                "title": "QUEUED",
                "type": "string",
                "enum": [
                  "QUEUED"
                ]
              },
              {
                "title": "CLEARED",
                "type": "string",
                "enum": [
                  "CLEARED"
                ]
              },
              {
                "title": "SENT",
                "type": "string",
                "enum": [
                  "SENT"
                ]
              },
              {
                "title": "PENDING_RISK_SCREENING",
                "type": "string",
                "enum": [
                  "PENDING_RISK_SCREENING"
                ]
              },
              {
                "title": "CONFIRMED",
                "type": "string",
                "enum": [
                  "CONFIRMED"
                ]
              },
              {
                "title": "CANCELLED",
                "type": "string",
                "enum": [
                  "CANCELLED"
                ]
              },
              {
                "title": "COMPLETE",
                "type": "string",
                "enum": [
                  "COMPLETE"
                ]
              },
              {
                "title": "FAILED",
                "type": "string",
                "enum": [
                  "FAILED"
                ]
              },
              {
                "title": "DENIED",
                "type": "string",
                "enum": [
                  "DENIED"
                ]
              },
              {
                "title": "ACCELERATED",
                "type": "string",
                "enum": [
                  "ACCELERATED"
                ]
              }
            ]
          },
          "transactionHash": {
            "description": "Hash of the transaction",
            "type": "string"
          },
          "transactionError": {
            "type": "object",
            "properties": {
              "errorDetails": {
                "type": "string"
              },
              "errorReason": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "walletId",
          "status"
        ]
      },
      "Challenge": {
        "type": "object",
        "properties": {
          "challengeId": {
            "description": "Circle challenge ID",
            "type": "string"
          },
          "encryptionKey": {
            "description": "Circle encryption key",
            "type": "string"
          },
          "userToken": {
            "description": "Circle user token",
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "encryptionKey",
          "userToken"
        ]
      },
      "Purchase": {
        "type": "object",
        "properties": {
          "id": {
            "description": "ID (transaction hash) of the purchase",
            "examples": [
              "0xcad9383fba33aaad6256304ef7b103f3f00b21afbaffbbff14423bf074b699e8"
            ],
            "type": "string"
          },
          "amount": {
            "description": "Quantity of credits purchased",
            "examples": [
              "1.0"
            ],
            "type": "string"
          },
          "listing": {
            "type": "object",
            "properties": {
              "id": {
                "description": "ID of the listing that was purchased",
                "examples": [
                  "0x1"
                ],
                "type": "string"
              },
              "tokenAddress": {
                "description": "Address of the asset that was purchased",
                "type": "string"
              },
              "tokenStandard": {
                "description": "Standard of the asset that was purchased",
                "examples": [
                  "ERC20"
                ],
                "type": "string"
              },
              "seller": {
                "type": "object",
                "properties": {
                  "id": {
                    "description": "Address of the seller",
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "project": {
                "type": "object",
                "properties": {
                  "country": {
                    "examples": [
                      "China"
                    ],
                    "type": "string"
                  },
                  "key": {
                    "examples": [
                      "VCS-191"
                    ],
                    "type": "string"
                  },
                  "methodology": {
                    "examples": [
                      "ACM0002"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "examples": [
                      "4×50 MW Dayingjiang- 3 Hydropower Project Phases 1&2"
                    ],
                    "type": "string"
                  },
                  "projectID": {
                    "examples": [
                      "191"
                    ],
                    "type": "string"
