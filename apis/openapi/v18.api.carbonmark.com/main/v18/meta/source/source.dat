    "/carbonProjects": {
      "get": {
        "summary": "List projects",
        "tags": [
          "CarbonProjects"
        ],
        "description": "Retrieve an array of carbon projects filtered by desired query parameters",
        "parameters": [
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "in": "query",
            "name": "ids",
            "required": false,
            "description": "A list of allowable ProjectIDs"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "in": "query",
            "name": "country",
            "required": false,
            "description": "Desired countries of origin for carbon projects"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "in": "query",
            "name": "category",
            "required": false,
            "description": "Desired categories of carbon projects"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "query",
            "name": "search",
            "required": false,
            "description": "Search carbon project names and descriptions for a string of text"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "in": "query",
            "name": "vintage",
            "required": false,
            "description": "Desired vintages of carbon projects"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "in": "query",
            "name": "sdg",
            "required": false,
            "description": "Desired SDGs of carbon projects"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "in": "query",
            "name": "registry",
            "required": false,
            "description": "Desired Registries of carbon projects"
          },
          {
            "schema": {
              "type": "string"
            },
            "example": "1620000000",
            "in": "query",
            "name": "expiresAfter",
            "required": false,
            "description": "Only return projects listings that expire after this timestamp (Unix seconds)"
          },
          {
            "schema": {
              "minimum": 0,
              "type": "number"
            },
            "example": "100",
            "in": "query",
            "name": "minSupply",
            "required": false,
            "description": "Only return projects with a purchaseable supply greater than this amount (Tonnes)"
          },
          {
            "schema": {
              "minimum": 0,
              "type": "number"
            },
            "examples": {
              "2": {
                "value": "2"
              },
              "0.5": {
                "value": "0.5"
              },
              "1.5": {
                "value": "1.5"
              }
            },
            "in": "query",
            "name": "minPriceUSD",
            "required": false,
            "description": "Exclude projects with a per-tonne price lower than this amount (USD)"
          },
          {
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "in": "query",
            "name": "assetPriceSourceIds",
            "required": false,
            "description": "Filter projects associated with listings matching specific asset_price_source_ids"
          },
          {
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": "number"
            },
            "in": "query",
            "name": "offset",
            "required": false,
            "description": "Index of the first item to return"
          },
          {
            "schema": {
              "default": 20,
              "minimum": 1,
              "type": "number"
            },
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Maximum number of items to return"
          }
        ],
        "responses": {
          "200": {
            "description": "List of carbon projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "description": "Items",
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CarbonProject"
                      }
                    },
                    "itemsCount": {
                      "description": "Total number of available items",
                      "type": "number"
                    },
                    "offset": {
                      "description": "Index of the first item of the returned result page",
                      "type": "number"
                    }
                  },
                  "required": [
                    "items",
                    "itemsCount",
                    "offset"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
