      "put": {
        "summary": "Update a user's team",
        "tags": [
          "Teams"
        ],
        "description": "This endpoint allows a user to update their team information. The user must be logged in to access this endpoint. The user must also be a member of the team they are attempting to update. If the team is already onboarded, the name cannot be changed.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "name"
                ],
                "type": "object",
                "properties": {
                  "display_name": {
                    "maxLength": 255,
                    "description": "This is the name that will appear on the Carbonmark profile. If it's not specified, the name will be used as the name.",
                    "type": "string",
                    "example": "Carbonmark"
                  },
                  "description": {
                    "maxLength": 255,
                    "description": "A brief overview of the individual or entity. If not supplied, the description field will remain blank.",
                    "type": "string",
                    "example": "Carbonmark leverages advanced digital infrastructure to provide secure, auditable, and interoperable products & services for facilitating the trade and usage of environmental commodities."
                  },
                  "profile_img_url": {
                    "maxLength": 255,
                    "description": "URL for the image to be showcased on the Carbonmark profile. If left unspecified, no image will be displayed.",
                    "type": "string",
                    "example": "https://postimg.cc/sQPXj0Bh"
                  },
                  "name": {
                    "maxLength": 255,
                    "minLength": 1,
                    "description": "The distinctive identifier for the individual or organization. Please note, this name is unique and cannot be modified once established.",
                    "type": "string",
                    "example": "carbonmark"
                  }
                }
              },
              "example": {
                "display_name": "Carbonmark",
                "description": "Carbonmark leverages advanced digital infrastructure to provide secure, auditable, and interoperable products & services for facilitating the trade and usage of environmental commodities.",
                "profile_img_url": "https://postimg.cc/sQPXj0Bh",
                "name": "carbonmark"
              }
            }
          },
          "required": true
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..uRi8T-GSlYDIoYIAmHnRxYKrgK483CBDUkaItopCUko",
            "in": "header",
            "name": "Authorization",
            "required": true,
            "description": "Bearer token"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
