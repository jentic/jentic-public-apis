    "/quotes": {
      "post": {
        "summary": "Request a retirement quote",
        "tags": [
          "Quotes"
        ],
        "description": "Request a retirement quote from a seller listing.\n\nIf you are using sandbox mode, you can use the value `listing-137-0x3aec46f1f61cae3485e99cc8c4d6ad6d6bea4354f0da97ebb19e405b73aba70d` for the `asset_price_source_id` parameter to simulate a failed transaction. Any other values will simulate a successful transaction.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "properties": {
                  "asset_price_source_id": {
                    "description": "ID of the asset price returned by the `/prices` resource",
                    "type": "string",
                    "pattern": "carbon_pool-(137|8453|84532)-0x\\w{40}-\\d+-(ubo|nbo|bct|nct|mco2|cco2)$|listing-(137|8453|84532)-0x\\w{64}$|product-(137|8453|84532)-(mco2|cco2)",
                    "example": "listing-137-0x12dbdff6fa065abc002324b5f2c1546b06e0440b1906438669a492e1987690f4"
                  },
                  "quantity_tonnes": {
                    "description": "Number of tonnes to retire",
                    "type": "number",
                    "example": 15
                  }
                },
                "required": [
                  "asset_price_source_id",
                  "quantity_tonnes"
                ]
              },
              "example": {
                "asset_price_source_id": "listing-137-0x886289a280cd265093215ff2893c29ff24c1381e830f63b0c71a335a7f15b362",
                "quantity_tonnes": 1
              }
            }
          },
          "required": true
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "example": "Bearer cm_api_d286bc5a-9980-43b7-9507-7fc013fecca8",
            "in": "header",
            "name": "Authorization",
            "required": true,
            "description": "Bearer token"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quote"
                },
                "examples": {
                  "Retire from Seller Listing Order": {
                    "value": {
                      "asset_price_source_id": "listing-137-0x12dbdff6fa065abc002324b5f2c1546b06e0440b1906438669a492e1987690f4",
                      "uuid": "07495f6c-8b02-465d-8fdd-4bcc2d2047e9",
                      "created_at": "2024-03-25T22:01:23.236141+00:00",
                      "updated_at": "2024-03-25T22:01:23.236141+00:00",
                      "credential_id": 93,
                      "quantity_tonnes": 1,
                      "cost_usdc": 0.5,
                      "consumed": 0
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/retirements": {
      "get": {
        "summary": "List retirements",
