                    "title": "ICR",
                    "type": "string",
                    "enum": [
                      "ICR"
                    ]
                  },
                  {
                    "title": "PUR",
                    "type": "string",
                    "enum": [
                      "PUR"
                    ]
                  },
                  {
                    "title": "JCS",
                    "type": "string",
                    "enum": [
                      "JCS"
                    ]
                  },
                  {
                    "title": "ECO",
                    "type": "string",
                    "enum": [
                      "ECO"
                    ]
                  },
                  {
                    "title": "CMARK",
                    "type": "string",
                    "enum": [
                      "CMARK"
                    ]
                  },
                  {
                    "title": "CCS",
                    "type": "string",
                    "enum": [
                      "CCS"
                    ]
                  },
                  {
                    "title": "TVER",
                    "type": "string",
                    "enum": [
                      "TVER"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "description": "Website of the product",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "coverImage": {
            "description": "Primary cover image to be shown on product page",
            "$ref": "#/components/schemas/ImageModel"
          },
          "images": {
            "description": "Other images associated with this product",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageModel"
            }
          },
          "assetPrices": {
            "description": "Prices of the products",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetPrice"
            }
          }
        },
        "required": [
          "id",
          "name",
          "short_description",
          "long_description",
          "sustainableDevelopmentGoals",
          "assetPrices"
        ]
      },
      "GeoJSONPoint": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Feature"
            ]
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Point"
                ]
              },
              "coordinates": {
                "minItems": 2,
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "type",
              "coordinates"
            ]
          }
        },
        "required": [
          "type",
          "geometry"
        ]
      },
      "APIInfo": {
        "type": "object",
        "properties": {
          "MAX_USDC": {
            "description": "Maximum value in USDC that can be retired using the API",
            "type": "number"
          }
        },
        "required": [
          "MAX_USDC"
        ]
      },
      "Assessor": {
        "type": "object",
        "properties": {
          "id": {
            "description": "ID of the assessor",
            "type": "string"
          },
          "name": {
            "description": "Name of the assessor",
            "type": "string"
          },
          "link": {
            "anyOf": [
              {
                "description": "Link to the assessor website",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "avatar": {
            "anyOf": [
              {
                "description": "Image representing the assessor",
                "$ref": "#/components/schemas/ImageModel"
              },
              {
                "type": "null"
              }
            ]
          },
          "accreditations": {
            "type": "array",
            "items": {
              "description": "Accreditations of the assessor",
              "type": "object",
              "properties": {
                "name": {
                  "description": "Name of the accreditation or the accreditation organisation",
                  "type": "string"
                },
                "link": {
                  "anyOf": [
                    {
                      "description": "URL of the accreditation organisation website",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "name"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "accreditations"
        ]
      },
      "Developer": {
        "type": "object",
        "properties": {
          "id": {
            "description": "ID of the developer",
            "type": "string"
          },
          "name": {
            "description": "Name of the developer",
            "type": "string"
          },
          "link": {
            "anyOf": [
              {
                "description": "Link to the developer website",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "handles": {
            "description": "Handles associated to this developer",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "avatar": {
