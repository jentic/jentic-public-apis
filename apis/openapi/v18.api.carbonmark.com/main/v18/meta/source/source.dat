              ]
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "registry": {
            "anyOf": [
              {
                "description": "Registry",
                "default": "polygon",
                "anyOf": [
                  {
                    "title": "VCS",
                    "type": "string",
                    "enum": [
                      "VCS"
                    ]
                  },
                  {
                    "title": "GS",
                    "type": "string",
                    "enum": [
                      "GS"
                    ]
