          "Wallets"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "example": "137-ERC20-0x314c0a010e148f1e1286f96f78ed366255267d54",
            "in": "query",
            "name": "tokenIdentifier",
            "required": true,
            "description": "Identifier of the token"
          },
          {
            "schema": {
              "type": "string"
            },
            "example": "0x8cE54d9625371fb2a068986d32C85De8E6e995f8",
            "in": "query",
            "name": "spenderAddress",
            "required": true,
            "description": "Address of the spender"
          },
          {
            "schema": {
              "type": "string"
            },
            "example": "Bearer cm_api_d286bc5a-9980-43b7-9507-7fc013fecca8",
            "in": "header",
            "name": "Authorization",
            "required": true,
            "description": "Bearer token"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "uuid",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllowanceModel"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/wallets/{uuid}/transactions": {
      "get": {
        "summary": "Get a wallet transaction by id",
        "tags": [
          "Wallets"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "example": "d6ef5152-75ab-5a1d-9c2d-54b66251395c",
            "in": "query",
            "name": "refId",
            "required": true,
            "description": "refId of the transaction"
          },
          {
            "schema": {
              "type": "string"
            },
            "example": "4942ccc4-b900-4e18-9ba6-2f720b352108",
            "in": "path",
            "name": "uuid",
            "required": true,
            "description": "UUID of the wallet"
          },
          {
            "schema": {
              "type": "string"
            },
            "example": "Bearer cm_api_d286bc5a-9980-43b7-9507-7fc013fecca8",
            "in": "header",
            "name": "Authorization",
            "required": true,
            "description": "Bearer token"
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WalletTransactionModel"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a transaction challenge",
        "tags": [
          "Wallets"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idempotencyKey": {
                    "description": "Unique value generated by the client, which the server uses to recognize subsequent retries of the same request. You must generate and provide an idempotency key formatted as a UUID version 4 format.",
                    "type": "string",
                    "pattern": "^[0-9(a-f|A-F)]{8}-[0-9(a-f|A-F)]{4}-4[0-9(a-f|A-F)]{3}-[89ab][0-9(a-f|A-F)]{3}-[0-9(a-f|A-F)]{12}$"
                  },
                  "abiFunctionSignature": {
                    "description": "The contract ABI function signature or `callData` field is required for interacting with the smart contract. The ABI function signature cannot be used simultaneously with `callData`. e.g. Burn(uint256).",
                    "type": "string"
                  },
                  "abiParameters": {
                    "description": "The contract ABI function signature parameters for executing the contract interaction. Supported parameter types include string, integer, boolean, and array. These parameters should be used exclusively with the abiFunctionSignature and cannot be used with `callData`.",
                    "type": "array",
                    "items": {}
                  },
                  "callData": {
                    "description": "The raw transaction data, must be an even-length hexadecimal string with the `0x` prefix, to be executed. It is important to note that the usage of `callData` is mutually exclusive with the `abiFunctionSignature` and `abiParameters`. Therefore, `callData` cannot be utilized simultaneously with either `abiFunctionSignature` or `abiParameters`.",
                    "type": "string"
                  },
                  "amount": {
                    "description": "The amount of native token that will be sent to the contract abi execution. Optional field for payable api only, if not provided, no native token will be sent.",
                    "type": "string"
                  },
                  "contractAddress": {
                    "description": "Optional reference or description used to identify the transaction.",
                    "type": "string"
                  },
                  "refId": {
                    "description": "Optional reference or description used to identify the transaction.",
                    "type": "string"
                  },
                  "fee": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "absolute"
                            ]
                          },
                          "config": {
                            "type": "object",
                            "properties": {
                              "maxFee": {
                                "description": "The maximum price per gas unit (see gasLimit), in gwei.\n          Requires priorityFee, and gasLimit, but incompatible with feeLevel or gasPrice.\n          Use the Estimate Fee methods to get this fee's estimates.",
                                "type": "string"
                              },
                              "priorityFee": {
                                "description": "Requires maxFee, and gasLimit but incompatible with feeLevel or gasPrice.\n         Use the Estimate Fee methods for fee estimates.",
                                "type": "string"
                              },
                              "gasLimit": {
                                "description": "The maximum gas units for the transaction, required if feeLevel isn't provided.\n         Use the Estimate Fee methods for this limit's estimation.",
                                "type": "string"
                              }
                            },
                            "required": [
                              "maxFee",
                              "priorityFee",
                              "gasLimit"
                            ]
                          }
                        },
                        "required": [
                          "type",
                          "config"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "gas"
                            ]
                          },
                          "config": {
                            "type": "object",
                            "properties": {
                              "gasLimit": {
                                "description": "The maximum gas units for the transaction, required if feeLevel isn't provided.\n         Use the Estimate Fee methods for this limit's estimation.",
                                "type": "string"
                              },
                              "gasPrice": {
                                "description": "For EIP-1559 supported blockchains, it's the max gas price per gas unit (see gasLimit), in gwei.\n         Requires gasLimit and incompatible with feeLevel, priorityFee, or maxFee.\n         Use the Estimate Fee methods for fee estimates.",
                                "type": "string"
                              }
                            },
                            "required": [
                              "gasLimit",
                              "gasPrice"
                            ]
                          }
                        },
                        "required": [
                          "type",
                          "config"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "level"
                            ]
                          },
                          "config": {
                            "type": "object",
                            "properties": {
                              "feeLevel": {
                                "description": " A dynamic fee level setting (LOW, MEDIUM, HIGH) determining the gas price for the transaction,\n         based on network conditions. Incompatible with gasLimit, gasPrice, priorityFee, or maxFee.\n         Use the Estimate Fee methods for fee level estimates.",
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "enum": [
                                      "LOW"
                                    ]
                                  },
                                  {
                                    "type": "string",
                                    "enum": [
                                      "MEDIUM"
                                    ]
                                  },
                                  {
                                    "type": "string",
                                    "enum": [
                                      "HIGH"
                                    ]
                                  }
                                ]
                              }
                            },
                            "required": [
                              "feeLevel"
                            ]
                          }
                        },
                        "required": [
                          "type",
                          "config"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "idempotencyKey",
                  "contractAddress",
                  "fee"
                ]
              }
            }
          },
          "required": true
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "example": "Bearer cm_api_d286bc5a-9980-43b7-9507-7fc013fecca8",
            "in": "header",
            "name": "Authorization",
            "required": true,
            "description": "Bearer token"
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "uuid",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "challengeId": {
                      "type": "string"
                    },
                    "encryptionKey": {
                      "type": "string"
                    },
                    "userToken": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "challengeId",
                    "encryptionKey",
                    "userToken"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/retirements/{beneficiaryAddress}/{retirementIndex}/status": {
      "get": {
        "summary": "Retirement indexing status",
        "tags": [
          "Retirements"
        ],
        "description": "Get a retirement indexing status given its beneficiary address and retirement index",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "example": "0x087a7afb6975a2837453be685eb6272576c0bc",
            "in": "path",
            "name": "beneficiaryAddress",
            "required": true,
            "description": "Address of the retirement beneficiary"
          },
          {
            "schema": {
              "type": "number"
            },
            "example": "5",
            "in": "path",
            "name": "retirementIndex",
            "required": true,
            "description": "Retirement index"
          }
        ],
        "responses": {
          "200": {
            "description": "Retirement indexing status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetirementIndexingStatus"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
