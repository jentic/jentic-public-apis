          "400": {
            "description": "Returned when a developer ID does not match any existing folder in the workspace",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Error message describing the validation failure"
