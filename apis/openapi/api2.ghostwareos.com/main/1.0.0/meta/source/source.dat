{
  "openapi": "3.0.3",
  "info": {
    "title": "GhostPay API",
    "description": "Payment links and payment processing API",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ghostware/GhoswareAPI/1.0.0"
  },
  "servers": [
    {
      "url": "https://api2.ghostwareos.com/api",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/links": {
      "post": {
        "summary": "Create a payment link",
        "operationId": "createLink",
        "tags": [
          "Links"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "receiverAddress",
                  "amount",
                  "asset"
                ],
                "properties": {
                  "receiverAddress": {
                    "type": "string",
                    "description": "Solana wallet address to receive payment",
                    "example": "9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM"
                  },
                  "amount": {
                    "type": "number",
                    "description": "Amount in human-readable units (not lamports)",
                    "example": 1.5
                  },
                  "asset": {
                    "type": "string",
                    "enum": [
                      "SOL",
                      "USDC",
                      "USDT",
                      "USD1"
                    ],
                    "description": "Asset type for payment",
                    "example": "SOL"
                  },
                  "memo": {
                    "type": "string",
                    "description": "Optional memo/note for the payment",
                    "example": "Payment for services"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment link created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "linkId": {
                      "type": "string",
                      "description": "Unique 12-character hex identifier",
                      "example": "a1b2c3d4e5f6"
                    },
                    "amount": {
                      "type": "number",
                      "description": "Amount in smallest units (lamports for SOL, 6 decimals for stablecoins)",
                      "example": 1500000000
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/links/wallets/{wallet}": {
      "get": {
        "summary": "Get payment links by wallet address",
        "operationId": "getLinksByWallet",
        "tags": [
          "Links"
        ],
        "parameters": [
          {
            "name": "wallet",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Solana wallet address",
            "example": "9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Pagination cursor (link_row_id to fetch before)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Number of records to return"
          }
        ],
        "responses": {
          "200": {
            "description": "List of payment links",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WalletLinkItem"
                      }
                    },
                    "nextCursor": {
                      "type": "integer",
                      "nullable": true,
                      "description": "Cursor for next page, null if no more pages"
                    },
                    "hasMore": {
                      "type": "boolean"
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "totalItems": {
                          "type": "integer"
                        },
                        "perPage": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No records found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/links/{linkId}": {
      "get": {
        "summary": "Get payment link details",
        "operationId": "getLinkById",
        "tags": [
          "Links"
        ],
        "security": [
          {
            "BearerAuth": [],
            "JWTAuth": []
          }
        ],
        "parameters": [
          {
            "name": "linkId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Payment link ID",
            "example": "a1b2c3d4e5f6"
          }
        ],
        "responses": {
          "200": {
            "description": "Payment link details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkDetails"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Link not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/payments/initiate": {
      "post": {
        "summary": "Initiate a payment",
        "description": "Initiates payment for a link. Requires wallet signature verification.",
        "operationId": "initiatePayment",
        "tags": [
          "Payments"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "linkId",
                  "payerAddress",
                  "message",
                  "signature"
                ],
                "properties": {
                  "linkId": {
                    "type": "string",
                    "description": "Payment link ID",
                    "example": "a1b2c3d4e5f6"
                  },
                  "payerAddress": {
                    "type": "string",
                    "description": "Payer's Solana wallet address",
                    "example": "9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM"
                  },
                  "message": {
                    "type": "string",
                    "description": "Message to sign. Must start with: ghostpay:pay:{linkId}",
                    "example": "ghostpay:pay:a1b2c3d4e5f6"
                  },
                  "signature": {
                    "type": "string",
                    "description": "Base58-encoded Ed25519 signature of the message, signed by the payerAddress wallet"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment initiated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "JWT token for subsequent requests (30min expiry)"
                    },
                    "depositAddress": {
                      "type": "string",
                      "description": "Address to send payment to"
                    },
                    "linkId": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "number",
                      "description": "Amount to deposit"
                    },
                    "symbol": {
                      "type": "string",
                      "description": "Asset symbol"
                    },
                    "expires": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Payment expiration time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "Invalid signature",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Link not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Link already being processed or already paid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/sends/initiate": {
      "post": {
        "summary": "Initiate a cross-chain send/swap",
        "description": "Initiates a cross-chain send or token swap. Minimum amount is $50 USD equivalent.",
        "operationId": "initiateSend",
        "tags": [
          "Sends"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "amount",
                  "from",
                  "to",
                  "chain",
                  "payerAddress",
                  "receiverAddress"
                ],
                "properties": {
                  "amount": {
                    "type": "number",
                    "description": "Amount to send in the source token units",
                    "example": 1.5
                  },
                  "from": {
                    "type": "string",
                    "description": "Source token to send from",
                    "enum": [
                      "SOL",
                      "ETH",
                      "USDC",
                      "USDT",
                      "USD1"
                    ],
                    "example": "SOL"
                  },
                  "to": {
                    "type": "string",
                    "description": "Destination token to receive",
                    "enum": [
                      "SOL",
                      "ETH",
                      "USDC",
                      "USDT",
                      "USD1"
                    ],
                    "example": "USDC"
                  },
                  "chain": {
                    "type": "string",
                    "description": "Blockchain to use",
                    "enum": [
                      "SOL",
                      "EVM"
                    ],
                    "example": "SOL"
                  },
                  "payerAddress": {
                    "type": "string",
                    "description": "Sender's wallet address (must match chain format)",
                    "example": "9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM"
                  },
                  "receiverAddress": {
                    "type": "string",
                    "description": "Receiver's wallet address (must match chain format)",
                    "example": "8XzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAXXN"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Send initiated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "depositAddress": {
                      "type": "string",
                      "description": "Address to send payment to",
                      "example": "7YzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAYYO"
                    },
                    "tokenIn": {
                      "type": "string",
                      "description": "Input token symbol",
                      "example": "SOL"
                    },
                    "tokenOut": {
                      "type": "string",
                      "description": "Output token symbol",
                      "example": "USDCSOL"
                    },
                    "amountIn": {
                      "type": "number",
                      "description": "Amount to send",
                      "example": 1.5
                    },
                    "amountOut": {
                      "type": "number",
                      "description": "Amount receiver will receive",
                      "example": 150.25
                    },
                    "expires": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Send expiration time"
                    },
                    "eta": {
                      "type": "number",
                      "description": "Estimated time to completion in minutes",
                      "example": 5
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters (invalid chain, address format, or amount below $50 USD)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key in format: gp_live_xxxxxxxxxxxxxxxxxxxxxxxx"
      },
      "JWTAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token from /payments/initiate"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "WalletLinkItem": {
        "type": "object",
        "properties": {
          "link_row_id": {
            "type": "integer"
          },
          "link_id": {
            "type": "string"
          },
          "amount_lamports": {
            "type": "number"
          },
          "link_status": {
            "type": "string",
            "enum": [
              "pending",
              "paid"
            ]
          },
          "link_created_at": {
            "type": "string",
            "format": "date-time"
          },
          "asset": {
            "type": "string"
          },
          "memo": {
            "type": "string",
            "nullable": true
          },
          "payment_status": {
            "type": "string",
            "nullable": true
          },
          "is_stalled": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "LinkDetails": {
        "type": "object",
        "properties": {
          "amount_lamports": {
            "type": "number"
          },
          "link_status": {
            "type": "string"
          },
          "qr_code": {
            "type": "string",
            "nullable": true
          },
          "asset": {
            "type": "string"
          },
          "memo": {
            "type": "string",
            "nullable": true
          },
          "deposit_address": {
            "type": "string",
            "nullable": true
          },
          "payment_status": {
            "type": "string",
            "nullable": true
          },
          "is_stalled": {
            "type": "boolean",
            "nullable": true
          },
          "payer_address": {
            "type": "string",
            "nullable": true
          },
          "link_created_at": {
            "type": "string",
            "format": "date-time"
          },
          "payment_created_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "payment_updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "expectedReward": {
            "type": "number",
            "description": "Expected GHOST token reward amount"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request parameters",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
