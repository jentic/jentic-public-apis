{
  "openapi": "3.0.3",
  "info": {
    "title": "Loyalty API",
    "version": "1.0.0",
    "description": "Loyalty API including balance,accumulations, redemptions, rewards, reversals, initialization, commit, and QR codes -Phase 1",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/mycompany-942/loyalty-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.moneris.io/loyalty"
    }
  ],
  "paths": {
    "/loyalty/balance": {
      "post": {
        "tags": [
          [
            "Loyalty"
          ]
        ],
        "summary": "Get loyalty balance",
        "description": "Returns loyalty balance, points, and rewards for a given card",
        "operationId": "getLoyaltyBalance",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoyaltyBalanceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful balance response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoyaltyBalanceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/loyalty/accumulations": {
      "post": {
        "tags": [
          [
            "Loyalty"
          ]
        ],
        "summary": "Accumulate loyalty points",
        "description": "Processes a purchase transaction to accumulate loyalty points",
        "operationId": "accumulateLoyaltyPoints",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoyaltyAccumulationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accumulation processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoyaltyAccumulationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/loyalty/redemptions": {
      "post": {
        "summary": "Redeem loyalty points",
        "operationId": "redeemPoints",
        "tags": [
          [
            "Loyalty"
          ]
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redeem response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedeemResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/loyalty/rewards": {
      "post": {
        "summary": "Get reward details for a card",
        "operationId": "getRewardDetails",
        "tags": [
          "Rewards"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RewardDetailsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reward details response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RewardDetailsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/loyalty/reward-redemptions": {
      "post": {
        "summary": "Redeem rewards",
        "operationId": "redeemReward",
        "tags": [
          "Rewards"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RewardRedemptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reward redemption response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RewardRedemptionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/loyalty/reversal": {
      "post": {
        "summary": "Full reversal",
        "operationId": "fullReversal",
        "tags": [
          [
            "Loyalty"
          ]
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReversalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full reversal response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReversalResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/loyalty/partial-reversal": {
      "post": {
        "summary": "Partial reversal",
        "operationId": "partialReversal",
        "tags": [
          [
            "Loyalty"
          ]
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartialReversalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Partial reversal response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartialReversalResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/loyalty/item-reversal": {
      "post": {
        "summary": "Item-level reversal",
        "operationId": "itemReversal",
        "tags": [
          "Rewards"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemReversalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Item reversal response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemReversalResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/loyalty/commit": {
      "post": {
        "summary": "Commit transaction",
        "operationId": "commitTransaction",
        "tags": [
          [
            "Loyalty"
          ]
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Commit response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommitResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/loyalty/initialization": {
      "get": {
        "summary": "Initialize loyalty settings",
        "operationId": "getInitialization",
        "tags": [
          "Initialization"
        ],
        "responses": {
          "200": {
            "description": "Initialization response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InitializationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/loyalty/qrcode": {
      "get": {
        "summary": "Get QR code for loyalty program",
        "operationId": "getQRCode",
        "tags": [
          "Signup"
        ],
        "responses": {
          "200": {
            "description": "QR Code response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QRCodeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/loyalty/non-member-accumulation": {
      "post": {
        "summary": "Non-member accumulation transaction",
        "operationId": "nonMemberAccumulation",
        "tags": [
          "Signup"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NonMemberAccumulationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Non-member accumulation response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NonMemberAccumulationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Timestamp": {
        "type": "string",
        "format": "date-time",
        "example": "2020-03-26T00:57:08.000-08:00"
      },
      "Currency": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3,
        "example": "CAD"
      },
      "Amount": {
        "type": "number",
        "format": "double",
        "multipleOf": 0.01,
        "description": "Numeric amount with 2 decimals",
        "example": 100.0
      },
      "Points": {
        "type": "number",
        "format": "double",
        "multipleOf": 0.01,
        "description": "Points value with 2 decimals",
        "example": 100.0
      },
      "Status": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Application or DataCandy status code",
            "example": "00"
          },
          "message": {
            "type": "string",
            "description": "Human-readable status message",
            "example": "Transaction successful"
          }
        }
      },
      "Channel": {
        "type": "object",
        "required": [
          "channelType"
        ],
        "discriminator": {
          "propertyName": "channelType",
          "mapping": {
            "TERMINAL": "#/components/schemas/TerminalChannel",
            "CHECKOUT": "#/components/schemas/CheckoutChannel",
            "API": "#/components/schemas/APIChannel"
          }
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/TerminalChannel"
          },
          {
            "$ref": "#/components/schemas/CheckoutChannel"
          },
          {
            "$ref": "#/components/schemas/APIChannel"
          }
        ]
      },
      "TerminalChannel": {
        "type": "object",
        "required": [
          "channelType",
          "terminalId"
        ],
        "properties": {
          "channelType": {
            "type": "string",
            "enum": [
              "TERMINAL"
            ]
          },
          "terminalId": {
            "type": "string"
          },
          "clerkId": {
            "type": "string"
          },
          "workStationId": {
            "type": "string"
          }
        }
      },
      "CheckoutChannel": {
        "type": "object",
        "required": [
          "channelType",
          "orderId",
          "checkoutId"
        ],
        "properties": {
          "channelType": {
            "type": "string",
            "enum": [
              "CHECKOUT"
            ]
          },
          "orderId": {
            "type": "string"
          },
          "checkoutId": {
            "type": "string"
          }
        }
      },
      "APIChannel": {
        "type": "object",
        "required": [
          "channelType",
          "externalReference"
        ],
        "properties": {
          "channelType": {
            "type": "string",
            "enum": [
              "API"
            ]
          }
        },
        "externalReference": {
          "type": "string"
        }
      },
      "InvoiceId": {
        "type": "string",
        "example": "INV-10001"
      },
      "Reward": {
        "type": "object",
        "properties": {
          "rewardSku": {
            "type": "string"
          },
          "rewardLabel": {
            "type": "string"
          },
          "rewardBarcode": {
            "type": "string"
          },
          "rewardExpiryDate": {
            "type": "string",
            "format": "date"
          },
          "rewardBarcodeFormat": {
            "type": "string"
          }
        }
      },
      "LanguageCode": {
        "type": "string",
        "enum": [
          "en",
          "fr"
        ]
      },
      "LineItem": {
        "type": "object",
        "description": "Common line item object",
        "required": [
          "itemId",
          "quantity",
          "amount"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "description": "Line item identifier",
            "example": "LINE-001"
          },
          "upc": {
            "type": "string",
            "description": "UPC code",
            "example": "012345678905"
          },
          "productCode": {
            "type": "string",
            "description": "Internal product SKU",
            "example": "SKU-12345"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          },
          "amount": {
            "type": "number",
            "format": "decimal",
            "description": "Monetary amount",
            "example": 100.0
          },
          "eligibleForAccumulation": {
            "type": "boolean",
            "description": "Whether item is eligible for loyalty accumulation",
            "example": true
          }
        }
      },
      "PromotionItem": {
        "type": "object",
        "description": "Line item affected by a promotion",
        "required": [
          "id",
          "promotionalPoints",
          "eligibleQuantity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Line item identifier",
            "example": "LineOne"
          },
          "upc": {
            "type": "string",
            "description": "Item UPC or SKU",
            "example": "sku10"
          },
          "ipc": {
            "type": "string",
            "description": "Internal product code",
            "example": "ipc10"
          },
          "promotionalPoints": {
            "type": "number",
            "format": "decimal",
            "description": "Promotional points awarded for this item",
            "example": 0.0
          },
          "eligibleQuantity": {
            "type": "integer",
            "minimum": 0,
            "description": "Quantity eligible for the promotion",
            "example": 0
          }
        }
      },
      "PromotionApplied": {
        "type": "object",
        "description": "Applied promotion details (returned only when RIP=1)",
        "required": [
          "promotionId",
          "name"
        ],
        "properties": {
          "promotionId": {
            "type": "string",
            "description": "Internal promotion identifier",
            "example": "4"
          },
          "externalReference": {
            "type": "string",
            "description": "External promotion reference",
            "example": "abc"
          },
          "name": {
            "type": "string",
            "description": "Promotion name",
            "example": "Promotion abc"
          },
          "promotionalPoints": {
            "type": "number",
            "format": "decimal",
            "description": "Total promotional points awarded by this promotion",
            "example": 0.0
          },
          "items": {
            "type": "array",
            "description": "Items participating in this promotion",
            "items": {
              "$ref": "#/components/schemas/PromotionItem"
            }
          }
        }
      },
      "DiscountPromotion": {
        "type": "object",
        "description": "Discount promotion applied to the transaction",
        "required": [
          "id",
          "type",
          "value"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Discount promotion identifier",
            "example": 1584715641
          },
          "type": {
            "type": "string",
            "description": "Discount promotion type",
            "enum": [
              "PERCENT",
              "AMOUNT",
              "CODE"
            ],
            "example": "PERCENT"
          },
          "value": {
            "type": "number",
            "format": "decimal",
            "description": "Discount value (percentage or amount depending on type)",
            "example": 0.0
          }
        }
      },
      "LoyaltyBalanceRequest": {
        "type": "object",
        "required": [
          "channel",
          "cardId",
          "timestamp",
          "currency",
          "languageCode"
        ],
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "cardId": {
            "type": "string"
          },
          "timestamp": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "profileCompleteCheckFlag": {
            "type": "boolean",
            "default": false
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "languageCode": {
            "$ref": "#/components/schemas/LanguageCode"
          }
        }
      },
      "LoyaltyBalanceResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "cardId": {
            "type": "string"
          },
          "transactionId": {
            "type": "string"
          },
          "confirmationNumber": {
            "type": "string"
          },
          "timestamp": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "programCode": {
            "type": "string"
          },
          "profileCompleted": {
            "type": "boolean"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "languageCode": {
            "$ref": "#/components/schemas/LanguageCode"
          },
          "message": {
            "type": "string"
          },
          "totalBalancePoints": {
            "$ref": "#/components/schemas/Points"
          },
          "totalPointsValue": {
            "$ref": "#/components/schemas/Amount"
          },
          "totalAvailablePoints": {
            "$ref": "#/components/schemas/Points"
          },
          "totalAvailablePointsValue": {
            "$ref": "#/components/schemas/Amount"
          },
          "rewards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reward"
            }
          },
          "loyaltyRedeemable": {
            "type": "boolean"
          },
          "receiptMessage": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LoyaltyAccumulationRequest": {
        "type": "object",
        "required": [
          "channel",
          "cardId",
          "timestamp",
          "transactionAmount",
          "paymentMethod",
          "currency",
          "languageCode"
        ],
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "cardId": {
            "type": "string"
          },
          "timestamp": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "profileCompleteCheckFlag": {
            "type": "boolean"
          },
          "autoCommit": {
            "type": "boolean"
          },
          "returnPromotions": {
            "type": "boolean"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "languageCode": {
            "$ref": "#/components/schemas/LanguageCode"
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "CASH",
              "CREDIT",
              "DEBIT",
              "GIFTCARD",
              "POINTS"
            ]
          },
          "transactionAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "redemptionAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "discountEligibleAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "accumulationExcludedAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "accumulationPoints": {
            "$ref": "#/components/schemas/Points"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineItem"
            }
          },
          "invoiceId": {
            "$ref": "#/components/schemas/InvoiceId"
          }
        }
      },
      "LoyaltyAccumulationResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "cardId": {
            "type": "string"
          },
          "invoiceId": {
            "$ref": "#/components/schemas/InvoiceId"
          },
          "transactionId": {
            "type": "string"
          },
          "confirmationNumber": {
            "type": "string"
          },
          "timestamp": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "programCode": {
            "type": "string"
          },
          "profileCompleted": {
            "type": "boolean"
          },
          "autoCommit": {
            "type": "boolean"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "languageCode": {
            "$ref": "#/components/schemas/LanguageCode"
          },
          "message": {
            "type": "string"
          },
          "paymentMethod": {
            "type": "string",
            "enum": [
              "CASH",
              "CREDIT",
              "DEBIT",
              "GIFTCARD",
              "POINTS"
            ]
          },
          "transactionAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "redemptionAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "discountAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "excludedAmount": {
            "$ref": "#/components/schemas/Amount"
          },
          "transactionAmountCalculation": {
            "type": "string",
            "enum": [
              "AMT",
              "ASD",
              "ASR",
              "SDR",
              "AMTX",
              "XAM",
              "ASRX"
            ]
          },
          "promotionPoints": {
            "$ref": "#/components/schemas/Points"
          },
          "addedPoints": {
            "$ref": "#/components/schemas/Points"
          },
          "addedPointsValue": {
            "$ref": "#/components/schemas/Amount"
          },
          "totalBalancePoints": {
            "$ref": "#/components/schemas/Points"
          },
          "totalPointsValue": {
