{
  "openapi": "3.0.3",
  "info": {
    "title": "Dagster External Assets REST API",
    "description": "REST API for reporting external asset materializations, observations, and check evaluations in Dagster. This covers the REST portions only; Dagster's primary API is GraphQL.",
    "version": "1.0.0",
    "contact": {
      "name": "Dagster",
      "url": "https://dagster.io"
    },
    "x-jentic-source-url": "https://docs.dagster.io/api/rest_api",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://{organization}.dagster.cloud/{deployment}",
      "description": "Dagster Cloud",
      "variables": {
        "organization": {
          "description": "Your Dagster Cloud organization name",
          "default": "my-org"
        },
        "deployment": {
          "description": "Deployment name (e.g., prod, staging)",
          "default": "prod"
        }
      }
    }
  ],
  "security": [
    {
      "dagsterCloudApiToken": []
    }
  ],
  "paths": {
    "/report_asset_materialization/": {
      "post": {
        "operationId": "reportAssetMaterialization",
        "summary": "Report an external asset materialization",
        "description": "Reports that an external asset has been materialized. The asset_key can be provided via JSON body, query parameter, or URL path.",
        "tags": [
          "External Assets"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "asset_key"
                ],
                "properties": {
                  "asset_key": {
                    "type": "string",
                    "description": "The identifier of the external asset"
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Key-value pairs of metadata about the materialization",
                    "additionalProperties": true
                  },
                  "data_version": {
                    "type": "string",
                    "description": "Version identifier for the materialized asset data"
                  },
                  "description": {
                    "type": "string",
                    "description": "Human-readable description of the materialization"
                  },
                  "partition": {
                    "type": "string",
                    "description": "Partition name that was materialized"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Materialization reported successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/report_asset_check/": {
      "post": {
        "operationId": "reportAssetCheckEvaluation",
        "summary": "Report an asset check evaluation",
        "description": "Reports the result of an asset check evaluation for an external asset.",
        "tags": [
          "External Assets"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "asset_key",
                  "passed",
                  "check_name"
                ],
                "properties": {
                  "asset_key": {
                    "type": "string",
                    "description": "The identifier of the external asset"
                  },
                  "passed": {
                    "type": "boolean",
                    "description": "Whether the check passed or failed"
                  },
                  "check_name": {
                    "type": "string",
                    "description": "Name of the check that was evaluated"
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Key-value pairs of metadata about the check",
                    "additionalProperties": true
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "WARN",
                      "ERROR"
                    ],
                    "default": "ERROR",
                    "description": "Severity level of the check failure"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Check evaluation reported successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/report_asset_observation/": {
      "post": {
        "operationId": "reportAssetObservation",
        "summary": "Report an external asset observation",
        "description": "Reports an observation about an external asset without materializing it.",
        "tags": [
          "External Assets"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "asset_key"
                ],
                "properties": {
                  "asset_key": {
                    "type": "string",
                    "description": "The identifier of the external asset"
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Key-value pairs of metadata about the observation",
                    "additionalProperties": true
                  },
                  "data_version": {
                    "type": "string",
                    "description": "Version identifier for the observed asset data"
                  },
                  "description": {
                    "type": "string",
                    "description": "Human-readable description of the observation"
                  },
                  "partition": {
                    "type": "string",
                    "description": "Partition name that was observed"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Observation reported successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "dagsterCloudApiToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Dagster-Cloud-Api-Token",
        "description": "API token for Dagster Cloud authentication. Not required for OSS deployments."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          }
        }
      }
    }
  }
}
