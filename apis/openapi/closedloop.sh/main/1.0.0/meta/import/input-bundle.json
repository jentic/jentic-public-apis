  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Bearer token authentication"
      }
    },
    "schemas": {
      "Feedback": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "processing",
              "completed",
              "failed"
            ]
          }
        }
      },
      "FeedbackDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Feedback"
          },
          {
