{
  "openapi": "3.0.0",
  "info": {
    "version": "0.1.0",
    "title": "Wittra Customer API",
    "description": "The Wittra Customer API allows customers to retrieve their organization-, project-, device- and telemetry-data.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/wittra-iot/customer-api/0.1.0"
  },
  "paths": {
    "/v5/health": {
      "get": {
        "summary": "Check if the service is online.",
        "operationId": "getHealth",
        "tags": [
          "Health"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Returns {\"status\": \"OK\"}",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "$ref": "#/components/schemas/healthResponseOk"
                    }
                  }
                },
                "examples": {
                  "healthCheck": {
                    "summary": "Successful health check",
                    "value": {
                      "status": "OK"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/v5/organizations/{organizationId}": {
      "get": {
        "summary": "Get organization by ID",
        "operationId": "getOrganizationById",
        "tags": [
          "Organizations"
        ],
        "parameters": [
          {
            "name": "organizationId",
            "description": "The ID of the organization to retrieve",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/organization"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorUnauthorized"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/v5/organizations/{organizationId}/projects": {
      "get": {
        "summary": "Get all projects for an organization",
        "operationId": "getProjectsByOrganizationId",
        "tags": [
          "Projects"
        ],
        "parameters": [
          {
            "name": "organizationId",
            "description": "The ID of the organization to retrieve projects for",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/projectList"
                },
                "example": {
                  "projects": [
                    {
                      "id": "abc123",
                      "name": "Production Project",
                      "region": "eu",
                      "organizationId": "org_12345",
                      "createdAt": "2024-01-01T00:00:00Z",
                      "updatedAt": "2024-01-15T10:00:00Z"
                    },
                    {
                      "id": "def456",
                      "name": "Development Project",
                      "region": "us",
                      "organizationId": "org_12345",
                      "createdAt": "2024-01-10T00:00:00Z",
                      "updatedAt": "2024-01-15T10:00:00Z"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorUnauthorized"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/v5/organizations/{organizationId}/projects/{projectId}": {
      "get": {
        "summary": "Get a specific project by ID within an organization",
        "operationId": "getProjectById",
        "tags": [
          "Projects"
        ],
        "parameters": [
          {
            "name": "organizationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/project"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorUnauthorized"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/v5/organizations/{organizationId}/projects/{projectId}/devices": {
      "get": {
        "summary": "Get all devices for a project",
        "operationId": "getDevicesByProjectId",
        "tags": [
          "Devices"
        ],
        "parameters": [
          {
            "name": "organizationId",
            "description": "The ID of the organization to retrieve devices for",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectId",
            "description": "The ID of the project to retrieve devices for",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/deviceList"
                },
                "example": {
                  "devices": [
                    {
                      "id": "D00124B00249ECF30",
                      "name": "My First Device",
                      "model": "CHAMELEON-1.1-EU",
                      "type": "tag",
                      "createdAt": "2024-01-05T12:00:00Z",
                      "updatedAt": "2024-01-15T10:00:00Z",
                      "group": "My Device Group"
                    },
                    {
                      "id": "D00124B00249ECF31",
                      "name": "My Second Device",
                      "model": "CHAMELEON-1.1-EU",
                      "type": "meshrouter",
                      "createdAt": "2024-01-06T12:00:00Z",
                      "updatedAt": "2024-01-15T10:00:00Z",
                      "group": "My Device Group"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorUnauthorized"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/v5/organizations/{organizationId}/projects/{projectId}/telemetry": {
      "get": {
        "summary": "Get telemetry data for a specific project within an organization",
        "operationId": "getTelemetryByProjectId",
        "tags": [
          "Telemetry"
        ],
        "parameters": [
          {
            "name": "organizationId",
            "description": "The ID of the organization to retrieve telemetry data for",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "projectId",
            "description": "The ID of the project to retrieve telemetry data for",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deviceIds",
            "description": "List of device IDs to filter the telemetry data",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": [
              "device1",
              "device2"
            ]
          },
          {
            "name": "sensorIds",
            "description": "List of sensor IDs to filter the telemetry data",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": [
              "sensor1",
              "sensor2"
            ]
          },
          {
            "name": "startTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Start time for the telemetry data range (RFC3339 format). If not provided, defaults to the 24 hours prior to the current time.",
            "example": "2024-09-11T07:00:00Z"
          },
          {
            "name": "endTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "End time for the telemetry data range (RFC3339 format). If not provided, defaults to the current time.",
            "example": "2024-09-11T08:00:00Z"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response returning telemetry data for all devices in the project (or filtered by deviceIds/sensorIds if provided)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/telemetryResponse"
                },
                "examples": {
                  "multipleDevices": {
                    "summary": "Telemetry data from multiple devices",
                    "value": {
                      "devices": [
                        {
                          "deviceId": "device_001",
                          "timestamp": "2024-09-11T07:42:04.486605925Z",
                          "data": {
                            "wittra-tag-accelerometer": {
                              "timestamp": "2024-09-11T07:42:04.486605925Z",
                              "x": {
                                "value": 0.012,
                                "unit": "G"
                              },
                              "y": {
                                "value": 0.025,
                                "unit": "G"
                              },
                              "z": {
                                "value": -0.955,
                                "unit": "G"
                              }
                            },
                            "wittra-tag-temperature": {
                              "timestamp": "2024-09-11T07:42:04.486605925Z",
                              "temperature": {
                                "value": 23.5,
                                "unit": "C"
                              }
                            }
                          }
                        },
                        {
                          "deviceId": "device_002",
                          "data": {
                            "wittra-tag-accelerometer": {
                              "timestamp": "2024-09-11T07:42:05.123456789Z",
                              "x": {
                                "value": 0.008,
                                "unit": "G"
                              },
                              "y": {
                                "value": 0.015,
                                "unit": "G"
                              },
                              "z": {
                                "value": -0.982,
                                "unit": "G"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/errorUnauthorized"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "error": {
        "description": "An error response",
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "Internal Server Error"
          }
        }
      },
      "errorUnauthorized": {
        "description": "An unauthorized error response",
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "Unauthorized"
          }
        }
      },
      "organization": {
        "description": "An organization object",
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "org_12345"
          },
          "name": {
            "type": "string",
            "example": "Wittra AB"
          }
        }
      },
      "region": {
        "description": "Geographic region",
        "type": "string",
        "enum": [
          "eu",
          "us",
          "au"
        ],
        "example": "eu"
      },
      "projectBase": {
        "description": "The base properties of a Wittra project.",
        "type": "object",
        "required": [
          "id",
          "name",
          "region",
          "organizationId",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "proj_abc123xyz"
          },
          "name": {
            "type": "string",
            "example": "Production Demo Project"
          },
          "region": {
            "$ref": "#/components/schemas/region"
          },
          "organizationId": {
            "type": "string",
            "example": "org_xyz789"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "project": {
        "description": "A project object with complete information.",
        "allOf": [
          {
            "$ref": "#/components/schemas/projectBase"
          },
          {
            "type": "object",
            "required": [
              "colocationGroups"
            ],
            "properties": {
              "colocationGroups": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/colocationGroup"
                }
              }
            }
          }
        ]
      },
      "projectList": {
        "description": "A list of projects",
        "type": "object",
        "required": [
          "projects"
        ],
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/projectBase"
            },
            "example": [
              {
                "id": "abc123",
                "name": "Production Project",
                "region": "eu",
                "organizationId": "org_12345",
                "createdAt": "2024-01-01T00:00:00Z",
                "updatedAt": "2024-01-15T10:00:00Z"
              }
            ]
          }
        }
      },
      "colocationGroup": {
        "description": "Colocation group information",
        "type": "object",
        "required": [
          "incrementiveId",
          "name"
        ],
        "properties": {
          "incrementiveId": {
            "type": "integer",
            "example": 0
          },
          "name": {
            "type": "string",
            "example": "RoofTop"
          }
        }
      },
      "device": {
        "description": "A device object",
        "type": "object",
        "required": [
          "id",
          "type",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "D00124B00249ECF30"
          },
          "name": {
            "type": "string",
            "example": "My First Device"
          },
          "model": {
            "type": "string",
            "example": "CHAMELEON-1.1-EU"
          },
          "type": {
            "type": "string",
            "example": "TAG"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "group": {
            "type": "string",
            "example": "My Device Group"
          }
        }
      },
      "deviceList": {
        "description": "A list of devices",
        "type": "object",
        "required": [
          "devices"
        ],
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/device"
            }
          }
        }
      },
      "healthResponseOk": {
        "description": "Health status response indicating the service is operational",
        "type": "string",
        "enum": [
          "OK"
        ]
      },
      "telemetryResponse": {
        "description": "Response containing telemetry data as a  array of telemetry records",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/telemetryData"
        },
        "example": [
          {
            "deviceId": "device_001",
            "projectId": "proj_abc123xyz",
            "timestamp": "2024-09-11T07:42:04.486605925Z",
            "wittra-tag-accelerometer": {
              "timestamp": "2024-09-11T07:42:04.486605925Z",
              "x": {
                "value": 0.012,
                "unit": "G"
              },
              "y": {
                "value": 0.025,
                "unit": "G"
              },
              "z": {
                "value": -0.955,
                "unit": "G"
              }
            },
            "wittra-tag-battery": {
              "timestamp": "2024-09-11T07:42:04.486605925Z",
              "value": {
                "value": 85,
                "unit": "%"
              }
            }
          },
          {
            "deviceId": "device_001",
            "projectId": "proj_abc123xyz",
            "timestamp": "2024-09-11T07:42:05.486605925Z",
            "wittra-tag-accelerometer": {
              "timestamp": "2024-09-11T07:42:05.486605925Z",
              "x": {
                "value": 0.015,
                "unit": "G"
              },
              "y": {
                "value": 0.028,
                "unit": "G"
              },
              "z": {
                "value": -0.96,
                "unit": "G"
              }
            }
          },
          {
            "deviceId": "device_002",
            "projectId": "proj_abc123xyz",
            "timestamp": "2024-09-11T07:42:04.486605925Z",
            "wittra-tag-temperature": {
              "timestamp": "2024-09-11T07:42:04.486605925Z",
              "temperature": {
                "value": 23.5,
                "unit": "C"
              }
            }
          }
        ]
      },
      "telemetryData": {
        "description": "A single telemetry data object containing context and sensor readings",
        "type": "object",
        "required": [
          "deviceId",
          "projectId",
          "timestamp",
          "data"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "description": "Unique identifier for the device",
            "example": "device_001"
          },
          "projectId": {
            "type": "string",
            "description": "Unique identifier for the project",
            "example": "proj_abc123xyz"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp representing the earliest sensor reading in this data object (RFC3339Nano format)",
            "example": "2024-09-11T07:42:04.486605925Z"
          },
          "data": {
            "type": "object",
            "description": "Map of sensor name to sensor data",
            "additionalProperties": {
              "$ref": "#/components/schemas/sensorData"
            }
          }
        },
        "example": {
          "deviceId": "device_001",
          "projectId": "proj_abc123xyz",
          "timestamp": "2024-09-11T07:42:04.486605925Z",
          "data": {
            "wittra-tag-accelerometer": {
              "timestamp": "2024-09-11T07:42:04.486605925Z",
              "x": {
                "value": 0.012,
                "unit": "G"
              },
              "y": {
                "value": 0.025,
                "unit": "G"
              },
              "z": {
                "value": -0.955,
                "unit": "G"
              }
            },
            "wittra-tag-battery": {
              "timestamp": "2024-09-11T07:42:04.486605925Z",
              "value": {
                "value": 85,
                "unit": "%"
              }
            }
          }
        }
      },
      "sensorData": {
        "description": "Sensor data contain protobuf values converted to JSON format.\n",
        "type": "object",
        "additionalProperties": true,
        "example": {
          "wittra-tag-accelerometer": {
            "timestamp": "2024-09-11T07:42:04.486605925Z",
            "x": {
              "value": 0.012,
              "unit": "G"
            },
            "y": {
              "value": 0.025,
              "unit": "G"
            },
            "z": {
              "value": -0.955,
              "unit": "G"
            }
          },
          "wittra-tag-battery": {
            "timestamp": "2024-09-11T07:42:04.486605925Z",
            "value": {
              "value": 85,
              "unit": "%"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "WittraApiKey": {
        "description": "Authorize to the API using the Wittra API key generated in the Wittra Console.",
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://customer-api.wittra.se"
    }
  ],
  "security": [
    {
      "WittraApiKey": []
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Health check endpoint"
    },
    {
      "name": "Organizations",
      "description": "Endpoints related to organizations"
    },
    {
      "name": "Projects",
      "description": "Endpoints related to projects"
    },
    {
      "name": "Telemetry",
      "description": "Endpoints related to telemetry data"
    },
    {
      "name": "Devices",
      "description": "Endpoints related to devices"
    }
  ]
}
