          "404": {
            "description": "مشتري مورد نظر يافت نشد"
          },
          "401": {
            "description": "لطفاً وارد حساب كاربري شويد"
          },
          "403": {
            "description": "شما به اين بخش دسترسي نداريد"
          }
        }
      },
      "put": {
        "tags": [
          "Customers"
        ],
        "summary": "بروزرساني مشتري",
        "description": "براي مفهوم هر فيلد به داكیومنت موديان مراجعه كنيد",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "integer",
                    "enum": [
                      1,
                      2,
                      3,
                      4
                    ],
                    "description": "نوع مشتري (1: حقيقي، 2: حقوقي، 3: مشاركت مدني، 4: اتباع غير ايراني)"
                  },
                  "name": {
                    "type": "string",
                    "description": "نام مشتري"
                  },
                  "last_name": {
                    "type": "string",
                    "description": "نام خانوادگي مشتري"
                  },
                  "national_code": {
                    "type": "string",
                    "description": "كد ملي"
                  },
                  "economic_code": {
                    "type": "string",
                    "description": "كد اقتصادي"
                  },
                  "passport_number": {
                    "type": "string",
                    "description": "شماره پاسپورت"
                  },
                  "postal_code": {
                    "type": "string",
                    "description": "كد پستي"
                  },
                  "branch_code": {
                    "type": "string",
                    "description": "كد شعبه"
                  },
                  "tel": {
                    "type": "string",
                    "description": "تلفن"
                  },
                  "address": {
                    "type": "string",
                    "description": "آدرس"
                  },
                  "description": {
                    "type": "string",
                    "description": "توضيحات"
                  }
                }
              }
            }
          }
        },
