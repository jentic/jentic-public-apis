    "/transactions": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "ليست تراكنش‌ها",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "f[id]",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "f[provider]",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "1: شاهین"
          },
          {
            "name": "f[coefficient]",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "-1: فروش || 1: خرید"
          },
          {
            "name": "f[bank]",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "بر اساس بانک های داکیومنت شاهین"
          },
          {
            "name": "f[status]",
            "description": "<span dir='rtl'>-100:ناموفق || 30:در حال بررسی || 100:موفقیت آمیز</span>",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "f[branch_code]",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "f[source_account]",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
