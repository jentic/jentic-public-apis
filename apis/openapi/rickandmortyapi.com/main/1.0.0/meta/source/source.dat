                    "$ref": "#/components/schemas/Episode"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PaginationInfo": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "description": "Total number of resources."
          },
          "pages": {
            "type": "integer",
            "description": "Total number of pages."
          },
          "next": {
            "type": "string",
            "nullable": true,
            "description": "URL to the next page."
          },
          "prev": {
            "type": "string",
            "nullable": true,
            "description": "URL to the previous page."
          }
        }
      },
      "Character": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Alive",
              "Dead",
              "unknown"
            ]
          },
          "species": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": [
              "Female",
              "Male",
              "Genderless",
              "unknown"
            ]
          },
          "origin": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          },
          "location": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          },
          "image": {
            "type": "string",
            "description": "URL to the character's image."
          },
          "episode": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "URLs of episodes the character appeared in."
          },
          "url": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Location": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "residents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Episode": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "air_date": {
            "type": "string"
          },
          "episode": {
            "type": "string",
            "description": "Episode code (e.g., S01E01)."
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "URLs of characters in the episode."
          },
          "url": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
