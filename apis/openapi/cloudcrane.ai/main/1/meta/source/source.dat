{"openapi":"3.1.0","info":{"title":"CloudCrane API","version":"1","description":"Call a deployed tool over REST or MCP, read a workspace as you build it over the workspace MCP, and receive signed webhooks. Every tool's exact input schema is its own: read it from the tool's `schema` endpoint, or from MCP's `tools/list`. Send a W3C `traceparent` header to have a call join your own trace: the `traceresponse` header names our span in it, and every reply carries an `X-Request-Id`."},"servers":[{"url":"https://cloudcrane.ai/api"}],"security":[{"toolKey":[]}],"tags":[{"name":"Tool","description":"A published dataset, as a tool an agent calls. Opened by a tool key (`cc_live_…`)."},{"name":"MCP","description":"The same tool, and the build connection, over the Model Context Protocol (Streamable HTTP, stateless)."}],"paths":{"/v1/tools/{name}/schema":{"get":{"tags":["Tool"],"operationId":"getToolSchema","summary":"What the tool is and what it takes","description":"The tool's name and description for an agent, the release it serves, how that release measured on its answer key (when it has one), and the JSON Schema of the search request: which filters, exclusions and sorts this tool allows. Doesn't count towards the key's quota.","parameters":[{"name":"name","in":"path","required":true,"description":"The tool's name, as its owner set it.","schema":{"type":"string"}}],"responses":{"200":{"description":"The tool","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ToolDescription"}}}},"401":{"description":"No key, or a key that is revoked or expired. Send it as `Authorization: Bearer <key>`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"A browser origin the key doesn't allow. Call from your server, or add the origin to the key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No tool with that name for this key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"The key's rate limit or monthly quota. `Retry-After` says when to try again after a rate limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"The tool is paused by its owner, or has no published data yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/tools/{name}/search":{"post":{"tags":["Tool"],"operationId":"searchTool","summary":"Search the tool's records","description":"Words, a record to find others like, filters, safety exclusions and sorting, as the tool's schema allows. Exclusions are enforced by the server: a record comes back only if it is known not to have an excluded value, so an unknown value is never treated as safe. Exclusions pinned to the key are always applied as well; a request can only narrow them.","parameters":[{"name":"name","in":"path","required":true,"description":"The tool's name, as its owner set it.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchRequest"}}}},"responses":{"200":{"description":"A page of results","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchResult"}}}},"400":{"description":"The request doesn't match this tool's schema; `detail` says where.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"No key, or a key that is revoked or expired. Send it as `Authorization: Bearer <key>`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"A browser origin the key doesn't allow. Call from your server, or add the origin to the key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No tool with that name for this key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"The key's rate limit or monthly quota. `Retry-After` says when to try again after a rate limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"The tool is paused by its owner, or has no published data yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/tools/{name}/values":{"post":{"tags":["Tool"],"operationId":"findValues","summary":"Look up value set entries to filter or exclude by","description":"For a field choosing from a large value set: entries matching some words, by name, synonym or code, so their codes can go in filters and exclusions.","parameters":[{"name":"name","in":"path","required":true,"description":"The tool's name, as its owner set it.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"field":{"type":"string","description":"A value set field the tool lets you filter or exclude by."},"query":{"type":"string","minLength":1,"maxLength":200},"limit":{"type":"integer","minimum":1,"maximum":25,"default":10}},"required":["field","query"],"additionalProperties":false}}}},"responses":{"200":{"description":"Matching entries","content":{"application/json":{"schema":{"type":"object","properties":{"field":{"type":"string"},"value_set":{"type":"string"},"version":{"type":"integer"},"values":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string"},"label":{"type":"string"}}}}}}}}},"400":{"description":"The request doesn't match; `detail` says where.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"No key, or a key that is revoked or expired. Send it as `Authorization: Bearer <key>`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"A browser origin the key doesn't allow. Call from your server, or add the origin to the key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No tool with that name for this key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"The key's rate limit or monthly quota. `Retry-After` says when to try again after a rate limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"The tool is paused by its owner, or has no published data yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/tools/{name}/report":{"post":{"tags":["Tool"],"operationId":"reportAnswer","summary":"Report a value that looks wrong","description":"Tells the tool's owner a returned value looks wrong. It waits in their review queue for a person to decide; nothing served changes until they do. Only a record the key can see can be reported, one open report per record and field.","parameters":[{"name":"name","in":"path","required":true,"description":"The tool's name, as its owner set it.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid","description":"The record's id, from a search result."},"field":{"type":"string","description":"The field whose value looks wrong."},"problem":{"type":"string","minLength":10,"maxLength":1000,"description":"What is wrong, and how you know."},"expected":{"description":"What it should be, if known: one of the field's values or a list of them."}},"required":["id","field","problem"],"additionalProperties":false}}}},"responses":{"200":{"description":"Received","content":{"application/json":{"schema":{"type":"object","properties":{"received":{"type":"boolean"},"review_item_id":{"type":"string"},"note":{"type":"string"}}}}}},"400":{"description":"The report doesn't match; `detail` says where.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"No key, or a key that is revoked or expired. Send it as `Authorization: Bearer <key>`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"A browser origin the key doesn't allow. Call from your server, or add the origin to the key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No record with that id that this key can see, or no such tool.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"The key's rate limit or monthly quota. `Retry-After` says when to try again after a rate limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"The tool is paused by its owner, or has no published data yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/v1/tools/{name}/items/{recordId}":{"get":{"tags":["Tool"],"operationId":"getItem","summary":"One record by id","description":"A record a search returned, under the same safety exclusions the key applies. One the key's exclusions leave out looks the same as one that doesn't exist.","parameters":[{"name":"name","in":"path","required":true,"description":"The tool's name, as its owner set it.","schema":{"type":"string"}},{"name":"recordId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},{"name":"include_receipts","in":"query","required":false,"schema":{"type":"boolean","default":true}}],"responses":{"200":{"description":"The record","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Result"}}}},"400":{"description":"The id isn't valid.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"No key, or a key that is revoked or expired. Send it as `Authorization: Bearer <key>`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"A browser origin the key doesn't allow. Call from your server, or add the origin to the key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No tool with that name for this key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"The key's rate limit or monthly quota. `Retry-After` says when to try again after a rate limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"The tool is paused by its owner, or has no published data yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/mcp/{name}":{"post":{"tags":["MCP"],"operationId":"toolMcp","summary":"The tool over MCP","description":"JSON-RPC over Streamable HTTP, with the tool key as a bearer token. `tools/list` offers `search_<name>` (the same request as REST search), `get_<name>`, and `find_values` when the tool has value set fields. Answers go through the same code as REST, so validation, the safety guarantee and logging are identical. GET and DELETE return 405: there are no sessions.","parameters":[{"name":"name","in":"path","required":true,"description":"The tool's name, as its owner set it.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","description":"A JSON-RPC 2.0 request, or a batch."}}}},"responses":{"200":{"description":"The JSON-RPC response."},"401":{"description":"No key, or a key that is revoked or expired. Send it as `Authorization: Bearer <key>`.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"A browser origin the key doesn't allow. Call from your server, or add the origin to the key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"No tool with that name for this key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"The key's rate limit or monthly quota. `Retry-After` says when to try again after a rate limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"The tool is paused by its owner, or has no published data yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/build/mcp":{"post":{"tags":["MCP"],"operationId":"buildMcp","summary":"Read, and build in, the workspace you're building","description":"For your own agent while you build: with a build key (`cc_build_…`) as a bearer token, it can list datasets and their columns, contracts, readiness, the review queue, receipts, value sets and runs. A key made to build can also create datasets, value sets and fields, edit fields, start runs, and publish when the accuracy gate passes by itself, through the dashboard's checks. Resolving review items, editing stored values, withholding, deleting and publishing past the gate stay with a person.","security":[{"buildKey":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","description":"A JSON-RPC 2.0 request, or a batch."}}}},"responses":{"200":{"description":"The JSON-RPC response."},"401":{"description":"No build key, or one that is revoked or expired.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"Called from a browser: a build key opens the whole workspace, so it only works from a server or an agent's runtime.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"The build key's rate limit or monthly quota. `Retry-After` says when to try again after a rate limit.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}},"webhooks":{"release.ready":{"post":{"summary":"A new release finished building","description":"Signed with your webhook's secret; check `CloudCrane-Signature` before trusting it. Respond with any 2xx; anything else is retried.","parameters":[{"name":"CloudCrane-Signature","in":"header","required":true,"description":"`t=<unix seconds>,v1=<hex>`: an HMAC-SHA256 of `<t>.<raw body>` with your webhook's secret. Reject one more than 5 minutes old.","schema":{"type":"string"}},{"name":"CloudCrane-Event","in":"header","required":true,"schema":{"type":"string","const":"release.ready"}},{"name":"CloudCrane-Delivery","in":"header","required":true,"description":"The delivery's id, the same on every retry: use it to ignore repeats.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"The delivery's id."},"event":{"type":"string","const":"release.ready"},"created_at":{"type":"string","format":"date-time"},"workspace_id":{"type":"string"},"data":{"type":"object","properties":{"dataset_id":{"type":"string"},"release_id":{"type":"string"},"release":{"type":"integer","description":"The release's number."}}}},"required":["id","event","created_at","workspace_id","data"]}}}},"responses":{"2XX":{"description":"Received."}}}},"release.held":{"post":{"summary":"A tool's scenarios held a release back","description":"Signed with your webhook's secret; check `CloudCrane-Signature` before trusting it. Respond with any 2xx; anything else is retried.","parameters":[{"name":"CloudCrane-Signature","in":"header","required":true,"description":"`t=<unix seconds>,v1=<hex>`: an HMAC-SHA256 of `<t>.<raw body>` with your webhook's secret. Reject one more than 5 minutes old.","schema":{"type":"string"}},{"name":"CloudCrane-Event","in":"header","required":true,"schema":{"type":"string","const":"release.held"}},{"name":"CloudCrane-Delivery","in":"header","required":true,"description":"The delivery's id, the same on every retry: use it to ignore repeats.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"The delivery's id."},"event":{"type":"string","const":"release.held"},"created_at":{"type":"string","format":"date-time"},"workspace_id":{"type":"string"},"data":{"type":"object","properties":{"tool_id":{"type":"string"},"tool":{"type":"string"},"release":{"type":"integer"},"failed":{"type":"array","items":{"type":"object","properties":{"scenario":{"type":"string"},"problems":{"type":"array","items":{"type":"string"}}}}}}}},"required":["id","event","created_at","workspace_id","data"]}}}},"responses":{"2XX":{"description":"Received."}}}},"drift.alert":{"post":{"summary":"A sync found drift and is waiting for a person","description":"Signed with your webhook's secret; check `CloudCrane-Signature` before trusting it. Respond with any 2xx; anything else is retried.","parameters":[{"name":"CloudCrane-Signature","in":"header","required":true,"description":"`t=<unix seconds>,v1=<hex>`: an HMAC-SHA256 of `<t>.<raw body>` with your webhook's secret. Reject one more than 5 minutes old.","schema":{"type":"string"}},{"name":"CloudCrane-Event","in":"header","required":true,"schema":{"type":"string","const":"drift.alert"}},{"name":"CloudCrane-Delivery","in":"header","required":true,"description":"The delivery's id, the same on every retry: use it to ignore repeats.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"The delivery's id."},"event":{"type":"string","const":"drift.alert"},"created_at":{"type":"string","format":"date-time"},"workspace_id":{"type":"string"},"data":{"type":"object","properties":{"dataset_id":{"type":"string"},"sync_id":{"type":"string"},"alerts":{"type":"array","items":{"type":"object","properties":{"field":{"type":"string"},"kind":{"type":"string"},"value":{"type":["string","null"]},"severity":{"type":"string"},"message":{"type":"string"}}}}}}},"required":["id","event","created_at","workspace_id","data"]}}}},"responses":{"2XX":{"description":"Received."}}}},"review.opened":{"post":{"summary":"A run left decisions for a person","description":"Signed with your webhook's secret; check `CloudCrane-Signature` before trusting it. Respond with any 2xx; anything else is retried.","parameters":[{"name":"CloudCrane-Signature","in":"header","required":true,"description":"`t=<unix seconds>,v1=<hex>`: an HMAC-SHA256 of `<t>.<raw body>` with your webhook's secret. Reject one more than 5 minutes old.","schema":{"type":"string"}},{"name":"CloudCrane-Event","in":"header","required":true,"schema":{"type":"string","const":"review.opened"}},{"name":"CloudCrane-Delivery","in":"header","required":true,"description":"The delivery's id, the same on every retry: use it to ignore repeats.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"The delivery's id."},"event":{"type":"string","const":"review.opened"},"created_at":{"type":"string","format":"date-time"},"workspace_id":{"type":"string"},"data":{"type":"object","properties":{"run_id":{"type":"string"},"dataset_id":{"type":"string"},"contract_id":{"type":"string"},"count":{"type":"integer","description":"How many decisions it left."}}}},"required":["id","event","created_at","workspace_id","data"]}}}},"responses":{"2XX":{"description":"Received."}}}},"tool.failing":{"post":{"summary":"A fifth or more of a tool's calls failed over 15 minutes; at most once an hour per tool","description":"Signed with your webhook's secret; check `CloudCrane-Signature` before trusting it. Respond with any 2xx; anything else is retried.","parameters":[{"name":"CloudCrane-Signature","in":"header","required":true,"description":"`t=<unix seconds>,v1=<hex>`: an HMAC-SHA256 of `<t>.<raw body>` with your webhook's secret. Reject one more than 5 minutes old.","schema":{"type":"string"}},{"name":"CloudCrane-Event","in":"header","required":true,"schema":{"type":"string","const":"tool.failing"}},{"name":"CloudCrane-Delivery","in":"header","required":true,"description":"The delivery's id, the same on every retry: use it to ignore repeats.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"The delivery's id."},"event":{"type":"string","const":"tool.failing"},"created_at":{"type":"string","format":"date-time"},"workspace_id":{"type":"string"},"data":{"type":"object","properties":{"tool_id":{"type":"string"},"tool":{"type":"string"},"calls":{"type":"integer"},"errors":{"type":"integer"},"window_minutes":{"type":"integer"},"dedupe_key":{"type":"string","description":"The same for every alert about the same cause."}}}},"required":["id","event","created_at","workspace_id","data"]}}}},"responses":{"2XX":{"description":"Received."}}}},"accuracy.dropped":{"post":{"summary":"Measuring the saved fields found a safety value less often than in the last release; once a day per drop","description":"Signed with your webhook's secret; check `CloudCrane-Signature` before trusting it. Respond with any 2xx; anything else is retried.","parameters":[{"name":"CloudCrane-Signature","in":"header","required":true,"description":"`t=<unix seconds>,v1=<hex>`: an HMAC-SHA256 of `<t>.<raw body>` with your webhook's secret. Reject one more than 5 minutes old.","schema":{"type":"string"}},{"name":"CloudCrane-Event","in":"header","required":true,"schema":{"type":"string","const":"accuracy.dropped"}},{"name":"CloudCrane-Delivery","in":"header","required":true,"description":"The delivery's id, the same on every retry: use it to ignore repeats.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"The delivery's id."},"event":{"type":"string","const":"accuracy.dropped"},"created_at":{"type":"string","format":"date-time"},"workspace_id":{"type":"string"},"data":{"type":"object","properties":{"dataset_id":{"type":"string"},"dataset":{"type":"string"},"evaluation_id":{"type":"string"},"regressions":{"type":"array","items":{"type":"object","properties":{"field":{"type":"string"},"value":{"type":"string"},"before":{"type":"object"},"after":{"type":"object"}}}},"dedupe_key":{"type":"string"}}}},"required":["id","event","created_at","workspace_id","data"]}}}},"responses":{"2XX":{"description":"Received."}}}},"credits.low":{"post":{"summary":"A fifth of the starter credits left, and again when none are","description":"Signed with your webhook's secret; check `CloudCrane-Signature` before trusting it. Respond with any 2xx; anything else is retried.","parameters":[{"name":"CloudCrane-Signature","in":"header","required":true,"description":"`t=<unix seconds>,v1=<hex>`: an HMAC-SHA256 of `<t>.<raw body>` with your webhook's secret. Reject one more than 5 minutes old.","schema":{"type":"string"}},{"name":"CloudCrane-Event","in":"header","required":true,"schema":{"type":"string","const":"credits.low"}},{"name":"CloudCrane-Delivery","in":"header","required":true,"description":"The delivery's id, the same on every retry: use it to ignore repeats.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"The delivery's id."},"event":{"type":"string","const":"credits.low"},"created_at":{"type":"string","format":"date-time"},"workspace_id":{"type":"string"},"data":{"type":"object","properties":{"credits":{"type":"integer"},"used":{"type":"integer"},"left":{"type":"integer"}}}},"required":["id","event","created_at","workspace_id","data"]}}}},"responses":{"2XX":{"description":"Received."}}}},"approval.requested":{"post":{"summary":"An agent asked a person to approve something only a person may do","description":"Signed with your webhook's secret; check `CloudCrane-Signature` before trusting it. Respond with any 2xx; anything else is retried.","parameters":[{"name":"CloudCrane-Signature","in":"header","required":true,"description":"`t=<unix seconds>,v1=<hex>`: an HMAC-SHA256 of `<t>.<raw body>` with your webhook's secret. Reject one more than 5 minutes old.","schema":{"type":"string"}},{"name":"CloudCrane-Event","in":"header","required":true,"schema":{"type":"string","const":"approval.requested"}},{"name":"CloudCrane-Delivery","in":"header","required":true,"description":"The delivery's id, the same on every retry: use it to ignore repeats.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"The delivery's id."},"event":{"type":"string","const":"approval.requested"},"created_at":{"type":"string","format":"date-time"},"workspace_id":{"type":"string"},"data":{"type":"object","properties":{"approval_id":{"type":"string"},"kind":{"type":"string","enum":["publish_past_gate","change_safety_field","resolve_review"]},"build_key_id":{"type":"string"}}}},"required":["id","event","created_at","workspace_id","data"]}}}},"responses":{"2XX":{"description":"Received."}}}},"ping":{"post":{"summary":"A test delivery, sent from the webhook's settings","description":"Signed with your webhook's secret; check `CloudCrane-Signature` before trusting it. Respond with any 2xx; anything else is retried.","parameters":[{"name":"CloudCrane-Signature","in":"header","required":true,"description":"`t=<unix seconds>,v1=<hex>`: an HMAC-SHA256 of `<t>.<raw body>` with your webhook's secret. Reject one more than 5 minutes old.","schema":{"type":"string"}},{"name":"CloudCrane-Event","in":"header","required":true,"schema":{"type":"string","const":"ping"}},{"name":"CloudCrane-Delivery","in":"header","required":true,"description":"The delivery's id, the same on every retry: use it to ignore repeats.","schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","description":"The delivery's id."},"event":{"type":"string","const":"ping"},"created_at":{"type":"string","format":"date-time"},"workspace_id":{"type":"string"},"data":{"type":"object","properties":{"message":{"type":"string"}}}},"required":["id","event","created_at","workspace_id","data"]}}}},"responses":{"2XX":{"description":"Received."}}}}},"components":{"securitySchemes":{"toolKey":{"type":"http","scheme":"bearer","description":"A tool key, `cc_live_…`. Opens one tool and nothing else."},"buildKey":{"type":"http","scheme":"bearer","description":"A build key, `cc_build_…`. Reads one workspace; a key made to build can also create datasets, value sets and fields, edit fields, start runs, publish when the accuracy gate passes, deploy tools and their scenarios, and ask a person for what only a person may do."}},"schemas":{"Error":{"type":"object","properties":{"error":{"type":"string"},"code":{"type":"string","description":"Stable and machine-readable, e.g. plan_limit, rate_limited, not_found."},"detail":{"type":"string","description":"Where a request didn't match, when it didn't."},"next":{"type":"object","description":"What to do about it, when there is something: an action (upgrade, request_approval, ask_owner, retry_later), the MCP tool that takes it, or the page where a person does.","properties":{"action":{"type":"string"},"tool":{"type":"string"},"url":{"type":"string"},"kind":{"type":"string"}},"required":["action"]}},"required":["error"]},"ToolDescription":{"type":"object","properties":{"name":{"type":"string","description":"`search_<tool name>`, the name an agent sees."},"description":{"type":"string"},"release":{"type":"integer","description":"The release this tool serves."},"accuracy":{"type":["object","null"],"description":"How the served release measured on its answer key; null when it wasn't measured.","properties":{"answer_key_version":{"type":"integer"},"answers_checked":{"type":["integer","null"]},"missed_safety_values":{"type":"integer"},"expected_safety_values":{"type":"integer"},"safety_recall":{"type":["object","null"],"properties":{"rate":{"type":"number"},"low":{"type":"number"},"high":{"type":"number"}}}}},"input_schema":{"type":"object","description":"The JSON Schema of this tool's search request."}},"required":["name","description","release","accuracy","input_schema"]},"SearchRequest":{"type":"object","description":"The general shape. Which `filters`, `exclude` and `sort` fields exist, and their allowed values, are the tool's own: see its `input_schema`.","properties":{"query":{"type":"string","minLength":1,"maxLength":200,"description":"Words to search for."},"similar_to":{"type":"string","format":"uuid","description":"A record's id; returns records like it instead. Not with `query`."},"filters":{"type":"object","description":"Only records matching every given filter."},"exclude":{"type":"object","additionalProperties":{"type":"array","items":{"type":"string"}},"description":"Safety field → values to leave out. A record is returned only if it is known not to have any of them."},"sort":{"type":"array","items":{"type":"object","properties":{"field":{"type":"string"},"direction":{"type":"string","enum":["asc","desc"]}},"required":["field"]}},"limit":{"type":"integer","minimum":1,"description":"Results per page, up to the tool's maximum."},"cursor":{"type":"string","description":"`next_cursor` from the previous page, with the same other parameters."},"include_receipts":{"type":"boolean","default":true}}},"Receipt":{"type":"object","description":"How one value was decided.","properties":{"method":{"type":"string","description":"rule, model, rule+model, human, flagged, …"},"confidence":{"type":["number","null"]},"contract_version":{"type":"integer"},"decided_by":{"type":["string","null"],"description":"Who approved it, when a person did."}}},"Result":{"type":"object","properties":{"id":{"type":"string"},"fields":{"type":"object","description":"The fields the tool returns, typed: a number is a number."},"origin":{"type":"object","properties":{"kind":{"type":"string","enum":["imported","generated"]},"model":{"type":"string","description":"For a generated record, the model that made it."}}},"unknown_safety_fields":{"type":"array","items":{"type":"string"},"description":"Safety fields nobody has decided on this record."},"receipts":{"type":"object","additionalProperties":{"$ref":"#/components/schemas/Receipt"}}},"required":["id","fields","origin"]},"SearchResult":{"type":"object","properties":{"results":{"type":"array","items":{"$ref":"#/components/schemas/Result"}},"next_cursor":{"type":["string","null"]},"labels":{"type":"object","description":"Names for value set codes in the results, by field."},"meta":{"type":"object","properties":{"release":{"type":"integer"},"applied_exclusions":{"type":"object","description":"Every exclusion applied, the key's pinned ones included."},"total":{"type":"integer"},"warnings":{"type":"array","items":{"type":"string"}}}}},"required":["results","next_cursor","meta"]}}}}