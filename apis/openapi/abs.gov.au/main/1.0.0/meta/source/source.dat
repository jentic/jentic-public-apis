{
  "openapi": "3.0.3",
  "info": {
    "title": "Australian Bureau of Statistics Data API",
    "description": "SDMX 2.1 compliant REST API providing machine-to-machine access to ABS statistics including Census, CPI, labour force, and other Australian economic and social data. Freely accessible with no API key required.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://www.abs.gov.au/about/data-services/application-programming-interfaces-apis",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://data.api.abs.gov.au/rest",
      "description": "ABS Data API (SDMX 2.1)"
    }
  ],
  "paths": {
    "/data/{dataflow_id}/{data_key}": {
      "get": {
        "operationId": "getData",
        "summary": "Get statistical data",
        "description": "Retrieves statistical data from a specified dataflow. The data key specifies dimension values separated by periods. Use 'all' or leave empty for all data in the dataflow.",
        "parameters": [
          {
            "name": "dataflow_id",
            "in": "path",
            "required": true,
            "description": "Dataflow identifier (e.g., CPI, LF, ALC, ERP). Use 'dataflow/ABS' endpoint to list all available dataflows.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "data_key",
            "in": "path",
            "required": true,
            "description": "Data key specifying dimension values separated by periods. Use 'all' for all data.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startPeriod",
            "in": "query",
            "description": "Start period for time range filter (e.g., 2020-Q1, 2020-01, 2020)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "endPeriod",
            "in": "query",
            "description": "End period for time range filter",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "detail",
            "in": "query",
            "description": "Level of detail in the response",
            "schema": {
              "type": "string",
              "enum": [
                "full",
                "dataonly",
                "serieskeysonly",
                "nodata"
              ],
              "default": "full"
            }
          },
          {
            "name": "dimensionAtObservation",
            "in": "query",
            "description": "Dimension to use at observation level",
            "schema": {
              "type": "string",
              "default": "AllDimensions"
            }
          },
          {
            "name": "lastNObservations",
            "in": "query",
            "description": "Return only the last N observations per series",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "firstNObservations",
            "in": "query",
            "description": "Return only the first N observations per series",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "updatedAfter",
            "in": "query",
            "description": "Return only data updated after this date (ISO 8601)",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": [
                "structurespecificdata",
                "jsondata",
                "csv"
              ],
              "default": "structurespecificdata"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Statistical data in requested format",
            "content": {
              "application/vnd.sdmx.data+json": {
                "schema": {
                  "$ref": "#/components/schemas/SDMXDataResponse"
                }
              },
              "application/vnd.sdmx.structurespecificdata+xml": {
                "schema": {
                  "type": "string"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters"
          },
          "404": {
            "description": "Dataflow or data not found"
          },
          "503": {
            "description": "Service temporarily unavailable"
          }
        }
      }
    },
    "/dataflow/ABS": {
      "get": {
        "operationId": "listDataflows",
        "summary": "List all available dataflows",
        "description": "Returns a list of all available ABS dataflows (datasets) with their identifiers and descriptions.",
        "parameters": [
          {
            "name": "references",
            "in": "query",
            "description": "Include referenced structures",
            "schema": {
              "type": "string",
              "enum": [
                "none",
                "parents",
                "parentsandsiblings",
                "children",
                "descendants",
                "all"
              ],
              "default": "none"
            }
          },
          {
            "name": "detail",
            "in": "query",
            "description": "Level of detail to return",
            "schema": {
              "type": "string",
              "enum": [
                "full",
                "allstubs",
                "referencestubs",
                "allcompletestubs",
                "referencecompletestubs",
                "referencepartial"
              ],
              "default": "full"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of dataflows",
            "content": {
              "application/vnd.sdmx.structure+json": {
                "schema": {
                  "$ref": "#/components/schemas/DataflowListResponse"
                }
              },
              "application/vnd.sdmx.structure+xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/dataflow/ABS/{dataflow_id}": {
      "get": {
        "operationId": "getDataflow",
        "summary": "Get dataflow details",
        "description": "Returns details of a specific dataflow including its structure definition.",
        "parameters": [
          {
            "name": "dataflow_id",
            "in": "path",
            "required": true,
            "description": "Dataflow identifier (e.g., CPI, LF, ALC)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "references",
            "in": "query",
            "description": "Include referenced structures",
            "schema": {
              "type": "string",
              "enum": [
                "none",
                "parents",
                "parentsandsiblings",
                "children",
                "descendants",
                "all"
              ],
              "default": "none"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dataflow details",
            "content": {
              "application/vnd.sdmx.structure+json": {
                "schema": {
                  "$ref": "#/components/schemas/DataflowResponse"
                }
              }
            }
          },
          "404": {
            "description": "Dataflow not found"
          }
        }
      }
    },
    "/datastructure/ABS/{structure_id}": {
      "get": {
        "operationId": "getDataStructure",
        "summary": "Get data structure definition",
        "description": "Returns the structure definition for a dataset including dimensions, attributes, and codelists.",
        "parameters": [
          {
            "name": "structure_id",
            "in": "path",
            "required": true,
            "description": "Data structure definition identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "references",
            "in": "query",
            "description": "Include referenced structures (use 'all' to get codelists)",
            "schema": {
              "type": "string",
              "enum": [
                "none",
                "parents",
                "parentsandsiblings",
                "children",
                "descendants",
                "all"
              ],
              "default": "none"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data structure definition",
            "content": {
              "application/vnd.sdmx.structure+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Structure not found"
          }
        }
      }
    },
    "/codelist/ABS/{codelist_id}": {
      "get": {
        "operationId": "getCodelist",
        "summary": "Get codelist values",
        "description": "Returns values for a specific codelist used in ABS data structures.",
        "parameters": [
          {
            "name": "codelist_id",
            "in": "path",
            "required": true,
            "description": "Codelist identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Codelist values",
            "content": {
              "application/vnd.sdmx.structure+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Codelist not found"
          }
        }
      }
    },
    "/conceptscheme/ABS/{scheme_id}": {
      "get": {
        "operationId": "getConceptScheme",
        "summary": "Get concept scheme",
        "description": "Returns a concept scheme defining the concepts used in ABS data structures.",
        "parameters": [
          {
            "name": "scheme_id",
            "in": "path",
            "required": true,
            "description": "Concept scheme identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Concept scheme details",
            "content": {
              "application/vnd.sdmx.structure+json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Concept scheme not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SDMXDataResponse": {
        "type": "object",
        "description": "SDMX JSON data response",
        "properties": {
          "header": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "test": {
                "type": "boolean"
              },
              "prepared": {
                "type": "string",
                "format": "date-time"
              },
              "sender": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "dataSets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "observations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {}
                  }
                }
              }
            }
          },
          "structure": {
            "type": "object",
            "properties": {
              "dimensions": {
                "type": "object"
              },
              "attributes": {
                "type": "object"
              }
            }
          }
        }
      },
      "DataflowListResponse": {
        "type": "object",
        "properties": {
          "header": {
            "type": "object"
          },
          "data": {
            "type": "object",
            "properties": {
              "dataflows": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Dataflow"
                }
              }
            }
          }
        }
      },
      "DataflowResponse": {
        "type": "object",
        "properties": {
          "header": {
            "type": "object"
          },
          "data": {
            "type": "object",
            "properties": {
              "dataflows": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Dataflow"
                }
              }
            }
          }
        }
      },
      "Dataflow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agencyID": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "structure": {
            "type": "string",
            "description": "Reference to the data structure definition"
          }
        }
      }
    }
  },
  "security": []
}
