{
  "openapi": "3.0.3",
  "info": {
    "title": "WhatsApp Gateway API",
    "description": "API documentation for WhatsApp Gateway using go-whatsapp-web-multidevice",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/asuratech-90e/ISP-APP/1.0.0"
  },
  "servers": [
    {
      "url": "https://wa.carikwifi.my.id",
      "description": "Production Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/devices": {
      "get": {
        "summary": "List devices",
        "tags": [
          "Device"
        ],
        "responses": {
          "200": {
            "description": "List of devices"
          }
        }
      },
      "post": {
        "summary": "Create device",
        "tags": [
          "Device"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_id": {
                    "type": "string",
                    "example": "device-1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device created"
          }
        }
      }
    },
    "/app/login": {
      "get": {
        "summary": "Get QR login",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Device-Id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "device-1"
          }
        ],
        "responses": {
          "200": {
            "description": "QR code response"
          }
        }
      }
    },
    "/app/status": {
      "get": {
        "summary": "Check device status",
        "tags": [
          "Auth"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Device-Id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "device-1"
          }
        ],
        "responses": {
          "200": {
            "description": "Connection status"
          }
        }
      }
    },
    "/devices/{device_id}/logout": {
      "post": {
        "summary": "Logout device",
        "tags": [
          "Device"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Device logged out"
          }
        }
      }
    },
    "/send/message": {
      "post": {
        "summary": "Send text message",
        "tags": [
          "Send Message"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Device-Id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "device-1"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone",
                  "message"
                ],
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "628123456789@s.whatsapp.net"
                  },
                  "message": {
                    "type": "string",
                    "example": "Hello from API"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Message sent"
          }
        }
      }
    },
    "/send/image": {
      "post": {
        "summary": "Send image",
        "tags": [
          "Send Message"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Device-Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "example": "628123456789@s.whatsapp.net"
                  },
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "caption": {
                    "type": "string",
                    "example": "Test image"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Image sent"
          }
        }
      }
    },
    "/user/check": {
      "get": {
        "summary": "Check WhatsApp number",
        "tags": [
          "User"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Device-Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "phone",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 628123456789
          }
        ],
        "responses": {
          "200": {
            "description": "Number check result"
          }
        }
      }
    },
    "/chats": {
      "get": {
        "summary": "List chats",
        "tags": [
          "Chat"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "X-Device-Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chat list"
          }
        }
      }
    }
  }
}
