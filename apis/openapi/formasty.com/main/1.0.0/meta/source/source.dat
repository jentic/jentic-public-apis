                "description": "Color token such as #RRGGBB, rgb(...), or rgba(...). Use the same values returned by formasty_get_form."
              },
              "linkColor": {
                "type": "string",
                "description": "Color token such as #RRGGBB, rgb(...), or rgba(...). Use the same values returned by formasty_get_form."
              },
              "borderColor": {
                "type": "string",
                "description": "Color token such as #RRGGBB, rgb(...), or rgba(...). Use the same values returned by formasty_get_form."
              },
              "buttonTextColor": {
                "type": "string",
                "description": "Color token such as #RRGGBB, rgb(...), or rgba(...). Use the same values returned by formasty_get_form."
              },
              "primaryColor": {
                "type": "string",
                "description": "Color token such as #RRGGBB, rgb(...), or rgba(...). Use the same values returned by formasty_get_form."
              },
              "secondaryColor": {
                "type": "string",
                "description": "Color token such as #RRGGBB, rgb(...), or rgba(...). Use the same values returned by formasty_get_form."
              },
              "borderIntensity": {
                "type": "string",
                "enum": [
                  "subtle",
