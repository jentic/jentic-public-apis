          {
            "in": "query",
            "name": "workspaceId",
            "schema": {
              "type": "string"
            },
            "description": "Authorized OAuth workspace to list. API keys can only use their bound workspace. workspace_id is also accepted."
          },
          {
            "in": "header",
            "name": "X-Formasty-Workspace-Id",
