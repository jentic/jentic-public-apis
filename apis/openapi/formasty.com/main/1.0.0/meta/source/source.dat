    "/forms/{form_id}/media-assets/generated": {
      "post": {
        "operationId": "uploadGeneratedImageAsset",
        "x-formasty-required-scope": "forms:update",
        "summary": "Ingest an AI-generated image asset",
        "description": "Stores an HTTPS or data URL PNG/JPG/GIF/WebP in Formasty storage and optionally attaches it to a step cover, ending media/background/logo, or choice option image.",
        "x-openai-isConsequential": true,
        "parameters": [
          {
            "in": "path",
            "name": "form_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sourceUrl": {
                    "type": "string",
                    "description": "HTTPS image URL. Mutually exclusive with dataUrl."
                  },
                  "dataUrl": {
                    "type": "string",
                    "description": "PNG/JPG/GIF/WebP data URL. Mutually exclusive with sourceUrl."
                  },
                  "fileName": {
                    "type": "string"
                  },
                  "altText": {
                    "type": "string"
                  },
                  "target": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Optional target such as step_cover, ending_media, ending_background, ending_logo, or field_option."
                  },
                  "draft_revision": {
                    "type": "integer",
                    "description": "Required when target is provided."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored generated image asset.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeneratedImageResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AgentError"
          }
        }
      }
    },
