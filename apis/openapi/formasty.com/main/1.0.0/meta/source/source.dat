                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "score"
                    ]
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "endings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "screenId": {
                          "type": "string"
                        },
                        "minScore": {
                          "type": "number"
                        },
                        "maxScore": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "screenId"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "mappings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "fieldId": {
                          "type": "string"
                        },
                        "optionId": {
                          "type": "string"
                        },
                        "optionValue": {
                          "type": "string"
                        },
                        "value": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            }
                          ]
                        },
                        "target": {
                          "type": "object",
                          "properties": {
                            "subfieldKey": {
                              "type": "string",
                              "description": "Optional subfield key for structured values such as address parts."
                            },
                            "rowKey": {
                              "type": "string",
                              "description": "Optional matrix row key when a workflow condition targets a matrix row value."
                            }
                          },
                          "description": "Optional workflow target selector for structured field values.",
                          "additionalProperties": false
                        },
                        "score": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "id",
                        "fieldId",
                        "score"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "qualification": {
                    "type": "object",
                    "properties": {
                      "enabled": {
                        "type": "boolean"
                      },
                      "tiers": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 6,
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "label": {
                              "type": "string"
                            },
                            "color": {
                              "type": "string",
                              "pattern": "^#[0-9a-fA-F]{6}$",
                              "description": "Optional hex color in #RRGGBB format, matching the builder validation."
                            },
                            "minScore": {
                              "type": "number"
                            }
                          },
                          "required": [
                            "id",
                            "label",
                            "minScore"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "enabled",
                      "tiers"
                    ],
                    "description": "Optional Business-tier lead qualification tiers. Each tier classifies the computed score into a labeled lead tier when its minScore threshold is met. Requires Business or an active trial.",
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "enabled",
                  "endings",
                  "mappings"
                ],
                "description": "Optional score quiz configuration. Use ending minScore/maxScore ranges to resolve the result.",
                "additionalProperties": false
              }
            ],
            "description": "Optional quiz configuration. Use type=match for recommendation/personality quizzes or type=score for score ranges."
          },
          "poll": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "resultsVisibility": {
                "type": "string",
                "enum": [
                  "after_vote",
                  "hidden"
                ],
                "description": "Whether aggregate poll results are shown after voting or kept hidden."
              }
            },
            "required": [
              "enabled",
              "resultsVisibility"
            ],
            "description": "Optional poll configuration. Poll publishing is subject to the current workspace plan.",
            "additionalProperties": false
          }
        },
        "required": [
          "version",
          "steps",
          "settings",
          "theme",
          "workflow"
        ],
        "description": "Full draft schema contract. Use the exact structure returned by formasty_get_form().form.draftSchema when replacing the whole draft. New forms should keep a statement-only welcome screen before respondent fields.",
        "additionalProperties": false
      },
      "WorkflowRule": {
        "type": "object",
        "additionalProperties": true,
        "description": "Builder-compatible workflow rule. Supports step routes, thank-you routes, and workflow variable actions.",
        "required": [
