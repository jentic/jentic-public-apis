          },
          "endings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "qualification": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "PollConfig": {
        "type": "object",
        "additionalProperties": true,
        "description": "Builder-compatible poll config. Set enabled true and resultsVisibility to after_vote or hidden. Poll publishing is Pro-gated server-side.",
