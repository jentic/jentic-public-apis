                "type": "boolean"
              },
              "branding": {
                "type": "object",
                "properties": {
                  "showPoweredBy": {
                    "type": "boolean",
                    "description": "Whether to show Formasty branding badges where the current plan allows it."
                  },
                  "logoUrl": {
                    "type": "string",
                    "description": "Absolute URL string. Prefer https URLs for public assets and integrations."
                  },
                  "logoScale": {
                    "type": "number",
                    "minimum": 0.7,
                    "maximum": 1.3
                  }
                },
                "description": "Branding controls nested under theme.branding.",
                "additionalProperties": false
              }
            },
            "description": "Partial theme patch. Use the same keys returned by formasty_get_form().form.draftSchema.theme.",
            "additionalProperties": false
          },
          "workflow": {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "enum": [
                  1
                ]
              },
              "enabled": {
                "type": "boolean"
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Stable workflow rule id. Reuse existing ids when replacing or editing current rules."
                    },
                    "title": {
                      "type": "string",
                      "description": "Optional human-readable rule label shown in the workflow UI."
                    },
                    "source": {
                      "type": "object",
                      "properties": {
                        "stepId": {
                          "type": "string",
                          "description": "Source step id for the rule."
                        },
                        "fieldId": {
                          "type": "string",
                          "description": "Optional source field id when branching from a specific field."
                        }
                      },
                      "required": [
                        "stepId"
                      ],
                      "additionalProperties": false
                    },
                    "match": {
                      "type": "string",
                      "enum": [
                        "all",
                        "any"
                      ]
                    },
                    "combinator": {
                      "type": "string",
                      "enum": [
                        "and",
                        "or"
                      ]
                    },
                    "conditions": {
                      "type": "array",
                      "description": "Workflow conditions. Use an empty array for an unconditional 'always go to' route, especially for statement-only steps.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Stable condition id. Reuse existing ids when editing an existing rule."
                          },
                          "sourceType": {
                            "type": "string",
                            "enum": [
                              "field",
                              "hidden_field",
                              "variable"
                            ],
                            "description": "What the condition reads from."
                          },
                          "sourceId": {
                            "type": "string",
                            "description": "Hidden field key or variable id depending on sourceType. For field conditions, prefer fieldId; sourceId is accepted as a compatibility alias."
                          },
                          "fieldId": {
                            "type": "string",
                            "description": "Field id when the condition reads from a form field."
                          },
                          "target": {
                            "type": "object",
                            "properties": {
                              "subfieldKey": {
                                "type": "string",
                                "description": "Optional subfield key for structured values such as address parts."
                              },
                              "rowKey": {
                                "type": "string",
                                "description": "Optional matrix row key when a workflow condition targets a matrix row value."
                              }
                            },
                            "description": "Optional workflow target selector for structured field values.",
                            "additionalProperties": false
                          },
                          "operator": {
                            "type": "string",
                            "enum": [
                              "equals",
                              "not_equals",
                              "contains",
                              "not_contains",
                              "starts_with",
                              "ends_with",
                              "includes",
                              "not_includes",
                              "gt",
                              "gte",
                              "lt",
                              "lte",
                              "between",
                              "is_answered",
                              "is_not_answered"
                            ],
                            "description": "Comparison operator. Use only operators that are already valid for the chosen source/target."
                          },
                          "value": {
                            "anyOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "array",
                                "minItems": 2,
                                "maxItems": 2,
                                "items": {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "number"
                                    }
                                  ]
                                }
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "min": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "number"
                                      }
                                    ]
                                  },
                                  "max": {
                                    "anyOf": [
                                      {
                                        "type": "string"
                                      },
                                      {
                                        "type": "number"
                                      }
                                    ]
                                  }
                                },
                                "required": [
                                  "min",
                                  "max"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                  "type": "string"
                                }
                              }
                            ],
                            "description": "Condition value. For between, use [min,max] or {min,max}. For includes/not_includes on multi-choice values, use a string array."
                          }
                        },
                        "required": [
                          "id",
                          "operator"
                        ],
                        "description": "Workflow condition. Reuse field ids, variable ids, hidden field keys, and target ids already present in the current form snapshot.",
                        "additionalProperties": false
                      }
                    },
