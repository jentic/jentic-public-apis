    "/forms/{form_id}/draft": {
      "put": {
        "operationId": "saveFormDraft",
        "x-formasty-required-scope": "forms:update",
        "summary": "Save the complete form draft",
        "description": "Atomically saves the builder-compatible schema and, when supplied, the complete form settings snapshot. Reuse the same mutation_id only when retrying the exact same request body.",
        "x-openai-isConsequential": true,
        "parameters": [
          {
            "in": "path",
            "name": "form_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "draftSchema",
                  "draft_revision"
                ],
                "additionalProperties": false,
                "properties": {
                  "draftSchema": {
                    "$ref": "#/components/schemas/DraftSchema"
                  },
                  "settings": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Optional complete form settings snapshot. When supplied, schema and settings commit as one draft revision."
                  },
                  "draft_revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "mutation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "Client-generated idempotency key for this logical save. Reuse it only for byte-for-byte equivalent retries."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved draft, or the stored result of an exact mutation_id retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormResponse"
                }
              }
            }
          },
          "409": {
            "description": "The draft revision is stale, or mutation_id was reused with a different payload."
          },
          "default": {
            "$ref": "#/components/responses/AgentError"
          }
        }
      }
    },
