          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "authentication_required",
              "permission_denied",
              "resource_not_found",
              "conflict",
              "payload_too_large",
              "validation_failed",
              "rate_limited",
              "internal_error",
              "service_unavailable"
            ],
            "description": "Stable machine-readable category suitable for programmatic recovery."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation of what failed."
          },
          "recovery": {
            "type": "string",
            "description": "Concrete next action an agent or API client can take."
          },
          "retryable": {
            "type": "boolean",
            "description": "Whether retrying later or after the described recovery can succeed."
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "description": "HTTP status mirrored in the JSON body."
          },
          "docs_url": {
            "type": "string",
            "format": "uri",
            "description": "Canonical Formasty API error documentation."
          }
        }
      }
    }
  },
  "paths": {
    "/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "x-formasty-required-scope": "none",
        "summary": "Inspect effective API capabilities",
        "description": "Returns credential scopes and workspace-role permissions as separate authorization layers, plus operations that are available, conditional on a target resource, or blocked in the evaluated workspace.",
        "parameters": [
          {
            "in": "query",
            "name": "workspaceId",
            "schema": {
              "type": "string"
            },
            "description": "OAuth workspace to evaluate. API keys remain bound to their configured workspace. workspace_id is also accepted."
          },
          {
            "in": "header",
            "name": "X-Formasty-Workspace-Id",
            "schema": {
              "type": "string"
            },
            "description": "Alternative workspace selector. It must match any workspaceId query value."
          }
        ],
        "responses": {
          "200": {
            "description": "Effective Formasty API capabilities.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credential.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AgentError"
          }
        }
      }
    },
