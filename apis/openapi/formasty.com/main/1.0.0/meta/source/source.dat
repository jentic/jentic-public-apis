    "/forms/{form_id}/validate": {
      "post": {
        "operationId": "validateFormDraft",
        "x-formasty-required-scope": "forms:read",
        "summary": "Validate a form draft",
        "description": "Runs the same schema, workflow, settings, booking, and plan-gate preflight used by Formasty agents without changing or publishing the form.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "$ref": "#/components/parameters/FormId"
          }
        ],
        "responses": {
          "200": {
            "description": "Current draft revision and publish-readiness report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftValidationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid OAuth token or API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing forms:read scope or workspace permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Form not found in the authenticated credential's workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AgentError"
          }
        }
      }
    },
    "/forms/{form_id}/publish": {
      "post": {
        "operationId": "publishForm",
        "x-formasty-required-scope": "forms:publish",
        "summary": "Publish a form",
        "description": "Validates and publishes the exact saved draft_revision supplied by the caller.",
        "x-openai-isConsequential": true,
        "parameters": [
          {
            "in": "path",
            "name": "form_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "draft_revision"
                ],
                "properties": {
                  "draft_revision": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Revision of the exact saved draft to publish."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Published form.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing draft_revision, invalid request body, missing draft, or an inline draft schema was supplied instead of using the draft endpoint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid OAuth token or API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Missing forms:publish scope or workspace publish permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Form not found in the authenticated credential's workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Stale draft revision, slug conflict, plan restriction, or publish-readiness preflight failure.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/DraftValidationFailureResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/AgentError"
          }
        }
      }
    },
