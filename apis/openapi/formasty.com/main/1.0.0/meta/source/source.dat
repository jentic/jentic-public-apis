              "brandPalette": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "description": "Color token such as #RRGGBB, rgb(...), or rgba(...). Use the same values returned by formasty_get_form."
                },
                "description": "Optional brand palette swatches shown in the builder design system."
