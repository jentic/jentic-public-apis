{
  "openapi": "3.0.0",
  "info": {
    "title": "Aevita API",
    "description": "API documentation for OAuth and Aevita Orders endpoints",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/webcompany-08f/Aevita/1.0.0"
  },
  "servers": [
    {
      "url": "https://pnlkidryumcdlhpdyvks.supabase.co/functions/v1",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/oauth/token": {
      "post": {
        "tags": [
          "OAuth"
        ],
        "summary": "Generate access/refresh tokens",
        "description": "Create tokens using client credentials or refresh an existing token.\nThe grant_type parameter accepts two values:\n- \"client_credentials\" - Generate new access and refresh tokens using client ID and secret\n- \"refresh_token\" - Refresh an existing access token using a refresh token\n",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ClientCredentialsRequest"
                  },
                  {
                    "$ref": "#/components/schemas/RefreshTokenRequest"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/TokenResponse"
                    },
                    {
                      "$ref": "#/components/schemas/RefreshTokenResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid grant type, credentials, or refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/aevita/orders": {
      "get": {
        "tags": [
          "Aevita Orders"
        ],
        "summary": "Get paginated order data",
        "description": "Retrieve orders with customer, HCP, doctor information, and products. \nSupports filtering by product SKU, payment status, order status, and modification date.\nRequires OAuth token authentication.\n",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items per page (max 100)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "sku",
            "in": "query",
            "description": "Filter orders by product SKU (exact match, case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "payment_status",
            "in": "query",
            "description": "Filter orders by payment status (partial match, case-insensitive)",
            "schema": {
              "type": "string"
            },
            "example": "paid"
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter orders by order status (partial match, case-insensitive)",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "paid",
                "sent_to_doctor",
                "approved",
                "rejected",
                "cancelled"
              ]
            },
            "example": "approved"
          },
          {
            "name": "modified_from",
            "in": "query",
            "description": "Filter orders modified from this date onwards (ISO 8601 format)",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2024-12-01T00:00:00Z"
          },
          {
            "name": "order_id",
            "in": "query",
            "description": "Filter orders by order ID (partial match, case-insensitive)",
            "schema": {
              "type": "string"
            },
            "example": "ORD-2024"
          },
          {
            "name": "order",
            "in": "query",
            "description": "Sort direction",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Orders retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OrderData"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid page, limit, sortBy, or other parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing OAuth token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/aevita/stock-update": {
      "put": {
        "tags": [
          "Product Stock Update"
        ],
        "summary": "Update product stock quantity",
        "description": "Update a product's stock quantity to a specified absolute value. Requires OAuth token authentication.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stock updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockUpdateResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid or missing parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing OAuth token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Product not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/aevita/stock-status/{sku}": {
      "get": {
        "tags": [
          "Aevita Stock"
        ],
        "summary": "Get product stock status",
        "description": "Retrieve stock status for a specific product by SKU. Requires OAuth token authentication.",
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "description": "The SKU of the product (6-character alphanumeric code)",
            "schema": {
              "type": "string",
              "pattern": "^[A-Z0-9]{6}$"
            },
            "example": "ABC123"
          }
        ],
        "responses": {
          "200": {
            "description": "Stock status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - SKU is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing OAuth token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Product not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "OAuth access token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Invalid request"
          }
        }
      },
      "ClientCredentialsRequest": {
        "type": "object",
        "required": [
          "grant_type",
          "client_id",
          "client_secret",
          "email"
        ],
        "properties": {
          "grant_type": {
            "type": "string",
            "enum": [
              "client_credentials"
            ]
          },
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "required": [
          "grant_type",
          "refresh_token",
          "email"
        ],
        "properties": {
          "grant_type": {
            "type": "string",
            "enum": [
              "refresh_token"
            ]
          },
          "refresh_token": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RefreshTokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderData": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "object",
            "nullable": true,
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "dossier_id": {
                "type": "string",
                "nullable": true
              },
              "is_identified": {
                "type": "boolean"
              },
              "address": {
                "type": "string",
                "nullable": true
              },
              "city": {
                "type": "string",
                "nullable": true
              },
              "zip": {
                "type": "string",
                "nullable": true
              },
              "state": {
                "type": "string",
                "nullable": true
              },
              "country": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "order": {
            "type": "object",
            "properties": {
              "order_id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "total_price": {
                "type": "number"
              },
              "discount_percentage": {
                "type": "number",
                "nullable": true,
                "description": "Discount percentage applied to the order"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "payment_status": {
                "type": "string"
              },
              "paid_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              },
              "modified_at": {
                "type": "string",
                "format": "date-time",
                "description": "Last modification timestamp of the order"
              },
              "creadit_note_number": {
                "type": "string",
                "nullable": true,
                "description": "Credit note number associated with the order, if any"
              }
            }
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": {
                  "type": "string",
                  "description": "Product SKU (6-character alphanumeric code)",
                  "example": "A1B2C3"
                },
                "product_name": {
                  "type": "string"
                },
                "unit_price": {
                  "type": "number"
                },
                "quantity": {
                  "type": "integer"
                },
                "interval": {
                  "type": "string"
                },
                "interval_count": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "total_pages": {
            "type": "integer"
          }
        }
      },
      "StockUpdateRequest": {
        "type": "object",
        "required": [
          "sku",
          "stock_quantity"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Z0-9]{6}$",
            "description": "The 6-character alphanumeric SKU of the product to update",
            "example": "ABC123"
          },
          "stock_quantity": {
            "type": "integer",
            "minimum": 0,
            "description": "The absolute stock quantity value to set"
          }
        }
      },
      "StockUpdateResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Stock updated successfully"
          },
          "sku": {
            "type": "string",
            "example": "ABC123"
          },
          "previous_quantity": {
            "type": "integer",
            "description": "The stock quantity before the update"
          },
          "new_quantity": {
            "type": "integer",
            "description": "The stock quantity after the update"
          }
        }
      },
      "StockStatusResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Product name"
          },
          "status": {
            "type": "string",
            "description": "Product status"
          },
          "stock_quantity": {
            "type": "integer",
            "description": "Current stock quantity"
          },
          "modified_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last modification timestamp of the stock status"
          }
        }
      }
    }
  }
}
