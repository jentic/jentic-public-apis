          "200": {
            "description": "Success"
          }
        },
        "security": []
      }
    },
    "/api/pricing/endpoint": {
      "get": {
        "tags": [
          "Payment"
        ],
        "summary": "Endpoint pricing",
        "description": "Pricing for a specific endpoint.",
        "operationId": "endpointPricing",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "endpoint",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Endpoint path"
          }
        ]
      }
    },
    "/paid/baidu-ocr": {
      "get": {
        "tags": [
          "OCR"
        ],
        "summary": "Baidu OCR (general)",
        "description": "General-purpose text recognition.",
        "operationId": "baiduOcr",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Image URL"
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "402": {
            "description": "Payment required"
          }
        },
        "security": [
          {
            "x402-payer": []
          }
        ],
        "x-pricing": {
          "amount": "0.01",
          "currency": "USDC",
          "network": "base"
        }
      }
    },
    "/paid/baidu-ocr-accurate": {
