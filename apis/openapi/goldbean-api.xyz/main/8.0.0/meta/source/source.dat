        "operationId": "gasPrice",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": []
      }
    },
    "/btc-price": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Bitcoin price",
