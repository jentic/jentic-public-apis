        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": []
      }
    },
    "/weather-now": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Weather",
        "description": "Current weather for a city.",
        "operationId": "weatherNow",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "City name"
          }
        ]
      }
    },
    "/api/pricing/plans": {
      "get": {
        "tags": [
          "Payment"
        ],
        "summary": "Pricing plans",
