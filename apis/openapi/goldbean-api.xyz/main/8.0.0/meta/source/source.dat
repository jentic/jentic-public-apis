{
  "openapi": "3.1.0",
  "info": {
    "title": "GoldBean API",
    "version": "8.0.0",
    "description": "Pay-per-call AI API marketplace bridging Baidu AI to the global agent economy. 47 endpoints covering OCR, speech recognition, image generation, TTS, LLM chat, translation, and more. x402-native payments with USDC on Base. MCP-compatible.",
    "contact": {
      "email": "wuzenghai616@gmail.com",
      "name": "GoldBean API",
      "url": "https://goldbean-api.xyz"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/wuzenghai616-lang/goldbean/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://goldbean-api.xyz",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "OCR"
    },
    {
      "name": "Speech"
    },
    {
      "name": "LLM"
    },
    {
      "name": "Image"
    },
    {
      "name": "Translation"
    },
    {
      "name": "Payment"
    },
    {
      "name": "System"
    },
    {
      "name": "OpenAI-Compatible"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "description": "Service health status and version.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": []
      }
    },
    "/info": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Service info",
        "description": "API name, version, auth method, route count.",
        "operationId": "info",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": []
      }
    },
    "/.well-known/x402.json": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "x402 discovery",
        "description": "x402 service discovery endpoint.",
        "operationId": "x402Discovery",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": []
      }
    },
    "/.well-known/mcp.json": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "MCP server card",
        "description": "MCP server card with 21 tool capabilities.",
        "operationId": "mcpServerCard",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": []
      }
    },
    "/.well-known/x402-bazaar": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "x402 Bazaar",
        "description": "Bazaar listing. Free: 50 calls/day, Standard: 0.01 USD/call.",
        "operationId": "x402Bazaar",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": []
      }
    },
    "/llms.txt": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "LLM-readable catalog",
        "description": "Complete endpoint catalog for LLMs.",
        "operationId": "llmsTxt",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": []
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "OpenAPI spec",
        "description": "OpenAPI 3.1 specification.",
        "operationId": "openapi",
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": []
      }
    },
    "/api/routes": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "List all routes",
