{
  "openapi": "3.0.3",
  "info": {
    "title": "00.1 Recuperação Partner Addition CDT",
    "version": "1.0.0",
    "contact": {},
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/GRAZYKTA/001-recuperacao-partner-addition-cdt/1.0.0"
  },
  "servers": [
    {
      "url": "https://api-crerec.limbo.work"
    }
  ],
  "paths": {
    "/oauth2/token": {
      "post": {
        "tags": [
          "Open APIs",
          "Client Credentials"
        ],
        "summary": "Token QA",
        "description": "Token QA",
        "operationId": "tokenQa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_id": {
                    "type": "string",
                    "example": "{{client_id}}"
                  },
                  "client_secret": {
                    "type": "string",
                    "example": "{{client_secret}}"
                  },
                  "grant_type": {
                    "type": "string",
                    "example": "client_credentials"
                  }
                }
              },
              "examples": {
                "Token QA": {
                  "value": {
                    "client_id": "{{client_id}}",
                    "client_secret": "{{client_secret}}",
                    "grant_type": "client_credentials"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/recovery-partners-addition/api/documentation": {
      "get": {
        "tags": [
          "Open APIs",
          "Documentation"
        ],
        "summary": "swagger-json",
        "description": "swagger-json",
        "operationId": "swaggerJson",
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/employee-credit/eligibility": {
      "get": {
        "tags": [
          "Open APIs",
          "Acquisition"
        ],
        "summary": "Eligibility",
        "description": "Eligibility",
        "operationId": "eligibility",
        "parameters": [
          {
            "name": "is_test",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "true"
            }
          },
          {
            "name": "consumer_id",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "12345"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/v1/employee-credit/simulation": {
      "post": {
        "tags": [
          "Open APIs",
          "Acquisition"
        ],
        "summary": "Simulation",
        "description": "Simulation",
        "operationId": "simulation",
        "parameters": [
          {
            "name": "is_test",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "true"
            }
          },
          {
            "name": "consumer_id",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "26252690"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cnpj": {
                    "type": "string",
                    "example": "123456"
                  },
                  "desiredAmount": {
                    "type": "number",
                    "example": 100
                  },
                  "desiredInstallment": {
                    "type": "number",
                    "example": 10
                  },
                  "solicitationId": {
                    "type": "number",
                    "example": 12345
                  },
                  "withInsurance": {
                    "type": "boolean",
                    "example": true
                  }
                }
              },
              "examples": {
                "Simulation": {
                  "value": {
                    "cnpj": "123456",
                    "desiredAmount": 100,
                    "desiredInstallment": 10,
                    "solicitationId": 12345,
                    "withInsurance": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/v1/employee-credit/confirmation": {
      "post": {
        "tags": [
          "Open APIs",
          "Acquisition"
        ],
        "summary": "Proposal Confirmation",
        "description": "Proposal Confirmation",
        "operationId": "proposalConfirmation",
        "parameters": [
          {
            "name": "is_test",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "true"
            }
          },
          {
            "name": "consumer_id",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "12345"
            }
          },
          {
            "name": "solicitation_id",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "12345"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
