{
  "openapi": "3.1.0",
  "info": {
    "title": "Prism Chat API",
    "description": "API for prism widget with chat and feedback logging endpoints.\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/PolicyReporter/prism-chat/1.0.0"
  },
  "servers": [
    {
      "url": "https://chatbot.policyreporter.com",
      "description": "Production"
    },
    {
      "url": "https://chatbot-pr.policyreporter.us",
      "description": "Stage"
    }
  ],
  "paths": {
    "/chat": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Send chat message",
        "description": "Sends a message to the AI chatbot and receives a streaming response",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Accept",
            "schema": {
              "type": "string",
              "default": "*/*"
            },
            "required": false,
            "description": "Accept header for response content type"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Streaming chat response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "description": "Newline-delimited JSON stream"
                },
                "examples": {
                  "streamingResponse": {
                    "value": "{\"text\":\"## Jefferson\"}\n{\"text\":\" Health Plans Taltz\"}\n{\"text\":\" PA Requirements\\n\\n\"}\n{\"text\":\"I can help you\"}\n{\"isComplete\":true,\"sources\":[{\"rank\":1,\"title\":\"Prior Authorization Form\",\"url\":\"https://example.com/doc1\"}]}\n"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "unauthorized": {
                    "value": {
                      "message": "Unauthorized"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Message": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "forbidden": {
                    "value": {
                      "Message": "User is not authorized to access this resource with an explicit deny in an identity-based policy"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "error": {
                    "value": "An unexpected error occurred while processing your request"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/log-response": {
      "post": {
        "tags": [
          "Logging"
        ],
        "summary": "Log user feedback or events",
        "description": "Logs user feedback, events, or other telemetry data",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event logged successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "error": {
                    "value": {
                      "error": "An unexpected error occurred while processing your request"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": [
          "userMessage"
        ],
        "properties": {
          "userMessage": {
            "type": "string",
            "maxLength": 10000
          },
          "sessionId": {
            "type": "string"
          },
          "invocationId": {
            "type": "string"
          },
          "appliedFilters": {
            "type": "object"
          },
          "excludedFilters": {
            "type": "object"
          },
          "needsChatName": {
            "type": "boolean"
          },
          "persona": {
            "type": "string",
            "enum": [
              "frm",
              "hub"
            ],
            "default": "frm"
          }
        },
        "examples": [
          {
            "userMessage": "Tell me about the jefferson health plan prior auth form requirements for Taltz",
            "sessionId": "",
            "invocationId": "",
            "needsChatName": true,
            "persona": "frm"
          }
        ]
      },
      "LogRequest": {
        "type": "object",
        "required": [
          "sessionId",
          "invocationId",
          "question",
          "answer",
          "feedback"
        ],
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "invocationId": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "feedback": {
            "type": "string",
            "enum": [
              "Upvote",
              "Downvote"
            ]
          },
          "reason": {
            "type": "string"
          },
          "fullChat": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "examples": [
          {
            "sessionId": "sessionId_123",
            "invocationId": "invocationId_123",
            "question": "tell me about the jefferson health plan prior auth form requirements for Taltz",
            "answer": "Jefferson Health Plans Taltz PA Requirements\n\nI can help you with Jefferson Health Plans' Taltz prior authorization forms...",
            "feedback": "Upvote",
            "reason": ""
          }
        ]
      },
      "LogResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "examples": [
          {
            "message": "Event logged successfully",
            "status": "success"
          }
        ]
      },
      "UnauthorizedError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "examples": [
          {
            "message": "Unauthorized"
          }
        ]
      },
      "ForbiddenError": {
        "type": "object",
        "properties": {
          "Message": {
            "type": "string"
          }
        },
        "examples": [
          {
            "Message": "User is not authorized to access this resource with an explicit deny in an identity-based policy"
          }
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token authentication. \n\n**How to get the token:**\n\n- **Production:** The JWT access token can be found in the Policy Reporter website cookies after logging in.\n\n    WARNING: The access token expires after 5 minutes.\n\n- **Stage:** The JWT access token can be retrieved from this link \n\n      https://app.swaggerhub.com/apis/PolicyReporter/prism-login/1.0.0#/\n"
      }
    }
  },
  "tags": [
    {
      "name": "Chat",
      "description": "Conversation endpoints"
    },
    {
      "name": "Logging",
      "description": "Feedback logging endpoints"
    }
  ]
}
