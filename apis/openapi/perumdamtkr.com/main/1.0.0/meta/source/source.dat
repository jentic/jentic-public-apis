  "paths": {
    "/api/register": {
      "post": {
        "tags": [
          "login"
        ],
        "summary": "Register user",
        "description": "Registers a new user into the system.",
        "operationId": "registerUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "tatangfriyatna1991@gmail.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "rahasia123"
                  },
                  "phone": {
                    "type": "string",
                    "example": "085777877527"
                  },
                  "role_id": {
                    "type": "number",
                    "example": 2
                  },
                  "username": {
                    "type": "string",
                    "example": "tatangfr27"
                  },
                  "wilayah_id": {
                    "type": "number",
                    "example": 1
                  }
                }
              },
              "examples": {
                "Register user": {
                  "value": {
                    "email": "tatangfriyatna1991@gmail.com",
                    "password": "rahasia123",
                    "phone": "085777877527",
                    "role_id": 2,
                    "username": "tatangfr27",
                    "wilayah_id": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {}
        ]
      }
    },
