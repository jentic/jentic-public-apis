    "/api/work-orders": {
      "post": {
        "tags": [
          "work-orders"
        ],
        "summary": "insert work order",
        "description": "Creates a new work order entry in the system.",
        "operationId": "insertWorkOrder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "alamat": {
                    "type": "string",
                    "example": "{{alamat}}"
                  },
                  "category": {
                    "type": "string",
                    "example": "{{category}}"
                  },
                  "channel_id": {
                    "type": "string",
                    "example": "{{channel_id}}"
                  },
                  "created_by": {
                    "type": "string",
                    "example": "{{created_by}}"
                  },
                  "customer": {
                    "type": "string",
                    "example": "{{customer}}"
                  },
                  "description": {
                    "type": "string",
                    "example": "{{description}}"
                  },
                  "external_ref": {
                    "type": "string",
                    "example": "{{external_ref}}"
                  },
                  "kd_kabupaten": {
                    "type": "string",
                    "example": "{{kd_kabupaten}}"
                  },
                  "kd_kecamatan": {
                    "type": "string",
                    "example": "{{kd_kecamatan}}"
                  },
                  "kd_kelurahan": {
                    "type": "string",
                    "example": "{{kd_kelurahan}}"
                  },
                  "kd_propinsi": {
                    "type": "string",
                    "example": "{{kd_propinsi}}"
                  },
                  "link_maps": {
                    "type": "string",
                    "example": "{{link_maps}}"
                  },
                  "nama": {
                    "type": "string",
                    "example": "{{nama}}"
                  },
                  "no_hp": {
                    "type": "string",
                    "example": "{{no_hp}}"
                  },
                  "pengaduan_id": {
                    "type": "string",
                    "example": "{{pengaduan_id}}"
                  },
                  "priority": {
                    "type": "string",
                    "example": "{{priority}}"
                  },
                  "status": {
                    "type": "string",
                    "example": "{{status}}"
                  },
                  "wilayah_id": {
                    "type": "string",
                    "example": "{{wilayah_id}}"
                  }
                }
              },
              "examples": {
                "insert non-pelanggan 1000 data": {
                  "value": {
                    "alamat": "{{alamat}}",
                    "category": "{{category}}",
                    "channel_id": "{{channel_id}}",
                    "created_by": "{{created_by}}",
                    "customer": "{{customer}}",
                    "description": "{{description}}",
                    "external_ref": "{{external_ref}}",
                    "kd_kabupaten": "{{kd_kabupaten}}",
                    "kd_kecamatan": "{{kd_kecamatan}}",
                    "kd_kelurahan": "{{kd_kelurahan}}",
                    "kd_propinsi": "{{kd_propinsi}}",
                    "link_maps": "{{link_maps}}",
                    "nama": "{{nama}}",
                    "no_hp": "{{no_hp}}",
                    "pengaduan_id": "{{pengaduan_id}}",
                    "priority": "{{priority}}",
                    "status": "{{status}}",
                    "wilayah_id": "{{wilayah_id}}"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "alamat": {
                    "type": "string",
                    "example": "Tangsel"
                  },
                  "category": {
                    "type": "string",
                    "example": "administratif"
                  },
                  "channel_id": {
                    "type": "string",
                    "example": "d2cdf499-eb62-4198-816a-54cafc642d4e"
                  },
                  "complaint_pic": {
                    "type": "string",
                    "format": "binary"
                  },
                  "created_by": {
                    "type": "string",
                    "example": "c833a173-b523-46ba-80dc-002055f3eb64"
                  },
                  "customer": {
                    "type": "string",
                    "example": "non-pelanggan"
                  },
                  "description": {
                    "type": "string",
                    "example": "Pipa utama bocor di area perumahan"
                  },
                  "external_ref": {
                    "type": "string",
                    "example": ""
                  },
                  "kd_kabupaten": {
                    "type": "string",
                    "example": "02"
                  },
                  "kd_kecamatan": {
                    "type": "string",
                    "example": "032"
                  },
                  "kd_kelurahan": {
                    "type": "string",
                    "example": "285"
                  },
                  "kd_propinsi": {
                    "type": "string",
                    "example": "36"
                  },
                  "latitude": {
                    "type": "string",
                    "example": "-6.90389"
                  },
                  "link_maps": {
                    "type": "string",
                    "example": ""
                  },
                  "longitude": {
                    "type": "string",
                    "example": "107.61861"
                  },
                  "nama": {
                    "type": "string",
                    "example": "Rahayu"
                  },
                  "no_hp": {
                    "type": "string",
                    "example": "085089876768"
                  },
                  "pengaduan_id": {
                    "type": "string",
                    "example": "0c1d14b0-1cd0-4e31-8c7f-a870aa2a7c76"
                  },
                  "priority": {
                    "type": "string",
                    "example": "high"
                  },
                  "status": {
                    "type": "string",
                    "example": "new"
                  },
                  "wilayah_id": {
                    "type": "string",
                    "example": "9"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
