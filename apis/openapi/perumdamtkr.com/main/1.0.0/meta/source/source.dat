      "post": {
        "tags": [
          "assign-work-orders"
        ],
        "summary": "Petugas reject tiket dari kasie",
        "description": "Allows an officer (petugas) to decline an assigned work order, typically requiring a valid reason for the rejection.",
        "operationId": "petugasRejectTiketDariKasie",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "detail_work_order_id": {
                    "type": "string",
                    "example": "a4303633-9e51-437d-8d3b-464475077006"
                  },
                  "reject_note": {
                    "type": "string",
                    "example": "Tidak bisa hadir karena sedang ada tugas lain."
                  }
                }
              },
              "examples": {
                "Petugas reject tiket dari kasie": {
                  "value": {
                    "detail_work_order_id": "a4303633-9e51-437d-8d3b-464475077006",
                    "reject_note": "Tidak bisa hadir karena sedang ada tugas lain."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Petugas reject tiket dari kasie",
            "headers": {
              "Access-Control-Allow-Origin": {
                "schema": {
                  "type": "string",
                  "example": "*"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-cache, private"
                }
              },
              "Connection": {
                "schema": {
                  "type": "string",
                  "example": "Keep-Alive"
                }
              },
              "Date": {
                "schema": {
                  "type": "string",
                  "example": "Wed, 19 Nov 2025 02:05:21 GMT"
                }
              },
              "Keep-Alive": {
                "schema": {
                  "type": "string",
                  "example": "timeout=5, max=100"
                }
              },
              "Server": {
                "schema": {
                  "type": "string",
                  "example": "Apache/2.4.58 (Unix) OpenSSL/1.1.1w PHP/8.2.12 mod_perl/2.0.12 Perl/v5.34.1"
                }
              },
              "Transfer-Encoding": {
                "schema": {
                  "type": "string",
                  "example": "chunked"
                }
              },
              "Vary": {
                "schema": {
                  "type": "string",
                  "example": "Authorization"
                }
              },
              "X-Powered-By": {
                "schema": {
                  "type": "string",
                  "example": "PHP/8.2.12"
                }
              },
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "string",
                  "example": "60"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "string",
                  "example": "58"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "all_rejected": {
                          "type": "boolean",
                          "example": false
                        },
                        "detail_work_order_id": {
                          "type": "string",
                          "example": "a4303633-9e51-437d-8d3b-464475077006"
                        },
                        "status": {
                          "type": "string",
                          "example": "assigned"
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Tiket berhasil ditolak."
                    },
                    "status": {
                      "type": "string",
                      "example": true
                    },
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                },
                "examples": {
                  "Petugas reject tiket dari kasie": {
                    "value": {
                      "data": {
                        "all_rejected": false,
                        "detail_work_order_id": "a4303633-9e51-437d-8d3b-464475077006",
                        "status": "assigned"
                      },
                      "message": "Tiket berhasil ditolak.",
                      "status": true,
                      "success": true
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
