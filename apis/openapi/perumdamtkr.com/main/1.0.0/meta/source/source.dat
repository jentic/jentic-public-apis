      "post": {
        "tags": [
          "reviews"
        ],
        "summary": "Kasie kirim penilaian work orders",
        "description": "Submit supervisor evaluations for work orders.",
        "operationId": "kasieKirimPenilaianWorkOrders",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reviews": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "komentar": {
                          "type": "string",
                          "example": "Pekerjaan cepat, hasil memuaskan."
                        },
                        "petugas_id": {
                          "type": "string",
                          "example": "73142870-efb5-4e51-8c82-af790af8360f"
                        },
                        "rating": {
                          "type": "number",
                          "example": 8
                        }
                      }
                    },
                    "example": [
                      {
                        "komentar": "Pekerjaan cepat, hasil memuaskan.",
                        "petugas_id": "73142870-efb5-4e51-8c82-af790af8360f",
                        "rating": 8
                      },
                      {
                        "komentar": "Masih ada sedikit kekurangan pada hasil akhir.",
                        "petugas_id": "2b1b4051-38c8-4c7a-a963-8d426d494e61",
                        "rating": 7.5
                      },
                      {
                        "komentar": "Koordinasi sangat baik dan inisiatif tinggi.",
                        "petugas_id": "2a97d8d9-050b-418a-b615-4a75e2d52bc4",
                        "rating": 9
                      }
                    ]
                  },
                  "work_order_id": {
                    "type": "string",
                    "example": "a03a431d-9a9d-4e99-b55b-4ece562aabb3"
                  }
                }
              },
              "examples": {
                "Kasie kirim penilaian work orders": {
                  "value": {
                    "reviews": [
                      {
                        "komentar": "Pekerjaan cepat, hasil memuaskan.",
                        "petugas_id": "73142870-efb5-4e51-8c82-af790af8360f",
                        "rating": 8
                      },
                      {
                        "komentar": "Masih ada sedikit kekurangan pada hasil akhir.",
                        "petugas_id": "2b1b4051-38c8-4c7a-a963-8d426d494e61",
                        "rating": 7.5
                      },
                      {
                        "komentar": "Koordinasi sangat baik dan inisiatif tinggi.",
                        "petugas_id": "2a97d8d9-050b-418a-b615-4a75e2d52bc4",
                        "rating": 9
                      }
                    ],
                    "work_order_id": "a03a431d-9a9d-4e99-b55b-4ece562aabb3"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
