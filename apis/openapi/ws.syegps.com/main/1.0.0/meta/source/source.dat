{
  "openapi": "3.0.3",
  "info": {
    "title": "API SYEGPS",
    "description": "API REST para la consulta de ubicación y estado en tiempo real de unidades GPS registradas en la plataforma SYEGPS.\n\n## Autenticación\nEsta API utiliza **Bearer Token (JWT)**. El token es compartido por el equipo de SYEGPS vía correo electrónico.\n\nIncluye el token en cada petición mediante el header `Authorization`:\n```\nAuthorization: Bearer <tu_token>\n```\n\n## Notas\n- Usa `\"DeviceAlias\": \"*\"` para consultar **todas las unidades** de la cuenta.\n- Usa `\"DeviceAlias\": \"nombre\"` para consultar **una unidad específica**.\n- Las coordenadas `Latitude` y `Longitude` están en formato decimal (WGS84).\n- `StopingTime` y `StopingDate` son `null` si la unidad está en movimiento.\n",
    "version": "1.0.0",
    "contact": {
      "name": "Soporte SYEGPS",
      "url": "https://ws.syegps.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/SyeGPS/API_JWT/1.0.0"
  },
  "servers": [
    {
      "url": "https://ws.syegps.com",
      "description": "Servidor de producción"
    }
  ],
  "tags": [
    {
      "name": "Unidades GPS",
      "description": "Consulta de ubicación y estado de unidades GPS en tiempo real"
    }
  ],
  "paths": {
    "/syegps/api/oauth/customFormat": {
      "post": {
        "tags": [
          "Unidades GPS"
        ],
        "summary": "Consultar ubicación de unidades",
        "description": "Devuelve la ubicación actual, estado de movimiento y tiempo de parada de una o más unidades GPS.\n\n- Para obtener **todas las unidades** de la cuenta, envía `\"DeviceAlias\": \"*\"`.\n- Para obtener **una unidad específica**, envía el alias exacto, por ejemplo `\"DeviceAlias\": \"F-150\"`.\n",
        "operationId": "customFormatOne",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GPSRequest"
              },
              "examples": {
                "todas_las_unidades": {
                  "summary": "Consultar todas las unidades",
                  "value": {
                    "accountId": "DcpAvGSiTPsSf0...P",
                    "DeviceAlias": "*"
                  }
                },
                "unidad_especifica": {
                  "summary": "Consultar una unidad específica",
                  "value": {
                    "accountId": "DcpAvGSiTPsSf0...P",
                    "DeviceAlias": "F-150"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consulta exitosa. Devuelve un arreglo con la(s) unidad(es) encontrada(s).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GPSUnit"
                  }
                },
                "examples": {
                  "todas_las_unidades": {
                    "summary": "Respuesta con múltiples unidades",
                    "value": [
                      {
                        "Alias": "F-150",
                        "DeviceID": "0680021605",
                        "Date": "2026-03-10",
                        "Time": "17:30:00",
                        "Latitude": 27.553622,
                        "Longitude": -99.480388,
                        "Course": 213,
                        "Moving": true,
                        "StopingTime": null,
                        "StopingDate": null
                      },
                      {
                        "Alias": "RM 02",
                        "DeviceID": "863719062231106",
                        "Date": "2026-03-02",
                        "Time": "07:51:21",
                        "Latitude": 27.4581666,
                        "Longitude": -99.56683,
                        "Course": 38,
                        "Moving": false,
                        "StopingTime": "21:25:07",
                        "StopingDate": "2026-02-27"
                      },
                      {
                        "Alias": "RM 05",
                        "DeviceID": "0950002772",
                        "Date": "2026-03-10",
                        "Time": "17:21:38",
                        "Latitude": 27.45813,
                        "Longitude": -99.567043,
                        "Course": 0,
                        "Moving": false,
                        "StopingTime": "00:38:22",
                        "StopingDate": "2026-03-06"
                      }
                    ]
                  },
                  "unidad_especifica": {
                    "summary": "Respuesta con una sola unidad",
                    "value": [
                      {
                        "Alias": "F-150",
                        "DeviceID": "0680021605",
                        "Date": "2026-03-10",
                        "Time": "17:41:00",
                        "Latitude": 27.503873,
                        "Longitude": -99.503238,
                        "Course": 183,
                        "Moving": true,
                        "StopingTime": null,
                        "StopingDate": null
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT compartido por el equipo SYEGPS vía correo electrónico."
      }
    },
    "schemas": {
      "GPSRequest": {
        "type": "object",
        "required": [
          "accountId",
          "DeviceAlias"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "description": "Identificador único de la cuenta SYEGPS",
            "example": "DcpAvGSiTPsSf0...P"
          },
          "DeviceAlias": {
            "type": "string",
            "description": "Alias de la unidad a consultar. Usa `\"*\"` para obtener todas las unidades de la cuenta.\n",
            "example": "*"
          }
        }
      },
      "GPSUnit": {
        "type": "object",
        "properties": {
          "Alias": {
            "type": "string",
            "description": "Nombre o alias asignado a la unidad GPS",
            "example": "F-150"
          },
          "DeviceID": {
            "type": "string",
            "description": "Identificador único del dispositivo GPS",
            "example": "0680021605"
          },
          "Date": {
            "type": "string",
            "format": "date",
            "description": "Fecha del último reporte de la unidad (YYYY-MM-DD)",
            "example": "2026-03-10"
          },
          "Time": {
            "type": "string",
            "format": "time",
            "description": "Hora del último reporte de la unidad (HH:MM:SS)",
            "example": "17:30:00"
          },
          "Latitude": {
            "type": "number",
            "format": "double",
            "description": "Latitud de la posición actual en grados decimales (WGS84)",
            "example": 27.553622
          },
          "Longitude": {
            "type": "number",
            "format": "double",
            "description": "Longitud de la posición actual en grados decimales (WGS84)",
            "example": -99.480388
          },
          "Course": {
            "type": "integer",
            "description": "Dirección de movimiento en grados (0-360, donde 0/360 = Norte)",
            "minimum": 0,
            "maximum": 360,
            "example": 213
          },
          "Moving": {
            "type": "boolean",
            "description": "Indica si la unidad está en movimiento (`true`) o detenida (`false`)",
            "example": true
          },
          "StopingTime": {
            "type": "string",
            "format": "time",
            "nullable": true,
            "description": "Hora en que la unidad se detuvo (HH:MM:SS). `null` si está en movimiento.",
            "example": "21:25:07"
          },
          "StopingDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Fecha en que la unidad se detuvo (YYYY-MM-DD). `null` si está en movimiento.",
            "example": "2026-02-27"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Código del error",
            "example": "unauthorized"
          },
          "message": {
            "type": "string",
            "description": "Descripción del error",
            "example": "Token inválido o expirado."
          },
          "status": {
            "type": "integer",
            "description": "Código HTTP del error",
            "example": 401
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Token Bearer inválido, expirado o no proporcionado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "unauthorized",
              "message": "Token inválido o expirado. Contacta al equipo SYEGPS para obtener un nuevo token.",
              "status": 401
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Se superó el límite de peticiones permitidas (throttle)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "too_many_requests",
              "message": "Has superado el límite de peticiones. Intenta de nuevo más tarde.",
              "status": 429
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Error interno del servidor",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "internal_server_error",
              "message": "Ocurrió un error inesperado. Contacta al soporte de SYEGPS.",
              "status": 500
            }
          }
        }
      }
    }
  }
}
