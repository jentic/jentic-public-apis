{
  "openapi": "3.1.0",
  "info": {
    "title": "AMiT API",
    "version": "1.0.0",
    "description": "API for retrieving train seat-reservation data for the AMiT onboard system.\nIt provides trip listings and links to reservation datasets used to display\nreservation status for specific cars/sections/seats.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/regiojet/AMiT/1.0.0"
  },
  "servers": [
    {
      "url": "https://amit-api.sa.cz"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v1/trips": {
      "get": {
        "tags": [
          "Trips"
        ],
        "summary": "List trips with available reservation data (next 24h)",
        "description": "Fixed server-side time window: trips with scheduled departure time in\n[now(), now()+24h).\n\nNote: Requests to URLs returned by this endpoint (the\n`url` field in each trip) MUST be performed with `Authorization: Bearer <token>`.\n",
        "parameters": [
          {
            "name": "lineGroup",
            "in": "query",
            "required": false,
            "description": "Filter by line groups.",
            "schema": {
              "type": "string"
            },
            "example": "LINE_GROUP_1"
          }
        ],
        "responses": {
          "200": {
            "description": "List of trips.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Trip"
                  }
                },
                "example": [
                  {
                    "tripId": "trip_123456",
                    "lineGroup": "LINE_GROUP_1",
                    "departureStation": "Praha hl.n.",
                    "scheduledDeparture": "2026-01-07T12:05:00+01:00",
                    "dataId": 1767786250,
                    "url": "https://amit-api.sa.cz/trip_123456.json"
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing/invalid Bearer token)."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Provide the token in the `Authorization` header:\n`Authorization: Bearer <token>`.\nThis also applies to any URLs returned by the API (e.g., `Trip.url`).\n"
      }
    },
    "schemas": {
      "Trip": {
        "type": "object",
        "required": [
          "tripId",
          "lineGroup",
          "departureStation",
          "scheduledDeparture",
          "dataId",
          "url"
        ],
        "properties": {
          "tripId": {
            "type": "string",
            "description": "Trip identifier."
          },
          "lineGroup": {
            "type": "string",
            "description": "Line group."
          },
          "departureStation": {
            "type": "string",
            "description": "Departure station."
          },
          "scheduledDeparture": {
            "type": "string",
            "format": "date-time",
            "description": "Scheduled departure time per timetable."
          },
          "dataId": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of last change in reservation data."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "URL to download JSON reservation data for this trip.\nRequests to this URL MUST include `Authorization: Bearer <token>`."
          }
        }
      }
    }
  }
}
