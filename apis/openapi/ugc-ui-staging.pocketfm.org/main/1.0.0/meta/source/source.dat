{
  "openapi": "3.0.3",
  "info": {
    "title": "UGC AI Copilot API",
    "version": "1.0.0",
    "description": "Centralized OpenAPI contract for Copilot AI modes: Ask, Plan, Review, and Research.\n\nImplements an async polling architecture using request_id-based task tracking.\nIncludes task lifecycle modeling (pending, processing, completed, failed),\nstructured review outputs, and standardized response schemas.\n\nVersion 1.0.0 – Initial unified contract for Copilot async architecture.\n",
    "contact": {
      "name": "Dharamjeet Kumar",
      "email": "dharamjeet.kumar@pocketfm.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/pocketfm/UGC-AI-Copilot/1.0.0"
  },
  "servers": [
    {
      "url": "https://virtserver.swaggerhub.com/pocketfm/UGC-AI-Copilot/1.0.0",
      "description": "SwaggerHub Auto Mock Server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Agent"
    },
    {
      "name": "Tasks"
    }
  ],
  "paths": {
    "/api/v1/agent/universal-ai-chat": {
      "post": {
        "tags": [
          "Agent"
        ],
        "summary": "Trigger AI Task (Ask / Plan / Review / Research)",
        "description": "Creates an async AI task and returns request_id for polling.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UniversalAIRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UniversalAIResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/chat/threads/{thread_id}/tasks/list": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "List Tasks",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tasks retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/threads/{thread_id}/tasks/status": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Get Task Status With Content",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "request_ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task status retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskStatusResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid payload",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "UniversalAIRequest": {
        "type": "object",
        "required": [
          "request_id",
          "thread_id",
          "query",
          "mode"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "thread_id": {
            "type": "string",
            "format": "uuid"
          },
          "query": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "ask",
              "plan",
              "review",
              "research"
            ]
          },
          "action": {
            "type": "string",
            "description": "Required for review mode (quick_polish or creative_review)"
          },
          "content_url": {
            "type": "string",
            "format": "uri"
          },
          "full_episode_text": {
            "type": "string"
          },
          "input_language": {
            "type": "string"
          },
          "file_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "UniversalAIResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "example": 1
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string"
              },
              "mode": {
                "type": "string"
              },
              "action": {
                "type": "string"
              }
            }
          }
        }
      },
      "TaskListResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "tasks": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TaskListItem"
                }
              }
            }
          }
        }
      },
      "TaskListItem": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "artifact_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TaskStatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "tasks": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TaskStatusItem"
                }
              }
            }
          }
        }
      },
      "TaskStatusItem": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "artifact_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "completed",
              "failed"
            ]
          },
          "content": {
            "type": "object",
            "description": "Mode-specific response content"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
