    "/v1/stocks/{ticker}/valuation-multiples/history": {
      "get": {
        "tags": [
          "Multiples"
        ],
        "summary": "A company's valuation multiples over time — EV/Revenue, EV/EBIT, EV/EBITDA, and P/E recomputed point-in-time at each past quarter's filing date, oldest first (up to ~10 years); REITs also carry P/FFO and P/AFFO, and any filer with a verified reconciliation carries EV over its own stated Adjusted EBITDA, from the company's SEC-stated reconciliation as it existed at each sample date. Each sample uses only facts filed by that date and that day's raw close; a completed exact-primary split reconciliation preserves older samples, while anchors before an unresolved split are omitted. Absent ratios carry a machine-readable reason (evMissingReason / peMissingReason) instead of an estimate.",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Stock ticker symbol (e.g. AAPL).",
