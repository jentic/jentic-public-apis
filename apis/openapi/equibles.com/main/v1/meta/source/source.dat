            "nullable": true
          },
          "kind": {
            "type": "string",
            "description": "\"Company\", \"Government\" or \"Other\".",
            "nullable": true
          },
          "kindLabel": {
            "type": "string",
            "description": "What its page says it is, e.g. \"U.S. federal agency\" or \"Company · Not listed on a market we cover\".",
            "nullable": true
          },
          "countryCode": {
