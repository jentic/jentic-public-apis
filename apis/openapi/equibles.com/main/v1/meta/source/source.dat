            "description": "Fiscal year of the financial figures below; null when no annual XBRL facts exist.",
            "format": "int32",
            "nullable": true
          },
          "revenue": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "revenueGrowthPercent": {
