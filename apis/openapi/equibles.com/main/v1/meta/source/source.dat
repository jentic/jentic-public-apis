            "$ref": "#/components/schemas/CallParticipantDto"
          },
          "firm": {
            "$ref": "#/components/schemas/AnalystFirmRefDto"
          },
          "question": {
            "type": "string",
            "description": "The full text of every turn the analyst spoke in this exchange, joined by blank lines.",
            "nullable": true
          },
          "answerers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CallParticipantDto"
            },
            "nullable": true
          },
