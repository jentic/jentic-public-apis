    "/v1/indexes/{index}/changes": {
      "get": {
        "tags": [
          "Indexes"
        ],
        "summary": "Companies that joined or left an index, newest first. Derived by comparing consecutive lists from the funds that track it, so each change is dated to the window between two reports (previousAsOfDate to observedAsOfDate) rather than to an announcement. Records from several funds for the same company and direction over overlapping windows are collapsed into one event, keeping the narrowest window.",
        "parameters": [
          {
            "name": "index",
            "in": "path",
            "description": "Index slug or name: \"sp-500\", \"S&P 500\", \"nasdaq-100\", \"Russell 2000\".",
