            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "One public company ranked by total federal contract dollars awarded."
      },
      "TopGovernmentContractorsResponse": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "description": "Resolved start of the ranked window.",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "description": "Resolved end of the ranked window.",
            "format": "date"
          },
          "latestActionDate": {
            "type": "string",
            "description": "Most recent action date stored across the whole government-contracts dataset — the coverage as-of. Null when no contract data is loaded (an empty ranking then means no coverage, not no awards).",
            "format": "date",
            "nullable": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopGovernmentContractorDto"
            },
            "nullable": true
          },
          "total": {
            "type": "integer",
            "description": "Total distinct companies with awards in the window (the MCP tool's denominator) — data is truncated whenever it holds fewer rows (additive, #7056).",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Top federal contractors over a date range. The resolved range is echoed back\n            because both bounds default server-side (1 year ago to today)."
      },
      "TopHolderDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "cik": {
            "type": "string",
            "description": "SEC CIK of the institution — the identifier accepted by the v1/institutions/{cik}/* endpoints.",
            "nullable": true
          },
          "shares": {
            "type": "integer",
            "description": "Share count restated onto today's split basis (matching every other 13F surface).",
            "format": "int64"
          },
          "value": {
            "type": "integer",
            "description": "Published position value in dollars: normally shares × the split-restated quarter-end close, with the filer's value used as a fallback; zero can mean unavailable.",
            "format": "int64"
          },
          "percentOfTotal": {
            "type": "number",
            "description": "Share of the total reported INSTITUTIONAL quantity at the report date (not of shares outstanding). That denominator sums common-share, put/call notional-underlying and any tracked principal-denominated rows, so it is a share of aggregate 13F exposure, not of ownership. Each exact listing is restated onto today's split basis before the ratio is computed.",
            "format": "double"
          },
          "listedTicker": {
            "type": "string",
            "description": "The exact listed share class this position is in (e.g. \"GOOG\" beside the primary \"GOOGL\"). Null = the primary listing.",
            "nullable": true
          },
          "positionType": {
            "type": "string",
            "description": "The security this line reports: \"Common\" = shares held outright, \"Principal\" = a principal-denominated security, and \"Put\" or \"Call\" = an option position reported at the notional value of underlying shares. A put is a bearish bet, not ownership.",
            "nullable": true
          },
          "holderType": {
            "type": "string",
            "description": "The holder's entity type from regulatory records (Form ADV rosters, the SEC filer profile, 13D/13G type codes, N-CEN), never from its name: \"Registered adviser\", \"Exempt adviser\", \"Adviser\", \"Bank\", \"Insurer\", \"Broker-dealer\", \"Registered fund\", \"Benefit plan\", \"Non-US\" or \"Unknown\" (no record decides it). Null when the holder is not yet classified.",
            "nullable": true
          },
          "style": {
            "type": "string",
            "description": "The holder's style band measured from its filed 13F book in meta.styleReportDate's quarter, never the firm's own description: \"Index-like\", \"Systematic-like\", \"Concentrated\", \"Diversified active\" or \"Unknown\" (book too small or unvalued to band). Null when the holder is not measured that quarter.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "TopHoldersMeta": {
        "type": "object",
        "properties": {
          "reportDate": {
            "type": "string",
            "format": "date"
          },
          "isCombinedQuarter": {
            "type": "boolean",
            "description": "True while the newest quarter's 13F filing window is open and the positions are presented as the combined view (funds that have not filed yet carry their prior-quarter positions)."
          },
          "totalInstitutions": {
            "type": "integer",
            "format": "int32"
          },
          "totalShares": {
            "type": "integer",
            "description": "Total reported institutional quantity at the report date, restated onto today's split basis. It sums common-share, put/call notional-underlying and any tracked principal-denominated rows, so it is aggregate 13F exposure, not pure share ownership.",
            "format": "int64"
          },
          "totalValue": {
            "type": "integer",
            "description": "Sum of published position values in dollars. Each value normally derives from reported shares × report-date close, may fall back to the filer's value, and can be zero when unavailable.",
            "format": "int64"
          },
          "styleReportDate": {
            "type": "string",
            "description": "The measured quarter every row's style comes from: the newest measured quarter on or before the report date. Null when no such quarter is measured yet.",
            "format": "date",
            "nullable": true
          },
          "matchingRows": {
            "type": "integer",
            "description": "With holderTypes or styles: the holding rows the filters keep, which limit and offset page through (additive). Omitted without a filter.",
            "format": "int32",
            "nullable": true
          },
          "matchingInstitutions": {
            "type": "integer",
            "description": "With holderTypes or styles: the distinct institutions among the kept rows (additive). Omitted without a filter.",
            "format": "int32",
            "nullable": true
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "offset": {
            "type": "integer",
            "format": "int32"
          },
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "hasMore": {
            "type": "boolean"
          },
          "total": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Paging meta extended with the report-date context and the whole-quarter totals the MCP GetTopHolders tool reports alongside its ranked list."
      },
