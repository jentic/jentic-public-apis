    "/v1/portfolios/{id}/watches": {
      "post": {
        "tags": [
          "Portfolios"
        ],
        "summary": "Puts an instrument on this portfolio's watchlist without recording any position.\n            Pass `optionContract` with the OCC symbol to watch an option, or omit it to watch the stock.\n            The instrument is verified against the live reference data before anything is stored, and\n            the priced portfolio then lists it in `watching` with a mark and no economics. Watching an\n            instrument the portfolio already watches answers 400; buying an instrument you watch folds\n            the watch row into the held position rather than showing two rows.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The portfolio to watch it in, from the portfolio list.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "The stock or option contract to watch without adding a holding.",
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/AddWatchRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddWatchRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AddWatchRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AddWatchRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioWatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
