            },
            "nullable": true
          },
          "federalAwards": {
            "$ref": "#/components/schemas/OrganizationAwardsDto"
          }
        },
        "additionalProperties": false,
        "description": "One organization: who it is, where it sits, the listed companies whose 10-K reports name it or one of its parts and,\nfor a federal agency, the listed companies it awarded the most. Without the Pro plan the company lists are empty and\nonly the counts and the unnamed overview are returned. A listed organization returns its ticker and no chain: read it\nfrom /v1/stocks/{ticker}/supply-chain."
      },
