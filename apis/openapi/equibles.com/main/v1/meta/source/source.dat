    "/v1/insiders": {
      "get": {
        "tags": [
          "InsiderTrading"
        ],
        "summary": "Search tracked corporate insiders (directors, officers, 10% owners) by whole name words, never arbitrary substrings. Exact legal names and verified aliases win; otherwise every word must match before a sparse any-word fallback. Recently active filers rank first; each result carries the most recent filing's company so namesakes are tellable apart.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Search query for insider name (required). Punctuation and word order are ignored. Verified aliases bridge public names to SEC legal names, so \"Jensen Huang\" resolves \"HUANG JEN HSUN\" without allowing a short substring such as \"ann\" to match \"JOANNA\".",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows to return (1–500; default varies per endpoint).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip before the first returned row (default 0).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsiderSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/insider-sentiment-scores": {
      "get": {
        "tags": [
          "InsiderTrading"
        ],
        "summary": "Stocks ranked by composite insider-sentiment score — a peer-relative 0-100 measure of how aggressively insiders are accumulating over a trailing 90-day window, from open-market Forms 4/5 buys and sells by officers and directors (a holder that is only a 10% owner is excluded). Highest score first. Rank reflects the full scored universe and does not renumber when liquidity filters are applied. Pass ticker for one stock's score and universe rank (the other filters do not apply then).",
        "parameters": [
          {
            "name": "clusterBuysOnly",
            "in": "query",
            "description": "Return only cluster buys (three or more distinct insiders buying in the window).",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "minMarketCap",
            "in": "query",
            "description": "Minimum market capitalization in USD (default 0 = no floor; stocks with unknown market cap are excluded when set).",
            "schema": {
              "type": "number",
              "format": "double",
              "default": 0.0
            }
          },
          {
            "name": "minSharePrice",
            "in": "query",
            "description": "Minimum share price in USD (default 0 = no floor; unknown price excluded when set).",
            "schema": {
              "type": "number",
              "format": "double",
              "default": 0.0
            }
          },
          {
            "name": "minDollarVolume",
            "in": "query",
            "description": "Minimum trailing 3-month average daily dollar volume in USD (default 0 = no floor; unknown volume excluded when set).",
            "schema": {
              "type": "number",
              "format": "double",
              "default": 0.0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows to return (1–500; default varies per endpoint).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip before the first returned row (default 0).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "bottom",
            "in": "query",
            "description": "Walk the ranking from the other end — heaviest net insider distribution (selling) first. Ranks stay the full-universe positions.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "ticker",
            "in": "query",
            "description": "Optional stock ticker (e.g. NVDA): returns that one stock's score and universe rank instead of the leaderboard; 404 when the stock is not in the scored universe.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InsiderSentimentScoresResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request — a malformed parameter value or a query parameter this endpoint does not support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/institutions": {
      "get": {
        "tags": [
          "Institutions"
        ],
        "summary": "Search the tracked 13F filer set by name or SEC CIK. Every punctuation-independent\nquery word is required first; the search broadens to any word only when no strict\nrow matches. CIK-prefix matches and verified flagship aliases are included.\nResults rank recently-active, larger filers first and include their latest 13F\nreport date, published tracked portfolio value and position count so namesakes can be\ndistinguished. The legacy reportedAum field normally uses report-date closing prices,\nmay fall back to filer values, and can include zero for unavailable valuations.\nThe returned CIK is the identifier every v1/institutions/{cik}/* endpoint accepts;\nmeta reports the total tracked match count so truncation is visible. Each filer carries\nits entity type from regulatory records, never from its name.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Institution name, partial name, or CIK (required).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum results to return (default 10, max 500).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          },
          {
            "name": "holderTypes",
            "in": "query",
            "description": "Comma-separated holder type tokens to keep: adv, era, ia, bank, ins, bd, fund, plan, nonus, unk (unk also matches a filer not yet classified).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstitutionSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/institutions/{cik}/portfolio": {
      "get": {
        "tags": [
          "Institutions"
        ],
        "summary": "The tracked stock positions reported by an institution for an actual 13F report date,\nranked by stored position value. Share counts are restated onto today's split basis by\neach position's own stock's splits. Value normally derives from shares times the report-date\nclose, falls back to filed value when needed, and can be zero when valuation is unavailable.",
        "parameters": [
          {
            "name": "cik",
            "in": "path",
            "description": "SEC CIK of the institution (see GET v1/institutions).",
