            "description": "The theme's name on the most recent call that raised it.",
            "nullable": true
          },
          "status": {
            "type": "string",
            "description": "Status on the latest call: \"new\" (raised on the latest call only, absent from the previous quarter's call), \"recurring\" (raised on the latest call and an earlier one), \"dropped\" (not raised on the latest call, and absent from the call in the quarter right after it was last seen) or \"unknown\" (that comparison would reach across an unscored quarter, or only one call is scored).",
            "nullable": true
          },
          "firstSeen": {
            "$ref": "#/components/schemas/CallThemeHistoryPeriodDto"
          },
          "lastSeen": {
