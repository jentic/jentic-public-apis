          "constituentCount": {
            "type": "integer",
            "description": "Companies in the published list, or 0 while no complete list is held.",
            "format": "int32"
          },
          "asOfDate": {
            "type": "string",
            "description": "The date the published list was reported for, or null while none is published.",
            "format": "date",
            "nullable": true
          },
          "source": {
            "type": "string",
            "description": "The fund and filing the published list came from, in one sentence.",
            "nullable": true
          },
          "isDaily": {
            "type": "boolean",
            "description": "True when the published list came from a fund's daily holdings file rather than a quarterly filing."
          }
        },
        "additionalProperties": false,
        "description": "One covered index and the state of the constituent list published for it."
      },
      "IndexSummaryDtoListResponse": {
