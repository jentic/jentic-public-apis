    },
    "/v1/indexes/{index}": {
      "get": {
        "tags": [
          "Indexes"
        ],
        "summary": "One index's current constituent list, heaviest first, with the fund and filing it came from. fundShares and fundValueUsd size the TRACKING FUND's position, never the company. Rows that could not be matched to a tracked company keep the name the fund reported and carry isLinked=false rather than being dropped.",
        "parameters": [
          {
            "name": "index",
            "in": "path",
            "description": "Index slug or name: \"sp-500\", \"S&P 500\", \"nasdaq-100\", \"Russell 2000\".",
