    "/v1/13f/flows": {
      "get": {
        "tags": [
          "HolderFlows"
        ],
        "summary": "Market-wide 13F holder flows for a closed quarter: what each kind of filer bought and sold of\n13F common shares, its net flow, net flow as a percentage of its prior 13F book, and net\nbuyers against net sellers. Trades are each filer's share changes priced at the security's\naverage close over the quarter, else its quarter-end value per share (an exit at the quarter\nbefore's); options and principal amounts are left out, and a share change from a corporate\naction reads as a trade. Only filers with a 13F the quarter before are compared. Holder type,\nclient base and private funds are each filer's current regulatory profile, never its name;\nstyle, turnover, horizon and book size are measured from its own 13F book that quarter.\nWith groupBy=sector each bucket's flow is split by its issuers' sectors, with exchange-traded\nproducts apart. Quarters still in their 13F filing window are not computed.",
        "parameters": [
          {
            "name": "dimension",
            "in": "query",
            "description": "How to split the filers: type (default), style, turnover, horizon, aum (13F book size), client (client base), pf (private funds) or country (filer location).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reportDate",
            "in": "query",
            "description": "A computed quarter end (yyyy-MM-dd, defaults to the newest). Any other date returns 400 listing the computed quarters.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "groupBy",
            "in": "query",
            "description": "none (default) or sector.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bucket",
            "in": "query",
            "description": "One bucket token of the dimension (e.g. adv or idx) to return only that bucket.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HolderFlowsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stocks/{ticker}/institutional-holders": {
      "get": {
        "tags": [
          "Holdings"
        ],
        "summary": "Top institutional holders (13F filers) of an exact stock or ETF listing, ranked by reported quantity. A row's\nquantity is common shares, an option position's notional underlying shares, or a\nprincipal amount, so the total is aggregate 13F exposure rather than pure ownership.\nWhile the newest quarter's 13F filing window is open, non-ETF primary stocks use the\ncombined view (new filings + prior-quarter carry-forward); ETF listings remain exact and\nas-filed because carry-forward is filer-wide. Share counts are restated onto today's basis.\nEach row carries the holder's entity type from regulatory records, never from its name, and its\nstyle band measured from its filed 13F book in one quarter for every row.",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Listed security ticker (e.g. AAPL or VOO).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reportDate",
            "in": "query",
            "description": "13F report date (yyyy-MM-dd, defaults to the latest available). Must be one of the stock's 13F report dates — any other date returns 400 listing the available dates.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows to return (1–500; default varies per endpoint).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip before the first returned row (default 0).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "holderTypes",
            "in": "query",
            "description": "Comma-separated holder type tokens to keep: adv, era, ia, bank, ins, bd, fund, plan, nonus, unk (unk also matches a holder not yet classified). Totals and percentages stay over every institution.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "styles",
            "in": "query",
            "description": "Comma-separated style band tokens to keep: idx (index-like), sys (systematic-like), conc (concentrated), divact (diversified active), unk (book too small or unvalued to band). Bands come from the newest measured quarter on or before the report date; a holder not measured that quarter matches no style. Totals and percentages stay over every institution.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopHoldersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/securities/{ticker}/institutional-holders": {
      "get": {
        "tags": [
