            "schema": {
              "type": "string"
            }
          },
          {
            "name": "years",
            "in": "query",
            "description": "Maximum fiscal years to return, newest first (default all on file; values below 1 are a 400).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
