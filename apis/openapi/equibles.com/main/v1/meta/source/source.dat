          },
          "overview": {
            "$ref": "#/components/schemas/SupplyChainOverviewDto"
          },
          "suppliers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SupplyChainCompanyDto"
            },
            "description": "Listed companies whose 10-K names it as a customer: they supply it.",
            "nullable": true
          },
          "customers": {
            "type": "array",
            "items": {
