    "/v1/web-data-feeds/{id}": {
      "get": {
        "tags": [
          "WebDataFeeds"
        ],
        "summary": "Returns the latest independently verified stored result for one tracker\n            owned by the API-key account, or the latest result at or before an optional historical\n            cutoff. It never triggers a live collection, and a newer failed run does not replace the\n            last good result.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The tracker id returned by GET /v1/web-data-feeds.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "at",
            "in": "query",
            "description": "Optional ISO-8601 timestamp. Returns the newest verified capture completed\n            at or before this instant.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebDataFeedDataResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request — a malformed parameter value or a query parameter this endpoint does not support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/custom-data-sets/{id}": {
      "get": {
        "tags": [
