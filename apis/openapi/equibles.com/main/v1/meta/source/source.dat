            "nullable": true
          },
          "isFilingWindowOpen": {
            "type": "boolean",
            "description": "True while the target quarter's 13F filing window is still open. Figures then use a combined view: filed funds contribute their current rows, while non-filers carry prior-quarter rows at zero delta so only reported moves rank."
