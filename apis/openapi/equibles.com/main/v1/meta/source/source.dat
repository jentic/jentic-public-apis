      "ShortSqueezeScoreDto": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "nullable": true
          },
          "rank": {
            "type": "integer",
            "description": "Position in the score-descending scored universe (1 = highest score), stamped before any liquidity filter — so a filtered board keeps each row's real standing instead of renumbering from 1, and the value matches what a single-ticker lookup reports for the same stock.",
            "format": "int32",
            "nullable": true
          },
          "score": {
            "type": "number",
            "description": "Composite 0-100 score: weighted mean of the available factor percentiles\n(short interest 30%, days to cover 20%, price vs trailing VWAP 15%, short-volume\ntrend 15%, short-interest change 10%, fails-to-deliver 10%; peer-relative, missing\nfactors drop out) plus catalyst boosts, capped at +20 and clamped to 100.",
            "format": "double"
          },
          "shortInterestPercentOfShares": {
            "type": "number",
            "description": "Current short position as a fraction of shares outstanding (0-1 scale).",
            "format": "double"
          },
          "daysToCover": {
            "type": "number",
            "description": "FINRA days-to-cover; computed from the average daily volume when not reported.",
            "format": "double",
            "nullable": true
          },
          "shortVolumeShareTrend": {
            "type": "number",
            "description": "Change in the short share of total volume: the most recent two weeks' pooled\nshort-volume ratio minus the prior two weeks'. Positive = rising pressure.",
            "format": "double",
            "nullable": true
          },
          "shortInterestChangePercent": {
            "type": "number",
            "description": "Change in the short position versus the previous FINRA report as a fraction of the\nprevious position (0.15 = shorts grew 15%), both positions split-adjusted; null when\nthe previous position is unknown or zero.",
            "format": "double",
            "nullable": true
          },
          "failsToDeliverPercentOfShares": {
            "type": "number",
            "description": "Worst single-day fails-to-deliver quantity over the trailing 30 days (split-adjusted)\nas a fraction of shares outstanding. Zero = the SEC feed reported no fails for the\nstock; null = the feed had no data.",
            "format": "double",
            "nullable": true
          },
          "priceAboveVwap": {
            "type": "number",
            "description": "Latest close versus the trailing volume-weighted average price (up to 65 trading\ndays, roughly one quarter), as a fraction of that average (0.25 = price sits 25%\nabove where recent volume traded); positive = open shorts underwater. Null without\nenough price history.",
            "format": "double",
            "nullable": true
          },
          "hasPriceSpikeCatalyst": {
            "type": "boolean",
            "description": "True when the last week's return is a 2-sigma outlier versus the stock's own daily volatility (+10 score boost)."
          },
          "hasVolumeSurgeCatalyst": {
            "type": "boolean",
            "description": "True when weekly dollar turnover runs at least twice the stock's baseline on a positive move (+10 score boost)."
          },
          "hasEarningsProximityCatalyst": {
            "type": "boolean",
            "description": "True when a scheduled earnings call sits within the squeeze window (5 weekdays before to 3 after; +10 score boost). False also means the calendar may simply not know the stock's date."
          },
          "marketCapitalization": {
            "type": "number",
            "description": "Market capitalization in USD; null when unknown.",
            "format": "double",
            "nullable": true
          },
          "averageDailyDollarVolume": {
            "type": "number",
            "description": "Approximate average daily dollar volume in USD (FINRA average daily share volume,\nrestated onto today's split basis, times the market-cap-implied share price);\nnull when either input is unknown.",
            "format": "double",
            "nullable": true
          },
          "baseScore": {
            "type": "number",
            "description": "The weighted mean of the factor percentiles alone, before any catalyst boost. Separating it from catalystBoost says whether a high score rests on standing short pressure or on a transient event. Note that score is the SUM clamped to 100, so on the highest scorers it is less than baseScore + catalystBoost.",
            "format": "double"
          },
          "catalystBoost": {
            "type": "number",
            "description": "The catalyst boost added to baseScore (+10 per catalyst, capped at +20). Score is the clamped sum.",
            "format": "double"
          },
          "shortInterestPercentile": {
            "type": "number",
            "description": "Peer-relative percentile (0-100) of shortInterestPercentOfShares across the scored universe — the value that actually feeds the score, since the raw fraction alone says nothing about how extreme it is.",
            "format": "double"
          },
          "daysToCoverPercentile": {
            "type": "number",
            "description": "Peer-relative percentile of daysToCover; null when the factor is missing and drops out of the weighted mean.",
            "format": "double",
            "nullable": true
          },
          "shortVolumeTrendPercentile": {
            "type": "number",
            "description": "Peer-relative percentile of shortVolumeShareTrend; null when the factor is missing.",
            "format": "double",
            "nullable": true
          },
          "shortInterestChangePercentile": {
            "type": "number",
            "description": "Peer-relative percentile of shortInterestChangePercent; null when the factor is missing.",
            "format": "double",
            "nullable": true
          },
          "failsToDeliverPercentile": {
            "type": "number",
            "description": "Peer-relative percentile of failsToDeliverPercentOfShares; null when the factor is missing.",
            "format": "double",
            "nullable": true
          },
          "priceAboveVwapPercentile": {
            "type": "number",
            "description": "Peer-relative percentile of priceAboveVwap; null when the factor is missing.",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ShortSqueezeScoresResponse": {
        "type": "object",
        "properties": {
          "settlementDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "data": {
