    "/v1/funds": {
      "get": {
        "tags": [
          "Funds"
        ],
        "summary": "Search the tracked directory of registered investment companies and UIT ETFs that file SEC Form NPORT-P. Exact identifiers and verified share-class aliases win; otherwise every punctuation-independent query word is required before a sparse any-word fallback. Results are largest by net assets first and include stored holdingCount, full reportedHoldingCount when available, holdingsCoverage, and a profileId accepted by the fund read endpoints. Money market funds and small business investment companies do not file NPORT-P; fixed-income-only trust series can also be absent from this tracked directory.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Fund name, ticker, profileId, series id, registrant, or verified share-class alias to search for (e.g. 'Russell 2000', 'iShares', 'IWM', 'VFIAX'); required.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum funds to return (default 20, max 500; zero or negative values are rejected, values above the maximum are clamped).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FundSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/funds/{ticker}/holdings": {
      "get": {
        "tags": [
          "Funds"
        ],
        "summary": "Portfolio holdings of a fund or ETF from its most recent SEC Form NPORT-P report, largest stored position first. Accepts the same exact profileId, SEC series id, stored series ticker, or verified share-class alias as directory search. Returns stored totalHoldings beside the filing's full reportedHoldingCount when available; holdingsCoverage is fullPortfolio for equal counts, trackedEquitiesOnly for fewer stored rows, or unknown for missing or inconsistent counts.",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Fund ticker, profileId, SEC series id, or verified share-class alias (e.g. SPY, 'vanguard-500-index-fund-s000002839', S000002839, or VOO).",
