  "components": {
    "schemas": {
      "AddPortfolioLotRequest": {
        "required": [
          "acquiredDate",
          "costPerUnit",
          "quantity",
          "ticker"
        ],
        "type": "object",
        "properties": {
          "ticker": {
            "minLength": 1,
            "type": "string",
            "description": "Stock ticker, or MIC:TICKER for a listing on another exchange (e.g. XPAR:AIR). For an\n            option, the ticker of the UNDERLYING U.S. stock."
          },
          "optionContract": {
            "type": "string",
            "description": "Optional OCC option symbol, e.g. O:AAPL260116C00250000. When present the contract's\n            expiration, strike, type and contract size are read back from the live options data, so an\n            unknown or expired symbol is rejected rather than stored. Omit it to record shares.",
            "nullable": true
          },
          "quantity": {
            "type": "number",
            "description": "Signed size: shares for a stock, contracts for an option. Negative for a short sale\n            or a written (sold-to-open) option.",
            "format": "double"
          },
          "costPerUnit": {
            "type": "number",
            "description": "Price per share, always positive: paid for a long, received for a short. For an\n            option this is the premium per share of the underlying, so a $3.20 contract is 3.20, not\n            320. In the currency the stock trades in, in major units: London prices in pounds, not\n            pence.",
            "format": "double"
          },
          "acquiredDate": {
            "type": "string",
            "description": "The trade date, yyyy-MM-dd. Cannot be in the future.",
            "format": "date"
          },
          "note": {
            "maxLength": 256,
            "type": "string",
            "description": "Optional note about this lot.",
            "nullable": true
          },
          "fxRate": {
            "type": "number",
            "description": "Optional broker exchange rate on the trade: units of the portfolio's currency per 1\n            unit of the lot's currency (the stock's trading currency; USD for an option). Only for a lot\n            in another currency than the portfolio's. Omitted, the cost converts at the official rate on\n            acquiredDate.",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AddWatchRequest": {
        "required": [
          "ticker"
        ],
        "type": "object",
        "properties": {
          "ticker": {
            "minLength": 1,
            "type": "string",
            "description": "Stock ticker, or MIC:TICKER for a listing on another exchange (e.g. XPAR:AIR). For an\n            option, the ticker of the UNDERLYING U.S. stock."
          },
          "optionContract": {
            "type": "string",
            "description": "Optional OCC option symbol, e.g. O:AAPL260116C00250000. When present the contract is\n            verified against the live options data before anything is stored. Omit it to watch the\n            stock.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AdviserSearchResponse": {
        "type": "object",
        "properties": {
          "totalMatches": {
            "type": "integer",
            "description": "Total advisers matching the query, before the limit truncation — when it\nexceeds the number of rows returned, narrow the query or raise limit.",
            "format": "int32"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvestmentAdviserSummaryDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AnalystEstimateResponseRow": {
        "type": "object",
        "properties": {
          "publicationLabel": {
            "type": "string",
            "nullable": true
          },
          "metric": {
            "type": "string",
            "nullable": true
          },
          "period": {
            "type": "string",
            "nullable": true
          },
          "dimensions": {
            "type": "string",
            "nullable": true
          },
          "unit": {
            "type": "string",
            "nullable": true
          },
          "basis": {
            "type": "string",
            "nullable": true
          },
          "statistic": {
            "type": "string",
            "nullable": true
          },
          "analyst": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "type": "string",
            "nullable": true
          },
          "footnotes": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AnalystEstimateSnapshotViewModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "publicationLabel": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AnalystEstimatesResponse": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "nullable": true
          },
          "companyName": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "provider": {
            "type": "string",
            "nullable": true
          },
