    "/v1/institutions/{cik}/style-history": {
      "get": {
        "tags": [
          "Institutions"
        ],
        "summary": "A 13F filer's portfolio style per measured closed quarter, newest first: the style band\n(index-like, systematic-like, concentrated, diversified active), turnover and holding-horizon\nbands, the measurements behind them and a plain-language reason for each band. Bands measure\nthe filed common-share book, never the firm's own description; a quarter is measured once its\nfiling window closes. Measurements stay with the CIK that filed them, so earlierCiks and\nlaterCiks name the other CIKs across a CIK change.",
        "parameters": [
          {
            "name": "cik",
            "in": "path",
            "description": "SEC CIK of the institution (see GET v1/institutions).",
            "required": true,
