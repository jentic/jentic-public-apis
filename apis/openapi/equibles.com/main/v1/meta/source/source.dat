            "format": "int32",
            "nullable": true
          },
          "timed": {
            "type": "boolean",
            "description": "True when the transcript was made from the call audio, so questions carry\n            startSeconds and endSeconds; false leaves both null."
          },
          "questionCount": {
            "type": "integer",
            "format": "int32"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CallQuestionDto"
            },
            "nullable": true
          },
          "note": {
            "type": "string",
            "description": "Why data is empty; null when it is not.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
