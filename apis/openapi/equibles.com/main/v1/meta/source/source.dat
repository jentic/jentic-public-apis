      "DocumentSearchResponse": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "description": "The applied excerpt cap after clamping.",
            "format": "int32"
          },
          "count": {
            "type": "integer",
            "description": "Excerpts returned (equals data.length; count == limit signals the cap bound).",
            "format": "int32"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentSearchResultDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Search-result envelope (additive over the plain list, #7056): top-k retrieval has\n            no meaningful \"total matches\", so instead of a fake total the response echoes the applied\n            limit — count == limit means the result set was capped and a larger limit may surface more\n            excerpts. count < limit means no further excerpts cleared relevance at this limit —\n            EXCEPT on endpoints that take maxResultsPerCompany, where a non-zero per-company cap can\n            drop excerpts below the overall limit, so a short page there is not proof of\n            exhaustion."
      },
