    "/v1/portfolios/{id}/lots/{lotId}/close": {
      "post": {
        "tags": [
          "Portfolios"
        ],
        "summary": "Records a sale. Closing part of a lot splits it: the closed quantity becomes its own\n            closed row and the remainder stays open on its original cost basis, so a later close of the\n            rest is still priced against what was actually paid for it. The response carries the CLOSED\n            lot, whose id differs from the original one after a partial close.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The portfolio holding the lot.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "lotId",
            "in": "path",
