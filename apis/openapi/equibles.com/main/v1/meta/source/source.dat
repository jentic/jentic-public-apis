      "PortfolioLotDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "instrumentKind": {
            "type": "string",
            "description": "Stock or Option.",
            "nullable": true
          },
          "ticker": {
            "type": "string",
            "description": "The listed symbol: the stock itself, or an option's underlying.",
            "nullable": true
          },
          "exchange": {
            "type": "string",
            "description": "The exchange's market identifier code (MIC, e.g. XPAR) for a listing outside the U.S.;\n            null for a U.S. listing. Together with ticker it names the listing, e.g. XPAR:AIR.",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "occTicker": {
            "type": "string",
            "description": "OCC option symbol, e.g. O:AAPL260116C00250000. Null on a stock lot.",
            "nullable": true
          },
          "expirationDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "strikePrice": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "contractType": {
            "type": "string",
            "description": "Call or Put. Null on a stock lot.",
            "nullable": true
          },
          "sharesPerContract": {
            "type": "integer",
            "description": "Shares of the underlying one contract controls — the P&L multiplier. Null on a\n            stock lot.",
            "format": "int32",
            "nullable": true
          },
          "quantity": {
            "type": "number",
            "description": "Signed: shares for a stock, contracts for an option; negative is short or\n            written.",
            "format": "double"
          },
          "costPerUnit": {
            "type": "number",
            "description": "Price per share the lot was opened at, always positive. For an option, the premium\n            per share of the underlying rather than per contract.",
            "format": "double"
          },
          "costBasis": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code the lot's prices and own figures are in: its listing's currency.",
            "nullable": true
          },
          "purchaseFxRate": {
            "type": "number",
            "description": "The broker exchange rate recorded with the lot: units of purchaseFxCurrency per 1\n            unit of currency. Null when none was recorded.",
            "format": "double",
            "nullable": true
          },
          "purchaseFxCurrency": {
            "type": "string",
            "nullable": true
          },
          "acquiredDate": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "closedDate": {
            "type": "string",
            "description": "Set on a closed lot; null while the lot is open.",
            "format": "date",
            "nullable": true
          },
          "closePricePerUnit": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "marketValue": {
            "type": "number",
            "description": "Null when this pass could not price the instrument — never a zero, which would read\n            as a total loss.",
            "format": "double",
            "nullable": true
          },
          "unrealizedGain": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "realizedGain": {
            "type": "number",
            "description": "Realized profit or loss on a closed lot; null while the lot is open.",
            "format": "double",
            "nullable": true
          },
          "convertedCostBasis": {
            "type": "number",
            "description": "The lot's figures in the portfolio's currency: cost at the purchase rate, value at\n            the current rate, and a closed lot's proceeds at the official rate on its closing date. Null\n            on a lot returned by a write, which carries no valuation.",
            "format": "double",
            "nullable": true
          },
          "convertedMarketValue": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "convertedUnrealizedGain": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "convertedRealizedGain": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "purchaseRate": {
            "$ref": "#/components/schemas/PortfolioFxRateDto"
          },
          "closeRate": {
            "$ref": "#/components/schemas/PortfolioFxRateDto"
          },
          "isOpen": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "PortfolioLotResponse": {
        "type": "object",
        "properties": {
          "portfolioId": {
            "type": "string",
            "format": "uuid"
          },
          "portfolioName": {
            "type": "string",
            "nullable": true
          },
          "deduplicated": {
            "type": "boolean",
            "description": "True when this request repeated an add that had already landed, so nothing was\n            created and the existing lot is returned. A client that retried a timed-out request reads\n            this instead of discovering a second holding. The response is 200 rather than 201."
          },
          "lot": {
            "$ref": "#/components/schemas/PortfolioLotDto"
          }
        },
        "additionalProperties": false
      },
      "PortfolioPositionDto": {
        "type": "object",
        "properties": {
          "instrumentKind": {
            "type": "string",
            "description": "Stock or Option.",
            "nullable": true
          },
          "ticker": {
            "type": "string",
            "nullable": true
          },
          "exchange": {
            "type": "string",
            "description": "The exchange's market identifier code (MIC, e.g. XPAR) for a listing outside the U.S.;\n            null for a U.S. listing. Together with ticker it names the listing, e.g. XPAR:AIR.",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "occTicker": {
            "type": "string",
            "description": "OCC option symbol. Null on a stock position.",
            "nullable": true
          },
          "expirationDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "strikePrice": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "contractType": {
            "type": "string",
            "description": "Call or Put. Null on a stock position.",
            "nullable": true
          },
          "sharesPerContract": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "quantity": {
            "type": "number",
            "description": "Signed total across the open lots; negative is a short position or a written\n            option.",
            "format": "double"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code of the listing's currency: cost, mark, value and gains are in it.\n            Null when the lots disagree, which leaves the position unvalued.",
            "nullable": true
          },
          "costBasis": {
            "type": "number",
            "format": "double"
          },
          "averageCostPerUnit": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "markPerUnit": {
            "type": "number",
            "description": "Price per share the position is marked at. Null when this pass could not price\n            it.",
            "format": "double",
            "nullable": true
          },
          "markSource": {
            "type": "string",
            "description": "Where the mark came from: LiveQuote, SettledClose or OptionDailyClose. Null when\n            there is no mark — read markUnavailableReason instead.",
            "nullable": true
          },
          "markAsOf": {
            "type": "string",
            "description": "The trading session the mark belongs to. Null when the source did not date it; for\n            an option snapshot that means the session is unknown, never today.",
            "format": "date",
            "nullable": true
          },
          "markUnavailableReason": {
            "type": "string",
            "description": "Why there is no mark, in one short phrase. Null when the position is priced.",
            "nullable": true
          },
          "marketValue": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "unrealizedGain": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "unrealizedGainPercent": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "expired": {
            "type": "boolean",
            "description": "True once an option contract's expiration has passed. An expired contract is never\n            marked: it was exercised or expired worthless, and only the owner knows which."
          },
          "convertedCostBasis": {
            "type": "number",
            "description": "Cost at each lot's purchase rate, in the portfolio's currency. Null when a lot has\n            no rate.",
            "format": "double",
            "nullable": true
          },
          "convertedMarketValue": {
            "type": "number",
            "description": "Market value at the current official rate, in the portfolio's currency.",
            "format": "double",
            "nullable": true
          },
          "convertedUnrealizedGain": {
            "type": "number",
            "description": "Gain in the portfolio's currency, including the exchange-rate move since\n            purchase.",
            "format": "double",
            "nullable": true
          },
          "convertedUnrealizedGainPercent": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "conversionUnavailableReason": {
            "type": "string",
            "description": "Why a converted figure is null, in one short phrase.",
            "nullable": true
          },
          "lots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PortfolioLotDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
