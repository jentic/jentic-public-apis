      },
      "LatestPriceDto": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "description": "The canonical exact listed ticker resolved from the request. Dot class-share\n            spelling is returned in its stored dash form (for example BRK.B becomes BRK-B).",
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "close": {
            "type": "number",
            "format": "double"
          },
          "adjustedClose": {
            "type": "number",
            "description": "The stored provider-adjusted close in US dollars. It can change when corporate\n            actions reconcile and is not certified as a consistent total-return series.",
            "format": "double"
          },
          "volume": {
            "type": "integer",
            "format": "int64"
          },
          "previousClose": {
            "type": "number",
            "description": "The comparable close of the trading session immediately before this row's — the\n            basis of change and changePercent. Null when the stored series skips that session or a\n            captured split separates it from this row; all three fields are absent rather than wrong.",
            "format": "double",
            "nullable": true
          },
          "change": {
            "type": "number",
            "description": "One-session price move (close − previousClose) in dollars. Absent when previousClose is.",
            "format": "double",
            "nullable": true
          },
          "changePercent": {
            "type": "number",
            "description": "One-session price move as a percent of previousClose. Absent when previousClose is.",
            "format": "double",
            "nullable": true
          },
          "high52Week": {
            "type": "number",
            "description": "Highest stored daily CLOSE in the comparable raw-close interval ending on this\n            row's date — never an intraday high, and not dividend-adjusted. The requested interval begins\n            365 days earlier, but can begin later at range52WeekStartDate after a captured split or when\n            stored history is shorter. A source quoting an intraday range can read higher and one quoting\n            a dividend-adjusted range can read lower, both without either being wrong.",
            "format": "double",
            "nullable": true
          },
          "low52Week": {
            "type": "number",
            "description": "Lowest stored daily CLOSE in the same comparable interval as high52Week — never an\n            intraday low, and not dividend-adjusted.",
            "format": "double",
            "nullable": true
          },
          "changeFrom52WeekHighPercent": {
            "type": "number",
            "description": "Percent distance of the close from the reported high (zero or negative, e.g. -12.3).",
            "format": "double",
            "nullable": true
          },
          "changeFrom52WeekLowPercent": {
            "type": "number",
            "description": "Percent distance of the close from the reported low (zero or positive, e.g. 45.6).",
            "format": "double",
            "nullable": true
          },
