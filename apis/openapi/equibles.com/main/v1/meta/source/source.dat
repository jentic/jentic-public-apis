    "/v1/stocks/{ticker}/quote": {
      "get": {
        "tags": [
          "Quotes"
        ],
        "summary": "Latest available consolidated SIP intraday quote for one active U.S. listing — a market reading, not a daily bar. Requires a paid plan: Pro receives real-time trade and bid/ask, Plus receives the same fields 15 minutes delayed, and Free receives 403 because it covers end-of-day data only. SessionDate and ExpectedSessionDate identify the market sessions involved; Stale is true when the last trade predates the expected session, so an old print is never silently presented as current. Use /v1/stocks/{ticker}/prices for stored traded daily history when available.",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Exact listed ticker (e.g. GOOG, GOOGL, BRK-A, or BRK-B). A missing listing is never replaced by its sibling; dot class-share spelling such as BRK.B is accepted as BRK-B.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveQuoteDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
