            "type": "string",
            "format": "date",
            "nullable": true
          },
          "brokerName": {
            "type": "string",
            "nullable": true
          },
          "sharesOutstanding": {
            "type": "integer",
            "description": "The issuer's current shares outstanding from the exchange record — the\n            denominator for the standard materiality read (sharesToBeSold ÷\n            sharesOutstanding). Deliberately NOT the notice's own figure, which filers\n            sometimes fill with their sale count. Because this is the current count while\n            sharesToBeSold is as filed, restate sharesToBeSold across any splits since the\n            filing date before dividing. Null when the issuer count is unknown.",
            "format": "int64",
            "nullable": true
          },
          "remarks": {
            "type": "string",
            "description": "The notice's remarks — typically the 10b5-1 trading-plan adoption date,\n            distinguishing planned from discretionary sales; null when blank.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProposedSaleDtoPagedResponse": {
