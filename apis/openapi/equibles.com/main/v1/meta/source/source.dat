            "nullable": true
          },
          "sponsor": {
            "type": "string",
            "description": "Registrant that files the series; null when no series is linked.",
            "nullable": true
          },
          "structure": {
            "type": "string",
            "description": "Registration form the series files under, in plain words.",
            "nullable": true
          },
          "secSeriesId": {
            "type": "string",
            "description": "SEC series identifier; empty when the filing states none.",
            "nullable": true
          },
          "price": {
            "type": "number",
            "description": "Latest settled close for the exact listed ticker.",
            "format": "double",
            "nullable": true
          },
          "priceDate": {
            "type": "string",
            "description": "Session the settled close belongs to.",
            "format": "date",
            "nullable": true
          },
          "priceIsIntraday": {
            "type": "boolean",
            "description": "Always false on this endpoint; use the quote endpoint for plan-entitled intraday data."
          },
          "dayChangePercent": {
            "type": "number",
            "description": "Percentage change against the prior settled close.",
            "format": "double",
            "nullable": true
          },
          "netAssets": {
            "type": "number",
            "description": "Net assets in US dollars from the latest report.",
            "format": "double",
            "nullable": true
          },
          "totalAssets": {
            "type": "number",
            "description": "Total assets in US dollars from the latest report.",
            "format": "double",
            "nullable": true
          },
          "holdingCount": {
            "type": "integer",
            "description": "Holding rows stored for the latest report.",
            "format": "int32",
            "nullable": true
          },
          "reportedHoldingCount": {
            "type": "integer",
            "description": "Investment-row count the filing itself reports, before the storage filter.",
            "format": "int32",
            "nullable": true
          },
          "holdingsCoverage": {
            "type": "string",
            "description": "One of \"fullPortfolio\", \"trackedEquitiesOnly\", or \"unknown\".",
            "nullable": true
          },
          "reportPeriodDate": {
            "type": "string",
            "description": "Date the reported portfolio is as of.",
            "format": "date",
            "nullable": true
          },
          "high52Week": {
            "type": "number",
            "description": "Highest settled close over the covered range.",
            "format": "double",
            "nullable": true
          },
          "low52Week": {
            "type": "number",
            "description": "Lowest settled close over the covered range.",
            "format": "double",
            "nullable": true
          },
          "range52WeekStartDate": {
            "type": "string",
            "description": "First comparable date of the range, which a split can shorten.",
            "format": "date",
            "nullable": true
          },
          "range52WeekIsPartial": {
            "type": "boolean",
            "description": "True when a split prevented a full trailing-year comparison."
          },
          "averageVolume30Day": {
            "type": "integer",
            "description": "Mean daily volume over the comparable sessions counted below.",
            "format": "int64",
            "nullable": true
          },
          "averageVolumeSessionCount": {
            "type": "integer",
            "description": "Number of settled sessions the average volume covers.",
            "format": "int32"
          },
          "topTenWeightPercent": {
            "type": "number",
            "description": "Combined weight of the ten largest positions; null unless coverage is complete.",
            "format": "double",
            "nullable": true
          },
          "priceHistoryStartDate": {
            "type": "string",
            "description": "First session of the bounded five-year series behind the chart.",
            "format": "date",
            "nullable": true
          },
          "performance": {
            "$ref": "#/components/schemas/EtfPerformanceDto"
          },
          "assetAllocations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EtfAllocationDto"
            },
            "description": "Asset-category breakdown; empty unless coverage is complete.",
            "nullable": true
          },
          "countryAllocations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EtfAllocationDto"
            },
            "description": "Country breakdown; empty unless coverage is complete.",
            "nullable": true
          },
          "topHoldings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EtfHoldingDto"
            },
            "description": "Ten largest stored positions, largest first.",
            "nullable": true
          },
          "coverageNote": {
            "type": "string",
            "description": "States each figure's source and what is deliberately not inferred.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Dedicated ETF profile: exact-ticker settled market figures alongside SEC fund facts from the\nlatest NPORT-P report. Concentration and allocation are returned only when stored and reported\nholding counts prove the portfolio is complete; expense ratio and benchmark are never inferred."
      },
