    "/v1/stocks/{ticker}/splits": {
      "get": {
        "tags": [
          "StockSplits"
        ],
        "summary": "Captured stock splits and reverse splits for an exact stock or ETF listing, newest effective date first. Each row says whether the stored daily price history has already been restated onto the post-split basis. Announced splits can appear before their effective date. A share class or fund series never inherits another listing's splits.",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Listed stock or ETF ticker (e.g. NVDA, BRK.B, SCHD).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Earliest effective date (yyyy-MM-dd).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "Latest effective date (yyyy-MM-dd).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows to return (1–500; default varies per endpoint).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip before the first returned row (default 0).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
