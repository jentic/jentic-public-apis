      },
      "TranscriptPhraseTrendCallDto": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "description": "Investor event id, for the per-event transcript and questions endpoints.",
            "format": "uuid"
          },
          "fiscalYear": {
            "type": "integer",
            "description": "The company's own fiscal year.",
            "format": "int32"
          },
          "fiscalQuarter": {
            "type": "integer",
            "description": "The fiscal quarter, 1-4.",
            "format": "int32"
          },
          "callDate": {
            "type": "string",
            "format": "date-time"
          },
          "callDateIsPeriodEnd": {
            "type": "boolean",
            "description": "True when callDate is the fiscal period end a seeded row carries, not a confirmed call date."
          },
          "missingQuartersBefore": {
            "type": "integer",
            "description": "Fiscal quarters with no earnings call on file between the previous returned call and this one; 0 for the oldest call.",
            "format": "int32"
          },
          "textSource": {
            "type": "string",
            "description": "speakerTurns (the spoken record), transcriptDocument (a call with no speaker turns, counted over its published document, which can include the document's own boilerplate), unsupportedLanguage when the transcript on file is mostly Chinese, Japanese or Korean script, which whole-word counting cannot read, or none when no transcript text is on file; with unsupportedLanguage or none the counts are null, never zero.",
            "nullable": true
          },
          "mentions": {
            "type": "integer",
            "description": "Whole-word, case-insensitive matches of the phrase; null when the call has no text.",
            "format": "int32",
            "nullable": true
          },
          "wordCount": {
            "type": "integer",
            "description": "Words in the text counted over; null when the call has no text.",
            "format": "int32",
            "nullable": true
          },
          "ratePer10kWords": {
            "type": "number",
            "description": "Mentions per 10,000 words, one decimal; null when the call has no text.",
            "format": "double",
            "nullable": true
          },
          "sectionSplit": {
            "type": "string",
            "description": "detected when the call states its hand-off to questions, so the two section counts are set; unknown otherwise, and both are null.",
            "nullable": true
          },
          "preparedRemarksMentions": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "qaMentions": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "quotes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptPhraseQuoteDto"
            },
            "description": "Up to two sentences around a mention, one from each section when both mention the phrase.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
