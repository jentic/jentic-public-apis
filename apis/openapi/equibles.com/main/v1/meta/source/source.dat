            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "reducedTotal": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "exitedTotal": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
