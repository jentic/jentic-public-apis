    "/v1/portfolios/{id}": {
      "get": {
        "tags": [
          "Portfolios"
        ],
        "summary": "One portfolio, priced. Open lots are rolled up into a position per instrument, each\n            marked from its own price lane and labelled with the trading session that mark belongs to; a\n            position that could not be priced carries nulls and a reason rather than a zero. Closed lots\n            are listed with their realized profit and loss, and instruments watched but not held come in\n            a separate `watching` array carrying marks only, outside every total. Totals are in the\n            portfolio's `currency`; each position and lot states its own currency, with its figures\n            converted at the official rates listed in `conversionRates`.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The portfolio's id, from your list or the shared list.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
