      "ShortInterestForecastResponse": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "nullable": true
          },
          "settlementDate": {
            "type": "string",
            "description": "The settlement date being estimated. FINRA has measured it; the official figure is not out yet.",
            "format": "date"
          },
          "publicationDate": {
            "type": "string",
            "description": "The date FINRA is expected to publish the official figure for that settlement, after which this forecast is withdrawn.",
            "format": "date"
          },
          "previousSettlementDate": {
            "type": "string",
            "description": "The last settlement with an official figure — the anchor this estimate grew from.",
            "format": "date"
          },
          "previousReportedPosition": {
            "type": "integer",
            "description": "The official position at `previousSettlementDate` (shares), restated onto today's split basis so it is directly comparable with the estimate.",
            "format": "int64"
          },
          "estimatedShortPosition": {
            "type": "integer",
            "description": "The estimated short position at `settlementDate` (shares), on the same split basis. A model output, not a reported figure.",
            "format": "int64"
          },
          "estimatedChangePercent": {
            "type": "number",
            "description": "The estimated change against `previousReportedPosition`, in percent.",
            "format": "double"
          },
          "likelyRangeLow": {
            "type": "integer",
            "description": "Low end of the model's own likely range (shares, same split basis) — its 10th percentile.",
            "format": "int64"
          },
          "likelyRangeHigh": {
            "type": "integer",
            "description": "High end of the model's own likely range (shares, same split basis) — its 90th percentile.",
            "format": "int64"
          },
          "confidence": {
            "type": "string",
            "description": "How firm the direction call is: `high`, `medium` or `low`, from how far\n`riseProbability` sits from the model's decision cut. Bands are cut at measured\nquantiles, not chosen. Measured on held-out models of the same configuration over 2025 to\nJuly 2026, the high band called the direction correctly about 72% of the time and the\nmedium-and-above band about 69%, against about 62% over all estimates.",
            "nullable": true
          },
          "riseProbability": {
            "type": "number",
            "description": "The model's own probability, 0 to 1, that the short position RISES at\n`settlementDate` against `previousReportedPosition`.\n            \nThis is a separate model output, not the sign of `estimatedChangePercent`, and\nthe two can disagree. Read direction from `expectsIncrease`, which applies the\nmodel's own decision cut; that cut is not 0.5, so comparing this value against 0.5 will\ngive the wrong answer near the boundary.",
            "format": "double"
          },
          "expectsIncrease": {
            "type": "boolean",
            "description": "Whether the model expects the position to rise, applying its own decision cut."
          },
          "asOfDate": {
            "type": "string",
            "description": "The last FINRA daily short-volume date the estimate reads. Its inputs stop here.",
            "format": "date"
          },
          "note": {
            "type": "string",
            "description": "Says in words what every field above is, so an answer built from this response cannot present it as a reported position.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "The model's estimate of a settlement FINRA has measured but not yet published."
      },
      "ShortInterestSnapshotDto": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "description": "Company name; null for ETF listings or when the security is not enriched yet.",
            "nullable": true
          },
          "shortPosition": {
            "type": "integer",
            "description": "Current short position, restated to today's split basis.",
            "format": "int64"
          },
          "changeInShortPosition": {
            "type": "integer",
            "description": "Change from the previous settlement, recomputed with both positions restated to today's split basis.",
            "format": "int64"
          },
          "averageDailyVolume": {
            "type": "integer",
            "description": "FINRA average daily share volume, restated to today's split basis.",
            "format": "int64",
            "nullable": true
          },
          "daysToCover": {
            "type": "number",
            "description": "Days to cover as reported. FINRA caps this value at 999.99 — a 999.99 reading is that cap sentinel (\"999.99 or more\", true value unknown, typically an illiquid name), not an exact figure; capped rows rank after real readings.",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
