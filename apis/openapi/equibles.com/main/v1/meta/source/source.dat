          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuidanceItemDto"
            },
            "nullable": true
          },
          "coverage": {
            "$ref": "#/components/schemas/GuidanceCoverageDto"
          }
        },
        "additionalProperties": false
      },
      "HolderActivityDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "cik": {
            "type": "string",
            "description": "SEC CIK of the institution — the identifier accepted by the v1/institutions/{cik}/* endpoints.",
            "nullable": true
          },
          "previousShares": {
            "type": "integer",
            "description": "Prior-quarter share count, restated onto today's split basis.",
            "format": "int64"
          },
          "currentShares": {
            "type": "integer",
            "description": "Target-quarter share count, restated onto today's split basis.",
            "format": "int64"
          },
          "deltaShares": {
            "type": "integer",
            "description": "Share-count change across the two quarters on today's split basis, so it reflects a real position change rather than a split.",
            "format": "int64"
          },
          "deltaValue": {
            "type": "integer",
            "description": "Change in published position value in dollars. Values normally use the report-date closing-price basis, may fall back to the filer's value, and can be zero when unavailable; the delta includes price movement, so a seller can still show a positive value change.",
            "format": "int64"
          },
          "isNewPosition": {
            "type": "boolean",
            "description": "True when the institution reported no position in the prior quarter (the delta is the full position)."
          },
          "isSoldOut": {
            "type": "boolean",
            "description": "True when the institution exited entirely this quarter (the delta is the negated prior position)."
          },
          "isFirst13F": {
            "type": "boolean",
            "description": "For new-position buyers only: true when the target quarter is the filer's first 13F on record. A first-time filer ranks only when it continues an earlier CIK (see continuesFrom). Null when the row is not a new position.",
            "nullable": true
          },
          "continuesFrom": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContinuedFilerDto"
            },
            "description": "The earlier filers this CIK alone continues, whose previous-quarter positions are included in previousShares (additive). Omitted for any other row.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "HolderFlowBucketDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "A stable token for the bucket, such as adv, idx or nonus; all for the total.",
            "nullable": true
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "filers": {
            "type": "integer",
            "format": "int32"
          },
          "comparedFilers": {
            "type": "integer",
            "description": "Filers with a 13F the quarter before, whose trades are counted.",
            "format": "int32"
          },
          "equityAum": {
            "type": "integer",
            "description": "Every filer's 13F common-share value this quarter, in dollars.",
            "format": "int64"
          },
          "priorEquityAum": {
            "type": "integer",
            "description": "The compared filers' 13F common-share value the quarter before, in dollars.",
            "format": "int64"
          },
          "boughtValue": {
            "type": "number",
            "description": "Dollars bought: share increases priced at the quarter's average close, else the quarter-end value per share.",
            "format": "double"
          },
          "soldValue": {
            "type": "number",
            "description": "Dollars sold, priced the same way; an exit at the quarter before's value per share.",
            "format": "double"
          },
          "netValue": {
            "type": "number",
            "format": "double"
          },
          "netPercentOfPriorBook": {
            "type": "number",
            "description": "Net flow as a percentage of priorEquityAum; null without a prior book.",
            "format": "double",
            "nullable": true
          },
          "netBuyers": {
            "type": "integer",
            "description": "Compared filers that bought more than they sold.",
            "format": "int32"
          },
          "netSellers": {
            "type": "integer",
            "description": "Compared filers that sold more than they bought.",
            "format": "int32"
          },
          "unpricedTrades": {
            "type": "integer",
            "description": "Trades with no price on either side, left out of the dollar values.",
            "format": "int32"
          },
          "sectors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HolderSectorFlowDto"
            },
            "description": "The flow per sector when groupBy=sector and the split is available; otherwise null.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "One bucket's money in and out of 13F common shares over the quarter. Only filers with a 13F the\nquarter before are compared; the rest are counted and add no flow."
      },
