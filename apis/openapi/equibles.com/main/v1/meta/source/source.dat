    "/v1/portfolios/{id}/lots": {
      "post": {
        "tags": [
          "Portfolios"
        ],
        "summary": "Records one purchase or sale as a lot. Pass `optionContract` with the OCC symbol to\n            record an option contract, or omit it for shares. `quantity` is signed — negative for a short\n            sale or a written option — and `costPerUnit` is always a positive price per share, because the\n            direction is carried by the sign of the quantity alone. Repeating an identical request within\n            a few minutes returns the lot already recorded with `deduplicated: true` and HTTP 200 instead\n            of adding a second holding, so a retried timeout is safe.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The portfolio to add to, from the portfolio list.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "The instrument, acquisition terms, and optional notes.",
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/AddPortfolioLotRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddPortfolioLotRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AddPortfolioLotRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AddPortfolioLotRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioLotResponse"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioLotResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
