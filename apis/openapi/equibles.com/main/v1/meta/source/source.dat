    "/v1/stocks/{ticker}/holder-mix": {
      "get": {
        "tags": [
          "Holdings"
        ],
        "summary": "A stock or ETF listing's 13F holders split by one dimension, quarter by quarter, oldest\nfirst: each bucket's common shares, value and filers, its like-for-like change (only filers\nwith an observed 13F in both quarters, each kept in its bucket of the later quarter on both\nsides), and new and exited filers. Every dimension's buckets sum to total. Holder type, client\nbase and private funds are each filer's current regulatory profile, never its name; style,\nturnover, horizon and book size are measured from each filer's 13F book in the newest\nmeasured quarter on or before the column. A company's primary listing reads its open quarter\nas the combined view; an ETF series or sibling class reads its exact listing as filed. Shares\nare restated to today's split basis; options are reported beside them and principal amounts\nare left out.",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Listed security ticker (e.g. AAPL or VOO).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dimension",
            "in": "query",
            "description": "How to split the holders: type (default), style, turnover, horizon, aum (13F book size), client (client base), pf (private funds) or country (filer location).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "periods",
            "in": "query",
            "description": "Quarters to return, newest last (default 4, max 12); each is compared with the quarter before.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 4
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HolderMixResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
