            "format": "double"
          },
          "estimatedSellFlowUsd": {
            "type": "number",
            "description": "Estimated sale dollars in the window (sum of disclosed-range midpoints).",
            "format": "double"
          },
          "estimatedNetFlowUsd": {
            "type": "number",
