    "/v1/indexes": {
      "get": {
        "tags": [
          "Indexes"
        ],
        "summary": "Every covered US stock index, with the state of the constituent list published for it. A list is published only once a tracking fund's filing reaches us whole, so constituentCount is 0 and asOfDate null while none is complete.",
