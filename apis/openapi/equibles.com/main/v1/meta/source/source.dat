      "FundDto": {
        "type": "object",
        "properties": {
          "seriesName": {
            "type": "string",
            "nullable": true
          },
          "registrantName": {
            "type": "string",
            "nullable": true
          },
          "profileId": {
            "type": "string",
            "description": "Stable profile id (slug) of the fund series in the fund directory. Also accepted\nin place of the ticker on /v1/funds/{ticker}/holdings and\n/v1/funds/{ticker}/operations — the way to reach series that have no ticker of\ntheir own.",
            "nullable": true
          },
          "ticker": {
            "type": "string",
            "description": "The directory's single ticker for the series; null when no unique ticker is stored.\nMultiple share-class tickers are not carried in this field.",
            "nullable": true
          },
          "fundType": {
            "type": "string",
            "description": "N-CEN registration type when on record, e.g. \"N-1A\" open-end/ETF, \"N-2\"\nclosed-end. Null for most sweep-discovered trust series — it is populated only\nwhen the fund is matched to an N-CEN filing.",
            "nullable": true
          },
          "netAssets": {
            "type": "number",
            "description": "Net assets in USD from the latest report header.",
            "format": "double"
          },
          "holdingCount": {
            "type": "integer",
            "description": "Stored holding rows on the latest report; some trust reports retain only tracked-stock positions.",
            "format": "int32"
          },
          "reportedHoldingCount": {
            "type": "integer",
            "description": "Full investment-row count reported in the latest NPORT-P filing before this\nplatform's storage filter. Null while an older filing awaits parser replay or\nwhen EDGAR could not be re-fetched.",
            "format": "int32",
            "nullable": true
          },
          "holdingsCoverage": {
            "type": "string",
            "description": "\"fullPortfolio\" when stored and reported counts agree, \"trackedEquitiesOnly\"\nwhen fewer rows are stored, or \"unknown\" when counts are missing or inconsistent.\nNetAssets is always the fund's reported total.",
            "nullable": true
          },
          "latestReportPeriodDate": {
            "type": "string",
            "description": "Reporting period of the series' latest NPORT-P report.",
            "format": "date"
          }
        },
        "additionalProperties": false,
        "description": "One registered-fund series from the NPORT-P fund directory."
      },
