            "description": "Rows held but not matched to a tracked company; listed under the fund's own name rather than dropped.",
            "format": "int32"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndexConstituentDto"
            },
            "nullable": true
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "additionalProperties": false,
        "description": "A page of constituents plus where the whole list came from."
      },
      "IndexForecastBucketDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "nullable": true
          },
          "note": {
            "type": "string",
            "description": "What this bucket means for this index, in the index's own terms.",
            "nullable": true
          },
          "count": {
            "type": "integer",
            "description": "Companies scored into this bucket in total.",
            "format": "int32"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndexForecastCandidateDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "One bucket of scored companies, with the count of everything scored into it."
      },
      "IndexForecastCandidateDto": {
        "type": "object",
        "properties": {
          "rank": {
            "type": "integer",
            "description": "Position within its bucket, by the index's own ranking measure.",
            "format": "int32"
          },
          "ticker": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "isLinked": {
            "type": "boolean"
          },
          "rankingValueUsd": {
            "type": "number",
            "description": "Size input: the index ranking value, except S&P 500 exits use total company value because\nthat is the probability model's size-pressure input.",
            "format": "double",
            "nullable": true
          },
          "probability": {
            "type": "number",
            "description": "Estimated chance over probabilityHorizonDays, as a fraction from zero to one.",
            "format": "double",
            "nullable": true
          },
          "isMigration": {
            "type": "boolean",
            "description": "True when the company leaves this index by joining a sibling one rather than dropping out."
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndexForecastRuleDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "One company scored against an index's published rules."
      },
      "IndexForecastResponse": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "kind": {
            "type": "string",
            "description": "\"Screen\" or \"Projection\". A Screen's index is decided by a committee. The S&P 500\nsupplements that eligibility screen with empirical probabilities; other S&P rows remain\nscreen results only. A Projection's index is decided by a published ranking.",
            "nullable": true
          },
          "headline": {
            "type": "string",
            "description": "One sentence saying what this forecast is, in the index's own terms.",
            "nullable": true
          },
          "asOfDate": {
            "type": "string",
            "description": "The trading day scored. Readers receive its highest immutable model revision.",
            "format": "date"
          },
          "methodologySource": {
            "type": "string",
            "description": "The methodology document the rules come from.",
            "nullable": true
          },
          "methodologyVersion": {
            "type": "string",
            "nullable": true
          },
          "probabilityHorizonDays": {
            "type": "integer",
            "description": "Probability horizon in days, null when rows are deterministic screen results.",
            "format": "int32",
            "nullable": true
          },
          "probabilityModelVersion": {
            "type": "string",
            "description": "Version of the probability calculation, null when probabilities are unavailable.",
            "nullable": true
          },
          "probabilitySource": {
            "type": "string",
            "description": "The empirical study used to calibrate probability event rates, or null.",
            "nullable": true
          },
          "probabilitySourceUrl": {
            "type": "string",
            "description": "Official URL for probabilitySource, or null.",
            "nullable": true
          },
          "exitCalibrationSource": {
            "type": "string",
            "description": "The observed-removal dataset used to shape exit risk, or null for older models.",
            "nullable": true
          },
          "exitCalibrationSourceUrl": {
            "type": "string",
            "description": "Public provenance for exitCalibrationSource, or null.",
            "nullable": true
          },
          "exitCalibrationMethod": {
            "type": "string",
            "description": "The cohorts, pooling, and within-cohort ordering used by the exit calibration.",
            "nullable": true
          },
          "scoredCount": {
            "type": "integer",
            "description": "Companies scored against this index's rules.",
            "format": "int32"
          },
          "unmeasuredMemberCount": {
            "type": "integer",
            "description": "Companies the index holds today that could not be measured against every entry rule. They\nstay out of deterministic departure buckets: a figure we cannot read is not evidence that a\ncompany is leaving an index. S&P 500 probability snapshots still assign the common exit\nbaseline. For a Projection the ranking was built without them, so an addition is only\npublished when its rank survives every one of them outranking it.",
            "format": "int32"
          },
          "candidatesLocked": {
            "type": "boolean",
            "description": "True when candidate identities and scorecards require the Plus plan or above."
          },
          "upgradeUrl": {
            "type": "string",
            "description": "Where a Free caller can compare plans when candidate identities are locked.",
            "nullable": true
          },
          "additions": {
            "$ref": "#/components/schemas/IndexForecastBucketDto"
          },
          "migrations": {
            "$ref": "#/components/schemas/IndexForecastBucketDto"
          },
          "departures": {
            "$ref": "#/components/schemas/IndexForecastBucketDto"
          },
          "notEvaluated": {
            "$ref": "#/components/schemas/IndexForecastBucketDto"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What this forecast cannot tell you, stated by the index's own methodology.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "An index's published entry rules applied to every company we track, for one day."
      },
      "IndexForecastRuleDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable rule identifier (\"sp-market-cap\", \"russell-float\").",
            "nullable": true
          },
          "label": {
            "type": "string",
            "nullable": true
          },
          "outcome": {
            "type": "string",
            "description": "\"Pass\", \"Fail\", \"NotEvaluated\" or \"NotApplied\". NotEvaluated is a fact about the COMPANY (a\nfigure we could not read, which blocks a verdict); NotApplied is a fact about US (a rule we\nrun for nobody, disclosed and excluded from the verdict).",
            "nullable": true
          },
          "requirement": {
            "type": "string",
            "description": "What the index's published methodology requires.",
            "nullable": true
          },
          "observed": {
            "type": "string",
            "description": "What we measured for this company.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "One published rule applied to one company, with the figure behind the outcome."
      },
      "IndexSummaryDto": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "description": "URL and query key for this index (\"sp-500\", \"nasdaq-100\").",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "provider": {
            "type": "string",
            "description": "The organisation that publishes the index (\"S&P Dow Jones Indices\").",
            "nullable": true
          },
          "forecastable": {
            "type": "boolean",
            "description": "Whether the index publishes quantitative entry rules we can apply. The Dow does not."
