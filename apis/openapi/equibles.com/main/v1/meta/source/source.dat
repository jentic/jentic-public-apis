            "type": "number",
            "description": "Start of the exchange in the call audio, in seconds; null unless the response is timed.",
            "format": "double",
            "nullable": true
          },
          "endSeconds": {
            "type": "number",
            "description": "End of the exchange in the call audio, in seconds; null unless the response is timed.",
            "format": "double",
            "nullable": true
          },
          "startTurnIndex": {
            "type": "integer",
            "description": "Zero-based index of the exchange's first turn (the operator's introduction when there\n            is one); pass it as the speakers endpoint's offset.",
            "format": "int32"
          },
          "endTurnIndex": {
            "type": "integer",
            "description": "Index one past the exchange's last turn (exclusive).",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CallQuestionsResponse": {
        "type": "object",
        "properties": {
          "eventId": {
