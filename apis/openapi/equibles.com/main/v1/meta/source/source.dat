    "/v1/indexes/{index}/forecast": {
      "get": {
        "tags": [
          "Indexes"
        ],
        "summary": "An index's own published entry rules applied to every company we track, with a rule-by-rule scorecard behind each company. The S&P 500 adds a versioned probability over probabilityHorizonDays for each eligible join candidate and every current member exit. kind is \"Screen\" for the S&P indexes, whose additions a committee decides, and \"Projection\" for the Russell indexes and Nasdaq-100, whose membership a published ranking decides. Each model revision is immutable; a model-version change may append a higher revision for the same trading day, and readers use the highest revision.",
        "parameters": [
          {
            "name": "index",
            "in": "path",
            "description": "Index slug or name. The Dow publishes no quantitative entry rule and returns 404.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexForecastResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request — a malformed parameter value or a query parameter this endpoint does not support.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stocks/{ticker}/insider-transactions": {
      "get": {
        "tags": [
          "InsiderTrading"
        ],
        "summary": "Insider transactions for a stock from SEC Forms 4/5, newest first. Form 3 establishes initial ownership rather than reporting transactions. transactionType is the coarse Buy/Sell/Award/Gift/Exercise label; transactionCode carries the filed SEC code's meaning (Conversion, Tax Payment, …) — non-market codes surface there, so check it before reading a row as an open-market trade.",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Stock ticker symbol (e.g. AAPL).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows to return (1–500; default varies per endpoint).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip before the first returned row (default 0).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Only include transactions on or after this date (yyyy-MM-dd).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
