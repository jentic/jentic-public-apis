    "/v1/organizations/{slug}": {
      "get": {
        "tags": [
          "Organizations"
        ],
        "summary": "One organization no market we cover lists: its kind, country, Legal Entity Identifier, parent chain and parts; the listed companies whose 10-K reports name it or one of its parts, each with the verbatim sentence, the source filing and any stated share; and, for a federal agency, the ten listed companies it awarded the most contract value over the last 12 months. A retired slug answers with the current one. Naming companies requires the Pro plan; other plans get the counts and the unnamed overview.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "The organization's slug (e.g. us-government), as a supply chain company's organization.slug or the search returns it.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum companies per side (default 50, max 500); a company and the parts listed under it are kept together.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationResponse"
                }
              }
            }
          },
          "400": {
