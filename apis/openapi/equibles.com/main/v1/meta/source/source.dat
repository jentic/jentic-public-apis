    "/v1/stocks/{ticker}/short-interest/forecast": {
      "get": {
        "tags": [
          "ShortData"
        ],
        "summary": "The model's estimate of the next short-interest settlement — the one FINRA has already measured but has not published yet. This is a PREDICTION, not a reported figure: never cite it as FINRA data. It carries a likely range (P10-P90) and a confidence band, and it is withdrawn as soon as the official figure for that settlement exists. Returns 404 when there is nothing to forecast, which is the normal state in the days after a release.",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Stock ticker symbol (e.g. AAPL). Class shares use a dash (BRK-B); the dot form (BRK.B) is also accepted.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
