    "/v1/portfolios/{id}/lots/{lotId}": {
      "patch": {
        "tags": [
          "Portfolios"
        ],
        "summary": "Corrects a lot that was entered wrong. Only the fields you send change. The\n            instrument itself cannot be edited — a lot on the wrong stock or contract is a different\n            holding, so delete it and add the right one. To record a sale, close the lot instead of\n            editing its quantity down; editing it away loses the realized profit.",
        "parameters": [
