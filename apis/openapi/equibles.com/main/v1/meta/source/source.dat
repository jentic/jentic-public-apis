    "/v1/stocks/{ticker}/short-interest": {
      "get": {
        "tags": [
          "ShortData"
        ],
        "summary": "Bi-monthly FINRA short interest for an exact stock or ETF listing, newest first. Share counts are restated onto today's split basis; days to cover is as reported except that FINRA's zero-volume 999.99 placeholder returns null (the ratio is undefined) — a returned 999.99 is a genuine reading meaning \"999.99 or more\" (FINRA's cap).",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Listed security ticker (e.g. AAPL or VOO). Class shares use a dash (BRK-B); the dot form (BRK.B) is also accepted.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "description": "Start settlement date (yyyy-MM-dd, defaults to 1 year ago).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "description": "End settlement date (yyyy-MM-dd, defaults to today).",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum rows to return (1–500; default varies per endpoint).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip before the first returned row (default 0).",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShortInterestDtoPagedResponse"
                }
              }
            }
          },
