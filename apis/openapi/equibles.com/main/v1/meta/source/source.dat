          },
          "totalShares": {
            "type": "integer",
            "description": "Legacy totalShares field: reported quantities across common-share, put/call notional-underlying and any tracked principal-denominated rows, restated onto today's split basis. This is aggregate 13F exposure, not pure share ownership.",
            "format": "int64"
          },
          "totalValue": {
            "type": "integer",
            "description": "Sum of published position values in dollars. Each value normally derives from reported shares × report-date close, may fall back to the filer's value, and can be zero when unavailable.",
            "format": "int64"
          },
          "changePercent": {
            "type": "number",
            "description": "Quarter-over-quarter change of totalShares in percent; null for the oldest returned period (nothing to compare against).",
            "format": "double",
            "nullable": true
          },
          "isCombinedQuarter": {
            "type": "boolean",
            "description": "True when this is the newest quarter presented as the combined view while its 13F filing window is still open."
          }
        },
