          },
          "distinctSellers": {
            "type": "integer",
            "description": "Distinct members with at least one disclosed sale in the window.",
            "format": "int32"
          },
          "buyTrades": {
            "type": "integer",
            "description": "Disclosed purchase transactions in the window.",
            "format": "int32"
          },
          "sellTrades": {
            "type": "integer",
            "description": "Disclosed sale transactions in the window.",
            "format": "int32"
          },
