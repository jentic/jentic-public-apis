    "/v1/stocks/{ticker}/supply-chain": {
      "get": {
        "tags": [
          "SupplyChain"
        ],
        "summary": "A company's customers, suppliers, competitors and partners named in annual 10-K reports: its own and those of other listed companies that name it, each with the verbatim sentence, the source filing, any revenue or receivables share the filing states and, for a revenue share, its dollar amount from the same filing's revenue. Competitors carry who names the rivalry. A missing company is not evidence of no relationship. Requires the Pro plan; other plans get the counts and the unnamed overview.",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Stock ticker (e.g. THO), or MIC:TICKER (e.g. XPAR:SU) for a listing outside the US.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "side",
            "in": "query",
            "description": "Only one side: customers, suppliers, competitors or partners (default: all four).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "quantifiedOnly",
            "in": "query",
            "description": "Only companies with a stated share (default false).",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "lens",
            "in": "query",
            "description": "Order within each side: stated (largest stated share first, the default), dependsOn (largest share of this company's revenue first) or dependents (largest share of the other company's own revenue first).",
            "schema": {
              "type": "string",
              "default": "stated"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum companies per side (default 50, max 500); in the stated order a company and the parts listed under it are kept together.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupplyChainResponse"
