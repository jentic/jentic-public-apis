            "format": "int32",
            "nullable": true
          },
          "scoredCount": {
            "type": "integer",
            "description": "Total stocks scored at the settlement date — the universe every score,\n            percentile and rank is relative to. Present on both the board and a single-ticker\n            lookup; unlike total, it does not move with your liquidity filters.",
            "format": "int32",
            "nullable": true
          },
          "total": {
            "type": "integer",
            "description": "Board responses only: total scored stocks clearing the liquidity floors — data is truncated whenever it holds fewer rows (additive, #7056).",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
