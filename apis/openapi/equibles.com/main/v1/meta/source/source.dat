    "/v1/quotes": {
      "get": {
        "tags": [
          "Quotes"
        ],
        "summary": "Latest available consolidated SIP intraday quotes for up to 25 active U.S. listings in one call. Requires a paid plan: Pro receives real-time trade and bid/ask, Plus receives the same fields 15 minutes delayed, and Free receives 403 because it covers end-of-day data only. Tickers with no reading are omitted rather than returned with a placeholder price, so compare the returned tickers against the ones you asked for.",
        "parameters": [
