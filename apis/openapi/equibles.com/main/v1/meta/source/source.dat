          },
          "positionType": {
            "type": "string",
            "description": "The security this line reports: \"Common\" = shares held outright, \"Principal\" = a principal-denominated security, and \"Put\" or \"Call\" = an option position reported at the notional value of underlying shares. A put is a bearish bet, not ownership. A filer holding both common and options in one name emits one row per security, so this is what tells them apart.",
            "nullable": true
          },
          "previousShares": {
            "type": "integer",
            "description": "Prior-quarter quantity (shares, option underlying shares, or principal dollars), restated onto today's split basis except for principal.",
            "format": "int64"
          },
          "currentShares": {
            "type": "integer",
            "description": "Target-quarter quantity (shares, option underlying shares, or principal dollars), restated onto today's split basis except for principal.",
            "format": "int64"
          },
          "deltaShares": {
            "type": "integer",
            "description": "Quantity change on today's split basis, so a split between the quarters does not surface as a phantom increase or reduction.",
            "format": "int64"
          },
          "deltaValue": {
            "type": "integer",
            "description": "Change in published position value in dollars. Values normally use the report-date closing-price basis, may fall back to the filer's value, and can be zero when unavailable; the delta includes price movement.",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "InstitutionActivityResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "cik": {
