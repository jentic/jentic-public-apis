      }
    },
    "/v1/stocks/{ticker}/supply-chain/overlap": {
      "get": {
        "tags": [
          "SupplyChain"
        ],
        "summary": "Which of a company's suppliers and customers also supply or buy from its listed competitors, as 10-K filings name them: every competitor that matched a listed company with how many it shares, and each supplier and customer with the competitors it also serves. With vs, the company against one competitor: both, only the company, only the competitor. A competitor whose own 10-K is not read yet (ownFilingRead false) can share companies only its own filing would name. Requires the Pro plan; other plans get the counts.",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "description": "Stock ticker (e.g. NVDA), or MIC:TICKER (e.g. XPAR:SU) for a listing outside the US.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "vs",
            "in": "query",
            "description": "One competitor's ticker, as the competitors list shows it (e.g. AMD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum companies per list (default 50, max 500).",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupplyChainOverlapResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/web-data-feeds": {
      "get": {
        "tags": [
          "WebDataFeeds"
        ],
