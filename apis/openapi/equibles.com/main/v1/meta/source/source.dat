            "nullable": true
          },
          "sharedBy": {
            "type": "string",
            "description": "Who shared it with your organization. Absent on your own portfolios.",
            "nullable": true
          },
          "asOfUtc": {
            "type": "string",
            "description": "When this valuation was computed, UTC.",
            "format": "date-time"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code every total below is stated in.",
            "nullable": true
          },
          "conversionRates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PortfolioFxRateDto"
            },
            "description": "The current official rate each position in another currency was converted at, dated\n            by its observation. Empty when every holding is already in `currency`.",
            "nullable": true
          },
          "costBasis": {
            "type": "number",
            "description": "Total paid across every open lot whose cost converts into `currency`, priced or\n            not.",
            "format": "double"
          },
          "marketValue": {
            "type": "number",
            "description": "Sum over the positions that could be priced. Null when none could.",
            "format": "double",
            "nullable": true
          },
          "unrealizedGain": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "unrealizedGainPercent": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "realizedGain": {
            "type": "number",
            "description": "Profit or loss already taken, across every closed lot.",
            "format": "double"
          },
          "unconvertedClosedLotCount": {
            "type": "integer",
            "description": "Closed lots left out of realizedGain because no rate converts them.",
            "format": "int32"
          },
          "unvaluedPositionCount": {
            "type": "integer",
            "description": "Open positions this pass could not price. Never silently excluded: a total computed\n            over part of a portfolio reads as the whole one unless the gap is stated.",
            "format": "int32"
          },
          "unconvertedPositionCount": {
            "type": "integer",
            "description": "Open positions left out of the totals because their cost or value could not be\n            converted into `currency`; each says why in conversionUnavailableReason.",
            "format": "int32"
          },
          "coverageNote": {
            "type": "string",
            "description": "Set when a bound stopped this pass from pricing everything, for example more\n            distinct option contracts than one valuation may fetch. Null when nothing was cut.",
            "nullable": true
          },
          "positions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PortfolioPositionDto"
            },
            "nullable": true
          },
          "watching": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PortfolioWatchDto"
            },
            "description": "Instruments watched but not held. They carry marks and nothing else, and are never\n            part of costBasis, marketValue or any gain figure. A watched instrument the account also\n            holds appears in positions only, carrying its watchId.",
            "nullable": true
          },
          "closedLots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PortfolioLotDto"
            },
            "description": "Closed lots, most recently closed first. They carry realized profit and loss and no\n            market value.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PortfolioWatchDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The watch entry's id — what DELETE /v1/portfolios/{id}/watches/{watchId} takes.",
            "format": "uuid"
          },
          "instrumentKind": {
            "type": "string",
            "description": "\"Stock\" or \"Option\".",
            "nullable": true
          },
          "ticker": {
            "type": "string",
            "description": "The listed ticker: the stock itself, or the option's underlying.",
            "nullable": true
          },
          "exchange": {
            "type": "string",
            "description": "The exchange's market identifier code (MIC, e.g. XPAR) for a listing outside the U.S.;\n            null for a U.S. listing. Together with ticker it names the listing, e.g. XPAR:AIR.",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "occTicker": {
            "type": "string",
            "description": "The OCC contract symbol; null on a stock row.",
            "nullable": true
          },
          "expirationDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "strikePrice": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "contractType": {
            "type": "string",
            "description": "\"Call\" or \"Put\"; null on a stock row.",
            "nullable": true
          },
          "sharesPerContract": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 code the mark is in: the listing's currency. Null when the listing states\n            none, and on a row returned by a write, which carries no mark.",
            "nullable": true
          },
          "markPerUnit": {
            "type": "number",
            "description": "Price per share of the underlying. Null when this pass could not price it.",
            "format": "double",
            "nullable": true
          },
          "markSource": {
            "type": "string",
            "description": "Where the mark came from; null when unpriced.",
            "nullable": true
          },
          "markAsOf": {
            "type": "string",
            "description": "The trading session the mark belongs to. Null when the source did not date it.",
            "format": "date",
            "nullable": true
          },
          "markUnavailableReason": {
            "type": "string",
            "description": "Why there is no mark, when markSource is null.",
            "nullable": true
          },
          "expired": {
            "type": "boolean",
            "description": "True once a watched contract's expiration has passed."
          }
        },
        "additionalProperties": false,
        "description": "An instrument on the portfolio's watchlist that the account does NOT hold. A watch row\n            carries a mark and nothing else — deliberately no quantity, cost or value fields, because there\n            is no position to value and a zero would read as a total loss. It is never part of the\n            portfolio's totals."
      },
      "PortfolioWatchResponse": {
        "type": "object",
        "properties": {
          "portfolioId": {
            "type": "string",
            "format": "uuid"
          },
          "portfolioName": {
            "type": "string",
            "nullable": true
          },
          "watch": {
            "$ref": "#/components/schemas/PortfolioWatchDto"
          }
        },
        "additionalProperties": false,
        "description": "The answer to watching an instrument: which portfolio it landed in and the watch row\n            itself. A write answers with identity only — the mark fields are filled by the priced GET."
      },
      "PriceBarDto": {
        "type": "object",
