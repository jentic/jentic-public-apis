            "format": "int32",
            "nullable": true
          },
          "fiscalQuarter": {
            "type": "integer",
            "description": "The fiscal quarter of an earnings call, 1-4; null for conferences and other events.",
            "format": "int32",
            "nullable": true
          },
          "totalTurnCount": {
            "type": "integer",
