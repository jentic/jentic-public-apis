      "ValuationMultiplesHistoryPointDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "nullable": true
          },
          "asOf": {
            "type": "string",
            "format": "date"
          },
          "close": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "peRatio": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "peBasis": {
            "type": "string",
            "description": "\"diluted-eps\" or \"common-shareholder-income\"; null when P/E is unavailable.",
            "nullable": true
          },
          "evToRevenue": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "evToEbit": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "evToEbitda": {
            "type": "number",
            "description": "EV over TTM EBITDA (EBIT plus the tagged depreciation-and-amortization\n            family), the same strict same-date EV as evToEbit.",
            "format": "double",
            "nullable": true
          },
          "priceToFfo": {
            "type": "number",
            "description": "REIT only: price over the company's own stated FFO, re-resolved\n            point-in-time from the approved SEC-filed reconciliation as it existed at this\n            sample date. A company-defined non-GAAP measure — see ffoBasis and the\n            response-level ffoLabel.",
            "format": "double",
            "nullable": true
          },
          "priceToAffo": {
            "type": "number",
            "description": "REIT only: price over the company's own stated AFFO, same\n            methodology as priceToFfo.",
            "format": "double",
            "nullable": true
          },
          "ffoBasis": {
            "type": "string",
            "description": "The aggregation basis that priced this sample's P/FFO — \"TTM\" (four\n            consecutive stated fiscal quarters) or \"FY2023\" (the stated full year). Can\n            differ between samples as the company's disclosures evolve.",
            "nullable": true
          },
          "affoBasis": {
            "type": "string",
            "description": "The aggregation basis behind this sample's P/AFFO (see ffoBasis).",
            "nullable": true
          },
          "evToAdjustedEbitda": {
            "type": "number",
            "description": "EV over the company's own stated Adjusted EBITDA, re-resolved\n            point-in-time from the approved SEC-filed reconciliation as it existed at this\n            sample date against the sample's same-date EV. Any filer with a verified\n            reconciliation — no SIC gate. A company-defined non-GAAP measure — see\n            adjustedEbitdaBasis and the response-level adjustedEbitdaLabel.",
            "format": "double",
            "nullable": true
          },
          "adjustedEbitdaBasis": {
            "type": "string",
            "description": "The aggregation basis behind this sample's evToAdjustedEbitda (see\n            ffoBasis).",
            "nullable": true
          },
          "evMissingReason": {
            "type": "string",
            "description": "Why enterprise value was not computable at this sample, when it was\n            not: NoCloseNearSampleDate, MissingShareCount, MissingSameDateDebt or\n            MissingSameDateCash. Null when EV computed.",
            "nullable": true
          },
          "peMissingReason": {
            "type": "string",
            "description": "Why P/E was not computable at this sample, when it was not:\n            NoCloseNearSampleDate, IncompleteTtmEps or NonPositiveTtmEps. Null when P/E\n            computed.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ValuationMultiplesHistoryResponse": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string",
            "nullable": true
          },
          "companyName": {
            "type": "string",
            "nullable": true
          },
          "omittedAnchorCount": {
            "type": "integer",
            "description": "Sampled quarters dropped because no ratio was computable at that\n            point in time or because the raw-close split basis was unprovable — non-zero\n            means the series is shorter than the advertised ~10 years by this many anchors.",
            "format": "int32"
          },
          "omittedForUnprovenSplitBasisCount": {
            "type": "integer",
            "description": "How many of the omitted anchors were dropped solely because they\n            predate the company's latest unresolved split, where the stored raw-close\n            basis cannot be proven against the current per-share basis; an exact-primary\n            reconciliation preserves the older anchors\n            (UnverifiedPriceSplitBasis). Always ≤ omittedAnchorCount.",
            "format": "int32"
          },
          "ffoLabel": {
            "type": "string",
            "description": "REIT only: the company's verbatim label for the FFO measure behind\n            priceToFfo (its own non-GAAP definition, from the newest priced sample).\n            Null when no sample carries P/FFO.",
            "nullable": true
          },
          "affoLabel": {
            "type": "string",
            "description": "REIT only: the company's verbatim label for the AFFO measure behind\n            priceToAffo. Null when no sample carries P/AFFO.",
            "nullable": true
          },
          "adjustedEbitdaLabel": {
            "type": "string",
            "description": "The company's verbatim label for the Adjusted EBITDA measure behind\n            evToAdjustedEbitda (its own non-GAAP definition, from the newest priced\n            sample). Any filer with a verified reconciliation — no SIC gate. Null when no\n            sample carries evToAdjustedEbitda.",
            "nullable": true
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValuationMultiplesHistoryPointDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
