            "format": "int32",
            "nullable": true
          },
          "holdingsCoverage": {
            "type": "string",
            "description": "What totalHoldings counts: \"fullPortfolio\" when stored and reported counts agree,\n\"trackedEquitiesOnly\" when fewer rows are stored, or\n\"unknown\" when counts are missing or inconsistent.",
            "nullable": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EtfHoldingDto"
            },
            "nullable": true
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "additionalProperties": false,
        "description": "Paged holdings of an ETF's most recent NPORT-P report, with the report header facts\nalongside the standard paged envelope. Matches the shape of the registered-fund\nholdings endpoint so a caller can read either with one parser."
      },
      "EtfPerformanceDto": {
        "type": "object",
        "properties": {
          "oneWeekPercent": {
            "type": "number",
