{
  "openapi": "3.0.3",
  "info": {
    "title": "brainergy",
    "description": "REST API for data exchange between Multiserver and brainergy",
    "version": "0.2.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/RENESTEINERAT1/brainergy/0.2.0"
  },
  "servers": [
    {
      "url": "https://schulung.mserver.io/brainergy/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Check the health of the service",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Service is running",
            "content": {
              "application/json": {
                "example": {
                  "status": "running"
                }
              }
            }
          },
          "503": {
            "description": "Service is unavailable",
            "content": {
              "application/json": {
                "example": {
                  "status": "unavailable"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/parameters/{systemId}": {
      "get": {
        "summary": "Retrieve model parameters for a specific energy system",
        "tags": [
          "Optimization"
        ],
        "parameters": [
          {
            "name": "systemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the system for which parameters will be retrieved"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of key-value pairs representing system parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParameterSet"
                },
                "example": [
                  {
                    "key": "electricStorage-1.ParameterX",
                    "value": 300
                  },
                  {
                    "key": "electricStorage-1.ParameterY",
                    "value": 1400
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Invalid system ID provided"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/pullTimeseries/{systemId}": {
      "post": {
        "summary": "Retrieve aggregated time series data for a specific energy system",
        "tags": [
          "TimeSeries"
        ],
        "parameters": [
          {
            "name": "systemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the system for which time series data will be retrieved"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "periodStart": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Start of the period for time series retrieval"
                  },
                  "periodEnd": {
                    "type": "string",
                    "format": "date-time",
                    "description": "End of the period for time series retrieval"
                  },
                  "periodInterval": {
                    "type": "string",
                    "description": "Interval for the requested time series data"
                  },
                  "timeSeries": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/TimeSeriesSelection"
                    }
                  }
                },
                "required": [
                  "periodStart",
                  "periodEnd",
                  "periodInterval",
                  "timeSeries"
                ]
              },
              "example": {
                "periodStart": "2024-10-22T14:00:00Z",
                "periodEnd": "2024-10-22T14:03:00Z",
                "periodInterval": "1h",
                "timeSeries": [
                  {
                    "group": "measurement",
                    "name": "electricPowerGrid-1.electricPowerMinus-1",
                    "live": false
                  },
                  {
                    "group": "schedule",
                    "name": "electricPowerGrid-1.electricPowerMinus-1",
                    "live": false
                  },
                  {
                    "group": "forecast",
                    "name": "electricDemand-1.electricPowerMinus-1",
                    "live": false
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Time series data successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeSeriesDataSet"
                },
                "example": {
                  "timeSeries": [
                    {
                      "group": "measurement",
                      "name": "electricPowerGrid-1.electricPowerMinus-1",
                      "data": {
                        "2024-10-22T14:00:00Z": 150.38498,
                        "2024-10-22T14:01:00Z": 145.97528,
                        "2024-10-22T14:02:00Z": 138.98536
                      },
                      "live": false
                    },
                    {
                      "group": "schedule",
                      "name": "electricPowerGrid-1.electricPowerMinus-1",
                      "data": {
                        "2024-10-22T14:00:00Z": 150,
                        "2024-10-22T14:01:00Z": 145,
                        "2024-10-22T14:02:00Z": 140
                      },
                      "live": false
                    },
                    {
                      "group": "forecast",
                      "name": "electricDemand-1.electricPowerMinus-1",
                      "data": {
                        "2024-10-22T14:00:00Z": 40.9,
                        "2024-10-22T14:01:00Z": 39.05,
                        "2024-10-22T14:02:00Z": 37.7
                      },
                      "live": false
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input provided",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Details about the error"
                    }
                  },
                  "required": [
                    "message"
                  ]
                },
                "example": {
                  "message": "Invalid time series selection provided."
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/pushTimeseries/{systemId}": {
      "post": {
        "summary": "Submit time series data for a specific energy system",
        "tags": [
          "TimeSeries"
        ],
        "parameters": [
          {
            "name": "systemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the system for which time series data will be submitted"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TimeSeriesDataSet"
              },
              "example": {
                "timeSeries": [
                  {
                    "group": "measurement",
                    "name": "electricPowerGrid-1.electricPowerMinus-1",
                    "data": {
                      "2024-10-22T14:00:00Z": 151.37,
                      "2024-10-22T14:01:00Z": 144.97,
                      "2024-10-22T14:02:00Z": 0
                    },
                    "live": false
                  },
                  {
                    "group": "measurement",
                    "name": "electricPowerGrid-1.electricPowerPlus-1",
                    "data": {
                      "2024-10-22T14:00:00Z": 0,
                      "2024-10-22T14:01:00Z": 0,
                      "2024-10-22T14:02:00Z": 40.98
                    },
                    "live": false
                  },
                  {
                    "group": "schedule",
                    "name": "electricPowerGrid-1.electricPowerMinus-1",
                    "data": {
                      "2024-10-22T14:00:00Z": 150.38498,
                      "2024-10-22T14:01:00Z": 145.97528,
                      "2024-10-22T14:02:00Z": 0
                    },
                    "live": false
                  },
                  {
                    "group": "schedule",
                    "name": "electricPowerGrid-1.electricPowerPlus-1",
                    "data": {
                      "2024-10-22T14:00:00Z": 0,
                      "2024-10-22T14:01:00Z": 0,
                      "2024-10-22T14:02:00Z": 38.98536
                    },
                    "live": false
                  },
                  {
                    "group": "forecast",
                    "name": "electricDemand-1.electricPowerMinus-1",
                    "data": {
                      "2024-10-22T14:00:00Z": 40.9854,
                      "2024-10-22T14:01:00Z": 39.0245,
                      "2024-10-22T14:02:00Z": 37.7354
                    },
                    "live": false
                  },
                  {
                    "group": "forecast",
                    "name": "pv-1.electricPowerPlus-1",
                    "data": {
                      "2024-10-22T14:00:00Z": 7.89725,
                      "2024-10-22T14:01:00Z": 2.71274,
                      "2024-10-22T14:02:00Z": 3.79555
                    },
                    "live": false
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Time series data successfully submitted"
          },
          "400": {
            "description": "Invalid input provided",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Details about the error"
                    }
                  },
                  "required": [
                    "message"
                  ]
                },
                "example": {
                  "message": "Invalid time series data provided."
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/pushAnomalies/{systemId}": {
      "post": {
        "summary": "Submit anomalies for a specific energy system",
        "tags": [
          "Anomalies"
        ],
        "parameters": [
          {
            "name": "systemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the system for which time series data will be submitted"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnomaliesDataSet"
              },
              "example": {
                "anomalies": [
                  {
                    "name": "electricPowerGrid-1.electricPowerMinus-1",
                    "begin": "2025-10-22T14:00:00Z",
                    "end": "2025-10-22T14:01:00Z",
                    "percent": 50
                  },
                  {
                    "name": "electricPowerGrid-1.electricPowerMinus-2",
                    "begin": "2025-10-22T14:00:00Z",
                    "end": "2025-10-22T14:01:00Z",
                    "percent": 70
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Anomalies successfully submitted"
          },
          "400": {
            "description": "Invalid input provided",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Details about the error"
                    }
                  },
                  "required": [
                    "message"
                  ]
                },
                "example": {
                  "message": "Invalid anomalies provided."
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SchedulesSelection": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "ParameterSet": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "key",
            "value"
          ]
        }
      },
      "TimeSeriesDataSet": {
        "type": "object",
        "properties": {
          "timeSeries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "group": {
                  "type": "string",
                  "enum": [
                    "measurement",
                    "schedule",
                    "forecast",
                    "price"
                  ],
                  "description": "The name of the group associated with the time series data"
                },
                "name": {
                  "type": "string",
                  "description": "The name of the time series"
                },
                "data": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "format": "double"
                  },
                  "description": "The time series data points, where keys are timestamps and values are numeric values"
                },
                "live": {
                  "type": "boolean",
                  "description": "Indicates if the time series data is live (default: false)"
                }
              },
              "required": [
                "group",
                "name",
                "data",
                "live"
              ]
            }
          }
        },
        "required": [
          "timeSeries"
        ]
      },
      "AnomaliesDataSet": {
        "type": "object",
        "properties": {
          "anomalies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the time series"
                },
                "begin": {
                  "type": "string",
                  "format": "date-time",
                  "description": "The begin timestamp of the anomalie"
                },
                "end": {
                  "type": "string",
                  "format": "date-time",
                  "description": "The end timestamp of the anomalie"
                },
                "percent": {
                  "type": "number",
                  "format": "double",
                  "description": "The percentage of the anomalie"
                }
              },
              "required": [
                "name",
                "begin",
                "end",
                "percent"
              ]
            }
          }
        },
        "required": [
          "anomalies"
        ]
      },
      "TimeSeriesSelection": {
        "type": "object",
        "properties": {
          "timeSeries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "group": {
                  "type": "string",
                  "enum": [
                    "measurement",
                    "schedule",
                    "forecast",
                    "derivedSchedule",
                    "price"
                  ],
                  "description": "The name of the group associated with the time series data"
                },
                "name": {
                  "type": "string",
                  "description": "The name of the time series"
                },
                "live": {
                  "type": "boolean",
                  "description": "Indicates if the time series data is live (default: false)"
                }
              },
              "required": [
                "group",
                "name",
                "live"
              ]
            }
          }
        },
        "required": [
          "timeSeries"
        ]
      }
    },
    "responses": {},
    "parameters": {},
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "tags": [
    {
      "name": "TimeSeries",
      "description": "Endpoints related to time series data."
    },
    {
      "name": "Optimization",
      "description": "Endpoints related to optimization tasks."
    },
    {
      "name": "System",
      "description": "Endpoints related to system management."
    }
  ]
}
