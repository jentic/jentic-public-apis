{
  "openapi": "3.0.0",
  "servers": [
    {
      "description": "Client API",
      "url": "https://api.zap-map.io/"
    }
  ],
  "info": {
    "title": "Client API, Search Pillar",
    "version": "1.9",
    "license": {
      "name": "Copyright (C) Zapmap Ltd - All Rights Reserved."
    },
    "description": "<p>All endpoints are secured via an OAuth token; refer to the Client API Auth Swagger for details on how to generate this token.</p>\n\n<hr />\n\n<p>Versioning is achieved via the URL, and is in the format of <code>major.minor</code>. Specifying only the <code>major</code> will allow for you to automatically update to the latest non-breaking change as-and-when released, and is strongly recommended. To remain on an exact version, update the URL, e.g., <code>/locations/v1.2/filters</code>.</p>\n<hr /><br />\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/mgsoftwareltd/client-api-search-pillar/1.9"
  },
  "tags": [
    {
      "name": "Search"
    }
  ],
  "paths": {
    "/locations/v1/filters": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Retrieve possible values for Bounding Box filters.",
        "description": "Lists the filters that are considered \"dynamic\" and might regularly change.",
        "security": [
          {
            "OAuth": []
          }
        ],
        "responses": {
          "400": {
            "description": "Bad input parameter(s)."
          },
          "200": {
            "description": "<p>A multi-dimensional array of the \"dynamic\" filters that the Bounding Box endpoint can accept.</p>\n\n<p>Some filters, such as <code>CATEGORIES</code>, have children to allow a more fine-tuned search.</p>\n\n<p>The <code>CATEGORIES</code> follows the hierarchy of primary > secondary > tertiary. For example, Accommodation > Hotel > Hilton, or Fuel Forecourt > Shell.</p>\n",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "The length of time, in seconds, that you are permitted to cache the response."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "example": {
                        "CONNECTOR_TYPE": [
                          {
                            "name": "Combo Type 2",
                            "value": "IEC_62196_T2_COMBO"
                          },
                          {
                            "name": "CHAdeMO",
                            "value": "CHADEMO"
                          },
                          {
                            "name": "Mennekes Type 2",
                            "value": "IEC_62196_T2"
                          }
                        ],
                        "CATEGORIES": [
                          {
                            "name": "Fuel Forecourt",
                            "value": "FUEL_FORECOURT",
                            "children": [
                              {
                                "name": "Train Station",
                                "id": "TRAIN_STATION"
                              },
                              {
                                "name": "Airport",
                                "id": "AIRPORT"
                              }
                            ]
                          },
                          {
                            "name": "Accommodation",
                            "value": "ACCOMMODATION",
                            "children": [
                              {
                                "name": "Hotel",
                                "value": "HOTEL",
                                "children": [
                                  {
                                    "name": "Mariott",
                                    "value": "MARRIOTT"
                                  },
                                  {
                                    "name": "Hilton",
                                    "value": "HILTON"
                                  }
                                ]
                              }
                            ]
                          }
                        ],
                        "NETWORK": [
                          {
                            "name": "Alfa Power",
                            "value": "34"
                          },
                          {
                            "name": "Allego",
                            "value": "56"
                          },
                          {
                            "name": "bp pulse",
                            "value": "12"
                          },
                          {
                            "name": "char.gy",
                            "value": "117"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/locations/v1/search/bounding-box": {
      "get": {
        "tags": [
          "Search"
        ],
        "operationId": "Bounding_Box",
        "summary": "Retrieve a list of Locations in a defined lat/lon that match chosen filters.",
        "description": "<p>By passing in the appropriate options, you can perform a search for relevant locations.</p>\n\n<p>The response is the minimum required to place a marker onto a map.</p>\n\n<p>This is a heavily cached boundary box search.</p>\n",
        "security": [
          {
            "OAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "latitude",
            "description": "<p>The West-to-East position of the \"bounding box\".</p>\n\n<p>This MUST have the same number of decimal points (max 3) as the <code>longitude</code> otherwise the API will return an HTTP 400.</p>\n\n<p>For each bounding box request the <strong>bottom left</strong> co-ordinate. For example, assuming a user location of <code>51.4533142, -2.581124</code> and you wanted to display a 100km<sup>2</sup> bounding box then you would <code>floor</code> the co-ordinate to 2 decimal places. For instance:</p>\n\n<table>\n  <tr>\n    <th>Passed into Client API</th>\n    <th>Client API searches for</th>\n    <th>Description</th>\n  </tr>\n  <tr>\n    <td>\n      <code>51.450, -2.590</code><br />\n      <small>Floor to 3 decimal place numbers.</small>\n    </td>\n    <td>\n      <code>51.459999, -2.580001</code>,<br />\n      <code>51.450000, -2.590000</code>\n    </td>\n    <td>\n      Street level\n    </td>\n  </tr>\n  <tr>\n    <td>\n      <code>51.40, -2.60</code><br />\n      <small>Floor to 2 decimal place numbers.</small>\n    </td>\n    <td>\n      <code>51.499999, -2.500001</code>,<br />\n      <code>51.400000, -2.600000</code>\n    </td>\n    <td>\n      Town level\n    </td>\n  </tr>\n  <tr>\n    <td>\n      <code>51.0, -3.0</code><br />\n      <small>Floor to 1 decimal place number.</small>\n    </td>\n    <td>\n      <code>51.999999, -2.000001</code>,<br />\n      <code>51.000000, -3.000000</code>\n    </td>\n    <td>\n      Region level\n    </td>\n  </tr>\n  <tr>\n    <td>\n      <code>50, -10</code><br />\n      <small>Floor to decimal number.</small>\n    </td>\n    <td>\n      <code>59.999999, -0.000001</code>,<br />\n      <code>50.000000, -10.000000</code>\n    </td>\n    <td>\n      Country level\n    </td>\n  </tr>\n</table>\n",
            "required": true,
            "schema": {
              "type": "number",
              "format": "float",
              "minimum": -90,
              "maximum": 90,
              "example": "51.450"
            }
          },
          {
            "in": "query",
            "name": "longitude",
            "description": "<p>The North-to-South position of the \"bounding box\".</p>\n\n<p>This MUST have the same number of decimal points (max 3) as the <code>latitude</code> otherwise the API will return an HTTP 400.</p>\n",
            "required": true,
            "schema": {
              "type": "number",
              "format": "float",
              "minimum": -180,
              "maximum": 180,
              "example": "-2.585"
            }
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "in": "query",
            "name": "connector_type",
            "description": "<p>Array of connector types to search for.</p>\n\n<p>Passing in no Connector Types will not place any restrictions on the returned results. When values are passed in, only Locations which contain those Connector Types shall be returned.</p>\n\n<p>Possible values are passed in from the [filters] endpoint.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "string",
                "enum": [
                  "CHADEMO",
                  "DOMESTIC_G",
                  "IEC_60309_2_single_16",
                  "IEC_60309_2_three_64",
                  "IEC_62196_T1",
                  "IEC_62196_T2",
                  "IEC_62196_T2_COMBO"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "connector_power",
            "description": "<p>Array of two values, a minimum and maximum watts.</p>\n\n<p>Passing in no Power values will not place any restrictions on the returned results. When values are passed in, only Locations which contain those Powers shall be returned.</p>\n\n<p>Can provide any range of numbers, but for best results we recommend the values below.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32",
                "enum": [
                  3000,
                  7000,
                  11000,
                  22000,
                  50000,
                  100000,
                  350000
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "price_min",
            "description": "<p>Positive float</p>\n\n<p>Passing in no minimum price will not place any restrictions on the returned results. When a value is passed in, only Locations with one or more connectors with a price per/kWh greater than the given value will be returned.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "number",
              "format": "currency"
            }
          },
          {
            "in": "query",
            "name": "price_max",
            "description": "<p>Positive float</p>\n\n<p>Passing in no maximum price will not place any restrictions on the returned results. When a value is passed in, only Locations with one or more connectors with a price per/kWh less than the given value will be returned.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "number",
              "format": "currency"
            }
          },
          {
            "in": "query",
            "name": "currency_code",
            "description": "<p>ISO-4217 currency code</p>\n\n<p>Passing in no currency code will not place any restrictions on the returned results. When a value is passed in, only Locations where payment is taken in the given currency will be returned.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "string",
              "maxLength": 3,
              "minLength": 3
            }
          },
          {
            "in": "query",
            "name": "access",
            "description": "<p>Array of access requirements to search for.</p>\n\n<p>Passing in no Access Restrictions will not place any restrictions on the returned results. When values are passed in, only Locations which contain those Access Restrictions shall be returned.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "string",
                "enum": [
                  "AVAILABLE_24_HOURS",
                  "PUBLICLY_ACCESSIBLE",
                  "NO_PHYSICAL_RESTRICTIONS",
                  "HIDE_HOME_LOCATIONS",
                  "HIDE_WORK_LOCATIONS",
                  "SHOW_TAXI_LOCATIONS"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "category",
            "description": "<p>Possible values are defined in the [filters] endpoint.</p>\n\n<p>Passing in no Location Categories will not place any restrictions on the returned results. When values are passed in, only Locations which contain those Categories shall be returned.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "string",
                "enum": [
                  "ACCOMMODATION",
                  "HOTEL",
                  "HILTON"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "network",
            "description": "<p>Possible values are defined in the [filters] endpoint.</p>\n\n<p>Passing in no Networks will not place any restrictions on the returned results. When values are passed in, only Locations which contain those Networks shall be returned.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "string",
                "enum": [
                  "34",
                  "56",
                  "12",
                  "117"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "payment_method",
            "description": "<p>Array of payment methods to apply.</p>\n\n<p>Passing in no Payment Methods will not place any restrictions on the returned results. When values are passed in, only Locations which contain those Payment Methods shall be returned.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "string",
                "enum": [
                  "FREE",
                  "CONTACTLESS",
                  "ZAP_PAY",
                  "ALLSTAR_ZAP_PAY",
                  "ALLSTAR_RFID"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "user_rating",
            "description": "<p>Single value for a User Rating to search for.</p>\n\n<p>The User Rating is Zap-Map's internal Location rating. It is based upon many variables, such as reliability, popularity, and Zap-Pay Session user rating.</p>\n\n<p>Passing in no User Rating will not place any restrictions on the returned results. When values are passed in, only Locations which are at or above the User Rating shall be returned.</p>\n",
            "schema": {
              "type": "integer",
              "format": "int32",
              "enum": [
                2,
                3,
                4
              ]
            }
          },
          {
            "in": "query",
            "name": "min_devices",
            "description": "<p>How many Devices a Location needs to have before it is returned.</p>\n\n<p>Passing in no Minimum Devices will not place any restrictions on the returned results. When a value is passed in, only Locations which are at or above the number of Devices shall be returned.</p>\n",
            "schema": {
              "type": "integer",
              "format": "int32",
              "enum": [
                2,
                3,
                4,
                5,
                6
              ]
            }
          },
          {
            "in": "query",
            "name": "latest",
            "description": "<p>Only return Locations that have been added in the past 30 days.</p>\n\n<p>Passing in no Latest parameter will not place any restrictions on the returned results. When a value is passed in, only Locations that have been added in the past 30 days shall be returned.</p>\n",
            "schema": {
              "type": "boolean",
              "enum": [
                true
              ]
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad input parameter(s)."
          },
          "200": {
            "description": "<p>Search results matching criteria.</p>\n\n<p>The <code>power</code> will be a distinct list of the Connector speeds.</p>\n\n<p>Possible <code>category</code> values are:</p>\n\n<table>\n  <tr>\n    <th>Key</th>\n    <th>Value</th>\n  </tr>\n  <tr>\n    <td><code>PUBLIC</code></td>\n    <td>Publicly accessible Location.</td>\n  </tr>\n  <tr>\n    <td><code>HOME</code></td>\n    <td>A Location at someones personal house.</td>\n  </tr>\n  <tr>\n    <td><code>WORK</code></td>\n    <td>A Location at a place of work.</td>\n  </tr>\n</table>\n",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "The length of time, in seconds, that you are permitted to cache the response."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "uuid": {
                            "type": "string",
                            "example": "l0c4t10n123"
                          },
                          "coordinates": {
                            "type": "object",
                            "properties": {
                              "latitude": {
                                "type": "integer",
                                "format": "int32",
                                "example": 51.4532876
                              },
                              "longitude": {
                                "type": "integer",
                                "format": "int32",
                                "example": -2.6909715
                              }
                            }
                          },
                          "power": {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            },
                            "example": [
                              100000,
                              150000,
                              350000
                            ]
                          },
                          "category": {
                            "type": "string",
                            "enum": [
                              "PUBLIC",
                              "WORK",
                              "HOME"
                            ]
                          },
                          "created_at": {
                            "type": "string",
                            "default": "2022-12-25T10:11:12Z"
                          }
                        }
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/locations/v1/search/linestring": {
      "post": {
        "tags": [
          "Search"
        ],
        "operationId": "Linestring",
        "summary": "Retrieve a list of usable Locations within a radius of a linestring that match chosen filters.",
        "description": "<p>By passing in the appropriate options, you can perform a search for relevant locations.</p>\n<p>The response is the minimum required to place a marker onto a map.</p>\n",
        "security": [
          {
            "OAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "connector_type",
            "description": "<p>Array of connector types to search for.</p>\n\n<p>Passing in no Connector Types will not place any restrictions on the returned results. When values are passed in, only Locations which contain those Connector Types shall be returned.</p>\n\n<p>Possible values are passed in from the [filters] endpoint.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "string",
                "enum": [
                  "CHADEMO",
                  "DOMESTIC_G",
                  "IEC_60309_2_single_16",
                  "IEC_60309_2_three_64",
                  "IEC_62196_T1",
                  "IEC_62196_T2",
                  "IEC_62196_T2_COMBO"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "connector_power",
            "description": "<p>Array of two values, a minimum and maximum watts.</p>\n\n<p>Passing in no Power values will not place any restrictions on the returned results. When values are passed in, only Locations which contain those Powers shall be returned.</p>\n\n<p>Can provide any range of numbers, but for best results we recommend the values below.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32",
                "enum": [
                  3000,
                  7000,
                  11000,
                  22000,
                  50000,
                  100000,
                  350000
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "access",
            "description": "<p>Array of access requirements to search for.</p>\n\n<p>Passing in no Access Restrictions will not place any restrictions on the returned results. When values are passed in, only Locations which contain those Access Restrictions shall be returned.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "string",
                "enum": [
                  "AVAILABLE_24_HOURS",
                  "PUBLICLY_ACCESSIBLE",
                  "NO_PHYSICAL_RESTRICTIONS",
                  "HIDE_HOME_LOCATIONS",
                  "HIDE_WORK_LOCATIONS",
                  "SHOW_TAXI_LOCATIONS"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "category",
            "description": "<p>Possible values are defined in the [filters] endpoint.</p>\n\n<p>Passing in no Location Categories will not place any restrictions on the returned results. When values are passed in, only Locations which contain those Categories shall be returned.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "string",
                "enum": [
                  "ACCOMMODATION",
                  "HOTEL",
                  "HILTON"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "network",
            "description": "<p>Possible values are defined in the [filters] endpoint.</p>\n\n<p>Passing in no Networks will not place any restrictions on the returned results. When values are passed in, only Locations which contain those Networks shall be returned.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "string",
                "enum": [
                  "34",
                  "56",
                  "12",
                  "117"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "payment_method",
            "description": "<p>Array of payment methods to apply.</p>\n\n<p>Passing in no Payment Methods will not place any restrictions on the returned results. When values are passed in, only Locations which contain those Payment Methods shall be returned.</p>\n",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "string",
                "enum": [
                  "FREE",
                  "CONTACTLESS",
                  "ZAP_PAY",
                  "ALLSTAR_ZAP_PAY",
                  "ALLSTAR_RFID"
                ]
              }
            }
          },
          {
            "in": "query",
            "name": "user_rating",
            "description": "<p>Single value for a User Rating to search for.</p>\n\n<p>The User Rating is Zap-Map's internal Location rating. It is based upon many variables, such as reliability, popularity, and Zap-Pay Session user rating.</p>\n\n<p>Passing in no User Rating will not place any restrictions on the returned results. When values are passed in, only Locations which are at or above the User Rating shall be returned.</p>\n",
            "schema": {
              "type": "integer",
              "format": "int32",
              "enum": [
                2,
                3,
                4
              ]
            }
          },
          {
            "in": "query",
            "name": "min_devices",
            "description": "<p>How many Devices a Location needs to have before it is returned.</p>\n\n<p>Passing in no Minimum Devices will not place any restrictions on the returned results. When a value is passed in, only Locations which are at or above the number of Devices shall be returned.</p>\n",
            "schema": {
              "type": "integer",
              "format": "int32",
              "enum": [
                2,
                3,
                4,
                5,
                6
              ]
            }
          },
          {
            "in": "query",
            "name": "latest",
            "description": "<p>Only return Locations that have been added in the past 30 days.</p>\n\n<p>Passing in no Latest parameter will not place any restrictions on the returned results. When a value is passed in, only Locations that have been added in the past 30 days shall be returned.</p>\n",
            "schema": {
              "type": "boolean",
              "enum": [
                true
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "linestring": {
                    "type": "string",
                    "description": "<p>The latitude/longitude pairs that represent the search area.</p>\n<p>This <strong>must</strong> have at least 2 latitude/longitude pairs otherwise the API will return an HTTP 422.</p>\n",
                    "example": "52.44526 -1.42557,52.44788 -1.42484,52.45003 -1.42355,52.45226 -1.42153,52.45423 -1.41944"
                  },
                  "buffer": {
                    "type": "number",
                    "description": "<p>The buffer defines the radius around the linestring to search for locations. A value of 0.01 is roughly 1 kilometer; 0.05 is roughly 5 kilometers, and so on.</p>\n",
                    "minimum": 0,
                    "exclusiveMinimum": true,
                    "maximum": 1,
                    "exclusiveMaximum": true
                  },
                  "nearest": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/Coordinate"
                      },
                      {
                        "type": "object",
                        "description": "<p>These coordinates are optional, but when they are specified, a maximum of 200 locations are returned that are closest to this location (using as-the-crow-flies distance).</p>"
                      }
                    ]
                  },
                  "no_rating": {
                    "type": "boolean",
                    "description": "<p>When specified as <b>true</b> or <b>1</b>, charge points will not include the <b>rating</b> attribute.</p>"
                  }
                },
                "required": [
                  "linestring",
                  "buffer"
                ]
              }
            }
          }
        },
        "responses": {
          "422": {
            "description": "Bad input parameter(s)."
          },
          "200": {
            "description": "<p>Search results matching criteria.</p>\n<p>The <code>power</code> will be a distinct list of the Connector speeds relevant to the filter criteria.</p>\n<p>Possible <code>category</code> values are:</p>\n<table>\n  <tr>\n    <th>Key</th>\n    <th>Value</th>\n  </tr>\n  <tr>\n    <td><code>PUBLIC</code></td>\n    <td>Publicly accessible Location.</td>\n  </tr>\n  <tr>\n    <td><code>HOME</code></td>\n    <td>A Location at someones personal house.</td>\n  </tr>\n  <tr>\n    <td><code>WORK</code></td>\n    <td>A Location at a place of work.</td>\n  </tr>\n</table>\n",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "The length of time, in seconds, that you are permitted to cache the response."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "legacy_id",
                          "uuid",
                          "coordinates",
                          "power",
                          "category",
                          "created_at",
                          "rating"
                        ],
                        "properties": {
                          "legacy_id": {
                            "type": "integer",
                            "example": 124180
                          },
                          "uuid": {
                            "type": "string",
                            "example": "l0c4t10n123"
                          },
                          "coordinates": {
                            "type": "object",
                            "properties": {
                              "latitude": {
                                "type": "integer",
                                "format": "int32",
                                "example": 51.4532876
                              },
                              "longitude": {
                                "type": "integer",
                                "format": "int32",
                                "example": -2.6909715
                              }
                            }
                          },
                          "power": {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            },
                            "example": [
                              100000,
                              150000,
                              350000
                            ]
                          },
                          "category": {
                            "type": "string",
                            "enum": [
                              "PUBLIC",
                              "WORK",
                              "HOME"
                            ]
                          },
                          "created_at": {
                            "type": "string",
                            "default": "2022-12-25T10:11:12Z"
                          },
                          "rating": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 5,
                            "description": "<p>The location's user rating. In the absence of a user rating, it is set to the network's average user rating.</p>\n"
                          },
                          "distance": {
                            "type": "number",
                            "description": "<p>The distance, in meters, of the location from the \"nearest\" location specified in the request.</p>\n<p>This property is not set in the response when the \"nearest\" location has not been specified in the request.</p>\n"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/locations/v1/search/locale/{country_code}": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Search for possible locales.",
        "description": "<p>Search for possible locales matching the input search string</p>\n",
        "security": [
          {
            "OAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "country_code",
            "description": "Two-character country code that the locale belongs to.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "gb"
            }
          },
          {
            "in": "query",
            "name": "search",
            "description": "String to search by.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "bri"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad input parameter(s)."
          },
          "200": {
            "description": "Search results matching criteria.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "The length of time, in seconds, that you are permitted to cache the response."
              }
            }
          }
        }
      }
    },
    "/locations/v1/search/locale/{country_code}/{locale}": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Retrieve a list of Locations in a defined region or postcode.",
        "description": "<p>By passing in the appropriate options, you can perform a search for relevant locations.</p>\n",
        "security": [
          {
            "OAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "country_code",
            "description": "Two-character country code that the locale belongs to.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "gb"
            }
          },
          {
            "in": "path",
            "name": "locale",
            "description": "Name of the locale to search in.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "bristol"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad input parameter(s)."
          },
          "200": {
            "description": "Search results matching criteria.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "The length of time, in seconds, that you are permitted to cache the response."
              }
            }
          }
        }
      }
    },
    "/locations/v1/locations": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Retrieve a list of locations",
        "description": "Retrieves all available locations in a paginated fashion",
        "security": [
          {
            "OAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "in": "query",
            "name": "per_page",
            "description": "Number of locations to return per page",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 25
            }
          },
          {
            "in": "query",
            "name": "date_from",
            "description": "ISO-8601 UTC datetime to filter locations by when they were last updated",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2023-01-01T00:00:00Z"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of locations and pagination metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Location"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/locations/v1/location/{location_uuid}": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Retrieve a single Location.",
        "description": "Retrieves a single Location object.",
        "security": [
          {
            "OAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "location_uuid",
            "description": "The UUID of the Location you wish to retrieve.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "l0c4t10n123"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad input parameter(s)."
          },
          "200": {
            "description": "The Location data as requested.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "The length of time, in seconds, that you are permitted to cache the response."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          }
        }
      }
    },
    "/locations/v1/transient/status": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Retrieve a list of Location statuses.",
        "description": "<p>Given a list of location UUID's, return their dynamic information.</p>\n\n<p><strong>Note</strong>: For best performance request all 25 Locations returned in a single Bounding Box in a single request.</p>\n",
        "security": [
          {
            "OAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "uuids",
            "description": "A comma separated list of locations UUIDs. Maximum of 100 UUIDs per request.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad input parameter(s)."
          },
          "200": {
            "description": "Status data for Locations.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "The length of time, in seconds, that you are permitted to cache the response."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "properties": {
                          "uuid": {
                            "type": "string",
                            "example": "l0c4t10n123"
                          },
                          "devices": {
                            "type": "array",
                            "items": {
                              "properties": {
                                "uuid": {
                                  "type": "string",
                                  "example": "D3V1C35"
                                },
                                "evses": {
                                  "type": "array",
                                  "items": {
                                    "properties": {
                                      "uuid": {
                                        "type": "string",
                                        "example": "3v53abc123"
                                      },
                                      "connectors": {
                                        "type": "array",
                                        "example": [
                                          "IEC_62196_T2_COMBO",
                                          "CHADEMO"
                                        ]
                                      },
                                      "status": {
                                        "type": "object",
                                        "properties": {
                                          "user": {
                                            "type": "object",
                                            "description": "A status reported by a user. In the same format as the <code>network</code> status.",
                                            "nullable": true,
                                            "example": null,
                                            "properties": {
                                              "status": {
                                                "type": "string",
                                                "enum": [
                                                  "AVAILABLE",
                                                  "BLOCKED",
                                                  "CHARGING",
                                                  "INOPERATIVE",
                                                  "OUTOFORDER",
                                                  "PLANNED",
                                                  "REMOVED",
                                                  "RESERVED",
                                                  "UNKNOWN"
                                                ],
                                                "nullable": true,
                                                "example": "AVAILABLE",
                                                "description": "The status that is reported by the network"
                                              },
                                              "updated_at": {
                                                "type": "string",
                                                "format": "date-time",
                                                "example": "2022-12-25T10:11:12Z",
                                                "description": "When the status was last updated."
                                              }
                                            }
                                          },
                                          "network": {
                                            "type": "object",
                                            "properties": {
                                              "status": {
                                                "type": "string",
                                                "enum": [
                                                  "AVAILABLE",
                                                  "BLOCKED",
                                                  "CHARGING",
                                                  "INOPERATIVE",
                                                  "OUTOFORDER",
                                                  "PLANNED",
                                                  "REMOVED",
                                                  "RESERVED",
                                                  "UNKNOWN"
                                                ],
                                                "nullable": true,
                                                "example": "AVAILABLE",
                                                "description": "The status that is reported by the network"
                                              },
                                              "updated_at": {
                                                "type": "string",
                                                "format": "date-time",
                                                "example": "2022-12-25T10:11:12Z",
                                                "description": "When the status was last updated."
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/locations/v1/transient/party-heartbeat/{data_provider_uuid}": {
      "get": {
        "tags": [
          "Search"
        ],
        "summary": "Get Party Heartbeat",
        "description": "<p>Retrieve the UTC datetime for when we last heard from a party (we call this the \"heartbeat\").</p>\n\n<p>The heartbeat will be updated when:</p>\n\n<ul>\n  <li>We receive a push update from the party.</li>\n  <li>We pull the party's data.</li>\n</ul>\n\n<p>You can use this heartbeat in conjunction with the transient status to know:</p>\n\n<ul>\n  <li>When the status changed (e.g., from `AVAILABLE` to `CHARGING`) via the transient status.</li>\n  <li>How correct that data will be (e.g., we expect the party's data will be correct as of 5 seconds ago) via the Heartbeat.</li>\n</ul>\n",
        "security": [
          {
            "OAuth": []
          }
        ],
        "parameters": [
          {
            "name": "data_provider_uuid",
            "in": "path",
            "description": "The unique identifier for the party.",
            "required": true,
            "schema": {
              "type": "string",
              "example": "d4t4pr0v1d3r"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "The length of time, in seconds, that you are permitted to cache the response."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "heartbeat": {
                          "type": "string",
                          "format": "date-time",
                          "description": "ISO-8601 UTC datetime representing the heartbeat of the party."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Party not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Not found"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/locations/v1/tariffs": {
      "get": {
        "summary": "Retrieve tariffs by ID",
        "tags": [
          "Search"
        ],
        "description": "<p>Retrieves Tariffs based on provided IDs within each Location's Connector <code>tariff_ids</code> array.</p>\n<p>Loosely follows OCPI's definition for Tariffs.\n",
        "security": [
          {
            "OAuth": []
          }
        ],
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "description": "Comma-separated list of integer IDs for tariffs.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "422": {
            "description": "Bad input parameter(s)."
          },
          "200": {
            "description": "Successful response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "The length of time, in seconds, that you are permitted to cache the response."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 123
                          },
                          "currency": {
                            "type": "string",
                            "example": "GBP",
                            "description": "ISO-4217 code of the currency of this tariff"
                          },
                          "min_price": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "excl_vat": {
                                "type": "number",
                                "example": 1.5,
                                "nullable": false
                              },
                              "incl_vat": {
                                "type": "number",
                                "example": 1.8,
                                "nullable": true
                              }
                            }
                          },
                          "max_price": {
                            "type": "object",
                            "nullable": true,
                            "properties": {
                              "excl_vat": {
                                "type": "number",
                                "example": 100,
                                "nullable": false
                              },
                              "incl_vat": {
                                "example": 120,
                                "nullable": true
                              }
                            }
                          },
                          "start_date_time": {
                            "type": "string",
                            "format": "datetime",
                            "description": "ISO-8601 UTC datetime when this tariff becomes active",
                            "nullable": true
                          },
                          "end_date_time": {
                            "type": "string",
                            "format": "datetime",
                            "description": "ISO-8601 UTC datetime after which this tariff is no longer active",
                            "nullable": true
                          },
                          "last_updated": {
                            "type": "string",
                            "format": "datetime"
                          },
                          "elements": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "price_components": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "type": {
                                        "type": "string",
                                        "enum": [
                                          "ENERGY",
                                          "FLAT",
                                          "PARKING_TIME",
                                          "TIME"
                                        ]
                                      },
                                      "price": {
                                        "type": "number"
                                      },
                                      "vat": {
                                        "type": "number",
                                        "nullable": true,
                                        "description": "Applicable VAT percentage for this tariff dimension. If omitted, no VAT |\nis applicable. Not providing a VAT is different from 0% VAT, which would |\nbe a value of 0.0 here.\n"
                                      },
                                      "step_size": {
                                        "type": "integer"
                                      }
                                    }
                                  }
                                },
                                "restrictions": {
                                  "type": "object",
                                  "nullable": true,
                                  "properties": {
                                    "start_time": {
                                      "type": "string",
                                      "minLength": 5,
                                      "maxLength": 5,
                                      "description": "Valid from this time of day in local time",
                                      "example": "09:00",
                                      "nullable": true
                                    },
                                    "end_time": {
                                      "type": "string",
                                      "minLength": 5,
                                      "maxLength": 5,
                                      "description": "Valid until this time of day in local time",
                                      "example": "19:00",
                                      "nullable": true
                                    },
                                    "start_date": {
                                      "type": "string",
                                      "minLength": 10,
                                      "maxLength": 10,
                                      "description": "Valid from this date in local time",
                                      "example": "2024-04-21",
                                      "nullable": true
                                    },
                                    "end_date": {
                                      "type": "string",
                                      "minLength": 10,
                                      "maxLength": 10,
                                      "description": "Valid until this date in local time",
                                      "example": "2024-08-09",
                                      "nullable": true
                                    },
                                    "min_kwh": {
                                      "type": "number",
                                      "example": 20.0,
                                      "nullable": true
                                    },
                                    "max_kwh": {
                                      "type": "number",
                                      "example": 50.0,
                                      "nullable": true
                                    },
                                    "min_current": {
                                      "type": "number",
                                      "example": 20.0,
                                      "nullable": true
                                    },
                                    "max_current": {
                                      "type": "number",
                                      "example": 50.0,
                                      "nullable": true
                                    },
                                    "min_power": {
                                      "type": "number",
                                      "example": 20.0,
                                      "nullable": true
                                    },
                                    "max_power": {
                                      "type": "number",
                                      "example": 50.0,
                                      "nullable": true
                                    },
                                    "min_duration": {
                                      "type": "integer",
                                      "description": "Minimum duration in seconds the Charging Session MUST last (inclusive).",
                                      "example": 120,
                                      "nullable": true
                                    },
                                    "max_duration": {
                                      "type": "integer",
                                      "description": "Maximum duration in seconds the Charging Session MUST last (exclusive).",
                                      "example": 6000,
                                      "nullable": true
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth/token/client",
            "tokenUrl": "/oauth/token/client",
            "scopes": {
              "locations": "Whether you have access to the location endpoints.",
              "route": "Whether you have access to the route endpoints.",
              "charge": "Whether you have access to the charge endpoints."
            }
          }
        }
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Which page of the result set to return.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "default": 1
        }
      }
    },
    "schemas": {
      "Meta": {
        "properties": {
          "total": {
            "type": "integer",
            "format": "int32",
            "example": 120
          },
          "per_page": {
            "type": "integer",
            "format": "int32",
            "example": 25
          },
          "current_page": {
            "type": "integer",
            "format": "int32",
            "example": 1
          },
          "last_page": {
            "type": "integer",
            "format": "int32",
            "example": 5
          }
        }
      },
      "Coordinate": {
        "description": "An object, array or string describing a specific location with Latitude and Longitude in decimal degrees.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "latitude": {
                "$ref": "#/components/schemas/Latitude"
              },
              "longitude": {
                "$ref": "#/components/schemas/Longitude"
              }
            },
            "required": [
              "latitude",
              "longitude"
            ]
          },
          {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          {
            "type": "string",
            "pattern": "^(-?\\d+(\\.\\d+)?),(-?\\d+(\\.\\d+)?)$"
          }
        ]
      },
      "Latitude": {
        "description": "A latitudinal coordinate in degrees (between -90 and 90).",
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "Longitude": {
        "description": "A longitudinal coordinate in degrees (between -180 and 180).",
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "Location": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "description": "The internal Unique Identifier that Zapmap gives this Location."
              },
              "user_rating": {
                "type": "number",
                "nullable": true,
                "description": "A rating from 1 to 5, in terms of quality where 1 is low and 5 is good, that Zapmap gives Locations where we have recent charging data."
              },
              "user_rating_count": {
                "type": "number",
                "nullable": true,
                "description": "How many data points were used to generate the `user_rating`."
              },
              "updated_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true,
                "description": "When the Location was last updated."
              },
              "name": {
                "type": "string",
                "description": "The name that Zapmap has given this Location, following our standard naming conventions."
              },
              "address": {
                "type": "string",
                "description": "The first line of the address."
              },
              "city": {
