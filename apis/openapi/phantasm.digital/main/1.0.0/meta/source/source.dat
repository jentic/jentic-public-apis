            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "perPage",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": "12"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          }
