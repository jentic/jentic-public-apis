                    "name": "STRAWBERRY WATERMELON",
                    "product_id": 524,
                    "sub_sku": "KADOBAR40KDIS09",
                    "product_variation_id": 524,
                    "woocommerce_variation_id": null,
                    "variation_value_id": 844,
