            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "keep-alive"
          },
          {
            "name": "Origin",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "https://gsd.phantasm.digital"
          },
          {
            "name": "Referer",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "https://gsd.phantasm.digital/"
          },
          {
            "name": "Sec-Fetch-Dest",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "empty"
