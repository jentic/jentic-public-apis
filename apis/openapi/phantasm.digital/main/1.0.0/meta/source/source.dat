    "/customer/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register",
        "description": "Individual Customer Register Form",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "prefix": {
                    "type": "string",
                    "example": "Mr."
                  },
                  "first_name": {
                    "type": "string",
                    "example": "Mayank"
                  },
                  "last_name": {
                    "type": "string",
                    "example": "Shukla"
                  },
                  "supplier_business_name": {
                    "type": "string",
                    "example": "Backend pvt"
                  },
                  "contact_type": {
                    "type": "string",
                    "example": "individual"
                  },
                  "tax_number": {
                    "type": "integer",
                    "example": "123456789"
                  },
                  "mobile": {
                    "type": "integer",
                    "example": "9876543210"
                  },
                  "landline": {
                    "type": "string"
                  },
                  "alternate_number": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string",
                    "example": "chicago"
                  },
                  "state": {
                    "type": "string",
                    "example": "IL"
                  },
                  "address_line_1": {
                    "type": "string",
                    "example": "1049 Industrial B"
                  },
                  "address_line_2": {
                    "type": "string"
                  },
                  "zip_code": {
                    "type": "integer",
                    "example": "60065"
                  },
                  "contact_id": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "example": "ut@gmail.com"
                  },
                  "shipping_address": {
                    "type": "string",
                    "example": "1049 industrial shipping line"
                  },
                  "position": {
                    "type": "string"
                  },
                  "dob": {
                    "type": "string",
                    "example": "1990-05-15"
                  },
                  "password": {
                    "type": "integer",
                    "example": "1234567890"
                  },
                  "Upload-Tobacco-License": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "noauthAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Server": {
                "schema": {
                  "type": "string",
                  "example": "nginx/1.24.0 (Ubuntu)"
                }
              },
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "application/json"
                }
              },
              "Transfer-Encoding": {
                "schema": {
                  "type": "string",
                  "example": "chunked"
                }
              },
              "Connection": {
                "schema": {
                  "type": "string",
                  "example": "keep-alive"
                }
              },
              "X-Powered-By": {
                "schema": {
                  "type": "string",
                  "example": "PHP/8.3.6"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-cache, private"
                }
              },
              "Date": {
                "schema": {
                  "type": "string",
                  "example": "Tue, 21 Jan 2025 13:27:49 GMT"
                }
              },
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer",
                  "example": "5"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer",
                  "example": "4"
                }
              },
              "Access-Control-Allow-Origin": {
                "schema": {
                  "type": "string",
                  "example": "*"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "status": false,
                  "message": [
                    {
                      "field": "Upload-FEIN-License",
                      "messages": [
                        "The upload- f e i n- license field is required."
                      ]
                    },
                    {
                      "field": "State-Tax-Business-License",
                      "messages": [
                        "The state- tax- business- license field is required."
                      ]
                    },
                    {
                      "field": "Government-Issued-ID",
                      "messages": [
                        "The government- issued- i d field is required."
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
