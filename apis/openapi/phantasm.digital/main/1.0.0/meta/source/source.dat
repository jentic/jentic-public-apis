              }
            }
          }
        },
        "security": [
          {
            "noauthAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/customer/set-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Set Password",
        "description": "submit new password api",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "not needed on logged in password change ",
                    "example": "utkarsh@phantasm.co.in"
                  },
                  "password": {
                    "type": "integer",
                    "description": "needed on logged in password change ",
                    "example": "1234567"
                  },
                  "password_confirmation": {
                    "type": "integer",
                    "description": "needed on logged in password change ",
                    "example": "1234567"
                  },
                  "token": {
                    "type": "string",
                    "description": "not needed on logged in password change ",
                    "example": "Xr6PEqmgmNHG8QOXaFffU75y4wTPCmtBVq7HWFrej4bIahWDVil0deaBwoV5"
                  },
                  "old_password": {
                    "type": "integer",
                    "description": "needed on logged in password change ",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "noauthAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Server": {
                "schema": {
                  "type": "string",
                  "example": "nginx/1.24.0 (Ubuntu)"
                }
              },
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "application/json"
                }
              },
              "Transfer-Encoding": {
                "schema": {
                  "type": "string",
                  "example": "chunked"
                }
              },
              "Connection": {
                "schema": {
                  "type": "string",
                  "example": "keep-alive"
                }
              },
              "X-Powered-By": {
                "schema": {
                  "type": "string",
                  "example": "PHP/8.3.6"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-cache, private"
                }
              },
              "Date": {
                "schema": {
                  "type": "string",
                  "example": "Mon, 27 Jan 2025 10:29:27 GMT"
                }
              },
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer",
                  "example": "5"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer",
                  "example": "4"
                }
              },
              "Access-Control-Allow-Origin": {
                "schema": {
                  "type": "string",
                  "example": "*"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "status": false,
                  "message": "This password reset token is invalid."
                }
              }
            }
          }
        }
      }
    },
