      "name": "Discount-rules",
      "description": "These Discount valid only in ecommerce\n\n**product adjustment and bxgy offer first will apply on priority wise****if no offer applied then cart adjustment offer can apply****if no offer + no cart adjustment then freeShipping offer**\n\nPriority work on **product adjustment and bxgy offers (bcz first these get calculated)**\n\ncart offfer apply only if not **product adjustment and bxgy offer are applied**"
    }
  ],
  "paths": {
    "/api/customer/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login",
        "description": "This is Customer Login (It is work for Customer Individual/Bussinsess)  \nHave Throtle (api return json response after exceeding limit)  \nError response also JSON type\n\nSession Expire = 1 day",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "email": "utkarsh@phantasm.co.in",
                  "password": "12345678"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "application/json"
          },
          {
            "name": "Cookie",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "XSRF-%3D; refresh_token=ZBf22rC4kZwWxNBjizSdwEOKJs78JQvalvtNkLm1JnHGnhj7yZjWHUpaFGba; smokevana_erp_%3D"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Server": {
                "schema": {
                  "type": "string",
                  "example": "nginx/1.24.0 (Ubuntu)"
                }
              },
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "application/json"
                }
              },
              "Transfer-Encoding": {
                "schema": {
                  "type": "string",
                  "example": "chunked"
                }
              },
              "Connection": {
                "schema": {
                  "type": "string",
                  "example": "keep-alive"
                }
              },
              "X-Powered-By": {
                "schema": {
                  "type": "string",
                  "example": "PHP/8.3.6"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-cache, private"
                }
              },
              "Date": {
                "schema": {
                  "type": "string",
                  "example": "Sat, 28 Dec 2024 10:42:03 GMT"
                }
              },
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer",
                  "example": "5"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer",
                  "example": "4"
                }
              },
              "Access-Control-Allow-Origin": {
                "schema": {
                  "type": "string",
                  "example": "*"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "status": true,
                  "message": "Login successful",
                  "token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9.eyJhdWQiOiIxIiwianRpIjoiZWYzMjBjNjc0ZTZkOTZlY2ZjZjI3NTA2ZGVlNTg2ZmY2YTUwMTExOWY0OTAxMDQ5MmRhZDE2OTdiYWNlNmZkOGM1NjZlYjhhNzRlNzI2MzYiLCJpYXQiOjE3MzUzODI1MjMuODM0MiwibmJmIjoxNzM1MzgyNTIzLjgzNDIwNSwiZXhwIjoxNzY2OTE4NTIzLjgyNDc2LCJzdWIiOiIxMCIsInNjb3BlcyI6W119.A2dcqn45U1A9t2MWfRN1WdepU3kfrUiW9rKPlL4mnvGqKq9WUh8vZY2dRsxeVVi_nuiBgIUr0UUSz0otHPsf8J1qzFSBZVlinTeqfKVE1vsVsogJtfcKY7B0X7IkVK1Z5aZEAC_vmBK2jpi7nT10KEAzgyspjDgp6sp9BFxPJ1V6n7E1WZztgCMBKcSrX5En460h-ML3cnUlQZb0ZZlUU5CKQpHUIYr036dEW7TVdYXcAxXv1SzJSHywnontIdY-Vr_klAPibdxb45EQOyNObTbh4XOVt7FTvLGBekv3v5A-9peuFxvWgdvskfrERD-1aoC7cImofGjPFLej1Hvj0d3xpUIrMIO8KCj5XKAUYX3tLI0oognFVBGdn5v4djpJaRcMZzUkGpr0WxWWGyBcP50rjqcfjChoc-H4Fr7Ljkpgl9Ti8F9yA6qGDNYPuoK43FTMhqHce5jhheFYSe7bgHzv8CElUc2tJaLnccUf53DqfVFrs5846yHPSSZBCmmIWAKAFYZsGO5Z-P5VFNA3PnIqNtIsY_YEtRkeSFD0FYafaRUn5F0oagdi-QQhJFcnVVsQau5atUg49QHrYRpCXDKWbqCkIo9uTK6MfOkrpITnE4PjGfW4CbZDkCCTdqUfynmZrcBr8WNVQJTm8B4LXxoOu4o8f7gy6KKqyvO5oJk"
