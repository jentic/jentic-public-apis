            "example": "same-origin"
          },
          {
            "name": "User-Agent",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36"
          },
          {
            "name": "X-CSRF-TOKEN",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "rfFSJrHwrLj4N2KAonqrJQRa3yWCnByR5xnkqdiw"
          },
          {
            "name": "X-Requested-With",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "XMLHttpRequest"
          },
          {
            "name": "sec-ch-ua",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "\"Google Chrome\";v=\"137\", \"Chromium\";v=\"137\", \"Not/A)Brand\";v=\"24\""
          },
          {
            "name": "sec-ch-ua-mobile",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "?0"
          },
          {
            "name": "sec-ch-ua-platform",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "\"Windows\""
          },
          {
            "name": "Cookie",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "remember_admin_%3D; remember_web_%3D; appearance=light; XSRF-%3D; phantasm_erp_%3D; XSRF-%3D; phantasm_erp_%3D"
          },
          {
            "name": "Content-Type",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "example": "application/json"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "noauthAuth": []
    }
  ]
}
