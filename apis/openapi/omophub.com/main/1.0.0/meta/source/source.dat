traversal_summary":{"total_discovered":25,"max_distance_reached":3,"relationship_types_used":["Is a","Subsumes","Maps to"]}},"meta":{"request_id":"req_traverse_123","timestamp":"2025-01-15T10:00:00Z","vocab_release":"2025.1"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"concepts/traverse-relationships.mdx"}},"/concepts/search":{"get":{"summary":"Incorrect concept search path guidance","description":"Returns the canonical GET /search/concepts endpoint to use.","operationId":"getConceptsSearch","tags":["Concepts"],"security":[{"bearerAuth":[]}],"parameters":[],"responses":{"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-disposition":{"status":"guidance","reason":"Intentional 404 response for a commonly mistyped route","successor":"/v1/search/concepts"}}},"/concepts/semantic-search":{"get":{"summary":"Semantic concept search (deprecated alias)","description":"Deprecated alias for GET /search/semantic.","operationId":"getConceptsSemanticSearch","tags":["Search"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"query","in":"query","required":true,"description":"English natural-language search query. After trimming, queries must contain 3-500 characters. MI is also accepted as a case-insensitive abbreviation. Other 1-2 character queries are rejected.","schema":{"oneOf":[{"type":"string","pattern":"^(?![\\s\\S]*\\u0000)\\s*\\S[\\s\\S]{1,498}\\S\\s*$","description":"Query with a trimmed length of 3-500 characters."},{"type":"string","pattern":"^\\s*[Mm][Ii]\\s*$","description":"Configured whole-query MI abbreviation, matched case-insensitively after trimming."}]},"example":"heart attack"},{"name":"page","in":"query","required":false,"description":"Page number (1-based)","schema":{"type":"integer","default":1}},{"name":"page_size","in":"query","required":false,"description":"Results per page (1-100)","schema":{"type":"integer","default":20,"maximum":100},"example":5},{"name":"threshold","in":"query","required":false,"description":"Minimum similarity score (0.0-1.0). Higher values return fewer, closer matches. This score is not a probability or clinical confidence value.","schema":{"type":"number","default":0.5}},{"name":"vocabulary_ids","in":"query","required":false,"description":"Filter to specific vocabularies (comma-separated). Vocabularies the API key cannot access are omitted when at least one requested vocabulary is accessible. A request containing only inaccessible vocabularies returns 403. Examples: SNOMED, SNOMED,ICD10CM, SNOMED,ICD10CM,RxNorm","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"domain_ids","in":"query","required":false,"description":"Filter to specific domains (comma-separated) Examples: Condition, Drug, Condition,Drug,Procedure","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"standard_concept","in":"query","required":false,"description":"Filter by standard concept status Values: S (Standard), C (Classification), N (Non-standard; stored as null in OMOP)","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"concept_class_id","in":"query","required":false,"description":"Filter by one or more concept classes (comma-separated).","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"vocab_release","in":"query","required":false,"description":"Vocabulary version (e.g., 2025v2). Uses default if not specified.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"deprecated":true,"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"query":{"type":"string"},"results":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"domain_id":{"type":"string"},"vocabulary_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"concept_code":{"type":"string"},"similarity_score":{"type":"number","minimum":0,"maximum":1,"description":"Relative match score from 0.0 to 1.0. Higher values rank first. This is not a probability or clinical confidence value."},"matched_text":{"type":"string","description":"Text associated with the match."}},"additionalProperties":true}},"total_results":{"type":"integer"},"retrieval_truncated":{"type":"boolean"},"totals_are_lower_bound":{"type":"boolean"},"latency_ms":{"type":"number"}},"additionalProperties":true},"meta":{"type":"object","properties":{"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true},"request_id":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"query":"heart attack","results":[{"concept_id":4329847,"concept_name":"Myocardial infarction","domain_id":"Condition","vocabulary_id":"SNOMED","concept_class_id":"Clinical Finding","standard_concept":"S","concept_code":"22298006","similarity_score":0.92,"matched_text":"Myocardial infarction"}],"total_results":45,"retrieval_truncated":false,"totals_are_lower_bound":false,"latency_ms":28},"meta":{"pagination":{"page":1,"page_size":20,"total_items":45,"total_pages":3,"has_next":true,"has_previous":false},"request_id":"req_sem_abc123"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-disposition":{"status":"deprecated","reason":"Compatibility alias retained for existing clients","successor":"/v1/search/semantic"},"x-documentation-source":"search/semantic-search.mdx"}},"/concepts/suggest":{"get":{"summary":"Suggest Concepts","description":"Get intelligent concept suggestions for autocomplete functionality, based on partial text input. Candidate evidence includes exact published synonyms, concept-name prefixes and substrings, and source-code prefixes. Ordering Clinical utility is the outer ordering tier, using the API's default ranking policy documented under Relevance Scoring in [Basic Search](/api-reference/search/basic-search). Questionnaire answer-list entries, survey values and LOINC structural parts rank last by default, and Standard concepts outrank non-standard ones. Within one utility tier, exact primary names and exact source codes lead, followed by exact published synonyms, name prefixes, code prefixes, and name substrings. Core clinical domains are preferred next, followed by shorter completion text, vocabulary authority, alphabetical name, and concept_id. The final ID tie-break makes pagination deterministic. This endpoint and [/v1/search/suggest](/api-reference/search/search-suggest) share one implementation and therefore one ordering.","operationId":"getConceptsSuggest","tags":["Concepts"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"query","in":"query","required":true,"description":"Partial text input for suggestions (minimum 2 characters, maximum 100 characters)","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"diab"},{"name":"page","in":"query","required":false,"description":"Page number for pagination (1-based)","schema":{"type":"integer","default":1}},{"name":"page_size","in":"query","required":false,"description":"Number of suggestions per page (max: 100)","schema":{"type":"integer","default":10,"maximum":100},"example":5},{"name":"vocabulary_ids","in":"query","required":false,"description":"Comma-separated list of vocabulary IDs to filter suggestions (e.g., \"SNOMED,ICD10CM\")","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"domain_ids","in":"query","required":false,"description":"Comma-separated list of domain IDs to filter suggestions (e.g., \"Condition,Drug\")","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"concept_class_ids","in":"query","required":false,"description":"Comma-separated concept classes. Explicit requests for Answer, Survey, Value, or another normally demoted class disable the default non-clinical demotion for that filtered result set.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"vocab_release","in":"query","required":false,"description":"Vocabulary release version to query (e.g., \"2025.1\"). Defaults to latest release.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"},"invalid_reason":{"nullable":true}},"additionalProperties":true}},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"},"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":[{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"2002-01-31","valid_end_date":"2099-12-31","invalid_reason":null},{"concept_id":4000678,"concept_name":"Diabetes mellitus","concept_code":"73211009","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"2002-01-31","valid_end_date":"2099-12-31","invalid_reason":null},{"concept_id":435216,"concept_name":"Type 1 diabetes mellitus","concept_code":"46635009","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"2002-01-31","valid_end_date":"2099-12-31","invalid_reason":null},{"concept_id":4174977,"concept_name":"Diabetic retinopathy","concept_code":"4855003","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"2002-01-31","valid_end_date":"2099-12-31","invalid_reason":null},{"concept_id":443767,"concept_name":"Diabetic nephropathy","concept_code":"127013003","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"2002-01-31","valid_end_date":"2099-12-31","invalid_reason":null}],"meta":{"request_id":"req_suggest_123","timestamp":"2024-12-22T10:00:00Z","vocab_release":"2025.2","pagination":{"page":1,"page_size":5,"total_items":47,"total_pages":10,"has_next":true,"has_previous":false}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"concepts/suggest-concepts.mdx"}},"/domains":{"get":{"summary":"Get Domains","description":"Retrieve all OMOP domains - Condition, Drug, Measurement, Observation, Procedure - that group medical concepts into high-level semantic categories.","operationId":"getDomains","tags":["Domains"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"include_stats","in":"query","required":false,"description":"Include concept counts and vocabulary coverage for each domain","schema":{"type":"boolean","default":false},"example":true},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version to query Example: 2025.1","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"domains":{"type":"array","items":{"type":"object","properties":{"domain_id":{"type":"string"},"domain_name":{"type":"string"},"domain_concept_id":{"type":"integer"}},"additionalProperties":true}}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"domains":[{"domain_id":"Condition","domain_name":"Condition","domain_concept_id":19},{"domain_id":"Drug","domain_name":"Drug","domain_concept_id":13},{"domain_id":"Procedure","domain_name":"Procedure","domain_concept_id":10},{"domain_id":"Measurement","domain_name":"Measurement","domain_concept_id":21},{"domain_id":"Observation","domain_name":"Observation","domain_concept_id":27}]},"meta":{"request_id":"req_abc123","vocab_release":"2025.1"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"domains/get-domains.mdx"}},"/domains/{domainId}/concepts":{"get":{"summary":"Get Domain Concepts","description":"Retrieve all OMOP concepts within a specific domain - Condition, Drug, Measurement, Procedure - with pagination for building domain-scoped concept sets.","operationId":"getDomainsByDomainIdConcepts","tags":["Domains"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"domainId","in":"path","required":true,"description":"The domain identifier to retrieve concepts from. Example: Condition, Drug, Procedure","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"Condition"},{"name":"vocabulary_ids","in":"query","required":false,"description":"Filter concepts to specific vocabularies within the domain (comma-separated). Example: SNOMED,ICD10CM","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"SNOMED"},{"name":"standard_only","in":"query","required":false,"description":"Return only standard concepts (standard_concept = 'S').","schema":{"type":"boolean","default":false},"example":true},{"name":"include_invalid","in":"query","required":false,"description":"Include invalid/deprecated concepts in results.","schema":{"type":"boolean","default":true}},{"name":"page","in":"query","required":false,"description":"Page number for pagination (1-based).","schema":{"type":"integer","default":1}},{"name":"page_size","in":"query","required":false,"description":"Number of concepts to return per page. Values above 200 are clamped to 200.","schema":{"type":"integer","default":20},"example":50},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version to query Example: 2025.1","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"concepts":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"vocabulary_name":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"},"invalid_reason":{"nullable":true,"type":"string"}},"additionalProperties":true}}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"vocab_release":{"type":"string"},"timestamp":{"type":"string"},"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"concepts":[{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","vocabulary_name":"Systematized Nomenclature of Medicine Clinical Terms","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"1970-01-01","valid_end_date":"2099-12-31","invalid_reason":null},{"concept_id":46635009,"concept_name":"Type 1 diabetes mellitus","concept_code":"46635009","vocabulary_id":"SNOMED","vocabulary_name":"Systematized Nomenclature of Medicine Clinical Terms","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"1970-01-01","valid_end_date":"2099-12-31","invalid_reason":null}]},"meta":{"request_id":"req_abc123","vocab_release":"2025.1","timestamp":"2025-01-05T10:00:00Z","pagination":{"page":1,"page_size":50,"total_items":847,"total_pages":17,"has_next":true,"has_previous":false}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"domains/get-domain-concepts.mdx"}},"/domains/{domainId}/statistics":{"get":{"summary":"Get Domain Statistics","description":"Get statistical overview for an OMOP domain including concept counts, standard concept coverage, and vocabulary distribution for capacity planning.","operationId":"getDomainsByDomainIdStatistics","tags":["Domains"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"domainId","in":"path","required":true,"description":"The domain identifier to get statistics for. Example: Condition, Drug, Procedure","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"Condition"},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version to query Example: 2025.1","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"domain_id":{"type":"string"},"statistics":{"type":"object","properties":{"domain_id":{"type":"string"},"domain_name":{"type":"string"},"total_concepts":{"type":"integer"},"standard_concepts":{"type":"integer"},"non_standard_concepts":{"type":"integer"},"invalid_concepts":{"type":"integer"},"vocabulary_breakdown":{"type":"array","items":{"type":"object","properties":{"vocabulary_id":{"type":"string"},"vocabulary_name":{"type":"string"},"concept_count":{"type":"integer"}},"additionalProperties":true}},"concept_class_breakdown":{"type":"array","items":{"type":"object","properties":{"concept_class_id":{"type":"string"},"concept_class_name":{"type":"string"},"concept_count":{"type":"integer"}},"additionalProperties":true}},"creation_date_range":{"type":"object","properties":{"earliest":{"type":"string"},"latest":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"vocab_release":{"type":"string"},"timestamp":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"domain_id":"Condition","statistics":{"domain_id":"Condition","domain_name":"Condition","total_concepts":845672,"standard_concepts":423891,"non_standard_concepts":421781,"invalid_concepts":12453,"vocabulary_breakdown":[{"vocabulary_id":"SNOMED","vocabulary_name":"Systematized Nomenclature of Medicine Clinical Terms","concept_count":387421},{"vocabulary_id":"ICD10CM","vocabulary_name":"International Classification of Diseases, Tenth Revision, Clinical Modification","concept_count":98234},{"vocabulary_id":"ICD10","vocabulary_name":"International Classification of Diseases, Tenth Revision","concept_count":87456}],"concept_class_breakdown":[{"concept_class_id":"Clinical Finding","concept_class_name":"Clinical Finding","concept_count":312456},{"concept_class_id":"Disorder","concept_class_name":"Disorder","concept_count":156789}],"creation_date_range":{"earliest":"1970-01-01","latest":"2024-12-01"}}},"meta":{"request_id":"req_abc123","vocab_release":"2025.1","timestamp":"2025-01-05T10:00:00Z"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"domains/get-domain-statistics.mdx"}},"/fhir/resolve":{"post":{"summary":"Resolve FHIR Coding","description":"Translate a single FHIR Coding (system URI + code) into a fully resolved OMOP concept chain: source concept, standard concept, target CDM table, optional mapping quality signal, and optional Phoebe recommendations. The resolver chains existing OMOPHub primitives - get_concept_by_code, mappings, semantic_search, validate, and recommended - behind a single composite call. If the structured code lookup fails (or only display text is provided), the resolver falls back to semantic search. Use this endpoint when you are building a FHIR-to-OMOP ETL pipeline and need to determine which OMOP CDM table a FHIR resource should land in based on its coded fields.","operationId":"postFhirResolve","tags":["Fhir"],"security":[{"bearerAuth":[]}],"parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"oneOf":[{"type":"object","properties":{"code":{"type":"string","pattern":"^[A-Za-z0-9._\\-:/+*()]+$","minLength":1,"maxLength":128,"description":"The code value from the FHIR Coding. Required when system or vocabulary_id is provided."},"resource_type":{"type":"string","pattern":"^[^\\u0000]*$","enum":["Condition","Observation","MedicationStatement","MedicationRequest","MedicationAdministration","Immunization","Procedure","AllergyIntolerance","DiagnosticReport","Encounter","Patient"],"description":"FHIR resource type that carried this coding (e.g. Condition, Observation, MedicationStatement). Used to validate domain alignment and to filter the semantic search fallback. Supported values: Condition, Observation, MedicationStatement, MedicationRequest, MedicationAdministration, Immunization, Procedure, AllergyIntolerance, DiagnosticReport, Encounter, Patient."},"include_recommendations":{"type":"boolean","default":false,"description":"Include Phoebe-recommended related concepts in the response."},"recommendations_limit":{"type":"integer","default":5,"minimum":1,"maximum":20,"description":"Maximum Phoebe recommendations to return (1–20)."},"include_quality":{"type":"boolean","default":false,"description":"Include a mapping_quality signal (high, medium, low, or manual_review) on the resolution."},"on_unmapped":{"type":"string","pattern":"^[^\\u0000]*$","default":"error","enum":["error","sentinel"],"description":"Behavior when no concept can be located at all. error (default) returns a 404 concept_not_found. sentinel instead returns a resolution with the OMOP concept_id 0 sentinel so ETL pipelines always get a writable row. (A concept that resolves but has no standard Maps to target always returns standard_concept.concept_id = 0 regardless of this flag.)"},"system":{"type":"string","pattern":"^[^\\u0000]*$","minLength":1,"maxLength":512,"description":"FHIR code system URI, e.g. http://snomed.info/sct, http://loinc.org, or http://hl7.org/fhir/sid/icd-10-cm. Required unless vocabulary_id or display is provided."}},"additionalProperties":false,"required":["system","code"]},{"type":"object","properties":{"code":{"type":"string","pattern":"^[A-Za-z0-9._\\-:/+*()]+$","minLength":1,"maxLength":128,"description":"The code value from the FHIR Coding. Required when system or vocabulary_id is provided."},"resource_type":{"type":"string","pattern":"^[^\\u0000]*$","enum":["Condition","Observation","MedicationStatement","MedicationRequest","MedicationAdministration","Immunization","Procedure","AllergyIntolerance","DiagnosticReport","Encounter","Patient"],"description":"FHIR resource type that carried this coding (e.g. Condition, Observation, MedicationStatement). Used to validate domain alignment and to filter the semantic search fallback. Supported values: Condition, Observation, MedicationStatement, MedicationRequest, MedicationAdministration, Immunization, Procedure, AllergyIntolerance, DiagnosticReport, Encounter, Patient."},"include_recommendations":{"type":"boolean","default":false,"description":"Include Phoebe-recommended related concepts in the response."},"recommendations_limit":{"type":"integer","default":5,"minimum":1,"maximum":20,"description":"Maximum Phoebe recommendations to return (1–20)."},"include_quality":{"type":"boolean","default":false,"description":"Include a mapping_quality signal (high, medium, low, or manual_review) on the resolution."},"on_unmapped":{"type":"string","pattern":"^[^\\u0000]*$","default":"error","enum":["error","sentinel"],"description":"Behavior when no concept can be located at all. error (default) returns a 404 concept_not_found. sentinel instead returns a resolution with the OMOP concept_id 0 sentinel so ETL pipelines always get a writable row. (A concept that resolves but has no standard Maps to target always returns standard_concept.concept_id = 0 regardless of this flag.)"},"vocabulary_id":{"type":"string","pattern":"^[A-Za-z0-9\\s_-]+$","minLength":1,"maxLength":64,"description":"Direct OMOP vocabulary_id (e.g. SNOMED, ICD10CM). Alternative to system for callers who already know the OMOP vocabulary and want to skip URI resolution."}},"additionalProperties":false,"required":["vocabulary_id","code"]},{"type":"object","properties":{"code":{"type":"string","pattern":"^[A-Za-z0-9._\\-:/+*()]+$","minLength":1,"maxLength":128,"description":"The code value from the FHIR Coding. Required when system or vocabulary_id is provided."},"resource_type":{"type":"string","pattern":"^[^\\u0000]*$","enum":["Condition","Observation","MedicationStatement","MedicationRequest","MedicationAdministration","Immunization","Procedure","AllergyIntolerance","DiagnosticReport","Encounter","Patient"],"description":"FHIR resource type that carried this coding (e.g. Condition, Observation, MedicationStatement). Used to validate domain alignment and to filter the semantic search fallback. Supported values: Condition, Observation, MedicationStatement, MedicationRequest, MedicationAdministration, Immunization, Procedure, AllergyIntolerance, DiagnosticReport, Encounter, Patient."},"include_recommendations":{"type":"boolean","default":false,"description":"Include Phoebe-recommended related concepts in the response."},"recommendations_limit":{"type":"integer","default":5,"minimum":1,"maximum":20,"description":"Maximum Phoebe recommendations to return (1–20)."},"include_quality":{"type":"boolean","default":false,"description":"Include a mapping_quality signal (high, medium, low, or manual_review) on the resolution."},"on_unmapped":{"type":"string","pattern":"^[^\\u0000]*$","default":"error","enum":["error","sentinel"],"description":"Behavior when no concept can be located at all. error (default) returns a 404 concept_not_found. sentinel instead returns a resolution with the OMOP concept_id 0 sentinel so ETL pipelines always get a writable row. (A concept that resolves but has no standard Maps to target always returns standard_concept.concept_id = 0 regardless of this flag.)"},"display":{"type":"string","pattern":"^[^\\u0000]*$","maxLength":500,"description":"Optional human-readable display text from the FHIR Coding. Used as the semantic search fallback when structured lookup fails, or as the primary input for text-only CodeableConcept resolution."}},"additionalProperties":false,"required":["display"]}]},"example":{"system":"http://snomed.info/sct","code":"44054006","resource_type":"Condition"}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"input":{"type":"object","properties":{"system":{"type":"string"},"code":{"type":"string"},"resource_type":{"type":"string"}},"additionalProperties":true},"resolution":{"type":"object","properties":{"vocabulary_id":{"type":"string"},"source_concept":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true}},"additionalProperties":true},"standard_concept":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true}},"additionalProperties":true},"mapping_type":{"type":"string"},"target_table":{"type":"string"},"domain_resource_alignment":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"input":{"system":"http://snomed.info/sct","code":"44054006","resource_type":"Condition"},"resolution":{"vocabulary_id":"SNOMED","source_concept":{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S"},"standard_concept":{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S"},"mapping_type":"direct","target_table":"condition_occurrence","domain_resource_alignment":"aligned"}},"meta":{"request_id":"req_fhir_resolve_123","timestamp":"2026-04-09T10:00:00Z","vocab_release":"2025.2"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/fhir-resolver.routes.ts","x-documentation-source":"fhir/resolve.mdx"}},"/fhir/resolve/batch":{"post":{"summary":"Resolve FHIR Codings - Batch","description":"Batch-resolve up to 100 FHIR Coding inputs in a single request. The batch never fails because one coding could not be resolved - failing items are reported inline in the results array with an error field, and the surrounding successful resolutions are still returned. Use this endpoint in ETL pipelines where you are iterating over a FHIR Bundle or exporting a FHIR dataset and need high-throughput code resolution.","operationId":"postFhirResolveBatch","tags":["Fhir"],"security":[{"bearerAuth":[]}],"parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"codings":{"type":"array","items":{"type":"object","additionalProperties":true},"description":"Array of FHIR coding inputs. Each item accepts the same fields as the single resolve endpoint: system, code, display, vocabulary_id. Maximum 100 items."},"resource_type":{"type":"string","pattern":"^[^\\u0000]*$","enum":["Condition","Observation","MedicationStatement","MedicationRequest","MedicationAdministration","Immunization","Procedure","AllergyIntolerance","DiagnosticReport","Encounter","Patient"],"description":"FHIR resource type applied to every item in the batch. Used for domain alignment checks and as the domain filter on semantic search fallbacks. Supported values match the single resolve endpoint."},"include_recommendations":{"type":"boolean","default":false,"description":"Include Phoebe recommendations on every successful resolution."},"recommendations_limit":{"type":"integer","default":5,"minimum":1,"maximum":20,"description":"Maximum Phoebe recommendations per resolved concept (1–20)."},"include_quality":{"type":"boolean","default":false,"description":"Include a mapping_quality signal on every successful resolution."}},"additionalProperties":false,"required":["codings"]},"example":{"codings":[{"system":"http://snomed.info/sct","code":"44054006"},{"system":"http://loinc.org","code":"2951-2"},{"system":"http://www.nlm.nih.gov/research/umls/rxnorm","code":"197696"},{"system":"http://hl7.org/fhir/sid/icd-10-cm","code":"E11.9"}]}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"results":{"type":"array","items":{"type":"object","properties":{"input":{"type":"object","properties":{"system":{"type":"string"},"code":{"type":"string"}},"additionalProperties":true},"resolution":{"type":"object","properties":{"vocabulary_id":{"type":"string"},"source_concept":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true}},"additionalProperties":true},"standard_concept":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true}},"additionalProperties":true},"mapping_type":{"type":"string"},"target_table":{"type":"string"},"domain_resource_alignment":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true}},"summary":{"type":"object","properties":{"total":{"type":"integer"},"resolved":{"type":"integer"},"failed":{"type":"integer"}},"additionalProperties":true}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"results":[{"input":{"system":"http://snomed.info/sct","code":"44054006"},"resolution":{"vocabulary_id":"SNOMED","source_concept":{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S"},"standard_concept":{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S"},"mapping_type":"direct","target_table":"condition_occurrence","domain_resource_alignment":"not_checked"}},{"input":{"system":"http://snomed.info/sct","code":"00000000"},"error":{"code":"concept_not_found","message":"No matching OMOP concept found for the provided input","details":{"vocabulary_id":"SNOMED","code":"00000000"}}}],"summary":{"total":2,"resolved":1,"failed":1}},"meta":{"request_id":"req_fhir_batch_123","timestamp":"2026-04-09T10:00:00Z","vocab_release":"2025.2"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/fhir-resolver.routes.ts","x-documentation-source":"fhir/resolve-batch.mdx"}},"/fhir/resolve/codeable-concept":{"post":{"summary":"Resolve FHIR CodeableConcept","description":"A FHIR CodeableConcept often contains multiple Coding entries for the same clinical idea - for example, both a SNOMED code and an ICD-10-CM code for the same condition. This endpoint resolves every coding in parallel and picks the best match according to OHDSI vocabulary preference: 1. SNOMED CT - conditions, procedures, observations 2. RxNorm - drugs 3. LOINC - measurements 4. CVX - vaccines 5. ICD-10 / ICD-10-CM - classification 6. Other vocabularies The remaining resolutions are returned in alternatives, and any codings that failed to resolve are reported in unresolved. If no coding resolves and a top-level text is provided, the resolver falls back to semantic search on that text.","operationId":"postFhirResolveCodeableConcept","tags":["Fhir"],"security":[{"bearerAuth":[]}],"parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"coding":{"type":"array","items":{"type":"object","additionalProperties":true},"description":"Array of FHIR Coding objects, each with required system and code fields, an optional display, and an optional user_selected boolean. Maximum 20 codings per request. When a coding sets user_selected: true it wins best_match over vocabulary preference (FHIR-to-OMOP IG CodeableConcept pattern, mirroring FHIR Coding.userSelected)."},"text":{"type":"string","pattern":"^[^\\u0000]*$","description":"Optional top-level CodeableConcept.text. Used as the semantic search fallback when none of the structured codings can be resolved."},"resource_type":{"type":"string","pattern":"^[^\\u0000]*$","enum":["Condition","Observation","MedicationStatement","MedicationRequest","MedicationAdministration","Immunization","Procedure","AllergyIntolerance","DiagnosticReport","Encounter","Patient"],"description":"FHIR resource type carrying the CodeableConcept. Applied to every resolution for domain alignment and semantic search filtering."},"include_recommendations":{"type":"boolean","default":false,"description":"Include Phoebe recommendations on resolved concepts."},"recommendations_limit":{"type":"integer","default":5,"minimum":1,"maximum":20,"description":"Maximum Phoebe recommendations per resolved concept (1–20)."},"include_quality":{"type":"boolean","default":false,"description":"Include a mapping_quality signal on resolved concepts."}},"additionalProperties":false},"example":{"coding":[{"system":"http://snomed.info/sct","code":"44054006","display":"Type 2 diabetes mellitus"},{"system":"http://hl7.org/fhir/sid/icd-10-cm","code":"E11.9","display":"Type 2 diabetes mellitus without complications"}],"resource_type":"Condition"}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"input":{"type":"object","properties":{"coding":{"type":"array","items":{"type":"object","properties":{"system":{"type":"string"},"code":{"type":"string"}},"additionalProperties":true}},"resource_type":{"type":"string"}},"additionalProperties":true},"best_match":{"type":"object","properties":{"input":{"type":"object","properties":{"system":{"type":"string"},"code":{"type":"string"},"resource_type":{"type":"string"}},"additionalProperties":true},"resolution":{"type":"object","properties":{"vocabulary_id":{"type":"string"},"source_concept":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true}},"additionalProperties":true},"standard_concept":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true}},"additionalProperties":true},"mapping_type":{"type":"string"},"target_table":{"type":"string"},"domain_resource_alignment":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"alternatives":{"type":"array","items":{"type":"object","properties":{"input":{"type":"object","properties":{"system":{"type":"string"},"code":{"type":"string"},"resource_type":{"type":"string"}},"additionalProperties":true},"resolution":{"type":"object","properties":{"vocabulary_id":{"type":"string"},"source_concept":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"nullable":true,"type":"string"}},"additionalProperties":true},"standard_concept":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true}},"additionalProperties":true},"mapping_type":{"type":"string"},"relationship_id":{"type":"string"},"target_table":{"type":"string"},"domain_resource_alignment":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true}},"unresolved":{"type":"array","items":{}}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"input":{"coding":[{"system":"http://snomed.info/sct","code":"44054006"},{"system":"http://hl7.org/fhir/sid/icd-10-cm","code":"E11.9"}],"resource_type":"Condition"},"best_match":{"input":{"system":"http://snomed.info/sct","code":"44054006","resource_type":"Condition"},"resolution":{"vocabulary_id":"SNOMED","source_concept":{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S"},"standard_concept":{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S"},"mapping_type":"direct","target_table":"condition_occurrence","domain_resource_alignment":"aligned"}},"alternatives":[{"input":{"system":"http://hl7.org/fhir/sid/icd-10-cm","code":"E11.9","resource_type":"Condition"},"resolution":{"vocabulary_id":"ICD10CM","source_concept":{"concept_id":45576876,"concept_name":"Type 2 diabetes mellitus without complications","concept_code":"E11.9","vocabulary_id":"ICD10CM","domain_id":"Condition","concept_class_id":"5-char billing code","standard_concept":null},"standard_concept":{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S"},"mapping_type":"mapped","relationship_id":"Maps to","target_table":"condition_occurrence","domain_resource_alignment":"aligned"}}],"unresolved":[]},"meta":{"request_id":"req_fhir_cc_123","timestamp":"2026-08-01T10:00:00Z","vocab_release":"2026.2"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/fhir-resolver.routes.ts","x-documentation-source":"fhir/resolve-codeable-concept.mdx"}},"/health":{"get":{"summary":"Get API health","operationId":"getHealth","tags":["System"],"security":[],"parameters":[],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/app.ts","x-documentation-disposition":{"status":"system","reason":"Operational health probe, not a vocabulary operation"}}},"/mappings/coverage":{"get":{"summary":"Get Mapping Coverage","description":"Analyze mapping coverage between a source and target OMOP vocabulary - quantify how many concepts translate across SNOMED, ICD-10, LOINC, and RxNorm.","operationId":"getMappingsCoverage","tags":["Mappings"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"source_vocabulary","in":"query","required":true,"description":"Source vocabulary ID to analyze mappings from Example: SNOMED","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"SNOMED"},{"name":"target_vocabulary","in":"query","required":true,"description":"Target vocabulary ID to analyze mappings to Example: ICD10CM","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"ICD10CM"},{"name":"domain_ids","in":"query","required":false,"description":"Comma-separated domain IDs to filter the analysis. Whitespace and empty comma-delimited entries are ignored; at least one non-empty domain ID is required when the parameter is supplied. Example: Condition,Drug","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"Condition, , Drug,"},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version (e.g., \"2025.1\")","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"source_vocabulary":{"type":"string"},"target_vocabulary":{"type":"string"},"domain_coverage":{"type":"array","items":{"type":"object","properties":{"domain_id":{"type":"string"},"domain_name":{"type":"string"},"source_concepts":{"type":"integer"},"mapped_concepts":{"type":"integer"},"coverage_percentage":{"type":"number"}},"additionalProperties":true}},"overall_coverage":{"type":"number"},"unmapped_concepts":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"domain_id":{"type":"string"},"reason":{"type":"string"}},"additionalProperties":true}}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true,"required":["success","data","meta"]},"example":{"success":true,"data":{"source_vocabulary":"SNOMED","target_vocabulary":"ICD10CM","domain_coverage":[{"domain_id":"Condition","domain_name":"Condition","source_concepts":234567,"mapped_concepts":178234,"coverage_percentage":75.9},{"domain_id":"Drug","domain_name":"Drug","source_concepts":89234,"mapped_concepts":45678,"coverage_percentage":51.2}],"overall_coverage":65.5,"unmapped_concepts":[{"concept_id":4087682,"concept_name":"Finding related to ability to move","domain_id":"Condition","reason":"No direct mapping"},{"concept_id":4273391,"concept_name":"Coronary artery bypass graft","domain_id":"Procedure","reason":"No direct mapping"}]},"meta":{"request_id":"req_coverage_abc123","timestamp":"2024-12-22T10:00:00Z","vocab_release":"2025.2"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"mappings/get-mapping-coverage.mdx"}},"/mappings/quality/{sourceVocab}/{targetVocab}":{"get":{"summary":"Get Mapping Quality","description":"Measure concept coverage and mapping composition for one directed vocabulary pair.","operationId":"getMappingsQualityBySourceVocabByTargetVocab","tags":["Mappings"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"sourceVocab","in":"path","required":true,"description":"Source vocabulary identifier, such as ICD10CM, SNOMED, or RxNorm.","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"ICD10CM"},{"name":"targetVocab","in":"path","required":true,"description":"Target vocabulary identifier, such as SNOMED, ICD10CM, or ATC.","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"SNOMED"},{"name":"vocab_release","in":"query","required":false,"description":"Vocabulary release to query, for example 2025.2. The current default release is used when omitted.","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"2025.2"}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"source_vocabulary":{"type":"string"},"target_vocabulary":{"type":"string"},"total_concepts":{"type":"integer"},"mapped_concepts":{"type":"integer"},"coverage_percentage":{"type":"number"},"mapping_types":{"type":"array","items":{"type":"object","properties":{"type":{"type":"string"},"count":{"type":"integer"},"percentage":{"type":"number"}},"additionalProperties":true,"required":["type","count","percentage"]}},"quality_score":{"type":"integer"},"issues":{"type":"array","items":{"type":"object","properties":{"issue_type":{"type":"string"},"count":{"type":"integer"},"severity":{"type":"string"},"examples":{"type":"array","items":{}}},"additionalProperties":true,"required":["issue_type","count","severity","examples"]}}},"additionalProperties":true,"required":["source_vocabulary","target_vocabulary","total_concepts","mapped_concepts","coverage_percentage","mapping_types","quality_score","issues"]},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true,"required":["request_id","timestamp","vocab_release"]}},"additionalProperties":true,"required":["success","data","meta"]},"example":{"success":true,"data":{"source_vocabulary":"ICD10CM","target_vocabulary":"SNOMED","total_concepts":98186,"mapped_concepts":97707,"coverage_percentage":99.51215040840853,"mapping_types":[{"type":"direct","count":97305,"percentage":99.58856581411773},{"type":"other","count":402,"percentage":0.4114341858822807}],"quality_score":90,"issues":[{"issue_type":"Unmapped concepts","count":479,"severity":"low","examples":[]}]},"meta":{"request_id":"req_01HXYZ","timestamp":"2026-09-11T12:00:00.000Z","vocab_release":"2025.2"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"mappings/get-mapping-quality.mdx"}},"/mappings/validate":{"post":{"summary":"Validate Mappings","description":"Validate the accuracy and quality of OMOP concept mappings between vocabularies - verify translations before committing them to source_to_concept_map.","operationId":"postMappingsValidate","tags":["Mappings"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version (e.g., \"2025.1\")","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"mappings":{"type":"array","items":{"type":"object","additionalProperties":true,"properties":{"source_concept_id":{"type":"integer","description":"The source OMOP concept ID"},"target_concept_id":{"type":"integer","description":"The target OMOP concept ID to validate mapping to"},"mapping_type":{"type":"string","pattern":"^[^\\u0000]*$","description":"The relationship type of the mapping (e.g., \"Maps to\", \"Maps to value\", \"direct\")"}},"required":["source_concept_id","target_concept_id","mapping_type"]},"description":"Array of concept mappings to validate (1-100 items) The source OMOP concept ID The target OMOP concept ID to validate mapping to The relationship type of the mapping (e.g., \"Maps to\", \"Maps to value\", \"direct\")"}},"additionalProperties":false,"required":["mappings"]},"example":{"mappings":[{"source_concept_id":201826,"target_concept_id":443735,"mapping_type":"Maps to"},{"source_concept_id":4182210,"target_concept_id":320128,"mapping_type":"Maps to"}]}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"array","items":{"type":"object","properties":{"source_concept_id":{"type":"integer"},"target_concept_id":{"type":"integer"},"mapping_type":{"type":"string"},"is_valid":{"type":"boolean"},"validation_score":{"type":"number"},"issues":{"type":"array","items":{}},"recommendations":{"type":"array","items":{}}},"additionalProperties":true}},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true,"required":["success","data","meta"]},"example":{"success":true,"data":[{"source_concept_id":201826,"target_concept_id":443735,"mapping_type":"Maps to","is_valid":true,"validation_score":0.85,"issues":[],"recommendations":[]},{"source_concept_id":4182210,"target_concept_id":320128,"mapping_type":"Maps to","is_valid":false,"validation_score":0.4,"issues":["No direct mapping relationship exists","Domain mismatch between concepts"],"recommendations":["Verify mapping relationship type is correct","Consider using a target concept in the same domain"]}],"meta":{"request_id":"req_validate_abc123","timestamp":"2024-12-22T10:00:00Z","vocab_release":"2025.2"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"mappings/validate-mappings.mdx"}},"/relationships/types":{"get":{"summary":"Get Relationship Types","description":"Retrieve all available OMOP relationship types - Maps to, Is a, Subsumes, and the complete set of OHDSI-defined links between medical concepts.","operationId":"getRelationshipsTypes","tags":["Relationships"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"page","in":"query","required":false,"description":"Page number for pagination (1-based)","schema":{"type":"integer","default":1}},{"name":"page_size","in":"query","required":false,"description":"Number of relationship types to return per page. Values above 200 are clamped to 200.","schema":{"type":"integer","default":100},"example":50},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version Example: 2025.1","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"relationship_types":{"type":"array","items":{"type":"object","properties":{"relationship_id":{"type":"string"},"relationship_name":{"type":"string"},"is_hierarchical":{"type":"string"},"defines_ancestry":{"type":"string"},"reverse_relationship_id":{"type":"string"},"relationship_concept_id":{"type":"integer"}},"additionalProperties":true}}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"vocab_release":{"type":"string"},"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"relationship_types":[{"relationship_id":"Is a","relationship_name":"Is a","is_hierarchical":"1","defines_ancestry":"1","reverse_relationship_id":"Subsumes","relationship_concept_id":44818821},{"relationship_id":"Maps to","relationship_name":"Maps to","is_hierarchical":"0","defines_ancestry":"0","reverse_relationship_id":"Mapped from","relationship_concept_id":44818981},{"relationship_id":"Has finding site","relationship_name":"Has finding site","is_hierarchical":"0","defines_ancestry":"0","reverse_relationship_id":"Finding site of","relationship_concept_id":44818788}]},"meta":{"request_id":"req_abc123","vocab_release":"2025.1","pagination":{"page":1,"page_size":100,"total_items":642,"total_pages":7,"has_next":true,"has_previous":false}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/relationships.routes.ts","x-documentation-source":"relationships/get-relationship-types.mdx"}},"/search/advanced":{"post":{"summary":"Advanced Search","description":"Perform multi-criteria search across OMOP medical vocabularies with advanced filtering by domain, vocabulary, concept class, and standard status.","operationId":"postSearchAdvanced","tags":["Search"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"Authorization","in":"header","required":true,"description":"Bearer token with your API key","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"query":{"type":"string","pattern":"^[^\\u0000]*$","description":"The search query term Example: \"diabetes mellitus type 2\" Validation: Query must be a configured abbreviation (COPD, CHF, MI, T2DM, HTN, or CKD) or at least 3 characters long, unless the request includes a vocabulary_ids, domain_ids, or concept_class_ids value. The field may be omitted for filter-only searches."},"vocabulary_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Array of vocabulary IDs to search within. In a mixed list, vocabularies the API key cannot access are omitted; a list containing only inaccessible vocabularies returns 403. Options: SNOMED, ICD10CM, ICD9CM, RxNorm, LOINC, HCPCS, etc. Default: All vocabularies"},"domain_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Array of domain IDs to filter by Options: Condition, Drug, Procedure, Measurement, Observation, etc."},"concept_class_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Array of concept class IDs to filter by Examples: Clinical Finding, Pharmaceutical Substance, Procedure"},"standard_concepts_only":{"type":"boolean","description":"Whether to include only standard (S) concepts. When omitted, concepts of every standard status are eligible."},"include_invalid":{"type":"boolean","description":"Whether to include invalid/deprecated concepts. Set to false to return only currently valid concepts."},"include_facets":{"type":"boolean","description":"Whether to include facet counts in the response. Set to false when facet data is not needed."},"include_synonyms":{"type":"boolean","description":"Include published OMOP synonyms in candidate retrieval and match evidence."},"search_mode":{"type":"string","pattern":"^[^\\u0000]*$","default":"full_text","enum":["full_text","fuzzy","exact"],"description":"Lexical retrieval mode. Semantic and hybrid search use their dedicated endpoints and are not aliases of this option."},"min_score":{"type":"number","default":0,"minimum":0,"maximum":1,"description":"Minimum bounded lexical-evidence score. This threshold is evaluated before clinical-utility ranking, so it removes weak text matches consistently rather than excluding an entire Standard, Classification, or non-standard tier."},"sort_by":{"type":"string","pattern":"^[^\\u0000]*$","default":"relevance","enum":["relevance","name","code","date"],"description":"Result sort. Clinical ranking applies only to relevance."},"sort_order":{"type":"string","pattern":"^[^\\u0000]*$","default":"desc","enum":["asc","desc"],"description":"Sort direction."},"relationship_filters":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"relationship_id":{"type":"string","pattern":"^[^\\u0000]*$","description":"OMOP relationship identifier to require.","minLength":1,"maxLength":20},"target_concept_id":{"type":"integer","minimum":1,"description":"Optional concept ID that the relationship must connect to."},"target_vocabularies":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$","minLength":1,"maxLength":20},"description":"Optional vocabulary IDs (1-20). The concept at the other end of the relationship must belong to one of them. Combined with target_concept_id, both conditions apply to the same relationship. In a mixed list, vocabularies the API key cannot access are omitted; a list containing only inaccessible vocabularies returns 403.","minItems":1,"maxItems":20},"direction":{"type":"string","pattern":"^[^\\u0000]*$","enum":["forward","reverse","both"],"description":"Direction in which to evaluate the relationship. forward matches the returned concept as concept_id_1, reverse matches it as concept_id_2, and both accepts either orientation. Defaults to forward.","default":"forward"}},"required":["relationship_id"]},"description":"Require each returned concept to satisfy every relationship filter in the array. Filters are combined with AND, so every filter is required; there is no required field. Unknown relationship or vocabulary identifiers, and any field not listed below, return 400. Vocabulary access policy is always enforced on the concept at the other end of the relationship, including when only target_concept_id is supplied. OMOP relationship identifier to require. Optional concept ID that the relationship must connect to. Optional vocabulary IDs (1-20). The concept at the other end of the relationship must belong to one of them. Combined with target_concept_id, both conditions apply to the same relationship. In a mixed list, vocabularies the API key cannot access are omitted; a list containing only inaccessible vocabularies returns 403. Direction in which to evaluate the relationship. forward matches the returned concept as concept_id_1, reverse matches it as concept_id_2, and both accepts either orientation. Defaults to forward. json [ { \"relationship_id\": \"Maps to\", \"target_concept_id\": 201826, \"direction\": \"forward\" } ] To keep only source concepts that map to SNOMED, for example ICD10CM codes with a standard SNOMED equivalent: json [ { \"relationship_id\": \"Maps to\", \"target_vocabularies\": [\"SNOMED\"] } ]","minItems":1,"maxItems":10},"date_range":{"type":"object","additionalProperties":true,"description":"Return concepts valid at any point in this inclusive date range. A concept matches when its validity interval overlaps the requested interval; it does not need to start and end within the range. Either bound may be omitted for an open-ended range. Inclusive lower bound in YYYY-MM-DD format. Concepts whose valid_end_date is on or after this date match. Inclusive upper bound in YYYY-MM-DD format. Concepts whose valid_start_date is on or before this date match. json { \"start_date\": \"2020-01-01\", \"end_date\": \"2024-12-31\" }","properties":{"start_date":{"type":"string","pattern":"^[^\\u0000]*$","format":"date","description":"Inclusive lower bound in YYYY-MM-DD format. Concepts whose valid_end_date is on or after this date match."},"end_date":{"type":"string","pattern":"^[^\\u0000]*$","format":"date","description":"Inclusive upper bound in YYYY-MM-DD format. Concepts whose valid_start_date is on or before this date match."}}},"page":{"type":"integer","default":1,"minimum":1,"description":"Page number (1-based indexing)"},"page_size":{"type":"integer","default":20,"minimum":1,"maximum":1000,"description":"Number of results per page (max: 1000)"}},"additionalProperties":false},"example":{"query":"diabetes mellitus type 2","page_size":10}}}},"responses":{"200":{"description":"Successful response","headers":{"X-OMOPHub-Ranking-Policy":{"description":"Version of the ranking implementation and matching response-cache namespace.","schema":{"type":"string","example":"v9"}}},"content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"concepts":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"vocabulary_name":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"},"invalid_reason":{"nullable":true,"type":"string"},"search_score":{"type":"number","minimum":0,"maximum":1,"description":"Normalized deterministic ranking score. Higher values rank first for relevance sorting; this is not a probability."}},"additionalProperties":true}},"facets":{"type":"object","properties":{"vocabularies":{"type":"array","items":{"type":"object","properties":{"vocabulary_id":{"type":"string"},"vocabulary_name":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":true}},"domains":{"type":"array","items":{"type":"object","properties":{"domain_id":{"type":"string"},"domain_name":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":true}},"concept_classes":{"type":"array","items":{"type":"object","properties":{"concept_class_id":{"type":"string"},"concept_class_name":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":true}},"years":{"type":"array","items":{"type":"object","properties":{"year":{"type":"integer"},"count":{"type":"integer"}},"additionalProperties":true}}},"additionalProperties":true},"facet_status":{"type":"object","properties":{"partial":{"type":"boolean"},"failed_facets":{"type":"array","items":{}}},"additionalProperties":true},"search_metadata":{"type":"object","properties":{"query_time_ms":{"type":"integer"},"total_results":{"type":"integer"},"max_relevance_score":{"type":"number"},"search_algorithm":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"},"search":{"type":"object","properties":{"query":{"type":"string"},"total_results":{"type":"integer"},"filters_applied":{"type":"object","properties":{"vocabulary_ids":{"type":"array","items":{}},"domain_ids":{"type":"array","items":{}},"standard_concepts_only":{"type":"boolean"},"include_invalid":{"type":"boolean"}},"additionalProperties":true}},"additionalProperties":true},"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"concepts":[{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","vocabulary_name":"Systematized Nomenclature of Medicine Clinical Terms","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"1970-01-01","valid_end_date":"2099-12-31","invalid_reason":null,"search_score":0.843},{"concept_id":435216,"concept_name":"Diabetes mellitus type 2 in obese","concept_code":"E11.0","vocabulary_id":"ICD10CM","vocabulary_name":"International Classification of Diseases, Tenth Revision, Clinical Modification","domain_id":"Condition","concept_class_id":"4-char billing code","standard_concept":null,"valid_start_date":"2015-10-01","valid_end_date":"2099-12-31","invalid_reason":null,"search_score":0.786}],"facets":{"vocabularies":[{"vocabulary_id":"SNOMED","vocabulary_name":"SNOMED CT","count":45},{"vocabulary_id":"ICD10CM","vocabulary_name":"ICD-10-CM","count":23},{"vocabulary_id":"ICD9CM","vocabulary_name":"ICD-9-CM","count":12}],"domains":[{"domain_id":"Condition","domain_name":"Condition","count":67},{"domain_id":"Observation","domain_name":"Observation","count":13}],"concept_classes":[{"concept_class_id":"Clinical Finding","concept_class_name":"Clinical Finding","count":45},{"concept_class_id":"4-char billing code","concept_class_name":"4-char billing code","count":23}],"years":[{"year":1970,"count":45},{"year":2015,"count":23}]},"facet_status":{"partial":false,"failed_facets":[]},"search_metadata":{"query_time_ms":127,"total_results":80,"max_relevance_score":10,"search_algorithm":"full_text_with_ranking"}},"meta":{"request_id":"req_adv_search_abc123","timestamp":"2024-01-15T10:30:00Z","vocab_release":"2025.1","search":{"query":"diabetes mellitus type 2","total_results":80,"filters_applied":{"vocabulary_ids":[],"domain_ids":[],"standard_concepts_only":false,"include_invalid":true}},"pagination":{"page":1,"page_size":10,"total_items":80,"total_pages":8,"has_next":true,"has_previous":false}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"search/advanced-search.mdx"}},"/search/autocomplete":{"get":{"summary":"Search Autocomplete","description":"Get real-time autocomplete suggestions for OMOP medical terminology searches, with optional vocabulary and domain filters.","operationId":"getSearchAutocomplete","tags":["Search"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"query","in":"query","required":true,"description":"Search query for autocompletion (minimum 2 characters, maximum 100)","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"diab"},{"name":"vocabulary_ids","in":"query","required":false,"description":"Filter suggestions to specific vocabularies (comma-separated). In a mixed list, vocabularies the API key cannot access are omitted; a list containing only inaccessible vocabularies returns 403. Examples: SNOMED, ICD10CM,LOINC, RxNorm","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"domain_ids","in":"query","required":false,"description":"Filter suggestions to specific domains (comma-separated) Examples: Condition, Drug,Procedure","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"page_size","in":"query","required":false,"description":"Maximum number of suggestions to return (1-20)","schema":{"type":"integer","default":10,"maximum":20},"example":5},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version (defaults to latest)","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"query":{"type":"string"},"suggestions":{"type":"array","items":{"type":"object","properties":{"suggestion":{"type":"string"},"type":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":true}},"page_size":{"type":"integer"}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"},"search":{"type":"object","properties":{"query":{"type":"string"},"total_results":{"type":"integer"},"filters_applied":{"type":"object","properties":{"search_type":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"query":"diab","suggestions":[{"suggestion":"Diabetes mellitus","type":"concept_name","count":12},{"suggestion":"Diabetic retinopathy","type":"concept_name","count":4}],"page_size":5},"meta":{"request_id":"req_01JEXAMPLE","timestamp":"2026-09-07T12:00:00.000Z","vocab_release":"2026.2","search":{"query":"diab","total_results":2,"filters_applied":{"search_type":"autocomplete"}}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"search/search-autocomplete.mdx"}},"/search/bulk":{"post":{"summary":"Bulk Search","description":"Perform OMOP concept search on multiple queries simultaneously with optimized batch processing - ideal for ETL pipelines and terminology mapping jobs.","operationId":"postSearchBulk","tags":["Search"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version (defaults to latest)","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"searches":{"type":"array","items":{"type":"object","additionalProperties":true,"properties":{"search_id":{"type":"string","pattern":"[^\\u0000]","description":"Unique identifier for this search within the batch. NUL characters (U+0000) are stripped before processing; results echo the normalized identifier. The identifier must remain nonempty after normalization.","minLength":1},"query":{"type":"string","pattern":"^[^\\u0000]*$","maxLength":500,"description":"Search term or phrase (3-500 characters), or a configured whole-query abbreviation: COPD, CHF, MI, T2DM, HTN, or CKD. Leading and trailing whitespace is ignored. Other one- and two-character terms are rejected."},"bulk_mode":{"type":"boolean","default":true,"description":"Enable bulk-optimized search mode for better performance"},"vocabulary_ids":{"oneOf":[{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"}},{"type":"string","pattern":"^[^\\u0000]*$"}],"description":"Filter results to specific vocabularies (e.g., [\"SNOMED\", \"ICD10CM\"]). A comma-separated string is also accepted for compatibility. In a mixed list, inaccessible vocabularies are omitted; an all-inaccessible list fails that search item. Overrides defaults.vocabulary_ids."},"domain_ids":{"oneOf":[{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"}},{"type":"string","pattern":"^[^\\u0000]*$"}],"description":"Filter results to specific domains (e.g., [\"Condition\", \"Drug\"]). A comma-separated string is also accepted for compatibility. Overrides defaults.domain_ids for this search."},"concept_class_ids":{"oneOf":[{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"}},{"type":"string","pattern":"^[^\\u0000]*$"}],"description":"Filter results to specific concept classes (e.g., [\"Clinical Finding\"]). A comma-separated string is also accepted for compatibility. Overrides defaults.concept_class_ids for this search."},"standard_concept":{"type":"string","pattern":"^[^\\u0000]*$","description":"Filter by standard concept status: \"S\" (Standard) or \"C\" (Classification). Overrides defaults.standard_concept for this search."},"include_invalid":{"type":"boolean","default":false,"description":"Include invalid/deprecated concepts. Overrides defaults.include_invalid for this search."},"page_size":{"type":"integer","default":20,"minimum":1,"maximum":100,"description":"Number of results per search (1-100). Overrides defaults.page_size for this search."}},"required":["search_id","query"]},"minItems":1,"maxItems":50,"description":"Array of search query objects (1-50 items) Unique identifier for this search within the batch. NUL characters (U+0000) are stripped before processing; results echo the normalized identifier. The identifier must remain nonempty after normalization. Search term or phrase (3-500 characters), or a configured whole-query abbreviation: COPD, CHF, MI, T2DM, HTN, or CKD. Leading and trailing whitespace is ignored. Other one- and two-character terms are rejected. Enable bulk-optimized search mode for better performance Filter results to specific vocabularies (e.g., [\"SNOMED\", \"ICD10CM\"]). A comma-separated string is also accepted for compatibility. In a mixed list, inaccessible vocabularies are omitted; an all-inaccessible list fails that search item. Overrides defaults.vocabulary_ids. Filter results to specific domains (e.g., [\"Condition\", \"Drug\"]). A comma-separated string is also accepted for compatibility. Overrides defaults.domain_ids for this search. Filter results to specific concept classes (e.g., [\"Clinical Finding\"]). A comma-separated string is also accepted for compatibility. Overrides defaults.concept_class_ids for this search. Filter by standard concept status: \"S\" (Standard) or \"C\" (Classification). Overrides defaults.standard_concept for this search. Include invalid/deprecated concepts. Overrides defaults.include_invalid for this search. Number of results per search (1-100). Overrides defaults.page_size for this search."},"defaults":{"type":"object","additionalProperties":true,"description":"Default filter parameters applied to all searches. Individual searches can override any default. Default vocabulary filter for all searches (e.g., [\"SNOMED\"]). A comma-separated string is also accepted for compatibility. Default domain filter for all searches (e.g., [\"Condition\"]). A comma-separated string is also accepted for compatibility. Default concept class filter for all searches. A comma-separated string is also accepted for compatibility. Default standard concept filter: \"S\" or \"C\" Default invalid concept inclusion Default results per search (1-100)","properties":{"vocabulary_ids":{"oneOf":[{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"}},{"type":"string","pattern":"^[^\\u0000]*$"}],"description":"Default vocabulary filter for all searches (e.g., [\"SNOMED\"]). A comma-separated string is also accepted for compatibility."},"domain_ids":{"oneOf":[{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"}},{"type":"string","pattern":"^[^\\u0000]*$"}],"description":"Default domain filter for all searches (e.g., [\"Condition\"]). A comma-separated string is also accepted for compatibility."},"concept_class_ids":{"oneOf":[{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"}},{"type":"string","pattern":"^[^\\u0000]*$"}],"description":"Default concept class filter for all searches. A comma-separated string is also accepted for compatibility."},"standard_concept":{"type":"string","pattern":"^[^\\u0000]*$","description":"Default standard concept filter: \"S\" or \"C\""},"include_invalid":{"type":"boolean","default":false,"description":"Default invalid concept inclusion"},"page_size":{"type":"integer","default":20,"minimum":1,"maximum":100,"description":"Default results per search (1-100)"}}}},"additionalProperties":false,"required":["searches"]},"example":{"defaults":{"vocabulary_ids":["SNOMED"],"standard_concept":"S"},"searches":[{"search_id":"s1","query":"diabetes"},{"search_id":"s2","query":"hypertension"},{"search_id":"s3","query":"aspirin","vocabulary_ids":["RxNorm"],"domain_ids":["Drug"]}]}}}},"responses":{"200":{"description":"Successful response","headers":{"X-OMOPHub-Ranking-Policy":{"description":"Version of the ranking implementation and matching response-cache namespace.","schema":{"type":"string","example":"v9"}}},"content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"array","items":{"type":"object","properties":{"search_id":{"type":"string"},"query":{"type":"string"},"status":{"type":"string"},"results":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"vocabulary_name":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"},"invalid_reason":{"nullable":true,"type":"string"},"search_score":{"type":"number","minimum":0,"maximum":1,"description":"Normalized deterministic ranking score. Higher values rank first for relevance sorting; this is not a probability."},"match_type":{"type":"string"}},"additionalProperties":true}},"duration":{"type":"number"}},"additionalProperties":true}},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":[{"search_id":"s1","query":"diabetes","status":"completed","results":[{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","vocabulary_name":"SNOMED Clinical Terms","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"2002-01-31","valid_end_date":"2099-12-31","invalid_reason":null,"search_score":0.843,"match_type":"exact"},{"concept_id":4000678,"concept_name":"Diabetes mellitus","concept_code":"73211009","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","search_score":0.786}],"duration":856},{"search_id":"s2","query":"hypertension","status":"completed","results":[{"concept_id":320128,"concept_name":"Essential hypertension","concept_code":"59621000","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","search_score":0.843},{"concept_id":316866,"concept_name":"Hypertensive disorder","concept_code":"38341003","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","search_score":0.786}],"duration":1034},{"search_id":"s3","query":"aspirin","status":"completed","results":[{"concept_id":1112807,"concept_name":"Aspirin","concept_code":"1191","vocabulary_id":"RxNorm","domain_id":"Drug","concept_class_id":"Ingredient","standard_concept":"S","search_score":0.843}],"duration":957}],"meta":{"request_id":"req_bulk_search_123","timestamp":"2024-01-15T10:30:00Z","vocab_release":"2025.2"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"search/bulk-search.mdx"}},"/search/concepts":{"get":{"summary":"Basic Concept Search","description":"Search for medical concepts using text queries. This endpoint provides fast, relevant results across all supported vocabularies using advanced search algorithms.","operationId":"getSearchConcepts","tags":["Search"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"query","in":"query","required":true,"description":"Search query text (3-500 characters after surrounding whitespace is removed), or one of the configured whole-query clinical abbreviations: COPD, CHF, MI, T2DM, HTN, and CKD. Other one- and two-character queries are rejected because they are too broad.","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"essential hypertension"},{"name":"vocabulary_ids","in":"query","required":false,"description":"Filter search to specific vocabularies (comma-separated). In a mixed list, vocabularies the API key cannot access are omitted; a list containing only inaccessible vocabularies returns 403. Examples: SNOMED, SNOMED,ICD10CM, RxNorm,NDC","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"domain_ids","in":"query","required":false,"description":"Filter by medical domains (comma-separated) Examples: Condition, Condition,Procedure, Drug,Device","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"concept_class_ids","in":"query","required":false,"description":"Filter by concept classes (comma-separated). Class names may contain spaces. Examples: Disorder, Ingredient, Clinical Finding, Answer Naming a class that the default ranking policy demotes (see Relevance Scoring below) also turns that demotion off, so concept_class_ids=Answer ranks questionnaire answer-list entries on text relevance alone.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"page","in":"query","required":false,"description":"Page number (1-based indexing)","schema":{"type":"integer","default":1}},{"name":"page_size","in":"query","required":false,"description":"Number of results per page. Values above 200 are clamped to 200.","schema":{"type":"integer","default":20},"example":10},{"name":"include_synonyms","in":"query","required":false,"description":"Include each result concept's synonyms array in the response. This does not control whether synonyms are searched — they always are. Use it when you need to see _which_ published term matched, which is often not visible from the concept itself: Bronchial asthma returns 317009 Asthma, whose name contains neither word.","schema":{"type":"boolean","default":false}},{"name":"exact_match","in":"query","required":false,"description":"Return only concepts whose concept ID, name, code, or a published synonym equals the query exactly, case-insensitively where applicable.","schema":{"type":"boolean","default":false}},{"name":"include_invalid","in":"query","required":false,"description":"Include concepts that have been deprecated or replaced in a later vocabulary release. Slower: this cannot use the search index and reads the concept table directly.","schema":{"type":"boolean","default":false}},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version to query Example: 2025.1","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","headers":{"X-OMOPHub-Ranking-Policy":{"description":"Version of the ranking implementation and matching response-cache namespace.","schema":{"type":"string","example":"v9"}}},"content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"match_score":{"type":"number","minimum":0,"maximum":1,"description":"Normalized tiered ranking score. Exact identifier intent, authoritative bare-code resolution and its Standard mapping, clinical utility, and lexical evidence occupy non-overlapping bands; a bounded within-evidence core-domain preference is applied before raw text detail. The score is non-increasing in relevance-ranked results. This is not a probability; thresholds calibrated against the pre-issue-138 additive score must be recalibrated."},"match_type":{"type":"string","enum":["exact","partial"],"description":"Exact when the query equals the concept ID, code, primary name, or a published synonym; otherwise partial."},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"}},"additionalProperties":true}},"meta":{"type":"object","properties":{"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true},"search":{"type":"object","properties":{"query":{"type":"string"},"total_results":{"type":"integer"},"filters_applied":{"type":"object","properties":{"vocabulary_ids":{"type":"array","items":{"type":"string"}}},"additionalProperties":true}},"additionalProperties":true},"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":[{"concept_id":320128,"concept_name":"Essential hypertension","concept_code":"59621000","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Disorder","standard_concept":"S","match_score":0.832741,"match_type":"exact","valid_start_date":"2002-01-31","valid_end_date":"2099-12-31"},{"concept_id":4217486,"concept_name":"Essential hypertension in obstetric context","concept_code":"72022006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Disorder","standard_concept":"S","match_score":0.779244,"match_type":"partial","valid_start_date":"2002-01-31","valid_end_date":"2099-12-31"},{"concept_id":4302591,"concept_name":"Essential hypertension complicating AND/OR reason for care during pregnancy","concept_code":"78808002","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Disorder","standard_concept":"S","match_score":0.775806,"match_type":"partial","valid_start_date":"2002-01-31","valid_end_date":"2099-12-31"}],"meta":{"pagination":{"page":1,"page_size":10,"total_items":247,"total_pages":25,"has_next":true,"has_previous":false},"search":{"query":"essential hypertension","total_results":247,"filters_applied":{"vocabulary_ids":["SNOMED","ICD10CM"]}},"request_id":"req_search_123","timestamp":"2024-12-22T10:00:00Z","vocab_release":"2025.2"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"search/basic-search.mdx"}},"/search/facets":{"get":{"summary":"Search Facets","description":"Retrieve search facets for filtering medical terminology search results by vocabulary, domain, concept class, and valid-start year.","operationId":"getSearchFacets","tags":["Search"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"query","in":"query","required":false,"description":"Search query to generate facets for. When provided, facets reflect the distribution of matching concepts.","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"diabetes"},{"name":"vocabulary_ids","in":"query","required":false,"description":"Filter facets to specific vocabularies (comma-separated). In a mixed list, vocabularies the API key cannot access are omitted; a list containing only inaccessible vocabularies returns 403. Examples: SNOMED, ICD10CM,LOINC, RxNorm","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"SNOMED,ICD10CM"},{"name":"domain_ids","in":"query","required":false,"description":"Filter facets to specific domains (comma-separated). Examples: Condition, Drug,Measurement","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"bucket_limit","in":"query","required":false,"description":"Maximum number of buckets returned for each facet category. Minimum: 1; maximum: 100. Counts omitted by this limit are reported in the corresponding facet metadata other_count.","schema":{"type":"integer","default":20,"minimum":1,"maximum":100},"example":20},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version (defaults to latest) Examples: 2025.1, 2024.2","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"query":{"type":"string"},"total_items":{"type":"integer"},"facets":{"type":"object","properties":{"vocabularies":{"type":"array","items":{"type":"object","properties":{"vocabulary_id":{"type":"string","nullable":true},"vocabulary_name":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":true}},"domains":{"type":"array","items":{"type":"object","properties":{"domain_id":{"type":"string","nullable":true},"domain_name":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":true}},"concept_classes":{"type":"array","items":{"type":"object","properties":{"concept_class_id":{"type":"string","nullable":true},"concept_class_name":{"type":"string"},"count":{"type":"integer"}},"additionalProperties":true}},"years":{"type":"array","items":{"type":"object","properties":{"year":{"type":"integer","nullable":true},"count":{"type":"integer"}},"additionalProperties":true}}},"additionalProperties":true},"facet_metadata":{"type":"object","properties":{"vocabularies":{"type":"object","properties":{"total_buckets":{"type":"integer"},"returned_buckets":{"type":"integer"},"returned_count":{"type":"integer"},"other_count":{"type":"integer"}},"additionalProperties":true},"domains":{"type":"object","properties":{"total_buckets":{"type":"integer"},"returned_buckets":{"type":"integer"},"returned_count":{"type":"integer"},"other_count":{"type":"integer"}},"additionalProperties":true},"concept_classes":{"type":"object","properties":{"total_buckets":{"type":"integer"},"returned_buckets":{"type":"integer"},"returned_count":{"type":"integer"},"other_count":{"type":"integer"}},"additionalProperties":true},"years":{"type":"object","properties":{"total_buckets":{"type":"integer"},"returned_buckets":{"type":"integer"},"returned_count":{"type":"integer"},"other_count":{"type":"integer"}},"additionalProperties":true}},"additionalProperties":true},"facet_status":{"type":"object","properties":{"partial":{"type":"boolean"},"failed_facets":{"type":"array","items":{}}},"additionalProperties":true}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"query":"diabetes","total_items":312,"facets":{"vocabularies":[{"vocabulary_id":"SNOMED","vocabulary_name":"SNOMED CT","count":245},{"vocabulary_id":"ICD10CM","vocabulary_name":"ICD-10-CM","count":67}],"domains":[{"domain_id":"Condition","domain_name":"Condition","count":198},{"domain_id":"Observation","domain_name":"Observation","count":87},{"domain_id":"Drug","domain_name":"Drug","count":27}],"concept_classes":[{"concept_class_id":"Clinical Finding","concept_class_name":"Clinical Finding","count":156},{"concept_class_id":"Disorder","concept_class_name":"Disorder","count":87},{"concept_class_id":"Procedure","concept_class_name":"Procedure","count":42}],"years":[{"year":2025,"count":245},{"year":2024,"count":67}]},"facet_metadata":{"vocabularies":{"total_buckets":2,"returned_buckets":2,"returned_count":312,"other_count":0},"domains":{"total_buckets":3,"returned_buckets":3,"returned_count":312,"other_count":0},"concept_classes":{"total_buckets":4,"returned_buckets":3,"returned_count":285,"other_count":27},"years":{"total_buckets":2,"returned_buckets":2,"returned_count":312,"other_count":0}},"facet_status":{"partial":false,"failed_facets":[]}},"meta":{"request_id":"req_abc123","vocab_release":"2025.1"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"search/search-facets.mdx"}},"/search/semantic":{"get":{"summary":"Semantic Search","description":"Find OMOP concepts related in meaning to an English-language query, even when the wording differs from the concept name. Results are suggestions for review, not automatic clinical coding decisions. Example queries: - \"heart attack\" finds \"Myocardial infarction\" - \"sugar diabetes\" finds \"Type 2 diabetes mellitus\" - \"high blood pressure\" finds \"Essential hypertension\" - \"belly pain\" finds \"Abdominal pain\"","operationId":"getSearchSemantic","tags":["Search"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"query","in":"query","required":true,"description":"English natural-language search query. After trimming, queries must contain 3-500 characters. MI is also accepted as a case-insensitive abbreviation. Other 1-2 character queries are rejected.","schema":{"oneOf":[{"type":"string","pattern":"^(?![\\s\\S]*\\u0000)\\s*\\S[\\s\\S]{1,498}\\S\\s*$","description":"Query with a trimmed length of 3-500 characters."},{"type":"string","pattern":"^\\s*[Mm][Ii]\\s*$","description":"Configured whole-query MI abbreviation, matched case-insensitively after trimming."}]},"example":"heart attack"},{"name":"page","in":"query","required":false,"description":"Page number (1-based)","schema":{"type":"integer","default":1}},{"name":"page_size","in":"query","required":false,"description":"Results per page (1-100)","schema":{"type":"integer","default":20,"maximum":100},"example":5},{"name":"threshold","in":"query","required":false,"description":"Minimum similarity score (0.0-1.0). Higher values return fewer, closer matches. This score is not a probability or clinical confidence value.","schema":{"type":"number","default":0.5}},{"name":"vocabulary_ids","in":"query","required":false,"description":"Filter to specific vocabularies (comma-separated). Vocabularies the API key cannot access are omitted when at least one requested vocabulary is accessible. A request containing only inaccessible vocabularies returns 403. Examples: SNOMED, SNOMED,ICD10CM, SNOMED,ICD10CM,RxNorm","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"domain_ids","in":"query","required":false,"description":"Filter to specific domains (comma-separated) Examples: Condition, Drug, Condition,Drug,Procedure","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"standard_concept","in":"query","required":false,"description":"Filter by standard concept status Values: S (Standard), C (Classification), N (Non-standard; stored as null in OMOP)","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"concept_class_id","in":"query","required":false,"description":"Filter by one or more concept classes (comma-separated).","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"vocab_release","in":"query","required":false,"description":"Vocabulary version (e.g., 2025v2). Uses default if not specified.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"query":{"type":"string"},"results":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"domain_id":{"type":"string"},"vocabulary_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"concept_code":{"type":"string"},"similarity_score":{"type":"number","minimum":0,"maximum":1,"description":"Relative match score from 0.0 to 1.0. Higher values rank first. This is not a probability or clinical confidence value."},"matched_text":{"type":"string","description":"Text associated with the match."}},"additionalProperties":true}},"total_results":{"type":"integer"},"retrieval_truncated":{"type":"boolean"},"totals_are_lower_bound":{"type":"boolean"},"latency_ms":{"type":"number"}},"additionalProperties":true},"meta":{"type":"object","properties":{"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true},"request_id":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"query":"heart attack","results":[{"concept_id":4329847,"concept_name":"Myocardial infarction","domain_id":"Condition","vocabulary_id":"SNOMED","concept_class_id":"Clinical Finding","standard_concept":"S","concept_code":"22298006","similarity_score":0.92,"matched_text":"Myocardial infarction"}],"total_results":45,"retrieval_truncated":false,"totals_are_lower_bound":false,"latency_ms":28},"meta":{"pagination":{"page":1,"page_size":20,"total_items":45,"total_pages":3,"has_next":true,"has_previous":false},"request_id":"req_sem_abc123"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"search/semantic-search.mdx"}},"/search/semantic-bulk":{"post":{"summary":"Bulk Semantic Search","description":"Find related OMOP concepts for multiple English-language queries in one request.","operationId":"postSearchSemanticBulk","tags":["Search"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version (defaults to latest)","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"searches":{"type":"array","items":{"type":"object","additionalProperties":true,"properties":{"search_id":{"type":"string","pattern":"[^\\u0000]","description":"Unique identifier for this search within the batch. NUL characters (U+0000) are stripped before processing; results echo the normalized identifier. The identifier must remain nonempty after normalization.","minLength":1},"query":{"oneOf":[{"type":"string","pattern":"^(?![\\s\\S]*\\u0000)\\s*\\S[\\s\\S]{1,498}\\S\\s*$","description":"Query with a trimmed length of 3-500 characters."},{"type":"string","pattern":"^\\s*[Mm][Ii]\\s*$","description":"Configured whole-query MI abbreviation, matched case-insensitively after trimming."}],"description":"English natural-language search query. After trimming, queries must contain 3-500 characters. MI is also accepted as a case-insensitive abbreviation. Other 1-2 character queries fail only their own bulk item."},"page_size":{"type":"integer","default":10,"minimum":1,"maximum":50,"description":"Number of results per search (1-50). Overrides defaults.page_size for this search."},"threshold":{"type":"number","default":0.5,"minimum":0,"maximum":1,"description":"Minimum similarity score (0.0-1.0). Higher values return fewer, closer matches. Overrides defaults.threshold for this search."},"vocabulary_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Filter results to specific vocabularies (e.g., [\"SNOMED\", \"ICD10CM\"]). In a mixed list, inaccessible vocabularies are omitted; an all-inaccessible list fails that search item. Overrides defaults.vocabulary_ids."},"domain_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Filter results to specific domains (e.g., [\"Condition\", \"Drug\"]). Overrides defaults.domain_ids for this search."},"standard_concept":{"type":"string","pattern":"^[^\\u0000]*$","description":"Filter by standard concept status: \"S\" (Standard) or \"C\" (Classification). Overrides defaults.standard_concept for this search."},"concept_class_id":{"type":"string","pattern":"^[^\\u0000]*$","description":"Filter by concept class (e.g., \"Clinical Finding\"). Overrides defaults.concept_class_id for this search."}},"required":["search_id","query"]},"minItems":1,"maxItems":25,"description":"Array of semantic search query objects (1-25 items) Unique identifier for this search within the batch. NUL characters (U+0000) are stripped before processing; results echo the normalized identifier. The identifier must remain nonempty after normalization. English natural-language search query. After trimming, queries must contain 3-500 characters. MI is also accepted as a case-insensitive abbreviation. Other 1-2 character queries fail only their own bulk item. Number of results per search (1-50). Overrides defaults.page_size for this search. Minimum similarity score (0.0-1.0). Higher values return fewer, closer matches. Overrides defaults.threshold for this search. Filter results to specific vocabularies (e.g., [\"SNOMED\", \"ICD10CM\"]). In a mixed list, inaccessible vocabularies are omitted; an all-inaccessible list fails that search item. Overrides defaults.vocabulary_ids. Filter results to specific domains (e.g., [\"Condition\", \"Drug\"]). Overrides defaults.domain_ids for this search. Filter by standard concept status: \"S\" (Standard) or \"C\" (Classification). Overrides defaults.standard_concept for this search. Filter by concept class (e.g., \"Clinical Finding\"). Overrides defaults.concept_class_id for this search."},"defaults":{"type":"object","additionalProperties":true,"description":"Default parameters applied to all searches. Individual searches can override any default. Default results per search (1-50) Default minimum similarity score (0.0-1.0). This is not a probability or clinical confidence threshold. Default vocabulary filter for all searches (e.g., [\"SNOMED\"]) Default domain filter for all searches (e.g., [\"Condition\"]) Default standard concept filter: \"S\" or \"C\" Default concept class filter","properties":{"page_size":{"type":"integer","default":10,"minimum":1,"maximum":50,"description":"Default results per search (1-50)"},"threshold":{"type":"number","default":0.5,"minimum":0,"maximum":1,"description":"Default minimum similarity score (0.0-1.0). This is not a probability or clinical confidence threshold."},"vocabulary_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Default vocabulary filter for all searches (e.g., [\"SNOMED\"])"},"domain_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Default domain filter for all searches (e.g., [\"Condition\"])"},"standard_concept":{"type":"string","pattern":"^[^\\u0000]*$","description":"Default standard concept filter: \"S\" or \"C\""},"concept_class_id":{"type":"string","pattern":"^[^\\u0000]*$","description":"Default concept class filter"}}}},"additionalProperties":false,"required":["searches"]},"example":{"defaults":{"vocabulary_ids":["SNOMED"],"standard_concept":"S","threshold":0.5,"page_size":5},"searches":[{"search_id":"s1","query":"heart attack"},{"search_id":"s2","query":"sugar diabetes","threshold":0.7},{"search_id":"s3","query":"aspirin tablets","vocabulary_ids":["RxNorm"],"domain_ids":["Drug"]}]}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"results":{"type":"array","items":{"type":"object","properties":{"search_id":{"type":"string"},"query":{"type":"string"},"status":{"type":"string"},"results":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"similarity_score":{"type":"number","minimum":0,"maximum":1,"description":"Relative match score from 0.0 to 1.0. Higher values rank first. This is not a probability or clinical confidence value."},"matched_text":{"type":"string","description":"Text associated with the match."}},"additionalProperties":true}},"similarity_threshold":{"type":"number"},"result_count":{"type":"integer"},"retrieval_truncated":{"type":"boolean"},"totals_are_lower_bound":{"type":"boolean"},"duration":{"type":"number"}},"additionalProperties":true}},"total_searches":{"type":"integer"},"completed_count":{"type":"integer"},"failed_count":{"type":"integer"},"total_duration":{"type":"number"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"results":[{"search_id":"s1","query":"heart attack","status":"completed","results":[{"concept_id":4329847,"concept_name":"Myocardial infarction","concept_code":"22298006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","similarity_score":0.92,"matched_text":"Myocardial infarction"}],"similarity_threshold":0.5,"result_count":1,"retrieval_truncated":false,"totals_are_lower_bound":false,"duration":45}],"total_searches":1,"completed_count":1,"failed_count":0,"total_duration":45}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"search/semantic-bulk-search.mdx"}},"/search/similar":{"post":{"summary":"Search Similar Concepts","description":"Find semantically similar medical concepts using advanced machine learning algorithms with flexible search criteria and body parameters.","operationId":"postSearchSimilar","tags":["Search"],"security":[{"bearerAuth":[]}],"parameters":[],"requestBody":{"required":true,"content":{"application/json":{"schema":{"oneOf":[{"type":"object","properties":{"vocabulary_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Target vocabularies to search within (array of strings). In a mixed list, vocabularies the API key cannot access are omitted; a list containing only inaccessible vocabularies returns 403. Examples: [\"SNOMED\", \"ICD10CM\"], [\"RxNorm\", \"NDC\"]"},"domain_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Clinical domains to focus the similarity search (array of strings) Examples: [\"Condition\", \"Procedure\"], [\"Drug\", \"Device\"]"},"concept_class_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Concept classes to include in similarity search (array of strings) Examples: [\"Clinical Finding\", \"Procedure\"], [\"Ingredient\", \"Brand Name\"]"},"similarity_threshold":{"type":"number","default":0.7,"minimum":0,"maximum":1,"description":"Minimum similarity score threshold (0 to 1.0) Higher values = More strict similarity matching 0 is a valid value and is honoured: it returns every candidate the retrieval produced, ranked by score."},"page_size":{"type":"integer","default":20,"minimum":1,"maximum":1000,"description":"Number of similar concepts to return per page Every page size is served from the same fixed candidate pool, so this changes how results are sliced, never how they are scored - see [Pagination](pagination) for the bound on how deep paging can go."},"include_scores":{"type":"boolean","default":true,"description":"Include similarity_score on each returned concept. Set false to omit it; ranking is unaffected."},"include_explanations":{"type":"boolean","default":false,"description":"Add an explanation field to each returned concept describing the evidence behind its score. For one release each concept also carries a duplicate similarity_explanation field with the same value. It is deprecated and exists only so clients that read the old name keep working; read explanation."},"standard_concept":{"type":"string","pattern":"^[^\\u0000]*$","enum":["S","C","N"],"description":"Filter by standard concept designation Options: S (standard), C (classification), N (non-standard) OMOP stores non-standard concepts with a null standard_concept; N selects those rows."},"include_invalid":{"type":"boolean","default":false,"description":"Include invalid/deprecated concepts in the similarity search. Supported only with algorithm=lexical. The embedding index contains valid concepts only, so include_invalid=true with semantic or hybrid returns 400 rather than silently ignoring the filter."},"exclude_self":{"type":"boolean","default":true,"description":"Exclude the reference concept from its own results. Applies when the request started from a concept_id."},"algorithm":{"type":"string","pattern":"^[^\\u0000]*$","default":"semantic","enum":["semantic","lexical","hybrid"],"description":"Similarity algorithm to use Options: - semantic (default) - Neural embedding similarity. Best for finding conceptually similar terms that share no words (e.g. \"heart attack\" → \"Myocardial infarction\"). Returns 503 if the embedding service is unavailable. - lexical - Text-based Jaccard word and character similarity. Good for fuzzy text matching and typo tolerance, and the only algorithm that can search invalid concepts. - hybrid - Runs both retrievals, unions their candidates and scores every one of them by the same rule: 0.7 × semantic + 0.3 × lexical, where a signal neither retrieval established counts as 0. Note that this puts hybrid scores on a different scale from both semantic and lexical scores — a candidate sharing no words with the query keeps only 0.7 × its semantic score, and one the embedding search did not return keeps only 0.3 × its lexical score — so the same similarity_threshold is stricter here than in either single-signal algorithm. See [Algorithm Comparison](algorithm-comparison). If the embedding service is unavailable, hybrid serves its lexical half and reports algorithm_used: \"lexical\" with degraded_from: \"hybrid\" rather than failing."},"page":{"type":"integer","default":1,"minimum":1,"description":"Page number (1-based indexing)"},"concept_id":{"type":"integer","minimum":1,"description":"Reference concept to find similar concepts for. Its name becomes the search text, and the concept itself is excluded from the results unless exclude_self is false."}},"additionalProperties":false,"required":["concept_id"]},{"type":"object","properties":{"vocabulary_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Target vocabularies to search within (array of strings). In a mixed list, vocabularies the API key cannot access are omitted; a list containing only inaccessible vocabularies returns 403. Examples: [\"SNOMED\", \"ICD10CM\"], [\"RxNorm\", \"NDC\"]"},"domain_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Clinical domains to focus the similarity search (array of strings) Examples: [\"Condition\", \"Procedure\"], [\"Drug\", \"Device\"]"},"concept_class_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Concept classes to include in similarity search (array of strings) Examples: [\"Clinical Finding\", \"Procedure\"], [\"Ingredient\", \"Brand Name\"]"},"similarity_threshold":{"type":"number","default":0.7,"minimum":0,"maximum":1,"description":"Minimum similarity score threshold (0 to 1.0) Higher values = More strict similarity matching 0 is a valid value and is honoured: it returns every candidate the retrieval produced, ranked by score."},"page_size":{"type":"integer","default":20,"minimum":1,"maximum":1000,"description":"Number of similar concepts to return per page Every page size is served from the same fixed candidate pool, so this changes how results are sliced, never how they are scored - see [Pagination](pagination) for the bound on how deep paging can go."},"include_scores":{"type":"boolean","default":true,"description":"Include similarity_score on each returned concept. Set false to omit it; ranking is unaffected."},"include_explanations":{"type":"boolean","default":false,"description":"Add an explanation field to each returned concept describing the evidence behind its score. For one release each concept also carries a duplicate similarity_explanation field with the same value. It is deprecated and exists only so clients that read the old name keep working; read explanation."},"standard_concept":{"type":"string","pattern":"^[^\\u0000]*$","enum":["S","C","N"],"description":"Filter by standard concept designation Options: S (standard), C (classification), N (non-standard) OMOP stores non-standard concepts with a null standard_concept; N selects those rows."},"include_invalid":{"type":"boolean","default":false,"description":"Include invalid/deprecated concepts in the similarity search. Supported only with algorithm=lexical. The embedding index contains valid concepts only, so include_invalid=true with semantic or hybrid returns 400 rather than silently ignoring the filter."},"exclude_self":{"type":"boolean","default":true,"description":"Exclude the reference concept from its own results. Applies when the request started from a concept_id."},"algorithm":{"type":"string","pattern":"^[^\\u0000]*$","default":"semantic","enum":["semantic","lexical","hybrid"],"description":"Similarity algorithm to use Options: - semantic (default) - Neural embedding similarity. Best for finding conceptually similar terms that share no words (e.g. \"heart attack\" → \"Myocardial infarction\"). Returns 503 if the embedding service is unavailable. - lexical - Text-based Jaccard word and character similarity. Good for fuzzy text matching and typo tolerance, and the only algorithm that can search invalid concepts. - hybrid - Runs both retrievals, unions their candidates and scores every one of them by the same rule: 0.7 × semantic + 0.3 × lexical, where a signal neither retrieval established counts as 0. Note that this puts hybrid scores on a different scale from both semantic and lexical scores — a candidate sharing no words with the query keeps only 0.7 × its semantic score, and one the embedding search did not return keeps only 0.3 × its lexical score — so the same similarity_threshold is stricter here than in either single-signal algorithm. See [Algorithm Comparison](algorithm-comparison). If the embedding service is unavailable, hybrid serves its lexical half and reports algorithm_used: \"lexical\" with degraded_from: \"hybrid\" rather than failing."},"page":{"type":"integer","default":1,"minimum":1,"description":"Page number (1-based indexing)"},"concept_name":{"type":"string","pattern":"^[^\\u0000]*$","minLength":1,"maxLength":255,"description":"Reference concept name, when you have the name but not the ID"}},"additionalProperties":false,"required":["concept_name"]},{"type":"object","properties":{"vocabulary_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Target vocabularies to search within (array of strings). In a mixed list, vocabularies the API key cannot access are omitted; a list containing only inaccessible vocabularies returns 403. Examples: [\"SNOMED\", \"ICD10CM\"], [\"RxNorm\", \"NDC\"]"},"domain_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Clinical domains to focus the similarity search (array of strings) Examples: [\"Condition\", \"Procedure\"], [\"Drug\", \"Device\"]"},"concept_class_ids":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Concept classes to include in similarity search (array of strings) Examples: [\"Clinical Finding\", \"Procedure\"], [\"Ingredient\", \"Brand Name\"]"},"similarity_threshold":{"type":"number","default":0.7,"minimum":0,"maximum":1,"description":"Minimum similarity score threshold (0 to 1.0) Higher values = More strict similarity matching 0 is a valid value and is honoured: it returns every candidate the retrieval produced, ranked by score."},"page_size":{"type":"integer","default":20,"minimum":1,"maximum":1000,"description":"Number of similar concepts to return per page Every page size is served from the same fixed candidate pool, so this changes how results are sliced, never how they are scored - see [Pagination](pagination) for the bound on how deep paging can go."},"include_scores":{"type":"boolean","default":true,"description":"Include similarity_score on each returned concept. Set false to omit it; ranking is unaffected."},"include_explanations":{"type":"boolean","default":false,"description":"Add an explanation field to each returned concept describing the evidence behind its score. For one release each concept also carries a duplicate similarity_explanation field with the same value. It is deprecated and exists only so clients that read the old name keep working; read explanation."},"standard_concept":{"type":"string","pattern":"^[^\\u0000]*$","enum":["S","C","N"],"description":"Filter by standard concept designation Options: S (standard), C (classification), N (non-standard) OMOP stores non-standard concepts with a null standard_concept; N selects those rows."},"include_invalid":{"type":"boolean","default":false,"description":"Include invalid/deprecated concepts in the similarity search. Supported only with algorithm=lexical. The embedding index contains valid concepts only, so include_invalid=true with semantic or hybrid returns 400 rather than silently ignoring the filter."},"exclude_self":{"type":"boolean","default":true,"description":"Exclude the reference concept from its own results. Applies when the request started from a concept_id."},"algorithm":{"type":"string","pattern":"^[^\\u0000]*$","default":"semantic","enum":["semantic","lexical","hybrid"],"description":"Similarity algorithm to use Options: - semantic (default) - Neural embedding similarity. Best for finding conceptually similar terms that share no words (e.g. \"heart attack\" → \"Myocardial infarction\"). Returns 503 if the embedding service is unavailable. - lexical - Text-based Jaccard word and character similarity. Good for fuzzy text matching and typo tolerance, and the only algorithm that can search invalid concepts. - hybrid - Runs both retrievals, unions their candidates and scores every one of them by the same rule: 0.7 × semantic + 0.3 × lexical, where a signal neither retrieval established counts as 0. Note that this puts hybrid scores on a different scale from both semantic and lexical scores — a candidate sharing no words with the query keeps only 0.7 × its semantic score, and one the embedding search did not return keeps only 0.3 × its lexical score — so the same similarity_threshold is stricter here than in either single-signal algorithm. See [Algorithm Comparison](algorithm-comparison). If the embedding service is unavailable, hybrid serves its lexical half and reports algorithm_used: \"lexical\" with degraded_from: \"hybrid\" rather than failing."},"page":{"type":"integer","default":1,"minimum":1,"description":"Page number (1-based indexing)"},"query":{"type":"string","pattern":"^[^\\u0000]*$","minLength":1,"maxLength":500,"description":"Free-text query or concept description to find similar concepts for"}},"additionalProperties":false,"required":["query"]}]},"example":{"query":"type 2 diabetes mellitus","vocabulary_ids":["SNOMED","ICD10CM"],"domain_ids":["Condition"],"algorithm":"hybrid","similarity_threshold":0.8,"page_size":10,"include_scores":true,"include_explanations":true,"standard_concept":"S"}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"similar_concepts":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"matched_text":{"type":"string"},"source_type":{"type":"string"},"similarity_score":{"type":"number"},"explanation":{"type":"string"},"similarity_explanation":{"type":"string"}},"additionalProperties":true}},"search_metadata":{"type":"object","properties":{"original_query":{"type":"string"},"algorithm_used":{"type":"string"},"similarity_threshold":{"type":"number"},"total_candidates":{"type":"integer"},"results_returned":{"type":"integer"},"processing_time_ms":{"type":"integer"},"totals_are_lower_bound":{"type":"boolean"},"embedding_latency_ms":{"type":"integer"}},"additionalProperties":true}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"},"search":{"type":"object","properties":{"query":{"type":"string"},"total_results":{"type":"integer"},"filters_applied":{"type":"object","properties":{"algorithm":{"type":"string"},"vocabulary_ids":{"type":"array","items":{"type":"string"}},"domain_ids":{"type":"array","items":{"type":"string"}},"standard_concept":{"type":"string","nullable":true},"include_invalid":{"type":"boolean"},"exclude_self":{"type":"boolean"}},"additionalProperties":true}},"additionalProperties":true},"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"similar_concepts":[{"concept_id":4193704,"concept_name":"Type 2 diabetes mellitus without complication","concept_code":"313436004","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","matched_text":"Type 2 diabetes mellitus without complication","source_type":"concept_name","similarity_score":0.93,"explanation":"Semantic similarity 0.94 and lexical overlap 0.91, combined at 0.7/0.3","similarity_explanation":"Semantic similarity 0.94 and lexical overlap 0.91, combined at 0.7/0.3"},{"concept_id":3191208,"concept_name":"Type 2 diabetes mellitus with hyperglycemia","concept_code":"1481000119100","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","matched_text":"Type 2 diabetes mellitus with hyperglycemia","source_type":"concept_name","similarity_score":0.9,"explanation":"Semantic similarity 0.89 and lexical overlap 0.91, combined at 0.7/0.3","similarity_explanation":"Semantic similarity 0.89 and lexical overlap 0.91, combined at 0.7/0.3"},{"concept_id":35206879,"concept_name":"Type 2 diabetes mellitus without complications","concept_code":"E11.9","vocabulary_id":"ICD10CM","domain_id":"Condition","concept_class_id":"4-char nonbill code","standard_concept":"S","matched_text":"Type 2 diabetes mellitus without complications","source_type":"concept_name","similarity_score":0.87,"explanation":"Semantic similarity 0.86 and lexical overlap 0.9, combined at 0.7/0.3","similarity_explanation":"Semantic similarity 0.86 and lexical overlap 0.9, combined at 0.7/0.3"}],"search_metadata":{"original_query":"type 2 diabetes mellitus","algorithm_used":"hybrid","similarity_threshold":0.8,"total_candidates":3,"results_returned":3,"processing_time_ms":1,"totals_are_lower_bound":false,"embedding_latency_ms":18}},"meta":{"request_id":"req_01HQZX3M5K8P2N7R4T6V9W1Y3B","timestamp":"2026-09-06T13:37:12.848Z","vocab_release":"2026.1","search":{"query":"type 2 diabetes mellitus","total_results":3,"filters_applied":{"algorithm":"hybrid","vocabulary_ids":["SNOMED","ICD10CM"],"domain_ids":["Condition"],"standard_concept":"S","include_invalid":false,"exclude_self":true}},"pagination":{"page":1,"page_size":10,"total_items":3,"total_pages":1,"has_next":false,"has_previous":false}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"search/search-similar.mdx"}},"/search/similar/{conceptId}":{"get":{"summary":"Get Similar Concepts by ID","description":"Find OMOP concepts similar to a specific concept identified by its concept ID using semantic similarity - discover related clinical terminology fast.","operationId":"getSearchSimilarByConceptId","tags":["Search"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"conceptId","in":"path","required":true,"description":"The OMOP concept_id to find similar concepts for. This is the OMOP identifier, not a source vocabulary code. \"Type 2 diabetes mellitus\" is concept ID 201826 and SNOMED code 44054006; the route resolves the path value with concept_id only and does not translate codes, so passing a code returns the wrong concept or a 404.","schema":{"type":"integer"},"example":201826},{"name":"vocabulary_ids","in":"query","required":false,"description":"Target vocabularies to search within (comma-separated). In a mixed list, vocabularies the API key cannot access are omitted; a list containing only inaccessible vocabularies returns 403. Examples: SNOMED, SNOMED,ICD10CM, RxNorm,NDC vocabularies is accepted as a legacy alias.","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"SNOMED,ICD10CM"},{"name":"domain_ids","in":"query","required":false,"description":"Clinical domains to focus the similarity search (comma-separated) Examples: Condition,Procedure, Drug,Device","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"concept_class_ids","in":"query","required":false,"description":"Concept classes to include in similarity search (comma-separated) Examples: Clinical Finding,Procedure, Ingredient,Brand Name","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"similarity_threshold","in":"query","required":false,"description":"Minimum similarity score threshold (0.0 to 1.0) Higher values = More strict similarity matching 0 is a valid value and is honoured: it returns every candidate the retrieval produced, ranked by score.","schema":{"type":"number","default":0.7,"minimum":0,"maximum":1},"example":0.8},{"name":"page_size","in":"query","required":false,"description":"Number of similar concepts to return per page. Larger values are clamped to 200, silently - the pagination block in the response reports the size actually served. Every page size is served from the same fixed candidate pool, so this changes how results are sliced, never how they are scored; see [Pagination](pagination) for the bound on how deep paging can go.","schema":{"type":"integer","default":20,"minimum":1},"example":10},{"name":"page","in":"query","required":false,"description":"Page number (1-based indexing)","schema":{"type":"integer","default":1,"minimum":1}},{"name":"include_scores","in":"query","required":false,"description":"Include similarity_score on each returned concept. Set false to omit it; ranking is unaffected.","schema":{"type":"boolean","default":true},"example":true},{"name":"include_explanations","in":"query","required":false,"description":"Add an explanation field to each returned concept describing the evidence behind its score. For one release each concept also carries a duplicate similarity_explanation field with the same value. It is deprecated and exists only so clients that read the old name keep working; read explanation.","schema":{"type":"boolean","default":false},"example":true},{"name":"standard_concept","in":"query","required":false,"description":"Filter by standard concept designation Options: S (standard), C (classification), N (non-standard) OMOP stores non-standard concepts with a null standard_concept; N selects those rows.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"include_invalid","in":"query","required":false,"description":"Include invalid/deprecated concepts in the similarity search. Supported only with algorithm=lexical. The embedding index contains valid concepts only, so include_invalid=true with semantic or hybrid returns 400 rather than silently ignoring the filter.","schema":{"type":"boolean","default":false}},{"name":"algorithm","in":"query","required":false,"description":"Similarity algorithm to use Options: - semantic (default) - Neural embedding similarity. Returns 503 if the embedding service is unavailable. - lexical - Text-based Jaccard word and character similarity, and the only algorithm that can search invalid concepts. - hybrid - Runs both retrievals, unions their candidates and scores every one of them the same way: 0.7 × semantic + 0.3 × lexical, where a signal neither retrieval established counts as 0. A candidate the embedding search did not return therefore scores at most 0.3, so it cannot reach the default threshold of 0.7; use lexical when you want exact name or code matches to rank on their own. If the embedding service is unavailable, hybrid serves its lexical half and reports algorithm_used: \"lexical\" with degraded_from: \"hybrid\".","schema":{"type":"string","pattern":"^[^\\u0000]*$","default":"semantic"}},{"name":"exclude_self","in":"query","required":false,"description":"Exclude the source concept from its own results","schema":{"type":"boolean","default":true}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"similar_concepts":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"matched_text":{"type":"string"},"source_type":{"type":"string"},"similarity_score":{"type":"number"},"explanation":{"type":"string"},"similarity_explanation":{"type":"string"}},"additionalProperties":true}},"search_metadata":{"type":"object","properties":{"original_query":{"type":"string"},"algorithm_used":{"type":"string"},"similarity_threshold":{"type":"number"},"total_candidates":{"type":"integer"},"results_returned":{"type":"integer"},"processing_time_ms":{"type":"integer"},"totals_are_lower_bound":{"type":"boolean"},"source_concept_id":{"type":"integer"},"embedding_latency_ms":{"type":"integer"}},"additionalProperties":true},"source_concept":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true}},"additionalProperties":true}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"},"search":{"type":"object","properties":{"query":{"type":"string"},"total_results":{"type":"integer"},"filters_applied":{"type":"object","properties":{"algorithm":{"type":"string"},"vocabulary_ids":{"type":"array","items":{"type":"string"}},"include_invalid":{"type":"boolean"},"exclude_self":{"type":"boolean"}},"additionalProperties":true}},"additionalProperties":true},"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"similar_concepts":[{"concept_id":4193704,"concept_name":"Type 2 diabetes mellitus without complication","concept_code":"313436004","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","matched_text":"Type 2 diabetes mellitus without complication","source_type":"concept_name","similarity_score":0.94,"explanation":"Semantic similarity of 0.94 between the query embedding and this concept's embedding","similarity_explanation":"Semantic similarity of 0.94 between the query embedding and this concept's embedding"},{"concept_id":3191208,"concept_name":"Type 2 diabetes mellitus with hyperglycemia","concept_code":"1481000119100","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","matched_text":"Type 2 diabetes mellitus with hyperglycemia","source_type":"concept_name","similarity_score":0.89,"explanation":"Semantic similarity of 0.89 between the query embedding and this concept's embedding","similarity_explanation":"Semantic similarity of 0.89 between the query embedding and this concept's embedding"},{"concept_id":35206879,"concept_name":"Type 2 diabetes mellitus without complications","concept_code":"E11.9","vocabulary_id":"ICD10CM","domain_id":"Condition","concept_class_id":"4-char nonbill code","standard_concept":"S","matched_text":"Type 2 diabetes mellitus without complications","source_type":"concept_name","similarity_score":0.86,"explanation":"Semantic similarity of 0.86 between the query embedding and this concept's embedding","similarity_explanation":"Semantic similarity of 0.86 between the query embedding and this concept's embedding"}],"search_metadata":{"original_query":"Type 2 diabetes mellitus","algorithm_used":"semantic","similarity_threshold":0.8,"total_candidates":3,"results_returned":3,"processing_time_ms":24,"totals_are_lower_bound":false,"source_concept_id":201826,"embedding_latency_ms":18},"source_concept":{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S"}},"meta":{"request_id":"req_01HQZX3M5K8P2N7R4T6V9W1Y3B","timestamp":"2026-09-06T13:45:45.958Z","vocab_release":"2026.1","search":{"query":"Type 2 diabetes mellitus","total_results":3,"filters_applied":{"algorithm":"semantic","vocabulary_ids":["SNOMED","ICD10CM"],"include_invalid":false,"exclude_self":true}},"pagination":{"page":1,"page_size":10,"total_items":3,"total_pages":1,"has_next":false,"has_previous":false}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"search/get-search-similar-by-id.mdx"}},"/search/suggest":{"get":{"summary":"Search Suggest","description":"Returns valid OMOP concepts using exact published synonyms, concept-name prefixes and substrings, and source-code prefixes. The endpoint does not calculate or return a relevance or confidence score. Ordering Clinical utility is the outer ordering tier under the API's [default ranking policy](/api-reference/search/basic-search): questionnaire answer-list entries, survey values and LOINC structural parts rank last by default, and Standard concepts outrank non-standard ones. Within one utility tier, exact primary names and exact source codes lead, followed by exact published synonyms, name prefixes, code prefixes, and name substrings. Core clinical domains are preferred next, followed by shorter completion text, vocabulary authority, alphabetical name, and concept_id. Before that policy existed, this endpoint ordered by standard_concept, LENGTH(concept_name), concept_name alone — effectively \"the shortest standard name starting with what you typed\" — so diabetes returned the LOINC answer-list entry named Diabetes (8 characters) ahead of 201820 Diabetes mellitus (17).","operationId":"getSearchSuggest","tags":["Search"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"query","in":"query","required":true,"description":"Partial concept name, exact synonym, or source-code prefix. Must contain between 2 and 100 characters.","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"diab"},{"name":"page_size","in":"query","required":false,"description":"Number of suggestions to return. Minimum 1, maximum 100.","schema":{"type":"integer","default":10,"maximum":100},"example":5},{"name":"vocabulary_ids","in":"query","required":false,"description":"Comma-separated vocabulary IDs, such as SNOMED,ICD10CM. In a mixed list, vocabularies the API key cannot access are omitted; a list containing only inaccessible vocabularies returns 403.","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"SNOMED"},{"name":"domain_ids","in":"query","required":false,"description":"Comma-separated domain IDs, such as Condition,Drug.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"concept_class_ids","in":"query","required":false,"description":"Comma-separated concept classes. Explicit requests for Answer, Survey, Value, or another normally demoted class disable the default non-clinical demotion for that filtered result set.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"include_context","in":"query","required":false,"description":"When true, adds a context object containing the suggestion's vocabulary, domain, and concept class.","schema":{"type":"boolean","default":false}},{"name":"vocab_release","in":"query","required":false,"description":"Vocabulary release to query. Defaults to the current release.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"query":{"type":"string"},"suggestions":{"type":"array","items":{"type":"object","properties":{"suggestion":{"type":"string"},"concept_id":{"type":"integer"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true}},"additionalProperties":true}}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"},"search":{"type":"object","properties":{"query":{"type":"string"},"total_results":{"type":"integer"},"filters_applied":{"type":"object","properties":{"context":{"type":"boolean"}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"query":"diab","suggestions":[{"suggestion":"Type 2 diabetes mellitus","concept_id":201826,"concept_code":"44054006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S"}]},"meta":{"request_id":"req_suggest_123","timestamp":"2026-09-05T12:00:00.000Z","vocab_release":"2026.2","search":{"query":"diab","total_results":1,"filters_applied":{"context":false}}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"search/search-suggest.mdx"}},"/vocabularies":{"get":{"summary":"List Vocabularies","description":"Get a paginated list of all available OMOP medical vocabularies - SNOMED CT, ICD-10, LOINC, RxNorm, ATC, HCPCS, and 120+ OHDSI-supported terminologies.","operationId":"getVocabularies","tags":["Vocabularies"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"page","in":"query","required":false,"description":"Page number for pagination (1-based).","schema":{"type":"integer","default":1}},{"name":"page_size","in":"query","required":false,"description":"Number of vocabularies to return per page. Values above 200 are clamped to 200.","schema":{"type":"integer","default":20}},{"name":"include_stats","in":"query","required":false,"description":"Include release-scoped concept and standard-concept counts for each vocabulary. Counts reflect the selected release.","schema":{"type":"boolean","default":false}},{"name":"sort_by","in":"query","required":false,"description":"Sort field. Options: name, priority, updated","schema":{"type":"string","pattern":"^[^\\u0000]*$","default":"name"}},{"name":"sort_order","in":"query","required":false,"description":"Sort order. Options: asc, desc","schema":{"type":"string","pattern":"^[^\\u0000]*$","default":"asc"}},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version (e.g., \"2025.1\"). Defaults to the latest available release.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"vocabularies":{"type":"array","items":{"type":"object","properties":{"vocabulary_id":{"type":"string"},"vocabulary_name":{"type":"string"},"vocabulary_reference":{"type":"string"},"vocabulary_version":{"type":"string"},"vocabulary_concept_id":{"type":"integer"},"concept_count":{"type":"integer"},"standard_concept_count":{"type":"integer"}},"additionalProperties":true}}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"vocab_release":{"type":"string"},"timestamp":{"type":"string"},"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"vocabularies":[{"vocabulary_id":"SNOMED","vocabulary_name":"Systematized Nomenclature of Medicine Clinical Terms","vocabulary_reference":"SNOMED CT","vocabulary_version":"US Edition 20240301","vocabulary_concept_id":45756746,"concept_count":354652,"standard_concept_count":298456},{"vocabulary_id":"ICD10CM","vocabulary_name":"International Classification of Diseases, Tenth Revision, Clinical Modification","vocabulary_reference":"CMS","vocabulary_version":"2024","vocabulary_concept_id":45756681,"concept_count":95678,"standard_concept_count":0},{"vocabulary_id":"LOINC","vocabulary_name":"Logical Observation Identifiers Names and Codes","vocabulary_reference":"Regenstrief Institute","vocabulary_version":"2.76","vocabulary_concept_id":45756747,"concept_count":260142,"standard_concept_count":226941},{"vocabulary_id":"RxNorm","vocabulary_name":"RxNorm","vocabulary_reference":"National Library of Medicine","vocabulary_version":"2024-03-04","vocabulary_concept_id":45756748,"concept_count":125634,"standard_concept_count":108742}]},"meta":{"request_id":"req_abc123","vocab_release":"2025.1","timestamp":"2025-01-05T10:00:00Z","pagination":{"page":1,"page_size":20,"total_items":25,"total_pages":2,"has_next":true,"has_previous":false}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"vocabularies/list-vocabularies.mdx"}},"/vocabularies/{vocabularyId}":{"get":{"summary":"Get Vocabulary Details","description":"Retrieve details about a specific vocabulary including its name, reference, version, and concept identifier.","operationId":"getVocabulariesByVocabularyId","tags":["Vocabularies"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"vocabularyId","in":"path","required":true,"description":"The vocabulary identifier (e.g., \"SNOMED\", \"ICD10CM\", \"LOINC\", \"RxNorm\")","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"SNOMED"},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version (e.g., \"2025.1\")","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"vocabulary_id":{"type":"string"},"vocabulary_name":{"type":"string"},"vocabulary_reference":{"type":"string"},"vocabulary_version":{"type":"string"},"vocabulary_concept_id":{"type":"integer"}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true,"required":["success","data","meta"]},"example":{"success":true,"data":{"vocabulary_id":"SNOMED","vocabulary_name":"Systematized Nomenclature of Medicine Clinical Terms","vocabulary_reference":"SNOMED International","vocabulary_version":"2024-07-01","vocabulary_concept_id":45756746},"meta":{"request_id":"req_vocab_123","timestamp":"2024-12-22T10:00:00Z","vocab_release":"2025.1"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"vocabularies/get-vocabulary.mdx"}},"/vocabularies/{vocabularyId}/concepts":{"get":{"summary":"Get Vocabulary Concepts","description":"Get concepts within a specific OMOP vocabulary with pagination - browse SNOMED, ICD-10, LOINC, RxNorm, or any of 120+ vocabulary code lists.","operationId":"getVocabulariesByVocabularyIdConcepts","tags":["Vocabularies"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"vocabularyId","in":"path","required":true,"description":"The vocabulary identifier (e.g., \"SNOMED\", \"ICD10CM\", \"LOINC\", \"RxNorm\").","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"SNOMED"},{"name":"search","in":"query","required":false,"description":"Search term to filter concepts by name or code.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"page","in":"query","required":false,"description":"Page number for pagination (1-based, max 1000). For large vocabularies, use the search parameter to filter results instead of deep pagination.","schema":{"type":"integer","default":1}},{"name":"page_size","in":"query","required":false,"description":"Number of concepts per page. Values above 200 are clamped to 200.","schema":{"type":"integer","default":20},"example":10},{"name":"standard_concept",