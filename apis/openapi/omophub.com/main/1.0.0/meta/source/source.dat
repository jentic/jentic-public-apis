equired":true,"content":{"application/json":{"schema":{"type":"object","properties":{"concept_ids":{"type":"array","items":{"type":"integer"},"minItems":1,"maxItems":100,"description":"Array of concept IDs to retrieve (max: 100)"},"include_relationships":{"type":"boolean","default":false,"description":"Include relationships for all concepts"},"include_synonyms":{"type":"boolean","default":false,"description":"Include synonyms for all concepts"},"include_mappings":{"type":"boolean","default":false,"description":"Include cross-vocabulary mappings for all concepts"},"vocabulary_filter":{"type":"array","items":{"type":"string","pattern":"^[^\\u0000]*$"},"description":"Filter results to specific vocabularies"},"standard_only":{"type":"boolean","default":false,"description":"Only return standard concepts"}},"additionalProperties":false,"required":["concept_ids"]},"example":{"concept_ids":[320128,201826,4329847],"include_relationships":true,"include_synonyms":true}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"concepts":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"},"invalid_reason":{"nullable":true},"synonyms":{"type":"array","items":{"type":"string"}},"relationships":{"type":"object","properties":{"parents":{"type":"array","items":{"type":"object","properties":{"relationship_id":{"type":"string"},"concept_id":{"type":"integer"},"concept_name":{"type":"string"}},"additionalProperties":true}},"children":{"type":"array","items":{}}},"additionalProperties":true}},"additionalProperties":true}},"failed_concepts":{"type":"array","items":{}},"summary":{"type":"object","properties":{"total_requested":{"type":"integer"},"successful_retrievals":{"type":"integer"},"failed_retrievals":{"type":"integer"},"vocabularies_represented":{"type":"array","items":{"type":"string"}},"domains_represented":{"type":"array","items":{"type":"string"}}},"additionalProperties":true}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"},"query_time_ms":{"type":"number"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"concepts":[{"concept_id":320128,"concept_name":"Essential hypertension","concept_code":"59621000","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"1970-01-01","valid_end_date":"2099-12-31","invalid_reason":null,"synonyms":["High blood pressure"],"relationships":{"parents":[{"relationship_id":"Is a","concept_id":4182210,"concept_name":"Hypertensive disorder"}],"children":[]}},{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"1970-01-01","valid_end_date":"2099-12-31","invalid_reason":null,"synonyms":[{"concept_synonym_name":"Type II diabetes mellitus","language_concept_id":4180186,"language_concept_name":"English"},{"concept_synonym_name":"Adult-onset diabetes","language_concept_id":4180186,"language_concept_name":"English"}],"relationships":[{"relationship_id":"Is a","target_concept_id":73211009,"target_concept_name":"Diabetes mellitus","target_vocabulary_id":"SNOMED","relationship_direction":"outbound"}]},{"concept_id":4329847,"concept_name":"Myocardial infarction","concept_code":"22298006","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"1970-01-01","valid_end_date":"2099-12-31","invalid_reason":null,"synonyms":[{"concept_synonym_name":"Heart attack","language_concept_id":4180186,"language_concept_name":"English"},{"concept_synonym_name":"MI - Myocardial infarction","language_concept_id":4180186,"language_concept_name":"English"}],"relationships":[{"relationship_id":"Is a","target_concept_id":134057,"target_concept_name":"Acute myocardial infarction","target_vocabulary_id":"SNOMED","relationship_direction":"inbound"}]}],"failed_concepts":[],"summary":{"total_requested":3,"successful_retrievals":3,"failed_retrievals":0,"vocabularies_represented":["SNOMED"],"domains_represented":["Condition"]}},"meta":{"request_id":"req_batch_123","timestamp":"2024-12-22T10:00:00Z","vocab_release":"2025.2","query_time_ms":45.2}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"concepts/batch-concepts.mdx"}},"/concepts/by-code":{"get":{"summary":"Missing concept-code path parameters guidance","description":"Returns the canonical /concepts/by-code/{vocabularyId}/{conceptCode} shape to use.","operationId":"getConceptsByCode","tags":["Concepts"],"security":[{"bearerAuth":[]}],"parameters":[],"responses":{"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-disposition":{"status":"guidance","reason":"Intentional 400 response for omitted path parameters","successor":"/v1/concepts/by-code/{vocabularyId}/{conceptCode}"}}},"/concepts/by-code/{vocabularyId}/{conceptCode}":{"get":{"summary":"Get Concept by Code","description":"Retrieve concept information using the vocabulary-specific code instead of the universal concept ID. This is useful when working with source data that contains original codes.","operationId":"getConceptsByCodeByVocabularyIdByConceptCode","tags":["Concepts"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"vocabularyId","in":"path","required":true,"description":"The vocabulary identifier (e.g., \"SNOMED\", \"ICD10CM\", \"LOINC\")","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"SNOMED"},{"name":"conceptCode","in":"path","required":true,"description":"The vocabulary-specific code (e.g., \"59621000\" for SNOMED, \"I10\" for ICD10CM)","schema":{"type":"string","pattern":"^[^\\u0000]*$"},"example":"59621000"},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release to use (e.g., \"2025.2\"). Uses latest if not specified.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"include_synonyms","in":"query","required":false,"description":"Include concept synonyms in the response","schema":{"type":"boolean","default":false}},{"name":"include_relationships","in":"query","required":false,"description":"Include concept relationships and mappings","schema":{"type":"boolean","default":false}},{"name":"include_hierarchy","in":"query","required":false,"description":"Include concept hierarchy information","schema":{"type":"boolean","default":false}},{"name":"include_invalid","in":"query","required":false,"description":"Include concepts with invalid_reason set (deprecated/updated concepts). Set to false to only return valid concepts.","schema":{"type":"boolean","default":true}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties