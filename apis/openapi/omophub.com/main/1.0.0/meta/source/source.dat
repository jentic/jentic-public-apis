{"openapi":"3.0.0","info":{"title":"OMOPHub Healthcare Vocabulary API","version":"1.0.0","description":"A comprehensive healthcare vocabulary API platform providing secure, compliant access to medical terminologies and OHDSI vocabulary services. CPT4 access requires the API-key owner to complete annual UMLS validation in the OMOPHub Dashboard and expires each January 30 UTC. Unlicensed direct or CPT4-only requests return 403 vocabulary_restricted; mixed search filters omit CPT4 and return accessible vocabularies. GPI and MedDRA remain unavailable.","contact":{"name":"OMOPHub API Support","email":"support@omophub.com","url":"https://docs.omophub.com"},"license":{"name":"Commercial License","url":"https://omophub.com/license"},"termsOfService":"https://omophub.com/terms"},"servers":[{"url":"https://api.omophub.com/v1","description":"Production server"}],"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"API_KEY"}},"schemas":{"Concept":{"type":"object","properties":{"concept_id":{"type":"integer","example":201826,"description":"Unique concept identifier"},"concept_name":{"type":"string","example":"Type 2 diabetes mellitus","description":"Primary concept name"},"concept_code":{"type":"string","example":"44054006","description":"Concept code within the vocabulary"},"vocabulary_id":{"type":"string","example":"SNOMED","description":"Vocabulary identifier"},"vocabulary_name":{"type":"string","example":"Systematized Nomenclature of Medicine Clinical Terms","description":"Full vocabulary name"},"domain_id":{"type":"string","example":"Condition","description":"Domain identifier"},"concept_class_id":{"type":"string","example":"Clinical Finding","description":"Concept class identifier"},"standard_concept":{"type":"string","nullable":true,"example":"S","enum":["S","C","N"],"description":"Standard concept status (S=Standard, C=Classification, N=Non-standard, null=Unspecified/Unknown)"},"valid_start_date":{"type":"string","format":"date","example":"1970-01-01","description":"Date when concept became valid"},"valid_end_date":{"type":"string","format":"date","example":"2099-12-31","description":"Date when concept becomes invalid"},"invalid_reason":{"type":"string","nullable":true,"description":"Reason for invalidity (if applicable)"},"relevance_score":{"type":"number","format":"float","minimum":0,"maximum":1,"example":0.98,"description":"Search relevance score"}},"required":["concept_id","concept_name","concept_code","vocabulary_id","domain_id"]},"Vocabulary":{"type":"object","properties":{"vocabulary_id":{"type":"string","example":"SNOMED"},"vocabulary_name":{"type":"string","example":"Systematized Nomenclature of Medicine Clinical Terms"},"vocabulary_reference":{"type":"string","example":"https://www.snomed.org/"},"vocabulary_version":{"type":"string","example":"2024-03"},"vocabulary_concept_id":{"type":"integer","example":44819096},"total_concepts":{"type":"integer","example":354652},"standard_concepts":{"type":"integer","example":298456},"classification_concepts":{"type":"integer","example":56196},"release_date":{"type":"string","format":"date","example":"2024-03-01"},"description":{"type":"string","example":"International healthcare terminology"}},"required":["vocabulary_id","vocabulary_name"]},"Domain":{"type":"object","properties":{"domain_id":{"type":"string","example":"Condition"},"domain_name":{"type":"string","example":"Condition"},"domain_concept_id":{"type":"integer","example":19},"description":{"type":"string","example":"A condition is a clinical or pathological state"},"concept_count":{"type":"integer","example":125643}},"required":["domain_id","domain_name","domain_concept_id"]},"ConceptClass":{"type":"object","properties":{"concept_class_id":{"type":"string","example":"Clinical Finding"},"concept_class_name":{"type":"string","example":"Clinical Finding"},"concept_class_concept_id":{"type":"integer","example":4167179},"concept_count":{"type":"integer","example":98765}},"required":["concept_class_id","concept_class_name","concept_class_concept_id"]},"Relationship":{"type":"object","properties":{"relationship_id":{"type":"string","example":"Is a"},"relationship_name":{"type":"string","example":"Is a"},"is_hierarchical":{"type":"boolean","example":true},"defines_ancestry":{"type":"boolean","example":true},"reverse_relationship_id":{"type":"string","example":"Subsumes"},"relationship_concept_id":{"type":"integer","example":4180186}},"required":["relationship_id","relationship_name","is_hierarchical"]},"PaginationMeta":{"type":"object","properties":{"page":{"type":"integer","example":1,"description":"Current page number"},"page_size":{"type":"integer","example":20,"description":"Items per page"},"total_items":{"type":"integer","example":157,"description":"Total number of items"},"total_pages":{"type":"integer","example":8,"description":"Total number of pages"},"has_next":{"type":"boolean","example":true,"description":"Whether there are more pages"},"has_previous":{"type":"boolean","example":false,"description":"Whether there are previous pages"}},"required":["page","page_size","total_items","total_pages","has_next","has_previous"]},"ApiResponse":{"type":"object","properties":{"success":{"type":"boolean","example":true},"data":{"type":"array","items":{"$ref":"#/components/schemas/Concept"}},"meta":{"type":"object","properties":{"request_id":{"type":"string","example":"req_abc123def456"},"timestamp":{"type":"string","format":"date-time","example":"2024-01-15T10:30:00Z"},"vocab_release":{"type":"string","example":"2024-03"},"pagination":{"$ref":"#/components/schemas/PaginationMeta"}},"required":["request_id","timestamp"]}},"required":["success","data","meta"]},"ErrorResponse":{"type":"object","properties":{"success":{"type":"boolean","example":false},"error":{"type":"object","properties":{"code":{"type":"string","example":"vocabulary_not_found"},"message":{"type":"string","example":"Vocabulary not found"},"details":{"oneOf":[{"type":"object","additionalProperties":true},{"type":"array","items":{"type":"object"}}]}},"required":["code","message"]},"meta":{"type":"object","properties":{"request_id":{"type":"string","example":"req_error123"},"timestamp":{"type":"string","format":"date-time","example":"2024-01-15T10:30:00Z"}},"required":["request_id","timestamp"]}},"required":["success","error"]},"MappingQuality":{"type":"object","properties":{"source_vocabulary":{"type":"string","example":"ICD10CM","description":"Source vocabulary identifier"},"target_vocabulary":{"type":"string","example":"SNOMED","description":"Target vocabulary identifier"},"total_concepts":{"type":"integer","example":72458,"description":"Valid concepts in the source vocabulary; denominator of coverage_percentage"},"mapped_concepts":{"type":"integer","example":52891,"description":"Distinct source concepts with a valid relationship to the target vocabulary; numerator of coverage_percentage and sum of mapping_types counts"},"coverage_percentage":{"type":"number","format":"float","example":73,"description":"100 × mapped_concepts / total_concepts, or 0 when total_concepts is 0"},"mapping_types":{"type":"array","items":{"type":"object","properties":{"type":{"type":"string","enum":["direct","equivalent","hierarchical","other"],"example":"direct","description":"Best available mapping type for this group of source concepts"},"count":{"type":"integer","example":45000,"description":"Distinct mapped source concepts assigned to this type"},"percentage":{"type":"number","format":"float","example":85.1}},"required":["type","count","percentage"]},"description":"Mutually exclusive breakdown of mapped source concepts; counts sum to mapped_concepts"},"quality_score":{"type":"integer","minimum":0,"maximum":100,"example":78,"description":"Rounded heuristic: coverage contributes 50%, direct mapping share 30%, and mapping-type diversity 20%"},"issues":{"type":"array","items":{"type":"object","properties":{"issue_type":{"type":"string","example":"unmapped_concepts"},"count":{"type":"integer","example":19567},"severity":{"type":"string","enum":["low","medium","high"],"example":"medium"},"examples":{"type":"array","items":{"type":"object"}}}},"description":"Identified quality issues"}},"required":["source_vocabulary","target_vocabulary","total_concepts","mapped_concepts","coverage_percentage","mapping_types","quality_score","issues"]},"MappingCoverage":{"type":"object","properties":{"source_vocabulary":{"type":"string","example":"SNOMED","description":"Source vocabulary identifier"},"target_vocabulary":{"type":"string","example":"ICD10CM","description":"Target vocabulary identifier"},"overall_coverage":{"type":"number","format":"float","example":65.5,"description":"Overall mapping coverage percentage"},"domain_coverage":{"type":"array","items":{"type":"object","properties":{"domain_id":{"type":"string","example":"Condition"},"domain_name":{"type":"string","example":"Condition"},"source_concepts":{"type":"integer","example":234567},"mapped_concepts":{"type":"integer","example":178234},"coverage_percentage":{"type":"number","format":"float","example":75.9}}},"description":"Coverage breakdown by domain"},"unmapped_concepts":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer","example":4087682},"concept_name":{"type":"string","example":"Finding related to ability to move"},"domain_id":{"type":"string","example":"Condition"},"reason":{"type":"string","example":"No direct mapping"}}},"description":"Sample of unmapped concepts (up to 100)"}},"required":["source_vocabulary","target_vocabulary","overall_coverage","domain_coverage"]},"MappingValidationRequest":{"type":"object","properties":{"mappings":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"object","properties":{"source_concept_id":{"type":"integer","example":201826,"description":"Source concept ID"},"target_concept_id":{"type":"integer","example":443735,"description":"Target concept ID"},"mapping_type":{"type":"string","example":"Maps to","description":"Type of mapping relationship"}},"required":["source_concept_id","target_concept_id","mapping_type"]}}},"required":["mappings"]},"MappingValidationResult":{"type":"object","properties":{"source_concept_id":{"type":"integer","example":201826},"target_concept_id":{"type":"integer","example":443735},"mapping_type":{"type":"string","example":"Maps to"},"is_valid":{"type":"boolean","example":true,"description":"Whether the mapping is valid"},"validation_score":{"type":"number","format":"float","minimum":0,"maximum":1,"example":0.85,"description":"Validation confidence score (0-1)"},"issues":{"type":"array","items":{"type":"string"},"example":["Domain mismatch for direct mapping"],"description":"List of validation issues"},"recommendations":{"type":"array","items":{"type":"string"},"example":["Consider using equivalent or hierarchical mapping"],"description":"Recommendations for improving the mapping"}},"required":["source_concept_id","target_concept_id","mapping_type","is_valid","validation_score","issues","recommendations"]}},"responses":{"BadRequest":{"description":"Bad request or validation failure","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"Unauthorized":{"description":"Authentication is required or invalid","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"Forbidden":{"description":"The authenticated caller is not permitted to perform this operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"NotFound":{"description":"The requested resource was not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"RateLimited":{"description":"The request exceeded an applicable rate limit","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"ServerError":{"description":"The server could not complete the request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}},"paths":{"/":{"get":{"summary":"Get API information","operationId":"getRoot","tags":["System"],"security":[],"parameters":[],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/app.ts","x-documentation-disposition":{"status":"system","reason":"API discovery resource, not a vocabulary operation"}}},"/concept-classes":{"get":{"summary":"Get Concept Classes","description":"Retrieve all OMOP concept classes that categorize medical concepts - Clinical Finding, Ingredient, Procedure, and the complete OHDSI classification set.","operationId":"getConceptClasses","tags":["Domains"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"vocabulary_ids","in":"query","required":false,"description":"Filter concept classes to those used by specific vocabularies. Comma-separated list. Example: SNOMED,RxNorm,ICD10CM","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"include_stats","in":"query","required":false,"description":"Include concept counts and vocabulary coverage for each concept class.","schema":{"type":"boolean","default":false},"example":true},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version to query Example: 2025.1","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"concept_classes":{"type":"array","items":{"type":"object","properties":{"concept_class_id":{"type":"string"},"concept_class_name":{"type":"string"},"concept_class_concept_id":{"type":"integer"},"concept_count":{"type":"integer"},"vocabulary_coverage":{"type":"array","items":{"type":"string"}}},"additionalProperties":true}}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"vocab_release":{"type":"string"},"timestamp":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"concept_classes":[{"concept_class_id":"Clinical Finding","concept_class_name":"Clinical Finding","concept_class_concept_id":441840,"concept_count":425891,"vocabulary_coverage":["SNOMED","Read"]},{"concept_class_id":"Ingredient","concept_class_name":"Ingredient","concept_class_concept_id":441828,"concept_count":45678,"vocabulary_coverage":["RxNorm","SNOMED"]},{"concept_class_id":"Procedure","concept_class_name":"Procedure","concept_class_concept_id":441838,"concept_count":198765,"vocabulary_coverage":["SNOMED","HCPCS"]}]},"meta":{"request_id":"req_abc123","vocab_release":"2025.1","timestamp":"2025-01-05T10:00:00Z"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"domains/get-concept-classes.mdx"}},"/concepts":{"get":{"summary":"Search medical concepts","operationId":"getConcepts","tags":["Concepts"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"query","in":"query","schema":{"type":"string"},"description":"Search query"},{"name":"vocabulary","in":"query","schema":{"type":"string","enum":["SNOMED","ICD10CM","LOINC","RXNORM"]},"description":"Filter by vocabulary"}],"deprecated":true,"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","additionalProperties":true}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-disposition":{"status":"deprecated","reason":"Compatibility alias retained for existing clients","successor":"/v1/search/concepts"}}},"/concepts/{conceptId}":{"get":{"summary":"Get Concept","description":"Retrieve comprehensive information about a medical concept using its unique concept ID. This endpoint provides full concept details including synonyms, relationships, and classification information.","operationId":"getConceptsByConceptId","tags":["Concepts"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"conceptId","in":"path","required":true,"description":"The unique concept identifier (e.g., 320128 for \"Essential hypertension\")","schema":{"type":"integer"},"example":320128},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release to use (e.g., \"2025.2\"). Uses latest if not specified.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"include_relationships","in":"query","required":false,"description":"Include related concepts (parents, children, mappings)","schema":{"type":"boolean","default":false}},{"name":"include_synonyms","in":"query","required":false,"description":"Include all synonyms and alternative names","schema":{"type":"boolean","default":false}},{"name":"include_hierarchy","in":"query","required":false,"description":"Include ancestor and descendant concepts in hierarchy","schema":{"type":"boolean","default":false}},{"name":"include_invalid","in":"query","required":false,"description":"Include concepts with invalid_reason set (deprecated/updated concepts). Set to false to only return valid concepts.","schema":{"type":"boolean","default":true}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"},"invalid_reason":{"nullable":true},"is_valid":{"type":"boolean"},"is_standard":{"type":"boolean"},"is_classification":{"type":"boolean"},"synonyms":{"type":"array","items":{"type":"string"}},"relationships":{"type":"object","properties":{"parents":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"relationship_id":{"type":"string"}},"additionalProperties":true}},"children":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"relationship_id":{"type":"string"}},"additionalProperties":true}}},"additionalProperties":true}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"concept_id":320128,"concept_name":"Essential hypertension","concept_code":"59621000","vocabulary_id":"SNOMED","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","valid_start_date":"1970-01-01","valid_end_date":"2099-12-31","invalid_reason":null,"is_valid":true,"is_standard":true,"is_classification":false,"synonyms":["Primary hypertension","Idiopathic hypertension","High blood pressure"],"relationships":{"parents":[{"concept_id":316866,"concept_name":"Hypertensive disorder","relationship_id":"Is a"}],"children":[{"concept_id":4124681,"concept_name":"Accelerated hypertension","relationship_id":"Subsumes"}]}},"meta":{"request_id":"req_concept_123","timestamp":"2024-12-22T10:00:00Z","vocab_release":"2025.2"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"concepts/get-concept.mdx"}},"/concepts/{conceptId}/ancestors":{"get":{"summary":"Get Concept Ancestors","description":"Retrieve all ancestor OMOP concepts for a given concept - hierarchical context, classification paths, and parent terms for concept set expansion.","operationId":"getConceptsByConceptIdAncestors","tags":["Hierarchy"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"conceptId","in":"path","required":true,"description":"The unique identifier of the concept to retrieve ancestors for Example: 201826 (Type 2 diabetes mellitus)","schema":{"type":"integer"},"example":201826},{"name":"vocabulary_ids","in":"query","required":false,"description":"Filter ancestors to specific vocabularies (comma-separated) Example: SNOMED,ICD10CM","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"domain_ids","in":"query","required":false,"description":"Filter ancestors to specific domains (comma-separated) Example: Condition,Observation","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"max_levels","in":"query","required":false,"description":"Maximum number of hierarchy levels to traverse Range: 1-20","schema":{"type":"integer","default":10},"example":5},{"name":"include_distance","in":"query","required":false,"description":"Include hierarchy_level field for each ancestor (distance from source concept)","schema":{"type":"boolean","default":false},"example":true},{"name":"include_paths","in":"query","required":false,"description":"Include path_length field for each ancestor","schema":{"type":"boolean","default":false},"example":true},{"name":"include_invalid","in":"query","required":false,"description":"Include deprecated/invalid concepts in ancestry (by default they are excluded)","schema":{"type":"boolean","default":false}},{"name":"page","in":"query","required":false,"description":"Page number for pagination (1-based)","schema":{"type":"integer","default":1}},{"name":"max_results","in":"query","required":false,"description":"Maximum size of the ancestor set to retrieve before pagination is applied. Range: 1-5000 Defaults to the maximum, so paging through the response returns every ancestor that matches this request - those within max_levels and any vocabulary_ids / domain_ids filters you supplied. (relationship_types is not applied - see above.) It is not necessarily the concept's entire ancestry: max_levels defaults to 10, so more distant ancestors are excluded, and truncated does not flag that (it reports the row cap only). Pass max_levels=20 if you need the full ancestry. Results are ordered by ascending min_levels_of_separation. When max_results truncates the set, the nearest ancestors - direct parents before grandparents and roots - are preserved. Concepts at the same separation have no semantic precedence over one another.","schema":{"type":"integer","default":5000}},{"name":"page_size","in":"query","required":false,"description":"Number of ancestor concepts to return per page. Values above 200 are clamped to 200.","schema":{"type":"integer","default":100}},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version to query Example: 2025.1","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"vocabulary_id":{"type":"string"},"ancestors":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"vocabulary_name":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"level":{"type":"integer"},"min_levels_of_separation":{"type":"integer"},"max_levels_of_separation":{"type":"integer"},"relationship_id":{"type":"string"},"relationship_name":{"type":"string"},"hierarchy_level":{"type":"integer"},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"},"invalid_reason":{"nullable":true,"type":"string"}},"additionalProperties":true}},"hierarchy_summary":{"type":"object","properties":{"total_ancestors":{"type":"integer"},"max_hierarchy_depth":{"type":"integer"},"unique_vocabularies":{"type":"array","items":{"type":"string"}},"relationship_types_used":{"type":"array","items":{"type":"string"}},"truncated":{"type":"boolean"},"result_limit":{"type":"integer"}},"additionalProperties":true}},"additionalProperties":true},"meta":{"type":"object","properties":{"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true},"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","vocabulary_id":"SNOMED","ancestors":[{"concept_id":73211009,"concept_name":"Diabetes mellitus","concept_code":"73211009","vocabulary_id":"SNOMED","vocabulary_name":"SNOMED Clinical Terms","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","level":1,"min_levels_of_separation":1,"max_levels_of_separation":1,"relationship_id":"Is a","relationship_name":"Is a","hierarchy_level":1,"valid_start_date":"1970-01-01","valid_end_date":"2099-12-31","invalid_reason":null},{"concept_id":362969004,"concept_name":"Disorder of endocrine system","concept_code":"362969004","vocabulary_id":"SNOMED","vocabulary_name":"SNOMED Clinical Terms","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","level":2,"min_levels_of_separation":2,"max_levels_of_separation":2,"relationship_id":"Is a","relationship_name":"Is a","hierarchy_level":2,"valid_start_date":"2002-01-31","valid_end_date":"2099-12-31","invalid_reason":null},{"concept_id":64572001,"concept_name":"Disease","concept_code":"64572001","vocabulary_id":"SNOMED","vocabulary_name":"SNOMED Clinical Terms","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","level":3,"min_levels_of_separation":3,"max_levels_of_separation":3,"relationship_id":"Is a","relationship_name":"Is a","hierarchy_level":3,"valid_start_date":"1970-01-01","valid_end_date":"2099-12-31","invalid_reason":null}],"hierarchy_summary":{"total_ancestors":3,"max_hierarchy_depth":3,"unique_vocabularies":["SNOMED"],"relationship_types_used":["Is a"],"truncated":false,"result_limit":5000}},"meta":{"pagination":{"page":1,"page_size":100,"total_items":3,"total_pages":1,"has_next":false,"has_previous":false},"request_id":"req_ancestors_201826_20250104_103100","timestamp":"2025-01-04T10:31:00Z","vocab_release":"2025.1"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"hierarchy/get-concept-ancestors.mdx"}},"/concepts/{conceptId}/descendants":{"get":{"summary":"Get Concept Descendants","description":"Retrieve all descendant OMOP concepts for a given concept - hierarchical children and specialized terms for phenotype and cohort definitions.","operationId":"getConceptsByConceptIdDescendants","tags":["Hierarchy"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"conceptId","in":"path","required":true,"description":"The unique identifier of the concept to retrieve descendants for Example: 201820 (Diabetes mellitus)","schema":{"type":"integer"},"example":201820},{"name":"vocabulary_ids","in":"query","required":false,"description":"Filter descendants to specific vocabularies (comma-separated) Example: SNOMED,ICD10CM","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"domain_ids","in":"query","required":false,"description":"Filter descendants to specific domains (comma-separated) Example: Condition,Drug","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"max_levels","in":"query","required":false,"description":"Maximum number of hierarchy levels to traverse downward Range: 1-20","schema":{"type":"integer","default":10},"example":3},{"name":"include_distance","in":"query","required":false,"description":"Include hierarchy_level field for each descendant (distance from source concept)","schema":{"type":"boolean","default":false},"example":true},{"name":"include_paths","in":"query","required":false,"description":"Include path_length field for each descendant","schema":{"type":"boolean","default":false}},{"name":"include_invalid","in":"query","required":false,"description":"Include deprecated/invalid concepts in descendants (by default they are excluded)","schema":{"type":"boolean","default":false}},{"name":"max_results","in":"query","required":false,"description":"Maximum size of the descendant set to retrieve before pagination is applied. Range: 1-5000 Defaults to the maximum, so paging through the response returns every descendant that matches this request - that is, those within max_levels and any domain_ids / vocabulary_ids filters you supplied. (relationship_types is not applied - see above.) It is not necessarily the concept's entire descendant closure: max_levels defaults to 10, so deeper descendants are excluded, and truncated does not flag that (it reports the row cap only). For a full closure, pass max_levels=20 as well. Lower max_results only if you deliberately want a partial set - note that total_items then reflects the truncated set, not the true descendant count. Results are ordered by ascending min_levels_of_separation. When max_results truncates the set, the nearest descendants - direct children before deeper specializations - are preserved. Concepts at the same separation have no semantic precedence over one another.","schema":{"type":"integer","default":5000}},{"name":"page","in":"query","required":false,"description":"Page number for pagination (1-based)","schema":{"type":"integer","default":1}},{"name":"page_size","in":"query","required":false,"description":"Number of descendant concepts to return per page. Values above 200 are clamped to 200.","schema":{"type":"integer","default":100}},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version to query Example: 2025.1","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"vocabulary_id":{"type":"string"},"descendants":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"vocabulary_name":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"level":{"type":"integer"},"min_levels_of_separation":{"type":"integer"},"max_levels_of_separation":{"type":"integer"},"relationship_id":{"type":"string"},"relationship_name":{"type":"string"},"hierarchy_level":{"type":"integer"},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"},"invalid_reason":{"nullable":true,"type":"string"}},"additionalProperties":true}},"hierarchy_summary":{"type":"object","properties":{"total_descendants":{"type":"integer"},"truncated":{"type":"boolean"},"result_limit":{"type":"integer"},"max_hierarchy_depth":{"type":"integer"},"unique_vocabularies":{"type":"array","items":{"type":"string"}},"relationship_types_used":{"type":"array","items":{"type":"string"}}},"additionalProperties":true}},"additionalProperties":true},"meta":{"type":"object","properties":{"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true},"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"concept_id":201820,"concept_name":"Diabetes mellitus","vocabulary_id":"SNOMED","descendants":[{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","vocabulary_name":"SNOMED Clinical Terms","domain_id":"Condition","concept_class_id":"Disorder","standard_concept":"S","level":1,"min_levels_of_separation":1,"max_levels_of_separation":1,"relationship_id":"Subsumes","relationship_name":"Subsumes","hierarchy_level":1,"valid_start_date":"2002-01-31","valid_end_date":"2099-12-31","invalid_reason":null},{"concept_id":201254,"concept_name":"Type 1 diabetes mellitus","concept_code":"46635009","vocabulary_id":"SNOMED","vocabulary_name":"SNOMED Clinical Terms","domain_id":"Condition","concept_class_id":"Disorder","standard_concept":"S","level":1,"min_levels_of_separation":1,"max_levels_of_separation":1,"relationship_id":"Subsumes","relationship_name":"Subsumes","hierarchy_level":1,"valid_start_date":"2002-01-31","valid_end_date":"2099-12-31","invalid_reason":null},{"concept_id":4130162,"concept_name":"Insulin treated type 2 diabetes mellitus","concept_code":"237599002","vocabulary_id":"SNOMED","vocabulary_name":"SNOMED Clinical Terms","domain_id":"Condition","concept_class_id":"Disorder","standard_concept":"S","level":2,"min_levels_of_separation":2,"max_levels_of_separation":2,"relationship_id":"Subsumes","relationship_name":"Subsumes","hierarchy_level":2,"valid_start_date":"2002-01-31","valid_end_date":"2099-12-31","invalid_reason":null}],"hierarchy_summary":{"total_descendants":847,"truncated":false,"result_limit":5000,"max_hierarchy_depth":6,"unique_vocabularies":["SNOMED"],"relationship_types_used":["Subsumes"]}},"meta":{"pagination":{"page":1,"page_size":100,"total_items":847,"total_pages":9,"has_next":true,"has_previous":false},"request_id":"req_descendants_123","timestamp":"2024-12-22T10:00:00Z","vocab_release":"2025.2"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"hierarchy/get-concept-descendants.mdx"}},"/concepts/{conceptId}/hierarchy":{"get":{"summary":"Get Concept Hierarchy","description":"Retrieve the complete OMOP hierarchy for a concept - ancestors and descendants in one unified view for phenotype development and concept sets.","operationId":"getConceptsByConceptIdHierarchy","tags":["Hierarchy"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"conceptId","in":"path","required":true,"description":"The unique identifier of the concept to retrieve hierarchy for Example: 201820 (Diabetes mellitus)","schema":{"type":"integer"},"example":201820},{"name":"format","in":"query","required":false,"description":"Response format for hierarchy data Options: flat, graph - flat: Returns ancestors and descendants as separate arrays (default) - graph: Returns nodes and edges for visualization (similar to OHDSI Athena)","schema":{"type":"string","pattern":"^[^\\u0000]*$","default":"flat"}},{"name":"vocabulary_ids","in":"query","required":false,"description":"Filter hierarchy to specific vocabularies (comma-separated) Example: SNOMED,ICD10CM","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"domain_ids","in":"query","required":false,"description":"Filter hierarchy to specific domains (comma-separated) Example: Condition,Drug","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"max_levels","in":"query","required":false,"description":"Maximum number of hierarchy levels to traverse in both directions Range: 1-20","schema":{"type":"integer","default":10},"example":3},{"name":"max_results","in":"query","required":false,"description":"Maximum number of results to return per direction (ancestors/descendants) for performance optimization Range: 1-5000 Recommended: Use 100-500 for interactive queries, up to 1000 for bulk analysis","schema":{"type":"integer","default":500}},{"name":"include_invalid","in":"query","required":false,"description":"Include deprecated/invalid concepts in hierarchy (by default they are excluded)","schema":{"type":"boolean","default":false}},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version to query Example: 2025.1","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":