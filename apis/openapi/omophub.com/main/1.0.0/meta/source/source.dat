rameters":[{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version (e.g., \"2025.1\")","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"concept_ids":{"type":"array","items":{"type":"object","additionalProperties":true},"description":"Array of starting concept IDs for traversal (1-50 concepts)"},"traversal_params":{"type":"object","additionalProperties":true,"description":"Optional parameters for controlling the traversal Maximum traversal depth (1-5) Array of relationship types to follow (default: [\"Is a\", \"Subsumes\", \"Mapped from\"]) Limit traversal to specific vocabularies Include invalid/deprecated concepts in traversal Include detailed path information in response Use breadth-first traversal (default is depth-first) Minimum relevance score filter (0.0-1.0) Maximum number of results to return","properties":{"max_depth":{"type":"integer","default":3,"description":"Maximum traversal depth (1-5)"},"relationship_types":{"type":"array","items":{"type":"object","additionalProperties":true},"description":"Array of relationship types to follow (default: [\"Is a\", \"Subsumes\", \"Mapped from\"])"},"vocabulary_ids":{"type":"array","items":{"type":"object","additionalProperties":true},"description":"Limit traversal to specific vocabularies"},"include_invalid":{"type":"boolean","default":true,"description":"Include invalid/deprecated concepts in traversal"},"include_paths":{"type":"boolean","default":false,"description":"Include detailed path information in response"},"breadth_first":{"type":"boolean","default":false,"description":"Use breadth-first traversal (default is depth-first)"},"min_score":{"type":"number","description":"Minimum relevance score filter (0.0-1.0)"},"page_size":{"type":"integer","default":100,"description":"Maximum number of results to return"}}}},"additionalProperties":false,"required":["con