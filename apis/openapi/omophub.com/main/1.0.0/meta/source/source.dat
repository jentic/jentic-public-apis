ry","required":false,"description":"Specific vocabulary release version (e.g., \"2025.1\")","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"queries":{"type":"array","items":{"type":"object","additionalProperties":true,"properties":{"query_id":{"type":"string","pattern":"^[^\\u0000]*$","description":"Unique identifier for this query (used to match results)"},"concept_id":{"type":"integer","description":"The OMOP concept ID to query hierarchy for"},"operation":{"type":"string","pattern":"^[^\\u0000]*$","description":"Type of hierarchy query. Options: ancestors, descendants, hierarchy, level Any other value fails that individual query with Unknown operation: (the surrounding batch still succeeds - check success on each result). Relationship traversal is not available here; use [GET /v1/concepts/{concept_id}/relationships](/api-reference/relationships/get-concept-relationships) or [POST /v1/concepts/relationships/traverse](/api-reference/concepts/traverse-relationships)."},"params":{"type":"object","additionalProperties":true,"description":"Optional parameters for the query Maximum number of hierarchy levels to traverse Accepted for backwards compatibility, but ignored by every operation this endpoint supports. All four operations read OMOP's precomputed concept_ancestor closure, which stores transitive Is a subsumption only and has no relationship column to filter on. Passing Part of - or a nonexistent relationship - returns the same Is a results. Limit results to specific vocabularies Limit results to specific domains Include relationships to invalid/deprecated concepts","properties":{"max_levels":{"type":"integer","default":10,"description":"Maximum number of hierarchy levels to traverse"},"relationship_types":{"type":"array","items":{"type":"object","additionalProperties":true},"description":"Accepted for backwards compatibility, but ignored by every operation this endpoint supports. All four operations read OMOP's precomputed concept_ancestor closure, which stores transitive Is a subsumption only and has no relationship column to filter on. Passing Part of - or a nonexistent relationship - returns the same Is a results."},"vocabulary_ids":{"type":"array","items":{"type":"object","additionalProperties":true},"description":"Limit results to specific vocabularies"},"domain_ids":{"type":"array","items":{"type":"object","additionalProperties":true},"description":"Limit results to specific domains"},"include_invalid":{"type":"boolean","default":false,"description":"Include relationships to invalid/deprecated concepts"}}}},"required":["query_id","concept_id","operation"]},"minItems":1,"maxItems":100,"description":"Array of hierarchy query requests (1-100 queries) Unique identifier for this query (used to match results) The OMOP concept ID to query hierarchy for Type of hierarchy query. Options: ancestors, descendants, hierarchy, level Any other value fails that individual query with Unknown operation: (the surrounding batch still succeeds - check success on each result). Relationship traversal is not available here; use [GET /v1/concepts/{concept_id}/relationships](/api-reference/relationships/get-concept-relationships) or [POST /v1/concepts/relationships/traverse](/api-reference/concepts/traverse-relationships). Optional parameters for the query Maximum number of hierarchy levels to traverse Accepted for backwards compatibility, but ignored by every operation this endpoint supports. All four operations read OMOP's precomputed concept_ancestor closure, which stores transitive Is a subsumption only and has no relationship column to filter on. Passing Part of - or a nonexistent relationship - returns the same Is a results. Limit results to specific vocabularies Limit results to specific domains Include relationships to invalid/deprecated concepts"}},"additionalProperties":false,"required":["queries"]},"example":{"queries":[{"query_id":"q1","concept_id":201826,"operation":"ancestors","params":{"max_levels":5}},{"query_id":"q2","concept_id":4182210,"operation":"descendants","params":{"max_levels":3}},{"query_id":"q3","concept_id":313217,"operation":"hierarchy","params":{"max_levels":4,"relationship_types":["Is a"]}}]}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"array","items":{"type":"object","properties":{"query_id":{"type":"string"},"concept_id":{"type":"integer"},"operation":{"type":"string"},"success":{"type":"boolean"},"results":{"type":"array","items":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"vocabulary_name":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"level":{"type":"integer"},"min_levels_of_separation":{"type":"integer"},"max_levels_of_separation":{"type":"integer"},"relationship_id":{"type":"string"},"relationship_name":{"type":"string"},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"},"invalid_reason":{"nullable":true}},"additionalProperties":true}}},"additionalProperties":true}},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true,"required":["success","data","meta"]},"example":{"success":true,"data":[{"query_id":"q1","concept_id":201826,"operation":"ancestors","success":true,"results":[{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","vocabulary_name":"SNOMED CT","domain_id":"Condition","concept_class_id":"Clinical Finding","standard_concept":"S","level":0,"min_levels_of_separation":0,"max_levels_of_separation":0,"relationship_id":"Is a","relationship_name":"Is a","valid_start_date":"1970-01-01T00:00:00.000Z","valid_end_date":"2099-12-31T00:00:00.000Z","invalid_reason":null}]}],"meta":{"request_id":"req_batch_hierarchy_123","timestamp":"2024-12-22T10:00:00Z","vocab_release":"2025.1"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"concepts/batch-hierarchy-queries.mdx"}},"/concepts/map":{"post":{"summary":"Map Concepts","description":"Map medical concepts between OMOP vocabularies to find equivalent or related concepts across SNOMED, ICD-10, LOINC, RxNorm, and other terminologies.","operationId":"postConceptsMap","tags":["Mappings"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version to use for mapping (e.g., \"2025.1\", \"2024.2\"). When not specified, uses the default/latest vocabulary version.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"oneOf":[{"type":"object","properties":{"target_vocabulary":{"type":"string","pattern":"^[^\\u0000]*$","minLength":1,"description":"Target vocabulary identifier to map concepts to Examples: \"ICD10CM\", \"SNOMED\", \"ICD9CM\", \"LOINC\", \"RxNorm\""},"mapping_type":{"type":"string","pattern":"^[^\\u0000]*$","enum":["direct","equivalent","broader","narrower"],"description":"Type of concept mapping to filter results by. When not specified, all mapping types are returned. Options: - \"direct\" - Direct mappings only (Maps to, Mapped from) - \"equivalent\" - Equivalent concepts (Maps to, Source - contains, Has precise ingredient) - \"broader\" - Broader concepts (Is a, Subsumes, Has ingredient) - \"narrower\" - Narrower concepts (Subsumes, Consists of)"},"include_invalid":{"type":"boolean","default":false,"description":"Include mappings whose relationship or target concept is deprecated. Defaults to false - only currently-valid mappings are returned unless you ask for more. This page previously documented the default as true. That was wrong: the endpoint has always excluded deprecated mappings when the field is omitted, and the documentation has been corrected rather than the behaviour, so no existing request changes. The sibling GET /v1/concepts/{id}/mappings defaults include_invalid to true. The two differ deliberately: that endpoint lists what exists for one concept, where hiding deprecated mappings would misrepresent the record, while this one resolves sources for downstream use, where a deprecated mapping is rarely what you want by default. Pass the parameter explicitly on both if you need them to agree."},"source_concepts":{"type":"array","items":{"type":"integer","minimum":1},"minItems":1,"maxItems":100,"description":"Array of source OMOP concept IDs to map (1-100 concepts). Use this OR source_codes, not both. Important: These must be OMOP concept IDs (internal database IDs), NOT vocabulary-specific codes. Use /v1/concepts/by-code/{vocabulary}/{code} to look up concept IDs from codes, or use source_codes parameter instead. Example: [201826, 192671] (OMOP concept IDs for Type 2 diabetes and Myocardial infarction)"}},"additionalProperties":false,"required":["target_vocabulary","source_concepts"]},{"type":"object","properties":{"target_vocabulary":{"type":"string","pattern":"^[^\\u0000]*$","minLength":1,"description":"Target vocabulary identifier to map concepts to Examples: \"ICD10CM\", \"SNOMED\", \"ICD9CM\", \"LOINC\", \"RxNorm\""},"mapping_type":{"type":"string","pattern":"^[^\\u0000]*$","enum":["direct","equivalent","broader","narrower"],"description":"Type of concept mapping to filter results by. When not specified, all mapping types are returned. Options: - \"direct\" - Direct mappings only (Maps to, Mapped from) - \"equivalent\" - Equivalent concepts (Maps to, Source - contains, Has precise ingredient) - \"broader\" - Broader concepts (Is a, Subsumes, Has ingredient) - \"narrower\" - Narrower concepts (Subsumes, Consists of)"},"include_invalid":{"type":"boolean","default":false,"description":"Include mappings whose relationship or target concept is deprecated. Defaults to false - only currently-valid mappings are returned unless you ask for more. This page previously documented the default as true. That was wrong: the endpoint has always excluded deprecated mappings when the field is omitted, and the documentation has been corrected rather than the behaviour, so no existing request changes. The sibling GET /v1/concepts/{id}/mappings defaults include_invalid to true. The two differ deliberately: that endpoint lists what exists for one concept, where hiding deprecated mappings would misrepresent the record, while this one resolves sources for downstream use, where a deprecated mapping is rarely what you want by default. Pass the parameter explicitly on both if you need them to agree."},"source_codes":{"type":"array","items":{"type":"object","additionalProperties":true,"properties":{"vocabulary_id":{"type":"string","pattern":"^[^\\u0000]*$","minLength":1,"maxLength":50,"description":"Vocabulary identifier for this source code."},"concept_code":{"type":"string","pattern":"^[^\\u0000]*$","minLength":1,"maxLength":100,"description":"Code within the source vocabulary."}},"required":["vocabulary_id","concept_code"]},"minItems":1,"maxItems":100,"description":"Array of vocabulary/code pairs to map (1-100 concepts). Use this OR source_concepts, not both. This allows mapping directly from source system codes (e.g., SNOMED codes) without first looking up the OMOP concept ID. Example: json [ {\"vocabulary_id\": \"SNOMED\", \"concept_code\": \"44054006\"}, {\"vocabulary_id\": \"SNOMED\", \"concept_code\": \"22298006\"} ] Vocabulary identifier for this source code. Code within the source vocabulary."}},"additionalProperties":false,"required":["target_vocabulary","source_codes"]}]},"example":{"source_codes":[{"vocabulary_id":"ICD10CM","concept_code":"E11.9"},{"vocabulary_id":"ICD10CM","concept_code":"I21.9"}],"target_vocabulary":"SNOMED","mapping_type":"direct"}}}},"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"mappings":{"type":"array","items":{"type":"object","properties":{"source_concept_id":{"type":"integer"},"source_concept_name":{"type":"string"},"source_concept_code":{"type":"string"},"source_vocabulary_id":{"type":"string"},"target_concept_id":{"type":"integer"},"target_concept_name":{"type":"string"},"target_concept_code":{"type":"string"},"target_vocabulary_id":{"type":"string"},"target_domain_id":{"type":"string"},"target_standard_concept":{"type":"string","nullable":true},"relationship_id":{"type":"string"},"relationship_name":{"type":"string"},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"},"invalid_reason":{"nullable":true,"type":"string"},"mapping_type":{"type":"string"}},"additionalProperties":true}},"unmapped_sources":{"type":"array","items":{}},"summary":{"type":"object","properties":{"requested_sources":{"type":"integer"},"mapped_sources":{"type":"integer"},"unmapped_sources":{"type":"integer"},"total_mappings":{"type":"integer"}},"additionalProperties":true}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"mappings":[{"source_concept_id":45576876,"source_concept_name":"Type 2 diabetes mellitus without complications","sourc