concept":"S","level":1,"min_levels_of_separation":1,"max_levels_of_separation":1,"relationship_id":"Is a","relationship_name":"Is a"},{"concept_id":4274025,"concept_name":"Disease","concept_code":"64572001","vocabulary_id":"SNOMED","vocabulary_name":"SNOMED Clinical Terms","domain_id":"Condition","concept_class_id":"Disorder","standard_concept":"S","level":2,"min_levels_of_separation":2,"max_levels_of_separation":2,"relationship_id":"Is a","relationship_name":"Is a"}],"descendants":[{"concept_id":201826,"concept_name":"Type 2 diabetes mellitus","concept_code":"44054006","vocabulary_id":"SNOMED","vocabulary_name":"SNOMED Clinical Terms","domain_id":"Condition","concept_class_id":"Disorder","standard_concept":"S","level":1,"min_levels_of_separation":1,"max_levels_of_separation":1,"relationship_id":"Subsumes","relationship_name":"Subsumes"},{"concept_id":201254,"concept_name":"Type 1 diabetes mellitus","concept_code":"46635009","vocabulary_id":"SNOMED","vocabulary_name":"SNOMED Clinical Terms","domain_id":"Condition","concept_class_id":"Disorder","standard_concept":"S","level":1,"min_levels_of_separation":1,"max_levels_of_separation":1,"relationship_id":"Subsumes","relationship_name":"Subsumes"}],"level":3,"max_level":5,"total_ancestors":2,"total_descendants":2},"meta":{"request_id":"req_hierarchy_123","timestamp":"2024-12-22T10:30:00Z","vocab_release":"2025.2"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"hierarchy/get-concept-hierarchy.mdx"}},"/concepts/{conceptId}/level":{"get":{"summary":"Get Concept Level","description":"Get the hierarchical level and depth of an OMOP concept within its vocabulary tree for quick classification and hierarchy-aware filtering.","operationId":"getConceptsByConceptIdLevel","tags":["Concepts"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"conceptId","in":"path","required":true,"description":"The unique OMOP concept ID to get level information for","schema":{"type":"integer"},"example":201826},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version (e.g., \"2025.1\")","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"concept_id":{"type":"integer"},"level":{"type":"integer"},"depth_from_root":{"type":"integer"},"breadth_at_level":{"nullable":true,"type":"integer"},"total_descendants":{"type":"integer"},"total_ancestors":{"type":"integer"}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"}},"additionalProperties":true}},"additionalProperties":true,"required":["success","data","meta"]},"example":{"success":true,"data":{"concept_id":201826,"level":0,"depth_from_root":4,"breadth_at_level":null,"total_descendants":15,"total_ancestors":3},"meta":{"request_id":"req_concept_level_123","timestamp":"2024-12-22T10:00:00Z","vocab_release":"2025.1"}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"concepts/get-concept-level.mdx"}},"/concepts/{conceptId}/mappings":{"get":{"summary":"Get Concept Mappings","description":"Retrieve mappings from a concept to equivalent or related concepts in other vocabulary systems. Each row carries the target's target_domain_id and target_standard_concept, so a single call is enough both to route the mapping to the right CDM table and to verify that a Maps to target is standard. Neither previously required a second request per target; before 2026-09-09 the response omitted both fields and each one did.","operationId":"getConceptsByConceptIdMappings","tags":["Mappings"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"conceptId","in":"path","required":true,"description":"The OMOP concept ID to get mappings for","schema":{"type":"integer"},"example":35207668},{"name":"target_vocabulary","in":"query","required":false,"description":"Filter mappings to a specific target vocabulary (e.g., \"ICD10CM\", \"SNOMED\")","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"relationship_ids","in":"query","required":false,"description":"Comma-separated relationship types to return. Defaults to Maps to. Use Maps to,Maps to value to include the Value-as-Concept decomposition of composite concepts. Like include_invalid, this parameter was accepted but not applied before 2026-08-11.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}},{"name":"page","in":"query","required":false,"description":"Page number, 1-based","schema":{"type":"integer","default":1},"example":1},{"name":"page_size","in":"query","required":false,"description":"Mappings per page. Values above 200 are clamped to 200 without an error, so requesting more returns a smaller page than asked for.","schema":{"type":"integer","default":100},"example":100},{"name":"include_invalid","in":"query","required":false,"description":"Include mappings whose relationship or target concept is deprecated. Defaults to true - pass false to return only currently-valid mappings. Note that POST /v1/concepts/map defaults this to false. The two differ deliberately: this endpoint lists what exists for one concept, where hiding deprecated mappings would misrepresent the record, while map resolves sources for downstream use. Pass the parameter explicitly on both if you need them to agree. The source concept itself is never filtered, so a deprecated concept still returns what it maps to.","schema":{"type":"boolean","default":true}},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version to use (e.g., \"2025.1\", \"2024.2\"). When not specified, uses the default/latest vocabulary version.","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"mappings":{"type":"array","items":{"type":"object","properties":{"source_concept_id":{"type":"integer"},"source_concept_name":{"type":"string"},"source_concept_code":{"type":"string"},"source_vocabulary_id":{"type":"string"},"target_concept_id":{"type":"integer"},"target_concept_name":{"type":"string"},"target_concept_code":{"type":"string"},"target_vocabulary_id":{"type":"string"},"target_domain_id":{"type":"string"},"target_standard_concept":{"type":"string","nullable":true},"relationship_id":{"type":"string"},"relationship_name":{"type":"string"},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"},"invalid_reason":{"nullable":true,"type":"string"},"mapping_type":{"type":"string"}},"additionalProperties":true}}},"additionalProperties":true},"meta":{"type":"object","properties":{"request_id":{"type":"string"},"timestamp":{"type":"string"},"vocab_release":{"type":"string"},"pagination":{"type":"object","properties":{"page":{"type":"integer"},"page_size":{"type":"integer"},"total_items":{"type":"integer"},"total_pages":{"type":"integer"},"has_next":{"type":"boolean"},"has_previous":{"type":"boolean"}},"additionalProperties":true}},"additionalProperties":true}},"additionalProperties":true},"example":{"success":true,"data":{"mappings":[{"source_concept_id":35207668,"source_concept_name":"Essential (primary) hypertension","source_concept_code":"I10","source_vocabulary_id":"ICD10CM","target_concept_id":320128,"target_concept_name":"Essential hypertension","target_concept_code":"59621000","target_vocabulary_id":"SNOMED","target_domain_id":"Condition","target_standard_concept":"S","relationship_id":"Maps to","relationship_name":"Non-standard to Standard map (OMOP)","valid_start_date":"1969-12-31T23:00:00.000Z","valid_end_date":"2099-12-31T00:00:00.000Z","invalid_reason":null,"mapping_type":"direct"}]},"meta":{"request_id":"req_abc123","timestamp":"2025-01-05T12:00:00.000Z","vocab_release":"2025.2","pagination":{"page":1,"page_size":100,"total_items":1,"total_pages":1,"has_next":false,"has_previous":false}}}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/ServerError"}},"x-source-route":"src/routes/v1/vocabulary.routes.ts","x-documentation-source":"mappings/get-concept-mappings.mdx"}},"/concepts/{conceptId}/path/{targetId}":{"get":{"summary":"Get Concept Path","description":"Find the hierarchical path between two OMOP concepts - the concepts that connect them, how far apart they are, and which way the hierarchy runs.","operationId":"getConceptsByConceptIdPathByTargetId","tags":["Hierarchy"],"security":[{"bearerAuth":[]}],"parameters":[{"name":"conceptId","in":"path","required":true,"description":"The source concept - the concept the path starts from Example: 201820 (Diabetes mellitus)","schema":{"type":"integer"},"example":201820},{"name":"targetId","in":"path","required":true,"description":"The target concept - the concept the path ends at Example: 441840 (Clinical finding)","schema":{"type":"integer"},"example":4274025},{"name":"max_depth","in":"query","required":false,"description":"Reject a path longer than this many levels. No default: when omitted, the whole hierarchy is searched. If the two concepts are connected but farther apart than max_depth, the response is path_exists: false with max_depth_exceeded: true, which keeps that case distinguishable from two concepts that are simply unrelated.","schema":{"type":"integer","minimum":1,"maximum":50}},{"name":"shortest_path_only","in":"query","required":false,"description":"By default the response contains every concept lying on any route between the endpoints. Set this to true to keep only the concepts on a shortest route - those whose levels_from_source + levels_to_target equals path_length. path_length itself is unaffected: it is always the shortest separation.","schema":{"type":"boolean","default":false},"example":true},{"name":"include_intermediate","in":"query","required":false,"description":"Set to false to return only the two endpoint concepts in path, dropping everything between them. path_length is unaffected.","schema":{"type":"boolean","default":true}},{"name":"vocab_release","in":"query","required":false,"description":"Specific vocabulary release version to query Example: 2025.1","schema":{"type":"string","pattern":"^[^\\u0000]*$"}}],"responses":{"200":{"description":"Successful response","content":{"application/json":{"schema":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"source_concept_id":{"type":"integer"},"target_concept_id":{"type":"integer"},"source_concept":{"type":"object","properties":{"concept_id":{"type":"integer"},"concept_name":{"type":"string"},"concept_code":{"type":"string"},"vocabulary_id":{"type":"string"},"vocabulary_name":{"type":"string"},"domain_id":{"type":"string"},"concept_class_id":{"type":"string"},"standard_concept":{"type":"string","nullable":true},"valid_start_date":{"type":"string"},"valid_end_date":{"type":"string"},"invalid_reason":{"nullable":true,"type":"string"}},"a