              "timestamp": "2024-02-27T14:16:23.000-0500",
              "status": "503",
              "path": "v2/current-resource-name/1232322",
              "traceId": "2345IJ6789",
              "causes": [
                {
                  "code": "server.overloaded",
                  "description": "The server is currently overloaded and unable to handle requests",
                  "timestamp": "2024-02-27T14:16:23.000-0500",
                  "status": "503",
                  "path": "v2/current-resource-name/1232322",
                  "traceId": "2345IJ6789"
                }
              ]
            }
          }
