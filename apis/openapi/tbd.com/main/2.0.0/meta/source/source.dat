    "responses": {
      "unauthorizedAccess": {
        "description": "Unauthorized access",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/401Error"
            },
            "example": {
              "code": "invalid.login",
              "description": "Access to the requested resource is unauthorized",
              "timestamp": "2024-02-27T14:16:23.000-0500",
              "status": "401",
              "path": "v2/current-resource-name/1232322",
              "traceId": "9876CD1234"
            }
          }
        }
      },
      "forbiddenAccess": {
        "description": "Forbidden access",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/403Error"
            },
            "example": {
              "code": "forbidden.request",
              "description": "Access to the requested resource is forbidden",
              "timestamp": "2024-02-27T14:16:23.000-0500",
              "status": "403",
              "path": "v2/current-resource-name/1232322",
              "traceId": "3456GH5678"
            }
          }
        }
      },
      "unprocessableEntity": {
        "description": "Unprocessable entity",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/422Error"
            },
            "example": {
              "code": "unprocessable.entity",
              "message": "Validation Failed",
              "description": "Can not process the request because of validation failures",
              "timestamp": "2022-02-15T22:14:45.624+0000",
              "status": "422",
              "path": "v2/current-resource-name/A1",
              "traceId": "1234HH4445",
              "causes": [
                {
                  "code": "first.name.required",
                  "description": "First Name is missing from the request",
                  "timestamp": "2022-02-15T22:14:45.624+0000",
                  "status": "422",
                  "path": "v2/current-resource-name/A1",
                  "traceId": "1234HH4445"
                }
              ]
            }
          }
        }
      },
      "internalServerError": {
        "description": "Bad Gateway",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/500Error"
            },
            "example": {
              "code": "internal.server.error",
              "description": "The server encountered an error while processing the request.",
              "timestamp": "2024-02-27T14:16:23.000-0500",
              "status": "500",
              "path": "v2/current-resource-name/1232322",
              "traceId": "2345IJ6789",
              "causes": [
                {
                  "code": "server.overload",
                  "description": "The server ran out of resources and crashed due to high traffic or low memory.",
                  "timestamp": "2024-03-04T16:55:20.000-0500",
                  "status": "500",
                  "path": "v2/current-resource-name/1232322",
                  "traceId": "3456GH5678"
                },
                {
                  "code": "database.connection",
                  "description": "Incorrect database login credentials or connectivity issues.",
                  "timestamp": "2024-03-04T16:55:20.000-0500",
                  "status": "500",
                  "path": "v2/current-resource-name/1232322",
                  "traceId": "3456GH5678"
                },
                {
                  "code": "file.corruption",
                  "description": "Corrupted files in the application installation.",
                  "timestamp": "2024-03-04T16:55:20.000-0500",
                  "status": "500",
                  "path": "v2/current-resource-name/1232322",
                  "traceId": "3456GH5678"
                },
                {
                  "code": "server.misconfig",
                  "description": "Server misconfiguration led to unexpected behavior.",
                  "timestamp": "2024-03-04T16:55:20.000-0500",
                  "status": "500",
                  "path": "v2/current-resource-name/1232322"
                }
              ]
            }
          }
        }
      },
      "serviceUnavailable": {
        "description": "Service unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/503Error"
            },
            "example": {
              "code": "service.not.available",
