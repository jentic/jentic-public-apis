{
  "openapi": "3.0.0",
  "info": {
    "title": "Enrollment Backup",
    "contact": {
      "name": "TBD",
      "url": "https://TBD.com/",
      "email": "TBD@humana.com",
      "x-owner-snow-group-name": "TBD",
      "x-sre-team-name": "SREDigitalShopping@humana.com"
    },
    "version": "2.0.0",
    "x-api-type": "rest",
    "x-classification": "private",
    "x-consumption-domain": "internal",
    "x-business-capability": "<ToDo>",
    "x-resource": "plans",
    "x-segment": "insurance",
    "x-sub-segment": "medicare",
    "x-architecture-category": "northstar",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/VCHILARAPU/enrollment-backup/2.0.0"
  },
  "servers": [
    {
      "url": "https://{serverName}/{apiVersion}/{basePath}",
      "description": "The server URL for Retail Enrollment Backup Apigee URLs",
      "variables": {
        "serverName": {
          "description": "Name of the server",
          "default": "qa-plans.humana.com",
          "enum": [
            "dev-plans.humana.com",
            "qa-plans.humana.com",
            "plans.humana.com"
          ]
        },
        "basePath": {
          "description": "Base path and folder for the API",
          "default": "enrollment-backup"
        },
        "apiVersion": {
          "description": "API version in URL",
          "default": "svc"
        }
      }
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/signature": {
      "post": {
        "tags": [
          "Enrollment signature Backup"
        ],
        "summary": "To Store Enrollment signature Backup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/enrollment-request-model"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Service Not Available"
          }
        }
      }
    },
    "/agent-backup": {
      "post": {
        "tags": [
          "Enrollment Agent Backup"
        ],
        "summary": "To store agent data",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/enrollment-agent-request-model"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Service Not Available"
          }
        }
      }
    },
    "/progress": {
      "post": {
        "tags": [
          "Enrollment Progress Backup"
        ],
        "summary": "To store enrollment progress data",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/enrollment-progress-request-model"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/enrollment-progress-created-response-model"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Service Not Available"
          }
        }
      },
      "get": {
        "tags": [
          "Get progress of an enrollment backup"
        ],
        "summary": "Get progress of an enrollment backup",
        "parameters": [
          {
            "name": "userGuid",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "userGuid"
          },
          {
            "name": "uniqueId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "uniqueId"
          },
          {
            "name": "customerMedicareId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "customerMedicareId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/enrollment-progress-response-model"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Service Not Available"
          }
        }
      }
    },
    "/disableProgressAndSaveApplicationId": {
      "post": {
        "tags": [
          "Disable Progress and Save Application Id"
        ],
        "summary": "Disable Progress and Save Application Id",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/enrollment-disable-progress-model"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          },
          "503": {
            "description": "Service Not Available"
          }
        }
      }
    },
    "/isAlive": {
      "get": {
        "tags": [
          "Get Live status of an application"
        ],
        "summary": "To get live status of an application",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "example": true
                }
              }
            }
          }
        }
      }
    }
  },
