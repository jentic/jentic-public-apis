{
  "openapi": "3.0.3",
  "info": {
    "title": "Transbank Webpay Plus API",
    "description": "Chilean payment processing API by Transbank. Webpay Plus enables online credit and debit card payments, including transaction creation, confirmation, status queries, refunds/reversals, and deferred capture.",
    "version": "1.2",
    "x-jentic-source-url": "https://www.transbankdevelopers.cl/referencia/webpay"
  },
  "servers": [
    {
      "url": "https://webpay3g.transbank.cl",
      "description": "Production server"
    },
    {
      "url": "https://webpay3gint.transbank.cl",
      "description": "Integration/test server"
    }
  ],
  "paths": {
    "/rswebpaytransaction/api/webpay/v1.2/transactions": {
      "post": {
        "operationId": "createTransaction",
        "summary": "Create a new transaction",
        "description": "Initialize a new Webpay Plus transaction. Returns a token and URL to redirect the customer to Webpay for payment.",
        "tags": [
          "Transaction"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransactionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTransactionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rswebpaytransaction/api/webpay/v1.2/transactions/{token}": {
      "put": {
        "operationId": "commitTransaction",
        "summary": "Commit a transaction",
        "description": "Confirm and finalize a Webpay Plus transaction after the customer has completed payment on the Webpay page. Must be called within 30 seconds of receiving the token at the return URL.",
        "tags": [
          "Transaction"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "description": "Transaction token returned from createTransaction",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction committed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid token or transaction already committed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "getTransactionStatus",
        "summary": "Get transaction status",
        "description": "Retrieve the current status and details of a transaction using its token.",
        "tags": [
          "Transaction"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "description": "Transaction token",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction status retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionDetailResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rswebpaytransaction/api/webpay/v1.2/transactions/{token}/refunds": {
      "post": {
        "operationId": "refundTransaction",
        "summary": "Refund or reverse a transaction",
        "description": "Request a full reversal or partial refund (nullification) of a committed transaction. Full reversals are processed if the amount matches the original; partial refunds create a nullification.",
        "tags": [
          "Refund"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "description": "Transaction token",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefundRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Refund processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefundResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or refund not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rswebpaytransaction/api/webpay/v1.2/transactions/{token}/capture": {
      "put": {
        "operationId": "captureTransaction",
        "summary": "Capture a deferred transaction",
        "description": "Capture the authorized amount of a deferred payment transaction. Only applicable to transactions created with deferred capture mode.",
        "tags": [
          "Capture"
        ],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "description": "Transaction token",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptureRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction captured successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or capture not allowed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyId": {
        "type": "apiKey",
        "in": "header",
        "name": "Tbk-Api-Key-Id",
        "description": "Commerce code assigned by Transbank"
      },
      "apiKeySecret": {
        "type": "apiKey",
        "in": "header",
        "name": "Tbk-Api-Key-Secret",
        "description": "Secret API key assigned by Transbank"
      }
    },
    "schemas": {
      "CreateTransactionRequest": {
        "type": "object",
        "required": [
          "buy_order",
          "session_id",
          "amount",
          "return_url"
        ],
        "properties": {
          "buy_order": {
            "type": "string",
            "description": "Unique buy order identifier",
            "maxLength": 26
          },
          "session_id": {
            "type": "string",
            "description": "Session identifier for the transaction",
            "maxLength": 61
          },
          "amount": {
            "type": "number",
            "description": "Transaction amount in CLP",
            "example": 10000
          },
          "return_url": {
            "type": "string",
            "format": "uri",
            "description": "URL where Webpay will redirect after payment",
            "maxLength": 256
          }
        }
      },
      "CreateTransactionResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Transaction token for subsequent operations",
            "maxLength": 64
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Webpay form URL to redirect the customer",
            "maxLength": 255
          }
        }
      },
      "TransactionDetailResponse": {
        "type": "object",
        "properties": {
          "vci": {
            "type": "string",
            "description": "Visa Commerce Indicator authentication result (TSY=authenticated, TSN=failed, NP=not participating, U3=internal error, INV=data invalid, A=attempt)",
            "enum": [
              "TSY",
              "TSN",
              "NP",
              "U3",
              "INV",
              "A"
            ]
          },
          "amount": {
            "type": "number",
            "description": "Transaction amount"
          },
          "status": {
            "type": "string",
            "description": "Transaction status",
            "enum": [
              "INITIALIZED",
              "AUTHORIZED",
              "REVERSED",
              "FAILED",
              "NULLIFIED",
              "PARTIALLY_NULLIFIED",
              "CAPTURED"
            ]
          },
          "buy_order": {
            "type": "string",
            "description": "Buy order identifier"
          },
          "session_id": {
            "type": "string",
            "description": "Session identifier"
          },
          "card_detail": {
            "type": "object",
            "properties": {
              "card_number": {
                "type": "string",
                "description": "Last 4 digits of the card"
              }
            }
          },
          "accounting_date": {
            "type": "string",
            "description": "Accounting date (MMdd format)"
          },
          "transaction_date": {
            "type": "string",
            "format": "date-time",
            "description": "Transaction date and time"
          },
          "authorization_code": {
            "type": "string",
            "description": "Authorization code from the issuer"
          },
          "payment_type_code": {
            "type": "string",
            "description": "Payment type (VD=debit, VN=credit single, VC=credit installments, SI=3-installment no interest, S2=2-installment no interest, NC=N-installment no interest, VP=prepaid)",
            "enum": [
              "VD",
              "VN",
              "VC",
              "SI",
              "S2",
              "NC",
              "VP"
            ]
          },
          "response_code": {
            "type": "integer",
            "description": "Response code (0=approved, -1=rejected, -2=must retry, -3=error)"
          },
          "installments_amount": {
            "type": "number",
            "description": "Amount per installment"
          },
          "installments_number": {
            "type": "integer",
            "description": "Number of installments"
          },
          "balance": {
            "type": "number",
            "description": "Remaining balance after partial refunds"
          }
        }
      },
      "RefundRequest": {
        "type": "object",
        "required": [
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "description": "Amount to refund. If equal to original amount, a full reversal is attempted; otherwise a partial nullification."
          }
        }
      },
      "RefundResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Refund type",
            "enum": [
              "NULLIFIED",
              "REVERSED"
            ]
          },
          "authorization_code": {
            "type": "string",
            "description": "Authorization code for the refund"
          },
          "authorization_date": {
            "type": "string",
            "format": "date-time",
            "description": "Date of refund authorization"
          },
          "nullified_amount": {
            "type": "number",
            "description": "Amount nullified"
          },
          "balance": {
            "type": "number",
            "description": "Remaining balance after nullification"
          },
          "response_code": {
            "type": "integer",
            "description": "Response code (0=approved)"
          }
        }
      },
      "CaptureRequest": {
        "type": "object",
        "required": [
          "buy_order",
          "authorization_code",
          "capture_amount"
        ],
        "properties": {
          "buy_order": {
            "type": "string",
            "description": "Buy order from original transaction",
            "maxLength": 26
          },
          "authorization_code": {
            "type": "string",
            "description": "Authorization code from the committed transaction"
          },
          "capture_amount": {
            "type": "number",
            "description": "Amount to capture (may be less than or equal to authorized amount)"
          }
        }
      },
      "CaptureResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Transaction token"
          },
          "authorization_code": {
            "type": "string",
            "description": "Authorization code"
          },
          "authorization_date": {
            "type": "string",
            "format": "date-time",
            "description": "Date of capture authorization"
          },
          "captured_amount": {
            "type": "number",
            "description": "Amount captured"
          },
          "response_code": {
            "type": "integer",
            "description": "Response code (0=approved)"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error_message": {
            "type": "string",
            "description": "Human-readable error description"
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKeyId": [],
      "apiKeySecret": []
    }
  ],
  "tags": [
    {
      "name": "Transaction",
      "description": "Transaction creation, confirmation, and status"
    },
    {
      "name": "Refund",
      "description": "Transaction refunds and reversals"
    },
    {
      "name": "Capture",
      "description": "Deferred transaction capture"
    }
  ]
}
