                    "ETAStatus": "ON_TIME",
                    "location": {
                      "locationType": "CUSTOMER",
                      "zip5": "30301",
                      "stopType": "DELIVERY",
                      "stopSequence": 3
                    },
                    "currentLocation": {
                      "latitude": 33.749,
                      "longitude": -84.388,
                      "currentDateTime": "2025-11-01T09:30:00Z"
                    },
                    "currentEvent": {
                      "eventType": "EN_ROUTE"
                    },
                    "positionalInfo": {
                      "pingInterval": 1200,
                      "distance": 35.5,
                      "speed": 40.0,
                      "accuracy": 50.0
                    }
                  }
                },
                "facilityArriveNoEta": {
                  "summary": "FACILITY_ARRIVE event without ETA/ETAStatus",
