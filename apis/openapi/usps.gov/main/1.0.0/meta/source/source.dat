                      "locationType": "NON_USPS",
                      "zip5": "20590",
                      "stopType": "PICKUP",
                      "stopSequence": 2
                    },
                    "currentLocation": {
                      "latitude": 38.8977,
                      "longitude": -77.0365,
                      "currentDateTime": "2025-10-21T07:55:00Z"
