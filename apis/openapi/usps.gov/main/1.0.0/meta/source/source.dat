    "schemas": {
      "ShipmentTracking": {
        "title": "Shipment Tracking Event",
        "description": "Details about a shipment tracking event, including location, status, and facility information.",
        "allOf": [
          {
            "$ref": "#/components/schemas/ShipmentTrackingBase"
          }
        ]
      },
      "ShipmentTrackingBase": {
        "title": "Shipment Tracking Event",
        "description": "Details about a shipment tracking event, including location, status, and facility information.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalLoadNumber",
          "appointmentID",
          "appointmentDate",
          "trailerID",
          "schedulerCRID",
          "location",
          "currentLocation",
          "currentEvent",
          "positionalInfo"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "currentEvent": {
                  "type": "object",
                  "description": "Current event information used for conditional validation.",
                  "properties": {
                    "eventType": {
                      "type": "string",
                      "description": "Event type used to determine ETA and ETAStatus requirements.",
                      "enum": [
                        "FACILITY_ARRIVE",
                        "FACILITY_DEPART"
                      ]
                    }
                  }
                }
              }
            },
            "else": {
              "required": [
                "ETA",
                "ETAStatus"
              ]
            }
          }
        ],
        "properties": {
          "externalLoadNumber": {
            "type": "string",
            "description": "Unique identifier for the shipment load.",
            "minLength": 1,
            "maxLength": 50,
            "pattern": "^[A-Z0-9]+$",
            "examples": [
              "ELN123456"
            ]
          },
          "appointmentID": {
            "type": "string",
            "description": "Appointment ID assigned from FAST. Required.",
            "minLength": 1,
            "maxLength": 12,
            "pattern": "^[A-Za-z0-9]{1,12}$",
            "examples": [
              "987654321"
            ]
          },
          "appointmentDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time of the appointment (ISO 8601).",
            "examples": [
              "2025-10-17T13:30:00Z"
            ],
            "minLength": 20,
            "maxLength": 30
          },
          "trailerID": {
            "type": "string",
            "description": "Unique identifier for the trailer.",
            "examples": [
              "TRAILER1234"
            ],
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[A-Z0-9]+$"
          },
          "schedulerCRID": {
            "type": "string",
            "description": "Scheduler's unique identifier.",
            "examples": [
              "01122445343"
            ],
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[0-9]+$"
          },
          "ETA": {
            "type": "string",
            "format": "date-time",
            "description": "Estimated time of arrival (ISO 8601). Required unless currentEvent.eventType is FACILITY_ARRIVE or FACILITY_DEPART.",
            "examples": [
              "2025-10-17T14:00:00Z"
            ],
            "minLength": 20,
            "maxLength": 30
          },
          "ETAStatus": {
            "type": "string",
            "description": "The ETA status of the current destination and not the appointment. Required unless currentEvent.eventType is FACILITY_ARRIVE or FACILITY_DEPART.",
            "examples": [
              "ON_TIME"
            ],
            "minLength": 4,
            "maxLength": 12,
            "enum": [
              "ON_TIME",
              "EARLY",
              "DELAYED",
              "LATE",
              "CANCELLED",
              "REDIRECTED",
              "RESCHEDULED"
            ]
          },
          "location": {
            "$ref": "#/components/schemas/TrackingLocation"
          },
          "currentLocation": {
            "$ref": "#/components/schemas/TrackingCurrentLocation"
          },
          "currentEvent": {
            "$ref": "#/components/schemas/TrackingCurrentEvent"
          },
          "positionalInfo": {
            "$ref": "#/components/schemas/TrackingPositionalInfo"
          },
          "resourceInfo": {
            "$ref": "#/components/schemas/TrackingResourceInfo"
          }
        }
      },
      "TrackingLocation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locationType",
          "stopType",
          "stopSequence"
        ],
        "oneOf": [
          {
            "required": [
              "dropSiteKey"
            ],
            "properties": {
              "locationType": {
                "type": "string",
                "const": "USPS",
                "description": "Type of location for USPS sites.",
                "minLength": 1,
                "maxLength": 15,
                "pattern": "^USPS$"
              }
            }
          },
          {
            "required": [
              "zip5"
            ],
            "properties": {
              "locationType": {
                "type": "string",
                "enum": [
                  "CUSTOMER",
                  "NON_USPS"
                ],
                "description": "Type of location for customer or non-USPS sites.",
                "minLength": 1,
                "maxLength": 15
              }
            }
          }
        ],
        "properties": {
          "locationType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15,
            "description": "Type of location (e.g., USPS, NON_USPS).",
            "enum": [
              "USPS",
              "CUSTOMER",
              "NON_USPS"
            ]
          },
          "dropSiteKey": {
            "type": "string",
            "description": "Key for the drop site. Required when locationType is USPS.",
            "examples": [
              "KZ11305"
            ],
            "minLength": 1,
            "maxLength": 15,
            "pattern": "^[A-Z0-9]+$"
          },
          "zip5": {
            "type": "string",
            "description": "Five-digit ZIP Code. Required when locationType is CUSTOMER or NON_USPS.",
            "examples": [
              "20590"
            ],
            "minLength": 5,
            "maxLength": 5,
            "pattern": "^[0-9]{5}$"
          },
          "stopType": {
            "type": "string",
            "description": "Type of stop (Pickup or Delivery).",
            "minLength": 6,
            "maxLength": 8,
            "enum": [
              "PICKUP",
              "DELIVERY"
            ],
            "examples": [
              "DELIVERY"
            ]
          },
          "stopSequence": {
            "type": "integer",
            "description": "The actual stop number in the route.",
            "examples": [
              2
            ],
            "minimum": 1,
            "maximum": 100
          }
        },
        "description": "Location details for the tracking event."
      },
      "TrackingCurrentLocation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "latitude",
          "longitude",
          "currentDateTime"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "description": "Latitude of the current location.",
            "examples": [
              39.8561
            ],
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "description": "Longitude of the current location.",
            "examples": [
              -104.6737
            ],
            "minimum": -180,
            "maximum": 180
          },
          "currentDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the current location.",
            "examples": [
              "2025-10-17T10:30:00Z"
            ],
            "minLength": 20,
            "maxLength": 30
          }
        },
        "description": "Current location details for the tracking event."
      },
      "TrackingCurrentEvent": {
        "type": "object",
        "additionalProperties": false,
        "description": "The current event type for the shipment.",
        "required": [
          "eventType"
        ],
        "properties": {
          "eventType": {
            "type": "string",
            "description": "The type of event (e.g., EN_ROUTE, PRE_ARRIVAL, FACILITY_ARRIVE, FACILITY_DEPART).",
            "minLength": 7,
            "maxLength": 15,
            "enum": [
              "EN_ROUTE",
              "PRE_ARRIVAL",
              "FACILITY_ARRIVE",
              "FACILITY_DEPART"
            ],
            "examples": [
              "EN_ROUTE"
            ]
          }
        }
      },
      "TrackingPositionalInfo": {
        "type": "object",
        "additionalProperties": false,
        "description": "Positional information for the shipment.",
        "required": [
          "pingInterval",
          "distance",
          "speed",
          "accuracy"
        ],
        "properties": {
          "pingInterval": {
            "type": "integer",
            "description": "Interval in milliseconds between location pings.",
            "examples": [
              1800
            ],
            "minimum": 0,
            "maximum": 10000
          },
          "distance": {
            "type": "number",
            "description": "Distance traveled in kilometers.",
            "examples": [
              120.5
            ],
            "minimum": 0,
            "maximum": 10000
          },
          "speed": {
            "type": [
              "number",
              "null"
            ],
            "description": "Speed is a double representing the velocity of the device the shipment tracking is using in meters per second. This value is null if the implementation is not able to measure it.",
            "examples": [
              55.0
            ],
            "minimum": 0,
            "maximum": 155
          },
          "accuracy": {
            "type": [
              "number",
              "null"
            ],
            "description": "Accuracy is a strictly positive double representing the accuracy, with a 95% confidence level, of the GeolocationCoordinates.latitude and GeolocationCoordinates.longitude properties expressed in meters",
            "examples": [
              125.0
            ],
            "minimum": 0,
            "maximum": 1000
          }
        }
      },
      "TrackingResourceInfo": {
        "type": "object",
        "additionalProperties": false,
        "description": "Information about the resource sending the information. If submitted by CUSTOMER, submissionType defaults to AUTOMATIC. DRIVER submissions are manual.",
        "properties": {
          "submissionType": {
            "type": "string",
            "description": "Type of submission (e.g., MANUAL, AUTOMATIC). Defaults to AUTOMATIC for CUSTOMER submissions.",
            "enum": [
              "MANUAL",
              "AUTOMATIC"
            ],
            "default": "AUTOMATIC",
            "examples": [
              "AUTOMATIC"
            ],
            "minLength": 6,
            "maxLength": 9
          },
          "submissionBy": {
            "type": "string",
            "description": "Who submitted the information (e.g., CUSTOMER, DRIVER). Defaults to CUSTOMER when submitted by API.",
            "enum": [
              "CUSTOMER",
              "DRIVER"
            ],
            "default": "CUSTOMER",
            "examples": [
              "CUSTOMER"
            ],
            "minLength": 6,
            "maxLength": 8
          },
          "comments": {
            "type": "string",
            "description": "Comments related to the appointment tracking submission.",
            "pattern": "^[A-Za-z0-9\\s\\-\\.,]+$",
            "examples": [
              "Driver reported delay due to traffic."
            ],
            "minLength": 1,
            "maxLength": 256
          },
          "rating": {
            "type": "number",
            "description": "Rating related to the appointment tracking submission.",
            "examples": [
              4.5
            ],
            "minimum": 0,
            "maximum": 5
          },
          "locationPermission": {
            "type": "string",
            "description": "Permission of location services status for submission on DRIVER submissionBy. NOT_REQUIRED for CUSTOMER submissionBy using API.",
            "enum": [
              "GRANTED",
              "DENIED",
              "NOT_REQUIRED"
            ],
            "examples": [
              "GRANTED"
            ],
            "minLength": 6,
            "maxLength": 12
          },
          "notificationPermission": {
            "type": "string",
            "description": "Permission of notification services status for submission on DRIVER submissionBy. NOT_REQUIRED for CUSTOMER submissionBy using API.",
            "enum": [
              "GRANTED",
              "DENIED",
              "NOT_REQUIRED"
            ],
            "examples": [
              "GRANTED"
            ],
            "minLength": 6,
            "maxLength": 12
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "description": "Problem Details object aligned to RFC 9457.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "A URI reference that identifies the problem type.",
            "minLength": 1,
            "maxLength": 256,
            "examples": [
              "https://api.usps.gov/problems/invalid-format"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Short, human-readable summary of the problem type.",
            "examples": [
              "Invalid field format"
            ]
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "description": "HTTP status code for this occurrence of the problem.",
            "examples": [
              400
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "routeID must match pattern ^[A-Za-z0-9\\-]{1,15}$."
            ]
          },
          "instance": {
            "type": "string",
            "format": "uri",
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "minLength": 1,
            "maxLength": 256,
            "examples": [
              "https://api.usps.gov/shipments/v1/route"
            ]
          },
          "errorCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Z0-9_]+$",
            "description": "Application-specific error code in uppercase snake case.",
            "examples": [
              "INVALID_FORMAT"
            ]
          },
          "errors": {
            "type": "array",
            "description": "Optional array of detailed error messages.",
            "minItems": 0,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Additional detail about the error."
            }
          }
        }
      }
    },
    "securitySchemes": {
      "AuthToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
