{
  "openapi": "3.1.0",
  "info": {
    "title": "Shipments",
    "version": "1.0.0",
    "summary": "Shipments API is the base for shipment activities. Its primary use is for managing shipment tracking events but other endpoints should be added in the future.",
    "description": "Enables the management of shipment tracking events.",
    "termsOfService": "https://about.usps.com/termsofuse.htm",
    "contact": {
      "name": "USPS Support",
      "email": "APISupport@usps.gov",
      "url": "https://api.usps.gov/support"
    },
    "x-updated-on": "01/13/2026 - Leonard McKinney",
    "x-reviewed-on": "MM/DD/YYYY - <team name>",
    "x-approved-on": "MM/DD/YYYY - <team name>",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/neuharthr/shipments/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.usps.gov/shipments/v1",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "AuthToken": []
    }
  ],
  "tags": [
    {
      "name": "Tracking",
      "description": "Shipment tracking operations"
    }
  ],
  "paths": {
    "/tracking": {
      "post": {
        "summary": "Create a shipment tracking event",
        "description": "Provides real-time shipment tracking information using GPS data for appointment scheduling and shipment monitoring. ETA and ETAStatus are required unless currentEvent.eventType is FACILITY_ARRIVE or FACILITY_DEPART.",
        "operationId": "post-shipments-tracking",
        "tags": [
          "Tracking"
        ],
        "requestBody": {
          "description": "Shipment tracking event to create",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShipmentTracking"
              },
              "examples": {
                "uspsLocation": {
                  "summary": "USPS location with dropSiteKey",
                  "value": {
                    "externalLoadNumber": "ELN123456",
                    "appointmentID": "A987654321",
                    "appointmentDate": "2025-10-17T13:30:00Z",
                    "trailerID": "TRAILER1234",
                    "schedulerCRID": "01122445343",
                    "ETA": "2025-10-17T14:00:00Z",
                    "ETAStatus": "ON_TIME",
                    "location": {
                      "locationType": "USPS",
                      "dropSiteKey": "EV19160",
                      "stopType": "DELIVERY",
                      "stopSequence": 2
                    },
                    "currentLocation": {
                      "latitude": 39.8561,
                      "longitude": -104.6737,
                      "currentDateTime": "2025-10-17T10:30:00Z"
                    },
                    "currentEvent": {
                      "eventType": "EN_ROUTE"
                    },
                    "positionalInfo": {
                      "pingInterval": 1800,
                      "distance": 120.5,
                      "speed": 55.0,
                      "accuracy": 122.5
                    }
                  }
                },
                "nonUspsLocation": {
                  "summary": "NON_USPS location with zip5",
                  "value": {
                    "externalLoadNumber": "ELN654321",
                    "appointmentID": "A123456789",
                    "appointmentDate": "2025-10-18T09:15:00Z",
                    "trailerID": "TRAILER5678",
                    "schedulerCRID": "01122445343",
                    "ETA": "2025-10-18T10:00:00Z",
                    "ETAStatus": "ON_TIME",
                    "location": {
                      "locationType": "NON_USPS",
                      "zip5": "20590",
                      "stopType": "PICKUP",
                      "stopSequence": 1
                    },
                    "currentLocation": {
                      "latitude": 40.0,
                      "longitude": -105.0,
                      "currentDateTime": "2025-10-18T08:45:00Z"
                    },
                    "currentEvent": {
                      "eventType": "PRE_ARRIVAL"
                    },
                    "positionalInfo": {
                      "pingInterval": 900,
                      "distance": 10.0,
                      "speed": 25.0,
                      "accuracy": 30.0
                    }
                  }
                },
                "customerLocation": {
                  "summary": "CUSTOMER location with zip5",
                  "value": {
                    "externalLoadNumber": "ELN777888",
                    "appointmentID": "A555666777",
                    "appointmentDate": "2025-11-01T10:00:00Z",
