{
  "openapi": "3.0.3",
  "info": {
    "title": "Environment Agency Flood Monitoring API",
    "description": "Real-time flood monitoring data for England including flood warnings, river levels, and measurement station data. Open data provided under the Open Government Licence with no registration required.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://environment.data.gov.uk/flood-monitoring/doc/reference",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://environment.data.gov.uk/flood-monitoring",
      "description": "Environment Agency Flood Monitoring API"
    }
  ],
  "paths": {
    "/id/floods": {
      "get": {
        "operationId": "listFloodWarnings",
        "summary": "List current flood warnings",
        "description": "Returns a list of current flood warnings and alerts. Can be filtered by severity, county, or geographic location.",
        "parameters": [
          {
            "name": "min-severity",
            "in": "query",
            "description": "Minimum severity level (1=Severe Flood Warning, 2=Flood Warning, 3=Flood Alert, 4=Warning no longer in force)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          {
            "name": "county",
            "in": "query",
            "description": "Filter by county name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "description": "Latitude for geographic filter",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "long",
            "in": "query",
            "description": "Longitude for geographic filter",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "dist",
            "in": "query",
            "description": "Radius in km for geographic filter (used with lat/long)",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "_limit",
            "in": "query",
            "description": "Maximum number of results to return",
            "schema": {
              "type": "integer",
              "default": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of flood warnings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FloodWarningsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/id/floodAreas": {
      "get": {
        "operationId": "listFloodAreas",
        "summary": "List flood areas",
        "description": "Returns a list of flood warning and alert areas.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "description": "Latitude for geographic filter",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "long",
            "in": "query",
            "description": "Longitude for geographic filter",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "dist",
            "in": "query",
            "description": "Radius in km for geographic filter",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "_limit",
            "in": "query",
            "description": "Maximum number of results",
            "schema": {
              "type": "integer",
              "default": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of flood areas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FloodAreasResponse"
                }
              }
            }
          }
        }
      }
    },
    "/id/floodAreas/{area_code}": {
      "get": {
        "operationId": "getFloodArea",
        "summary": "Get a specific flood area",
        "description": "Returns details of a specific flood warning or alert area.",
        "parameters": [
          {
            "name": "area_code",
            "in": "path",
            "required": true,
            "description": "Flood area code identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Flood area details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Flood area not found"
          }
        }
      }
    },
    "/id/stations": {
      "get": {
        "operationId": "listStations",
        "summary": "List measurement stations",
        "description": "Returns a list of measurement stations with optional filtering by parameter, location, river, or type.",
        "parameters": [
          {
            "name": "parameter",
            "in": "query",
            "description": "Filter by measurement parameter (e.g., level, flow, wind, temperature, rainfall)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "parameterName",
            "in": "query",
            "description": "Filter by full parameter name (e.g., Water Level, Flow)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "qualifier",
            "in": "query",
            "description": "Filter by qualifier (Stage, Downstream Stage, Groundwater, Tidal Level)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "label",
            "in": "query",
            "description": "Filter by exact station label",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "town",
            "in": "query",
            "description": "Filter by town name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "catchmentName",
            "in": "query",
            "description": "Filter by catchment area name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "riverName",
            "in": "query",
            "description": "Filter by river name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stationReference",
            "in": "query",
            "description": "Filter by station reference ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "RLOIid",
            "in": "query",
            "description": "Filter by RLOI identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Text search in station labels",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "description": "Latitude for geographic filter",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "long",
            "in": "query",
            "description": "Longitude for geographic filter",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "dist",
            "in": "query",
            "description": "Radius in km for geographic filter",
            "schema": {
              "type": "number",
              "format": "float"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Station type filter",
            "schema": {
              "type": "string",
              "enum": [
                "SingleLevel",
                "MultiTraceLevel",
                "Coastal",
                "Groundwater",
                "Meteorological"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Station status filter",
            "schema": {
              "type": "string",
              "enum": [
                "Active",
                "Closed",
                "Suspended"
              ]
            }
          },
          {
            "name": "_view",
            "in": "query",
            "description": "Set to 'full' to include scale information",
            "schema": {
              "type": "string",
              "enum": [
                "full"
              ]
            }
          },
          {
            "name": "_limit",
            "in": "query",
            "description": "Maximum number of results",
            "schema": {
              "type": "integer",
              "default": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of stations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/id/stations/{station_id}": {
      "get": {
        "operationId": "getStation",
        "summary": "Get a specific station",
        "description": "Returns details of a specific measurement station.",
        "parameters": [
          {
            "name": "station_id",
            "in": "path",
            "required": true,
            "description": "Station identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Station details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Station not found"
          }
        }
      }
    },
    "/id/measures": {
      "get": {
        "operationId": "listMeasures",
        "summary": "List measures",
        "description": "Returns a list of available measures across all stations.",
        "parameters": [
          {
            "name": "parameter",
            "in": "query",
            "description": "Filter by parameter short form (level, flow, etc.)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "parameterName",
            "in": "query",
            "description": "Filter by full parameter name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "qualifier",
            "in": "query",
            "description": "Filter by qualifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stationReference",
            "in": "query",
            "description": "Filter by station reference",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "station",
            "in": "query",
            "description": "Filter by station URI",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "_limit",
            "in": "query",
            "description": "Maximum number of results",
            "schema": {
              "type": "integer",
              "default": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of measures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasuresResponse"
                }
              }
            }
          }
        }
      }
    },
    "/id/stations/{station_id}/measures": {
      "get": {
        "operationId": "getStationMeasures",
        "summary": "Get measures for a station",
        "description": "Returns measures available at a specific station.",
        "parameters": [
          {
            "name": "station_id",
            "in": "path",
            "required": true,
            "description": "Station identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Station measures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasuresResponse"
                }
              }
            }
          }
        }
      }
    },
    "/data/readings": {
      "get": {
        "operationId": "listReadings",
        "summary": "List readings",
        "description": "Returns readings across stations. Supports filtering by date, parameter, and station. Data available for up to 4 weeks.",
        "parameters": [
          {
            "name": "latest",
            "in": "query",
            "description": "Return only the most recent reading per measure",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "today",
            "in": "query",
            "description": "Return today's readings only",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "Return readings for a specific date (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "startdate",
            "in": "query",
            "description": "Start date for date range filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "enddate",
            "in": "query",
            "description": "End date for date range filter (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "parameter",
            "in": "query",
            "description": "Filter by parameter short form",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "qualifier",
            "in": "query",
            "description": "Filter by qualifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stationReference",
            "in": "query",
            "description": "Filter by station reference",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "station",
            "in": "query",
            "description": "Filter by station URI",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "_view",
            "in": "query",
            "description": "Set to 'full' to include measure descriptions",
            "schema": {
              "type": "string",
              "enum": [
                "full"
              ]
            }
          },
          {
            "name": "_sorted",
            "in": "query",
            "description": "Sort descending by date",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "_limit",
            "in": "query",
            "description": "Maximum number of results (max 10000)",
            "schema": {
              "type": "integer",
              "default": 500,
              "maximum": 10000
            }
          },
          {
            "name": "_offset",
            "in": "query",
            "description": "Pagination offset",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of readings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/id/stations/{station_id}/readings": {
      "get": {
        "operationId": "getStationReadings",
        "summary": "Get readings for a station",
        "description": "Returns readings for a specific station. Supports date filtering and since parameter.",
        "parameters": [
          {
            "name": "station_id",
            "in": "path",
            "required": true,
            "description": "Station identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "description": "Return only the most recent reading",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "today",
            "in": "query",
            "description": "Return today's readings",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "Readings for specific date (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "startdate",
            "in": "query",
            "description": "Start date for range",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "enddate",
            "in": "query",
            "description": "End date for range",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Return readings since this datetime (ISO 8601)",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "_sorted",
            "in": "query",
            "description": "Sort descending by date",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "_limit",
            "in": "query",
            "description": "Maximum number of results",
            "schema": {
              "type": "integer",
              "default": 500,
              "maximum": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Station readings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/id/measures/{measure_id}/readings": {
      "get": {
        "operationId": "getMeasureReadings",
        "summary": "Get readings for a specific measure",
        "description": "Returns readings for a specific measure. Supports date and since filtering.",
        "parameters": [
          {
            "name": "measure_id",
            "in": "path",
            "required": true,
            "description": "Measure identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "description": "Return only the most recent reading",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "today",
            "in": "query",
            "description": "Return today's readings",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "Readings for specific date (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "startdate",
            "in": "query",
            "description": "Start date for range",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "enddate",
            "in": "query",
            "description": "End date for range",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Return readings since this datetime (ISO 8601)",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "_sorted",
            "in": "query",
            "description": "Sort descending by date",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "_limit",
            "in": "query",
            "description": "Maximum number of results",
            "schema": {
              "type": "integer",
              "default": 500,
              "maximum": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Measure readings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadingsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
