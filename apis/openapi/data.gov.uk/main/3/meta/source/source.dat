{
  "openapi": "3.0.3",
  "info": {
    "title": "data.gov.uk CKAN API",
    "description": "The UK Government open data portal API, powered by CKAN. Provides read access to UK government datasets (packages), resources, organisations (publishers), groups and tags published through the data.gov.uk platform.\n\nNo API key is required and there are no rate limits. Actions are invoked against the action API base URL documented at https://guidance.data.gov.uk/get_data/api_documentation/ ; parameters are supplied as URL query string values and every response is a JSON envelope with `success`, `result` and `help` fields.\n\nNote: data.gov.uk exposes a read-only subset of the CKAN action API. Only the dataset (package) and organisation (publisher) list/show/search actions documented at the source URL are publicly available; other CKAN actions return HTTP 403.",
    "version": "3",
    "contact": {
      "name": "data.gov.uk",
      "url": "https://data.gov.uk/"
    },
    "x-jentic-source-url": "https://guidance.data.gov.uk/get_data/api_documentation/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://data.gov.uk/api/action",
      "description": "data.gov.uk CKAN action API (documented public base URL)"
    }
  ],
  "paths": {
    "/package_list": {
      "get": {
        "operationId": "packageList",
        "summary": "List all dataset names",
        "description": "Return a list of the names of the site's datasets (packages).",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of packages to return",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Offset for pagination",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. `success` is true and `result` holds the action output.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanListResponse"
                }
              }
            }
          },
          "404": {
            "description": "Action or requested resource not found. `success` is false and `error` describes the problem.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          }
        }
      }
    },
    "/package_show": {
      "get": {
        "operationId": "packageShow",
        "summary": "Get dataset details",
        "description": "Return the metadata of a dataset (package) and its resources.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The id or name of the dataset",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. `success` is true and `result` holds the action output.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanPackageResponse"
                }
              }
            }
          },
          "404": {
            "description": "Action or requested resource not found. `success` is false and `error` describes the problem.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          }
        }
      }
    },
    "/package_search": {
      "get": {
        "operationId": "packageSearch",
        "summary": "Search datasets",
        "description": "Searches for datasets satisfying a given search criteria.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "The solr query string. Use * for all datasets.",
            "schema": {
              "type": "string",
              "default": "*:*"
            }
          },
          {
            "name": "fq",
            "in": "query",
            "description": "Filter query to apply",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Sort order, e.g., 'name asc', 'metadata_modified desc'",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rows",
            "in": "query",
            "description": "Number of matching rows to return (default 10)",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Offset in the complete result for pagination",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "facet",
            "in": "query",
            "description": "Enable faceted results (true/false)",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "facet.field",
            "in": "query",
            "description": "Fields to facet upon. Can be specified multiple times.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "facet.limit",
            "in": "query",
            "description": "Maximum number of values per facet field",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "include_private",
            "in": "query",
            "description": "Include private datasets (requires auth)",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. `success` is true and `result` holds the action output.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanSearchResponse"
                }
              }
            }
          },
          "404": {
            "description": "Action or requested resource not found. `success` is false and `error` describes the problem.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          }
        }
      }
    },
    "/organization_list": {
      "get": {
        "operationId": "organizationList",
        "summary": "List all organizations",
        "description": "Return a list of the names of the site's organizations.",
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Sort field and order, e.g., 'name asc'",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "all_fields",
            "in": "query",
            "description": "Return organization dictionaries instead of just names",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of organizations to return",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Offset for pagination",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. `success` is true and `result` holds the action output.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          },
          "404": {
            "description": "Action or requested resource not found. `success` is false and `error` describes the problem.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          }
        }
      }
    },
    "/organization_show": {
      "get": {
        "operationId": "organizationShow",
        "summary": "Get organization details",
        "description": "Return the details of an organization.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "The id or name of the organization",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_datasets",
            "in": "query",
            "description": "Include datasets in the organization",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response. `success` is true and `result` holds the action output.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          },
          "404": {
            "description": "Action or requested resource not found. `success` is false and `error` describes the problem.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CkanResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CkanListResponse": {
        "type": "object",
        "properties": {
          "help": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "result": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CkanResponse": {
        "type": "object",
        "properties": {
          "help": {
            "type": "string",
            "description": "URL to the help documentation for this action"
          },
          "success": {
            "type": "boolean",
            "description": "Whether the request was successful"
          },
          "result": {
            "description": "The result data"
          }
        }
      },
      "CkanPackageResponse": {
        "type": "object",
        "properties": {
          "help": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "result": {
            "$ref": "#/components/schemas/CkanPackage"
          }
        }
      },
      "CkanPackage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "description": "Dataset description"
          },
          "author": {
            "type": "string"
          },
          "author_email": {
            "type": "string"
          },
          "maintainer": {
            "type": "string"
          },
          "maintainer_email": {
            "type": "string"
          },
          "license_id": {
            "type": "string"
          },
          "license_title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "metadata_created": {
            "type": "string",
            "format": "date-time"
          },
          "metadata_modified": {
            "type": "string",
            "format": "date-time"
          },
          "num_resources": {
            "type": "integer"
          },
          "num_tags": {
            "type": "integer"
          },
          "organization": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CkanResource"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                }
              }
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "CkanResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "package_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "mimetype": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "nullable": true
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "last_modified": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string"
          },
          "resource_type": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CkanSearchResponse": {
        "type": "object",
        "properties": {
          "help": {
            "type": "string"
          },
          "success": {
            "type": "boolean"
          },
          "result": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "description": "Total number of matching results"
              },
              "sort": {
                "type": "string"
              },
              "facets": {
                "type": "object"
              },
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CkanPackage"
                }
              },
              "search_facets": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "security": []
}
