    "/orders/status": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Looks up the status for an order",
        "description": "Given a clinic-code and a list of reference-ids, provides the status of the\nassociated orders.\nThis reference-id is provided in the response to a post to the /orders endpoint.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "reference-ids",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "in": "query",
            "name": "clinic-code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "shipping-id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderStatusResults"
                }
              }
            }
          },
          "501": {
            "$ref": "#/components/responses/NotImplemented"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/orders/details": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Looks up the details for an order by the order id provided in when creating the order.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "reference-ids",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "in": "query",
            "name": "clinic-code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "shipping-id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetailsResult"
                }
              }
            }
          },
          "501": {
            "$ref": "#/components/responses/NotImplemented"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/vets/lookup": {
      "get": {
        "tags": [
          "vets"
        ],
        "summary": "Look up a Vet by province and license ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "province-code",
            "required": true,
            "description": "The two character provincial code.",
            "schema": {
              "example": true,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "license-id",
            "required": true,
            "description": "The license-id for the vet to look up.",
            "schema": {
              "example": 1234,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "clinic-code",
            "required": true,
            "description": "The clinic-code to cross-reference with the Vet",
            "schema": {
              "example": "K",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VetLookup"
                }
              }
            }
          },
          "404": {
            "description": "Valid vet not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VetLookupError"
                },
                "examples": {
                  "not-exist": {
                    "summary": "An example of a vet which does not exist.",
                    "value": {
                      "province": true,
                      "clinic-code": "K",
                      "license-id": "1234",
                      "message": "VET does not exist."
                    }
                  },
                  "not-xref": {
                    "summary": "An example of a vet which is not linked to the clinic.",
                    "value": {
                      "province": true,
                      "clinic-code": "K",
                      "license-id": "1234",
                      "message": "VET is not registered at the clinic."
                    }
                  },
                  "not-active": {
                    "summary": "An example of an inactive vet.",
                    "value": {
                      "province": true,
                      "clinic-code": "K",
                      "license-id": "1234",
                      "message": "VET is not active"
                    }
                  },
                  "suspended": {
                    "summary": "An example of a suspended license.",
                    "value": {
                      "province": true,
                      "clinic-code": "K",
                      "license-id": "1234",
                      "message": "VET license is suspended."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/web/products/ids": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "Returns web item IDs created since a given date",
        "description": "Returns the list of item numbers for products created since a given date.\nThis includes creation dates from both the master and the extension records.\nIf the `since` parameter is omitted, the system will return all items starting from the first one ever created.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2025-01-02T15:04:05"
            },
            "description": "Optional ISO 8601 datetime (UTC) to return only items created since that timestamp."
          }
        ],
        "responses": {
          "200": {
            "description": "Success – List of item IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "item-ids": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "item-number": {
                            "type": "string",
                            "example": "1234567"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input (e.g. malformed date)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "invalid time format, expected YYYY-MM-DDTHH:MM:SS"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/web/clinics/codes": {
      "get": {
        "tags": [
          "clinics"
        ],
        "summary": "Returns a list of clinic codes",
        "description": "Retrieves all clinic codes that have been created or updated since a given date.\nThe `since` parameter is optional and supports flexible formats:\n- `2006-01-02T15:04:05`\n- `2006-01-02 15:04:05`\n- `2006-01-02`\n\nIf the `since` parameter is omitted, defaults to `2006-01-02T15:04:05`.\n",
        "operationId": "getWebClinicCodes",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2024-01-01T00:00:00"
            },
            "description": "Optional timestamp filter. Returns clinics created or updated on or after this datetime.\nSupports formats:\n- `2006-01-02T15:04:05`\n- `2006-01-02 15:04:05`\n- `2006-01-02`\n"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of clinic codes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "clinic-codes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ClinicCode"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input format for 'since' parameter"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden – missing integration permission"
          }
        }
      }
    },
    "/web/clinics/details": {
      "get": {
        "tags": [
          "clinics"
        ],
        "summary": "Returns detailed clinic and ship-to information",
        "description": "Returns detailed information about clinics and their ship-to locations based on a comma-separated list of clinic codes.",
        "operationId": "getWebClinicDetails",
        "parameters": [
          {
            "name": "codes",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated list of clinic codes"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success – Returns clinic details and ship-to information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebClinicDetailResults"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/web/orders": {
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "Submit a new web order",
        "description": "Submits a new web order.  \nThis endpoint does not enforce any user-based restrictions or clinic permission checks.\n\n**Optional PunchOut Support:**\n- A `punchout` object can be included for order processing\n- All PunchOut fields are optional and support the PunchOut flow\n\n**Note:** In general, the response will return a `reference-id` even if there are issues with the order.\nTo retrieve detailed validation errors, use the `/web/orders/status` endpoint.\nThe `400` response is reserved for unexpected or technical issues with the input.\n",
        "operationId": "createWebOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/WebOrderSimple"
                  },
                  {
                    "$ref": "#/components/schemas/WebOrder"
                  }
                ]
              },
              "examples": {
                "standard": {
                  "summary": "Standard Order",
                  "value": {
                    "clinic-code": "A100",
                    "shipping-id": "0001",
                    "shipping-location": {
                      "name1": "Example Name",
                      "address1": "Example St",
                      "address2": "",
                      "city": "Toronto",
                      "province": "ON",
                      "postal": "M5H 2N2",
                      "phone-number": "519-555-1234"
                    },
                    "items": [
                      {
                        "item-id": "0500132",
                        "quantity": 1
                      }
                    ]
                  }
                },
                "epharma": {
                  "summary": "Order with prescription",
                  "value": {
                    "clinic-code": "A100",
                    "shipping-id": "0001",
                    "shipping-location": {
                      "name1": "John Doe",
                      "address1": "123 Main St",
                      "address2": "",
                      "city": "Toronto",
                      "province": "ON",
                      "postal": "M5H 2N2",
                      "phone-number": "519-555-1234"
                    },
                    "items": [
                      {
                        "item-id": "0500132",
                        "quantity": 1,
                        "prescription-label": {
                          "label-type": "companion",
                          "vet": {
                            "province": "ON",
                            "license-id": "1234",
                            "clinic-code": "K"
                          },
                          "clinic-code": "K",
                          "species": "Dog",
                          "product-name": "Prescription product",
                          "strength": "a value",
                          "unit-of-measure": "100mL",
                          "quantity": 1,
                          "directions": "Apply daily",
                          "refills": 3,
                          "refills-remaining": 2,
                          "expiry": "2025-11-29",
                          "pet-name": "Spot",
                          "pet-weight": "30lbs"
                        }
                      }
                    ]
                  }
                },
                "punchout": {
                  "summary": "PunchOut Order",
                  "value": {
                    "clinic-code": "K55",
                    "po-number": "custom-po-1234",
                    "shipping-id": "",
                    "shipping-location": {
                      "name1": "",
                      "address1": "",
                      "address2": "",
                      "city": "",
                      "province": "",
                      "postal": "",
                      "phone-number": ""
                    },
                    "items": [
                      {
                        "item-id": "1150120",
                        "quantity": 1
                      }
                    ],
                    "punchout": {
                      "post-url": "https://example.com/punchout/return",
                      "network-id": "ID123",
                      "address-id": "ADDR123",
                      "buyer-cookie": "SESSION12345"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order submitted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "reference-id": {
                      "type": "string",
                      "example": "WEBORD123456"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebValidationError"
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/web/orders/status": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Looks up the status for an order",
        "description": "Given a clinic-code and a list of reference-ids, provides the status of the\nassociated orders.\nThis reference-id is provided in the response to a post to the /orders endpoint.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "reference-ids",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "in": "query",
            "name": "clinic-code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "shipping-id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebOrderStatusResults"
                }
              }
            }
          },
          "501": {
            "$ref": "#/components/responses/NotImplemented"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/web/orders/ids": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Returns web order IDs created since a given date‐time",
        "description": "Retrieves the list of web order identifiers (order‐number, backorder‐code, clinic‐code, shipping‐id). Supports optional filtering by creation timestamp.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "type": "string",
              "example": "2025-07-25T13:45:00"
            },
            "description": "Optional timestamp to filter orders created *on or after* this datetime.\nAccepted formats:\n- `2006-01-02T15:04:05`\n- `2006-01-02 15:04:05`\n- `2006-01-02`\nIf omitted or blank, defaults to `2006-01-02T15:04:05` UTC.\n"
          }
        ],
        "responses": {
          "200": {
            "description": "Success – list of web order IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "web-order-ids": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WebOrderID"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid `since` format",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "invalid 'since' format; accepted: 2006-01-02T15:04:05, 2006-01-02 15:04:05 or 2006-01-02"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/web/orders/details": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Get Web Order Details by Order Number",
        "description": "Retrieves a single web order's full details by S2K order number, including shipping information,\nline items, pricing, comments, tracking numbers, and discount flags.\n",
        "operationId": "getWebOrderDetailsByOrderNumber",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "order-number",
            "in": "query",
            "required": true,
            "description": "S2K order number",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "clinic-code",
            "in": "query",
            "required": true,
            "description": "Clinic code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "shipping-id",
            "in": "query",
            "description": "Shipping ID",
            "schema": {
              "type": "string",
              "minLength": 4,
              "maxLength": 7
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Web order details found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order-details": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WebOrderDetail"
                      }
                    }
                  }
                },
                "example": {
                  "order-details": [
                    {
                      "reference-id": "ABCD1234EFGH",
                      "order-number": "1505623",
                      "clinic-code": "123456",
                      "po-number": "PO-98765",
                      "shipping-id": "SHIP1",
                      "order-date": "2025-08-05T09:30:00Z",
                      "shipping-override": {
                        "name1": "John Doe",
                        "address1": "123 Clinic Rd",
                        "address2": "Suite 200",
                        "city": "Toronto",
                        "province": "ON",
                        "postal": "M1M1M1",
                        "phone-number": "4165551234"
                      },
                      "tracking": [
                        {
                          "courier": "ATS",
                          "pin": "123456789"
                        }
                      ],
                      "lineitems": [
                        {
                          "item-id": "1150121",
                          "quantity": 2,
                          "price": 49.91,
                          "backordered": false,
                          "comments": "Please deliver ASAP",
                          "discount-applied": true
                        },
                        {
                          "item-id": "2220001",
                          "quantity": 1,
                          "price": 19.99,
                          "backordered": true,
                          "comments": "",
                          "discount-applied": false
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid parameters"
          },
          "403": {
            "description": "Unauthorized access"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/city/lookup": {
      "get": {
        "tags": [
          "city"
        ],
        "summary": "Look up valid city names based on the provided postal code.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "postal-code",
            "required": true,
            "description": "The postal code provided can either be 6 continuous characters or 7 including a space. It must be in the form of ANA NAN where \"A\" is alphanumeric and \"N\" is numeric.",
            "schema": {
              "example": "N4X1B7",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CityNameLookup"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidPostalCodeParameter"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/web/statements/ids": {
      "get": {
        "tags": [
          "statements"
        ],
        "summary": "Returns statement IDs created since a given date",
        "description": "Returns the list of statement IDs created since a given date.\nIf the since parameter is omitted, defaults to 2006-01-02T15:04:05.\nThe company parameter is optional and defaults to 1.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "company",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Company number. If not provided, defaults to 1."
          },
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2025-08-01T00:00:00"
            },
            "description": "Optional ISO 8601 datetime (UTC) to return only statements created since that timestamp.\nAccepted formats:\n  - 2006-01-02T15:04:05\n  - 2006-01-02 15:04:05\n  - 2006-01-02\nIf omitted, defaults to 2006-01-02T15:04:05.\n"
          },
          {
            "in": "query",
            "name": "clinic-code",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional clinic code to filter results."
          }
        ],
        "responses": {
          "200": {
            "description": "Success – List of statement IDs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebStatementIDResults"
                },
                "examples": {
                  "example": {
                    "summary": "Example response",
                    "value": {
                      "statement-ids": [
                        {
                          "statement-id": 123,
                          "clinic-code": "CUST001",
                          "company-number": 1
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input (e.g. malformed date)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "invalid time format, expected YYYY-MM-DDTHH:MM:SS"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/web/statements/details": {
      "get": {
        "tags": [
          "statements"
        ],
        "summary": "Returns statement details for a list of statement IDs",
        "description": "Returns the full details for the provided statement IDs. The company parameter is optional and defaults to 1.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "company",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Company number. If not provided, defaults to 1."
          },
          {
            "in": "query",
            "name": "statement-ids",
            "required": true,
            "schema": {
              "type": "string"
            },
            "style": "form",
            "explode": false,
            "description": "Comma-separated list of statement IDs to retrieve details for."
          }
        ],
        "responses": {
          "200": {
            "description": "Success – List of statement details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebStatementResults"
                },
                "examples": {
                  "example": {
                    "summary": "Example response",
                    "value": {
                      "statements": [
                        {
                          "statement-id": 123,
                          "company-number": 1,
                          "clinic-code": "CUST001",
                          "statement-print-date": "2024-08-01",
                          "created-timestamp": "2024-08-01T10:00:00",
                          "created-job": "JOB123",
                          "balance-forward": 100.0,
                          "age-code-0-balance": 50.0,
                          "age-code-1-balance": 0.0,
                          "age-code-2-balance": 0.0,
                          "age-code-3-balance": 0.0,
                          "age-code-4-balance": 0.0,
                          "age-code-5-balance": 0.0,
                          "eligible-discount-amount": 0.0,
                          "delayed-billing-balance": 0.0,
                          "amount-due-balance": 150.0,
                          "details": [
                            {
                              "statement-id": 123,
                              "statement-sequence": 1,
                              "invoice-date": "2024-07-15",
                              "statement-date": "2024-08-01",
                              "transaction-code": "INV",
                              "invoice-number": 456,
                              "invoice-sequence": 1,
                              "order-number": 789,
                              "backorder-code": 0,
                              "po-number": "PO123",
                              "transaction-amount": 150.0
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input (e.g. malformed statement-ids)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "invalid statement-ids format"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/web/regulatory-rules": {
      "get": {
        "tags": [
          "regulatory"
        ],
        "summary": "Returns regulatory rules for product types and destination types",
        "description": "Returns a list of regulatory rules associated with product types and destination types.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebRegulatoryRuleResults"
                },
                "example": {
                  "regulatory-rules": [
                    {
                      "product-type": "A",
                      "destination-type": "A",
                      "allow-purchase": true,
                      "licensed-vet-required": true,
                      "signature-on-file-required": false,
                      "precursor-date-check": true,
                      "active": true,
                      "last-update-date": "2022-06-03T08:34:02-04:00"
                    },
                    {
                      "product-type": "A",
                      "destination-type": "B",
                      "allow-purchase": false,
                      "licensed-vet-required": false,
                      "signature-on-file-required": false,
                      "precursor-date-check": false,
                      "active": true,
                      "last-update-date": "2022-06-03T08:34:28-04:00"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/web/promotions/bogos": {
      "get": {
        "tags": [
          "promotions"
        ],
        "summary": "Returns all active BOGO promotions",
        "description": "Returns a list of all active BOGO (Buy One Get One) promotions, including all required fields as per the specification.\n",
        "operationId": "getBogoPromotions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success – Returns all active BOGO promotions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "bogo-promotions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BogoPromotion"
                      }
                    }
                  }
                },
                "example": {
                  "bogo-promotions": [
                    {
                      "promotion-code": "BOGO123",
                      "promotion-description": "Buy 1 Get 1 Free on Product X",
                      "maximum-use-per-order": 2,
                      "buy-item": "ITEM001",
                      "buy-quantity": 1,
                      "get-item": "ITEM002",
