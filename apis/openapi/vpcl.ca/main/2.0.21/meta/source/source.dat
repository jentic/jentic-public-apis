                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/orders": {
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "Submit a new order directly to the backend.",
        "description": "Given a po-number, a clinic code, shipping-id, and a list of items and quantities,\ncreates an order for the VP system.\nFor accounts with the credentials to submit home delivery orders, a shipping-location field may also\nbe provided for the delivery address. Please see the schema for details.\nThe result body will return a unique reference-id used for further operations.\nThis is used to help disambiguate duplicate orders.",
        "requestBody": {
          "description": "The order to be placed.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderResult"
              },
              "examples": {
                "clinic-order": {
                  "summary": "A standard order shipping to a clinic",
                  "value": {
                    "po-number": "1234",
                    "clinic-code": "K",
                    "shipping-id": "0005",
                    "items": [
                      {
                        "item-id": "1234567",
                        "quantity": 3
                      },
                      {
                        "item-id": "1234568",
                        "quantity": 2
                      }
                    ]
                  }
                },
                "home-delivery": {
                  "summary": "An order shipping to home delivery",
                  "value": {
                    "po-number": "1235",
                    "clinic-code": "K",
                    "shipping-id": "0005",
                    "items": [
                      {
                        "item-id": "1234567",
                        "quantity": 3
                      },
                      {
                        "item-id": "1234568",
                        "quantity": 2
                      }
                    ],
                    "shipping-location": {
                      "name1": "John Doe",
                      "address1": "123 Main St",
                      "city": "St Marys",
                      "province": true,
                      "postal": "N4X1B7",
                      "phone-number": "555-555-5555"
                    }
                  }
                },
                "prescription": {
                  "summary": "Companion animal prescription home delivery",
                  "value": {
                    "po-number": "1236",
                    "clinic-code": "K",
                    "shipping-id": "0005",
                    "items": [
                      {
                        "item-id": "1234569",
                        "quantity": 2,
                        "prescription-label": {
                          "label-type": "companion",
                          "vet": {
                            "province": true,
                            "clinic-code": "K",
                            "license-id": "1234"
                          },
                          "clinic-code": "K",
                          "species": "Dog",
                          "product-name": "Prescription product",
                          "strength": "a value",
                          "unit-of-measure": "100mL",
                          "quantity": 1,
                          "directions": "Application instructions",
                          "refills": 3,
                          "expiry": "2025-11-29",
                          "pet-name": "Spot",
                          "pet-weight": "30lbs"
                        }
                      }
                    ]
                  }
                },
                "large-animal": {
                  "summary": "Large animal prescription delivery",
                  "value": {
                    "po-number": "1237",
                    "clinic-code": "K",
                    "shipping-id": "0005",
                    "items": [
                      {
                        "item-id": "1234570",
                        "quantity": 20,
                        "prescription-label": {
                          "label-type": "large-farm",
                          "vet": {
                            "province": true,
                            "clinic-code": "K",
                            "license-id": "1234"
                          },
                          "clinic-code": "K",
                          "species": "cow",
                          "product-name": "Prescription product",
                          "strength": "value",
                          "unit-of-measure": "100mL",
                          "quantity": "1L",
                          "directions": "Directions on use",
                          "refills": 0,
                          "expiry": "2025-11-29",
                          "number-of-animals": 20,
                          "premise-id": "123",
                          "withdrawal-type-1": "Milk",
                          "withdrawal-time-1": "2 hours",
                          "withdrawal-type-2": "Meat",
                          "withdrawal-time-2": "1 week"
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderID"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadOrderError"
                },
                "example": {
                  "message": "Invalid input",
                  "errors": [
                    {
                      "item-id": "123",
                      "field-name": "pet-name",
                      "message": "Field length exceeded",
                      "details": "maximum characters: 15"
                    },
                    {
                      "item-id": "123",
                      "field-name": "pet-weight",
                      "message": "Field length exceeded",
                      "details": "maximum characters: 15"
                    }
                  ]
                }
              }
            }
          },
          "501": {
            "$ref": "#/components/responses/NotImplemented"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/orders/prescription-label-types": {
      "get": {
        "tags": [
