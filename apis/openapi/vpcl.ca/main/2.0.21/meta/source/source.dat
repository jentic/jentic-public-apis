              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "clinic-code",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "shipping-id",
            "schema": {
              "type": "string"
            }
