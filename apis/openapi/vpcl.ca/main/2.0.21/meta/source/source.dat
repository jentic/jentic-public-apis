                      "get-item-charge": 0.0,
                      "promotion-start-date": "2024-06-01",
                      "promotion-end-date": "2024-06-30",
                      "combine-promotion": "Y",
                      "last-update-date": "2024-05-20"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
