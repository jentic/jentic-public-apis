            "example": "912674"
          },
          "order-number-suffix": {
            "type": "string",
            "description": "The backorder code padded to 3 digits (e.g., \"005\" or \"000\" for base orders)",
            "example": "005"
          },
          "clinic-code": {
            "type": "string"
          },
          "po-number": {
            "type": "string"
          },
          "shipping-id": {
            "type": "string"
          },
          "order-date": {
            "type": "string",
            "format": "date-time"
          },
          "order-placed-by": {
            "type": "string",
            "description": "The person who placed the order (OAWHO column from VCOHEAD)"
          },
          "order-source": {
            "type": "string",
            "description": "The source of the order (OAORDS column from VCOHEAD)"
          },
          "material-total": {
            "type": "number",
            "format": "float",
            "description": "Sum of all line item prices (price * quantity)",
            "example": 68.05
          },
          "discount-one": {
            "type": "number",
            "format": "float",
            "description": "Discount amount (OADSC1 column from VCOHEAD)",
            "example": 0
          },
          "handling-charge": {
            "type": "number",
            "format": "float",
            "description": "Handling charge (OAHAND column from VCOHEAD)",
            "example": 0
          },
          "miscellaneous-charge": {
            "type": "number",
            "format": "float",
            "description": "Miscellaneous charge (OAMISC column from VCOHEAD)",
            "example": 55.0
          },
          "freight-charge": {
            "type": "number",
            "format": "float",
            "description": "Freight charge (OAFRT column from VCOHEAD)",
            "example": 0
          },
          "tax": {
            "type": "number",
            "format": "float",
            "description": "Total tax amount (OAAMTX column from VCOHEAD)",
            "example": 16.0
          },
          "order-total": {
            "type": "number",
            "format": "float",
            "description": "Total order amount (OAITOT column from VCOHEAD)",
            "example": 139.05
          },
          "shipping-override": {
            "$ref": "#/components/schemas/ShippingLocation"
          },
          "tracking": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tracking"
            }
          },
          "lineitems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebLineItem"
            }
          }
        }
      },
