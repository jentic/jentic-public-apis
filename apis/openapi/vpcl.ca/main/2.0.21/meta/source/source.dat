      "WebLineItem": {
        "type": "object",
        "properties": {
          "item-id": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "price": {
            "type": "number",
            "format": "float"
          },
          "backordered": {
            "type": "boolean"
          },
          "comments": {
            "type": "string"
          },
          "discount-applied": {
            "type": "boolean"
          },
          "original-po-number": {
            "type": "string",
            "description": "For SWOG (Ship With One Order Group) consolidated orders, this is the original PO number  from the subsidiary or master order that this line item came from.  Only present when this line is part of a SWOG consolidation.\n",
            "example": "PO-12345"
          },
          "original-order-number-prefix": {
            "type": "string",
            "description": "For SWOG consolidated orders, this is the original order number (without backorder code)  that this line item came from. For master lines, it's the slave order that was consolidated. For slave lines, it's the master order they belong to. Only present when this line is part of a SWOG consolidation.\n",
            "example": "1170038"
          },
          "original-order-number-suffix": {
            "type": "string",
            "description": "For SWOG consolidated orders, this is the original backorder code (padded to 3 digits)  that this line item came from. Only present when this line is part of a SWOG consolidation.\n",
            "example": "004"
          },
          "prescription-label": {
            "$ref": "#/components/schemas/WebPrescriptionLabelInput"
          }
        },
        "required": [
          "item-id",
          "quantity",
          "price",
          "backordered",
          "comments",
          "discount-applied"
        ]
      },
