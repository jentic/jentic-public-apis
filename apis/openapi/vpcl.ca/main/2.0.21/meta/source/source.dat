              "invoice-number": "152555",
              "clinic-code": "C78",
              "invoice-type": "rebate"
            }
          ]
        }
      },
      "WebInvoiceDetail": {
        "type": "object",
        "properties": {
          "invoice-number": {
            "type": "integer",
            "description": "The invoice number",
            "example": 1373399
          },
          "invoice-type": {
            "type": "string",
            "description": "Type of invoice - \"invoice\" for regular invoices, \"rebate\" for rebate invoices, \"interest\" for interest/finance charge invoices",
            "enum": [
              "invoice",
              "rebate",
              "interest"
            ],
            "example": "invoice"
          },
          "order-number": {
            "type": "integer",
            "description": "The order number",
            "example": 1504809
          },
          "order-backorder-code": {
            "type": "string",
            "description": "The backorder code (3 digits with leading zeros)",
            "example": "000"
          },
          "invoice-date": {
            "type": "string",
            "format": "date",
            "description": "Invoice date in YYYY-MM-DD format",
            "example": "2024-08-19"
          },
          "clinic-code": {
            "type": "string",
            "description": "The clinic code",
            "example": "D71"
          },
          "customer-po": {
            "type": "string",
            "description": "Customer purchase order number",
            "example": "PO123456"
          },
          "ship-via-code": {
            "type": "string",
            "description": "Shipping method code",
            "example": "UPS"
          },
          "backorder-split": {
            "type": "string",
            "description": "Backorder split flag (Y/N)",
            "example": "N"
          },
          "order-date": {
            "type": "string",
            "format": "date",
            "description": "Order date in YYYY-MM-DD format",
            "example": "2024-08-15"
          },
          "date-shipped": {
            "type": "string",
            "format": "date",
            "description": "Date shipped in YYYY-MM-DD format",
            "example": "2024-08-18"
          },
          "company-info": {
            "$ref": "#/components/schemas/WebInvoiceCompanyInfo"
          },
          "bill-to-info": {
            "$ref": "#/components/schemas/WebInvoiceBillToInfo"
          },
          "ship-to-info": {
            "$ref": "#/components/schemas/WebInvoiceShipToInfo"
          },
          "term-info": {
            "$ref": "#/components/schemas/WebInvoiceTermInfo"
          },
          "fees": {
            "$ref": "#/components/schemas/WebInvoiceFees"
          },
          "taxes": {
            "$ref": "#/components/schemas/WebInvoiceTaxes"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebInvoiceLineItem"
            }
          },
          "comments": {
            "$ref": "#/components/schemas/WebInvoiceComments"
          },
          "therapeutic-summary": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebInvoiceTherapeuticSummary"
            }
          },
          "totals": {
            "$ref": "#/components/schemas/WebInvoiceTotals"
          },
          "company-messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebInvoiceCompanyMessage"
            }
          },
          "rebate-info": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/WebInvoiceRebateInfo"
              }
            ],
            "description": "**Optional.** Rebate-specific information. Only populated when `invoice-type` is \"rebate\".\nReturns null for regular invoices and interest invoices.\n"
          },
          "interest-info": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/WebInvoiceInterestInfo"
              }
            ],
            "description": "**Optional.** Interest/finance charge specific information. Only populated when `invoice-type` is \"interest\".\nReturns null for regular invoices and rebate invoices.\n"
          }
        },
        "required": [
          "invoice-number",
          "invoice-type",
          "invoice-date",
          "clinic-code",
          "company-info",
          "bill-to-info",
          "ship-to-info",
          "term-info",
          "fees",
          "taxes",
          "details",
          "comments",
          "totals"
        ]
      },
