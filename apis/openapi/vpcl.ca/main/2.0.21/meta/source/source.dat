{
  "openapi": "3.0.3",
  "info": {
    "title": "VPCL API Service",
    "description": "This is the documentation for the API Service for VPCL integration.\nAll calls to the API will require a header token, received as part of the call to /tokens/authentication",
    "contact": {
      "email": "dev.support@vpcl.on.ca"
    },
    "version": "2.0.21",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/FABSANTANDREA/vpcl-api-service/2.0.21"
  },
  "externalDocs": {
    "description": "VPCL",
    "url": "http://vpcl.ca"
  },
  "servers": [
    {
      "url": "https://connecttest.vpcl.ca/api/v2",
      "description": "Test server"
    },
    {
      "url": "https://connect.vpcl.ca/api/v2",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Authentication"
    },
    {
      "name": "products",
      "description": "Item information"
    },
    {
      "name": "clinics",
      "description": "Clinic information"
    },
    {
      "name": "carts",
      "description": "Carts"
    },
    {
      "name": "orders",
      "description": "Orders"
    },
    {
      "name": "reports",
      "description": "Reports"
    },
    {
      "name": "statements",
      "description": "Statement information"
    },
    {
      "name": "vets",
      "description": "Vet lookup"
    },
    {
      "name": "city",
      "description": "City lookup"
    },
    {
      "name": "promotions",
      "description": "Promotions"
    },
    {
      "name": "invoices",
      "description": "Invoice information"
    }
  ],
  "paths": {
    "/tokens/authentication": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Get new auth token",
        "description": "Gets a new authentication token for the user",
        "requestBody": {
          "description": "Authentication parameters",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthToken"
                }
              }
            }
          },
          "422": {
            "description": "input error"
          }
        }
      }
    },
    "/reports/vendor/inventory": {
      "get": {
        "tags": [
          "reports"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/producttypes/details": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "Returns the list of product types.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductTypeResults"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/products/ids": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "Returns products ids",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "new",
                "type",
                "discontinued",
                "vendor"
              ],
              "default": "all"
            },
            "description": "Query type. If this parameter is not provided, defaults to all."
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "type": "string"
            },
            "description": "A product type specified by a request to the /producttypes/details endpoint."
          },
          {
            "in": "query",
            "name": "vendor",
            "schema": {
              "type": "string"
            },
            "description": "The vendor code to use for searching for items from a specific vendor."
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemIDResults"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/products/details": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "Returns product details",
        "parameters": [
          {
            "in": "query",
            "name": "ids",
            "schema": {
              "type": "string"
            },
            "style": "form",
            "explode": false
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/products/quantitiesandprices": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "Returns information on current inventory and prices",
