          },
          "misc-service-charges": {
            "type": "number",
            "format": "float",
            "example": 0.0
          }
        }
      },
      "WebInvoiceTaxes": {
        "type": "object",
        "properties": {
          "state-tax": {
            "type": "number",
            "format": "float",
            "example": 0.0
          },
          "county-tax": {
            "type": "number",
            "format": "float",
            "example": 0.0
          },
          "local-tax1": {
            "type": "number",
            "format": "float",
            "example": 0.0
          },
          "local-tax2": {
            "type": "number",
            "format": "float",
            "example": 0.0
          }
        }
      },
      "WebInvoiceLineItem": {
        "type": "object",
        "properties": {
          "line-number": {
            "type": "integer",
            "example": 1
          },
          "item-number": {
            "type": "string",
            "example": "ITEM001"
          },
          "sell-price": {
            "type": "number",
            "format": "float",
            "example": 25.99
          },
          "qty-ordered": {
            "type": "number",
            "format": "float",
            "example": 2
          },
          "qty-shipped": {
            "type": "number",
            "format": "float",
            "example": 2
          },
          "qty-backorder": {
            "type": "number",
            "format": "float",
            "example": 0
          },
          "extended-amount": {
            "type": "number",
            "format": "float",
            "example": 51.98
          },
          "division": {
            "type": "integer",
            "example": 1
          },
          "my-vet-store": {
            "type": "string",
            "description": "MyVetStore flag (Y/N)",
            "example": "Y"
          },
          "price-status": {
            "type": "string",
            "description": "Price status (NW=New, UP=Price Increase, DN=Price Decrease, **=Promotional)",
            "example": "NW"
          },
          "rebate-code": {
            "type": "string",
            "description": "Rebate code (Q=Quarterly, A=ASR, N=No Rebate)",
            "example": "Q"
          },
          "original-order-number": {
            "type": "integer",
            "description": "Original order number if this is a SWOG order",
            "example": 1500123
          },
          "original-po-number": {
            "type": "string",
            "description": "Original PO number",
            "example": "ORIG-PO-456"
          }
        }
      },
      "WebInvoiceComments": {
        "type": "object",
        "properties": {
          "comment-1": {
            "type": "string",
            "example": "Thank you for your business"
          },
          "comment-2": {
            "type": "string",
            "example": "Original Orders: 1504809"
          },
          "comment-3": {
            "type": "string",
            "example": ""
          },
          "comment-4": {
            "type": "string",
            "example": ""
          },
          "comment-5": {
            "type": "string",
            "example": ""
          }
        }
      },
      "WebInvoiceTherapeuticSummary": {
        "type": "object",
        "properties": {
          "therapeutic-division": {
            "type": "integer",
            "example": 1
          },
          "amount": {
            "type": "number",
            "format": "float",
            "example": 51.98
          }
        }
      },
      "WebInvoiceTotals": {
        "type": "object",
        "properties": {
          "items-subtotal": {
            "type": "number",
            "format": "float",
            "example": 51.98
          },
          "total-fees": {
            "type": "number",
            "format": "float",
            "example": 5.0
          },
          "total-sales-tax": {
            "type": "number",
            "format": "float",
            "example": 6.76
          },
          "invoice-total": {
            "type": "number",
            "format": "float",
            "example": 63.74
          }
        }
      },
      "WebInvoiceCompanyMessage": {
        "type": "object",
        "properties": {
          "sequence-number": {
            "type": "integer",
            "example": 1
          },
          "message": {
            "type": "string",
            "example": "Welcome to our new online ordering system"
          }
        }
      },
      "WebInvoiceRebateInfo": {
        "type": "object",
        "description": "Rebate-specific information for rebate invoices",
        "properties": {
          "rebate-id": {
            "type": "string",
            "description": "The rebate ID",
            "example": "REBATE001"
          },
          "rebate-name": {
            "type": "string",
            "description": "Primary rebate name/description",
            "example": "Quarterly Rebate Program"
          },
          "rebate-name2": {
            "type": "string",
            "description": "Secondary rebate name/description",
            "example": "Volume Discount"
          },
          "rebate-name3": {
            "type": "string",
            "description": "Tertiary rebate name/description",
            "example": "Early Payment Bonus"
          },
          "posted-to-ar-or-ap": {
            "type": "string",
            "description": "Whether posted to AR (Accounts Receivable) or AP (Accounts Payable)",
            "example": "AR"
          },
          "posted-date": {
            "type": "string",
            "format": "date",
            "description": "Date when rebate was posted",
            "example": "2024-08-20"
          },
          "posting-period": {
            "type": "integer",
            "description": "Posting period (CCYY/MM format)",
            "example": 202408
          },
          "posting-batch": {
            "type": "integer",
            "description": "Posting batch number",
            "example": 12345
          },
          "transaction-date": {
            "type": "string",
            "format": "date",
            "description": "Transaction date for the rebate",
            "example": "2024-08-19"
          },
          "sales-invoice": {
            "type": "integer",
            "format": "int64",
            "description": "Original sales invoice number associated with the rebate",
            "example": 1373399
          },
          "item-number": {
            "type": "string",
            "description": "Item number related to the rebate",
            "example": "0500132"
          },
          "payment-method": {
            "type": "string",
            "description": "Payment method for the rebate",
            "example": "CHECK"
          },
          "vendor-number": {
            "type": "string",
            "description": "Vendor number associated with the rebate",
            "example": "V123"
          }
        }
      },
      "WebInvoiceInterestInfo": {
        "type": "object",
        "description": "Interest/finance charge specific information for interest invoices",
        "properties": {
          "description": {
            "type": "string",
            "description": "Description of the interest charge (usually \"INTEREST CHARGE\")",
            "example": "INTEREST CHARGE"
          },
          "interest-rate": {
            "type": "number",
            "format": "float",
            "description": "Late charge percentage/interest rate applied",
            "example": 1.5
          },
          "interest-amount": {
            "type": "number",
            "format": "float",
            "description": "The actual interest amount charged",
            "example": 25.5
          },
          "foreign-amount": {
            "type": "number",
            "format": "float",
            "description": "Foreign currency amount if applicable",
            "example": 0.0
          },
          "batch-number": {
            "type": "integer",
            "description": "Batch number from ARUPIN",
            "example": 5678
          },
          "posting-period": {
            "type": "integer",
            "description": "Fiscal period (CCYY/MM format)",
            "example": 202408
          },
          "aging-code": {
            "type": "integer",
            "description": "Aging bucket code",
            "example": 4
          },
          "aging-date": {
            "type": "string",
            "format": "date",
            "description": "Date used for aging calculation",
            "example": "2024-07-20"
          },
          "account-status": {
            "type": "integer",
            "description": "Customer account status code",
            "example": 1
          },
          "parent-customer": {
            "type": "string",
            "description": "Parent customer code if applicable",
            "example": ""
          },
          "state-description": {
            "type": "string",
            "description": "State name for tax jurisdiction",
            "example": "Ontario"
          }
        }
      },
      "WebCart": {
        "type": "object",
        "description": "Web cart information with associated cart items",
        "properties": {
          "username": {
            "type": "string",
            "description": "Name of the user who created the cart (from users table), or email address if name not available",
            "example": "john.smith@example.com"
          },
          "clinic-code": {
            "type": "string",
            "description": "The clinic code",
            "example": "D71"
          },
          "shipping-id": {
            "type": "string",
            "description": "Shipping identifier",
            "example": "001R"
          },
          "cart-reference-id": {
            "type": "string",
            "description": "Unique cart reference ID",
            "example": "WEB-12345-001"
          },
          "po-number": {
            "type": "string",
            "description": "Purchase order number",
            "example": "PO123456"
          },
          "order-placed-by": {
            "type": "string",
            "description": "Name of the person who placed the order (from users table)",
            "example": "Dr. John Smith"
          },
          "cart-items": {
            "type": "array",
            "description": "List of items in the cart",
            "items": {
              "$ref": "#/components/schemas/WebCartItem"
            }
          }
        }
      },
      "WebCartItem": {
        "type": "object",
        "description": "Individual item within a web cart",
        "properties": {
          "item-sequence-number": {
            "type": "integer",
            "description": "Sequence number of the item in the cart",
            "example": 1
          },
          "item-number": {
            "type": "string",
            "description": "Item/product number",
            "example": "0500132"
          },
          "quantity": {
            "type": "integer",
            "description": "Quantity of the item",
            "example": 2
          },
          "note": {
            "type": "string",
            "description": "Optional note for the item",
            "example": "Rush order"
          }
        }
      },
      "WebContactDetail": {
        "type": "object",
        "description": "Contact information for a clinic",
        "properties": {
          "contact-name": {
            "type": "string",
            "description": "Full name of the contact (first name + last name)",
            "example": "Dr. John Smith"
          },
          "communication-type": {
            "type": "string",
            "description": "Job title or communication type description",
            "example": "Veterinarian"
          },
          "email-address": {
            "type": "string",
            "format": "email",
            "description": "Email address of the contact",
            "example": "john.smith@clinic.com"
          },
          "active": {
            "type": "boolean",
            "description": "Whether the contact is active",
            "example": true
          }
        },
        "example": {
          "contact-name": "Dr. Jane Doe",
          "communication-type": "Manager",
          "email-address": "jane.doe@example.com",
          "active": true
        }
      },
      "CityNameLookup": {
        "type": "object",
        "properties": {
          "long-city-name": {
            "type": "string",
            "maxLength": 30
          },
          "valid-city-name": {
            "type": "string",
            "maxLength": 17
          },
          "province": {
            "type": "string",
            "maxLength": 2
          },
          "postal-code": {
            "type": "string",
            "maxLength": 7
          }
        },
        "example": {
          "long-city-name": "MONTREAL RIVER HARBOUR",
          "valid-city-name": "MONTL-RIV-HBR",
          "province": true,
          "postal-code": "A1A1A1"
        }
      },
      "WebOrderCancelResponse": {
        "type": "object",
        "description": "Response from order cancellation request",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates if the cancellation was successful (true if RESULT_ERROR is empty/blank)",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Result message from the stored procedure",
            "example": "Your cancel request has been submitted"
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "WebOrderModificationResponse": {
        "type": "object",
        "description": "Response from order modification request",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates if the modification was successful (true if RESULT_ERROR is empty/blank)",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Result message from the stored procedure",
            "example": "Your change request has been submitted"
          }
        },
        "required": [
          "success",
          "message"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Access token is missing or invalid, or the user does not have appropriate permissions"
      },
      "NotImplemented": {
        "description": "This API is not yet implemented, but is planned."
      },
      "InvalidPostalCodeParameter": {
        "description": "Postal code not found"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
