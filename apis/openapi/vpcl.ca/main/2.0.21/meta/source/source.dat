    "/clinics/search": {
      "get": {
        "tags": [
          "clinics"
        ],
        "summary": "Searches for a clinic",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Search term for clinic search"
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClinicDetailResults"
                }
              }
            }
          },
          "400": {
            "description": "Search term is missing or shorter than two characters in length."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/clinics/details": {
      "get": {
        "tags": [
          "clinics"
        ],
        "summary": "Returns the details for a clinic",
