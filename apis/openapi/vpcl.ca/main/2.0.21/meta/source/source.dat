            "type": "string"
          },
          "vpcl-class": {
            "type": "string"
          },
          "product-type": {
            "type": "string"
          },
          "product-sub-type": {
            "type": "string"
          },
          "web-category-code": {
            "type": "integer"
          },
          "web-sub-category-code": {
            "type": "integer"
          },
          "therapeutic-index-number": {
            "type": "string"
          },
          "master-last-update-date": {
            "type": "string",
            "format": "date-time"
          },
          "extension-last-update-date": {
            "type": "string",
            "format": "date-time"
          },
          "estimated-arrival-date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "similar-items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SimilarItem"
            }
          },
          "delivery-restrictions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebItemRestriction"
            }
          },
          "epharma": {
            "type": "boolean"
          },
          "cubic-measure": {
            "type": "string"
          },
          "weight": {
            "type": "string"
          },
          "date-created": {
            "type": "string",
            "format": "date"
          },
          "dangerous-good": {
            "type": "boolean",
            "description": "True when item is classified as dangerous good (I1DNG = 1)",
            "example": false
          },
          "limited-quantity": {
            "type": "boolean",
            "description": "True when item is classified as limited quantity (I1DNG = 5)",
            "example": false
          },
          "excepted-quantity": {
            "type": "boolean",
            "description": "True when item is classified as excepted quantity (I1DNG = 7)",
            "example": false
          },
          "dangerous-good-un-code": {
            "type": "string",
            "description": "UN code for dangerous goods classification",
            "example": "UN1203"
          },
          "dangerous-good-description1": {
            "type": "string",
            "description": "Primary description of dangerous goods",
            "example": "Gasoline"
          },
          "dangerous-good-description2": {
            "type": "string",
            "description": "Secondary description of dangerous goods",
            "example": "Motor spirit"
          },
          "dangerous-good-class": {
            "type": "string",
            "description": "Dangerous goods class",
            "example": "3"
          },
          "dangerous-good-package-group": {
            "type": "string",
            "description": "Package group for dangerous goods",
            "example": "II"
          },
          "dangerous-good-special-provision": {
            "type": "string",
            "description": "Special provisions for dangerous goods handling",
            "example": "144"
          },
          "omit-from-ecommerce": {
            "type": "boolean",
            "description": "True when item should be omitted from e-commerce (I1PCRP != 'N')",
            "example": false
          },
          "universal-product-code": {
            "type": "string",
            "description": "Universal Product Code (UPC/Barcode)",
            "example": "012345678901"
          },
          "item-width": {
            "type": "string",
            "description": "Item width measurement",
            "example": "10.5"
          },
          "item-length": {
            "type": "string",
            "description": "Item length measurement",
            "example": "15.2"
          },
          "item-height": {
            "type": "string",
            "description": "Item height measurement",
            "example": "8.0"
          },
          "supplier-return-percentage": {
            "type": "number",
            "format": "float",
            "description": "Supplier return percentage",
            "example": 10.5
          },
          "therapeutic-division": {
            "type": "string",
            "description": "Therapeutic division classification",
            "example": "CARDIOLOGY"
          },
          "delayed-billing-due-date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Earliest delayed billing due date for the product. Returns null if unavailable or all dates are past.",
            "example": "2025-10-15"
          },
          "made-in-canada": {
            "type": "boolean",
            "description": "Indicates if the product is made in Canada (UDFBVALUE = 'M')",
            "example": true
          },
          "product-of-canada": {
            "type": "boolean",
            "description": "Indicates if the product is a product of Canada (UDFBVALUE = 'P')",
            "example": false
          },
          "stock-item": {
            "type": "boolean",
            "description": "Indicates if this is a stock item (ICSTK = 'Y')",
            "example": true
          },
          "allow-backorder": {
            "type": "boolean",
            "description": "Indicates if backorders are allowed for this item. False when UDFBVALUE = 'N' (UDFBFILD = 3), true otherwise.",
            "example": true
          },
          "delayed-billing-start-date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Start date for delayed billing from ZCOCSCD (OKFDTE). Returns null if no valid date exists (excludes 0).",
            "example": "2025-11-15"
          },
          "delayed-billing-end-date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "End date for delayed billing from ZCOCSCD (OKTDTE). Returns null if no valid date exists (excludes 0 and 99999999 for permanent billing).",
            "example": "2025-12-31"
          },
          "short-date": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Shortest expiry date for items with short shelf life (VINLOT.IVSLDT). Only applies when ICCRMO = 'Y'. Shows dates within 90 days from current date for lots with available balance in active bins. Returns empty string if no short-dated lots exist.",
            "example": "2025-12-15"
          },
          "vtex-product-id": {
            "type": "string",
            "description": "VTEX e-commerce platform product ID from ZUDDTA (UDFBFILD = 4)",
            "example": "12345"
          },
          "vtex-product-name": {
            "type": "string",
            "description": "VTEX e-commerce platform product name from ZUDDTA (UDFBFILD = 5)",
            "example": "Acepromazine 10mg Tablets"
          },
          "unspsc-code": {
            "type": "string",
            "description": "Commodity code for Punchout integration from VINITEM.ICCMDT. Defaults to '51000000' if blank.",
            "example": "51000000"
          }
        }
      },
