    "/web/invoices/ids": {
      "get": {
        "tags": [
          "invoices"
        ],
        "summary": "Returns invoice records",
        "description": "Returns a list of invoice records. All parameters are optional.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "**Optional.** Filters results to include only invoices created since this date.\nIf omitted, returns all invoices.\nAccepts multiple formats: YYYY-MM-DDTHH:MM:SS, YYYY-MM-DD HH:MM:SS, or YYYY-MM-DD\n",
            "example": "2024-01-01T00:00:00"
          },
          {
            "in": "query",
            "name": "company",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1"
            },
            "description": "**Optional.** Company number to filter by. \n**Default value: \"1\"** if not provided.\n",
            "example": "1"
          },
          {
            "in": "query",
            "name": "clinic-code",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "**Optional.** Clinic code to filter invoices for a specific clinic.\nIf omitted, returns invoices for all clinics.\n",
            "example": "C188"
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebInvoiceResults"
                },
                "example": {
                  "invoices": [
                    {
                      "invoice-number": "153404",
                      "clinic-code": "C188",
                      "invoice-type": "invoice"
                    },
                    {
                      "invoice-number": "152555",
                      "clinic-code": "C78",
                      "invoice-type": "rebate"
                    },
                    {
                      "invoice-number": "152556",
                      "clinic-code": "C78",
                      "invoice-type": "interest"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters (e.g., invalid date format or company number)"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/web/invoices/details": {
      "get": {
        "tags": [
          "invoices"
        ],
        "summary": "Returns detailed invoice information",
        "description": "Returns comprehensive invoice details including line items, comments, therapeutic summaries, \nfees, taxes, totals, and company messages for a specific invoice number and clinic code.\n\n**Note:** An invoice can have multiple order/backorder combinations, so the response \nreturns an array of invoice objects.\n\n**Optional/Conditional Fields:**\n- `rebate-info`: Only populated when `invoice-type` is \"rebate\"\n- `interest-info`: Only populated when `invoice-type` is \"interest\"\n- Fields marked as nullable may return null when data is not available\n",
        "operationId": "getWebInvoiceDetails",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "invoice-number",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "**Required.** The invoice number to retrieve details for.\n",
            "example": "1373399"
          },
          {
            "in": "query",
            "name": "clinic-code",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "**Required.** The clinic code associated with the invoice.\n",
            "example": "D71"
          },
          {
            "in": "query",
            "name": "company",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1"
            },
            "description": "**Optional.** Company number to filter by.\n**Default value: \"1\"** if not provided.\n",
            "example": "1"
          }
        ],
        "responses": {
          "200": {
            "description": "Success - Returns detailed invoice information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "invoices": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WebInvoiceDetail"
                      }
                    }
                  }
                },
                "example": {
                  "invoices": [
                    {
                      "invoice-number": 1373399,
                      "order-number": 1504809,
                      "order-backorder-code": "000",
                      "invoice-date": "2024-08-19",
                      "clinic-code": "D71",
                      "customer-po": "PO123456",
                      "ship-via-code": "UPS",
                      "backorder-split": "N",
                      "order-date": "2024-08-15",
                      "date-shipped": "2024-08-18",
                      "company-info": {
                        "company": 1,
                        "company-name": "Veterinary Purchasing Company",
                        "address1": "123 Main St",
                        "city": "Toronto",
                        "state": "ON",
                        "postal-code": "M1M 1M1",
                        "country": "CA",
                        "phone": "416-555-0123",
                        "federal-tax-id": "123456789"
                      },
                      "bill-to-info": {
                        "clinic-code": "D71",
                        "company-name": "Sample Veterinary Clinic",
                        "address1": "456 Clinic Ave",
                        "city": "Toronto",
                        "state": "ON",
                        "postal-code": "M2M 2M2",
                        "phone": "416-555-0456"
                      },
                      "details": [
                        {
                          "line-number": 1,
                          "item-number": "ITEM001",
                          "sell-price": 25.99,
                          "qty-ordered": 2,
                          "qty-shipped": 2,
                          "qty-backorder": 0,
                          "extended-amount": 51.98,
                          "division": 1,
                          "my-vet-store": "Y",
                          "price-status": "NW",
                          "rebate-code": "Q",
                          "original-order-number": 1500123,
                          "original-po-number": "ORIG-PO-456"
                        }
                      ],
                      "totals": {
                        "items-subtotal": 51.98,
                        "total-fees": 5.0,
                        "total-sales-tax": 6.76,
                        "invoice-total": 63.74
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing required parameters or invalid format"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Invoice not found"
          }
        }
      }
    },
    "/web/carts": {
      "get": {
        "tags": [
          "carts"
        ],
        "summary": "Returns web cart information",
        "description": "Returns web cart information with cart items created since a given date.\nThe `since` parameter is optional and supports flexible formats:\n- `2006-01-02T15:04:05`\n- `2006-01-02 15:04:05`\n- `2006-01-02`\n\nIf the `since` parameter is omitted, defaults to `2006-01-02T15:04:05`.\n",
        "operationId": "getWebCarts",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "**Optional.** ISO 8601 datetime (UTC) to return only carts created since that timestamp.\nSupports multiple formats: `2006-01-02T15:04:05`, `2006-01-02 15:04:05`, or `2006-01-02`.\n",
            "example": "2025-01-01T00:00:00"
          }
        ],
        "responses": {
          "200": {
            "description": "Success - Returns web cart information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "carts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WebCart"
                      }
                    }
                  }
                },
                "example": {
                  "carts": [
                    {
                      "username": "Dr. John Smith",
                      "clinic-code": "D71",
                      "shipping-id": "001R",
                      "cart-reference-id": "WEB-12345-001",
                      "po-number": "PO123456",
                      "order-placed-by": "Dr. John Smith",
                      "cart-items": [
                        {
                          "item-sequence-number": 1,
                          "item-number": "0500132",
                          "quantity": 2,
                          "note": "Rush order"
                        },
                        {
                          "item-sequence-number": 2,
                          "item-number": "0500133",
                          "quantity": 1,
                          "note": ""
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid 'since' format"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/web/orders/cancel": {
      "post": {
        "tags": [
          "orders"
        ],
        "summary": "Cancel an ERP order",
        "description": "Submits a cancel request for an existing ERP order.\n\n**Accepted Order Sources:**\n- `F` - Fax/Email orders\n- `I` - Internet orders\n- `P` - Phone orders\n\nOrders with other source types cannot be cancelled through this endpoint.\n\n**Note:** This endpoint requires the `bw:integration` permission.\n",
        "operationId": "cancelWebOrder",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "erp-order-number"
                ],
                "properties": {
                  "erp-order-number": {
                    "type": "integer",
                    "description": "The ERP order number to cancel (must be a positive integer)",
                    "example": 1506293
                  }
                }
              },
              "example": {
                "erp-order-number": 1506293
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cancel request processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WebOrderCancelResponse"
                      }
                    }
                  }
                },
                "example": {
                  "results": [
                    {
                      "success": true,
                      "message": "Your cancel request has been submitted"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input - missing or invalid erp-order-number",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "erp-order-number is required and must be a positive integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "description": "Forbidden - User does not have bw:integration permission"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/web/orders/lineitem/modify": {
      "put": {
        "tags": [
          "orders"
        ],
        "summary": "Modify an order line item quantity",
        "description": "Modifies the quantity of a specific line item in an existing ERP order.\n\n**Accepted Order Sources:**\n- `F` - Fax/Email orders\n- `I` - Internet orders\n- `P` - Phone orders\n\nOrders with other source types cannot be modified through this endpoint.\n\n**Line Item Cancellation:**\nSetting `new-quantity` to `0` will cancel the specified line item from the order.\n\n**Note:** This endpoint requires the `bw:integration` permission.\n",
        "operationId": "modifyWebOrder",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "order-number-prefix",
                  "order-number-suffix",
                  "item-line",
                  "new-quantity"
                ],
                "properties": {
                  "order-number-prefix": {
                    "type": "string",
                    "description": "The order number (OAORD)",
                    "example": "1506561"
                  },
                  "order-number-suffix": {
                    "type": "string",
                    "description": "The backorder code (OABOCD)",
                    "example": "000"
                  },
                  "item-line": {
                    "type": "integer",
                    "description": "The line number (OBLINE) to modify (must be a positive integer)",
                    "example": 1
                  },
                  "new-quantity": {
                    "type": "integer",
                    "description": "The new quantity for the line item. Set to 0 to cancel the line item.",
                    "minimum": 0,
                    "example": 5
                  }
                }
              },
              "examples": {
                "modify-quantity": {
                  "summary": "Modify line item quantity",
                  "value": {
                    "order-number-prefix": "1506561",
                    "order-number-suffix": "000",
                    "item-line": 1,
                    "new-quantity": 5
                  }
                },
                "cancel-line-item": {
                  "summary": "Cancel a line item (set quantity to 0)",
                  "value": {
                    "order-number-prefix": "1506561",
                    "order-number-suffix": "000",
                    "item-line": 1,
                    "new-quantity": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Modify request processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/WebOrderModificationResponse"
                    }
                  }
                },
                "examples": {
                  "success": {
                    "summary": "Successful modification",
                    "value": {
                      "result": {
                        "success": true,
                        "message": "Your change request has been submitted"
                      }
                    }
                  },
                  "failure": {
                    "summary": "Failed modification",
                    "value": {
                      "result": {
                        "success": false,
                        "message": "The specified line item does not exist in this order"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input - missing or invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "examples": {
                  "missing-prefix": {
                    "summary": "Missing order-number-prefix",
                    "value": {
                      "error": "order-number-prefix is required"
                    }
                  },
                  "missing-suffix": {
                    "summary": "Missing order-number-suffix",
                    "value": {
                      "error": "order-number-suffix is required"
                    }
                  },
                  "invalid-line": {
                    "summary": "Invalid item-line",
                    "value": {
                      "error": "item-line must be a positive integer"
                    }
                  },
                  "invalid-quantity": {
                    "summary": "Invalid new-quantity",
                    "value": {
                      "error": "new-quantity must be greater than 0"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "description": "Forbidden - User does not have permission"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/web/orders/status/by-erp-order-number": {
      "get": {
        "tags": [
          "orders"
        ],
        "summary": "Get order status by ERP order number",
        "description": "Retrieves the status of web orders using the ERP order number instead of the reference-id.\n\n**Query Parameters:**\n- `erp-order-number` (required): The S2K order number (OAORD)\n- `clinic-code` (required): Filter by specific clinic code\n- `shipping-id` (optional): Filter by specific shipping location\n- `company-no` (optional): Company number, defaults to 1\n",
        "operationId": "getWebOrderStatusByErpOrderNumber",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "erp-order-number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ERP system order number",
            "example": "1506293"
          },
          {
            "name": "clinic-code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "clinic code to filter results",
            "example": "123456"
          },
          {
            "name": "shipping-id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "shipping ID to filter results",
            "example": "001"
          },
          {
            "name": "company-no",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Optional Company number (defaults to 1)",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved order status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusResults": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WebOrderStatus"
                      }
                    }
                  }
                },
                "examples": {
                  "single-backorder": {
                    "summary": "Single order without backorder",
                    "value": {
                      "statusResults": [
                        {
                          "reference-id": "V3PNEK6RO65MSHRY7VWMNJCS5M",
                          "order-number": "1506293",
                          "clinic-code": "123456",
                          "po-number": "PO-2024-001",
                          "shipping-id": "001",
                          "status-id": "SHIPPED",
                          "status-description": "Shipped",
                          "error-details": []
                        }
                      ]
                    }
                  },
                  "multiple-backorders": {
                    "summary": "Order with multiple backorder codes",
                    "value": {
                      "statusResults": [
                        {
                          "reference-id": "V3PNEK6RO65MSHRY7VWMNJCS5M",
                          "order-number": "1506293-000",
                          "clinic-code": "123456",
                          "po-number": "PO-2024-001",
                          "shipping-id": "001",
                          "status-id": "SHIPPED",
                          "status-description": "Shipped",
                          "error-details": []
                        },
                        {
                          "reference-id": "V3PNEK6RO65MSHRY7VWMNJCS5M",
                          "order-number": "1506293-001",
                          "clinic-code": "123456",
                          "po-number": "PO-2024-001",
                          "shipping-id": "001",
                          "status-id": "PENDING",
                          "status-description": "Pending",
                          "error-details": []
                        }
                      ]
                    }
                  },
                  "with-errors": {
                    "summary": "Order with validation errors",
                    "value": {
                      "statusResults": [
                        {
                          "reference-id": "V3PNEK6RO65MSHRY7VWMNJCS5M",
                          "order-number": "1506293",
                          "clinic-code": "123456",
                          "po-number": "PO-2024-001",
                          "shipping-id": "001",
                          "status-id": "REJECTED",
                          "status-description": "Rejected",
                          "error-details": [
                            {
                              "message-code": "INVALID_ITEM",
                              "message": "Item is not available for this clinic",
                              "item-id": "1234567"
                            }
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input - missing or invalid erp-order-number",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "erp-order-number is required"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "description": "Forbidden - User does not have bw:integration permission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "User does not have permission to access this resource"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "error": "Internal server error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BadOrderError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item-id": {
                  "type": "string"
                },
                "field-name": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "details": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "OrderID": {
        "type": "object",
        "properties": {
          "reference-id": {
            "type": "string",
            "example": "V3PNEK6RO65MSHRY7VWMNJCS5M"
          }
        }
      },
      "LabelTypes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        }
      },
      "PrescriptionLabel": {
        "type": "object",
        "properties": {
          "label-type": {
            "type": "string",
            "description": "The 'title' field from /orders/prescription-label-types"
          },
          "vet": {
            "$ref": "#/components/schemas/VetLookup"
          },
          "clinic-code": {
            "type": "string"
          },
          "species": {
            "type": "string",
            "maxLength": 15
          },
          "product-name": {
            "type": "string",
            "maxLength": 50
          },
          "strength": {
            "type": "string",
            "maxLength": 50
          },
          "unit-of-measure": {
            "type": "string",
            "maxLength": 10
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000,
            "exclusiveMaximum": true
          },
          "directions": {
            "type": "string",
            "maxLength": 220
          },
          "refills": {
            "type": "integer",
            "maximum": 99
          },
          "refills-remaining": {
            "type": "integer",
            "maximum": 99
          },
          "expiry": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "SmallPrescriptionLabel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PrescriptionLabel"
          },
          {
            "type": "object",
            "properties": {
              "pet-name": {
                "type": "string",
                "maxLength": 15
              },
              "pet-weight": {
                "type": "string",
                "maxLength": 15
              }
            }
          }
        ],
        "example": {
          "vet": {
            "province": true,
            "license-id": "1234",
            "clinic-code": "K"
          },
          "clinic-code": "K",
          "species": "Dog",
          "product-name": "A product name"
        }
      },
      "LargePrescriptionLabel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PrescriptionLabel"
          },
          {
            "type": "object",
            "properties": {
              "number-of-animals": {
                "type": "integer",
                "maximum": 1000000,
                "exclusiveMaximum": true
              },
              "premise-id": {
                "type": "string",
                "maxLength": 15
              },
              "withdrawal-type-1": {
                "type": "string",
                "maxLength": 12
              },
              "withdrawal-time-1": {
                "type": "string",
                "maxLength": 12
              },
              "withdrawal-type-2": {
                "type": "string",
                "maxLength": 12
              },
              "withdrawal-time-2": {
                "type": "string",
                "maxLength": 12
              }
            }
          }
        ]
      },
      "VetLookup": {
        "type": "object",
        "properties": {
          "vet-name": {
            "type": "string",
            "maxLength": 50
          },
          "province": {
            "type": "string",
            "maxLength": 2,
            "example": true
          },
          "clinic-code": {
            "type": "string",
            "example": "K"
          },
          "license-id": {
            "type": "string",
            "example": "1234"
          }
        },
        "example": {
          "vet-name": "John Smith",
          "province": true,
          "clinic-code": "K",
          "license-id": "1234"
        }
      },
      "VetLookupError": {
        "type": "object",
        "properties": {
          "province": {
            "type": "string"
          },
          "clinic-code": {
            "type": "string"
          },
          "license-id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "dev.support@vpcl.on.ca"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "password1234",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthToken": {
        "type": "object",
        "properties": {
          "authentication_token": {
            "type": "object",
            "properties": {
              "token": {
                "type": "string"
              },
              "expiry": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "ItemID": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "3212250"
          }
        }
      },
      "ItemIDResults": {
        "type": "object",
        "properties": {
          "item-ids": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemID"
            }
          }
        }
      },
      "SimilarItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "3212250"
          }
        }
      },
      "ProductType": {
        "type": "object",
        "properties": {
          "product-type": {
            "type": "string"
          },
          "product-type-description": {
            "type": "string"
          }
        }
      },
      "ProductTypeResults": {
        "type": "object",
        "properties": {
          "product-types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductType"
            }
          }
        }
      },
      "CartLineItem": {
        "type": "object",
        "properties": {
          "item-id": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "CartOrder": {
        "type": "object",
        "required": [
          "clinic-code",
          "po-number",
          "lineitems"
        ],
        "properties": {
          "clinic-code": {
            "type": "string"
          },
          "parent": {
            "type": "string"
          },
          "po-number": {
            "type": "string",
            "maxLength": 20
          },
          "shipping-id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "lineitems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartLineItem"
            }
          }
        }
      },
      "CartStatus": {
        "type": "object",
        "properties": {
          "clinic-code": {
            "type": "string"
          },
          "order-number": {
            "type": "integer"
          },
          "web-order-number": {
            "type": "integer"
          },
          "shipping-id": {
            "type": "string"
          },
          "po-number": {
            "type": "string",
            "maxLength": 20
          },
          "status-code": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ],
            "description": "Status code description:\n  * 0 - Unknown status\n  * 1 - Error\n  * 2 - Received but not created\n  * 3 - Created\n  * 4 - Picked\n  * 5 - Packed\n  * 6 - Shipped\n  * 7 - Rejected\n  * 8 - Cancelled"
          },
          "status-description": {
            "type": "string"
          },
          "system-message": {
            "type": "string"
          }
        }
      },
      "RejectedStatus": {
        "type": "object",
        "properties": {
          "status-code": {
            "type": "integer",
            "enum": [
              0,
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8
            ]
          },
          "status-description": {
            "type": "string",
            "description": "Status description:\n  * Invalid clinic\n  * Invalid ship-to\n  * Postal code not found or inactive\n  * Item not found (Inactive, invalid, or deleted)\n  * Not an ecommerce item\n  * Duplicate order\n  * Insufficient inventory\n  * Label information incomplete"
          }
        }
      },
      "OrderStatus": {
        "type": "object",
        "properties": {
          "clinic-code": {
            "type": "string",
            "example": "K"
          },
          "shipping-id": {
            "type": "string",
            "example": "0001"
          },
          "po-number": {
            "type": "string",
            "example": "order001",
            "maxLength": 20
          },
          "reference-id": {
            "type": "string"
          },
          "status-code": {
            "type": "string"
          },
          "status-description": {
            "type": "string"
          },
          "error-details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message-code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "original-reference-id": {
                  "type": "string"
                },
                "item-id": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "OrderStatusResults": {
        "type": "object",
        "properties": {
          "statusResults": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderStatus"
            }
          }
        }
      },
      "LineItemDetail": {
        "type": "object",
        "properties": {
          "item-id": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "price": {
            "type": "number",
            "format": "float",
            "example": 12.34
          },
          "backordered": {
            "type": "boolean"
          }
        }
      },
      "CartDetail": {
        "type": "object",
        "properties": {
          "clinic-code": {
            "type": "string",
            "example": "K"
          },
          "shipping-id": {
            "type": "string",
            "example": "0001"
          },
          "order-number": {
            "type": "integer"
          },
          "web-order-number": {
            "type": "integer"
          },
          "po-number": {
            "type": "string",
            "maxLength": 20
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "email account for user placing the order"
          },
          "lineitems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineItemDetail"
            }
          },
          "tax": {
            "type": "number",
            "format": "float"
          },
          "order-total": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "CartDetailsResult": {
        "type": "object",
        "properties": {
          "cart-details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartDetail"
            }
          }
        }
      },
      "OrderDetails": {
        "type": "object",
        "properties": {
          "clinic-code": {
            "type": "string",
            "example": "K"
          },
          "shipping-id": {
            "type": "string",
            "example": "0001"
          },
          "reference-id": {
            "type": "string",
            "example": "V3PNEK6RO65MSHRY7VWMNJCS5M"
          },
          "po-number": {
            "type": "string",
            "maxLength": 20,
            "example": "po1234"
          },
          "order-number": {
            "type": "string",
            "example": "1234567"
          },
          "order-date": {
            "description": "The date and time the order was initially received by the API.",
            "type": "string",
            "format": "date-time"
          },
          "lineitems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LineItemDetail"
            }
          },
          "shipping-override": {
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "object",
                "properties": {
                  "phone-number": {
                    "type": "string",
                    "example": "555-555-5555"
                  }
                }
              }
            ]
          },
          "tracking": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pin": {
                  "type": "string"
                },
                "courier": {
                  "type": "string",
                  "example": "Purolator"
                }
              }
            }
          }
        }
      },
      "OrderDetailsResult": {
        "type": "object",
        "properties": {
          "order-details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderDetails"
            }
          }
        }
      },
      "ClinicCode": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "ClinicCodeResults": {
        "type": "object",
        "properties": {
          "clinic-codes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClinicCode"
            }
          }
        }
      },
      "Location": {
        "type": "object",
        "properties": {
          "name1": {
            "type": "string",
            "example": "ABC Clinic"
          },
          "address1": {
            "type": "string",
            "example": "123 Main Street"
          },
          "address2": {
            "type": "string"
          },
          "city": {
            "type": "string",
            "example": "St Marys"
          },
          "province": {
            "type": "string",
            "example": true
          },
          "postal": {
            "type": "string",
            "example": "N4X 1B7"
          }
        }
      },
      "ShipToDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Location"
          },
          {
            "type": "object",
            "properties": {
              "name2": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "shipping-id": {
                "type": "string"
              },
              "epharma": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "ClinicDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Location"
          },
          {
            "type": "object",
            "properties": {
              "name2": {
                "type": "string"
              },
              "active": {
                "type": "boolean"
              },
              "epharma": {
                "type": "boolean",
                "description": "Indicates that the clinic/shipto is enabled for epharma."
              },
              "code": {
                "type": "string"
              },
              "parent": {
                "type": "string"
              },
              "ship-tos": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ShipToDetail"
                }
              }
            }
          }
        ]
      },
      "ClinicDetailResults": {
        "type": "object",
        "properties": {
          "clinic-details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClinicDetail"
            }
          }
        }
      },
      "QuantityAndPrice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "3212250"
          },
          "location": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "float",
            "example": 15.19
          },
          "quantity-available": {
            "type": "integer",
            "format": "int32",
            "example": 4447
          }
        }
      },
      "MVSQuantityAndPrice": {
        "allOf": [
          {
            "$ref": "#/components/schemas/QuantityAndPrice"
          },
          {
            "type": "object",
            "properties": {
              "quantity-available-mvs": {
                "type": "integer",
                "format": "int32"
              },
              "quantity-reservation-hold-mvs": {
                "type": "integer",
                "format": "int32"
              }
            }
          }
        ]
      },
      "QuantityAndPriceResults": {
        "type": "object",
        "properties": {
          "item-quanities-prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuantityAndPrice"
            }
          }
        }
      },
      "MVSQuantityAndPriceResults": {
        "type": "object",
        "properties": {
          "mvs-item-quantities-prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MVSQuantityAndPrice"
            }
          }
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "item-id": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          }
        },
        "example": {
          "item-id": "1234567",
          "quantity": 2
        }
      },
      "PrescriptionOrderItem": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/OrderItem"
          },
          {
            "type": "object",
            "properties": {
              "prescription-label": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/SmallPrescriptionLabel"
                  },
                  {
                    "$ref": "#/components/schemas/LargePrescriptionLabel"
                  }
                ],
                "discriminator": {
                  "propertyName": "label-type",
                  "mapping": {
                    "companion": "#/components/schemas/SmallPrescriptionLabel",
                    "large-farm": "#/components/schemas/LargePrescriptionLabel"
                  }
                }
              }
            }
          }
        ]
      },
      "BasicOrderInfo": {
        "type": "object",
        "properties": {
          "po-number": {
            "type": "string",
            "maxLength": 20
          },
          "clinic-code": {
            "type": "string"
          },
          "shipping-id": {
            "type": "string"
          }
        }
      },
      "Order": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/BasicOrderInfo"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OrderItem"
                }
              }
            }
          }
        ]
      },
      "HomeDeliveryOrder": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/BasicOrderInfo"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/OrderItem"
                    },
                    {
                      "$ref": "#/components/schemas/PrescriptionOrderItem"
                    }
                  ]
                }
              },
              "shipping-location": {
                "type": "object",
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Location"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "phone-number": {
                        "type": "string",
                        "example": "555-555-5555"
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      },
      "DeliveryRestriction": {
        "type": "object",
        "properties": {
          "province": {
            "type": "string"
          },
          "rule-type": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "rule-type-description": {
            "type": "string"
          }
        }
      },
      "OrderResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Order"
          },
          {
            "$ref": "#/components/schemas/HomeDeliveryOrder"
          }
        ]
      },
      "ItemDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProductType"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "alternate-product-id": {
                "type": "string"
              },
              "vendor-code": {
                "type": "string"
              },
              "vendor-product-id": {
                "type": "string"
              },
              "unit-of-measure": {
                "type": "string"
              },
              "case-quantity": {
                "type": "integer",
                "format": "int32"
              },
              "description-1": {
                "type": "string"
              },
              "description-2": {
                "type": "string"
              },
              "description-3": {
                "type": "string"
              },
              "active": {
                "type": "boolean"
              },
              "product-sub-type": {
                "type": "string"
              },
              "product-sub-type-description": {
                "type": "string"
              },
              "refrigerate": {
                "type": "boolean"
              },
              "dangerous-goods": {
                "type": "string"
              },
              "web-store": {
                "type": "boolean"
              },
              "taxable": {
                "type": "boolean"
              },
              "therapeutic-index": {
                "type": "string"
              },
              "date-created": {
                "type": "string"
              },
              "date-discontinued": {
                "type": "string"
              },
              "epharma": {
                "description": "Determines if this is an epharma item.",
                "type": "boolean"
              },
              "delivery-restrictions": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DeliveryRestriction"
                }
              },
              "similar-items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SimilarItem"
                }
              }
            }
          }
        ]
      },
      "ItemExtension": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nac": {
            "type": "integer",
            "format": "int32"
          },
          "weight-kg": {
            "type": "number",
            "format": "float"
          },
          "length-cm": {
            "type": "number",
