{
  "openapi": "3.0.3",
  "info": {
    "title": "Staff Validate API",
    "description": "Secure API endpoint for verifying that a given user identity belongs to an installed Shopify shop, for server-to-server communication.\n\n## Authentication\nAll requests must include the `X-Api-Key` header with a valid API secret key.\n\n### API Key Format\nKeys follow a prefixed format: `dc_sk_<random-string>`\n\n| Prefix | Meaning |\n|--------|---------|\n| `dc` | Delightable Concierge (application identifier) |\n| `sk` | Secret Key (indicates this is a sensitive credential) |\n\nExample: `dc_sk_6268a4ca57b8e104845ba3830678d1fc0fe2360cf6c`\n\n## Security\n- This endpoint is designed for server-to-server communication only\n- Never expose the API key in client-side code\n- All access attempts are logged for auditing\n- Both the API key check and the identity field comparisons use timing-safe equality\n",
    "version": "1.0.0",
    "contact": {
      "name": "Delightable Concierge Support"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/alleyoop-741/staff-validate-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://delightable-concierge.gadget.app",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/v1/staff-validate": {
      "post": {
        "summary": "Validate Staff Identity",
        "description": "Verify that a given `userId` and `email` match the merchant record of an installed Shopify shop.\n\nAll three fields — `shopId`, `userId`, and `email` — are required. The endpoint returns 200 OK only when:\n- The shop exists and is in the `\"installed\"` state\n- `userId` matches the shop's `merchantId`\n- `email` matches the shop's `customerEmail`\n\nOn success the response body is `{ code: 200, message: \"success\" }`.\n",
        "operationId": "validateStaff",
        "tags": [
          "Staff Validate"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StaffValidateRequest"
              },
              "examples": {
                "validateStaff": {
                  "summary": "Validate staff identity",
                  "value": {
                    "shopId": "12345",
                    "userId": "merchant-user-id",
                    "email": "merchant@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully validated — userId and email match the shop's merchant record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffValidateSuccess"
                },
                "example": {
                  "code": 200,
                  "message": "success"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - One or more of shopId, userId, email is missing or empty",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 400,
                  "message": "bad request"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 401,
                  "message": "unauthorized"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - One of the following:\n- The shop exists but is not in the \"installed\" state\n- The provided userId does not match the shop's merchantId, or the provided email does not match the shop's customerEmail\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 403,
                  "message": "forbidden"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - Shop not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 404,
                  "message": "not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 500,
                  "message": "internal server error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key",
        "description": "API secret key for authentication.\n\n**Key Format:** `dc_sk_<random-string>`\n\n| Prefix | Meaning |\n|--------|---------|\n| `dc` | Delightable Concierge (application identifier) |\n| `sk` | Secret Key (indicates this is a sensitive credential) |\n\n**Example:** `dc_sk_0C1ew29ComQ5wIDeGwieiGJbjWYPXgjH542cS5Te9J4`\n"
      }
    },
    "schemas": {
      "StaffValidateRequest": {
        "type": "object",
        "description": "Request body for validating staff identity. All three fields are required.\n",
        "required": [
          "shopId",
          "userId",
          "email"
        ],
        "properties": {
          "shopId": {
            "type": "string",
            "description": "The Gadget internal shop ID",
            "example": "12345"
          },
          "userId": {
            "type": "string",
            "description": "The user ID to validate against the shop's merchantId",
            "example": "merchant-user-id"
          },
          "email": {
            "type": "string",
            "description": "The email address to validate against the shop's customerEmail",
            "example": "merchant@example.com"
          }
        }
      },
      "StaffValidateSuccess": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "enum": [
              200
            ],
            "description": "HTTP status code",
            "example": 200
          },
          "message": {
            "type": "string",
            "enum": [
              "success"
            ],
            "description": "Indicates the identity was successfully validated",
            "example": "success"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "description": "HTTP status code"
          },
          "message": {
            "type": "string",
            "description": "Lowercase error message"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Staff Validate",
      "description": "Endpoint for validating staff identity against an installed Shopify shop"
    }
  ]
}
