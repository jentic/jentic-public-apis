{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "VendIoT - EV Charging Reporting",
    "description": "API for EV Charging reporting.",
    "contact": {
      "email": "develop@elecctro.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/elecctro/evc-reporting/1.0.0"
  },
  "servers": [
    {
      "description": "Production",
      "url": "https://vendiot-prd.elecctro.com"
    }
  ],
  "paths": {
    "/api/evc/sessions": {
      "get": {
        "operationId": "getSessions",
        "summary": "Generates the EV charging sessions report in CSV.",
        "description": "The integrator can use this method to retrieve the EV charging sessions report in CSV for the sessions which had any updates in the filtered period. Updates that cause the session to be listed are:\n  - CDR received\n  - Invoice generated\n  - Payment received\n",
        "parameters": [
          {
            "name": "filter[dateStart]",
            "in": "query",
            "description": "Start date to filter by (inclusive).",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}/\\d{2}/\\d{4}$",
              "example": "20/01/2023",
              "description": "Date in dd/MM/YYYY format"
            }
          },
          {
            "name": "filter[dateEnd]",
            "in": "query",
            "description": "End date to filter by (exclusive).",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}/\\d{2}/\\d{4}$",
              "example": "21/01/2023",
              "description": "Date in dd/MM/YYYY format"
            }
          },
          {
            "name": "filter[timeStart]",
            "in": "query",
            "description": "Start time to filter by (inclusive). **Will be ignored if filter[dateStart] is not specified**.",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}:\\d{2}$",
              "example": "09:30:00",
              "description": "Time in hh:mm:ss format"
            }
          },
          {
            "name": "filter[timeEnd]",
            "in": "query",
            "description": "End time to filter by (exclusive). **Will be ignored if filter[dateEnd] is not specified**.",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}:\\d{2}$",
              "example": "18:30:00",
              "description": "Time in hh:mm:ss format"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "description": "Sessions report CSV.",
                  "example": "sessionId,startDateTime,endDateTime,energyTariff,totalCostExclVat,totalCostInclVat,totalEnergy,totalEnergyCostExclVat,totalEnergyCostInclVat,totalTime,totalTimeCostExclVat,totalTimeCostInclVat,iecExclVat,iecInclVat,invoiceReferenceId,posIdentifier,transactionId,transactionDateTime,transactionAmount,paymentMethod,schemaName,walletNumber,cardNumber,accountingPeriodId"
                }
              }
            }
          }
        }
      }
    },
    "/api/evc/accountingPeriods": {
      "get": {
        "operationId": "getAccountingPeriods",
        "summary": "Generates the accounting periods report in CSV.",
        "description": "The integrator can use this method to retrieve the accounting periods which were closed on the filtered period.\n",
        "parameters": [
          {
            "name": "filter[dateStart]",
            "in": "query",
            "description": "Start date to filter by (inclusive).",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}/\\d{2}/\\d{4}$",
              "example": "20/01/2023",
              "description": "Date in dd/MM/YYYY format"
            }
          },
          {
            "name": "filter[dateEnd]",
            "in": "query",
            "description": "End date to filter by (exclusive).",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}/\\d{2}/\\d{4}$",
              "example": "21/01/2023",
              "description": "Date in dd/MM/YYYY format"
            }
          },
          {
            "name": "filter[timeStart]",
            "in": "query",
            "description": "Start time to filter by (inclusive). **Will be ignored if filter[dateStart] is not specified**.",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}:\\d{2}$",
              "example": "09:30:00",
              "description": "Time in hh:mm:ss format"
            }
          },
          {
            "name": "filter[timeEnd]",
            "in": "query",
            "description": "End time to filter by (exclusive). **Will be ignored if filter[dateEnd] is not specified**.",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}:\\d{2}$",
              "example": "18:30:00",
              "description": "Time in hh:mm:ss format"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "description": "Accounting periods report CSV.",
                  "example": "accountingPeriodId,posIdentifier,openDateTime,closeDateTime,grossAmount,netAmount,feeAmount"
                }
              }
            }
          }
        },
        "security": [
          {
            "ElecctroApiKeyAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ElecctroApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY"
      }
    }
  },
  "security": [
    {
      "ElecctroApiKeyAuth": []
    }
  ]
}
