      "ListingTypes": {
        "type": "string",
        "enum": [
          "product",
          "promotional"
        ]
      },
      "HighlightIds": {
        "type": "string",
        "enum": [
          "traveller-type",
          "skill-level",
          "duration",
          "guided",
          "required-equipment",
          "accessibility-inclusivity",
          "paid-or-ticketed"
        ]
      },
      "HighlightQuestions": {
        "type": "string",
        "enum": [
          "Is there a specific type of traveller this experience caters to?",
          "What skill levels is this product or experience suited to?",
          "How long does the activity or experience take on average?",
          "Is this a guided or self-guided experience?",
          "Is any special equipment or gear needed?",
          "Is this experience accessible and inclusive for all?",
          "Is this a paid or ticketed event?"
        ]
      },
      "HighlightAnswerNames": {
        "type": "string",
        "enum": [
          "Families & Kids",
          "Luxury Travellers",
          "Adventure Enthusiasts",
          "Beginner",
          "Intermediate",
          "Advanced",
          "1-2 hours",
          "Half day",
          "Full day",
          "Multiple days",
          "Guided",
          "Self-guided",
          "Equipment Provided",
          "Bring Your Own",
          "No Equipment Needed",
          "Rentals Available",
          "Wheelchair Accessible",
          "Gender-Neutral Bathrooms",
          "LGBTQS+ Friendly",
          "Ticket Required (Paid)",
          "Ticket Required (Free)",
          "No Ticket Required"
        ]
      },
      "HighlightAnswerIds": {
        "type": "string",
        "enum": [
          "families-and-kids",
          "luxury-travellers",
          "adventure-enthusiasts",
          "beginner",
          "intermediate",
