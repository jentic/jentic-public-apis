  "components": {
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header"
      }
    },
    "schemas": {
      "CategoryIds": {
        "type": "string",
        "enum": [
          "accommodations",
          "food-and-drink",
          "rentals-and-equipment",
          "things-to-do",
          "transportation",
          "visitor-information"
        ]
      },
      "CategoryLabels": {
        "type": "string",
        "enum": [
          "Accommodations",
          "Food & Drink",
          "Rentals & Services",
          "Things To Do",
          "Transportation",
          "Visitor Information"
        ]
      },
      "Listing": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "WZ6yw1rCGgGl1bymx9u5F9"
          },
          "listingId": {
            "type": "number",
            "example": 12273
          },
          "linkRef": {
            "type": "string",
            "example": "mountain-view-cabin-12273",
            "description": "This is the title lowercased, hyphenated, and combined with the listing ID. Mainly used for determining the URL to use on detailed listing pages."
          },
          "_rev": {
            "type": "string",
            "example": "XQj2r0v4MAuMkClOEY9SDr"
          },
          "_type": {
            "type": "string",
            "enum": [
              "listing"
            ]
          },
          "category": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/components/schemas/CategoryIds"
              },
              "label": {
                "$ref": "#/components/schemas/CategoryLabels"
              }
            }
          },
          "seasons": {
            "$ref": "#/components/schemas/SeasonIds"
          },
          "dates": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "2024-01-01"
            }
          },
          "startDate": {
            "type": "string",
            "example": "2023-10-01"
          },
          "endDate": {
            "type": "string",
            "example": "2023-10-10"
          },
          "isAnnual": {
            "type": "boolean",
            "default": false
          },
          "facebookId": {
            "type": "string",
            "example": "test-business-123"
          },
          "instagramId": {
            "type": "string",
            "example": "test-business-123"
          },
          "xId": {
            "type": "string",
            "example": "test-business-123"
          },
          "name": {
            "type": "string",
            "example": "Mountain View Cabin"
          },
          "description": {
            "type": "string",
            "example": "Beautiful cabin with a mountain view."
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ATISImage"
            }
          },
          "noTypesApplicable": {
            "type": "boolean",
            "default": false
          },
          "listingStatus": {
            "type": "string",
            "enum": [
              "published"
            ]
          },
          "amenities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/components/schemas/AmenityIds"
                },
                "label": {
                  "$ref": "#/components/schemas/AmenityLabels"
                }
              }
            }
          },
          "location": {
            "$ref": "#/components/schemas/ATISLocation"
          },
          "suggestedType": {
            "type": "string",
            "example": "Cabin"
          },
          "website": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com"
          },
          "moderatorFeedback": {
            "type": "string",
            "example": "A note set by moderators for ATIS app users regarding listing approvals/rejections."
          },
          "types": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/components/schemas/TypeIds"
                },
                "label": {
                  "$ref": "#/components/schemas/TypeLabels"
                }
              }
            }
          },
          "organization": {
            "type": "object",
            "properties": {
              "_createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "_id": {
                "type": "string",
                "example": "XQj2r0v4MAuMkClOEY9N6D"
              },
              "_type": {
                "type": "string",
                "enum": [
                  "organization"
                ]
              },
              "_updatedAt": {
                "type": "string",
                "format": "date-time"
              },
              "organizationName": {
                "type": "string",
                "example": "Alberta Badland Tours"
              },
              "primaryRegion": {
                "type": "string",
                "example": "Calgary"
              },
              "website": {
                "type": "string",
                "format": "uri",
                "example": "https://www.albertabadlandtours.com"
              }
            }
          },
          "listingType": {
            "type": "string",
            "enum": [
              "product"
            ]
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/components/schemas/HighlightAnswerIds"
                },
                "label": {
                  "$ref": "#/components/schemas/HighlightLabels"
                }
              }
            }
          },
          "availability": {
            "$ref": "#/components/schemas/AvailabilityIds"
          },
          "isSubmitted": {
            "type": "boolean",
            "default": false
          },
          "listingStatusUpdatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-05-13T22:46:56.958Z"
          },
          "userLastSubmittedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-05-13T22:46:56.958Z"
          },
          "userLastUpdatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-05-13T22:46:56.958Z"
          },
          "_updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-05-12T22:46:56.958Z"
          },
          "_createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-05-11T22:46:56.958Z"
          }
        }
      },
      "TypeIds": {
        "type": "string",
        "enum": [
          "bed-and-breakfasts",
          "cabins-and-huts",
          "campgrounds-and-rv-parks",
          "glamping",
          "hostels",
          "hotels",
          "motels-and-inns",
