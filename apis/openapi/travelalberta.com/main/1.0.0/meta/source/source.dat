          "lgbt",
          "ticket-required-paid",
          "ticket-required-free",
          "no-ticket-required"
        ]
      },
      "HighlightLabels": {
        "type": "string",
        "enum": [
          "Families & Kids",
          "Luxury Travellers",
          "Adventure Enthusiasts",
          "Beginner",
          "Intermediate",
