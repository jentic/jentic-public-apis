          "Ticket Required (Paid)",
          "Ticket Required (Free)",
          "No Ticket Required"
        ]
      },
      "AmenityIds": {
        "type": "string",
        "enum": [
          "airport-transportation",
          "breakfast",
          "free-parking",
          "free-wifi",
          "gym-fitness-centre",
          "kitchenette",
          "laundry-service",
          "pet-friendly",
          "restaurant-bar-lounge",
          "hot-tub",
          "patio",
          "pool",
          "reservations-accepted",
          "takeout-delivery"
        ]
      },
      "AmenityLabels": {
        "type": "string",
        "enum": [
          "Airport Transportation",
          "Breakfast",
          "Free Parking",
          "Free WiFi",
          "Gym/Fitness Centre",
          "Hot Tub",
          "Kitchenette",
          "Laundry Service",
          "Reservations Accepted",
          "Restaurant/Bar/Lounge",
          "Patio",
          "Pet Friendly",
          "Pool",
          "Takeout/Delivery"
        ]
      },
      "AvailabilityIds": {
        "type": "string",
        "enum": [
          "yearRound",
          "seasonal",
          "temporary"
        ]
      },
      "SeasonIds": {
        "type": "string",
        "enum": [
          "spring",
          "summer",
          "fall",
          "winter"
        ]
      },
      "Regions": {
        "type": "string",
        "enum": [
          "Canadian Rockies",
          "Northern Rockies",
          "Calgary",
          "Canadian Badlands",
          "Central Prairies",
          "Foothills",
          "Wood Buffalo",
          "Lakelands",
          "Southern Rockies",
          "West Country",
          "Wildlands",
          "Edmonton",
          "Historic Plains"
        ]
      },
      "ATISImage": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "object",
            "properties": {
              "_ref": {
                "type": "string",
                "example": "image-8a6220ebe49995193436f16c0d50fdf465ea648d-1200x800-jpg"
              },
              "_type": {
                "type": "string",
                "enum": [
                  "reference"
                ]
              }
            }
          },
          "_type": {
            "type": "string",
            "enum": [
              "image"
            ]
          },
          "alt": {
            "type": "string"
          },
          "src": {
            "type": "string",
            "example": "https://cdn.sanity.io/images/lr9tta69/development/8a6220ebe49995193436f16c0d50fdf465ea648d-1200x800.jpg?fm=webp"
          },
          "caption": {
            "type": "string"
          },
          "photographer": {
            "type": "string",
            "example": "John Smith"
          },
          "isCoverPhoto": {
            "type": "boolean",
            "default": false
          },
          "_key": {
            "type": "string",
            "example": "EnW75tQQgXdwaJKZCHeyoW"
          }
        }
      },
      "ATISLocation": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "example": "St Patrick's Island, Calgary, AB T2E, Canada"
          },
          "city": {
            "type": "string",
            "example": "Calgary"
          },
          "province": {
            "type": "string",
            "example": "Alberta"
          },
          "lat": {
            "type": "number",
            "example": 51.0486
          },
          "lng": {
            "type": "number",
            "example": -114.0708
          },
          "region": {
            "type": "string",
            "example": "Calgary"
          }
        }
      },
      "TaxonomyType": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TypeIds"
          },
          "name": {
            "$ref": "#/components/schemas/TypeLabels"
          }
        }
      },
      "TaxonomyHighlight": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/HighlightIds"
          },
          "question": {
            "$ref": "#/components/schemas/HighlightQuestions"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/components/schemas/HighlightAnswerNames"
                },
                "id": {
                  "$ref": "#/components/schemas/HighlightAnswerIds"
                }
              }
            }
          }
        }
      },
      "TaxonomyCategory": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/CategoryIds"
          },
          "name": {
            "$ref": "#/components/schemas/CategoryLabels"
          },
          "description": {
            "type": "string"
          },
          "types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaxonomyType"
            }
          }
        }
      },
      "TaxonomyAmenity": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/AmenityIds"
          },
          "name": {
            "$ref": "#/components/schemas/AmenityLabels"
          }
        }
      },
      "GeoJSONFeature": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Feature"
            ]
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Point"
                ]
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2,
                "example": [
                  -110.181077,
                  54.435936
                ]
              }
            }
          },
          "properties": {
            "type": "object",
            "properties": {
              "listingId": {
                "type": "integer",
                "example": 5900
              },
              "category": {
                "$ref": "#/components/schemas/CategoryIds"
              },
              "types": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TypeIds"
                },
                "example": [
                  "museums"
                ]
              }
            }
          }
        }
      },
      "Organization": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "5fb70539-687d-416f-ba43-31bce978affb"
          },
          "_rev": {
            "type": "string",
            "example": "XQj2r0v4MAuMkClOEY9N6D"
          },
          "_type": {
            "type": "string",
            "enum": [
              "organization"
            ]
          },
          "organizationName": {
            "type": "string",
            "example": "Alberta Badland Tours"
          },
          "primaryRegion": {
            "$ref": "#/components/schemas/Regions",
            "description": "This field is only available in the API response if addressPublic is set to true."
          },
          "logo": {
            "$ref": "#/components/schemas/ATISImage"
          },
          "website": {
            "type": "string",
            "format": "uri",
            "example": "https://www.albertabadlandtours.com"
          },
          "address": {
            "type": "string",
            "example": "1234 5th Ave",
            "description": "This field is only available in the API response if addressPublic is set to true. This preference can be set by DMOs in the operator app."
          },
          "contactPhone": {
            "type": "string",
            "example": "(778)-123-4567",
            "description": "This field is only available in the API response if contactPublic is set to true. This preference can be set by DMOs in the operator app."
          },
          "contactEmail": {
            "type": "string",
            "format": "email",
            "example": "contact@badlandtours.com",
            "description": "This field is only available in the API response if contactPublic is set to true. This preference can be set by DMOs in the operator app."
          },
          "contactPublic": {
            "type": "boolean",
            "example": true
          },
          "addressPublic": {
            "type": "boolean",
            "example": true
          },
          "_updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-01T00:00:00Z"
          },
          "_createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-01T00:00:00Z"
          }
        }
      },
      "Feature": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "The type of the feature.",
            "example": "Feature"
          },
          "properties": {
            "type": "object",
            "properties": {
              "stroke": {
                "type": "string",
                "description": "Stroke colour in hex format.",
                "example": "#555555"
              },
              "stroke-width": {
                "type": "integer",
                "description": "Width of the stroke.",
                "example": 2
              },
              "stroke-opacity": {
                "type": "number",
                "description": "Opacity of the stroke.",
                "example": 1
              },
              "fill": {
                "type": "string",
                "description": "Fill colour in hex format.",
                "example": "#787878"
              },
              "fill-opacity": {
                "type": "number",
                "description": "Opacity of the fill.",
                "example": 0.5
              },
              "title": {
                "type": "string",
                "description": "Title of the region.",
                "example": "Canadian Rockies"
              }
            }
          },
          "geometry": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "The type of geometry.",
                "example": "Polygon"
              },
              "coordinates": {
                "type": "array",
                "description": "The coordinates used to define the geometry.",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "description": "Latitude and longitude values.",
                      "example": [
                        -117.0064462,
                        52.3655186
                      ]
                    }
                  }
                }
              }
            }
          },
          "id": {
            "type": "string",
            "description": "The ID for the feature.",
            "example": "1"
          }
        }
      }
    },
    "responses": {
      "GenericResponse400": {
        "description": "This response is returned when the request could not be processed. Typically due to incorrect or malformed request parameters.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "GenericResponse403": {
        "description": "This response is returned by API Gateway when passing an unauthorized API key header.",
        "content": {
          "application/json": {
            "schema": {
              "title": "403 Response Schema",
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Forbidden"
                }
              }
            }
          }
        }
      },
      "GenericResponse429": {
        "description": "This response is returned by API Gateway when exceeding your API Key's requests per second quota.",
        "content": {
          "application/json": {
            "schema": {
              "title": "429 Response Schema",
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Throttled"
                }
              }
            }
          }
        }
      },
      "GenericResponse500": {
        "description": "This response is returned due to an internal server error. Please try again later.",
        "content": {
          "application/json": {
            "schema": {
              "title": "500 Response Schema",
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "default": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    },
    "parameters": {
      "limit": {
        "name": "limit",
        "in": "query",
        "description": "Number of items to return per page.",
        "schema": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 1000
        }
      },
      "page": {
        "name": "page",
        "in": "query",
        "description": "Page number to return.",
        "schema": {
          "type": "number",
          "default": 1,
          "minimum": 1
        }
      },
      "sortBy": {
        "name": "sortBy",
        "in": "query",
        "description": "Field to sort the items by.",
        "schema": {
          "type": "string",
          "default": "_id"
        }
      },
      "sort": {
        "name": "sort",
        "in": "query",
        "description": "Sort order of the items.",
        "schema": {
          "type": "string",
          "default": "desc",
          "enum": [
            "desc",
            "asc"
          ]
        }
      },
      "version": {
        "name": "version",
        "required": true,
        "in": "query",
        "description": "The version of the API to request against.",
        "schema": {
          "type": "string",
          "default": "1",
          "enum": [
            "1"
          ]
        }
      },
      "imageTransformations": {
        "name": "imageTransformations",
        "in": "query",
        "description": "A JSON stringified representation of sanity's image transformation parameters documented here -> https://www.sanity.io/docs/image-urls#BhPyF4m0. Applies all transformation parameters to all image fields in the response. This object should be URL encoded to avoid parsing issues when processing the request. The example below is the URL encoded version of the following stringified JSON object \"{\"fm\":\"webp\",\"fb-x\":\"0.5\",\"y\":\"0.5\"}\".",
        "schema": {
          "type": "string",
          "default": "",
          "example": "%7B%22fm%22%3A%22webp%22%2C%22fb-x%22%3A%220.5%22%2C%22y%22%3A%220.5%22%7D"
        }
      },
      "cities": {
        "name": "cities",
        "in": "query",
        "description": "Comma delimited list of cities to filter by.",
        "schema": {
          "type": "string",
          "example": "calgary,edmonton"
        }
      },
      "regions": {
        "name": "regions",
        "description": "Comma delimited list of regions to filter by.",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/Regions"
        }
      }
    }
  }
}
