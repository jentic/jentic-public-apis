    "/listings-geojson": {
      "get": {
        "description": "Retrieves a GeoJSON export of the complete listings dataset or a specified subset based on filters.",
        "parameters": [
          {
            "$ref": "#/components/parameters/version"
          },
          {
            "name": "minLng",
            "in": "query",
            "description": "The minimum longitude value to filter listings by.",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "default": 180,
              "example": "-180"
            }
          },
          {
            "name": "maxLng",
            "in": "query",
            "description": "The maximum longitude value to filter listings by.",
            "schema": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "default": 180,
              "example": "180"
            }
          },
          {
            "name": "minLat",
            "in": "query",
            "description": "The minimum latitude value to filter listings by.",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90,
              "default": 90,
              "example": "-90"
            }
          },
          {
            "name": "maxLat",
            "in": "query",
            "description": "The maximum latitude value to filter listings by.",
            "schema": {
              "type": "number",
              "minimum": -90,
              "maximum": 90,
              "default": 90,
              "example": "90"
            }
          },
          {
            "$ref": "#/components/parameters/cities"
          },
          {
            "$ref": "#/components/parameters/regions"
          }
        ],
        "responses": {
          "200": {
            "description": "This response is returned when the request successfully fetched the query results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string",
                      "example": "*[_type == \"resource-name\" && _id == \"YNn0JxSBKlj8boLf8VWNQ7\" && filter in [\"value1\", \"value2\", \"value3\"]][0]"
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "FeatureCollection"
                          ]
                        },
                        "features": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/GeoJSONFeature"
                          }
                        }
                      }
                    },
                    "ms": {
                      "type": "integer",
                      "example": 5
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/GenericResponse403"
          },
          "429": {
            "$ref": "#/components/responses/GenericResponse429"
          },
          "500": {
            "$ref": "#/components/responses/GenericResponse500"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    },
    "/organizations": {
