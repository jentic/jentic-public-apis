    "/v1/subscriptions": {
      "post": {
        "operationId": "createSubscription",
        "summary": "Create webhook subscription",
        "tags": [
          "Subscriptions"
        ],
        "description": "Creates a subscription for one event type. A matching active subscription for the same user, event, URL, and page filter is returned with 201 without updating it. Null or omitted page filter covers all owned pages, including future pages.",
        "responses": {
          "201": {
            "description": "New or existing active subscription.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                },
                "example": {
                  "id": "66666666-6666-4666-8666-666666666666",
                  "is_active": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid Zapier subscription request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or revoked API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Invalid API key"
                }
              }
            }
          },
          "404": {
            "description": "Booking page not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Booking page not found"
                }
              }
            }
          },
          "500": {
            "description": "Authentication failed, or Failed to create Zapier subscription.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to create Zapier subscription"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubscriptionInput"
              },
              "example": {
                "trigger_type": "new_booking",
                "target_url": "https://example.com/webhooks/meetzi",
                "booking_page_id": null
              }
            }
          }
        },
        "callbacks": {
          "bookingEvent": {
            "{$request.body#/target_url}": {
              "post": {
                "summary": "Receive one booking event",
                "description": "One booking object without a data wrapper or event envelope. Payload shape follows trigger_type. No webhook signature or Authorization header. One delivery attempt; no automatic retry or replay. HTTP 410 triggers an attempt to deactivate the subscription.",
                "security": [],
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/NewBooking"
                          },
                          {
                            "$ref": "#/components/schemas/CancelledBooking"
                          },
                          {
                            "$ref": "#/components/schemas/RescheduledBooking"
                          }
                        ]
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Any 2xx acknowledges delivery."
                  },
                  "410": {
                    "description": "Receiver is gone; Meetzi attempts to deactivate this subscription."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/subscriptions/{id}": {
      "delete": {
        "operationId": "deleteSubscription",
        "summary": "Deactivate webhook subscription",
        "tags": [
          "Subscriptions"
        ],
        "description": "Deactivates an active subscription owned by the user. Repeating a successful deletion returns 404.",
        "responses": {
          "204": {
            "description": "Deactivated successfully. Empty body."
          },
          "400": {
            "description": "Invalid Zapier subscription id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or revoked API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Invalid API key"
                }
              }
            }
          },
          "404": {
            "description": "Subscription not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Subscription not found"
                }
              }
            }
          },
          "500": {
            "description": "Authentication failed, or Failed to delete Zapier subscription.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to delete Zapier subscription"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Active subscription ID.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  },
