{
  "openapi": "3.1.0",
  "info": {
    "title": "Meetzi Booking Automation API",
    "version": "2026-09-30",
    "description": "All seven API key authenticated endpoints under /v1 for Zapier and custom server integrations. Validate an account, list booking pages, read recent bookings, and subscribe to booking events. Booking data is scoped to pages owned by the key owner. This reference does not cover product session APIs. No request quota or rate-limit headers are specified.",
    "x-jentic-source-url": "https://docs.meetzi.co/api/openapi.json"
  },
  "servers": [
    {
      "url": "https://api.meetzi.co"
    }
  ],
  "paths": {
    "/v1/me": {
      "get": {
        "operationId": "getConnectionIdentity",
        "summary": "Get connection identity",
        "tags": [
          "Account"
        ],
        "description": "Validate the key and return its user identity. displayLabel falls back from email to name to user ID.",
        "responses": {
          "200": {
            "description": "Connected account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Identity"
                },
                "example": {
                  "userId": "11111111-1111-4111-8111-111111111111",
                  "email": "alex@example.com",
                  "name": "Alex Morgan",
                  "displayLabel": "alex@example.com",
                  "apiKeyId": "22222222-2222-4222-8222-222222222222",
                  "provider": "zapier"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or revoked API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Invalid API key"
                }
              }
            }
          },
          "500": {
            "description": "Authentication failed, or Failed to load Zapier connection info.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to load Zapier connection info"
                }
              }
            }
          }
        }
      }
    },
    "/v1/booking-pages": {
      "get": {
        "operationId": "listBookingPages",
        "summary": "List owned booking pages",
        "tags": [
          "Booking pages"
        ],
        "description": "Lists public and private non-deleted pages owned by the user, newest created first. Question order is not guaranteed. No pagination parameters.",
        "responses": {
          "200": {
            "description": "Owned booking pages, or an empty data array.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingPageList"
                },
                "example": {
                  "data": [
                    {
                      "id": "33333333-3333-4333-8333-333333333333",
                      "name": "Discovery Call",
                      "slug": "discovery-call",
                      "is_public": true,
                      "created_at": "2026-09-01T09:00:00.000Z",
                      "questions": [
                        {
                          "id": "44444444-4444-4444-8444-444444444444",
                          "question": "What would you like to discuss?",
                          "order": 0
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, or revoked API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Invalid API key"
                }
              }
            }
          },
          "500": {
            "description": "Authentication failed, or Failed to list booking pages.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Failed to list booking pages"
                }
              }
            }
          }
        }
      }
    },
