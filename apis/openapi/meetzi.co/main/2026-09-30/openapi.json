        },
        "parameters": [
          {
            "name": "booking_page_id",
            "in": "query",
            "required": false,
            "description": "Owned, non-deleted page ID. Omit for all owned pages.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum recent records; no cursor or offset pagination.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          }
        ]
      }
    },
