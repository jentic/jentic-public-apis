                      "type": "string",
                      "example": "Language"
                    },
                    "categoryIcon": {
                      "type": "string",
                      "example": "cilSpeech"
                    },
                    "level": {
                      "type": "string",
                      "example": "advanced"
                    },
                    "visibility": {
                      "type": "string",
                      "example": "draft"
                    },
                    "enrollment_count": {
                      "type": "integer",
                      "example": 5
                    },
                    "image": {
                      "type": "string",
                      "nullable": true,
                      "example": null
                    },
                    "createdBy": {
                      "type": "string",
                      "format": "uuid",
                      "example": "e4d307ea-f5cc-4f5d-a846-be82637ece82"
                    },
                    "createdByName": {
                      "type": "string",
                      "example": "testingTeacher"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2025-11-01T14:11:51.116Z"
                    },
                    "deleted_at": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        ]
      },
