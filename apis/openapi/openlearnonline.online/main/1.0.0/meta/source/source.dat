                    "type": "string",
                    "format": "uuid",
                    "example": "29406f92-574b-46ca-8e70-274bfa50b669"
                  },
                  "isCompleted": {
                    "type": "boolean",
                    "example": true
                  },
                  "bestScore": {
                    "type": "integer",
                    "nullable": true,
                    "example": null
                  },
                  "attempts": {
                    "type": "integer",
                    "example": 3
                  }
                }
              }
            }
          }
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error response wrapper",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "nullable": true
          }
        }
      }
    }
  }
}
