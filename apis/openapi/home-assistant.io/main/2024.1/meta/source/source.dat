{
  "openapi": "3.0.3",
  "info": {
    "title": "Home Assistant REST API",
    "description": "The Home Assistant REST API allows you to interact with a Home Assistant instance over HTTP. You can read and set states, fire events, call services, render templates, and more. All endpoints require authentication via a long-lived access token passed as a Bearer token in the Authorization header.",
    "version": "2024.1",
    "contact": {
      "name": "Home Assistant",
      "url": "https://www.home-assistant.io/"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://developers.home-assistant.io/docs/api/rest"
  },
  "servers": [
    {
      "url": "https://{host}:8123/api",
      "description": "Home Assistant instance",
      "variables": {
        "host": {
          "default": "localhost",
          "description": "The hostname or IP address of the Home Assistant instance"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Status",
      "description": "API status and health check"
    },
    {
      "name": "Configuration",
      "description": "System configuration and validation"
    },
    {
      "name": "States",
      "description": "Entity state management"
    },
    {
      "name": "Events",
      "description": "Event listing and firing"
    },
    {
      "name": "Services",
      "description": "Service listing and invocation"
    },
    {
      "name": "History",
      "description": "Historical state data"
    },
    {
      "name": "Logbook",
      "description": "Logbook entries"
    },
    {
      "name": "Camera",
      "description": "Camera proxy image retrieval"
    },
    {
      "name": "Calendar",
      "description": "Calendar entity and event access"
    },
    {
      "name": "Templates",
      "description": "Jinja2 template rendering"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getApiStatus",
        "summary": "API running check",
        "description": "Returns a message indicating that the API is up and running. This is useful as a health check endpoint.",
        "tags": [
          "Status"
        ],
        "responses": {
          "200": {
            "description": "API is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiStatusResponse"
                },
                "example": {
                  "message": "API running."
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/config": {
      "get": {
        "operationId": "getConfig",
        "summary": "Get configuration",
        "description": "Returns the current configuration of the Home Assistant instance, including location, unit system, timezone, loaded components, and more.",
        "tags": [
          "Configuration"
        ],
        "responses": {
          "200": {
            "description": "Current configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Configuration"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/components": {
      "get": {
        "operationId": "getComponents",
        "summary": "Get loaded components",
        "description": "Returns an array of component names (strings) that are currently loaded in the Home Assistant instance.",
        "tags": [
          "Configuration"
        ],
        "responses": {
          "200": {
            "description": "List of loaded component names",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "sensor",
                    "light",
                    "automation",
                    "script"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "List events",
        "description": "Returns an array of event objects. Each event object contains the event type and the number of listeners currently registered for that event.",
        "tags": [
          "Events"
        ],
        "responses": {
          "200": {
            "description": "List of event types and their listener counts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventType"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/services": {
      "get": {
        "operationId": "listServices",
        "summary": "List services",
        "description": "Returns an array of service objects grouped by domain. Each object includes the domain name and the services available within that domain.",
        "tags": [
          "Services"
        ],
        "responses": {
          "200": {
            "description": "List of services grouped by domain",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ServiceDomain"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/history/period/{timestamp}": {
      "get": {
        "operationId": "getHistory",
        "summary": "Get state history",
        "description": "Returns an array of arrays of state objects for the specified time period. Each inner array contains the state history for a single entity. If the timestamp is omitted, it defaults to 1 day before the current time. The filter_entity_id parameter is recommended to limit the amount of data returned.",
        "tags": [
          "History"
        ],
        "parameters": [
          {
            "name": "timestamp",
            "in": "path",
            "description": "Start timestamp in ISO 8601 format (e.g., 2024-01-01T00:00:00+00:00). Defaults to 1 day before the current time if omitted.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "filter_entity_id",
            "in": "query",
            "description": "Comma-separated list of entity IDs to filter the history results.",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "sensor.temperature,sensor.humidity"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "End timestamp in URL-encoded ISO 8601 format.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "minimal_response",
            "in": "query",
            "description": "When present, only return last_changed and state for states other than the first and last in the period.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "no_attributes",
            "in": "query",
            "description": "When present, skip returning attributes in the response to reduce data size.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "significant_changes_only",
            "in": "query",
            "description": "When present, only return significant state changes, filtering out minor attribute-only changes.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of state history arrays, one per entity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/State"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/logbook/{timestamp}": {
      "get": {
        "operationId": "getLogbook",
        "summary": "Get logbook entries",
        "description": "Returns an array of logbook entry objects for the specified time period. Each entry includes information about what happened, when, and which entity was involved.",
        "tags": [
          "Logbook"
        ],
        "parameters": [
          {
            "name": "timestamp",
            "in": "path",
            "description": "Start timestamp in ISO 8601 format (e.g., 2024-01-01T00:00:00+00:00).",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "entity",
            "in": "query",
            "description": "Entity ID to filter logbook entries to a single entity.",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "light.living_room"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "End timestamp in URL-encoded ISO 8601 format.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of logbook entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LogbookEntry"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/states": {
      "get": {
        "operationId": "listStates",
        "summary": "List all entity states",
        "description": "Returns an array of state objects for all entities currently registered in Home Assistant. Each object includes the entity ID, current state, attributes, and timestamps.",
        "tags": [
          "States"
        ],
        "responses": {
          "200": {
            "description": "List of all entity states",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/State"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/states/{entity_id}": {
      "get": {
        "operationId": "getState",
        "summary": "Get entity state",
        "description": "Returns the state object for the specified entity. Returns 404 if the entity is not found.",
        "tags": [
          "States"
        ],
        "parameters": [
          {
            "name": "entity_id",
            "in": "path",
            "description": "The entity ID to retrieve (e.g., sensor.temperature, light.living_room).",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entity state object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Entity not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "setState",
        "summary": "Update or create entity state",
        "description": "Updates the state of an existing entity or creates a new entity with the given state. Returns 200 if the entity already existed and was updated, or 201 if a new entity was created.",
        "tags": [
          "States"
        ],
        "parameters": [
          {
            "name": "entity_id",
            "in": "path",
            "description": "The entity ID to update or create (e.g., sensor.temperature).",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StateRequest"
              },
              "example": {
                "state": "25",
                "attributes": {
                  "unit_of_measurement": "°C",
                  "friendly_name": "Temperature"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing entity state updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "201": {
            "description": "New entity created with the specified state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/State"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "operationId": "deleteState",
        "summary": "Remove entity state",
        "description": "Removes the state of the specified entity from Home Assistant. The entity will no longer appear in the state machine until it is re-created.",
        "tags": [
          "States"
        ],
        "parameters": [
          {
            "name": "entity_id",
            "in": "path",
            "description": "The entity ID to remove.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Entity state successfully removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiMessageResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Entity not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/error_log": {
      "get": {
        "operationId": "getErrorLog",
        "summary": "Get error log",
        "description": "Returns the full error log from the current Home Assistant session as plain text.",
        "tags": [
          "Configuration"
        ],
        "responses": {
          "200": {
            "description": "Error log content as plain text",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/camera_proxy/{entity_id}": {
      "get": {
        "operationId": "getCameraImage",
        "summary": "Get camera image",
        "description": "Returns the current image from the specified camera entity as binary image data.",
        "tags": [
          "Camera"
        ],
        "parameters": [
          {
            "name": "entity_id",
            "in": "path",
            "description": "The camera entity ID (e.g., camera.front_door).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "time",
            "in": "query",
            "description": "Timestamp in milliseconds to force a cache refresh of the image.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Camera image data",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Camera entity not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/calendars": {
      "get": {
        "operationId": "listCalendars",
        "summary": "List calendars",
        "description": "Returns an array of calendar entities registered in Home Assistant, each with an entity ID and display name.",
        "tags": [
          "Calendar"
        ],
        "responses": {
          "200": {
            "description": "List of calendar entities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CalendarEntity"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/calendars/{entity_id}": {
      "get": {
        "operationId": "getCalendarEvents",
        "summary": "Get calendar events",
        "description": "Returns calendar events for the specified calendar entity within the given time range. Both start and end query parameters are required.",
        "tags": [
          "Calendar"
        ],
        "parameters": [
          {
            "name": "entity_id",
            "in": "path",
            "description": "The calendar entity ID (e.g., calendar.personal).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start date/time in ISO 8601 format.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "End date/time in ISO 8601 format.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of calendar events within the specified range",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CalendarEvent"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Calendar entity not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/events/{event_type}": {
      "post": {
        "operationId": "fireEvent",
        "summary": "Fire event",
        "description": "Fires a custom event of the specified type. An optional JSON body can be provided as event data that will be passed to all event listeners.",
        "tags": [
          "Events"
        ],
        "parameters": [
          {
            "name": "event_type",
            "in": "path",
            "description": "The event type to fire (e.g., custom_event, my_event).",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "description": "Optional event data to include with the fired event.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "key": "value",
                "another_key": 123
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event successfully fired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiMessageResponse"
                },
                "example": {
                  "message": "Event custom_event fired."
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/services/{domain}/{service}": {
      "post": {
        "operationId": "callService",
        "summary": "Call service",
        "description": "Calls a service within the specified domain. An optional JSON body can be provided as service data (e.g., entity_id to target). Returns an array of state objects that changed as a result of the service call.",
        "tags": [
          "Services"
        ],
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "description": "The service domain (e.g., light, switch, automation).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "service",
            "in": "path",
            "description": "The service name to call (e.g., turn_on, turn_off, toggle).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "return_response",
            "in": "query",
            "description": "When present, includes the service response data in the returned object alongside changed states.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "description": "Optional service data. Typically includes entity_id to specify which entity to target.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServiceCallRequest"
              },
              "example": {
                "entity_id": "light.living_room",
                "brightness": 255
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Service called successfully. Returns changed states, or an object with changed_states and service_response when return_response is set.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/State"
                      },
                      "description": "Array of changed state objects (default response)"
                    },
                    {
                      "$ref": "#/components/schemas/ServiceCallResponseWithReturn"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid service data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Domain or service not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/template": {
      "post": {
        "operationId": "renderTemplate",
        "summary": "Render template",
        "description": "Renders a Home Assistant Jinja2 template and returns the result as plain text. Templates can access all entity states and other Home Assistant data.",
        "tags": [
          "Templates"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TemplateRequest"
              },
              "example": {
                "template": "The temperature is {{ states('sensor.temperature') }}."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rendered template result as plain text",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid template syntax",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/config/core/check_config": {
      "post": {
        "operationId": "checkConfig",
        "summary": "Check configuration",
        "description": "Triggers a validation of the Home Assistant configuration files (configuration.yaml and related files). Returns whether the configuration is valid and any errors found.",
        "tags": [
          "Configuration"
        ],
        "responses": {
          "200": {
            "description": "Configuration check result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckConfigResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/intent/handle": {
      "post": {
        "operationId": "handleIntent",
        "summary": "Handle intent",
        "description": "Processes a named intent with the provided data. Requires the intent integration to be configured in Home Assistant. This is used for natural language processing and voice assistant integrations.",
        "tags": [
          "Services"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntentRequest"
              },
              "example": {
                "name": "HassTurnOn",
                "data": {
                  "name": "living room light"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Intent handled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid intent request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Long-lived access token for Home Assistant. Generate one from your user profile page at /profile in the Home Assistant UI. Pass it in the Authorization header as: Bearer {token}"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication required. Provide a valid long-lived access token in the Authorization header.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "message": "401: Unauthorized"
            }
          }
        }
      }
    },
    "schemas": {
      "ApiStatusResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Status message indicating the API is running.",
            "example": "API running."
          }
        },
        "required": [
          "message"
        ]
      },
      "ApiMessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Response message."
          }
        },
        "required": [
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Error description."
          }
        },
        "required": [
          "message"
        ]
      },
      "Configuration": {
        "type": "object",
        "properties": {
          "components": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of loaded component names."
          },
          "config_dir": {
            "type": "string",
            "description": "Path to the configuration directory."
          },
          "elevation": {
            "type": "number",
            "description": "Elevation of the Home Assistant location in meters."
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "description": "Latitude of the Home Assistant location."
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "description": "Longitude of the Home Assistant location."
          },
          "location_name": {
            "type": "string",
            "description": "Name of the Home Assistant location."
          },
          "time_zone": {
            "type": "string",
            "description": "Timezone identifier (e.g., America/New_York)."
          },
          "unit_system": {
            "type": "object",
            "properties": {
              "length": {
                "type": "string",
                "description": "Unit for length measurements."
              },
              "mass": {
                "type": "string",
                "description": "Unit for mass measurements."
              },
              "pressure": {
                "type": "string",
                "description": "Unit for pressure measurements."
              },
              "temperature": {
                "type": "string",
                "description": "Unit for temperature measurements."
              },
              "volume": {
                "type": "string",
                "description": "Unit for volume measurements."
              }
            },
            "description": "Configured unit system."
          },
          "version": {
            "type": "string",
            "description": "Home Assistant version string."
          },
          "state": {
            "type": "string",
            "description": "Current state of the system (e.g., RUNNING).",
            "enum": [
              "NOT_RUNNING",
              "STARTING",
              "RUNNING",
              "STOPPING",
              "FINAL_WRITE"
            ]
          },
          "external_url": {
            "type": "string",
            "nullable": true,
            "description": "External URL configured for the instance."
          },
          "internal_url": {
            "type": "string",
            "nullable": true,
            "description": "Internal URL configured for the instance."
          },
          "currency": {
            "type": "string",
            "description": "Configured currency code."
          },
          "country": {
            "type": "string",
            "nullable": true,
            "description": "Configured country code."
          },
          "language": {
            "type": "string",
            "description": "Configured language code."
          }
        }
      },
      "State": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "The entity ID (e.g., sensor.temperature).",
            "example": "sensor.temperature"
          },
          "state": {
            "type": "string",
            "description": "The current state value.",
            "example": "23.5"
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true,
            "description": "Entity attributes (varies by entity type)."
          },
          "last_changed": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the last state change."
          },
          "last_reported": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the last state report."
          },
          "last_updated": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the last state or attribute update."
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          }
        },
        "required": [
          "entity_id",
          "state",
          "attributes",
          "last_changed",
          "last_updated"
        ]
      },
      "Context": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique context identifier."
          },
          "parent_id": {
            "type": "string",
            "nullable": true,
            "description": "Parent context identifier."
          },
          "user_id": {
            "type": "string",
            "nullable": true,
            "description": "User ID that triggered the context."
          }
        },
        "required": [
          "id"
        ]
      },
      "StateRequest": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "description": "The state value to set."
          },
          "attributes": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional attributes to set on the entity."
          }
        },
        "required": [
          "state"
        ]
      },
      "EventType": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "description": "The event type name.",
            "example": "state_changed"
          },
          "listener_count": {
            "type": "integer",
            "description": "Number of listeners registered for this event type.",
            "example": 5
          }
        },
        "required": [
          "event",
          "listener_count"
        ]
      },
      "ServiceDomain": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "The service domain name.",
            "example": "light"
          },
          "services": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Human-readable service name."
                },
                "description": {
                  "type": "string",
                  "description": "Description of what the service does."
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "Available fields/parameters for the service."
                },
                "target": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "Target specification for the service."
                }
              }
            },
            "description": "Map of service names to their definitions."
          }
        },
        "required": [
          "domain",
          "services"
        ]
      },
      "ServiceCallRequest": {
        "type": "object",
        "properties": {
          "entity_id": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "Entity ID or array of entity IDs to target."
          }
        },
        "additionalProperties": true,
        "description": "Service call data. The accepted fields depend on the specific service being called."
      },
      "ServiceCallResponseWithReturn": {
        "type": "object",
        "properties": {
          "changed_states": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/State"
            },
            "description": "Array of state objects that changed as a result of the service call."
          },
          "service_response": {
            "type": "object",
            "additionalProperties": true,
            "description": "Response data from the service, if the service provides one."
          }
        },
        "required": [
          "changed_states",
          "service_response"
        ]
      },
      "LogbookEntry": {
        "type": "object",
        "properties": {
          "when": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the logbook entry."
          },
          "name": {
            "type": "string",
            "description": "Friendly name of the entity or event."
          },
          "message": {
            "type": "string",
            "description": "Description of what happened."
          },
          "domain": {
            "type": "string",
            "description": "Domain of the entity (e.g., light, switch)."
          },
          "entity_id": {
            "type": "string",
            "description": "Entity ID that the logbook entry relates to."
          },
          "context_user_id": {
            "type": "string",
            "nullable": true,
            "description": "User ID that caused this logbook entry."
          }
        }
      },
      "CalendarEntity": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "The calendar entity ID.",
            "example": "calendar.personal"
          },
          "name": {
            "type": "string",
            "description": "Display name of the calendar.",
            "example": "Personal"
          }
        },
        "required": [
          "entity_id",
          "name"
        ]
      },
      "CalendarEvent": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "string",
            "description": "Title/summary of the calendar event."
          },
          "start": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date",
                    "description": "Date for all-day events."
                  }
                },
                "required": [
                  "date"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "dateTime": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date-time for timed events."
                  }
                },
                "required": [
                  "dateTime"
                ]
              }
            ],
            "description": "Start of the event. Contains either a date (all-day) or dateTime (timed)."
          },
          "end": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date",
                    "description": "Date for all-day events."
                  }
                },
                "required": [
                  "date"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "dateTime": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date-time for timed events."
                  }
                },
                "required": [
                  "dateTime"
                ]
              }
            ],
            "description": "End of the event. Contains either a date (all-day) or dateTime (timed)."
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Detailed description of the event."
          },
          "location": {
            "type": "string",
            "nullable": true,
            "description": "Location of the event."
          }
        },
        "required": [
          "summary",
          "start",
          "end"
        ]
      },
      "TemplateRequest": {
        "type": "object",
        "properties": {
          "template": {
            "type": "string",
            "description": "Jinja2 template string to render. Can reference entity states and other Home Assistant data."
          }
        },
        "required": [
          "template"
        ]
      },
      "CheckConfigResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string",
            "enum": [
              "valid",
              "invalid"
            ],
            "description": "Whether the configuration is valid or invalid."
          },
          "errors": {
            "type": "string",
            "nullable": true,
            "description": "Error details if the configuration is invalid, null if valid."
          }
        },
        "required": [
          "result",
          "errors"
        ]
      },
      "IntentRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The intent name to handle (e.g., HassTurnOn, HassTurnOff, HassGetState)."
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Intent data/slots to pass to the intent handler."
          }
        },
        "required": [
          "name"
        ]
      },
      "IntentResponse": {
        "type": "object",
        "properties": {
          "speech": {
            "type": "object",
            "properties": {
              "plain": {
                "type": "object",
                "properties": {
                  "speech": {
                    "type": "string",
                    "description": "The spoken response text."
                  },
                  "extra_data": {
                    "type": "object",
                    "nullable": true,
                    "additionalProperties": true,
                    "description": "Additional data returned with the response."
                  }
                },
                "required": [
                  "speech"
                ]
              }
            },
            "description": "Speech response from the intent handler."
          },
          "card": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "Optional card data for visual display."
          },
          "language": {
            "type": "string",
            "description": "Language code of the response."
          },
          "response_type": {
            "type": "string",
            "description": "Type of intent response.",
            "enum": [
              "action_done",
              "query_answer",
              "error"
            ]
          },
          "data": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true,
            "description": "Additional response data including targets and success/failure info."
          }
        }
      }
    }
  }
}
