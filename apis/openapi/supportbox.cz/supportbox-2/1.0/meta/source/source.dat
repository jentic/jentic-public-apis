      }
    },
    "/api/v1/phonebox-tickets/{phonebox-ticket-id}/json-data": {
      "post": {
        "summary": "Přidání JSON dat k telefonnímu ticketu.",
        "description": "Přidá libovolná data ve formátu JSON k telefonnímu ticketu. Pokud data obsahují odpověď Optimcall voicebota, bude ticket automaticky vyřešen v případě, že je hodnota call_status = \"handled\".",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "tags": [
          "Telefony"
        ],
        "parameters": [
          {
            "name": "phonebox-ticket-id",
            "in": "path",
            "description": "ID telefonního ticketu",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "json_data": {
                    "type": "object",
                    "description": "JSON data, která mají být uložena k ticketu"
                  }
                },
                "required": [
                  "json_data"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "JSON data byla úspěšně přidána"
          },
          "404": {
            "description": "Ticket s požadovaným ID nebyl nalezen"
          }
        }
      }
    },
    "/api/v1/mailbox-tickets/{mailbox-ticket-id}/notes": {
      "post": {
        "summary": "Přidání poznámky k ticketu",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "tags": [
          "E-maily"
        ],
        "parameters": [
          {
            "name": "mailbox-ticket-id",
            "in": "path",
            "description": "ID ticketu",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "html_message": {
                    "type": "string",
                    "description": "Text poznámky. Může obsahovat HTML.",
                    "example": "<b>Důležitá</b> poznámka"
                  },
                  "user_id": {
                    "type": "integer",
                    "description": "ID uživatele. SupportBox zobrazí uživatele jako tvůrce poznámky.",
                    "example": 123
                  }
                },
                "required": [
                  "html_message",
                  "user_id"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Note was added to ticket"
          },
          "403": {
            "description": "Authorization error"
          },
          "404": {
            "description": "Ticket by ID was not found"
          },
          "500": {
            "description": "Internal error"
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "summary": "Výpis uživatelů.",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "tags": [
