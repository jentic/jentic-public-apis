            "description": "ID chatu.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "createdAtFrom",
            "in": "query",
            "description": "Datum vytvoření od.",
            "required": false,
            "schema": {
              "type": "string",
              "anyOf": [
                {
                  "format": "date"
                },
                {
                  "format": "date-time"
                }
              ]
            }
          },
          {
            "name": "createdAtTo",
            "in": "query",
            "description": "Datum vytvoření do.",
            "required": false,
            "schema": {
              "type": "string",
              "anyOf": [
                {
                  "format": "date"
                },
                {
                  "format": "date-time"
                }
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Číslo stránky.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "description": "Počet záznamů na stránku",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tickets": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ChatTicketReport"
                      }
                    },
                    "pagination": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Pagination"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chatboxes/{chatbox-id}/webhook": {
      "post": {
        "summary": "Subscribe live-chat webhook",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "tags": [
          "Live-chaty"
        ],
        "parameters": [
          {
            "name": "chatbox-id",
            "in": "path",
            "description": "The chatbox ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://myserver.com/send-callback-here"
                  }
                },
                "required": [
                  "callback_url"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Webhook created"
          }
        },
        "callbacks": {
          "Changed ticket status": {
            "{$request.body#/callbackUrl}": {
              "post": {
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "chatbox_id": {
                            "type": "integer",
                            "example": 987
                          },
                          "ticket_id": {
                            "type": "integer",
                            "example": 12345
                          },
                          "event": {
                            "type": "string",
                            "enum": [
                              "changed_ticket_status"
                            ]
                          },
                          "changed_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "new_status": {
                            "type": "string",
                            "enum": [
                              "new",
                              "resolved",
                              "trash"
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Your server returns this code if it accepts the callback"
                  }
                }
              }
            }
          },
          "Operator answered with message": {
            "{$request.body#/callbackUrl}": {
              "post": {
                "requestBody": {
                  "required": true,
                  "content": {
                    "application/json": {
                      "schema": {
                        "type": "object",
                        "properties": {
                          "chatbox_id": {
                            "type": "integer",
                            "example": 987
                          },
                          "ticket_id": {
                            "type": "integer",
                            "example": 12345
                          },
                          "event": {
                            "type": "string",
                            "enum": [
                              "operator_answered_with_message"
                            ]
                          },
                          "message_id": {
                            "type": "integer",
                            "example": 1234567
                          },
                          "message_html": {
                            "type": "string",
                            "example": "Your order is resolved.",
                            "description": "Message can contains HTML special chars"
                          },
                          "operator_id": {
                            "type": "integer",
                            "example": 123
                          },
                          "sent_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                },
                "responses": {
                  "200": {
                    "description": "Your server returns this code if it accepts the callback"
                  }
                }
              }
            }
          }
        }
      }
    },
