{
  "openapi": "3.0.3",
  "info": {
    "title": "SupportBox API",
    "description": "API SaaS aplikace [SupportBox](https://supportbox.cz).\n# Zabezpečení\nAPI endpointy počítají s ověřením pomocí HTTP BASIC AUTH.\nLogin je ID účtu a heslo je API key. Obě tyto informace\nnaleznete v záložce \"Zabezpečení\" [v aplikaci](https://app.supportbox.cz).\n# Limity API\nV případě překročení povoleného počtu požadavků pro jeden účet nebo 1 IP adresu\nserver odpoví 429 Too Many Requests. Limit je 60 požadavků za minutu.",
    "contact": {
      "email": "podpora@supportbox.cz"
    },
    "version": "1.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/SupportBox/SupportBox/1.0"
  },
  "servers": [
    {
      "url": "https://app.supportbox.cz"
    }
  ],
  "tags": [
    {
      "name": "E-maily",
      "description": "API pro práci s e-maily."
    },
    {
      "name": "Telefony",
      "description": "API pro práci s telefony."
    },
    {
      "name": "Live-chaty",
      "description": "API pro práci s live-chaty, FB Messengerem a Instragramem."
    },
    {
      "name": "Účet",
      "description": "API pro práci s účtem."
    }
  ],
  "paths": {
    "/api/v1/mailboxes/{mailbox-id}/tickets-enhanced-report": {
      "get": {
        "summary": "Výpis mail ticketů s podrobnostmi ze statistik.",
        "description": "Jsou vybrány tickety s datem editace v posledních 7 dnech.",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "tags": [
          "E-maily"
        ],
        "parameters": [
          {
            "name": "mailbox-id",
            "in": "path",
            "description": "ID mailboxu.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "updatedAtFrom",
            "in": "query",
            "description": "Datum úpravy od.",
            "required": false,
            "schema": {
              "type": "string",
              "anyOf": [
                {
                  "format": "date"
                },
                {
                  "format": "date-time"
                }
              ]
            }
          },
          {
            "name": "updatedAtTo",
            "in": "query",
            "description": "Datum úpravy do.",
            "required": false,
            "schema": {
              "type": "string",
              "anyOf": [
                {
                  "format": "date"
                },
                {
                  "format": "date-time"
                }
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Číslo stránky.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "description": "Počet záznamů na stránku",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tickets": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MailTicketEnhancedReport"
                      }
                    },
                    "pagination": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Pagination"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Požadavek není validní",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string",
                            "description": "jméno chybné hodnoty",
                            "example": "dateTo"
                          },
                          "error": {
                            "type": "string",
                            "description": "popis chyby",
                            "example": "Please provide valid dateTo"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chatboxes/{chatbox-id}/tickets-report": {
      "get": {
        "summary": "Výpis chat ticketů s podrobnostmi ze statistik.",
        "description": "Jsou vybrány tickety s datem vytvoření v posledních 7 dnech.",
