        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompanyUser"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tags": {
      "get": {
        "summary": "Výpis štítků.",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "tags": [
          "Účet"
        ],
        "responses": {
          "200": {
            "description": "successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CompanyTag"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Login is Account ID, password is API token for account."
      }
    },
    "schemas": {
      "MailTicketReport": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "example": 123
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2021-08-12T12:00:00+01:00"
          },
          "customerEmail": {
            "type": "string",
            "nullable": true,
            "example": "customer-email@gmail.com"
          },
          "resolvedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2021-08-12T13:00:00+01:00"
          },
          "firstResponseAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2021-08-12T12:10:00+01:00"
          },
          "averageTimeToResponse": {
            "type": "integer",
            "example": 60,
            "description": "Průměrný čas odpovědi v sekundách."
          },
          "averageTimeToResponseInWorkingHours": {
            "type": "integer",
            "example": 60,
            "description": "Průměrný čas odpovědi v sekundách v rámci pracovní doby."
          },
          "wasResolvedWithFirstResponse": {
            "type": "boolean",
            "example": true,
            "description": "Byl ticket vyřešen první odpovědí?"
          },
          "countResponsesFromOperators": {
            "type": "integer",
            "example": 2,
            "description": "Počet odpovědí od operátorů."
          },
          "customerVotes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MailMessageVote"
            }
          }
        }
      },
      "MailTicketEnhancedReport": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "example": 123
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2021-08-12T12:00:00+01:00"
          },
          "customerEmail": {
            "type": "string",
            "nullable": true,
            "example": "customer-email@gmail.com"
          },
          "resolvedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2021-08-12T13:00:00+01:00"
          },
          "firstResponseAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2021-08-12T12:10:00+01:00"
          },
          "averageTimeToResponse": {
            "type": "integer",
            "example": 60,
            "description": "Průměrný čas odpovědi v sekundách."
          },
          "averageTimeToResponseInWorkingHours": {
            "type": "integer",
            "example": 60,
            "description": "Průměrný čas odpovědi v sekundách v rámci pracovní doby."
          },
          "wasResolvedWithFirstResponse": {
            "type": "boolean",
            "example": true,
            "description": "Byl ticket vyřešen první odpovědí?"
          },
          "countResponsesFromOperators": {
            "type": "integer",
            "example": 2,
            "description": "Počet odpovědí od operátorů."
          },
          "customerVotes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MailMessageVote"
            }
          },
          "updatedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2021-08-12T12:10:00+01:00"
          },
          "tagsIds": {
            "type": "array",
            "description": "ID přiřazených štítků",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "example": [
              1,
              2,
              3
            ]
          },
          "status": {
            "$ref": "#/components/schemas/MailTicketStatus"
          },
          "assignedUserId": {
            "type": "integer",
            "format": "int32",
            "example": 123,
            "description": "ID přiřazeného operátora"
          },
          "outcomingMessagesCount": {
            "type": "integer",
            "format": "int32",
            "example": 10,
            "description": "Počet odchozích zpráv"
          },
          "incomingMessagesCount": {
            "type": "integer",
            "format": "int32",
            "example": 10,
            "description": "Počet příchozích zpráv"
          },
          "duration": {
            "type": "integer",
            "nullable": true,
            "format": "int32",
            "example": 567,
            "description": "Celková doba trvání konverzace (s)"
          }
        }
      },
      "ChatTicketReport": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "example": 123
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2021-08-12T12:00:00+01:00"
          },
          "customerEmail": {
            "type": "string",
            "nullable": true,
            "example": "customer-email@gmail.com",
            "description": "Email zákazníka v případě, že jej známe nebo je spárován."
          },
          "resolvedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2021-08-12T13:00:00+01:00"
          },
          "firstResponseAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2021-08-12T12:10:00+01:00"
          },
          "averageTimeToResponse": {
            "type": "integer",
            "example": 60,
            "description": "Průměrný čas odpovědi v sekundách."
          },
          "averageTimeToResponseInWorkingHours": {
            "type": "integer",
            "example": 60,
            "description": "Průměrný čas odpovědi v sekundách v rámci pracovní doby."
          },
          "wasResolvedWithFirstResponse": {
            "type": "boolean",
            "example": true,
            "description": "Byl ticket vyřešen první odpovědí?"
          },
          "countResponsesFromOperators": {
            "type": "integer",
            "example": 2,
