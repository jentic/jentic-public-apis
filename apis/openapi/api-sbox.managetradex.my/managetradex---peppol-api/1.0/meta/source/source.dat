  "components": {
    "securitySchemes": {
      "oAuth2ClientCredentials": {
        "type": "oauth2",
        "description": "The authentication mechanism of this API supports OAuth 2.0 with the client credentials grant flow to obtain tokens. [More info](https://www.oauth.com/oauth2-servers/access-tokens/client-credentials/).",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth2/token",
            "scopes": {}
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "Unauthorised.\n* Due to an expired access token.\n* Due to invalid access token.\n",
        "content": {
          "application/error+json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseMessage"
            },
            "example": {
              "timestamp": "2024-09-02T09:17:06.14Z",
              "status": 401,
              "error": "Unauthorized"
            }
          }
        }
      },
      "403": {
        "description": "Access to the API is denied.",
        "content": {
          "application/error+json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseMessage"
            },
            "example": {
              "timestamp": "2024-09-02T09:17:06.14Z",
              "status": 403,
              "error": "Forbidden",
              "message": "Access to resource X not allowed."
            }
          }
        }
      },
      "404": {
        "description": "The requested resource not available.",
        "content": {
          "application/error+json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseMessage"
            },
            "example": {
              "timestamp": "2024-09-02T09:17:06.14Z",
              "status": 404,
              "error": "Not found",
              "message": "Requested resource X is not found."
            }
          }
        }
      },
      "502": {
        "description": "Bad Gateway"
      },
      "504": {
        "description": "Gateway Timeout"
      }
    },
    "schemas": {
      "TransactionDocument": {
        "type": "object",
        "properties": {
          "senderId": {
            "$ref": "#/components/schemas/SenderId"
          },
          "receiverId": {
            "$ref": "#/components/schemas/ReceiverId"
          },
          "docType": {
            "$ref": "#/components/schemas/DocType"
          },
          "invoice": {
            "$ref": "#/components/schemas/InvoiceDocument"
          }
        }
      },
      "InvoiceDocument": {
        "type": "object",
        "properties": {
          "invoiceType": {
            "$ref": "#/components/schemas/InvoiceType"
          },
          "invoiceNo": {
            "type": "string",
            "description": "Unique Invoice number"
          },
          "issuedDate": {
            "type": "string",
            "format": "date",
            "description": "Issued date"
          },
          "issuedTime": {
            "type": "string",
            "description": "Issued time.<br> For local time format is HH:mm:ss<br> For timezone format(UTC) is HH:mm:ssZ",
            "example": "15:30:41"
          },
          "currency": {
            "type": "string",
            "description": "Invoice/Credit Note currency code.<br>\nRefer to the Appendix for the 3 letter currency code to be used.\n",
            "minLength": 3,
            "maxLength": 3,
            "example": "MYR"
          },
          "supplier": {
            "$ref": "#/components/schemas/Supplier"
          },
          "buyer": {
            "$ref": "#/components/schemas/Buyer"
          },
          "header": {
            "$ref": "#/components/schemas/Header"
          },
          "validationResult": {
            "$ref": "#/components/schemas/ValidationResult"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "example": [
              {
                "classification": "022",
                "itemId": "1001",
                "description": "Mouse Pad Eco",
                "quantity": 100,
                "uom": {
                  "code": "EA",
                  "name": "Each"
                },
                "unitPrice": 1.0,
                "totalTax": 5.0,
                "taxes": [
                  {
                    "taxable": 100.0,
                    "code": "ST",
                    "rate": 5,
                    "amount": 5.0
                  }
                ],
                "totalExclTax": 100.0,
                "total": 105.0
              },
              {
                "classification": "022",
                "itemId": "1002",
                "description": "Nexus Wireless Mouse E-2099",
                "quantity": 50,
                "uom": {
                  "code": "EA",
                  "name": "Each"
                },
                "unitPrice": 8.0,
                "totalTax": 20.0,
                "taxes": [
                  {
                    "taxable": 400.0,
                    "code": "ST",
                    "rate": 5,
                    "amount": 20.0
                  }
                ],
                "totalExclTax": 400.0,
                "total": 420.0
              }
            ]
          },
          "headerDiscounts": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/HeaderDiscount"
            }
          },
          "headerCharges": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/HeaderCharge"
            }
          },
          "summary": {
            "type": "object",
            "nullable": true,
            "properties": {
              "totalExclTax": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total invoice amount  without tax.<br>\nMax 2 decimals.\n",
                "example": 500.0
              },
              "discount": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total discount amount for the invoice.<br>\nMax 2 decimals.\n",
                "example": 5.0
              },
              "charge": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total charge amount for the invoice.<br>\nMax 2 decimals.\n",
                "example": 50.0
              },
              "totalTax": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total tax amount for the invoice.<br>\nMax 2 decimals.\n",
                "example": 27.5
              },
              "taxes": {
                "type": "array",
                "nullable": true,
                "items": {
                  "$ref": "#/components/schemas/Tax"
                },
                "example": [
                  {
                    "taxable": 550.0,
                    "code": "ST",
                    "rate": 5,
                    "amount": 27.5
                  }
                ]
              },
              "rounding": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The rounding amount for the invoice.<br>\nMax 2 decimals.\n"
              },
              "total": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total amount needs to be paid for the invoice.<br>\nMax 2 decimals.\n",
                "example": 572.5
              }
            }
          },
          "paymentMeans": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/PaymentMean"
            }
          },
          "prePayment": {
            "type": "object",
            "nullable": true,
            "properties": {
              "amount": {
                "type": "number",
                "nullable": true,
                "format": "double",
                "description": "Pre-payment amount"
              },
              "date": {
                "format": "date",
                "description": "Payment date"
              },
              "time": {
                "type": "string",
                "nullable": true,
                "description": "Payment time"
              },
              "reference": {
                "type": "string",
                "description": "Payment reference"
              }
            }
          },
          "paymentTerms": {
            "type": "object",
            "nullable": true,
            "properties": {
              "note": {
                "type": "string",
                "description": "An agreed-upon payment terms and conditions"
              }
            }
          },
          "attachments": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/Attachment"
            }
          },
          "deliveryAddress": {
            "$ref": "#/components/schemas/DeliveryAddress"
          },
          "note": {
            "type": "string",
            "nullable": true,
            "description": "Document note"
          }
        }
      },
      "TransactionDetail": {
        "type": "object",
        "properties": {
          "transactionId": {
            "$ref": "#/components/schemas/TransactionId"
          },
          "direction": {
            "$ref": "#/components/schemas/TransactionDirection"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "messageIdentifier": {
                "type": "string",
                "description": "Alphanumeric identity code for message indentifier",
                "example": "ef4d7907-4413-4a85-8cff-e9c99bf09d02"
              },
              "corner1Identifier": {
                "type": "string",
                "description": "Peppol ID of sender"
              },
              "corner4Identifier": {
                "type": "string",
                "description": "Peppol ID of receiver"
              },
              "documentIdentifier": {
                "type": "string",
                "description": "Document Identifier",
                "example": "peppol-doctype-wildcard::urn:oasis:names:specification:ubl:schema:xsd:Invoice-2::Invoice##urn:peppol:pint:billing-1@my-1::2.1"
              },
              "processIdentifier": {
                "type": "string",
                "description": "Process indentifier",
                "example": "cenbii-procid-ubl::urn:peppol:bis:billing"
              }
            }
          },
          "state": {
            "$ref": "#/components/schemas/TransactionState"
          },
          "outcome": {
            "$ref": "#/components/schemas/TransactionOutcome"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The time (UTC) when the transaction was created"
          },
          "acknowledgedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The time (UTC) when the transaction was acknowledged"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionEvent"
            }
          },
          "artefacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionArtefact"
            }
          }
        }
      },
      "TransactionSearch": {
        "type": "object",
        "properties": {
          "transactionId": {
            "$ref": "#/components/schemas/TransactionId"
          },
          "direction": {
            "$ref": "#/components/schemas/TransactionDirection"
          },
          "documentIdentifier": {
            "type": "string",
            "description": "Document Identifier",
            "example": "peppol-doctype-wildcard::urn:oasis:names:specification:ubl:schema:xsd:Invoice-2::Invoice##urn:peppol:pint:billing-1@my-1::2.1"
          },
          "processIdentifier": {
            "type": "string",
            "description": "Process indentifier",
            "example": "cenbii-procid-ubl::urn:peppol:bis:billing"
          },
          "senderId": {
            "type": "string",
            "description": "Peppol ID of sender"
          },
          "receiverId": {
            "type": "string",
            "description": "Peppol ID of receiver"
          },
          "state": {
            "$ref": "#/components/schemas/TransactionState"
          },
          "outcome": {
            "$ref": "#/components/schemas/TransactionOutcome"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The time (UTC) when the transaction was created"
          }
        }
      },
      "TransactionArtefact": {
        "type": "object",
        "properties": {
          "artefactId": {
            "type": "string",
            "description": "Uniquely identifies a specific artefact.",
            "format": "uuid"
          },
          "type": {
            "$ref": "#/components/schemas/TransactionArtefactType"
          },
          "size": {
            "type": "integer",
            "description": "The size in bytes of the artefact.",
            "format": "int32",
            "minimum": 1,
            "example": 65392
          },
          "contentType": {
            "type": "string",
            "description": "The native content type of the artefact.",
            "example": "application/xml"
          }
        }
      },
      "TransactionArtefactType": {
        "type": "string",
        "description": "Defines the type of the artefact related to a transaction.         \n  * OUTBOUND_SOURCE - The original payload for an outbound transaction.\n  * OUTBOUND_TRANSFORM - A transformed result from OUTBOUND_SOURCE.\n  * INBOUND_SOURCE - The original payload as received for an inbound transaction.\n  * INBOUND_DOCUMENT - A unwrap result from INBOUND_SOURCE.\n  * INBOUND_TRANSFORM - A transformed result from INBOUND_DOCUMENT.\n  * VALIDATION_RESULT - The outcome of validation for a payload.\n  * C2_C3_AP_REQUEST - The request from sending Access Point in an outbound scenario.\n  * C2_C3_AP_RESPONSE - The response from receiving Access Point in an outbound scenario.\n  * C3_C2_AP_REQUEST - The request from sending Access Point in an inbound scenario.\n  * C3_C2_AP_RESPONSE - The response from receiving Access Point in an inbound scenario.\n",
        "enum": [
          "OUTBOUND_SOURCE",
          "OUTBOUND_TRANSFORM",
          "INBOUND_SOURCE",
          "INBOUND_DOCUMENT",
          "INBOUND_TRANSFORM",
          "VALIDATION_RESULT",
          "C2_C3_AP_REQUEST",
          "C2_C3_AP_RESPONSE",
          "C3_C2_AP_REQUEST",
          "C3_C2_AP_RESPONSE"
        ],
        "example": "INBOUND_SOURCE"
      },
      "TransactionEvent": {
        "type": "object",
        "description": "Contains information about events that have been recorded to a transaction.",
        "properties": {
          "access": {
            "$ref": "#/components/schemas/TransactionEventAccessType"
          },
          "level": {
            "$ref": "#/components/schemas/TransactionEventLevelType"
          },
          "description": {
            "type": "string",
            "description": "Description of the occurred event"
          },
          "time": {
            "type": "string",
            "description": "The time (UTC) when the event occurred",
            "format": "date-time"
          },
          "details": {
            "$ref": "#/components/schemas/TransactionEventDetail"
          }
        }
      },
      "TransactionEventAccessType": {
        "type": "string",
        "description": "Describes the sensitivity of the event.\n * PUBLIC - Default level of events.\n * PRIVATE - Internal events.\n",
        "enum": [
          "PUBLIC",
          "PRIVATE"
        ],
        "example": "PUBLIC"
      },
      "TransactionEventLevelType": {
        "type": "string",
        "description": "Describes the type of event. If event is ERROR, the error details can get from TransactionEventDetail. \n * INFO - Standard level of nice to know information.\n * ERROR - Any errors that where detected during the processing, that caused the processing to be halted and marked the transaction as failed.\n",
        "enum": [
          "INFO",
          "ERROR"
        ],
        "example": "ERROR"
      },
      "TransactionEventDetail": {
        "type": "object",
        "description": "Detailed description of a specific situation that can be correlated to a specific event code.",
        "properties": {
          "code": {
            "type": "integer",
            "description": "The event code. Error and event codes documented externally.",
            "format": "int32",
            "pattern": "^\\d{4,}$",
            "example": -1300
          },
          "metric": {
            "type": "integer",
            "description": "Optional metric that has been recorded for a specific situation.",
            "format": "int32",
            "example": 233
          },
          "description": {
            "type": "string",
            "description": "The detailed description.",
            "example": "Transaction could not complete because service X was reporting Y."
          }
        }
      },
      "Participant": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string",
            "description": "Company name"
          },
          "brnType": {
            "type": "string",
            "description": "Type of Business Indentifier"
          },
          "registrationNumber": {
            "type": "string",
            "description": "Business Indentifier"
          },
          "address": {
            "$ref": "#/components/schemas/ParticipantAddress"
          },
          "authorizedPerson": {
            "$ref": "#/components/schemas/AuthorizedPerson"
          },
          "authorizedDocument": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "description": "Authorized document in Base64 format"
              }
            }
          },
          "user": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "User name of person who perform update"
              },
              "email": {
                "type": "string",
                "description": "Email of person who perform update"
              }
            }
          }
        }
      },
      "ParticipantDetail": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "description": "Unique Id assigned by MTX"
          },
          "peppolId": {
            "$ref": "#/components/schemas/PeppolId"
          },
          "companyName": {
            "type": "string",
            "description": "Company name"
          },
          "brnType": {
            "type": "string",
            "description": "Type of Business Indentifier"
          },
          "registrationNumber": {
            "type": "string",
            "description": "Business Indentifier"
          },
          "address": {
            "$ref": "#/components/schemas/ParticipantAddress"
          },
          "authorizedPerson": {
            "$ref": "#/components/schemas/AuthorizedPerson"
          },
          "authorizedDocument": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "description": "Authorized document in Base64 format"
              }
            }
          },
          "docTypeNames": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "List of supported document types"
            }
          },
          "status": {
            "$ref": "#/components/schemas/ParticipantStatus"
          }
        }
      },
      "ParticipantDetailUpdate": {
        "type": "object",
        "properties": {
          "companyName": {
            "type": "string",
            "description": "Company name"
          },
          "address": {
            "$ref": "#/components/schemas/ParticipantAddress"
          },
          "authorizedPerson": {
            "$ref": "#/components/schemas/AuthorizedPerson"
          },
          "user": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "User name of person who perform update"
              },
              "email": {
                "type": "string",
                "description": "Email of person who perform update"
              }
            }
          }
        }
      },
      "ParticipantAddress": {
        "type": "object",
        "properties": {
          "address1": {
            "type": "string",
            "description": "Address line 1"
          },
          "address2": {
            "type": "string",
            "description": "Address Line 2"
          },
          "address3": {
            "type": "string",
            "description": "Address Line 3",
            "nullable": true
          },
          "city": {
            "type": "string",
            "description": "City"
          },
          "postcode": {
            "type": "string",
            "description": "Postal code"
          },
          "state": {
            "type": "string",
            "description": "State",
            "example": "Selangor"
          },
          "country": {
            "type": "string",
            "description": "Country",
            "example": "Malaysia"
          }
        }
      },
      "ParticipantStatus": {
        "type": "string",
        "description": "Status of participant.\n * I - Pending Approval\n * A - Active\n * I - Inactive\n",
        "enum": [
          "P",
          "A",
          "I"
        ]
      },
      "AuthorizedPerson": {
        "type": "object",
        "nullable": true,
        "properties": {
          "firstName": {
            "type": "string",
            "description": "First name of the contact person"
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the contact person"
          },
          "email": {
            "type": "string",
            "description": "Email of the contact person"
          },
          "mobile": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Country dialing code of the contact phone number",
                "example": "+60"
              },
              "number": {
                "type": "string",
                "description": "The contact telephone number of the supplier (e.g,, office, mobile)",
                "example": 16889888
              }
            }
          }
        }
      },
      "Supplier": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the supplier’s company."
          },
          "tin": {
            "type": "string",
            "description": "Supplier’s TIN assigned by IRBM."
          },
          "registrationNumber": {
            "type": "string",
            "description": "New BRN (12 digits) to be used."
          },
          "taxNumber": {
            "type": "string",
            "nullable": true,
            "description": "SST registration number of the supplier. This is not applicable to the suppliers that are not SST registered."
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "contact": {
            "type": "object",
            "nullable": true,
            "properties": {
              "firstName": {
                "type": "string",
                "description": "First name of the contact person"
              },
              "lastName": {
                "type": "string",
                "description": "Last name of the contact person"
              }
            }
          },
          "email": {
            "type": "string",
            "description": "Email address of the supplier",
            "format": "email",
            "nullable": true,
            "example": "abc@supplier.com"
          },
          "telephone": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Country dialing code of the contact phone number.",
                "example": "+60"
              },
              "number": {
                "type": "string",
                "description": "The contact telephone number of the supplier (e.g,, office, mobile)",
                "example": 16889888
              }
            }
          }
        }
      },
      "Buyer": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the buyer’s company (recipient of goods or services)"
          },
          "tin": {
            "type": "string",
            "description": "Buyer’s TIN assigned by IRBM."
          },
          "registrationNumber": {
            "type": "string",
            "description": "New BRN (12 digits) to be used."
          },
          "taxNumber": {
            "type": "string",
            "nullable": true,
            "description": "SST registration number of the buyer. This is not applicable to the buyers that are not SST registered."
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "contact": {
            "type": "object",
            "nullable": true,
            "properties": {
              "firstName": {
                "type": "string",
                "description": "First name of the contact person"
              },
              "lastName": {
                "type": "string",
                "description": "Last name of the contact person"
              }
            }
          },
          "email": {
            "type": "string",
            "description": "Email address of the buyer",
            "format": "email",
            "nullable": true,
            "example": "xyz@buyer.com"
          },
          "telephone": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Country dialing code of the contact phone number.",
                "example": "+60"
              },
              "number": {
                "type": "string",
                "description": "The contact telephone number of the buyer (e.g,, office, mobile)",
                "example": 88920202
              }
            }
          }
        }
      },
      "Header": {
        "type": "object",
        "nullable": true,
        "properties": {
          "paymentDueDate": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "description": "Payment due date"
          },
          "exchangeRate": {
            "type": "object",
            "nullable": true,
            "properties": {
              "rate": {
                "type": "number",
                "format": "double",
                "description": "Currency exchange rate to the invoice currency.<br>\nMax 5 decimals.\n"
              },
              "currency": {
                "type": "string",
                "nullable": true,
                "description": "Exchange currency code. This is applicable when invoice currency is not MYR currency.<br> \nRefer to the Appendix for the 3 letter currency code to be used.<br>\nDefault is MYR.\n"
              },
              "exchangeDate": {
                "type": "string",
                "format": "date",
                "description": "Date of exchange rate.\n"
              }
            },
            "example": {
              "rate": 4.33876,
              "currency": "USD"
            }
          },
          "taxPointDate": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "description": "Tax point date"
          },
          "accountingCost": {
            "type": "string",
            "nullable": true,
            "description": "The buyer’s accounting cost centre."
          },
          "purchaseOrderReference": {
            "type": "string",
            "nullable": true,
            "description": "Purchase order reference number"
          },
          "salesOrderReference": {
            "type": "string",
            "nullable": true,
            "description": "Sales order reference number"
          },
          "contractReference": {
            "type": "string",
            "nullable": true,
            "description": "Contract reference number"
          },
          "tenderReference": {
            "type": "string",
            "nullable": true,
            "description": "Tender reference number"
          },
          "buyerReference": {
            "type": "string",
            "nullable": true,
            "description": "Buyer reference number"
          },
          "projectReference": {
            "type": "string",
            "nullable": true,
            "description": "Project reference number"
          },
          "deliveryDate": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "description": "Delivery date"
          },
          "billingReference": {
            "type": "string",
            "nullable": true,
            "description": "Billing reference number. Original invoice reference number for credit note and debit note."
          },
          "billingReferenceDate": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "description": "Billing reference date. Original invoice date for credit note and debit note."
          },
          "billingReferenceUuid": {
            "type": "string",
            "nullable": true,
            "description": "Billing reference uuid. Original invoice unique ID of the document assigned by IRBM for credit note and debit note."
          },
          "billingFrequency": {
            "type": "string",
            "nullable": true,
            "description": "Frequency of the invoice (e.g., Monthly, Quarterly, Yearly, etc)"
          },
          "billingPeriod": {
            "type": "object",
            "nullable": true,
            "properties": {
              "startDate": {
                "type": "string",
                "format": "date",
                "description": "Start date of invoice period"
              },
              "endDate": {
                "type": "string",
                "format": "date",
                "description": "End date of invoice period"
              }
            }
          },
          "msic": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Supplier’s Malaysia Standard Industrial Classification (MSIC) Code. It is a 5-digit numeric code that represent the Supplier’s business nature and activity.<br>\nLink for the list of MSIC codes:<br>\nhttps://sdk.myinvois.hasil.gov.my/codes/msic-codes/\n",
                "example": 46510
              },
              "name": {
                "type": "string",
                "description": "Description of the supplier’s business activity.",
                "example": "Wholesale of computer hardware, software and peripherals"
              }
            }
          },
          "ftaInfo": {
            "type": "string",
            "nullable": true,
            "description": "Trade agreement between two or more countries."
          },
          "incoterms": {
            "type": "string",
            "nullable": true,
            "description": "A set of international trade rules that define the responsibilities of buyers and suppliers.<br>\nRefer to the Appendix for the INCOTERMS code to be used.\n"
          },
          "certExporterAuthNo": {
            "type": "string",
            "nullable": true,
            "description": "Authorisation Number for Certified Exporter"
          },
          "customsRef1": {
            "type": "string",
            "nullable": true,
            "description": "Unique number assigned on the declaration of goods imported. Customs Form No.1"
          },
          "customsRef2": {
            "type": "string",
            "nullable": true,
            "description": "Unique number assigned on the declaration of goods exported. Customs Form No.2"
          }
        }
      },
      "Item": {
        "type": "object",
        "properties": {
          "classification": {
            "type": "string",
            "description": "Category of products or services<br>\nLink for the list of classification codes:<br>\nhttps://sdk.myinvois.hasil.gov.my/codes/classification-codes/\n"
          },
          "itemId": {
            "type": "string",
            "nullable": true,
            "description": "Product or service Item Id or code"
          },
          "name": {
            "type": "string",
            "description": "Short name of product or service"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Description of product or service"
          },
          "note": {
            "type": "string",
            "nullable": true,
            "description": "Note of product or service"
          },
          "quantity": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Number of units of a particular product or service.<br>\nMax 9 digits and 3 decimals.\n"
          },
          "uom": {
            "type": "string",
            "description": "Standard unit used to measure the product or service. (UN/ECE Recommendation 20, Revision 17)<br>\nLink for the list of UOM:<br>\nhttps://docs.peppol.eu/poac/my/2025-Q2/pint-my/trn-invoice/codelist/UNECERec20/\n",
            "example": "EA"
          },
          "unitPrice": {
            "type": "number",
            "format": "double",
            "description": "Price assigned to a single unit of a product or service.<br>\nMax 2 decimals.\n"
          },
          "discount": {
            "$ref": "#/components/schemas/ItemDiscount"
          },
          "charge": {
            "$ref": "#/components/schemas/ItemCharge"
          },
          "totalTax": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Total tax amount for the line item.<br>\nMax 2 decimals.\n"
          },
          "taxes": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/Tax"
            }
          },
          "taxExemptedReason": {
            "type": "string",
            "nullable": true,
            "description": "Description of tax exemption. Mandatory when tax exemption is applied."
          },
          "totalExclTax": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Line amount excluding tax.<br>\nMax 2 decimals.\n"
          },
          "total": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Total line amount including tax, discount or charge.<br>\nMax 2 decimals.\n"
          },
          "accountingCost": {
            "type": "string",
            "nullable": true,
            "description": "The buyer’s accounting cost centre."
          },
          "hscCode": {
            "type": "string",
            "nullable": true,
            "description": "Harmonized system code of the goods."
          },
          "purchaseOrderLineNo": {
            "type": "integer",
            "description": "Purchase order line number."
          },
          "countryOrigin": {
            "type": "string",
            "nullable": true,
            "description": "A two-letter country code of the origin of goods.<br>\nRefer to the Appendix for the 2 letter country code to be used.\n",
            "example": "MY"
          },
          "batchNo": {
            "type": "string",
            "nullable": true,
            "description": "The batch number of product or service."
          },
          "expiryDate": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "description": "Expiry date"
          },
          "attributes": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Attribute name\n"
                },
                "value": {
                  "type": "string",
                  "description": "Attribute value\n"
                }
              }
            }
          }
        }
      },
      "HeaderDiscount": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Header discount description\n"
          },
          "rate": {
            "type": "number",
            "format": "double",
            "description": "Header discount percentage.<br>\nMax 2 decimals.\n"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Header discount amount deducted from the original price of a product or service.<br>\nMax 2 decimals.\n"
          },
          "tax": {
            "$ref": "#/components/schemas/Tax"
          }
        },
        "example": [
          {
            "description": "Quantity Discount",
            "amount": 5
          }
        ]
      },
      "HeaderCharge": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Header charge description\n"
          },
          "rate": {
            "type": "number",
            "format": "double",
            "description": "Header charge percentage.<br>\nMax 2 decimals.\n"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Header charge amount deducted from the original price of a product or service.<br>\nMax 2 decimals.\n"
          },
          "tax": {
            "$ref": "#/components/schemas/Tax"
          }
        },
        "example": [
          {
            "description": "Bank Charges",
            "rate": 10,
            "tax": [
              {
                "taxable": 50.0,
                "code": "ST",
                "rate": 5,
                "amount": 2.5
              }
            ]
          }
        ]
      },
      "ValidationResult": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "description": "Validated date"
          },
          "time": {
            "type": "string",
            "description": "Validated time"
          },
          "uuid": {
            "type": "string",
            "description": "Unique ID of the document assigned by IRBM when validation result is valid."
          },
          "link": {
            "type": "string",
            "description": "The public URL link to verify the validated e-invoices via MyInvois.<br>\nThis info is only available when the validation result is valid.\n"
          }
        }
      },
      "ItemDiscount": {
        "type": "object",
        "nullable": true,
        "properties": {
          "description": {
            "type": "string",
            "description": "Discount description. If not provided, default to ‘Discount’\n"
          },
          "rate": {
            "type": "number",
            "format": "double",
            "description": "Discount percentage to the invoiced item.<br>\nMax 2 decimals.\n"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Line discount amount deducted from the original price of a product or service.<br>\nMax 2 decimals.\n"
          }
        }
      },
      "ItemCharge": {
        "type": "object",
        "nullable": true,
        "properties": {
          "description": {
            "type": "string",
            "description": "Charge description. If not provided, default to ‘Charge’\n"
          },
          "rate": {
            "type": "number",
            "format": "double",
            "description": "Charge percentage applied to the item.<br>\nMax 2 decimals.\n"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Charge amount to the item.<br>\nMax 2 decimals.\n"
          }
        }
      },
      "PaymentMean": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "description": "Code of payment means<br>\nLink for the list of payment means:<br>\nhttps://docs.peppol.eu/poac/my/2025-Q2/pint-my/trn-invoice/codelist/UNCL4461/\n"
          },
          "description": {
            "type": "string",
            "description": "Description of payment means<br>\nLink for the list of payment means:<br>\nhttps://docs.peppol.eu/poac/my/2025-Q2/pint-my/trn-invoice/codelist/UNCL4461/\n"
          },
          "bank": {
            "type": "object",
            "nullable": true,
            "properties": {
              "name": {
                "type": "string",
                "description": "Bank name",
                "example": "Maybank"
              },
              "branchCode": {
                "type": "string",
                "description": "The bank branch code. Swift or BIC code."
              },
              "accountName": {
                "type": "string",
                "description": "Bank account no."
              },
              "accountNumber": {
                "type": "string",
                "description": "Bank account name"
              }
            }
          }
        },
        "example": [
          {
            "method": "B",
            "bank": {
              "name": "Maybank",
              "accountName": "A B",
              "accountNumber": "A1234567890"
            }
          },
          {
            "method": "C"
          },
          {
            "method": "Q"
          }
        ]
      },
      "Attachment": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "description": "The document file name."
          },
          "description": {
            "type": "string",
            "description": "The document description."
          },
          "contentType": {
            "type": "string",
            "description": "The document mime type."
          },
          "content": {
            "type": "string",
            "description": "The document with Base64 encoding"
          }
        }
      },
      "DeliveryAddress": {
        "type": "object",
        "nullable": true,
        "properties": {
          "name": {
            "type": "string",
            "nullable": true,
            "description": "Name of the shipping recipient of the goods/services"
          },
          "tin": {
            "type": "string",
            "nullable": true,
            "description": "TIN of the shipping recipient"
          },
          "registrationNumber": {
            "type": "string",
            "nullable": true,
            "description": "Shipping recipient’s Registration / Identification number / Passport number"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "SenderId": {
        "type": "string",
        "description": "Peppol ID of sender."
      },
      "ReceiverId": {
        "type": "string",
        "description": "Peppol ID of receiver."
      },
      "PeppolId": {
        "type": "string",
        "description": "Unique alphanumeric code used within the Peppol network."
      },
      "TransactionId": {
        "type": "string",
        "description": "Unique alphanumeric identity code for submitted document."
      },
      "TransformationId": {
        "type": "string",
        "description": "Defines a specific transformation",
        "minLength": 36,
        "maxLength": 36,
        "format": "uuid"
      },
      "ArtefactId": {
        "type": "string",
        "description": "Unique alphanumeric identity code for an artefact",
        "minLength": 36,
        "maxLength": 36,
        "format": "uuid"
      },
      "TransactionDirection": {
        "type": "string",
        "description": "Direction of the transaction\n * I - A transaction that has been received from the Peppol network.\n * O - A transaction that sending to Peppol network.",
        "enum": [
          "I",
          "O"
        ],
        "example": "I"
      },
      "TransactionState": {
        "type": "string",
        "description": "Current state of a transaction.\n * PROCESSING - Transaction is still being processed.\n * COMPLETED - The transaction processing is completed. This is an end-state. Once client is successfully updated into client system, client required to update state as ACKNOWLEDGED.\n * ACKNOWLEDGED - The transaction has been acknowledged by consumer as final state.\n",
        "enum": [
          "PROCESSING",
          "COMPLETED",
          "ACKNOWLEDGED"
        ],
        "example": "ACKNOWLEDGED"
      },
      "TransactionOutcome": {
        "type": "string",
        "description": "Current outcome of a transaction.\n * SUCCESS - The transaction was processed successfully.\n * FAILED - The transaction was processed with Error. Refer to the latest ERROR-event for detailed information.\n",
        "enum": [
          "SUCCESS",
          "FAILED"
        ]
      },
      "PaginationCursor": {
        "type": "string",
        "description": "A pagination cursor to fetch next result list."
      },
      "DocType": {
        "type": "string",
        "description": "Type of the document.\n * invoice - Invoice\n",
        "enum": [
          "invoice"
        ]
      },
      "InvoiceType": {
        "type": "string",
        "description": "Type of the invoice. Default is invoice.\n * invoice - Invoice\n * creditnote - Credit Note\n * debitnote - Debit Note\n",
        "enum": [
          "invoice",
          "creditnote"
        ]
      },
      "Address": {
        "type": "object",
        "properties": {
          "address1": {
            "type": "string",
            "description": "Address line 1"
          },
          "address2": {
            "type": "string",
            "description": "Address Line 2"
          },
          "address3": {
            "type": "string",
            "description": "Address Line 3",
            "nullable": true
          },
          "city": {
            "type": "string",
            "description": "City name"
          },
          "postcode": {
            "type": "string",
            "description": "Postal code"
          },
          "state": {
            "type": "string",
            "description": "State name",
            "example": "Selangor"
          },
          "country": {
            "type": "string",
            "description": "Country code.<br>\nRefer to the Appendix for the list of 2 letter country codes.\n",
            "example": "MY"
          }
        }
      },
      "Tax": {
        "type": "object",
        "nullable": true,
        "properties": {
          "taxable": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Taxable amount for the line item."
          },
          "code": {
            "type": "string",
            "description": "Type of taxes for the line item. Mandatory when the line item is subjected to tax.<br>\n* SA = Sales Tax\n* SE = Service Tax\n* HVG - High-Value Goods Tax\n* LVG = Sales Tax on Low-Value Goods\n* E = Exempted\n* O - Outside scope of tax\n"
          },
          "quantity": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Number of units of a particular tax.\n"
          },
          "rate": {
            "type": "number",
            "format": "double",
            "description": "Tax rate applied to the line item.<br>\nTax rate is mandatory when tax type is provided.<br>\nMax 2 decimals.\n"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "tax amount"
          }
        }
      },
      "IncludeArtefacts": {
        "type": "boolean",
        "description": "To include artefact files in Base64 (E.g. PDF).<br/>  Default is false."
      },
      "ReponseMessage": {
        "type": "object",
        "description": "Response message in json.",
        "properties": {
          "statusCode": {
            "type": "string",
            "description": "Status code.\n* 000 - Success\n* 999 - Failed\n",
            "example": "000"
          },
          "statusDescription": {
            "type": "string",
            "description": "Status description.\n* SUCCESS_RESPONSE - Success\n* ERROR_RESPONSE - Failed\n",
            "example": "SUCCESS_RESPONSE"
          }
        }
      },
      "DocumentReponseMessage": {
        "type": "object",
        "description": "Response message in json.",
        "properties": {
          "statusCode": {
            "type": "string",
            "description": "Status code.\n* 000 - Success\n* 999 - Failed\n",
            "example": "000"
          },
          "statusDescription": {
            "type": "string",
            "description": "Status description.\n* SUCCESS_RESPONSE - Success\n* ERROR_RESPONSE - Failed\n",
            "example": "SUCCESS_RESPONSE"
          },
          "message": {
            "type": "object",
            "properties": {
              "transactionId": {
                "$ref": "#/components/schemas/TransactionId"
              }
            }
          }
        }
      },
      "ErrorResponseMessage": {
        "type": "object",
        "description": "Always available in the body for responses of type 'application/problem+json'.",
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "Date and time of the error response.",
            "format": "date"
          },
          "status": {
            "type": "string",
            "description": "HTTP status codes."
          },
          "error": {
            "type": "string",
            "description": "HTTP status description."
          },
          "message": {
            "type": "string",
            "description": "Detailed error description."
          }
        }
      },
      "PeppolReponseMessage": {
        "type": "object",
        "description": "Response message in json.",
        "properties": {
          "statusCode": {
            "type": "string",
            "description": "Status code.\n* 000 - Success\n* 999 - Failed\n",
            "example": "000"
          },
          "statusDescription": {
            "type": "string",
            "description": "Status description.\n* SUCCESS_RESPONSE - Success\n* ERROR_RESPONSE - Failed\n",
            "example": "SUCCESS_RESPONSE"
          },
          "messages": {
            "type": "object",
            "properties": {
              "idScheme": {
                "type": "string"
              },
              "idType": {
                "type": "string"
              },
              "idValue": {
                "type": "string"
              },
              "supportedDocuments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "commonName": {
                      "type": "string"
                    },
                    "profileCode": {
                      "type": "string"
                    },
                    "documentLocalName": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "documentIdentifier": {
                      "type": "string"
                    },
                    "documentIdentifierScheme": {
                      "type": "string"
                    },
                    "processIdentifier": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
