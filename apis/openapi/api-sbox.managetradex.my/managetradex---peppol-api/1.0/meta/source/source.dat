{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0",
    "title": "ManageTradeX - Peppol API",
    "description": "Provides sending/receiving Peppol documents with the ManageTradeX platform.",
    "contact": {
      "name": "ManageTradeX Support",
      "url": "https://www.managetradex.com/",
      "email": "support@managetradex.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/managetradex/PEPPOL-API/1.0"
  },
  "servers": [
    {
      "url": "https://api-sbox.managetradex.my/api/1.0",
      "description": "Sandbox"
    }
  ],
  "paths": {
    "/transactions": {
      "post": {
        "tags": [
          "Transactions"
        ],
        "summary": "Submit transaction",
        "description": "Submit a transaction in ubl/native format for processing and sending to Peppol network.<br>\nUpon processing completed, it will invoke callback api with successful result or failed result with error.",
        "parameters": [
          {
            "in": "query",
            "name": "transformationId",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TransformationId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "senderId": {
                    "$ref": "#/components/schemas/SenderId"
                  },
                  "receiverId": {
                    "$ref": "#/components/schemas/ReceiverId"
                  },
                  "docType": {
                    "$ref": "#/components/schemas/DocType"
                  },
                  "invoice": {
                    "$ref": "#/components/schemas/InvoiceDocument"
                  }
                }
              },
              "examples": {
                "invoiceExample": {
                  "summary": "Invoice",
                  "value": {
                    "senderId": "0230:01123456789012",
                    "receiverId": "0230:01456789012345",
                    "docType": "invoice",
                    "invoice": {
                      "invoiceNo": "INV-00002",
                      "issuedDate": "2024-01-02",
                      "issuedTime": "15:30:41",
                      "currency": "MYR",
                      "supplier": {
                        "name": "string",
                        "tin": "string",
                        "registrationNumber": "string",
                        "taxNumber": "string",
                        "address": {
                          "address1": "string",
                          "city": "string",
                          "state": "Selangor",
                          "country": "MY"
                        },
                        "telephone": {
                          "code": "+60",
                          "number": "16889888"
                        }
                      },
                      "buyer": {
                        "name": "string",
                        "tin": "string",
                        "registrationNumber": "string",
                        "address": {
                          "address1": "string",
                          "city": "string",
                          "state": "Selangor",
                          "country": "MY"
                        },
                        "telephone": {
                          "code": "+60",
                          "number": "88920202"
                        }
                      },
                      "header": {
                        "msic": {
                          "code": "46510",
                          "name": "Wholesale of computer hardware, software and peripherals"
                        }
                      },
                      "validationResult": {
                        "date": "2024-01-02",
                        "time": "15:30:42Z",
                        "uuid": "W6ZZJ0CN6J24TCD2TEWDXK6K10",
                        "link": "https://preprod.myinvois.hasil.gov.my/W6ZZJ0CN6J24TCD2TDWDXK6K10/share/FBDJ3A9QH4FGM1CRTDWDXK6K10gSLZVe1759457505"
                      },
                      "items": [
                        {
                          "classification": "022",
                          "name": "Mouse Pad Eco",
                          "quantity": 100,
                          "uom": "EA",
                          "unitPrice": 1,
                          "taxes": [
                            {
                              "code": "SA",
                              "rate": 5
                            }
                          ]
                        },
                        {
                          "classification": "022",
                          "name": "Nexus Wireless Mouse E-2099",
                          "quantity": 50,
                          "uom": "EA",
                          "unitPrice": 8
                        }
                      ]
                    }
                  }
                },
                "creditNoteExample": {
                  "summary": "Credit Note",
                  "value": {
                    "senderId": "0230:01123456789012",
                    "receiverId": "0230:01456789012345",
                    "docType": "invoice",
                    "invoice": {
                      "invoiceType": "creditnote",
                      "invoiceNo": "CN-00001",
                      "issuedDate": "2024-01-02",
                      "issuedTime": "15:30:41",
                      "currency": "MYR",
                      "supplier": {
                        "name": "string",
                        "tin": "string",
                        "registrationNumber": "string",
                        "address": {
                          "address1": "string",
                          "city": "string",
                          "state": "Selangor",
                          "country": "MY"
                        },
                        "telephone": {
                          "code": "60",
                          "number": "16889888"
                        }
                      },
                      "buyer": {
                        "name": "string",
                        "tin": "string",
                        "registrationNumber": "string",
                        "address": {
                          "address1": "string",
                          "city": "string",
                          "state": "Selangor",
                          "country": "MY"
                        },
                        "telephone": {
                          "code": "60",
                          "number": "88920202"
                        }
                      },
                      "header": {
                        "origInvNo": "INV-00001",
                        "msic": {
                          "code": "46510",
                          "name": "Wholesale of computer hardware, software and peripherals"
                        }
                      },
                      "validationResult": {
                        "date": "2024-01-02",
                        "time": "15:30:42Z",
                        "uuid": "W6ZZJ0CN6J24TCD2TEWDXK6K10",
                        "link": "https://preprod.myinvois.hasil.gov.my/W6ZZJ0CN6J24TCD2TDWDXK6K10/share/FBDJ3A9QH4FGM1CRTDWDXK6K10gSLZVe1759457505"
                      },
                      "items": [
                        {
                          "classification": "022",
                          "name": "Mouse Pad Eco",
                          "quantity": 100,
                          "uom": "EA",
                          "unitPrice": 1,
                          "taxes": [
                            {
                              "code": "SA",
                              "rate": 5
                            }
                          ]
                        },
                        {
                          "classification": "022",
                          "name": "Nexus Wireless Mouse E-2099",
                          "quantity": 50,
                          "uom": "EA",
                          "unitPrice": 8
                        }
                      ]
                    }
                  }
                }
              }
            },
            "application/xml": {
              "schema": {
                "type": "object",
                "xml": {
                  "name": "StandardBusinessDocument"
                }
              },
              "examples": {
                "ublExample": {
                  "summary": "SBDH wrapped business document for Peppol",
                  "value": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<StandardBusinessDocument xmlns=\"http://www.unece.org/cefact/namespaces/StandardBusinessDocumentHeader\">\n  <StandardBusinessDocumentHeader>\n    <HeaderVersion>1.0</HeaderVersion>\n    <Sender>\n      <Identifier Authority=\"iso6523-actorid-upis\">0230:01201001043854</Identifier>\n    </Sender>\n    <Receiver>\n        <Identifier Authority=\"iso6523-actorid-upis\">0230:01202099990006</Identifier>\n    </Receiver>\n    <DocumentIdentification>\n        <Standard>urn:oasis:names:specification:ubl:schema:xsd:Invoice-2</Standard>\n        <TypeVersion>2.1</TypeVersion>\n        <InstanceIdentifier>b2a96ad7-fb12-4092-a81b-71c8a82db580</InstanceIdentifier>\n        <Type>Invoice</Type>\n        <CreationDateAndTime>2024-09-18T07:51:02.765Z</CreationDateAndTime>\n    </DocumentIdentification>\n    <BusinessScope>\n        <Scope>\n            <Type>DOCUMENTID</Type>\n            <InstanceIdentifier>urn:oasis:names:specification:ubl:schema:xsd:Invoice-2::Invoice##urn:peppol:pint:billing-1@my-1::2.1</InstanceIdentifier>\n            <Identifier>peppol-doctype-wildcard</Identifier>\n        </Scope>\n        <Scope>\n            <Type>PROCESSID</Type>\n            <InstanceIdentifier>urn:peppol:bis:billing</InstanceIdentifier>\n        </Scope>\n        <Scope>\n            <Type>COUNTRY_C1</Type>\n            <InstanceIdentifier>MY</InstanceIdentifier>\n        </Scope>\n    </BusinessScope>\n  </StandardBusinessDocumentHeader>\n  <Invoice>\n      ...\n  </Invoice>\n</StandardBusinessDocument>"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The transaction submitted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentReponseMessage"
                }
              }
            }
          },
          "400": {
            "description": "Failed to submit the transaction with the error message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseMessage"
                },
                "example": {
                  "statusCode": "999",
                  "statusDescription": "Error message"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "502": {
            "$ref": "#/components/responses/502"
          },
          "504": {
            "$ref": "#/components/responses/504"
          }
        },
        "security": [
          {
            "oAuth2ClientCredentials": []
          }
        ]
      },
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Get the list of transactions",
        "description": "List transactions.",
        "parameters": [
          {
            "in": "query",
            "name": "direction",
            "required": false,
            "description": "Filter on specific transaction directions.",
            "schema": {
              "$ref": "#/components/schemas/TransactionDirection"
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "description": "Filter on specific transaction states.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/TransactionState"
              }
            }
          },
          {
            "in": "query",
            "name": "outcome",
            "required": false,
            "description": "Filter on specific transaction outcomes.",
            "style": "form",
            "explode": false,
            "schema": {
              "$ref": "#/components/schemas/TransactionOutcome"
            }
          },
          {
            "in": "query",
            "name": "createdAtFrom",
            "required": false,
            "description": "Filter on creation from datetime. Format: “YYYY-MM-DDThh:mm:ssZ”.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "createdAtTo",
            "required": false,
            "description": "Filter on creation to datetime. Format: “YYYY-MM-DDThh:mm:ssZ”.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "Specify the maximum items to return in the response for pagination. Use together with cursor.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "description": "A pagination cursor to fetch next result list.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/PaginationCursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response the document details in xml format.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cursor": {
                      "$ref": "#/components/schemas/PaginationCursor"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TransactionSearch"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "502": {
            "$ref": "#/components/responses/502"
          },
          "504": {
            "$ref": "#/components/responses/504"
          }
        },
        "security": [
          {
            "oAuth2ClientCredentials": []
          }
        ]
      }
    },
    "/transactions/{transactionId}": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Get transaction details",
        "description": "Get transaction details by transaction id.",
        "parameters": [
          {
            "in": "path",
            "name": "transactionId",
            "required": true,
            "description": "Unique alphanumeric identity code for submitted transaction.",
            "schema": {
              "$ref": "#/components/schemas/TransactionId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response the document details in json format.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "502": {
            "$ref": "#/components/responses/502"
          },
          "504": {
            "$ref": "#/components/responses/504"
          }
        },
        "security": [
          {
            "oAuth2ClientCredentials": []
          }
        ]
      }
    },
    "/transactions/{transactionId}/acknowledge": {
      "put": {
        "tags": [
          "Transactions"
        ],
        "summary": "Acknowledge a transaction as processed",
        "description": "Ability for the client to acknowledge that they have successfully processed any information related to a \ntransaction. This can only be done to a transaction that is in an COMPLETED state.",
        "parameters": [
          {
            "in": "path",
            "name": "transactionId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TransactionId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The transaction acknowledged successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseMessage"
                }
              }
            }
          },
          "400": {
            "description": "Failed to update transaction as acknowledged with the error message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseMessage"
                },
                "example": {
                  "statusCode": "999",
                  "statusDescription": "Error message"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "502": {
            "$ref": "#/components/responses/502"
          },
          "504": {
            "$ref": "#/components/responses/504"
          }
        },
        "security": [
          {
            "oAuth2ClientCredentials": []
          }
        ]
      }
    },
    "/transactions/{transactionId}/artefacts/{artefactId}": {
      "get": {
        "tags": [
          "Transactions"
        ],
        "summary": "Download an artefact",
        "description": "Downloads an artefact. <br> For sending with native format, actual ubl format is available to download with type \"OUTBOUND_TRANSFORM\".<br> For receiving with native format, transformed native format is available to download with type \"INBOUND_TRANSFORM\".",
        "parameters": [
          {
            "in": "path",
            "name": "transactionId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TransactionId"
            }
          },
          {
            "in": "path",
            "name": "artefactId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ArtefactId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful and content response in the request body."
          },
          "400": {
            "description": "Failed to download artefact with the error message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseMessage"
                },
                "example": {
                  "statusCode": "999",
                  "statusDescription": "Error message"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "502": {
            "$ref": "#/components/responses/502"
          },
          "504": {
            "$ref": "#/components/responses/504"
          }
        },
        "security": [
          {
            "oAuth2ClientCredentials": []
          }
        ]
      }
    },
