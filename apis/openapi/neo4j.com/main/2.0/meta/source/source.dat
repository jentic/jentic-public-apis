{
  "openapi": "3.0.3",
  "info": {
    "title": "Neo4j Query API",
    "description": "The Neo4j Query API allows executing Cypher statements against a Neo4j server through HTTP requests. It supports both single-request queries and explicit transactions.",
    "version": "2.0",
    "x-jentic-source-url": "https://neo4j.com/docs/query-api/current/endpoints/",
    "contact": {
      "name": "Neo4j",
      "url": "https://neo4j.com"
    }
  },
  "servers": [
    {
      "url": "https://{host}:{port}",
      "description": "Neo4j Server (Aura or self-managed)",
      "variables": {
        "host": {
          "default": "your-instance.databases.neo4j.io",
          "description": "Neo4j server hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port (443 for Aura, 7473 for self-managed)"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "discovery",
        "summary": "Service discovery",
        "description": "Obtain a list of available endpoints and basic server information.",
        "responses": {
          "200": {
            "description": "Server information and available endpoints",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/db/{databaseName}/query/v2": {
      "post": {
        "operationId": "executeQuery",
        "summary": "Execute a Cypher query",
        "description": "Submit a Cypher query to the specified database. The query runs in an auto-commit transaction.",
        "parameters": [
          {
            "name": "databaseName",
            "in": "path",
            "required": true,
            "description": "Name of the target database",
            "schema": {
              "type": "string",
              "default": "neo4j"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "statement"
                ],
                "properties": {
                  "statement": {
                    "type": "string",
                    "description": "Cypher query statement"
                  },
                  "parameters": {
                    "type": "object",
                    "description": "Query parameters",
                    "additionalProperties": true
                  },
                  "includeCounters": {
                    "type": "boolean",
                    "description": "Include query counters in response"
                  },
                  "bookmarks": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Causal chain bookmarks"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Database not found"
          }
        }
      }
    },
    "/db/{databaseName}/query/v2/tx": {
      "post": {
        "operationId": "beginTransaction",
        "summary": "Begin an explicit transaction",
        "description": "Open a new explicit transaction on the specified database. Optionally execute queries in the same request.",
        "parameters": [
          {
            "name": "databaseName",
            "in": "path",
            "required": true,
            "description": "Name of the target database",
            "schema": {
              "type": "string",
              "default": "neo4j"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string",
                    "description": "Optional Cypher query to execute"
                  },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "bookmarks": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction opened",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResult"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Database not found"
          }
        }
      }
    },
    "/db/{databaseName}/query/v2/tx/{transactionId}": {
      "post": {
        "operationId": "executeInTransaction",
        "summary": "Execute query in transaction",
        "description": "Execute a Cypher query within an open explicit transaction.",
        "parameters": [
          {
            "name": "databaseName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "statement"
                ],
                "properties": {
                  "statement": {
                    "type": "string"
                  },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResult"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Transaction not found"
          }
        }
      },
      "delete": {
        "operationId": "rollbackTransaction",
        "summary": "Rollback transaction",
        "description": "Rollback and close an open explicit transaction.",
        "parameters": [
          {
            "name": "databaseName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction rolled back"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Transaction not found"
          }
        }
      }
    },
    "/db/{databaseName}/query/v2/tx/{transactionId}/commit": {
      "post": {
        "operationId": "commitTransaction",
        "summary": "Commit transaction",
        "description": "Commit an open explicit transaction. Optionally execute a final query before committing.",
        "parameters": [
          {
            "name": "databaseName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transactionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string"
                  },
                  "parameters": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction committed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResult"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Transaction not found"
          }
        }
      }
    },
    "/dbms/cluster": {
      "get": {
        "operationId": "getClusterInfo",
        "summary": "Get cluster information",
        "description": "Returns cluster topology and routing information.",
        "responses": {
          "200": {
            "description": "Cluster information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "QueryResult": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Column names"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "array"
                },
                "description": "Result rows"
              },
              "bookmarks": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Causal chain bookmarks"
              }
            }
          },
          "counters": {
            "type": "object",
            "description": "Query execution counters"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic authentication with Neo4j username and password"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token authentication"
      }
    }
  }
}
