{"openapi":"3.0.0","info":{"title":"ManyScripts API","version":"1.0.0","description":"Extract transcripts and metadata from TikTok, YouTube, Instagram, X/Twitter, Facebook, and Xiaohongshu (beta) videos."},"servers":[{"url":"https://www.manyscripts.com/api/v1","description":"ManyScripts API v1"}],"security":[{"bearerAuth":[]}],"paths":{"/me":{"get":{"operationId":"getAccount","summary":"Check an API key","description":"Returns the account behind the API key and whether it can call the API. Costs nothing and runs no extraction, so integration platforms should use this to test a saved connection.","responses":{"200":{"description":"The key is valid","content":{"application/json":{"schema":{"type":"object","properties":{"userId":{"type":"string"},"email":{"type":"string","nullable":true},"plan":{"type":"string","enum":["pro","free"]},"apiAccess":{"type":"boolean","description":"False on a free plan: the key is real but /transcript will answer 403."}}}}}},"401":{"description":"Missing or invalid API key"}}}},"/transcript":{"post":{"operationId":"extractTranscript","summary":"Extract video transcript","description":"Extracts the spoken transcript, the creator's written caption, and metadata from a social video URL. Supported: YouTube, TikTok, Instagram Reels, X/Twitter, Facebook.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["url"],"properties":{"url":{"type":"string","description":"Full URL of the video to transcribe.","example":"https://www.tiktok.com/@user/video/123456789"}}}}}},"responses":{"200":{"description":"Transcript extracted successfully","content":{"application/json":{"schema":{"type":"object","properties":{"transcript":{"type":"string"},"platform":{"type":"string"},"title":{"type":"string"},"uploader":{"type":"string"},"duration":{"type":"string"},"viewCount":{"type":"number"},"likeCount":{"type":"number"},"commentCount":{"type":"number"},"shareCount":{"type":"number","description":"Reposts or shares. Well populated on TikTok and often absent elsewhere, so treat it as optional rather than zero."},"uploadDate":{"type":"string","description":"YYYYMMDD, as the platform reports it."},"hashtags":{"type":"array","items":{"type":"string"}},"caption":{"type":"string","description":"The text the creator wrote alongside the video: the post caption on Instagram, TikTok and Facebook, the video description on YouTube. Written text, not the spoken transcript. Truncated to 2200 characters."}}}}}},"400":{"description":"Invalid URL, unsupported platform, or no transcript found","content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string","description":"What happened, written for a person."},"code":{"type":"string","description":"Machine-readable cause, e.g. NO_SPEECH, PRIVATE_VIDEO, LICENSED_AUDIO_WITHHELD, RATE_LIMITED, DOWNLOAD_TIMEOUT."},"retryable":{"type":"boolean","description":"Whether sending the same link again soon can change the answer. When false, do not retry this link; move on. When true, back off (honour Retry-After when present) and try again."}}}}}},"401":{"description":"Missing or invalid API key"},"403":{"description":"Pro subscription required"},"429":{"description":"Too many requests. One of: the rate limit (60 requests/minute; body carries `error`); the account's daily extraction limit (1,000 a day by default, reset at 00:00 UTC; body carries `message` and `limitReached: true`); or a cooldown, when this account sent a link that failed in the last 30 minutes with an answer retrying cannot change (body carries `cooldown: true`, the original `code` and `retryable: false`; nothing is extracted and nothing is counted). Wait for Retry-After before trying again.","headers":{"Retry-After":{"description":"Seconds until the limit that refused this request resets.","schema":{"type":"integer"}}},"content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string","description":"Daily limit: what was reached and when it resets."},"limitReached":{"type":"boolean","description":"True when the daily extraction limit refused the request, rather than the per-minute rate limit."},"error":{"type":"string","description":"Per-minute rate limit only."},"cooldown":{"type":"boolean","description":"True when this link failed for this account in the last 30 minutes. Move on to the next link."},"code":{"type":"string","description":"Cooldown only: the code of the failure being repeated."},"retryable":{"type":"boolean","description":"Cooldown only: always false."}}}}}},"500":{"description":"Extraction failed","content":{"application/json":{"schema":{"type":"object","properties":{"message":{"type":"string","description":"What happened, written for a person."},"code":{"type":"string","description":"Machine-readable cause, e.g. NO_SPEECH, PRIVATE_VIDEO, LICENSED_AUDIO_WITHHELD, RATE_LIMITED, DOWNLOAD_TIMEOUT."},"retryable":{"type":"boolean","description":"Whether sending the same link again soon can change the answer. When false, do not retry this link; move on. When true, back off (honour Retry-After when present) and try again."}}}}}}}}}},"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"Your ManyScripts API key (starts with msk_). Generate one in Dashboard → Connect & Integrations."}}}}