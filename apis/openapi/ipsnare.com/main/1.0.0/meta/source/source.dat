{
  "openapi": "3.0.3",
  "info": {
    "title": "IPSnare API",
    "description": "API for ingesting click tracking data",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@ipsnare.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/visionfullimited/ipsnare-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.ipsnare.com/v1",
      "description": "Production server"
    }
  ],
  "paths": {
    "/clicks": {
      "post": {
        "summary": "Ingest click data",
        "description": "Creates a new click record in the database",
        "operationId": "ingestClick",
        "tags": [
          "Clicks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClickData"
              },
              "examples": {
                "validClick": {
                  "summary": "Valid click data",
                  "value": {
                    "publisher_id": "pub_456",
                    "user_ip": "192.168.1.1",
                    "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
                    "click_id": "click_789abc",
                    "job_id": "job_def123",
                    "job_country": "US",
                    "click_country": "US",
                    "publisher_click_id": "pub_click_xyz",
                    "created_at": "2025-11-10T12:30:45Z",
                    "expired": 0,
                    "expired_at": null,
                    "bot_score": 0.15,
                    "is_bot": 0,
                    "bot_type": "",
                    "metadata": {
                      "campaign_id": "camp_001",
                      "source": "google"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Click data successfully ingested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "success": true,
                  "message": "Click data ingested successfully",
                  "click_id": "click_789abc",
                  "timestamp": "2025-11-10T12:30:45Z"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingRequiredField": {
                    "summary": "Missing required field",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Missing required field",
                        "details": [
                          {
                            "field": "publisher_id",
                            "message": "publisher_id is required"
                          }
                        ]
                      }
                    }
                  },
                  "invalidDataType": {
                    "summary": "Invalid data type",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Invalid data type",
                        "details": [
                          {
                            "field": "is_bot",
                            "message": "is_bot must be 0 or 1"
                          }
                        ]
                      }
                    }
                  },
                  "invalidCountryCode": {
                    "summary": "Invalid country code",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Invalid country code format",
                        "details": [
                          {
                            "field": "job_country",
                            "message": "job_country must be a 2-character ISO country code"
                          }
                        ]
                      }
                    }
                  },
                  "invalidIPAddress": {
                    "summary": "Invalid IP address",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Invalid IP address format",
                        "details": [
                          {
                            "field": "user_ip",
                            "message": "user_ip must be a valid IPv4 or IPv6 address"
                          }
                        ]
                      }
                    }
                  },
                  "invalidBotScore": {
                    "summary": "Invalid bot score range",
                    "value": {
                      "success": false,
                      "error": {
                        "code": "VALIDATION_ERROR",
                        "message": "Invalid bot score range",
                        "details": [
                          {
                            "field": "bot_score",
                            "message": "bot_score must be between 0.0 and 1.0"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable entity - business logic error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "BUSINESS_LOGIC_ERROR",
                    "message": "expired_at must be set when expired is 1",
                    "details": [
                      {
                        "field": "expired_at",
                        "message": "expired_at is required when expired equals 1"
                      }
                    ]
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Failed to insert data into database",
                    "details": []
                  }
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable - database connection error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "SERVICE_UNAVAILABLE",
                    "message": "Database is currently unavailable",
                    "details": []
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClickData": {
        "type": "object",
        "required": [
          "publisher_id",
          "user_ip",
          "click_id",
          "job_id",
          "job_country",
          "click_country",
          "created_at",
          "bot_score",
          "is_bot"
        ],
        "properties": {
          "publisher_id": {
            "type": "string",
            "description": "Unique identifier for the publisher",
            "minLength": 1,
            "maxLength": 255,
            "example": "pub_456"
          },
          "user_ip": {
            "type": "string",
            "description": "User's IP address (IPv4 or IPv6)",
            "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$|^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$",
            "example": "192.168.1.1"
          },
          "user_agent": {
            "type": "string",
            "description": "User's browser user agent string",
            "maxLength": 1000,
            "example": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
          },
          "click_id": {
            "type": "string",
            "description": "Unique identifier for the click event",
            "minLength": 1,
            "maxLength": 255,
            "example": "click_789abc"
          },
          "job_id": {
            "type": "string",
            "description": "Identifier for the associated job",
            "minLength": 1,
            "maxLength": 255,
            "example": "job_def123"
          },
          "job_country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code for the job location",
            "pattern": "^[A-Z]{2}$",
            "minLength": 2,
            "maxLength": 2,
            "example": "US"
          },
          "click_country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code for the click origin",
            "pattern": "^[A-Z]{2}$",
            "minLength": 2,
            "maxLength": 2,
            "example": "US"
          },
          "publisher_click_id": {
            "type": "string",
            "description": "Publisher's own click identifier",
            "maxLength": 255,
            "example": "pub_click_xyz"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the click was created (ISO 8601 format)",
            "example": "2025-11-10T12:30:45Z"
          },
          "expired": {
            "type": "integer",
            "description": "Flag indicating if the click has expired (0=false, 1=true)",
            "minimum": 0,
            "maximum": 1,
            "default": 0,
            "example": 0
          },
          "expired_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp when the click expired (required if expired=1)",
            "example": null
          },
          "bot_score": {
            "type": "number",
            "format": "int",
            "nullable": true,
            "description": "Bot detection score (0 to 100, where 100 is definitely a bot)",
            "minimum": 0,
            "maximum": 100,
            "example": 15
          },
          "is_bot": {
            "type": "integer",
            "description": "Flag indicating if the click is from a bot (0=false, 1=true)",
            "minimum": 0,
            "maximum": 1,
            "example": 0
          },
          "bot_type": {
            "type": "string",
            "description": "Type of bot detected (if any)",
            "maxLength": 255,
            "example": ""
          },
          "metadata": {
            "type": "object",
            "description": "Additional metadata as JSON object",
            "additionalProperties": true,
            "example": {
              "campaign_id": "camp_001",
              "source": "google",
              "device_type": "mobile"
            }
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Click data ingested successfully"
          },
          "click_id": {
            "type": "string",
            "example": "click_789abc"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2025-11-10T12:30:45Z"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "BUSINESS_LOGIC_ERROR",
                  "INTERNAL_ERROR",
                  "SERVICE_UNAVAILABLE"
                ],
                "example": "VALIDATION_ERROR"
              },
              "message": {
                "type": "string",
                "example": "Missing required field"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "example": "publisher_id"
                    },
                    "message": {
                      "type": "string",
                      "example": "publisher_id is required"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for authentication."
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Clicks",
      "description": "Click data ingestion endpoints"
    }
  ]
}
