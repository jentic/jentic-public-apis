{"openapi":"3.1.0","info":{"title":"FanDuel API API","version":"1.0.0","description":"FanDuel Sportsbook odds API for developers. Real-time player props, moneylines, spreads, totals, alternates, futures, soccer and DFS salaries in one JSON feed, with the history of every line move. REST, webhooks and MCP. Free tier, no card."},"servers":[{"url":"https://fanduelapi.com"}],"security":[{"bearer":[]}],"paths":{"/api/v1/coverage":{"get":{"operationId":"getCoverage","summary":"What is collected right now","description":"Per league: games in the collection window, games in play, open markets and props, and the last successful read. Its meta, like every data response's, says how fresh the data is: source_status (ok, delayed, stale or down), observed_at and source_age_seconds. Costs 0 credits a call (https://fanduelapi.com/credits).","x-credits":{"per_100_rows":null,"per_call":0},"parameters":[{"name":"X-User-Request","in":"header","required":false,"description":"The current user task in one sentence. No secrets or personal data.","schema":{"type":"string","maxLength":500}},{"name":"X-Rating","in":"header","required":false,"description":"Optional. 1 to 5: how well the previous response served the task. Recorded once per prompt or per day.","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Missing or invalid key"},"404":{"description":"Not found"},"429":{"description":"Rate or monthly credit limit. The body says which plan, when it resets, one sentence to relay, and the upgrade URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"plan":{"type":"object"},"limit":{"type":"string"},"reset_at":{"type":"string","format":"date-time"},"retry_after_seconds":{"type":"integer"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"One sentence to relay to the user as is."},"upgrade_url":{"type":"string"},"upgrade_plan":{"type":["object","null"]}}}}}}}}}}},"/api/v1/props":{"get":{"operationId":"listProps","summary":"Current FanDuel player props","description":"Every FanDuel Sportsbook player prop on the board, one record per player, stat and period, with line, over and under prices in American and decimal odds, and a move summary: where it opened, where it is now and how many times it moved. With no sport, league, game or player it reads the in-season league with the most open props (meta.default_league says which); sport=all reads every league. view=compact returns the whole board in one call, up to 1,000 rows without the move summary, priced per 100 rows served. Costs 3 credits per 100 rows (https://fanduelapi.com/credits).","x-credits":{"per_100_rows":3,"per_call":null},"parameters":[{"name":"view","in":"query","required":false,"description":"compact: the whole board in one call (up to 1,000 rows, no move summary). Default full.","schema":{"type":"string","enum":["full","compact"]}},{"name":"sport","in":"query","required":false,"description":"basketball, football, hockey, baseball or soccer; or a league code such as nba, ncaaf or epl.","schema":{"type":"string"}},{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NCAAF, EPL, LALIGA, UCL or MLS.","schema":{"type":"string"}},{"name":"event_id","in":"query","required":false,"description":"One game, from /api/v1/events.","schema":{"type":"string"}},{"name":"player","in":"query","required":false,"description":"Player name, matched case-blind on any part.","schema":{"type":"string"}},{"name":"stat","in":"query","required":false,"description":"points, rebounds, assists, threes, pra and the other stats FanDuel lists.","schema":{"type":"string"}},{"name":"status","in":"query","required":false,"description":"Market status. Default: everything except removed.","schema":{"type":"string","enum":["open","suspended","closed","removed","any"]}},{"name":"updated_since","in":"query","required":false,"description":"Only props that changed after this ISO 8601 time.","schema":{"type":"string","format":"date-time"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 200. Default 50.","schema":{"type":"integer"}},{"name":"offset","in":"query","required":false,"description":"Rows to skip, for paging.","schema":{"type":"integer"}},{"name":"X-User-Request","in":"header","required":false,"description":"The current user task in one sentence. No secrets or personal data.","schema":{"type":"string","maxLength":500}},{"name":"X-Rating","in":"header","required":false,"description":"Optional. 1 to 5: how well the previous response served the task. Recorded once per prompt or per day.","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Missing or invalid key"},"404":{"description":"Not found"},"429":{"description":"Rate or monthly credit limit. The body says which plan, when it resets, one sentence to relay, and the upgrade URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"plan":{"type":"object"},"limit":{"type":"string"},"reset_at":{"type":"string","format":"date-time"},"retry_after_seconds":{"type":"integer"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"One sentence to relay to the user as is."},"upgrade_url":{"type":"string"},"upgrade_plan":{"type":["object","null"]}}}}}}}}}}},"/api/v1/props/{id}/history":{"get":{"operationId":"getPropHistory","summary":"Line and price history for one prop","description":"Every recorded state of one prop, oldest first, with its timestamp, plus the move summary. On Free it covers the last 24 hours (meta.history_window says how many older states are hidden, with the upgrade link); Developer and up see all of it. Costs 10 credits a call (https://fanduelapi.com/credits).","x-credits":{"per_100_rows":null,"per_call":10},"parameters":[{"name":"id","in":"path","required":true,"description":"Prop id from /api/v1/props.","schema":{"type":"string"}},{"name":"X-User-Request","in":"header","required":false,"description":"The current user task in one sentence. No secrets or personal data.","schema":{"type":"string","maxLength":500}},{"name":"X-Rating","in":"header","required":false,"description":"Optional. 1 to 5: how well the previous response served the task. Recorded once per prompt or per day.","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Missing or invalid key"},"404":{"description":"Not found"},"429":{"description":"Rate or monthly credit limit. The body says which plan, when it resets, one sentence to relay, and the upgrade URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"plan":{"type":"object"},"limit":{"type":"string"},"reset_at":{"type":"string","format":"date-time"},"retry_after_seconds":{"type":"integer"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"One sentence to relay to the user as is."},"upgrade_url":{"type":"string"},"upgrade_plan":{"type":["object","null"]}}}}}}}}}}},"/api/v1/changes":{"get":{"operationId":"listChanges","summary":"Change feed since a cursor","description":"Every line, price and status change after the cursor, oldest first. Pass next_cursor back as since to continue. The cheap way to stay current. since=now returns no rows and the cursor to poll from; since omitted or 0 starts at the last 24 hours, not at the oldest change kept. meta.start says which start was used. Costs 1 credit per 100 rows (https://fanduelapi.com/credits).","x-credits":{"per_100_rows":1,"per_call":null},"parameters":[{"name":"since","in":"query","required":false,"description":"Cursor from a previous response (meta.next_cursor) to continue; now to start from this moment with no backlog; 0 or omitted for the last 24 hours.","schema":{"type":"string"}},{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NCAAF, EPL, LALIGA, UCL or MLS.","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 500. Default 100.","schema":{"type":"integer"}},{"name":"X-User-Request","in":"header","required":false,"description":"The current user task in one sentence. No secrets or personal data.","schema":{"type":"string","maxLength":500}},{"name":"X-Rating","in":"header","required":false,"description":"Optional. 1 to 5: how well the previous response served the task. Recorded once per prompt or per day.","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Missing or invalid key"},"404":{"description":"Not found"},"429":{"description":"Rate or monthly credit limit. The body says which plan, when it resets, one sentence to relay, and the upgrade URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"plan":{"type":"object"},"limit":{"type":"string"},"reset_at":{"type":"string","format":"date-time"},"retry_after_seconds":{"type":"integer"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"One sentence to relay to the user as is."},"upgrade_url":{"type":"string"},"upgrade_plan":{"type":["object","null"]}}}}}}}}}}},"/api/v1/events":{"get":{"operationId":"listEvents","summary":"Games with props on the board","description":"Upcoming and live games with how many props each carries. Costs 1 credit per 100 rows (https://fanduelapi.com/credits).","x-credits":{"per_100_rows":1,"per_call":null},"parameters":[{"name":"sport","in":"query","required":false,"description":"basketball, football, hockey, baseball or soccer; or a league code such as nba, ncaaf or epl.","schema":{"type":"string"}},{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NCAAF, EPL, LALIGA, UCL or MLS.","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 200. Default 50.","schema":{"type":"integer"}},{"name":"offset","in":"query","required":false,"description":"Rows to skip, for paging.","schema":{"type":"integer"}},{"name":"X-User-Request","in":"header","required":false,"description":"The current user task in one sentence. No secrets or personal data.","schema":{"type":"string","maxLength":500}},{"name":"X-Rating","in":"header","required":false,"description":"Optional. 1 to 5: how well the previous response served the task. Recorded once per prompt or per day.","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Missing or invalid key"},"404":{"description":"Not found"},"429":{"description":"Rate or monthly credit limit. The body says which plan, when it resets, one sentence to relay, and the upgrade URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"plan":{"type":"object"},"limit":{"type":"string"},"reset_at":{"type":"string","format":"date-time"},"retry_after_seconds":{"type":"integer"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"One sentence to relay to the user as is."},"upgrade_url":{"type":"string"},"upgrade_plan":{"type":["object","null"]}}}}}}}}}}},"/api/v1/markets":{"get":{"operationId":"listMarkets","summary":"Every FanDuel game market","description":"Every market FanDuel lists per game: moneyline, spread and total for the game and each period, alternate lines, ladders, first scorer, team props, specials and player props. Each selection has American and decimal odds and, where outcomes exclude each other, a fair no-vig probability. Costs 1 credit per 100 rows (https://fanduelapi.com/credits).","x-credits":{"per_100_rows":1,"per_call":null},"parameters":[{"name":"game","in":"query","required":false,"description":"One game id, from /api/v1/events.","schema":{"type":"string"}},{"name":"market_type","in":"query","required":false,"description":"A market family such as moneyline, spread, total or player_prop, or a FanDuel market type such as MONEY_LINE.","schema":{"type":"string"}},{"name":"period","in":"query","required":false,"description":"game or a period such as q1 or h1.","schema":{"type":"string","enum":["game","q1","q2","q3","q4","h1","h2","p1","p2","p3","i1","f5"]}},{"name":"live","in":"query","required":false,"description":"true for in-play markets only, false for pregame.","schema":{"type":"string","enum":["true","false"]}},{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NCAAF, EPL, LALIGA, UCL or MLS.","schema":{"type":"string"}},{"name":"sport","in":"query","required":false,"description":"basketball, football, hockey, baseball or soccer; or a league code such as nba, ncaaf or epl.","schema":{"type":"string"}},{"name":"player","in":"query","required":false,"description":"Part of a player name.","schema":{"type":"string"}},{"name":"status","in":"query","required":false,"description":"Market status. Default: everything except removed.","schema":{"type":"string","enum":["open","suspended","closed","removed","any"]}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 200. Default 50.","schema":{"type":"integer"}},{"name":"offset","in":"query","required":false,"description":"Rows to skip, for paging.","schema":{"type":"integer"}},{"name":"X-User-Request","in":"header","required":false,"description":"The current user task in one sentence. No secrets or personal data.","schema":{"type":"string","maxLength":500}},{"name":"X-Rating","in":"header","required":false,"description":"Optional. 1 to 5: how well the previous response served the task. Recorded once per prompt or per day.","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Missing or invalid key"},"404":{"description":"Not found"},"429":{"description":"Rate or monthly credit limit. The body says which plan, when it resets, one sentence to relay, and the upgrade URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"plan":{"type":"object"},"limit":{"type":"string"},"reset_at":{"type":"string","format":"date-time"},"retry_after_seconds":{"type":"integer"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"One sentence to relay to the user as is."},"upgrade_url":{"type":"string"},"upgrade_plan":{"type":["object","null"]}}}}}}}}}}},"/api/v1/markets/{id}/history":{"get":{"operationId":"getMarketHistory","summary":"History of one game market","description":"Every recorded state of one market, oldest first, with its timestamp. On Free it covers the last 24 hours (meta.history_window); Developer and up see all of it. Costs 10 credits per 100 rows (https://fanduelapi.com/credits).","x-credits":{"per_100_rows":10,"per_call":null},"parameters":[{"name":"id","in":"path","required":true,"description":"FanDuel market id from /api/v1/markets, such as 734.195271534.","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 200. Default 50.","schema":{"type":"integer"}},{"name":"offset","in":"query","required":false,"description":"Rows to skip, for paging.","schema":{"type":"integer"}},{"name":"X-User-Request","in":"header","required":false,"description":"The current user task in one sentence. No secrets or personal data.","schema":{"type":"string","maxLength":500}},{"name":"X-Rating","in":"header","required":false,"description":"Optional. 1 to 5: how well the previous response served the task. Recorded once per prompt or per day.","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Missing or invalid key"},"404":{"description":"Not found"},"429":{"description":"Rate or monthly credit limit. The body says which plan, when it resets, one sentence to relay, and the upgrade URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"plan":{"type":"object"},"limit":{"type":"string"},"reset_at":{"type":"string","format":"date-time"},"retry_after_seconds":{"type":"integer"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"One sentence to relay to the user as is."},"upgrade_url":{"type":"string"},"upgrade_plan":{"type":["object","null"]}}}}}}}}}}},"/api/v1/games/{id}/odds":{"get":{"operationId":"getGameOdds","summary":"Every market for one game","description":"The whole FanDuel book for one game in one call, game lines first. Costs 5 credits a call (https://fanduelapi.com/credits).","x-credits":{"per_100_rows":null,"per_call":5},"parameters":[{"name":"id","in":"path","required":true,"description":"Game id from /api/v1/events.","schema":{"type":"string"}},{"name":"status","in":"query","required":false,"description":"Market status. Default: everything except removed.","schema":{"type":"string","enum":["open","suspended","closed","removed","any"]}},{"name":"X-User-Request","in":"header","required":false,"description":"The current user task in one sentence. No secrets or personal data.","schema":{"type":"string","maxLength":500}},{"name":"X-Rating","in":"header","required":false,"description":"Optional. 1 to 5: how well the previous response served the task. Recorded once per prompt or per day.","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Missing or invalid key"},"404":{"description":"Not found"},"429":{"description":"Rate or monthly credit limit. The body says which plan, when it resets, one sentence to relay, and the upgrade URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"plan":{"type":"object"},"limit":{"type":"string"},"reset_at":{"type":"string","format":"date-time"},"retry_after_seconds":{"type":"integer"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"One sentence to relay to the user as is."},"upgrade_url":{"type":"string"},"upgrade_plan":{"type":["object","null"]}}}}}}}}}}},"/api/v1/odds":{"get":{"operationId":"getOddsBoard","summary":"Odds board: every game of a league in one call","description":"Every game of a league (and optionally one US Eastern date) with its game lines in one call, instead of one /games/{id}/odds call per game. Moneyline, spread and total by default; market_type takes a comma list of families or all. changed_since returns only markets that moved after that time, so the board is its own change feed. Up to 1,000 markets, priced per 100 markets served. With no sport or league it reads the league with the most open game lines. Costs 2 credits per 100 rows (https://fanduelapi.com/credits).","x-credits":{"per_100_rows":2,"per_call":null},"parameters":[{"name":"sport","in":"query","required":false,"description":"basketball, football, hockey, baseball or soccer; or a league code such as nba, ncaaf or epl.","schema":{"type":"string"}},{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NCAAF, EPL, LALIGA, UCL or MLS.","schema":{"type":"string"}},{"name":"date","in":"query","required":false,"description":"One US Eastern calendar date, YYYY-MM-DD. Default: games from 6 hours ago through the next 7 days.","schema":{"type":"string"}},{"name":"market_type","in":"query","required":false,"description":"Comma list of families (moneyline, spread, total, team_total, alt_spread, alt_total, player_prop, ...) or all. Default moneyline,spread,total.","schema":{"type":"string"}},{"name":"period","in":"query","required":false,"description":"game (default), a period such as h1 or q1, or any.","schema":{"type":"string"}},{"name":"changed_since","in":"query","required":false,"description":"Only markets whose line, price or status changed after this ISO time, such as meta.as_of of your last call.","schema":{"type":"string","format":"date-time"}},{"name":"view","in":"query","required":false,"description":"compact (default) groups markets by game; full returns /markets rows.","schema":{"type":"string","enum":["compact","full"]}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 1000. Default 1000.","schema":{"type":"integer"}},{"name":"X-User-Request","in":"header","required":false,"description":"The current user task in one sentence. No secrets or personal data.","schema":{"type":"string","maxLength":500}},{"name":"X-Rating","in":"header","required":false,"description":"Optional. 1 to 5: how well the previous response served the task. Recorded once per prompt or per day.","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Missing or invalid key"},"404":{"description":"Not found"},"429":{"description":"Rate or monthly credit limit. The body says which plan, when it resets, one sentence to relay, and the upgrade URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"plan":{"type":"object"},"limit":{"type":"string"},"reset_at":{"type":"string","format":"date-time"},"retry_after_seconds":{"type":"integer"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"One sentence to relay to the user as is."},"upgrade_url":{"type":"string"},"upgrade_plan":{"type":["object","null"]}}}}}}}}}}},"/api/v1/compare":{"get":{"operationId":"comparePropLines","summary":"FanDuel against its own ladder, Novig, DraftKings and PrizePicks","description":"Each main over/under player prop next to the alternate lines FanDuel lists for the same player, stat and game (the main line's no-vig fair probability, each rung's implied probability, and matched_price where a rung is the same outcome as the main over), plus books: the same market at Novig (fair_over and fair_under, the no-vig mid of its order book), DraftKings (prices) and PrizePicks (the line), with same_line false where that venue's nearest line differs, fanduel_ev_pct against the Novig fair price and the better sportsbook price per side. ladder=only keeps rows with a ladder; books=only keeps rows another venue lists. view=books lists every compared FanDuel market, game lines included. Free reads the other venues five minutes behind. Priced per 100 rows served. Costs 3 credits per 100 rows (https://fanduelapi.com/credits).","x-credits":{"per_100_rows":3,"per_call":null},"parameters":[{"name":"view","in":"query","required":false,"description":"books: every compared FanDuel market, game lines included.","schema":{"type":"string","enum":["default","books"]}},{"name":"sport","in":"query","required":false,"description":"basketball, football, hockey, baseball or soccer; or a league code such as nba, ncaaf or epl.","schema":{"type":"string"}},{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NCAAF, EPL, LALIGA, UCL or MLS.","schema":{"type":"string"}},{"name":"event_id","in":"query","required":false,"description":"One game.","schema":{"type":"string"}},{"name":"player","in":"query","required":false,"description":"Player name.","schema":{"type":"string"}},{"name":"stat","in":"query","required":false,"description":"Stat such as receiving_yards.","schema":{"type":"string"}},{"name":"ladder","in":"query","required":false,"description":"only: rows that have an alternate ladder.","schema":{"type":"string","enum":["only","any"]}},{"name":"books","in":"query","required":false,"description":"only: rows another venue lists.","schema":{"type":"string","enum":["only","any"]}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 200. Default 50.","schema":{"type":"integer"}},{"name":"offset","in":"query","required":false,"description":"Rows to skip, for paging.","schema":{"type":"integer"}},{"name":"X-User-Request","in":"header","required":false,"description":"The current user task in one sentence. No secrets or personal data.","schema":{"type":"string","maxLength":500}},{"name":"X-Rating","in":"header","required":false,"description":"Optional. 1 to 5: how well the previous response served the task. Recorded once per prompt or per day.","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Missing or invalid key"},"404":{"description":"Not found"},"429":{"description":"Rate or monthly credit limit. The body says which plan, when it resets, one sentence to relay, and the upgrade URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"plan":{"type":"object"},"limit":{"type":"string"},"reset_at":{"type":"string","format":"date-time"},"retry_after_seconds":{"type":"integer"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"One sentence to relay to the user as is."},"upgrade_url":{"type":"string"},"upgrade_plan":{"type":["object","null"]}}}}}}}}}}},"/api/v1/ev":{"get":{"operationId":"listPositiveEv","summary":"+EV FanDuel prices against the Novig fair price","description":"FanDuel prices that pay more than the fair chance, measured against the Novig exchange's no-vig price (the mid of its two-sided order book) for the same side and line: ev_pct = (fair_probability x book_decimal - 1) x 100, edge_cents, kelly_full and kelly_quarter, main_line and confidence. Default view: fair probability at least 15%, main lines only, high confidence, best EV first. books=fanduel,draftkings adds DraftKings. Free reads the top 10 rows five minutes behind; paid plans read it live, refreshed every minute. Priced per 100 rows served. Costs 3 credits per 100 rows (https://fanduelapi.com/credits).","x-credits":{"per_100_rows":3,"per_call":null},"parameters":[{"name":"league","in":"query","required":false,"description":"League code, such as NBA, NCAAF, EPL, LALIGA, UCL or MLS.","schema":{"type":"string"}},{"name":"market_type","in":"query","required":false,"description":"One market type.","schema":{"type":"string","enum":["moneyline","spread","total","player_prop"]}},{"name":"player","in":"query","required":false,"description":"Player name or part of it.","schema":{"type":"string"}},{"name":"event_id","in":"query","required":false,"description":"One FanDuel game.","schema":{"type":"string"}},{"name":"books","in":"query","required":false,"description":"Comma list: fanduel (default), draftkings.","schema":{"type":"string"}},{"name":"min_edge","in":"query","required":false,"description":"Minimum EV in percent, -3 to 100.","schema":{"type":"string"}},{"name":"min_prob","in":"query","required":false,"description":"Minimum fair probability in percent. Default 15.","schema":{"type":"string"}},{"name":"alt_lines","in":"query","required":false,"description":"true adds alternate lines.","schema":{"type":"string","enum":["true","false"]}},{"name":"confidence","in":"query","required":false,"description":"Default high.","schema":{"type":"string","enum":["high","any"]}},{"name":"sort","in":"query","required":false,"description":"Default ev.","schema":{"type":"string","enum":["ev","edge_cents","kelly"]}},{"name":"limit","in":"query","required":false,"description":"Rows per page, 1 to 200. Default 50.","schema":{"type":"integer"}},{"name":"offset","in":"query","required":false,"description":"Rows to skip, for paging.","schema":{"type":"integer"}},{"name":"X-User-Request","in":"header","required":false,"description":"The current user task in one sentence. No secrets or personal data.","schema":{"type":"string","maxLength":500}},{"name":"X-Rating","in":"header","required":false,"description":"Optional. 1 to 5: how well the previous response served the task. Recorded once per prompt or per day.","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Missing or invalid key"},"404":{"description":"Not found"},"429":{"description":"Rate or monthly credit limit. The body says which plan, when it resets, one sentence to relay, and the upgrade URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"plan":{"type":"object"},"limit":{"type":"string"},"reset_at":{"type":"string","format":"date-time"},"retry_after_seconds":{"type":"integer"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"One sentence to relay to the user 