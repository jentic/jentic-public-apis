e":"league","in":"query","required":false,"description":"League code, such as NBA, NCAAF, EPL, LALIGA, UCL or MLS.","schema":{"type":"string"}},{"name":"player","in":"query","required":false,"description":"Player id.","schema":{"type":"string"}},{"name":"stat","in":"query","required":false,"description":"Stat.","schema":{"type":"string"}},{"name":"games","in":"query","required":false,"description":"Last N graded games.","schema":{"type":"integer"}},{"name":"X-User-Request","in":"header","required":false,"description":"The current user task in one sentence. No secrets or personal data.","schema":{"type":"string","maxLength":500}},{"name":"X-Rating","in":"header","required":false,"description":"Optional. 1 to 5: how well the previous response served the task. Recorded once per prompt or per day.","schema":{"type":"integer","minimum":1,"maximum":5}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Missing or invalid key"},"402":{"description":"UPGRADE_REQUIRED: the plan does not include this. error.message and error.upgrade_url carry a one-click checkout link (X-Upgrade-Url too), error.sample a few labelled rows, error.user_message one sentence to relay. Costs no credits."},"404":{"description":"Not found"},"429":{"description":"Rate or monthly credit limit. The body says which plan, when it resets, one sentence to relay, and the upgrade URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","enum":["RATE_LIMITED","QUOTA_EXCEEDED"]},"message":{"type":"string"},"plan":{"type":"object"},"limit":{"type":"string"},"reset_at":{"type":"string","format":"date-time"},"retry_after_seconds":{"type":"integer"},"notify_user":{"type":"boolean"},"user_message":{"type":"string","description":"One sentence to relay to the user as is."},"upgrade_url":{"type":"string"},"upgrade_plan":{"type":["object","null"]}}}}}}}}}}},"/api/v1/watches":{"get":{"operationId":"listWatches","summary":"List Watches","description":"A player prop you track, with the line or price move that should alert you.","parameters":[{"name":"limit","in":"query","schema":{"type":"integer","maximum":200}},{"name":"offset","in":"query","schema":{"type":"integer"}}],"responses":{"200":{"description":"OK"},"401":{"description":"Invalid key"},"429":{"description":"Rate or quota limit"}}},"post":{"operationId":"createWatch","summary":"Create a Watch","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Watch"}}}},"responses":{"201":{"description":"Created"},"402":{"description":"Record limit"},"422":{"description":"Invalid"}}}},"/api/v1/watches/{id}":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"getWatch","summary":"Read a Watch","responses":{"200":{"description":"OK"},"404":{"description":"Not found"}}},"patch":{"operationId":"updateWatch","summary":"Update a Watch","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Watch"}}}},"responses":{"200":{"description":"OK"},"404":{"description":"Not found"}}},"delete":{"operationId":"deleteWatch","summary":"Delete a Watch","responses":{"204":{"description":"Deleted"},"404":{"description":"Not found"}}}},"/api/v1/onboarding":{"get":{"operationId":"getOnboardingQuestions","summary":"Setup questions to answer for your user","description":"The onboarding questions that finish setting up an account, with ids and options. No key needed; with a key the reply also carries the answers already given. Costs no quota.","security":[],"responses":{"201":{"description":"Received"},"422":{"description":"Invalid"}}},"post":{"operationId":"answerOnboarding","summary":"Answer the setup questions for your user","description":"Stores the answers as the onboarding form does, marked as answered by an agent; the person sees them on the dashboard and can edit them. Idempotent, costs no quota, up to 20 a minute.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["answers"],"properties":{"answers":{"type":"object","required":["use_case","sports"],"properties":{"use_case":{"type":"string","enum":["Prop model","Odds screen","Betting agent","Research","Other"],"description":"What are you building?"},"sports":{"type":"string","description":"Which sports matter most?"}}},"client":{"type":"string","description":"Name of the agent or client, such as Claude Code."}}}}}},"responses":{"201":{"description":"Received"},"422":{"description":"Invalid"}}}},"/api/v1/stream":{"get":{"operationId":"streamChanges","summary":"Stream changes (Server-Sent Events)","description":"Events: hello, change (id = cursor), checkpoint (id = how far the feed was read), gap (resume older than the retained feed), reconnect. Resume with the Last-Event-ID header. Free is delayed 300 s. Concurrent connections are capped per plan.","parameters":[{"name":"since","in":"query","required":false,"description":"Cursor to resume after, if Last-Event-ID cannot be sent.","schema":{"type":"string"}},{"name":"league","in":"query","required":false,"description":"Comma list, e.g. NBA,NFL.","schema":{"type":"string"}},{"name":"kinds","in":"query","required":false,"description":"Comma list of new, line_move, price_move, status_change, removed.","schema":{"type":"string"}}],"responses":{"200":{"description":"text/event-stream"},"400":{"description":"Invalid cursor or filter"},"401":{"description":"Invalid key"},"402":{"description":"Plan or full archive required"},"429":{"description":"Rate or quota limit"}}}},"/api/v1/export":{"get":{"operationId":"getExport","summary":"Export props or history for a date range","description":"CSV or NDJSON, streamed, paged by cursor while X-Has-More is true. Developer and up. X-Rows, X-Next-Cursor, X-Archive-Rows-Spent and X-Archive-Rows-Remaining are provisional: they are set before the body streams and describe the page as planned. Archive rows are charged as the body is read. If the archive balance is spent elsewhere or revoked during the download, the body ends early with one error line instead of the remaining rows: in CSV the last line is '#error,<code>,next_cursor=<cursor>'; in NDJSON the last line is {\"error\":{\"code\":...,\"message\":...,\"next_cursor\":...}}. Clients must not parse the error line as data. Page on from the error line's next_cursor when one is present, otherwise from X-Next-Cursor.","parameters":[{"name":"kind","in":"query","required":false,"description":"history (default) or props.","schema":{"type":"string"}},{"name":"format","in":"query","required":false,"description":"csv (default) or ndjson.","schema":{"type":"string"}},{"name":"from","in":"query","required":true,"description":"Start, inclusive. ISO 8601 date or time.","schema":{"type":"string"}},{"name":"to","in":"query","required":true,"description":"End, exclusive. At most 366 days after from.","schema":{"type":"string"}},{"name":"cursor","in":"query","required":false,"description":"X-Next-Cursor from the previous page.","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, up to 10000.","schema":{"type":"integer","maximum":10000}},{"name":"league","in":"query","required":false,"description":"League code.","schema":{"type":"string"}},{"name":"sport","in":"query","required":false,"description":"Sport.","schema":{"type":"string"}},{"name":"event_id","in":"query","required":false,"description":"One game.","schema":{"type":"string"}}],"responses":{"200":{"description":"text/csv or application/x-ndjson"},"400":{"description":"Invalid query"},"401":{"description":"Invalid key"},"402":{"description":"Plan or full archive required"},"429":{"description":"Rate or quota limit"}}}},"/api/v1/training-set":{"get":{"operationId":"getTrainingSet","summary":"Training set: open line, closing line and moves per prop","description":"One row per prop whose game started in the range. Closing line is the one /results grades against: the last open or suspended line strictly before the game started (FanDuel's start, or the first read with the game in play if earlier). meta.graded is false until results are graded.","parameters":[{"name":"from","in":"query","required":true,"description":"Start, inclusive. ISO 8601 date or time.","schema":{"type":"string"}},{"name":"to","in":"query","required":true,"description":"End, exclusive. At most 366 days after from.","schema":{"type":"string"}},{"name":"format","in":"query","required":false,"description":"json (default), csv or ndjson.","schema":{"type":"string"}},{"name":"cursor","in":"query","required":false,"description":"meta.next_cursor from the previous page.","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Rows per page, up to 5000.","schema":{"type":"integer","maximum":5000}},{"name":"league","in":"query","required":false,"description":"League code.","schema":{"type":"string"}},{"name":"sport","in":"query","required":false,"description":"Sport.","schema":{"type":"string"}},{"name":"stat","in":"query","required":false,"description":"Stat.","schema":{"type":"string"}}],"responses":{"200":{"description":"OK"},"400":{"description":"Invalid query"},"401":{"description":"Invalid key"},"402":{"description":"Plan or full archive required"},"429":{"description":"Rate or quota limit"}}}},"/api/v1/credit-costs":{"get":{"operationId":"getCreditCosts","summary":"What each call costs in credits","description":"The credits table every plan is charged from: credits per 100 rows per endpoint, default and largest page, and the plans' monthly credits. With path=, a quote for one call (an API path and its query, URL-encoded). No key, no credits.","parameters":[{"name":"path","in":"query","required":false,"description":"An API path and query to quote, such as /api/v1/props?limit=200.","schema":{"type":"string"}}],"security":[],"responses":{"201":{"description":"Received"},"422":{"description":"Invalid"}}}},"/api/v1/webhooks":{"get":{"operationId":"listWebhooks","summary":"List webhook endpoints","responses":{"200":{"description":"OK"},"401":{"description":"Invalid key"}}},"post":{"operationId":"createWebhook","summary":"Register a webhook endpoint","description":"Plans that include webhooks. Up to five HTTPS endpoints on public addresses. The signing secret is returned once. Deliveries are signed X-Webhook-Signature: t=<unix>,v1=<HMAC-SHA256 of t.body>.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["url"],"properties":{"url":{"type":"string","format":"uri"},"description":{"type":"string","maxLength":120},"kinds":{"type":"array","items":{"type":"string"}},"leagues":{"type":"array","items":{"type":"string"}}}}}}},"responses":{"201":{"description":"Created, with secret"},"402":{"description":"Plan does not include webhooks"},"409":{"description":"Five endpoints already"},"422":{"description":"URL refused"}}}},"/api/v1/webhooks/{id}":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"delete":{"operationId":"deleteWebhook","summary":"Delete a webhook endpoint","responses":{"204":{"description":"Deleted"},"404":{"description":"Not found"}}}},"/api/v1/webhooks/{id}/deliveries":{"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"get":{"operationId":"listWebhookDeliveries","summary":"Delivery log of an endpoint","parameters":[{"name":"before","in":"query","required":false,"description":"Delivery id to page back from.","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Up to 200.","schema":{"type":"integer","maximum":200}}],"responses":{"200":{"description":"OK"}}}},"/api/v1/agent/signup":{"post":{"operationId":"startAgentSignup","summary":"Start a Free account for a person, from an agent","description":"Sends the person a verification email. When they approve it in the browser, the agent collects a Free key from /api/v1/agent/token. Rate limited per IP and per email; disposable addresses are refused.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["email","use_case"],"properties":{"email":{"type":"string","format":"email","description":"The person's own email address. Ask them; never invent one."},"use_case":{"type":"string","description":"What they are building, in their words or one of the onboarding options."},"sports":{"type":"string","description":"Which sports matter most."},"agent":{"type":"string","description":"Name of the agent or client making the request."}}}}}},"security":[],"responses":{"202":{"description":"Verification email sent; poll the token endpoint"},"422":{"description":"Invalid or disposable email, or missing use_case"},"429":{"description":"Too many signups for this network or email"},"503":{"description":"Signup unavailable"}}}},"/api/v1/agent/token":{"post":{"operationId":"finishAgentSignup","summary":"Collect the key once the person approves","description":"Poll every interval seconds with the device_code from the signup call. Returns the key exactly once after approval.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["device_code"],"properties":{"device_code":{"type":"string","description":"device_code from /api/v1/agent/signup."}}}}}},"security":[],"responses":{"200":{"description":"The key, shown once"},"400":{"description":"authorization_pending, slow_down or expired_token"},"404":{"description":"Unknown device_code"},"410":{"description":"Already collected"}}}},"/api/v1/feedback":{"post":{"operationId":"sendFeedback","summary":"Tell the team what is missing","description":"Needs no key and costs no quota. A valid key attributes it.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["kind","message"],"properties":{"kind":{"type":"string","enum":["missing_feature","missing_data","bug","other"]},"message":{"type":"string"},"contact":{"type":"string"}}}}}},"security":[],"responses":{"201":{"description":"Received"},"422":{"description":"Invalid"}}}},"/api/v1/billing/cancel":{"get":{"operationId":"getSubscription","summary":"Subscription status and cancel reasons","description":"The account's subscription and the reasons a cancellation accepts. Costs no quota.","responses":{"200":{"description":"OK"},"401":{"description":"Invalid key"}}},"post":{"operationId":"cancelSubscription","summary":"Cancel the subscription at the end of the paid period","description":"Only when your user asks. A reason is required: ask your user why and never pick one for them. Costs no quota.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["reason"],"properties":{"reason":{"type":"string","enum":["got_what_i_needed","too_expensive","missing_data","reliability","not_using","switched","other"],"description":"got_what_i_needed: I got the data I needed; too_expensive: Too expensive; missing_data: Missing data or features I need; reliability: Errors or slow responses; not_using: Not using it enough; switched: Switched to another service; other: Something else"},"comment":{"type":"string","maxLength":500,"description":"Your user's own words. Required when reason is other."}}}}}},"responses":{"200":{"description":"Scheduled to cancel at period end"},"400":{"description":"CANCEL_REASON_REQUIRED: the reply lists the valid reasons"},"401":{"description":"Invalid key"},"404":{"description":"No active subscription"},"503":{"description":"Billing unavailable, nothing changed"}}},"delete":{"operationId":"keepSubscription","summary":"Keep the subscription (undo a scheduled cancel)","description":"Costs no quota.","responses":{"200":{"description":"Kept"},"401":{"description":"Invalid key"},"404":{"description":"No subscription"}}}}},"components":{"schemas":{"Watch":{"type":"object","additionalProperties":false,"required":["player","stat"],"properties":{"player":{"type":"string","description":"Player name as FanDuel lists it"},"stat":{"type":"string","enum":["points","rebounds","assists","threes","pra","other"],"description":"Which prop market"},"line":{"type":"number","description":"Line you want to be told about"},"note":{"type":"string","description":"Why you are watching it"}}}},"securitySchemes":{"bearer":{"type":"http","scheme":"bearer"}}}}