le when the later of verified_at and last_checked_at is more than 7 days before the response date."},"credited_date":"2026-10-01","amount_usd":150,"tax_info_verified":null,"meets_minimum":true,"shortfall_usd":0,"cash_out_minimum_usd":100,"steps":[{"order":1,"id":"credited","label":"FACT","title":"Reward credited","summary":"This date is the day the reward appeared in All Activity. Snap starts the pending clock then.","rule_id":"payouts.pending_to_available_days","rule_version":1,"source_url":"https://help.snapchat.com/hc/en-us/articles/7012324940948-How-do-I-set-up-my-Payout-Portal-and-cash-out-my-Creator-Rewards-on-Snapchat","verified_at":"2026-09-26","earliest_date":"2026-10-01","latest_date":"2026-10-01","range":false,"timing":"dated","formula":null,"duration_earliest_days":null,"duration_latest_days":null,"related_rule_ids":[]},{"order":2,"id":"available","label":"CALCULATION","title":"Pending becomes Available","summary":"Snap says rewards take 14 days to move from Pending to Available. Earliest and latest are the same day.","rule_id":"payouts.pending_to_available_days","rule_version":1,"source_url":"https://help.snapchat.com/hc/en-us/articles/7012324940948-How-do-I-set-up-my-Payout-Portal-and-cash-out-my-Creator-Rewards-on-Snapchat","verified_at":"2026-09-26","earliest_date":"2026-10-15","latest_date":"2026-10-15","range":false,"timing":"dated","formula":"2026-10-01 + 14 days (payouts.pending_to_available_days)","duration_earliest_days":14,"duration_latest_days":14,"related_rule_ids":[]},{"order":3,"id":"cash_out","label":"CALCULATION","title":"Cash-out","summary":"$150 USD meets the cash-out minimum of $100 USD. You can cash out as early as the day the balance is available. Snap does not publish a last day.","rule_id":"payouts.cash_out_min_usd","rule_version":1,"source_url":"https://help.snapchat.com/hc/en-us/articles/14669003687444-About-Snapchat-s-Monetization-Program","verified_at":"2026-09-26","earliest_date":"2026-10-15","latest_date":null,"range":true,"timing":"conditional","formula":"2026-10-15 if the available balance meets payouts.cash_out_min_usd","duration_earliest_days":null,"duration_latest_days":null,"related_rule_ids":[]},{"order":4,"id":"tax_verification","label":"FACT","title":"Taxpayer verification","summary":"Tax status was not supplied. Snap says taxpayer verification can take up to 14 days. Later dates assume verification is already finished.","rule_id":"tax.taxpayer_verification_days_max","rule_version":1,"source_url":"https://help.snapchat.com/hc/en-us/articles/7012324940948-How-do-I-set-up-my-Payout-Portal-and-cash-out-my-Creator-Rewards-on-Snapchat","verified_at":"2026-09-26","earliest_date":null,"latest_date":null,"range":true,"timing":"conditional","formula":null,"duration_earliest_days":null,"duration_latest_days":14,"related_rule_ids":["tax.forms_w9_w8"]},{"order":5,"id":"payout_portal","label":"CALCULATION","title":"Snapchat Payout Portal","summary":"After you cash out, Snap says it typically takes 14 days or longer for cash to reach the Snapchat Payout Portal (Hyperwallet). The earliest date assumes you cash out on the first day you can. There is no latest date.","rule_id":"payouts.cash_out_to_portal_days","rule_version":1,"source_url":"https://help.snapchat.com/hc/en-us/articles/7012324940948-How-do-I-set-up-my-Payout-Portal-and-cash-out-my-Creator-Rewards-on-Snapchat","verified_at":"2026-09-26","earliest_date":"2026-10-29","latest_date":null,"range":true,"timing":"conditional","formula":"2026-10-15 + 14 days (payouts.cash_out_to_portal_days)","duration_earliest_days":14,"duration_latest_days":null,"related_rule_ids":["payouts.provider_hyperwallet"]}],"facts":[{"label":"FACT","rule_id":"payouts.pending_to_available_days","version":1,"program":"payouts","claim":"Creator Rewards take 14 days from appearing in 'All Activity' to move from Pending to Available.","value":14,"unit":"days","metric":null,"operator":null,"window_days":null,"rule_type":"payout_term","status":"current","source_url":"