n"],"notes":"Entry (invitation) criterion from the same help-page edit as the 15,000-hour view-time rule. Changed between Feb 16 and Feb 17, 2026 (archived captures of Snap's help page; not announced by Snap). Distinct from the 100-hour ongoing threshold for already-enrolled creators (ump.ongoing_spotlight_view_time_hours_28d_max_rewards)."}],"recommendations":[{"label":"RECOMMENDATION","order":1,"objective":"Raise 28-day Spotlight view time","reason":"Spotlight view time is the binding constraint at 40% of the 3,000-hour entry criterion.","linked_rule_id":"ump.spotlight_view_time_hours_28d_min","measurable_target":{"metric":"spotlight_view_time_hours_28d","value":3000,"unit":"hours","by_date":"2026-12-30"},"assumptions":["Criteria on the official help page as verified 2026-09-27 remain unchanged."],"risks":["Meeting the published criteria does not guarantee an invitation; invitation is at Snap's discretion."],"realism_note":null}]}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/components/responses/Unauthorized"},"402":{"$ref":"#/components/responses/PaymentRequired"},"405":{"$ref":"#/components/responses/Error"},"413":{"$ref":"#/components/responses/Error"},"422":{"$ref":"#/components/responses/Error"},"429":{"$ref":"#/components/responses/RateLimited"},"500":{"$ref":"#/components/responses/Error"},"503":{"$ref":"#/components/responses/Error"}}}},"/v1/tools/calculate_payout_timeline":{"post":{"tags":["calculations"],"operationId":"calculate_payout_timeline","summary":"Date-by-date payout timeline from a credited date, using published payout and tax rules. An estimate, not a promise.","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/calculate_payout_timeline.input.schema"}}}},"responses":{"200":{"description":"Payout timeline calculation.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLi