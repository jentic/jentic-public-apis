rsed by, or sponsored by Snap Inc. Snapchat is a trademark of Snap Inc."},"DateTime":{"type":"string","format":"date-time"},"Date":{"type":"string","format":"date"},"RuleId":{"type":"string","pattern":"^[a-z0-9_]+(\\.[a-z0-9_]+)+$","maxLength":120},"Source":{"type":"object","additionalProperties":false,"required":["url","publisher","verified_at","supports_rule_ids"],"properties":{"url":{"type":"string","format":"uri"},"publisher":{"type":"string"},"title":{"type":["string","null"]},"verified_at":{"$ref":"#/components/schemas/Date"},"last_checked_at":{"description":"ISO-8601 timestamp of the latest automated check that found this source's official text unchanged. Omitted when no such check is recorded. Does not replace verified_at.","type":"string","format":"date-time"},"supports_rule_ids":{"type":"array","items":{"$ref":"#/components/schemas/RuleId"}}}},"DataFreshness":{"type":"object","additionalProperties":false,"required":["rules_db_version","generated_at","oldest_verified_at","newest_verified_at","stale_rule_ids","policy"],"properties":{"rules_db_version":{"description":"Monotonic version of the published rules set. Pattern YYYY-MM-DD.n","type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"},"generated_at":{"$ref":"#/components/schemas/DateTime"},"oldest_verified_at":{"type":["string","null"],"format":"date"},"newest_verified_at":{"type":["string","null"],"format":"date"},"oldest_last_checked_at":{"description":"Earliest last_checked_at among rules in this response. Omitted when none of those rules have an unchanged-source check. Does not replace oldest_verified_at.","type":"string","format":"date-time"},"newest_last_checked_at":{"description":"Latest last_checked_at among rules in this response. Omitted when none of those rules have an unchanged-source check. Does not replace newest_verified_at.","type":"string","format":"date-time"},"stale_rule_ids":{"description":"Rules in this response whose later of verified_at and last_checked_at is older than the staleness window stated in `policy`. A missing last_checked_at does not count.","type":"array","items":{"$ref":"#/components/schemas/RuleId"}},"policy":{"type":"string","description":"Human-readable freshness policy, e.g. 'Sources are re-checked daily; a rule is listed as stale when the later of verified_at and last_checked_at is more than 7 days before the response date.'"}}},"Envelope":{"description":"Fields present in every successful tool output.","type":"object","required":["tool","api_version","notice","generated_at","sources","data_freshness"],"properties":{"tool":{"type":"string"},"api_version":{"const":"v1"},"notice":{"$ref":"#/components/schemas/Notice"},"generated_at":{"$ref":"#/components/schemas/DateTime"},"sources":{"type":"array","items":{"$ref":"#/components/schemas/Source"}},"data_freshness":{"$ref":"#/components/schemas/DataFreshness"},"warnings":{"description":"Plain strings. Omitted when empty. Calculation tools add a string when followers is 0 and view_time_hours_28d or spotlight_view_time_hours_28d is above 0, and when view_time_hours_28d exceeds 28 days × 24 hours × followers × 0.5. Those warnings say the figure is unusually high for your follower count, please check for a typo, and that view time can come from non-followers. They are never an error. FACT GET aliases append ignored query parameter notices to this same array. Spotlight hours above total view hours are HTTP 400 VALUE_INCONSISTENT rather than a warning.","type":"array","items":{"type":"string"}}}},"ProgramSlug":{"description":"Program identifier. Validated at runtime against programs present in the rules database; unknown values return UNKNOWN_PROGRAM. Examples: unified_monetization_program, snap_star, creator_subscriptions, brand_partnerships, payouts, tax, recommendation_eligibility, creator_monetization_policy, public_profile, lens_creator_rewards.","type":"string","pattern":"^[a-z0-9_]{2,64}$"},"EffectiveDateNote":{"description":"Present when effective_date is null because Snap did not publish a date. effective_date stays null.","const":"not published by Snap"},"IsoCountry":{"type":"object","additionalProperties":false,"required":["snap_name","alpha2","alpha3","numeric"],"properties":{"snap_name":{"type":"string"},"alpha2":{"type":"string"},"alpha3":{"type":"string"},"numeric":{"type":"string"}}},"RuleFact":{"description":"FACT: a rule record as stored in the versioned rules database (approved records only).","type":"object","additionalProperties":false,"required":["label","rule_id","version","program","claim","value","unit","status","source_url","publisher","verified_at","effective_date","requires_user_confirmation","applies_to","requirement_phase","mvp_scope","notes"],"properties":{"label":{"const":"FACT"},"rule_id":{"$ref":"#/components/schemas/RuleId"},"version":{"type":"integer","minimum":1},"program":{"$ref":"#/components/schemas/ProgramSlug"},"claim":{"type":"string"},"value":{"anyOf":[{"type":["number","string","boolean","null"]},{"type":"array","items":{"type":"string"}}]},"unit":{"type":"string"},"metric":{"type":["string","null"]},"operator":{"type":["string","null"],"enum":["gte","gt","lte","lt","eq","in","is_true",null]},"window_days":{"type":["integer","null"]},"rule_type":{"description":"Role of the rule, copied from the rules database. Omitted by older clients. Used to group answer pages.","type":["string","null"],"enum":["eligibility_threshold","eligibility_condition","ongoing_condition","payout_term","tax_term","content_policy","program_fact","program_status","supplementary_note",null]},"status":{"type":"string","enum":["current","historical","unverified"]},"source_url":{"type":"string","format":"uri"},"publisher":{"type":"string"},"verified_at":{"$ref":"#/components/schemas/Date"},"last_checked_at":{"description":"ISO-8601 timestamp of the latest automated check that found this rule's official source text unchanged. Omitted when no such check is recorded. Does not replace verified_at and is not a rule value.","type":"string","format":"date-time"},"effective_date":{"type":["string","null"],"format":"date"},"effective_date_note":{"$ref":"#/components/schemas/EffectiveDateNote"},"changed_after":{"description":"Inclusive start of an observed change window when the source does not state a single effective_date. Null when unknown. Additive.","type":["string","null"],"format":"date"},"changed_before":{"description":"Inclusive end of an observed change window when the source does not state a single effective_date. Null when unknown. Additive.","type":["string","null"],"format":"date"},"date_note":{"description":"How changed_after and changed_before were established. Null when there is no window note. Not a substitute for source_url.","type":["string","null"]},"iso_countries":{"description":"ISO 3166-1 codes for each name in a country list, from the reviewed country map. Omitted unless this fact is a country list.","type":"array","items":{"$ref":"#/components/schemas/IsoCountry"}},"requires_user_confirmation":{"type":"boolean"},"supersedes":{"type":["string","null"]},"applies_to":{"type":"string","enum":["entry","enrolled_creators","all","not_applicable"]},"requirement_phase":{"type":"string","enum":["entry","ongoing","entry_and_ongoing","not_applicable"]},"mvp_scope":{"type":"string","enum":["in_scope","out_of_scope"]},"related_rule_ids":{"type":"array","items":{"type":"string"}},"notes":{"type":"string"}}},"CatalogScope":{"type":"object","additionalProperties":false,"description":"Counts computed from the approved rules database for one as-of date. mvp_in_force is the default requirements list. in_force_including_out_of_scope adds programs stored as out of scope. mvp_including_historical is every in-scope record, which is what the rule-change log lists.","required":["mvp_in_force","in_force_including_out_of_scope","mvp_including_historical","approved_total","out_of_scope_programs","summary"],"properties":{"mvp_in_force":{"type":"integer","minimum":0},"in_force_including_out_of_scope":{"type":"integer","minimum":0},"mvp_including_historical":{"type":"integer","minimum":0},"approved_total":{"type":"integer","minimum":0},"out_of_scope_programs":{"type":"array","items":{"type":"string"}},"summary":{"type":"string"}}},"get_monetization_requirements.output.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/get_monetization_requirements.output.schema.json","title":"get_monetization_requirements output","type":"object","additionalProperties":false,"allOf":[{"$ref":"#/components/schemas/Envelope"}],"required":["tool","api_version","notice","generated_at","sources","data_freshness","programs","facts"],"properties":{"tool":{"const":"get_monetization_requirements"},"api_version":{"const":"v1"},"notice":{"$ref":"#/components/schemas/Notice"},"generated_at":{"$ref":"#/components/schemas/DateTime"},"sources":{"type":"array","items":{"$ref":"#/components/schemas/Source"}},"data_freshness":{"$ref":"#/components/schemas/DataFreshness"},"warnings":{"description":"Plain strings. Omitted when empty. Calculation tools add a string when followers is 0 and view_time_hours_28d or spotlight_view_time_hours_28d is above 0, and when view_time_hours_28d exceeds 28 days × 24 hours × followers × 0.5. Those warnings say the figure is unusually high for your follower count, please check for a typo, and that view time can come from non-followers. They are never an error. FACT GET aliases append ignored query parameter notices to this same array. Spotlight hours above total view hours are HTTP 400 VALUE_INCONSISTENT rather than a warning.","type":"array","items":{"type":"string"}},"query":{"type":"object","description":"Echo of the effective filters.","additionalProperties":true},"programs":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["program","program_status","rule_ids"],"properties":{"program":{"$ref":"#/components/schemas/ProgramSlug"},"program_status":{"type":"string","enum":["active","historical","unknown"]},"rule_ids":{"type":"array","items":{"$ref":"#/components/schemas/RuleId"}}}}},"facts":{"type":"array","items":{"$ref":"#/components/schemas/RuleFact"}},"direct_answer":{"type":"string","description":"Answer-first lead built from entry-requirement facts included in this response. Omitted when those facts are absent."},"direct_answer_note":{"type":"string","description":"Optional sentence after the lead for unverified entry facts left out of it. Omitted when there are none."},"catalog_scope":{"$ref":"#/components/schemas/CatalogScope"},"country_eligibility":{"type":["array","null"],"items":{"type":"object","additionalProperties":false,"required":["program","country","listed","rule_id"],"properties":{"program":{"$ref":"#/components/schemas/ProgramSlug"},"country":{"type":"string"},"listed":{"type":["boolean","null"]},"rule_id":{"$ref":"#/components/schemas/RuleId"}}}}}},"error.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/error.schema.json","title":"Error response (all tools, REST and MCP)","type":"object","additionalProperties":false,"required":["error","notice"],"properties":{"notice":{"$ref":"#/components/schemas/Notice"},"error":{"type":"object","additionalProperties":false,"required":["code","message","fix","docs_url","request_id"],"properties":{"code":{"type":"string","enum":["INVALID_INPUT","PROGRAM_OUT_OF_SCOPE","MISSING_REQUIRED_FIELD","UNKNOWN_FIELD","VALUE_OUT_OF_RANGE","VALUE_INCONSISTENT","UNKNOWN_PROGRAM","UNKNOWN_METRIC","UNKNOWN_RULE_ID","INVALID_DATE","DATE_RANGE_INVALID","PAYLOAD_TOO_LARGE","RATE_LIMITED","INVALID_API_KEY","TURNSTILE_FAILED","NO_RULES_AVAILABLE","UNSUPPORTED_API_VERSION","NOT_FOUND","METHOD_NOT_ALLOWED","INTERNAL_ERROR","SERVICE_UNAVAILABLE","CONFLICT","PAYMENT_REQUIRED"]},"message":{"description":"What went wrong, human-readable.","type":"string","maxLength":500},"fix":{"description":"Exactly what the caller should change to succeed, human-readable.","type":"string","maxLength":500},"field":{"description":"JSON Pointer to the offending input field, if any.","type":["string","null"]},"fields":{"description":"Metric names involved when one JSON Pointer cannot name the error. VALUE_INCONSISTENT names every field, including spotlight_view_time_hours_28d and view_time_hours_28d when Spotlight hours exceed total view hours.","type":["array","null"],"items":{"type":"string"}},"allowed_values":{"type":["array","null"],"items":{"type":"string"}},"retry_after_seconds":{"type":["integer","null"],"minimum":0},"docs_url":{"type":"string","format":"uri"},"request_id":{"type":"string","maxLength":64}}}}},"get_monetization_requirements.input.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/get_monetization_requirements.input.schema.json","title":"get_monetization_requirements input","description":"FACT tool. Returns Snap's current creator-monetization requirements per program, each with source URL, verified_at, effective_date, status, applies_to (entry vs enrolled creators) and mvp_scope. Defaults to in-scope programs: unified_monetization_program, payouts, tax, snap_star, creator_monetization_policy, recommendation_eligibility, brand_partnerships, public_profile, plus historical records on request. Use check_eligibility/calculate_gap to compare a creator's metrics against the rules.","type":"object","additionalProperties":false,"properties":{"program":{"description":"Limit to one program. Omit for all programs.","anyOf":[{"$ref":"#/components/schemas/ProgramSlug"}]},"country":{"description":"ISO 3166-1 alpha-2, alpha-3, or an English country name. Adds country_eligibility. Does not remove facts.","type":"string","minLength":2,"maxLength":80},"include_unverified":{"type":"boolean","default":true,"description":"Include rules we could not verify (status=unverified). Default true so gaps in knowledge are visible."},"include_historical":{"type":"boolean","default":false},"include_out_of_scope":{"type":"boolean","default":false,"description":"Include programs outside the MVP scope (e.g., lens_creator_rewards, creator_subscriptions). Default false. Requesting an out-of-scope program with this false returns PROGRAM_OUT_OF_SCOPE."},"requirement_phase":{"description":"Optional filter.","type":"string","enum":["entry","ongoing","entry_and_ongoing","not_applicable"]},"as_of":{"description":"Return the rules that were in force on this date (uses version history). Default: today.","type":"string","format":"date"}}},"get_rule_changes.output.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/get_rule_changes.output.schema.json","title":"get_rule_changes output","type":"object","additionalProperties":false,"allOf":[{"$ref":"#/components/schemas/Envelope"}],"required":["tool","api_version","notice","generated_at","sources","data_freshness","since","until","query","changes","next_cursor"],"properties":{"tool":{"const":"get_rule_changes"},"api_version":{"const":"v1"},"notice":{"$ref":"#/components/schemas/Notice"},"generated_at":{"$ref":"#/components/schemas/DateTime"},"sources":{"type":"array","items":{"$ref":"#/components/schemas/Source"}},"data_freshness":{"$ref":"#/components/schemas/DataFreshness"},"warnings":{"description":"Plain strings. Omitted when empty. Calculation tools add a string when followers is 0 and view_time_hours_28d or spotlight_view_time_hours_28d is above 0, and when view_time_hours_28d exceeds 28 days × 24 hours × followers × 0.5. Those warnings say the figure is unusually high for your follower count, please check for a typo, and that view time can come from non-followers. They are never an error. FACT GET aliases append ignored query parameter notices to this same array. Spotlight hours above total view hours are HTTP 400 VALUE_INCONSISTENT rather than a warning.","type":"array","items":{"type":"string"}},"since":{"$ref":"#/components/schemas/Date"},"until":{"$ref":"#/components/schemas/Date"},"query":{"type":"object","additionalProperties":false,"description":"Filters applied to this response, including defaults. Top-level since and until stay for older clients.","required":["since","until","program","limit","include_baseline","cursor"],"properties":{"since":{"$ref":"#/components/schemas/Date"},"until":{"$ref":"#/components/schemas/Date"},"program":{"type":["string","null"]},"limit":{"type":"integer"},"include_baseline":{"type":"boolean"},"cursor":{"type":["string","null"]}}},"changes":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["label","rule_id","program","change_type","previous","current","source_url","detected_at","effective_date"],"properties":{"label":{"const":"FACT"},"rule_id":{"$ref":"#/components/schemas/RuleId"},"program":{"$ref":"#/components/schemas/ProgramSlug"},"change_type":{"type":"string","description":"How this record differs from the approved record it supersedes, or the type on an explicit change block. Baseline records are returned only in baseline.","enum":["added","value_changed","status_changed","retired","source_changed","baseline"]},"previous":{"type":["object","null"],"additionalProperties":false,"required":["version","value","unit","status","verified_at"],"properties":{"version":{"type":"integer"},"value":{"anyOf":[{"type":["number","string","boolean","null"]},{"type":"array","items":{"type":"string"}}]},"unit":{"type":"string"},"status":{"type":"string","enum":["current","historical","unverified"]},"verified_at":{"$ref":"#/components/schemas/Date"},"claim":{"type":"string"}}},"current":{"type":["object","null"],"additionalProperties":false,"required":["version","value","unit","status","verified_at"],"properties":{"version":{"type":"integer"},"value":{"anyOf":[{"type":["number","string","boolean","null"]},{"type":"array","items":{"type":"string"}}]},"unit":{"type":"string"},"status":{"type":"string","enum":["current","historical","unverified"]},"verified_at":{"$ref":"#/components/schemas/Date"},"claim":{"type":"string"}}},"source_url":{"type":"string","format":"uri"},"detected_at":{"$ref":"#/components/schemas/Date"},"effective_date":{"type":["string","null"],"format":"date"},"effective_date_note":{"$ref":"#/components/schemas/EffectiveDateNote"},"changed_after":{"description":"Inclusive start of an observed change window when the source does not state a single effective_date. Null when unknown. Additive.","type":["string","null"],"format":"date"},"changed_before":{"description":"Inclusive end of an observed change window when the source does not state a single effective_date. Null when unknown. Additive.","type":["string","null"],"format":"date"},"date_note":{"description":"How changed_after and changed_before were established. Null when there is no window note. Not a substitute for source_url.","type":["string","null"]},"effective_month":{"description":"Month-only announcement when Snap did not publish a day, YYYY-MM. Null when the change has a day or no month.","type":["string","null"],"pattern":"^[0-9]{4}-[0-9]{2}$"},"snap_effective_date":{"description":"Day Snap stated the rule took effect. Null when Snap did not state one.","type":["string","null"],"format":"date"},"snap_announced_date":{"description":"Day Snap announced the rule. Null when Snap did not state an announcement day.","type":["string","null"],"format":"date"},"first_recorded_by_us":{"description":"Day this project first recorded the change. Null when the record has no such date. Not Snap's date.","type":["string","null"],"format":"date"},"evidence_urls":{"description":"Wayback captures or Snap URLs that support the date. Empty when there are none.","type":"array","items":{"type":"string","format":"uri"}},"date_confidence":{"description":"stated_by_snap, bounded_by_archives, or unknown. Null on records that predate the field.","type":["string","null"],"enum":["stated_by_snap","bounded_by_archives","unknown",null]},"date_display":{"description":"Rendered public date line: Snap's date, an archive window with evidence URLs, or unknown, plus the day first recorded by us.","type":"string"},"notes":{"type":"string"}}}},"baseline":{"description":"Initial-load records. Present only when include_baseline is true. Never included in changes or in change counts.","type":"array","items":{"type":"object","additionalProperties":false,"required":["label","rule_id","program","change_type","previous","current","source_url","detected_at","effective_date"],"properties":{"label":{"const":"FACT"},"rule_id":{"$ref":"#/components/schemas/RuleId"},"program":{"$ref":"#/components/schemas/ProgramSlug"},"change_type":{"const":"baseline"},"previous":{"type":["object","null"],"additionalProperties":false,"required":["version","value","unit","status","verified_at"],"properties":{"version":{"type":"integer"},"value":{"anyOf":[{"type":["number","string","boolean","null"]},{"type":"array","items":{"type":"string"}}]},"unit":{"type":"string"},"status":{"type":"string","enum":["current","historical","unverified"]},"verified_at":{"$ref":"#/components/schemas/Date"},"claim":{"type":"string"}}},"current":{"type":["object","null"],"additionalProperties":false,"required":["version","value","unit","status","verified_at"],"properties":{"version":{"type":"integer"},"value":{"anyOf":[{"type":["number","string","boolean","null"]},{"type":"array","items":{"type":"string"}}]},"unit":{"type":"string"},"status":{"type":"string","enum":["current","historical","unverified"]},"verified_at":{"$ref":"#/components/schemas/Date"},"claim":{"type":"string"}}},"source_url":{"type":"string","format":"uri"},"detected_at":{"$ref":"#/components/schemas/Date"},"effective_date":{"type":["string","null"],"format":"date"},"effective_date_note":{"$ref":"#/components/schemas/EffectiveDateNote"},"changed_after":{"type":["string","null"],"format":"date"},"changed_before":{"type":["string","null"],"format":"date"},"date_note":{"type":["string","null"]},"effective_month":{"type":["string","null"],"pattern":"^[0-9]{4}-[0-9]{2}$"},"snap_effective_date":{"description":"Day Snap stated the rule took effect. Null when Snap did not state one.","type":["string","null"],"format":"date"},"snap_announced_date":{"description":"Day Snap announced the rule. Null when Snap did not state an announcement day.","type":["string","null"],"format":"date"},"first_recorded_by_us":{"description":"Day this project first recorded the change. Null when the record has no such date. Not Snap's date.","type":["string","null"],"format":"date"},"evidence_urls":{"description":"Wayback captures or Snap URLs that support the date. Empty when there are none.","type":"array","items":{"type":"string","format":"uri"}},"date_confidence":{"description":"stated_by_snap, bounded_by_archives, or unknown. Null on records that predate the field.","type":["string","null"],"enum":["stated_by_snap","bounded_by_archives","unknown",null]},"date_display":{"description":"Rendered public date line: Snap's date, an archive window with evidence URLs, or unknown, plus the day first recorded by us.","type":"string"},"notes":{"type":"string"}}}},"next_cursor":{"type":["string","null"]},"catalog_scope":{"$ref":"#/components/schemas/CatalogScope"}}},"get_rule_changes.input.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/get_rule_changes.input.schema.json","title":"get_rule_changes input","description":"FACT tool. Lists approved changes to Snap monetization rules. A change is a record that supersedes an approved earlier record and differs in value, status, or source, or a record with an explicit approved change block (added or retired). Baseline records (no supersedes and no change block) are omitted unless include_baseline is true, and they are never included in changes or in change counts. since and until filter on the change date: effective_date, else changed_before, else the last day of effective_month, else detected_at. They do not filter on verified_at.","type":"object","additionalProperties":false,"properties":{"since":{"type":"string","format":"date","description":"Inclusive lower bound on the change date: effective_date, else changed_before, else the last day of effective_month, else detected_at. Omitted on GET, POST, and MCP means 90 days before the request's UTC date. until defaults to the UTC date of the request. The response echoes both dates at the top level and inside query."},"until":{"type":"string","format":"date","description":"Inclusive upper bound on that same change date. Default: the UTC date of the request."},"program":{"$ref":"#/components/schemas/ProgramSlug"},"limit":{"type":"integer","minimum":1,"maximum":200,"default":50},"cursor":{"type":"string","maxLength":200,"description":"Opaque pagination cursor from a previous response."},"include_baseline":{"type":"boolean","default":false,"description":"When true, also return baseline records in baseline. Baseline records are never included in changes."}}},"EvaluableProgram":{"description":"Programs the calculation tools evaluate in v1. Other in-scope programs (payouts, tax, snap_star, creator_monetization_policy, recommendation_eligibility, brand_partnerships) are served as FACTs by get_monetization_requirements; Snap Star status is evaluated as a prerequisite inside unified_monetization_program.","type":"string","enum":["unified_monetization_program"],"default":"unified_monetization_program"},"CreatorMetrics":{"description":"Metrics supplied by the caller (the creator or their agent). We never look metrics up ourselves; Snap offers no public analytics for arbitrary usernames. All fields optional; missing fields produce `unknowns`, never guesses. Data minimization: no age, birthdate, name, or username is accepted; creator age is never stored. Caller metrics are checked for plausibility. spotlight_view_time_hours_28d above view_time_hours_28d returns VALUE_INCONSISTENT. view_time_hours_28d above 28 days × 24 hours × followers × 0.5 is a warning that the figure is unusually high for your follower count, please check for a typo. The warning also says view time can come from non-followers. followers of 0 with hours above 0 is the same kind of warning, never an error.","type":"object","additionalProperties":false,"minProperties":1,"properties":{"followers":{"type":"integer","minimum":0,"maximum":10000000000},"view_time_hours_28d":{"description":"Total view time in hours over the last 28 days, as shown in Snapchat Insights.","type":"number","minimum":0,"maximum":1000000000},"spotlight_view_time_hours_28d":{"description":"Spotlight view time in hours over the last 28 days.","type":"number","minimum":0,"maximum":1000000000},"meets_age_requirement":{"description":"Whether the creator meets the age requirement (18 or the local age of majority). true/false as stated by the caller; null = unknown and returns requires_user_confirmation. Data minimization: we never ask for or store a creator's age or birthdate.","type":["boolean","null"]},"country":{"description":"Country of residence. ISO 3166-1 alpha-2 (US), alpha-3 (USA), or the English name on the reviewed country map (United States). Unlisted territories stay unknown.","type":"string","minLength":2,"maxLength":80},"is_snap_star":{"description":"Self-reported Snap Star status. Cannot be verified by us; treated as a user confirmation.","type":"boolean"},"posts_per_month":{"type":"integer","minimum":0,"maximum":100000},"active_posting_days_28d":{"type":"integer","minimum":0,"maximum":28}}},"Confirmations":{"description":"Caller's answers to qualitative requirements (requires_user_confirmation rules), keyed by rule id. We record the answer as given and never verify it.","type":"array","maxItems":50,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["rule_id","confirmed"],"properties":{"rule_id":{"$ref":"#/components/schemas/RuleId"},"confirmed":{"type":"boolean"}}}},"AlreadyEnrolled":{"description":"Set true only if the creator is already enrolled in the Monetization Program. Default false: only entry (invitation) requirements are evaluated. When true, ongoing requirements for enrolled creators are reported in a separate section.","type":"boolean","default":false},"check_eligibility.input.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/check_eligibility.input.schema.json","title":"check_eligibility input","description":"CALCULATION tool. Creator metrics in; pass/fail per published entry requirement of the Monetization Program out, plus unknowns and requirements needing the creator's own confirmation. Never returns an 'eligible' verdict: the result is meets_published_criteria / does_not_meet_published_criteria / unknown, with a fixed disclaimer that invitation is at Snap's discretion. Ongoing requirements for enrolled creators are reported separately only when already_enrolled=true. Caller metrics are checked for plausibility. spotlight_view_time_hours_28d above view_time_hours_28d returns VALUE_INCONSISTENT. view_time_hours_28d above 28 days × 24 hours × followers × 0.5 is a warning that the figure is unusually high for your follower count, please check for a typo. The warning also says view time can come from non-followers. followers of 0 with hours above 0 is the same kind of warning, never an error.","type":"object","additionalProperties":false,"required":["metrics"],"properties":{"program":{"$ref":"#/components/schemas/EvaluableProgram"},"metrics":{"$ref":"#/components/schemas/CreatorMetrics"},"confirmations":{"$ref":"#/components/schemas/Confirmations"},"already_enrolled":{"$ref":"#/components/schemas/AlreadyEnrolled"},"metrics_as_of":{"type":"string","format":"date","description":"Date the metrics were read from Insights."}}},"OngoingNote":{"const":"Ongoing requirements apply only to creators already enrolled in the Monetization Program. Snap says the 100-hour Spotlight view-time requirement is needed to qualify for maximum Creator Rewards; Snap does not say that rewards stop below it."},"MetricName":{"description":"Closed vocabulary of creator metrics the engines understand.","type":"string","enum":["followers","view_time_hours_28d","spotlight_view_time_hours_28d","meets_age_requirement","country","is_snap_star","posts_per_month","active_posting_days_28d"]},"Unknown":{"description":"A requirement we could not evaluate, with the reason and what would resolve it.","type":"object","additionalProperties":false,"required":["rule_id","reason","how_to_resolve"],"properties":{"rule_id":{"$ref":"#/components/schemas/RuleId"},"reason":{"type":"string","enum":["missing_input","rule_unverified","requires_user_confirmation","not_computable_from_metrics","rule_value_not_numeric"]},"missing_metric":{"anyOf":[{"$ref":"#/components/schemas/MetricName"},{"type":"null"}]},"how_to_resolve":{"type":"string"}}},"check_eligibility.output.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/check_eligibility.output.schema.json","title":"check_eligibility output","type":"object","additionalProperties":false,"allOf":[{"$ref":"#/components/schemas/Envelope"}],"required":["tool","api_version","notice","generated_at","sources","data_freshness","program","already_enrolled","summary","requirements","ongoing_requirements","unknowns","facts"],"properties":{"tool":{"const":"check_eligibility"},"api_version":{"const":"v1"},"notice":{"$ref":"#/components/schemas/Notice"},"generated_at":{"$ref":"#/components/schemas/DateTime"},"sources":{"type":"array","items":{"$ref":"#/components/schemas/Source"}},"data_freshness":{"$ref":"#/components/schemas/DataFreshness"},"warnings":{"description":"Plain strings. Omitted when empty. Calculation tools add a string when followers is 0 and view_time_hours_28d or spotlight_view_time_hours_28d is above 0, and when view_time_hours_28d exceeds 28 days × 24 hours × followers × 0.5. Those warnings say the figure is unusually high for your follower count, please check for a typo, and that view time can come from non-followers. They are never an error. FACT GET aliases append ignored query parameter notices to this same array. Spotlight hours above total view hours are HTTP 400 VALUE_INCONSISTENT rather than a warning.","type":"array","items":{"type":"string"}},"program":{"$ref":"#/components/schemas/ProgramSlug"},"already_enrolled":{"type":"boolean"},"summary":{"type":"object","additionalProperties":false,"required":["published_criteria_status","disclaimer","pass_count","fail_count","unknown_count","requires_confirmation_count"],"description":"Entry requirements only. published_criteria_status rule: does_not_meet_published_criteria if any requirement is fail or user_denied; otherwise unknown if any is unknown or requires_user_confirmation; otherwise meets_published_criteria. There is deliberately no 'eligible' verdict.","properties":{"published_criteria_status":{"type":"string","enum":["meets_published_criteria","does_not_meet_published_criteria","unknown"]},"disclaimer":{"type":"string","enum":["Meets the published criteria; invitation to the Monetization Program is at Snap's discretion.","Does not meet the published criteria based on the inputs provided; invitation to the Monetization Program is at Snap's discretion.","Cannot determine whether the published criteria are met from the inputs provided (some requirements are unknown or need the creator's confirmation); invitation to the Monetization Program is at Snap's discretion."]},"pass_count":{"type":"integer","minimum":0},"fail_count":{"type":"integer","minimum":0},"unknown_count":{"type":"integer","minimum":0},"requires_confirmation_count":{"type":"integer","minimum":0}},"allOf":[{"if":{"properties":{"published_criteria_status":{"const":"meets_published_criteria"}}},"then":{"properties":{"disclaimer":{"const":"Meets the published criteria; invitation to the Monetization Program is at Snap's discretion."}}}},{"if":{"properties":{"published_criteria_status":{"const":"does_not_meet_published_criteria"}}},"then":{"properties":{"disclaimer":{"const":"Does not meet the published criteria based on the inputs provided; invitation to the Monetization Program is at Snap's discretion."}}}},{"if":{"properties":{"published_criteria_status":{"const":"unknown"}}},"then":{"properties":{"disclaimer":{"const":"Cannot determine whether the published criteria are met from the inputs provided (some requirements are unknown or need the creator's confirmation); invitation to the Monetization Program is at Snap's discretion."}}}}]},"ongoing_requirements":{"description":"null unless already_enrolled=true.","type":["object","null"],"additionalProperties":false,"required":["note","requirements"],"properties":{"note":{"$ref":"#/components/schemas/OngoingNote"},"requirements":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["label","rule_id","rule_version","claim","rule_status","outcome","threshold","input_value"],"properties":{"label":{"const":"CALCULATION"},"rule_id":{"$ref":"#/components/schemas/RuleId"},"rule_version":{"type":"integer"},"claim":{"type":"string"},"rule_status":{"type":"string","enum":["current","unverified"]},"metric":{"anyOf":[{"$ref":"#/components/schemas/MetricName"},{"type":"null"}]},"operator":{"type":["string","null"],"enum":["gte","gt","lte","lt","eq","in","is_true",null]},"threshold":{"type":"object","additionalProperties":false,"required":["value","unit"],"properties":{"value":{"anyOf":[{"type":["number","string","boolean","null"]},{"type":"array","items":{"type":"string"}}]},"unit":{"type":"string"}}},"input_value":{"type":["number","string","boolean","null"]},"outcome":{"type":"string","enum":["pass","fail","unknown","requires_user_confirmation","user_confirmed","user_denied"]},"explanation":{"type":"string","maxLength":300}}}}}},"requirements":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["label","rule_id","rule_version","claim","rule_status","outcome","threshold","input_value"],"properties":{"label":{"const":"CALCULATION"},"rule_id":{"$ref":"#/components/schemas/RuleId"},"rule_version":{"type":"integer"},"claim":{"type":"string"},"rule_status":{"type":"string","enum":["current","unverified"]},"metric":{"anyOf":[{"$ref":"#/components/schemas/MetricName"},{"type":"null"}]},"operator":{"type":["string","null"],"enum":["gte","gt","lte","lt","eq","in","is_true",null]},"threshold":{"type":"object","additionalProperties":false,"required":["value","unit"],"properties":{"value":{"anyOf":[{"type":["number","string","boolean","null"]},{"type":"array","items":{"type":"string"}}]},"unit":{"type":"string"}}},"input_value":{"type":["number","string","boolean","null"]},"outcome":{"type":"string","enum":["pass","fail","unknown","requires_user_confirmation","user_confirmed","user_denied"]},"explanation":{"type":"string","maxLength":300}}}},"unknowns":{"type":"array","items":{"$ref":"#/components/schemas/Unknown"}},"facts":{"type":"array","items":{"$ref":"#/components/schemas/RuleFact"}}}},"calculate_gap.input.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/calculate_gap.input.schema.json","title":"calculate_gap input","description":"CALCULATION tool. Exact shortfall for each numeric entry requirement of the Monetization Program: absolute amount and percent complete, and which gap is the binding constraint. Ongoing requirements for enrolled creators are reported separately only when already_enrolled=true. Caller metrics are checked for plausibility. spotlight_view_time_hours_28d above view_time_hours_28d returns VALUE_INCONSISTENT. view_time_hours_28d above 28 days × 24 hours × followers × 0.5 is a warning that the figure is unusually high for your follower count, please check for a typo. The warning also says view time can come from non-followers. followers of 0 with hours above 0 is the same kind of warning, never an error.","type":"object","additionalProperties":false,"required":["metrics"],"properties":{"program":{"$ref":"#/components/schemas/EvaluableProgram"},"metrics":{"$ref":"#/components/schemas/CreatorMetrics"},"already_enrolled":{"$ref":"#/components/schemas/AlreadyEnrolled"},"include_recommendations":{"type":"boolean","default":true}}},"NumericMetricName":{"type":"string","enum":["followers","view_time_hours_28d","spotlight_view_time_hours_28d","posts_per_month","active_posting_days_28d"]},"Recommendation":{"description":"RECOMMENDATION: our suggestion, never a Snap rule. Short and structured; the calling agent writes prose.","type":"object","additionalProperties":false,"required":["label","objective","reason","linked_rule_id","measurable_target","assumptions","risks"],"properties":{"label":{"const":"RECOMMENDATION"},"order":{"description":"1 = address first (the binding constraint). An ordering, not a score.","type":"integer","minimum":1},"objective":{"type":"string","maxLength":200},"reason":{"type":"string","maxLength":300},"linked_rule_id":{"$ref":"#/components/schemas/RuleId"},"measurable_target":{"type":"object","additionalProperties":false,"required":["metric","value","unit"],"properties":{"metric":{"$ref":"#/components/schemas/MetricName"},"value":{"type":"number"},"unit":{"type":"string"},"by_date":{"type":["string","null"],"format":"date"}}},"assumptions":{"type":"array","items":{"type":"string"},"minItems":1},"risks":{"type":"array","items":{"type":"string"}},"realism_note":{"type":["string","null"],"description":"Plain statement when the math is unrealistic, e.g. 'Required pace is 20x your observed pace.'"}}},"calculate_gap.output.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/calculate_gap.output.schema.json","title":"calculate_gap output","type":"object","additionalProperties":false,"allOf":[{"$ref":"#/components/schemas/Envelope"}],"required":["tool","api_version","notice","generated_at","sources","data_freshness","program","already_enrolled","gaps","ongoing_gaps","binding_constraint","unknowns","facts","recommendations"],"properties":{"tool":{"const":"calculate_gap"},"api_version":{"const":"v1"},"notice":{"$ref":"#/components/schemas/Notice"},"generated_at":{"$ref":"#/components/schemas/DateTime"},"sources":{"type":"array","items":{"$ref":"#/components/schemas/Source"}},"data_freshness":{"$ref":"#/components/schemas/DataFreshness"},"warnings":{"description":"Plain strings. Omitted when empty. Calculation tools add a string when followers is 0 and view_time_hours_28d or spotlight_view_time_hours_28d is above 0, and when view_time_hours_28d exceeds 28 days × 24 hours × followers × 0.5. Those warnings say the figure is unusually high for your follower count, please check for a typo, and that view time can come from non-followers. They are never an error. FACT GET aliases append ignored query parameter notices to this same array. Spotlight hours above total view hours are HTTP 400 VALUE_INCONSISTENT rather than a warning.","type":"array","items":{"type":"string"}},"program":{"$ref":"#/components/schemas/ProgramSlug"},"already_enrolled":{"type":"boolean"},"gaps":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["label","rule_id","rule_version","metric","unit","threshold","current","met","shortfall_absolute","percent_complete","percent_complete_uncapped","formula"],"properties":{"label":{"const":"CALCULATION"},"rule_id":{"$ref":"#/components/schemas/RuleId"},"rule_version":{"type":"integer"},"metric":{"$ref":"#/components/schemas/NumericMetricName"},"unit":{"type":"string"},"window_days":{"type":["integer","null"]},"threshold":{"type":"number"},"current":{"type":"number"},"met":{"type":"boolean"},"shortfall_absolute":{"type":"number","minimum":0,"description":"max(threshold - current, 0)"},"surplus_absolute":{"type":"number","minimum":0,"description":"max(current - threshold, 0)"},"percent_complete":{"type":"number","minimum":0,"maximum":100,"description":"min(current / threshold, 1) * 100, rounded to 2 dp"},"percent_complete_uncapped":{"type":"number","minimum":0},"formula":{"type":"string"}}},"description":"Entry requirements only."},"ongoing_gaps":{"description":"null unless already_enrolled=true.","type":["object","null"],"additionalProperties":false,"required":["note","gaps"],"properties":{"note":{"$ref":"#/components/schemas/OngoingNote"},"gaps":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["label","rule_id","rule_version","metric","unit","threshold","current","met","shortfall_absolute","percent_complete","percent_complete_uncapped","formula"],"properties":{"label":{"const":"CALCULATION"},"rule_id":{"$ref":"#/components/schemas/RuleId"},"rule_version":{"type":"integer"},"metric":{"$ref":"#/components/schemas/NumericMetricName"},"unit":{"type":"string"},"window_days":{"type":["integer","null"]},"threshold":{"type":"number"},"current":{"type":"number"},"met":{"type":"boolean"},"shortfall_absolute":{"type":"number","minimum":0,"description":"max(threshold - current, 0)"},"surplus_absolute":{"type":"number","minimum":0,"description":"max(current - threshold, 0)"},"percent_complete":{"type":"number","minimum":0,"maximum":100,"description":"min(current / threshold, 1) * 100, rounded to 2 dp"},"percent_complete_uncapped":{"type":"number","minimum":0},"formula":{"type":"string"}}}}}},"binding_constraint":{"type":["object","null"],"additionalProperties":false,"required":["rule_id","metric","percent_complete","rule"],"properties":{"rule_id":{"$ref":"#/components/schemas/RuleId"},"metric":{"$ref":"#/components/schemas/NumericMetricName"},"percent_complete":{"type":"number"},"rule":{"const":"unmet requirement with the lowest percent_complete; ties broken by rule_id"}}},"unknowns":{"type":"array","items":{"$ref":"#/components/schemas/Unknown"}},"facts":{"type":"array","items":{"$ref":"#/components/schemas/RuleFact"}},"recommendations":{"type":"array","items":{"$ref":"#/components/schemas/Recommendation"}}}},"calculate_growth_pace.input.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/calculate_growth_pace.input.schema.json","title":"calculate_growth_pace input","description":"CALCULATION tool. Required daily and weekly pace to close each numeric gap within target_days, with a linear scenario plus alternatives and labeled assumptions. A projection, never a prediction. Caller metrics are checked for plausibility. spotlight_view_time_hours_28d above view_time_hours_28d returns VALUE_INCONSISTENT. view_time_hours_28d above 28 days × 24 hours × followers × 0.5 is a warning that the figure is unusually high for your follower count, please check for a typo. The warning also says view time can come from non-followers. followers of 0 with hours above 0 is the same kind of warning, never an error.","type":"object","additionalProperties":false,"required":["metrics","target_days"],"properties":{"program":{"$ref":"#/components/schemas/EvaluableProgram"},"metrics":{"$ref":"#/components/schemas/CreatorMetrics"},"already_enrolled":{"$ref":"#/components/schemas/AlreadyEnrolled"},"target_days":{"type":"integer","minimum":1,"maximum":730},"observed_daily_change":{"description":"Optional recent average daily change per metric (caller-supplied, may be negative) for comparing required vs. current pace.","type":"object","additionalProperties":false,"properties":{"followers":{"type":"number","minimum":-1000000000,"maximum":1000000000},"view_time_hours_28d":{"type":"number","minimum":-1000000000,"maximum":1000000000},"spotlight_view_time_hours_28d":{"type":"number","minimum":-1000000000,"maximum":1000000000},"posts_per_month":{"type":"number","minimum":-1000000000,"maximum":1000000000},"active_posting_days_28d":{"type":"number","minimum":-1000000000,"maximum":1000000000}}},"metrics_to_pace":{"type":"array","items":{"$ref":"#/components/schemas/NumericMetricName"},"uniqueItems":true,"maxItems":5}}},"calculate_growth_pace.output.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/calculate_growth_pace.output.schema.json","title":"calculate_growth_pace output","type":"object","additionalProperties":false,"allOf":[{"$ref":"#/components/schemas/Envelope"}],"required":["tool","api_version","notice","generated_at","sources","data_freshness","program","already_enrolled","target_days","target_date","paces","ongoing_paces","projection_disclaimer","unknowns","facts","recommendations"],"properties":{"tool":{"const":"calculate_growth_pace"},"api_version":{"const":"v1"},"notice":{"$ref":"#/components/schemas/Notice"},"generated_at":{"$ref":"#/components/schemas/DateTime"},"sources":{"type":"array","items":{"$ref":"#/components/schemas/Source"}},"data_freshness":{"$ref":"#/components/schemas/DataFreshness"},"warnings":{"description":"Plain strings. Omitted when empty. Calculation tools add a string when followers is 0 and view_time_hours_28d or spotlight_view_time_hours_28d is above 0, and when view_time_hours_28d exceeds 28 days × 24 hours × followers × 0.5. Those warnings say the figure is unusually high for your follower count, please check for a typo, and that view time can come from non-followers. They are never an error. FACT GET aliases append ignored query parameter notices to this same array. Spotlight hours above total view hours are HTTP 400 VALUE_INCONSISTENT rather than a warning.","type":"array","items":{"type":"string"}},"program":{"$ref":"#/components/schemas/ProgramSlug"},"target_days":{"type":"integer"},"target_date":{"$ref":"#/components/schemas/Date"},"already_enrolled":{"type":"boolean"},"paces":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["rule_id","metric","metric_kind","current","threshold","gap","scenarios"],"properties":{"rule_id":{"$ref":"#/components/schemas/RuleId"},"metric":{"$ref":"#/components/schemas/NumericMetricName"},"metric_kind":{"type":"string","enum":["cumulative","rolling_window"]},"window_days":{"type":["integer","null"]},"current":{"type":"number"},"threshold":{"type":"number"},"gap":{"type":"number","minimum":0},"already_met":{"type":"boolean"},"scenarios":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["label","name","computable","required_daily","required_weekly","unit","formula","assumptions"],"properties":{"label":{"const":"CALCULATION"},"name":{"type":"string","enum":["linear","compound","rolling_window_replacement"],"description":"linear: shortfall divided by the caller-chosen days, (T - C) / N. Used for cumulative metrics and for rolling-window metrics. compound: constant daily % growth (cumulative metrics; not computable when current = 0). rolling_window_replacement remains in the enum and is not produced."},"computable":{"type":"boolean"},"required_daily":{"type":["number","null"]},"required_weekly":{"type":["number","null"]},"required_daily_growth_rate_pct":{"type":["number","null"],"description":"compound scenario only"},"unit":{"type":"string"},"formula":{"type":"string"},"assumptions":{"type":"array","items":{"type":"string"},"minItems":1},"not_computable_reason":{"type":["string","null"]}}},"minItems":1},"observed_daily_change":{"type":["number","null"]},"required_to_observed_ratio":{"type":["number","null"],"description":"linear required_daily / observed_daily_change; null if observed not supplied or <= 0."}}},"description":"Entry requirements only."},"ongoing_paces":{"description":"null unless already_enrolled=true.","type":["object","null"],"additionalProperties":false,"required":["note","paces"],"properties":{"note":{"$ref":"#/components/schemas/OngoingNote"},"paces":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["rule_id","metric","metric_kind","current","threshold","gap","scenarios"],"properties":{"rule_id":{"$ref":"#/components/schemas/RuleId"},"metric":{"$ref":"#/components/schemas/NumericMetricName"},"metric_kind":{"type":"string","enum":["cumulative","rolling_window"]},"window_days":{"type":["integer","null"]},"current":{"type":"number"},"threshold":{"type":"number"},"gap":{"type":"number","minimum":0},"already_met":{"type":"boolean"},"scenarios":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["label","name","computable","required_daily","required_weekly","unit","formula","assumptions"],"properties":{"label":{"const":"CALCULATION"},"name":{"type":"string","enum":["linear","compound","rolling_window_replacement"],"description":"linear: shortfall divided by the caller-chosen days, (T - C) / N. Used for cumulative metrics and for rolling-window metrics. compound: constant daily % growth (cumulative metrics; not computable when current = 0). rolling_window_replacement remains in the enum and is not produced."},"computable":{"type":"boolean"},"required_daily":{"type":["number","null"]},"required_weekly":{"type":["number","null"]},"required_daily_growth_rate_pct":{"type":["number","null"],"description":"compound scenario only"},"unit":{"type":"string"},"formula":{"type":"string"},"assumptions":{"type":"array","items":{"type":"string"},"minItems":1},"not_computable_reason":{"type":["string","null"]}}},"minItems":1},"observed_daily_change":{"type":["number","null"]},"required_to_observed_ratio":{"type":["number","null"],"description":"linear required_daily / observed_daily_change; null if observed not supplied or <= 0."}}}}}},"projection_disclaimer":{"const":"Projections show the pace required under stated assumptions. They are not predictions of what will happen."},"unknowns":{"type":"array","items":{"$ref":"#/components/schemas/Unknown"}},"facts":{"type":"array","items":{"$ref":"#/components/schemas/RuleFact"}},"recommendations":{"type":"array","items":{"$ref":"#/components/schemas/Recommendation"}}}},"calculate_payout_timeline.input.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/calculate_payout_timeline.input.schema.json","title":"calculate_payout_timeline input","description":"CALCULATION tool. Dates Snap's payout steps from the day a reward was credited (the day it appeared in All Activity). Optional amount_usd is compared with the published cash-out minimum. Optional tax_info_verified says whether taxpayer verification is already finished. This tool does not look up an account. The result is an estimate, not a promise.","type":"object","additionalProperties":false,"required":["credited_date"],"properties":{"credited_date":{"description":"The day the reward appeared in All Activity, which is when Snap starts the pending clock. YYYY-MM-DD.","type":"string","format":"date"},"amount_usd":{"description":"Available balance in USD, supplied by the caller. Omitted when unknown. Compared with the cash-out minimum from the rules database. Not a Snap pay rate.","type":"number","minimum":0,"maximum":1000000000},"tax_info_verified":{"description":"True when the caller says taxpayer verification is already finished. False when it is not. Omit when unknown. This service does not check a Snap account.","type":"boolean"}}},"calculate_payout_timeline.output.schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://howtomakemoneyonsnapchat.com/schemas/v1/calculate_payout_timeline.output.schema.json","title":"calculate_payout_timeline output","type":"object","additionalProperties":false,"allOf":[{"$ref":"#/components/schemas/Envelope"}],"required":["tool","api_version","notice","generated_at","sources","data_freshness","credited_date","amount_usd","tax_info_verified","meets_minimum","shortfall_usd","cash_out_minimum_usd","steps","facts","recommendations","caveats","estimate_disclaimer"],"properties":{"tool":{"const":"calculate_payout_timeline"},"api_version":{"const":"v1"},"notice":{"$ref":"#/components/schemas/Notice"},"generated_at":{"$ref":"#/components/schemas/DateTime"},"sources":{"type":"array","items":{"$ref":"#/components/schemas/Source"}},"data_freshness":{"$ref":"#/components/schemas/DataFreshness"},"warnings":{"description":"Plain strings. Omitted when empty.","type":"array","items":{"type":"string"}},"credited_date":{"$ref":"#/components/schemas/Date"},"amount_usd":{"type":["number","null"]},"tax_info_verified":{"type":["boolean","null"]},"meets_minimum":{"description":"True when amount_usd meets the cash-out minimum. False when it does not. Null when amount_usd was omitted.","type":["boolean","null"]},"shortfall_usd":{"description":"How far amount_usd is under the cash-out minimum. 0 when the minimum is met. Null when amount_usd was omitted.","type":["number","null"],"minimum":0},"cash_out_minimum_usd":{"description":"The cash-out minimum copied from the rules database.","type":"number","minimum":0},"steps":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["order","id","label","title","summary","rule_id","rule_version","source_url","verified_at","earliest_date","latest_date","range","timing","formula","duration_earliest_days","duration_latest_days","related_rule_ids"],"properties":{"order":{"type":"integer","minimum":1},"id":{"type":"string","enum":["credited","available","cash_out","tax_verification","payout_portal"]},"label":{"type":"string","enum":["FACT","CALCULATION","RECOMMENDATION"]},"title":{"type":"string"},"summary":{"type":"string"},"rule_id":{"$ref":"#/components/schemas/RuleId"},"rule_version":{"type":"integer","minimum":1},"source_url":{"type":"string","format":"uri"},"verified_at":{"$ref":"#/components/schemas/Date"},"earliest_date":{"type":["string","null"],"format":"date"},"latest_date":{"type":["string","null"],"format":"date"},"range":{"description":"True when the source gives a range, or when a latest date is not published.","type":"boolean"},"timing":{"type":"string","enum":["dated","conditional","not_dated"]},"formula":{"type":["string","null"]},"duration_earliest_days":{"type":["integer","null"]},"duration_latest_days":{"type":["integer","null"]},"related_rule_ids":{"type":"array","items":{"$ref":"#/components/schemas/RuleId"}}}}},"facts":{"type":"array","items":{"$ref":"#/components/schemas/RuleFact"}},"recommendations":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["label","text","linked_rule_ids","assumptions"],"properties":{"label":{"const":"RECOMMENDATION"},"text":{"type":"string","maxLength":300},"linked_rule_ids":{"type":"array","minItems":1,"items":{"$ref":"#/components/schemas/RuleId"}},"assumptions":{"type":"array","minItems":1,"items":{"type":"string"}}}}},"caveats":{"type":"array","minItems":1,"items":{"type":"string"}},"estimate_disclaimer":{"const":"Snap may change this timing. This timeline is an estimate, not a promise."}}}}},"x-mcp":{"transport":"streamable-http","endpoint":"/mcp","canonical_url":"https://howtomakemoneyonsnapchat.com/mcp","auth":"The website calculators are free. The API and MCP server need an API key with a 14-day free trial or a paid plan. tools/list stays public. Send the key as Authorization Bearer or X-API-Key. No email. OAuth 2.1 only if authenticated tiers are added later (requires the operator's approval).","tools":["get_monetization_requirements","get_rule_changes","check_eligibility","calculate_gap","calculate_growth_pace","calculate_payout_timeline"],"server_info_description":"Independent; not affiliated with Snap Inc. Canonical host https://howtomakemoneyonsnapchat.com."},"x-limits":{"max_request_body_bytes":16384,"anonymous_requests_per_window":60,"anonymous_window_seconds":60,"anonymous_requests_per_day":5000,"anonymous_daily_window_seconds":86400,"key_requests_per_window":600,"key_window_seconds":60,"key_requests_per_day":50000,"key_daily_window_seconds":86400,"key_issue_per_day":5,"key_issue_global_per_day":500,"anonymous_rate_limit":"Website calculators: 60 requests per 60 seconds and 5000 requests per day per IP prefix (IPv4 /32, IPv6 /64). API and MCP calls use the key's plan limit. Key issuance is 5 per network: IPv4 address or IPv6 /56, and 500 globally per UTC day. Override with Worker vars RATE_LIMIT_REQUESTS, RATE_LIMIT_WINDOW_SECONDS, RATE_LIMIT_DAILY_REQUESTS, RATE_LIMIT_DAILY_WINDOW_SECONDS, RATE_LIMIT_KEY_REQUESTS, RATE_LIMIT_KEY_WINDOW_SECONDS, RATE_LIMIT_KEY_DAILY_REQUESTS, RATE_LIMIT_KEY_DAILY_WINDOW_SECONDS, KEY_ISSUE_PER_DAY, KEY_ISSUE_GLOBAL_PER_DAY, and MAX_BODY_BYTES."}}