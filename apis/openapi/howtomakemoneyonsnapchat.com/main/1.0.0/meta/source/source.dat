version":2,"program":"unified_monetization_program","claim":"At least 3,000 of the 15,000 hours of view time over the last 28 days must come from Spotlight.","value":3000,"unit":"hours","metric":"spotlight_view_time_hours_28d","operator":"gte","window_days":28,"rule_type":"eligibility_threshold","status":"current","source_url":"https://help.snapchat.com/hc/en-us/articles/14669003687444-About-Snapchat-s-Monetization-Program","publisher":"Snap Inc. (Snapchat Support)","verified_at":"2026-09-27","effective_date":null,"effective_date_note":"not published by Snap","changed_after":"2026-02-16","changed_before":"2026-02-17","date_note":"per archived Snap help page (Wayback Machine snapshots of support article 14669003687444 on 2026-02-16 and 2026-02-17); not announced by Snap.","requires_user_confirmation":false,"supersedes":"ump.spotlight_view_time_hours_28d_min@1","applies_to":"entry","requirement_phase":"entry","mvp_scope":"in_scope","related_rule_ids":["ump.view_time_hours_28d_min"],"notes":"Entry (invitation) criterion from the same help-page edit as the 15,000-hour view-time rule. Changed between Feb 16 and Feb 17, 2026 (archived captures of Snap's help page; not announced by Snap). Distinct from the 100-hour ongoing threshold for already-enrolled creators (ump.ongoing_spotlight_view_time_hours_28d_max_rewards)."}],"recommendations":[{"label":"RECOMMENDATION","order":1,"objective":"Raise 28-day Spotlight view time","reason":"Spotlight view time is the binding constraint at 40% of the 3,000-hour entry criterion.","linked_rule_id":"ump.spotlight_view_time_hours_28d_min","measurable_target":{"metric":"spotlight_view_time_hours_28d","value":3000,"unit":"hours","by_date":null},"assumptions":["Criteria on the official help page as verified 2026-09-27 remain unchanged."],"risks":["Meeting the published criteria does not guarantee an invitation; invitation is at Snap's discretion."],"realism_note":null}]}}}},"400":{"$ref":"#/components/responses/Error"},"401":{"$ref":"#/comp