already_enrolled":false,"gaps":[{"label":"CALCULATION","rule_id":"ump.followers_min","rule_version":1,"metric":"followers","unit":"followers","window_days":null,"threshold":50000,"current":32000,"met":false,"shortfall_absolute":18000,"surplus_absolute":0,"percent_complete":64,"percent_complete_uncapped":64,"formula":"shortfall = max(50000 - 32000, 0); percent = min(32000/50000, 1) * 100"},{"label":"CALCULATION","rule_id":"ump.view_time_hours_28d_min","rule_version":2,"metric":"view_time_hours_28d","unit":"hours","window_days":28,"threshold":15000,"current":9500,"met":false,"shortfall_absolute":5500,"surplus_absolute":0,"percent_complete":63.33,"percent_complete_uncapped":63.33,"formula":"shortfall = max(15000 - 9500, 0); percent = min(9500/15000, 1) * 100"},{"label":"CALCULATION","rule_id":"ump.spotlight_view_time_hours_28d_min","rule_version":2,"metric":"spotlight_view_time_hours_28d","unit":"hours","window_days":28,"threshold":3000,"current":1200,"met":false,"shortfall_absolute":1800,"surplus_absolute":0,"percent_complete":40,"percent_complete_uncapped":40,"formula":"shortfall = max(3000 - 1200, 0); percent = min(1200/3000, 1) * 100"}],"ongoing_gaps":null,"binding_constraint":{"rule_id":"ump.spotlight_view_time_hours_28d_min","metric":"spotlight_view_time_hours_28d","percent_complete":40,"rule":"unmet requirement with the lowest percent_complete; ties broken by rule_id"},"unknowns":[],"facts":[{"label":"FACT","rule_id":"ump.followers_min","version":1,"program":"unified_monetization_program","claim":"Creators may be eligible for invitation if they have at least 50,000 followers.","value":50000,"unit":"followers","metric":"followers","operator":"gte","window_days":null,"rule_type":"eligibility_threshold","status":"current","source_url":"https://help.snapchat.com/hc/en-us/articles/14669003687444-About-Snapchat-s-Monetization-Program","publisher":"Snap Inc. (Snapchat Support)","verified_at":"2026-09-26","effective_date":null,"effective_date_note":"not published by Sna