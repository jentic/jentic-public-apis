TENT","message":"spotlight_view_time_hours_28d is greater than view_time_hours_28d.","fix":"Set spotlight_view_time_hours_28d to a number less than or equal to view_time_hours_28d. Spotlight hours are part of total view hours.","field":null,"fields":["spotlight_view_time_hours_28d","view_time_hours_28d"],"allowed_values":null,"retry_after_seconds":null,"docs_url":"https://howtomakemoneyonsnapchat.com/docs/errors#VALUE_INCONSISTENT","request_id":"req_example"}}}}},"Unauthorized":{"description":"The API key is missing or not valid (error.code = INVALID_API_KEY). Tool calls require a trial, an active plan, or a complimentary key.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/error.schema"},"example":{"notice":"HowToMakeMoneyOnSnapchat.com is an independent third party and is not affiliated with, endorsed by, or sponsored by Snap Inc. Snapchat is a trademark of Snap Inc.","error":{"code":"INVALID_API_KEY","message":"This tool requires an API key with a trial or an active plan.","fix":"Open /pricing to start a 14-day free trial or choose a paid plan. Send the key as Authorization: Bearer or X-API-Key.","field":null,"fields":null,"allowed_values":null,"retry_after_seconds":null,"docs_url":"https://howtomakemoneyonsnapchat.com/docs/errors#INVALID_API_KEY","request_id":"req_example"}}}}},"TurnstileFailed":{"description":"Turnstile check missing or not accepted (error.code = TURNSTILE_FAILED).","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"}},"content":