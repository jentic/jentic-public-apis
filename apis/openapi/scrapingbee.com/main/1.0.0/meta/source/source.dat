{
  "openapi": "3.0.3",
  "info": {
    "title": "ScrapingBee API",
    "description": "Web scraping proxy API. Send a URL and ScrapingBee handles proxies, headless browsers, and CAPTCHAs. Supports JavaScript rendering, screenshots, Google search scraping, and data extraction.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://www.scrapingbee.com/documentation/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://app.scrapingbee.com",
      "description": "ScrapingBee API"
    }
  ],
  "security": [
    {
      "ApiKeyQuery": []
    }
  ],
  "paths": {
    "/api/v1/": {
      "get": {
        "operationId": "scrapeGet",
        "summary": "Scrape URL (GET)",
        "description": "Scrape a webpage by URL using a GET request. Returns the HTML content of the page with optional JavaScript rendering, proxy rotation, and data extraction.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Your ScrapingBee API key"
          },
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The URL of the page to scrape (URL-encoded)"
          },
          {
            "name": "render_js",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Whether to render JavaScript on the page"
          },
          {
            "name": "premium_proxy",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Use premium residential proxies (10-25 credits)"
          },
          {
            "name": "stealth_proxy",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Use stealth proxies for extra protection (75 credits)"
          },
          {
            "name": "country_code",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Country code for geo-targeted proxy (e.g., us, gb, de)"
          },
          {
            "name": "block_ads",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Block ads on the page"
          },
          {
            "name": "block_resources",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Block images, fonts, and CSS to speed up scraping"
          },
          {
            "name": "wait",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Wait time in milliseconds after page load"
          },
          {
            "name": "wait_for",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "CSS selector to wait for before returning"
          },
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 140000
            },
            "description": "Maximum timeout in milliseconds"
          },
          {
            "name": "js_scenario",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded JavaScript scenario for browser interactions"
          },
          {
            "name": "extract_rules",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded extraction rules for structured data"
          },
          {
            "name": "screenshot",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Take a screenshot of the page"
          },
          {
            "name": "screenshot_full_page",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Take a full-page screenshot"
          },
          {
            "name": "screenshot_selector",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "CSS selector for element-specific screenshot"
          },
          {
            "name": "session_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Session ID for keeping the same proxy across requests"
          },
          {
            "name": "cookies",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Cookies to send with the request (name=value;name2=value2)"
          },
          {
            "name": "forward_headers",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Forward custom headers prefixed with Spb- to the target"
          },
          {
            "name": "forward_headers_pure",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Forward only your custom headers, replacing defaults"
          },
          {
            "name": "device",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["desktop", "mobile"]
            },
            "description": "Device type to emulate"
          },
          {
            "name": "json_response",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Return response as JSON with headers and status code"
          },
          {
            "name": "return_page_source",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Return original page source before JS execution"
          },
          {
            "name": "transparent_status_code",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Return the target website's status code"
          },
          {
            "name": "own_proxy",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Use your own proxy (protocol://user:pass@host:port)"
          },
          {
            "name": "custom_google",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Use Google search scraping mode"
          },
          {
            "name": "search_type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["web", "images", "news", "videos", "shopping"]
            },
            "description": "Type of Google search results"
          },
          {
            "name": "nb_results",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Number of Google search results per page"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Google search results page number"
          }
        ],
        "responses": {
          "200": {
            "description": "Page content (HTML, screenshot bytes, or JSON depending on parameters)",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "JSON response when json_response=true or extract_rules are used"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key"
          },
          "500": {
            "description": "Internal error or target website error"
          }
        }
      },
      "post": {
        "operationId": "scrapePost",
        "summary": "Scrape URL (POST)",
        "description": "Scrape a webpage using a POST request. Useful for form submissions or APIs that require POST. Same parameters as GET, with additional body forwarding.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Your ScrapingBee API key"
          },
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The URL to send the POST request to"
          },
          {
            "name": "render_js",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Whether to render JavaScript"
          },
          {
            "name": "forward_headers",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Forward custom headers"
          },
          {
            "name": "json_response",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "transparent_status_code",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "requestBody": {
          "description": "The body to forward to the target URL",
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Target page response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key"
          },
          "500": {
            "description": "Internal error"
          }
        }
      }
    },
    "/api/v1/usage": {
      "get": {
        "operationId": "getUsage",
        "summary": "Get API Usage",
        "description": "Get your current API credit usage and remaining credits.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usage information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "max_api_credit": {
                      "type": "integer",
                      "description": "Maximum API credits for the plan"
                    },
                    "used_api_credit": {
                      "type": "integer",
                      "description": "Credits used in the current period"
                    },
                    "max_concurrency": {
                      "type": "integer",
                      "description": "Maximum concurrent requests"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/store": {
      "get": {
        "operationId": "getScreenshot",
        "summary": "Get Stored Screenshot",
        "description": "Retrieve a stored screenshot by its storage URL.",
        "parameters": [
          {
            "name": "api_key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Screenshot image",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key",
        "description": "ScrapingBee API key passed as a query parameter"
      }
    }
  }
}
