{
  "openapi": "3.0.0",
  "info": {
    "title": "RWD Client API Documentation",
    "version": "1.0.0",
    "description": "Public APIs for RWD third-party integrations and client-side ordering.\n\n## Authentication\nAll endpoints require an API key passed in the `x-api-key` header. Each company is assigned a unique API key stored in their company record. Contact your administrator to obtain your API key.\n\n## Workflow\n1. **Get Order Details** — Call `GET /rwd-client/order/order-details` to fetch your pricing template, available products, quantity discount tiers, and customer settings.\n2. **Create Order** — Call `POST /rwd-client/order/create-order` with the `customerId`, product IDs (from step 1), and quantities. All pricing, discounts, tax, and totals are calculated automatically on the backend.\n\n## How Calculations Work\n- **Prices**: Fetched from the customer's assigned pricing template. You cannot override prices via the API.\n- **Quantity Discounts**: Products with `quantityDiscount: true` are eligible. The total quantity of all eligible products is summed, matched against the discount tiers, and the corresponding discount percentage is applied to each eligible product's unit price.\n- **Tax**: Applied only if the customer has `isTaxed: true`. Tax is calculated as: `taxRate% × (subTotal - totalQuantityDiscount)`.\n- **Total Formula**: `subTotal - totalQuantityDiscount + taxCharge`\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/craxinnocom/RWD_CLIENT_ORDERS/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.rwdtrim.com",
      "description": "Live Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Enter your API key. This key identifies your company and authorizes your requests.\nThe API key is linked to your company record and determines which customer data you can access.\n"
      }
    },
    "schemas": {
      "OrderProduct": {
        "type": "object",
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "description": "The MongoDB ObjectId of the product. Get this from the `pricingTemplate.products[].productId._id` field in the order-details response.\n",
            "example": "65f5c080687a87a263de8882"
          },
          "quantity": {
            "type": "number",
            "minimum": 0,
            "description": "Number of boxes/units to order. At least one product in the array must have quantity > 0.",
            "example": 10
          }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": [
          "customerId",
          "products"
        ],
        "properties": {
          "customerId": {
            "type": "string",
            "description": "The MongoDB ObjectId of the Company/Customer to place the order for. Get this from the `customer._id` field in the order-details response.",
            "example": "694e18cef7ebad9850b561fc"
          },
          "products": {
            "type": "array",
            "description": "Array of products with quantities. At least one product must have quantity > 0. All productIds must exist in the customer's pricing template.",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/OrderProduct"
            }
          },
          "PoNo": {
            "type": "string",
            "description": "Purchase Order Number. Optional unless the customer has isPoRequired set to true (check via order-details API).",
            "example": "PO-2025-001"
          },
          "notes": {
            "type": "string",
            "description": "Any additional instructions or notes for the order.",
            "example": "Rush order - deliver to warehouse B"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "status": {
            "type": "integer",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Invalid or missing customerId"
          }
        }
      },
      "UnauthorizedResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Unauthorized: Invalid API key"
          }
        }
      },
      "ShippingAddress": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string",
            "example": "123 Main St"
          },
          "city": {
            "type": "string",
            "example": "Dallas"
          },
          "state": {
            "type": "string",
            "example": "TX"
          },
          "zipCode": {
            "type": "string",
            "example": "75001"
          }
        }
      },
      "BillingAddress": {
        "type": "object",
        "properties": {
          "street": {
            "type": "string",
            "example": "123 Main St"
          },
          "city": {
            "type": "string",
            "example": "Dallas"
          },
          "state": {
            "type": "string",
            "example": "TX"
          },
          "zipCode": {
            "type": "string",
            "example": "75001"
          }
        }
      },
      "CustomerInfo": {
        "type": "object",
        "description": "Customer details relevant for order creation.",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Customer MongoDB ObjectId. Use this as `customerId` when creating an order.",
            "example": "694e18cef7ebad9850b561fc"
          },
          "companyName": {
            "type": "string",
            "example": "ABC Construction"
          },
          "isPoRequired": {
            "type": "boolean",
            "description": "If `true`, the `PoNo` field is **required** when creating an order for this customer.",
            "example": false
          },
          "isPayCardRequired": {
            "type": "boolean",
            "description": "Whether credit card payment is required for this customer.",
            "example": false
          },
          "isTaxed": {
            "type": "boolean",
            "description": "If `true`, tax will be automatically applied to the order total.",
            "example": true
          },
          "isRegularOrPlainBox": {
            "type": "boolean",
            "description": "Box type preference. `true` = plain box, `false` = regular box.",
            "example": false
          },
          "billingToParentCompany": {
            "type": "boolean",
            "description": "Whether billing is directed to the parent company.",
            "example": false
          },
          "parentCompanyId": {
            "type": "string",
            "nullable": true,
            "description": "Parent company ObjectId, if applicable.",
            "example": null
          },
          "paymentTermId": {
            "type": "string",
            "nullable": true,
            "description": "Assigned payment term ObjectId.",
            "example": "65a1b2c3d4e5f6a7b8c9d0e1"
          },
          "email": {
            "type": "string",
            "description": "Primary contact email for order confirmations.",
            "example": "orders@abcconstruction.com"
          },
          "shippingAddress": {
            "$ref": "#/components/schemas/ShippingAddress"
          },
          "billingAddress": {
            "$ref": "#/components/schemas/BillingAddress"
          }
        }
      },
      "TemplateProductDetail": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Product ObjectId. **Use this value as `productId` in the create order request.**",
            "example": "65f5c080687a87a263de8882"
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable product name.",
            "example": "White Trim 12ft"
          },
          "size": {
            "type": "string",
            "example": "12"
          },
          "colorCode": {
            "type": "string",
            "example": "WH01"
          },
          "seOrde": {
            "type": "string",
            "enum": [
              "single",
              "double",
              "no tape"
            ],
            "description": "Edge type. `single` = SE, `double` = DE, `no tape` = NO TAPE.",
            "example": "single"
          },
          "isStock": {
            "type": "boolean",
            "description": "Whether the product is currently in stock.",
            "example": true
          }
        }
      },
      "TemplateProduct": {
        "type": "object",
        "properties": {
          "productId": {
            "$ref": "#/components/schemas/TemplateProductDetail"
          },
          "price": {
            "type": "number",
            "description": "Unit price for this product (from pricing template).",
            "example": 14.0
          },
          "quantityDiscount": {
            "type": "boolean",
            "description": "If `true`, this product is eligible for quantity-based discounts.",
            "example": true
          },
          "customCode": {
            "type": "string",
            "nullable": true,
            "description": "Custom product code, if assigned.",
            "example": null
          },
          "customText": {
            "type": "string",
            "nullable": true,
            "description": "Custom product text/label, if assigned.",
            "example": null
          }
        }
      },
      "PricingTemplate": {
        "type": "object",
        "description": "The pricing template assigned to this customer with all available products and prices.",
        "properties": {
          "_id": {
            "type": "string",
            "example": "65b2c3d4e5f6a7b8c9d0e1f2"
          },
          "templateName": {
            "type": "string",
            "example": "Standard Pricing 2025"
          },
          "products": {
            "type": "array",
            "description": "All available products for this customer. Use `productId._id` values when creating an order.",
            "items": {
              "$ref": "#/components/schemas/TemplateProduct"
            }
          }
        }
      },
      "QuantityDiscount": {
        "type": "object",
        "description": "A single quantity discount tier.",
        "properties": {
          "fromQuantity": {
            "type": "number",
            "description": "Minimum total quantity of discount-eligible products for this tier.",
            "example": 50
          },
          "toQuantity": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "description": "Maximum quantity for this tier. Can be a number or `\"above\"` for unlimited.",
            "example": 100
          },
          "discountRate": {
            "type": "number",
            "description": "Discount percentage to apply to each eligible product's unit price.",
            "example": 5
          }
        }
      },
      "OrderDetailsResponseData": {
        "type": "object",
        "properties": {
          "customer": {
            "$ref": "#/components/schemas/CustomerInfo"
          },
          "pricingTemplate": {
            "$ref": "#/components/schemas/PricingTemplate"
          },
          "quantityDiscounts": {
            "type": "array",
            "description": "Quantity discount tiers. The discount is determined by summing the total quantity of all\ndiscount-eligible products (`quantityDiscount: true`), finding the matching tier, and\napplying that tier's `discountRate` percentage to each eligible product's unit price.\n",
            "items": {
              "$ref": "#/components/schemas/QuantityDiscount"
            }
          },
          "defaultTaxRate": {
            "type": "number",
            "description": "Default tax rate percentage. Applied only when customer `isTaxed` is `true`.",
            "example": 7.25
          }
        }
      },
      "OrderDetailsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "status": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "Order details fetched successfully"
          },
          "data": {
            "$ref": "#/components/schemas/OrderDetailsResponseData"
          }
        }
      },
      "CreatedOrderProduct": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "example": "65f5c080687a87a263de8882"
          },
          "price": {
            "type": "number",
            "description": "Original unit price from pricing template.",
            "example": 14.0
          },
          "discountedPrice": {
            "type": "number",
            "description": "Price after quantity discount. Same as `price` if no discount applies.",
            "example": 12.5
          },
          "quantity": {
            "type": "number",
            "example": 10
          }
        }
      },
      "CreateOrderResponseData": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "number",
            "description": "Auto-generated sequential order ID.",
            "example": 1025
          },
          "_id": {
            "type": "string",
            "description": "MongoDB ObjectId of the created order.",
            "example": "694f29def8fcbe0961c672ed"
          },
          "total": {
            "type": "number",
            "description": "Final order total. Formula: subTotal - totalQuantityDiscount + taxCharge",
            "example": 1250.75
          },
          "subTotal": {
            "type": "number",
            "description": "Sum of (price × quantity) for all products before any discounts.",
            "example": 1400.0
          },
          "totalQuantityDiscount": {
            "type": "number",
            "description": "Total discount amount from quantity-based discounts.",
            "example": 149.25
          },
          "status": {
            "type": "string",
            "description": "Initial order status.",
            "example": "Pending"
          },
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreatedOrderProduct"
            }
          }
        }
      },
      "CreateOrderResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "status": {
            "type": "integer",
            "example": 201
          },
          "message": {
            "type": "string",
            "example": "Order created successfully"
          },
          "data": {
            "$ref": "#/components/schemas/CreateOrderResponseData"
          }
        }
      }
    }
  },
  "paths": {
    "/rwd-client/order/order-details": {
      "get": {
        "summary": "Get customer and pricing details",
        "description": "Fetches all information needed to create an order for the authenticated company.\n\nThe `customerId` is **automatically resolved** from the API key — no need to pass it separately.\n\n### Response includes:\n- **Customer info**: Company name, PO requirement, tax status, addresses\n- **Pricing template**: All available products with their prices and discount eligibility\n- **Quantity discount tiers**: Discount brackets based on total eligible quantity\n- **Default tax rate**: Applied when customer has tax enabled\n\n### How to use the response:\n1. Check `customer.isPoRequired` — if `true`, you must include `PoNo` when creating an order\n2. Browse `pricingTemplate.products` to see available products and prices\n3. Use `productId._id` from each product as the `productId` in your create order request\n4. Check `quantityDiscounts` to understand volume pricing tiers\n",
        "tags": [
          "Client Order"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Order details fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderDetailsResponse"
                }
              }
            }
          },
          "400": {
            "description": "No pricing template assigned to this customer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "status": 400,
                  "message": "No pricing template assigned to this customer"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid `x-api-key` header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponse"
                },
                "examples": {
                  "missing": {
                    "summary": "Missing API key",
                    "value": {
                      "success": false,
                      "message": "Unauthorized: API key is required. Pass it in the 'x-api-key' header."
                    }
                  },
                  "invalid": {
                    "summary": "Invalid API key",
                    "value": {
                      "success": false,
                      "message": "Unauthorized: Invalid API key"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Customer not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "status": 404,
                  "message": "Customer not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rwd-client/order/create-order": {
      "post": {
        "summary": "Create a new order",
        "description": "Creates an order with minimal input. **All calculations are performed on the backend** — you only need to provide the customer ID, product IDs, and quantities.\n\n### What the backend calculates automatically:\n| Field | How it's calculated |\n|-------|-------------------|\n| **Product prices** | Fetched from customer's pricing template |\n| **Quantity discounts** | Sum eligible product quantities → match discount tier → apply % to each eligible product |\n| **Tax** | `taxRate% × (subTotal - totalQuantityDiscount)` — only if customer `isTaxed` is `true` |\n| **Sub Total** | Sum of `price × quantity` for all products |\n| **Total** | `subTotal - totalQuantityDiscount + taxCharge` |\n| **Billing info** | Payment term, bill-to-parent, tax settings from customer record |\n| **Order ID** | Auto-generated sequential number |\n\n### Validation rules:\n- All `productId` values must exist in the customer's pricing template\n- At least one product must have `quantity > 0`\n- Quantities cannot be negative\n- If customer has `isPoRequired: true`, the `PoNo` field is required\n\n### How to get valid product IDs:\nCall `GET /rwd-client/order/order-details` first and use the `productId._id` values from `pricingTemplate.products[]`.\n",
        "tags": [
          "Client Order"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              },
              "examples": {
                "basicOrder": {
                  "summary": "Basic order with two products",
                  "value": {
                    "customerId": "694e18cef7ebad9850b561fc",
                    "products": [
                      {
                        "productId": "65f5c080687a87a263de8882",
                        "quantity": 10
                      },
                      {
                        "productId": "660eb97137f411f78f873115",
                        "quantity": 5
                      }
                    ]
                  }
                },
                "orderWithPO": {
                  "summary": "Order with PO number and notes",
                  "value": {
                    "customerId": "694e18cef7ebad9850b561fc",
                    "products": [
                      {
                        "productId": "65f5c080687a87a263de8882",
                        "quantity": 50
                      }
                    ],
                    "PoNo": "PO-2025-0042",
                    "notes": "Deliver to warehouse B"
                  }
                },
                "singleProduct": {
                  "summary": "Single product order",
                  "value": {
                    "customerId": "694e18cef7ebad9850b561fc",
                    "products": [
                      {
                        "productId": "65f5c080687a87a263de8882",
                        "quantity": 100
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOrderResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error. Possible reasons:\n- Missing or invalid `customerId`\n- Empty products array\n- No product has quantity > 0\n- Invalid `productId` (not found in pricing template)\n- Negative quantity value\n- Missing PO number when required by customer\n- No pricing template assigned to customer\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidCustomer": {
                    "summary": "Invalid customer ID",
                    "value": {
                      "success": false,
                      "status": 400,
                      "message": "Invalid or missing customerId"
                    }
                  },
                  "emptyProducts": {
                    "summary": "Empty products array",
                    "value": {
                      "success": false,
                      "status": 400,
                      "message": "Products array is required and must not be empty"
                    }
                  },
                  "noQuantity": {
                    "summary": "No valid quantity",
                    "value": {
                      "success": false,
                      "status": 400,
                      "message": "At least one product must have a quantity greater than 0"
                    }
                  },
                  "invalidProduct": {
                    "summary": "Product not in pricing template",
                    "value": {
                      "success": false,
                      "status": 400,
                      "message": "Product 65f5c080687a87a263de8882 is not in the customer's pricing template"
                    }
                  },
                  "poRequired": {
                    "summary": "PO number required",
                    "value": {
                      "success": false,
                      "status": 400,
                      "message": "PO Number is required for this customer"
                    }
                  },
                  "noTemplate": {
                    "summary": "No pricing template",
                    "value": {
                      "success": false,
                      "status": 400,
                      "message": "No pricing template assigned to this customer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid `x-api-key` header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedResponse"
                },
                "examples": {
                  "missing": {
                    "summary": "Missing API key",
                    "value": {
                      "success": false,
                      "message": "Unauthorized: API key is required. Pass it in the 'x-api-key' header."
                    }
                  },
                  "invalid": {
                    "summary": "Invalid API key",
                    "value": {
                      "success": false,
                      "message": "Unauthorized: Invalid API key"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Customer or pricing template not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "status": 404,
                  "message": "Customer not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
