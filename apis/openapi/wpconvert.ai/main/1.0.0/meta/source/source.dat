    PreviewOnlyDownloadDenied:
      summary: Preview-only conversion cannot be downloaded
      description: >-
        Upgrading will not unlock this artifact. A new conversion must be run
        under a paid entitlement to obtain a downloadable theme.
      value:
        error:
          code: upgrade_required
          message: >-
            This was a free preview-only conversion. Upgrade to Pro/Agency or buy
            PAYG credits, then re-run the conversion to download the theme.
          plan_needed: pro
          preview_only: true
          buy_credits_url: https://wpconvert.ai/billing
    SignedUploadWorkflow:
      summary: Signed upload target for a large archive
      description: >-
        Step 1 of the large-archive flow. Next, `PUT` the archive to `signedUrl`
        with `Content-Type: application/zip` and `x-upsert: true` (no API key on
        that request), then `POST /api/convert/from-storage` with the same
        `jobId`.
      value:
        jobId: 11111111-1111-4111-8111-111111111111
        bucket: uploads
        path: 99999999-9999-4999-8999-999999999999/11111111-1111-4111-8111-111111111111.zip
        token: EXAMPLE_UPLOAD_TOKEN_NOT_A_REAL_SECRET
        signedUrl: https://storage.example.com/object/upload/sign/uploads/example.zip?token=EXAMPLE
        maxSizeMB: 100
