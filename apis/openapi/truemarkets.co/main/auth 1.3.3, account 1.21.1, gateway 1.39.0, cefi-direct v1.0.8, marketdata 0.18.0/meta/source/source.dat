          "404": {
            "description": "Symbol not found or no price data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/defi/market/prices/candles": {
      "get": {
        "summary": "Get OHLC candles for a symbol",
        "operationId": "getCandles",
        "tags": [
          "Market data: Prices"
        ],
        "description": "Returns open/high/low/close buckets for an asset over a configurable\nlookback window, sampled at a configurable resolution. Use for\ncandlestick charts and volatility measures that need the intra-bucket\nrange rather than a single close.\n\nOnly sources that store individual ticks can produce OHLC. Requesting\ncandles for an asset priced from a derived or snapshot source returns\n`400`.\n\nSee the [Time Window & Resolution](#section/Time-Window-and-Resolution)\nsection for the format of `window` and `resolution`.\n",
        "security": [],
        "parameters": [
          {
            "name": "asset_id",
            "in": "query",
            "description": "Backend asset ID. Mutually exclusive with `symbol`: exactly one of\nthe two is required, and naming both is a 400.\n",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "description": "Asset symbol to fetch candles for (e.g. `SOL`, `BTC`).",
            "required": false,
            "deprecated": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "window",
            "in": "query",
            "description": "Lookback period (e.g. `1h`, `4h`, `1d`, `7d`, `1M`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1h"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "description": "Ends the window at this instant instead of now, so a past period can be read. RFC3339, and must not be in the future or the zero time. Absent reads live data.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2026-01-02T03:04:05Z"
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "description": "Candle size (e.g. `1m`, `5m`, `1h`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5s"
            }
          },
          {
            "name": "asset_class",
            "in": "query",
            "description": "Asset class to resolve the symbol in. Defaults to `spot`.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "spot",
                "perp"
              ],
              "default": "spot"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candle series for the requested symbol",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters, or candles unavailable for the asset's price source",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "404": {
            "description": "Symbol not found or no price data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      }
    },
