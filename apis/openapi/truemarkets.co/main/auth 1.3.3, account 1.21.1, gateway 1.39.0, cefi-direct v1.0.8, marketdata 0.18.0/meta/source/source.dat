            "name": "limit",
            "in": "query",
            "description": "Maximum number of allocations to return",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Allocations retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListAllocationsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/GatewayBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/GatewayUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/GatewayForbidden"
          },
          "500": {
            "$ref": "#/components/responses/GatewayInternalError"
          }
        }
      },
      "post": {
        "operationId": "createAllocation",
        "summary": "Allocate funds to CeFi",
        "description": "Allocates `amount` of the caller's DeFi wallet balance to CeFi trading. This does not move tokens; to send funds out of the wallet, use `POST /transfers`. The tokens stay in the caller's wallet, but the allocated amount can't leave it until it is released with `POST /custody/releases`. The wallet must cover everything the caller has allocated of the asset.\n\nAnswers `202` with the allocation in `crediting`. Poll `GET /custody/allocations/{id}` until it is `completed` or `rejected`.\n\nOnly one allocation per `asset_id` can be in progress at a time. Another request for the same `asset_id` answers `409`, so retrying after a lost response can't allocate twice.\n\n`asset_id` is a DeFi listing from `GET /assets` that also trades on CeFi. A CeFi listing answers `404`.",
        "tags": [
          "Gateway: Custody"
        ],
        "security": [
          {
            "GatewayBearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GatewayOnBehalfOf"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAllocationRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Allocation accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Allocation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/GatewayBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/GatewayUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/GatewayForbidden"
          },
          "404": {
            "$ref": "#/components/responses/GatewayNotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/GatewayInternalError"
          },
          "503": {
            "$ref": "#/components/responses/GatewayServiceUnavailable"
          }
        }
      }
    },
