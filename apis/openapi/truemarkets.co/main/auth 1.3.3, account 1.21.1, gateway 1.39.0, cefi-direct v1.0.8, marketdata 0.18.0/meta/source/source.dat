          "400": {
            "$ref": "#/components/responses/GatewayBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/GatewayUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/GatewayForbidden"
          },
          "500": {
            "$ref": "#/components/responses/GatewayInternalError"
          }
        }
      },
      "post": {
        "operationId": "createRelease",
        "summary": "Release funds from CeFi",
        "description": "Releases `amount` of the caller's allocated balance from CeFi trading, so it is free to leave the caller's DeFi wallet again. This does not move tokens; to send funds out of the wallet, use `POST /transfers`.\n\nAnswers `202` with the release in `debiting`. Poll `GET /custody/releases/{id}` until it is `completed` or `rejected`.\n\nOnly one release per `asset_id` can be in progress at a time. Another request for the same `asset_id` answers `409`, so retrying after a lost response can't release twice.\n\n`asset_id` is a DeFi listing from `GET /assets` that also trades on CeFi. A CeFi listing answers `404`.",
        "tags": [
          "Gateway: Custody"
        ],
        "security": [
          {
            "GatewayBearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GatewayOnBehalfOf"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReleaseRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Release accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Release"
                }
              }
            }
          },
          "400": {
