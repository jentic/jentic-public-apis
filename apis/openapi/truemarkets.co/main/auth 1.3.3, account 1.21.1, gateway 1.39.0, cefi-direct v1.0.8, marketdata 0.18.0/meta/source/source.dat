              "minLength": 1,
              "pattern": "^[1-9][0-9]*$"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Filters assets by name. Returns assets where the name is an exact match or contains the provided substring. Matching is case-sensitive.\n",
            "required": false,
            "schema": {
