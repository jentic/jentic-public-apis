{
  "openapi": "3.1.0",
  "info": {
    "title": "True Markets API",
    "version": "auth 1.3.3, account 1.21.1, gateway 1.39.0, cefi-direct v1.0.8, marketdata 0.18.0",
    "description": "Every public True Markets REST API in one document. Each is also published on its own:\n\n- [Authentication REST spec](https://docs.truemarkets.co/openapi/auth.yaml): Exchange an API key signature for a token, and refresh it.\n- [Accounts REST spec](https://docs.truemarkets.co/openapi/account.yaml): Create the users your organization trades for, with their wallets, and read deposit details.\n- [Trading REST spec](https://docs.truemarkets.co/openapi/gateway.yaml): Quotes, orders, transfers, balances and transactions, for your own account or for a user you act for.\n- [CeFi direct REST spec](https://docs.truemarkets.co/openapi/cefi-direct.yaml): Order entry, balances and market data on the CeFi venue, for firms with direct access.\n- [Market data REST spec](https://docs.truemarkets.co/openapi/marketdata.yaml): Prices, candles and history across venues, without a token."
  },
  "externalDocs": {
    "url": "https://docs.truemarkets.co"
  },
  "servers": [
    {
      "url": "https://api.truemarkets.co",
      "description": "Production"
    },
    {
      "url": "https://api.uat.truemarkets.co",
      "description": "UAT (sandbox)"
    }
  ],
  "tags": [
    {
      "name": "Account: Agreements",
      "description": "User acceptance of third-party and platform agreements."
    },
    {
      "name": "Account: Organizations",
      "description": "The users an organization trades for. Each user is created with wallets and addressed on trading routes through `TM-On-Behalf-Of`."
    },
    {
      "name": "Account: Trading Setup",
      "description": "How a user is set up to trade and to settle what they trade, separate from their KYC status."
    },
    {
      "name": "Gateway: Quotes",
      "description": "Request real-time market quotes for trading pairs without creating an order."
    },
    {
      "name": "Gateway: Orders",
      "description": "Create, execute, cancel, and monitor orders across CeFi and DeFi."
    },
    {
      "name": "Gateway: Transfers",
      "description": "Create, execute, and monitor transfers across CeFi and DeFi."
    },
    {
      "name": "Gateway: Ramps",
      "description": "Sell stablecoin balances for fiat through Coinbase or PayPal, funded from CeFi when needed."
    },
    {
      "name": "Gateway: Custody",
      "description": "Set aside part of the caller's DeFi wallet balance for CeFi trading, and release it again. Tokens stay in the caller's wallet. Nothing is sent on chain or to a bank; for that, see Transfers and Ramps."
    },
    {
      "name": "Gateway: Paper Trading",
      "description": "Add and remove test funds in a paper-trading environment. These endpoints exist only in non-production paper-trading environments such as UAT; production answers `404`."
    },
    {
      "name": "Gateway: Transactions",
      "description": "One unified feed of the caller's orders, transfers, and ramps."
    },
    {
      "name": "Gateway: Assets",
      "description": "Browse the unified catalog of tradeable assets across DeFi and CeFi venues."
    },
    {
      "name": "Gateway: Balances",
      "description": "Query account balances for the authenticated user."
    },
    {
      "name": "Gateway: Positions",
      "description": "Query a user's open Hyperliquid perpetual positions."
    },
    {
      "name": "Institutional: Service",
      "description": "Health checks and API version discovery endpoints. These endpoints are publicly accessible and do not require authentication."
    },
    {
      "name": "Institutional: Assets",
      "description": "Query available assets on the exchange by ID or name."
    },
    {
      "name": "Institutional: Instruments",
      "description": "Query tradeable instruments (market definitions) and their statistics."
    },
    {
      "name": "Institutional: Market Data",
      "description": "Real-time market quotes and VWAP computations. These endpoints are publicly accessible and do not require authentication."
    },
    {
      "name": "Institutional: Clients",
      "description": "Retrieve and update client account information and settings."
    },
    {
      "name": "Institutional: Orders",
      "description": "Create, modify, cancel, and query orders including status, trades, and activity history."
    },
    {
      "name": "Institutional: Balances",
      "description": "Query account balances across all assets."
    },
    {
      "name": "Institutional: Transfers",
      "description": "Initiate and track fund transfers between accounts."
    },
    {
      "name": "Market data: Prices",
      "description": "Current price candles and historical price points for spot assets."
    },
    {
      "name": "Market data: Market Cap",
      "description": "Latest market capitalization for individual assets and ranked listings."
    },
    {
      "name": "Market data: Market Feed",
      "description": "Assets ranked by trending ratio or by the size of their recent price move."
    },
    {
      "name": "Market data: Streams",
      "description": "Server-sent quote streams."
    }
  ],
  "x-tagGroups": [
    {
      "name": "Auth",
      "tags": [
        "Auth: Authentication",
        "Auth: OAuth"
      ]
    },
    {
      "name": "Account",
      "tags": [
        "Account: Agreements",
        "Account: Organizations",
        "Account: Trading Setup"
      ]
    },
    {
      "name": "Gateway",
      "tags": [
        "Gateway: Quotes",
        "Gateway: Orders",
        "Gateway: Transfers",
        "Gateway: Ramps",
        "Gateway: Custody",
        "Gateway: Paper Trading",
        "Gateway: Transactions",
        "Gateway: Assets",
        "Gateway: Balances",
        "Gateway: Positions"
      ]
    },
    {
      "name": "Institutional",
      "tags": [
        "Institutional: Service",
        "Institutional: Assets",
        "Institutional: Instruments",
        "Institutional: Market Data",
        "Institutional: Clients",
        "Institutional: Orders",
        "Institutional: Balances",
        "Institutional: Transfers"
      ]
    },
    {
      "name": "Market data",
      "tags": [
        "Market data: Prices",
        "Market data: Market Cap",
        "Market data: Market Feed",
        "Market data: Streams",
        "Market data: CeFi"
      ]
    }
  ],
  "paths": {
    "/v1/auth/token/refresh": {
      "post": {
        "summary": "Refresh access token",
        "description": "Exchange a valid refresh token for a new access/refresh token pair",
        "operationId": "refreshToken",
        "tags": [
          "Auth: Authentication"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens refreshed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessTokensResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or missing refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/api-key/token": {
      "post": {
        "summary": "Exchange API key for tokens",
        "description": "Verify an ECDSA P-256 signature and issue JWT tokens. The client signs\nthe message `{key_id}.{unix_timestamp}` with their private key using ES256.\nThe timestamp must be within ±30 seconds of the server time.\n\nA personal key returns an access token and a refresh token. An organization key\nreturns an access token only, with no `refresh_token` field: mint a new token from\nthe key before `expires_in`.\n",
        "operationId": "exchangeAPIKeyToken",
        "tags": [
          "Auth: Authentication"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/APIKeyTokenExchangeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens issued successfully. A user key yields an access and refresh token; an organization key yields an access token only.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AccessTokensResponse"
                    },
                    {
                      "$ref": "#/components/schemas/OrganizationTokenResponse"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (missing fields)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key, expired, revoked, invalid signature, or timestamp out of range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/oauth/authorize": {
      "get": {
        "summary": "Start an authorization request",
        "description": "The authorization endpoint (RFC 6749 4.1.1). A valid request is\nredirected to the consent screen with its parameters intact; the\nsigned-in user's decision comes back through `/oauth/consent`.\n\nWhere a failure is reported depends on what failed. An unknown client\nor an unregistered `redirect_uri` is answered here, because the only\ntarget we could redirect to is the one we just refused to trust.\nEverything else redirects back to the client with `error` and `state`\n(RFC 6749 4.1.2.1).\n\nPKCE is required and `code_challenge_method` must be `S256`.\n",
        "operationId": "oauthAuthorize",
        "tags": [
          "Auth: OAuth"
        ],
        "security": [],
        "parameters": [
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "description": "Must match one the client registered, byte-for-byte outside loopback.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "code"
              ]
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "required": true,
            "description": "base64url SHA-256 of the client's code verifier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "S256"
              ]
            }
          },
          {
            "name": "resource",
            "in": "query",
            "required": true,
            "description": "RFC 8707 resource indicator; becomes the access token's audience.",
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "Space-delimited. Defaults to every scope the client registered for.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "Echoed back unchanged so the client can detect an unsolicited response.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the consent screen, or back to the client's\n`redirect_uri` carrying `error` and `state`.\n",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "400": {
            "description": "Unknown client, or a redirect_uri the client did not register.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "401": {
            "description": "The client is unknown or disabled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/oauth/consent": {
      "post": {
        "summary": "Record a consent decision",
        "description": "The signed-in user's answer to the consent screen. Approving records\nthe grant and mints an authorization code; denying returns the client\nto its redirect with `error=access_denied`.\n\nThe authorize parameters are repeated here and validated again, because\nnothing but the user's browser carries them between the two requests.\n\nReturns where the browser should go rather than redirecting, since the\nconsent screen issues this as a fetch.\n",
        "operationId": "oauthConsent",
        "tags": [
          "Auth: OAuth"
        ],
        "security": [
          {
            "AuthBearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentResponse"
                }
              }
            }
          },
          "400": {
            "description": "The authorize parameters no longer validate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "403": {
            "description": "`error=login_required` — approving a sensitive scope such as\n`mcp:trade` needs a credential presented within the last few\nminutes, and this session's is older.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/oauth/token": {
      "post": {
        "summary": "Exchange a grant for tokens",
        "description": "The token endpoint (RFC 6749 4.1.3 and 6), form encoded.\n\n`authorization_code` consumes the code atomically, checks it was issued\nto this client and this `redirect_uri`, and verifies PKCE. A code is\nsingle-use: unknown, expired and already-redeemed are one answer, so a\ncaller cannot tell them apart.\n\n`refresh_token` rotates: the presented token is consumed and the\nresponse carries its replacement, minted with the stored audience and\nscopes, so neither can widen on refresh. Refresh tokens are opaque and\nsingle-use; replaying a consumed one revokes every token descended\nfrom the same grant.\n",
        "operationId": "oauthToken",
        "tags": [
          "Auth: OAuth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type",
                  "client_id"
                ],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "authorization_code",
                      "refresh_token"
                    ]
                  },
                  "client_id": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "description": "Required for authorization_code."
                  },
                  "redirect_uri": {
                    "type": "string",
                    "format": "uri",
                    "description": "Required for authorization_code; must match the authorize request."
                  },
                  "code_verifier": {
                    "type": "string",
                    "description": "Required for authorization_code."
                  },
                  "refresh_token": {
                    "type": "string",
                    "description": "Required for refresh_token."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthTokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_grant` for a bad, expired, replayed or mismatched code or\nPKCE verifier; `unsupported_grant_type` otherwise.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "401": {
            "description": "The client is unknown or disabled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/.well-known/oauth-resource-jwks.json": {
      "get": {
        "summary": "OAuth resource token key set",
        "description": "The key set for OAuth resource tokens, served separately from\n`/.well-known/jwks.json`.\n\nResource tokens are signed with their own key, so a resource token\npresented to a first-party verifier fails signature verification.\nOnly resource servers fetch this document.\n",
        "operationId": "oauthResourceJWKS",
        "tags": [
          "Auth: OAuth"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The resource token key set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JWKSResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/oauth/authorize/details": {
      "get": {
        "summary": "Describe an authorization request",
        "description": "What the consent screen renders: who is asking, for what, and whether\nwe vouch for the name.\n\nIt validates the same request `/oauth/authorize` did, so the screen\ncannot be made to describe a grant that would not actually be issued.\n\n`unverified` is true for a client that registered itself and chose its\nown name. `redirect_host` is shown beside the name because the host is\nthe part a client cannot assert freely.\n",
        "operationId": "oauthAuthorizeDetails",
        "tags": [
          "Auth: OAuth"
        ],
        "security": [],
        "parameters": [
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "code"
              ]
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "S256"
              ]
            }
          },
          {
            "name": "resource",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request as the consent screen should present it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizeClientResponse"
                }
              }
            }
          },
          "400": {
            "description": "The authorize request does not validate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "401": {
            "description": "The client is unknown or disabled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/oauth/consents": {
      "get": {
        "summary": "List connected apps",
        "description": "The user's standing OAuth grants, newest first.",
        "operationId": "listOAuthConsents",
        "tags": [
          "Auth: OAuth"
        ],
        "security": [
          {
            "AuthBearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The user's live grants",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ConsentGrantResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/oauth/consents/{client_id}": {
      "delete": {
        "summary": "Revoke a connected app",
        "description": "Withdraws the grant and revokes the refresh tokens minted from it, so\nthe client cannot mint a fresh access token once its current one\nlapses. An access token already issued stays valid until it expires.\n",
        "operationId": "revokeOAuthConsent",
        "tags": [
          "Auth: OAuth"
        ],
        "security": [
          {
            "AuthBearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "client_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Grant revoked"
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          },
          "404": {
            "description": "The user has no live grant for this client.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/oauth/register": {
      "post": {
        "summary": "Register an OAuth client",
        "description": "Dynamic client registration (RFC 7591). A remote MCP client — Claude,\nMeta Muse, MCP Inspector — calls this itself before starting an\nauthorization flow; none of them can be handed a `client_id` out of\nband.\n\nRegistration is open in mechanism and closed in reach: every\n`redirect_uri` must belong to one known client vendor, and a caller\nwhose callback belongs to none is refused. Clients registered here are\npublic, use PKCE with S256, and are marked unverified on the consent\nscreen because their name is self-asserted.\n\nErrors answer in the OAuth envelope (RFC 6749 5.2), not the usual one.\n",
        "operationId": "registerOAuthClient",
        "tags": [
          "Auth: OAuth"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterOAuthClientRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Client registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterOAuthClientResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid client metadata, or a redirect_uri belonging to no known\nvendor. `error` is `invalid_redirect_uri`, `invalid_client_metadata`\nor `invalid_scope`.\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthError"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/oauth-authorization-server": {
      "servers": [
        {
          "url": "https://api.truemarkets.co",
          "description": "Production"
        },
        {
          "url": "https://api.uat.truemarkets.co",
          "description": "UAT"
        }
      ],
      "get": {
        "summary": "Authorization server metadata",
        "description": "RFC 8414 discovery. A remote MCP client fetches this to learn where to\nregister and authorize, having been configured with nothing but the\nMCP server URL.\n\n`issuer` must equal the origin this document is served from, which is\nwhy it is mounted at the root rather than under `/v1/auth`. The\nendpoints it names do sit under that base path; RFC 8414 does not\nrequire them to share the issuer's prefix.\n\nServed `no-store`: a client that cached this across a key or endpoint\nrotation would fail in a way that looks like our outage.\n",
        "operationId": "oauthAuthorizationServerMetadata",
        "tags": [
          "Auth: OAuth"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The authorization server's published identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationServerMetadata"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/me/trading": {
      "get": {
        "operationId": "getTradingSetup",
        "tags": [
          "Account: Trading Setup"
        ],
        "summary": "Get the user's trading setup",
        "description": "Returns how the user is set up to trade and to settle, independent of their KYC status.\n\n- `wallets` lists the wallets the user holds: `main`, their own wallet, and `strategies`,\n  the wallet strategies trade from. A wallet the user does not hold is omitted. Each\n  `main` address reports `settlement_authority`: whether the user has authorized\n  settlement of CeFi trades on that chain.\n- `trading.cefi` is enabled once the user has a CeFi trading account; `accounts` lists\n  them, each naming the wallet it settles against and its `client_id`.\n- `trading.defi` is enabled once the user holds a `main` wallet.\n- `settlement.defi` is enabled when CeFi trading is enabled and every `main` address has\n  settlement authority. `settlement.paxos` is enabled once the user has a Paxos account.\n\nA CeFi listing can be traded when `trading.cefi.enabled` and the `settlement` rail the\nlisting settles on are both enabled.\n\nAn organization token reads one of its users' setup with `TM-On-Behalf-Of`.\n",
        "security": [
          {
            "AccountBearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountOnBehalfOf"
          }
        ],
        "responses": {
          "200": {
            "description": "The user's trading setup",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TradingSetupResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AccountUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/AccountForbidden"
          },
          "500": {
            "$ref": "#/components/responses/AccountInternalError"
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/organizations/{organization_id}/users": {
      "post": {
        "x-internal": false,
        "operationId": "createOrganizationUser",
        "tags": [
          "Account: Organizations"
        ],
        "summary": "Create a user your organization trades for",
        "description": "Creates the user your organization trades for under the reference you name them by, with\ntheir wallets, or returns the existing one. Re-sending the same request is safe: a 503 means\nthe wallet step did not finish, and repeating the request completes it. Once your organization\nreaches its user limit a new reference is refused, while re-sending an existing one still works.\nUse the returned `user_id` as the `TM-On-Behalf-Of` value on trading routes.\n",
        "security": [
          {
            "AccountBearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationIdParam"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrganizationUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User already existed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationUser"
                }
              }
            }
          },
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationUser"
                }
              }
            }
          },
          "400": {
            "description": "Malformed organization id, external reference or signer public key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AccountUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/AccountForbidden"
          },
          "409": {
            "description": "The reference names a member of the organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "422": {
            "description": "The organization has reached its user limit; contact support to raise it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/AccountInternalError"
          },
          "503": {
            "description": "Service unavailable; retry the same request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          }
        }
      },
      "get": {
        "x-internal": false,
        "operationId": "listOrganizationUsers",
        "tags": [
          "Account: Organizations"
        ],
        "summary": "List the users your organization trades for",
        "description": "Returns your organization's users, newest first. Page with the opaque `cursor` from\n`pagination.next_cursor`. Supply `external_ref_id` instead to look up a single user by the\nreference you created them with; a reference matching nothing is an empty page.\n",
        "security": [
          {
            "AccountBearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationIdParam"
          },
          {
            "name": "external_ref_id",
            "in": "query",
            "required": false,
            "description": "Narrow the page to the user created under this reference.",
            "schema": {
              "$ref": "#/components/schemas/ExternalRefId"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque cursor from a prior page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum users to return; above 100 is clamped to 100 and echoed back.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationUserPage"
                }
              }
            }
          },
          "400": {
            "description": "Malformed organization id, external reference, cursor or limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AccountUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/AccountForbidden"
          },
          "500": {
            "$ref": "#/components/responses/AccountInternalError"
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/organizations/{organization_id}/users/{user_id}": {
