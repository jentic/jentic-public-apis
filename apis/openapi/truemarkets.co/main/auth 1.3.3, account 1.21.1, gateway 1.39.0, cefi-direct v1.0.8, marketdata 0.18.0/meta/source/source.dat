    "/v1/gateway/orders/all/cancel": {
      "post": {
        "operationId": "cancelAllOrders",
        "summary": "Cancel all open orders on a venue",
        "description": "Cancels all of your open orders on the given venue and returns how many\nwere canceled. Cancellation is asynchronous — confirm final per-order\nstate via `GET /orders`. Only `cefi` is supported today; `defi` returns\n`501 Not Implemented`.\n",
        "tags": [
          "Gateway: Orders"
        ],
        "security": [
          {
