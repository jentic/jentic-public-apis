    "/v1/cefi/orders/{ref_id}": {
      "delete": {
        "tags": [
          "Institutional: Orders"
        ],
        "summary": "Cancel order",
        "description": "Begins the cancellation process of an existing active order from the exchange. N.B. it is still possible to receive trades on the order that is being canceled.\n",
        "operationId": "cancelOrdersCefi",
        "responses": {
          "200": {
            "description": "Successful operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderActive"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InstitutionalBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/InstitutionalUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/InstitutionalForbidden"
          },
          "404": {
            "$ref": "#/components/responses/InstitutionalNotFound"
          },
          "408": {
            "$ref": "#/components/responses/Timeout"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMedia"
          },
          "500": {
            "$ref": "#/components/responses/InstitutionalInternalError"
          },
          "503": {
            "$ref": "#/components/responses/InstitutionalServiceUnavailable"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/XAuthUserId"
          },
          {
            "$ref": "#/components/parameters/XAuthTimestamp"
          },
          {
            "$ref": "#/components/parameters/XAuthToken"
          },
          {
            "$ref": "#/components/parameters/XAuthSignature"
          },
          {
            "name": "ref_id",
            "in": "path",
            "description": "ID of order to cancel. For id_type=exchange (default): positive integer. For id_type=client: 1-18 char ASCII string or 36-char UUID.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!^0$)[a-zA-Z0-9-]+$"
            }
          },
          {
            "name": "id_type",
            "in": "query",
            "description": "Type of ID the ref_id is, must be either 'client' or 'exchange'. If omitted will default to 'exchange'",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "client",
                "exchange"
              ]
            }
          }
        ],
        "security": [
          {
            "HMAC": []
          },
          {
            "JWT": []
          }
        ]
      },
      "servers": [
        {
          "url": "https://api.truex.co",
          "description": "Production"
        },
        {
          "url": "https://api.uat.truex.co",
          "description": "UAT (sandbox)"
        }
      ]
    },
    "/v1/cefi/orders/all": {
      "delete": {
        "tags": [
          "Institutional: Orders"
        ],
        "summary": "Cancel all orders",
        "description": "Requests cancellation of every active order belonging to the authenticated client. Processed asynchronously: the gateway dispatches a cancel per order and returns **202 Accepted** immediately, listing the orders a cancel was dispatched for in `accepted`. Per-order completion is reported on the order event stream (cancel reports), not in this response. N.B. it is still possible to receive trades on an order while it is being canceled.\n",
        "operationId": "cancelAllOrdersCefi",
        "responses": {
          "202": {
            "description": "Request accepted; cancellations are processed asynchronously.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelAllOrdersAccepted"
                }
              }
            }
          },
          "401": {
