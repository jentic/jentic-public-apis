          }
        }
      },
      "patch": {
        "operationId": "modifyOrder",
        "tags": [
          "Gateway: Orders"
        ],
        "summary": "Modify an active limit order",
        "description": "Changes the price and/or quantity of an active CeFi limit order. The change\nis asynchronous: the order's stored price and quantity update once the\nexchange confirms the modification. Only active limit orders are modifiable.\n",
