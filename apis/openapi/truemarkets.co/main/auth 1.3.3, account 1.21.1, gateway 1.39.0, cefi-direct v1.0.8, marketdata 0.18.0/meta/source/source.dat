            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The ranking at each bucket of the window",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - unknown source or invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "404": {
            "description": "No ranking data in the window",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/defi/market/market-data/market-cap/history": {
      "get": {
        "summary": "Get reported market-cap history",
        "operationId": "getMarketCapHistory",
        "tags": [
          "Market data: Market Cap"
        ],
        "description": "Returns an asset's reported market capitalisation in USD over a\nconfigurable lookback window, sampled at a configurable resolution.\n\nEach point is the figure the data provider reported at that timestamp.\nThe snapshot is written on the provider's ingest cadence, which is\ncoarser than a minute, so a `resolution` of at least `1h` is what the\nseries can actually fill. Buckets with no snapshot behind them are\nabsent rather than zero.\n\nSee the [Time Window & Resolution](#section/Time-Window-and-Resolution)\nsection for the format of `window` and `resolution`.\n",
        "security": [],
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "description": "Asset symbol to fetch market cap for (e.g. `SOL`, `BTC`).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "window",
            "in": "query",
            "description": "Lookback period (e.g. `1h`, `4h`, `1d`, `7d`, `1M`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1h"
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "description": "Bucket size (e.g. `5m`, `1h`, `1d`). Must be at least `1h` for windows over `1d`.",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5s"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reported market-cap series for the requested asset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketCapHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "404": {
            "description": "Unknown symbol, or no market-cap data in the window",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/defi/market/market-data/trending": {
