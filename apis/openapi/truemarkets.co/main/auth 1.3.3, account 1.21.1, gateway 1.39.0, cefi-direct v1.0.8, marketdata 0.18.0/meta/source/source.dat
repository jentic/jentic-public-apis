            "$ref": "#/components/parameters/XAuthUserId"
          },
          {
            "$ref": "#/components/parameters/XAuthTimestamp"
          },
          {
            "$ref": "#/components/parameters/XAuthToken"
          },
          {
            "$ref": "#/components/parameters/XAuthSignature"
          }
        ],
        "security": [
          {
            "HMAC": []
          },
          {
            "JWT": []
          }
        ]
      },
      "servers": [
