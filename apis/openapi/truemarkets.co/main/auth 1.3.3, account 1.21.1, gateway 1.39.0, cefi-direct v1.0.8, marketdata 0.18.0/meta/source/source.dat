    "/v1/cefi/orders": {
      "get": {
        "tags": [
          "Institutional: Orders"
        ],
        "summary": "Get orders",
        "description": "Fetches all orders for a client entered within the past 24 hours on the exchange. A filter can be provided to limit the results.",
        "operationId": "getOrdersPluralCefi",
        "parameters": [
          {
            "$ref": "#/components/parameters/XAuthUserId"
          },
          {
            "$ref": "#/components/parameters/XAuthTimestamp"
          },
          {
            "$ref": "#/components/parameters/XAuthToken"
          },
          {
            "$ref": "#/components/parameters/XAuthSignature"
          },
          {
            "name": "size",
            "in": "query",
            "description": "Number of records to return per page. Maximum allowed value is 100.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "skip",
            "in": "query",
            "description": "Number of records to skip before returning results. Used for offset-based pagination.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          },
          {
            "name": "timestamp",
            "in": "query",
            "description": "A Unix UTC timestamp in nanoseconds used as a reference point for fetching orders. The query will retrieve results created **before** this timestamp, enabling precise time-based filtering and ensuring stable pagination. If omitted, the server responds with **400 BAD REQUEST**.\n",
            "required": true,
            "schema": {
              "type": "string",
              "example": "1741523275598727336",
              "pattern": "^[0-9]{19}$"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Comma-separated list of order statuses to filter by.",
            "required": false,
            "schema": {
              "type": "string"
            },
            "examples": {
              "single": {
                "summary": "Filter for active orders",
                "value": "ACTIVE"
              },
              "multiple": {
                "summary": "Filter for filled and canceled orders",
                "value": "FILLED,CANCELED"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderTrade"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InstitutionalBadRequest"
