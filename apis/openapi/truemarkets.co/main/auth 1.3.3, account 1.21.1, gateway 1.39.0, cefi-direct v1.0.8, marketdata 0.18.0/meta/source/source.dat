    "/v1/cefi/transfers": {
      "get": {
        "tags": [
          "Institutional: Transfers"
        ],
        "summary": "Get transfer",
        "description": "Fetches all transfers for a client within the past 24 hours on the exchange.",
        "operationId": "getTransfersPluralCefi",
