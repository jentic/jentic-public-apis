    "/v1/cefi/clients/fees": {
      "get": {
        "tags": [
          "Institutional: Clients"
        ],
        "summary": "Get client fees",
        "description": "Returns a client's maker and taker fee tiers and the fee rates those tiers currently resolve to. Rates are decimal fractions of trade notional (`\"0.003\"` is 0.3%). A tier with no configured fee resolves to `\"0\"`. JWT callers may omit `client_id` to read their own client; an HMAC caller without `client_id` reads the client named by `X-Truex-Auth-UserId`.\n",
        "operationId": "getClientFeesCefi",
        "parameters": [
          {
            "$ref": "#/components/parameters/XAuthUserId"
          },
          {
            "$ref": "#/components/parameters/XAuthTimestamp"
          },
          {
            "$ref": "#/components/parameters/XAuthToken"
          },
          {
            "$ref": "#/components/parameters/XAuthSignature"
          },
          {
            "name": "client_id",
            "in": "query",
            "description": "Exchange generated client ID to query fees for. Must be a client the caller may access.\n",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation.",
