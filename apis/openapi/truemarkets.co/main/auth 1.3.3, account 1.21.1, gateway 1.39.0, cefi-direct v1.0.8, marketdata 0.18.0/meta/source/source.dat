    "/v1/defi/market/market-data/perp/history": {
      "get": {
        "summary": "Get perp funding rate and open interest history",
        "operationId": "getPerpMarketHistory",
        "tags": [
          "Market data: Market Feed"
        ],
        "description": "Returns a perpetual future's funding rate and open interest over a\nconfigurable lookback window, sampled at a configurable resolution.\nBoth series come from the same venue snapshot row, so a caller reading\nthem together never compares values sampled at different times.\n\n`funding_rate` is the venue's hourly rate as a decimal fraction, so\n`0.0000125` is 0.00125% per hour. `open_interest` is a coin count of the\nbase asset (`35984.2` for BTC), not a USD notional.\n\nSee the [Time Window & Resolution](#section/Time-Window-and-Resolution)\nsection for the format of `window` and `resolution`.\n",
        "security": [],
        "parameters": [
          {
            "name": "asset_id",
            "in": "query",
            "description": "Backend asset ID. Mutually exclusive with `symbol`: exactly one of\nthe two is required, and naming both is a 400.\n",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "description": "Perp symbol to fetch the snapshot series for (e.g. `BTC`).",
            "required": false,
            "deprecated": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "window",
            "in": "query",
            "description": "Lookback period (e.g. `1h`, `4h`, `1d`, `7d`, `1M`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1h"
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "description": "Bucket size (e.g. `5m`, `1h`, `1d`). Must be at least `1h` for windows over `1d`.",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5s"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Funding rate and open interest series for the requested perp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PerpMarketHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "404": {
            "description": "Unknown perp, or no snapshot in the window",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/defi/market/market-data/volume/history": {
      "get": {
        "summary": "Get reported 24h volume history",
        "operationId": "getVolumeHistory",
        "tags": [
          "Market data: Market Feed"
        ],
        "description": "Returns an asset's reported 24h volume in USD over a configurable\nlookback window, sampled at a configurable resolution.\n\nEach point is the rolling 24h figure the data provider reported at that\ntimestamp, not the volume traded inside the bucket. Two adjacent points\ntherefore overlap by almost a full day.\n\nSee the [Time Window & Resolution](#section/Time-Window-and-Resolution)\nsection for the format of `window` and `resolution`.\n",
        "security": [],
        "parameters": [
          {
            "name": "asset_id",
            "in": "query",
            "description": "Backend asset ID. Mutually exclusive with `symbol`: exactly one of\nthe two is required, and naming both is a 400.\n",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "description": "Asset symbol to fetch reported volume for (e.g. `SOL`, `BTC`).",
            "required": false,
            "deprecated": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "window",
            "in": "query",
            "description": "Lookback period (e.g. `1h`, `4h`, `1d`, `7d`, `1M`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1h"
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "description": "Bucket size (e.g. `5m`, `1h`, `1d`). Must be at least `1h` for windows over `1d`.",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5s"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reported 24h volume series for the requested asset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VolumeHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "404": {
            "description": "Unknown asset, no reported-volume source, or no data in the window",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/defi/market/market-data/scans/history": {
      "get": {
        "summary": "Get a market ranking at every bucket of a window",
        "operationId": "getScanHistory",
        "tags": [
          "Market data: Market Feed"
        ],
        "description": "Returns the ranking a scanner or a universe rotation is built on, taken\nat every bucket across a lookback window rather than only at now.\n\nEvery span a ranking measures is read backwards from its own bucket, so\nno bucket reflects a figure the market had not reported yet. Ranking a\nmonth of hourly buckets over the whole tracked universe would be\nhundreds of thousands of rows, so each bucket carries only its top\n`per_bucket` assets, ordered best first on the requested `source`.\nAssets without a symbol or without a spot price source are dropped, the\nsame way the live feeds drop them.\n\n`value` is the figure the source ranks on: a trending ratio, a recent\nvolume in USD, or a signed price change percentage. Ranking is on that\nsigned figure, so `sort=desc` on a `surging_*` source is the gainers and\n`sort=asc` is the fallers.\n\nSee the [Time Window & Resolution](#section/Time-Window-and-Resolution)\nsection for the format of `window` and `resolution`.\n",
        "security": [],
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "description": "Which ranking to take.",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "trending_ratio",
                "volume",
                "surging_1h",
                "surging_4h",
                "surging_24h"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Which end of the ranking each bucket keeps. Buckets are capped before they are served, so this must match the sort the caller will rank by: a \"biggest dippers\" scanner asking for `desc` would be handed the gainers it was never going to buy.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "desc",
                "asc"
              ],
              "default": "desc"
            }
          },
          {
            "name": "window",
            "in": "query",
            "description": "Lookback period (e.g. `1h`, `4h`, `1d`, `7d`, `1M`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1h"
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "description": "Bucket size (e.g. `5m`, `1h`, `1d`). Must be at least `1h` for windows over `1d`.",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5s"
            }
          },
          {
            "name": "per_bucket",
            "in": "query",
