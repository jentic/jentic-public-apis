    "/v1/defi/market/stream/bbo": {
      "get": {
        "summary": "Stream BBO quotes",
        "operationId": "streamBboQuotes",
        "tags": [
          "Market data: Streams"
        ],
        "description": "Server-sent stream of best bid and offer quotes as each source publishes them, one `bbo` event per update and a comment frame between updates to keep the connection open.",
        "security": [],
        "responses": {
          "200": {
            "description": "The quote stream. Held open until the client disconnects.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "description": "The per-IP or global concurrent stream limit is already reached.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "500": {
            "description": "The connection cannot be streamed over.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "503": {
            "description": "The quote source is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "Probe the BBO stream",
        "operationId": "probeBboStream",
        "tags": [
          "Market data: Streams"
        ],
        "description": "Returns the stream's headers with no body, without opening a subscription or counting against the connection limits.",
        "security": [],
        "responses": {
          "200": {
            "description": "The stream is reachable."
          }
        }
      }
    },
    "/v1/assets/prices/history": {
      "get": {
        "summary": "Get price history for an asset",
        "operationId": "getAssetPriceHistory",
        "tags": [
          "Market data: Prices"
        ],
        "description": "Returns historical price points for an asset over a configurable lookback\nwindow, sampled at a configurable resolution.\n\nThe same series as `/v1/defi/market/prices/history`, mounted under the\nasset-oriented path. This mount stores no individual ticks, so candle\nendpoints and candle-input indicators are unavailable here.\n\nSee the [Time Window & Resolution](#section/Time-Window-and-Resolution)\nsection for the format of `window` and `resolution`.\n",
        "security": [],
        "parameters": [
          {
            "name": "asset_id",
            "in": "query",
            "description": "Backend asset ID. Mutually exclusive with `symbol`: exactly one of\nthe two is required, and naming both is a 400.\n",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "description": "Asset symbol (e.g. `SOL`, `BTC`).",
            "required": false,
            "deprecated": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "window",
            "in": "query",
            "description": "Lookback period (e.g. `1h`, `4h`, `1d`, `7d`, `1M`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1h"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "description": "Ends the window at this instant instead of now, so a past period can be read. RFC3339, and must not be in the future or the zero time. Absent reads live data.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2026-01-02T03:04:05Z"
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "description": "Gap between consecutive data points (e.g. `5s`, `1m`, `5m`, `1h`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5s"
            }
          },
          {
            "name": "asset_class",
            "in": "query",
            "description": "Asset class to resolve the asset in. Defaults to `spot`.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "spot",
                "perp"
              ],
              "default": "spot"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Price history data for the requested asset",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "404": {
            "description": "Asset not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/assets/prices/range": {
