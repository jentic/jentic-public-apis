      "MarketDataError": {
        "type": "object",
        "description": "Shared API error envelope",
        "required": [
          "type",
          "message",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Closed error category fixing the HTTP status",
            "enum": [
              "invalid_argument",
              "unauthenticated",
              "permission_denied",
              "not_found",
              "method_not_allowed",
              "conflict",
              "failed_precondition",
              "resource_exhausted",
              "unavailable",
              "internal"
            ]
          },
          "code": {
            "type": "string",
            "description": "Specific error condition from the fleet code registry. Extensible: clients MUST tolerate any value and fall back to type-based handling. No operation here emits one today."
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "metadata": {
            "type": "object",
            "description": "Machine-readable context scoped to `code`; values are always strings. Which keys appear is determined by `code`.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "field_violations": {
            "type": "array",
            "description": "Per-field rejections, present on `invalid_argument` when the request failed field validation.",
            "items": {
              "type": "object",
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Dotted path to the offending field, as the client sent it"
                },
                "message": {
                  "type": "string",
                  "description": "Human-readable reason the field was rejected"
                }
              }
            }
          },
          "request_id": {
            "type": "string",
            "description": "Per-request correlation ID, empty when unavailable"
          }
        }
      },
      "MarketCapResponse": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "The asset symbol"
          },
          "market_cap": {
            "type": "string",
            "description": "Market capitalization in USD (as string to preserve precision)"
          }
        }
      },
      "MarketCapListResponse": {
        "type": "object",
        "properties": {
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MarketCapResponse"
            },
            "description": "List of assets with market cap, sorted by market cap descending"
          }
        }
      },
      "PriceResponse": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "The asset symbol"
          },
          "candles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candle"
            },
            "description": "List of price candles for different time intervals"
          }
        }
      },
      "Candle": {
        "type": "object",
        "properties": {
          "interval": {
            "type": "string",
            "description": "Time interval for the candle (e.g., 1h, 4h, 24h)"
          },
          "openPrice": {
            "type": "string",
            "description": "Opening price for the interval"
          },
          "closePrice": {
            "type": "string",
            "description": "Closing price for the interval"
          },
          "highPrice": {
            "type": "string",
            "description": "Highest price during the interval"
          },
          "lowPrice": {
            "type": "string",
            "description": "Lowest price during the interval"
          }
        }
      },
      "PricePointResponse": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid",
            "description": "Backend asset ID. Absent on the CeFi routes."
          },
          "symbol": {
            "type": "string",
            "description": "The asset symbol"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Unix timestamp of the actual data point returned"
          },
          "price": {
            "type": "string",
            "description": "Price at the returned timestamp"
          }
        }
      },
      "PriceRangeResponse": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid",
            "description": "Backend asset ID. Absent on the CeFi routes."
          },
          "symbol": {
            "type": "string",
            "description": "The asset symbol"
          },
          "window": {
            "type": "string",
            "description": "The time window used for the query"
          },
          "min_price": {
            "type": "string",
            "description": "Minimum price within the window"
          },
          "max_price": {
            "type": "string",
            "description": "Maximum price within the window"
          },
          "min_timestamp": {
            "type": "string",
            "description": "ISO 8601 timestamp when the minimum price occurred"
          },
          "max_timestamp": {
            "type": "string",
            "description": "ISO 8601 timestamp when the maximum price occurred"
          }
        }
      },
      "PerpMarketHistoryResponse": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid",
            "description": "Backend asset ID of the perp"
          },
          "symbol": {
            "type": "string",
            "description": "The perp symbol"
          },
          "window": {
            "type": "string",
            "description": "The time window used for the query"
          },
          "resolution": {
            "type": "string",
            "description": "The time resolution used for the query"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PerpMarketPoint"
            },
            "description": "Funding rate and open interest buckets, oldest first"
          }
        }
      },
      "PerpMarketPoint": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the bucket"
          },
          "funding_rate": {
            "type": "string",
            "description": "Hourly funding rate as a decimal fraction (0.0000125 is 0.00125% per hour)"
          },
          "open_interest": {
            "type": "string",
            "description": "Open interest as a coin count of the base asset, not a USD notional"
          }
        }
      },
      "VolumeHistoryResponse": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid",
            "description": "Backend asset ID"
          },
          "symbol": {
            "type": "string",
            "description": "The asset symbol"
          },
          "window": {
            "type": "string",
            "description": "The time window used for the query"
          },
          "resolution": {
            "type": "string",
            "description": "The time resolution used for the query"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VolumePoint"
            },
            "description": "Reported 24h volume buckets, oldest first"
          }
        }
      },
      "VolumePoint": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the bucket"
          },
          "volume": {
            "type": "string",
            "description": "Reported rolling 24h volume in USD at this timestamp"
          }
        }
      },
      "ScanCandidate": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "The asset symbol"
          },
          "value": {
            "type": "string",
            "description": "The figure the source ranks on, signed for a price change"
          }
        }
      },
      "ScanBucket": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the bucket"
          },
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanCandidate"
            },
            "description": "The bucket's top assets, best first"
          }
        }
      },
      "ScanHistoryResponse": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "The ranking that was taken"
          },
          "sort": {
            "type": "string",
            "description": "Which end of the ranking each bucket kept"
          },
          "window": {
            "type": "string",
            "description": "The time window used for the query"
          },
          "resolution": {
            "type": "string",
            "description": "The time resolution used for the query"
          },
          "per_bucket": {
            "type": "integer",
            "description": "The most assets any bucket carries"
          },
          "buckets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanBucket"
            },
            "description": "One ranking per bucket, oldest first"
          }
        }
      },
      "MarketCapHistoryResponse": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string",
            "description": "The asset symbol"
          },
          "window": {
            "type": "string",
            "description": "The time window used for the query"
          },
          "resolution": {
            "type": "string",
            "description": "The time resolution used for the query"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MarketCapPoint"
            },
            "description": "Reported market-cap buckets, oldest first"
          }
        }
      },
      "MarketCapPoint": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of the bucket"
          },
          "market_cap": {
            "type": "string",
            "description": "Reported market capitalisation in USD at this timestamp"
          }
        }
      },
      "PriceHistoryResponse": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid",
            "description": "Backend asset ID. Absent on the CeFi routes."
          },
          "symbol": {
            "type": "string",
            "description": "The asset symbol"
          },
          "window": {
            "type": "string",
            "description": "The time window used for the query"
          },
          "resolution": {
            "type": "string",
            "description": "The time resolution used for the query"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "description": "List of price points"
          }
        }
      },
      "Point": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "description": "ISO 8601 timestamp for the price point"
          },
          "price": {
            "type": "string",
            "description": "Price at this timestamp"
          }
        }
      },
      "CandleHistoryResponse": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid",
            "description": "Backend asset ID. Absent on the CeFi routes."
          },
          "symbol": {
            "type": "string",
            "description": "The asset symbol"
          },
          "window": {
            "type": "string",
            "description": "The time window used for the query"
          },
          "resolution": {
            "type": "string",
            "description": "The candle size used for the query"
          },
          "candles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CandleBucket"
            },
            "description": "List of OHLC buckets, oldest first"
          }
        }
      },
      "CandleBucket": {
        "type": "object",
        "properties": {
          "t": {
            "type": "string",
            "description": "ISO 8601 timestamp of the bucket start"
          },
          "open": {
            "type": "string",
            "description": "First price in the bucket"
          },
          "high": {
            "type": "string",
            "description": "Highest price in the bucket"
          },
          "low": {
            "type": "string",
            "description": "Lowest price in the bucket"
          },
          "close": {
            "type": "string",
            "description": "Last price in the bucket"
          }
        }
      },
      "BatchPriceHistoryResponse": {
        "type": "object",
        "properties": {
          "window": {
            "type": "string",
            "description": "The time window used for the query"
          },
          "resolution": {
            "type": "string",
            "description": "The time resolution used for the query"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchPriceHistoryResult"
            },
            "description": "Per-symbol results"
          }
        }
      },
      "BatchPriceHistoryResult": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "format": "uuid",
            "description": "Backend asset ID. Absent on the CeFi routes."
          },
          "symbol": {
            "type": "string",
            "description": "The asset symbol"
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "description": "Price points (omitted if error)"
          },
          "error": {
            "type": "string",
            "description": "Error message if the symbol could not be resolved (omitted on success)"
          }
        }
      }
    },
    "parameters": {
      "OrganizationIdParam": {
        "name": "organization_id",
        "in": "path",
        "required": true,
        "description": "Your organization's id: the `tm.organization_id` claim of an organization token, also shown on the console Overview. The token must be this organization's, or belong to one of its admins.\n",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "AccountOnBehalfOf": {
        "name": "TM-On-Behalf-Of",
        "in": "header",
        "required": false,
        "description": "Act as one of your organization's users. The value is the `user_id` returned when the user was created; the request then reads that user's account. Requires an organization token and a user your organization created: `400` for a personal token, a repeated header or a non-UUID, `403` for a user outside your organization.\n",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "3f6d2c0e-8a41-4c2b-9f1e-2b7d5c0a9e11"
      },
      "GatewayOnBehalfOf": {
        "name": "TM-On-Behalf-Of",
        "in": "header",
        "required": false,
        "description": "Act as one of your organization's users. The value is the `user_id` returned when the user was created; the request then reads and writes that user's account. Requires an organization token and a user your organization created: `400` for a personal token, a repeated header or a non-UUID, `403` for a user outside your organization. Not accepted on organization-scoped routes.\n",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "3f6d2c0e-8a41-4c2b-9f1e-2b7d5c0a9e11"
      },
      "XTruexVersion": {
        "in": "header",
        "name": "X-Truex-Version",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "v2024_01_01",
            "v2026_01_23"
          ],
          "default": "v2024_01_01"
        },
        "description": "API version to use for the request. Controls response format: - `v2024_01_01` (default, deprecated — sunset August 5, 2026): Raw data arrays/objects - `v2026_01_23`: Envelope format with `{ \"data\": [...], \"pagination\": {...} }`\n"
      },
      "XAuthUserId": {
        "in": "header",
        "name": "x-truex-auth-userid",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "HMAC only. The client the request acts for. Omit it with a JWT, which carries your client id."
      },
      "XAuthTimestamp": {
        "in": "header",
        "name": "x-truex-auth-timestamp",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Timestamp when request was made in seconds since epoch. Must be no older than 15 seconds and no more than 1 second in the future. Required with both JWT and HMAC authentication; it guards against replayed requests."
      },
      "XAuthToken": {
        "in": "header",
        "name": "x-truex-auth-token",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "HMAC only. The UUID affiliated with the HMAC key. Omit it with a JWT."
      },
      "XAuthSignature": {
        "in": "header",
        "name": "x-truex-auth-signature",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "HMAC only. The computed HMAC signature. Omit it with a JWT."
      },
      "FeedLimit": {
        "name": "limit",
        "in": "query",
        "description": "Assets to return.",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        }
      },
      "FeedSort": {
        "name": "sort",
        "in": "query",
        "description": "Rank ascending instead of descending.",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "default": "desc"
        }
      }
    },
    "responses": {
      "AccountUnauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AccountError"
            }
          }
        }
      },
      "AccountForbidden": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AccountError"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AccountError"
            }
          }
        }
      },
      "AccountInternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AccountError"
            }
          }
        }
      },
      "GatewayBadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            }
          }
        }
      },
      "GatewayUnauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            }
          }
        }
      },
      "GatewayForbidden": {
        "description": "Forbidden. On order creation this also covers an asset that is not available to trade from the country the request came from.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            }
          }
        }
      },
      "GatewayNotFound": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Request is well-formed but cannot be processed (e.g. leverage missing or out of range for a perp order)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            }
          }
        }
      },
      "GatewayInternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            }
          }
        }
      },
      "GatewayServiceUnavailable": {
        "description": "Service unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            }
          }
        }
      },
      "InstitutionalBadRequest": {
        "description": "Bad request.",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InstitutionalUnauthorized": {
        "description": "Unauthorized.",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InstitutionalForbidden": {
        "description": "Forbidden.",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InstitutionalNotFound": {
        "description": "Not found.",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Timeout": {
        "description": "Request timeout.",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "UnsupportedMedia": {
        "description": "Unsupported media type.",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InstitutionalInternalError": {
        "description": "Internal server error.",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "InstitutionalServiceUnavailable": {
        "description": "Service unavailable.",
        "content": {
          "application/problem+json": {
            "schema": {
              "type": "object",
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
