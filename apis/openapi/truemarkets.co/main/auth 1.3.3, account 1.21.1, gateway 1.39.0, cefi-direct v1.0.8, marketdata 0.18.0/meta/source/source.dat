              "$ref": "#/components/schemas/ReleaseStatus"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque pagination cursor from the previous page's `next_cursor`",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
