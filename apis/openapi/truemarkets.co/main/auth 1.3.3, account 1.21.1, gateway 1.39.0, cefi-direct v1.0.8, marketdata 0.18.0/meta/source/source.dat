    "/v1/defi/market/prices": {
      "get": {
        "summary": "Get price candles by symbol",
        "operationId": "getPrices",
        "tags": [
          "Market data: Prices"
        ],
        "description": "Returns the latest price candles (open/high/low/close) for an asset across\nmultiple standard intervals (1h, 4h, 24h). Useful for rendering at-a-glance\nprice summaries.\n",
        "security": [],
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "description": "Asset symbol to fetch candles for (e.g. `SOL`, `BTC`).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "asset_class",
            "in": "query",
            "description": "Asset class to resolve the symbol in. Defaults to `spot`; if the\nsymbol has no spot listing at all, falls back to `perp`.\n",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "spot",
                "perp"
              ],
              "default": "spot"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Price candle data for the requested symbol",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - symbol parameter is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "404": {
            "description": "Symbol not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/defi/market/prices/history": {
      "get": {
        "summary": "Get price history for a symbol",
        "operationId": "getPriceHistory",
        "tags": [
          "Market data: Prices"
        ],
        "description": "Returns historical price points for an asset over a configurable lookback\nwindow, sampled at a configurable resolution. Use for charting and\ntime-series analysis.\n\nSee the [Time Window & Resolution](#section/Time-Window-and-Resolution)\nsection for the format of `window` and `resolution`.\n",
        "security": [],
        "parameters": [
          {
            "name": "asset_id",
            "in": "query",
            "description": "Backend asset ID. Mutually exclusive with `symbol`: exactly one of\nthe two is required, and naming both is a 400.\n",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "description": "Asset symbol to fetch history for (e.g. `SOL`, `BTC`).",
            "required": false,
            "deprecated": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "window",
            "in": "query",
            "description": "Lookback period (e.g. `1h`, `4h`, `1d`, `7d`, `1M`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1h"
            }
          },
          {
            "name": "as_of",
            "in": "query",
            "description": "Ends the window at this instant instead of now, so a past period can be read. RFC3339, and must not be in the future or the zero time. Absent reads live data.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2026-01-02T03:04:05Z"
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "description": "Gap between consecutive data points (e.g. `5s`, `1m`, `5m`, `1h`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5s"
            }
          },
          {
            "name": "asset_class",
            "in": "query",
            "description": "Asset class to resolve the symbol in. Defaults to `spot`.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "spot",
                "perp"
              ],
              "default": "spot"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Price history data for the requested symbol",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "404": {
            "description": "Symbol not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/defi/market/prices/history/point": {
      "get": {
        "summary": "Get price at a point in time",
        "operationId": "getPriceAtTime",
        "tags": [
          "Market data: Prices"
        ],
        "description": "Returns the last known price for an asset at or before the given timestamp.\nUse this to value a position, settle a trade, or anchor a calculation to a\nspecific moment in time.\n",
        "security": [],
        "parameters": [
          {
            "name": "asset_id",
            "in": "query",
            "description": "Backend asset ID. Mutually exclusive with `symbol`: exactly one of\nthe two is required, and naming both is a 400.\n",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "description": "Asset symbol to look up (e.g. `SOL`, `BTC`).",
            "required": false,
            "deprecated": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "timestamp",
            "in": "query",
            "description": "Unix timestamp in seconds. The response returns the most recent price at or before this moment.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "asset_class",
            "in": "query",
            "description": "Asset class to resolve the symbol in. Defaults to `spot`.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "spot",
                "perp"
              ],
              "default": "spot"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Price at the requested point in time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricePointResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "404": {
            "description": "No price data found for the given symbol and timestamp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/defi/market/prices/history/batch": {
      "get": {
        "summary": "Get price history for multiple symbols",
        "operationId": "getPriceHistoryBatch",
        "tags": [
          "Market data: Prices"
        ],
        "description": "Returns price history for multiple symbols in a single request. Each symbol\nis resolved independently — an unknown or failing symbol returns a per-symbol\nerror in its result entry instead of failing the whole batch, so partial\nresults are still returned.\n\nSee the [Time Window & Resolution](#section/Time-Window-and-Resolution)\nsection for the format of `window` and `resolution`.\n",
        "security": [],
        "parameters": [
          {
            "name": "asset_ids",
            "in": "query",
            "description": "Comma-separated list of backend asset IDs. Mutually exclusive with\n`symbols`: exactly one of the two is required, and naming both is a\n400.\n",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "symbols",
            "in": "query",
            "description": "Comma-separated list of asset symbols (e.g. `SOL,BTC,ETH`).",
            "required": false,
            "deprecated": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "window",
            "in": "query",
            "description": "Lookback period (e.g. `1h`, `4h`, `1d`, `7d`, `1M`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1h"
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "description": "Gap between consecutive data points (e.g. `5s`, `1m`, `5m`, `1h`).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "5s"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Batch price history data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchPriceHistoryResponse"
                },
                "example": {
                  "window": "1h",
                  "resolution": "5s",
                  "results": [
                    {
                      "symbol": "SOL",
                      "points": [
                        {
                          "t": "2025-01-20T12:00:00Z",
                          "price": "100.50"
                        },
                        {
                          "t": "2025-01-20T12:00:05Z",
                          "price": "101.00"
                        }
                      ]
                    },
                    {
                      "symbol": "BTC",
                      "points": [
                        {
                          "t": "2025-01-20T12:00:00Z",
                          "price": "42000.00"
                        }
                      ]
                    },
                    {
                      "symbol": "UNKNOWN",
                      "error": "unknown symbol"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid parameters or missing symbols",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                },
                "examples": {
                  "missing_symbols": {
                    "summary": "No symbols provided",
                    "value": {
                      "type": "invalid_argument",
                      "message": "symbols required",
                      "request_id": "01JX2K7WQ4Z8N3RTMV9CE5A0BF"
                    }
                  },
                  "invalid_window": {
                    "summary": "Invalid window parameter",
                    "value": {
                      "type": "invalid_argument",
                      "message": "invalid window parameter",
                      "request_id": "01JX2K7WQ4Z8N3RTMV9CE5A0BF"
                    }
                  },
                  "invalid_resolution": {
                    "summary": "Invalid resolution parameter",
                    "value": {
                      "type": "invalid_argument",
                      "message": "invalid resolution parameter",
                      "request_id": "01JX2K7WQ4Z8N3RTMV9CE5A0BF"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/defi/market/prices/indicators": {
      "get": {
        "operationId": "getPriceIndicators",
        "security": [],
        "tags": [
          "Market data: Prices"
        ],
        "summary": "Get a technical indicator series",
        "description": "Returns one or more technical indicator lines computed from the asset's\nclose prices.\n\nThe requested `window` is widened internally by the indicator's warm-up\ndepth and trimmed back before responding, so the first returned point is\nalready converged rather than carrying seed bias. The window is measured\nback from the most recent available point, so a feed lagging behind the\ncurrent time still returns a full window.\n\n`lines` is keyed by line name. Single-line indicators (`sma`, `ema`,\n`rsi`, `atr`) return one entry named after the indicator. `macd`\nreturns `macd`, `signal` and `histogram`; `bollinger` returns `upper`,\n`middle`, `lower` and `percent_b`.\n\n`atr` reads OHLC candles rather than closes, so it is only available\nfor assets whose price source stores individual ticks; anything else\nreturns `400`. It is Wilder-smoothed and defaults to a period of 14.\n\nThe momentum measures cover fixed spans rather than a caller-supplied\n`period`, which is rejected for them. `surging_1h`, `surging_4h` and\n`surging_24h` are the percent price change over that span, so the\n`resolution` must be coarse enough for the span to fit in 400 buckets —\nthe same bound a supplied `period` carries.\n`trending_ratio` is average reported 24h volume over the last 6 hours\ndivided by its 30-day average, so it needs a CoinGecko-mapped asset and\na `resolution` of at least `1h`.\n\nVWAP is not offered: it needs per-bucket traded volume, which no price\nseries carries.\n",
        "parameters": [
          {
            "name": "asset_id",
            "in": "query",
            "description": "Backend asset ID. Mutually exclusive with `symbol`: exactly one of\nthe two is required, and naming both is a 400.\n",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "symbol",
            "in": "query",
            "required": false,
            "deprecated": true,
            "description": "Asset symbol (e.g. SOL, BTC)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "indicator",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "sma",
                "ema",
                "rsi",
                "macd",
                "bollinger",
                "atr",
                "surging_1h",
                "surging_4h",
                "surging_24h",
                "trending_ratio"
              ]
            }
          },
          {
            "name": "window",
            "in": "query",
            "description": "Time window for the series (e.g. 1d, 7d, 1M)",
            "schema": {
              "type": "string",
              "default": "1h"
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "description": "Candle size the period counts in (e.g. 1m, 1h, 1d)",
            "schema": {
              "type": "string",
              "default": "1m"
            }
          },
          {
            "name": "period",
            "in": "query",
            "description": "Lookback in candles. Required for sma, ema and rsi; defaults to 20\nfor bollinger and 14 for atr, and is not used by macd. Rejected\nfor the momentum measures, which cover a fixed span.\n",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 400
            }
          },
          {
            "name": "fast_period",
            "in": "query",
            "description": "MACD fast EMA length. Defaults to 12.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 400
            }
          },
          {
            "name": "slow_period",
            "in": "query",
            "description": "MACD slow EMA length. Defaults to 26; must exceed fast_period.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 400
            }
          },
          {
            "name": "signal_period",
            "in": "query",
            "description": "MACD signal EMA length. Defaults to 9.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 400
            }
          },
          {
            "name": "std_dev",
            "in": "query",
            "description": "Bollinger band width in standard deviations. Defaults to 2.",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "asset_class",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Indicator lines",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndicatorHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Unknown indicator, or a parameter out of range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "404": {
            "description": "Not enough price history to compute the indicator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketDataError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/defi/market/prices/range": {
