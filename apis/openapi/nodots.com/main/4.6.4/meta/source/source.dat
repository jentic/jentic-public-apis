{
  "openapi": "3.0.3",
  "info": {
    "title": "Nodots Backgammon API",
    "description": "REST API for managing backgammon games, users, game history, performance ratings, and XG import functionality.\n\n## Authentication\nMost endpoints require Auth0 JWT authentication. Include the token in the Authorization header:\n```\nAuthorization: Bearer <token>\n```\n\n## Game Flow\n1. Create game with two players (`POST /games`)\n2. Game auto-transitions to `rolled-for-start` state\n3. Roll dice (`POST /games/:id/roll`) → `moving` state\n4. Make moves (`POST /games/:id/move`) until turn complete\n5. Confirm turn (`POST /games/:id/confirm-turn`) → next player's turn\n6. Repeat until game reaches `completed` state\n\n## WebSocket\nReal-time updates available via Socket.IO at the same host.\n",
    "version": "4.6.4",
    "contact": {
      "name": "Ken Riley",
      "email": "kenr@nodots.com"
    },
    "license": {
      "name": "MIT"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/nodotsadvisorygroup/nodots-backgammon-api/4.6.4"
  },
  "servers": [
    {
      "url": "https://api.nodots.com/api/v1",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Games",
      "description": "Game management and gameplay"
    },
    {
      "name": "Users",
      "description": "User management"
    },
    {
      "name": "PR",
      "description": "Performance Rating calculation and retrieval"
    },
    {
      "name": "History",
      "description": "Game history and XG import/export"
    },
    {
      "name": "Stats",
      "description": "User statistics"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/games": {
      "get": {
        "summary": "List all games",
        "tags": [
          "Games"
        ],
        "responses": {
          "200": {
            "description": "List of games",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Game"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new game",
        "tags": [
          "Games"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "player1",
                  "player2"
                ],
                "properties": {
                  "player1": {
                    "type": "object",
                    "properties": {
                      "userId": {
                        "type": "string",
                        "format": "uuid"
                      }
                    }
                  },
                  "player2": {
                    "type": "object",
                    "properties": {
                      "userId": {
                        "type": "string",
                        "format": "uuid"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Game created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/games/{gameId}": {
      "get": {
        "summary": "Get game by ID",
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Game details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "404": {
            "description": "Game not found"
          }
        }
      }
    },
    "/games/{gameId}/roll": {
      "post": {
        "summary": "Roll dice",
        "description": "Roll dice for current player. Valid in `rolling` or `rolled-for-start` states.",
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Dice rolled, game transitions to `moving` state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid game state for rolling"
          }
        }
      }
    },
    "/games/{gameId}/move": {
      "post": {
        "summary": "Move a checker",
        "description": "Move a checker for the active player. Game must be in `moving` state.",
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "checkerId"
                ],
                "properties": {
                  "checkerId": {
                    "type": "string",
                    "description": "ID of the checker to move"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Move executed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid move or game state"
          }
        }
      }
    },
    "/games/{gameId}/confirm-turn": {
      "post": {
        "summary": "Confirm turn completion",
        "description": "Confirm the current player's turn and pass to the next player. Game must be in `moved` state.",
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Turn confirmed, next player's turn or game completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid game state"
          }
        }
      }
    },
    "/games/{gameId}/switch-dice": {
      "post": {
        "summary": "Switch dice order",
        "description": "Switch the order of dice (e.g., use 4 before 6 instead of 6 before 4)",
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Dice switched"
          },
          "400": {
            "description": "Invalid game state for switching"
          }
        }
      }
    },
    "/games/{gameId}/double": {
      "post": {
        "summary": "Offer double",
        "description": "Offer to double the cube. Must be in `rolling` state.",
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Double offered"
          },
          "400": {
            "description": "Cannot double in current state"
          }
        }
      }
    },
    "/games/{gameId}/accept-double": {
      "post": {
        "summary": "Accept double offer",
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Double accepted"
          },
          "400": {
            "description": "No double to accept"
          }
        }
      }
    },
    "/games/{gameId}/decline-double": {
      "post": {
        "summary": "Decline double offer",
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Double declined, game ends"
          },
          "400": {
            "description": "No double to decline"
          }
        }
      }
    },
    "/games/{gameId}/robot-move": {
      "post": {
        "summary": "Execute robot turn",
        "description": "Execute a complete robot turn (all moves). Active player must be a robot.",
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Robot turn executed"
          },
          "400": {
            "description": "Active player is not a robot"
          }
        }
      }
    },
    "/games/{gameId}/undo-last-action": {
      "post": {
        "summary": "Undo last action",
        "description": "Undo the last move in the current turn",
        "tags": [
          "Games"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Action undone"
          },
          "400": {
            "description": "Cannot undo"
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "List all users",
        "tags": [
          "Users"
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/{userId}": {
      "get": {
        "summary": "Get user by ID",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User details"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    },
    "/users/robots": {
      "get": {
        "summary": "List robot users",
        "tags": [
          "Users"
        ],
        "responses": {
          "200": {
            "description": "List of robot users"
          }
        }
      }
    },
    "/pr/games/{gameId}/post-game-pr": {
      "post": {
        "summary": "Calculate PR for completed game",
        "description": "Calculate and store Performance Rating for a completed game using GNU Backgammon analysis.",
        "tags": [
          "PR"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          },
          {
            "name": "force",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Force recalculation even if PR exists"
          }
        ],
        "responses": {
          "200": {
            "description": "PR calculated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PRResult"
                }
              }
            }
          },
          "400": {
            "description": "Game not completed"
          },
          "404": {
            "description": "Game not found"
          }
        }
      }
    },
    "/pr/games/{gameId}": {
      "get": {
        "summary": "Get PR results for game",
        "tags": [
          "PR"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "PR results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PRResult"
                }
              }
            }
          },
          "404": {
            "description": "No PR data found"
          }
        }
      }
    },
    "/pr/games/{gameId}/moves": {
      "get": {
        "summary": "Get move-level PR analysis",
        "description": "Get detailed analysis of each move with hints and equity loss",
        "tags": [
          "PR"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Move-level analysis",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "gameId": {
                          "type": "string"
                        },
                        "totalMoves": {
                          "type": "integer"
                        },
                        "moves": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/MoveAnalysis"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/pr/users/{userId}": {
      "get": {
        "summary": "Get user PR stats",
        "tags": [
          "PR"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User PR statistics"
          }
        }
      }
    },
    "/pr/users/{userId}/history": {
      "get": {
        "summary": "Get user PR history",
        "tags": [
          "PR"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PR history"
          }
        }
      }
    },
    "/history/games/{gameId}": {
      "get": {
        "summary": "Get complete game history",
        "tags": [
          "History"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Complete game history with all actions"
          },
          "404": {
            "description": "No history found"
          }
        }
      }
    },
    "/history/games/{gameId}/range": {
      "get": {
        "summary": "Get actions within a range",
        "tags": [
          "History"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Actions in range"
          }
        }
      }
    },
    "/history/games/{gameId}/latest": {
      "get": {
        "summary": "Get latest action",
        "tags": [
          "History"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Latest action"
          }
        }
      }
    },
    "/history/games/{gameId}/export/xg": {
      "get": {
        "summary": "Export game to XG format",
        "tags": [
          "History"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "XG format file",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/history/import/xg": {
      "post": {
        "summary": "Import XG format file",
        "description": "Import games from eXtreme Gammon format",
        "tags": [
          "History"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "xgContent"
                ],
                "properties": {
                  "xgContent": {
                    "type": "string",
                    "description": "XG file content as string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Games imported",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "games": {
                          "type": "array"
                        },
                        "gamesCreated": {
                          "type": "integer"
                        },
                        "errors": {
                          "type": "array"
                        },
                        "warnings": {
                          "type": "array"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/stats/users/{userId}": {
      "get": {
        "summary": "Get user statistics",
        "tags": [
          "Stats"
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User statistics"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "GameId": {
        "name": "gameId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Game ID"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/Game"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Game": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "stateKind": {
            "type": "string",
            "enum": [
              "rolling-for-start",
              "rolled-for-start",
              "rolling",
              "doubled",
              "moving",
              "moved",
              "completed"
            ]
          },
          "players": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Player"
            }
          },
          "board": {
            "$ref": "#/components/schemas/Board"
          },
          "cube": {
            "$ref": "#/components/schemas/Cube"
          },
          "activeColor": {
            "type": "string",
            "enum": [
              "white",
              "black"
            ]
          },
          "activePlay": {
            "$ref": "#/components/schemas/Play"
          },
          "winner": {
            "type": "string",
            "description": "Player ID of winner (only when completed)"
          }
        }
      },
      "Player": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "enum": [
              "white",
              "black"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "clockwise",
              "counterclockwise"
            ]
          },
          "isRobot": {
            "type": "boolean"
          },
          "dice": {
            "type": "object",
            "properties": {
              "currentRoll": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "Board": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "bar": {
            "type": "object"
          },
          "off": {
            "type": "object"
          }
        }
      },
      "Cube": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer"
          },
          "owner": {
            "type": "string"
          },
          "stateKind": {
            "type": "string"
          }
        }
      },
      "Play": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "stateKind": {
            "type": "string",
            "enum": [
              "rolling",
              "moving",
              "moved",
              "confirmed"
            ]
          },
          "moves": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Move"
            }
          }
        }
      },
      "Move": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "dieValue": {
            "type": "integer"
          },
          "stateKind": {
            "type": "string",
            "enum": [
              "ready",
              "completed",
              "confirmed"
            ]
          },
          "moveKind": {
            "type": "string",
            "enum": [
              "no-move",
              "point-to-point",
              "reenter",
              "bear-off"
            ]
          },
          "possibleMoves": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "userType": {
            "type": "string",
            "enum": [
              "human",
              "robot"
            ]
          }
        }
      },
      "PRResult": {
        "type": "object",
        "properties": {
          "gameId": {
            "type": "string"
          },
          "players": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": {
                  "type": "string"
                },
                "playerColor": {
                  "type": "string"
                },
                "performanceRating": {
                  "type": "number"
                },
                "averageEquityLoss": {
                  "type": "number"
                },
                "totalMoves": {
                  "type": "integer"
                },
                "analyzedMoves": {
                  "type": "integer"
                },
                "errors": {
                  "type": "object",
                  "properties": {
                    "doubtful": {
                      "type": "integer"
                    },
                    "error": {
