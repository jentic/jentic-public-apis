    "/users/me/xp-events": {
      "get": {
        "summary": "List XP events for user",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "XP events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/XPEvent"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/gamification/xp-events": {
      "post": {
        "summary": "Internal - award XP for an activity",
        "tags": [
          "Internal",
          "Profile"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "user_id",
                  "module",
                  "activity_type",
                  "xp_delta"
                ],
                "properties": {
                  "user_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "module": {
                    "type": "string"
                  },
                  "activity_type": {
                    "type": "string"
                  },
                  "xp_delta": {
                    "type": "integer"
                  },
                  "related_entity_type": {
                    "type": "string",
                    "nullable": true
                  },
                  "related_entity_id": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New XP totals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "new_xp_total": {
                      "type": "integer"
                    },
                    "new_level": {
                      "type": "integer"
                    },
                    "leveled_up": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
