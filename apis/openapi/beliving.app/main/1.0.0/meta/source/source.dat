                            "type": "string",
                            "format": "date",
                            "nullable": true
                          },
                          "last_weight_sync_at": {
                            "type": "string",
                            "format": "date-time",
                            "nullable": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
