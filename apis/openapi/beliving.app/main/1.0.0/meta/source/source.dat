{
  "openapi": "3.0.3",
  "info": {
    "title": "Beliving API",
    "version": "1.0.0",
    "description": "Beliving – Mind · Body · Soul. Core APIs for Onboarding, Longevity, Mindfulness, Super Nutrition, and Profile/Gamification, including HealthKit / Health Connect sync.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/beliving/beliving-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.beliving.app/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "onboarding_completed": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "gender": {
            "type": "string",
            "nullable": true
          },
          "age": {
            "type": "integer",
            "nullable": true
          },
          "weight_kg": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "height_cm": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HealthConnection": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "ios_healthkit | android_healthconnect"
          },
          "steps_enabled": {
            "type": "boolean"
          },
          "calories_enabled": {
            "type": "boolean"
          },
          "distance_enabled": {
            "type": "boolean"
          },
          "weight_enabled": {
            "type": "boolean"
          },
          "sleep_enabled": {
            "type": "boolean"
          },
          "connected_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "DailyActivitySummary": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "steps": {
            "type": "integer",
            "nullable": true
          },
          "calories_active_kcal": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "distance_km": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "weight_kg": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "sleep_score": {
            "type": "number",
            "format": "float",
            "nullable": true
          }
        }
      },
      "SleepSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sleep_date": {
            "type": "string",
            "format": "date"
          },
          "start_time": {
            "type": "string",
            "format": "date-time"
          },
          "end_time": {
            "type": "string",
            "format": "date-time"
          },
          "time_in_bed_min": {
            "type": "integer",
            "nullable": true
          },
          "time_asleep_min": {
            "type": "integer",
            "nullable": true
          },
          "efficiency": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "sleep_score": {
            "type": "number",
            "format": "float",
            "nullable": true
          }
        }
      },
      "StressLog": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "stress_state": {
            "type": "string",
            "description": "yes | little | no"
          },
          "source": {
            "type": "string"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MindfulnessSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "activity_type": {
            "type": "string",
            "description": "breathing | video | game"
          },
          "subtype": {
            "type": "string",
            "nullable": true
          },
          "duration_sec": {
            "type": "integer",
            "nullable": true
          },
          "completed": {
            "type": "boolean"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "RecipeCard": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "image_url": {
            "type": "string",
            "nullable": true
          },
          "calories": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "protein_g": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "carbs_g": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "fat_g": {
            "type": "number",
            "format": "float",
            "nullable": true
          }
        }
      },
      "RecipeDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RecipeCard"
          },
          {
            "type": "object",
            "properties": {
              "ingredients": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "quantity": {
                      "type": "number",
                      "nullable": true
                    },
                    "unit": {
                      "type": "string",
                      "nullable": true
                    }
                  }
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "Meal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string",
            "description": "manual | ai_scan | recipe"
          },
          "food_name": {
            "type": "string"
          },
          "eaten_at": {
            "type": "string",
            "format": "date-time"
          },
          "calories": {
            "type": "number",
            "format": "float"
          },
          "protein_g": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "carbs_g": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "fat_g": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "recipe_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "ai_confidence": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NutritionDailySummary": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "total_calories": {
            "type": "number",
            "format": "float"
          },
          "target_calories": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "macros": {
            "type": "object",
            "properties": {
              "protein_g": {
                "type": "number",
                "format": "float"
              },
              "protein_target_g": {
                "type": "number",
                "format": "float",
                "nullable": true
              },
              "carbs_g": {
                "type": "number",
                "format": "float"
              },
              "carbs_target_g": {
                "type": "number",
                "format": "float",
                "nullable": true
              },
              "fat_g": {
                "type": "number",
                "format": "float"
              },
              "fat_target_g": {
                "type": "number",
                "format": "float",
                "nullable": true
              }
            }
          },
          "meals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "food_name": {
                  "type": "string"
                },
                "calories": {
                  "type": "number",
                  "format": "float"
                },
                "eaten_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "XPEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "module": {
            "type": "string"
          },
          "activity_type": {
            "type": "string"
          },
          "xp_delta": {
            "type": "integer"
          },
          "related_entity_type": {
            "type": "string",
            "nullable": true
          },
          "related_entity_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserState": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer"
          },
          "xp_total": {
            "type": "integer"
          },
          "xp_to_next_level": {
            "type": "integer"
          },
          "current_streak_days": {
            "type": "integer"
          },
          "longest_streak_days": {
            "type": "integer"
          },
          "last_active_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "last_level_up_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "BadgeStatus": {
        "type": "object",
        "properties": {
          "badge_id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "icon_url": {
            "type": "string",
            "nullable": true
          },
          "unlocked": {
            "type": "boolean"
          },
          "unlocked_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "BadgeDefinition": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "icon_url": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HealthSyncDailyActivityItem": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "steps": {
            "type": "integer",
            "nullable": true
          },
          "calories_active_kcal": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "distance_km": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "weight_kg": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "raw_source_metadata": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "HealthSyncSleepSessionItem": {
        "type": "object",
        "properties": {
          "sleep_date": {
            "type": "string",
            "format": "date"
          },
          "start_time": {
            "type": "string",
            "format": "date-time"
          },
          "end_time": {
            "type": "string",
            "format": "date-time"
          },
          "time_in_bed_min": {
            "type": "integer",
            "nullable": true
          },
          "time_asleep_min": {
            "type": "integer",
            "nullable": true
          },
          "efficiency": {
            "type": "number",
            "format": "float",
            "nullable": true
          },
          "raw_source": {
            "type": "object",
            "nullable": true
          }
        }
      }
    }
  },
  "paths": {
    "/auth/google": {
      "post": {
        "summary": "Google Sign-in",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id_token"
                ],
                "properties": {
                  "id_token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in or signed up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/apple": {
      "post": {
        "summary": "Apple Sign-in",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id_token"
                ],
                "properties": {
                  "id_token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in or signed up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/phone/start": {
      "post": {
        "summary": "Start phone sign-in (OTP)",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone"
                ],
                "properties": {
                  "phone": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/phone/verify": {
      "post": {
        "summary": "Verify OTP and sign-in",
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone",
                  "otp"
                ],
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "otp": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in or signed up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get current user",
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/users/me/onboarding/complete": {
      "post": {
        "summary": "Mark onboarding as completed",
        "tags": [
          "Onboarding"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Onboarding completion",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "onboarding_completed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/me/profile": {
      "get": {
        "summary": "Get user profile",
        "tags": [
          "User"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update user profile",
        "tags": [
          "User"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "gender": {
                    "type": "string"
                  },
                  "age": {
                    "type": "integer"
                  },
                  "weight_kg": {
                    "type": "number",
                    "format": "float"
                  },
                  "height_cm": {
                    "type": "number",
                    "format": "float"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          }
        }
      }
    },
    "/users/me/health-connections": {
      "get": {
        "summary": "Get health connections & permissions",
        "tags": [
          "HealthSync"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Health connection list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "connections": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/HealthConnection"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Register or update health connection permissions",
        "tags": [
          "HealthSync"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "platform"
                ],
                "properties": {
                  "platform": {
                    "type": "string"
                  },
                  "steps_enabled": {
                    "type": "boolean"
                  },
                  "calories_enabled": {
                    "type": "boolean"
                  },
                  "distance_enabled": {
                    "type": "boolean"
                  },
                  "weight_enabled": {
                    "type": "boolean"
                  },
                  "sleep_enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated health connection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthConnection"
                }
              }
            }
          }
        }
      }
    },
    "/internal/health-connections/{platform}": {
      "patch": {
        "summary": "Internal - update health connection flags",
        "tags": [
          "Internal",
          "HealthSync"
        ],
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "steps_enabled": {
                    "type": "boolean"
                  },
                  "calories_enabled": {
                    "type": "boolean"
                  },
                  "distance_enabled": {
                    "type": "boolean"
                  },
                  "weight_enabled": {
                    "type": "boolean"
                  },
                  "sleep_enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      }
    },
    "/users/me/daily-activity": {
      "get": {
        "summary": "Get daily activity summary",
        "tags": [
          "Longevity"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daily summary",
            "content": {
              "application/json": {
                "schema": {
