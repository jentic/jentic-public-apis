{
  "openapi": "3.0.3",
  "info": {
    "title": "PPTM-SOLAS API",
    "description": "REST API untuk Sistem Pelaporan Pemeliharaan Peralatan (PPTM-SOLAS).\n\n## Authentication\nAPI ini menggunakan Laravel Sanctum untuk autentikasi. Untuk mengakses endpoint yang dilindungi:\n1. Login melalui `/api/auth/login` untuk mendapatkan token\n2. Sertakan token di header: `Authorization: Bearer {token}`\n\n## Response Format\nSemua response menggunakan format standar:\n```json\n{\n  \"code\": 200,\n  \"status\": \"success\",\n  \"message\": \"...\",\n  \"data\": {...}\n}\n```\n",
    "version": "1.1.0",
    "contact": {
      "name": "PPTM Support",
      "email": "support@pptm-solas.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/selfemployee-e24/pptm-solas-api/1.1.0"
  },
  "servers": [
    {
      "url": "https://pptm.solas.id/api",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Login, logout, dan manajemen token"
    },
    {
      "name": "Dashboard",
      "description": "Statistik dan data dashboard"
    },
    {
      "name": "Request Laporan",
      "description": "Manajemen laporan permintaan perbaikan"
    },
    {
      "name": "Detail Laporan",
      "description": "Detail dari laporan perbaikan"
    },
    {
      "name": "Tindakan Perbaikan",
      "description": "Tindakan perbaikan yang dilakukan"
    },
    {
      "name": "Rincian Suku Cadang",
      "description": "Manajemen suku cadang/spare parts"
    },
    {
      "name": "Comments",
      "description": "Komentar pada laporan"
    },
    {
      "name": "Catatan Progress",
      "description": "Catatan progress perbaikan"
    },
    {
      "name": "Task Assignment",
      "description": "Penugasan task ke teknisi"
    },
    {
      "name": "Users",
      "description": "Manajemen pengguna"
    },
    {
      "name": "Roles",
      "description": "Manajemen role"
    },
    {
      "name": "Master Mesin",
      "description": "Master data mesin/peralatan"
    },
    {
      "name": "Master Departement",
      "description": "Master data departemen"
    },
    {
      "name": "Master Supervisor",
      "description": "Master data supervisor"
    },
    {
      "name": "Master Satuan",
      "description": "Master data satuan"
    },
    {
      "name": "Prioritas",
      "description": "Master data prioritas"
    },
    {
      "name": "Jenis Engineer",
      "description": "Master data jenis engineer"
    },
    {
      "name": "Saran Masukan",
      "description": "Saran dan masukan"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Token"
      }
    },
    "schemas": {
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 400
          },
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 422
          },
          "status": {
            "type": "string",
            "example": "error"
          },
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "errors": {
            "type": "object"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "from": {
            "type": "integer"
          },
          "to": {
            "type": "integer"
          }
        }
      },
      "PaginationLinks": {
        "type": "object",
        "properties": {
          "first": {
            "type": "string"
          },
          "last": {
            "type": "string"
          },
          "prev": {
            "type": "string",
            "nullable": true
          },
          "next": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@admin.com"
          },
          "username": {
            "type": "string",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "password"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 200
          },
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string",
            "example": "Login berhasil"
          },
          "data": {
            "type": "object",
            "properties": {
              "user": {
                "$ref": "#/components/schemas/User"
              },
              "token": {
                "type": "string",
                "example": "1|abcdef123456"
              },
              "token_type": {
                "type": "string",
                "example": "Bearer"
              }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "username": {
            "type": "string"
          },
          "role_id": {
            "type": "string",
            "format": "uuid"
          },
          "supervisor_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "department_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "id_jenis_engineer": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "UserCreate": {
        "type": "object",
        "required": [
          "name",
          "email",
          "username",
          "password",
          "role_id"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "username": {
            "type": "string",
            "example": "johndoe"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8
          },
          "role_id": {
            "type": "string",
            "format": "uuid"
          },
          "supervisor_id": {
            "type": "string",
            "format": "uuid"
          },
          "department_id": {
            "type": "string",
            "format": "uuid"
          },
          "id_jenis_engineer": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UserUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "username": {
            "type": "string"
          },
          "role_id": {
            "type": "string",
            "format": "uuid"
          },
          "supervisor_id": {
            "type": "string",
            "format": "uuid"
          },
          "department_id": {
            "type": "string",
            "format": "uuid"
          },
          "id_jenis_engineer": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Admin"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RoleCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Manager"
          }
        }
      },
      "RequestLaporan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code_pptm": {
            "type": "string",
            "example": "CV0366/0260/NBLSL1/01/2026"
          },
          "code_keluhan": {
            "type": "string",
            "example": "0260/NBLSL1/01/2026"
          },
          "id_mesin": {
            "type": "string",
            "format": "uuid"
          },
          "lokasi": {
            "type": "string"
          },
          "id_supervisor": {
            "type": "string",
            "format": "uuid"
          },
          "deskripsi_masalah": {
            "type": "string"
          },
          "penyebab_awal": {
            "type": "string"
          },
          "tanggal": {
            "type": "string",
            "format": "date"
          },
          "jam": {
            "type": "string",
            "example": "08:00:00"
          },
          "jenis_laporan": {
            "type": "string",
            "example": "mesin_produksi"
          },
          "kontak_person": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "mesin": {
            "$ref": "#/components/schemas/MasterMesin"
          },
          "supervisor": {
            "$ref": "#/components/schemas/MasterSupervisor"
          }
        }
      },
      "RequestLaporanCreate": {
        "type": "object",
        "required": [
          "id_mesin",
          "deskripsi_masalah",
          "tanggal",
          "jam"
        ],
        "properties": {
          "id_mesin": {
            "type": "string",
            "format": "uuid"
          },
          "lokasi": {
            "type": "string"
          },
          "id_supervisor": {
            "type": "string",
            "format": "uuid"
          },
          "deskripsi_masalah": {
            "type": "string",
            "example": "Mesin tidak bisa menyala"
          },
          "penyebab_awal": {
            "type": "string"
          },
          "tanggal": {
            "type": "string",
            "format": "date",
            "example": "2026-01-30"
          },
          "jam": {
            "type": "string",
            "example": "08:00"
          },
          "jenis_laporan": {
            "type": "string",
            "example": "mesin_produksi"
          },
          "kontak_person": {
            "type": "string",
            "example": "081234567890"
          }
        }
      },
      "RequestLaporanStatusUpdate": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "waiting",
              "assigned",
              "on_progress",
              "inspeksiKalibrasi",
              "pengujianUlang",
              "readyForOperation",
              "rejected",
              "delayed",
              "closed"
            ]
          },
          "alasan": {
            "type": "string",
            "description": "Alasan jika status rejected atau delayed"
          }
        }
      },
      "AssignTaskRequest": {
        "type": "object",
        "required": [
          "user_ids"
        ],
        "properties": {
          "user_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "type": {
            "type": "string",
            "example": "teknisi"
          }
        }
      },
      "DetailLaporan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "id_request_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "id_users": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "id_tindakan_perbaikan": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "closed_by_admin": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "closed_by_supervisor": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "reason_reject": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "requestLaporan": {
            "$ref": "#/components/schemas/RequestLaporan"
          },
          "users": {
            "$ref": "#/components/schemas/User"
          },
          "tindakanPerbaikan": {
            "$ref": "#/components/schemas/TindakanPerbaikan"
          }
        }
      },
      "DetailLaporanCreate": {
        "type": "object",
        "required": [
          "id_request_laporan",
          "status"
        ],
        "properties": {
          "id_request_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "id_users": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "TindakanPerbaikan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "id_detail_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "uraian_pekerjaan": {
            "type": "string"
          },
          "tanggal_mulai_perbaikan": {
            "type": "string",
            "format": "date"
          },
          "tanggal_selesai_perbaikan": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "biaya_jasa": {
            "type": "number",
            "format": "float"
          },
          "nomor_purchase_request": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TindakanPerbaikanCreate": {
        "type": "object",
        "required": [
          "id_detail_laporan",
          "uraian_pekerjaan",
          "tanggal_mulai_perbaikan"
        ],
        "properties": {
          "id_detail_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "uraian_pekerjaan": {
            "type": "string",
            "example": "Mengganti komponen yang rusak"
          },
          "tanggal_mulai_perbaikan": {
            "type": "string",
            "format": "date",
            "example": "2026-01-30"
          },
          "tanggal_selesai_perbaikan": {
            "type": "string",
            "format": "date"
          },
          "biaya_jasa": {
            "type": "number",
            "format": "float",
            "example": 500000
          },
          "nomor_purchase_request": {
            "type": "string"
          }
        }
      },
      "RincianSukuCadang": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "id_detail_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "id_satuan": {
            "type": "string",
            "format": "uuid"
          },
          "nama_barang": {
            "type": "string"
          },
          "jumlah": {
            "type": "integer"
          },
          "harga": {
            "type": "number",
            "format": "float"
          },
          "keterangan": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "satuan": {
            "$ref": "#/components/schemas/MasterSatuan"
          }
        }
      },
      "RincianSukuCadangCreate": {
        "type": "object",
        "required": [
          "id_detail_laporan",
          "nama_barang",
          "jumlah",
          "harga"
        ],
        "properties": {
          "id_detail_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "id_satuan": {
            "type": "string",
            "format": "uuid"
          },
          "nama_barang": {
            "type": "string",
            "example": "Bearing 6205"
          },
          "jumlah": {
            "type": "integer",
            "example": 2
          },
          "harga": {
            "type": "number",
            "format": "float",
            "example": 75000
          },
          "keterangan": {
            "type": "string"
          }
        }
      },
      "RincianSukuCadangBulk": {
        "type": "object",
        "required": [
          "id_detail_laporan",
          "items"
        ],
        "properties": {
          "id_detail_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "nama_barang",
                "jumlah",
                "harga"
              ],
              "properties": {
                "id_satuan": {
                  "type": "string",
                  "format": "uuid"
                },
                "nama_barang": {
                  "type": "string"
                },
                "jumlah": {
                  "type": "integer"
                },
                "harga": {
                  "type": "number",
                  "format": "float"
                },
                "keterangan": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "id_detail_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "id_user": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string"
          },
          "is_edited": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "CommentCreate": {
        "type": "object",
        "required": [
          "id_detail_laporan",
          "content"
        ],
        "properties": {
          "id_detail_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string",
            "example": "Progress perbaikan sudah 50%"
          }
        }
      },
      "CatatanProgress": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "id_detail_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "catatan": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CatatanProgressCreate": {
        "type": "object",
        "required": [
          "id_detail_laporan",
          "catatan"
        ],
        "properties": {
          "id_detail_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "catatan": {
            "type": "string",
            "example": "Sudah melakukan pengecekan awal"
          }
        }
      },
      "TaskTo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "id_request_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "id_users": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "request_laporan": {
            "$ref": "#/components/schemas/RequestLaporan"
          }
        }
      },
      "TaskToCreate": {
        "type": "object",
        "required": [
          "id_request_laporan",
          "id_users"
        ],
        "properties": {
          "id_request_laporan": {
            "type": "string",
            "format": "uuid"
          },
          "id_users": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "example": "teknisi"
          }
        }
      },
      "MasterMesin": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kode": {
            "type": "string",
            "example": "MSN-001"
          },
          "nama_mesin": {
            "type": "string",
            "example": "Mesin CNC"
          },
          "lokasi_mesin": {
            "type": "string",
            "example": "Gedung A Lt.1"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
