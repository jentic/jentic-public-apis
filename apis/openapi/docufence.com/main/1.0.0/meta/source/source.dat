        "operationId": "v2Getfileid",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content_type": {
                    "type": "string",
                    "example": "application/pdf"
                  },
                  "file_size": {
                    "type": "number",
                    "example": 1258291
                  },
                  "file_sizes": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "example": 1258291
                    },
                    "example": [
                      1258291,
                      1258291,
                      1258291,
                      1258291,
                      1258291
                    ]
                  },
                  "total_files": {
                    "type": "number",
                    "example": 5
                  }
                }
              },
              "examples": {
                "V2-GetFileID": {
                  "value": {
                    "content_type": "application/pdf",
                    "file_size": 1258291,
                    "file_sizes": [
                      1258291,
                      1258291,
                      1258291,
                      1258291,
                      1258291
                    ],
                    "total_files": 5
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
