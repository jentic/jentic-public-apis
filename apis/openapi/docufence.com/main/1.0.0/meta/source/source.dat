      "put": {
        "summary": "V2-fileUpload",
        "description": "V2-fileUpload",
        "operationId": "v2Fileupload",
        "parameters": [
          {
            "name": "X-Amz-Algorithm",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "AWS4-HMAC-SHA256"
            }
          },
          {
            "name": "X-Amz-Credential",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "30f76a4fd119ee90a012600d948ca5cd%2F20250919%2Fauto%2Fs3%2Faws4_request"
            }
          },
          {
            "name": "X-Amz-Date",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "20250919T061755Z"
            }
          },
          {
            "name": "X-Amz-Expires",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "3600"
            }
          },
          {
            "name": "X-Amz-SignedHeaders",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "content-type%3Bhost%3Bx-amz-acl"
            }
          },
          {
            "name": "X-Amz-Signature",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "af76c47170db12aafeafe6aaeb588f3a2ab0875beb28a13ccb5fbaad7a7e16cf"
            }
          },
          {
            "name": "x-amz-content-sha256",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "UNSIGNED-PAYLOAD"
            }
          },
          {
            "name": "x-amz-acl",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "public-read"
            }
          }
        ],
        "requestBody": {
          "content": {}
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {}
        ]
      }
    },
