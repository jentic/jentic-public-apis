    "/banking/customer/{principalId}/account/{accountId}/transaction": {
      "get": {
        "description": "Retrieve a list of transactions based on customer and account identifiers. Transactions should be ordered according\nto \"effective\" date in descending order.\n\nAs the date and time for a transaction can alter depending on status and transaction type two separate date/times\nare included in the payload. There are still some scenarios where neither of these time stamps is available. For the\npurpose of filtering and ordering it is expected that the data holder will use the \"effective\" date/time which will\nbe defined as:\n  - Posted date/time if available, then\n  - Execution date/time if available, then\n  - A reasonable date/time nominated by the data holder using internal data structures",
        "operationId": "listBankingTransactions",
        "parameters": [
          {
            "$ref": "#/components/parameters/HeaderXFapiInteractionId"
          },
          {
            "$ref": "#/components/parameters/PathPrincipalId"
          },
          {
            "$ref": "#/components/parameters/PathAccountId"
          },
          {
            "$ref": "#/components/parameters/QueryTransactionIdList"
          },
          {
            "$ref": "#/components/parameters/HeaderRealmName"
          },
          {
            "$ref": "#/components/parameters/QueryOldestDateTime"
          },
          {
            "$ref": "#/components/parameters/QueryNewestDateTime"
          },
          {
            "$ref": "#/components/parameters/QueryMinAmount"
          },
          {
            "$ref": "#/components/parameters/QueryMaxAmount"
          },
          {
            "$ref": "#/components/parameters/QueryTransactionText"
          },
          {
            "$ref": "#/components/parameters/QueryPage"
          },
          {
            "$ref": "#/components/parameters/QueryPageSize"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/ListTransactions"
          },
          "400": {
            "$ref": "#/components/responses/ListTransactions400"
          },
          "404": {
            "$ref": "#/components/responses/DioGeneric404"
          },
          "422": {
            "$ref": "#/components/responses/ListTransactions422"
          },
          "429": {
            "$ref": "#/components/responses/DioGeneric429"
          },
          "451": {
            "$ref": "#/components/responses/DioGeneric451"
          }
        },
        "summary": "List Transactions",
        "tags": [
          "Banking"
        ]
      }
    },
