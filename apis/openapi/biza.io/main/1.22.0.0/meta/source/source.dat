          },
          "directDebit": {
            "$ref": "#/components/schemas/EnergyPaymentScheduleDirectDebitV1"
          },
          "digitalWallet": {
            "$ref": "#/components/schemas/EnergyPaymentScheduleDigitalWalletV1"
          },
          "manualPayment": {
            "$ref": "#/components/schemas/EnergyPaymentScheduleManualPaymentV1"
          }
        },
        "required": [
          "paymentScheduleUType"
        ],
        "type": "object",
