          "CHEQUE_DISHONOUR",
          "DD_DISHONOUR",
          "MEMBERSHIP",
          "CONTRIBUTION",
          "PAPER_BILL",
          "OTHER"
        ],
        "type": "string",
        "example": "ESTABLISHMENT"
      },
      "EnumEnergyPlanFeeTermV1": {
        "description": "The term of the fee",
        "enum": [
