          "username": {
            "description": "The username is the string that the customer is expected to enter at the first step of the consent flow. It could be an email, phone number or some kind of internet banking ID. The CDR mandates that the user needs to login to CDR with the same username as their digital banking channels, so what this username is depends on your existing UX.",
            "type": "string",
