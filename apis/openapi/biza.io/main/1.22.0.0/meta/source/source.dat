  "paths": {
    "/health": {
      "get": {
        "description": "Retrieve health check summary",
        "operationId": "getHealth",
        "parameters": [
          {
            "$ref": "#/components/parameters/HeaderXFapiInteractionId"
          },
          {
            "$ref": "#/components/parameters/HeaderRealmName"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/GetHealth"
          },
          "400": {
            "$ref": "#/components/responses/DioGeneric400"
          }
        },
        "summary": "Get Service Health Status (Optional)",
        "tags": [
          "Admin"
        ]
      }
    },
    "/login/user": {
      "post": {
        "description": "Essentially a simplified GetCustomer call. To be used as a replacement for GetCustomer in the Consent Flow.\nAlso used in the Consent Management Dashboard as a way of knowing about the Power of Attorney situations  that may exist.",
        "summary": "Get User",
        "operationId": "getUser",
        "parameters": [
          {
            "$ref": "#/components/parameters/HeaderXFapiInteractionId"
          },
          {
            "$ref": "#/components/parameters/HeaderRealmName"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/GetUserRequest"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/LoginUser"
          },
          "400": {
            "$ref": "#/components/responses/DioGeneric400"
          },
          "404": {
            "$ref": "#/components/responses/DioGeneric404"
          },
          "422": {
            "$ref": "#/components/responses/DioGeneric422"
          },
          "429": {
            "$ref": "#/components/responses/DioGeneric429"
          },
          "451": {
            "$ref": "#/components/responses/DioGeneric451"
          }
        },
        "tags": [
          "Common"
        ]
      }
    },
    "/login/userId": {
      "post": {
        "description": "Maps a username (the text that the user logs in with to Internet Banking / consent flow) to an User ID. This can represent some kind of internet banking number, email or phone number. As the username can often be an email or phone number, HaaS cannot rely on the username being consistent over the lifetime of the grant. This call is for converting that username to an ID that HaaS can use to look up details about the user over the lifetime of grant without having to keep up to date with username changes if the user changes their phone number or email.\nThis functionality is used to convert a user identifier to a principal identifier within HaaS Admin.",
        "summary": "Get User ID",
        "operationId": "getUserId",
        "deprecated": true,
        "parameters": [
          {
            "$ref": "#/components/parameters/HeaderXFapiInteractionId"
          },
          {
            "$ref": "#/components/parameters/HeaderRealmName"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/GetUserIdRequest"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/LoginUserId"
          },
          "400": {
            "$ref": "#/components/responses/DioGeneric400"
          },
          "404": {
            "$ref": "#/components/responses/DioGeneric404"
          }
        },
        "tags": [
          "Admin"
        ]
      }
    },
    "/login/init": {
      "post": {
        "description": "Initiate OTP Login using a supplied username and receive a request identifier to present the supplied OTP back with. This call should not fail if the username doesn't exist, but instead return a request ID that has no possibility of succeeding. This is to avoid enumeration attacks on usernames via this interface (i.e the only way to verify a user exists is to successfully pass the right OTP).",
        "summary": "Init Login",
        "operationId": "initLogin",
        "parameters": [
          {
            "$ref": "#/components/parameters/HeaderXFapiInteractionId"
          },
          {
            "$ref": "#/components/parameters/HeaderRealmName"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/LoginInitRequest"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/LoginInit"
          },
          "400": {
            "$ref": "#/components/responses/DioGeneric400"
          },
          "422": {
            "$ref": "#/components/responses/InitLogin422"
          },
          "429": {
            "$ref": "#/components/responses/DioGeneric429"
          }
        },
        "tags": [
          "Auth"
        ]
      }
    },
    "/login/verify": {
      "post": {
        "description": "Using a supplied request identifier and a supplied OTP verify the login and return a set of customer identifiers it is now validated for",
        "operationId": "verifyLogin",
        "summary": "Verify Login",
        "parameters": [
          {
            "$ref": "#/components/parameters/HeaderXFapiInteractionId"
          },
          {
            "$ref": "#/components/parameters/HeaderRealmName"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/LoginVerifyRequest"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/LoginVerify"
          },
          "400": {
            "$ref": "#/components/responses/DioGeneric400"
          },
          "422": {
            "$ref": "#/components/responses/VerifyLogin422"
          },
          "429": {
            "$ref": "#/components/responses/DioGeneric429"
          },
          "451": {
            "$ref": "#/components/responses/DioGeneric451"
          }
        },
        "tags": [
          "Auth"
        ]
      }
    },
    "/user/notification-info": {
      "post": {
        "description": "Takes a userId and returns back the name and email that should be used when sending email notifications to that user.\nThere are places where HaaS needs to obtain the name & email of a `userId` but we don't have a `principalId` present.\n    \n*Note:* This API is experimental and **MUST NOT** be implemented directly by customers at this time.",
        "summary": "Get User Notification Information",
        "operationId": "getUserNotificationInfo",
        "parameters": [
          {
            "$ref": "#/components/parameters/HeaderXFapiInteractionId"
          },
          {
            "$ref": "#/components/parameters/HeaderRealmName"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/UserNotificationInfoRequest"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/UserNotificationInfoResponse"
          },
          "404": {
            "$ref": "#/components/responses/DioGeneric404"
          },
          "429": {
            "$ref": "#/components/responses/DioGeneric429"
          }
        },
        "tags": [
          "Notification"
        ]
      }
    },
