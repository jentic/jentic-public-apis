                  "type": "string",
                  "maxLength": 512,
                  "example": "552375cb-9c00-4fde-a0a0-592904a55355"
                },
                "timeClosed": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2017-07-21T17:32:28Z"
                }
              },
              "required": [
