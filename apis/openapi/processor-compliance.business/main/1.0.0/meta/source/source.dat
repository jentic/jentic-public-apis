{
  "openapi": "3.0.3",
  "info": {
    "title": "Processor Compliance Order Management API",
    "description": "API for user authentication and order management",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "reiner.schmidt@processor-compliance.business"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/REINERSCHMIDT/order-management-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.processor-compliance.business/v1",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Endpoints for user authentication"
    },
    {
      "name": "Orders",
      "description": "Endpoints for order management"
    }
  ],
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "User login",
        "description": "Authenticates a user with username and password",
        "operationId": "logIn",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "username",
                  "password"
                ],
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "max.mustermann",
                    "description": "Username"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "SecretPassword123!",
                    "description": "User password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
                      "description": "JWT token for subsequent API calls"
                    },
                    "expires_in": {
                      "type": "integer",
                      "example": 3600,
                      "description": "Token validity in seconds"
                    },
                    "user_id": {
                      "type": "string",
                      "example": "user_12345",
                      "description": "Unique user ID"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Add new order",
        "description": "Creates a new order with company information and delivery address",
        "operationId": "addOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "company_name",
                  "order_reference",
                  "email",
                  "vat",
                  "department",
                  "address"
                ],
                "properties": {
                  "company_name": {
                    "type": "string",
                    "example": "Mustermann GmbH",
                    "description": "Name of the ordering company"
                  },
                  "order_reference": {
                    "type": "string",
                    "example": "PO-2024-001234",
                    "description": "Internal order reference/purchase order number"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "orders@mustermann.de",
                    "description": "Contact email address"
                  },
                  "vat": {
                    "type": "string",
                    "example": "DE123456789",
                    "description": "VAT identification number"
                  },
                  "department": {
                    "type": "string",
                    "example": "Procurement",
                    "description": "Department within the company"
                  },
                  "address": {
                    "type": "object",
                    "required": [
                      "street",
                      "house_number",
                      "postal_code",
                      "city",
                      "country"
                    ],
                    "properties": {
                      "street": {
                        "type": "string",
                        "example": "Musterstraße",
                        "description": "Street name"
                      },
                      "house_number": {
                        "type": "string",
                        "example": "42a",
                        "description": "House number"
                      },
                      "address_line2": {
                        "type": "string",
                        "example": "3rd Floor, Office 301",
                        "description": "Additional address information (optional)"
                      },
                      "postal_code": {
                        "type": "string",
                        "example": "12345",
                        "description": "Postal code"
                      },
                      "city": {
                        "type": "string",
                        "example": "Musterstadt",
                        "description": "City"
                      },
                      "country": {
                        "type": "string",
                        "example": "Germany",
                        "description": "Country"
                      }
                    }
                  },
                  "notes": {
                    "type": "string",
                    "example": "Order from Musterstadt",
                    "description": "Additional notes for the order (optional)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order_id": {
                      "type": "string",
                      "example": "ORD-2024-789456",
                      "description": "Unique order ID"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "confirmed",
                        "processing",
                        "shipped",
                        "delivered",
                        "cancelled"
                      ],
                      "example": "pending",
                      "description": "Current status of the order"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-01-29T14:30:00Z",
                      "description": "Order creation timestamp"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}": {
      "delete": {
        "tags": [
          "Orders"
        ],
        "summary": "Delete an order",
        "description": "Deletes an existing order by its order ID",
        "operationId": "deleteOrder",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "description": "Unique order ID to delete",
            "schema": {
              "type": "string"
            },
            "example": "ORD-2024-789456"
          }
        ],
        "responses": {
          "200": {
            "description": "Order successfully deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Order successfully deleted",
                      "description": "Confirmation message"
                    },
                    "order_id": {
                      "type": "string",
                      "example": "ORD-2024-789456",
                      "description": "ID of the deleted order"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token from login authentication"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message",
            "example": "Invalid input data"
          },
          "error_code": {
            "type": "string",
            "description": "Unique error code",
            "example": "INVALID_INPUT"
          },
          "details": {
            "type": "array",
            "description": "Detailed error information (optional)",
            "items": {
              "type": "string"
            },
            "example": [
              "Field 'email' is not a valid email address",
              "Field 'postal_code' is required"
            ]
          }
        }
      }
    }
  }
}
