{
  "openapi": "3.0.3",
  "info": {
    "title": "PeopleForce API",
    "version": "3.0.0",
    "description": "Company API v1 is deprecated. It no longer receives changes and will stop being supported, so move integrations to a newer version of the Company API.",
    "termsOfService": "https://peopleforce.io/terms-and-conditions",
    "contact": {
      "name": "PeopleForce Support",
      "email": "support@peopleforce.io",
      "url": "https://help.peopleforce.io"
    }
  },
  "servers": [
    {
      "url": "https://app.peopleforce.io"
    }
  ],
  "paths": {
    "/api/public/v1/asset_assignments": {
      "post": {
        "summary": "Create an asset assignment",
        "tags": [
          "Assets"
        ],
        "operationId": "post-asset_assignments",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "asset_id": {
                    "type": "string"
                  },
                  "user_id": {
                    "type": "string"
                  },
                  "issued_on": {
                    "type": "string",
                    "format": "date"
                  },
                  "returned_on": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "asset_id",
                  "user_id",
                  "issued_on"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "returns the assignment with its return date",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "user_id": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "asset_id": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "issued_on": {
                          "type": "string",
                          "format": "date"
                        },
                        "returned_on": {
                          "nullable": true,
                          "type": "string",
                          "format": "date"
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updated_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "id",
                        "user_id",
                        "asset_id",
                        "issued_on",
                        "returned_on",
                        "created_at",
                        "updated_at"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "responds with 401",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "format": "int32"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "message"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "does not create an asset assignment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "errors"
                  ]
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/api/public/v1/asset_assignments/{id}": {
      "delete": {
        "summary": "Delete an asset assignment",
