                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "employee_id": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "leave_type_id": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "leave_type": {
                          "type": "string"
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "pending",
                            "approved",
                            "rejected",
                            "withdrawn"
                          ]
                        },
                        "amount": {
                          "type": "string"
                        },
                        "hours": {
                          "type": "string"
                        },
                        "tracking_time_in": {
                          "type": "string",
                          "enum": [
                            "hours",
                            "days"
                          ]
                        },
                        "starts_on": {
                          "type": "string",
                          "format": "date"
                        },
                        "ends_on": {
                          "type": "string",
                          "format": "date"
                        },
                        "comment": {
                          "type": "string"
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updated_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "attachment_url": {
                          "nullable": true,
                          "type": "string"
                        },
                        "employee": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "format": "int64"
                            },
                            "first_name": {
                              "type": "string"
                            },
                            "last_name": {
                              "type": "string"
                            },
                            "email": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "first_name",
                            "last_name",
                            "email"
                          ]
                        },
                        "entries": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "date": {
                                "type": "string"
                              },
                              "amount": {
                                "type": "string"
                              },
                              "starts_at": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "ends_at": {
                                "type": "string",
                                "format": "date-time"
                              }
                            },
                            "required": [
                              "date",
                              "amount"
                            ]
                          }
                        },
                        "leave_type_policy": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "visibility": {
                              "type": "string",
                              "enum": [
                                "public",
                                "private"
                              ]
                            },
                            "activity_type": {
                              "type": "string",
                              "enum": [
                                "not_working_paid",
                                "not_working_unpaid",
                                "working_paid"
                              ]
                            }
                          },
                          "required": [
                            "name",
                            "visibility",
                            "activity_type"
                          ]
                        },
                        "approvals": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "state": {
                                "type": "string",
                                "enum": [
                                  "queued",
                                  "pending",
                                  "approved",
                                  "rejected",
                                  "withdrawn",
                                  "skipped"
                                ]
                              },
                              "assigned_to": {
                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "integer",
                                    "format": "int64"
                                  },
                                  "full_name": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "id",
                                  "full_name"
                                ]
                              }
                            },
                            "required": [
                              "state",
                              "assigned_to"
                            ]
                          }
                        }
                      },
                      "required": [
                        "id",
                        "employee_id",
                        "leave_type_id",
                        "leave_type",
                        "state",
                        "amount",
                        "hours",
                        "tracking_time_in",
                        "starts_on",
                        "ends_on",
                        "comment",
                        "created_at",
                        "updated_at",
                        "attachment_url",
                        "employee",
