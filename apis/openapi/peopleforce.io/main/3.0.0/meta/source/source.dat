      "put": {
        "summary": "Update an asset assignment",
        "tags": [
          "Assets"
        ],
        "operationId": "put-asset_assignments-id",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
