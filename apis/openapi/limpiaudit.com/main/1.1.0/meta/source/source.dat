{
  "openapi": "3.1.0",
  "info": {
    "title": "Limpi API",
    "version": "1.1.0",
    "summary": "API publique Limpi v1",
    "description": "API asynchrone pour lancer, suivre et exploiter des audits SEO/GEO. Les erreurs utilisent RFC 9457 application/problem+json.",
    "termsOfService": "https://limpiaudit.com/conditions-generales-utilisation"
  },
  "servers": [
    {
      "url": "https://limpiaudit.com/api/v1",
      "description": "Production"
    }
  ],
  "paths": {
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApiSpecification",
        "summary": "Lire le contrat OpenAPI 3.1",
        "security": [],
        "responses": {
          "200": {
            "description": "Spécification OpenAPI courante.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getApiIdentity",
        "summary": "Lire l'identité API courante",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Identité API.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiIdentityEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/audits": {
      "get": {
        "operationId": "listAudits",
        "summary": "Lister les audits",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "audits:read",
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Curseur opaque signé. Ne pas interpréter."
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "completed",
                "failed",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page d'audits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      },
      "post": {
        "operationId": "createAudit",
        "summary": "Créer un audit asynchrone",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "audits:write",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]{8,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditCreateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Audit accepté.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              },
              "Idempotency-Replayed": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "true"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalProblem"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/audits/{job_id}": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      ],
      "get": {
        "operationId": "getAudit",
        "summary": "Lire un audit",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "audits:read",
        "responses": {
          "200": {
            "description": "Audit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/audits/{job_id}/cancel": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      ],
      "post": {
        "operationId": "cancelAudit",
        "summary": "Annuler un audit",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "audits:write",
        "responses": {
          "200": {
            "description": "Annulation acceptée ou audit déjà annulé.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/audits/{job_id}/report": {
      "parameters": [
        {
          "name": "job_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      ],
      "get": {
        "operationId": "getAuditReport",
        "summary": "Lire le rapport public d'un audit terminé",
        "description": "Projection publique fail-closed. Les nouveaux champs internes ne sont jamais exposés automatiquement. Taille maximale : 4 MiB.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "reports:read",
        "responses": {
          "200": {
            "description": "Rapport public schema_version 1.0.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditReportEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "410": {
            "$ref": "#/components/responses/Gone"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalProblem"
          }
        }
      }
    },
    "/usage": {
      "get": {
        "operationId": "getUsage",
        "summary": "Lire quota et consommation",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-required-scope": "usage:read",
        "responses": {
          "200": {
            "description": "Usage courant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Limpi API key",
        "description": "Transmettre la clé exclusivement via Authorization: Bearer."
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "instance",
          "request_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "Audit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "object",
          "url",
          "domain",
          "status",
          "requested_pages",
          "pages_analyzed",
          "pages_billed",
          "score",
          "progress",
          "created_at",
          "started_at",
          "finished_at",
          "cancel_requested_at",
          "report_available"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "object": {
            "const": "audit"
          },
          "url": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "requested_pages": {
            "type": "integer",
            "minimum": 0
          },
          "pages_analyzed": {
            "type": "integer",
            "minimum": 0
          },
          "pages_billed": {
            "type": "integer",
            "minimum": 0
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "progress": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "current",
              "total",
              "step",
              "label",
              "excluded"
            ],
            "properties": {
              "current": {
                "type": "integer",
                "minimum": 0
              },
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "step": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "excluded": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "cancel_requested_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "report_available": {
            "type": "boolean"
          }
        }
      },
      "AuditCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "URL publique HTTP(S). Les hôtes privés, loopback, link-local et résolutions DNS non publiques sont refusés."
          },
          "max_pages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1500,
            "default": 10
          },
          "max_depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15,
            "default": 2
          },
          "crawl_delay": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "default": 200,
            "description": "Délai en millisecondes."
          },
          "exclude_patterns": {
            "oneOf": [
              {
                "type": "array",
                "maxItems": 30,
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              {
                "type": "string",
                "description": "Compatibilité historique : une entrée par ligne."
              }
            ],
            "default": []
          },
          "client_name": {
            "type": "string",
            "maxLength": 120,
            "default": ""
          },
          "analyst_name": {
            "type": "string",
            "maxLength": 120,
            "default": ""
          }
        },
        "required": [
          "url"
        ]
      },
      "PublicReport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "counts",
          "crawl",
          "section_scores",
          "stats",
          "checks",
          "recommendations",
          "pages"
        ],
        "properties": {
          "schema_version": {
            "const": "1.1"
          },
          "base_url": {
            "type": "string",
            "maxLength": 8192
          },
          "score": {
            "type": "number"
          },
          "scoring_method": {
            "type": "string",
            "maxLength": 256
          },
          "cms": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "counts": {
            "$ref": "#/components/schemas/PublicCounts"
          },
          "crawl": {
            "$ref": "#/components/schemas/PublicCrawl"
          },
          "section_scores": {
            "$ref": "#/components/schemas/PublicSectionScores"
          },
          "stats": {
            "$ref": "#/components/schemas/PublicStats"
          },
          "professional_opinion": {
            "$ref": "#/components/schemas/PublicProfessionalOpinion"
          },
          "professional_opinion_text": {
            "type": "string",
            "maxLength": 8192
          },
          "checks": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/PublicCheck"
            }
          },
          "recommendations": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/PublicRecommendation"
            }
          },
          "pages": {
            "type": "array",
            "maxItems": 1500,
            "items": {
              "$ref": "#/components/schemas/PublicPage"
            }
          }
        }
      },
      "AuditEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Audit"
          }
        }
      },
      "AuditList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "data",
          "has_more",
          "next_cursor"
        ],
        "properties": {
          "object": {
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Audit"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ApiIdentityEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "user_id",
              "api_key"
            ],
            "properties": {
              "type": {
                "const": "api_identity"
              },
              "user_id": {
                "type": "integer"
              },
              "api_key": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "scopes",
                  "created_at",
                  "expires_at"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "scopes": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "audits:read",
                        "audits:write",
                        "reports:read",
                        "usage:read"
                      ]
                    }
                  },
                  "created_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "expires_at": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "UsageEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object",
              "plan",
              "plan_label",
              "monthly_page_quota",
              "monthly_pages_used",
              "monthly_pages_remaining",
              "available_for_next_audit",
              "quota_reset_at"
            ],
            "properties": {
              "object": {
                "const": "usage"
              },
              "plan": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "plan_label": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "monthly_page_quota": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "monthly_pages_used": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "monthly_pages_remaining": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "available_for_next_audit": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "quota_reset_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      },
      "AuditReportEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "object",
              "audit_id",
              "schema_version",
              "report"
            ],
            "properties": {
              "object": {
                "const": "audit_report"
              },
              "audit_id": {
                "type": "string"
              },
              "schema_version": {
                "const": "1.1"
              },
              "report": {
                "$ref": "#/components/schemas/PublicReport"
              }
            }
          }
        }
      },
      "PublicScalarMap": {
        "type": "object",
        "maxProperties": 100,
        "propertyNames": {
          "type": "string",
          "maxLength": 256
        },
        "additionalProperties": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 16384
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "PublicUrlItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 8192
          },
          "context": {
            "type": "string",
            "maxLength": 4096
          },
          "redirect_to": {
            "type": "string",
            "maxLength": 8192
          }
        }
      },
      "PublicBreakdownItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 1024
          },
          "status": {
            "type": "string",
            "maxLength": 128
          },
          "count": {
            "type": "number"
          }
        }
      },
      "PublicExplanationRich": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "problème": {
            "type": "string",
            "maxLength": 8192
          },
          "quoi": {
            "type": "string",
            "maxLength": 8192
          },
          "impact": {
            "type": "string",
            "maxLength": 8192
          },
          "solution": {
            "type": "string",
            "maxLength": 8192
          },
          "analogie": {
            "type": "string",
            "maxLength": 8192
          },
          "benchmarks": {
            "type": "string",
            "maxLength": 8192
          }
        }
      },
      "PublicSeoLengthChart": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "absent": {
            "type": "integer"
          },
          "good": {
            "type": "integer"
          },
          "perfect": {
            "type": "integer"
          },
          "too_long": {
            "type": "integer"
          },
          "too_short": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "PublicCheck": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "actor": {
            "type": "string",
            "maxLength": 16384
          },
          "actor_label": {
            "type": "string",
            "maxLength": 16384
          },
          "detail": {
            "type": "string",
            "maxLength": 16384
          },
          "estimated_time": {
            "type": "string",
            "maxLength": 16384
          },
          "explanation": {
            "type": "string",
            "maxLength": 16384
          },
          "ideal": {
            "type": "string",
            "maxLength": 16384
          },
