                                "maximum": 100
                            },
                            "daycare": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 100
                            },
                            "grooming": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 100
                            },
                            "training": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 100
                            },
                            "classes": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 100
                            }
                        }
                    },
                    "customFields": {
                        "type": "array",
                        "description": "Merged into existing custom field answers; omitted fields are unchanged",
                        "items": {
                            "$ref": "#/components/schemas/CustomFieldAnswer"
                        }
                    },
                    "emergencyContacts": {
                        "type": "array",
                        "description": "Replaces all existing emergency contacts when provided",
                        "items": {
                            "$ref": "#/components/schemas/EmergencyContact"
                        }
                    },
                    "additionalContacts": {
                        "type": "array",
                        "description": "Replaces all existing additional contacts when provided",
