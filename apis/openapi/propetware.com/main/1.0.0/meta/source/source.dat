            "PetDocument": {
                "type": "object",
                "description": "Metadata for one file attached to a pet. The `id` is the handle for the download endpoint; no storage path or storage identifier is exposed.\n",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "The document ID. Pass this to `/accounts/{accountId}/pets/{petId}/documents/{documentId}/download`. Stable for the life of the document.\n"
                    },
                    "name": {
                        "type": "string",
                        "description": "The filename as uploaded."
                    },
                    "mimeType": {
                        "type": "string",
                        "nullable": true,
                        "description": "The file's MIME type, as reported by the browser at upload. `null` on some older rows. Images are re-encoded to JPEG on upload if they exceed 1500px on either side, so an image's stored bytes may not match this exactly.\n",
                        "example": "application/pdf"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "vaccination",
                            "preventive"
                        ],
                        "description": "What the file was uploaded against. This is the only association a file has - it points at a pet and a category, not at an individual vaccination record.\n"
                    },
                    "uploadedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "example": {
                    "id": 4471,
                    "name": "rabies-certificate-2026.pdf",
                    "mimeType": "application/pdf",
                    "type": "vaccination",
                    "uploadedAt": "2026-05-02T14:10:00.000000Z"
                }
            },
            "Note": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Unique note identifier"
                    },
                    "customerId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Associated customer ID (if customer note)"
                    },
                    "petId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Associated pet ID (if pet note)"
                    },
                    "orderId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Associated order ID (if order note)"
                    },
                    "bookingId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "The single booking this note belongs to, or null when the note belongs to the customer, the pet, or the order as a whole.\n\nOnly ever populated on the order-notes list, which is the one list where booking notes and order notes appear together. The customer and pet lists exclude booking notes, so this is always null there.\n\nThe same value the `note.*` webhook payloads carry.\n"
                    },
                    "description": {
                        "type": "string",
                        "description": "Note content"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "normal",
                            "high",
                            "postcard",
                            "photo",
                            "deposit50",
                            "deposit100",
                            "special"
                        ],
                        "description": "Note status/priority"
                    },
                    "initials": {
                        "type": "string",
                        "nullable": true,
                        "description": "Initials of person who created the note"
                    },
                    "noteTags": {
                        "type": "array",
                        "description": "The tags staff have put on this note, resolved in place so no second call is needed. An empty array when the note has none - never null, so it can be iterated unconditionally.\n\nGrouped and ordered the way ProPet's own note-tag picker orders them: by heading display order, then tag display order. That is not the order the tags were applied in.\n\nA tag the facility has since retired stays on the note that carries it and comes back with `active: false`, because the note really does carry it. `/accounts/{accountId}/noteTags` is the full list.\n",
                        "items": {
                            "$ref": "#/components/schemas/NoteTagBrief"
                        }
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true,
                        "description": "Note creation timestamp"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true,
                        "description": "Note last update timestamp"
                    }
                },
                "example": {
                    "id": 456,
                    "customerId": 123,
                    "petId": null,
                    "orderId": null,
                    "bookingId": null,
                    "description": "Customer prefers morning drop-offs",
                    "status": "normal",
                    "initials": "JS",
                    "noteTags": [
                        {
                            "id": 31,
                            "name": "Pet Behaviour",
                            "color": "#c0392b",
                            "displayColor": "#c0392b",
                            "heading": {
                                "id": 4,
                                "name": "Behaviour",
                                "itemOrder": 1,
                                "active": true
                            },
                            "itemOrder": 2,
                            "active": true
                        }
                    ],
                    "createdAt": "2024-01-15T10:00:00.000000Z",
                    "updatedAt": "2024-01-15T10:00:00.000000Z"
                }
            },
            "NoteTagBrief": {
                "type": "object",
                "description": "A note tag as it appears on a note. `NoteTagsPresenter::describe()` builds this and the full `NoteTag` from the same values, so the shape you meet on a note is the shape the reference endpoint returns - the reference endpoint just adds timestamps.\n",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string",
                        "description": "What ProPet prints on the tag, e.g. \"Pet Behaviour\"."
                    },
                    "color": {
                        "type": "string",
                        "nullable": true,
                        "description": "The colour the facility chose, with its leading hash, e.g. `#c0392b`. `null` when it never chose one - read `displayColor` for what ProPet actually paints in that case.\n"
                    },
                    "displayColor": {
                        "type": "string",
                        "description": "The colour ProPet paints this tag, which is `#029ddd` when the facility set none or set something malformed. Two fields rather than one so a chart can tell \"unset\" from a deliberate choice of the default blue.\n\nText on the tag is always white in ProPet's own rendering.\n"
                    },
                    "heading": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/NoteTagHeading"
                            }
                        ],
                        "nullable": true,
                        "description": "The heading the tag is grouped under on the Note Tags screen. `null` when the tag was saved without one.\n\nThis is what makes a tag interpretable: \"Pet Behaviour\" under a \"Behaviour\" heading is a behaviour tag by design rather than by the coincidence of its name.\n"
                    },
                    "itemOrder": {
                        "type": "integer",
                        "description": "The tag's display order within its heading, as arranged on the Note Tag Order screen. Note lists and the tag list are returned by heading order then this, so rendering in the returned order reproduces the picker.\n"
                    },
                    "active": {
                        "type": "boolean",
                        "description": "`false` once the facility has retired the tag. A retired tag stays on the notes that carry it, so it is reported rather than dropped.\n"
                    }
                }
            },
            "NoteTagHeading": {
                "type": "object",
                "description": "The group a note tag belongs to on the Note Tags screen.",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "itemOrder": {
                        "type": "integer",
                        "description": "The heading's display order, as arranged on the Note Tag Heading Order screen."
                    },
                    "active": {
                        "type": "boolean",
                        "description": "`false` once the heading has been retired."
                    }
                }
            },
            "NoteTag": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/NoteTagBrief"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "createdAt": {
                                "type": "string",
                                "format": "date-time",
                                "nullable": true
                            },
                            "updatedAt": {
                                "type": "string",
                                "format": "date-time",
                                "nullable": true
                            },
                            "deletedAt": {
                                "type": "string",
                                "format": "date-time",
                                "nullable": true,
                                "description": "When the tag was retired; `null` while `active` is true."
                            }
                        }
                    }
                ]
            },
            "NoteCreate": {
                "type": "object",
                "required": [
                    "description",
                    "status"
                ],
                "properties": {
                    "description": {
                        "type": "string",
                        "description": "Note content"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "normal",
                            "high",
                            "postcard",
                            "photo",
                            "deposit50",
                            "deposit100",
                            "special"
                        ],
                        "description": "Note status/priority"
                    },
                    "initials": {
                        "type": "string",
                        "maxLength": 10,
                        "description": "Initials of person creating the note"
                    }
                },
                "example": {
                    "description": "Customer requested special pickup time",
                    "status": "normal",
                    "initials": "JD"
                }
            },
            "NoteUpdate": {
                "type": "object",
                "properties": {
                    "description": {
                        "type": "string",
                        "description": "Note content"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "normal",
                            "high",
                            "postcard",
                            "photo",
                            "deposit50",
                            "deposit100",
                            "special"
                        ],
                        "description": "Note status/priority"
                    }
                },
                "example": {
                    "description": "Updated: Customer now prefers afternoon drop-offs",
                    "status": "high"
                }
            },
            "NoteResponse": {
                "type": "object",
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/Note"
                    }
                },
                "example": {
                    "data": {
                        "id": 456,
                        "customerId": 123,
                        "petId": null,
                        "orderId": null,
                        "bookingId": null,
                        "description": "Customer prefers morning drop-offs",
                        "status": "normal",
                        "initials": "JS",
                        "createdAt": "2024-01-15T10:00:00.000000Z",
                        "updatedAt": "2024-01-15T10:00:00.000000Z"
                    }
                }
            },
            "PaginatedNotes": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Note"
                        }
                    },
                    "meta": {
                        "type": "object",
                        "properties": {
                            "pagination": {
                                "type": "object",
                                "properties": {
                                    "currentPage": {
                                        "type": "integer"
                                    },
                                    "perPage": {
                                        "type": "integer"
                                    },
                                    "total": {
                                        "type": "integer"
                                    },
                                    "lastPage": {
                                        "type": "integer"
                                    }
                                }
                            },
                            "filters": {
                                "type": "object",
                                "properties": {
                                    "status": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "noteTagId": {
                                        "type": "integer",
                                        "nullable": true
                                    }
                                }
                            }
                        }
                    }
                },
                "example": {
                    "data": [
                        {
                            "id": 456,
                            "customerId": 123,
                            "petId": null,
                            "orderId": null,
                            "noteTags": [],
                            "description": "Customer prefers morning drop-offs",
                            "status": "normal",
                            "initials": "JS",
                            "createdAt": "2024-01-15T10:00:00.000000Z",
                            "updatedAt": "2024-01-15T10:00:00.000000Z"
                        }
                    ],
                    "meta": {
                        "pagination": {
                            "currentPage": 1,
                            "perPage": 25,
                            "total": 1,
                            "lastPage": 1
                        },
                        "filters": {
                            "status": null
                        }
                    }
                }
            },
