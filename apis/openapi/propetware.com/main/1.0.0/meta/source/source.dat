        "/accounts/{accountId}/customers/{customerId}/notes": {
            "get": {
                "summary": "List customer notes",
                "tags": [
                    "Notes"
                ],
                "description": "The notes attached to the customer, newest first - the same set the customer's notes panel shows in ProPet.\n\nNotes belonging to a single booking are excluded. A booking note written by the calendar carries its customer's id as well as the booking's, so without that exclusion this list would return rows staff do not see in this context. To read the notes on a booking, list the notes on its order; `bookingId` on each note identifies them.\n\nA note is not excluded for also belonging to an order. Order-scoped notes on this customer's orders appear here, as they do in the panel.\n",
                "operationId": "listCustomerNotes",
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
