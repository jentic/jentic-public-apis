                    }
                }
            },
            "patch": {
                "summary": "Update customer",
                "tags": [
                    "Customers"
                ],
                "description": "Update a customer",
                "operationId": "updateCustomer",
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The account ID"
                    },
                    {
                        "name": "customerId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The customer ID"
                    }
                ],
                "requestBody": {
                    "required": true,
