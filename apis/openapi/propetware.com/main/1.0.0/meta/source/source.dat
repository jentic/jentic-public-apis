        "/accounts/{accountId}/pets/{petId}/vaccinations": {
            "get": {
                "summary": "List pet vaccinations",
                "tags": [
                    "Vaccinations"
                ],
                "description": "Retrieve vaccination records for a specific pet with expiration data",
                "operationId": "listPetVaccinations",
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The account ID"
                    },
                    {
                        "name": "petId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The pet ID"
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "up-to-date",
                                "pending",
                                "expired",
                                "about-to-expire",
                                "exception",
                                "missing"
                            ]
                        },
                        "description": "**Not implemented \u2014 accepted and echoed back in `meta.filters`, but the response is not filtered.** Every vaccination type active for the account is returned regardless. Filter client-side on `expirationInfo.effectiveStatus` until this is wired up.\n\nThe values above are the ones the endpoint accepts; anything else is a 422. They are pet-level summary values, not the per-record `effectiveStatus` vocabulary, so they will not be the vocabulary this filter ends up using. Earlier revisions of this spec documented `current`, `due_soon` and similar, which were never accepted.\n"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Pet vaccination records retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/PetVaccination"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                }
            },
            "post": {
                "summary": "Create pet vaccination record",
                "tags": [
                    "Vaccinations"
                ],
                "description": "Record a vaccination for a pet, for a vaccination type it has no record of yet.\n\nThis is create-only. A pet has at most one record per vaccination type, so if one already holds a date, verification status, note or initials, this returns 422 and names the record's ID and the PATCH URL to use instead. The reliable sequence is `GET /pets/{petId}/vaccinations` once, keep the `expirationInfo.id` per type, and PATCH from then on; POST only for a type the GET returned with `expirationInfo: null` or with every field empty.\n\nThe vaccination type must belong to this account, must match the pet's species, and must be active for the account. A record against an inactive type is not returned by any read endpoint, so it is rejected rather than written where nothing can see it.\n",
                "operationId": "createPetVaccination",
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "petId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PetVaccinationCreate"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Vaccination record created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PetVaccination"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                }
            }
        },
