                "properties": {
                    "breed": {
                        "type": "string",
                        "maxLength": 255,
                        "description": "Breed name"
                    },
                    "species": {
                        "type": "string",
                        "enum": [
                            "dog",
                            "cat",
                            "bird",
                            "rabbit",
                            "guinea",
                            "rat",
                            "mouse",
                            "hamster",
                            "chinchilla",
                            "gerbil",
