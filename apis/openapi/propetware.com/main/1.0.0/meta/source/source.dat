            "ColourCode": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "description": "Unique colour code identifier"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "pet",
                            "customer"
                        ],
                        "description": "Type of colour code"
                    },
                    "number": {
                        "type": "integer",
                        "description": "Colour code number"
                    },
                    "label": {
                        "type": "string",
                        "description": "Colour code description/label"
