            "PhoneNumber": {
                "type": "object",
                "properties": {
                    "number": {
                        "type": "string",
                        "description": "Phone number"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "mobile",
                            "work",
                            "home",
                            "other"
                        ],
                        "description": "Type of phone number"
                    }
                },
                "example": {
                    "number": "416-555-1234",
                    "type": "mobile"
                }
            },
            "CustomFieldAnswer": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Custom field ID"
                    },
                    "answer": {
                        "nullable": true,
                        "description": "Answer value. The type depends on the field type: `yesno` returns an integer (1 = Yes, 2 = No) or null if unanswered; `select` and `radio` return the raw option value as a string; `checkbox` returns an array of selected raw option values; `text` and `textarea` return a plain string.\n",
                        "oneOf": [
                            {
                                "type": "integer",
                                "description": "yesno: 1 (Yes) or 2 (No)",
                                "enum": [
                                    1,
                                    2
                                ]
                            },
                            {
                                "type": "string",
                                "description": "text, textarea, select, radio: raw value"
                            },
                            {
                                "type": "array",
                                "description": "checkbox: array of selected raw option values",
                                "items": {
                                    "type": "string"
                                }
                            }
                        ]
                    }
                },
                "examples": {
                    "yesno": {
                        "value": {
                            "id": "177666",
                            "answer": 1
                        }
                    },
                    "select": {
                        "value": {
                            "id": "123",
                            "answer": "google"
                        }
                    },
                    "checkbox": {
                        "value": {
                            "id": "456",
                            "answer": [
                                "monday",
                                "wednesday"
                            ]
                        }
                    },
                    "unanswered": {
                        "value": {
                            "id": "789",
                            "answer": null
                        }
                    }
                }
            },
            "CustomFieldValue": {
                "type": "object",
                "description": "A custom field on a customer or pet response.\n\nBy default only `id` and `answer` are present, and the list holds just the answers stored on the record - a field nobody has answered is absent entirely. Pass `includeEmptyCustomFields=true` and the list becomes every field the account has configured for customers/pets, with `question`, `fieldType` and `answered` filled in on each entry.\n",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Custom field ID"
                    },
                    "answer": {
                        "nullable": true,
                        "description": "Answer value. The type depends on the field type: `yesno` returns an integer (1 = Yes, 2 = No) or null if unanswered; `select` and `radio` return the raw option value as a string; `checkbox` returns an array of selected raw option values; `text` and `textarea` return a plain string.\n\nWhen `includeEmptyCustomFields=true`, an unanswered field returns `null` here - or `[]` for `checkbox`, so its type never changes.\n",
                        "oneOf": [
                            {
                                "type": "integer",
                                "description": "yesno: 1 (Yes) or 2 (No)",
                                "enum": [
                                    1,
                                    2
                                ]
                            },
                            {
                                "type": "string",
                                "description": "text, textarea, select, radio: raw value"
                            },
                            {
                                "type": "array",
                                "description": "checkbox: array of selected raw option values",
                                "items": {
                                    "type": "string"
                                }
                            }
                        ]
                    },
                    "question": {
                        "type": "string",
                        "description": "The question as configured in Settings. Present only when `includeEmptyCustomFields=true`.\n"
                    },
                    "fieldType": {
                        "type": "string",
                        "enum": [
                            "yesno",
                            "text",
                            "textarea",
                            "select",
                            "radio",
                            "checkbox"
                        ],
                        "description": "How the field is answered, so a consumer knows how to read `answer`. Present only when `includeEmptyCustomFields=true`. Use `GET /accounts/{accountId}/customerFields/custom` or `GET /accounts/{accountId}/petFields/custom` for the option labels behind a `select`, `radio` or `checkbox` value.\n"
                    },
                    "answered": {
                        "type": "boolean",
                        "description": "Whether this record has a response for the field. Present only when `includeEmptyCustomFields=true`, where it is the reliable way to tell an unanswered field from one answered with an empty value.\n"
                    }
                },
                "examples": {
                    "default": {
                        "value": {
                            "id": "123",
                            "answer": "google"
                        }
                    },
                    "full": {
                        "value": {
                            "id": "123",
                            "question": "How did you hear about us?",
                            "fieldType": "select",
                            "answer": "google",
                            "answered": true
                        }
                    },
                    "fullUnanswered": {
                        "value": {
                            "id": "789",
                            "question": "Bus route",
                            "fieldType": "select",
                            "answer": null,
                            "answered": false
                        }
                    }
                }
            },
            "EmergencyContact": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 255
                    },
                    "relationship": {
                        "type": "string",
                        "maxLength": 255,
                        "nullable": true
                    },
                    "phoneNumber": {
                        "type": "string",
                        "maxLength": 255,
                        "nullable": true
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 255,
                        "nullable": true
                    },
                    "address": {
                        "type": "string",
                        "nullable": true
                    },
                    "generalNotes": {
                        "type": "string",
                        "nullable": true
                    }
                }
            },
            "AdditionalContact": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "readOnly": true
                    },
