        "/accounts/{accountId}/kennels": {
            "get": {
                "summary": "List kennels",
                "tags": [
                    "Kennels"
                ],
                "description": "Every kennel (\"spot\") on the account, in the order the account arranged them on its Kennel Builder screen: by the display order of the kennel type, then by the kennel's own sort value, so kennel 2 comes before kennel 10 rather than after it. Kennels whose type has been deleted sort last.\n\nEach row carries its kennel type inline, so grouping or colouring a list of kennels needs no second request. Retired kennels are included by default - see `active`.\n\nNot paginated. This is reference data: an account has tens to hundreds of kennels, not thousands.\n",
                "operationId": "listKennels",
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The account ID"
                    },
                    {
                        "name": "kennelTypeId",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "Return only kennels of this kennel type."
                    },
                    {
                        "name": "species",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "dog",
                                "cat",
                                "bird",
                                "rabbit",
                                "guinea",
                                "rat",
                                "mouse",
                                "hamster",
                                "chinchilla",
                                "gerbil",
                                "ferret",
                                "hedgehog",
                                "horse",
                                "pig",
                                "fish",
                                "turtle",
                                "amphibian",
                                "reptile",
                                "goat",
                                "primate",
                                "chicken",
                                "cow",
                                "sugarglider"
                            ]
                        },
                        "description": "Return only kennels whose kennel type accepts this species. A species the account has configured no type for returns an empty list, not everything.\n"
                    },
                    {
                        "name": "q",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "maxLength": 200
                        },
                        "description": "Case-insensitive substring match against the kennel's name and its number.\n"
                    },
                    {
                        "$ref": "#/components/parameters/KennelActive"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Kennels retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Kennel"
                                            }
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "total": {
                                                    "type": "integer"
                                                },
                                                "filters": {
                                                    "type": "object",
                                                    "description": "The filter parameters as received."
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                }
            }
        },
        "/accounts/{accountId}/kennels/{kennelId}": {
            "get": {
                "summary": "Get kennel",
                "tags": [
                    "Kennels"
                ],
                "description": "A single kennel by ID, with its kennel type inline.\n\nResolves retired kennels too, so a `kennelId` taken from an older booking always resolves to a name rather than a `404`.\n",
