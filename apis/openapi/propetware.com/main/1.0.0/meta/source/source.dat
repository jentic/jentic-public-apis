                                "chinchilla",
                                "gerbil",
                                "ferret",
                                "hedgehog",
                                "horse",
                                "pig",
                                "fish",
                                "turtle",
                                "amphibian",
                                "reptile",
                                "goat",
                                "primate",
                                "chicken",
