        "/accounts/{accountId}/breeds": {
            "get": {
                "summary": "List breeds",
                "tags": [
                    "Breeds"
                ],
                "description": "Retrieve all breeds for an account. Optionally filter by species or search by name.",
                "operationId": "listBreeds",
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "accountId",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "in": "query",
                        "name": "species",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "dog",
                                "cat",
                                "bird",
                                "rabbit",
                                "guinea",
                                "rat",
                                "mouse",
                                "hamster",
                                "chinchilla",
                                "gerbil",
                                "ferret",
                                "hedgehog",
                                "horse",
                                "pig",
                                "fish",
                                "turtle",
                                "amphibian",
                                "reptile",
                                "goat",
                                "primate",
                                "chicken",
                                "cow",
                                "sugarglider"
                            ]
                        },
                        "description": "Filter breeds by species"
                    },
                    {
                        "in": "query",
                        "name": "q",
                        "schema": {
                            "type": "string",
                            "maxLength": 200
                        },
                        "description": "Search breeds by name"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of breeds",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
