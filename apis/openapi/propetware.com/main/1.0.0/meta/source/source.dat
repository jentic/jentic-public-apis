                        "type": "string",
                        "nullable": true,
                        "description": "Country"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "new",
                            "active",
                            "inactive",
                            "disabled"
                        ],
                        "description": "Customer status"
                    },
                    "phoneNumbers": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/PhoneNumber"
                        },
                        "description": "Array of phone numbers"
                    },
                    "customFields": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CustomFieldValue"
                        },
                        "description": "Custom field responses. Only the answers stored on this customer by default; pass `includeEmptyCustomFields=true` for every customer custom field the account has configured, answered or not.\n"
                    },
                    "colourCodes": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "description": "Color codes associated with customer"
                    },
                    "gdprAgreedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true,
                        "description": "GDPR agreement timestamp"
                    },
                    "availableCredit": {
                        "type": "number",
                        "format": "float",
                        "description": "Credit the customer currently has on account, in the account's currency: payments held in the credit pool less credit already applied to orders. `0` when the customer has none.\n\nDerived on every read - there is no stored balance - and rounded the way the Customer screen rounds it, so the two always agree. Note that zero-decimal currencies such as KES and THB round to whole units.\n\nRead only. Credit cannot yet be added or spent through the API.\n"
                    },
                    "createdByUserId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "ID of user who created this customer"
                    },
                    "createdByUserInitials": {
                        "type": "string",
                        "nullable": true,
                        "description": "Initials of user who created this customer"
                    },
                    "personalDiscounts": {
                        "$ref": "#/components/schemas/PersonalDiscounts"
                    },
                    "emergencyContacts": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/EmergencyContact"
                        }
                    },
                    "additionalContacts": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/AdditionalContact"
                        }
                    }
                },
                "example": {
                    "id": 1234,
                    "createdAt": "2024-01-15T10:00:00.000Z",
                    "updatedAt": "2024-01-15T15:30:00.000Z",
                    "firstName": "John",
                    "lastName": "Smith",
                    "fullName": "John Smith",
                    "email": "john.smith@example.com",
                    "companyName": "ABC Pet Services",
                    "streetAddress": "123 Main Street",
                    "suburb": "Downtown",
                    "city": "Toronto",
                    "province": "ON",
                    "postalCode": "M5H 2N2",
                    "country": "Canada",
                    "status": "active",
                    "phoneNumbers": [
                        {
                            "number": "416-555-1234",
                            "type": "mobile"
                        },
                        {
                            "number": "416-555-5678",
                            "type": "home"
                        }
                    ],
                    "customFields": [
                        {
                            "id": "123",
                            "answer": "Google"
                        }
                    ],
                    "colourCodes": [],
                    "gdprAgreedAt": "2024-01-15T10:00:00Z",
                    "availableCredit": 45.5,
                    "createdByUserId": 5,
                    "createdByUserInitials": "JS",
                    "personalDiscounts": {
                        "boarding": 10,
                        "daycare": 15,
                        "grooming": 5,
                        "training": 20,
                        "classes": 0
                    }
                }
            },
