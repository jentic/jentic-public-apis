                        "spayedNeuteredOrIntact": {
                            "label": "Spayed/neutered or intact",
                            "included": true,
                            "required": false,
                            "notifyOnChange": false
                        },
                        "breed": {
                            "label": "Breed",
                            "included": true,
                            "required": true,
                            "notifyOnChange": false
                        },
                        "colour": {
                            "label": "Colour",
                            "included": true,
                            "required": false,
                            "notifyOnChange": false
                        },
