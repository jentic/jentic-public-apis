        "/accounts/{accountId}/pets/{petId}/documents": {
            "get": {
                "summary": "List pet documents",
                "tags": [
                    "Documents"
                ],
                "description": "Metadata for the files attached to a pet - the vaccination certificates and preventive records uploaded through the account UI. Newest first.\n\nMetadata only. No file contents and no storage location: fetch the bytes from `/accounts/{accountId}/pets/{petId}/documents/{documentId}/download` using the `id` from this list.\n\nA file is linked to a **pet and a coarse type**, never to an individual vaccination record, so \"the certificate for this pet's Rabies vaccination\" is not a question this data can answer - \"this pet's vaccination documents\" is.\n\nRows are not checked against storage while listing. A document whose file has since been removed from storage still appears here and returns `404` on download.\n",
                "operationId": "listPetDocuments",
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The account ID"
                    },
                    {
                        "name": "petId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The pet ID"
                    },
                    {
                        "name": "type",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "vaccination",
                                "preventive"
                            ]
                        },
                        "description": "Return only documents of this type; omit for all of a pet's documents. These two are the only values the uploader ever writes, so anything else returns `422` rather than an empty list.\n"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Pet documents retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/PetDocument"
                                            }
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "account_id": {
                                                    "type": "integer"
                                                },
                                                "pet_id": {
                                                    "type": "integer"
                                                },
                                                "filters": {
                                                    "type": "object",
                                                    "description": "The filter parameters as received."
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                }
            }
        },
        "/accounts/{accountId}/pets/{petId}/documents/{documentId}/download": {
            "get": {
                "summary": "Download a pet document",
                "tags": [
                    "Documents"
                ],
                "description": "Streams the file back. The response body is the file itself, with `Content-Type` set from the document's `mimeType` and `Content-Disposition: attachment` carrying its `name` - not JSON, and not a redirect.\n\nThere is no signed-URL form. Vaccination and preventive uploads are private, and the response is streamed so that the storage location never reaches the caller and the `documents:read` check runs on every read rather than once, when a URL was minted. Treat the endpoint itself as the durable reference to a file.\n\nA `404` means the document id is unknown, belongs to another pet, has been deleted, or the row has outlived its file in storage. The four are deliberately indistinguishable.\n",
                "operationId": "downloadPetDocument",
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The account ID"
                    },
                    {
                        "name": "petId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The pet ID"
                    },
                    {
                        "name": "documentId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The document ID (`id` from the pet documents list)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The file",
                        "content": {
                            "application/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                }
            }
        },
