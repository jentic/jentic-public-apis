            "PaginationLinks": {
                "type": "object",
                "properties": {
                    "first": {
                        "type": "string",
                        "nullable": true
                    },
                    "last": {
                        "type": "string",
                        "nullable": true
                    },
                    "prev": {
                        "type": "string",
                        "nullable": true
                    },
                    "next": {
                        "type": "string",
                        "nullable": true
                    }
                }
            },
            "PaginationMeta": {
                "type": "object",
                "description": "The `meta` object on every paginated response.\n\nNote the nesting: the page counters are under `meta.pagination`, not directly on `meta`. This schema described them as flat until 2026-09-03, which was simply wrong - `BaseApiController::paginatedResponse()` has always nested them. If you read `meta.currentPage` and got nothing, that is why.\n",
                "properties": {
                    "pagination": {
                        "type": "object",
                        "properties": {
                            "currentPage": {
                                "type": "integer"
                            },
                            "perPage": {
                                "type": "integer"
                            },
                            "total": {
                                "type": "integer"
                            },
                            "lastPage": {
                                "type": "integer"
                            }
                        }
                    },
                    "filters": {
                        "type": "object",
                        "description": "The filter parameters as received, echoed back. Only the keys you actually sent are present, so treat a missing key as \"not filtered\" rather than expecting the full set.\n"
                    }
                }
            },
            "PaginatedAccounts": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Account"
                        }
                    },
                    "meta": {
                        "$ref": "#/components/schemas/PaginationMeta"
                    }
                }
            },
            "PaginatedCustomers": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Customer"
                        }
                    },
                    "meta": {
                        "$ref": "#/components/schemas/PaginationMeta"
                    }
                }
            },
            "PaginatedUsers": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/User"
                        }
                    },
                    "meta": {
                        "$ref": "#/components/schemas/PaginationMeta"
                    }
                }
            },
            "UserBrief": {
                "type": "object",
                "description": "Compact staff user, embedded where a record identifies the staff member who acted so that no second request is needed. The full record, including role, is available from the users endpoints.\n",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "active": {
                        "type": "boolean",
                        "description": "`false` for staff who have been deactivated. Their records remain resolvable.\n"
                    }
                }
            },
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "role": {
                        "type": "object",
                        "nullable": true,
                        "description": "The staff member's role. `null` for superadmins, who sit outside the role system, and for staff whose role has since been removed. Check `isSuperAdmin` to tell those cases apart.\n",
                        "properties": {
                            "id": {
                                "type": "integer"
                            },
                            "name": {
                                "type": "string"
                            }
                        }
                    },
                    "roleName": {
                        "type": "string",
                        "nullable": true,
                        "description": "Display label for the role, matching what the ProPet interface shows. `Superuser` for superadmins.\n"
                    },
                    "isSuperAdmin": {
                        "type": "boolean"
                    },
                    "color": {
                        "type": "string",
                        "nullable": true,
                        "description": "Colour ProPet uses for this staff member in the scheduler, for display parity in external tools.\n"
                    },
                    "active": {
                        "type": "boolean",
                        "description": "`false` for staff who have been deactivated. They are returned so that historical records referencing their `userId` stay resolvable.\n"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "deletedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true,
                        "description": "When the staff member was deactivated, if they were."
                    }
                }
            },
            "PaginatedPets": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Pet"
                        }
                    },
                    "meta": {
                        "$ref": "#/components/schemas/PaginationMeta"
                    }
                }
            },
            "OrderTax": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "amount": {
                        "type": "number"
                    }
                }
            },
            "OrderInvoice": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "number": {
                        "type": "string"
                    },
                    "date": {
                        "type": "string",
                        "format": "date"
                    }
                }
            },
            "Order": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "boarding",
                            "classes",
                            "daycare",
                            "grooming",
                            "retail",
                            "standalone",
                            "training",
                            "voucher"
                        ]
                    },
                    "orderNumber": {
                        "type": "string"
                    },
                    "customerId": {
                        "type": "integer"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "request",
                            "pending",
                            "booked",
                            "change_request",
                            "replaced",
                            "declined",
                            "cancelled"
                        ],
                        "description": "`cancelled` is reported here in place of the stored status whenever the order is cancelled, so it is a status value even though it cannot be filtered on. `change_request`, `replaced` and `declined` are only returned when asked for - see `includeNonBookable`.\n"
                    },
                    "startDate": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "endDate": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "subtotal": {
                        "type": "number"
                    },
                    "taxes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderTax"
                        }
                    },
                    "total": {
                        "type": "number"
                    },
                    "totalPayment": {
                        "type": "number"
                    },
                    "balanceOwing": {
                        "type": "number"
                    },
                    "hasChangeRequest": {
                        "type": "boolean"
                    },
                    "changeRequestParentId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "ID of the order this one was cloned from, and proposes to replace. Present on change request orders. Always a lower ID than this order's own, because the parent is the older row.\n"
                    },
                    "changeRequestChildId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "ID of the change request cloned from this order. Present on the order being changed. Always a higher ID than this order's own.\n"
                    },
                    "masterOrderId": {
                        "type": "integer",
                        "description": "ID of the order at the root of this order's change-request chain - the reservation as it was originally booked, before any change request replaced it.\n\nEqual to `id` for an order that has never been change requested, which is most of them, so you can group by it unconditionally rather than walking `changeRequestParentId` yourself. A reservation changed twice gives three orders that all share one `masterOrderId`.\n"
                    },
                    "changeRequestStatus": {
                        "type": "string",
                        "nullable": true,
                        "enum": [
                            "request",
                            "pending",
                            "accepted",
                            "declined"
                        ],
                        "description": "Status of the change request; present on the child (change request) order"
                    },
                    "invoice": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/OrderInvoice"
                            }
                        ],
                        "nullable": true
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "cancelled": {
                        "type": "boolean"
                    },
                    "cancelledAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "cancellationTypeId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "ID of the cancellation reason the cancellation was recorded with; `null` on an order that is not cancelled, and on one cancelled before the facility had any reason configured.\n\nResolve it with `/accounts/{accountId}/cancellationTypes/{id}`, or read `cancellationType` below, which is the same lookup already done.\n\nNot to be confused with a customer's *request* to cancel, which is a different record and is not exposed.\n"
                    },
                    "cancellationType": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/CancellationTypeBrief"
                            }
                        ],
                        "nullable": true,
                        "description": "The reason resolved in place, so `cancellationTypeId` needs no second call. `null` whenever `cancellationTypeId` is.\n"
                    },
                    "cancellationNotes": {
                        "type": "string",
                        "nullable": true,
                        "description": "Free text typed alongside the reason when the order was cancelled.\n"
                    },
                    "cancellationInitials": {
                        "type": "string",
                        "nullable": true,
                        "description": "Initials typed by whoever cancelled the order. Free text, not a `userId` - no staff user is recorded against a cancellation, so there is nothing to resolve against `/accounts/{accountId}/users`.\n"
                    },
                    "pendingReasonId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "ID of the pending reason option; present when status is 'pending'"
                    }
                }
            },
            "CancellationType": {
                "type": "object",
                "description": "A cancellation reason on the account - what ProPet calls a cancellation type, and what its Administration screen calls a Cancellation Reason. The row an order's `cancellationTypeId` points at.\n\nThe reason also carries the email subject and body a facility mails the customer when it cancels under this reason. Those are not returned: they are account settings content rather than order data, and this endpoint is on `orders:read`. Ask if you need them.\n",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string",
                        "description": "What ProPet prints for this reason, e.g. \"No show\"."
                    },
                    "itemOrder": {
                        "type": "integer",
                        "description": "The display order of the reason list, and the order this endpoint returns it in.\n\nWorth knowing that it means little in practice. Only the two reasons created with a new account carry a value (1 and 2); there is no reorder control on the Cancellation Reasons screen, so every reason a facility adds itself is `0` and therefore sorts ahead of the defaults. It is reported as stored rather than tidied up, because this is the order the facility's own screen shows. Sort by `name` if you want something stable to look at.\n"
                    },
                    "active": {
                        "type": "boolean",
                        "description": "`false` once the facility has retired the reason. Retired reasons still label the orders cancelled under them, so they are returned rather than 404'd - see the `active` query parameter.\n"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "deletedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true,
                        "description": "When the reason was retired; `null` while `active` is true."
                    }
                }
            },
            "CancellationTypeBrief": {
                "type": "object",
                "description": "The compact form embedded on an order as `cancellationType`. `active` is included because a reason retired since the order was cancelled still labels it, and a consumer needs to be able to tell the difference between \"this is why\" and \"this is why, and we do not use that reason any more\".\n\n`itemOrder` and the timestamps are omitted here; read the full `CancellationType` if you need them.\n",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "active": {
                        "type": "boolean"
                    }
                }
            },
            "PendingReasonOption": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "serviceType": {
                        "type": "string"
                    },
                    "emailSubject": {
                        "type": "string"
                    },
                    "emailBody": {
                        "type": "string"
                    },
                    "textMessage": {
                        "type": "string"
                    },
                    "itemOrder": {
                        "type": "integer"
                    },
                    "allowCustomersPayOnline": {
                        "type": "boolean"
                    },
                    "paymentAmountType": {
                        "type": "string",
                        "nullable": true,
                        "description": "Present when allowCustomersPayOnline is true"
                    },
                    "paymentFixedAmount": {
                        "type": "number",
                        "nullable": true,
                        "description": "Present when allowCustomersPayOnline is true"
                    },
                    "acceptOnlineTips": {
                        "type": "boolean",
                        "description": "Present when allowCustomersPayOnline is true"
                    },
                    "onlineTipAdjustmentId": {
                        "nullable": true,
                        "description": "Present when allowCustomersPayOnline is true"
                    }
                }
            },
            "OrderLineItem": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "type": {
                        "type": "string"
                    },
                    "productId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Reference to the product ID for this line item. Populated for rate, addon, auto-adjustment, and managed-adjustment types. `null` for manual adjustments and other types with no linked product.\n"
                    },
                    "name": {
                        "type": "string",
                        "nullable": true,
                        "description": "Human-readable label for this line item (e.g. \"Shorten Stay\", \"Waive of Change Fee\"). Populated for all types that carry a description; `null` otherwise.\n"
                    },
                    "petIds": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    },
                    "quantity": {
                        "type": "number"
                    },
                    "subtotal": {
                        "type": "number"
                    },
                    "tax": {
                        "type": "number"
                    }
                }
            },
            "OrderBookingPet": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "species": {
                        "type": "string"
                    }
                }
            },
            "OrderBooking": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "type": {
                        "type": "string"
                    },
                    "pet": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/OrderBookingPet"
                            }
                        ],
                        "nullable": true
                    },
                    "lineItemId": {
                        "type": "integer",
                        "nullable": true
                    },
                    "startDateTime": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
                        "example": "2026-09-03 07:30:00",
                        "nullable": true,
                        "description": "Facility-local wall clock, `YYYY-MM-DD HH:MM:SS`, with no timezone marker. Composed from the stored date and the stored minute-of-day.\n\n**Not `format: date-time`.** This field has always returned a naive wall clock and an RFC 3339 parser will reject it. The account's `timezone` is on the account object if you need to resolve an instant. `endDateTime`, `arrivedAt` and `departedAt` carry the same representation, as do the two dates on each `kennelAssignments` entry.\n"
                    },
                    "endDateTime": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
                        "example": "2026-09-05 11:00:00",
                        "nullable": true
                    },
                    "arrivedAt": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
                        "example": "2026-09-03 07:34:00",
                        "nullable": true,
                        "description": "When the pet actually checked in. `null` until it does.\n"
                    },
                    "departedAt": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
                        "example": "2026-09-05 10:52:00",
                        "nullable": true
                    },
                    "kennelId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Primary kennel assigned to this booking."
                    },
                    "kennel": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/KennelBrief"
                            }
                        ],
                        "nullable": true,
                        "description": "The kennel named by `kennelId`, resolved inline. `null` when no kennel is assigned yet. Kennels the facility has since retired are still resolved here, with `active: false`.\n\nReturned under `orders:read` alone. The `kennels:read` ability is only needed for the kennels endpoints themselves.\n"
                    },
                    "kennelAssignments": {
                        "type": "array",
                        "nullable": true,
                        "description": "Per-segment kennel assignments for bookings where the pet rotates between kennels during the stay (split bookings). `null` when the pet stays in the same kennel for the entire booking.\n",
                        "items": {
                            "type": "object",
                            "properties": {
                                "kennelId": {
                                    "type": "integer"
                                },
                                "kennel": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/KennelBrief"
                                        }
                                    ],
                                    "nullable": true,
                                    "description": "The kennel named by `kennelId`, resolved inline."
                                },
                                "startDate": {
                                    "type": "string",
                                    "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
                                    "example": "2026-09-03 07:30:00",
                                    "nullable": true,
                                    "description": "When the pet moved into this kennel. Facility-local wall clock, `YYYY-MM-DD HH:MM:SS`, the same representation as `startDateTime` on the booking.\n\n**Changed 2026-09-03.** These two fields previously returned an ISO-8601 instant with the time of day dropped and the remaining midnight labelled `America/Montreal` regardless of where the facility is - a 07:30 move was reported as `2026-09-03T04:00:00.000000Z`. They now carry the time.\n"
                                },
                                "endDate": {
                                    "type": "string",
                                    "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
                                    "example": "2026-09-04 09:15:00",
                                    "nullable": true,
                                    "description": "When the pet left this kennel. Same representation as `startDate`, and changed at the same time.\n"
                                }
                            }
                        }
                    },
                    "userId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "The staff member assigned to this booking."
                    },
                    "user": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/UserBrief"
                            }
                        ],
                        "nullable": true,
                        "description": "The staff member named by `userId`, resolved inline. `null` when no staff member is assigned. Staff who have since left are still resolved here, with `active: false`.\n"
                    }
                }
            },
            "Payment": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "amount": {
                        "type": "number",
                        "format": "float"
                    },
                    "method": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string",
                        "nullable": true
                    },
                    "initials": {
                        "type": "string",
                        "nullable": true
                    },
                    "paymentDate": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "paidBy": {
                        "type": "string",
                        "nullable": true
                    },
                    "cardTypeExternal": {
                        "type": "string",
                        "nullable": true
                    },
                    "gateway": {
                        "type": "string",
                        "nullable": true
                    },
                    "isDeposit": {
                        "type": "boolean"
                    },
                    "creditPool": {
                        "type": "boolean"
                    },
                    "bulkPaymentId": {
                        "type": "integer",
                        "nullable": true
                    },
                    "freeCreditDescription": {
                        "type": "string",
                        "nullable": true
                    },
                    "qbSyncedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "refundedAmount": {
                        "type": "number",
                        "format": "float",
                        "nullable": true
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                }
            },
            "OrderDetail": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Order"
                    },
                    {
                        "type": "object",
                        "properties": {
                            "lineItems": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/OrderLineItem"
                                }
                            },
                            "bookings": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/OrderBooking"
                                }
                            },
                            "payments": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/Payment"
                                }
                            },
                            "questions": {
                                "type": "array",
                                "description": "Booking form questions and answers. Present only when `includeQuestions=true`.\n\nOne entry per pet per service, not per booking - see `OrderQuestions`.\n",
                                "items": {
                                    "$ref": "#/components/schemas/OrderQuestions"
                                }
                            }
                        }
                    }
                ]
            },
            "PaginatedOrders": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Order"
                        }
                    },
                    "meta": {
                        "type": "object",
                        "properties": {
                            "pagination": {
                                "type": "object",
                                "properties": {
                                    "currentPage": {
                                        "type": "integer"
                                    },
                                    "perPage": {
                                        "type": "integer"
                                    },
                                    "total": {
                                        "type": "integer"
                                    },
                                    "lastPage": {
                                        "type": "integer"
                                    }
                                }
                            },
                            "filters": {
                                "type": "object",
                                "description": "The filters as received. Only the keys you sent are present.\n\nThis previously listed `startDate` and `endDate`, which are not parameters this endpoint has ever accepted - the four real date filters are below.\n",
                                "properties": {
                                    "minStartDate": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "maxStartDate": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "minEndDate": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "maxEndDate": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "status": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "type": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "orderNumber": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "customerId": {
                                        "type": "integer",
                                        "nullable": true
                                    },
                                    "petId": {
                                        "type": "integer",
                                        "nullable": true
                                    },
                                    "includeNonBookable": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "OrderDetailResponse": {
                "type": "object",
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/OrderDetail"
                    }
                }
            },
            "OrderQuestions": {
                "type": "object",
                "description": "One pet's answers to one service's booking form.\n\nAn order holds several of these. A pet on a boarding reservation that also has grooming booked answers two forms - the boarding form and the grooming add-on form - and each is its own entry. A retail or facility rental order has one entry with no pet at all. A pet enrolled in three classes gets one entry per class, because class questions are configured per class.\n\nThey are a list on the order rather than nested inside `bookings` for that reason: add-on and retail answers have no booking row to hang from, so nesting them would silently drop them. Join on `petId` and `serviceType` if you need to pair an entry with a booking.\n\nAn entry only appears if at least one question was answered. A form the customer left blank is not reported as an empty entry, because that would read as \"nothing was asked\".\n",
                "properties": {
                    "petId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "The pet whose form this is. `null` on a retail or facility rental order, where the questions are asked of the order rather than of an animal.\n"
                    },
                    "serviceType": {
                        "type": "string",
                        "description": "The service whose form this is: `boarding`, `daycare`, `grooming`, `training`, `classes`, `standalone`, `retail` or `facility`.\n\nThis is not always the order's own `type`. An add-on service scheduled against a reservation has its own form, and its own entry here, under its own service type.\n"
                    },
                    "trainingClassId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "The training class this entry's questions belong to. `null` on every service type other than `classes`.\n\nClass questions are configured per class, and a pet enrolled in more than one answers each set, so an entry per class is the only way to attribute an answer to the class that asked for it.\n"
                    },
                    "respondedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true,
                        "description": "When this form was last saved. The \"Response date\" facility staff see on the booking sheet.\n\nIt covers the whole form, not a single answer - there is no per-question timestamp. `null` for a response saved before the field was recorded.\n"
                    },
                    "groups": {
                        "type": "array",
                        "description": "The questions, grouped the way the account grouped them on the form.\n\nHeadings like \"Booking Information\" or \"Checkin Questions\" are configured as fields in their own right, and staff read the questions under them as a block, so they are reported as groups rather than flattened away. A heading whose questions were all unanswered is not reported, and neither is the heading.\n",
                        "items": {
                            "$ref": "#/components/schemas/OrderQuestionGroup"
                        }
                    }
                }
            },
            "OrderQuestionGroup": {
                "type": "object",
                "description": "A heading from the booking form and the questions under it.\n",
                "properties": {
                    "heading": {
                        "type": "string",
                        "nullable": true,
                        "description": "The heading as configured in Settings. `null` for questions that come before the first heading on the form - the account has not grouped those, and inventing a label for them would be a guess.\n"
                    },
                    "questions": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/OrderQuestion"
                        }
                    }
                }
            },
            "OrderQuestion": {
                "type": "object",
                "description": "One booking form question and the answer given.\n\nOnly answered questions are reported. A question the customer left blank is omitted, which matches what facility staff see - the booking sheet drops blank answers too. It also means the list cannot be read as the account's form definition: use `GET /accounts/{accountId}/customFields` for that.\n\nAn answer stored against a field the account has since unassigned from this pet's species is also not reported, for the same reason: the facility no longer sees it either.\n",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "The custom field ID, as a string. Stable across orders, so it is the key to match a question by rather than its text.\n"
                    },
                    "question": {
                        "type": "string",
                        "description": "The question as configured in Settings.\n"
                    },
                    "shortQuestion": {
                        "type": "string",
                        "description": "The account's short label for the question, for places a full sentence does not fit. Falls back to `question` when no short form is configured.\n"
                    },
                    "fieldType": {
                        "type": "string",
                        "description": "How the question is answered, and therefore how to read `answer`: `text`, `textarea`, `yesno`, `select`, `radio`, `checkbox`, `smart_feeding`, `file` or `date`.\n"
                    },
                    "adminOnly": {
                        "type": "boolean",
                        "description": "Whether the facility has marked this question as staff-only.\n\nThese are returned, flagged rather than withheld: an API key is a facility credential, and the account portal shows them. A consumer building a customer-facing screen should hide anything flagged here, the way the customer portal does. Always `false` on class questions, which have no staff-only setting.\n"
                    },
                    "answer": {
                        "description": "The answer, typed by `fieldType`:\n\n* `text`, `textarea`, `date` - a string.\n* `yesno` - an integer, `1` for Yes and `2` for No.\n* `select`, `radio` - the chosen option's raw value as a string. Use `GET /accounts/{accountId}/customFields` for the option labels.\n* `checkbox` - an array of the chosen raw option values.\n* `smart_feeding` - an array of feeding rows, each with `frequency`, `quantity`, `unit`, `foodType` and `notes`. The four lookups are objects of `{id, name}`; `notes` is a string.\n* `file` - an object with `fileName`, `orderId`, `petId` and `customFieldId`. There is no download endpoint for these: a custom field upload is stored as a filename against the order, not as a document record, so `GET /pets/{petId}/documents` does not list it.\n"
                    }
                }
            },
            "BookingOrderBrief": {
                "type": "object",
                "description": "The reservation a booking belongs to, resolved inline so a day sheet does not need a request per row.\n\nEnough to label and link the booking. For line items, payments, notes, cancellation details or the customer's own record, fetch `GET /accounts/{accountId}/orders/{orderId}`.\n\nOrders the facility has since deleted are still resolved here, so a booking never comes back with a bare id and no number.\n",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "orderNumber": {
                        "type": "string",
                        "description": "The booking number staff read off a sheet - `#B001234`. Pass it to the order list's `orderNumber` filter to find the reservation.\n"
                    },
                    "type": {
                        "type": "string",
                        "description": "The order's service type."
                    },
                    "status": {
                        "type": "string",
                        "description": "The order's status, reported as `cancelled` when the order is cancelled - which is how staff read it, and which the raw `status` column does not say on its own.\n"
                    },
                    "cancelled": {
                        "type": "boolean"
                    }
                }
            },
            "Booking": {
                "type": "object",
                "description": "One pet on one service for one stretch of time.\n\nThis is the same record `GET /accounts/{accountId}/orders/{orderId}` returns under `bookings`, with the context a reader who does not have the order in hand needs: `status`, `cancelled`, `isNoShow`, `customerId`, the `order` itself, and `kennelsOnDate`. The fields shared with `OrderBooking` are assembled by the same code, so the two cannot drift.\n",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "type": {
                        "type": "string",
                        "description": "`boarding`, `daycare`, `facility`, `addon` or `classes`. The last two appear only when asked for by `type`.\n"
                    },
                    "status": {
                        "type": "string",
                        "description": "`booked`, `pending` or `request`. This is the **booking's** status, which is not always its order's - a reservation can be confirmed while one add-on on it is still a request.\n"
                    },
                    "cancelled": {
                        "type": "boolean",
                        "description": "Only ever `true` when you passed `includeCancelled=true`.\n"
                    },
                    "isNoShow": {
                        "type": "boolean",
                        "description": "The pet was expected and did not arrive."
                    },
                    "pet": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/OrderBookingPet"
                            }
                        ],
                        "nullable": true,
                        "description": "Pets the facility has since removed are still resolved here, so a historical booking still names the pet it was for.\n"
                    },
                    "customerId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "Read from the booking's own column rather than its order's, so a booking whose order has been deleted still has an owner. Resolve it with `GET /accounts/{accountId}/customers/{customerId}`.\n"
                    },
                    "orderId": {
                        "type": "integer",
                        "nullable": true
                    },
                    "order": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/BookingOrderBrief"
                            }
                        ],
                        "nullable": true
                    },
                    "lineItemId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "The line item on the order that this booking was priced under. `null` for a booking with no charge of its own.\n"
                    },
                    "startDateTime": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
                        "example": "2026-09-03 07:30:00",
                        "nullable": true,
                        "description": "Facility-local wall clock, `YYYY-MM-DD HH:MM:SS`, with no timezone marker - the same representation the order endpoint uses for this field. Composed from the stored date and the stored minute-of-day.\n\n**Not `format: date-time`.** An RFC 3339 parser will reject it. The account's `timezone` is on the account object if you need to resolve an instant.\n"
                    },
                    "endDateTime": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
                        "example": "2026-09-05 11:00:00",
                        "nullable": true
                    },
                    "arrivedAt": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
                        "example": "2026-09-03 07:34:00",
                        "nullable": true,
                        "description": "When the pet actually checked in. `null` until it does, which is how a sheet tells \"expected\" from \"here\".\n"
                    },
                    "departedAt": {
                        "type": "string",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
                        "example": "2026-09-05 10:52:00",
                        "nullable": true
                    },
                    "kennelId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "The booking's primary kennel. On a booking that rotates between kennels this is only the **first** one, so a sheet for a single day should read `kennelsOnDate` instead.\n"
                    },
                    "kennel": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/KennelBrief"
                            }
                        ],
                        "nullable": true,
                        "description": "The kennel named by `kennelId`, resolved inline. Kennels the facility has since retired still resolve, with `active: false`. Returned under `orders:read` alone; `kennels:read` is only needed for the kennels endpoints themselves.\n"
                    },
                    "kennelsOnDate": {
                        "type": "array",
                        "description": "Every kennel this booking occupies **inside the window you asked for** - one entry for a pet that stays put, more for one that moves.\n\nThis is what a chart for a single day should print against a pet. `kennelId` alone would name the first kennel of a rotation regardless of which day you asked about.\n\nThis is not `kennelAssignments` from the order endpoint, and it is not a replacement for it. That field reports the *times* a pet moved between kennels - correctly, since 2026-09-03. This endpoint answers *which* kennels rather than *when*, because that is the question a day sheet asks; the move history stays on the order endpoint, where consumers already read it.\n\nWith no date window - an `orderId` request - this is every kennel the booking ever occupies.\n",
                        "items": {
                            "$ref": "#/components/schemas/KennelBrief"
                        }
                    },
                    "userId": {
                        "type": "integer",
                        "nullable": true,
                        "description": "The staff member assigned to this booking."
                    },
                    "user": {
                        "allOf": [
                            {
                                "$ref": "#/components/schemas/UserBrief"
                            }
                        ],
                        "nullable": true,
                        "description": "The staff member named by `userId`, resolved inline. Staff who have since left still resolve, with `active: false`.\n"
                    }
                }
            },
            "BookingPageQuestions": {
                "allOf": [
                    {
                        "type": "object",
                        "properties": {
                            "orderId": {
                                "type": "integer",
                                "description": "The reservation these answers were given against. Present here and not on the single-order endpoint, where it would be redundant.\n"
                            }
                        }
                    },
                    {
                        "$ref": "#/components/schemas/OrderQuestions"
                    }
                ],
                "description": "One pet's answers to one service's booking form, tagged with the order it belongs to.\n\nJoin to a booking on `orderId` + `petId` + `serviceType`. Entries with a `null` `petId` are a retail or facility rental order's answers and pair with the order rather than with any pet.\n"
            },
            "PaginatedBookings": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Booking"
                        }
                    },
                    "questions": {
                        "type": "array",
                        "description": "Booking form questions and answers for every order on this page. Present only when `includeQuestions=true`.\n\nA sibling of `data` rather than a key on each booking - see `includeQuestions`.\n",
                        "items": {
                            "$ref": "#/components/schemas/BookingPageQuestions"
                        }
                    },
                    "meta": {
                        "type": "object",
                        "properties": {
                            "pagination": {
                                "type": "object",
                                "properties": {
                                    "currentPage": {
                                        "type": "integer"
                                    },
                                    "perPage": {
                                        "type": "integer"
                                    },
                                    "total": {
                                        "type": "integer"
                                    },
                                    "lastPage": {
                                        "type": "integer"
                                    }
                                }
                            },
                            "window": {
                                "type": "object",
                                "description": "The dates the request was actually bounded to, so a caller can read the window back rather than infer it. Both are `null` on an `orderId` request, which has no window.\n",
                                "properties": {
                                    "minDate": {
                                        "type": "string",
                                        "format": "date",
                                        "nullable": true
                                    },
                                    "maxDate": {
                                        "type": "string",
                                        "format": "date",
                                        "nullable": true
                                    }
                                }
                            },
                            "filters": {
                                "type": "object",
                                "description": "The filters as received. Only the keys you sent are present.",
                                "properties": {
                                    "date": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "minDate": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "maxDate": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "type": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "status": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "petId": {
                                        "type": "integer",
                                        "nullable": true
                                    },
                                    "customerId": {
                                        "type": "integer",
                                        "nullable": true
                                    },
                                    "kennelId": {
                                        "type": "integer",
                                        "nullable": true
                                    },
                                    "orderId": {
                                        "type": "integer",
                                        "nullable": true
                                    },
                                    "includeCancelled": {
                                        "type": "string",
                                        "nullable": true
                                    }
                                }
                            }
                        }
                    }
                }
            },
