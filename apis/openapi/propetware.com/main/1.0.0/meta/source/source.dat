        "/accounts/{accountId}/noteTags": {
            "get": {
                "summary": "List note tags",
                "tags": [
                    "Notes"
                ],
                "description": "Every note tag on the account, grouped by heading and returned in the order ProPet's own note-tag picker shows them - heading display order, then tag display order.\n\nEvery note already carries its own tags resolved ([`noteTags`](#/components/schemas/Note)), so this endpoint is for the two things a note cannot give you: the tags that have not turned up on a note you have read yet, and the whole list to populate a filter control. Pair it with the `noteTagId` filter on the three note lists.\n\nRequires `notes:read`, not an ability of its own: a note already discloses every value in this list, so a separate grant would gate nothing.\n\nRetired tags are included by default - see `active`. Not paginated.\n",
                "operationId": "listNoteTags",
                "security": [
                    {
                        "ApiKeyAuth": []
                    }
                ],
                "parameters": [
                    {
                        "name": "accountId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The account ID"
                    },
                    {
                        "name": "headingId",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        },
                        "description": "Return only tags grouped under this heading. Pass `0` for tags saved without a heading.\n"
                    },
                    {
                        "name": "q",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "maxLength": 200
                        },
                        "description": "Case-insensitive substring match against the tag's name."
                    },
                    {
                        "$ref": "#/components/parameters/NoteTagActive"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Note tags retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/NoteTag"
                                            }
                                        },
                                        "meta": {
                                            "type": "object",
                                            "properties": {
                                                "total": {
                                                    "type": "integer"
                                                },
                                                "filters": {
                                                    "type": "object",
                                                    "description": "The filter parameters as received."
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                }
            }
        },
