{
  "openapi": "3.0.0",
  "info": {
    "title": "AppSkyline API",
    "version": "1.0.0",
    "description": "Public REST API for AppSkyline. Authenticate with an API key created in the AppSkyline dashboard: send the base64-encoded key secret with HTTP Basic auth. Each key carries per-resource scopes like `keywords:read` or `apps:write`.",
    "x-api-versioning": {
      "currentVersion": "1",
      "requestHeader": "API-Version",
      "responseHeader": "API-Version",
      "compatibilityPolicy": "Omitting API-Version selects version 1. Unsupported versions return HTTP 400 with supportedVersions.",
      "deprecationPolicy": "AppSkyline announces incompatible versions at least 180 days before removal. Deprecated responses include Deprecation, Sunset, and a Link relation named deprecation.",
      "deprecationHeaders": [
        "Deprecation",
        "Sunset",
        "Link"
      ],
      "policyUrl": "https://www.appskyline.com/api.md#compatibility-version"
    }
  },
  "servers": [
    {
      "url": "https://api.appskyline.com"
    }
  ],
  "components": {
    "headers": {
      "Deprecation": {
        "description": "Present only when this API operation or version is deprecated. The value is an RFC 9745 Structured Field Date.",
        "schema": {
          "type": "string",
          "example": "@1893456000"
        }
      },
      "Sunset": {
        "description": "Present on deprecated responses when a retirement date is scheduled. The value is an HTTP-date.",
        "schema": {
          "type": "string",
          "example": "Tue, 01 Jan 2030 00:00:00 GMT"
        }
      },
      "DeprecationLink": {
        "description": "Present on deprecated responses and points to the applicable migration or deprecation policy with rel=\"deprecation\".",
        "schema": {
          "type": "string",
          "example": "<https://www.appskyline.com/api.md#compatibility-version>; rel=\"deprecation\""
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "basic",
        "description": "HTTP Basic auth carrying only the API key secret: Authorization: Basic base64(<key secret>)."
      },
      "accessToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Operator session token issued by the AppSkyline dashboard: Authorization: Token <access token>."
      }
    },
    "schemas": {
      "App": {
        "type": "object",
        "required": [
          "_id",
          "organizationId",
          "name"
        ],
        "properties": {
          "_id": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "store": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "Keyword": {
        "type": "object",
        "required": [
          "_id",
          "organizationId",
          "appId",
          "searchTerms"
        ],
        "properties": {
          "_id": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "appId": {
            "type": "string"
          },
          "searchTerms": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "nullable": true
          }
        },
        "additionalProperties": true
      },
      "KeywordPage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Keyword"
            }
          },
          "nextCursor": {
            "nullable": true,
            "type": "string",
            "description": "Opaque cursor for the next page, or null after the final page"
          }
        },
        "additionalProperties": false
      },
      "EngagementRow": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "impressions": {
            "type": "integer"
          },
          "downloads": {
            "type": "integer"
          },
          "sessions": {
            "type": "integer"
          }
        },
        "additionalProperties": true
      },
      "WebhookSubscription": {
        "type": "object",
        "required": [
          "_id",
          "organizationId",
          "url",
          "active"
        ],
        "properties": {
          "_id": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "active": {
            "type": "boolean"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "secret": {
            "type": "string",
            "description": "Returned only when the subscription is created."
          }
        },
        "additionalProperties": true
      },
      "DeleteResult": {
        "type": "object",
        "required": [
          "_id"
        ],
        "properties": {
          "_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "BatchOperation": {
        "type": "object",
        "required": [
          "alias",
          "url"
        ],
        "properties": {
          "alias": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Allowed collection plus optional query string."
          }
        }
      },
      "BatchResponse": {
        "type": "object",
        "description": "Map from each requested alias to its result array.",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Structured JSON API error.",
        "required": [
          "name",
          "message",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "paths": {
    "/api/apple-app-store-engagement": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "Apple App Store engagement rows",
        "description": "Downloads/sessions engagement rows for your organization, optionally filtered by `appId` and a `days` cutoff. Requires the `stats:read` scope.\n",
        "security": [
          {
            "apiKey": []
          },
          {
            "accessToken": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "appId",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "days",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "API-Version",
            "required": false,
            "description": "Compatibility version. Omit to use version 1; unsupported versions return 400.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ],
              "default": "1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of engagement rows",
            "headers": {
              "RateLimit": {
                "description": "Current quota, remaining requests, and reset time.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Quota policy and window applied to the credential.",
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "description": "Compatibility version used for the response.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "Link": {
                "$ref": "#/components/headers/DeprecationLink"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EngagementRow"
                  }
                }
              }
            }
          },
          "403": {
            "description": "API key is missing the `stats:read` scope",
            "headers": {
              "RateLimit": {
                "description": "Current quota, remaining requests, and reset time.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Quota policy and window applied to the credential.",
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "description": "Compatibility version used for the response.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "Link": {
                "$ref": "#/components/headers/DeprecationLink"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "API key rate limit exceeded",
            "headers": {
              "RateLimit": {
                "description": "Current quota, remaining requests, and reset time.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Quota policy and window applied to the credential.",
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "description": "Compatibility version used for the response.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "Link": {
                "$ref": "#/components/headers/DeprecationLink"
              },
              "Retry-After": {
                "description": "Seconds until the request may be retried.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "getAppleAppStoreEngagement"
      }
    },
    "/api/apps": {
      "get": {
        "tags": [
          "Apps"
        ],
        "summary": "List apps",
        "description": "Lists the apps of your organization. Requires the `apps:read` scope.\n",
        "security": [
          {
            "apiKey": []
          },
          {
            "accessToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Array of apps",
            "headers": {
              "RateLimit": {
                "description": "Current quota, remaining requests, and reset time.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Quota policy and window applied to the credential.",
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "description": "Compatibility version used for the response.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "Link": {
                "$ref": "#/components/headers/DeprecationLink"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/App"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "headers": {
              "RateLimit": {
                "description": "Current quota, remaining requests, and reset time.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Quota policy and window applied to the credential.",
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "description": "Compatibility version used for the response.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "Link": {
                "$ref": "#/components/headers/DeprecationLink"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "API key is missing the `apps:read` scope",
            "headers": {
              "RateLimit": {
                "description": "Current quota, remaining requests, and reset time.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Quota policy and window applied to the credential.",
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "description": "Compatibility version used for the response.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "Link": {
                "$ref": "#/components/headers/DeprecationLink"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "API key rate limit exceeded",
            "headers": {
              "RateLimit": {
                "description": "Current quota, remaining requests, and reset time.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Quota policy and window applied to the credential.",
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "description": "Compatibility version used for the response.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "Link": {
                "$ref": "#/components/headers/DeprecationLink"
              },
              "Retry-After": {
                "description": "Seconds until the request may be retried.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "getApps",
        "parameters": [
          {
            "in": "header",
            "name": "API-Version",
            "required": false,
            "description": "Compatibility version. Omit to use version 1; unsupported versions return 400.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ],
              "default": "1"
            }
          }
        ]
      },
      "post": {
        "tags": [
          "Apps"
        ],
        "summary": "Create an app",
        "description": "Requires the `apps:write` scope.",
        "security": [
          {
            "apiKey": []
          },
          {
            "accessToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The created app",
            "headers": {
              "RateLimit": {
                "description": "Current quota, remaining requests, and reset time.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Quota policy and window applied to the credential.",
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "description": "Compatibility version used for the response.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "Link": {
                "$ref": "#/components/headers/DeprecationLink"
              },
              "Idempotency-Replayed": {
                "description": "True when a completed response was replayed for the supplied idempotency key.",
                "schema": {
                  "type": "boolean"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/App"
                }
              }
            }
          },
          "403": {
            "description": "API key is missing the `apps:write` scope",
            "headers": {
              "RateLimit": {
                "description": "Current quota, remaining requests, and reset time.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Quota policy and window applied to the credential.",
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "description": "Compatibility version used for the response.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "Link": {
                "$ref": "#/components/headers/DeprecationLink"
              },
              "Idempotency-Replayed": {
                "description": "True when a completed response was replayed for the supplied idempotency key.",
                "schema": {
                  "type": "boolean"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Domain is already taken",
            "headers": {
              "RateLimit": {
                "description": "Current quota, remaining requests, and reset time.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Quota policy and window applied to the credential.",
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "description": "Compatibility version used for the response.",
                "schema": {
                  "type": "string",
                  "enum": [
                    "1"
                  ]
                }
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "Link": {
                "$ref": "#/components/headers/DeprecationLink"
              },
              "Idempotency-Replayed": {
                "description": "True when a completed response was replayed for the supplied idempotency key.",
                "schema": {
                  "type": "boolean"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "operationId": "postApps",
        "parameters": [
          {
            "in": "header",
            "name": "API-Version",
            "required": false,
            "description": "Compatibility version. Omit to use version 1; unsupported versions return 400.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ],
              "default": "1"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "description": "Unique retry key retained for 24 hours (maximum 255 characters).",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ]
      }
    },
    "/api/apps/{appId}": {
      "get": {
        "tags": [
          "Apps"
        ],
        "summary": "Get an app by id",
        "description": "Requires the `apps:read` scope.",
        "security": [
          {
            "apiKey": []
          },
          {
            "accessToken": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "appId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "API-Version",
            "required": false,
            "description": "Compatibility version. Omit to use version 1; unsupported versions return 400.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ],
              "default": "1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The app",
            "headers": {
              "RateLimit": {
                "description": "Current quota, remaining requests, and reset time.",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Quota policy and window applied to the credential.",
                "schema": {
                  "type": "string"
                }
              },
              "API-Version": {
                "description": "Compatibility version used for the response.",
                "schema": {
                  "type": "string",
                  "enum": [
