{
  "openapi": "3.1.0",
  "info": {
    "title": "JustTranscribe API",
    "version": "1.2.0",
    "description": "Transcribe public videos and audio into accurate, timestamped text. Transcription is asynchronous: create returns an id, poll it until status is \"complete\" (typically 1–5 minutes). Docs: https://justtranscribe.ai/developers",
    "x-jentic-source-url": "https://justtranscribe.ai/api/v1/openapi.json"
  },
  "servers": [
    {
      "url": "https://justtranscribe.ai"
    }
  ],
  "paths": {
    "/api/v1/me": {
      "get": {
        "operationId": "getAccount",
        "summary": "Identify the authenticated account",
        "x-openai-isConsequential": false,
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "plan": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transcripts": {
      "post": {
        "operationId": "createTranscript",
        "summary": "Start transcribing a public video/audio URL",
        "description": "Public links only (YouTube, TikTok, Instagram, Facebook, Pinterest, Google Drive) — no private or login-required videos, up to 150 minutes. Returns immediately; poll getTranscript until status is \"complete\".",
        "x-openai-isConsequential": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "Public video or audio URL."
                  },
                  "webhookUrl": {
                    "type": "string",
                    "description": "Optional HTTPS URL to POST the result to on completion."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "queued": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listTranscripts",
        "summary": "List transcripts, newest first",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "completedAt returns finished transcripts ordered by completion — the safe polling cursor.",
            "schema": {
              "type": "string",
              "enum": [
                "createdAt",
                "completedAt"
              ]
            }
          },
          {
            "name": "include",
            "in": "query",
            "description": "include=text adds the plain transcript to each row.",
            "schema": {
              "type": "string",
              "enum": [
                "text"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of transcripts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transcripts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TranscriptSummary"
                      }
                    },
                    "hasMore": {
                      "type": "boolean"
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transcripts/{id}": {
      "get": {
        "operationId": "getTranscript",
        "summary": "Get a transcript (poll until complete)",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transcript with text once complete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptFull"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteTranscript",
        "summary": "Permanently delete a transcript",
        "x-openai-isConsequential": true,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transcripts/{id}/export/{format}": {
      "get": {
        "operationId": "exportTranscript",
        "summary": "Export as txt, srt, vtt, csv or md",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "txt",
                "srt",
                "vtt",
                "csv",
                "md"
              ]
            }
          },
          {
            "name": "ts",
            "in": "query",
            "description": "ts=0 drops timestamps in txt/md.",
            "schema": {
              "type": "string",
              "enum": [
                "0"
              ]
            }
          },
          {
            "name": "sp",
            "in": "query",
            "description": "sp=1 adds cached speaker labels.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The export as text",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TranscriptSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "pending",
              "fetching",
              "transcribing",
              "analyzing",
              "complete",
              "failed"
            ]
          },
          "title": {
            "type": "string",
            "description": "Null while unknown."
          },
          "platform": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Null for uploads."
          },
          "language": {
            "type": "string"
          },
          "durationSec": {
            "type": "number"
          },
          "error": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "description": "ISO date-time; null while in flight."
          }
        }
      },
      "TranscriptFull": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "pending",
              "fetching",
              "transcribing",
              "analyzing",
              "complete",
              "failed"
            ]
          },
          "title": {
            "type": "string",
            "description": "Null while unknown."
          },
          "platform": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Null for uploads."
          },
          "language": {
            "type": "string"
          },
          "durationSec": {
            "type": "number"
          },
          "error": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "description": "ISO date-time; null while in flight."
          },
          "text": {
            "type": "string",
            "description": "Plain transcript, one segment per line; null until complete."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key from https://justtranscribe.ai/api-keys (jt_live_…)."
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}