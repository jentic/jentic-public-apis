          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          },
          {
            "in": "path",
            "name": "property_id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "698da8303100b232620bad09"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "currency_name": {
                    "type": "string",
                    "example": "AED"
                  },
                  "currency_symbol": {
                    "type": "string",
                    "example": "\u062f.\u0625"
                  },
                  "base_price": {
                    "type": "number",
                    "example": 4000
                  },
                  "security_amount": {
                    "type": "string",
                    "example": "2000"
                  },
                  "is_booking_discount": {
                    "type": "integer",
                    "example": 0
                  },
                  "discount_amount": {
                    "type": "number",
                    "nullable": true,
                    "example": null
                  },
                  "discount_type": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  },
                  "discount_expiry_date": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  },
                  "cancellation_policy": {
                    "type": "string",
                    "enum": [
                      "flexible",
                      "moderate",
                      "strict"
                    ],
                    "example": "flexible"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
