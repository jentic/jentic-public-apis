    "/properties/availability": {
      "post": {
        "summary": "Check Property Availability",
        "tags": [
          "Booking"
        ],
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "property_id",
                  "check_in_date",
                  "check_out_date",
                  "no_of_guest"
                ],
                "properties": {
                  "property_id": {
                    "type": "string",
                    "example": "6989736046f8dbb9c90a9c43"
