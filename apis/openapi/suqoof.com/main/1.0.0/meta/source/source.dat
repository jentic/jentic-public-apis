    "/booking": {
      "get": {
        "summary": "List Bookings",
        "tags": [
          "Booking"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          },
          {
            "in": "query",
            "name": "type",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "upcoming",
                "cancelled",
                "previous",
                "pending",
                "all"
              ]
            },
            "description": "Filter bookings by type"
          },
          {
            "in": "query",
            "name": "search",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search by property name"
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Booked list get successfully.",
            "content": {
              "application/json": {
                "example": {
                  "status": true,
                  "message": "Booked list get successfully."
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create / Store Booking",
        "tags": [
          "Booking"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "property_id",
                  "check_in_date",
                  "check_out_date",
                  "no_of_guest",
                  "total_adult",
                  "total_child",
                  "no_of_room",
                  "property_fee",
                  "currency_name",
                  "currency_symbol",
                  "is_service_selected"
                ],
                "properties": {
                  "property_id": {
                    "type": "string",
                    "example": "6989736046f8dbb9c90a9c43"
                  },
                  "check_in_date": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-03-08"
                  },
                  "check_out_date": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-03-09"
                  },
                  "no_of_guest": {
                    "type": "integer",
                    "example": 1
                  },
                  "total_adult": {
                    "type": "integer",
                    "example": 1
                  },
                  "total_child": {
                    "type": "integer",
                    "example": 0
                  },
                  "no_of_room": {
                    "type": "integer",
                    "example": 1
                  },
                  "property_fee": {
                    "type": "number",
                    "example": 10800
                  },
                  "currency_name": {
                    "type": "string",
                    "example": "AED"
                  },
                  "currency_symbol": {
                    "type": "string",
                    "example": "\u062f.\u0625"
                  },
                  "is_service_selected": {
                    "type": "integer",
                    "example": 0,
                    "description": "0 = no services, 1 = include services"
                  },
                  "service_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "686b789ccbf5e56c0f041636"
                    ],
                    "description": "Required only when is_service_selected = 1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Property booked successfully."
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
