{
  "openapi": "3.0.0",
  "info": {
    "title": "Suqoof API",
    "version": "1.0.0",
    "description": "Full Suqoof API collection covering Property Create, Property Update, Property Routes, Lists, and Booking.\n**How to use:** Click the \ud83d\udd12 Authorize button \u2192 paste your Bearer token \u2192 click Authorize \u2192 all APIs will send it automatically.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/dstrict11/swagger-collection/1.0.0"
  },
  "servers": [
    {
      "url": "https://www.suqoof.com/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "DeviceToken": {
        "in": "header",
        "name": "device_token",
        "required": true,
        "schema": {
          "type": "string"
        },
        "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.dummy"
      },
      "DeviceType": {
        "in": "header",
        "name": "device_type",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "android",
            "ios"
          ]
        },
        "example": "android"
      },
      "AcceptLanguage": {
        "in": "header",
        "name": "Accept-Language",
        "required": false,
        "schema": {
          "type": "string"
        },
        "example": "en"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/property/step-1": {
      "post": {
        "summary": "Property Create - Step 1 (Property Type)",
        "tags": [
          "Property Create"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "property_type_id": {
                    "type": "string",
                    "example": "6894b7872f2bcf4f8b00e978"
                  },
                  "property_id": {
                    "type": "string",
                    "nullable": true,
                    "example": null,
                    "description": "null for create, pass ID for update"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/property/step-2": {
      "post": {
        "summary": "Property Create - Step 2 (Location)",
        "tags": [
          "Property Create"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "property_id": {
                    "type": "string",
                    "example": "6894b7872f2bcf4f8b00e978"
                  },
                  "property_name": {
                    "type": "string",
                    "example": "Charming Beach Hotel"
                  },
                  "country": {
                    "type": "string",
                    "example": "United States"
                  },
                  "city": {
                    "type": "string",
                    "example": "California"
                  },
                  "area": {
                    "type": "string",
                    "example": "California"
                  },
                  "house_no": {
                    "type": "string",
                    "example": "805"
                  },
                  "address": {
                    "type": "string",
                    "example": "Junipero Serra Freeway, Daly City"
                  },
                  "latitude": {
                    "type": "string",
                    "example": "37.68244552"
                  },
                  "longitude": {
                    "type": "string",
                    "example": "-122.4714975"
                  },
                  "zip_code": {
                    "type": "string",
                    "example": "93430"
                  },
                  "district": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  },
                  "street_address": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  },
                  "landmark": {
                    "type": "string",
                    "example": "Cayucos"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/property/step-3": {
      "post": {
        "summary": "Property Create - Step 3 (Rooms)",
        "tags": [
          "Property Create"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "property_id": {
                    "type": "string",
                    "example": "6894b7872f2bcf4f8b00e978"
                  },
                  "rooms": {
                    "type": "object",
                    "description": "Room configuration object",
                    "example": {
                      "bedrooms": 2,
                      "bathrooms": 1,
                      "guest_capacity": 4
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/property/step-4": {
      "post": {
        "summary": "Property Create - Step 4 (Amenities)",
        "tags": [
          "Property Create"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "property_id": {
                    "type": "string",
                    "example": "6894b7872f2bcf4f8b00e978"
                  },
                  "amenity_id": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "amenity_id_1",
                      "amenity_id_2"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/property/step-5": {
      "post": {
        "summary": "Property Create - Step 5 (Rules & Check-in Time)",
        "tags": [
          "Property Create"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "property_id": {
                    "type": "string",
                    "example": "6894b7872f2bcf4f8b00e978"
                  },
                  "rule_id": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "rule_id_1"
                    ]
                  },
                  "additional_rules": {
                    "type": "string",
                    "example": "Please follow some beach rules."
                  },
                  "check_in_time": {
                    "type": "string",
                    "example": "11:13 AM"
                  },
                  "check_out_time": {
                    "type": "string",
                    "example": "11:13 AM"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/property/step-6": {
      "post": {
        "summary": "Property Create - Step 6 (Services)",
        "tags": [
          "Property Create"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "property_id": {
                    "type": "string",
                    "example": "6894b7872f2bcf4f8b00e978"
                  },
                  "is_service": {
                    "type": "integer",
                    "example": 0,
                    "description": "0 = no service, 1 = has service"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/property/step-7": {
      "post": {
        "summary": "Property Create - Step 7 (Description)",
        "tags": [
          "Property Create"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "property_id": {
                    "type": "string",
                    "example": "6894b7872f2bcf4f8b00e978"
                  },
                  "description": {
                    "type": "string",
                    "example": "A beachfront hotel offering ocean-view rooms."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/property/step-8": {
      "post": {
        "summary": "Property Create - Step 8 (Photos Upload)",
        "tags": [
          "Property Create"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "property_id": {
                    "type": "string",
                    "example": "6894b7872f2bcf4f8b00e978"
                  },
                  "photos": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "description": "Photo files to upload"
                  },
                  "image_type": {
                    "type": "string",
                    "example": "cover_photo"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/property/step-9": {
      "post": {
        "summary": "Property Create - Step 9 (Inspection & Agreement)",
        "tags": [
          "Property Create"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "property_id": {
                    "type": "string",
                    "example": "6894b7872f2bcf4f8b00e978"
                  },
                  "apply_inspection_fees": {
                    "type": "integer",
                    "example": 1
                  },
                  "inspection_date": {
                    "type": "string",
                    "format": "date",
                    "example": "2026-02-10"
                  },
                  "inspection_time": {
                    "type": "string",
                    "example": "11:30 AM"
                  },
                  "is_agree": {
                    "type": "integer",
                    "example": 1
                  },
                  "is_booking_referral": {
                    "type": "integer",
                    "example": 0
                  },
                  "referral_type": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/property/step-10": {
      "post": {
        "summary": "Property Create - Step 10 (Pricing)",
        "tags": [
          "Property Create"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/DeviceToken"
          },
          {
            "$ref": "#/components/parameters/DeviceType"
          },
          {
            "$ref": "#/components/parameters/AcceptLanguage"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "property_id": {
                    "type": "string",
                    "example": "6894b7872f2bcf4f8b00e978"
                  },
                  "currency_name": {
                    "type": "string",
                    "example": "AED"
                  },
                  "currency_symbol": {
                    "type": "string",
                    "example": "\u062f.\u0625"
                  },
                  "base_price": {
                    "type": "number",
                    "example": 4000
                  },
                  "security_amount": {
                    "type": "string",
                    "example": "2000"
                  },
                  "is_booking_discount": {
                    "type": "integer",
                    "example": 0
                  },
                  "discount_amount": {
                    "type": "number",
                    "nullable": true,
                    "example": null
                  },
                  "discount_type": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  },
                  "discount_expiry_date": {
                    "type": "string",
                    "nullable": true,
                    "example": null
                  },
                  "cancellation_policy": {
                    "type": "string",
                    "enum": [
                      "flexible",
                      "moderate",
                      "strict"
                    ],
                    "example": "flexible"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
