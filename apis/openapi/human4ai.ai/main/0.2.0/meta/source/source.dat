    "/api/owner/feedback/{id}/retract": {
      "post": {
        "operationId": "retractFeedback",
        "summary": "OWNER ONLY: remove from public display; external copies cannot be recalled",
        "parameters": [
          {
            "name": "id",
            "in": "path",
