  "paths": {
    "/api/v1/presensi/scan": {
      "post": {
        "summary": "Scan RFID (Presensi pelajaran)",
        "description": "Scan RFID (Presensi pelajaran)",
        "operationId": "scanRfidPresensiPelajaran",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mata_pelajaran_id": {
                    "type": "string",
                    "example": "0414cc89-2825-4e03-a341-30878b65fa47"
                  },
                  "rfid": {
                    "type": "string",
                    "example": "RF001234567890"
                  }
                }
              },
              "examples": {
                "Scan RFID (Presensi pelajaran)": {
                  "value": {
                    "mata_pelajaran_id": "0414cc89-2825-4e03-a341-30878b65fa47",
                    "rfid": "RF001234567890"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success Response Scan RFID (Presensi)",
            "headers": {
              "CF-RAY": {
                "schema": {
                  "type": "string",
                  "example": "9d7e12516be4f876-SIN"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-cache, private"
                }
              },
              "Connection": {
                "schema": {
                  "type": "string",
                  "example": "keep-alive"
                }
              },
              "Date": {
                "schema": {
                  "type": "string",
                  "example": "Fri, 06 Mar 2026 02:53:42 GMT"
                }
              },
              "Nel": {
                "schema": {
                  "type": "string",
                  "example": "{\"report_to\":\"cf-nel\",\"success_fraction\":0.0,\"max_age\":604800}"
                }
              },
              "Report-To": {
                "schema": {
                  "type": "string",
                  "example": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=qf1TUkYQlGmy5dqRAufaApHN5%2BUXHjXA7d%2Bw%2FAMIMMKlz2R7fTB1CLgQgT6kljN7VekHOxij%2B%2FSCoRSHbcPIxTi0vW3paA%2Fh1r7mkcUchJTIF6Lo\"}]}"
                }
              },
              "Server": {
                "schema": {
                  "type": "string",
                  "example": "cloudflare"
                }
              },
              "Transfer-Encoding": {
                "schema": {
                  "type": "string",
                  "example": "chunked"
                }
              },
              "access-control-allow-origin": {
                "schema": {
                  "type": "string",
                  "example": "*"
                }
              },
              "alt-svc": {
                "schema": {
                  "type": "string",
                  "example": "h3=\":443\"; ma=86400"
                }
              },
              "cf-cache-status": {
                "schema": {
                  "type": "string",
                  "example": "DYNAMIC"
                }
              },
              "strict-transport-security": {
                "schema": {
                  "type": "string",
                  "example": "max-age=31536000"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "presensi": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "example": "2281ab8d-7138-4fe3-92b4-1528fd619e55"
                            },
                            "jam_scan": {
                              "type": "string",
                              "example": "02:53:42"
                            },
                            "mata_pelajaran": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "example": "0414cc89-2825-4e03-a341-30878b65fa47"
                                },
                                "kode": {
                                  "type": "string",
                                  "example": "S.03"
                                },
                                "nama": {
                                  "type": "string",
                                  "example": "Al Qur'an"
                                }
                              }
                            },
                            "status_kehadiran": {
                              "type": "string",
                              "example": "H"
                            },
                            "status_text": {
                              "type": "string",
                              "example": "Hadir"
                            },
                            "tanggal": {
                              "type": "string",
                              "example": "2026-03-06"
                            }
                          }
                        },
                        "santri": {
                          "type": "object",
                          "properties": {
                            "foto": {
                              "type": "string",
                              "example": "https://sim.ppmanbailfutuh.com/storage/foto/santri/7410B6NKj1ELrmuJdZ0p53Unq0EX4VDvWaTUD1Kl.jpg"
                            },
                            "id": {
                              "type": "string",
                              "example": "a116fb48-2005-437d-801f-2703a848e4d8"
                            },
                            "nama": {
                              "type": "string",
                              "example": "Facere dicta asperio"
                            },
                            "nis": {
                              "type": "string",
                              "example": "2024 01 3401050004 002"
                            }
                          }
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "example": "Presensi berhasil"
                    },
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                },
                "examples": {
                  "Success Response Scan RFID (Presensi)": {
                    "value": {
                      "data": {
                        "presensi": {
                          "id": "2281ab8d-7138-4fe3-92b4-1528fd619e55",
                          "jam_scan": "02:53:42",
                          "mata_pelajaran": {
                            "id": "0414cc89-2825-4e03-a341-30878b65fa47",
                            "kode": "S.03",
                            "nama": "Al Qur'an"
                          },
                          "status_kehadiran": "H",
                          "status_text": "Hadir",
                          "tanggal": "2026-03-06"
                        },
                        "santri": {
                          "foto": "https://sim.ppmanbailfutuh.com/storage/foto/santri/7410B6NKj1ELrmuJdZ0p53Unq0EX4VDvWaTUD1Kl.jpg",
                          "id": "a116fb48-2005-437d-801f-2703a848e4d8",
                          "nama": "Facere dicta asperio",
                          "nis": "2024 01 3401050004 002"
                        }
                      },
                      "message": "Presensi berhasil",
                      "success": true
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
