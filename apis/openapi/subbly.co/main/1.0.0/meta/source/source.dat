    "/invoices/{invoice_id}/schedule_payment": {
      "patch": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Invoice"
        ],
        "summary": "Schedule the next payment for invoice",
        "description": "Schedule the next payment for current invoice\n",
        "operationId": "scheduleInvoicePayment",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "description": "Invoice ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "string"
            }
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/SchedulePaymentBody"
        },
        "responses": {
          "200": {
            "description": "Invoice object response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          }
        }
      }
    },
    "/payment_methods/{payment_method_id}": {
      "get": {
