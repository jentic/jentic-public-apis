            "nullable": true,
            "type": "boolean"
          },
          "access_level": {
            "type": "string",
            "enum": [
              "storefront",
              "private"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityMetadataValue"
            }
          }
        }
      },
      "Metadata": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "name": {
            "nullable": false,
            "description": "Metadata name.",
            "type": "string",
            "example": "Color"
          },
          "slug": {
            "nullable": false,
            "description": "Metadata slug.",
            "type": "string",
            "example": "color-red"
          },
          "description": {
            "nullable": true,
            "description": "Description of the metadata.",
            "type": "string"
          },
          "unit": {
            "type": "string",
            "nullable": true,
            "example": "kg"
          },
          "data_type": {
            "nullable": false,
            "type": "string",
            "enum": [
              "single_line_string",
              "multi_line_text",
              "rich_text",
              "integer",
              "decimal",
              "datetime",
              "date",
              "time",
              "volume",
              "weight",
              "boolean",
              "color",
              "rating",
              "url",
              "money",
              "json"
            ]
          },
          "preset": {
            "nullable": false,
            "type": "boolean"
          },
          "multiple": {
            "nullable": false,
            "type": "boolean"
          },
          "access_level": {
            "type": "string",
