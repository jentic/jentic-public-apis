      "MetadataValue": {
        "type": "object",
        "properties": {
          "id": {
            "description": "Metadata value ID",
            "nullable": false,
            "type": "integer",
            "example": 1
          },
          "value": {
            "nullable": false,
            "description": "The metadata value. Can be one of:\n- string\n- integer\n- float\n- date (`YYYY-MM-DD`)\n- date-time (`YYYY-MM-DDThh:mm:ssZ`)\n- JSON object\n",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number",
                "format": "float"
              },
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      },
      "EntityMetadataValue": {
        "type": "object",
        "properties": {
          "id": {
            "description": "The pivot metadata value ID",
            "type": "integer",
            "example": 1
          },
          "value_id": {
            "description": "Metadata value ID",
            "nullable": false,
            "type": "integer",
            "example": 101
          },
          "value": {
            "nullable": false,
            "description": "The metadata value. Can be one of:\n- string\n- integer\n- float\n- date (`YYYY-MM-DD`)\n- date-time (`YYYY-MM-DDThh:mm:ssZ`)\n- JSON object\n",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number",
                "format": "float"
              },
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "object"
              }
            ]
          },
          "metadata": {
            "nullable": true,
            "description": "Array of metadata keys.\nAllowed keys:\n- `image_url`\n- `color`\n",
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "image_url",
                "color"
              ]
            }
          }
        }
      },
      "StoreMetadataBody": {
        "type": "object",
        "required": [
          "name",
          "data_type",
          "access_level"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Metadata name"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Free‐form description"
          },
          "multiple": {
            "type": "boolean",
            "description": "Allow multiple values?"
          },
          "data_type": {
            "type": "string",
            "enum": [
              "single_line_string",
              "multi_line_text",
              "rich_text",
              "integer",
              "decimal",
              "datetime",
              "date",
              "time",
              "volume",
              "weight",
              "boolean",
              "color",
              "rating",
              "url",
              "money",
              "json"
            ],
            "description": "Data type for the metadata"
          },
          "access_level": {
            "type": "string",
            "enum": [
              "storefront",
              "private"
            ],
            "description": "Who can see/use this metadata"
          },
          "preset": {
            "type": "boolean",
            "description": "Are values from a preset list?"
          },
          "unit": {
            "type": "string",
            "maxLength": 255,
            "description": "Unit label (required only for data types with unit - volume, weight)"
          },
          "values": {
            "type": "array",
            "nullable": true,
            "description": "List of allowed values (when `preset` is true)",
            "items": {
              "type": "object",
              "required": [
                "value"
              ],
              "properties": {
                "value": {
                  "description": "The value to add. Format depends on data_type:\n- single_line_string, color, time: String (max 255 characters)\n- multi_line_text, rich_text: String (any length)\n- url: Valid URL string\n- integer, rating: Integer value (as string, e.g., \"42\")\n- boolean: Boolean value (1/0)\n- decimal, money, volume, weight: Numeric value (integer or decimal)\n- date: String in format \"Y-m-d\" (e.g., \"2024-03-15\")\n- datetime: String in format \"Y-m-d H:i:s\" (e.g., \"2024-03-15 14:30:00\")\n- json: Valid JSON string\n",
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "UpdateMetadataBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "New name of the metadata"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Detailed description"
          },
          "access_level": {
            "type": "string",
            "description": "Access scope for the metadata",
            "enum": [
              "storefront",
              "private"
            ]
          },
          "unit": {
            "type": "string",
            "maxLength": 255,
            "nullable": true,
            "description": "Unit of measurement (applicable for data types weight and volume)"
          },
          "values": {
            "type": "object",
            "nullable": true,
            "description": "Operations on preset values",
            "properties": {
              "create": {
                "type": "array",
                "description": "New values to add",
                "items": {
                  "type": "object",
                  "required": [
                    "value"
                  ],
                  "properties": {
                    "value": {
                      "description": "The new value. Format depends on data_type:\n- single_line_string, color, time: String (max 255 characters)\n- multi_line_text, rich_text: String (any length)\n- url: Valid URL string\n- integer, rating: Integer value (as string, e.g., \"42\")\n- boolean: Boolean value (true/false)\n- decimal, money, volume, weight: Numeric value (integer or decimal)\n- date: String in format \"Y-m-d\" (e.g., \"2024-03-15\")\n- datetime: String in format \"Y-m-d H:i:s\" (e.g., \"2024-03-15 14:30:00\")\n- json: Valid JSON string\n",
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object"
                        }
                      ]
                    }
                  }
                }
              },
              "update": {
                "type": "array",
                "description": "Existing values to update",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "value"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "Identifier of the value to update"
                    },
                    "value": {
                      "description": "The new value. Format depends on data_type:\n- single_line_string, color, time: String (max 255 characters)\n- multi_line_text, rich_text: String (any length)\n- url: Valid URL string\n- integer, rating: Integer value (as string, e.g., \"42\")\n- boolean: Boolean value (true/false)\n- decimal, money, volume, weight: Numeric value (integer or decimal)\n- date: String in format \"Y-m-d\" (e.g., \"2024-03-15\")\n- datetime: String in format \"Y-m-d H:i:s\" (e.g., \"2024-03-15 14:30:00\")\n- json: Valid JSON string\n",
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object"
                        }
                      ]
                    }
                  }
                }
              },
              "delete": {
                "type": "array",
                "description": "IDs of values to remove",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "Identifier of the value to delete"
                    }
                  }
                }
              }
            }
          }
        }
      },
