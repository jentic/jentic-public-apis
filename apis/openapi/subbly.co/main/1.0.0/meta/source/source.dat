  "components": {
    "parameters": {
      "ExpandParam": {
        "name": "expand",
        "in": "query",
        "description": "List of relations to expand in the response.\n",
        "schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": "form",
        "explode": true
      }
    },
    "requestBodies": {
      "MetadataSyncBody": {
        "description": "Metadata sync request body",
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "metadata"
              ],
              "properties": {
                "metadata": {
                  "type": "object",
                  "properties": {
                    "create": {
                      "nullable": true,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "values"
                        ],
                        "properties": {
                          "name": {
                            "type": "string",
                            "maxLength": 255
                          },
                          "description": {
                            "type": "string",
                            "nullable": true,
                            "maxLength": 500
                          },
                          "values": {
                            "type": "array",
                            "minItems": 1,
                            "items": {}
                          }
                        }
                      }
                    },
                    "delete": {
                      "nullable": true,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "attribute_id"
                        ],
                        "properties": {
                          "attribute_id": {
                            "type": "integer"
                          },
                          "values": {
                            "type": "array",
                            "nullable": true,
                            "items": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "SchedulePaymentBody": {
        "description": "Schedule Payment Body",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "next_attempt_at"
              ],
              "properties": {
                "next_attempt_at": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2022-02-24T04:00:00"
                }
              }
            }
          }
        }
      },
      "SubscriptionCancelBody": {
        "description": "Cancellation Reasons Body",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "reason_id": {
                  "type": "integer",
                  "nullable": true,
                  "description": "The ID of the cancellation reason (available if cancellation reasons are enabled)"
                },
                "extra_feedback": {
                  "type": "string",
                  "nullable": true,
                  "maxLength": 255,
                  "description": "Additional feedback from the customer"
                },
                "involuntary_churn": {
                  "type": "boolean",
                  "nullable": true,
                  "description": "Involuntary churn occurs when a subscription ends due to issues like payment failures. Pass false to clear the past due status and prevent involuntary churn event. Pass true to keep the subscription in its current past due state, which may lead to involuntary churn."
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY"
      }
    },
    "schemas": {
      "PaginatedResult": {
        "type": "object",
        "properties": {
          "pagination": {
            "type": "object",
            "properties": {
              "current_page": {
                "type": "integer",
                "example": 1
              },
              "last_page": {
                "type": "integer",
                "example": 2,
                "nullable": true
              },
              "from": {
                "type": "integer",
                "nullable": true,
                "example": 1
              },
              "to": {
                "type": "integer",
                "nullable": true
              },
              "total": {
                "type": "integer",
                "example": 20
              }
            }
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique ID for the charge transaction"
          },
          "external_id": {
            "type": "string",
            "description": "Gateway reference ID",
            "example": "pi_3Qtw6SJ8pwdPGEaK0nZoMSSE"
          },
          "invoice_id": {
            "type": "integer",
            "description": "Associated invoice ID"
          },
          "customer_id": {
            "type": "integer",
            "description": "Associated customer ID"
          },
          "customer": {
            "nullable": true,
            "description": "Expandable link to the customer",
            "allOf": [
              {
                "$ref": "#/components/schemas/Customer"
              }
            ]
          },
          "description": {
            "type": "string",
            "description": "Description of the transaction"
          },
          "payment_method_id": {
            "type": "integer",
            "description": "ID of the payment method used"
          },
          "payment_method": {
            "nullable": true,
            "description": "Expandable link to the payment method",
            "allOf": [
              {
                "$ref": "#/components/schemas/PaymentMethod"
              }
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "charge"
            ],
            "description": "Type of transaction"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed"
            ],
            "description": "Status of the transaction"
          },
          "amount": {
            "type": "number",
            "format": "number",
            "description": "Transaction amount in cents"
          },
          "currency_code": {
            "type": "string",
            "description": "Currency code in ISO format",
            "example": "USD"
          },
          "last_payment_error": {
            "type": "object",
            "nullable": true,
            "properties": {
              "error_text": {
                "type": "string",
                "nullable": true,
                "description": "External text describing the payment error",
                "example": "Your card has insufficient funds."
              },
              "decline_code": {
                "type": "string",
                "nullable": true,
                "description": "External code describing the reason for payment decline",
                "example": "insufficient_funds"
              },
              "error_code": {
                "type": "string",
                "nullable": true,
                "description": "External code indicating the specific error",
                "example": "card_declined"
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "2022-04-01 00:00:00"
          }
        }
      },
      "Subscription": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "customer_id": {
            "type": "integer"
          },
          "customer": {
            "nullable": true,
            "description": "Expandable link to the customer",
            "allOf": [
              {
                "$ref": "#/components/schemas/Customer"
              }
            ]
          },
          "referred_by": {
            "type": "integer",
            "nullable": true
          },
          "product_id": {
            "type": "integer"
          },
          "product": {
            "nullable": true,
            "description": "Expandable link to the product",
            "allOf": [
              {
                "$ref": "#/components/schemas/SubscriptionProduct"
              }
            ]
          },
          "quantity": {
            "type": "integer"
          },
          "shipping_address_id": {
            "type": "integer"
          },
          "shipping_address": {
            "nullable": true,
            "description": "Expandable link to the subscription's shipping address or pickup point object",
            "oneOf": [
              {
                "$ref": "#/components/schemas/Address"
              },
              {
                "$ref": "#/components/schemas/PickupInfo"
              }
            ]
          },
          "shipping_method_id": {
            "type": "integer"
          },
          "billing_address_id": {
            "type": "integer"
          },
          "billing_address": {
            "nullable": true,
            "description": "Expandable link to the subscription's billing address",
            "allOf": [
              {
                "$ref": "#/components/schemas/Address"
              }
            ]
          },
          "payment_method_id": {
            "type": "integer"
          },
          "payment_method": {
            "nullable": true,
            "description": "Expandable link to the subscription's default payment method",
            "allOf": [
              {
                "$ref": "#/components/schemas/PaymentMethod"
              }
            ]
          },
          "currency_code": {
            "type": "string",
            "example": "USD"
          },
          "survey": {
            "$ref": "#/components/schemas/SubscriptionPreferences"
          },
          "preferences": {
            "$ref": "#/components/schemas/SubscriptionPreferences"
          },
          "bundle": {
            "$ref": "#/components/schemas/SubscriptionBundle"
          },
          "gift": {
            "type": "object",
            "nullable": true,
            "properties": {
              "message": {
                "type": "string",
                "nullable": true
              },
              "starts_at": {
                "type": "string",
                "format": "date-time",
                "nullable": true,
                "example": "2022-02-24 04:00:00"
              },
              "order_limit": {
                "type": "integer",
                "nullable": true
              }
            }
          },
          "commitment_term_total_payments": {
            "type": "integer",
            "nullable": true
          },
          "cancel_at_end_of_commitment": {
            "type": "boolean"
          },
          "next_payment_date": {
            "type": "string",
            "format": "date-time",
            "example": "2023-04-23 00:45:00"
          },
          "past_due": {
            "type": "boolean",
            "example": false
          },
          "successful_charges_count": {
            "type": "integer",
            "description": "Number of successful charges.\n"
          },
          "charges_limit": {
            "type": "integer",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "trial",
              "pre_order",
              "gift_waiting_to_start",
              "cancelled",
              "switched",
              "expired"
            ],
            "description": "The current status of the subscription. Possible values:\n- `active`: The subscription is currently active, and the user is being billed as per the plan's terms\n- `trial`: The subscription is in a trial period, and will automatically switch to an active status with billing at the start of the next renewal cycle\n- `pre_order`: The subscription has been created but will only be charged once the pre-order end date is reached\n- `gift_waiting_to_start`: A subscription that was gifted and is set to begin at a future date\n- `cancelled`:  The subscription has been canceled and will not renew at the end of the current billing period\n- `switched`: The subscription has been switched to a different plan with purpose to reset subscription's order count\n- `expired`: The subscription has ended due to reaching its auto expire cycles\n"
          },
          "cancellations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cancellation"
            }
          },
          "discounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Discount"
            }
          },
          "addons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Addon"
            }
          },
          "last_payment_at": {
            "type": "string",
            "format": "date-time",
            "example": "2023-04-23 00:45:00"
          },
          "unpaid": {
            "type": "boolean",
            "example": false
          },
          "cancellation_requested": {
            "type": "boolean",
            "example": false
          },
          "metadata": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/EntityMetadata"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2022-04-01 00:00:00"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2022-04-01 00:00:00"
          }
        }
      },
