    "/variants": {
      "post": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Product"
        ],
        "summary": "Create variant",
        "operationId": "storeVariant",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "product_id",
                  "price"
                ],
                "properties": {
                  "product_id": {
                    "type": "integer",
                    "description": "Parent one-time product ID"
                  },
                  "name": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 255,
                    "description": "Required when product is a gift card or when no options are provided."
                  },
                  "price": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Price in cents"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "inventory_item_id": {
                    "type": "integer",
                    "nullable": true,
                    "description": "Prohibited for gift card products."
                  },
                  "options": {
                    "type": "object",
                    "nullable": true,
                    "description": "Prohibited for gift card products.",
                    "properties": {
                      "create": {
                        "type": "array",
                        "maxItems": 3,
                        "items": {
                          "type": "object",
                          "required": [
                            "name",
                            "value"
                          ],
                          "properties": {
                            "name": {
                              "type": "string",
                              "maxLength": 255
                            },
                            "value": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Variant object response",
