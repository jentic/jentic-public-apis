    "/bundles": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Bundle"
        ],
        "summary": "Get list of bundles",
        "description": "An API endpoint to get list of bundles. The private API can access both published and unpublished bundles.\n",
        "operationId": "listBundles",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Items per page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "ids[]",
            "in": "query",
            "description": "Filter by bundle IDs",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "slugs[]",
            "in": "query",
            "description": "Filter by bundle slugs",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "tags[]",
            "in": "query",
            "description": "Filter by tags",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "published",
            "in": "query",
            "description": "Filter by published status",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "configurable",
            "in": "query",
            "description": "Filter by configurable bundles",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "digital",
            "in": "query",
            "description": "Filter by digital bundles",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "$ref": "#/components/parameters/ExpandParam"
          },
          {
            "name": "sort[field]",
            "in": "query",
            "description": "Field to sort by",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "name"
              ]
            }
          },
          {
            "name": "sort[direction]",
            "in": "query",
            "description": "Sort direction",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bundles list response",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResult"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Bundle"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Bundle"
        ],
        "summary": "Create a new bundle",
        "operationId": "storeBundle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "configurable",
                  "slug"
                ],
                "properties": {
                  "configurable": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "selection_type": {
                    "type": "string",
                    "nullable": true,
                    "enum": [
                      "variant",
                      "product",
                      "single_product"
                    ]
                  },
                  "digital": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "slug": {
                    "type": "string",
                    "maxLength": 70
                  },
                  "name": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 255
                  },
                  "hidden_items": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "searchable": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "show_ruleset_name": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "delivery_info": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 500
                  },
                  "setup_fee": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "pre_order_end_at": {
                    "type": "string",
                    "nullable": true,
                    "format": "date"
                  },
                  "gifting_enabled": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "pause_enabled": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "price_type": {
                    "type": "string",
                    "nullable": true,
                    "enum": [
                      "total",
                      "per_item"
                    ]
                  },
                  "discount_type": {
                    "type": "string",
                    "nullable": true,
                    "enum": [
                      "per_item",
                      "total",
                      "percentage"
                    ]
                  },
                  "ruleset_type": {
                    "type": "string",
                    "nullable": true,
                    "enum": [
                      "quantity",
                      "total"
                    ]
                  },
                  "appearance_type": {
                    "type": "string",
                    "nullable": true,
                    "enum": [
                      "one_step",
                      "two_step",
                      "without_ruleset"
                    ]
                  },
                  "quantity_selectors": {
                    "type": "array",
                    "nullable": true,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "collect_shipping_address": {
                    "type": "integer",
                    "nullable": true,
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "funnel_id": {
                    "type": "integer",
                    "nullable": true
                  },
                  "tags": {
                    "type": "object",
                    "properties": {
                      "create": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "value"
                          ],
                          "properties": {
                            "value": {
                              "type": "string",
                              "maxLength": 255
                            }
                          }
                        }
                      }
                    }
                  },
                  "filters": {
                    "type": "object",
                    "properties": {
                      "create": {
                        "type": "array",
                        "maxItems": 1,
                        "items": {
                          "type": "object",
                          "required": [
                            "metadata_id"
                          ],
                          "properties": {
                            "metadata_id": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  },
                  "preferences": {
                    "type": "object",
                    "properties": {
                      "create": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "attribute_id",
                            "title"
                          ],
                          "properties": {
                            "attribute_id": {
                              "type": "integer"
                            },
                            "title": {
                              "type": "string",
                              "maxLength": 255
                            }
                          }
                        }
                      }
                    }
                  },
                  "rulesets": {
                    "type": "object",
                    "properties": {
                      "create": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "min",
                            "max"
                          ],
                          "properties": {
                            "min": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "max": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 1
                            },
                            "name": {
                              "type": "string",
                              "nullable": true,
                              "maxLength": 255
                            },
                            "cta_text": {
                              "type": "string",
                              "nullable": true,
                              "maxLength": 255
                            }
                          }
                        }
                      }
                    }
                  },
                  "images": {
                    "type": "object",
                    "properties": {
                      "create": {
                        "type": "array",
                        "maxItems": 5,
                        "items": {
                          "type": "object",
                          "required": [
                            "url"
                          ],
                          "properties": {
                            "url": {
                              "type": "string",
                              "maxLength": 500
                            },
                            "order": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bundle created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bundle"
                }
              }
            }
          }
        }
      }
    },
