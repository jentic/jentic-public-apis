        ],
        "summary": "Get payment method by ID.",
        "description": "A detailed description of the payment method.\n",
        "operationId": "showPaymentMethod",
        "parameters": [
          {
            "name": "payment_method_id",
            "in": "path",
            "description": "Payment method ID",
