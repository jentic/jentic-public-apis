            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by active status",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "query",
            "in": "query",
            "description": "Search by name or SKU",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 255
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Inventory items list response",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResult"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/InventoryItem"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Inventory"
        ],
        "summary": "Create a new inventory item",
        "operationId": "storeInventoryItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "sku",
                  "stock_count",
                  "status"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "sku": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "Unique SKU within the shop"
                  },
                  "stock_count": {
                    "type": "integer"
                  },
                  "status": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "priority": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 1
                  },
                  "inventory_group_id": {
                    "type": "integer",
                    "nullable": true
                  },
                  "buy_price": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0,
                    "description": "Buy price in cents"
                  },
                  "msrp_price": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0,
                    "description": "MSRP price in cents"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "photo_url": {
                    "type": "string",
                    "nullable": true,
                    "format": "url",
                    "maxLength": 255
                  },
                  "weight": {
                    "type": "number",
                    "nullable": true,
                    "minimum": 0.01
                  },
                  "width": {
                    "type": "number",
                    "nullable": true,
                    "minimum": 0.01
                  },
                  "height": {
                    "type": "number",
                    "nullable": true,
                    "minimum": 0.01
                  },
                  "depth": {
                    "type": "number",
                    "nullable": true,
                    "minimum": 0.01
                  },
                  "hs_code": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 255,
                    "description": "Harmonized System code"
                  },
                  "country_origin_id": {
                    "type": "integer",
                    "nullable": true,
                    "description": "Country of origin ID"
                  },
                  "tags": {
                    "type": "object",
                    "properties": {
                      "create": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "value"
                          ],
                          "properties": {
                            "value": {
                              "type": "string",
                              "maxLength": 255
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inventory item created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryItem"
                }
              }
            }
          }
        }
      }
    },
