        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "create"
                ],
                "properties": {
                  "create": {
                    "type": "array",
                    "maxItems": 200,
                    "items": {
                      "type": "object",
                      "required": [
                        "variant_id"
                      ],
                      "properties": {
                        "variant_id": {
                          "type": "integer"
                        },
                        "quantity": {
                          "type": "integer",
                          "nullable": true,
                          "minimum": 1
                        },
