    "/products/subscription": {
      "post": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Product"
        ],
        "summary": "Create subscription product",
        "operationId": "storeSubscriptionProduct",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "slug"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "slug": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "digital": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "delivery_info": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 500
                  },
                  "gifting_enabled": {
                    "type": "integer",
                    "nullable": true,
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "pre_order_end_at": {
                    "type": "string",
                    "nullable": true,
                    "format": "date"
                  },
                  "setup_fee": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "pause_enabled": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "collect_shipping_address": {
                    "type": "integer",
                    "nullable": true,
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "tax_product_code": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 30
                  },
                  "inventory_item_id": {
                    "type": "integer",
                    "nullable": true
                  },
                  "funnel_id": {
                    "type": "integer",
                    "nullable": true
                  },
                  "tags": {
                    "type": "object",
                    "properties": {
                      "create": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "value"
                          ],
                          "properties": {
                            "value": {
                              "type": "string",
                              "maxLength": 255
                            }
                          }
                        }
                      }
                    }
                  },
                  "images": {
                    "nullable": true,
                    "type": "object",
                    "properties": {
                      "create": {
                        "type": "array",
                        "maxItems": 5,
                        "items": {
                          "type": "object",
                          "required": [
                            "url"
                          ],
                          "properties": {
                            "url": {
                              "type": "string",
                              "maxLength": 500
                            },
                            "order": {
                              "type": "integer",
                              "nullable": true,
                              "minimum": 0
                            }
                          }
