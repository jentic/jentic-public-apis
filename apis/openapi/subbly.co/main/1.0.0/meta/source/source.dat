            "nullable": true,
            "description": "Description of the metadata.",
            "type": "string"
          },
          "unit": {
            "type": "string",
            "nullable": true,
            "example": "kg"
          },
          "data_type": {
            "nullable": false,
            "type": "string",
            "enum": [
              "single_line_string",
              "multi_line_text",
              "rich_text",
              "integer",
              "decimal",
              "datetime",
              "date",
              "time",
              "volume",
              "weight",
