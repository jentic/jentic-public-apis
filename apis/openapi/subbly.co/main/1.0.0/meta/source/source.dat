                    "type": "integer",
                    "nullable": true
                  },
                  "inventory_stock_count": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                  },
                  "create": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "required": [
                        "price",
                        "options"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "nullable": true,
                          "maxLength": 255
                        },
                        "description": {
                          "type": "string",
                          "nullable": true
                        },
                        "price": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "inventory_item_id": {
                          "type": "integer",
                          "nullable": true
                        },
                        "options": {
                          "type": "object",
                          "required": [
                            "create"
                          ],
                          "properties": {
                            "create": {
                              "type": "array",
                              "maxItems": 3,
                              "items": {
                                "type": "object",
                                "required": [
                                  "name",
                                  "value"
                                ],
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "maxLength": 255
                                  },
                                  "value": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "update": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string",
                          "nullable": true,
                          "maxLength": 255
                        },
                        "description": {
                          "type": "string",
                          "nullable": true
                        },
                        "price": {
                          "type": "integer",
                          "nullable": true,
                          "minimum": 0
                        },
                        "inventory_item_id": {
                          "type": "integer",
                          "nullable": true
                        },
                        "options": {
                          "type": "object",
                          "nullable": true,
                          "properties": {
                            "create": {
                              "type": "array",
                              "maxItems": 3,
                              "items": {
                                "type": "object",
                                "required": [
                                  "name",
                                  "value"
                                ],
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "maxLength": 255
                                  },
                                  "value": {
                                    "type": "string"
                                  }
                                }
                              }
                            },
                            "update": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "required": [
                                  "id",
                                  "value"
                                ],
                                "properties": {
                                  "id": {
                                    "type": "integer"
                                  },
                                  "value": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "archive": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "required": [
                        "id"
                      ],
                      "properties": {
                        "id": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch operation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "create": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Variant"
                      }
                    },
                    "update": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Variant"
                      }
                    },
                    "delete": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Variant"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/plans": {
      "post": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Product"
        ],
        "summary": "Create plan",
        "operationId": "storePlan",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "product_id",
                  "frequency_unit",
                  "frequency_count"
                ],
                "properties": {
                  "product_id": {
                    "type": "integer",
                    "description": "Parent subscription product ID"
                  },
                  "frequency_unit": {
                    "type": "string",
                    "enum": [
                      "day",
                      "week",
                      "month"
                    ]
                  },
                  "frequency_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 365
                  },
                  "name": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 255
                  },
                  "price": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Price in cents"
                  },
                  "anchor_date": {
                    "type": "string",
                    "nullable": true,
                    "format": "date",
                    "description": "Accepts date (Y-m-d) or the string \"today\" which resolves to the current date"
                  },
                  "rebilling_day": {
                    "type": "integer",
                    "nullable": true
                  },
                  "rebilling_day_of_month": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 1,
                    "maximum": 31
                  },
                  "rebilling_day_of_week": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 1,
                    "maximum": 7
                  },
                  "cut_off_days": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "cut_off_time": {
                    "type": "string",
                    "nullable": true,
                    "example": "23:59",
                    "description": "Format HH:mm"
                  },
                  "charge_immediately": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "ship_immediately": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "buffer_days": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "trial_price": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "trial_length_days": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "trial_single_order": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "commitment_billing_count": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 1
                  },
                  "charges_limit": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 1
                  },
                  "shipment_schedule": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "add_unit": {
                          "type": "string",
                          "enum": [
                            "day",
                            "week",
                            "month"
                          ]
                        },
                        "add_count": {
                          "type": "integer"
                        },
                        "unit_day": {
                          "type": "integer"
                        },
                        "unit_offset": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "survey_id": {
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plan object response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          }
        }
      }
    },
