    "/variants/{variant_id}": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Product"
        ],
        "summary": "Get variant by ID",
        "description": "Get a specific variant by ID. This endpoint is only for one-time product variants.\n",
        "operationId": "showVariant",
        "parameters": [
          {
            "name": "variant_id",
            "in": "path",
            "description": "Variant ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/ExpandParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Variant object response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Variant"
                }
              }
            }
          }
        }
      },
      "put": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Product"
        ],
        "summary": "Update variant",
        "operationId": "updateVariant",
        "parameters": [
          {
            "name": "variant_id",
            "in": "path",
            "description": "Variant ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 255
                  },
                  "price": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "inventory_item_id": {
                    "type": "integer",
                    "nullable": true
                  },
                  "options": {
                    "type": "object",
                    "nullable": true,
                    "properties": {
                      "create": {
                        "type": "array",
                        "maxItems": 3,
                        "items": {
                          "type": "object",
                          "required": [
                            "name",
                            "value"
                          ],
                          "properties": {
                            "name": {
                              "type": "string",
                              "maxLength": 255
                            },
                            "value": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "update": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "id",
