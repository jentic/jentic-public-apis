    "/bundles/{bundle_id}/plans": {
      "post": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Bundle"
        ],
        "summary": "Create a bundle plan",
        "operationId": "storeBundlePlan",
        "parameters": [
          {
            "name": "bundle_id",
            "in": "path",
            "description": "Bundle ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type",
                  "name"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "subscription",
                      "one_time"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "prices": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "ruleset_id",
                        "ranges"
                      ],
                      "properties": {
                        "ruleset_id": {
                          "type": "integer"
                        },
                        "ranges": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "quantity",
                              "amount"
                            ],
                            "properties": {
                              "quantity": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "amount": {
                                "type": "integer",
                                "minimum": 0
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "discounts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "ruleset_id",
                        "ranges"
                      ],
                      "properties": {
                        "ruleset_id": {
                          "type": "integer"
                        },
                        "ranges": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "quantity": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "amount_off": {
                                "type": "integer",
                                "nullable": true,
                                "minimum": 0
                              },
                              "percent_off": {
                                "type": "number",
                                "nullable": true,
                                "minimum": 0,
                                "maximum": 100
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "frequency_unit": {
                    "type": "string",
                    "description": "Required for subscription type",
                    "enum": [
                      "day",
                      "week",
                      "month"
                    ]
                  },
                  "frequency_count": {
                    "type": "integer",
                    "description": "Required for subscription type",
                    "minimum": 1,
                    "maximum": 365
                  },
                  "shippings": {
                    "type": "array",
                    "description": "Required for non-digital subscription bundles. Prohibited for digital bundles.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "add_unit": {
                          "type": "string",
                          "description": "Buffered shipping unit. Prohibited with anchored shipping.",
                          "enum": [
                            "day",
                            "week",
                            "month"
                          ]
                        },
                        "add_count": {
                          "type": "integer",
                          "description": "Buffered shipping count. Required with add_unit."
                        },
                        "unit_day": {
                          "type": "integer",
                          "description": "Anchored shipping day. Required without add_unit."
                        },
                        "unit_offset": {
                          "type": "integer",
                          "description": "Anchored shipping offset. Required with unit_day."
                        }
                      }
                    }
                  },
                  "anchor_date": {
                    "type": "string",
                    "format": "date",
                    "nullable": true,
                    "description": "Date in Y-m-d format. Accepts 'today' as a special value. Required for daily frequency with anchored billing."
                  },
                  "rebilling_day": {
                    "type": "integer",
                    "nullable": true,
                    "description": "For daily frequency. Must be 1 if set.",
                    "enum": [
                      1
                    ]
                  },
                  "rebilling_day_of_month": {
                    "type": "integer",
                    "nullable": true,
                    "description": "For monthly frequency. Day of month (1-31).",
                    "minimum": 1,
                    "maximum": 31
                  },
                  "rebilling_day_of_week": {
                    "type": "integer",
                    "nullable": true,
                    "description": "For weekly frequency. Day of week (1-7).",
                    "minimum": 1,
                    "maximum": 7
                  },
                  "cut_off_days": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "cut_off_time": {
                    "type": "string",
                    "nullable": true,
                    "description": "Time in HH:MM format. Required with cut_off_days."
                  },
                  "charge_immediately": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "ship_immediately": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "buffer_days": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "trial_price": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "trial_length_days": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "trial_single_order": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "commitment_billing_count": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 1
                  },
                  "charges_limit": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 1
                  },
                  "survey_id": {
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bundle plan created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BundlePlan"
                }
              }
            }
          }
        }
      }
    },
