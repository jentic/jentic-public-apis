    "/transactions": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Transaction"
        ],
        "summary": "Get list of transactions.",
        "description": "An API endpoint to get list of transactions.\n",
        "operationId": "listTransactions",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Entities per page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "customer_id",
            "in": "query",
            "description": "Filter by customer ID",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "invoice_id",
            "in": "query",
            "description": "Filter by invoice ID",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter transactions by status (e.g., success, failed)",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "success",
                "failed"
              ]
            }
          },
          {
            "name": "external_ids",
            "in": "query",
            "description": "Filter transactions by external (gateway) transaction IDs",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions list response",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResult"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "allOf": [
                              {
                                "$ref": "#/components/schemas/Transaction"
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{transaction_id}": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Transaction"
        ],
        "summary": "Get transaction by ID.",
        "description": "A detailed description of the charge transaction.\n",
        "operationId": "showTransaction",
        "parameters": [
          {
            "name": "transaction_id",
