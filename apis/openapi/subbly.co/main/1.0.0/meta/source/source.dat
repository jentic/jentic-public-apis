  "paths": {
    "/customers/{customer_id}": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Customer"
        ],
        "summary": "Get customer by ID.",
        "description": "A detailed description of the customer.\n",
        "operationId": "showCustomer",
        "parameters": [
          {
            "name": "customer_id",
            "in": "path",
            "description": "Customer ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer object response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          }
        }
      }
    },
    "/subscriptions": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Subscription"
        ],
        "summary": "Get list of subscriptions",
        "description": "An API endpoint to get list of subscriptions\n",
        "operationId": "listSubscriptions",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Items per page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "statuses",
            "in": "query",
            "description": "Filter by subscription statuses",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "active",
                  "trial",
                  "pre_order",
                  "gift_waiting_to_start",
                  "cancelled",
                  "switched",
                  "expired"
                ]
              }
            }
          },
          {
            "name": "start_created_at",
            "in": "query",
            "description": "Filter to include only subscriptions with a creation date on or after the specified start date",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2022-02-24T04:00:00"
            }
          },
          {
            "name": "end_created_at",
            "in": "query",
            "description": "Filter to include only subscriptions with a creation date on or before the specified end date",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2022-02-24T04:00:00"
            }
          },
          {
            "name": "customer_id",
            "in": "query",
            "description": "Filter by customer ID",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "product_id",
            "in": "query",
            "description": "Filter by product ID",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/ExpandParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Subscriptions list response",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResult"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Subscription"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/subscriptions/{subscription_id}": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Subscription"
        ],
        "summary": "Get subscription by ID.",
        "description": "A detailed description of the subscription.\n",
        "operationId": "showSubscription",
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "description": "Subscription ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Subscription object response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          }
        }
      }
    },
    "/subscriptions/{subscription_id}/cancel": {
      "post": {
        "summary": "Cancel a subscription",
        "description": "Cancels a subscription for a given reason.",
        "operationId": "cancelSubscription",
        "tags": [
          "Subscription"
        ],
        "parameters": [
          {
            "name": "subscription_id",
            "in": "path",
            "description": "The ID of the subscription to cancel",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/SubscriptionCancelBody"
        },
        "responses": {
          "200": {
            "description": "Subscription object response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Subscription"
                }
              }
            }
          }
        }
      }
    },
    "/invoices": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Invoice"
        ],
        "summary": "Get list of invoices.",
        "description": "An API endpoint to get list of invoices.\n",
        "operationId": "listInvoices",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Entities per page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "customer_id",
            "in": "query",
            "description": "Filter by customer ID",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "description": "Filter to include only invoices with a creation date on or after the specified start date.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2022-02-24T04:00:00"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "description": "Filter to include only invoices with a creation date on or before the specified end date.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2022-02-24T04:00:00"
            }
          },
          {
            "name": "statuses",
            "in": "query",
            "description": "Filter by invoice status",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "pending",
                  "open",
                  "paid",
                  "voided",
                  "past_due",
                  "processing"
                ]
              }
            }
          },
          {
            "$ref": "#/components/parameters/ExpandParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Invoices list response",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PaginatedResult"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "allOf": [
                              {
                                "$ref": "#/components/schemas/Invoice"
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{invoice_id}": {
      "get": {
        "security": [
          {
            "apiKey": []
