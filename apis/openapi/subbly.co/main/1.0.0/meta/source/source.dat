    "/plans/{plan_id}": {
      "get": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Product"
        ],
        "summary": "Get plan by ID",
        "description": "Get a specific plan by ID. This endpoint is only for subscription product plans.\n",
        "operationId": "showPlan",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "description": "Plan ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/ExpandParam"
          }
        ],
        "responses": {
          "200": {
            "description": "Plan object response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          }
        }
      },
      "put": {
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Product"
        ],
        "summary": "Update plan",
        "operationId": "updatePlan",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "description": "Plan ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "nullable": true,
                    "maxLength": 255
                  },
                  "price": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Price in cents. Cannot be changed if the plan has active subscriptions."
                  },
                  "cut_off_days": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "cut_off_time": {
                    "type": "string",
                    "nullable": true,
                    "example": "23:59",
                    "description": "Format HH:mm"
                  },
                  "charge_immediately": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "ship_immediately": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "buffer_days": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "trial_price": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "trial_length_days": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0
                  },
                  "trial_single_order": {
                    "type": "integer",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  "commitment_billing_count": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 1
                  },
                  "charges_limit": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 1
                  },
                  "shipment_schedule": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "add_unit": {
                          "type": "string",
                          "nullable": true,
                          "enum": [
                            "day",
                            "week",
                            "month"
                          ]
                        },
                        "add_count": {
                          "type": "integer",
                          "nullable": true
                        },
                        "unit_day": {
                          "type": "integer",
                          "nullable": true
                        },
                        "unit_offset": {
                          "type": "integer",
                          "nullable": true
                        }
                      }
                    }
                  },
                  "survey_id": {
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plan object response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          }
