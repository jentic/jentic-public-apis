                    "type": "integer",
                    "nullable": true,
                    "minimum": 1
                  },
                  "extra_price": {
                    "type": "integer",
                    "nullable": true,
                    "minimum": 0,
                    "description": "Extra price in cents"
                  },
                  "settings": {
                    "type": "object",
                    "nullable": true,
                    "properties": {
                      "create": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "bundle_ruleset_id",
                            "max_quantity"
                          ],
                          "properties": {
                            "bundle_ruleset_id": {
                              "type": "integer"
                            },
                            "max_quantity": {
                              "type": "integer",
