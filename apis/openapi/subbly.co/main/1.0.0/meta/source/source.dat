            "description": "Bundle item created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BundleItem"
                }
              }
            }
          }
        }
      }
    },
    "/bundles/{bundle_id}/items/batch": {
