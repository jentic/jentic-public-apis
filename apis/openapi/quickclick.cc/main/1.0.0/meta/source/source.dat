    "/v1/platforms/{platform}/shops/{shopId}/menus": {
      "get": {
        "tags": [
          "菜單APIs"
        ],
        "summary": "取得商店的菜單(平台)",
        "description": "透過此API可以讓第三方根據設定回應預設菜品\n\n如果不希望mapping菜品的店，根據平台preference可以讓回傳的API只有預設商品",
        "operationId": "getMenuByPlatform",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "平台代碼"
          },
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "取得商店的菜單(平台)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "menus": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
