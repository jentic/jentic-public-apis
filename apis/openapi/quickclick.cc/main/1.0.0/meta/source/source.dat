    "/v1/shops": {
      "get": {
        "tags": [
          "商店APIs"
        ],
        "summary": "取得商店列表",
        "description": "店家詳細資訊將於上架時，透過Excel或POST API方式直接提供給第三方平台廠商，可提供欄位包括\n\n- id: 商店ID\n    \n- shopId: 商店串接ID\n    \n- address: 住址\n    \n\n```\n// Response Example\n{\n    \"shopId\": \"P_xxxxxx\", // 商店ID\n    \"shopName\": \"我的第一間商店\", // 商店名稱\n    \"shopInfo\": \"店家描述說明\", // 店家描述說明\n}\n\n ```",
        "operationId": "getShops",
        "responses": {
          "200": {
            "description": "取得商店列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 12345
                      },
                      "shopId": {
                        "type": "string",
                        "example": "D_B81NJ2kdm"
                      },
                      "shopName": {
                        "type": "string",
                        "example": "我的測試商店"
                      },
                      "prepareTime": {
                        "type": "integer",
                        "example": 15
                      },
                      "storeAddress": {
                        "type": "string",
                        "example": "台北市信義區信義路五段7號"
                      }
                    }
                  }
                },
                "example": [
                  {
                    "id": 12345,
                    "shopId": "D_B81NJ2kdm",
                    "shopName": "我的測試商店",
                    "prepareTime": 15,
                    "storeAddress": "台北市信義區信義路五段7號"
                  },
                  {
                    "id": 12346,
                    "shopId": "D_D1GNjLr6p",
                    "shopName": "第二間商店",
                    "prepareTime": 20,
                    "storeAddress": "台北市大安區忠孝東路四段1號"
                  }
                ]
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        }
      }
    },
    "/v1/shops/{shopId}/carts": {
      "post": {
        "tags": [
          "購物車APIs"
        ],
        "summary": "建立訂單購物車",
        "description": "此 API 用於在特定商店中建立一個訂單購物車。\n\nRequest Body說明：\n\n| 參數名稱 | 資料型態 | 必填 | 描述 |\n| --- | --- | --- | --- |\n| customerId | 字串 | 是 | 客戶 ID |\n| customerName | 字串 | 是 | 點餐者顯示名稱 |\n| cartOwnerId | 字串 | 否 | 購物車擁有者 ID |\n| cartType | 字串 | 是 | 購物車類型 (ORDER, GROUP_ORDER, TABLE_ORDER) |\n| closeTs | 整數 | 是 | 購物車關閉時間戳記 |\n| displayId | 字串 | 否 | 取餐編號 |\n| tableNumber | 字串 | 否 | 桌號 |\n| user | 物件 | 否 | 使用者資訊 |\n| userId | 字串 | 否 | 使用者 ID |\n\nResponse 說明：\n\n| 回傳參數名稱 | 資料型態 | 描述 |\n| --- | --- | --- |\n| cartId | 字串 | 購物車 ID |\n| customerCartId | 字串 | 此客戶的購物車 ID |",
        "operationId": "createCart",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "建立訂單購物車 - 揪團一起點",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cartId": {
                      "type": "string",
                      "example": "D_1LJd7kjE4_HM2EHcaSThqJYZuzBPPL"
                    },
                    "cartOwnerId": {
                      "type": "string",
                      "example": "df5c63e8-1fcc-5a31-8f5f-2b2306a6ed20"
                    },
                    "customerId": {
                      "type": "string",
                      "example": "df5c63e8-1fcc-5a31-8f5f-2b2306a6ed20"
                    },
                    "customerToken": {
                      "type": "string",
                      "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..cNw04bqkpTUTRuPHboetRKOCYeedzymTuM5L44Lk9PTT6hSFlI5SOBMMME8qgoitDc15alFEsqqSigLjzs6T02n6WXgop6kc9d19vnQ06VDJ0mM7ICnR_g7QP0SRjgq9fGoz6yziFweFw6A_pe1dhAe58hBJMvI9rtTQHQVmkJkZt8va8S0jHVEOG9qhdmnJvGJsNT4XcIuIn4_oEwQpcMioKHTPWIPWTjgJha0fAmay2yFjS8c7iLx8O-jxd-uCbZWLAzP8S0GD7VixG0VGJG9d914a92kC0ypxr9tPeirCjbbdWqjWte2c-Jn0WotvUhNUtftTP0gShyNNhrjpMg"
                    },
                    "tokenExpiredTs": {
                      "type": "integer",
                      "example": 1681754062
                    },
                    "cartOwnerName": {
                      "type": "string",
                      "example": "AAAA2"
                    },
                    "customerCarts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "customerId": {
                            "type": "string",
                            "example": "df5c63e8-1fcc-5a31-8f5f-2b2306a6ed20"
                          },
                          "customerName": {
                            "type": "string",
                            "example": "AAAA2"
                          },
                          "customerCartStatus": {
                            "type": "string",
                            "example": "cart_ready"
                          },
                          "customerCartId": {
                            "type": "string",
                            "example": "hHTE0XlLf6RRrRsbKH86"
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "example1": {
                    "summary": "建立訂單購物車 - 揪團一起點",
                    "value": {
                      "cartId": "D_1LJd7kjE4_HM2EHcaSThqJYZuzBPPL",
                      "cartOwnerId": "df5c63e8-1fcc-5a31-8f5f-2b2306a6ed20",
