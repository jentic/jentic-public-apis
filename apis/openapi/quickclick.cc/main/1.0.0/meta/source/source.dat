                        "categoryIds": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "externalId": {
                                "type": "string",
                                "example": "c1"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "externalId": {
                          "type": "string",
                          "example": "c1"
                        },
                        "title": {
                          "type": "string",
                          "example": "我的分類"
                        },
                        "productIds": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "externalId": {
                                "type": "string",
                                "example": "p1"
                              }
                            }
                          }
                        },
                        "translations": {
                          "type": "object",
                          "properties": {
                            "default": {
                              "type": "string",
                              "example": "zh-TW"
                            },
                            "zh-TW": {
                              "type": "object",
                              "properties": {
                                "title": {
                                  "type": "string",
                                  "example": "my Category"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "products": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "example": "我的商品1"
                        },
                        "description": {
                          "type": "string",
                          "example": "測測測測"
                        },
                        "price": {
                          "type": "integer",
                          "example": 10
                        },
                        "externalId": {
                          "type": "string",
                          "example": "p1"
                        },
                        "modifierGroupIds": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "externalId": {
                                "type": "string",
                                "example": "s1"
                              },
                              "modifierOptionIds": {
                                "type": "array",
                                "items": {
                                  "type": "object"
                                }
                              }
                            }
                          }
                        },
                        "translations": {
                          "type": "object",
                          "properties": {
                            "default": {
                              "type": "string",
                              "example": "zh-TW"
                            },
                            "zh-TW": {
                              "type": "object",
                              "properties": {
                                "title": {
                                  "type": "string",
                                  "example": "my Product1"
                                },
                                "description": {
                                  "type": "string",
                                  "example": "test"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "modifierGroups": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "externalId": {
                          "type": "string",
                          "example": "s1"
                        },
                        "title": {
                          "type": "string",
                          "example": "測試加購"
                        },
                        "type": {
                          "type": "string",
                          "example": "single"
                        },
                        "modifierOptionIds": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "externalId": {
                                "type": "string",
                                "example": "o1"
                              }
                            }
                          }
                        },
                        "translations": {
                          "type": "object",
                          "properties": {
                            "default": {
                              "type": "string",
                              "example": "zh-TW"
                            },
                            "zh-TW": {
                              "type": "object",
                              "properties": {
                                "title": {
                                  "type": "string",
                                  "example": "my Modifier Group"
                                },
                                "description": {
                                  "type": "string",
                                  "example": ""
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "modifierOptions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "externalId": {
                          "type": "string",
                          "example": "o1"
                        },
                        "title": {
                          "type": "string",
                          "example": "加購選項1"
                        },
                        "price": {
                          "type": "integer",
                          "example": 10
                        },
                        "modifierGroupExternalId": {
                          "type": "string",
                          "example": "s1"
                        },
                        "modifierGroupIds": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "externalId": {
                                "type": "string",
                                "example": "s2"
                              },
                              "modifierOptionIds": {
                                "type": "array",
                                "items": {
                                  "type": "object"
                                }
                              }
                            }
                          }
                        },
                        "translations": {
                          "type": "object",
                          "properties": {
                            "default": {
                              "type": "string",
                              "example": "zh-TW"
                            },
                            "zh-TW": {
                              "type": "object",
                              "properties": {
