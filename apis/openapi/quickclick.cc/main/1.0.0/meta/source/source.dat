                      "customerToken": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..ee9-trJCmf94uy5qR6PeFmrcJgXygzY-fbd1PaZXC2mCwgnDC5HLtu6OTTxUXBvSaH2m0jzdAk_xujk9ByEl32cOyUoa0B304RVhdqjoZjcQHzk90413JMKX0v3lcC_Z50n5Q4OEdcNrxIAegbQVciSc6XuLdxXWOxVFPwX4N-_a5armjytZODEpQ1YwPcXAq0q_qKvZ_OPmMcYrmSKF9VbVaxB6mBXy7_NIAqmNR8un0vvkCHEZuPhvB8HgYmb5XIWFh47ZJBEJxzu1eC5xkAcYHFYa0BItqwvQ1ad_z_63mbWWak9CS-1WJKWYfwr2YqdTDHLcgFFR9MATkyf8pg",
                      "tokenExpiredTs": 1683453497,
