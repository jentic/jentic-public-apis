    "/v1/platforms/{platformId}/shops/{shopId}/settings": {
      "get": {
        "tags": [
          "商店APIs"
        ],
        "summary": "取得商店設定(平台)",
        "description": "透過平台取得商店設定資訊\n\n**GET** `/v1/platforms/:platformId/shops/:shopId/settings`\n\n與 取得商店設定 相同，但增加平台參數",
        "operationId": "getShopSettingsByPlatform",
        "parameters": [
          {
            "name": "platformId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "平台代碼 (如: dotdot, ubereats, foodpanda 等)"
          },
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "取得商店設定(平台)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "kiosk": {
                      "type": "object",
                      "properties": {
                        "menu": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "example": "28654"
                            }
                          }
                        },
                        "tables": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "title": {
                                "type": "string",
                                "example": "1號桌"
                              },
                              "type": {
                                "type": "string",
                                "example": "table"
                              }
                            }
                          }
                        },
                        "platforms": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "string",
                                "example": "quickclick"
                              }
                            }
                          }
                        },
                        "mealTypes": {
                          "type": "object",
                          "properties": {
                            "delivery": {
                              "type": "object",
                              "properties": {
                                "enabled": {
                                  "type": "boolean",
                                  "example": false
                                }
                              }
                            },
                            "toGo": {
                              "type": "object",
                              "properties": {
                                "enabled": {
                                  "type": "boolean",
                                  "example": true
                                }
                              }
                            },
                            "eatIn": {
                              "type": "object",
                              "properties": {
                                "enabled": {
                                  "type": "boolean",
                                  "example": true
                                }
                              }
                            }
                          }
                        },
                        "ddpay": {
                          "type": "object",
                          "properties": {
                            "ddqr": {
                              "type": "string",
                              "nullable": true
                            }
                          }
                        },
                        "paymentTypes": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "method": {
                                "type": "string",
                                "example": "cash"
                              },
                              "provider": {
                                "type": "string",
                                "example": "cash"
                              }
                            }
                          }
                        },
                        "carryMethod": {
                          "type": "string",
                          "example": "number"
                        },
                        "currencySettings": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    }
                  }
                },
                "example": {
                  "kiosk": {
                    "menu": {
                      "id": "28654"
                    },
                    "tables": [
                      {
                        "title": "1號桌",
                        "type": "table"
                      }
                    ],
                    "platforms": [
                      {
                        "code": "quickclick"
                      }
                    ],
                    "mealTypes": {
                      "delivery": {
                        "enabled": false
                      },
                      "toGo": {
                        "enabled": true
                      },
                      "eatIn": {
                        "enabled": true
                      }
                    },
                    "ddpay": {
                      "ddqr": null
                    },
                    "paymentTypes": [
                      {
                        "method": "cash",
                        "provider": "cash"
                      }
                    ],
                    "carryMethod": "number",
                    "currencySettings": null
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        }
      }
    },
