    "/v1/shops/{shopId}/menus/{menuId}/upload/{vendorId}": {
      "post": {
        "tags": [
          "菜單APIs"
        ],
        "summary": "上傳菜單至平台",
        "description": "上傳菜單至指定外送平台\n\n**POST** `/v1/shops/:shopId/menus/:menuId/upload/:vendorId`\n\n| 參數 | 說明 |\n| --- | --- |\n| vendorId | 平台代碼: ubereats, foodpanda, linespot, gofoodie, counter, kiosk |\n\n注意：若平台未整合將回傳 NO_VENDOR_INTEGRATED 錯誤",
        "operationId": "uploadMenuToVendor",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          },
          {
            "name": "menuId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "菜單ID"
          },
          {
            "name": "vendorId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "平台代碼 (如: ubereats, foodpanda, linespot, gofoodie, counter, kiosk)"
          }
        ],
        "responses": {
          "200": {
            "description": "上傳菜單至平台",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                },
                "example": {
                  "success": true
                }
              }
            }
          },
          "400": {
            "description": "平台未整合",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "No Middleware Integration"
                        },
                        "code": {
                          "type": "string",
                          "example": "NO_VENDOR_INTEGRATED"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "error": {
                    "message": "No Middleware Integration",
                    "code": "NO_VENDOR_INTEGRATED"
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        }
      }
    },
    "/v1/shops/{shopId}/opening-hours": {
      "get": {
        "tags": [
          "商店APIs"
        ],
        "summary": "取得商店營業時間",
        "description": "取得商店營業時間\n\n- 營業時間: 如下列格式 (特別注意：影響取餐時間包括備餐、配送時間、限流等因素，消費者仍有可能於營業時間內但無法下單）\n```\n    {\n       \"periods\": [{\n          \"0\": [ //sunday\n           {\"startTime\": \"00:00\", \"endTime\": \"23:59\"}\n          ],\n          \"1\": [ \n           {\"startTime\": \"00:00\", \"endTime\": \"23:59\"}\n          ],\n          \"2\": [ \n           {\"startTime\": \"00:00\", \"endTime\": \"23:59\"}\n          ],\n          \"3\": [ \n           {\"startTime\": \"00:00\", \"endTime\": \"23:59\"}\n          ],\n          \"4\": [ \n           {\"startTime\": \"00:00\", \"endTime\": \"23:59\"}\n          ],\n          \"5\": [ \n           {\"startTime\": \"00:00\", \"endTime\": \"23:59\"}\n          ]\n       }],\n       \"specialHours\": {\n         \"2021-11-12\": [\n           {\"startTime\": \"00:00\", \"endTime\": \"23:59\"}\n         ]\n       },\n       \"timezone\": \"Asia/Taipei\"\n    }\n```",
        "operationId": "getShopOpeningHours",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "取得商店狀態",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "utcOffset": {
                      "type": "integer",
                      "example": 480
                    },
                    "periods": {
                      "type": "object",
                      "properties": {
                        "0": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "startTime": {
                                "type": "string",
                                "example": "14:00"
                              },
                              "endTime": {
                                "type": "string",
                                "example": "16:59"
                              },
                              "checkStart": {
                                "type": "string",
                                "example": "00:14:00"
                              },
                              "checkEnd": {
                                "type": "string",
                                "example": "00:16:59"
                              },
                              "cross": {
                                "type": "boolean",
                                "example": false
                              }
                            }
                          }
                        },
                        "1": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "startTime": {
                                "type": "string",
                                "example": "00:00"
                              },
                              "endTime": {
                                "type": "string",
                                "example": "16:59"
                              },
                              "checkStart": {
                                "type": "string",
                                "example": "00:00:00"
                              },
                              "checkEnd": {
                                "type": "string",
                                "example": "00:16:59"
                              },
                              "cross": {
                                "type": "boolean",
                                "example": false
                              }
                            }
                          }
                        },
                        "2": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "startTime": {
                                "type": "string",
                                "example": "00:00"
                              },
                              "endTime": {
                                "type": "string",
                                "example": "16:59"
                              },
                              "checkStart": {
                                "type": "string",
                                "example": "00:00:00"
                              },
                              "checkEnd": {
                                "type": "string",
                                "example": "00:16:59"
                              },
                              "cross": {
                                "type": "boolean",
                                "example": false
                              }
                            }
                          }
                        },
                        "3": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "startTime": {
                                "type": "string",
                                "example": "00:00"
                              },
                              "endTime": {
                                "type": "string",
                                "example": "16:59"
                              },
                              "checkStart": {
                                "type": "string",
                                "example": "00:00:00"
                              },
                              "checkEnd": {
                                "type": "string",
                                "example": "00:16:59"
                              },
                              "cross": {
                                "type": "boolean",
                                "example": false
                              }
                            }
                          }
                        },
                        "4": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "startTime": {
                                "type": "string",
                                "example": "00:00"
                              },
                              "endTime": {
                                "type": "string",
                                "example": "16:59"
                              },
                              "checkStart": {
                                "type": "string",
                                "example": "00:00:00"
                              },
                              "checkEnd": {
                                "type": "string",
                                "example": "00:16:59"
                              },
                              "cross": {
                                "type": "boolean",
                                "example": false
                              }
                            }
                          }
                        },
                        "5": {
