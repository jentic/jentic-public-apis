                          "isRecommended": {
                            "type": "boolean",
                            "example": false
                          },
                          "modifierSettingsId": {
                            "type": "integer",
                            "example": 65335
                          },
                          "modifierGroupIds": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "example": 129343
                                },
                                "externalId": {
                                  "type": "string",
                                  "example": "zhSr6fFsIp"
                                },
                                "customId": {
                                  "type": "integer",
                                  "example": 65335
