              }
            }
          }
        }
      }
    },
    "/v1/vendors/{vendorCode}/shops/{shopId}/ddqr/{ddqrExternalId}": {
      "patch": {
        "tags": [
          "DDQR"
        ],
        "summary": "第三方換桌API",
        "description": "此API允許第三方廠商透過第三方訂單ID，進行換桌。\n\n## Request Body\n\n| 名稱 | 是否必填 | 類型 | 描述 |\n| --- | --- | --- | --- |\n| vendorCode | 是 | 字符串 | 快一點夥伴編號，由快一點提供給夥伴。 |\n| shopId | 是 | 字符串 | 快一點商店ID，例如：`P_XXXXX` |\n| partnerOrderID | 是 | 字符串 | 夥伴訂單ID |\n| ddqrExternalId | 是 | 字符串 | 店家桌牌控制ID，每一個夥伴每一間店唯一。例如：「A1」 |\n\n### Response\n\n| 名稱 | 類型 | 說明 |\n| --- | --- | --- |\n| ddqrCode | 字符串 | 桌子的QR碼 |\n| ddqrExternalId | 字符串 | 店家桌牌控制ID |\n| partnerOrderId | 字符串 | 夥伴訂單ID |",
        "operationId": "ddqrChangeTable",
        "parameters": [
          {
            "name": "vendorCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "平台代碼 (如: ubereats, foodpanda, linespot, gofoodie, counter, kiosk)"
          },
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          },
          {
            "name": "ddqrExternalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "DDQR 外部ID"
          }
        ],
        "responses": {
          "200": {
            "description": "第三方換桌API",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ddqrCode": {
                      "type": "string",
                      "example": "QRCODEABCD"
                    },
                    "ddqrExternalId": {
                      "type": "string",
                      "example": "A1"
                    },
                    "partnerOrderId": {
                      "type": "string",
                      "example": "033-1245678845"
                    }
                  }
                },
                "example": {
                  "ddqrCode": "QRCODEABCD",
                  "ddqrExternalId": "A1",
                  "partnerOrderId": "033-1245678845"
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "partnerOrderId": {
                    "type": "string",
                    "example": "033-1245678845"
                  }
                }
              },
              "example": {
                "partnerOrderId": "033-1245678845"
              }
            }
          }
        }
      }
    },
    "/v1/vendors/{vendorCode}/shops/{shopId}/mw-settings": {
      "get": {
        "tags": [
          "合作夥伴APIs"
        ],
        "summary": "取得MW設定",
        "description": "取得合作夥伴中介軟體設定\n\n**GET** `/v1/vendors/:vendorCode/shops/:shopId/mw-settings`\n\n| 參數 | 說明 |\n| --- | --- |\n| vendorCode | 平台代碼: ubereats, foodpanda, linespot, gofoodie, counter, kiosk |\n\n此API **不需要認證**，回傳指定平台的中介軟體設定\n\n> **注意：此 API 不需要認證**",
        "operationId": "getMwSettings",
        "parameters": [
          {
            "name": "vendorCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "平台代碼 (如: ubereats, foodpanda, linespot, gofoodie, counter, kiosk)"
          },
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "取得MW設定",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "autoAccept": {
                      "type": "boolean",
                      "example": true
                    },
                    "autoPrint": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                },
                "examples": {
                  "example1": {
                    "summary": "取得MW設定",
                    "value": {
                      "autoAccept": true,
                      "autoPrint": true
                    }
                  },
                  "example2": {
                    "summary": "無設定",
                    "value": []
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "security": []
      }
    },
    "/v1/platforms/{platform}/orders/{orderId}": {
      "get": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "取得訂單內容By外部訂單ID",
        "description": "透過外部訂單ID找出對應訂單\n\n# 補充說明\n\n## 訂單狀態\n\n訂單狀態包括:\n\n- new: 新訂單但尚未接單\n    \n- accepted: 已接單\n    \n- rejected: 拒絕接單\n    \n- cancelled: 取消訂單\n    \n- done: 訂單製作完成（使用接單平板時才有)\n    \n\n## 如果有使用GIT物流\n\n訂單狀態增加：\n\n- git_assigning_driver: 媒合中\n    \n- git_on_going: 物流已媒合\n    \n- git_picked_up: 物流已取餐\n    \n- git_completed: 物流已送達\n    \n- git_rejected: 物流已拒單\n    \n- git_expired: 物流已過期\n    \n- git_cancelled: 物流已取消\n    \n\n備註：物流只有媒合中時可以取消，已媒合後不可取消\n\n## 運費呈現方式\n\n運費的部分可查看 `deliveryFee` ，若店家補貼費用，會有 `DELIVERY_FEE_PROMOTION` 的優惠資訊存在於 `discounts` 中。\n\n## 發票開立金額\n\n訂單的 `amount` 為主，透過訂單的最終金額，外部 POS 廠商可以自行開立發票。\n\n## 回傳欄位說明\n\n| 字段名稱 | 資料型態 | 說明 |\n| --- | --- | --- |\n| orderId | String | 訂單ID |\n| id | Integer | 訂單的內部ID。 |\n| currentState | String | 訂單的當前狀態  <br>\\- new: 新訂單但尚未接單  <br>\\- accepted: 已接單  <br>\\- rejected: 拒絕接單  <br>\\- cancelled: 取消訂單  <br>\\- done: 訂單製作完成（使用接單平板時才有) |\n| store | Object | 有關訂單所在店家的信息。 |\n| displayId | String | 取餐編號編號。 |\n| tableNumber | String | 餐桌號碼（如果有）。 |\n| user | Object | 下單用戶的信息。 |\n| comments | String | 訂單備註。 |\n| amount | Integer | 訂單的總金額。 |\n| createdTs | Integer | 訂單建立的Timestamp (unix ts)。 |\n| pickupTs | Integer | 預計取餐的Timestamp (unix ts)。 |\n| driverPickupTs | Integer | 取餐司機接單的Timestamp (unix ts)（如果有）。 |\n| points | Array | 訂單使用的折抵點數（如果有）。 |\n| mealType | String | 餐點類型（包含：\"eat_in\", \"to_go\",  <br>\"takeaway\", \"delivery\"）。 |\n| discounts | Array | 訂單使用的折扣（如果有）。 |\n| platform | String | 訂單的平台來源，包含：quickclick, ubereats, foodpanda。 |\n| source | String | 訂單的下單來源，會根據下單網址的「source」帶到訂單資訊當中，（例如：\"qcv2\"）。 |\n| distributorCode | String | 分銷商代碼（如果有）。 |\n| payment | Object | 支付方法相關資訊。 |\n| deliveryFee | Object | 有關運費的資訊。 |\n| paymentType | String | 付款類型（例如：\"cash\", \"paid_on_site\"）。  <br>paid_on_site: 櫃檯人工確認收款  <br>  <br>member_discounts: 僅使用會員點數或票券折抵  <br>  <br>qrpay_line: LINE行動支付  <br>  <br>qrpay_jko: 街口支付  <br>  <br>qrpay_credit: 信用卡  <br>  <br>qrpay_apple: Apple Pay  <br>  <br>qrpay_google: Google Pay  <br>  <br>qrpay_taiwanpay: TW Pay  <br>  <br>qrpay_easywallet: 悠遊付  <br>  <br>qrpay_icashpay: iCashPay  <br>  <br>qrpay_pxpayplus: 全支付  <br>  <br>qrpay_pluspay: 全盈支付 |\n| carts | Array | 購物車中的項目列表。 |\n| tickets | Array | 使用的票券（如果有）。 |\n| ticketCarts | Array | 購物車中的票券項目列表。 |\n| orderInstructions | Object | 有關訂單指示的信息。 |\n| currencySettings | Object | 有關貨幣設定的信息。 |\n| receipt | Object | 有關收據的信息。 |\n| partner | Object | 合作夥伴的信息。 |\n\n## 訂單範例\n\n```\n{\n  \"orderId\": \"0000001925\", // 訂單編號\n  \"id\": 1925,\n  \"currentState\": \"accepted\", // 訂單狀態\n  \"displayId\": \"29\", // 取餐編號\n  \"tableNumber\": \"1\",\n  \"store\": {\n    \"id\": 56,\n    \"shopId\": \"P_xxxxx\",\n    \"name\": \"Kelly test staging\"\n  },\n  \"qcStore\": {\n    \"shopId\": \"P_xxxxx\"\n  },\n  \"user\": {\n    \"id\": 174,\n    \"userId\": \"abcdefg\", \n    \"name\": \"T.DotDot\", // 用戶姓名\n    \"phone\": null, // 用戶電話\n    \"address\": null,\n    \"taxId\": \"88888888\", // 統編, optional\n    \"carrierId\": \"/xXXXXXX\", // 載具, optional\n    \"sso\": { // 如果有第三方平台串接時，第三方平台ID資訊會在此, optional\n      \"uuid\": \"11b75487-35d7-54f7-aabb-2b401e7fd6d1\",\n      \"provider\": \"oauth\",\n      \"userId\": \"12345678\", // 第三方平台用戶ID\n      \"projectId\": \"ttpushv3\", // optional\n      \"identityPoolId\": \"abcd\" // optional\n    }\n  },\n  \"receipt\": { // optional\n    \"isGetReceipt\": boolean, // 不開發票時才可選擇是否索取收據，開發票的店這個參數不影響\n    \"carrierType\": \"\" // 空白代表不用載具，mobile：手機載具 || member：會員載具 || npc 自然人憑證 || bussiness 統編 || donation 捐贈碼\n  },\n  \"amount\": 90, // 訂單金額\n  \"createdTs\": 1610606801,\n  \"pickupTs\": 1610607660, // 消費者預期取餐時間\n  \"driverPickupTs\": null, // 如果有採用第三方外送服務(e.g., lalamove)，此為外送員取餐時間\n  \"mealType\": \"delivery\", // eat_in 內用, to_go 外帶, delivery 外送\n  \"paymentType\": \"cash\",// cash, multiple, qrpay_credit, qrpay_line, qrpay_google, qrpay_apple, qrpay_easywallet, qrpay_jko, qrpay_icashpay, qrpay_pxpay, qrpay_pluspay, qrpay_gcash_ewallet, qrpay_gcash_scan2pay, qrpay_maya_web, qrpay_maya_scan2pay\n  {\n  \"payment\": {\n    \"type\": \"qrpay_line\", // cash, multiple, qrpay_credit, qrpay_line, qrpay_google, qrpay_apple, qrpay_easywallet, qrpay_jko, qrpay_icashpay, qrpay_pxpay, qrpay_pluspay, qrpay_gcash_ewallet, qrpay_gcash_scan2pay, qrpay_maya_web, qrpay_maya_scan2pay\n    \"status\": \"success\", // \"pending\": 待付款, \"success\": 已付款\n    \"ddpayTransactionId\": \"Q22280043400LZdkmZvx\"\n  },\n  \"deliveryFee\": { // 運費\n    \"value\": 85\n  },\n  \"platform\": \"quickclick\", // 訂單來源平台 (quickclick / ubereats / foodpanda)\n  \"platformData\": {\n    \"orderId\": \"<第三方平台訂單編號>\",\n    \"displayId\": \"<第三方平台取餐編號>\"\n  },\n  \"source\": \"staff\", // 顯示點餐網址所帶的source參數，可識別下單來源\n  \"distributorCode\": \"somevendor\", // 通路代碼 (optional)\n  \"discounts\": [{ // 折扣\n    \"amount\": 10,\n    \"name\": \"一般折扣(金額滿0折10%（無條件捨去）)\",\n    \"type\": \"ORDER_PROMOTION_DISCOUNT\" \n  },\n  {\n      \"amount\": 85,\n      \"name\": \"店家補貼運費\",\n      \"type\": \"DELIVERY_FEE_PROMOTION\"\n  }],\n  \"carts\": [{\n    \"id\": 74907,\n    \"title\": \"南投早餐 Tossed Noodles with Minced Pork Breakfast\",\n    \"externalId\":\"00004\",\n    \"price\":90,\n    \"unitPrice\":90,\n    \"totalPrice\":90,\n    \"baseUnitPrice\":90,\n    \"baseTotalPrice\":90,\n    \"quantity\":1,\n    \"productPriority\":0,\n    \"classId\":null,\n    \"printPriority\":null,\n    \"selectedModifierGroups\": [{\n      \"title\": \"飲料加購\",\n      \"id\": 4708,\n      \"externalId\": null,\n      \"selectedModifierOptions\": [{\n        \"title\": \"綠茶\",\n        \"id\": 25654,\n        \"externalId\": null,\n        \"price\": 0,\n        \"selectedModifierGroups\": [{\n          \"id\": 4710,\n          \"externalId\": null,\n          \"title\": \"甜度\",\n          \"selectedModifierOptions\": [{\n            \"id\": 25655,\n            \"externalId\": null,\n            \"title\": \"去冰\",\n            \"price\": 0\n          }]\n        }]\n      }]\n    }]\n  }]\n}\n\n ```",
        "operationId": "getOrderByExternalId",
        "parameters": [
          {
            "name": "platform",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "平台代碼"
          },
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "訂單ID"
          }
        ],
        "responses": {
          "200": {
            "description": "取得訂單內容",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orderId": {
                      "type": "string",
                      "example": "0000001925"
                    },
                    "id": {
                      "type": "integer",
                      "example": 1925
                    },
                    "currentState": {
                      "type": "string",
                      "example": "accepted"
                    },
                    "store": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 56
                        },
                        "name": {
                          "type": "string",
                          "example": "Kelly test staging"
                        }
                      }
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 174
                        },
                        "userId": {
                          "type": "string",
                          "example": "abcdefg"
                        },
                        "name": {
                          "type": "string",
                          "example": "T.DotDot"
                        },
                        "phone": {
                          "type": "string",
                          "nullable": true
                        },
                        "address": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    },
                    "amount": {
                      "type": "integer",
                      "example": 90
                    },
                    "createdTs": {
                      "type": "integer",
                      "example": 1610606801
                    },
                    "pickupTs": {
                      "type": "integer",
                      "example": 1610607660
                    },
                    "mealType": {
                      "type": "string",
                      "example": "delivery"
                    },
                    "paymentType": {
                      "type": "string",
                      "example": "multiple"
                    },
                    "payment": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "example": "success"
                        }
                      }
                    },
                    "carts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 74907
                          },
                          "title": {
                            "type": "string",
                            "example": "南投早餐 Tossed Noodles with Minced Pork Breakfast"
                          },
                          "externalId": {
                            "type": "string",
                            "example": "南投早餐_Tossed_Noodles_"
                          },
                          "price": {
                            "type": "integer",
                            "example": 90
                          },
                          "unitPrice": {
                            "type": "integer",
                            "example": 90
                          },
                          "totalPrice": {
                            "type": "integer",
                            "example": 90
                          },
                          "baseUnitPrice": {
                            "type": "integer",
                            "example": 90
                          },
                          "baseTotalPrice": {
                            "type": "integer",
                            "example": 90
                          },
                          "quantity": {
                            "type": "integer",
                            "example": 1
                          },
                          "productPriority": {
                            "type": "integer",
                            "example": 0
                          },
                          "classId": {
                            "type": "string",
                            "nullable": true
                          },
                          "printPriority": {
                            "type": "string",
                            "nullable": true
                          },
                          "selectedModifierGroups": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "orderId": "0000001925",
                  "id": 1925,
                  "currentState": "accepted",
                  "store": {
                    "id": 56,
                    "name": "Kelly test staging"
                  },
                  "user": {
                    "id": 174,
                    "userId": "abcdefg",
                    "name": "T.DotDot",
                    "phone": null,
                    "address": null
                  },
                  "amount": 90,
                  "createdTs": 1610606801,
                  "pickupTs": 1610607660,
                  "mealType": "delivery",
                  "paymentType": "multiple",
                  "payment": {
                    "status": "success"
                  },
                  "carts": [
                    {
                      "id": 74907,
                      "title": "南投早餐 Tossed Noodles with Minced Pork Breakfast",
                      "externalId": "南投早餐_Tossed_Noodles_",
                      "price": 90,
