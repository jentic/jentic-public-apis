    "/v1/platforms/{platformId}/orders/{orderId}": {
      "get": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "取得訂單內容(平台)",
        "description": "透過平台取得訂單內容\n\n**GET** `/v1/platforms/:platformId/orders/:orderId`\n\n參數與回應格式同 取得訂單內容",
        "operationId": "getOrderByPlatform",
        "parameters": [
          {
            "name": "platformId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "平台代碼 (如: dotdot, ubereats, foodpanda 等)"
          },
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "訂單ID"
          }
        ],
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "請求錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        }
      },
      "patch": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "修改訂單(平台)",
        "description": "透過平台修改訂單\n\n**PATCH** `/v1/platforms/:platformId/orders/:orderId`\n\n| 參數 | 類型 | 說明 |\n| --- | --- | --- |\n| amount | Number | 修改後的訂單金額 |",
        "operationId": "patchOrderByPlatform",
        "parameters": [
          {
            "name": "platformId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "平台代碼 (如: dotdot, ubereats, foodpanda 等)"
          },
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "訂單ID"
          }
        ],
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "請求錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "integer",
                    "example": 250
                  }
                }
              },
              "example": {
                "amount": 250
              }
            }
          }
        }
      }
    },
