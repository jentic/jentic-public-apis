    "/v1/shops/{shopId}/carts/{cartId}/customer-carts/{customerCartId}/token": {
      "post": {
        "tags": [
          "購物車APIs"
        ],
        "summary": "重新取得FirestoreToken",
        "description": "這個 API 讓客戶可以將商品加入到購物車裡。\n\n| 參數名稱                   | 必要性 | 資料型態 | 說明         |\n|------------------------|-----|------|------------|\n| productId              | 是   | 整數   | 商品 ID      |\n| title                  | 否   | 字串   | 商品名稱       |\n| price                  | 否   | 浮點數  | 商品價格       |\n| quantity               | 是   | 整數   | 商品數量       |\n| selectedModifierGroups | 否   | 陣列   | 陣列中包含客製化選項 |\n\n\nselectedModifierGroups 內的客製化選項屬性：\n\n| 參數名稱                    | 必要性 | 資料型態 | 說明          |\n|-------------------------|-----|------|-------------|\n| title                   | 是   | 字串   | 選項名稱        |\n| id                      | 是   | 整數   | 選項 ID       |\n| externalId              | 否   | 字串   | 選項的外部 ID    |\n| selectedModifierOptions | 否   | 陣列   | 選項裡選擇的客製化選項 |\n\nselectedModifierOptions 內的客製化選項屬性：\n\n| 參數名稱       | 必要性 | 資料型態 | 說明       |\n|------------|-----|------|----------|\n| title      | 否   | 字串   | 選項名稱     |\n| id         | 是   | 整數   | 選項 ID    |\n| externalId | 否   | 字串   | 選項的外部 ID |\n| price      | 否   | 浮點數  | 選項價格     |",
        "operationId": "refreshFirestoreToken",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          },
          {
            "name": "cartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "購物車ID"
          },
          {
            "name": "customerCartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "團員購物車ID"
          }
        ],
        "responses": {
          "200": {
            "description": "重新取得FirestoreToken",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "customerToken": {
                      "type": "string",
                      "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..Ima7xEvpAUZrgey97ZJBdjivq9ae5XzIV704RabPBOyhJEnbzfrNrRFz-nBuI1yTPik9l23V87T0C0PtSLTZf2AaU5CcuUKDfF4R4GHBSYJDhk1nW96CfQFrZM6WEdLh3CmZvaGWo2sKmsB3NX6ZwEaf3ny-e-C6-Rj6rn5ahs0XY9-PLacjGCz4KfRINswgbeD5ldVKRS4dgzDuaghihJo5i9I2Af26rz0-vaSwOP9v6kVp5t4tLWPbqRIy1YuMYjuWsBiZbT2daoaKXWQIuVnG30DUYA-u607eJ1pOvDd_73HC4ciz4EOf3MBAyW6gALw7Tlbp0LXDMcXMcaZ02w"
                    },
                    "tokenExpiredTs": {
                      "type": "integer",
                      "example": 1681835371
                    }
                  }
                },
                "example": {
                  "customerToken": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..Ima7xEvpAUZrgey97ZJBdjivq9ae5XzIV704RabPBOyhJEnbzfrNrRFz-nBuI1yTPik9l23V87T0C0PtSLTZf2AaU5CcuUKDfF4R4GHBSYJDhk1nW96CfQFrZM6WEdLh3CmZvaGWo2sKmsB3NX6ZwEaf3ny-e-C6-Rj6rn5ahs0XY9-PLacjGCz4KfRINswgbeD5ldVKRS4dgzDuaghihJo5i9I2Af26rz0-vaSwOP9v6kVp5t4tLWPbqRIy1YuMYjuWsBiZbT2daoaKXWQIuVnG30DUYA-u607eJ1pOvDd_73HC4ciz4EOf3MBAyW6gALw7Tlbp0LXDMcXMcaZ02w",
                  "tokenExpiredTs": 1681835371
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customerToken": {
                    "type": "string",
                    "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..E4xn8A4Wcm8eHXXNAJ3LvW5AkzFEtZWTRzM9ED6LZ1386KVwomjBi0kyT6i_fWSlsTHvGkOpw_PrU2j17ZnXhH9RFDBrAoPpibIXaOO3H9pxooXA52t-TzhTOqmU-UvTWVQ50TkqvR5MgmwFevXA97j5MD6jK3EPdxSHwSNnbUZ_eZ-bd_LgsgMO4gAk0vrig7BZ4bz8SOtS1ujfOl5SxoZtA17NEp7U5FLLcrhwSO_eAT5CqWgUKmbk1WfHhFr3pX32ilB7Uxy5HdzebtGyYwpUBpgaKQPwP89x9OKxndJmRQbyhrkDeLOof-bVLUvWkvRwcw80_hf4qxN-E4hh-Q"
                  },
                  "customerId": {
                    "type": "string",
                    "example": "c35cb438-5c74-5616-ac45-6c5db9de7fcc"
                  }
                }
              },
              "example": {
                "customerToken": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..E4xn8A4Wcm8eHXXNAJ3LvW5AkzFEtZWTRzM9ED6LZ1386KVwomjBi0kyT6i_fWSlsTHvGkOpw_PrU2j17ZnXhH9RFDBrAoPpibIXaOO3H9pxooXA52t-TzhTOqmU-UvTWVQ50TkqvR5MgmwFevXA97j5MD6jK3EPdxSHwSNnbUZ_eZ-bd_LgsgMO4gAk0vrig7BZ4bz8SOtS1ujfOl5SxoZtA17NEp7U5FLLcrhwSO_eAT5CqWgUKmbk1WfHhFr3pX32ilB7Uxy5HdzebtGyYwpUBpgaKQPwP89x9OKxndJmRQbyhrkDeLOof-bVLUvWkvRwcw80_hf4qxN-E4hh-Q",
                "customerId": "c35cb438-5c74-5616-ac45-6c5db9de7fcc"
              }
            }
          }
        }
      }
    },
    "/v1/shops/{shopId}/carts/{cartId}/order-payload": {
      "get": {
        "tags": [
          "購物車APIs"
        ],
        "summary": "取得購物車內容 by cartId （訂單資訊顯示用）",
        "description": "只有團主可以用",
        "operationId": "getCartOrderPayload",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          },
          {
            "name": "cartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "購物車ID"
          }
        ],
        "responses": {
          "200": {
            "description": "取得購物車內容 by cartId （訂單資訊顯示用）",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "amount": {
                      "type": "integer",
                      "example": 90
                    },
                    "carts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 74907
                          },
                          "quantity": {
                            "type": "integer",
                            "example": 1
                          },
                          "price": {
                            "type": "integer",
                            "example": 10
                          },
                          "title": {
                            "type": "string",
                            "example": "火腿吐司"
                          },
                          "eater": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "example": ""
                              },
                              "name": {
                                "type": "string",
                                "example": ""
                              }
                            }
                          },
                          "priceDetail": {
                            "type": "object",
                            "properties": {
                              "total": {
                                "type": "object",
                                "properties": {
                                  "amount": {
                                    "type": "integer",
                                    "example": 100
                                  }
                                }
                              }
                            }
                          },
                          "selectedModifierGroups": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "example": 4708
                                },
                                "title": {
                                  "type": "string",
                                  "example": "飲料選擇"
                                },
                                "selectedModifierOptions": {
                                  "type": "array",
                                  "items": {
                                    "type": "object"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "customerCarts": {
