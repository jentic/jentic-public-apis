    "/v1/shops/{shopId}/carts/{cartId}/customer-carts/{customerCartId}": {
      "get": {
        "tags": [
          "購物車APIs"
        ],
        "summary": "取得購物車內容",
        "description": "此 API 可以取得指定購物車的內容，包括購物車資訊、商品資訊、客戶購物車資訊等。\n\n參數：\n\n| 參數名稱   | 資料型態 | 必填 | 描述     |\n|--------|------|----|--------|\n| shopId | 字串   | 是  | 商店 ID  |\n| cartId | 字串   | 是  | 購物車 ID |\n\n當請求成功時，此 API 會回應一個包含購物車內容的物件，包括以下欄位：\n\n| 回傳欄位名稱                  | 資料型態 | 描述        |\n|-------------------------|------|-----------|\n| cartId                  | 字串   | 購物車 ID    |\n| cartOwnerId             | 字串   | 購物車擁有者 ID |\n| customerId              | 字串   | 客戶 ID     |\n| cartType                | 字串   | 購物車類型     |\n| cartStatus                | 字串   | 購物車狀態      cart_ordering ｜ cart_abandoned ｜cart_completed ｜ order_created\n| closeTs                 | 整數   | 購物車關閉時間戳記 |\n| displayId               | 字串   | 顯示 ID     |\n| tableNumber             | 字串   | 桌號        |\n| user                    | 物件   | 使用者資訊     |\n| customerCarts           | 陣列   | 客戶購物車資訊   |\n| customerCarts.id                      | 整數   | 消費者購物車 ID    |\n| customerCartStatus                | 字串   | 購物車狀態      cart_ordering ｜ cart_ready \n| customerId              | 整數   | 客戶 ID     |\n| customerName            | 字串   | 客戶名稱      |\n| items                   | 陣列   | 客戶購物車商品資訊   |\n| id                      | 整數   | 商品 ID     |\n| title                   | 字串   | 商品名稱      |\n| price                   | 整數   | 商品價格      |\n| quantity                | 整數   | 商品數量      |\n| selectedModifierGroups  | 陣列   | 商品選擇的調味群組 |\n| title                   | 字串   | 調味群組名稱    |\n| id                      | 整數   | 調味群組 ID   |\n| externalId              | 字串   | 外部 ID     |\n| selectedModifierOptions | 陣列   | 商品選擇的調味選項 |\n| title                   | 字串   | 調味選項名稱    |\n| id                      | 整數   | 調味選項 ID   |",
        "operationId": "getCartContent",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          },
          {
            "name": "cartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "購物車ID"
          },
          {
            "name": "customerCartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "團員購物車ID"
          },
          {
            "name": "customerToken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "取得購物車內容",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "D_B81NJ2kdm_2lW0H954d6VaNMOH6lsn"
                    },
                    "customerCarts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "example": "customerCarts"
                          },
                          "docs": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "example": "EU10OTLdHRHQLXEAEC8s"
                                },
                                "data": {
                                  "type": "object",
                                  "properties": {
                                    "closeTs": {
                                      "type": "object"
                                    },
                                    "customerId": {
                                      "type": "object"
                                    },
                                    "cartType": {
                                      "type": "object"
                                    },
                                    "displayId": {
                                      "type": "object"
                                    },
                                    "userId": {
                                      "type": "object"
                                    },
                                    "user": {
                                      "type": "object"
                                    },
                                    "customerName": {
                                      "type": "object"
                                    },
                                    "tableNumber": {
                                      "type": "object"
                                    },
                                    "cartOwnerId": {
                                      "type": "object"
                                    },
                                    "customCartStatus": {
                                      "type": "object"
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "cartId": {
                      "type": "string",
                      "example": "D_B81NJ2kdm_2lW0H954d6VaNMOH6lsn"
                    },
                    "customerCartId": {
                      "type": "string",
                      "example": "lnny6qY0AAvfUI2dzFZv"
                    }
                  }
                },
                "example": {
                  "id": "D_B81NJ2kdm_2lW0H954d6VaNMOH6lsn",
                  "customerCarts": [
                    {
                      "name": "customerCarts",
                      "docs": [
                        {
                          "id": "EU10OTLdHRHQLXEAEC8s",
                          "data": {
                            "closeTs": 12345678,
                            "customerId": "aab3b862-5f16-51ef-b519-0aa7b119670d",
                            "cartType": "GROUP_ORDER",
                            "displayId": "29",
                            "userId": "abcd",
                            "user": {
                              "userId": "abcdefg"
                            },
                            "customerName": "",
                            "tableNumber": "A1",
                            "cartOwnerId": "userId",
                            "customCartStatus": "cart_ordering"
                          }
                        },
                        {
                          "id": "V6Hkb5MF5HK6iSThDIPj",
                          "data": {
                            "closeTs": 1679289277,
                            "customerCartStatus": "cart_ready",
                            "customerId": "19599efe-04af-5372-8cb9-a72be36f7a20",
                            "cartType": "GROUP_ORDER",
                            "items": [],
                            "user": {
                              "userId": "abcdefg"
                            },
                            "customerName": "AAAA2"
                          }
                        },
                        {
                          "id": "lnny6qY0AAvfUI2dzFZv",
                          "data": {
                            "closeTs": 12345678,
                            "customerCartStatus": "cart_ordering",
                            "customerId": "3ff47532-c092-5534-94d3-360ea709b469",
                            "cartType": "GROUP_ORDER",
                            "displayId": "29",
                            "userId": "abcd",
                            "user": {
                              "userId": "abcdefg"
