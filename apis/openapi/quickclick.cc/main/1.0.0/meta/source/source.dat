                                "type": "boolean",
                                "example": true
                              }
                            }
                          },
                          "categoryIds": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "example": 38545
                                },
                                "externalId": {
                                  "type": "string",
                                  "example": "FixuJD-PZr"
                                },
                                "priority": {
                                  "type": "integer",
                                  "example": 0
                                },
                                "productIds": {
                                  "type": "array",
                                  "items": {
                                    "type": "object"
                                  }
                                }
                              }
                            }
                          },
                          "modifierGroupIds": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "integer",
                                  "example": 129347
                                },
                                "externalId": {
                                  "type": "string",
                                  "example": "THbYnfYGtq"
                                },
                                "customId": {
                                  "type": "integer",
                                  "example": 65339
                                },
                                "priority": {
                                  "type": "integer",
                                  "example": 4
                                },
                                "constraintRules": {
                                  "type": "object",
                                  "properties": {
                                    "quantity": {
                                      "type": "object"
                                    }
                                  }
                                },
                                "modifierOptionIds": {
                                  "type": "array",
                                  "items": {
                                    "type": "object"
                                  }
                                }
                              }
                            }
                          },
                          "customId": {
                            "type": "integer",
                            "example": 65339
                          }
                        }
                      }
                    },
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "categoryId": {
                            "type": "integer",
                            "example": 38545
                          },
                          "externalId": {
                            "type": "string",
                            "example": "FixuJD-PZr"
                          },
                          "title": {
                            "type": "string",
                            "example": "主餐"
                          },
                          "productIds": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "externalId": {
                                  "type": "string",
                                  "example": "i4lwNr0ABv"
                                },
                                "id": {
                                  "type": "integer",
                                  "example": 346804
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "classes": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "example": 1
                          },
