    "/v1/shops/{shopId}/order-quotation": {
      "post": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "訂單報價(含優惠)",
        "description": "訂單報價API，計算優惠折扣與金額\n\n**POST** `/v1/shops/:shopId/order-quotation`\n\n| 參數 | 類型 | 說明 |\n| --- | --- | --- |\n| user | Object | (選填) 使用者資訊 |\n| user.uuid | String | (選填) 使用者UUID，用於查詢優惠券 |\n| order | Object | 訂單資訊 |\n| order.amount | Number | (選填) 訂單金額，未提供時自動計算 |\n| order.carts | Array | 購物車品項 |\n| order.discounts | Array | (選填) 已套用的外部折扣 |\n| partnerOrderId | String | (選填) 合作夥伴訂單ID |",
        "operationId": "orderQuotation",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "訂單報價(含優惠)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "amount": {
                      "type": "integer",
                      "example": 320
                    },
                    "discounts": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "promotions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                },
                "example": {
                  "amount": 320,
                  "discounts": [],
                  "promotions": []
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user": {
                    "type": "object",
                    "properties": {
                      "uuid": {
                        "type": "string",
                        "example": "user-uuid-001"
                      }
                    }
                  },
                  "order": {
                    "type": "object",
                    "properties": {
                      "carts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "example": "P001"
                            },
                            "title": {
                              "type": "string",
                              "example": "招牌便當"
                            },
                            "price": {
                              "type": "integer",
                              "example": 100
                            },
                            "quantity": {
                              "type": "integer",
                              "example": 2
                            }
                          }
                        }
                      },
                      "discounts": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    }
                  },
                  "partnerOrderId": {
                    "type": "string",
                    "example": "PARTNER-001"
                  }
                }
              },
              "example": {
                "user": {
                  "uuid": "user-uuid-001"
                },
                "order": {
                  "carts": [
                    {
                      "id": "P001",
                      "title": "招牌便當",
                      "price": 100,
                      "quantity": 2
                    },
                    {
                      "id": "P002",
                      "title": "排骨飯",
                      "price": 120,
                      "quantity": 1
                    }
                  ],
                  "discounts": []
                },
                "partnerOrderId": "PARTNER-001"
              }
            }
          }
        }
      }
    },
    "/v1/shops/{shopId}/order-quote": {
      "post": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "訂單報價(別名)",
        "description": "訂單報價API (order-quotation 的別名)\n\n**POST** `/v1/shops/:shopId/order-quote`\n\n參數與回應格式同 訂單報價(含優惠)",
        "operationId": "orderQuote",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "請求錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "order": {
                    "type": "object",
                    "properties": {
                      "carts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "example": "P001"
                            },
                            "title": {
                              "type": "string",
                              "example": "招牌便當"
                            },
                            "price": {
                              "type": "integer",
                              "example": 100
                            },
                            "quantity": {
                              "type": "integer",
                              "example": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "order": {
                  "carts": [
                    {
                      "id": "P001",
                      "title": "招牌便當",
                      "price": 100,
                      "quantity": 1
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/shops/{shopId}/orders": {
      "post": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "建立訂單",
        "description": "透過此API，可以建立訂單。\n\n## 即時建立訂單\n\ncode: \"counter\"\n\n透過此API建立快一點訂單，系統會卡控商品ID、對應出單、發送通知Webhook，並記錄於快一點報表。\n\n(可切換Example Request，查看「建立訂單」範例）\n\ncode: \"kiosk\"\n\n如果是透過kiosk建立訂單，會控制出單邏輯\n\n## Request Body:\n\n| 欄位名稱 | 是否必填 | 資料型態 | 說明 |\n| --- | --- | --- | --- |\n| tableNumber | 否 | string | 餐桌號碼，桌號，如不適用請傳入空字串或 null。 |\n| amount | 是 | integer | 訂單金額 |\n| points | 否 | point\\[\\] | 點數折抵，以array型態傳遞 |\n| tickets | 否 | ticket\\[\\] | 優惠券兌換，以array型態傳遞 |\n| cartDetail | 否 | object | 購物車資訊，包含\"cartId\"和\"type\"欄位 |\n| discounts | 否 | discount | 優惠項目 |\n| pickupTs | 是 | integer | 消費者預期取餐時間(Unix 時間戳記) |\n| driverPickupTs | 否 | integer | 如果有採用第三方外送服務(e.g., lalamove)，此為外送員取餐時間 |\n| mealType | 是 | string | 用餐方式：eat_in 內用, to_go 自取, takeaway 外帶, delivery 外送 |\n| paymentType | 是 | string | 付款方式：cash, multiple, qrpay_credit, qrpay_line, qrpay_google, qrpay_apple, qrpay_easywallet |\n| payment | 是 | object | 付款狀態，包含\"status\"欄位，值可為\"pending\"、\"success\"、\"failed\"等 |\n| distributorCode | 否 | string | 特定合作夥伴店家代碼 |\n| carts | 是 | cart\\[\\] | 餐點清單，包含以下欄位：id、quantity、price、title、eater、modifiers |\n| orderInstructions | 否 | object | 訂單的備註與整單加購，包含\"specialInstructions\"和\"selectedModifierGroups\"欄位 |\n| clientOptions | 是 | object | 呼叫客戶端選項，包含\"code\"、\"templateId\"和\"templateOptions\"欄位 |\n| user | 否 | user | 用戶資訊 |\n\n**user欄位說明**\n\n| 欄位名稱 | 是否必填 | 資料型態 | 說明 |\n| --- | --- | --- | --- |\n| id | 否 | 數字 | 用戶 ID |\n| userId | 否 | 字串 | 用戶識別碼 |\n| name | 是 | 字串 | 用戶姓名 |\n| phone | 否 | 字串 | 用戶電話 |\n| address | 否 | 字串 | 用戶地址 |\n| taxId | 否 | 字串 | 用戶統編 |\n| carrierId | 否 | 字串 | 載具 ID |\n\n**carts陣列裡的每一個物件都包含以下欄位：**\n\n| 欄位名稱 | 是否必填 | 資料型態 | 說明 |\n| --- | --- | --- | --- |\n| id | 是 | Integer | 商品編號 |\n| quantity | 是 | Integer | 商品數量 |\n| price | 是 | Integer | 商品價格 |\n| title | 是 | String | 商品名稱 |\n| eater | 否 | Object | 商品客製化選項 |\n| selectedModifierGroups | 否 | Array | 商品客製化群組 |\n\n若有客製化群組，則每一個selectedModifierGroups陣列裡的物件都包含以下欄位：\n\n| 欄位名稱 | 是否必填 | 資料型態 | 說明 |\n| --- | --- | --- | --- |\n| id | 是 | Integer | 客製化群組編號 |\n| title | 是 | String | 客製化群組名稱 |\n| selectedModifierOptions | 是 | Array | 客製化群組選項 |\n\n若有客製化群組選項，則每一個selectedModifierOptions陣列裡的物件都包含以下欄位：\n\n| 欄位名稱 | 是否必填 | 資料型態 | 說明 |\n| --- | --- | --- | --- |\n| id | 是 | Integer | 客製化群組選項編號 |\n| price | 是 | Integer | 客製化群組選項價格 |\n| title | 是 | String | 客製化群組選項名稱 |\n| selectedModifierGroups | 否 | Array | 客製化群組選項客製化群組 |\n\ndiscounts\n\n| 欄位名稱 | 是否必填 | 資料型態 | 說明 |\n| --- | --- | --- | --- |\n| amount | 是 | 數字 | 此折扣金額 |\n| name | 是 | 字串 | 折扣名稱 |\n| type | 是 | 字串 | 折扣類型，可為 COUNTER_DISCOUNT(整筆訂單折扣) 或 ITEM_DISCOUNT(單一品項折扣) |\n\npoints\n\n| 欄位名稱 | 是否必填 | 資料型態 | 說明 |\n| --- | --- | --- | --- |\n| pointCode | 是 | string | 代表此成分點數的代碼 |\n| uuid | 是 | string | 此成分點數對應的 uuid |\n| pointName | 是 | string | 代表此成分點數的名稱 |\n| amount | 是 | int | 此成分點數的折抵金額 |\n\ndeliveryOptions\n\n| 欄位名稱 | 是否必填 | 資料型態 | 說明 |\n| --- | --- | --- | --- |\n| mode | 是 | 字串 | 配送模式，可為 \"auto\" 或 \"manual\" |\n| quoteFee.amount | 否 | 浮點數 | 配送費用金額 |\n| quoteFee.currency | 否 | 字串 | 貨幣種類 |\n| shopCoveredFee.amount | 否 | 浮點數 | 商家承擔的配送費用金額 |\n| shopCoveredFee.currency | 否 | 字串 | 貨幣種類 |\n| comment | 否 | 字串 | 訂單備註 |\n| riderPickupTs | 否 | 整數 | 外送員取餐時間 (Unix 時間戳) |\n| deliveryMinutes | 否 | 整數 | 配送時間 (單位：分鐘) |\n\norderInstructions\n\n| 欄位名稱 | 是否必填 | 資料型態 | 說明 |\n| --- | --- | --- | --- |\n| selectedModifierGroups.id | 否 | 整數 | 選定的商品修飾組 ID |\n| selectedModifierGroups.title | 否 | 字串 | 選定的商品修飾組名稱 |\n| selectedModifierGroups.selectedModifierOptions.id | 否 | 整數 | 選定的商品修飾選項 ID |\n| selectedModifierGroups.selectedModifierOptions.price | 否 | 浮點數 | 選定的商品修飾選項價格 |\n| selectedModifierGroups.selectedModifierOptions.title | 否 | 字串 | 選定的商品修飾選項名稱 |\n| specialInstructions | 否 | 字串 | 訂單備註 |\n\nclientOptions\n\n| 欄位名稱 | 是否必填 | 資料型態 | 說明 |\n| --- | --- | --- | --- |\n| code | 是 | 字串 | 決定送單類型，例如 ubereats、foodpanda 或 counter。 |\n| templateId | 否 | 字串 | 決定客製化樣板。 |\n| templateOptions | 否 | 物件 | 新增客製化樣板相關參數。 |\n\npayment\n\n| 欄位名稱 | 是否必填 | 資料型態 | 說明 |\n| --- | --- | --- | --- |\n| status | 是 | 字串 | 支付狀態，值可以為 pending 或 success，表示待付款或已付款。 |\n\nclientOption欄位說明\n\n| 欄位名稱 | 是否必填 | 資料格式 | 說明 |\n| --- | --- | --- | --- |\n| code | 是 | 字串 | 呼叫端代碼，上傳明細代碼為：\"report\"，櫃檯點餐代碼為：\"counter\"，Kiosk: \"kiosk\" |\n| templateId | 否 | 數字 | 用戶端範本 ID |\n| templateOptions | 否 | 物件 | 用戶端範本選項設 |",
        "operationId": "createOrder",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "建立訂單",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orderId": {
                      "type": "string",
                      "example": "0000001925"
                    },
                    "orderNumber": {
                      "type": "string",
                      "example": "1"
                    }
                  }
                },
                "example": {
                  "orderId": "0000001925",
                  "orderNumber": "1"
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          },
          "500": {
            "description": "建立訂單",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Unknown Product ID for [undefined] undefined"
                        },
                        "code": {
                          "type": "string",
                          "example": "QC_CREATE_ORDER_FAILED"
                        },
                        "devMessage": {
                          "type": "string",
                          "example": "Error: Unknown Product ID for [undefined] undefined\n    at /home/service/Sites/qc-pos-middleware/package/src/core/orders.js:1619:19\n    at /home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:1249:26\n    at _fulfilled (/home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:854:54)\n    at /home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:883:30\n    at Promise.promise.promiseDispatch (/home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:816:13)\n    at /home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:570:49\n    at runSingle (/home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:137:13)\n    at flush (/home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:125:13)\n    at processTicksAndRejections (node:internal/process/task_queues:78:11)"
                        },
                        "name": {
                          "type": "string",
                          "example": "Error"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "error": {
                    "message": "Unknown Product ID for [undefined] undefined",
                    "code": "QC_CREATE_ORDER_FAILED",
                    "devMessage": "Error: Unknown Product ID for [undefined] undefined\n    at /home/service/Sites/qc-pos-middleware/package/src/core/orders.js:1619:19\n    at /home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:1249:26\n    at _fulfilled (/home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:854:54)\n    at /home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:883:30\n    at Promise.promise.promiseDispatch (/home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:816:13)\n    at /home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:570:49\n    at runSingle (/home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:137:13)\n    at flush (/home/service/Sites/qc-pos-middleware/package/node_modules/q/q.js:125:13)\n    at processTicksAndRejections (node:internal/process/task_queues:78:11)",
                    "name": "Error"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "integer",
                    "example": 100
                  },
                  "pickupTs": {
                    "type": "integer",
                    "example": 1739677300
                  },
                  "mealType": {
                    "type": "string",
                    "example": "takeaway"
                  },
                  "paymentType": {
                    "type": "string",
                    "example": "cash"
                  },
                  "payment": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string",
                        "example": "pending"
                      }
                    }
                  },
                  "carts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 1600221
                        },
                        "quantity": {
                          "type": "integer",
                          "example": 1
                        },
                        "price": {
                          "type": "integer",
                          "example": 100
                        },
                        "title": {
                          "type": "string",
                          "example": "示範商品"
                        },
                        "eater": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "example": ""
                            },
                            "name": {
                              "type": "string",
                              "example": ""
                            }
                          }
                        }
                      }
                    }
                  },
                  "clientOptions": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "example": "counter"
                      },
                      "templateId": {
                        "type": "string",
                        "example": ""
                      },
                      "templateOptions": {
                        "type": "object",
                        "properties": {
                          "someKey": {
                            "type": "string",
                            "example": "someValue"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "amount": 100,
                "pickupTs": 1739677300,
                "mealType": "takeaway",
                "paymentType": "cash",
                "payment": {
                  "status": "pending"
                },
                "carts": [
                  {
                    "id": 1600221,
                    "quantity": 1,
                    "price": 100,
                    "title": "示範商品",
                    "eater": {
                      "id": "",
                      "name": ""
                    }
                  }
                ],
                "clientOptions": {
                  "code": "counter",
                  "templateId": "",
                  "templateOptions": {
                    "someKey": "someValue"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/shops/{shopId}/posdvr": {
      "get": {
        "tags": [
          "商店APIs"
        ],
        "summary": "取得POS DVR設定",
        "description": "取得商店POS DVR監視器設定\n\n**GET** `/v1/shops/:shopId/posdvr`\n\n回傳DVR連線設定，包含IP、帳號、密碼、頻道等資訊",
        "operationId": "getPosDvr",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "取得POS DVR設定",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ip": {
                      "type": "string",
                      "example": "172.19.1.168"
                    },
                    "account": {
                      "type": "string",
                      "example": "admin"
                    },
                    "password": {
                      "type": "string",
                      "example": "admin"
                    },
                    "channel": {
                      "type": "string",
                      "example": "1"
                    },
                    "enabled": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                },
                "examples": {
                  "example1": {
                    "summary": "取得POS DVR設定",
                    "value": {
                      "ip": "172.19.1.168",
                      "account": "admin",
                      "password": "admin",
                      "channel": "1",
                      "enabled": true
                    }
                  },
                  "example2": {
                    "summary": "無DVR設定",
                    "value": {
                      "enabled": false
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        }
      }
    },
    "/v1/shops/{shopId}/product-search": {
      "post": {
        "tags": [
          "菜單APIs"
        ],
        "summary": "搜尋商品",
        "description": "透過外部ID搜尋商品\n\n**POST** `/v1/shops/:shopId/product-search`\n\n| 參數 | 類型 | 說明 |\n| --- | --- | --- |\n| externalIds | Array | 商品外部ID陣列 |\n| menuId | Number | (選填) 菜單ID，用於過濾 |\n\n注意：此API僅限system權限使用",
        "operationId": "searchProducts",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "搜尋商品",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "example": 1001
                      },
                      "externalId": {
                        "type": "string",
                        "example": "P001"
                      },
                      "name": {
                        "type": "string",
                        "example": "招牌便當"
                      },
                      "price": {
                        "type": "integer",
                        "example": 100
                      }
                    }
                  }
                },
                "example": [
                  {
                    "id": 1001,
                    "externalId": "P001",
                    "name": "招牌便當",
                    "price": 100
                  },
                  {
                    "id": 1002,
                    "externalId": "P002",
                    "name": "排骨飯",
                    "price": 120
                  }
                ]
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "externalIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "example": "P001"
                    }
                  },
                  "menuId": {
                    "type": "integer",
                    "example": 28654
                  }
                }
              },
              "example": {
                "externalIds": [
                  "P001",
                  "P002"
                ],
                "menuId": 28654
              }
            }
          }
        }
      }
    },
    "/v1/shops/{shopId}/products/{productId}": {
      "patch": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "Update Product Status",
        "description": "更新商品上下架狀態\n\n**PATCH** `/v1/shops/:shopId/products/:productId`\n\n| 參數 | 類型 | 說明 |\n| --- | --- | --- |\n| sale | Boolean | 是否上架 (true=上架, false=下架) |",
        "operationId": "updateProductStatus",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          },
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商品ID"
          }
        ],
        "responses": {
          "200": {
            "description": "更新商品上架",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sale": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                },
                "examples": {
                  "example1": {
                    "summary": "更新商品上架",
                    "value": {
                      "sale": true
                    }
                  },
                  "example2": {
                    "summary": "更新商品下架",
                    "value": {
                      "sale": false
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sale": {
                    "type": "boolean",
                    "example": true
                  }
                }
              },
              "example": {
                "sale": true
              }
            }
          }
        }
      }
    },
    "/v1/shops/{shopId}/settings": {
      "get": {
        "tags": [
          "商店APIs"
        ],
        "summary": "取得商店設定",
        "description": "回傳QC訂單平台上各種設定\n\n未來可透過指定apps filter回傳資訊",
        "operationId": "getShopSettings",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          },
          {
            "name": "apps",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "quickclick,counter"
          }
        ],
        "responses": {
          "200": {
            "description": "取得商店設定",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "emenu": {
                      "type": "object",
                      "properties": {}
                    },
                    "counter": {
                      "type": "object",
                      "properties": {
                        "menu": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 8032
                            }
                          }
                        },
                        "tables": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "platforms": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "string",
                                "example": "dudoo"
                              }
                            }
                          }
                        },
                        "mealTypes": {
                          "type": "object",
                          "properties": {
                            "delivery": {
                              "type": "object",
                              "properties": {
                                "enabled": {
                                  "type": "integer",
                                  "example": 1
                                }
                              }
                            },
                            "toGo": {
                              "type": "object",
                              "properties": {
                                "enabled": {
                                  "type": "integer",
                                  "example": 1
                                }
                              }
                            },
                            "eatIn": {
                              "type": "object",
                              "properties": {
                                "enabled": {
                                  "type": "integer",
                                  "example": 1
                                }
                              }
                            }
                          }
                        },
                        "paymentTypes": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "carryMethod": {
                          "type": "string",
                          "example": "round"
                        },
                        "isDdcInvoice": {
                          "type": "object",
                          "properties": {
                            "enabled": {
                              "type": "integer",
                              "example": 0
                            },
                            "platforms": {
                              "type": "object",
                              "properties": {
                                "quickclick": {
                                  "type": "integer",
                                  "example": 1
                                },
                                "quickprint": {
                                  "type": "integer",
                                  "example": 1
                                },
                                "counter": {
                                  "type": "integer",
                                  "example": 1
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "quickclick": {
                      "type": "object",
                      "properties": {
                        "menu": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "integer",
                              "example": 301
                            },
                            "name": {
                              "type": "string",
                              "example": "線上點餐菜單"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "emenu": {},
                  "counter": {
                    "menu": {
                      "id": 8032
                    },
                    "tables": [],
                    "platforms": [
                      {
                        "code": "dudoo"
                      }
                    ],
                    "mealTypes": {
                      "delivery": {
                        "enabled": 1
                      },
                      "toGo": {
                        "enabled": 1
                      },
                      "eatIn": {
                        "enabled": 1
                      }
                    },
                    "paymentTypes": [],
                    "carryMethod": "round",
                    "isDdcInvoice": {
                      "enabled": 0,
                      "platforms": {
                        "quickclick": 1,
                        "quickprint": 1,
                        "counter": 1
                      }
                    }
                  },
                  "quickclick": {
                    "menu": {
                      "id": 301,
                      "name": "線上點餐菜單"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        }
      }
    },
    "/v1/shops/{shopId}/status": {
      "get": {
        "tags": [
          "商店APIs"
