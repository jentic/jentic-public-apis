                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "example": "printByShop"
                    },
                    "printers": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                },
                "example": {
                  "mode": "printByShop",
                  "printers": []
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        }
      }
    },
    "/v1/platforms/{platformId}/shops/{shopId}/order-quotation": {
      "post": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "訂單報價(平台)",
        "description": "透過平台進行訂單報價\n\n**POST** `/v1/platforms/:platformId/shops/:shopId/order-quotation`\n\n參數與回應格式同 訂單報價(含優惠)",
        "operationId": "orderQuotationByPlatform",
        "parameters": [
          {
            "name": "platformId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "平台代碼 (如: dotdot, ubereats, foodpanda 等)"
          },
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "請求錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "order": {
                    "type": "object",
                    "properties": {
                      "carts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "example": "P001"
                            },
                            "title": {
                              "type": "string",
                              "example": "招牌便當"
                            },
                            "price": {
                              "type": "integer",
                              "example": 100
                            },
                            "quantity": {
                              "type": "integer",
                              "example": 1
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "order": {
                  "carts": [
                    {
                      "id": "P001",
                      "title": "招牌便當",
                      "price": 100,
                      "quantity": 1
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/platforms/{platformId}/shops/{shopId}/orders": {
      "post": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "建立訂單(平台)",
        "description": "透過平台建立訂單\n\n**POST** `/v1/platforms/:platformId/shops/:shopId/orders`\n\n參數與回應格式同 建立訂單，但增加平台參數",
        "operationId": "createOrderByPlatform",
        "parameters": [
          {
            "name": "platformId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "平台代碼 (如: dotdot, ubereats, foodpanda 等)"
          },
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "建立訂單(平台)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "orderId": {
                      "type": "string",
                      "example": "0000001300"
                    },
                    "orderNumber": {
                      "type": "string",
                      "example": "001"
                    }
                  }
                },
                "example": {
                  "orderId": "0000001300",
                  "orderNumber": "001"
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mealType": {
                    "type": "string",
                    "example": "takeaway"
                  },
                  "carts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "example": "P001"
                        },
                        "title": {
                          "type": "string",
                          "example": "招牌便當"
                        },
                        "price": {
                          "type": "integer",
                          "example": 100
                        },
                        "quantity": {
                          "type": "integer",
                          "example": 1
                        }
                      }
                    }
                  },
                  "amount": {
                    "type": "integer",
                    "example": 100
                  },
                  "paymentType": {
                    "type": "string",
                    "example": "cash"
                  },
                  "user": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "example": "王小明"
                      },
                      "phone": {
                        "type": "string",
                        "example": "0912345678"
                      }
                    }
                  }
                }
              },
              "example": {
                "mealType": "takeaway",
                "carts": [
                  {
                    "id": "P001",
                    "title": "招牌便當",
                    "price": 100,
                    "quantity": 1
                  }
                ],
                "amount": 100,
                "paymentType": "cash",
                "user": {
                  "name": "王小明",
                  "phone": "0912345678"
                }
              }
            }
          }
        }
      }
    },
