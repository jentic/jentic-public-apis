    "/v1/shops/{shopId}/carts/{cartId}/submit": {
      "post": {
        "tags": [
          "購物車APIs"
        ],
        "summary": "送單給廚房",
        "description": "",
        "operationId": "submitToKitchen",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          },
          {
            "name": "cartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "購物車ID"
          }
        ],
        "responses": {
          "200": {
            "description": "成功"
          },
          "400": {
            "description": "請求錯誤",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customerToken": {
                    "type": "string",
                    "example": ""
                  },
                  "customerId": {
                    "type": "string",
                    "example": ""
                  }
                }
              },
              "example": {
                "customerToken": "",
                "customerId": ""
              }
            }
          }
        }
      }
    },
