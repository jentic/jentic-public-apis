      "patch": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "修改訂單",
        "description": "更新訂單\n\n## 更新會員資訊\n\n**user欄位說明**\n\n| 欄位名稱 | 是否必填 | 資料型態 | 說明 |\n| --- | --- | --- | --- |\n| id | 否 | 數字 | 用戶 ID |\n| userId | 否 | 字串 | 用戶識別碼 |\n| name | 是 | 字串 | 用戶姓名 |\n| phone | 否 | 字串 | 用戶電話 |\n| address | 否 | 字串 | 用戶地址 |\n| taxId | 否 | 字串 | 用戶統編 |\n| carrierId | 否 | 字串 | 載具 ID |\n\n## 更新金額\n\n金額部分特別注意，僅供帳務對帳用  \n**(特別注意，不會實際調整金流）**\n\n``` json\n{\n    \"amount\": 90, // 欲調整之訂單金額\n    \"comments\": { // 關於此筆調整的相關紀錄\n        \"storeComments\": \"\",\n        \"systemLogs\": \"操作人：TEST\"\n    }\n}\n\n ```",
        "operationId": "patchOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "訂單ID"
          }
        ],
        "responses": {
          "200": {
            "description": "修改訂單"
          },
          "401": {
            "description": "認證失敗"
          }
        }
      }
    },
    "/v1/orders/{orderId}/accept": {
      "post": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "接收訂單",
        "description": "當接單模式為手動接單時，需要呼叫此API來確認接單",
        "operationId": "acceptOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "訂單ID"
          }
        ],
        "responses": {
          "200": {
            "description": "接收訂單成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                },
                "example": {}
              }
            }
          },
          "400": {
            "description": "訂單已接受",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Cannot accept the order. The order is already accepted"
                        },
                        "code": {
                          "type": "string",
                          "example": "ORDER_IS_ACCEPTED"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "example1": {
                    "summary": "訂單已接受",
                    "value": {
                      "error": {
                        "message": "Cannot accept the order. The order is already accepted",
                        "code": "ORDER_IS_ACCEPTED"
                      }
                    }
                  },
                  "example2": {
                    "summary": "訂單狀態錯誤",
                    "value": {
                      "error": {
                        "message": "Cannot accept the order. The order status is done"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        }
      }
    },
    "/v1/orders/{orderId}/cancel": {
      "post": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "取消訂單",
        "description": "1. 已經接單的訂單可透過此API進行取消(尚未接單的只能拒絕接單)\n2. 如果物流處於媒合中狀態，會禁止取消(因為空車費用會造成店家損失)\n3. 如果物流完成，可以允許取消，因代表有客訴問題，物流費用由店家承擔。\n    \n\n取消成功範例\n\n```\n{\n  \"message\": \"訂單0000035698（流水號「121」）已取消\",\n  \"success\": true\n}\n\n```\n\n取消失敗範例\n\n```\n{\n {\n    \"success\": false,\n    \"error\": {\n        \"message\": \"無法取消訂單\"\n    }\n}\n\n```",
        "operationId": "cancelOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "訂單ID"
          }
        ],
        "responses": {
          "200": {
            "description": "取消訂單成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                },
                "example": {
                  "success": true
                }
              }
            }
          },
          "400": {
            "description": "取消訂單失敗",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Cannot cancel the order"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "success": false,
                  "error": {
                    "message": "Cannot cancel the order"
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "example": "店家忙碌中"
                  }
                }
              },
              "example": {
                "reason": "店家忙碌中"
              }
            }
          }
        }
      }
    },
    "/v1/orders/{orderId}/complete": {
      "post": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "完成訂單",
        "description": "當接單模式為手動接單時，需要呼叫此API來確認接單",
        "operationId": "completeOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "訂單ID"
          }
        ],
        "responses": {
          "200": {
            "description": "完成訂單成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                },
                "example": {}
              }
            }
          },
          "400": {
            "description": "訂單已完成",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Cannot complete the order. The order is already marked as completed/done."
                        },
                        "code": {
                          "type": "string",
                          "example": "ORDER_IS_COMPLETED"
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "example1": {
                    "summary": "訂單已完成",
                    "value": {
                      "error": {
                        "message": "Cannot complete the order. The order is already marked as completed/done.",
                        "code": "ORDER_IS_COMPLETED"
                      }
                    }
                  },
                  "example2": {
                    "summary": "訂單尚未接受",
                    "value": {
                      "error": {
                        "message": "Cannot complete the order. The order is not even accepted yet."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        }
      }
    },
    "/v1/orders/{orderId}/confirm-payment": {
      "post": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "確認收款",
        "description": "### API 欄位說明\n\n| 欄位名稱 | 欄位類型 | 是否必填 | 描述 |\n| --- | --- | --- | --- |\n| `paymentType` | string | 必填 | 支付方式，`paid_on_site` 表示櫃檯人工確認收款，`ddpay` 表示透過 DDPay 收款 |\n| `payment.status` | string | 必填 | 支付狀態，通常為 `success` 表示成功 |\n| `payment.ddpayOrderId` | string | 必填 (ddpay) | DDPay 訂單編號，當 `paymentType` 為 `ddpay` 時必填 |\n| `payment.invoice.isIssued` | boolean | 必填 | 是否已經開立發票，`true` 表示已開立 |\n| `payment.invoice.isPrinted` | boolean | 必填 | 發票是否已列印（如果無載具則列印紙本） |\n| `payment.invoice.invoiceNumber` | string | 選填 | 發票號碼，當發票已開立時填寫 |\n| `user.taxId` | string | 選填 | 統一編號，如果是公司戶發票則填寫 |\n| `user.carrierId` | string | 選填 | 載具編號，若不使用載具可不填 |\n| `receipt.isGetReceipt` | boolean | 選填 | 當不開發票時，是否需要收據，開發票時無效 |\n| `receipt.carrierType` | string | 選填 | 載具類型，空白代表不用載具，`mobile` 代表手機載具，`member` 代表會員載具 |\n\n### 操作說明\n\n- 若商家與顧客透過線下手段完成收款（如現金或其它實體交易），應使用 `paymentType: \"paid_on_site\"` 來進行 API 呼叫。\n    \n- 若使用 DDPay 完成收款，第三方應於收到 DDPay 付款完成通知後，發起此「確認收款」API，並提供 `ddpayOrderId`，以利快一點系統取得對應的 DDPay 交易詳細資訊。\n    \n\n### Payload 範例\n\n``` json\n{\n    \"paymentType\": \"ddpay\",\n    \"payment\": {\n        \"status\": \"success\",\n        \"ddpayOrderId\": \"23120916272945Xxfr\",\n        \"invoice\": {\n            \"isIssued\": true,\n            \"isPrinted\": true,\n            \"invoiceNumber\": \"AB12345678\"\n        }\n    },\n    \"user\": {\n        \"taxId\": \"88888888\",\n        \"carrierId\": \"/xXXXXXX\"\n    },\n    \"receipt\": {\n        \"isGetReceipt\": true,\n        \"carrierType\": \"mobile\"\n    }\n}\n\n ```\n\n### `paymentType` 的選項：\n\n- **`paid_on_site`**: 櫃檯人工確認收款，適用於線下收款（如現金或其它實體支付方式）。\n    \n- **`ddpay`**: 透過 DDPay 完成收款，當選擇此選項時，必須提供 `ddpayOrderId`。",
        "operationId": "confirmPayment",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "訂單ID"
          }
        ],
        "responses": {
          "200": {
            "description": "現場付款",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "string",
                      "example": "success"
                    }
                  }
                },
                "examples": {
                  "example1": {
                    "summary": "現場付款",
                    "value": {
                      "results": "success"
                    }
                  },
                  "example2": {
                    "summary": "DDPay線上支付",
                    "value": {
                      "results": "success"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "paymentType": {
                    "type": "string",
                    "example": "paid_on_site"
                  },
                  "payment": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string",
                        "example": "success"
                      },
                      "ddpayOrderId": {
                        "type": "string",
                        "example": "23120916272945Xxfr"
                      },
                      "invoice": {
                        "type": "object",
                        "properties": {
                          "isIssued": {
                            "type": "boolean",
                            "example": true
                          },
                          "isPrinted": {
                            "type": "boolean",
                            "example": true
                          },
                          "invoiceNumber": {
                            "type": "string",
                            "example": "AB12345678"
                          }
                        }
                      }
                    }
                  },
                  "user": {
                    "type": "object",
                    "properties": {
                      "taxId": {
                        "type": "string",
                        "example": "88888888"
                      },
                      "carrierId": {
                        "type": "string",
                        "example": "/xXXXXXX"
                      }
                    }
                  },
                  "receipt": {
                    "type": "object",
                    "properties": {
                      "isGetReceipt": {
                        "type": "boolean",
                        "example": true
                      },
                      "carrierType": {
                        "type": "string",
                        "example": "mobile"
                      }
                    }
                  }
                }
              },
              "example": {
                "paymentType": "paid_on_site",
                "payment": {
                  "status": "success",
                  "ddpayOrderId": "23120916272945Xxfr",
                  "invoice": {
                    "isIssued": true,
                    "isPrinted": true,
                    "invoiceNumber": "AB12345678"
                  }
                },
                "user": {
                  "taxId": "88888888",
                  "carrierId": "/xXXXXXX"
                },
                "receipt": {
                  "isGetReceipt": true,
                  "carrierType": "mobile"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders/{orderId}/delivery-status": {
      "put": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "更新訂單物流狀態（限自送）",
        "description": "當接單模式為手動接單時，需要呼叫此API來確認接單",
        "operationId": "updateDeliveryStatus",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "訂單ID"
          }
        ],
        "responses": {
          "200": {
            "description": "配送中",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                },
                "examples": {
                  "example1": {
                    "summary": "配送中",
                    "value": {}
                  },
                  "example2": {
                    "summary": "已送達",
                    "value": {}
                  }
                }
              }
            }
          },
          "400": {
            "description": "訂單尚未接受",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Cannot update delivery status of the order. The order is not even accepted yet."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "error": {
                    "message": "Cannot update delivery status of the order. The order is not even accepted yet."
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "example": "on_going"
                  }
                }
              },
              "example": {
                "status": "on_going"
              }
            }
          }
        }
      }
    },
    "/v1/orders/{orderId}/deny": {
      "post": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "拒絕接單",
        "description": "當接單模式為手動接單時，如果拒絕接單，需要呼叫此API\n\n拒單成功，回傳http status 200\n\n拒單失敗，回傳http status 500",
        "operationId": "denyOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "訂單ID"
          }
        ],
        "responses": {
          "200": {
            "description": "拒絕接單成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                },
                "example": {
                  "success": true
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "example": "食材不足"
                  }
                }
              },
              "example": {
                "reason": "食材不足"
              }
            }
          }
        }
      }
    },
    "/v1/orders/{orderId}/recheckout": {
      "post": {
        "tags": [
          "訂單APIs"
        ],
        "summary": "重新結帳",
        "description": "重新結帳API:\n\n這個API會做兩件事情\n\n1\\. 如果還有原本的訂單金流，會取消\n\n2\\. 重新結帳",
        "operationId": "recheckout",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "訂單ID"
          }
        ],
        "responses": {
          "200": {
            "description": "重新結帳",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "89GJyWwyCkoJ23189113744"
                    },
                    "payUrl": {
                      "type": "string",
                      "example": "https://pay-staging.ddc.ai/b8YL"
                    }
                  }
                },
                "example": {
                  "code": "89GJyWwyCkoJ23189113744",
                  "payUrl": "https://pay-staging.ddc.ai/b8YL"
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "paymentType": {
                    "type": "string",
                    "example": "multiple"
                  },
                  "shopId": {
                    "type": "string",
                    "example": "D_lkqMMd6Dn"
                  },
                  "payment": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "type": "string",
                        "example": "pending"
                      },
                      "ddqr": {
                        "type": "object",
                        "properties": {
                          "initiate": {
                            "type": "boolean",
                            "example": true
                          },
                          "terminalId": {
                            "type": "string",
                            "example": "GIANT01"
                          }
                        }
                      },
                      "ddtap": {
                        "type": "object",
                        "properties": {}
                      }
                    }
                  },
                  "amount": {
                    "type": "integer",
                    "example": 20
                  },
                  "carts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 147716
                        },
                        "quantity": {
                          "type": "integer",
                          "example": 1
                        },
                        "price": {
                          "type": "integer",
                          "example": 10
                        },
                        "title": {
                          "type": "string",
                          "example": "火腿吐司"
                        },
                        "eater": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string",
                              "example": ""
                            },
                            "name": {
                              "type": "string",
                              "example": ""
                            }
                          }
                        },
                        "selectedModifierGroups": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 4708
                              },
                              "title": {
                                "type": "string",
                                "example": "飲料選擇"
                              },
                              "selectedModifierOptions": {
                                "type": "array",
                                "items": {
                                  "type": "object"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "paymentType": "multiple",
                "shopId": "D_lkqMMd6Dn",
                "payment": {
                  "status": "pending",
                  "ddqr": {
                    "initiate": true,
                    "terminalId": "GIANT01"
                  },
                  "ddtap": {}
                },
                "amount": 20,
                "carts": [
                  {
                    "id": 147716,
                    "quantity": 1,
                    "price": 10,
                    "title": "火腿吐司",
                    "eater": {
                      "id": "",
                      "name": ""
                    },
                    "selectedModifierGroups": [
                      {
                        "id": 4708,
                        "title": "飲料選擇",
                        "selectedModifierOptions": [
                          {
                            "id": 25654,
                            "price": 10,
                            "quantity": 1,
                            "title": "可樂",
                            "selectedModifierGroups": [
                              {
                                "id": 4710,
                                "title": "飲料客制",
                                "selectedModifierOptions": [
                                  {
                                    "id": 25655,
                                    "price": 0,
                                    "quantity": 1,
                                    "title": "半糖"
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
