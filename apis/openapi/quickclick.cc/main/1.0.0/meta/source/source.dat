    "/v1/shops/{shopId}/cash-box": {
      "post": {
        "tags": [
          "商店APIs"
        ],
        "summary": "開啟錢箱",
        "description": "開啟錢箱。\n\n如果後台沒指定，會根據抓取到的所有商店設備進行開錢箱的動作",
        "operationId": "openCashBox",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "透過DID開啟",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "type": "string",
                      "example": "printByDid"
                    }
                  }
                },
                "examples": {
                  "example1": {
                    "summary": "透過DID開啟",
                    "value": {
                      "mode": "printByDid"
                    }
                  },
                  "example2": {
                    "summary": "透過商店印表機開啟",
                    "value": {
                      "mode": "printByShop",
                      "printers": [
                        {
                          "did": "PRINTER001"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              },
              "example": {}
            }
          }
        }
      }
    },
    "/v1/shops/{shopId}/external-ids": {
      "post": {
        "tags": [
          "菜單APIs"
        ],
        "summary": "設定商品外部ID",
        "description": "自動設定商店所有商品、分類與選項的外部ID\n\n**POST** `/v1/shops/:shopId/external-ids`\n\n此API會自動為尚未有externalId的項目產生外部ID",
        "operationId": "setExternalIds",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "設定商品外部ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                },
                "example": {}
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        }
      }
    },
    "/v1/shops/{shopId}/menus": {
      "put": {
        "tags": [
          "菜單APIs"
        ],
        "summary": "發布更新商店菜單",
        "description": "呼叫此API後，將建立菜單、商品、加值選項（將覆蓋既有菜單）\n\n```\n{\n  \"menus\": [\n    {\n      \"externalId\": \"<string>\", // 如果下訂單需要指定menu id, 會出現在這邊\n      \"title\": \"<string>\",\n      \"translations\": { // 多國語言\n        \"default\": \"zh-TW\",\n        \"zh-TW\": {\n          \"title\": \"<string>\"\n        }\n      },\n      \"categoryIds\": [ // optional, 不給就全部分類都上架\n      {\n        \"externalId\": \"<string>\",\n        \"productsIds\": [ // 有限制單一商品只能上到單一分類，但可決定特定菜單要不要上架\n          {\n            \"externalId\": \"<string>\"\n          }\n        ]\n      }]\n    }\n  ],\n  \"categories\": [ // 分類，例如：吐司類\n    {\n      \"externalId\": \"<string>\",\n      \"title\": \"<string>\",\n      \"productsIds\": [ // 有限制單一商品只能上到單一分類，但架構上先放在這邊後續較有彈性，格式也比較一致\n       {\n         \"externalId\": \"<string>\"\n       }\n      ],\n      \"translations\": { // 多國語言\n        \"zh_tw\": {\n          \"title\": \"<string>\"\n        }\n      }\n    }\n  ],\n  \"classes\": [\n    {\n      \"code\": \"<string>\", // 商品屬性代碼，分站出單使用，例如：飲料、吐司...分站出單使用\n      \"name\": \"    }\n  ],\n  \"products\": [ // 商品，例如：薯餅蛋土司\n    {\n      \"isCombo\": true, // 是否為套餐，預設 false\n      \"externalId\": \"<string>\",\n      \"title\": \"<string>\",\n      \"description\": \"<string>\",\n      \"translations\": { // 多國語言\n        \"default\": \"zh-TW\",\n        \"zh-TW\": {\n          \"title\": \"<string>\",\n          \"description\": null\n        }\n      },\n      \"price\": <number>,\n      \"sale\": \"<boolean>\",\n      \"tags\": [\n        \"<string>\"\n      ],\n      \"isRecommended\": <boolean>, // 是否推薦\n      \"dishInfo\": {\n        \"sku\": \"<string>\",  // 料號\n        \"classCode\": \"<string>\", // 商品屬性代碼，分站出單使用，例如：飲料、吐司...分站出單使用\n        \"calories\": {\n          \"displayType\": \"single_item\", // takes the value of lower_range as is (e.g. “10”)\n          \"lower_range\": <number> // 卡路里, The lower range of the energy content. \n        }\n      },\n      \"modifierGroupIds\": [ \n        {\n          \"externalId\": \"<string>\",\n          \"modifierOptionIds\": [  // optional, 如果有要特殊調整此商品要上的選項，可於此指定要上的選項ID\n             {\n               \"externalId\": \"<string>\"\n             }\n           ]\n        }\n      ]\n    }\n  ],\n  \"modifierGroups\": [ // 加購題型，例如：飲料加購。\n    {\n      \"externalId\": \"<string>\",\n      \"title\": \"<string>\",\n      \"description\": \"<string>\",\n      \"type\": \"single\", // multiple\n      \"translations\": { // 多國語言\n        \"default\": \"zh-TW\",\n        \"zh-TW\": {\n          \"title\": \"<string>\",\n          \"description\": null\n        }\n      },\n      \"modifierOptionIds\": [ // modifierOption只能屬於一種modifierGroups\n        {\n          \"externalId\": \"<string>\"\n        }\n      ]\n    }\n  ],\n  \"modifierOptions\": [ // 加購選項，例如：紅茶\n    {\n      \"externalId\": \"<string>\",\n      \"title\": \"<string>\",\n      \"price\": <number>,\n      \"modifierGroupExternalId\": \"<string>\", // 所屬group\n      \"sale\": true, // default true\n      \"translations\": { // 多國語言\n        \"default\": \"zh-TW\",\n        \"zh-TW\": {\n          \"title\": \"<string>\",\n          \"description\": null\n        }\n      },\n      \"modifierGroupIds\": [\n        {\n          \"externalId\": \"<string>\",\n          \"modifierOptionIds\": [  // optional\n             {\n               \"externalId\": \"<string>\"\n             }\n           ]\n        }\n      ]\n    }\n  ]\n}\n\n ```",
        "operationId": "updateMenu",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          }
        ],
        "responses": {
          "200": {
            "description": "開始同步菜單",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "processing"
                    },
                    "syncId": {
                      "type": "integer",
                      "example": 1601127823299
                    }
                  }
                },
                "example": {
                  "status": "processing",
                  "syncId": 1601127823299
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "menus": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "example": "全日菜單"
                        },
                        "externalId": {
