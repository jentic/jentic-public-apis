          "購物車APIs"
        ],
        "summary": "取得團購基本資訊 (BY cartId)",
        "description": "",
        "operationId": "getCartInfo",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          },
          {
            "name": "cartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "購物車ID"
          }
        ],
        "responses": {
          "200": {
            "description": "取得團購基本資訊 (BY cartId)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
