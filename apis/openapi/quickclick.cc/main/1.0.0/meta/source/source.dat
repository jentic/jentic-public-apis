      "patch": {
        "tags": [
          "購物車APIs"
        ],
        "summary": "送單給團主",
        "description": "",
        "operationId": "submitToHost",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          },
          {
            "name": "cartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "購物車ID"
          },
          {
            "name": "customerCartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "團員購物車ID"
          }
        ],
        "responses": {
          "200": {
            "description": "送單給團主",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "customerCartStatus": {
                      "type": "string",
                      "example": "cart_ready"
                    }
                  }
                },
                "example": {
                  "customerCartStatus": "cart_ready"
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customerCartStatus": {
                    "type": "string",
                    "example": "cart_ready"
                  }
                }
              },
              "example": {
                "customerCartStatus": "cart_ready"
              }
            }
          }
        }
      }
    },
    "/v1/shops/{shopId}/carts/{cartId}/customer-carts/{customerCartId}/items": {
      "post": {
        "tags": [
          "購物車APIs"
        ],
        "summary": "加入商品到購物車",
        "description": "這個 API 讓客戶可以將商品加入到購物車裡。\n\n| 參數名稱                   | 必要性 | 資料型態 | 說明         |\n|------------------------|-----|------|------------|\n| productId              | 是   | 整數   | 商品 ID      |\n| title                  | 否   | 字串   | 商品名稱       |\n| price                  | 否   | 浮點數  | 商品價格       |\n| quantity               | 是   | 整數   | 商品數量       |\n| selectedModifierGroups | 否   | 陣列   | 陣列中包含客製化選項 |\n\n\nselectedModifierGroups 內的客製化選項屬性：\n\n| 參數名稱                    | 必要性 | 資料型態 | 說明          |\n|-------------------------|-----|------|-------------|\n| title                   | 是   | 字串   | 選項名稱        |\n| id                      | 是   | 整數   | 選項 ID       |\n| externalId              | 否   | 字串   | 選項的外部 ID    |\n| selectedModifierOptions | 否   | 陣列   | 選項裡選擇的客製化選項 |\n\nselectedModifierOptions 內的客製化選項屬性：\n\n| 參數名稱       | 必要性 | 資料型態 | 說明       |\n|------------|-----|------|----------|\n| title      | 否   | 字串   | 選項名稱     |\n| id         | 是   | 整數   | 選項 ID    |\n| externalId | 否   | 字串   | 選項的外部 ID |\n| price      | 否   | 浮點數  | 選項價格     |",
        "operationId": "addItemToCart",
        "parameters": [
          {
            "name": "shopId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "商店ID"
          },
          {
            "name": "cartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "購物車ID"
          },
          {
            "name": "customerCartId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "團員購物車ID"
          }
        ],
        "responses": {
          "200": {
            "description": "加入商品到購物車",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "productId": {
                      "type": "integer",
                      "example": 74907
                    },
                    "title": {
                      "type": "string",
                      "example": "南投早餐 Tossed Noodles with Minced Pork Breakfast"
                    },
                    "price": {
                      "type": "integer",
                      "example": 90
                    },
                    "quantity": {
                      "type": "integer",
                      "example": 1
                    },
                    "selectedModifierGroups": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "title": {
                            "type": "string",
                            "example": "飲料加購"
                          },
                          "id": {
                            "type": "integer",
                            "example": 4708
                          },
                          "externalId": {
                            "type": "string",
                            "nullable": true
                          },
                          "selectedModifierOptions": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "title": {
                                  "type": "string",
                                  "example": "綠茶"
                                },
                                "id": {
                                  "type": "integer",
                                  "example": 25654
                                },
                                "externalId": {
                                  "type": "string",
                                  "nullable": true
                                },
                                "price": {
                                  "type": "integer",
                                  "example": 0
                                },
                                "selectedModifierGroups": {
                                  "type": "array",
                                  "items": {
                                    "type": "object"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "priceDetail": {
                      "type": "object",
                      "properties": {
                        "totalPrice": {
                          "type": "object",
                          "properties": {
                            "amount": {
                              "type": "integer",
                              "example": 270
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "productId": 74907,
                  "title": "南投早餐 Tossed Noodles with Minced Pork Breakfast",
                  "price": 90,
                  "quantity": 1,
                  "selectedModifierGroups": [
                    {
                      "title": "飲料加購",
                      "id": 4708,
                      "externalId": null,
                      "selectedModifierOptions": [
                        {
                          "title": "綠茶",
                          "id": 25654,
                          "externalId": null,
                          "price": 0,
                          "selectedModifierGroups": [
                            {
                              "id": 4710,
                              "externalId": null,
                              "title": "甜度",
                              "selectedModifierOptions": [
                                {
                                  "id": 25655,
                                  "externalId": null,
                                  "title": "去冰",
                                  "price": 0
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "priceDetail": {
                    "totalPrice": {
                      "amount": 270
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "認證失敗"
          }
        },
