                  "example2": {
                    "summary": "取得訂單內容 (後結加點)",
                    "value": {
                      "orderId": "0000001925",
                      "id": 1925,
                      "currentState": "accepted",
                      "store": {
                        "id": 56,
                        "name": "Kelly test staging"
                      },
                      "user": {
                        "id": 174,
                        "userId": "abcdefg",
                        "name": "T.DotDot",
                        "phone": null,
                        "address": null
                      },
                      "amount": 90,
                      "createdTs": 1610606801,
                      "pickupTs": 1610607660,
                      "mealType": "delivery",
