      "post": {
        "summary": "Add Website",
        "description": "Set up visitor identification for a website and get the tracking pixel to install. Identification starts as soon as the pixel is live and your balance can cover it; each identified person or company is charged then, never here. Credits: free.",
        "tags": [
          "Visitor ID"
        ],
        "x-credits-cost": {
          "amount": 0,
          "unit": "call"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "domain": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Website domain the tracking pixel will identify visitors for"
                  },
                  "name": {
                    "type": "string",
                    "description": "Display name for the workspace (defaults to the domain)"
                  }
                },
                "required": [
                  "domain"
                ],
                "example": {
                  "domain": "coldiq.com"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Website already existed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisitorIdWebsite"
                }
              }
            }
          },
