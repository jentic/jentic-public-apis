    "/v1/limadata/enrich/person": {
      "post": {
        "summary": "Enrich Person",
        "description": "Enrich a person's professional profile using email, LinkedIn URL, or name+company. Variable credit cost (1-5) settled from response header. Optional: include_work_email (+1 credit), include_phone (+10 credits). Credits: 17.5 per call.",
        "tags": [
          "Lima Data"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-credits-cost": {
          "amount": 17.5,
          "unit": "call"
        },
