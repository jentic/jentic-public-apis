      "ChatDetailResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ChatConversation"
          },
          {
            "type": "object",
            "properties": {
              "messages": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ChatMessage"
                }
              },
              "totalCreditsConsumed": {
                "type": "number"
              },
              "activeRun": {
                "type": "object",
