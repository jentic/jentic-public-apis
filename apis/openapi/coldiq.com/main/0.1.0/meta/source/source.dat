                  "name": {
                    "type": "string"
                  },
                  "campaign_schedule": {
                    "type": "object",
                    "properties": {
                      "schedules": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "timing": {
                              "type": "object",
                              "properties": {
