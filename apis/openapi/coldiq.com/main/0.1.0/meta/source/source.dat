      "post": {
        "summary": "Bulk Traffic Estimation",
        "description": "Estimate organic search traffic for a list of domains. Credits: 2.31 per target; reserved up-front for the requested size, settled to the actual count (see X-ColdIQ-Credits-Charged).",
        "tags": [
          "DataForSEO"
        ],
