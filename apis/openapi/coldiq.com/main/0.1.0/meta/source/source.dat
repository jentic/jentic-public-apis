                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/mailboxes/catalog": {
      "get": {
        "tags": [
          "Mailboxes"
        ],
        "summary": "Mailbox catalog \u2014 prices, limits and purchase availability",
