                        "type": "object",
                        "properties": {
                          "include": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "exclude": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "additionalProperties": {
                          "nullable": true
                        },
                        "description": "Company location(s), e.g. \"San Francisco, United States\". Format {\"include\":[...],\"exclude\":[...]}."
                      },
                      "company": {
                        "type": "object",
                        "properties": {
                          "websites": {
                            "type": "object",
                            "properties": {
                              "include": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "exclude": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
