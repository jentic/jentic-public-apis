    "/v1/discolike/contacts/match": {
      "get": {
        "summary": "Contact Match",
        "description": "Match a person name (optionally scoped by company or domain) to contact profiles with match scores.21 credits per returned match. Credits: variable per query + 0.21/match \u2014 query=37.8, record=0.74; reserved up-front, settled to actual (see X-ColdIQ-Credits-Charged).",
        "tags": [
          "DiscoLike"
        ],
        "x-credits-cost": {
          "unit": "query + 0.21/match",
          "rates": {
            "query": 37.8,
            "record": 0.74
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 2,
              "description": "Person name to search for (min 2 characters).",
              "example": "Michel Lieben"
