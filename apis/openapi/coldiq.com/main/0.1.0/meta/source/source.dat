              "credits",
              "idempotencyKey"
            ]
          }
        ],
        "example": {
          "priceId": "price_1TopUp",
          "amount": 10000,
          "credits": 6000,
          "idempotencyKey": "5c5fe57b-19de-4b1e-a597-404534046dd6"
        }
      },
      "PlanChangePreviewResponse": {
        "type": "object",
        "properties": {
          "currentPlan": {
            "type": "object",
            "properties": {
              "priceId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "credits": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true
              },
              "interval": {
                "type": "string",
                "enum": [
                  "month",
                  "quarter",
                  "year"
                ]
              },
              "amount": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true
              },
              "currency": {
                "type": "string"
              }
            },
            "required": [
              "priceId",
              "name",
              "credits",
              "interval",
              "amount",
              "currency"
            ]
          },
          "targetPlan": {
            "type": "object",
            "properties": {
              "priceId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "credits": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true
              },
              "interval": {
                "type": "string",
                "enum": [
                  "month",
                  "quarter",
                  "year"
                ]
              },
              "amount": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true
              },
              "currency": {
                "type": "string"
              }
            },
            "required": [
              "priceId",
              "name",
              "credits",
              "interval",
              "amount",
              "currency"
            ]
          },
