                "MID_LOW",
                "MEDIUM",
                "MID_HIGH",
                "HIGH",
                "UNRESTRICTED"
              ],
              "description": "Result diversity control."
            },
            "required": false,
            "description": "Result diversity control.",
            "name": "variance",
            "in": "query"
