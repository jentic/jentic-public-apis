    "/v1/linkupapi/data/search/profiles": {
      "post": {
        "summary": "Search Profiles",
        "description": "Search LinkedIn profiles by job title, location, current company, industry, school, or keywords. Returns a list of matching profiles. Billed per 10 results. Credits: 6.3 per 10 results; reserved up-front for the requested size, settled to the actual count (see X-ColdIQ-Credits-Charged).",
