    "/v1/fullenrich/contact/enrich/bulk": {
      "post": {
        "summary": "Enrich Contacts In Bulk",
        "description": "Submit up to 100 contacts for enrichment. Returns an `enrichment_id` immediately \u2014 results are delivered asynchronously via webhook and stored for retrieval via GET. Credits are reserved upfront (worst-case) and the unused portion is refunded when results arrive: 1 per email, 3 per personal email, 10 per phone number. Credits: variable per contact \u2014 contact.emails=14, contact.phones=119, contact.personal_emails=35; reserved up-front, settled to actual (see X-ColdIQ-Credits-Charged).",
        "tags": [
          "FullEnrich"
        ],
        "x-credits-cost": {
          "unit": "contact",
          "rates": {
            "contact.emails": 14,
            "contact.phones": 119,
            "contact.personal_emails": 35
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
