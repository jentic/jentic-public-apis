            "example": "Software",
            "description": "Company industry classification"
          },
          "location": {
            "type": "string",
            "example": "United States",
            "description": "Geographic filter"
          },
          "employee_range": {
            "type": "string",
            "example": "51-200",
            "description": "Company size filter (e.g. \"51-200\", \"201-500\")"
          },
          "min_active_jobs": {
            "type": "integer",
            "minimum": 1,
            "example": 5,
            "description": "Minimum number of active job postings"
          },
          "total_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "example": 50,
            "description": "Number of results to return (max 500). Billed at 1 credit per 10 companies."
          }
        },
        "example": {
          "job_title": "Sales Director",
          "industry": "Software",
          "location": "United States",
          "employee_range": "51-200",
          "total_results": 50
        }
      },
      "AiArkCompanySearchResponse": {
        "type": "object",
        "properties": {
