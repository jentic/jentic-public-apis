                "displayName",
                "providerType",
                "status",
                "domainId",
                "domain",
                "purchaseId",
                "credentialStatus",
                "sequencer",
                "sequencerStatus",
                "sequencerConnectionId",
                "sequencerConnectionName",
                "sequencerAccountId",
                "sequencerError",
                "createdAt",
                "updatedAt"
              ]
            }
          },
          "report": {
            "type": "object",
            "nullable": true,
            "properties": {
              "completed": {
                "type": "integer"
              },
              "failed": {
                "type": "integer"
              },
              "refunded": {
                "type": "integer"
              },
              "message": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "completed",
              "failed",
              "refunded",
              "message"
            ]
          }
        },
        "required": [
          "id",
          "cartId",
          "state",
          "phase",
          "provider",
          "mailboxCount",
          "domains",
          "createdAt",
          "updatedAt",
          "completedAt",
          "quote",
          "timeline",
          "lines",
          "mailboxes",
          "report"
        ]
      },
