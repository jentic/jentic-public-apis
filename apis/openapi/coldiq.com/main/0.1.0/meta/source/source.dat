      "CreateProspectListRequest": {
        "type": "object",
        "properties": {
          "list": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "ColdIQ CEO prospects"
              },
              "max_profiles": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500,
                "example": 100
              }
            },
            "required": [
