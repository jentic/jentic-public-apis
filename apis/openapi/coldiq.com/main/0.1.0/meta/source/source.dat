                        "first_name": {
                          "type": "string"
                        },
                        "last_name": {
                          "type": "string"
                        },
                        "full_name": {
                          "type": "string"
                        },
                        "company_name": {
                          "type": "string"
                        },
                        "company_website": {
                          "type": "string"
                        },
                        "company_linkedin_url": {
                          "type": "string"
                        },
                        "linkedin_url": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "person_id": {
                          "type": "string"
                        },
                        "identifier": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "identifier"
                      ]
                    },
                    "minItems": 1,
                    "maxItems": 50
                  },
                  "only_verified_email": {
                    "type": "boolean"
                  },
                  "enrich_mobile": {
                    "type": "boolean"
                  },
                  "only_verified_mobile": {
