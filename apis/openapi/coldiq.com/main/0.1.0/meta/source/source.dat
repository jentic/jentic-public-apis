            "name": "employee_range",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Annual revenue range as \"min,max\" in raw integers."
            },
            "required": false,
            "description": "Annual revenue range as \"min,max\" in raw integers.",
            "name": "revenue_range",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Business models: B2B, B2C, B2G, G2B, G2C, D2C, C2C, C2B. Comma-separated for multiple values.",
              "example": "B2B"
            },
