    "/dashboard/connections/{provider}": {
      "put": {
        "tags": [
          "Connections"
        ],
        "summary": "Connect or update a tool",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "lemlist"
            },
            "required": true,
            "name": "provider",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
