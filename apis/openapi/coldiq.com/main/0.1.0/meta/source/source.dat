                  "email_list": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "email"
                    }
                  },
                  "daily_limit": {
                    "type": "integer"
                  },
                  "daily_max_leads": {
                    "type": "integer"
                  },
                  "stop_on_reply": {
                    "type": "boolean"
                  },
                  "stop_on_auto_reply": {
                    "type": "boolean"
                  },
                  "link_tracking": {
                    "type": "boolean"
                  },
                  "open_tracking": {
                    "type": "boolean"
                  },
                  "api_key": {
                    "type": "string",
                    "description": "Your Instantly API key. Optional if you have connected your Instantly account in the dashboard."
