        "allOf": [
          {
            "$ref": "#/components/schemas/PlanChangeBody"
          },
          {
            "type": "object",
            "properties": {
              "prorationDate": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true,
