          },
          "state": {
            "type": "string",
            "enum": [
              "awaiting_payment",
              "provisioning",
              "completed",
              "partial",
              "failed",
              "refunded"
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "payment",
              "domain",
              "dns",
              "inboxes",
              "credentials"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "google",
              "microsoft"
            ]
          },
          "mailboxCount": {
            "type": "integer"
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "completedAt": {
            "type": "string",
            "nullable": true
          },
          "quote": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MailboxQuote"
              },
              {
                "nullable": true
              }
            ]
          },
          "timeline": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "string",
                  "enum": [
                    "payment",
                    "domain",
                    "dns",
                    "inboxes",
                    "credentials"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "waiting",
                    "current",
                    "completed",
                    "failed"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "detail": {
                  "type": "string",
                  "nullable": true
                },
                "completedAt": {
                  "type": "string",
                  "nullable": true
                }
              },
              "required": [
                "phase",
                "state",
                "label",
                "detail",
                "completedAt"
              ]
            }
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "domain",
                    "mailbox"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "provisioning",
                    "completed",
                    "failed",
                    "refunded"
                  ]
                },
                "error": {
                  "type": "string",
                  "nullable": true
                }
              },
              "required": [
                "id",
                "type",
                "label",
                "quantity",
                "status",
                "error"
              ]
            }
          },
          "mailboxes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "number"
                },
                "email": {
                  "type": "string"
                },
                "displayName": {
                  "type": "string",
                  "nullable": true
                },
                "providerType": {
                  "type": "string",
                  "enum": [
                    "google",
                    "microsoft"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "active",
                    "failed",
                    "deleted"
                  ]
                },
                "domainId": {
                  "type": "number",
                  "nullable": true
                },
                "domain": {
                  "type": "string"
                },
                "purchaseId": {
                  "type": "string"
                },
                "credentialStatus": {
                  "type": "string",
                  "enum": [
                    "preparing",
                    "ready",
                    "unavailable"
                  ]
                },
                "sequencer": {
                  "type": "string",
                  "nullable": true,
                  "description": "Sending tool this inbox is linked to, when linked"
                },
                "sequencerStatus": {
                  "type": "string"
                },
                "sequencerConnectionId": {
                  "type": "string",
                  "nullable": true
                },
                "sequencerConnectionName": {
                  "type": "string",
                  "nullable": true
                },
                "sequencerAccountId": {
                  "type": "string",
                  "nullable": true
                },
                "sequencerError": {
                  "type": "string",
                  "nullable": true
                },
                "createdAt": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string"
                }
              },
              "required": [
