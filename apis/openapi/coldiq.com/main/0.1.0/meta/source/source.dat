            "minimum": 0
          },
          "creditsAdded": {
            "type": "integer",
            "minimum": 0
          },
          "effectiveAt": {
            "type": "string",
            "format": "date-time"
          },
          "nextBillingAt": {
            "type": "string",
            "format": "date-time"
          },
          "paymentMethod": {
            "$ref": "#/components/schemas/SavedCard"
          },
          "prorationDate": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          }
        },
