          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "description": "Person's email address. Example: michel@coldiq.com"
                  },
                  "linkedin_url": {
                    "type": "string",
                    "description": "Person's LinkedIn URL. Example: https://www.linkedin.com/in/michel-lieben"
                  },
                  "name": {
                    "type": "string",
                    "description": "Person's name. Required when using company lookup. Example: Michel Lieben"
                  },
                  "company_name": {
                    "type": "string",
                    "description": "Company name. Use with name for identity resolution. Example: ColdIQ"
                  },
                  "company_domain": {
                    "type": "string",
                    "description": "Company domain. Use with name for identity resolution. Example: coldiq.com"
                  },
                  "include_work_email": {
                    "type": "boolean",
                    "description": "Include work email in response. Adds 1 credit if found."
                  },
                  "include_phone": {
                    "type": "boolean",
                    "description": "Include phone number(s) in response. Adds 10 credits if found."
                  }
                },
                "title": "LimaDataEnrichPersonRequest",
