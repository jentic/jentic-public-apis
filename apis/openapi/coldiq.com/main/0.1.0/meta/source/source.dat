    "/dashboard/team": {
      "get": {
        "tags": [
          "Team"
        ],
        "summary": "Get your team and its members",
        "responses": {
          "200": {
            "description": "Your team, or a null team if you have none yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Team"
                }
              }
            }
          },
          "401": {
