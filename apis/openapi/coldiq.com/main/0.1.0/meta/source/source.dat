        ]
      },
      "TopUpPaymentIntentBody": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TopUpBody"
          },
          {
            "type": "object",
            "properties": {
              "amount": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true,
                "description": "Exact smallest-currency-unit amount shown in the current preview"
              },
              "credits": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true,
                "description": "Exact credit amount shown in the current preview"
              },
              "idempotencyKey": {
                "type": "string",
                "format": "uuid",
