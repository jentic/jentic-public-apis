    "/v1/wiza/individual-reveals": {
      "post": {
        "x-credits-cost": {
          "unit": "contact",
          "rates": {
            "none": 17.5,
            "partial": 35,
            "phone": 122.5,
            "full": 122.5
          }
        },
        "summary": "Start Individual Reveal",
        "description": "Enrich a single contact with professional data. Returns immediately with a reveal ID \u2014 results are delivered asynchronously via webhook and retrievable via GET. Processing time: 0\u2013380 seconds depending on enrichment level. Credit costs: none=1, partial=2, phone/full=7. Credits: variable per contact \u2014 none=17.5, partial=35, phone=122.5, full=122.5; reserved up-front, settled to actual (see X-ColdIQ-Credits-Charged).",
        "tags": [
          "Wiza"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
