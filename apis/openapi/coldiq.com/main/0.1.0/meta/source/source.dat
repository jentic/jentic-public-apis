    "/v1/icypeas/search-results": {
      "post": {
        "summary": "Retrieve your results",
        "description": "Fetch results for a previously initiated search using its _id. Free \u2014 no credit cost. Credits: 1.05 per call.",
        "tags": [
          "Icypeas"
        ],
        "x-credits-cost": {
          "amount": 1.05,
          "unit": "call"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "bulk",
                      "single"
                    ],
                    "description": "Result retrieval mode"
                  },
                  "id": {
                    "type": "string",
                    "description": "Item _id returned by the initiation endpoint (required for mode=single)"
                  },
                  "file": {
                    "type": "string",
                    "description": "File ID returned by bulk-search (required for mode=bulk)"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100,
                    "description": "Number of results (default 10, max 100)"
                  },
                  "next": {
                    "type": "boolean",
                    "description": "Pagination direction (true = next, false = previous)"
                  },
                  "sort": {
                    "type": "array",
                    "items": {
                      "nullable": true
                    },
                    "description": "Pagination cursor from previous response"
                  },
                  "type": {
                    "type": "string",
                    "description": "Filter by task type (e.g. email-search, domain-scan, email-verification)"
                  }
                },
                "required": [
                  "mode"
                ],
                "title": "IcypeasSearchResultsRequest",
                "example": {
                  "mode": "single",
