    "/v1/icypeas/reverse-email-lookups": {
      "post": {
        "summary": "Bulk search : Find the profile URLs behind many email addresses",
        "description": "Reverse look up multiple email addresses. Min 2, max 50 per request. Costs 10.5 credits per submitted email because the acknowledgement cannot be settled per result. Credits: 1.05 per call.",
