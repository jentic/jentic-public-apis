          },
          {
            "schema": {
              "type": "string",
              "description": "States to exclude. Comma-separated for multiple values."
            },
            "required": false,
            "description": "States to exclude. Comma-separated for multiple values.",
            "name": "negate_state",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Industry categories to include. Comma-separated for multiple values."
            },
