          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "publicId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Chat soft-deleted"
          },
          "404": {
            "description": "Chat not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatError"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard/signup-context": {
      "post": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Capture signup network context",
        "responses": {
          "200": {
            "description": "Browser network context capture result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "captured": {
                      "type": "boolean"
                    },
                    "status": {
                      "type": "string",
