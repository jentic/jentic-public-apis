            "type": "string",
            "format": "uri",
            "example": "https://webhook.site/your-unique-id"
          }
        },
        "required": [
          "list",
          "filters"
        ],
        "example": {
          "list": {
            "name": "ColdIQ CEO prospects",
            "max_profiles": 100
          },
          "filters": {
            "job_company": [
