        "tags": [
          "Lima Data"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-credits-cost": {
          "amount": 7,
          "unit": "call"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
