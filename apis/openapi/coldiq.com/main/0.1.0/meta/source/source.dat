    "/v1/adyntel/linkedin": {
      "post": {
        "summary": "LinkedIn Ads",
        "description": "Fetch the LinkedIn ads for a company by domain or LinkedIn page ID, from the LinkedIn Ad Library. Returns one page plus a `continuation_token`. Credits: 1.85 per call.",
        "tags": [
          "Adyntel"
        ],
        "x-credits-cost": {
          "amount": 1.85,
          "unit": "call"
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "company_domain": {
                    "type": "string",
                    "description": "Company website without protocol or www (e.g. 'coldiq.com'). Provide this or linkedin_page_id."
                  },
                  "linkedin_page_id": {
                    "type": "integer",
                    "description": "LinkedIn company page ID (numeric). Provide this or company_domain."
                  },
                  "date_filter": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "last30d",
                          "month",
                          "year",
                          "lastyear"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "startdate": {
                            "type": "string",
                            "description": "Range start (YYYY-MM-DD)"
                          },
                          "enddate": {
                            "type": "string",
                            "description": "Range end (YYYY-MM-DD)"
                          }
                        },
                        "required": [
                          "startdate",
                          "enddate"
                        ]
                      }
                    ],
                    "description": "Time window: a preset (last30d, month, year, lastyear) or a custom {startdate, enddate} range."
                  },
                  "continuation_token": {
                    "type": "string",
                    "description": "Pagination token from a previous response to fetch the next page."
                  }
                },
                "title": "LinkedInAdsRequest",
                "example": {
                  "company_domain": "salesforce.com"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "LinkedIn ads for the company",
