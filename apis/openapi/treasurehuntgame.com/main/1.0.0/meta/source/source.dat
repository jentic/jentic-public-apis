{
  "openapi": "3.0.0",
  "info": {
    "title": "Treasure Hunt Video Game API",
    "description": "RESTful API for a treasure hunt video game with JSON endpoints for current level, treasure, and account data.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/MConneely/TreasureHuntGameAPI/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.treasurehuntgame.com"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/currentlevel": {
      "get": {
        "operationId": "getCurrentLevel",
        "summary": "Get the current level of the player",
        "responses": {
          "200": {
            "description": "Current level retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentLevel"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - API key missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Current level not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "updateCurrentLevel",
        "summary": "Update the current level of the player (move up or down a level)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Level update action",
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "Action to perform on the current level",
                    "enum": [
                      "moveUp",
                      "moveDown"
                    ]
                  }
                },
                "required": [
                  "action"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current level updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentLevel"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - API key missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Current level not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/treasure": {
      "get": {
        "operationId": "getTreasure",
        "summary": "Get treasure information",
        "responses": {
          "200": {
            "description": "Treasure information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Treasure"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - API key missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Treasure not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "foundTreasure",
        "summary": "Notify that a user has found a treasure",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Treasure found information",
                "properties": {
                  "treasureId": {
                    "type": "integer",
                    "description": "ID of the treasure found"
                  }
                },
                "required": [
                  "treasureId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Treasure found recorded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Treasure"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - API key missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Treasure not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteTreasure",
        "summary": "Delete a treasure",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Treasure deletion information",
                "properties": {
                  "treasureId": {
                    "type": "integer",
                    "description": "ID of the treasure to delete"
                  }
                },
                "required": [
                  "treasureId"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Treasure deleted successfully"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - API key missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Treasure not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/accountdata": {
      "get": {
        "operationId": "getAccountData",
        "summary": "Get account data of the player",
        "responses": {
          "200": {
            "description": "Account data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountData"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - API key missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Account data not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "CurrentLevel": {
        "type": "object",
        "description": "Current level information of the player",
        "properties": {
          "levelNumber": {
            "type": "integer",
            "example": 5
          },
          "description": {
            "type": "string",
            "example": "You are on level 5, the forest of mysteries."
          }
        }
      },
      "Treasure": {
        "type": "object",
        "description": "Treasure information",
        "properties": {
          "treasureId": {
            "type": "integer",
            "example": 123
          },
          "name": {
            "type": "string",
            "example": "Golden Crown"
          },
          "value": {
            "type": "integer",
            "example": 1000
          },
          "location": {
            "type": "string",
            "example": "Hidden cave behind the waterfall"
          }
        }
      },
      "AccountData": {
        "type": "object",
        "description": "Player account data",
        "properties": {
          "userId": {
            "type": "integer",
            "example": 789
          },
          "username": {
            "type": "string",
            "example": "playerOne"
          },
          "email": {
            "type": "string",
            "example": "playerone@example.com"
          },
          "totalScore": {
            "type": "integer",
            "example": 4500
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Error response",
        "properties": {
          "code": {
            "type": "integer",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Bad request"
          }
        }
      }
    }
  }
}
