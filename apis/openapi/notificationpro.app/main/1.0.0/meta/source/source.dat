{
  "openapi": "3.0.3",
  "info": {
    "title": "Notification PRO API",
    "description": "API for creating and managing notifications in Notification PRO for Shopify.\n\nThis API allows developers to programmatically create, update, retrieve, and delete \nnotifications, as well as access analytics data for notification performance tracking.\n\n## Authentication\nAll API requests require authentication using an API key. Include your API key in the \n`X-API-Key` header of each request.\n\n**Example:**\n```\nX-API-Key: npro_1234567890abcdef\n```\n\n## Rate Limiting\n- **Free Plan**: 100 requests per hour\n- **Pro Plan**: 1000 requests per hour\n\nRate limit information is included in response headers:\n- `X-RateLimit-Limit`: Maximum requests allowed per hour\n- `X-RateLimit-Remaining`: Requests remaining in current window\n- `X-RateLimit-Reset`: Unix timestamp when the rate limit resets\n\n## Base URL\n```\nhttps://api.notificationpro.app/v1\n```\n",
    "version": "1.0.0",
    "contact": {
      "name": "Notification PRO Support",
      "email": "support@notificationpro.app",
      "url": "https://docs.notificationpro.app"
    },
    "license": {
      "name": "Private License"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/universitydestrasbou/notification-pro-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.notificationpro.app/v1",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Notifications",
      "description": "Create and manage notifications"
    },
    {
      "name": "Analytics",
      "description": "Retrieve notification performance metrics"
    }
  ],
  "paths": {
    "/notifications": {
      "post": {
        "tags": [
          "Notifications"
        ],
        "summary": "Create a new notification",
        "description": "Creates a new notification for the authenticated merchant's store.\n\n**Free Plan Limitations:**\n- Maximum 3 active notifications (status: \"active\")\n- Watermark automatically added\n- Basic icons only (3 available)\n\n**Pro Plan Features:**\n- Unlimited active notifications\n- No watermark\n- Access to 100+ premium icons\n- Advanced scheduling options\n",
        "operationId": "createNotification",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationCreate"
              },
              "examples": {
                "basic-sale-notification": {
                  "summary": "Basic sale notification",
                  "value": {
                    "title": "Summer Sale: 40% Off",
                    "content": "Shop our biggest summer sale! Save up to 40% on selected items. Ends Sunday!",
                    "icon_id": "icon_tag_001",
                    "link_url": "https://mystore.myshopify.com/collections/summer-sale",
                    "display_settings": {
                      "position": "header-right",
                      "color": "#FF6B6B",
                      "font_size": "14px",
                      "background_color": "#FFFFFF"
                    },
                    "status": "active"
                  }
                },
                "scheduled-product-launch": {
                  "summary": "Scheduled product launch notification",
                  "value": {
                    "title": "🎉 New Collection Drops Tomorrow!",
                    "content": "Be the first to shop our exclusive fall collection. Launching September 1st at 9 AM EST.",
                    "icon_id": "icon_gift_005",
                    "link_url": "https://mystore.myshopify.com/collections/fall-2026",
                    "display_settings": {
                      "position": "header-center",
                      "color": "#4A90E2",
                      "font_size": "15px"
                    },
                    "schedule": {
                      "start_date": "2026-09-01T09:00:00Z",
                      "end_date": "2026-09-07T23:59:59Z",
                      "timezone": "America/New_York"
                    },
                    "status": "scheduled"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Notification created successfully",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Maximum requests allowed per hour"
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                },
                "description": "Requests remaining in current window"
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Unix timestamp when rate limit resets"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationResponse"
                },
                "example": {
                  "id": "notif_7h3k2m9p1q",
                  "title": "Summer Sale: 40% Off",
                  "content": "Shop our biggest summer sale! Save up to 40% on selected items. Ends Sunday!",
                  "icon_id": "icon_tag_001",
                  "link_url": "https://mystore.myshopify.com/collections/summer-sale",
                  "display_settings": {
                    "position": "header-right",
                    "color": "#FF6B6B",
                    "font_size": "14px",
                    "background_color": "#FFFFFF"
                  },
                  "status": "active",
                  "created_at": "2026-01-17T14:30:00Z",
                  "updated_at": "2026-01-17T14:30:00Z",
                  "analytics_url": "/api/v1/notifications/notif_7h3k2m9p1q/analytics",
                  "preview_url": "https://mystore.myshopify.com?npro_preview=notif_7h3k2m9p1q"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid input data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missing-title": {
                    "summary": "Missing required title field",
                    "value": {
                      "error": "Validation Error",
                      "message": "The 'title' field is required",
                      "code": "VALIDATION_ERROR",
                      "details": [
                        {
                          "field": "title",
                          "issue": "Required field missing"
                        }
                      ]
                    }
                  },
                  "invalid-icon": {
                    "summary": "Invalid icon ID",
                    "value": {
                      "error": "Validation Error",
                      "message": "The specified icon_id does not exist",
                      "code": "INVALID_ICON",
                      "details": [
                        {
                          "field": "icon_id",
                          "issue": "Icon 'icon_invalid_999' not found in available icons"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized",
                  "message": "Invalid or missing API key",
                  "code": "INVALID_API_KEY"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Plan limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Plan Limit Exceeded",
                  "message": "Free plan allows maximum 3 active notifications. Upgrade to Pro for unlimited notifications.",
                  "code": "PLAN_LIMIT_EXCEEDED",
                  "details": {
                    "current_active_count": 3,
                    "plan_limit": 3,
                    "upgrade_url": "https://app.notificationpro.app/upgrade"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Internal Server Error",
                  "message": "An unexpected error occurred. Please try again later.",
                  "code": "INTERNAL_ERROR",
                  "request_id": "req_abc123def456"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/{notification_id}/analytics": {
      "get": {
        "tags": [
          "Analytics"
        ],
        "summary": "Get notification analytics",
        "description": "Retrieves performance analytics for a specific notification.\n\n**Metrics Included:**\n- **Impressions**: Total number of times the notification icon was displayed\n- **Clicks**: Number of times users clicked on the notification\n- **Click-Through Rate (CTR)**: Percentage of impressions that resulted in clicks\n- **Unique Visitors**: Number of unique users who saw the notification\n- **Daily Breakdown**: Day-by-day metrics for the specified date range\n\n**Data Retention:**\n- Free Plan: 30 days of analytics data\n- Pro Plan: 365 days of analytics data\n\n**Refresh Rate:**\nAnalytics data is updated every 15 minutes. Real-time data is not available.\n",
        "operationId": "getNotificationAnalytics",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "notification_id",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the notification",
            "schema": {
              "type": "string",
              "pattern": "^notif_[a-zA-Z0-9]{10}$"
            },
            "example": "notif_7h3k2m9p1q"
          },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "description": "Start date for analytics range (ISO 8601 format). Defaults to 7 days ago.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-01-10T00:00:00Z"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "description": "End date for analytics range (ISO 8601 format). Defaults to current date/time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-01-17T23:59:59Z"
          },
          {
            "name": "timezone",
            "in": "query",
            "required": false,
            "description": "Timezone for date range calculations (IANA timezone format). Defaults to store's timezone.",
            "schema": {
              "type": "string"
            },
            "example": "America/New_York"
          },
          {
            "name": "granularity",
            "in": "query",
            "required": false,
            "description": "Data granularity for daily breakdown",
            "schema": {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "week"
              ],
              "default": "day"
            },
            "example": "day"
          }
        ],
        "responses": {
          "200": {
            "description": "Analytics data retrieved successfully",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                },
                "description": "Maximum requests allowed per hour"
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                },
                "description": "Requests remaining in current window"
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                },
                "description": "Unix timestamp when rate limit resets"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsResponse"
                },
                "example": {
                  "notification_id": "notif_7h3k2m9p1q",
                  "notification_title": "Summer Sale: 40% Off",
                  "period": {
                    "start": "2026-01-10T00:00:00Z",
                    "end": "2026-01-17T23:59:59Z",
                    "timezone": "America/New_York"
                  },
                  "metrics": {
                    "impressions": 15420,
                    "clicks": 1847,
                    "click_through_rate": 0.1198,
                    "unique_visitors": 8932,
                    "average_time_to_click": 3.2
                  },
                  "daily_breakdown": [
                    {
                      "date": "2026-01-10",
                      "impressions": 2104,
                      "clicks": 253,
                      "unique_visitors": 1289,
                      "click_through_rate": 0.1202
                    },
                    {
                      "date": "2026-01-11",
                      "impressions": 2387,
                      "clicks": 294,
                      "unique_visitors": 1456,
                      "click_through_rate": 0.1232
                    },
                    {
                      "date": "2026-01-12",
                      "impressions": 1956,
                      "clicks": 227,
                      "unique_visitors": 1178,
                      "click_through_rate": 0.1161
                    },
                    {
                      "date": "2026-01-13",
                      "impressions": 2201,
                      "clicks": 271,
                      "unique_visitors": 1334,
                      "click_through_rate": 0.1231
                    },
                    {
                      "date": "2026-01-14",
                      "impressions": 2089,
                      "clicks": 238,
                      "unique_visitors": 1245,
                      "click_through_rate": 0.1139
                    },
                    {
                      "date": "2026-01-15",
                      "impressions": 2312,
                      "clicks": 289,
                      "unique_visitors": 1401,
                      "click_through_rate": 0.125
                    },
                    {
                      "date": "2026-01-16",
                      "impressions": 2098,
                      "clicks": 241,
                      "unique_visitors": 1256,
                      "click_through_rate": 0.1149
                    },
                    {
                      "date": "2026-01-17",
                      "impressions": 273,
                      "clicks": 34,
                      "unique_visitors": 167,
                      "click_through_rate": 0.1245
                    }
                  ],
                  "top_referrers": [
                    {
                      "source": "direct",
                      "clicks": 892,
                      "percentage": 0.483
                    },
                    {
                      "source": "google",
                      "clicks": 421,
                      "percentage": 0.228
                    },
                    {
                      "source": "facebook",
                      "clicks": 312,
                      "percentage": 0.169
                    },
                    {
                      "source": "instagram",
                      "clicks": 222,
                      "percentage": 0.12
                    }
                  ],
                  "device_breakdown": {
                    "mobile": 9847,
                    "desktop": 4521,
                    "tablet": 1052
                  },
                  "export_url": "https://api.notificationpro.app/v1/notifications/notif_7h3k2m9p1q/analytics/export?format=csv"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - Invalid parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Validation Error",
                  "message": "Invalid date range: start_date must be before end_date",
                  "code": "INVALID_DATE_RANGE"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Unauthorized",
                  "message": "Invalid or missing API key",
                  "code": "INVALID_API_KEY"
                }
              }
            }
          },
          "404": {
            "description": "Notification not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Not Found",
                  "message": "Notification with ID 'notif_7h3k2m9p1q' not found",
                  "code": "NOTIFICATION_NOT_FOUND"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Internal Server Error",
                  "message": "An unexpected error occurred. Please try again later.",
                  "code": "INTERNAL_ERROR",
                  "request_id": "req_xyz789ghi012"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for authentication. Obtain your API key from the Notification PRO dashboard under Settings > API Keys.\n"
      }
    },
    "schemas": {
      "NotificationCreate": {
        "type": "object",
        "required": [
          "title",
          "content",
          "icon_id"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 100,
            "description": "The notification title (main heading)",
            "example": "Summer Sale: 40% Off"
          },
          "content": {
            "type": "string",
            "maxLength": 500,
            "description": "The notification message body",
            "example": "Shop our biggest summer sale! Save up to 40% on selected items."
          },
          "icon_id": {
            "type": "string",
            "description": "ID of the icon to display. Use /icons endpoint to get available icons.",
            "example": "icon_tag_001"
          },
          "link_url": {
            "type": "string",
            "format": "uri",
            "description": "URL where notification should link (optional but recommended)",
            "example": "https://mystore.myshopify.com/collections/sale"
          },
          "display_settings": {
            "type": "object",
            "description": "Visual customization options",
            "properties": {
              "position": {
                "type": "string",
                "enum": [
                  "header-left",
                  "header-center",
                  "header-right"
                ],
                "default": "header-right",
                "description": "Position of notification icon in header"
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$",
                "description": "Notification text color (hex format)",
                "example": "#FF6B6B"
              },
              "background_color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$",
                "description": "Notification background color (hex format)",
                "example": "#FFFFFF"
              },
              "font_size": {
                "type": "string",
                "pattern": "^\\d+px$",
                "description": "Font size for notification text",
                "example": "14px"
              }
            }
          },
          "schedule": {
            "type": "object",
            "description": "Scheduling options (optional)",
            "properties": {
              "start_date": {
                "type": "string",
                "format": "date-time",
                "description": "When notification should start displaying (ISO 8601)",
                "example": "2026-01-20T00:00:00Z"
              },
              "end_date": {
                "type": "string",
                "format": "date-time",
                "description": "When notification should stop displaying (ISO 8601)",
                "example": "2026-02-01T23:59:59Z"
              },
              "timezone": {
                "type": "string",
                "description": "IANA timezone for schedule",
                "example": "America/New_York"
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "scheduled"
            ],
            "default": "active",
            "description": "Notification status:\n- active: Immediately visible to customers\n- inactive: Created but not visible (draft mode)\n- scheduled: Will become active based on schedule.start_date\n"
          }
        }
      },
      "NotificationResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/NotificationCreate"
          },
          {
            "type": "object",
            "required": [
              "id",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique notification identifier",
                "example": "notif_7h3k2m9p1q"
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when notification was created",
                "example": "2026-01-17T14:30:00Z"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when notification was last updated",
                "example": "2026-01-17T14:30:00Z"
              },
              "analytics_url": {
                "type": "string",
                "description": "URL to fetch analytics for this notification",
                "example": "/api/v1/notifications/notif_7h3k2m9p1q/analytics"
              },
              "preview_url": {
                "type": "string",
                "description": "URL to preview notification on your store",
                "example": "https://mystore.myshopify.com?npro_preview=notif_7h3k2m9p1q"
              }
            }
          }
        ]
      },
      "AnalyticsResponse": {
        "type": "object",
        "properties": {
          "notification_id": {
            "type": "string",
            "description": "ID of the notification",
            "example": "notif_7h3k2m9p1q"
          },
          "notification_title": {
            "type": "string",
            "description": "Title of the notification",
            "example": "Summer Sale: 40% Off"
          },
          "period": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "format": "date-time",
                "description": "Start of analytics period"
              },
              "end": {
                "type": "string",
                "format": "date-time",
                "description": "End of analytics period"
              },
              "timezone": {
                "type": "string",
                "description": "Timezone used for date calculations"
              }
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "impressions": {
                "type": "integer",
                "description": "Total times notification icon was displayed",
                "example": 15420
              },
              "clicks": {
                "type": "integer",
                "description": "Total times notification was clicked",
                "example": 1847
              },
              "click_through_rate": {
                "type": "number",
                "format": "float",
                "description": "Percentage of impressions that resulted in clicks",
                "example": 0.1198
              },
              "unique_visitors": {
                "type": "integer",
                "description": "Number of unique users who saw the notification",
                "example": 8932
              },
              "average_time_to_click": {
                "type": "number",
                "format": "float",
                "description": "Average seconds before user clicked notification",
                "example": 3.2
              }
            }
          },
          "daily_breakdown": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date",
                  "example": "2026-01-10"
                },
                "impressions": {
                  "type": "integer",
                  "example": 2104
                },
                "clicks": {
                  "type": "integer",
                  "example": 253
                },
                "unique_visitors": {
                  "type": "integer",
                  "example": 1289
                },
                "click_through_rate": {
                  "type": "number",
                  "format": "float",
                  "example": 0.1202
                }
              }
            }
          },
          "top_referrers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "example": "direct"
                },
                "clicks": {
                  "type": "integer",
                  "example": 892
                },
                "percentage": {
                  "type": "number",
                  "format": "float",
                  "example": 0.483
                }
              }
            }
          },
          "device_breakdown": {
            "type": "object",
            "properties": {
              "mobile": {
                "type": "integer",
                "example": 9847
              },
              "desktop": {
                "type": "integer",
                "example": 4521
              },
              "tablet": {
                "type": "integer",
                "example": 1052
              }
            }
          },
          "export_url": {
            "type": "string",
            "description": "URL to export analytics data as CSV",
            "example": "https://api.notificationpro.app/v1/notifications/notif_7h3k2m9p1q/analytics/export?format=csv"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Error category",
            "example": "Validation Error"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message",
            "example": "The 'title' field is required"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable error code",
            "example": "VALIDATION_ERROR"
          },
          "details": {
            "type": "object",
            "description": "Additional error details (optional)"
          },
          "request_id": {
            "type": "string",
            "description": "Unique request identifier for support purposes",
            "example": "req_abc123def456"
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
