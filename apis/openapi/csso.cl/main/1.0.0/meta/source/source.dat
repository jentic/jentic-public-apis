{
  "openapi": "3.0.0",
  "servers": [
    {
      "description": "Demo IF",
      "url": "https://sic-if.csso.cl/api/sic"
    },
    {
      "description": "Testing",
      "url": "https://sic2.saludness.com/api/sic"
    },
    {
      "description": "Desarrollo",
      "url": "https://pruebas-sic.saludness.com/api/sic"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "info": {
    "description": "API de integraciones para el sistema SIC de **Salud Ness**",
    "version": "1.0.0",
    "title": "SIC API",
    "contact": {
      "name": "Soporte para API",
      "email": "josef@exponess.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/josef2/SIC/1.0.0"
  },
  "tags": [
    {
      "name": "BMS",
      "description": "Sistema de control centralizado"
    },
    {
      "name": "Alimentación Pacientes",
      "description": "Servicio de alimentacion de pacientes"
    },
    {
      "name": "Aseo",
      "description": "Servicio de Aseo"
    },
    {
      "name": "Alimentación Funcionarios",
      "description": "Servicio de Funcionarios"
    },
    {
      "name": "Estacionamiento",
      "description": "Servicio de Estacionamiento"
    },
    {
      "name": "Dotación",
      "description": "Control de ocupación"
    }
  ],
  "paths": {
    "/alimentacionPacientes/pacient": {
      "post": {
        "tags": [
          "Alimentación Pacientes"
        ],
        "summary": "Informa el ingreso o actualización de un paciente",
        "operationId": "addPacient",
        "description": "Cuando un paciente entra en el hospital informa su ingreso para que se pueda ser atendido por el servicio de alimentación que presta la institución",
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/generalError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/pacient"
              }
            }
          },
          "description": "Paciente a registrar"
        }
      }
    },
    "/alimentacionPacientes/pacient/{numepisodio}": {
      "put": {
        "tags": [
          "Alimentación Pacientes"
        ],
        "summary": "Informa la actualización de un paciente",
        "operationId": "updatePacient",
        "description": "Cuando un paciente en el hospital registra una actualización sus registros clinicos.",
        "parameters": [
          {
            "in": "path",
            "name": "numepisodio",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Numero del episodio del paciente",
            "example": "H0000262609"
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/pacient"
              }
            }
          },
          "description": "Paciente a actualizar"
        }
      }
    },
    "/alimentacionPacientes/pacientDiet": {
      "post": {
        "tags": [
          "Alimentación Pacientes"
        ],
        "summary": "Informa el regimen allimenticio del paciente",
        "operationId": "addPacientDiet",
        "description": "Cuando un paciente recibe una prescipción de diete en el hospital, se informa para que se pueda ser atendido por el servicio de alimentación que presta la institución.",
        "responses": {
          "200": {
            "description": "Prescipción Recibida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/generalError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/prescription"
              }
            }
          },
          "description": "Prescripción a registrar"
        }
      }
    },
    "/alimentacionPacientes/pacientLocation": {
      "post": {
        "tags": [
          "Alimentación Pacientes"
        ],
        "summary": "Informa el cambio de ubicación de un paciente",
        "operationId": "movePacient",
        "description": "Actualiza la ubicación del paciente.",
        "responses": {
          "200": {
            "description": "Ubicación Actualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/generalError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/pacientLocation"
              }
            }
          },
          "description": "Prescripción a registrar"
        }
      }
    },
    "/alimentacionFuncionarios/entry": {
      "post": {
        "tags": [
          "Alimentación Funcionarios"
        ],
        "summary": "Solicita autoriación para el ingreso para un funcionario",
        "operationId": "diningRoomEntry",
        "description": "Solicita autoriación para el ingreso para un funcionario e informa sobre su resultado",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/generalError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/healthEmployeeMark"
              }
            }
          },
          "description": "Solicitud de Ingreso"
        }
      }
    },
    "/moi/alarm": {
      "post": {
        "tags": [
          "BMS"
        ],
        "summary": "Informa de una alarma",
        "operationId": "addAlarm",
        "description": "Añade una alarma al SIC para so posterior atención",
        "responses": {
          "201": {
            "description": "Alarma creada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/generalError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/alarm"
              }
            }
          },
          "description": "Alarma registrada"
        }
      }
    },
    "/moi/record": {
      "post": {
        "tags": [
          "BMS"
        ],
        "summary": "Informa de un registro",
        "operationId": "addRecord",
        "description": "Añade un registro de consumo / nivel disponible de fluidos o energia.",
        "responses": {
          "200": {
            "description": "Registro exitoso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/generalError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/recordBMS"
              }
            }
          },
          "description": "Registro a reportar"
        }
      }
    },
    "/aseo/request": {
      "post": {
        "tags": [
          "Aseo"
        ],
        "summary": "Solicita un servicio de aseo por alta, cambio de ubicación del paciente",
        "operationId": "cleanRequest",
        "description": "Se genera una solicitud de servicio de aseo",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/generalError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/cleanRequest"
              }
            }
          },
          "description": "Solicitud de Aseo"
        }
      }
    },
    "/estacionamiento/entry": {
      "post": {
        "tags": [
          "Estacionamiento"
        ],
        "summary": "Solicita autoriación para el ingreso de una placa patente al estacionamiento",
        "operationId": "parkingEntry",
        "description": "Solicita autoriación para el ingreso de una placa patente al estacionamiento",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalResponse"
                },
                "examples": {
                  "acceso_autorizado": {
                    "summary": "Acceso autorizado",
                    "value": {
                      "ok": true,
                      "doc": null,
                      "signature": "980ea72542a0048c135d49d7a75fe29b09a9bb96"
                    }
                  },
                  "acceso_denegado": {
                    "summary": "Acceso denegado",
                    "value": {
                      "ok": false,
                      "err": "Mensaje realacionado con el error",
                      "signature": "980ea72542a0048c135d49d7a75fe29b09a9bb96"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/generalError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/parking"
              }
            }
          },
          "description": "Solicitud de Ingreso"
        }
      }
    },
    "/estacionamiento/exit": {
      "post": {
        "tags": [
          "Estacionamiento"
        ],
        "summary": "Informa el egreso de una placa patente al estacionamiento",
        "operationId": "parkingExit",
        "description": "Informa el egreso de una placa patente al estacionamiento",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/generalError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/parking"
              }
            }
          },
          "description": "Informe del egreso o salida"
        }
      }
    },
    "/dotacion/entry": {
      "post": {
        "tags": [
          "Dotación"
        ],
        "summary": "Informa el Ingreso de un empledo",
        "operationId": "personalEntry",
        "description": "Registra el ingreso a las instalaciones de un empleado de la SC Permite es registro de entreadas y salidas del personal",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/generalError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/employeeMark"
              }
            }
          },
          "description": "Informe de Ingreso"
        }
      }
    },
    "/dotacion/exit": {
      "post": {
        "tags": [
          "Dotación"
        ],
        "summary": "Informa el egreso de de un empledo",
        "operationId": "personalExit",
        "description": "Informa el egreso o salida a las instalaciones de un empleado de la SC",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/generalResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/generalError"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/employeeMark"
              }
            }
          },
          "description": "Informe del egreso o salida"
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "generalError": {
        "type": "string",
        "example": "Unauthorized"
      },
      "generalResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "string",
            "example": true,
            "description": "Devuelve valores booleanos true o false, en el caso de false se devuelve tambien err y en true doc null"
          },
          "err": {
            "type": "string",
            "example": "Mensaje realacionado con el error",
            "description": "Solo de retorna si ok=false"
          },
          "doc": {
            "type": "string",
            "example": null,
            "description": "Solo de retorna si ok=true"
          },
          "signature": {
            "type": "string",
            "example": "980ea72542a0048c135d49d7a75fe29b09a9bb96",
            "description": "Id de la transacción"
          }
        }
      },
      "pacient": {
        "type": "object",
        "required": [
          "evento",
          "num_trak",
          "nombres",
          "estado_episodio",
          "salahosp",
          "numepisodio"
        ],
        "properties": {
          "evento": {
            "type": "string",
            "example": "HOS",
            "description": "Código que indica el evento del paciente. Los posibles valores son: <br> HOS: Hospitalizado <br> URG: Urgencia <br> AMB: Ambulatorio <br>"
          },
          "tipo_paciente": {
            "type": "string",
            "example": "ID",
            "description": "Código que indica si el paciente es identificable. Los posibles valores son:<br>\nID: Identificable <br>\nPN: No Identificable <br>\nRN: Recién Nacido <br>\nSD: Sin Documentación\n"
          },
          "rut_paciente": {
            "type": "string",
            "example": "12488347-4",
            "description": "Rut del paciente sin puntos, con guión y dígito verificador."
          },
          "pasaporte": {
            "type": "string",
            "description": "Pasaporte del paciente."
          },
          "descripcion_paciente": {
            "type": "string",
            "description": "Descripción física del paciente o cualquier información asociada al paciente."
          },
          "num_trak": {
            "type": "string",
            "description": "ID del HIS asignado al paciente. Es único e irrepetible."
          },
          "nombres": {
            "type": "string",
            "description": "Nombres del paciente."
          },
          "apellido_paterno": {
            "type": "string",
            "description": "Primer apellido del paciente o apellido paterno."
          },
          "apellido_materno": {
            "type": "string",
            "description": "Segundo apellido del paciente o apellido materno."
          },
          "sexo": {
            "type": "string",
            "example": "M",
            "description": "Código para identificar el genero del paciente: <br> M: Masculino <br> F: Femenino <br> I: Intersex <br> D: Desconocido <br>"
          },
          "numepisodio": {
            "type": "string",
            "description": "N° de episodio en el HIS.",
            "example": "H0000262609"
          },
          "establecimiento_referencia": {
            "type": "string",
            "example": 112100,
            "description": "Código de Establecimiento <br> 112100: Hospital del Salvador <br> 112106: Instituto Nacional de Geriatría"
          },
          "servhosp": {
            "$ref": "#/components/schemas/hospitalService"
          },
          "salahosp": {
            "$ref": "#/components/schemas/hospitalRoom"
          },
          "camahosp": {
            "$ref": "#/components/schemas/hospitalBed"
          },
          "estado_episodio": {
            "type": "string",
            "example": "A",
            "description": "Estado del paciente (para indicar si fue dado de alta). Los posibles valores son: <br> A: Actual (está en el servicio clinico) <br> C: Cancelado (fue ingresado por error) <br> D: Egreso (dado de alta administrativa... el paciente ha desocupado la cama)"
          },
          "diag_principal": {
            "type": "object",
            "description": "Código del diagnostico",
            "example": "M15.2"
          }
        }
      },
      "pacientLocation": {
        "type": "object",
        "required": [
          "num_trak",
          "estado_episodio",
          "numepisodio",
          "salahosp"
        ],
        "properties": {
          "num_trak": {
            "type": "string",
            "description": "ID del HIS asignado al paciente. Es único e irrepetible."
          },
          "numepisodio": {
            "type": "string",
            "description": "N° de episodio en el HIS."
          },
          "servdestino": {
            "$ref": "#/components/schemas/hospitalService"
          },
          "salahosp": {
            "$ref": "#/components/schemas/hospitalRoom"
          },
          "camadestino": {
            "$ref": "#/components/schemas/hospitalBed"
          },
          "estado_episodio": {
            "type": "string",
            "example": "A",
            "description": "Estado del paciente (para indicar si fue dado de alta). Los posibles valores son: <br> A: Actual (está en el servicio clinico) <br> C: Cancelado (fue ingresado por error) <br> D: Egreso (dado de alta administrativa... el paciente ha desocupado la cama)"
          }
        }
      },
      "prescription": {
        "type": "object",
        "required": [
          "evento",
          "tipo_paciente",
          "num_trak",
          "nombres",
          "apellido_paterno",
          "sexo",
          "fecha_nacimiento",
          "numepisodio",
          "estado_episodio",
          "rutprofsol",
          "nomprofsol",
          "apatprofsol",
          "fecha_oden",
          "hora_orden",
          "codigo_regimen_alimentario",
          "regimen_alimentario",
          "establecimiento_referencia",
          "camahosp",
          "salahosp",
          "isolation",
          "estado_de_la_orden",
          "requestState",
          "numero_solicitud"
        ],
        "properties": {
          "evento": {
            "type": "string",
            "example": "HOS",
            "description": "Código que indica el evento del paciente. Los posibles valores son: <br> HOS: Hospitalizado <br> URG: Urgencia <br> AMB: Ambulatorio <br>"
          },
          "tipo_paciente": {
            "type": "string",
            "example": "ID",
            "description": "Código que indica si el paciente es identificable. Los posibles valores son:<br>\nID: Identificable <br>\nPN: No Identificable <br>\nRN: Recién Nacido <br>\nSD: Sin Documentación\n"
          },
          "rut_paciente": {
            "type": "string",
            "example": "12488347-4",
            "description": "Rut del paciente sin puntos, con guión y dígito verificador."
          },
          "pasaporte": {
            "type": "string",
            "description": "Pasaporte del paciente."
          },
          "descripcion_paciente": {
            "type": "string",
            "description": "Descripción física del paciente o cualquier información asociada al paciente."
          },
          "num_trak": {
            "type": "string",
            "description": "ID del HIS asignado al paciente. Es único e irrepetible."
          },
          "nombres": {
            "type": "string",
            "description": "Nombres del paciente."
          },
          "apellido_paterno": {
            "type": "string",
            "description": "Primer apellido del paciente o apellido paterno."
          },
          "apellido_materno": {
            "type": "string",
            "description": "Segundo apellido del paciente o apellido materno."
          },
          "sexo": {
            "type": "string",
            "example": "M",
            "description": "Código para identificar el genero del paciente: <br> M: Masculino <br> F: Femenino <br> I: Intersex <br> D: Desconocido <br>"
          },
          "numepisodio": {
            "type": "string",
            "description": "N° de episodio en el HIS.",
            "example": "H0000262609"
          },
          "establecimiento_referencia": {
            "type": "string",
            "example": 112100,
            "description": "Código de Establecimiento <br> 112100: Hospital del Salvador <br> 112106: Instituto Nacional de Geriatría"
          },
          "servhosp": {
            "$ref": "#/components/schemas/hospitalService"
          },
          "salahosp": {
            "$ref": "#/components/schemas/hospitalRoom"
          },
          "camahosp": {
            "$ref": "#/components/schemas/hospitalBed"
          },
          "estado_episodio": {
            "type": "string",
            "example": "A",
            "description": "Estado del paciente (para indicar si fue dado de alta). Los posibles valores son: <br> A: Actual (está en el servicio clinico) <br> C: Cancelado (fue ingresado por error) <br> D: Egreso (dado de alta administrativa... el paciente ha desocupado la cama)"
          },
          "diag_principal": {
            "type": "object",
            "description": "Código del diagnostico",
            "example": "M15.2"
          },
          "rutprofsol": {
            "type": "string",
            "example": "12488347-4",
            "description": "RUT del profesional solicitante sin puntos, con guión y dígito verificador."
          },
          "nomprofsol": {
            "type": "string",
            "description": "Nombres del profesional solicitante ."
          },
          "apatprofsol": {
            "type": "string",
            "description": "Primer apellido del profesional solicitante o apellido paterno."
          },
          "apmatprofsol": {
            "type": "string",
            "description": "Segundo apellido del profesional solicitante o apellido materno."
          },
          "fecha_nacimiento": {
            "type": "string",
            "format": "date",
            "example": "1985-08-29",
            "description": "Fecha de Nacimineto Paciente"
          },
          "fecha_oden": {
            "type": "string",
            "format": "date",
            "example": "2022-08-29",
            "description": "Fecha de Solicitud de indicación"
          },
          "hora_orden": {
            "type": "string",
            "format": "time",
            "example": "09:12",
            "description": "Hora de Solicitud de indicación"
          },
          "codigo_regimen_alimentario": {
            "type": "string",
            "example": "02",
            "description": "Código del régimen alimentario. Permite saber el tipo de régimen. <br>\n01  Básico <br>\n02  Completo <br>\n03  Liviano <br>\n04  Blando <br>\n05  Sin Residuos <br>\n06  Líquido <br>\n07  Líquido - Frío <br>\n08  Especial - Hídrico <br>\n09  Especial - Hiperglusídico <br>\n10  Especial - Hipercalórico <br>\n11  Especial - Hiperproteico <br>\n12  Especial - Hiposódico <br>\n13  Especial - Diabético <br>\n"
          },
          "regimen_alimentario": {
            "type": "string",
            "description": "Descripción del régimen alimentario."
          },
          "consistencia": {
            "type": "string",
            "description": "Descripción del la consistencia."
          },
          "condiciones_alimentacion": {
            "type": "string",
            "description": "Condiciones del régimen alimentario."
          },
          "alerts": {
            "$ref": "#/components/schemas/foodAlerts"
          },
          "aislamiento": {
            "type": "string",
            "example": "S",
            "description": "Indica si el paciente esta en aislamiento. Los posibles valores son: S: Está en aislamiento N: No está en aislamiento "
          },
          "numero_solicitud": {
            "type": "string",
            "description": "N° de Solicitud en el HIS.",
            "example": 50162662
          },
          "estado_de_la_orden": {
            "type": "string",
            "example": "V",
            "description": "Código del Estado de la solicitud V: solicitado D: Suspendido IP: en atención E: ejecutado"
          },
          "peso": {
            "type": "string",
            "description": "Peso del paciente."
          },
          "talla": {
            "type": "string",
            "description": "Altura o talla del paciente."
          },
          "imc": {
            "type": "string",
            "example": 18.5,
            "description": "% índice de masa coproral"
          }
        }
      },
      "cleanRequest": {
        "type": "object",
        "required": [
          "rutRequester",
          "date",
          "institution",
          "hospitalService",
          "hospitalRoom",
          "hospitalBed",
          "cleantype",
          "requestState"
        ],
        "properties": {
          "rutRequester": {
            "type": "string",
            "example": "12488347-4",
            "description": "RUT del profesional solicitante sin puntos, con guión y dígito verificador."
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2016-08-29T09:12:33Z",
            "description": "Fecha de Solicitud"
          },
          "institution": {
            "$ref": "#/components/schemas/institution"
          },
          "hospitalService": {
            "$ref": "#/components/schemas/hospitalService"
          },
          "hospitalRoom": {
            "$ref": "#/components/schemas/hospitalRoom"
          },
          "hospitalBed": {
            "$ref": "#/components/schemas/hospitalBed"
          },
          "cleantype": {
            "type": "string",
            "example": "02",
            "description": "Tipo de Solicitud de Aseo <br> 01: tipo I Regular <br>02: tipo II Terminal (Este es unico valido desde el HIS) <br>03: tipo III Regular <br>04: tipo III Terminal <br>"
          },
          "requestState": {
            "type": "string",
            "example": "V",
            "description": "Código del Estado de la solicitud V: solicitado D: Suspendido IP: en atención E: ejecutado"
          },
          "comments": {
            "type": "string",
            "description": "Texto libre con comentarios asociados a esta solicitud"
          }
        }
      },
      "foodAlert": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "001"
          },
          "name": {
            "type": "string",
            "example": "No Sal"
          }
        }
      },
      "foodAlerts": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/foodAlert"
        },
        "example": [
          {
            "name": "No Sal",
            "code": "001"
          },
          {
            "name": "No Azucar",
            "code": "003"
          }
        ]
      },
      "recordBMS": {
        "type": "object",
        "required": [
          "type",
          "description",
          "recordType",
          "value",
          "date"
        ],
        "properties": {
          "type": {
            "type": "string",
            "example": "fluido",
            "description": "Valores: fluido, energia"
          },
          "description": {
            "type": "string",
            "example": "Combustible diesel planta de eneregia"
          },
          "recordType": {
            "type": "string",
            "example": "consumo",
            "description": "Valores: consumo, disponible"
          },
          "value": {
            "type": "string",
            "example": "50 litros"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2016-08-29T09:12:33Z"
          },
          "comments": {
            "type": "string",
            "description": "Cualquier texto adicional que se requiera enviar"
          }
        }
      },
      "alarm": {
        "type": "object",
        "required": [
          "id",
          "building",
          "floor",
          "object",
          "date"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "d290f1ee-6c54-4b01-90e6-d701748f0851"
          },
          "building": {
            "type": "string",
            "example": "HDS",
            "description": "Los valores validos para building serian HDS, ING, AA"
          },
          "floor": {
            "type": "string",
            "example": -2
          },
          "system": {
            "type": "string",
            "example": "Mantenimiento y Operación de Instalaciones y Equipamiento del Sistema Térmico, Climatización, Refrigeración, Sistema Geotérmico y Gas Combustible"
          },
          "subSystem": {
            "type": "string",
            "example": "Informe Diario de Consumo de Fluidos o de Energía"
          },
          "responsable": {
            "type": "string",
            "example": "Compañia de mantentenimiento 123 c.a."
          },
          "object": {
            "$ref": "#/components/schemas/alarmObject"
          },
          "subObjects": {
            "$ref": "#/components/schemas/alarmObjects"
          },
          "signal": {
            "type": "string",
            "example": "Temperatura"
          },
          "type": {
            "type": "string",
            "example": "HiHi"
          },
          "priority": {
            "type": "string",
            "example": 50
          },
          "value": {
            "type": "string",
            "example": "70°"
          },
          "name": {
            "type": "string",
            "example": "Nombre de la alarma"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2016-08-29T09:12:33Z"
          }
        }
      },
      "alarmObject": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "UMA del sistema de clima"
          },
          "code": {
            "type": "string",
            "example": "moi-hds-uma-01"
          }
        }
      },
      "alarmObjects": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/alarmObject"
        },
        "example": {
          "Object1": {
            "name": "Sensor temperatura",
            "code": "moi-hds-uma-01.01"
          },
          "Object2": {
            "name": "Timer",
            "code": "moi-hds-uma-01.0e"
          }
        }
      },
      "institution": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": 112100
          },
          "name": {
            "type": "string",
            "example": "Hospital del Salvador"
          }
        },
        "description": "Código de Establecimiento <br> 112100: Hospital del Salvador <br> 112106: Instituto Nacional de Geriatría"
      },
      "hospitalService": {
        "type": "string",
        "example": "AINHSO",
        "description": "Código del Servicio Clínico asociado a la hospitalización y Descripción código servicio clínico"
      },
      "hospitalRoom": {
        "type": "object",
        "example": "string",
        "description": "Descripción de la Sala o cuarto del paciente"
      },
      "hospitalBed": {
        "type": "object",
        "example": "string",
        "description": "Descripción de la cama, sillon u otro para la ubicación especifica del paciente el la sala o cuarto en que se encuentra"
      },
      "parking": {
        "type": "object",
        "required": [
          "patente",
          "freeParkingSpaces"
        ],
        "properties": {
          "patente": {
            "type": "string",
            "description": "Informacion de la placa patente",
            "example": "HPBG12"
          },
          "freeParkingSpaces": {
            "type": "number",
            "description": "Cantidad de puestos de estacionamientos para funcionarios disponibles",
            "example": 23
          }
        }
      },
      "employeeMark": {
        "type": "object",
        "required": [
          "rut",
          "name",
          "company",
          "service",
          "date"
        ],
        "properties": {
          "rut": {
            "type": "string",
            "description": "Rut del empleado",
            "example": "13228429-6"
          },
          "name": {
            "type": "string",
            "description": "Nombre del empleado"
          },
          "company": {
            "type": "string",
            "description": "Nombre del la empresa a la que presta servicio"
          },
          "service": {
            "type": "string",
            "description": "Servico concesionado los posibles valores son: <ul> <li>moi</li> <li>adquisicionEquipo</li> <li>aseo</li> <li>alimentacionPacientes</li> <li>alimentacionFuncionarios</li> <li>equipoMedico</li> <li>ropa</li> <li>elementoTecnologico</li> <li>residuosHospitalarios</li> <li>Estacionamiento</li> <li>mobiliario</li> <li>adquisicionMobiliario</li> <li>controlVectores</li> <li>seguridad</li> <li>cafeteria</li> <li>concesionaria</li> </ul>",
            "example": "aseo"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2016-08-29T09:12:33Z",
            "description": "Hora y fecha en que se registro la marca"
          }
        }
      },
      "healthEmployeeMark": {
        "type": "object",
        "required": [
          "rut",
          "date"
        ],
        "properties": {
          "rut": {
            "type": "string",
            "description": "Rut del Funcionario",
            "example": "13228429-6"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2016-08-29T09:12:33Z",
            "description": "Hora y fecha en que se registro la marca"
          }
        }
      }
    }
  }
}
