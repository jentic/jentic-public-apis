{
  "openapi": "3.1.0",
  "info": {
    "title": "Cohesivity Agent Control API",
    "version": "1.0.0",
    "description": "Machine-readable discovery contract for tenant bootstrap and common control-plane operations. Offering-specific request and response contracts are published in the external agent documentation."
  },
  "servers": [
    {
      "url": "https://cohesivity.ai"
    }
  ],
  "externalDocs": {
    "description": "Full Cohesivity agent reference",
    "url": "https://cohesivity.ai/llms-full.txt"
  },
  "x-versioning": {
    "current": "1",
    "requestHeader": "API-Version",
    "deprecationPolicy": "https://cohesivity.ai/docs/versioning",
    "runtimeProfiles": "https://cohesivity.ai/docs/versioning",
    "operationScopes": {
      "front-door": "Always executes on the current shared front door.",
      "profile-aware": "May execute on the tenant-pinned runtime or the current front door according to the resource and runtime capability rules."
    }
  },
  "tags": [
    {
      "name": "Bootstrap",
      "description": "Create an ephemeral project tenant through the supported installer flow."
    },
    {
      "name": "Resources",
      "description": "Provision and remove tenant infrastructure resources."
    },
    {
      "name": "Tenant",
      "description": "Read tenant state and complete account or human handoffs."
    },
    {
      "name": "MCP",
      "description": "Use the one public Cohesivity MCP server for documentation and management, with optional account OAuth."
    },
    {
      "name": "Discovery",
      "description": "Read unauthenticated service liveness and discovery metadata."
    }
  ],
  "paths": {
    "/api/genesis": {
      "post": {
        "operationId": "createEphemeralTenant",
        "summary": "Create a 72-hour ephemeral tenant",
        "description": "Unauthenticated, and not called directly: use `npx @cohesivity/init` or `curl -fsSL /quickstart.sh | bash`, which handle attribution and idempotency. Listed for completeness. A `User-Agent` containing `curl` is rejected with `403` and reason `bannedUserAgent`.",
        "tags": [
          "Bootstrap"
        ],
        "security": [],
        "parameters": [
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Set to `json` to request the structured representation. `Accept: application/json` is equivalent.",
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Tenant credentials and agent directives",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenesisResponse"
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/ApiVersion"
              },
              "Link": {
                "$ref": "#/components/headers/VersioningPolicyLink"
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/RestError"
          },
          "429": {
            "$ref": "#/components/responses/RestError"
          }
        },
        "x-cohesivity-runtime-scope": "front-door"
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/api/resources": {
      "post": {
        "operationId": "provisionResources",
        "summary": "Provision multiple tenant resources",
        "description": "Provisions the requested resource set in dependency order for the authenticated tenant. Each item reports its own active or failed result; a mixed result returns HTTP 207.",
        "tags": [
          "Resources"
        ],
        "security": [
          {
            "managementKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "resources"
                ],
                "properties": {
                  "resources": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/components/schemas/ResourceName"
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-resource provisioning results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkProvisionResponse"
                }
              }
            },
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/ApiVersion"
              },
              "Link": {
                "$ref": "#/components/headers/VersioningPolicyLink"
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "207": {
            "description": "Provisioning completed with one or more per-resource failures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkProvisionResponse"
                }
              }
            },
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/ApiVersion"
              },
              "Link": {
                "$ref": "#/components/headers/VersioningPolicyLink"
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/RestError"
          },
          "401": {
            "$ref": "#/components/responses/RestError"
          },
          "500": {
            "$ref": "#/components/responses/RestError"
          }
        },
        "x-cohesivity-runtime-scope": "profile-aware"
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/api/resources/{resourceName}": {
