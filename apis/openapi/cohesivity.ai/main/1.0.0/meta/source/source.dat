            "name": "create_tenant",
            "title": "Create tenant",
            "description": "Cohesivity gives an app managed backend resources and third-party APIs (Postgres, Redis, object storage, social login, realtime, AI and data APIs) through one tenant with one set of credentials. Call this first when the project has no .cohesivity file; the other tools need the tenant_id it returns. Create an owned claimed tenant for an account, or an ephemeral tenant for a guest. Retries with the same idempotency key return the same tenant and credentials. Write credentials_file.content verbatim to .cohesivity in the current project, with private permissions (0600), and add .cohesivity to .gitignore. Never overwrite credentials for a different tenant without user approval. Do not print the contents in chat or logs or commit them. If this client cannot write files, say the file was not saved and offer the optional protected browser download. The hosted server cannot write the client filesystem itself. This authorized response contains project secrets and may be retained in the client tool history.",
            "scope": "mcp:tenants:create",
            "inputSchema": {
              "type": "object",
              "required": [
                "idempotency_key",
                "confirmed"
              ],
              "properties": {
                "idempotency_key": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 128
                },
                "confirmed": {
                  "type": "boolean",
                  "enum": [
                    true
                  ],
                  "description": "Set to true only when the current user request explicitly authorized this exact mutation."
                }
              },
              "additionalProperties": false
            },
            "outputSchema": {
              "type": "object",
              "required": [
                "tenant_id",
                "credentials_file"
              ],
              "properties": {
                "tenant_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$",
                  "description": "Required explicit tenant id. Use the tenant_id that create_tenant returned, or the one in the project .cohesivity file. Account connections are not bound to a tenant; access is checked for every call."
                },
                "tenant_lifecycle": {
                  "type": "string",
                  "enum": [
                    "ephemeral",
                    "claimed"
                  ]
                },
                "runtime_profile": {
                  "type": "string"
                },
                "expires_at": {
                  "type": "string"
                },
                "credentials_download_url": {
                  "type": "string"
                },
                "credentials_file": {
                  "type": "object",
                  "required": [
                    "filename",
                    "content"
                  ],
                  "properties": {
                    "filename": {
                      "type": "string",
                      "const": ".cohesivity"
                    },
                    "content": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "annotations": {
              "readOnlyHint": false,
              "destructiveHint": false,
              "idempotentHint": false,
              "openWorldHint": true
            }
          },
          {
