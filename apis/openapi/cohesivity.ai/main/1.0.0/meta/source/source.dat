    "/mcp/tenants/{tenant_id}/credentials": {
      "get": {
        "operationId": "downloadMcpTenantCredentials",
        "summary": "Download a private project credentials file in the authorized browser",
        "description": "The credentials_download_url from OAuth create_tenant is an address, not a bearer capability. It is an optional fallback for OAuth clients with no writable workspace, not a prerequisite for coding clients that save the authorized hosted create_tenant credentials_file response. Public creation returns no browser download URL. Download requires the legacy consent browser guest cookie for its own active, unexpired, still-ephemeral tenant, or an account session that currently owns the active claimed tenant. Guest access ends after claim; reconnect with the owning account. OAuth bearer tokens, tenant keys, and the URL alone do not authorize download. Query strings and cross-site fetches are rejected. Save the secret attachment verbatim as a gitignored .cohesivity file with mode 0600, without overwriting a different tenant; never print it in chat, logs, or source, or commit it.",
        "tags": [
          "MCP"
        ],
        "security": [
          {
            "cohesivitySession": []
          },
          {
            "mcpGuestSession": []
          }
        ],
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,40}$"
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/CredentialsFile"
          },
          "404": {
            "description": "Credentials unavailable; authentication and ownership failures do not disclose tenant existence",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "x-cohesivity-runtime-scope": "front-door"
      }
    },
    "/api/mcp/bootstrap": {
      "post": {
        "operationId": "bootstrapAccountProject",
        "summary": "Write account-owned project credentials through the installed local bootstrap",
        "description": "Private account-token-only file API used by the installed local quickstart. Requires an account OAuth token for the /mcp resource, the mcp:tenants:create scope, confirmed: true, and an idempotency_key. Creates and atomically claims an owned tenant with no expiry, or reuses the same authorized idempotent creation. Returns secrets only as a private .cohesivity attachment for direct local-file storage, never as an MCP tool result. Guest tokens and invalid or expired account tokens fail closed; never downgrade to guest. Plain guest quickstart continues to use /api/genesis.",
        "tags": [
          "MCP"
        ],
        "security": [
          {
            "mcpOAuth": [
              "mcp:tenants:create"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "idempotency_key",
                  "confirmed"
                ],
                "properties": {
                  "idempotency_key": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  },
                  "confirmed": {
                    "type": "boolean",
                    "enum": [
                      true
                    ],
                    "description": "Set to true only when the current user request explicitly authorized this exact mutation."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/CredentialsFile"
          },
          "201": {
            "$ref": "#/components/responses/CredentialsFile"
          },
          "400": {
            "$ref": "#/components/responses/McpError"
          },
          "401": {
            "$ref": "#/components/responses/McpError"
          },
          "403": {
            "$ref": "#/components/responses/McpError"
          },
          "405": {
            "description": "Only POST is accepted; the response has no body",
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/ApiVersion"
              },
              "Link": {
                "$ref": "#/components/headers/VersioningPolicyLink"
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              },
              "Allow": {
                "schema": {
                  "type": "string",
                  "const": "POST"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/McpError"
          },
          "500": {
            "$ref": "#/components/responses/McpError"
          },
          "503": {
            "$ref": "#/components/responses/McpError"
          }
        },
        "x-cohesivity-runtime-scope": "front-door"
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/oauth/authorize": {
      "get": {
        "operationId": "authorizeManagementMcp",
        "summary": "Review and approve management MCP access",
        "description": "Optional OAuth consent requires authorization code, exact redirect URI, RFC 8707 resource, explicit scopes, and PKCE S256. Account sign-in is the default: use an existing account session, or redirect to Google account sign-in when none exists. Account connections link directly to the Cohesivity account, including one with zero tenants, without tenant selection. Account grants are account-scoped; each tenant tool requires an explicit tenant_id and checks current access. Explicit guest=true is legacy compatibility only and permits a temporary 72-hour guest identity. account_required=true requires account sign-in, including for optional local CLI login.",
        "tags": [
          "MCP"
        ],
        "security": [],
        "parameters": [
          {
            "name": "response_type",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "const": "code"
            }
          },
          {
            "name": "client_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "scope",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 43,
              "maxLength": 128
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "const": "S256"
            }
          },
          {
            "name": "resource",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          {
            "name": "account_required",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "guest",
            "in": "query",
            "required": false,
            "description": "Legacy guest compatibility only; new OAuth sign-in uses an account by default.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Guest or account-scoped consent page without tenant selection",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "302": {
            "$ref": "#/components/responses/OAuthRedirect"
          },
          "400": {
            "$ref": "#/components/responses/OAuthError"
          },
          "500": {
            "$ref": "#/components/responses/OAuthError"
          }
        },
        "x-cohesivity-runtime-scope": "front-door"
      },
      "post": {
        "operationId": "approveManagementMcp",
        "summary": "Approve or deny management MCP access",
        "description": "Consumes signed one-use approval state bound to the consent browser, records a guest or account-scoped grant without tenant selection, and redirects to the exact registered client URI. Tenant tools require an explicit tenant_id and check current ownership or guest-creation access; guest grants expire within their 72-hour identity lifetime.",
        "tags": [
          "MCP"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/OAuthApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "302": {
            "$ref": "#/components/responses/OAuthRedirect"
          },
          "400": {
            "$ref": "#/components/responses/OAuthError"
          },
          "403": {
            "$ref": "#/components/responses/OAuthError"
          },
          "500": {
            "$ref": "#/components/responses/OAuthError"
          }
        },
        "x-cohesivity-runtime-scope": "front-door"
      }
    },
    "/oauth/token": {
      "post": {
        "operationId": "exchangeManagementMcpToken",
        "summary": "Exchange a code or rotate a refresh token",
        "description": "Public-client token endpoint. Authorization codes require PKCE S256. Refresh tokens rotate transactionally and replay revokes the token family.",
        "tags": [
          "MCP"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/OAuthTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Short-lived access token and rotating refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthTokenResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/OAuthError"
          },
          "429": {
            "$ref": "#/components/responses/OAuthError"
          },
          "500": {
            "$ref": "#/components/responses/OAuthError"
          },
          "503": {
            "$ref": "#/components/responses/OAuthError"
          }
        },
        "x-cohesivity-runtime-scope": "front-door"
      }
    },
    "/oauth/register": {
      "post": {
        "operationId": "registerManagementMcpClient",
        "summary": "Dynamically register a public MCP OAuth client",
        "description": "Accepts exact HTTPS redirect URIs and loopback HTTP callbacks. Wildcards, fragments, embedded credentials, and confidential-client authentication are rejected.",
        "tags": [
          "MCP"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OAuthClientRegistrationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Public client registration without a client secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthClientRegistrationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/OAuthError"
          },
          "429": {
            "$ref": "#/components/responses/OAuthError"
          },
          "500": {
            "$ref": "#/components/responses/OAuthError"
          },
          "503": {
            "$ref": "#/components/responses/OAuthError"
          }
        },
        "x-cohesivity-runtime-scope": "front-door"
      }
    },
    "/oauth/revoke": {
      "post": {
        "operationId": "revokeManagementMcpToken",
        "summary": "Revoke an MCP access token or refresh-token family",
        "description": "Accepts an access or refresh token, revokes the matching token or family when found, and returns the same empty success for unknown tokens.",
        "tags": [
          "MCP"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/OAuthRevocationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent revocation completed without a response body",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/OAuthError"
          },
          "429": {
            "$ref": "#/components/responses/OAuthError"
          },
          "500": {
            "$ref": "#/components/responses/OAuthError"
          },
          "503": {
            "$ref": "#/components/responses/OAuthError"
          }
        },
        "x-cohesivity-runtime-scope": "front-door"
      }
    },
    "/health": {
      "get": {
        "operationId": "getFrontDoorLiveness",
        "summary": "Check front-door liveness",
        "description": "Confirms that the shared edge front door can execute requests; it does not claim that databases or upstream providers are healthy.",
        "tags": [
          "Discovery"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "The shared front door is answering requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "service",
                    "scope"
                  ],
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "const": "cohesivity-frontdoor"
                    },
                    "scope": {
                      "const": "front-door-liveness"
                    }
                  }
                }
              }
            }
          }
        },
        "x-cohesivity-runtime-scope": "front-door"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "managementKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Use the literal value `Bearer <coh_man_...>` from the tenant .cohesivity file. This is a Cohesivity API key, not an OAuth access token."
      },
      "cohesivitySession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "coh_user_session",
        "description": "Authenticated Cohesivity owner session used by the human account surface."
      },
      "mcpGuestSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-mcp_guest",
        "description": "Private HttpOnly Secure SameSite=Lax cookie issued to the consent browser for a 72-hour guest identity. It authorizes downloads only for that guest's active, unexpired, still-ephemeral creations; it never grants account ownership."
      },
      "waitToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Use the literal Bearer value returned with a Cohesivity wait descriptor."
      },
      "mcpOAuth": {
        "type": "oauth2",
        "description": "Optional OAuth 2.1 authorization code flow with mandatory PKCE S256 and RFC 8707 resource binding to /mcp. Tokens bound to the retired /mcp/manage resource are rejected; sign in again. New sign-in defaults to an account. A legacy guest identity lasts 72 hours and can access only its still-ephemeral creations. Account grants cover currently owned claimed tenants. Access is revalidated per call; invalid tokens never fall back to public or guest access. Only account tokens with mcp:tenants:create may also use the private /api/mcp/bootstrap file API.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://cohesivity.ai/oauth/authorize",
            "tokenUrl": "https://cohesivity.ai/oauth/token",
            "refreshUrl": "https://cohesivity.ai/oauth/token",
            "scopes": {
              "mcp:tenants:create": "Authorize tenants create management operations within the guest or account grant.",
              "mcp:tenant:read": "Authorize tenant read management operations within the guest or account grant.",
              "mcp:resources:write": "Authorize resources write management operations within the guest or account grant.",
              "mcp:feedback:write": "Authorize feedback write management operations within the guest or account grant."
            }
          }
        }
      }
    },
    "parameters": {
      "ApiVersion": {
        "name": "API-Version",
        "in": "header",
        "required": false,
        "description": "Public REST compatibility major. Omit the header or send 1; other values return HTTP 400 before authentication or mutation.",
        "schema": {
          "type": "string",
          "const": "1",
          "default": "1"
        }
      }
    },
    "headers": {
      "ApiVersion": {
        "description": "Public REST compatibility major used for this response.",
        "schema": {
          "type": "string",
          "const": "1"
        }
      },
      "Deprecation": {
        "description": "RFC 9745 deprecation timestamp. Present only when this specific surface is deprecated.",
        "schema": {
          "type": "string",
          "pattern": "^@[0-9]+$"
        }
      },
      "Sunset": {
        "description": "RFC 8594 planned removal date in HTTP-date form. Present only after a removal date is scheduled.",
        "schema": {
          "type": "string",
          "example": "Wed, 11 Nov 2026 23:59:59 GMT"
        }
      },
      "VersioningPolicyLink": {
        "description": "Link to the REST versioning and deprecation policy. Deprecated operations additionally use rel=\"deprecation\".",
        "schema": {
          "type": "string",
          "example": "<https://cohesivity.ai/docs/versioning>; rel=\"describedby\""
        }
      },
      "RateLimit": {
        "description": "Current quota state using draft-ietf-httpapi-ratelimit-headers-11 and RFC 9651 Structured Fields syntax. The `r` parameter is the available quota, and `t` is the effective window in seconds within which the client can use no more than that quota. It is not a quota-restoration promise; `Retry-After` carries any retry delay.",
        "schema": {
          "type": "string",
          "example": "\"genesis-ip\";r=9;t=60"
        }
      },
      "RateLimitPolicy": {
        "description": "Named quota and window using the IETF HTTPAPI RateLimit draft and RFC 9651 Structured Fields syntax when a route evaluates a known rate limit.",
        "schema": {
          "type": "string",
          "example": "\"genesis-ip\";q=10;w=60"
        }
      },
      "RetryAfter": {
        "description": "Seconds the client should wait before retrying a transient rate-limited request.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "McpProtocolVersion": {
        "description": "MCP protocol version used by the Streamable HTTP exchange.",
        "schema": {
          "type": "string",
          "enum": [
            "2025-03-26",
            "2025-06-18",
            "2025-11-25"
          ]
        }
      }
    },
    "schemas": {
      "CohesivityCredentialsFile": {
        "type": "string",
        "description": "Secret .cohesivity project file containing tenant_id, coh_management_key, coh_application_key, expires_at, tenant_lifecycle, and runtime_profile. Store locally outside source control; authorized hosted create_tenant is the sole secret-bearing MCP response exception. Local MCP output remains metadata-only. Claimed tenants have no expiry."
      },
      "GenesisResponse": {
        "type": "object",
        "required": [
          "tenant_id",
          "coh_management_key",
          "coh_application_key"
        ],
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "coh_management_key": {
            "type": "string",
            "description": "Secret tenant management key returned only by tenant creation."
          },
          "coh_application_key": {
            "type": "string",
            "description": "Secret tenant application key returned only by tenant creation."
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      },
      "ResourceName": {
        "type": "string",
        "enum": [
          "openweather-api",
          "google-geocoding-api",
          "exa-api",
          "openai-api",
          "ai-gateway",
          "deepgram-api",
          "inbox",
          "postgres",
          "redis",
          "object-storage",
          "vector-database",
          "railway-hosting",
          "cloudflare-workers",
          "social-login",
          "realtime",
          "steel-browser"
        ],
        "description": "A currently provisionable resource slug. Read its /offerings/<slug> reference before supplying configuration."
      },
      "TeardownResourceName": {
        "type": "string",
        "enum": [
          "openweather-api",
          "google-geocoding-api",
          "exa-api",
          "openai-api",
          "ai-gateway",
          "deepgram-api",
          "resend-api",
          "inbox",
          "database",
          "postgres",
          "redis",
          "object-storage",
          "vector-database",
          "railway-hosting",
          "vercel-hosting",
          "cloudflare-workers",
          "social-login",
          "realtime",
          "browser",
          "steel-browser"
        ],
        "description": "A current or legacy resource slug that the teardown endpoint can remove from an existing tenant."
      },
      "ResourceConfiguration": {
        "type": "object",
        "description": "Offering-specific provisioning options. Only send fields documented by the selected offering reference.",
        "properties": {
          "region": {
            "type": "string"
          },
          "primary_region": {
            "type": "string"
          },
          "write_region": {
            "type": "string"
          },
          "dimensions": {
            "type": "integer",
            "minimum": 1
          },
          "metric": {
            "type": "string"
          },
          "webhook_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": true
      },
      "ResourceResult": {
        "type": "object",
        "required": [
          "resource",
          "status"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "resource": {
            "$ref": "#/components/schemas/TeardownResourceName"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "failed",
              "suspended"
            ]
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "docs_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": true
      },
      "BulkProvisionResponse": {
        "type": "object",
        "required": [
          "success",
          "requested_count",
          "failed_count",
          "results"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "requested_count": {
            "type": "integer",
            "minimum": 1
          },
          "failed_count": {
            "type": "integer",
            "minimum": 0
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceResult"
            }
          }
        },
        "additionalProperties": false
      },
      "ResourceTeardownResponse": {
        "type": "object",
        "required": [
          "success",
          "resource",
          "status"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "resource": {
            "$ref": "#/components/schemas/TeardownResourceName"
          },
          "status": {
            "type": "string",
            "const": "suspended"
          }
        },
        "additionalProperties": false
      },
      "TenantStatusResponse": {
        "type": "object",
        "required": [
          "account"
        ],
        "properties": {
          "account": {
            "type": "object",
            "required": [
              "tenant_id",
              "status",
              "lifecycle",
              "runtime_profile"
            ],
            "properties": {
              "tenant_id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "lifecycle": {
                "type": "string",
                "enum": [
                  "ephemeral",
                  "claimed"
                ]
              },
              "runtime_profile": {
                "type": "string"
              },
              "runtime_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "upgrade_available": {
                "type": "boolean"
              },
              "upgrade_target_profile": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "bucket_usage": {
            "type": "object",
            "additionalProperties": true
          },
          "notifications": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "ClaimApprovalResponse": {
        "type": "object",
        "required": [
          "tenant_id",
          "approval_url",
          "expires_at",
          "wait"
        ],
        "properties": {
          "tenant_id": {
            "type": "string"
          },
          "approval_url": {
            "type": "string",
            "format": "uri"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "wait": {
            "$ref": "#/components/schemas/WaitDescriptor"
          }
        },
        "additionalProperties": false
      },
      "WaitDescriptor": {
        "type": "object",
        "required": [
          "endpoint",
          "auth_header",
          "timeout_seconds_max",
          "expires_at",
          "type",
          "instructions",
          "command",
          "claude_web"
        ],
        "properties": {
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "auth_header": {
            "type": "string",
            "description": "Secret bearer credential for this wait capability. Do not log or persist it."
          },
          "timeout_seconds_max": {
            "type": "integer",
            "minimum": 1
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "claude_web": {
            "type": "object",
            "required": [
              "constraint_note",
              "command",
              "loop_instructions"
            ],
            "properties": {
              "constraint_note": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "loop_instructions": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "WaitResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "pending, expired, or the terminal status defined by the operation that created the wait capability."
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "ObservabilityResponse": {
        "type": "object",
        "required": [
          "generated_at",
          "account",
          "tenants",
          "limits_for_this_response",
          "includes_resolved"
        ],
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "account": {
            "type": "object",
            "additionalProperties": true
          },
          "tenants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "shared_buckets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "rate_limits_pressured": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "notifications": {
            "type": "object",
            "required": [
              "items",
              "next_cursor"
            ],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "next_cursor": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          },
          "limits_for_this_response": {
            "type": "object",
            "additionalProperties": true
          },
          "includes_resolved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      },
      "JsonRpcRequest": {
        "type": "object",
        "required": [
          "jsonrpc",
          "method"
        ],
        "properties": {
          "jsonrpc": {
            "const": "2.0"
          },
          "id": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "method": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "JsonRpcResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/JsonRpcSuccessResponse"
          },
          {
            "$ref": "#/components/schemas/JsonRpcErrorResponse"
          }
        ]
      },
      "JsonRpcSuccessResponse": {
        "type": "object",
        "required": [
          "jsonrpc",
          "id",
          "result"
        ],
        "properties": {
          "jsonrpc": {
            "const": "2.0"
          },
          "id": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "result": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "JsonRpcErrorResponse": {
        "type": "object",
        "required": [
          "jsonrpc",
          "id",
          "error"
        ],
        "properties": {
          "jsonrpc": {
            "const": "2.0"
          },
          "id": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "error": {
            "$ref": "#/components/schemas/JsonRpcError"
          }
        },
        "additionalProperties": false
      },
      "JsonRpcError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {}
        },
        "additionalProperties": false
      },
      "OAuthApprovalRequest": {
        "type": "object",
        "required": [
          "approval_token",
          "decision"
        ],
        "properties": {
          "approval_token": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "deny"
            ]
          }
        },
        "additionalProperties": false
      },
      "OAuthTokenRequest": {
        "type": "object",
        "required": [
          "grant_type",
          "client_id",
          "resource"
        ],
        "properties": {
          "grant_type": {
            "type": "string",
            "enum": [
              "authorization_code",
              "refresh_token"
            ]
          },
          "client_id": {
            "type": "string"
          },
          "resource": {
            "type": "string",
            "format": "uri"
          },
          "code": {
            "type": "string"
          },
          "redirect_uri": {
            "type": "string",
            "format": "uri"
          },
          "code_verifier": {
            "type": "string",
            "minLength": 43,
            "maxLength": 128
          },
          "refresh_token": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "description": "Optional reduced scope for a refresh-token exchange."
          }
        },
        "oneOf": [
          {
            "properties": {
              "grant_type": {
                "const": "authorization_code"
              }
            },
            "required": [
              "code",
              "redirect_uri",
              "code_verifier"
            ]
          },
          {
            "properties": {
              "grant_type": {
                "const": "refresh_token"
              }
            },
            "required": [
              "refresh_token"
            ]
          }
        ],
        "additionalProperties": false
      },
      "OAuthTokenResponse": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "refresh_token",
          "scope",
          "resource",
          "principal_type"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Short-lived bearer token. Store it as a secret."
          },
          "principal_type": {
            "type": "string",
            "enum": [
              "guest",
              "account"
            ]
          },
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "minimum": 0
          },
          "refresh_token": {
            "type": "string",
            "description": "Rotating refresh token. Store it as a secret and replace it after every refresh."
          },
          "scope": {
            "type": "string"
          },
          "resource": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      },
      "OAuthClientRegistrationRequest": {
        "type": "object",
        "required": [
          "redirect_uris"
        ],
        "properties": {
          "client_name": {
            "type": "string",
            "maxLength": 120
          },
          "redirect_uris": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "token_endpoint_auth_method": {
            "type": "string",
            "const": "none",
            "default": "none"
          },
          "grant_types": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "authorization_code",
                "refresh_token"
              ]
            },
            "default": [
              "authorization_code",
              "refresh_token"
            ]
          },
          "response_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "const": "code"
            },
            "default": [
              "code"
            ]
          }
        },
        "additionalProperties": false
      },
      "OAuthClientRegistrationResponse": {
        "type": "object",
        "required": [
          "client_id",
          "client_id_issued_at",
          "client_name",
          "redirect_uris",
          "token_endpoint_auth_method",
          "grant_types",
          "response_types"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_id_issued_at": {
            "type": "integer",
            "minimum": 0
          },
          "client_name": {
            "type": "string"
          },
          "redirect_uris": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "token_endpoint_auth_method": {
            "type": "string",
            "const": "none"
          },
          "grant_types": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "authorization_code",
                "refresh_token"
              ]
            }
          },
          "response_types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "const": "code"
            }
          }
        },
        "additionalProperties": false
      },
      "OAuthRevocationRequest": {
        "type": "object",
        "required": [
          "token",
          "client_id"
        ],
        "properties": {
          "token": {
            "type": "string",
            "writeOnly": true
          },
          "client_id": {
            "type": "string"
          },
          "token_type_hint": {
            "type": "string",
            "enum": [
              "access_token",
              "refresh_token"
            ]
          }
        },
        "additionalProperties": false
      },
      "OAuthErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "error_description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "GoogleError": {
        "type": "object",
        "required": [
          "code",
          "message",
          "errors"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "message"
              ],
              "properties": {
                "message": {
                  "type": "string"
                },
                "domain": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      },
      "CohesivityErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GoogleError"
              },
              {
                "$ref": "#/components/schemas/JsonRpcError"
              },
              {
                "type": "string"
              }
            ]
          },
          "error_description": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "responses": {
      "CredentialsFile": {
        "description": "Private .cohesivity attachment for direct local storage, not an MCP result",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "private, no-store"
            }
          },
          "Content-Disposition": {
            "schema": {
              "type": "string",
              "const": "attachment; filename=\".cohesivity\""
            }
          },
          "Referrer-Policy": {
            "schema": {
              "type": "string",
              "const": "no-referrer"
            }
          },
          "X-Content-Type-Options": {
            "schema": {
              "type": "string",
              "const": "nosniff"
            }
          }
        },
        "content": {
          "text/plain": {
            "schema": {
              "$ref": "#/components/schemas/CohesivityCredentialsFile"
            }
          }
        }
      },
      "RestError": {
        "description": "Structured error response",
        "headers": {
          "API-Version": {
            "$ref": "#/components/headers/ApiVersion"
          },
          "Deprecation": {
            "$ref": "#/components/headers/Deprecation"
          },
          "Sunset": {
            "$ref": "#/components/headers/Sunset"
          },
          "Link": {
            "$ref": "#/components/headers/VersioningPolicyLink"
          },
          "RateLimit": {
            "$ref": "#/components/headers/RateLimit"
          },
          "RateLimit-Policy": {
            "$ref": "#/components/headers/RateLimitPolicy"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CohesivityErrorResponse"
            }
          }
        }
      },
      "McpError": {
        "description": "MCP JSON-RPC error response",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            }
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/JsonRpcErrorResponse"
            }
          }
        }
      },
      "OAuthError": {
        "description": "OAuth error response",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/OAuthErrorResponse"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "The resource does not support this HTTP method",
        "headers": {
          "Allow": {
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "OAuthRedirect": {
        "description": "Exact registered client redirect with an authorization code or OAuth error",
        "headers": {
          "Location": {
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            }
          },
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        }
      }
    }
  }
}
