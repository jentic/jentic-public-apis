    "/api/wait": {
      "get": {
        "operationId": "waitForAgentAction",
        "summary": "Poll a Cohesivity wait descriptor",
        "description": "Long-polls a signed wait capability until its operation completes, the requested timeout elapses, or the capability expires.",
        "tags": [
          "Tenant"
        ],
        "security": [
          {
            "waitToken": []
          }
        ],
        "parameters": [
          {
            "name": "timeout",
            "in": "query",
            "required": false,
            "description": "Long-poll timeout in seconds, capped by the wait token lifetime.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 55,
              "default": 55
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current wait result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WaitResponse"
                }
              }
            },
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/ApiVersion"
              },
              "Link": {
                "$ref": "#/components/headers/VersioningPolicyLink"
              },
              "Deprecation": {
