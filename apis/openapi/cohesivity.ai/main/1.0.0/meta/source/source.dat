          "Resources"
        ],
        "security": [
          {
            "managementKey": []
          }
        ],
        "parameters": [
          {
            "name": "resourceName",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TeardownResourceName"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Teardown result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceTeardownResponse"
                }
              }
            },
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/ApiVersion"
              },
              "Link": {
                "$ref": "#/components/headers/VersioningPolicyLink"
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/RestError"
          },
          "401": {
            "$ref": "#/components/responses/RestError"
          },
          "404": {
            "$ref": "#/components/responses/RestError"
          },
          "500": {
            "$ref": "#/components/responses/RestError"
          }
        },
        "x-cohesivity-runtime-scope": "profile-aware"
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/api/status": {
      "get": {
        "operationId": "getTenantStatus",
