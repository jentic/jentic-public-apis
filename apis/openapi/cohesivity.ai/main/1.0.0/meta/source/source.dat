    "/api/observability": {
      "get": {
        "operationId": "getAccountObservability",
        "summary": "Read account-wide tenant and usage observability",
        "description": "Returns a bounded account-level snapshot. Optional include slices add buckets, notifications, ledger, costs, webhook history, deployment history, and recent events.",
        "tags": [
          "Tenant"
        ],
        "security": [
          {
            "managementKey": []
          },
          {
            "cohesivitySession": []
          }
        ],
        "parameters": [
          {
            "name": "include",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated slices: summary, tenants, buckets, cost, notifications, events, ledger, deploy_history, end_user_sessions, poller_health, webhook_history, or recent_events."
          },
          {
            "name": "tenant_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional owned tenant to focus in tenant-specific slices."
          },
          {
            "name": "window",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "24h",
                "7d",
                "30d",
                "90d"
              ]
            },
            "description": "Requested lookback window, clamped to the account plan."
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Optional ISO timestamp overriding the derived window start."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opaque pagination cursor from a previous response."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Requested per-slice row limit, clamped to the account plan."
          },
          {
            "name": "empty_buckets",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Include empty usage buckets when true."
          }
        ],
        "responses": {
          "200": {
            "description": "Account observability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservabilityResponse"
                }
              }
            },
            "headers": {
              "API-Version": {
                "$ref": "#/components/headers/ApiVersion"
              },
              "Link": {
                "$ref": "#/components/headers/VersioningPolicyLink"
              },
              "Deprecation": {
                "$ref": "#/components/headers/Deprecation"
              },
              "Sunset": {
                "$ref": "#/components/headers/Sunset"
              },
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              },
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/RestError"
          },
          "403": {
            "$ref": "#/components/responses/RestError"
          },
          "404": {
            "$ref": "#/components/responses/RestError"
          },
          "500": {
            "$ref": "#/components/responses/RestError"
          }
        },
        "x-cohesivity-runtime-scope": "front-door"
      },
      "parameters": [
        {
          "$ref": "#/components/parameters/ApiVersion"
        }
      ]
    },
    "/mcp": {
      "post": {
        "operationId": "callMcp",
        "summary": "Call the public Cohesivity MCP server for documentation and management, with optional account OAuth",
        "description": "One MCP Streamable HTTP JSON-RPC endpoint serves Cohesivity documentation and management. Without Authorization, initialize, ping, tools/list, and tools/call are public; no guest identity, token, or session is created. The server exposes exactly six tools: get_cohesivity_documentation plus five management tools, create_tenant, claim_tenant, tenant_status, provision_resource, and give_feedback. get_cohesivity_documentation is read-only, needs no tenant, credentials, confirmation, or OAuth scope, and reads only fixed Cohesivity pages selected by document and offering. Public create_tenant takes only confirmed: true; each call creates a new rate-limited 72-hour ephemeral tenant, with no idempotency_key and no browser download URL. Do not automatically retry an ambiguous creation outcome. Reuse an existing .cohesivity. Hosted claim_tenant, tenant_status, provision_resource, and give_feedback each require an explicit tenant_id; public calls also require its secret coh_management_key from .cohesivity as a writeOnly argument, verified against current tenant state. Provisioning accepts single resource/configuration or bulk resources/configurations. Creation, claim, and provisioning require confirmed: true after explicit authorization for the exact action; give_feedback submits feedback without user confirmation. Hosted create_tenant returns credentials_file with filename .cohesivity and exact file content in structuredContent and the compatible text result. This secret-bearing result and key-bearing tool inputs may enter model or client retained tool history. Save content verbatim with mode 0600 and gitignore it; never overwrite a different tenant or print credentials in chat, logs, or source. Report if the client cannot write safely. Optional account-scoped OAuth preserves the existing scopes and ownership checks: each tenant tool re-checks current access, OAuth creation requires idempotency_key and mcp:tenants:create, and account creation atomically claims the tenant with no expiry. OAuth tools do not accept management keys in arguments. Existing legacy guest tokens remain limited to their own still-ephemeral creations. Invalid Authorization returns 401; it must never fall back to public access. Other tool results are scrubbed; no other control-plane tools or operation handles are exposed. Local MCP output remains metadata-only. /mcp/manage is retired and returns 410; it is not an alias.",
        "tags": [
          "MCP"
        ],
        "security": [
          {},
          {
            "mcpOAuth": []
          }
        ],
        "x-cohesivity-mcp-tools": [
          {
            "name": "get_cohesivity_documentation",
            "title": "Get Cohesivity documentation",
            "description": "Read a current Cohesivity overview, reference, onboarding guide, pricing guide, offerings catalog, or individual offering document.",
            "inputSchema": {
              "type": "object",
              "required": [
                "document"
              ],
              "properties": {
                "document": {
                  "type": "string",
                  "enum": [
                    "docs",
                    "quick-reference",
                    "full-reference",
                    "onboarding",
                    "pricing",
                    "offerings",
                    "offering"
                  ]
                },
                "offering": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "description": "Offering slug. Required only when document is \"offering\"."
                }
              },
              "additionalProperties": false
            },
            "annotations": {
              "readOnlyHint": true,
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": false
            }
          },
          {
            "name": "create_tenant",
            "title": "Create tenant",
            "description": "Create an ephemeral Cohesivity tenant without login. Call this first when the project has no .cohesivity file. Each confirmed call creates a new tenant; do not retry automatically when the outcome is unknown. Write credentials_file.content verbatim to a private (0600), gitignored .cohesivity file. Never overwrite a different tenant without approval, print the contents, or commit them. Use its tenant_id and coh_management_key for follow-up tools. If the client cannot write files, say so. This response contains project secrets and may be retained in client tool history. Sign in before creating new tenants to have them owned by your account without a separate claim.",
            "scope": "mcp:tenants:create",
            "inputSchema": {
              "type": "object",
              "properties": {
                "confirmed": {
                  "type": "boolean",
                  "enum": [
                    true
                  ],
                  "description": "Set to true only when the current user request explicitly authorized this exact mutation."
                }
              },
              "additionalProperties": false,
              "required": [
                "confirmed"
              ]
            },
            "outputSchema": {
              "type": "object",
              "required": [
                "tenant_id",
                "credentials_file"
              ],
              "properties": {
                "tenant_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$",
                  "description": "Required explicit tenant id. Use the tenant_id that create_tenant returned, or the one in the project .cohesivity file. Account connections are not bound to a tenant; access is checked for every call."
                },
