    "/v1/stats/startups": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "Startup domains by Y Combinator batch",
        "description": "Which extension Y Combinator's startups use, and the state of the exact .com of those not on .com: absent from the .com zone, listed for sale, parked, in use or unknown; the figures for every batch with a year, each year and each batch. From Y Combinator's public company directory and the .com zone, read monthly.",
        "operationId": "getStatsStartups",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Every batch summed, each year, and each batch.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "enum": [
                        "Y Combinator"
                      ],
                      "description": "The company directory the companies are from."
                    },
                    "directory_date": {
                      "type": "string",
                      "format": "date",
                      "example": "2026-11-01",
                      "description": "The day the directory was read."
                    },
                    "com_date": {
                      "type": "string",
                      "format": "date",
                      "example": "2026-11-01",
                      "description": "The .com zone night the states in `exact_com` are from."
                    },
                    "companies": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Companies Y Combinator lists in every batch with a year."
                    },
                    "with_website": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Of `companies`, those with a website listed."
                    },
                    "com": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Of `with_website`, those whose website is on .com."
                    },
                    "tlds": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StartupTld"
                      },
                      "description": "Every extension the websites are on, most companies first, then by name; the counts sum to `with_website`."
                    },
                    "exact_com": {
                      "$ref": "#/components/schemas/StartupExactCom",
                      "description": "For the companies whose website is not on .com, the state of the .com of the same name; the five sum to `with_website` minus `com`."
                    },
                    "years": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StartupYear"
                      },
                      "description": "Every year with a batch, oldest first."
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "description": "The startups page."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StatsMeta"
                    }
                  },
                  "required": [
                    "source",
                    "directory_date",
                    "com_date",
                    "companies",
                    "with_website",
                    "com",
                    "tlds",
                    "exact_com",
                    "years",
                    "url",
                    "meta"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "source": "Y Combinator",
                  "directory_date": "2026-11-01",
                  "com_date": "2026-11-01",
                  "companies": 6358,
