            "description": "Its members summed, as of the newest registry-report month."
          }
        },
        "required": [
          "members"
        ],
        "additionalProperties": false
      },
      "StatsPhase": {
        "type": "object",
        "description": "A dated launch phase of one TLD.",
        "properties": {
          "tld": {
            "type": "string"
          },
          "phase": {
            "type": "string",
            "enum": [
              "sunrise",
              "claims",
              "landrush",
              "limited_registration",
              "qualified_launch",
              "exclusive_registration",
              "approved_launch",
              "general_availability"
            ]
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "tld",
          "phase",
          "start"
        ],
        "additionalProperties": false
      },
      "StatsPeriod": {
        "type": "object",
        "description": "A month the registry reports cover.",
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "example": "2026-05"
          }
        },
        "required": [
          "period"
        ],
        "additionalProperties": false
      },
      "StatsSummary": {
        "type": "object",
        "description": "Totals for one month.",
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "example": "2026-05"
          },
          "tlds": {
            "type": "integer",
            "minimum": 0,
            "description": "TLDs with a figure that month."
          },
          "domains": {
            "type": "integer",
            "minimum": 0,
            "description": "Their domains summed."
          },
          "registrars": {
            "type": "integer",
            "minimum": 0,
            "description": "Registrars with names under management that month."
          },
          "registries": {
            "type": "integer",
            "minimum": 0,
            "description": "Registry operators with names under management that month."
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "cctld",
                    "idn-cctld",
                    "legacy-gtld",
                    "new-gtld",
                    "sponsored",
                    "infra",
                    "unknown"
                  ]
                },
                "tlds": {
                  "type": "integer",
                  "minimum": 0
                },
                "domains": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "tlds",
                "domains"
              ],
              "additionalProperties": false
            }
          },
          "zone": {
            "type": "object",
            "description": "The newest zone night: the TLDs in it and their names.",
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "example": "2026-09-18"
              },
              "tlds": {
                "type": "integer",
                "minimum": 0
              },
              "domains": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "date",
              "tlds",
              "domains"
            ],
            "additionalProperties": false
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "meta": {
            "$ref": "#/components/schemas/StatsMeta",
            "description": "On the top-level object of a response only."
          }
        },
        "required": [
          "period",
          "tlds",
          "domains",
          "registrars",
          "registries",
          "kinds",
          "url"
        ],
        "additionalProperties": false
      },
      "StartupTld": {
        "type": "object",
        "description": "One extension and how many of the companies' websites are on it.",
        "properties": {
          "tld": {
            "type": "string",
            "example": "ai",
            "description": "The extension, without the dot (an A-label)."
          },
          "companies": {
            "type": "integer",
            "minimum": 0,
            "description": "Companies whose website is on this extension."
          }
        },
        "required": [
          "tld",
          "companies"
        ],
        "additionalProperties": false
      },
      "StartupExactCom": {
        "type": "object",
        "description": "The companies not on .com, by the state of the exact .com of their name in the .com zone.",
        "properties": {
          "absent": {
            "type": "integer",
            "minimum": 0,
            "description": "The .com is not in the .com zone: unregistered, or registered with no nameservers."
          },
          "listed": {
            "type": "integer",
            "minimum": 0,
            "description": "The .com points at the nameservers of a sales lander (Afternic, Sedo and others): listed for sale."
          },
          "parked": {
            "type": "integer",
            "minimum": 0,
            "description": "The .com points at the nameservers of a parking service."
          },
          "in_use": {
            "type": "integer",
            "minimum": 0,
            "description": "Any other delegation: the .com points at nameservers that are neither a sales lander nor a parking service."
          },
          "unknown": {
            "type": "integer",
            "minimum": 0,
            "description": "The .com is delegated, and its nameservers do not tell which of the states above it is in."
          }
        },
        "required": [
          "absent",
          "listed",
          "parked",
          "in_use",
          "unknown"
        ],
        "additionalProperties": false
      },
      "StartupBatch": {
        "type": "object",
        "description": "One Y Combinator batch.",
        "properties": {
          "batch": {
            "type": "string",
            "example": "Winter 2025",
            "description": "The batch as Y Combinator names it: season and year."
          },
          "season": {
            "type": "string",
            "enum": [
              "Winter",
              "Spring",
              "Summer",
              "Fall"
            ]
          },
          "companies": {
            "type": "integer",
            "minimum": 0,
            "description": "Companies Y Combinator lists in this batch."
          },
          "with_website": {
            "type": "integer",
            "minimum": 0,
            "description": "Of `companies`, those with a website listed."
          },
          "com": {
            "type": "integer",
            "minimum": 0,
            "description": "Of `with_website`, those whose website is on .com."
          },
          "tlds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StartupTld"
            },
            "description": "Every extension the websites are on, most companies first, then by name; the counts sum to `with_website`."
          },
          "exact_com": {
            "$ref": "#/components/schemas/StartupExactCom",
            "description": "For the companies whose website is not on .com, the state of the .com of the same name; the five sum to `with_website` minus `com`."
          }
        },
        "required": [
          "batch",
          "season",
          "companies",
          "with_website",
          "com",
          "tlds",
          "exact_com"
        ],
        "additionalProperties": false
      },
      "StartupYear": {
        "type": "object",
        "description": "The batches of one year, summed, and each batch.",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 2005,
            "example": 2025,
            "description": "The year of the batches."
          },
          "companies": {
            "type": "integer",
            "minimum": 0,
            "description": "Companies Y Combinator lists in that year's batches."
          },
          "with_website": {
            "type": "integer",
            "minimum": 0,
            "description": "Of `companies`, those with a website listed."
          },
          "com": {
            "type": "integer",
            "minimum": 0,
            "description": "Of `with_website`, those whose website is on .com."
          },
          "tlds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StartupTld"
            },
            "description": "Every extension the websites are on, most companies first, then by name; the counts sum to `with_website`."
          },
          "exact_com": {
            "$ref": "#/components/schemas/StartupExactCom",
            "description": "For the companies whose website is not on .com, the state of the .com of the same name; the five sum to `with_website` minus `com`."
          },
          "batches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StartupBatch"
            },
            "description": "The year's batches in season order: Winter, Spring, Summer, Fall."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The year's page."
          }
        },
        "required": [
          "year",
          "companies",
          "with_website",
          "com",
          "tlds",
          "exact_com",
          "batches",
          "url"
        ],
        "additionalProperties": false
      },
      "RoundApplicationRef": {
        "type": "object",
        "description": "An application, by id and string; the full object is at /v1/stats/applications/{id}.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "example": "3f0c9a52-6d1e-4b7a-9c2f-1a8e5d7b4c10"
          },
          "string": {
            "type": "string",
            "example": "agent"
          }
        },
        "required": [
          "id",
          "string"
        ],
        "additionalProperties": false
      },
      "RoundApplicantRef": {
        "type": "object",
        "description": "Who filed an application. `id` is the legal entity that filed it, not the company. `name` is the company that entity belongs to, which several legal entities can share; `legal_name` is the entity's own name. Send `id` to /v1/stats/applicants/{id} to get the company.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "example": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"
          },
          "name": {
            "type": "string",
            "example": "Example Registry Inc."
          },
          "legal_name": {
            "type": "string",
            "description": "The legal entity's name as ICANN lists it. Absent for a party not on ICANN's list.",
            "example": "Example Registry Holdings LLC"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "RoundSwitch": {
        "type": "object",
        "description": "The string an application switched to or from, with the date.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "string": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "The day of the switch."
          }
        },
        "required": [
          "id",
          "string"
        ],
        "additionalProperties": false
      },
      "RoundSource": {
        "type": "object",
        "description": "The source.",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "example": "https://example.com/news/we-applied"
          },
          "publisher": {
            "type": "string",
            "description": "On applications only."
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "RoundApplication": {
        "type": "object",
        "description": "An application in the 2026 new gTLD round: one per ICANN application, plus each claim an applicant announced that ICANN's list does not hold. An application's replacement (backup) string and IDN variant labels are items of their own, with status `replacement`, `deactivated` or `variant`, and name the application they belong to in `primary`; the application names them in `replacement`, `deactivated_replacement` and `variants`. A backup string that several applications name is an item for each of them.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "Our id, stable for v1.",
            "example": "3f0c9a52-6d1e-4b7a-9c2f-1a8e5d7b4c10"
          },
          "round": {
            "type": "integer",
            "enum": [
              2026
            ]
          },
          "string": {
            "type": "string",
            "description": "The string applied for, its A-label.",
            "example": "agent"
          },
          "applicant": {
            "$ref": "#/components/schemas/RoundApplicantRef",
            "description": "Absent when the applicant is not known."
          },
          "status": {
            "type": "string",
            "enum": [
              "catalogued",
              "rumored",
              "announced",
              "confirmed",
              "ghost",
              "retracted",
              "withdrawn",
              "in-contention",
              "auction-lost",
              "will-not-proceed",
              "delegated",
              "sunrise",
              "launched",
              "terminated",
              "replacement",
              "variant",
              "switched",
              "deactivated"
            ],
            "description": "Where the application stands. `catalogued` and `rumored` are reserved and not used. `announced`: the applicant has said it applied. `confirmed`: on ICANN's published list. `ghost`: abandoned: announced, but not on ICANN's list under that applicant. `retracted`: the announcement was taken back. `withdrawn`: withdrawn after applying. `in-contention`: confirmed, and competing with other applications for the same string. `auction-lost`: lost the contention set at auction. `will-not-proceed`: ICANN will not move the application forward. `delegated`: added to the root zone. `sunrise`: in its sunrise period. `launched`: open for general registration. `terminated`: the registry agreement ended. `replacement`: named on ICANN's list as the replacement string of another of the applicant's applications. `variant`: an IDN variant label of another of the applicant's applications. `switched`: was applied for; the applicant moved the application to its replacement string. `deactivated`: named as a replacement (backup) string of another of the applicant's applications, shown on ICANN's list as deactivated, because another applicant applied for the same string or named it as a backup. Only an application live on ICANN's list counts as an application: `confirmed`, `in-contention`, `delegated`, `sunrise`, `launched`."
          },
          "announced": {
            "type": "string",
            "format": "date",
            "description": "The day the applicant announced it applied."
          },
          "contention": {
            "type": "integer",
            "minimum": 0,
            "description": "How many applicants are pursuing the string: those with an application live on ICANN's list (`confirmed`, `in-contention`, `delegated`, `sunrise`, `launched`)."
          },
          "summary": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/RoundSource",
            "description": "The announcement or list where the application first appeared."
          },
          "icann_application_id": {
            "type": "string",
            "description": "ICANN's application id, once ICANN has published it."
          },
          "contention_set": {
            "type": "string",
            "description": "ICANN's id for the set of applications competing for the same string."
          },
          "icann_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "brand",
                "community",
                "geographic",
                "idn",
                "applicant-support",
                "variant-only"
              ]
            },
            "description": "ICANN's TLD types for the application, from ICANN's published list. An empty list is a generic (standard) application. `variant-only` is an application by the operator of an existing TLD to add an IDN variant label of it: the application is on the existing TLD and names the new label in `variants`. Absent when the row was not taken from ICANN's list."
          },
          "primary": {
            "$ref": "#/components/schemas/RoundApplicationRef",
            "description": "On a `replacement`, `deactivated` or `variant`: the application it belongs to."
          },
          "replacement": {
            "$ref": "#/components/schemas/RoundApplicationRef",
            "description": "The application's replacement string, while it is unused."
          },
          "deactivated_replacement": {
            "$ref": "#/components/schemas/RoundApplicationRef",
            "description": "The application's replacement string that ICANN's list shows as deactivated."
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoundApplicationRef"
            },
            "description": "The application's IDN variant labels."
          },
          "switched_to": {
            "$ref": "#/components/schemas/RoundSwitch",
            "description": "On a `switched` application: the replacement string it moved to."
          },
          "switched_from": {
            "$ref": "#/components/schemas/RoundSwitch",
            "description": "On the application a switch moved to: the string it moved from."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The string's page on namedesk.app. Absent for the few strings without a page."
          },
          "meta": {
            "$ref": "#/components/schemas/StatsMeta",
            "description": "On the top-level object of a response only."
          }
        },
        "required": [
          "id",
          "round",
          "string",
          "status",
          "contention",
          "source"
        ],
        "additionalProperties": false
      },
      "RoundString": {
        "type": "object",
        "description": "A string in the 2026 round: applied for, named as a backup, or claimed and abandoned. Strings that are already TLDs are not part of the round, except where ICANN lists an application to add an IDN variant label to an existing TLD (`icann_types` includes `variant-only`): that application counts, under the existing TLD, as ICANN lists it.",
        "properties": {
          "string": {
            "type": "string",
            "description": "The A-label.",
            "example": "agent"
          },
          "unicode": {
            "type": "string",
            "description": "IDN only: the native-script form."
          },
          "round": {
            "type": "integer",
            "enum": [
              2026
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "ai-tech",
              "crypto",
              "commerce",
              "geo",
              "brand",
              "culture",
              "infra",
              "other"
            ],
            "description": "The AI assessment's leading category once the string is assessed. Absent when not known."
          },
          "status": {
            "type": "string",
            "enum": [
              "catalogued",
              "rumored",
              "announced",
              "confirmed",
              "ghost",
              "retracted",
              "withdrawn",
              "in-contention",
              "auction-lost",
              "will-not-proceed",
              "delegated",
              "sunrise",
              "launched",
              "terminated",
              "replacement",
              "variant",
              "switched",
              "deactivated"
            ],
            "description": "The furthest stage any of its applications has reached."
          },
          "applications": {
            "type": "integer",
            "minimum": 0,
            "description": "Applications for this string. Only an application live on ICANN's list counts as an application: `confirmed`, `in-contention`, `delegated`, `sunrise`, `launched`."
          },
          "contention": {
            "type": "integer",
            "minimum": 0,
            "description": "How many applicants are pursuing it. Two or more means contested."
          },
          "first_seen": {
            "type": "string",
            "format": "date",
            "description": "The day namedesk first listed the string."
          },
          "score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "The AI assessment's score, 1 to 100 on one fixed scale; .com is scored on it like every other TLD. Absent until the string is assessed; https://namedesk.app/tlds/methodology explains it."
          },
          "verdict": {
            "type": "string",
            "description": "The assessment's one-sentence verdict. Absent until the string is assessed."
          },
          "applicants": {
            "type": "array",
            "description": "Each applicant on the string and its role: one entry per applicant and role, so an applicant that applies for the string and names it as a backup is listed twice.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "name": {
                  "type": "string",
                  "description": "The company. Several legal entities can share it."
                },
                "legal_name": {
                  "type": "string",
                  "description": "The legal entity's name as ICANN lists it. Absent for a party not on ICANN's list."
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "applying",
                    "replacement",
                    "variant",
                    "switched",
                    "deactivated",
                    "abandoned",
                    "unconfirmed",
                    "ended"
                  ],
                  "description": "`applying`: has an application for the string live on ICANN's list. `replacement`, `variant`: holds it as the replacement string or an IDN variant label of another application. `switched`: moved its application away from it. `deactivated`: named it as a backup string that ICANN's list shows as deactivated. `abandoned`: announced it, but is not on ICANN's list for it. `unconfirmed`: said or reported to have applied for it, not on ICANN's list. `ended`: applied for it, and the application ended (retracted, withdrawn, lost at auction, not proceeding, terminated)."
                }
              },
              "required": [
                "id",
                "name",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "comps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoundComp"
            },
            "description": "Only on the single-string read: the AI's comparables from the 2012 round, closest first. Absent when the string has none."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The string's page on namedesk.app. Absent for the few strings without a page."
          },
          "meta": {
            "$ref": "#/components/schemas/StatsMeta",
            "description": "On the top-level object of a response only."
          }
        },
        "required": [
          "string",
          "round",
          "status",
          "applications",
          "contention",
          "first_seen",
          "applicants"
        ],
        "additionalProperties": false
      },
      "RoundComp": {
        "type": "object",
        "additionalProperties": false,
        "description": "A string from the 2012 round the AI chose as a comparable, with what became of it and its names today from the registry statistics.",
        "required": [
          "rank",
          "string",
          "closeness",
          "why",
          "applications",
          "delegated",
          "retired"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "description": "1 is the closest comparable."
          },
          "string": {
            "type": "string",
            "example": "cloud"
          },
          "unicode": {
            "type": "string",
            "description": "IDN only: the native-script form."
          },
          "closeness": {
            "type": "string",
            "enum": [
              "strong",
              "moderate",
              "weak"
            ]
          },
          "why": {
            "type": "string",
            "description": "Why it is a comparable, in the AI's words."
          },
          "applications": {
            "type": "integer",
            "minimum": 0,
            "description": "How many applied for it in 2012."
          },
          "delegated": {
            "type": "boolean",
            "description": "It reached the root."
          },
          "retired": {
            "type": "boolean",
            "description": "It reached the root and has since left it."
          },
          "winner": {
            "type": "string",
            "description": "The applicant that won it, when one did."
          },
          "delegation_date": {
            "type": "string",
            "format": "date"
          },
          "operator": {
            "type": "string",
            "description": "Its registry operator today, when it is a TLD."
          },
          "domains": {
            "type": "object",
            "required": [
              "period",
              "count"
            ],
            "additionalProperties": false,
            "description": "Names under management in the latest month reported. Absent when it never reached the root or reports nothing.",
            "properties": {
              "period": {
                "type": "string",
                "example": "2026-05"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Its page on namedesk.app, when it is a TLD."
          }
        }
      },
      "RoundApplicant": {
        "type": "object",
        "description": "An applicant in the 2026 round: a company, counted once however many legal entities it applied through (`legal_entities`). In the list of abandoned applicants, a company whose every claim was abandoned.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "description": "Our id for the company, stable for v1. It can be the same as one of its legal entities' ids; /v1/stats/applicants/{id} also takes the id of any of its legal entities.",
            "example": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"
          },
          "name": {
            "type": "string",
            "description": "The company.",
            "example": "Example Registry Inc."
          },
          "website": {
            "type": "string",
            "description": "The company's website, when known."
          },
          "applications": {
            "type": "integer",
            "minimum": 0,
            "description": "Its applications in the round, over all its legal entities. Only an application live on ICANN's list counts as an application: `confirmed`, `in-contention`, `delegated`, `sunrise`, `launched`."
          },
          "legal_entities": {
            "type": "array",
            "description": "The legal entities the company applied through, most applications first.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "description": "The legal entity's id: applications name it as their `applicant.id`."
                },
                "legal_name": {
                  "type": "string",
                  "description": "Its name as ICANN lists it. Absent for a party not on ICANN's list.",
                  "example": "Example Registry Holdings LLC"
                },
                "applications": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Its applications in the round."
                }
              },
              "required": [
                "id",
                "applications"
              ],
              "additionalProperties": false
            }
          },
          "registries": {
            "type": "array",
            "description": "The registry operators that are the same company as the applicant or are tied to it, each backed by a public source quoted on its page on namedesk.app. Absent when there is none. A tie says who the applicant is, not who will run its new TLDs.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "The operator's id. When it runs a TLD today (`url` present), /v1/stats/registries/{id} has its full object."
                },
                "name": {
                  "type": "string",
                  "description": "The operator's name. Absent when the registry statistics cannot be read."
                },
                "relation": {
                  "type": "string",
                  "enum": [
                    "same-company",
                    "shared-ownership",
                    "shared-people",
                    "shared-address"
                  ],
                  "description": "same-company: the operator is this company (the same legal entity, or wholly owned within one group). shared-ownership: one owns part of the other, or they have an owner in common. shared-people: a person in common. shared-address: a registered address in common, and nothing more."
                },
                "tlds": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "The TLDs it runs today, as on its registry object; 0 when it runs none with published figures."
                },
                "domains": {
                  "$ref": "#/components/schemas/StatsDomains",
                  "description": "Domains under management across them in the newest month ICANN has published, as on its registry object."
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "The operator's page on namedesk.app. Absent for an operator that runs no TLD today."
                }
              },
              "required": [
                "id",
                "relation"
              ],
              "additionalProperties": false
            }
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The company's page on namedesk.app, with every legal entity it applies through and why they are one company. The address stays the same when the company is renamed."
          },
          "meta": {
            "$ref": "#/components/schemas/StatsMeta",
            "description": "On the top-level object of a response only."
          }
        },
        "required": [
          "id",
          "name",
          "applications",
          "legal_entities"
        ],
        "additionalProperties": false
      },
      "RoundChange": {
        "type": "object",
        "description": "One change to the round data.",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "description": "When namedesk made the change."
          },
          "string": {
            "type": "string"
          },
          "applicant": {
            "$ref": "#/components/schemas/RoundApplicantRef"
          },
          "change": {
            "type": "string",
            "enum": [
              "recorded",
              "status_changed",
              "corrected",
              "noted"
            ],
            "description": "`recorded`: a new application was listed. `status_changed`: its status moved. `corrected`: a fact was corrected or removed on request. `noted`: a note was added."
          },
          "status": {
            "type": "string",
            "enum": [
              "catalogued",
              "rumored",
              "announced",
              "confirmed",
              "ghost",
              "retracted",
              "withdrawn",
              "in-contention",
              "auction-lost",
              "will-not-proceed",
              "delegated",
              "sunrise",
              "launched",
              "terminated",
              "replacement",
              "variant",
              "switched",
              "deactivated"
            ],
            "description": "On `status_changed`: the new status."
          },
          "source": {
            "$ref": "#/components/schemas/RoundSource",
            "description": "The announcement or list behind the change, when there is one."
          },
          "note": {
            "type": "string",
            "description": "The text the changelog shows with the change: why a status moved, what was corrected, or the note itself. Absent when there is none."
          }
        },
        "required": [
          "at",
          "string",
          "change"
        ],
        "additionalProperties": false
      },
      "RoundMilestone": {
        "type": "object",
        "description": "A milestone on ICANN's calendar for the round. A date (YYYY-MM-DD) where ICANN gave a day, a UTC timestamp where it gave a time.",
        "properties": {
          "milestone": {
            "type": "string",
            "enum": [
              "reveal_day",
              "replacement_period",
              "string_confirmation_day",
              "refund_deadline",
              "objections",
              "icann_closed",
              "prioritization_draw"
            ]
          },
          "start": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$"
          },
          "end": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$",
            "description": "When it closes: the closing moment for a timestamp, the last day for a date."
          },
          "when": {
            "type": "string",
            "description": "How ICANN describes a milestone it has not dated yet."
          }
        },
        "required": [
          "milestone"
        ],
        "additionalProperties": false
      },
      "Round": {
        "type": "object",
        "description": "The 2026 new gTLD round at a glance.",
        "properties": {
          "round": {
            "type": "integer",
            "enum": [
              2026
            ]
          },
          "phase": {
            "type": "string",
            "enum": [
              "before_reveal",
              "revealed",
              "replacement_period",
              "awaiting_confirmation",
              "objections",
              "evaluation"
            ],
            "description": "Where the round is on ICANN's calendar, switching at the instants ICANN gives. `before_reveal`: ICANN has not published the applied-for strings. `revealed`: they are out, and the replacement period has not opened. `replacement_period`: applicants may switch to their replacement string. `awaiting_confirmation`: switching has closed. `objections`: the final list is out and objections are open. `evaluation`: objections have closed."
          },
          "milestones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoundMilestone"
            }
          },
          "counts": {
            "type": "object",
            "properties": {
              "applications": {
                "type": "integer",
                "minimum": 0,
                "description": "Only an application live on ICANN's list counts as an application: `confirmed`, `in-contention`, `delegated`, `sunrise`, `launched`."
              },
              "strings": {
                "type": "integer",
                "minimum": 0,
                "description": "Strings with at least one application."
              },
              "applicants": {
                "type": "integer",
                "minimum": 0,
                "description": "Companies with at least one application in the round: the list at /v1/stats/applicants. A company counts once however many legal entities it applied through."
              },
              "companies": {
                "type": "integer",
                "minimum": 0,
                "description": "The same number as `applicants`, kept for existing integrations."
              },
              "legal_entities": {
                "type": "integer",
                "minimum": 0,
                "description": "Legal entities with at least one application. Each of a company's entities counts separately."
              },
              "abandoned_applicants": {
                "type": "integer",
                "minimum": 0,
                "description": "Companies whose every claim in the round is abandoned: announced, but not on ICANN's list. Not part of `applicants`; the list at /v1/stats/applicants?abandoned=true."
              },
              "contention_sets": {
                "type": "integer",
                "minimum": 0,
                "description": "ICANN contention sets among the applications."
              }
            },
            "required": [
              "applications",
              "strings",
              "applicants",
              "companies",
              "legal_entities",
              "abandoned_applicants",
              "contention_sets"
            ],
            "additionalProperties": false
          },
          "revealed": {
            "type": "boolean",
            "description": "True once ICANN's published list is in the API."
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "meta": {
            "$ref": "#/components/schemas/StatsMeta",
            "description": "On the top-level object of a response only."
          }
        },
        "required": [
          "round",
          "phase",
          "milestones",
          "counts",
          "revealed",
          "url"
        ],
        "additionalProperties": false
      },
      "RegistryGroup": {
        "type": "object",
        "description": "A company in the registries list with `view=groups`: two or more operators under one owner, their TLDs and names summed. Its page is /v1/stats/groups/{slug}.",
        "properties": {
          "slug": {
            "type": "string",
            "example": "identity-digital"
          },
          "name": {
            "type": "string",
            "example": "Identity Digital"
          },
          "operators": {
            "type": "integer",
            "minimum": 2,
            "description": "Registry operators under this owner, as its page lists them (one may run no served TLD and carry no figures)."
          },
          "tlds": {
            "type": "integer",
            "minimum": 0,
            "description": "TLDs its operators run today, summed."
          },
          "domains": {
            "$ref": "#/components/schemas/StatsDomains"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "slug",
          "name",
          "operators",
          "tlds",
          "url"
        ],
        "additionalProperties": false
      },
      "RegistrarGroup": {
        "type": "object",
        "description": "A registrar family in the registrars list with `view=groups`: its accreditations' names summed in their newest month. Its page is /v1/stats/groups/{slug}.",
        "properties": {
          "slug": {
            "type": "string",
            "example": "godaddy"
          },
          "name": {
            "type": "string",
            "example": "GoDaddy"
          },
          "accreditations": {
            "type": "integer",
            "minimum": 1,
            "description": "Accreditations under this owner with reported volume."
          },
          "domains": {
            "$ref": "#/components/schemas/StatsDomains"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "slug",
          "name",
          "accreditations",
          "domains",
          "url"
        ],
        "additionalProperties": false
      },
      "StatsGroupMember": {
        "type": "object",
        "description": "A member of the group: an operator (its TLDs run today and their names, as the registries list counts them) or an accreditation (its names in its newest month).",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "tlds": {
            "type": "integer",
            "minimum": 0
          },
          "domains": {
            "$ref": "#/components/schemas/StatsDomains"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "ResearchJobSummary": {
        "type": "object",
        "description": "A job in the list of your team's jobs.",
        "properties": {
          "id": {
            "type": "string",
            "example": "job_a3f2c91d"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "cancelled"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "api",
              "csv"
            ]
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "domain_count": {
            "type": "integer"
          },
          "status_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "id",
          "status",
          "source",
          "submitted_at",
          "completed_at",
          "domain_count",
          "status_url"
        ]
      }
    }
  }
}
