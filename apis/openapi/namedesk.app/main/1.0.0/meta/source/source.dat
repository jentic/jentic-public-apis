              "type": "string",
              "example": "agent"
            }
          },
          {
            "name": "applicant",
            "in": "query",
            "description": "Applications by this applicant (a company). Send the company's id or any of its legal entities' ids; either returns every application by the company, so this cannot filter to one entity.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
