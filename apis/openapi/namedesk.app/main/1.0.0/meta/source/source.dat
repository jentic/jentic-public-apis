          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "meta": {
            "$ref": "#/components/schemas/StatsMeta",
            "description": "On the top-level object of a response only."
          }
        },
        "required": [
          "slug",
          "name",
          "url"
        ],
        "additionalProperties": false
      },
      "StatsGroupMembers": {
        "type": "object",
        "description": "One kind of a group's members, and their stock.",
