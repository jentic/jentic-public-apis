    "/v1/stats/tlds/{tld}/zone": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "A TLD's zone nights",
        "description": "Nightly counts of the TLD's names, oldest first: from its zone file, or, for a TLD without one, names seen in certificate transparency logs and confirmed in DNS; each night's `source` says which. Empty for a TLD with neither. Nights with no count are left out. Zone data may be withdrawn if a registry revokes access.",
        "operationId": "listStatsTldZone",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/StatsTld"
          },
          {
            "name": "from",
            "in": "query",
            "description": "First night, YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-09-18"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Last night, YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-09-18"
            }
          },
          {
            "name": "range",
            "in": "query",
            "description": "How far back from `to` when `from` is not given; `all` is up to five years.",
            "schema": {
              "type": "string",
              "enum": [
                "30d",
                "90d",
                "1y",
                "all"
              ],
              "default": "90d"
            }
          },
          {
            "$ref": "#/components/parameters/StatsLimit"
          },
          {
            "$ref": "#/components/parameters/StatsCursor"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of nights.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ZoneDay"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Null on the last page."
                    },
                    "query": {
                      "type": "object",
                      "description": "The parameters as resolved: defaults filled in, bounds clamped.",
                      "properties": {
                        "from": {
                          "type": "string",
                          "format": "date",
                          "example": "2026-09-18"
                        },
                        "to": {
                          "type": "string",
                          "format": "date",
                          "example": "2026-09-18"
                        },
                        "range": {
                          "type": "string",
                          "enum": [
                            "30d",
                            "90d",
                            "1y",
                            "all"
                          ]
                        },
                        "limit": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "range",
                        "limit"
                      ],
                      "additionalProperties": false
                    },
                    "bounds": {
                      "$ref": "#/components/schemas/StatsBounds"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StatsMeta"
                    }
                  },
                  "required": [
                    "items",
                    "next_cursor",
                    "query",
                    "meta"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "items": [
                    {
                      "date": "2026-08-10",
                      "source": "zone",
                      "domains": 1000000
                    },
                    {
                      "date": "2026-08-11",
                      "source": "zone",
                      "domains": 1001000,
                      "entered": 1501,
                      "left": 900
                    }
                  ],
                  "next_cursor": "eyJrIjoiL3YxL3N0YXRzL3RsZHMveHl6L3pvbmU_e1wiZnJvbVwiOlwiMjAyNi0wOC0xMFwiLFwidG9cIjpcIjIwMjYtMDktMThcIixcInJhbmdlXCI6XCI5MGRcIn0iLCJhdCI6IjIwMjYtMDgtMTEifQ",
                  "query": {
                    "from": "2026-08-10",
                    "to": "2026-09-18",
                    "range": "90d",
                    "limit": 2
                  },
                  "bounds": {
                    "first": "2026-08-10",
                    "last": "2026-09-18"
                  },
                  "meta": {
                    "as_of": "2026-08-11",
                    "attribution": "Statistics by Namedesk (https://namedesk.app). Zone counts from ICANN CZDS zone files."
                  }
                }
              }
            }
          },
          "302": {
            "$ref": "#/components/responses/StatsCanonical"
          },
          "400": {
            "$ref": "#/components/responses/StatsBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/StatsUnauthorized"
          },
          "429": {
            "$ref": "#/components/responses/StatsRateLimited"
          },
          "404": {
            "$ref": "#/components/responses/StatsNotFound"
          }
