{
  "openapi": "3.1.0",
  "info": {
    "title": "Namedesk API",
    "summary": "Programmatic access to Namedesk research, pricing, and signals.",
    "description": "The Namedesk API. Appraisal and research endpoints take an `x-api-key` header, generated in Settings -> API keys, and draw credits from the same wallet as the dashboard; reads never start new research. The stats endpoints are free and need no key.",
    "version": "1.0.0",
    "contact": {
      "name": "Namedesk support",
      "email": "hello@namedesk.app",
      "url": "https://namedesk.app/faqs"
    },
    "termsOfService": "https://namedesk.app/privacy",
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://api.namedesk.app",
      "description": "Production"
    }
  ],
  "externalDocs": {
    "description": "Full API documentation",
    "url": "https://namedesk.app/docs/api"
  },
  "security": [
    {
      "apiKey": []
    },
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Wallet",
      "description": "Credit balance for the authenticated organization."
    },
    {
      "name": "Research jobs",
      "description": "Submit, list, inspect, and cancel research jobs. 10 credits per uncached domain for a full read; quick reads cost 1 credit for a name the quick read judges not worth a full appraisal, 10 when it escalates."
    },
    {
      "name": "Reports",
      "description": "Fetch the most recent domain report or the pricing-only slice of it. Pure reads - never trigger compute."
    },
    {
      "name": "Stats",
      "description": "Domain industry statistics and the 2026 new gTLD round, free, no key required. Statistics: TLDs, registry operators and registrars month by month, launch phases and nightly zone counts, as counts and totals. The 2026 round: every application announced by its applicant or published by ICANN, the strings applied for, the applicants, ICANN's calendar and every change to the round data. Every response carries `meta` with the sources to credit."
    }
  ],
  "paths": {
    "/v1/wallet": {
      "get": {
        "tags": [
          "Wallet"
        ],
        "summary": "Get current credit balance",
        "description": "Your team's credit balance, the same wallet the dashboard uses. Check it before submitting a job.",
        "operationId": "getWallet",
        "responses": {
          "200": {
            "description": "Current balance.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "credits": {
                      "type": "integer",
                      "minimum": 0,
                      "example": 47
                    }
                  },
                  "required": [
                    "credits"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/research-jobs": {
      "post": {
        "tags": [
          "Research jobs"
        ],
        "summary": "Appraise domains",
        "description": "Submit 1 to 100 domains for a full appraisal of each, at 10 credits per domain. Domains your team has already appraised come back with their existing report at no cost. The job starts at once; check its status until `counts.pending` and `counts.running` are both 0.",
        "operationId": "createResearchJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateResearchJobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted and started. The response carries the job's per-domain breakdown; uncached names are still 'pending' or 'running'. Poll GET /v1/research-jobs/{id} every few seconds until counts.pending and counts.running reach 0.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchJob"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "description": "Insufficient credits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency-Key was reused with a different request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Research jobs"
        ],
        "summary": "List research jobs",
        "description": "List the authenticated organization's research jobs, newest first. Paginated.",
        "operationId": "listResearchJobs",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size. Defaults to 20. Minimum 1, maximum 100 - values above 100 are clamped to 100.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque pagination cursor returned in the previous response."
          }
        ],
        "responses": {
          "200": {
            "description": "Page of research jobs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ResearchJobSummary"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "next_cursor"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/research-jobs/quick": {
      "post": {
        "tags": [
          "Research jobs"
        ],
        "summary": "Quick-read domains",
        "description": "Submit 1 to 100 domains for quick reads. A quick check on each domain decides whether the full appraisal is worth it:\n- **Quick read** (`read_type=\"quick\"`): the domain is not worth the full appraisal. You get a first-pass wholesale, aftermarket and brokered estimate with a one-sentence reason. 1 credit per domain.\n- **Full read** (`read_type=\"full\"`): the domain is worth it, and the full appraisal runs with every signal and recommendation. 10 credits per domain.\n\nThe job starts at once and each domain's read follows; check its status until `counts.pending` and `counts.running` are both 0. The job sets aside 10 credits per domain when it starts, and the difference returns to your wallet as each quick read finishes. `credits_charged` on the job is always what your wallet has paid.\n\nDomains your team has already appraised come back with their existing report at no cost.",
        "operationId": "createQuickResearchJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateResearchJobRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted and started. `mode=\"quick\"` on the response. Per-domain credits_charged settles as each name's read is decided (1 credit for a quick read, 10 credits for a full read).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchJob"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "description": "Insufficient credits. Quick-mode jobs reserve 10 credits per uncached name up front (the worst case, in case every name escalates to a full read); your wallet needs to cover that even though the actual charge is typically lower.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency-Key was reused with a different request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/domains/{domain}/rerun": {
      "post": {
        "tags": [
          "Research jobs"
        ],
        "summary": "Re-appraise one domain",
        "description": "Run a fresh appraisal of one domain, even one your team has appraised before. By default it is a full read at 10 credits. With `quick` set to true it runs the quick check instead: 1 credit if that returns a quick read, 10 if the domain is worth the full appraisal.\n\nIf your team already has an appraisal of this domain running, you get that run instead, and nothing more is charged.\n\nUse it to refresh an old result, or to upgrade a quick read to the full appraisal without resubmitting a whole job. Later reads of the domain's report and pricing return the new result. A full read always takes precedence over a quick read of the same domain, and the earlier result stays in your history.",
        "operationId": "rerunDomain",
        "parameters": [
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The domain name (e.g. `acme.ai`)."
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "quick": {
                    "type": "boolean",
                    "default": false,
                    "description": "When true, use the quick check (may return a quick read for 1 credit, or run the full appraisal for 10 credits). Default false always runs the full appraisal at 10 credits."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Rerun started or completed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "run_id": {
                      "type": "string"
                    },
                    "domain": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "running",
                        "finalizing",
                        "succeeded",
                        "failed",
                        "cancelled"
                      ]
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "full",
                        "quick"
                      ],
                      "description": "The run's mode. When your team already had an appraisal of this domain running, that run's mode, which can differ from the one asked for."
                    },
                    "read_type": {
                      "type": "string",
                      "enum": [
                        "full",
                        "quick"
                      ],
                      "nullable": true,
                      "description": "Populated immediately for a quick read (the rerun returns terminal in-line). Null for a full read while the appraisal is still running; poll `GET /v1/domains/{domain}/pricing` for the eventual result."
                    },
                    "read_reason": {
                      "type": "string",
                      "nullable": true,
                      "description": "A one-sentence reason for the read tier this name received. Present on quick reads and on full reads that came from the quick endpoint; null for full reads submitted directly to /v1/research-jobs."
                    },
                    "credits_charged": {
                      "type": "integer",
                      "description": "What this request charged: 1 for a quick read, 10 for a full read (set aside when it starts, final when the appraisal finishes). 0 when your team already had an appraisal of this domain running: the answer names that run and nothing more is charged."
                    },
                    "credits_balance_after": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "run_id",
                    "domain",
                    "status",
                    "mode",
                    "credits_charged",
                    "credits_balance_after"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "description": "Insufficient credits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/research-jobs/{id}": {
      "get": {
        "tags": [
          "Research jobs"
        ],
        "summary": "Get research job status",
        "operationId": "getResearchJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Job state and per-domain status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchJob"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "description": "A job's status, its counts by outcome, the credits it has charged so far, and each domain's result with a link to its report. Reading it never spends credits."
      },
      "delete": {
        "tags": [
          "Research jobs"
        ],
        "summary": "Cancel a research job",
        "description": "Stops a running job and returns to your wallet the credits set aside for domains not yet finished. Domains that already came back keep their charge (10 credits for a full read, 1 for a quick read). `credits_refunded` in the answer is the amount returned. Cancelling a job that has already finished or been cancelled is refused with `already_terminal` and changes nothing.",
        "operationId": "cancelResearchJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Job cancelled. Returns the final state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchJob"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/research-jobs/{id}/report/{domain}": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Get a domain report scoped to a job",
        "description": "Returns the report for a specific domain inside a specific job. Useful when you've submitted the same domain in multiple jobs and want the version that came from a given submission.",
        "operationId": "getJobReport",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          },
          {
            "$ref": "#/components/parameters/Domain"
          }
        ],
        "responses": {
          "200": {
            "description": "Domain report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainReport"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/report/{domain}": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Get the most recent report for a domain",
        "description": "Your team's newest appraisal report for one domain, whichever job produced it. Reading it never spends credits or starts an appraisal. A domain your team has not appraised answers 404 `not_yet_researched`.",
        "operationId": "getLatestReport",
        "parameters": [
          {
            "$ref": "#/components/parameters/Domain"
          }
        ],
        "responses": {
          "200": {
            "description": "Domain report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainReport"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Domain has not been researched by this organization.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/domains/{domain}/pricing": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Get a domain's price bands",
        "description": "Only the pricing of a domain your team has appraised: the wholesale, aftermarket and brokered bands and their confidence. The quickest read, and it never spends credits. The shape matches `pricing` in the full report.",
        "operationId": "getDomainPricing",
        "parameters": [
          {
            "$ref": "#/components/parameters/Domain"
          }
        ],
        "responses": {
          "200": {
            "description": "Pricing slice.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pricing"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Domain has not been researched, or the pricing step did not produce a row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/research-jobs/{id}/report": {
      "get": {
        "tags": [
          "Research jobs",
          "Reports"
        ],
        "summary": "Get all domain reports for a job",
        "description": "Returns every domain in the job with its current job_status and (when computed) its full DomainReport. Customers poll this during a running job to watch reports fill in; once terminal, it's a one-shot answer for 'give me everything from this submission.'\n\nDomains in `pending` or `running` status carry only `domain` + `job_status` \u2014 no `report` key (the omit-when-null contract). `paid` and `cached` domains carry the full DomainReport. `failed` domains carry an `error` code (see \"Error codes\" in the docs).",
        "operationId": "getJobReports",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Job header + array of per-domain reports.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobReportsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/research-jobs/{id}/report/pricing": {
      "get": {
        "tags": [
          "Research jobs",
          "Reports"
        ],
        "summary": "Get pricing-only slice for every domain in a job",
        "description": "Pricing-only variant of /v1/research-jobs/{id}/report. Each entry carries the price band (wholesale / aftermarket / brokered), reasoning, key factors, and risks - capped at 4 KB per text field. Faster and lighter than the full report wrapper; built for the 'CSV of just the dollars and reasoning' workflow without pulling the probes / signals / brand signals you don't need.\n\nPass `?format=csv` to receive a browser-downloadable CSV instead of JSON. The CSV contains one row per domain in the job, with the same data as the JSON response projected into a flat row format. Failed entries occupy a row with the `error` column populated and the dollar columns blank.",
        "operationId": "getJobPricing",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ]
            },
            "description": "Response format. Defaults to JSON. Pass `?format=csv` to receive a browser-downloadable CSV (one row per domain) with columns: `domain, job_status, confidence, wholesale_low/mid/high, aftermarket_low/mid/high, brokered_low/mid/high, model, engine_version, computed_at, error, reasoning, key_factors, risks`. The CSV is BOM-prefixed for Excel UTF-8 compatibility, uses CRLF line terminators per RFC 4180, and serves with `Content-Disposition: attachment`."
          }
        ],
        "responses": {
          "200": {
            "description": "Job header + array of per-domain pricing slices.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobPricingResponse"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string",
                  "description": "Browser-downloadable CSV. See `format=csv` parameter description for the column list."
                },
                "example": "\ufeffdomain,job_status,confidence,wholesale_low,wholesale_mid,wholesale_high,aftermarket_low,aftermarket_mid,aftermarket_high,brokered_low,brokered_mid,brokered_high,model,engine_version,computed_at,error,reasoning,key_factors,risks\r\nacme.ai,paid,high,200,500,1500,5000,25000,65000,50000,165000,350000,opus-class,v5,2026-05-07T18:33:42Z,,\"Premium 4-char .ai cohort...\",a | b,risk1\r\n"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/stats/summary": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "The domain industry at a glance",
        "description": "TLDs, domains, registrars and registry operators with a figure in one month, by kind, and the newest nightly count.",
        "operationId": "getStatsSummary",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/StatsPeriod"
          }
        ],
        "responses": {
          "200": {
            "description": "The summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsSummary"
                },
                "example": {
                  "period": "2026-05",
                  "tlds": 6,
                  "domains": 2653610,
                  "registrars": 2,
                  "registries": 6,
                  "kinds": [
                    {
                      "kind": "new-gtld",
                      "tlds": 5,
                      "domains": 1953010
                    },
                    {
                      "kind": "idn-cctld",
                      "tlds": 1,
                      "domains": 700600
                    }
                  ],
                  "zone": {
                    "date": "2026-09-18",
                    "tlds": 3,
                    "domains": 3539000
                  },
                  "url": "https://namedesk.app/stats",
                  "meta": {
                    "as_of": "2026-09-18",
                    "updated_at": "2026-09-28T03:40:00Z",
                    "attribution": "Statistics by Namedesk (https://namedesk.app). Registry statistics from ICANN monthly registry reports and registry operators' own reports. Zone counts from ICANN CZDS zone files."
                  }
                }
              }
            }
          },
          "302": {
            "$ref": "#/components/responses/StatsCanonical"
          },
          "400": {
            "$ref": "#/components/responses/StatsBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/StatsUnauthorized"
          },
          "429": {
            "$ref": "#/components/responses/StatsRateLimited"
          }
        }
      }
    },
    "/v1/stats/periods": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "Months covered",
        "description": "Every month the registry reports cover, oldest first. Some months are missing.",
        "operationId": "listStatsPeriods",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/StatsLimit"
          },
          {
            "$ref": "#/components/parameters/StatsCursor"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of months.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StatsPeriod"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Null on the last page."
                    },
                    "query": {
                      "type": "object",
                      "description": "The parameters as resolved: defaults filled in, bounds clamped.",
                      "properties": {
                        "limit": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "limit"
                      ],
                      "additionalProperties": false
                    },
                    "bounds": {
                      "$ref": "#/components/schemas/StatsBounds"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StatsMeta"
                    }
                  },
                  "required": [
                    "items",
                    "next_cursor",
                    "query",
                    "meta"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "items": [
                    {
                      "period": "2024-01"
                    },
                    {
                      "period": "2024-02"
                    }
                  ],
                  "next_cursor": "eyJrIjoiL3YxL3N0YXRzL3BlcmlvZHM_e30iLCJhdCI6IjIwMjQtMDIifQ",
                  "query": {
                    "limit": 2
                  },
                  "bounds": {
                    "first": "2024-01",
                    "last": "2026-05"
                  },
                  "meta": {
                    "as_of": "2024-02",
                    "updated_at": "2026-09-28T03:40:00Z",
                    "attribution": "Statistics by Namedesk (https://namedesk.app). Registry statistics from ICANN monthly registry reports and registry operators' own reports."
                  }
                }
              }
            }
          },
          "302": {
            "$ref": "#/components/responses/StatsCanonical"
          },
          "400": {
            "$ref": "#/components/responses/StatsBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/StatsUnauthorized"
          },
          "429": {
            "$ref": "#/components/responses/StatsRateLimited"
          }
        }
      }
    },
    "/v1/stats/dns": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "DNS queries by month",
        "description": "The DNS queries the generic TLD registries answered each month, as they report them to ICANN, oldest first: every operator summed, and the six companies with the most queries in the newest month.",
        "operationId": "getStatsDns",
        "security": [],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "First month, YYYY-MM, inclusive. Default 2014-01; a month after the newest is the newest.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
              "example": "2026-05"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The months.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "first": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                      "example": "2026-05",
                      "description": "The first month in `months`."
                    },
                    "last": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                      "example": "2026-05",
                      "description": "The newest month with a queries figure."
                    },
                    "months": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "period": {
                            "type": "string",
                            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                            "example": "2026-05"
                          },
                          "queries": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "DNS queries the registries' name servers received that month (UDP and TCP)."
                          },
                          "domains": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Names under management in the TLDs with a queries figure, for queries per domain. Absent when that month's figure is an estimate rather than the registries' own report."
                          },
                          "operators": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Registry operators with queries that month."
                          }
                        },
                        "required": [
                          "period",
                          "queries",
                          "operators"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "operators": {
                      "type": "array",
                      "description": "The six companies with the most queries in `last`, most first. A company is a registry operator, or the operators that share an owner (as /v1/stats/groups names it).",
                      "items": {
                        "type": "object",
                        "properties": {
                          "family": {
                            "type": "string",
                            "example": "Verisign"
                          },
                          "months": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "period": {
                                  "type": "string",
                                  "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
                                  "example": "2026-05"
                                },
                                "queries": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "description": "DNS queries the registries' name servers received that month (UDP and TCP)."
                                },
                                "domains": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "description": "Names under management in the TLDs with a queries figure, for queries per domain. Absent when that month's figure is an estimate rather than the registries' own report."
                                }
                              },
                              "required": [
                                "period",
                                "queries"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "family",
                          "months"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StatsMeta"
                    }
                  },
                  "required": [
                    "first",
                    "last",
                    "months",
                    "operators",
                    "meta"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "first": "2026-04",
                  "last": "2026-05",
                  "months": [
                    {
                      "period": "2026-04",
                      "queries": 24070761064895,
                      "domains": 258858220,
                      "operators": 454
                    },
                    {
                      "period": "2026-05",
                      "queries": 24742003482652,
                      "domains": 261066281,
                      "operators": 438
                    }
                  ],
                  "operators": [
                    {
                      "family": "Verisign",
                      "months": [
                        {
                          "period": "2026-04",
                          "queries": 18859690009315,
                          "domains": 181123395
                        },
                        {
                          "period": "2026-05",
                          "queries": 19591870797855,
                          "domains": 182017968
                        }
                      ]
                    }
                  ],
                  "meta": {
                    "as_of": "2026-05",
                    "updated_at": "2026-10-29T03:40:00Z",
                    "attribution": "Statistics by Namedesk (https://namedesk.app). Registry statistics from ICANN monthly registry reports and registry operators' own reports."
                  }
                }
              }
            }
          },
          "302": {
            "$ref": "#/components/responses/StatsCanonical"
          },
          "400": {
            "$ref": "#/components/responses/StatsBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/StatsUnauthorized"
          },
          "429": {
            "$ref": "#/components/responses/StatsRateLimited"
          }
        }
      }
    },
    "/v1/stats/drop-catch": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "Drop catching in .com by year and half-year",
        "description": "Who catches deleted .com domains: the registrars that, over a full year, made more than 500,000 .com registration attempts and more than 200 for each domain they won. Every full year since 2014, with the newest year's companies, most domains caught first; every half-year with the domains kept past their first five days, and the newest half's three leaders.",
        "operationId": "getStatsDropCatch",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "The years and the newest year's companies.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tld": {
                      "type": "string",
                      "enum": [
                        "com"
                      ]
                    },
                    "year": {
                      "type": "string",
                      "pattern": "^[0-9]{4}$",
                      "example": "2025",
                      "description": "The newest full year."
                    },
                    "years": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "year": {
                            "type": "string",
                            "pattern": "^[0-9]{4}$",
                            "example": "2025"
                          },
                          "registrars": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Accreditations that passed the drop-catch rule that year."
                          },
                          "attempts": {
                            "type": "integer",
                            "minimum": 0,
                            "description": ".com registration attempts those accreditations made that year (ICANN attempted adds)."
                          },
                          "caught": {
                            "type": "integer",
                            "minimum": 0,
                            "description": ".com names those accreditations registered that year."
                          },
                          "returned": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Domains deleted within the five-day add grace period that year; can exceed `caught`."
                          },
                          "deleted": {
                            "type": "integer",
                            "minimum": 0,
                            "description": ".com names deleted after the add grace period that year, over every accredited registrar."
                          }
                        },
                        "required": [
                          "year",
                          "registrars",
                          "attempts",
                          "caught",
                          "returned"
                        ],
                        "additionalProperties": false
                      },
                      "description": "Every full year, oldest first."
                    },
                    "companies": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "example": "TurnCommerce",
                            "description": "The company: a registrar family as /v1/stats/groups names it, else the one accreditation."
                          },
                          "registrars": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Its accreditations that passed the drop-catch rule that year."
                          },
                          "attempts": {
                            "type": "integer",
                            "minimum": 0,
                            "description": ".com registration attempts those accreditations made that year (ICANN attempted adds)."
                          },
                          "caught": {
                            "type": "integer",
                            "minimum": 0,
                            "description": ".com names those accreditations registered that year."
                          },
                          "returned": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Domains deleted within the five-day add grace period that year; can exceed `caught`."
                          },
                          "previous": {
                            "type": "object",
                            "properties": {
                              "registrars": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "Its accreditations that passed the drop-catch rule that year."
                              },
                              "attempts": {
                                "type": "integer",
                                "minimum": 0,
                                "description": ".com registration attempts those accreditations made that year (ICANN attempted adds)."
                              },
                              "caught": {
                                "type": "integer",
                                "minimum": 0,
                                "description": ".com names those accreditations registered that year."
                              },
                              "returned": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "Domains deleted within the five-day add grace period that year; can exceed `caught`."
                              }
                            },
                            "required": [
                              "registrars",
                              "attempts",
                              "caught",
                              "returned"
                            ],
                            "additionalProperties": false,
                            "description": "The same figures for the year before, when it had drop-catch accreditations then."
                          },
                          "url": {
                            "type": "string",
                            "format": "uri",
                            "description": "Its company page, or the accreditation's page."
                          }
                        },
                        "required": [
                          "name",
                          "registrars",
                          "attempts",
                          "caught",
                          "url",
                          "returned"
                        ],
                        "additionalProperties": false
                      },
                      "description": "The companies in `year`, most names caught first."
                    },
                    "leaders": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "example": "Gname"
                          },
                          "years": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "year": {
                                  "type": "string",
                                  "pattern": "^[0-9]{4}$",
                                  "example": "2025"
                                },
                                "registrars": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                "attempts": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                "caught": {
                                  "type": "integer",
                                  "minimum": 0
                                },
                                "returned": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "description": "Domains deleted within the five-day add grace period that year; can exceed `caught`."
                                }
                              },
                              "required": [
                                "year",
                                "registrars",
                                "attempts",
                                "caught",
                                "returned"
                              ],
                              "additionalProperties": false
                            },
                            "description": "Every full year it had drop-catch registrars, oldest first."
                          }
                        },
                        "required": [
                          "name",
                          "years"
                        ],
                        "additionalProperties": false
                      },
                      "description": "The newest year's three largest companies, with every year since their first."
                    },
                    "halves": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "half": {
                            "type": "string",
                            "pattern": "^[0-9]{4}-H[12]$",
                            "example": "2026-H1"
                          },
                          "registrars": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Accreditations that passed the drop-catch rule that half-year."
                          },
                          "attempts": {
                            "type": "integer",
                            "minimum": 0,
                            "description": ".com registration attempts they made that half-year (ICANN attempted adds)."
                          },
                          "caught": {
                            "type": "integer",
                            "minimum": 0,
                            "description": ".com names they registered that half-year."
                          },
                          "returned": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "Domains deleted within the five-day add grace period that half-year; can exceed `caught`."
                          },
                          "kept": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "`caught` less `returned`, counted per company and never below zero: the domains caught and kept."
                          },
                          "leaders": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "name": {
                                  "type": "string",
                                  "example": "TurnCommerce"
                                },
                                "registrars": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "description": "Accreditations that passed the drop-catch rule that half-year."
                                },
                                "attempts": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "description": ".com registration attempts they made that half-year (ICANN attempted adds)."
                                },
                                "caught": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "description": ".com names they registered that half-year."
                                },
                                "returned": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "description": "Domains deleted within the five-day add grace period that half-year; can exceed `caught`."
                                },
                                "kept": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "description": "`caught` less `returned`, counted per company and never below zero: the domains caught and kept."
                                }
                              },
                              "required": [
                                "name",
                                "registrars",
                                "attempts",
                                "caught",
                                "returned",
                                "kept"
                              ],
                              "additionalProperties": false
                            },
                            "description": "The newest half's three companies that kept the most, in that order, each half it had drop-catch registrars."
                          }
                        },
                        "required": [
                          "half",
                          "registrars",
                          "attempts",
                          "caught",
                          "returned",
                          "kept",
                          "leaders"
                        ],
                        "additionalProperties": false
                      },
                      "description": "Every half-year with all six months of .com reports, oldest first. The rule is the year's with its lines halved: more than 250,000 attempts, more than 200 for each name, under 50,000 .com names held at the half's end."
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StatsMeta"
                    }
                  },
                  "required": [
                    "tld",
                    "year",
                    "years",
                    "companies",
                    "leaders",
                    "halves",
                    "meta"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "tld": "com",
                  "year": "2025",
                  "years": [
                    {
                      "year": "2024",
                      "registrars": 2242,
                      "attempts": 6460285017,
