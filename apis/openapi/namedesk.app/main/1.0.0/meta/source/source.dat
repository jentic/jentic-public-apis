            "type": "string"
          },
          "domains": {
            "type": "integer",
            "minimum": 0
          },
          "change": {
            "type": "integer"
          },
          "change_year": {
            "type": "integer"
          },
          "adds": {
            "type": "integer",
            "minimum": 0
          },
          "share_pct": {
            "type": "number",
            "description": "Percent of the TLD's domains, two decimals."
          }
        },
        "required": [
          "tld",
          "domains"
        ],
        "additionalProperties": false
      },
      "StatsGroup": {
        "type": "object",
        "description": "One owner: its registrars and its registry operators, each present when it has members of that kind.",
        "properties": {
          "slug": {
            "type": "string",
