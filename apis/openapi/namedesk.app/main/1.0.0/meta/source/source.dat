    "/v1/stats/groups/{slug}": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "Get a company",
        "description": "A whole company. One that runs several registry operators (Identity Digital) or holds several registrars (GoDaddy) is complete only here: `registries` lists its operators and `registrars` its registrars, each with its own figure, and each list's `domains` is its members' sum (domains in the operators' TLDs; domains the registrars sell). The slug is the company's name in lower case, each run of other characters one hyphen: the `group` a registry operator or registrar carries, or the `slug` on a company row of the registry or registrar list with `view=groups`.",
        "operationId": "getStatsGroup",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/StatsGroupSlug"
          }
        ],
        "responses": {
          "200": {
            "description": "The group.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsGroup"
                },
                "example": {
                  "slug": "godaddy",
                  "name": "GoDaddy",
                  "registrars": {
                    "members": [
                      {
                        "id": 146,
                        "name": "GoDaddy.com, LLC"
                      }
                    ],
                    "domains": {
                      "period": "2026-05",
                      "count": 1435000
                    }
                  },
                  "url": "https://namedesk.app/stats/groups/godaddy",
                  "meta": {
                    "as_of": "2026-05",
                    "updated_at": "2026-09-28T03:40:00Z",
                    "attribution": "Statistics by Namedesk (https://namedesk.app). Registry statistics from ICANN monthly registry reports and registry operators' own reports."
                  }
                }
              }
            }
          },
          "302": {
            "$ref": "#/components/responses/StatsCanonical"
          },
          "400": {
            "$ref": "#/components/responses/StatsBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/StatsUnauthorized"
          },
          "429": {
            "$ref": "#/components/responses/StatsRateLimited"
          },
          "404": {
            "$ref": "#/components/responses/StatsNotFound"
          }
        }
      }
    },
