                    "updated_at": "2026-11-01T03:40:00Z",
                    "attribution": "Statistics by Namedesk (https://namedesk.app). Companies and their websites from Y Combinator's public company directory; the state of each exact .com from ICANN CZDS zone files."
                  }
                }
              }
            }
          },
          "302": {
            "$ref": "#/components/responses/StatsCanonical"
          },
          "401": {
            "$ref": "#/components/responses/StatsUnauthorized"
          },
          "429": {
            "$ref": "#/components/responses/StatsRateLimited"
          }
        }
      }
    },
    "/v1/stats/tlds": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "List TLDs",
        "description": "Every TLD with a reported figure, at its newest month. `domains.estimated` marks a figure from the registry's own report. Sorted by `domains`; ties by TLD.",
        "operationId": "listStatsTlds",
        "security": [],
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "description": "Sorts on each TLD's newest month. Estimated figures have no `adds` and sort last.",
            "schema": {
              "type": "string",
              "enum": [
                "domains",
                "change",
                "adds",
                "name"
              ],
              "default": "domains"
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Defaults to `desc`, or `asc` when sorting by `name`.",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "kind",
            "in": "query",
            "description": "One or more, comma-joined.",
            "schema": {
              "type": "string",
              "example": "cctld,idn-cctld"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "One or more, comma-joined: brand, commerce, culture, ai-tech, geo, infra, other.",
            "schema": {
              "type": "string",
              "example": "geo"
            }
          },
          {
            "name": "registry",
            "in": "query",
            "description": "Registry operator ids, comma-joined (up to 50).",
            "schema": {
              "type": "string",
              "example": "69"
            }
          },
          {
            "$ref": "#/components/parameters/StatsQ"
          },
          {
            "$ref": "#/components/parameters/StatsLimit"
          },
          {
            "$ref": "#/components/parameters/StatsCursor"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of TLDs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Tld"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Null on the last page."
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Items across all pages."
                    },
                    "query": {
                      "type": "object",
                      "description": "The parameters as resolved: defaults filled in, bounds clamped.",
                      "properties": {
                        "sort": {
                          "type": "string",
                          "enum": [
                            "domains",
                            "change",
                            "adds",
                            "name"
                          ]
                        },
                        "order": {
                          "type": "string",
                          "enum": [
                            "asc",
                            "desc"
                          ]
                        },
                        "kind": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "cctld",
                              "idn-cctld",
                              "legacy-gtld",
                              "new-gtld",
                              "sponsored",
                              "infra",
                              "unknown"
                            ]
                          }
                        },
                        "category": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "brand",
                              "commerce",
                              "culture",
                              "ai-tech",
                              "geo",
                              "infra",
                              "other"
                            ]
                          }
                        },
                        "registry": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          }
                        },
                        "q": {
                          "type": "string"
                        },
                        "limit": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "sort",
                        "order",
                        "limit"
                      ],
                      "additionalProperties": false
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StatsMeta"
                    }
                  },
                  "required": [
                    "items",
                    "next_cursor",
                    "total",
                    "query",
                    "meta"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "items": [
                    {
                      "tld": "xyz",
                      "kind": "new-gtld",
                      "category": "other",
                      "delegated": "2014-02-19",
                      "registry": {
                        "id": 1,
                        "name": "XYZ.COM LLC"
                      },
                      "domains": {
                        "period": "2026-05",
                        "count": 1280000,
                        "change": 10000,
                        "change_year": 120000
                      },
                      "zone": {
                        "date": "2026-09-18",
                        "count": 1039000,
                        "for_sale": 400039,
                        "parked": 100000
                      },
                      "names": {
                        "count": 1039000,
                        "source": "zone",
                        "date": "2026-09-18"
                      },
                      "url": "https://namedesk.app/stats/tlds/xyz"
                    },
                    {
                      "tld": "xn--p1ai",
                      "unicode": "\u0440\u0444",
                      "kind": "idn-cctld",
                      "delegated": "2010-05-12",
                      "registry": {
                        "id": 8,
                        "name": "Coordination Center for TLD RU"
                      },
                      "domains": {
                        "period": "2026-05",
                        "count": 700600,
                        "change": 100,
                        "estimated": true
                      },
                      "url": "https://namedesk.app/stats/tlds/xn--p1ai"
                    }
                  ],
                  "next_cursor": "eyJrIjoiL3YxL3N0YXRzL3RsZHM_e1wic29ydFwiOlwiZG9tYWluc1wiLFwib3JkZXJcIjpcImRlc2NcIn0iLCJ2Ijo3MDA2MDAsInRsZCI6InhuLS1wMWFpIn0",
                  "total": 12,
                  "query": {
                    "sort": "domains",
                    "order": "desc",
                    "limit": 2
                  },
                  "meta": {
                    "as_of": "2026-09-18",
                    "updated_at": "2026-09-28T03:40:00Z",
                    "attribution": "Statistics by Namedesk (https://namedesk.app). Registry statistics from ICANN monthly registry reports and registry operators' own reports. Zone counts from ICANN CZDS zone files."
                  }
                }
              }
            }
          },
          "302": {
            "$ref": "#/components/responses/StatsCanonical"
          },
          "400": {
            "$ref": "#/components/responses/StatsBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/StatsUnauthorized"
          },
          "429": {
            "$ref": "#/components/responses/StatsRateLimited"
          }
        }
      }
    },
    "/v1/stats/tlds/{tld}": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "Get a TLD",
        "description": "One TLD, with its launch phases. `domains` is the registered total from registry reports. Our own nightly count is `names`: every registered domain when read from the zone file, or a floor when its source is `certificates` (domains in use with a certificate), so the registered total is higher. With no `domains` field there is no registered total for the TLD: quote the nightly count as a minimum (\"at least\"), not as the size of the TLD.",
        "operationId": "getStatsTld",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/StatsTld"
          }
        ],
        "responses": {
          "200": {
            "description": "The TLD.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tld"
                },
                "example": {
                  "tld": "mono",
                  "kind": "new-gtld",
                  "category": "commerce",
                  "delegated": "2015-03-01",
                  "registry": {
                    "id": 6,
                    "name": "XYZ Two LLC"
                  },
                  "phases": [
                    {
                      "phase": "sunrise",
                      "start": "2015-04-01",
                      "end": "2015-05-01"
                    },
                    {
                      "phase": "landrush",
                      "start": "2015-05-02",
                      "end": "2015-05-30"
                    },
                    {
                      "phase": "claims",
                      "start": "2015-06-01",
                      "end": "2015-08-30"
                    },
                    {
                      "phase": "general_availability",
                      "start": "2015-06-01"
                    },
                    {
                      "phase": "qualified_launch"
                    }
                  ],
                  "domains": {
                    "period": "2026-05",
                    "count": 32000,
                    "change": 500,
                    "change_year": 6000
                  },
                  "url": "https://namedesk.app/stats/tlds/mono",
                  "meta": {
                    "as_of": "2026-05",
                    "updated_at": "2026-09-28T03:40:00Z",
                    "attribution": "Statistics by Namedesk (https://namedesk.app). Registry statistics from ICANN monthly registry reports and registry operators' own reports. Launch periods from ICANN's TLD startup pages and the Trademark Clearinghouse calendar."
                  }
                }
              }
            }
          },
          "302": {
            "$ref": "#/components/responses/StatsCanonical"
          },
          "400": {
            "$ref": "#/components/responses/StatsBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/StatsUnauthorized"
          },
          "429": {
            "$ref": "#/components/responses/StatsRateLimited"
          },
          "404": {
            "$ref": "#/components/responses/StatsNotFound"
          }
        }
      }
    },
    "/v1/stats/tlds/{tld}/months": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "A TLD's months",
        "description": "Monthly figures, oldest first.",
        "operationId": "listStatsTldMonths",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/StatsTld"
          },
          {
            "$ref": "#/components/parameters/StatsFrom"
          },
          {
            "$ref": "#/components/parameters/StatsTo"
          },
          {
            "$ref": "#/components/parameters/StatsRange"
          },
          {
            "$ref": "#/components/parameters/StatsLimit"
          },
          {
            "$ref": "#/components/parameters/StatsCursor"
          }
        ],
        "responses": {
