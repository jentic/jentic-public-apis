    "/v1/stats/applications": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "List 2026 round applications",
        "description": "Applications in ICANN's 2026 new gTLD round, from applicants' public announcements and ICANN's published lists. One item per string and applicant.",
        "operationId": "listStatsApplications",
