    "/v1/stats/strings": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "List 2026 round strings",
        "description": "Strings in the 2026 round: applied for, named as a backup, or claimed and abandoned, chosen with `role` (by default, applied-for strings and backups). Each carries the AI assessment's score and verdict once the string is assessed.",
        "operationId": "listStatsStrings",
        "security": [],
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "description": "One or more roles, comma-joined. A string is listed when at least one application puts it in one of them. `applied`: applied for, with an application live on ICANN's list (an IDN variant label of an application counts here). `backup`: named as an application's replacement string. `deactivated`: named as a backup string that ICANN's list shows as deactivated. `abandoned`: announced, but not on ICANN's list. Default: `applied,backup`.",
            "schema": {
              "type": "string",
              "example": "applied,backup,deactivated",
              "default": "applied,backup"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "One or more statuses, comma-joined.",
            "schema": {
              "type": "string",
              "example": "confirmed,in-contention"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "One or more categories, comma-joined: ai-tech, crypto, commerce, geo, brand, culture, infra, other.",
            "schema": {
              "type": "string",
              "example": "ai-tech"
            }
          },
          {
            "name": "contested",
            "in": "query",
            "description": "`true`: only strings two or more applicants are pursuing.",
            "schema": {
              "type": "string",
              "enum": [
                "false",
                "true"
              ],
              "default": "false"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "`score`: highest first, unassessed strings last. `contention`: most contenders first. `string`: A to Z. `first_seen`: newest first.",
            "schema": {
              "type": "string",
              "enum": [
                "score",
                "contention",
                "string",
                "first_seen"
              ],
              "default": "score"
            }
          },
          {
            "$ref": "#/components/parameters/StatsLimit"
          },
          {
            "$ref": "#/components/parameters/StatsCursor"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of strings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RoundString"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Null on the last page."
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Items across all pages."
                    },
                    "query": {
                      "type": "object",
                      "description": "The parameters as resolved: defaults filled in, bounds clamped.",
                      "properties": {
                        "status": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "catalogued",
                              "rumored",
                              "announced",
                              "confirmed",
                              "ghost",
                              "retracted",
                              "withdrawn",
                              "in-contention",
                              "auction-lost",
                              "will-not-proceed",
                              "delegated",
                              "sunrise",
                              "launched",
                              "terminated",
                              "replacement",
                              "variant",
                              "switched",
                              "deactivated"
                            ]
                          }
                        },
                        "category": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "ai-tech",
                              "crypto",
                              "commerce",
                              "geo",
                              "brand",
                              "culture",
                              "infra",
                              "other"
                            ]
                          }
                        },
                        "contested": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        },
                        "role": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "applied",
                              "backup",
                              "deactivated",
                              "abandoned"
                            ]
                          }
                        },
                        "sort": {
                          "type": "string",
                          "enum": [
                            "score",
                            "contention",
                            "string",
                            "first_seen"
                          ]
                        },
                        "limit": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "sort",
                        "limit"
                      ],
                      "additionalProperties": false
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StatsMeta"
                    }
                  },
                  "required": [
                    "items",
                    "next_cursor",
                    "total",
                    "query",
                    "meta"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "items": [
                    {
