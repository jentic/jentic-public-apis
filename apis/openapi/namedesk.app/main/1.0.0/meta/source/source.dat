                      "description": "The parameters as resolved: defaults filled in, bounds clamped.",
                      "properties": {
                        "status": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "catalogued",
                              "rumored",
                              "announced",
                              "confirmed",
                              "ghost",
                              "retracted",
                              "withdrawn",
                              "in-contention",
                              "auction-lost",
                              "will-not-proceed",
                              "delegated",
                              "sunrise",
                              "launched",
                              "terminated",
                              "replacement",
                              "variant",
                              "switched",
                              "deactivated"
                            ]
                          }
                        },
                        "category": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": [
                              "ai-tech",
                              "crypto",
                              "commerce",
                              "geo",
                              "brand",
                              "culture",
                              "infra",
                              "other"
                            ]
                          }
                        },
                        "sort": {
                          "type": "string",
                          "enum": [
                            "announced",
                            "string",
                            "contention"
                          ]
                        },
                        "limit": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "sort",
                        "limit"
                      ],
                      "additionalProperties": false
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StatsMeta"
                    }
                  },
                  "required": [
                    "items",
                    "next_cursor",
                    "total",
                    "query",
                    "meta"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "items": [
                    {
                      "id": "3f0c9a52-6d1e-4b7a-9c2f-1a8e5d7b4c10",
                      "round": 2026,
                      "string": "agent",
                      "applicant": {
                        "id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                        "name": "Example Registry Inc."
                      },
                      "status": "confirmed",
                      "announced": "2026-04-12",
                      "contention": 2,
                      "source": {
                        "title": "We applied for .agent",
                        "url": "https://example.com/news/we-applied",
                        "publisher": "Example Registry Inc."
                      },
                      "icann_application_id": "1-1234-56789",
                      "contention_set": "42",
                      "replacement": {
                        "id": "5d7a1c3e-9b2f-4a6d-8e1c-2f4b6a8d0c35",
                        "string": "agents"
                      },
                      "url": "https://namedesk.app/tlds/agent"
                    }
                  ],
                  "next_cursor": "eyJrIjoiL3YxL3N0YXRzL2FwcGxpY2FudHMvMGExYjJjM2QtNGU1Zi00YTZiLThjN2QtOWUwZjFhMmIzYzRkL2FwcGxpY2F0aW9ucz97XCJzb3J0XCI6XCJhbm5vdW5jZWRcIn0iLCJ2IjoiMjAyNi0wNC0xMiIsImlkIjoiM2YwYzlhNTItNmQxZS00YjdhLTljMmYtMWE4ZTVkN2I0YzEwIn0",
                  "total": 12,
                  "query": {
                    "sort": "announced",
                    "limit": 1
                  },
                  "meta": {
                    "updated_at": "2026-10-08T09:30:12Z",
                    "attribution": "Statistics by Namedesk (https://namedesk.app). TLD round record from applicants' public announcements and ICANN's published lists."
                  }
                }
              }
            }
          },
          "302": {
            "$ref": "#/components/responses/StatsCanonical"
          },
          "400": {
            "$ref": "#/components/responses/StatsBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/StatsUnauthorized"
          },
          "429": {
            "$ref": "#/components/responses/StatsRateLimited"
          },
          "404": {
            "$ref": "#/components/responses/StatsNotFound"
          }
        }
      }
    },
    "/v1/stats/changes": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "2026 round changes",
        "description": "Every change to the round data, oldest first: a new application, a status change, a correction or a note.",
        "operationId": "listStatsChanges",
        "security": [],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "First day, YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-08"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Last day, YYYY-MM-DD.",
            "schema": {
              "type": "string",
              "format": "date",
              "example": "2026-10-08"
            }
          },
          {
            "name": "range",
            "in": "query",
            "description": "How far back from `to` when `from` is not given; `all` is up to five years.",
            "schema": {
              "type": "string",
              "enum": [
                "30d",
                "90d",
                "1y",
                "all"
              ],
              "default": "90d"
            }
          },
          {
            "$ref": "#/components/parameters/StatsLimit"
          },
          {
            "$ref": "#/components/parameters/StatsCursor"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of changes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RoundChange"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Null on the last page."
                    },
                    "query": {
                      "type": "object",
                      "description": "The parameters as resolved: defaults filled in, bounds clamped.",
                      "properties": {
                        "from": {
                          "type": "string",
                          "format": "date",
                          "example": "2026-10-08"
                        },
                        "to": {
                          "type": "string",
                          "format": "date",
                          "example": "2026-10-08"
                        },
                        "range": {
                          "type": "string",
                          "enum": [
                            "30d",
                            "90d",
                            "1y",
                            "all"
                          ]
                        },
                        "limit": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "range",
                        "limit"
                      ],
                      "additionalProperties": false
                    },
                    "bounds": {
                      "$ref": "#/components/schemas/StatsBounds"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/StatsMeta"
                    }
                  },
                  "required": [
                    "items",
                    "next_cursor",
                    "query",
                    "meta"
                  ],
                  "additionalProperties": false
                },
                "example": {
                  "items": [
                    {
                      "at": "2026-10-07T19:02:41Z",
                      "string": "agent",
                      "applicant": {
                        "id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                        "name": "Example Registry Inc."
                      },
                      "change": "status_changed",
                      "status": "confirmed",
                      "source": {
                        "title": "Applied-for strings",
                        "url": "https://example.com/applied-for-strings"
                      }
                    },
                    {
                      "at": "2026-10-08T09:30:12Z",
                      "string": "agent",
                      "applicant": {
                        "id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
                        "name": "Example Registry Inc."
                      },
                      "change": "corrected"
                    }
                  ],
                  "next_cursor": "eyJrIjoiL3YxL3N0YXRzL2NoYW5nZXM_e1wiZnJvbVwiOlwiMjAyNi0wNy0xMFwiLFwidG9cIjpcIjIwMjYtMTAtMDhcIixcInJhbmdlXCI6XCI5MGRcIn0iLCJhdCI6IjIwMjYtMTAtMDhUMDk6MzA6MTIuNDE4WiIsIm4iOjQyMTF9",
                  "query": {
                    "from": "2026-07-10",
                    "to": "2026-10-08",
                    "range": "90d",
                    "limit": 2
                  },
                  "bounds": {
                    "first": "2026-08-15",
                    "last": "2026-10-08"
                  },
                  "meta": {
                    "updated_at": "2026-10-08T09:30:12Z",
                    "attribution": "Statistics by Namedesk (https://namedesk.app). TLD round record from applicants' public announcements and ICANN's published lists."
                  }
                }
              }
            }
          },
          "302": {
            "$ref": "#/components/responses/StatsCanonical"
          },
          "400": {
            "$ref": "#/components/responses/StatsBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/StatsUnauthorized"
          },
          "429": {
            "$ref": "#/components/responses/StatsRateLimited"
          }
        }
      }
    },
    "/v1/stats/round/{round}": {
      "get": {
        "tags": [
          "Stats"
        ],
        "summary": "The 2026 round",
        "description": "ICANN's calendar for the round, where the round is on it, and how many applications, strings, applicants (companies), legal entities and contention sets it has.",
        "operationId": "getStatsRound",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/StatsRound"
          }
        ],
        "responses": {
          "200": {
            "description": "The round.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Round"
                },
                "example": {
                  "round": 2026,
                  "phase": "replacement_period",
                  "milestones": [
                    {
                      "milestone": "reveal_day",
                      "start": "2026-10-07T18:00:00Z"
                    },
                    {
                      "milestone": "replacement_period",
                      "start": "2026-10-08T00:01:00Z",
                      "end": "2026-10-21T23:59:00Z"
                    },
                    {
                      "milestone": "string_confirmation_day",
                      "start": "2026-11-17"
                    },
                    {
                      "milestone": "refund_deadline",
                      "end": "2026-11-27T23:59:00Z"
                    },
                    {
                      "milestone": "objections",
                      "start": "2026-11-17",
                      "end": "2027-03-16"
                    },
                    {
                      "milestone": "icann_closed",
                      "start": "2026-12-19T01:00:00Z",
                      "end": "2027-01-04T16:00:00Z"
                    },
                    {
                      "milestone": "prioritization_draw",
                      "when": "H1 2027, date to be set"
                    }
                  ],
                  "counts": {
                    "applications": 958,
                    "strings": 731,
                    "applicants": 402,
                    "companies": 402,
                    "legal_entities": 480,
                    "abandoned_applicants": 3,
                    "contention_sets": 96
                  },
                  "revealed": true,
                  "url": "https://namedesk.app/tlds",
                  "meta": {
                    "updated_at": "2026-10-08T09:30:12Z",
                    "attribution": "Statistics by Namedesk (https://namedesk.app). TLD round record from applicants' public announcements and ICANN's published lists."
                  }
                }
              }
            }
          },
          "302": {
            "$ref": "#/components/responses/StatsCanonical"
          },
          "400": {
            "$ref": "#/components/responses/StatsBadRequest"
          },
          "401": {
            "$ref": "#/components/responses/StatsUnauthorized"
          },
          "429": {
            "$ref": "#/components/responses/StatsRateLimited"
          },
          "404": {
            "$ref": "#/components/responses/StatsNotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Generate a key in Settings -> API keys. The full key is shown once when created."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Same key as `x-api-key`, sent as `Authorization: Bearer <key>`. Either auth scheme works; pick whichever your client prefers."
      }
    },
    "parameters": {
      "JobId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "example": "job_a3f2c91d"
        },
        "description": "The job id returned when the job was submitted."
      },
      "Domain": {
        "name": "domain",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "example": "acme.ai"
        },
        "description": "The domain, e.g. acme.ai."
      },
      "StatsLimit": {
        "name": "limit",
        "in": "query",
        "description": "Page size, 1 to 1000. Defaults to 100.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        }
      },
      "StatsCursor": {
        "name": "cursor",
        "in": "query",
        "description": "The `next_cursor` of the previous page. It is bound to the query it came from: change any other parameter and start again without it.",
        "schema": {
          "type": "string"
        }
      },
      "StatsPeriod": {
        "name": "period",
        "in": "query",
        "description": "A month, YYYY-MM. Defaults to the newest month; clamped to the months that exist and echoed in `query`.",
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "example": "2026-05"
        }
      },
      "StatsFrom": {
        "name": "from",
        "in": "query",
        "description": "First month, YYYY-MM, inclusive. Overrides `range`.",
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "example": "2026-05"
        }
      },
      "StatsTo": {
        "name": "to",
        "in": "query",
        "description": "Last month, YYYY-MM, inclusive. Defaults to the newest.",
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
          "example": "2026-05"
        }
      },
      "StatsRange": {
        "name": "range",
        "in": "query",
        "description": "How far back from `to` when `from` is not given.",
        "schema": {
          "type": "string",
          "enum": [
            "1y",
            "3y",
            "5y",
            "10y",
            "all"
          ],
          "default": "10y"
        }
      },
      "StatsQ": {
        "name": "q",
        "in": "query",
        "description": "Contained in the name (or the TLD), case-insensitive, 1 to 64 characters.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "StatsGroupFilter": {
        "name": "group",
        "in": "query",
        "description": "Only this group, by its exact name (the `group` field).",
        "schema": {
          "type": "string",
          "maxLength": 200
        }
      },
      "StatsTld": {
        "name": "tld",
        "in": "path",
        "required": true,
        "description": "The A-label, lower case.",
        "schema": {
          "type": "string",
          "example": "xyz"
        }
      },
      "StatsRegistryId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "example": "69"
        }
      },
      "StatsRegistrarId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The IANA registrar id, or `iana:` followed by it.",
        "schema": {
          "type": "string",
          "pattern": "^(iana:)?[1-9][0-9]*$",
          "example": "146"
        }
      },
      "StatsGroupSlug": {
        "name": "slug",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "example": "godaddy"
        }
      },
      "StatsApplicationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "example": "3f0c9a52-6d1e-4b7a-9c2f-1a8e5d7b4c10"
        }
      },
      "StatsApplicantId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "example": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"
        }
      },
      "StatsRoundString": {
        "name": "string",
        "in": "path",
        "required": true,
        "description": "The A-label, lower case.",
        "schema": {
          "type": "string",
          "example": "agent"
        }
      },
      "StatsRound": {
        "name": "round",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "2026"
          ]
        }
      },
      "StatsView": {
        "name": "view",
        "in": "query",
        "required": false,
        "description": "`members` (the default): one row per registry operator or registrar. `groups`: one row per company, its members' figures summed; a member with no parent company is listed as itself. With `groups`, `group` is refused and the sorts are the company row's (`domains`, `tlds`, `name` for registries; `domains`, `adds`, `name` for registrars).",
        "schema": {
          "type": "string",
          "enum": [
            "members",
            "groups"
          ],
          "default": "members"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[ -~]+$"
        },
        "description": "Optional. Any 1 to 255 printable ASCII characters; a UUID works well. Send the same key when you retry: for 24 hours, the same key with the same body returns the first response and charges nothing more. The same key with a different body is refused with 409 `idempotency_key_reused`, and while the first request is still running, with 409 `idempotency_request_in_progress`. Without a key, every request is a new submission. A key belongs to the API key that sent it: the same value sent with another of your team's API keys is a separate request."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Request validation failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid `x-api-key`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found or not owned by this organization.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "StatsCanonical": {
        "description": "The query string carried an unknown parameter or was not in standard form: a redirect to the same query in standard form. Follow it.",
        "headers": {
          "Location": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "StatsBadRequest": {
        "description": "A parameter has a bad value or was repeated (`invalid_parameter`, with `details.accepted`), or the cursor belongs to another query (`invalid_cursor`). Unknown parameters are ignored.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StatsError"
            }
          }
        }
      },
      "StatsUnauthorized": {
        "description": "An API key was sent and is not valid. Send none to read anonymously.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StatsError"
            }
          }
        }
      },
      "StatsNotFound": {
        "description": "No such entity (`tld_not_found`, `registry_not_found`, `registrar_not_found`, `group_not_found`, `application_not_found`, `applicant_not_found`, `string_not_found`, `round_not_found`, with `details.id`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StatsError"
            }
          }
        }
      },
      "StatsRateLimited": {
        "description": "Too many requests from this address in a minute (`rate_limited`). An API key raises the limit.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/StatsError"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable machine-readable error code (e.g. `invalid_domain`, `insufficient_credits`, `not_yet_researched`).",
            "example": "insufficient_credits"
          },
          "message": {
            "type": "string",
            "description": "Human-readable description of what went wrong."
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "CreateResearchJobRequest": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "string",
              "example": "acme.ai"
            },
            "description": "Between 1 and 100 unique domains."
          },
          "label": {
            "type": "string",
            "maxLength": 80,
            "description": "Optional human-readable label shown in the dashboard, completion email, and activity feed."
          }
        },
        "required": [
          "domains"
        ]
      },
      "ResearchJob": {
        "type": "object",
        "description": "A job and every domain in it.",
        "properties": {
          "id": {
            "type": "string",
            "example": "job_a3f2c91d"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "cancelled"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "api",
              "csv"
            ],
            "description": "Where the job was submitted: the API, or a CSV upload in the dashboard."
          },
          "mode": {
            "type": "string",
            "enum": [
              "full",
              "quick"
            ],
            "description": "`full`: every domain gets the full appraisal, 10 credits each. `quick`: a quick check on each domain decides whether the full appraisal is worth it; the others get a quick read at 1 credit each."
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "credits_charged": {
            "type": "integer",
            "description": "What your wallet has paid for this job so far: the sum of its domains' charges. On a quick job it settles as each quick read finishes."
          },
          "credits_balance_after": {
            "type": "integer",
            "description": "Your wallet's balance when this answer was made."
          },
          "counts": {
            "type": "object",
            "description": "Domains by outcome. The job is done when `pending` and `running` are both 0.",
            "properties": {
              "total": {
                "type": "integer"
              },
              "pending": {
                "type": "integer"
              },
              "running": {
                "type": "integer"
              },
              "paid": {
                "type": "integer"
              },
              "cached": {
                "type": "integer"
              },
              "failed": {
                "type": "integer"
              }
            },
            "required": [
              "total",
              "pending",
              "running",
              "paid",
              "cached",
              "failed"
            ]
          },
          "domains": {
            "type": "array",
            "description": "Each domain in the job.",
            "items": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "running",
                    "paid",
                    "cached",
                    "failed"
                  ],
                  "description": "`paid`: appraised in this job. `cached`: your team had already appraised it, so it cost nothing. `failed`: it did not finish and was not charged."
                },
                "read_type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "full",
                    "quick",
                    null
                  ],
                  "description": "`full` or `quick` once the domain is `paid` or `cached`; null until then."
                },
                "read_reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "One sentence on why the domain got a quick read or the full appraisal, when a quick check decided it."
                },
                "credits_charged": {
                  "type": "integer",
                  "description": "0 until the domain is `paid`; then 1 for a quick read, 10 for the full appraisal."
                },
                "report_url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri",
                  "description": "The domain's report, once it is `paid` or `cached`."
                }
              },
              "required": [
                "domain",
                "outcome",
                "read_type",
                "read_reason",
                "credits_charged",
                "report_url"
              ]
            }
          },
          "status_url": {
            "type": "string",
            "format": "uri"
          },
          "invalid": {
            "type": "array",
            "description": "On submission only, when some entries were not valid domains: each with its position (from 1) and the reason. The job runs for the rest.",
            "items": {
              "type": "object",
              "properties": {
                "line": {
                  "type": "integer"
                },
                "raw": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "line",
                "raw",
                "reason"
              ]
            }
          },
          "credits_refunded": {
            "type": "integer",
            "description": "On cancel only: the credits returned to your wallet."
          }
        },
        "required": [
          "id",
          "status",
          "source",
          "mode",
          "submitted_at",
          "completed_at",
          "credits_charged",
          "credits_balance_after",
          "counts",
          "domains",
          "status_url"
        ]
      },
      "DomainReport": {
        "type": "object",
        "description": "Comprehensive research report for a single domain. Returned by /v1/report/{domain} and /v1/research-jobs/{id}/report/{domain}. Null-valued keys are OMITTED from the response (a missing key means the underlying signal has not been computed for this domain). Free text fields are capped at 4 KB. `verdict` is the most recent verdict regardless of which intent it was computed for; customers who need a different intent should re-run research with that intent.",
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "description": "Bumps on breaking changes; additive changes keep 1.0."
          },
          "exported_at": {
            "type": "string",
            "format": "date-time"
          },
          "domain": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "acme.ai"
              },
              "sld": {
                "type": "string",
                "example": "acme"
              },
              "tld": {
                "type": "string",
                "example": ".ai"
              },
              "report_url": {
                "type": "string",
                "format": "uri",
                "description": "Permalink to the human-readable dashboard view."
              },
              "share_url": {
                "type": "string",
                "format": "uri",
                "description": "Public share URL when the report has been published; absent otherwise."
              }
            },
            "required": [
              "name",
              "sld",
              "tld",
              "report_url"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "partial"
            ],
            "description": "complete = premium probes ran; partial = free-tier signals only."
          },
          "history": {
            "type": "object",
            "properties": {
              "first_researched_at": {
                "type": "string",
                "format": "date-time"
              },
              "last_refreshed_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "first_researched_at",
              "last_refreshed_at"
            ]
          },
          "name_shape": {
            "type": "object",
            "description": "Deterministic features computed from the domain string. Always present (no compute required).",
            "properties": {
              "char_length": {
                "type": "integer",
                "minimum": 1
              },
              "char_length_class": {
                "type": "string",
                "example": "premium"
              },
              "tld_tier": {
                "type": "string",
                "example": "premium"
              },
              "pattern_class": {
                "type": "string",
                "example": "dictionary"
              },
              "syllable_count": {
                "type": "integer",
                "minimum": 0
              },
              "is_single_syllable": {
                "type": "boolean"
              },
              "is_alpha_only": {
                "type": "boolean"
              },
              "has_numbers": {
                "type": "boolean"
              },
              "has_hyphens": {
                "type": "boolean"
              },
              "is_dictionary_likely": {
                "type": "boolean"
              },
              "is_short_premium": {
                "type": "boolean"
              },
              "brandability_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "commercial_intent_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "verdict": {
            "type": "object",
            "description": "Most recent verdict (any intent). Markdown allowed in `paragraph` and `alternative_suggestion`.",
            "properties": {
              "call": {
                "type": "string",
                "enum": [
                  "yes",
                  "yes_caveats",
                  "no_consider",
                  "pass",
                  "neutral"
                ]
              },
              "intent": {
                "type": "string",
                "enum": [
                  "build",
                  "monetize",
                  "invest",
                  "explore"
                ],
                "description": "Intent the verdict was computed against. Absent when the intent is not retrievable."
              },
              "paragraph": {
                "type": "string",
                "description": "Markdown. Multi-sentence rationale, capped at 4 KB."
              },
              "alternative_suggestion": {
                "type": "string",
                "description": "Suggested alternative when call is no/pass. Capped at 4 KB."
              },
              "computed_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "call",
              "paragraph",
              "computed_at"
            ]
          },
          "pricing": {
            "$ref": "#/components/schemas/Pricing"
          },
          "ai_signals": {
            "type": "object",
            "description": "LLM-derived signals. Each sub-block carries its own `engine_version` and `computed_at`; sub-blocks are omitted when absent.",
            "properties": {
              "frontier_recall": {
                "type": "object",
                "properties": {
                  "models_total": {
                    "type": "integer",
                    "description": "How many frontier models read the name."
                  },
                  "models_recognizing": {
                    "type": "integer",
                    "description": "How many returned knowledge_high >= 50."
                  },
                  "per_model": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "model": {
                          "type": "string"
                        },
                        "knowledge_low": {
                          "type": "integer"
                        },
                        "knowledge_high": {
                          "type": "integer"
                        },
                        "summary": {
                          "type": "string",
                          "description": "Free text, capped at 4 KB."
                        },
                        "inferred_category": {
                          "type": "string"
                        },
                        "associations": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "engine_version": {
                          "type": "string"
                        },
                        "probed_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "model",
                        "knowledge_low",
                        "knowledge_high",
                        "engine_version",
                        "probed_at"
                      ]
                    }
                  }
                },
                "required": [
                  "models_total",
                  "models_recognizing",
                  "per_model"
                ]
              },
              "attractor": {
                "type": "object",
                "description": "AI mindshare: how often AI models name this domain on their own in answers about its space. A domain AI names gets visitors without anyone searching for it.",
                "properties": {
                  "topics": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "samples_per_topic": {
                    "type": "integer"
                  },
                  "target_hits_per_topic": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer"
                    }
                  },
                  "cooccurring_domains": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "description": "Per topic: other domains the model surfaced alongside the target."
                  },
                  "near_miss_domains": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "description": "Per topic: near-variants the model emitted instead of the target."
                  },
                  "ranks_per_topic": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    }
                  },
                  "engine_version": {
                    "type": "string"
                  },
                  "computed_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "inference": {
                "type": "object",
                "description": "The industry AI reads into the domain, and how often its answers agree.",
                "properties": {
                  "top_industry": {
                    "type": "string"
                  },
                  "industry_agreement": {
                    "type": "integer"
                  },
                  "samples_count": {
                    "type": "integer"
                  },
                  "all_samples": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "engine_version": {
                    "type": "string"
                  },
                  "computed_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "coherence": {
                "type": "object",
                "description": "Why AI thinks people would visit the domain, and how often its answers agree.",
                "properties": {
                  "top_intent": {
                    "type": "string"
                  },
                  "intent_agreement": {
                    "type": "integer"
                  },
                  "samples_count": {
                    "type": "integer"
                  },
                  "all_samples": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "engine_version": {
                    "type": "string"
                  },
                  "computed_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "hallucination": {
                "type": "object",
                "description": "Cross-model factual-claim consistency check. Flags when models confidently invent history.",
                "properties": {
                  "verdict": {
                    "type": "string"
                  },
                  "models_with_knowledge": {
                    "type": "integer"
                  },
                  "models_count": {
                    "type": "integer"
                  },
                  "models_attempted": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "per_topic_claims": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "engine_version": {
                    "type": "string"
                  },
                  "computed_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          },
          "brand_signals": {
            "type": "object",
            "properties": {
              "spellability": {
                "type": "object",
                "description": "Given a pitch, did the LLM reach this domain in 10 candidate suggestions? Categorical, not numeric.",
                "properties": {
                  "target_match_type": {
                    "type": "string",
                    "enum": [
                      "exact",
                      "sld_match",
                      "variant",
                      "miss"
                    ]
                  },
                  "target_rank": {
                    "type": "integer",
                    "description": "1-based position of the best match (1 = first)."
                  },
                  "suggestions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "domain": {
                          "type": "string"
                        },
                        "reasoning": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "domain"
                      ]
                    }
                  },
                  "engine_version": {
                    "type": "string"
                  },
                  "computed_at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "target_match_type",
                  "engine_version",
                  "computed_at"
                ]
              },
              "lookalike_neighbors": {
                "type": "array",
                "description": "Domains the frontier models surfaced alongside the target \u2014 typo neighbours and brand confusables.",
                "items": {
                  "type": "object",
                  "properties": {
                    "variant": {
                      "type": "string"
                    },
                    "match_type": {
                      "type": "string",
                      "enum": [
                        "tld_swap",
                        "variant"
                      ]
                    },
                    "models_surfaced": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "snippets": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "variant",
                    "match_type",
                    "models_surfaced"
                  ]
                }
              },
              "commercial_intent": {
                "type": "object",
                "properties": {
                  "score": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "bucket": {
                    "type": "string"
                  },
                  "markers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "tokens": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Tokenization of the SLD."
                  }
                },
                "required": [
                  "score",
                  "bucket"
                ]
              }
            }
          },
          "free_tier_probes": {
            "type": "array",
            "description": "Reads from open (free-tier) AI models, reported separately from frontier_recall.",
            "items": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "knowledge_low": {
                  "type": "integer"
                },
                "knowledge_high": {
                  "type": "integer"
                },
                "summary": {
                  "type": "string"
                },
                "engine_version": {
                  "type": "string"
                },
                "probed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "model",
                "knowledge_low",
                "knowledge_high",
                "engine_version",
                "probed_at"
              ]
            }
          },
          "alternative_names": {
            "type": "array",
            "description": "Alternative names suggested by the recommendations engine. Present only when a recommendations run was triggered.",
            "items": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "recognition_level": {
                  "type": "string",
                  "enum": [
                    "none",
                    "vague",
                    "strong"
                  ]
                },
                "pitfalls_triggered": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rationale": {
                  "type": "string"
                }
              },
              "required": [
                "domain",
                "recognition_level"
              ]
            }
          },
          "marketplace": {
            "type": "object",
            "description": "DNS-signature detection of for-sale or parked status. Cached domain-level for ~1h.",
            "properties": {
              "listed": {
                "type": "boolean",
                "description": "True when a named marketplace was detected."
              },
              "marketplace_name": {
                "type": "string",
                "description": "Marketplace name when listed; absent when only parked."
              },
              "parked": {
                "type": "boolean",
                "description": "True when the domain has parking-platform NS but no named marketplace match."
              }
            },
            "required": [
              "listed",
              "parked"
            ]
          }
        },
        "required": [
          "schema_version",
          "exported_at",
          "domain",
          "status",
          "history",
          "name_shape"
        ]
      },
      "Pricing": {
        "type": "object",
        "description": "Tiered pricing band for a domain, priced by Namedesk's own pricing engine on the AI signals only Namedesk measures (whether AI already knows the name, names it on its own, and reads it right) alongside what the market pays. Returned by /v1/domains/{domain}/pricing as a slice; embedded in DomainReport for full report calls. Free text in `reasoning`, `key_factors`, and `risks` is capped at 4 KB per field.",
        "properties": {
          "wholesale": {
            "$ref": "#/components/schemas/PriceBand"
          },
          "aftermarket": {
            "$ref": "#/components/schemas/PriceBand"
          },
          "brokered": {
            "$ref": "#/components/schemas/PriceBand"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reasoning": {
            "type": "string",
            "description": "Markdown. Market-expert prose explaining the band."
          },
          "key_factors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to 5 reasons the band lands where it does."
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Up to 5 risks that bound the upside."
          },
          "model": {
            "type": "string",
            "description": "The model that wrote this appraisal.",
            "example": "opus-class"
          },
          "engine_version": {
            "type": "string",
            "description": "Version of the appraisal. A newer version replaces earlier reads."
          },
          "computed_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "wholesale",
          "aftermarket",
          "brokered",
          "confidence",
          "model",
          "engine_version",
          "computed_at"
        ]
      },
      "PriceBand": {
        "type": "object",
        "properties": {
          "low": {
            "type": "integer",
            "minimum": 0
          },
          "mid": {
            "type": "integer",
            "minimum": 0
          },
          "high": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "low",
          "mid",
          "high"
        ]
      },
      "JobDomainStatus": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "paid",
          "cached",
          "failed"
        ],
        "description": "Per-domain lifecycle inside a research job. `pending` = waiting to start; `running` = appraisal in progress; `paid` = finished successfully and the credits for this name were committed (1 credit for a quick read, 10 credits for a full read); `cached` = your organization already had a finished report for this name at submission time, so no new appraisal ran and no credits were charged for it; `failed` = the appraisal couldn't finish and the credits reserved for this name were returned to your wallet."
      },
      "JobReportEntry": {
        "type": "object",
        "description": "One row in /v1/research-jobs/{id}/report. `report` is present only for `paid` and `cached` outcomes; `error` is present only for `failed`. Pending and running entries carry just `domain` + `job_status`.",
        "properties": {
          "domain": {
            "type": "string",
            "example": "acme.ai"
          },
          "job_status": {
            "$ref": "#/components/schemas/JobDomainStatus"
          },
          "report": {
            "$ref": "#/components/schemas/DomainReport"
          },
          "error": {
            "type": "string",
            "description": "Stable, machine-readable code for why this name's appraisal couldn't finish. Examples: `concurrent_run_winner`, `fast_fail_pricing`, `model_timeout`. The same codes appear elsewhere in the API; safe to branch on."
          }
        },
        "required": [
          "domain",
          "job_status"
        ]
      },
      "JobPricingEntry": {
        "type": "object",
        "description": "One row in /v1/research-jobs/{id}/report/pricing. `pricing` is the full Pricing slice (numbers + reasoning + key_factors + risks, all 4 KB-capped) for `paid` and `cached` entries.",
        "properties": {
          "domain": {
            "type": "string",
            "example": "acme.ai"
          },
          "job_status": {
            "$ref": "#/components/schemas/JobDomainStatus"
          },
          "pricing": {
            "$ref": "#/components/schemas/Pricing"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "domain",
          "job_status"
        ]
      },
      "JobReportsResponse": {
        "type": "object",
        "description": "Wrapper for /v1/research-jobs/{id}/report. The `job` block embeds the same shape returned by /v1/research-jobs/{id} so customers can render progress + per-domain reports from a single call.",
        "properties": {
          "job": {
            "$ref": "#/components/schemas/ResearchJob"
          },
          "reports": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobReportEntry"
            }
          }
        },
        "required": [
          "job",
          "reports"
        ]
      },
      "JobPricingResponse": {
        "type": "object",
        "properties": {
          "job": {
            "$ref": "#/components/schemas/ResearchJob"
          },
          "pricing": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobPricingEntry"
            }
          }
        },
        "required": [
          "job",
          "pricing"
        ]
      },
      "StatsMeta": {
        "type": "object",
        "description": "On every stats response.",
        "properties": {
          "as_of": {
            "type": "string",
            "description": "The newest month (YYYY-MM) or date (YYYY-MM-DD) in the response. Absent when the response holds none.",
            "example": "2026-05"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the data in this response last changed: the monthly statistics' last update, or the round data's newest change. Absent on zone series.",
            "example": "2026-09-28T03:40:00Z"
          },
          "attribution": {
            "type": "string",
            "description": "The credit to show with this response: Namedesk first, as the terms require (https://namedesk.app/terms#statistics), then its sources. The sources follow the source actually served: a TLD counted from certificates is attributed to them (\"Names seen in certificate transparency logs and confirmed in DNS, a floor: a name with no certificate is not counted.\"), never to zone files.",
            "example": "Statistics by Namedesk (https://namedesk.app). Registry statistics from ICANN monthly registry reports."
          },
          "coverage": {
            "type": "number",
            "minimum": 0,
            "description": "On a single certificate-fed TLD with a registry figure: names.count / domains.count, a fraction with two decimals, how much of the registry's figure the names seen in certificates reach. Absent on a zone TLD: a zone count is a different measure, not a share of the figure.",
            "example": 0.32
          }
        },
        "required": [
          "attribution"
        ],
        "additionalProperties": false
      },
      "StatsError": {
        "type": "object",
        "description": "Every stats error.",
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable machine-readable code: `invalid_parameter`, `invalid_cursor`, `not_found`, `tld_not_found`, `registry_not_found`, `registrar_not_found`, `group_not_found`, `application_not_found`, `applicant_not_found`, `string_not_found`, `round_not_found`, `unauthorized`, `rate_limited`.",
            "example": "invalid_parameter"
          },
          "message": {
            "type": "string",
            "description": "A sentence a person can act on."
          },
          "details": {
            "type": "object",
            "properties": {
              "parameter": {
                "type": "string",
                "description": "The rejected parameter."
              },
              "value": {
                "type": "string",
                "description": "The value it was given."
              },
              "accepted": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The values or the form it accepts."
              },
              "id": {
                "type": "string",
                "description": "The path id that was not found."
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "request_id": {
            "type": "string",
            "description": "Also in the `X-Request-Id` header; quote it when asking for help."
          }
        },
        "required": [
          "error",
          "message",
          "request_id"
        ],
        "additionalProperties": false
      },
      "StatsBounds": {
        "type": "object",
        "description": "The first and last points a series has, whatever range was asked for.",
        "properties": {
          "first": {
            "type": "string",
            "description": "The oldest point that exists (YYYY-MM, or YYYY-MM-DD for zone nights)."
          },
          "last": {
            "type": "string",
            "description": "The newest point that exists."
          }
        },
        "required": [
          "first",
          "last"
        ],
        "additionalProperties": false
      },
      "StatsRef": {
        "type": "object",
        "description": "A reference to a registry or registrar; the full object is at its own endpoint.",
        "properties": {
          "id": {
            "type": "integer",
            "example": 146
          },
          "name": {
            "type": "string",
            "example": "GoDaddy.com, LLC"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "StatsDomains": {
        "type": "object",
        "description": "A stock figure as of a month.",
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "example": "2026-05"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "Domains under management that month."
          },
          "change": {
            "type": "integer",
            "description": "Against the month before."
          },
          "change_year": {
            "type": "integer",
            "description": "Against the same month a year before. Absent on an estimated figure."
          },
          "estimated": {
            "type": "boolean",
            "const": true,
            "description": "Present (and true) only when the figure is from the registry operator's own report rather than its ICANN monthly registry report."
          }
        },
        "required": [
          "period",
          "count"
        ],
        "additionalProperties": false
      },
      "TldPhase": {
        "type": "object",
        "description": "A launch phase. Dates are absent when the source gives none.",
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "sunrise",
              "claims",
              "landrush",
              "limited_registration",
              "qualified_launch",
              "exclusive_registration",
              "approved_launch",
              "general_availability"
            ]
          },
          "start": {
            "type": "string",
            "format": "date"
          },
          "end": {
            "type": "string",
            "format": "date",
            "description": "Absent for a phase with no end date (general availability)."
          }
        },
        "required": [
          "phase"
        ],
        "additionalProperties": false
      },
      "TldZone": {
        "type": "object",
        "description": "The newest night of the TLD's zone file, when its newest night is a zone file's. May be withdrawn if the registry revokes zone access.",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-09-18"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "Names in the zone that night."
          },
          "for_sale": {
            "type": "integer",
            "minimum": 0,
            "description": "Names whose nameservers are a marketplace's; present when the night was classified."
          },
          "parked": {
            "type": "integer",
            "minimum": 0,
            "description": "Names on a parking service; present when the night was classified."
          }
        },
        "required": [
          "date",
          "count"
        ],
        "additionalProperties": false
      },
      "TldNames": {
        "type": "object",
        "description": "The names we count for the TLD on its newest night, from its zone file or from certificates. `domains` stays the registry's own figure; `meta.coverage` is this count over it.",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "Names counted that night."
          },
          "source": {
            "type": "string",
            "enum": [
              "zone",
              "certificates"
            ],
            "description": "Where the count comes from. `zone`: the registry's zone file, every delegated name. `certificates`: names seen in certificate transparency logs and confirmed in DNS, a floor: a name with no certificate is not counted."
          },
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-09-18"
          }
        },
        "required": [
          "count",
          "source",
          "date"
        ],
        "additionalProperties": false
      },
      "Tld": {
        "type": "object",
        "description": "A top-level domain.",
        "properties": {
          "tld": {
            "type": "string",
            "description": "The A-label, lower case. Also the id.",
            "example": "xyz"
          },
          "unicode": {
            "type": "string",
            "description": "IDN only: the native-script form."
          },
          "kind": {
            "type": "string",
            "enum": [
              "cctld",
              "idn-cctld",
              "legacy-gtld",
              "new-gtld",
              "sponsored",
              "infra",
              "unknown"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "brand",
              "commerce",
              "culture",
              "ai-tech",
              "geo",
              "infra",
              "other"
            ]
          },
          "delegated": {
            "type": "string",
            "description": "Root-zone delegation date, at the precision known: YYYY-MM-DD, or YYYY-MM or YYYY for a few old TLDs."
          },
          "removed": {
            "type": "string",
            "description": "Date removed from the root, same precision rule. Absent for a live TLD."
          },
          "registry": {
            "$ref": "#/components/schemas/StatsRef",
            "description": "The operator today."
          },
          "phases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TldPhase"
            },
            "description": "On the single TLD only."
          },
          "domains": {
            "$ref": "#/components/schemas/StatsDomains",
            "description": "The newest month from an ICANN monthly report or the registry's own report, else the newest archived copy of one. Absent when no such figure exists."
          },
          "zone": {
            "$ref": "#/components/schemas/TldZone"
          },
          "names": {
            "$ref": "#/components/schemas/TldNames"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Its page on namedesk.app."
          },
          "meta": {
            "$ref": "#/components/schemas/StatsMeta",
            "description": "On the top-level object of a response only."
          }
        },
        "required": [
          "tld",
          "kind",
          "url"
        ],
        "additionalProperties": false
      },
      "TldMonth": {
        "type": "object",
        "description": "One month of a TLD.",
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "example": "2026-05"
          },
          "domains": {
            "type": "integer",
            "minimum": 0
          },
          "change": {
            "type": "integer"
          },
          "change_year": {
            "type": "integer"
          },
          "adds": {
            "type": "integer",
            "minimum": 0
          },
          "renews": {
            "type": "integer",
            "minimum": 0
          },
          "deletes": {
            "type": "integer",
            "minimum": 0
          },
          "transfers_in": {
            "type": "integer",
            "minimum": 0
          },
          "transfers_out": {
            "type": "integer",
            "minimum": 0
          },
          "restores": {
            "type": "integer",
            "minimum": 0
          },
          "registrars": {
            "type": "integer",
            "minimum": 0,
            "description": "How many registrars held names in the TLD that month. Absent where there is no registrar breakdown (ccTLDs)."
          },
          "estimated": {
            "type": "boolean",
            "const": true,
            "description": "The figure is not from an ICANN monthly report; such a month carries only `domains` and `change`."
          }
        },
        "required": [
          "period"
        ],
        "additionalProperties": false
      },
      "TldRegistrar": {
        "type": "object",
        "description": "One registrar's holding in a TLD for a month.",
        "properties": {
          "registrar": {
            "$ref": "#/components/schemas/StatsRef"
          },
          "domains": {
            "type": "integer",
            "minimum": 0
          },
          "share_pct": {
            "type": "number",
            "description": "Percent of the TLD's domains that month, two decimals."
          },
          "adds": {
            "type": "integer",
            "minimum": 0
          },
          "renews": {
            "type": "integer",
            "minimum": 0
          },
          "deletes": {
            "type": "integer",
            "minimum": 0
          },
          "transfers_in": {
            "type": "integer",
            "minimum": 0
          },
          "transfers_out": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "registrar",
          "domains"
        ],
        "additionalProperties": false
      },
      "ZoneDay": {
        "type": "object",
        "description": "One night of a TLD's names, from its zone file or from certificates. A TLD moving from certificates to a zone file continues the same series.",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-09-18"
          },
          "source": {
            "type": "string",
            "enum": [
              "zone",
              "certificates"
            ],
            "description": "Where the count comes from. `zone`: the registry's zone file, every delegated name. `certificates`: names seen in certificate transparency logs and confirmed in DNS, a floor: a name with no certificate is not counted."
          },
          "domains": {
            "type": "integer",
            "minimum": 0,
            "description": "Names counted that night (a floor when `source` is `certificates`)."
          },
          "entered": {
            "type": "integer",
            "minimum": 0,
            "description": "Names that appeared since the night before. Absent on the first night and after a gap."
          },
          "left": {
            "type": "integer",
            "minimum": 0,
            "description": "Names that dropped out since the night before. Absent on the first night and after a gap."
          },
          "for_sale": {
            "type": "integer",
            "minimum": 0
          },
          "parked": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "date",
          "source",
          "domains"
        ],
        "additionalProperties": false
      },
      "Registry": {
        "type": "object",
        "description": "A registry operator.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Our id, stable for v1.",
            "example": 69
          },
          "name": {
            "type": "string",
            "description": "The operator's brand when no other operator uses it (for example, GoDaddy Registry); otherwise the name ICANN lists.",
            "example": "GoDaddy Registry"
          },
          "legal_name": {
            "type": "string",
            "description": "The name ICANN lists for the operator (for example, Registry Services, LLC). Present only when `name` holds the brand.",
            "example": "Registry Services, LLC"
          },
          "group": {
            "type": "string",
            "description": "The company, when it has two or more operators; its slug (the name in lower case, runs of other characters as one hyphen) is the path of /v1/stats/groups/{slug}. An operator without `group` is its company's only operator, and the company's slug is that of its `name`."
          },
          "tlds": {
            "type": "integer",
            "minimum": 0,
            "description": "TLDs it runs today."
          },
          "domains": {
            "$ref": "#/components/schemas/StatsDomains",
            "description": "Summed over the TLDs it runs today, for the newest ICANN-report month. Absent when none of them has a figure that month."
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "applicants": {
            "type": "array",
            "description": "On a single operator (/v1/stats/registries/{id}), when there is one: the applicant companies in the 2026 round that a public source ties to this operator, from the round record (the 2026 round endpoints' source), not the registry reports.",
            "items": {
              "$ref": "#/components/schemas/RegistryApplicant"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/StatsMeta",
            "description": "On the top-level object of a response only."
          }
        },
        "required": [
          "id",
          "name",
          "tlds",
          "url"
        ],
        "additionalProperties": false
      },
      "RegistryApplicant": {
        "type": "object",
        "description": "An applicant company in the 2026 round that a public source ties to a registry operator.",
        "properties": {
          "name": {
            "type": "string"
          },
          "relation": {
            "type": "string",
            "enum": [
              "same-company",
              "shared-ownership",
              "shared-people",
              "shared-address"
            ],
            "description": "same-company: the operator is this company (the same legal entity, or wholly owned within one group). shared-ownership: one owns part of the other, or they have an owner in common. shared-people: a person in common. shared-address: a registered address in common, and nothing more."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The company's page on namedesk.app, which quotes the source."
          }
        },
        "required": [
          "name",
          "relation",
          "url"
        ],
        "additionalProperties": false
      },
      "RegistryTld": {
        "type": "object",
        "description": "A TLD a registry operator runs.",
        "properties": {
          "tld": {
            "type": "string"
          },
          "since": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "example": "2026-05",
            "description": "The month it took the TLD over."
          },
          "domains": {
            "$ref": "#/components/schemas/StatsDomains",
            "description": "The TLD's newest reported figure, as on Tld.domains (without change_year). Absent when no such figure exists."
          }
        },
        "required": [
          "tld",
          "since"
        ],
        "additionalProperties": false
      },
      "GroupTld": {
        "type": "object",
        "description": "A TLD one of a company's registry operators runs.",
        "properties": {
          "tld": {
            "type": "string"
          },
          "since": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "example": "2026-05",
            "description": "The month it took the TLD over."
          },
          "domains": {
            "$ref": "#/components/schemas/StatsDomains",
            "description": "The TLD's newest reported figure, as on Tld.domains (without change_year). Absent when no such figure exists."
          },
          "operator": {
            "$ref": "#/components/schemas/StatsRef",
            "description": "The operator running it."
          }
        },
        "required": [
          "tld",
          "since",
          "operator"
        ],
        "additionalProperties": false
      },
      "RegistryMonth": {
        "type": "object",
        "description": "One month of an operator, summed over the TLDs it runs today.",
        "properties": {
          "period": {
            "type": "string",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
            "example": "2026-05"
          },
          "domains": {
            "type": "integer",
            "minimum": 0
          },
          "adds": {
            "type": "integer",
            "minimum": 0
          },
          "deletes": {
            "type": "integer",
            "minimum": 0
          },
          "tlds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "period",
          "domains",
          "tlds"
        ],
        "additionalProperties": false
      },
      "Registrar": {
        "type": "object",
        "description": "An ICANN-accredited registrar.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Our id: equal to the IANA registrar id.",
            "example": 146
          },
          "iana_id": {
            "type": "integer",
            "example": 146
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "description": "The company (see /v1/stats/groups/{slug}; its slug is the name in lower case, runs of other characters as one hyphen)."
          },
          "tlds": {
            "type": "integer",
            "minimum": 0,
            "description": "TLDs it held names in that month."
          },
          "domains": {
            "$ref": "#/components/schemas/StatsDomains"
          },
          "drop_catch": {
            "type": "object",
            "description": "Its newest full year as a drop-catch registrar in .com (see /v1/stats/drop-catch), when it has one.",
            "properties": {
              "year": {
                "type": "string",
                "pattern": "^[0-9]{4}$",
                "example": "2025"
              },
              "attempts": {
                "type": "integer",
                "minimum": 0,
                "description": ".com registration attempts those accreditations made that year (ICANN attempted adds)."
              },
              "caught": {
                "type": "integer",
                "minimum": 0,
                "description": ".com names those accreditations registered that year."
              }
            },
            "required": [
              "year",
              "attempts",
              "caught"
            ],
            "additionalProperties": false
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "meta": {
            "$ref": "#/components/schemas/StatsMeta",
            "description": "On the top-level object of a response only."
          }
        },
        "required": [
          "id",
          "iana_id",
          "name",
          "tlds",
          "domains",
          "url"
        ],
        "additionalProperties": false
      },
      "RegistrarMonth": {
        "type": "object",
        "description": "One month of a registrar, summed over its TLDs. renews and deletes_after_grace are what its customers did with the names that came up for renewal (deletes_after_grace excludes names cancelled in the add grace period); transfers_in and transfers_out are names moved to and from it.",
        "properties": {
          "period": {
