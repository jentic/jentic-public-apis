            "type": "integer",
            "minimum": 0
          },
          "change": {
            "type": "integer"
          },
          "adds": {
            "type": "integer",
            "minimum": 0
          },
          "deletes": {
            "type": "integer",
            "minimum": 0
          },
          "tlds": {
            "type": "integer",
            "minimum": 0
          },
          "renews": {
            "type": "integer",
            "minimum": 0
          },
          "deletes_after_grace": {
            "type": "integer",
            "minimum": 0
          },
          "transfers_in": {
            "type": "integer",
            "minimum": 0
          },
          "transfers_out": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "period",
          "domains",
          "tlds"
        ],
        "additionalProperties": false
      },
      "RegistrarTld": {
        "type": "object",
        "description": "One TLD of a registrar for a month.",
        "properties": {
