{
  "openapi": "3.1.0",
  "info": {
    "title": "Plant Tournament",
    "version": "0.1.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/gabrielges/plant-tournament/0.1.0"
  },
  "servers": [
    {
      "url": "https://mad.gabrielg.es/api/v1"
    }
  ],
  "tags": [
    {
      "name": "user",
      "description": "Register and edit user profiles."
    },
    {
      "name": "plant"
    },
    {
      "name": "ranking",
      "description": "Create and obtain user rankings."
    }
  ],
  "paths": {
    "/user": {
      "post": {
        "tags": [
          "user"
        ],
        "summary": "Register a new user account.",
        "operationId": "registerUser",
        "requestBody": {
          "description": "User information.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserData"
              },
              "example": {
                "alias": "Alejandro",
                "age": 26,
                "profile_picture": "pfp_5.png"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created successfully. Returns a user token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRegisterResponse"
                },
                "example": {
                  "user_token": "XVAH0tnyovOQSdooyLsTuPh7NgybjWkwwNqSsmCOYQMk1Hhtk148DJ2hJaXv77j2"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "user"
        ],
        "summary": "Update user profile.",
        "operationId": "updateUser",
        "security": [
          {
            "UserToken": []
          }
        ],
        "requestBody": {
          "description": "User information.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              },
              "examples": {
                "profile_change": {
                  "summary": "Profile update",
                  "value": {
                    "alias": "Álex",
                    "age": 26,
                    "profile_picture": "pfp_4.png"
                  }
                },
                "profile_picture_change": {
                  "summary": "Profile picture change",
                  "value": {
                    "profile_picture": "pfp_0.png"
                  }
                },
                "score_change": {
                  "summary": "Score update",
                  "value": {
                    "score": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully."
          },
          "400": {
            "description": "Invalid request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid user token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/plant": {
      "get": {
        "tags": [
          "plant"
        ],
        "summary": "Obtain a random set of plants.",
        "operationId": "getPlant",
        "security": [
          {
            "UserToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "A random set of three plants.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantList"
                },
                "example": [
                  {
                    "name": "Cactus",
                    "picture": "https://upload.wikimedia.org/wikipedia/commons/thumb/1/18/C%C3%A1ctus._Cuacos_de_Yuste.jpg/1280px-C%C3%A1ctus._Cuacos_de_Yuste.jpg",
                    "main_necessity": "sun"
                  },
                  {
                    "name": "Cattail",
                    "picture": "https://upload.wikimedia.org/wikipedia/commons/5/59/Typha-cattails-in-indiana.jpg",
                    "main_necessity": "water"
                  },
                  {
                    "name": "Sunflower",
                    "picture": "https://upload.wikimedia.org/wikipedia/commons/d/d4/Helianthus_annuus_001.JPG",
                    "main_necessity": "friends"
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Invalid user token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ranking": {
      "get": {
        "tags": [
          "ranking"
        ],
        "summary": "Obtain a list of the top players.",
        "operationId": "getRanking",
        "security": [
          {
            "UserToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "A list of users and their score.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankingList"
                },
                "example": [
                  {
                    "alias": "Sergio",
                    "profile_picture": "pfp_0.png",
                    "score": 1000
                  },
                  {
                    "alias": "Gabriel",
                    "profile_picture": "pfp_10.png",
                    "score": 250
                  }
                ]
              }
            }
          },
          "401": {
            "description": "Invalid user token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserData": {
        "type": "object",
        "required": [
          "alias",
          "age",
          "profile_picture"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 3,
            "maxLength": 16
          },
          "age": {
            "type": "integer",
            "format": "uint64",
            "minimum": 16,
            "maximum": 100
          },
          "profile_picture": {
            "$ref": "#/components/schemas/ProfilePicture"
          }
        }
      },
      "UserUpdate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UserData",
            "required": null
          },
          {
            "type": "object",
            "properties": {
              "score": {
                "type": "integer",
                "format": "uint64"
              }
            }
          }
        ]
      },
      "UserRegisterResponse": {
        "type": "object",
        "required": [
          "user_token"
        ],
        "properties": {
          "user_token": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          }
        }
      },
      "ProfilePicture": {
        "type": "string",
        "enum": [
          "pfp_0.png",
          "pfp_1.png",
          "pfp_2.png",
          "pfp_3.png",
          "pfp_4.png",
          "pfp_5.png",
          "pfp_6.png",
          "pfp_7.png",
          "pfp_8.png",
          "pfp_9.png",
          "pfp_10.png",
          "pfp_11.png"
        ]
      },
      "PlantList": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "required": [
            "name",
            "picture",
            "main_necessity"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "picture": {
              "type": "string",
              "format": "uri"
            },
            "main_necessity": {
              "type": "string",
              "enum": [
                "sun",
                "water",
                "friends",
                "other"
              ]
            }
          }
        }
      },
      "RankingList": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "alias",
            "profile_picture",
            "score"
          ],
          "properties": {
            "alias": {
              "type": "string",
              "minLength": 3,
              "maxLength": 16
            },
            "profile_picture": {
              "$ref": "#/components/schemas/ProfilePicture"
            },
            "score": {
              "type": "integer",
              "format": "uint64"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "UserToken": {
        "type": "apiKey",
        "name": "User-Token",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "UserToken": []
    }
  ]
}
