          },
          "Name": {
            "description": "Stack name",
            "example": "myStack",
            "type": "string"
          },
          "Namespace": {
            "description": "Kubernetes namespace if stack is a kube application",
            "example": "default",
            "type": "string"
          },
          "Option": {
