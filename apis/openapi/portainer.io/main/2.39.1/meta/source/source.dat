          "500": {
            "description": "Server error"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "jwt": []
          }
        ]
      },
      "put": {
        "summary": "Update a template",
        "description": "Update a template.\n**Access policy**: authenticated",
