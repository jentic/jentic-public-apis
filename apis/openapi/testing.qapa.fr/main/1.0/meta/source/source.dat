          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "mobile": {
            "type": "string"
          },
          "nationality": {
            "type": "string"
          },
          "missionStartDate": {
            "type": "string",
            "format": "date"
          },
          "missionEndDate": {
            "type": "string",
            "format": "date"
          },
          "ownerName": {
            "type": "string"
          },
          "sourcingUserName": {
            "type": "string"
          },
          "nbCheckedDocuments": {
            "type": "integer",
            "format": "int32"
          },
          "nbToCheckDocuments": {
            "type": "integer",
            "format": "int32"
          },
          "workAuthorisationOptional": {
