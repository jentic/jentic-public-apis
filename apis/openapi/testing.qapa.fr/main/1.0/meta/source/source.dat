          }
        }
      }
    },
    "securitySchemes": {
      "recruiter-authorization": {
        "type": "http",
        "description": "Bearer authentication header for recruiter",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      },
      "applicant-authorization": {
        "type": "http",
        "description": "Bearer authentication header for applicant",
        "scheme": "Bearer",
        "bearerFormat": "JWT"
      },
      "internal-request": {
        "type": "apiKey",
        "description": "Basic authentication header",
        "name": "INTERNAL-REQUEST",
        "in": "header"
      }
    }
  },
  "security": [
