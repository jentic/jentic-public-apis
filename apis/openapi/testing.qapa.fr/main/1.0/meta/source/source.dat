          },
          "fileNumber": {
            "type": "integer",
            "format": "int64"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "internalUserName": {
            "type": "string"
          },
          "prefectureStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "SUBMITTED",
              "VALIDATED",
              "REFUSED"
            ]
          }
        }
      },
      "ApplicantsWaitingForDocumentsValidationEntity": {
        "type": "object",
