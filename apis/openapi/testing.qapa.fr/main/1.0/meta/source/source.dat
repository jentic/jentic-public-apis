    "/internals/{internalId}/customers/{customerId}/applicants/{applicantId}/documents": {
      "post": {
        "tags": [
          "customer-applicant-selection-document-controller"
        ],
        "operationId": "createApplicantDocument",
        "parameters": [
          {
            "name": "applicantId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "customerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "documentType",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "IDENTITY_CARD",
                "PASSPORT",
                "WORK_CERTIFICATE",
                "RESIDENCE_PERMIT",
                "INITIAL_RESIDENCE_PERMIT",
                "REQUEST_FOR_INITIAL_RESIDENCE_PERMIT",
                "REQUEST_FOR_RENEW_OF_RESIDENCE_PERMIT",
                "BANK_ACCOUNT_NUMBER",
                "HEALTH_INSURANCE_CARD",
                "HEALTH_INSURANCE_CERTIFICATE",
                "MEDICAL_CERTIFICATE",
                "PROOF_OF_ADDRESS",
                "LICENCES_AND_CERTIFICATES",
                "STUDENT_CARD",
                "CUSTOM_USER_DOCUMENT",
                "PROFILE_PICTURE",
                "CURRICULUM_VITAE",
                "PROOF_OF_ABSENCE",
                "PARENTAL_WORK_AUTHORIZATION",
                "MEDICAL_CERTIFICATE_FOR_MINOR",
                "DISABILITY_CERTIFICATE"
              ]
            }
          },
          {
            "name": "tradeId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "skillId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "issueDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "expirationDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "customLabel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "identificationKey",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bypassDocumentTypeCheck",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "required": [
                  "pages"
                ],
                "type": "object",
                "properties": {
                  "pages": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          },
          "405": {
            "description": "Method Not Allowed"
          },
          "415": {
            "description": "Unsupported Media Type"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
