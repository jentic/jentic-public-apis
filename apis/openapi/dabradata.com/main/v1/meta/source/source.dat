d":true,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"retorno":{"type":["object","null"],"properties":{"cnpj":{"type":["string","null"],"description":"CNPJ da empresa consultada."},"observacao":{"type":["string","null"],"description":"Observações relacionadas ao registro."},"razaoSocial":{"type":["string","null"],"description":"Razão social da empresa."},"inutilizacoes":{"type":["array","null"],"items":{"type":"object","properties":{"ano":{"type":["number","null"],"description":"Ano de competência da inutilização."},"serie":{"type":["number","null"],"description":"Série do documento fiscal."},"modelo":{"type":["number","null"],"description":"Modelo do documento fiscal."},"protocolo":{"type":["string","null"],"description":"Protocolo de autorização da inutilização."},"numeroFinal":{"type":["number","null"],"description":"Número final da faixa inutilizada."},"numeroInicial":{"type":["number","null"],"description":"Número inicial da faixa inutilizada."},"dataAutorizacao":{"type":["string","null"],"description":"Data de autorização da inutilização."},"dataRecebimentoAN":{"type":["string","null"],"description":"Data de recebimento pelo órgão competente."}}},"description":"Lista de faixas de numeração inutilizadas."}},"description":"Resultado da consulta de inutilizações."},"metaDados":{"type":["object","null"],"properties":{"ip":{"type":["string","null"],"description":"Endereço IP da requisição."},"data":{"type":["string","null"],"description":"Data e hora da execução da consulta."},"chave":{"type":["string","null"],"description":"Chave de identificação."},"usuario":{"type":["string","null"],"description":"Usuário que realizou a consulta."},"mensagem":{"type":["string","null"],"description":"Mensagem de resposta."},"apiVersao":{"type":["string","null"],"description":"Versão da API utilizada."},"resultado":{"type":["string","null"],"description":"Status do resultado."},"assincrono":{"type":["boolean","null"],"description":"Indica se a consulta foi assíncrona."},"consultaUid":{"type":["string","null"],"description":"Identificador único da consulta."},"resultadoId":{"type":["number","null"],"description":"Identificador do resultado."},"consultaNome":{"type":["string","null"],"description":"Nome da consulta realizada."},"enviarCallback":{"type":["boolean","null"],"description":"Indica se callback será enviado."},"urlComprovante":{"type":["string","null"],"description":"URL do comprovante gerado."},"tempoExecucaoMs":{"type":["number","null"],"description":"Tempo de execução em milissegundos."},"gerarComprovante":{"type":["boolean","null"],"description":"Indica se comprovante será gerado."}},"description":"Metadados da consulta."}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/sintegra-estadual":{"get":{"summary":"Sintegra - Cadastro Estadual","description":"Verifica a situação cadastral e o regime de tributação de ICMS junto à SEFAZ, em todas as UFs. Basta o CNPJ: o estado do estabelecimento é identificado automaticamente. Essencial para validação fiscal, análise de risco e conformidade regulatória de empresas.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"sintegra-estadual","tags":["Fiscal"],"parameters":[{"name":"cnpj","in":"query","required":true,"description":"CNPJ COMPLETO do estabelecimento (14 dígitos, não a raiz). Aceita com ou sem pontuação.","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"uf","in":"query","required":false,"description":"UF da inscricao estadual (sigla, 2 letras). OPCIONAL. Quando informada, tem precedencia sobre a UF derivada do CNPJ — util para CNPJ com inscricao estadual em mais de um estado (ex.: substituto tributario). Omitida, a UF e' resolvida pelo proprio CNPJ.","schema":{"type":"string","format":"upper"},"example":"SP"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"ie":{"type":["string","null"],"description":"Inscrição estadual da entidade."},"uf":{"type":["string","null"],"description":"Unidade federativa do registro."},"cep":{"type":["string","null"],"description":"Código de endereçamento postal."},"cpf":{"type":["string","null"],"description":"Cadastro de pessoa física."},"cnpj":{"type":["string","null"],"description":"Cadastro nacional da pessoa jurídica."},"ufie":{"type":["string","null"],"description":"Unidade federativa da inscrição estadual."},"bairro":{"type":["string","null"],"description":"Bairro do endereço."},"numero":{"type":["string","null"],"description":"Número do endereço."},"situacao":{"type":["string","null"],"description":"Situação cadastral da inscrição estadual junto à SEFAZ, normalizada para um conjunto canônico: ATIVO, SUSPENSO, BAIXADO, INAPTO, INABILITADO ou NAO INFORMADO. Valores fora desse conjunto são repassados como vieram da fonte. Nulo quando a fonte consultada não informa a situação."},"telefone":{"type":["string","null"],"description":"Número de telefone."},"municipio":{"type":["string","null"],"description":"Município do endereço."},"logradouro":{"type":["string","null"],"description":"Nome da via ou endereço."},"complemento":{"type":["string","null"],"description":"Complemento do endereço."},"situacao_data":{"type":["string","null"],"description":"Data (DD/MM/AAAA) a que se refere a situação cadastral, quando informada pela fonte. Nulo quando não disponível."},"regimeApuracao":{"type":["string","null"],"description":"Regime de apuração do imposto."},"nomeEmpresarial":{"type":["string","null"],"description":"Razão social da entidade."},"atividadeEconomicaPrincipal":{"type":["string","null"],"description":"Código da atividade econômica principal."}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"ie":"string","uf":"string","cep":"string","cnpj":"string","ufie":"string","bairro":"string","numero":"string","situacao":"string","telefone":"string","municipio":"string","logradouro":"string","complemento":"string","situacao_data":"string","regimeApuracao":"string","nomeEmpresarial":"string","atividadeEconomicaPrincipal":"string"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/situacao-fiscal-pj":{"get":{"summary":"Situação Fiscal Federal da Empresa","description":"Situação fiscal federal da empresa inteira por CNPJ: dívida ativa da União separada por situação (em cobrança, negociada, garantida, suspensa), parcelamentos ativos na Receita Federal, regime tributário, imunidade, benefícios fiscais e alertas, com a data de referência de cada bloco.","operationId":"situacao-fiscal-pj","tags":["Fiscal"],"parameters":[{"name":"cnpj","in":"query","required":true,"description":"CNPJ da empresa (matriz ou filial), com ou sem máscara. Aceita o CNPJ alfanumérico. A resposta cobre a empresa inteira (todos os estabelecimentos da mesma raiz).","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","required":["cnpj_raiz","pgfn","parcelamentos_rfb","alertas","fontes"],"properties":{"cnpj":{"type":["string","null"],"description":"CNPJ consultado, sem máscara (14 caracteres; pode ter letras nas 12 primeiras posições)."},"pgfn":{"type":"object","required":["resumo"],"properties":{"itens":{"type":["array","null"],"items":{"type":"object","properties":{"cnpj":{"type":["string","null"],"description":"Estabelecimento devedor."},"valor":{"type":["number","null"],"description":"Valor consolidado da inscrição (R$)."},"origem":{"type":["string","null"],"description":"Tipo de dívida: `geral` (tributária), `previdenciaria` ou `fgts`."},"receita":{"type":["string","null"],"description":"Receita principal (ou tipo de crédito, na previdenciária)."},"subflag":{"type":["string","null"],"description":"Detalhe da situação, quando houver (ver `resumo.*.subflags`)."},"ajuizada":{"type":["boolean","null"],"description":"Se há execução fiscal."},"situacao":{"type":["string","null"],"description":"Situação normalizada: em_cobranca, negociada, garantida, suspensa_judicial, beneficio_fiscal ou outras."},"data_inscricao":{"type":["string","null"],"description":"Data da inscrição (AAAA-MM-DD)."},"numero_inscricao":{"type":["string","null"],"description":"Número da inscrição."},"situacao_inscricao":{"type":["string","null"],"description":"Situação como publicada pela PGFN."}}},"description":"Inscrições, primeiro as em cobrança e das maiores para as menores (no máximo 50; ver `itens_truncados`). Os totais do `resumo` são sempre completos."},"resumo":{"type":"object","required":["em_cobranca","negociada","garantida","suspensa_judicial"],"properties":{"outras":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."},"qtd_ajuizada":{"type":["integer","null"],"description":"Das inscrições, quantas têm execução fiscal."},"valor_ajuizado":{"type":["number","null"],"description":"Valor das inscrições com execução fiscal (R$)."}},"description":"Situação ainda não classificada (normalmente zero)."},"garantida":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":"integer","description":"Quantidade de inscrições."},"valor":{"type":"number","description":"Valor consolidado (R$)."},"qtd_ajuizada":{"type":["integer","null"],"description":"Das inscrições, quantas têm execução fiscal."},"valor_ajuizado":{"type":["number","null"],"description":"Valor das inscrições com execução fiscal (R$)."}},"description":"Garantida: seguro-garantia, carta-fiança, depósito ou penhora."},"negociada":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":"integer","description":"Quantidade de inscrições."},"valor":{"type":"number","description":"Valor consolidado (R$)."},"subflags":{"type":["object","null"],"properties":{"negociacao_bloqueada":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Negociação bloqueada."}},"description":"Detalhe informativo dentro da situação (não muda a classificação)."},"qtd_ajuizada":{"type":["integer","null"],"description":"Das inscrições, quantas têm execução fiscal."},"valor_ajuizado":{"type":["number","null"],"description":"Valor das inscrições com execução fiscal (R$)."}},"description":"Negociada: parcelamento ou transação com a PGFN (programas como SISPAR, REFIS, PAES, Leis 11.941 e 12.996)."},"em_cobranca":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":"integer","description":"Quantidade de inscrições."},"valor":{"type":"number","description":"Valor consolidado (R$)."},"subflags":{"type":["object","null"],"properties":{"protesto":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Com protesto."},"em_negociacao":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Negociação iniciada e ainda não consolidada."},"discussao_judicial":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Em discussão judicial sem suspensão formal."},"falencia_concordata":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Em falência ou concordata."},"parcelamento_rescindido":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Voltou à cobrança por parcelamento rescindido."}},"description":"Detalhe informativo dentro da situação (não muda a classificação)."},"qtd_ajuizada":{"type":["integer","null"],"description":"Das inscrições, quantas têm execução fiscal."},"valor_ajuizado":{"type":["number","null"],"description":"Valor das inscrições com execução fiscal (R$)."}},"description":"Em cobrança: dívida exigível, sem negociação, garantia ou suspensão. É o que a lista pública de devedores da PGFN mostra."},"beneficio_fiscal":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."},"qtd_ajuizada":{"type":["integer","null"],"description":"Das inscrições, quantas têm execução fiscal."},"valor_ajuizado":{"type":["number","null"],"description":"Valor das inscrições com execução fiscal (R$)."}},"description":"Moratória prevista em lei (residual, ex.: PROSUS)."},"suspensa_judicial":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":"integer","description":"Quantidade de inscrições."},"valor":{"type":"number","description":"Valor consolidado (R$)."},"qtd_ajuizada":{"type":["integer","null"],"description":"Das inscrições, quantas têm execução fiscal."},"valor_ajuizado":{"type":["number","null"],"description":"Valor das inscrições com execução fiscal (R$)."}},"description":"Suspensa por decisão judicial."}},"description":"Quantidade e valor consolidado por situação (somas completas)."},"ajuizada":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Dívida em cobrança que já tem execução fiscal."},"aplicavel":{"type":["boolean","null"],"description":"Se o bloco se aplica a esta empresa."},"tem_inscricao":{"type":["boolean","null"],"description":"Se há alguma inscrição, em qualquer situação."},"qtd_inscricoes":{"type":["integer","null"],"description":"Total de inscrições, em qualquer situação."},"itens_truncados":{"type":["boolean","null"],"description":"`true` quando há mais inscrições do que as listadas em `itens`."},"cnpjs_com_inscricao":{"type":["integer","null"],"description":"Quantos estabelecimentos da empresa têm alguma inscrição."},"em_cobranca_mais_antiga":{"type":["string","null"],"description":"Data da inscrição em cobrança mais antiga (AAAA-MM-DD)."},"em_cobranca_no_cnpj_consultado":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Em cobrança só no CNPJ consultado, sem somar os demais estabelecimentos — corresponde ao que a lista pública da PGFN mostra para este CNPJ."}},"description":"Dívida ativa da União (PGFN) de todos os estabelecimentos da empresa, separada por situação. Nunca some as situações num 'total devido': dívida negociada, garantida ou suspensa não está em cobrança."},"escopo":{"type":["string","null"],"description":"Sempre `raiz`: os blocos somam todos os estabelecimentos da empresa, mesmo quando o CNPJ consultado é de uma filial."},"fontes":{"type":"object","required":["cadastro","pgfn","parcelamentos_rfb"],"properties":{"pgfn":{"type":"object","required":["referencia","atualizado_em"],"properties":{"referencia":{"type":["string","null"],"description":"Período a que o dado se refere: trimestre da PGFN (ex.: `2026_trimestre_02`), data da publicação dos parcelamentos, safra do cadastro, último ano-calendário das publicações anuais ou último mês da DIRBI (`AAAA-MM`)."},"atualizado_em":{"type":["string","null"],"description":"Data em que a publicação oficial foi incorporada à nossa base (AAAA-MM-DD)."}},"description":"Dívida ativa da União (publicação trimestral da PGFN)."},"cadastro":{"type":"object","required":["referencia","atualizado_em"],"properties":{"referencia":{"type":["string","null"],"description":"Período a que o dado se refere: trimestre da PGFN (ex.: `2026_trimestre_02`), data da publicação dos parcelamentos, safra do cadastro, último ano-calendário das publicações anuais ou último mês da DIRBI (`AAAA-MM`)."},"atualizado_em":{"type":["string","null"],"description":"Data em que a publicação oficial foi incorporada à nossa base (AAAA-MM-DD)."}},"description":"Cadastro CNPJ da Receita Federal (safra mensal)."},"beneficios_ecf":{"type":["object","null"],"properties":{"referencia":{"type":["string","null"],"description":"Período a que o dado se refere: trimestre da PGFN (ex.: `2026_trimestre_02`), data da publicação dos parcelamentos, safra do cadastro, último ano-calendário das publicações anuais ou último mês da DIRBI (`AAAA-MM`)."},"atualizado_em":{"type":["string","null"],"description":"Data em que a publicação oficial foi incorporada à nossa base (AAAA-MM-DD)."}},"description":"Benefícios declarados na ECF (publicação anual)."},"beneficios_dirbi":{"type":["object","null"],"properties":{"referencia":{"type":["string","null"],"description":"Período a que o dado se refere: trimestre da PGFN (ex.: `2026_trimestre_02`), data da publicação dos parcelamentos, safra do cadastro, último ano-calendário das publicações anuais ou último mês da DIRBI (`AAAA-MM`)."},"atualizado_em":{"type":["string","null"],"description":"Data em que a publicação oficial foi incorporada à nossa base (AAAA-MM-DD)."}},"description":"DIRBI (declaração mensal de benefícios fiscais)."},"imunidade_isencao":{"type":["object","null"],"properties":{"referencia":{"type":["string","null"],"description":"Período a que o dado se refere: trimestre da PGFN (ex.: `2026_trimestre_02`), data da publicação dos parcelamentos, safra do cadastro, último ano-calendário das publicações anuais ou último mês da DIRBI (`AAAA-MM`)."},"atualizado_em":{"type":["string","null"],"description":"Data em que a publicação oficial foi incorporada à nossa base (AAAA-MM-DD)."}},"description":"Imunes e isentas (publicação anual)."},"parcelamentos_rfb":{"type":"object","required":["referencia","atualizado_em"],"properties":{"referencia":{"type":["string","null"],"description":"Período a que o dado se refere: trimestre da PGFN (ex.: `2026_trimestre_02`), data da publicação dos parcelamentos, safra do cadastro, último ano-calendário das publicações anuais ou último mês da DIRBI (`AAAA-MM`)."},"atualizado_em":{"type":["string","null"],"description":"Data em que a publicação oficial foi incorporada à nossa base (AAAA-MM-DD)."}},"description":"Parcelamentos ativos na Receita Federal (publicação mensal)."},"regime_tributario":{"type":["object","null"],"properties":{"referencia":{"type":["string","null"],"description":"Período a que o dado se refere: trimestre da PGFN (ex.: `2026_trimestre_02`), data da publicação dos parcelamentos, safra do cadastro, último ano-calendário das publicações anuais ou último mês da DIRBI (`AAAA-MM`)."},"atualizado_em":{"type":["string","null"],"description":"Data em que a publicação oficial foi incorporada à nossa base (AAAA-MM-DD)."}},"description":"Forma de tributação (publicação anual, cerca de 2 anos de defasagem)."}},"description":"Data de referência de cada bloco."},"alertas":{"type":"array","items":{"type":"object","properties":{"codigo":{"type":["string","null"],"description":"Código estável do alerta (ex.: DIVIDA_EM_DUAS_FRENTES)."},"descricao":{"type":["string","null"],"description":"Explicação em português."},"severidade":{"type":["string","null"],"description":"Gravidade do sinal: `alta` ou `media`."}}},"description":"Sinais cruzados entre os blocos. Lista vazia = nenhum sinal."},"cnpj_raiz":{"type":["string","null"],"description":"Raiz do CNPJ (8 primeiras posições). Todos os blocos cobrem a empresa inteira: matriz e todas as filiais com esta raiz."},"cadastro_minimo":{"type":["object","null"],"properties":{"uf":{"type":["string","null"],"description":"UF da matriz."},"mei":{"type":["object","null"],"properties":{"optante":{"type":["boolean","null"],"description":"Se é MEI hoje."},"data_opcao":{"type":["string","null"],"description":"Data do enquadramento (AAAA-MM-DD)."},"data_exclusao":{"type":["string","null"],"description":"Data do desenquadramento, quando houve (AAAA-MM-DD)."}},"description":"Enquadramento como MEI (SIMEI)."},"porte":{"type":["string","null"],"description":"Porte declarado."},"simples":{"type":["object","null"],"properties":{"optante":{"type":["boolean","null"],"description":"Se é optante hoje."},"data_opcao":{"type":["string","null"],"description":"Data da opção (AAAA-MM-DD)."},"data_exclusao":{"type":["string","null"],"description":"Data da exclusão, quando houve (AAAA-MM-DD)."}},"description":"Opção pelo Simples Nacional."},"municipio":{"type":["string","null"],"description":"Município da matriz."},"cnpj_matriz":{"type":["string","null"],"description":"CNPJ da matriz."},"razao_social":{"type":["string","null"],"description":"Razão social."},"cnpj_consultado":{"type":["object","null"],"properties":{"matriz":{"type":["boolean","null"],"description":"Se o CNPJ consultado é a matriz."},"situacao_cadastral":{"type":["string","null"],"description":"Situação cadastral do CNPJ consultado."}},"description":"O estabelecimento consultado."},"natureza_juridica":{"type":["object","null"],"properties":{"codigo":{"type":["string","null"],"description":"Código oficial."},"descricao":{"type":["string","null"],"description":"Descrição."}},"description":"Natureza jurídica."},"situacao_cadastral":{"type":["string","null"],"description":"Situação cadastral da matriz (ATIVA, BAIXADA, INAPTA, SUSPENSA, NULA)."},"data_situacao_cadastral":{"type":["string","null"],"description":"Data da situação cadastral da matriz (AAAA-MM-DD)."}},"description":"Identificação mínima da empresa na Receita Federal."},"imunidade_isencao":{"type":["object","null"],"properties":{"itens":{"type":["array","null"],"items":{"type":"object","properties":{"ano":{"type":["integer","null"],"description":"Ano-calendário."},"tipo_entidade":{"type":["string","null"],"description":"Tipo de entidade declarado (ex.: assistência social, filantrópica, educacional)."},"forma_tributacao":{"type":["string","null"],"description":"Imune ou isenta."}}},"description":"Do ano mais recente ao mais antigo."},"aplicavel":{"type":["boolean","null"],"description":"`false` quando a publicação oficial não cobre este tipo de empresa (ex.: optantes do Simples Nacional e MEI não entregam ECF nem DIRBI). Bloco não aplicável não é resultado negativo."},"motivo_nao_aplicavel":{"type":["string","null"],"description":"Por que o bloco não se aplica, quando `aplicavel` é `false`."}},"description":"Anos em que a empresa declarou imunidade ou isenção do IRPJ, com o tipo de entidade."},"parcelamentos_rfb":{"type":"object","required":["qtd","saldo_devedor"],"properties":{"qtd":{"type":"integer","description":"Quantidade de parcelamentos ativos."},"tem":{"type":["boolean","null"],"description":"Se há algum parcelamento ativo."},"itens":{"type":["array","null"],"items":{"type":"object","properties":{"cnpj":{"type":["string","null"],"description":"Estabelecimento."},"tipo":{"type":["string","null"],"description":"Tipo do parcelamento."},"adesao":{"type":["string","null"],"description":"Data da adesão (AAAA-MM-DD)."},"modalidade":{"type":["string","null"],"description":"Programa ou modalidade, quando informado (ex.: PERT, PRR)."},"qtde_parcelas":{"type":["integer","null"],"description":"Número de parcelas."},"saldo_devedor":{"type":["number","null"],"description":"Saldo devedor (R$)."},"valor_parcelado":{"type":["number","null"],"description":"Valor parcelado (R$)."}}},"description":"Parcelamentos, dos maiores saldos para os menores (no máximo 50; ver `itens_truncados`)."},"por_tipo":{"type":["array","null"],"items":{"type":"object","properties":{"qtd":{"type":["integer","null"],"description":"Quantidade."},"tipo":{"type":["string","null"],"description":"Tipo do parcelamento."},"saldo_devedor":{"type":["number","null"],"description":"Saldo devedor (R$)."},"valor_parcelado":{"type":["number","null"],"description":"Valor parcelado (R$)."}}},"description":"Totais por tipo de parcelamento."},"aplicavel":{"type":["boolean","null"],"description":"Se o bloco se aplica a esta empresa."},"saldo_devedor":{"type":"number","description":"Saldo devedor somado (R$). Pode passar do valor parcelado, por juros."},"itens_truncados":{"type":["boolean","null"],"description":"`true` quando há mais parcelamentos do que os listados."},"valor_parcelado":{"type":["number","null"],"description":"Valor originalmen