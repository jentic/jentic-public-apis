cumento":{"type":["string","null"],"description":"CPF ou CNPJ consultado."},"condenacoes":{"type":["array","null"],"items":{"type":"object","properties":{"orgao":{"type":["string","null"],"description":"Órgão expedidor da condenação."},"comarca":{"type":["string","null"],"description":"Comarca de origem do processo."},"tribunal":{"type":["string","null"],"description":"Tribunal responsável pelo julgamento."},"numeroProcesso":{"type":["string","null"],"description":"Número do processo de condenação."},"condenacaoCumprida":{"type":["boolean","null"],"description":"Indica se a condenação foi cumprida."},"dataTransitoJulgado":{"type":["string","null"],"description":"Data em que a condenação transitou em julgado."}}},"description":"Lista de condenações por improbidade administrativa."},"dataEmissao":{"type":["string","null"],"description":"Data de emissão do certificado."},"nomeEntidade":{"type":["string","null"],"description":"Nome ou razão social da entidade consultada."},"codigoValidacao":{"type":["string","null"],"description":"Código de validação da certidão."},"possuiCondenacao":{"type":["boolean","null"],"format":"bool","description":"Indica se a entidade possui condenação por improbidade administrativa."}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/ceis-sancoes":{"get":{"summary":"Empresas Inidôneas e Suspensas (CEIS)","description":"Identifica empresas e pessoas sancionadas por irregularidades contratuais com a Administração Pública, fornecendo detalhes sobre sanções e restrições de participação em licitações e contratos.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"ceis-sancoes","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"consta":{"type":["boolean","null"]},"sancoes":{"type":["array","null"],"items":{"type":"object","properties":{"orgao":{"type":["object","null"],"properties":{"uf":{"type":["string","null"]},"nome":{"type":["string","null"]},"poder":{"type":["string","null"]},"esfera":{"type":["string","null"]}}},"numeroRegistro":{"type":["number","null"]},"fundamentoLegal":{"type":["string","null"]},"detalhamentoSancao":{"type":["object","null"],"properties":{"fonte":{"type":["object","null"],"properties":{"nome":{"type":["string","null"]},"endereco":{"type":["string","null"]},"telefone":{"type":["string","null"]},"dadosPublicacao":{"type":["object","null"],"properties":{"data":{"type":["string","null"]},"link":{"type":["string","null"]},"texto":{"type":["string","null"]},"detalhamento":{"type":["string","null"]}}}}},"dataFim":{"type":["string","null"]},"categoria":{"type":["string","null"]},"dataInicio":{"type":["string","null"]},"observacao":{"type":["string","null"]},"dataReferencia":{"type":["string","null"]},"numeroProcesso":{"type":["string","null"]},"dataOrigemInformacao":{"type":["string","null"]},"dataTransitadoJulgado":{"type":["string","null"]},"abrangenciaDefinidaDecisaoJudicial":{"type":["string","null"]}}}}}},"mensagem":{"type":["string","null"]},"parametros":{"type":["object","null"]},"observacoes":{"type":["string","null"]},"nomeEntidade":{"type":["string","null"]},"constamSancoes":{"type":["boolean","null"]},"documentoConsultado":{"type":["string","null"]}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"sancoes":[{"orgao":{"uf":"SP","nome":"Secretaria Municipal Exemplo de Educação","poder":null,"esfera":"MUNICIPAL"},"numeroRegistro":999002,"fundamentoLegal":"LEI 8666 - ART. 87, IV - DECLARAÇÃO DE INIDONEIDADE PARA LICITAR OU CONTRATAR COM A ADMINISTRAÇÃO PÚBLICA.","detalhamentoSancao":{"fonte":{"nome":null,"endereco":null,"telefone":null,"dadosPublicacao":{"data":"01/01/2018 00:00:00","link":null,"texto":"Diário Oficial do Município Seção Licitações Página 1","detalhamento":null}},"dataFim":null,"categoria":"Declaração de Inidoneidade sem prazo determinado","dataInicio":"25/01/2018 00:00:00","observacao":null,"dataReferencia":null,"numeroProcesso":"0000-0.000.000-0","dataOrigemInformacao":null,"dataTransitadoJulgado":null,"abrangenciaDefinidaDecisaoJudicial":"Em todos os Poderes da Esfera do órgão sancionador"}}],"observacoes":"Foi encontrado um resultado compatível com a pesquisa.","nomeEntidade":"INSTITUTO EXEMPLO DE ENSINO","constamSancoes":true,"documentoConsultado":"22222222000122"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]],"x-empty-as-negative":true}},"/api/v1/consulta/cnep-sancoes":{"get":{"summary":"Empresas Punidas (CNEP)","description":"Verifica se pessoas físicas ou jurídicas constam no Cadastro Nacional de Empresas Punidas, identificando sanções, multas ou proibições de participação em licitações e contratos governamentais.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"cnep-sancoes","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"consta":{"type":["boolean","null"]},"sancoes":{"type":["array","null"],"items":{"type":"object","properties":{"orgao":{"type":["object","null"],"properties":{"uf":{"type":["string","null"]},"nome":{"type":["string","null"]},"poder":{"type":["string","null"]},"esfera":{"type":["string","null"]}}},"numeroRegistro":{"type":["number","null"]},"fundamentoLegal":{"type":["string","null"]},"detalhamentoSancao":{"type":["object","null"],"properties":{"fonte":{"type":["object","null"],"properties":{"nome":{"type":["string","null"]},"endereco":{"type":["string","null"]},"telefone":{"type":["string","null"]},"dadosPublicacao":{"type":["object","null"],"properties":{"data":{"type":["string","null"]},"link":{"type":["string","null"]},"texto":{"type":["string","null"]},"detalhamento":{"type":["string","null"]}}}}},"dataFim":{"type":["string","null"]},"categoria":{"type":["string","null"]},"dataInicio":{"type":["string","null"]},"observacao":{"type":["string","null"]},"valorMulta":{"type":["string","null"]},"dataReferencia":{"type":["string","null"]},"numeroProcesso":{"type":["string","null"]},"dataOrigemInformacao":{"type":["string","null"]},"dataTransitadoJulgado":{"type":["string","null"]},"abrangenciaDefinidaDecisaoJudicial":{"type":["string","null"]}}}}}},"mensagem":{"type":["string","null"]},"parametros":{"type":["object","null"]},"observacoes":{"type":["string","null"]},"nomeEntidade":{"type":["string","null"]},"constamSancoes":{"type":["boolean","null"]},"documentoConsultado":{"type":["string","null"]}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"sancoes":[{"orgao":{"uf":null,"nome":"Empresa Pública Exemplo S.A.","poder":null,"esfera":"FEDERAL"},"numeroRegistro":999001,"fundamentoLegal":"LEI 12846 - ART. 6º, I - MULTA, NO VALOR DE 0,1% A 20% DO FATURAMENTO BRUTO DO ÚLTIMO EXERCÍCIO.","detalhamentoSancao":{"fonte":{"nome":null,"endereco":null,"telefone":null,"dadosPublicacao":{"data":"01/01/2020 00:00:00","link":null,"texto":"Diário Oficial da União Seção 3 Página 1","detalhamento":null}},"dataFim":null,"categoria":"Multa","dataInicio":"20/08/2020 00:00:00","observacao":null,"valorMulta":"150000.00","dataReferencia":null,"numeroProcesso":"000000002020","dataOrigemInformacao":null,"dataTransitadoJulgado":null,"abrangenciaDefinidaDecisaoJudicial":"Sem Informação"}}],"observacoes":"Foi encontrado um resultado compatível com a pesquisa.","nomeEntidade":"COMERCIO EXEMPLO DE PECAS E EQUIPAMENTOS LTDA","constamSancoes":true,"documentoConsultado":"22222222000122"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]],"x-empty-as-negative":true}},"/api/v1/consulta/cepim":{"get":{"summary":"Entidades Impedidas (CEPIM)","description":"Consulta se uma entidade privada sem fins lucrativos está impedida de celebrar convênios ou contratos de repasse com a Administração Pública Federal, listando sanções e irregularidades associadas.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"cepim","tags":["Compliance & Risco"],"parameters":[{"name":"cnpj","in":"query","required":true,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"cnpj":{"type":["string","null"]},"consta":{"type":["boolean","null"]},"sancoes":{"type":["array","null"],"items":{"type":"object","properties":{"orgao":{"type":["object","null"],"properties":{"cnpj":{"type":["string","null"]},"nome":{"type":["string","null"]},"poder":{"type":["string","null"]},"sigla":{"type":["string","null"]}}},"numeroRegistro":{"type":["number","null"]},"detalhamentoSancao":{"type":["object","null"],"properties":{"motivo":{"type":["string","null"]},"dataReferencia":{"type":["string","null"]}}}}}},"mensagem":{"type":["string","null"]},"parametros":{"type":["object","null"]},"observacoes":{"type":["string","null"]},"razaoSocial":{"type":["string","null"]},"constamSancoes":{"type":["boolean","null"]}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"cnpj":"22222222000122","sancoes":[{"orgao":{"cnpj":null,"nome":"Ministério Exemplo de Desenvolvimento - Unidades com vínculo direto","poder":null,"sigla":null},"numeroRegistro":999003,"detalhamentoSancao":{"motivo":"NAO APRESENTACAO DE DOCUMENTACAO COMPLEMENTAR","dataReferencia":null}}],"observacoes":"Foi encontrado um resultado compatível com a pesquisa.","razaoSocial":"ASSOCIACAO EXEMPLO DE ARTESANATO","constamSancoes":true}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/ceaf-expulsoes":{"get":{"summary":"Expulsões da Administração Federal (CEAF)","description":"Consulta informações sobre demissões, destituições e cassações de aposentadoria de servidores públicos federais registradas desde 2004.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"ceaf-expulsoes","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"data":{"type":["object","null"],"properties":{"cpf":{"type":["string","null"],"description":"CPF da pessoa."},"nome":{"type":["string","null"],"description":"Nome da pessoa."},"sancoes":{"type":["array","null"],"items":{"type":"object","properties":{"orgao":{"type":["object","null"],"properties":{"nome":{"type":["string","null"],"description":"Nome do órgão."},"sigla":{"type":["string","null"],"description":"Sigla do órgão."}},"description":"Órgão responsável pela sanção."},"numeroRegistro":{"type":["number","null"],"description":"Número de registro da sanção."},"fundamentoLegal":{"type":["string","null"],"description":"Fundamento legal da sanção."},"detalhamentoSancao":{"type":["object","null"],"properties":{"cargoEfetivo":{"type":["string","null"],"description":"Cargo efetivo da pessoa no momento da sanção."},"cargoComissao":{"type":["string","null"],"description":"Cargo de comissão da pessoa no momento da sanção."},"dataReferencia":{"type":["string","null"],"description":"Data de referência da sanção."}},"description":"Detalhes da sanção aplicada."}}},"description":"Lista de sanções aplicadas."},"observacoes":{"type":["string","null"],"description":"Observações adicionais do registro."},"constamSancoes":{"type":["boolean","null"],"description":"Indica se a pessoa possui sanções registradas."},"numeroIdentificacao":{"type":["number","null"],"description":"Número de identificação do registro."}},"description":"Dados da consulta de expulsões da administração federal."},"found":{"type":["boolean","null"],"format":"bool","description":"Indica se foram encontrados registros para a consulta."},"message":{"type":["string","null"],"description":"Mensagem informativa sobre o resultado da consulta."}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"data":null,"found":false,"message":"Nenhum registro encontrado"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/sicaf-fornecedor":{"get":{"summary":"Fornecedor do Governo Federal (SICAF)","description":"Informa se um CPF ou CNPJ está cadastrado como fornecedor do Governo Federal (SICAF), se o cadastro está ativo e se consta habilitado a licitar, com os dados cadastrais divulgados: razão social/nome, atividade CNAE, natureza jurídica, porte e município/UF. Útil para diligência de fornecedor, análise de crédito (quem fatura com o setor público) e qualificação de leads B2G.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.\n\nEnvie no máximo um de: cpf ou cnpj — cada consulta responde sobre um único documento.","operationId":"sicaf-fornecedor","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF do titular a consultar — 11 dígitos, com ou sem pontuação. A máscara é removida antes da validação e o dígito verificador é conferido.","schema":{"type":"string","format":"cpf","pattern":"^[0-9]{11}$"}},{"name":"cnpj","in":"query","required":false,"description":"CNPJ da empresa a consultar — 14 caracteres, com ou sem pontuação. Aceita o CNPJ alfanumérico (12 posições em A-Z/0-9 mais 2 dígitos verificadores). A máscara é removida antes da validação e o dígito verificador é conferido.","schema":{"type":"string","format":"cnpj","pattern":"^[A-Z0-9]{12}[0-9]{2}$"}}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"uf":{"type":["string","null"],"description":"Sigla da UF do fornecedor no cadastro (ex.: 'SP'). null quando não cadastrado."},"cnae":{"type":["integer","null"],"description":"Código CNAE da atividade principal declarada no cadastro. null para fornecedor pessoa física e quando não cadastrado."},"nome":{"type":["string","null"],"description":"Razão social (PJ) ou nome (PF) do fornecedor, como consta no cadastro. null quando não cadastrado."},"porte":{"type":["string","null"],"description":"Porte da empresa por extenso (ex.: 'MICROEMPRESA', 'EMPRESA DE PEQUENO PORTE', 'DEMAIS'). null para fornecedor pessoa física e quando não cadastrado."},"status":{"type":["string","null"],"description":"Frase-resumo do resultado (ex.: 'Fornecedor ATIVO no cadastro do Governo Federal (SICAF/Compras.gov.br).' ou 'Nada consta: documento não localizado no cadastro de fornecedores do Governo Federal (SICAF/Compras.gov.br).')."},"municipio":{"type":["string","null"],"description":"Município do fornecedor no cadastro. null quando não cadastrado."},"tipoPessoa":{"type":["string","null"],"description":"Tipo do documento consultado: 'PF' para CPF (11 dígitos) ou 'PJ' para CNPJ (14 dígitos)."},"cadastroAtivo":{"type":["boolean","null"],"description":"true = cadastro ATIVO; false = cadastrado porém INATIVO. null quando o documento não está cadastrado (possuiCadastroSicaf=false)."},"cnaeDescricao":{"type":["string","null"],"description":"Descrição da atividade CNAE principal. null para fornecedor pessoa física e quando não cadastrado."},"naturezaJuridica":{"type":["string","null"],"description":"Natureza jurídica por extenso (ex.: 'SOCIEDADE ANONIMA FECHADA'). null para fornecedor pessoa física e quando não cadastrado."},"habilitadoLicitar":{"type":["boolean","null"],"description":"Flag 'habilitado a licitar' publicado pela fonte. Na prática acompanha o cadastro ativo (fornecedor inativo vem sempre false); o caso informativo é o raro fornecedor ATIVO com este campo false. NÃO é atestado de ausência de sanção — para sanções (CEIS/CNEP/CNIA/Inidôneos) use a consulta de sanções consolidadas. null quando não cadastrado."},"documentoConsultado":{"type":["string","null"],"description":"CPF ou CNPJ consultado, formatado com máscara (ex.: '11.111.111/0001-11' ou '111.111.111-11')."},"possuiCadastroSicaf":{"type":["boolean","null"],"description":"true = o documento consta no cadastro de fornecedores do Governo Federal (ativo ou inativo); false = NADA CONSTA, não é fornecedor cadastrado."},"codigoNaturezaJuridica":{"type":["integer","null"],"description":"Código oficial da natureza jurídica (tabela CONCLA/Receita Federal, ex.: 2054 = sociedade anônima fechada). null para fornecedor pessoa física e quando não cadastrado."}},"description":"Situação de um CPF/CNPJ no cadastro de fornecedores do Governo Federal (SICAF), publicado pelo Compras.gov.br: se está cadastrado, se o cadastro está ativo, se consta habilitado a licitar, e os dados cadastrais divulgados (nome/razão social, CNAE, natureza jurídica, porte, município/UF). Fonte: API pública oficial do Compras.gov.br. NÃO é o certificado SICAF (níveis I–VI), que exige login gov.br."}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]],"x-at-most-one-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/listas-restritivas":{"get":{"summary":"Listas Restritivas e Sanções — PF","description":"Screening de sanções e listas restritivas de uma pessoa física a partir do CPF, cobrindo 17 listas nacionais e internacionais: ONU (Conselho de Segurança), OFAC e DDTC (EUA), União Europeia, Reino Unido, Canadá, INTERPOL, FBI, BACEN, CVM, CNJ, TCU, TCE-SP, CEAF, CNEP, MTE (trabalho escravo) e IBAMA. O cruzamento com as listas é resolvido na origem a partir do CPF, com índice de similaridade de nome por ocorrência — sem risco de falso negativo por busca manual de nome.","operationId":"listas-restritivas","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF da pessoa física consultada, com ou sem máscara.","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"cpf":{"type":"string","description":"CPF consultado, no formato 000.000.000-00."},"status":{"type":"string","description":"Resumo do resultado em uma frase, pronto para exibição."},"ocorrencias":{"type":"array","items":{"type":"object","properties":{"tipo":{"type":"string","description":"Motivo específico do registro, como publicado pela lista de origem."},"fonte":{"type":"string","description":"Lista de origem do registro, por extenso — ex.: OFAC (EUA), ONU (Conselho de Segurança), INTERPOL, BACEN."},"dataFim":{"type":"string","description":"Fim da vigência do registro. Vazio quando o registro não tem data de término."},"categoria":{"type":"string","description":"Categoria normalizada do registro: Crimes financeiros, Terrorismo, Corrupção, Mandado de prisão, Lavagem de dinheiro, entre outras."},"dataInicio":{"type":"string","description":"Início da vigência do registro na lista. Vazio quando a lista não informa."},"nomeNaLista":{"type":"string","description":"Nome exatamente como publicado na lista de origem."},"atualizadoEm":{"type":"string","description":"Última atualização do registro na base — leia como a recência da informação."},"presenteNaFonte":{"type":"boolean","description":"true quando o registro segue publicado na lista de origem atualmente."},"similaridadeNome":{"type":"integer","description":"Índice de similaridade (0 a 100) entre o nome do titular do CPF e o nome publicado na lista. Valores abaixo de 100 podem indicar homônimo — exigem verificação manual antes de qualquer decisão."},"nascimentoNaLista":{"type":"string","description":"Data de nascimento publicada na lista, quando houver — use para desempatar homônimos."}}},"description":"Cada registro de lista restritiva associado ao nome do titular. Uma ocorrência NÃO significa sanção confirmada: verifique a similaridade do nome e os flags do consolidado."},"fontesRastreadas":{"type":"array","items":{"type":"string"},"description":"Todas as listas cobertas pelo screening. É o escopo do \"nada consta\": um resultado limpo vale para estas listas."},"totalOcorrencias":{"type":"integer","description":"Quantidade de ocorrências localizadas por correspondência de nome nas listas rastreadas."},"ocorrenciaConfirmada":{"type":"boolean","description":"true quando há ocorrência, em qualquer categoria, com similaridade de nome máxima (100) — a única situação em que a correspondência por nome é tratada como confirmada. Abaixo de 100, trate como possível homônimo: veja similaridadeNome de cada ocorrência."},"sancionadoAtualmente":{"type":"boolean","description":"true quando a fonte aponta sanção ou restrição VIGENTE para o titular do CPF. É o veredito do screening — não é derivado da similaridade de nome."},"sancionadoAnteriormente":{"type":"boolean","description":"true quando o titular já esteve sancionado no passado, mesmo sem sanção vigente hoje."},"ocorrenciaOutraCategoria":{"type":"boolean","description":"true quando há ocorrência em categoria diferente de Crimes financeiros (ex.: Terrorismo, Corrupção, Mandado de prisão)."},"ocorrenciasSemConfirmacao":{"type":"integer","description":"Quantidade de ocorrências com similaridade de nome abaixo de 100 (correspondência apenas parcial, sem confirmação de identidade)."},"ocorrenciaCrimesFinanceirosConfirmada":{"type":"boolean","description":"true quando há ocorrência na categoria Crimes financeiros com similaridade de nome máxima (100). Abaixo de 100, trate como possível homônimo — veja similaridadeNome de cada ocorrência."}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/midia-adversa":{"get":{"summary":"Mídia Adversa — PF","description":"Screening de mídia adversa de uma pessoa física a partir do CPF: notícias que citam o nome do titular, com teor (sentimento) por matéria, veículo, data e link. O nome civil é resolvido a partir do CPF e cruzado com a imprensa — cada matéria expõe o nome exatamente como citado, com índices de raridade do nome para calibrar o risco de homônimo.","operationId":"midia-adversa","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF da pessoa física consultada, com ou sem máscara.","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"cpf":{"type":"string","description":"CPF consultado, no formato 000.000.000-00."},"status":{"type":"string","description":"Resumo do resultado em uma frase, pronto para exibição."},"noticias":{"type":"array","items":{"type":"object","properties":{"url":{"type":"string","description":"Link da matéria."},"fonte":{"type":"string","description":"Veículo que publicou a matéria."},"titulo":{"type":"string","description":"Título da matéria."},"categorias":{"type":"array","items":{"type":"string"},"description":"Temas da matéria — ex.: Segurança, Política, Economia, Justiça."},"nomeCitado":{"type":"string","description":"O nome citado na matéria que mais se aproxima do nome do titular — compare com `nomesBuscados.nomeCompleto` para identificar homônimo. Vazio quando a matéria não traz um nome próximo o suficiente."},"sentimento":{"type":"string","description":"Teor geral da matéria: Negativo, Levemente negativo, Neutro, Levemente positivo, Positivo, Polarizado ou Indefinido."},"dataPublicacao":{"type":"string","description":"Data de publicação da matéria."},"locaisNaMateria":{"type":"array","items":{"type":"string"},"description":"Lugares citados na matéria (até 5). Use para o geo-check de homônimo: matéria que só cita lugares sem relação com o titular sugere outra pessoa."},"sentimentoDoCitado":{"type":"string","description":"Teor da menção especificamente à pessoa citada (pode diferir do teor geral da matéria)."},"correspondenciaNome":{"type":"string","description":"Classificação do casamento entre o nome do titular e o nomeCitado: 'exata' (mesmos nomes, fora conectivos), 'parcial' (sobra ou falta sobrenome — possível homônimo) ou vazio (nenhum nome próximo na matéria). Não é veredito de identidade."}}},"description":"Notícias que citam o nome do titular, das mais relevantes. Uma notícia NÃO é confirmação de identidade: verifique `nomeCitado`."},"nomesBuscados":{"type":"object","properties":{"nomeCurto":{"type":"string","description":"Forma curta do nome usada na busca."},"nomeCompleto":{"type":"string","description":"Nome civil completo do titular do CPF, usado na busca."},"unicidadeNomeCurto":{"type":"number","description":"Raridade da forma curta, de 0 a 1. Valores baixos indicam alto risco de homônimo nas notícias."},"unicidadeNomeCompleto":{"type":"number","description":"Raridade do nome completo, de 0 a 1 (1 = nome único; próximo de 0 = nome muito comum)."}},"description":"Os nomes usados no cruzamento com as notícias e o quão raros eles são — nome comum aumenta a chance de homônimo."},"totalNoticias":{"type":"integer","description":"Total de notícias localizadas citando o nome do titular. Pode ser maior que a quantidade de itens em `noticias` (a resposta traz as mais relevantes)."},"nivelExposicao":{"type":"string","description":"Nível de exposição na mídia, na escala A a H (A = exposição máxima, H = nenhuma exposição)."},"nivelCelebridade":{"type":"string","description":"Nível de celebridade do nome, na escala A a H (A = máximo, H = nenhum)."},"nivelImpopularidade":{"type":"string","description":"Nível de impopularidade do nome, na escala A a H (A = máximo, H = nenhum)."},"possuiNoticiaNegativa":{"type":"boolean","description":"true quando ao menos uma notícia tem teor negativo. É o sinal de mídia adversa — mas a associação é por NOME: confirme a identidade antes de qualquer decisão."},"totalNoticiasNegativas":{"type":"integer","description":"Quantidade de notícias com teor negativo."}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/offshore-leaks":{"get":{"summary":"Offshore Leaks (ICIJ)","description":"Busca por nome na base Offshore Leaks do ICIJ (Panama Papers, Pandora Papers e outros vazamentos) e retorna entidades, intermediários e pessoas associados a estruturas offshore, com jurisdição, vazamento de origem e tipo de correspondência. Útil para triagem de PEP, sanções e risco reputacional.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"offshore-leaks","tags":["Compliance & Risco"],"parameters":[{"name":"nome","in":"query","required":true,"description":"Nome completo para busca","schema":{"type":"string"},"example":"Fulano de Tal"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":["object","null"],"properties":{"registros":{"type":["array","null"],"items":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome do registro."},"pais":{"type":["array","null"],"items":{"type":"string"},"description":"Países vinculados ao registro."},"nodeId":{"type":["string","null"],"description":"Identificador do nó na base."},"tipoNo":{"type":["string","null"],"description":"Tipo do nó (entidade, intermediário, oficial, endereço)."},"situacao":{"type":["string","null"],"description":"Situação do registro."},"tipoMatch":{"type":["string","null"],"description":"Tipo de correspondência do nome pesquisado."},"vazamento":{"type":["string","null"],"description":"Vazamento de origem do registro (ex.: Panama Papers)."},"jurisdicao":{"type":["string","null"],"description":"Jurisdição associada ao registro."},"dataIncorporacao":{"type":["string","null"],"description":"Data de incorporação da entidade, quando aplicável."}}},"description":"Registros correspondentes ao nome pesquisado."},"observacoes":{"type":["string","null"],"description":"Observações gerais sobre o resultado."},"nomeConsultado":{"type":["string","null"],"description":"Nome informado na consulta."},"referenciaBase":{"type":["string","null"],"description":"Referência ou versão da base consultada."},"fonteAtribuicao":{"type":["string","null"],"description":"Atribuição de fonte exigida pelo ICIJ."},"totalRegistrosBase":{"type":["integer","null"],"description":"Total de registros existentes na base."},"resultadosEncontrados":{"type":["integer","null"],"description":"Quantidade de registros encontrados."}},"description":"Resultado da busca na base Offshore Leaks."},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"status":"string","mensagem":"string","custo_brl":"number","saldo_restante_brl":"number"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/pep-exposicao":{"get":{"summary":"Pessoa Exposta Politicamente (PEP)","description":"Verifica se um CPF pertence a uma Pessoa Exposta Politicamente (PEP) conforme regulação do Coaf, identificando riscos em processos de onboarding, compliance e screening AML/KYC.","operationId":"pep-exposicao","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"cpf":{"type":["string","null"],"description":"CPF do indivíduo."},"pep":{"type":["boolean","null"],"format":"bool","description":"Indica se o indivíduo é uma Pessoa Exposta Politicamente."},"nome":{"type":["string","null"],"description":"Nome do indivíduo."},"orgao":{"type":["string","null"],"description":"Informações do órgão do qual o indivíduo faz ou fez parte."},"funcao":{"type":["string","null"],"description":"Função desempenhada pelo indivíduo."},"status":{"type":["string","null"],"description":"Detalhes sobre o status do registro."},"parentescosPEP":{"type":["array","null"],"items":{"type":"object","properties":{"cpf":{"type":["string","null"],"description":"CPF do parente."},"nome":{"type":["string","null"],"description":"Nome do parente."},"obito":{"type":["boolean","null"],"description":"Indica se o parente faleceu."},"genero":{"type":["string","null"],"description":"Gênero do parente."},"dataObito":{"type":["string","null"],"description":"Data do óbito do parente."},"dataNascimento":{"type":["string","null"],"description":"Data de nascimento do parente."},"grauParentesco":{"type":["string","null"],"description":"Descrição do grau de parentesco."},"codigoGrauParentesco":{"type":["number","null"],"description":"Código numérico que identifica o grau de parentesco."}}},"description":"Lista de parentescos com Pessoas Expostas Politicamente."},"relacionadoComPEP":{"type":["boolean","null"],"format":"bool","description":"Indica se o indivíduo possui parentesco com uma Pessoa Exposta Politicamente."}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/aml-vinculos":{"get":{"summary":"Prevenção à Lavagem de Dinheiro (AML) — PF","description":"Consulta dados de Pessoa Física para compliance AML: verifica óbito, status PEP, parentescos e sociedades que participa, permitindo screening de risco em onboarding e transações.","operationId":"aml-vinculos","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"cpf":{"type":["string","null"],"description":"CPF da pessoa física."},"pep":{"type":["boolean","null"],"format":"bool","description":"Indica se a pessoa é Politicamente Exposta."},"nome":{"type":["string","null"],"description":"Nome da pessoa física."},"obito":{"type":["boolean","null"],"format":"bool","description":"Indica se a pessoa veio a óbito."},"genero":{"type":["string","null"],"description":"Gênero da pessoa."},"dataObito":{"type":["string","null"],"description":"Data do óbito da pessoa."},"sociedades":{"type":["array","null"],"items":{"type":"object","properties":{"cnpj":{"type":["string","null"],"description":"CNPJ da empresa."},"socios":{"type":["array","null"],"items":{"type":"object","properties":{"cpf":{"type":["string","null"],"description":"CPF do sócio."},"cnpj":{"type":["string","null"],"description":"CNPJ da empresa do sócio."},"nome":{"type":["string","null"],"description":"Nome do sócio."},"obito":{"type":["boolean","null"],"description":"Indica se o sócio veio a óbito."},"genero":{"type":["string","null"],"description":"Gênero do sócio."},"baixada":{"type":["boolean","null"],"description":"Indica se a empresa do sócio foi baixada."},"dataObito":{"type":["string","null"],"description":"Data do óbito do sócio."},"dataBaixada":{"type":["string","null"],"description":"Data da baixa da empresa do sócio."},"razaoSocial":{"type":["string","null"],"description":"Razão social da empresa do sócio."},"dataAbertura":{"type":["string","null"],"description":"Data de abertura da empresa do sócio."},"dataNascimento":{"type":["string","null"],"description":"Data de nascimento do sócio."},"qualificacaoSocio":{"type":["string","null"],"description":"Qualificação do sócio."}}},"description":"Lista de sócios da empresa."},"baixada":{"type":["boolean","null"],"description":"Indica se a empresa foi baixada."},"razaoSocial":{"type":["string","null"],"description":"Razão social da empresa."},"dataAbertura":{"type":["string","null"],"description":"Data de abertura da empresa."},"nomeFantasia":{"type":["string","null"],"description":"Nome fantasia da empresa."}}},"description":"Lista de sociedades nas quais a pessoa participa."},"parentescos":{"type":["array","null"],"items":{"type":"object","properties":{"cpf":{"type":["string","null"],"description":"CPF do parente."},"nome":{"type":["string","null"],"description":"Nome do parente."},"obito":{"type":["boolean","null"],"description":"Indica se o parente veio a óbito."},"genero":{"type":["string","null"],"description":"Gênero do parente."},"dataObito":{"type":["string","null"],"description":"Data do óbito do parente."},"dataNascimento":{"type":["string","null"],"description":"Data de nascimento do parente."},"grauParentesco":{"type":["string","null"],"description":"Grau de parentesco."}}},"description":"Lista de parentescos da pessoa."},"dataNascimento":{"type":["string","null"],"description":"Data de nascimento da pessoa."}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/confea-crea":{"get":{"summary":"Registro Profissional - CONFEA/CREA","description":"Valida registros profissionais no CONFEA/CREA, retornando dados cadastrais, situação, titulações e atribuições de engenheiros e agrônomos para compliance contratual.","operationId":"confea-crea","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"retorno":{"type":["object","null"],"properties":{"crea":{"type":["string","null"],"description":"Unidade regional do conselho em que está situado o cadastro."},"nome":{"type":["string","null"],"description":"Nome do indivíduo ou entidade do registro."},"vistos":{"type":["array","null"],"items":{"type":["string","null"]},"description":"Lista de vistos associados ao registro."},"situacao":{"type":["string","null"],"description":"Situação atual do registro profissional."},"dataRegistro":{"type":["string","null"],"description":"Data de registro ou sanção do profissional."},"registroNacional":{"type":["string","null"],"description":"Número do registro nacional no conselho."},"titulosGraduacao":{"type":["array","null"],"items":{"type":["string","null"]},"description":"Lista de títulos de graduação."},"cursosPosGraduacao":{"type":["array","null"],"items":{"type":["string","null"]},"description":"Lista de cursos de pós-graduação."},"atribuicoesGraduacao":{"type":["string","null"],"description":"Atribuições profissionais de graduação."},"atribuicoesPosGraduacao":{"type":["string","null"],"description":"Atribuições profissionais de pós-graduação."}},"description":"Dados do registro profissional."},"metaDados":{"type":["object","null"],"properties":{"ip":{"type":["string","null"],"description":"Endereço IP da requisição."},"data":{"type":["string","null"],"description":"Data e hora da consulta no formato dd/MM/yyyy HH:mm:ss."},"chave":{"type":["string","null"],"description":"Chave de autenticação utilizada na requisição."},"usuario":{"type":["string","null"],"description":"Usuário que realizou a consulta."},"mensagem":{"type":["string","null"],"description":"Mensagem descritiva do resultado da consulta."},"apiVersao":{"type":["string","null"],"description":"Versão da API utilizada."},"resultado":{"type":["string","null"],"description":"Status ou tipo de resultado da consulta."},"assincrono":{"type":["boolean","null"],"description":"Indica se a consulta foi realizada de forma assíncrona."},"consultaUid":{"type":["string","null"],"description":"Identificador único da consulta."},"resultadoId":{"type":["number","null"],"description":"Identificador numérico do resultado."},"consultaNome":{"type":["string","null"],"description":"Nome da consulta realizada."},"enviarCallback":{"type":["boolean","null"],"des