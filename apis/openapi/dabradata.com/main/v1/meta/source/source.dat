de funcionários."},"situacaoCadastral":{"type":["string","null"],"description":"Situação cadastral da empresa."},"ultimaAtualizacaoPJ":{"type":["string","null"],"description":"Data da última atualização dos dados cadastrais."},"naturezaJuridicaTipo":{"type":["string","null"],"description":"Tipo de natureza jurídica da empresa."},"naturezaJuridicaCodigo":{"type":["number","null"],"description":"Código da natureza jurídica da empresa."},"quantidadeFuncionarios":{"type":["number","null"],"description":"Quantidade de funcionários da empresa."},"naturezaJuridicaDescricao":{"type":["string","null"],"description":"Descrição da natureza jurídica da empresa."}}},"example":{"cnpj":"11111111000111","ramo":null,"porte":"GRANDE","emails":[{"enderecoEmail":"financeiro@exemplo.com.br"},{"enderecoEmail":"contato@exemplo.com.br"},{"enderecoEmail":"juridico@exemplo.com.br"}],"matriz":true,"socios":[{"nome":"HOLDING INTERNACIONAL NORTE LTDA","cargo":"Sócio Pessoa Jurídica Domiciliado no Exterior","documento":"22.222.222/0001-22","dataEntrada":"01/09/2004 00:00:00","percentualParticipacao":null},{"nome":"PARTICIPACOES GLOBAL SUL LTDA","cargo":"Sócio Pessoa Jurídica Domiciliado no Exterior","documento":"33.333.333/0001-33","dataEntrada":"01/09/2004 00:00:00","percentualParticipacao":null},{"nome":"FERNANDO AUGUSTO RIBEIRO DIAS","cargo":"Administrador","documento":"111.111.111-11","dataEntrada":"26/08/2014 00:00:00","percentualParticipacao":null}],"enderecos":[{"uf":"SP","cep":"01310-100","bairro":"Bela Vista","cidade":"SAO PAULO","numero":"3477","logradouro":"Avenida Paulista","complemento":"Andar 15"},{"uf":"MG","cep":"30130-010","bairro":"Centro","cidade":"BELO HORIZONTE","numero":"3900","logradouro":"Avenida Afonso Pena","complemento":"Sala 8"}],"telefones":[{"whatsApp":null,"operadora":null,"tipoTelefone":null,"telefoneComDDD":"11999990002","telemarketingBloqueado":null},{"whatsApp":null,"operadora":null,"tipoTelefone":null,"telefoneComDDD":"11999990003","telemarketingBloqueado":nul