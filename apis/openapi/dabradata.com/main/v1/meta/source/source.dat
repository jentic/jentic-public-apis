":"Descrição detalhada da movimentação."},"movimento":{"type":["string","null"],"description":"Tipo de movimento realizado."}}},"description":"Histórico de movimentações do processo."},"numeroProcesso":{"type":["object","null"],"properties":{"numero":{"type":["string","null"],"description":"Número do processo formatado."},"incidente":{"type":["string","null"],"description":"Número do incidente associado."}},"description":"Identificação do número do processo."},"outrosAssuntos":{"type":["string","null"],"description":"Outros assuntos relacionados ao processo."},"partesProcesso":{"type":["array","null"],"items":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome da parte."},"tipo":{"type":["string","null"],"description":"Tipo da parte (Reqte, Reqdo, etc)."},"representantes":{"type":["array","null"],"items":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome do representante."},"tipo":{"type":["string","null"],"description":"Tipo de representante (Advogado, etc)."}}},"description":"Lista de representantes da parte."}}},"description":"Lista de partes envolvidas no processo."},"peticoesDiversas":{"type":["array","null"],"items":{"type":"object","properties":{"data":{"type":["string","null"],"description":"Data da petição."},"tipo":{"type":["string","null"],"description":"Tipo de petição."}}},"description":"Lista de petições diversas apresentadas."}},"description":"Dados detalhados do processo."},"resumoProcessos":{"type":["array","null"],"items":{"type":"object","properties":{"parte":{"type":["string","null"],"description":"Nome da parte envolvida."},"classe":{"type":["string","null"],"description":"Classe do processo."},"numero":{"type":["string","null"],"description":"Número do processo."},"assunto":{"type":["string","null"],"description":"Assunto do processo."},"distribuicao":{"type":["object","null"],"properties":{"data":{"type":["string","null"],"description":"Data da distribuição."},"distribuicao":{"type":["string","null"],"description":"Forma de distribuição."}},"description":"Detalhes da distribuição do processo."}}},"description":"Resumo dos processos no foro."}}},"description":"Lista de foros com processos de primeiro grau."},"totalProcessos":{"type":["integer","null"],"description":"Quantidade total de processos em primeiro grau."}},"description":"Detalhes dos processos de primeiro grau."},"numeroProcesso":{"type":["string","null"],"description":"Número do processo consultado."}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"uf":"SP","grau":1,"status":"A entidade possui pelo menos 1 processo.","documento":"111.111.111-11","nomeParte":null,"segundoGrau":null,"primeiroGrau":{"foros":[{"foro":"Foro Central Cível","dadosProcesso":{"area":"Cível","juiz":"BELTRANO DE TAL","vara":"1ª Vara Cível","classe":"Procedimento Comum Cível","apensos":[],"assunto":"Cobrança","controle":"2026/000000","valorAcao":15000,"audiencias":[],"incidentes":[],"distribuicao":{"data":null,"distribuicao":"Livre"},"movimentacoes":[{"data":"20/10/2026 14:05:12","descricao":null,"movimento":"Conclusos para Despacho"},{"data":"15/10/2026 10:21:40","descricao":"Certifico e dou fé que o aviso de recebimento referente à parte requerida retornou positivo.","movimento":"Certidão de Cartório Expedida"},{"data":"02/10/2026 16:47:03","descricao":"Nº Protocolo: WXXX.26.00000000-0 Tipo da Petição: Petição Intermediária Data: 02/10/2026 16:45","movimento":"Petição Juntada"},{"data":"18/09/2026 09:12:55","descricao":"Expedida carta de citação com aviso de recebimento