l},{"cpf":null,"nome":"***","codigoCBO":"142330","dataAdmissao":null,"descricaoCBO":"ANALISTA DE NEGOCIOS","dataNascimento":null},{"cpf":null,"nome":"***","codigoCBO":"142105","dataAdmissao":null,"descricaoCBO":"GERENTE ADMINISTRATIVO","dataNascimento":null},{"cpf":null,"nome":"***","codigoCBO":"411005","dataAdmissao":null,"descricaoCBO":"AUXILIAR DE ESCRITORIO","dataNascimento":null},{"cpf":null,"nome":"***","codigoCBO":"123105","dataAdmissao":null,"descricaoCBO":"DIRETOR ADMINISTRATIVO","dataNascimento":null},{"cpf":null,"nome":"***","codigoCBO":"142330","dataAdmissao":null,"descricaoCBO":"ANALISTA DE NEGOCIOS","dataNascimento":null},{"cpf":null,"nome":"***","codigoCBO":"142330","dataAdmissao":null,"descricaoCBO":"ANALISTA DE NEGOCIOS","dataNascimento":null},{"cpf":null,"nome":"***","codigoCBO":"411010","dataAdmissao":null,"descricaoCBO":"ASSISTENTE ADMINISTRATIVO","dataNascimento":null},{"cpf":null,"nome":"***","codigoCBO":"411010","dataAdmissao":null,"descricaoCBO":"ASSISTENTE ADMINISTRATIVO","dataNascimento":null},{"cpf":null,"nome":"***","codigoCBO":"252305","dataAdmissao":null,"descricaoCBO":"SECRETARIA(O) EXECUTIVA(O)","dataNascimento":null},{"cpf":null,"nome":"***","codigoCBO":"142330","dataAdmissao":null,"descricaoCBO":"ANALISTA DE NEGOCIOS","dataNascimento":null},{"cpf":null,"nome":"***","codigoCBO":"411010","dataAdmissao":null,"descricaoCBO":"ASSISTENTE ADMINISTRATIVO","dataNascimento":null},{"cpf":null,"nome":"***","codigoCBO":"411010","dataAdmissao":null,"descricaoCBO":"ASSISTENTE ADMINISTRATIVO","dataNascimento":null}],"quantidadeFuncionarios":83}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/mpt-consulta":{"get":{"summary":"Ministério Público do Trabalho (MPT)","description":"Certidão Negativa de Feitos do Ministério Público do Trabalho (MPT). Informe o CNPJ e a regional é identificada automaticamente pela sede da empresa. Útil para habilitação em licitações, due diligence e KYC.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.","operationId":"mpt-consulta","tags":["Tribunais"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF da pessoa a consultar. Aceita com ou sem pontuação. Exige o parâmetro `uf`.","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ da empresa a consultar. Aceita com ou sem pontuação. Dispensa `uf`: a regional é identificada pela sede.","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"uf","in":"query","required":false,"description":"Regional do MPT a consultar. Opcional para CNPJ (derivada da sede) e obrigatória para CPF.","schema":{"type":"string","format":"upper","enum":["AC","AL","AM","AP","BA","CE","DF","ES","GO","MA","MG","MS","MT","PA","PB","PE","PI","PR","RJ","RN","RO","RR","RS","SC","SE","SP","TO","CAMPINAS"]},"example":"SP"},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"regiao":{"type":["string","null"],"description":"Regional do MPT efetivamente consultada (UF). Para CNPJ sem `uf` informada, é a regional da sede."},"status":{"type":["string","null"],"description":"`Certidão negativa` ou `Certidão positiva`."},"dataEmissao":{"type":["string","null"],"description":"Data e hora de emissão da certidão."},"ocorrencias":{"type":["array","null"],"items":{"type":"object","properties":{"classe":{"type":["string","null"],"description":"Classe do procedimento no MPT (ex.: NF, IC, PP, PA-TAC)."},"numero":{"type":["string","null"],"description":"Número do procedimento."},"partes":{"type":["array","null"],"items":{"type":["string","null"]},"description":"Partes no polo passivo."},"situacao":{"type":["string","null"],"description":"Situação do procedimento (ex.: ATIVO, ARQUIVADO)."},"anoAutuacao":{"type":["string","null"],"description":"Ano de autuação do procedimento."}}},"description":"Procedimentos encontrados. Lista vazia quando não há."},"linkValidacao":{"type":["string","null"],"description":"Endereço oficial da Procuradoria Regional para conferir a autenticidade da certidão usando o `codigoValidacao`."},"codigoValidacao":{"type":["string","null"],"description":"Código de validação da certidão emitida."},"mensagemCertidao":{"type":["string","null"],"description":"Texto de autenticidade emitido pelo MPT junto com a certidão."},"possuiOcorrencia":{"type":["boolean","null"],"format":"bool","description":"Indica se há procedimentos em nome do documento na regional consultada."},"documentoConsultado":{"type":["string","null"],"description":"CPF ou CNPJ consultado."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/tj-processos":{"get":{"summary":"Processos - Tribunal de Justiça","description":"Consulta a situação de processos judiciais no Tribunal de Justiça com detalhes de primeiro e segundo graus, retornando informações processuais para análise de compliance e risco jurídico.\n\nObrigatório informar pelo menos um de: cpf ou cnpj ou nome_parte ou numero_processo.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"tj-processos","tags":["Tribunais"],"parameters":[{"name":"uf","in":"query","required":false,"description":"Estados atendidos: PE, PI, SC e SP.","schema":{"type":"string","format":"upper","enum":["PE","PI","SC","SP"]},"example":"SP"},{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"grau","in":"query","required":false,"description":"Grau da instância processual buscada: primeiro ou segundo grau.","schema":{"type":"string"}},{"name":"nome_parte","in":"query","required":false,"description":"Nome completo da parte envolvida no processo. Via de busca alternativa a `cpf`, `cnpj` ou `numero_processo` — quanto mais completo o nome, maior a precisão do resultado.","schema":{"type":"string"}},{"name":"numero_processo","in":"query","required":false,"description":"Número do processo judicial, aceito com ou sem formatação. Via de busca alternativa a `cpf`, `cnpj` ou `nome_parte`.","schema":{"type":"string"}}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"uf":{"type":["string","null"],"description":"Unidade Federativa (estado) da consulta."},"grau":{"type":["integer","null"],"description":"Grau de jurisdição (1 para primeiro grau, 2 para segundo grau)."},"consta":{"type":["boolean","null"],"format":"bool","description":"Indica se consta algum registro para o documento consultado."},"status":{"type":["string","null"],"description":"Situação geral da consulta de processos."},"mensagem":{"type":["string","null"],"description":"Mensagem do resultado da consulta."},"documento":{"type":["string","null"],"description":"Documento (CPF ou CNPJ) consultado."},"nomeParte":{"type":["string","null"],"description":"Nome da parte consultada."},"parametros":{"type":["object","null"],"description":"Parâmetros informados na consulta."},"segundoGrau":{"type":["object","null"],"properties":{"sessoes":{"type":["array","null"],"items":{"type":"object","properties":{"sessao":{"type":["string","null"],"description":"Descrição da sessão."},"dadosProcesso":{"type":["object","null"],"properties":{"area":{"type":["string","null"],"description":"Área de atuação."},"secao":{"type":["string","null"],"description":"Seção do tribunal."},"classe":{"type":["string","null"],"description":"Classe processual."},"origem":{"type":["string","null"],"description":"Origem do processo (tribunal de origem)."},"assunto":{"type":["string","null"],"description":"Assunto principal do processo."},"relator":{"type":["string","null"],"description":"Nome do relator do processo."},"valorAcao":{"type":["number","null"],"description":"Valor da ação em reais."},"julgamentos":{"type":["array","null"],"items":{"type":"object","properties":{"data":{"type":["string","null"],"description":"Data do julgamento."},"decisao":{"type":["string","null"],"description":"Conteúdo da decisão."},"situacao":{"type":["string","null"],"description":"Situação do julgamento."}}},"description":"Histórico de julgamentos."},"volumeApenso":{"type":["string","null"],"description":"Volume do apenso."},"movimentacoes":{"type":["array","null"],"items":{"type":"object","properties":{"data":{"type":["string","null"],"description":"Data da movimentação."},"descricao":{"type":["string","null"],"description":"Descrição da movimentação."},"movimento":{"type":["string","null"],"description":"Tipo de movimento."}}},"description":"Histórico de movimentações."},"orgaoJulgador":{"type":["string","null"],"description":"Órgão responsável pelo julgamento."},"numeroProcesso":{"type":["object","null"],"properties":{"numero":{"type":["string","null"],"description":"Número do processo formatado."},"incidente":{"type":["string","null"],"description":"Número do incidente associado."}},"description":"Identificação do número do processo."},"partesProcesso":{"type":["array","null"],"items":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome da parte."},"tipo":{"type":["string","null"],"description":"Tipo da parte."},"representantes":{"type":["array","null"],"items":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome do representante."},"tipo":{"type":["string","null"],"description":"Tipo de representante."}}},"description":"Representantes da parte."}}},"description":"Lista de partes envolvidas."},"peticoesDiversas":{"type":["array","null"],"items":{"type":"object","properties":{"data":{"type":["string","null"],"description":"Data da petição."},"tipo":{"type":["string","null"],"description":"Tipo de petição."}}},"description":"Petições diversas apresentadas."},"subprocessosRecursos":{"type":["array","null"],"items":{"type":"object","properties":{"classe":{"type":["string","null"],"description":"Classe do subprocesso."},"dataRecebimento":{"type":["string","null"],"description":"Data de recebimento."}}},"description":"Subprocessos e recursos."},"composicaoJulgamentos":{"type":["array","null"],"items":{"type":"object","properties":{"magistrado":{"type":["string","null"],"description":"Nome do magistrado."},"participacao":{"type":["string","null"],"description":"Tipo de par