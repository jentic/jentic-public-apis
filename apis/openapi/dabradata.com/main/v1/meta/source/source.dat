sado para complementar a identificação na consulta pelo CPF.","schema":{"type":"string"}},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"cpf":{"type":["string","null"],"description":"CPF pesquisado."},"nome":{"type":["string","null"],"description":"Nome completo associado ao CPF."},"status":{"type":["string","null"],"description":"Texto integral da certidão emitida pela Polícia Federal (indica se consta ou não decisão condenatória)."},"nomeMae":{"type":["string","null"],"description":"Nome da mãe da pessoa pesquisada."},"protocolo":{"type":["string","null"],"description":"Protocolo do requerimento na Polícia Federal, presente quando a certidão não foi emitida (`certidaoEmitida=false`). Apresente-o em uma unidade da Polícia Federal para concluir a emissão."},"dataEmissao":{"type":["string","null"],"description":"Data e hora de emissão da certidão."},"dataValidade":{"type":["string","null"],"description":"Data e hora limite de validade da certidão."},"dataNascimento":{"type":["string","null"],"description":"Data de nascimento da pessoa pesquisada."},"numeroCertidao":{"type":["string","null"],"description":"Número identificador da certidão."},"certidaoEmitida":{"type":["boolean","null"],"format":"bool","description":"Só aparece (como `false`) quando a Polícia Federal não emitiu a certidão: o resultado é inconclusivo e NÃO significa ausência de antecedentes. Quando a certidão é emitida, o campo é omitido."},"possuiAntecedentesCriminais":{"type":["boolean","null"],"format":"bool","description":"Indica se há antecedentes criminais (true) ou se nada consta (false)."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/mpmt-investigacao":{"get":{"summary":"MP Mato Grosso - Procedimentos Investigatórios","description":"Consulta procedimentos investigatórios extrajudiciais no Ministério Público de Mato Grosso para CPF ou CNPJ, retornando informações sobre investigações instauradas e dados de certificação.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.","operationId":"mpmt-investigacao","tags":["Processos Judiciais"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":["string","null"],"description":"Mensagem de status do certificado."},"dataEmissao":{"type":["string","null"],"description":"Data de emissão do certificado."},"dataValidade":{"type":["string","null"],"description":"Data de validade do certificado."},"numeroCertidao":{"type":["string","null"],"description":"Número de identificação do certificado."},"codigoValidacao":{"type":["string","null"],"description":"Código de validação do certificado."},"documentoConsultado":{"type":["string","null"],"description":"Documento (CPF ou CNPJ) consultado."},"possuiProcedimentoExtrajudicial":{"type":["boolean","null"],"description":"Indica se há procedimentos investigatórios extrajudiciais registrados."},"procedimentosInvestigatoriosExtrajudiciais":{"type":["array","null"],"items":{"type":"object","properties":{"classe":{"type":["string","null"],"description":"Classe do registro."},"comarca":{"type":["string","null"],"description":"Comarca de origem do processo."},"numeroSIMP":{"type":["string","null"],"description":"Número SIMP do registro."},"observacao":{"type":["string","null"],"description":"Observação relacionada ao registro."},"promotoriaResponsavel":{"type":["string","null"],"description":"Promotoria responsável."}}},"description":"Lista de procedimentos investigatórios extrajudiciais."}}},"example":{"status":"Ministério Público do Estado de Mato Grosso - Procedimentos Investigatórios Extrajucidiais, CERTIFICO que NADA CONSTA nos registros de tramitação de Procedimentos Investigatórios Extrajudiciais, até apresente data, que contra o Documento de número 111.111.111-11, no Ministério Público do Estado de Mato Grosso ","dataEmissao":"17/04/2026 00:00:00","dataValidade":"17/05/2026 00:00:00","numeroCertidao":"67649","codigoValidacao":"619437F461A37B27401D66D5E8439ED6","documentoConsultado":"111.111.111-11","possuiProcedimentoExtrajudicial":false,"procedimentosInvestigatoriosExtrajudiciais":null}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/cnj-mandados-prisao":{"get":{"summary":"Mandados de Prisão (CNJ)","description":"Consulta mandados de prisão em aberto de uma pe