rue,"description":"Texto da mensagem. Cada 160 caracteres = 1 crédito.","schema":{"type":"string","maxLength":1600}},{"name":"reference","in":"query","required":false,"description":"Seu identificador do envio. Repetir o mesmo valor não dispara outro SMS nem cobra de novo — use no retry.","schema":{"type":"string","maxLength":100}}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":["string","null"]},"creditos":{"type":["integer","null"],"description":"Créditos de 160 caracteres cobrados neste envio."},"duplicado":{"type":["boolean","null"]},"request_id":{"type":["string","null"]}},"additionalProperties":true},"example":{"status":"sent","creditos":1,"request_id":"7f3a1c92-0000-0000-0000-000000000000"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/otp-send":{"post":{"summary":"Enviar código OTP","description":"Gera um código de uso único, envia por SMS e devolve um `request_id` para a validação posterior. O código nunca volta na resposta.","operationId":"otp-send","tags":["Mensageria"],"parameters":[{"name":"numero","in":"query","required":true,"description":"Celular de destino com DDI e DDD, só dígitos.","schema":{"type":"string","pattern":"^55[0-9]{10,11}$"}},{"name":"template","in":"query","required":false,"description":"Texto da mensagem contendo o marcador do código.","schema":{"type":"string","maxLength":300}},{"name":"code_length","in":"query","required":false,"description":"Quantidade de dígitos do código: 4 a 8 (padrão 6).","schema":{"type":"integer","enum":[4,5,6,7,8]}},{"name":"ttl_seconds","in":"query","required":false,"description":"Validade do código em segundos, de 60 a 900 (padrão 300).","schema":{"type":"integer"}}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":["string","null"]},"creditos":{"type":["integer","null"],"description":"Créditos de 160 caracteres cobrados neste envio."},"expira_em":{"type":["integer","string","null"]},"request_id":{"type":["string","null"]}},"additionalProperties":true},"example":{"status":"sent","creditos":1,"expira_em":300,"request_id":"otp_5c1d0e00000000000000000000000000"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/otp-resend":{"post":{"summary":"Reenviar código OTP","description":"Reenvia o código de uma verificação em aberto. Gera um código NOVO — o anterior deixa de valer.","operationId":"otp-resend","tags":["Mensageria"],"parameters":[{"name":"request_id","in":"query","required":true,"description":"Identificador da verificação em aberto.","schema":{"type":"string","maxLength":100}}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":["string","null"]},"creditos":{"type":["integer","null"],"description":"Créditos de 160 caracteres cobrados neste envio."},"request_id":{"type":["string","null"]}},"additionalProperties":true},"example":{"status":"sent","creditos":1,"request_id":"otp_5c1d0e00000000000000000000000000"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/sms-status":{"post":{"summary":"Status de SMS","description":"Consulta a situação de uma mensagem já enviada, pelo `request_id`: retida em análise, liberada para a operadora, entregue ou recusada, com os horários de cada etapa. Gratuita.","operationId":"sms-status","tags":["Mensageria"],"parameters":[{"name":"request_id","in":"query","required":true,"description":"Identificador devolvido no envio.","schema":{"type":"string","maxLength":100}}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":["string","null"],"description":"Situação normalizada: pending, held, sent, delivered, failed ou unknown."},"creditos":{"type":["integer","null"],"description":"Créditos de 160 caracteres cobrados neste envio."},"criado_em":{"type":["string","null"],"description":"Data e hora (UTC, ISO 8601) em que recebemos a mensagem."},"operadora":{"type":["string","null"]},"enviado_em":{"type":["string","null"],"description":"Data e hora (UTC, ISO 8601) em que a mensagem foi liberada para a operadora. null enquanto não sai (inclusive retida em análise)."},"request_id":{"type":["string","null"]},"entregue_em":{"type":["string","null"],"description":"Data e hora (UTC, ISO 8601) da confirmação de entrega. null até a confirmação."},"status_detalhe":{"type":["string","null"],"description":"Explicação curta da situação, em português."}},"additionalProperties":true},"example":{"status":"delivered","creditos":1,"criado_em":"2026-10-21T14:40:00+00:00","operadora":"VIVO","enviado_em":"2026-10-21T14:58:10+00:00","request_id":"7f3a1c92-0000-0000-0000-000000000000","entregue_em":"2026-10-21T14:58:16+00:00","status_detalhe":"Entrega confirmada pela operadora."}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/otp-verify":{"post":{"summary":"Verificar código OTP","description":"Confere o código digitado pelo usuário contra o `request_id` emitido. Uso único e gratuito.","operationId":"otp-verify","tags":["Mensageria"],"parameters":[{"name":"request_id","in":"query","required":true,"description":"Identificador devolvido no envio do código.","schema":{"type":"string","maxLength":100}},{"name":"codigo","in":"query","required":true,"description":"Código que o usuário digitou.","schema":{"type":"string","maxLength":12}}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"motivo":{"type":["string","null"]},"verificado":{"type":["boolean","null"]},"tentativas_restantes":{"type":["integer","null"]}},"additionalProperties":true},"example":{"verificado":true}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/anac-aeronaves":{"get":{"summary":"Aeronaves por CPF/CNPJ (RAB/ANAC)","description":"Lista todas as aeronaves registradas no Registro Aeronáutico Brasileiro (RAB/ANAC) para um CPF ou CNPJ — como proprietário ou operador — com o cadastro completo de cada uma (fabricante, modelo, série, situação, gravame, datas). Útil para cobrança de inadimplentes, due diligence e pesquisa patrimonial.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.\n\nEnvie no máximo um de: cpf ou cnpj — cada consulta responde sobre um único documento.","operationId":"anac-aeronaves","tags":["Patrimônio"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF do titular a consultar — 11 dígitos, com ou sem pontuação. A máscara é removida antes da validação e o dígito verificador é conferido.","schema":{"type":"string","format":"cpf","pattern":"^[0-9]{11}$"}},{"name":"cnpj","in":"query","required":false,"description":"CNPJ da empresa a consultar — 14 caracteres, com ou sem pontuação. Aceita o CNPJ alfanumérico (12 posições em A-Z/0-9 mais 2 dígitos verificadores). A máscara é removida antes da validação e o dígito verificador é conferido.","schema":{"type":"string","format":"cnpj","pattern":"^[A-Z0-9]{12}[0-9]{2}$"}}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":["string","null"],"description":"Frase-resumo do resultado (ex.: 'Constam 4 aeronaves para o CPF/CNPJ pesquisado.' ou 'Nada consta: nenhuma aeronave registrada para o CPF/CNPJ pesquisado.')."},"aeronaves":{"type":"array","items":{"type":"object","properties":{"marca":{"type":["string","null"],"description":"Marca/matrícula da aeronave, no formato canônico com hífen (ex.: 'PR-AIZ', 'PP-BER'). É a 'placa' da aeronave no RAB."},"classe":{"type":["string","null"],"description":"Classe da aeronave conforme o RAB (ex.: 'L2J' = terrestre bimotor a jato, 'L1T' = terrestre monomotor turboélice)."},"modelo":{"type":["string","null"],"description":"Modelo da aeronave (ex.: 'A330-243', 'ERJ 190-200 LR', 'PC-12/45')."},"gravame":{"type":"object","properties":{"possuiGravame":{"type":["boolean","null"],"description":"true = há gravame/ônus registrado sobre a aeronave; false = livre de gravame."},"depositarioNome":{"type":["string","null"],"description":"Nome/razão social do depositário/credor do gravame. null quando não há gravame."},"depositarioDocumento":{"type":["string","null"],"description":"CPF/CNPJ do depositário/credor, formatado com máscara. null quando não há gravame."}},"description":"Gravame/ônus sobre a aeronave (alienação fiduciária, penhor). Indica que a aeronave está dada em garantia a um credor (depositário) — relevante para cobrança: um bem gravado tem restrição."},"motivos":{"type":["string","null"],"description":"Motivo(s) associados à situação da aeronave, quando há. null quando não há."},"vinculo":{"type":["string","null"],"description":"Como o documento consultado figura NESTA aeronave: 'PROPRIETARIO' (é o dono), 'OPERADOR' (opera mas não é o dono — típico de aeronave arrendada/leasing) ou 'PROPRIETARIO_E_OPERADOR' (ambos). null quando não se aplica."},"operador":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome/razão social do operador."},"documento":{"type":["string","null"],"description":"CPF/CNPJ do operador, formatado com máscara."}},"description":"Operador registrado da aeronave (quem a opera — pode diferir do proprietário em caso de arrendamento/leasing)."},"tipoIcao":{"type":["string","null"],"description":"Designador de tipo ICAO da aeronave (ex.: 'A332', 'E190', 'PC12')."},"fabricante":{"type":["string","null"],"description":"Fabricante da aeronave (ex.: 'AIRBUS S.A.S.', 'EMBRAER', 'PILATUS')."},"numeroSerie":{"type":["string","null"],"description":"Número de série de fábrica da aeronave."},"situacaoRab":{"type":["string","null"],"description":"Situação do registro no RAB, quando informada. null quando a fonte não informa."},"proprietario":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome/razão social do proprietário."},"documento":{"type":["string","null"],"description":"CPF/CNPJ do proprietário, formatado com máscara."}},"description":"Proprietário registrado da aeronave (quem detém a propriedade — pode ser uma arrendadora/leasing, distinto do operador)."},"dataValidadeCa":{"type":["string","null"],"description":"Data de validade do Certificado de Aeronavegabilidade (CA), no formato 'DD/MM/AAAA'."},"dataValidadeRca":{"type":["string","null"],"description":"Data de validade do Registro/Certificado (RCA), no formato 'DD/MM/AAAA'. null quando não há."},"categoriaRegistro":{"type":["string","null"],"description":"Categoria de registro no RAB (ex.: 'TPR' = transporte público regular, 'TPN' = transporte público não-regular, 'TPX' = táxi aéreo, 'PRI' = privado)."},"tipoVooAutorizado":{"type":["string","null"],"description":"Tipo de voo autorizado para a aeronave. null quando a fonte não informa."},"numeroCertificados":{"type":["string","null"],"description":"Número dos certificados de matrícula (CM) e de aeronavegabilidade (CA) no RAB."},"pesoMaximoDecolagemKg":{"type":["integer","null"],"description":"Peso máximo de decolagem (MTOW) em quilogramas."},"tipoHabilitacaoPilotos":{"type":["string","null"],"description":"Habilitação exigida dos pilotos para operar a aeronave (ex.: 'A330/350')."},"dataCompraTransferencia":{"type":["string","null"],"description":"Data da compra/transferência da aeronave para o proprietário atual, no formato 'DD/MM/AAAA'."},"numeroMaximoPassageiros":{"type":["integer","null"],"description":"Número máximo de passageiros da aeronave."},"situacaoAeronavegabilidade":{"type":["string","null"],"description":"Situação de aeronavegabilidade (ex.: 'NORMAL', 'CERTIFICADO DE AERONAVEGABILIDADE (CA) SUSPENSO')."}},"description":"Cadastro completo de uma aeronave no RAB."},"description":"Lista das aeronaves vinculadas ao documento. Vazia ([]) quando nada consta. Nunca null: ausência é afirmada por [], não por null."},"tipoPessoa":{"type":["string","null"],"description":"Tipo do documento consultado: 'PF' para CPF (11 dígitos) ou 'PJ' para CNPJ (14 dígitos)."},"possuiAeronave":{"type":["boolean","null"],"description":"true = há ao menos uma aeronave registrada para o documento (como proprietário ou operador); false = NADA CONSTA no RAB."},"documentoConsultado":{"type":["string","null"],"description":"CPF ou CNPJ consultado, formatado com máscara (ex.: '11.111.111/0001-11' ou '111.111.111-11')."},"quantidadeAeronaves":{"type":["integer","null"],"description":"Quantidade de aeronaves retornadas para o documento. 0 quando nada consta."}},"description":"Aeronaves registradas para um CPF/CNPJ no Registro Aeronáutico Brasileiro (RAB/ANAC), com o cadastro completo de cada uma. Uma consulta retorna todas as aeronaves em que a pessoa figura como proprietária OU operadora. Fonte: RAB/ANAC."},"example":{"status":"Constam 2 aeronaves para o CPF/CNPJ pesquisado.","aeronaves":[{"marca":"PR-XAB","classe":"L1T","modelo":"PC-12/45","gravame":{"possuiGravame":false,"depositarioNome":null,"depositarioDocumento":null},"motivos":null,"vinculo":"OPERADOR","operador":{"nome":"AEREO EXEMPLO TRANSPORTES LTDA","documento":"11.111.111/0001-11"},"tipoIcao":"PC12","fabricante":"PILATUS","numeroSerie":"412","situacaoRab":null,"proprietario":{"nome":"EXEMPLO LEASING DE AERONAVES S.A.","documento":"22.222.222/0001-22"},"dataValidadeCa":"02/09/2026","dataValidadeRca":null,"categoriaRegistro":"TPX","tipoVooAutorizado":null,"numeroCertificados":"19004","pesoMaximoDecolagemKg":4500,"tipoHabilitacaoPilotos":"MNTE","dataCompraTransferencia":"16/09/2013","numeroMaximoPassageiros":8,"situacaoAeronavegabilidade":"NORMAL"},{"marca":"PP-XCD","classe":"L1T","modelo":"PC-12/45","gravame":{"possuiGravame":false,"depositarioNome":null,"depositarioDocumento":null},"motivos":null,"vinculo":"PROPRIETARIO_E_OPERADOR","operador":{"nome":"AEREO EXEMPLO TRANSPORTES LTDA","documento":"11.111.111/0001-11"},"tipoIcao":"PC12","fabricante":"PILATUS","numeroSerie":"533","situacaoRab":null,"proprietario":{"nome":"AEREO EXEMPLO TRANSPORTES LTDA","documento":"11.111.111/0001-11"},"dataValidadeCa":"29/09/2026","dataValidadeRca":null,"categoriaRegistro":"TPX","tipoVooAutorizado":null,"numeroCertificados":"19288","pesoMaximoDecolagemKg":4500,"tipoHabilitacaoPilotos":"MNTE","dataCompraTransferencia":"09/06/2014","numeroMaximoPassageiros":8,"situacaoAeronavegabilidade":"NORMAL"}],"tipoPessoa":"PJ","possuiAeronave":true,"documentoConsultado":"11.111.111/0001-11","quantidadeAeronaves":2}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/compone