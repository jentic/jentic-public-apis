responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]],"x-empty-as-negative":true}},"/api/v1/consulta/anbima-certificado-edu":{"get":{"summary":"Certificações Anbima","description":"Retorna as certificações profissionais da Anbima (como CPA-10, CPA-20, CEA, CGA, CFG, entre outras) associadas a um CPF, com datas de obtenção e vencimento, forma de obtenção e situação de cada certificado. Serve para comprovar a habilitação de profissionais do mercado financeiro.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"anbima-certificado-edu","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"cpf":{"type":["string","null"],"description":"CPF consultado."},"observacoes":{"type":["string","null"],"description":"Resumo textual do resultado da consulta."},"nomeEntidade":{"type":["string","null"],"description":"Nome da pessoa vinculada ao CPF na base da Anbima."},"certificacoes":{"type":["array","null"],"items":{"type":"object","properties":{"titulo":{"type":["string","null"],"description":"Sigla da certificação (ex.: CPA-10, CPA-20, CEA, CGA, CFG)."},"situacao":{"type":["string","null"],"description":"Situação atual da certificação (ex.: ATIVA, VENCIDA)."},"vencimento":{"type":["string","null"],"description":"Data limite de validade da certificação."},"formaObtencao":{"type":["string","null"],"description":"Forma pela qual a certificação foi obtida (ex.: exame de certificação, dominância)."},"ultimaAtualizacao":{"type":["string","null"],"description":"Data da atualização mais recente do certificado."},"primeiraCertificacao":{"type":["string","null"],"description":"Data da primeira obtenção da certificação."}}},"description":"Lista de certificações Anbima associadas ao CPF."},"possuiCertificacoes":{"type":["boolean","null"],"description":"Indica se foram localizadas certificações para o documento consultado."}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/bet-safe-compliance":{"get":{"summary":"Compliance para Apostas (Bet Safe)","description":"Consulta informações detalhadas de CPF para análise de risco e compliance em apostas, incluindo dados pessoais, benefícios sociais, vínculos familiares e status de conformidade.","operationId":"bet-safe-compliance","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"cbo":{"type":["string","null"],"description":"Classificação Brasileira de Ocupações."},"cpf":{"type":["