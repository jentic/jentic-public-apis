null,"nascimento":"string","nomeSocial":null,"restricoes":{"ocorrencias":[{"titulo":"string","observacao":"string","codigoInformacao":"string","descricaoInformacao":"string"}],"quantidadeOcorrencias":"string"},"acoesCiveis":{"dataMaior":null,"dataMenor":null,"dataUltimo":null,"valorMaior":null,"valorMenor":null,"valorTotal":null,"ocorrencias":[],"valorUltimo":null,"dataPrimeiro":null,"valorPrimeiro":null,"quantidadeOcorrencia":"string"},"cpfSituacao":"string","estadoCivil":"string","classeSocial":null,"naturalidade":null,"grauInstrucao":"string","nacionalidade":null,"rgDataEmissao":null,"tituloEleitor":"string","indicacaoObito":null,"rendaPresumida":{"faixa":"string","descricao":"string","rendaAnual":null,"dataReferencia":null,"valorPresumido":null,"dadosCadastroPositivo":null},"poderAquisitivo":null,"controlePositivo":{"ocorrenciasFaturasEmAtraso":[{"notaComportamentoFaturaEmAtraso":"string"}],"ocorrenciasNotaComportamentosContratosRecentes":[{"nota":"string"}]},"numeroDependentes":"string","ultimoImpostoRenda":null,"cartaoNacionalSaude":null,"chequeSemFundoBacen":{"documento":null,"tipoPessoa":null,"correntista":null,"quantidadeOcorrencia":"string"},"passagensComerciais":{"ocorrencias":[],"quantidadeOcorrencias":"string"},"chequeSemFundoVarejo":{"documento":null,"tipoPessoa":null,"correntista":null,"quantidadeOcorrencia":"string"},"pendenciasFinanceiras":{"dataMaior":"string","provedores":[{"provedor":"string"}],"valorMaior":null,"valorTotal":"string","ocorrencias":[{"moeda":"string","valor":"string","credor":"string","origem":"string","contrato":"string","entidade":null,"subjudice":null,"informante":"string","modalidade":"string","tipoDevedor":"string","dataInclusao":"string","dataVencimento":"string"}],"dataPrimeiro":"string","periodoFinal":null,"totalCredores":null,"valorPrimeiro":null,"periodoInicial":null,"ultimoVencimento":null,"quantidadeOcorrencia":"string"},"participacaoEmEmpresas":{"ocorrencias":[{"cnpj":"string","razaoSocial":"string","participacao":"string","participanteTipo":"string","participanteCargo":"string","participanteEntrada":"string","participanteDocumento":"string","quantidadeOutrosSocios":null}],"quantidadeOcorrencias":"string"},"cpfDataAtualizacaoReceita":"string","falenciasAcoesRecuperacoes":{"valorTotal":null,"ocorrencias":[],"ultimoRegistro":null,"quantidadeOcorrencia":"string"},"qtdDependentesBolsaFamilia":null}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/score-credito-quod":{"get":{"summary":"Score de Crédito (Quod)","description":"Retorna o Score de crédito de uma Pessoa Física ou Jurídica, analisando seu risco através de indicadores de inadimplência e capacidade de pagamento.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.","operationId":"score-credito-quod","tags":["Crédito & Score"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"observacao":{"type":["string","null"],"description":"Observação relacionada ao registro retornado."},"pessoaFisica":{"type":["object","null"],"properties":{"score":{"type":["number","null"],"description":"Score de crédito, de 0 a 1000. Quanto maior, menor o risco."},"faixaScore":{"type":["string","null"],"description":"Classificação da faixa de score (Alto, Médio ou Baixo índice de inadimplência)."},"scorePerfil":{"type":["number","null"],"description":"Score de perfil: quanto o comportamento de crédito segue o esperado. Pode não vir."},"scorePagamento":{"type":["number","null"],"description":"Score de compromisso de pagamento: como a pessoa paga as contas no dia a dia. Pode não vir."},"descricaoPerfil":{"type":["string","null"],"description":"Explicação do score de perfil. Pode não vir."},"descricaoScorePagamento":{"type":["string","null"],"description":"Explicação do score de compromisso de pagamento. Pode não vir."}},"description":"Dados de score de crédito da pessoa física consultada."},"pessoaJuridica":{"type":["object","null"],"properties":{"score":{"type":["number","null"],"description":"Pontuação da pessoa jurídica."},"motivos":{"type":["array","null"],"items":{"type":["string","null"]},"description":"Lista de motivos que resultaram no score apresentado."},"faixaScore":{"type":["string","null"],"description":"Classificação da faixa de score (Alto, Médio ou Baixo índice de inadimplência)."},"indicadoresNegocio":{"type":["array","null"],"items":{"type":"object","properties":{"risco":{"type":["string","null"],"description":"Nível de risco associado ao indicador."},"status":{"type":["string","null"],"description":"Status do indicador."},"indicador":{"type":["string","null"],"description":"Título do indicador de negócio."},"observacao":{"type":["string","null"],"description":"Observação sobre o indicador."}}},"description":"Lista de indicadores de negócio utilizados no cálculo do score."}},"description":"Dados de score de crédito da pessoa jurídica consultada."},"documentoConsultado":{"type":["string","null"],"description":"Documento consultado referente ao CPF ou CNPJ."}}},"example":{"observacao":null,"pessoaFisica":{"score":712,"faixaScore":"Baixo índice de inadimplência","scorePerfil":85,"scorePagamento":280,"descricaoPerfil":"O consumidor apresenta o comportamento esperado ou possui pequenas divergências na utilização de crédito.","descricaoScorePagamento":"O consumidor paga até 50% ou a maioria das suas contas em dia na média dos últimos 12 meses."},"pessoaJuridica":null,"documentoConsultado":"111.111.111-11"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/tse-titulo":{"get":{"summary":"Título de Eleitor e Local de Votação","description":"Consulta a situação do título de eleitor e o local de votação de um cidadão a partir do CPF. Retorna a identificação do eleitor (nome e número de inscrição), a situação da regularidade eleitoral, se a biometria foi coletada, e o domicílio eleitoral completo: UF, município, zona, seção, bairro, logradouro e número. Informar nome da mãe e data de nascimento eleva a taxa de correspondência e desambigua homônimos.","operationId":"tse-titulo","tags":["Eleitoral"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF do cidadão (11 dígitos, com ou sem máscara). Obrigatório.","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"nome_mae","in":"query","required":true,"description":"Nome completo da mãe. Obrigatório — a base oficial exige nome da mãe e data de nascimento.","schema":{"type":"string"}},{"name":"data_nascimento","in":"query","required":true,"description":"Data de nascimento (DD/MM/AAAA). Obrigatório — a base oficial exige nome da mãe e data de nascimento.","schema":{"type":"string"},"example":"01/01/1990"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":["string","null"],"description":"Mensagem de status da consulta."},"identificacao":{"type":["object","null"],"properties":{"eleitor":{"type":["string","null"],"description":"Identificação do eleitor."},"inscricao":{"type":["string","null"],"description":"Número de inscrição do título eleitoral."}},"description":"Dados de identificação do eleitor."},"biometriaColetada":{"type":["boolean","null"],"description":"Indica se a biometria foi coletada pelo eleitor."},"domicilioEleitoral":{"type":["object","null"],"properties":{"uf":{"type":["string","null"],"description":"Unidade federativa do domicílio eleitoral."},"zona":{"type":["number","null"],"description":"Zona eleitoral."},"local":{"type":["string","null"],"description":"Local de votação."},"secao":{"type":["number","null"],"description":"Seção eleitoral."},"bairro":{"type":["string","null"],"description":"Bairro do domicílio eleitoral."},"numero":{"type":["string","null"],"description":"Número do endereço do domicílio eleitoral."},"municipio":{"type":["string","null"],"description":"Município do domicílio eleitoral."},"logradouro":{"type":["string","null"],"description":"Logradouro do domicílio eleitoral."},"proximaEleicao":{"type":["string","null"],"description":"Data ou informação sobre a próxima eleição."}},"description":"Informações do domicílio eleitoral e local de votação."}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/antt-regularidade":{"get":{"summary":"ANTT - Regularidade de Transportadora","description":"Consulta informações sobre veículos habilitados pela ANTT ao Transporte Rodoviário Internacional de Cargas, retornando dados do veículo e transportador para validação e compliance.\n\nObrigatório informar pelo menos um de: cpf ou cnpj ou rntrc.","operationId":"antt-regularidade","tags":["Fiscal"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"rntrc","in":"query","required":false,"description":"Número de Registro Nacional de Transportadores Rodoviários de Cargas (RNTRC) da transportadora. Alternativa a `cpf`/`cnpj` para localizar o registro junto à ANTT.","schema":{"type":"string"}},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"apto":{"type":["boolean","null"],"description":"Flag indicando se o transportador está apto para realizar transportes."},"rntrc":{"type":["number","null"],"description":"Número de Registro Nacional de Transportadores Rodoviários de Cargas."},"status":{"type":["string","null"],"description":"Detalhes sobre o status do registro."},"situacao":{"type":["string","null"],"description":"Situação atual do registro."},"categoria":{"type":["string","null"],"description":"Categoria do transportador."},"documento":{"type":["string","null"],"description":"Número do documento (CPF ou CNPJ)."},"protocolo":{"type":["string","null"],"description":"Protocolo de identificação da consulta."},"observacao":{"type":["string","null"],"description":"Observações relacionadas ao registro."},"dataEmissao":{"type":["string","null"],"description":"Data e hora de emissão do certificado."},"localizacao":{"type":["object","null"],"properties":{"uf":{"type":["string","null"],"description":"Unidade Federativa (estado)."},"municipio":{"type":["string","null"],"description":"Município ou cidade."}},"description":"Dados de localização do registro."},"dataConsulta":{"type":["string","null"],"description":"Data e hora da realização da consulta."},"transportador":{"type":["string","null"],"description":"Nome da entidade ou indivíduo transportador."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj","rntrc"]]}},"/api/v1/consulta/cadin-sp":{"get":{"summary":"CADIN - São Paulo","description":"[LEGADO — prefira o cadin-estadual] CADIN Estadual de São Paulo (Secretaria da Fazenda de SP), por CPF ou CNPJ.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.","operationId":"cadin-sp","tags":["Fiscal"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome do indivíduo ou registro consultado."},"status":{"type":["string","null"],"description":"Status detalhado do registro consultado."},"pendencias":{"type":["array","null"],"items":{"type":"object","properties":{"entidade":{"type":["string","null"],"description":"Nome da entidade responsável pela pendência."},"dataInclusaoCADIN":{"type":["string","null"],"description":"Data de inclusão da pendência no cadastro."},"localRegularizacao":{"type":["string","null"],"description":"Endereço ou local para regularização da pendência."},"quantidadePendencias":{"type":["number","null"],"description":"Quantidade de pendências registradas para a entidade."}}},"description":"Lista de pendências encontradas."},"totalPendencias":{"type":["number","null"],"description":"Número total de pendências encontradas."},"codigoDeclaracao":{"type":["string","null"],"description":"Código único de identificação da consulta realizada."},"possuiPendencias":{"type":["boolean","null"],"description":"Indicador se existem pendências para o documento consultado."},"documentoConsultado":{"type":["string","null"],"description":"CPF ou CNPJ consultado nesta requisição."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/cadin-estadual":{"post":{"summary":"CADIN Estadual","description":"Consulta o CADIN Estadual (Cadastro Informativo de Inadimplência das Secretarias da Fazenda estaduais) por CPF ou CNPJ, roteando automaticamente pela UF informada — inclusive São Paulo. Um único endpoint para todos os estados. Para o CADIN MUNICIPAL de São Paulo (Prefeitura), use o endpoint cadin-prefeitura-SP.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.","operationId":"cadin-estadual","tags":["Fiscal"],"parameters":[{"name":"uf","in":"query","required":true,"description":"Estados atendidos: BA, GO, MG, MT, PA, PR, RN, RS, SP.","schema":{"type":"string","format":"upper","enum":["BA","GO","MG","MT","PA","PR","RN","RS","SP"]},"example":"SP"},{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"uf":{"type":["string","null"],"description":"Unidade Federativa (estado) referente ao registro."},"nome":{"type":["string","null"],"description":"Nome do indivíduo ou registro consultado."},"status":{"type":["string","null"],"description":"Detalhes sobre o status do registro em questão."},"pendencias":{"type":["array","null"],"items":{"type":"object","properties":{"orgao":{"type":["string","null"],"description":"Informações do órgão expedidor."},"entidade":{"type":["string","null"],"description":"Nome da entidade com pendência."},"tipoPendencia":{"type":["string","null"],"description":"Tipo de pendência registrada."},"numeroProcesso":{"type":["string","null"],"description":"Número do processo associado à pendência."},"dataInclusaoCADIN":{"type":["string","null"],"description":"Data de inclusão do documento no cadastro."},"localRegularizacao":{"type":["string","null"],"description":"Local para regularização da pendência."},"quantidadePendencias":{"type":["number","null"],"description":"Quantidade de pendências neste registro."}}},"description":"Lista de pendências registradas."},"valorTotal":{"type":["number","null"],"description":"Valor total de pendências."},"dataConsulta":{"type":["string","null"],"description":"Data e hora da consulta realizada."},"dataValidade":{"type":["string","null"],"description":"Data de validade do resultado da consulta."},"numeroCertidao":{"type":["string","null"],"description":"Número do certificado de consulta."},"totalPendencias":{"type":["number","null"],"description":"Total de pendências do documento consultado."},"codigoDeclaracao":{"type":["string","null"],"description":"Código de identificação da declaração."},"possuiPendencias":{"type":["boolean","null"],"description":"Indica se existem pendências registradas."},"documentoConsultado":{"type":["string","null"],"description":"Documento (CPF ou CNPJ) consultado."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/carf-recursos-fiscais":{"get":{"summary":"CARF — Recursos Fiscais","description":"Consulta os processos em tramitação ou julgados no CARF vinculados a um CPF ou CNPJ, trazendo número, tributo em discussão, recursos interpostos e histórico de andamentos. Ajuda a mapear contencioso administrativo tributário federal em análises de crédito e compliance.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"carf-recursos-fiscais","tags":["Fiscal"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":["object","null"],"properties":{"consta":{"type":["boolean","null"],"format":"bool","description":"Indica se consta algum registro para o documento consultado."},"mensagem":{"type":["string","null"],"description":"Mensagem do resultado da consulta."},"processos":{"type":["array","null"],"items":{"type":"object","properties":{"tributo":{"type":["string","null"],"description":"Tributo em discussão no processo."},"recursos":{"type":["array","null"],"items":{"type":"object","properties":{"dataEntrada":{"type":["string","null"],"description":"Data de entrada do recurso."},"tipoRecurso":{"type":["string","null"],"description":"Tipo do recurso interposto."}}},"description":"Recursos interpostos no processo."},"andamentos":{"type":["array","null"],"items":{"type":"object","properties":{"data":{"type":["string","null"],"description":"Data do andamento."},"ocorrencia":{"type":["string","null"],"description":"Descrição da ocorrência do andamento."}}},"description":"Histórico de andamentos do processo."},"dataEntrada":{"type":["string","null"],"description":"Data de entrada do processo no CARF."},"numeroProcesso":{"type":["string","null"],"description":"Número do processo administrativo."}}},"description":"Lista de processos administrativos fiscais no CARF."},"parametros":{"type":["object","null"],"description":"Parâmetros informados na consulta."},"observacoes":{"type":["string","null"],"description":"Observações gerais sobre o resultado."},"nomeEntidade":{"type":["string","null"],"description":"Nome ou razão social vinculada ao documento."},"totalProcessos":{"type":["integer","null"],"description":"Quantidade total de processos encontrados."},"documentoConsultado":{"type":["string","null"],"description":"CPF ou CNPJ informado na consulta."}},"description":"Resumo e lista de processos no CARF."},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]],"x-empty-as-negative":true}},"/api/v1/consulta/pgfn-devedores":{"get":{"summary":"Devedores da União (PGFN)","description":"Verifica se uma pessoa física ou jurídica tem dívida em cobrança na Dívida Ativa (lista de devedores da PGFN): União, FGTS e convênios com estados, municípios e autarquias, com valor total e inscrições.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.","operationId":"pgfn-devedores","tags":["Fiscal"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"uf":{"type":["string","null"],"description":"UF do devedor."},"cnae":{"type":["string","null"],"description":"Código CNAE do devedor (PJ)."},"nome":{"type":["string","null"],"description":"Nome ou razão social do devedor, quando inscrito."},"status":{"type":["string","null"],"description":"Resumo textual do resultado da consulta."},"naturezas":{"type":["array","null"],"description":"Inscrições em cobrança, uma por item (inclusive as de convênio, com `convenio`)."},"tipoPessoa":{"type":["string","null"],"description":"Tipo de pessoa (física ou jurídica)."},"tipoDevedor":{"type":["string","null"],"description":"Tipo de devedor (principal, corresponsável etc.)."},"totalDivida":{"type":["number","null"],"format":"currency","description":"Soma de todas as inscrições em cobrança (tributárias, previdenciárias, não tributárias, FGTS e convênios)."},"nomeFantasia":{"type":["string","null"],"description":"Nome fantasia do devedor."},"possuiDivida":{"type":["boolean","null"],"format":"bool","description":"Indica se há dívida inscrita na Dívida Ativa da União (PGFN)."},"cnaeDescricao":{"type":["string","null"],"description":"Descrição do CNAE do devedor (PJ)."},"nomeMunicipio":{"type":["string","null"],"description":"Município do devedor."},"codigoMunicipio":{"type":["number","string","null"],"description":"Código IBGE do município."},"totalTributario":{"type":["number","null"],"format":"currency","description":"Soma das naturezas Tributário - Demais débitos e Simples Nacional (0.0 ou null quando há dívida sem inscrição desse grupo)."},"unidadeResponsavel":{"type":["string","null"],"description":"Unidade da PGFN responsável pela cobrança."},"documentoConsultado":{"type":["string","null"],"description":"CPF ou CNPJ consultado."},"totalPrevidenciario":{"type":["number","null"],"format":"currency","description":"Soma da natureza Tributário - Previdenciário (0.0 ou null quando há dívida sem inscrição desse grupo)."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/historico-fiscal-pj":{"get":{"summary":"Histórico Fiscal da Empresa","description":"Histórico da empresa inteira na dívida ativa da União desde 2020, trimestre a trimestre: o que deixou de constar, parcelamentos e rompimentos, ajuizamentos e a foto atual, com a data de cada publicação da PGFN.","operationId":"historico-fiscal-pj","tags":["Fiscal"],"parameters":[{"name":"cnpj","in":"query","required":true,"description":"CNPJ da empresa (matriz ou filial), com ou sem máscara. Aceita o CNPJ alfanumérico. A resposta cobre a empresa inteira (todos os estabelecimentos da mesma raiz).","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","required":["cnpj","cnpj_raiz","escopo","pgfn","fontes"],"properties":{"cnpj":{"type":["string","null"],"description":"CNPJ consultado, sem máscara (14 caracteres; pode ter letras nas 12 primeiras posições)."},"pgfn":{"type":"object","required":["indicadores","deixou_de_constar","parcelamentos","ajuizamentos","linha_do_tempo","eventos","eventos_total","eventos_truncados","atual"],"properties":{"atual":{"type":"object","required":["em_cobranca","negociada","garantida","suspensa_judicial"],"properties":{"outras":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."},"qtd_ajuizada":{"type":["integer","null"],"description":"Das inscrições, quantas têm execução fiscal."},"valor_ajuizado":{"type":["number","null"],"description":"Valor das inscrições com execução fiscal (R$)."}},"description":"Situação ainda não classificada (normalmente zero)."},"garantida":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":"integer","description":"Quantidade de inscrições."},"valor":{"type":"number","description":"Valor consolidado (R$)."},"qtd_ajuizada":{"type":["integer","null"],"description":"Das inscrições, quantas têm execução fiscal."},"valor_ajuizado":{"type":["number","null"],"description":"Valor das inscrições com execução fiscal (R$)."}},"description":"Garantida: seguro-garantia, carta-fiança, depósito ou penhora."},"negociada":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":"integer","description":"Quantidade de inscrições."},"valor":{"type":"number","description":"Valor consolidado (R$)."},"subflags":{"type":["object","null"],"properties":{"negociacao_bloqueada":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Negociação bloqueada."}},"description":"Detalhe informativo dentro da situação (não muda a classificação)."},"qtd_ajuizada":{"type":["integer","null"],"description":"Das inscrições, quantas têm execução fiscal."},"valor_ajuizado":{"type":["number","null"],"description":"Valor das inscrições com execução fiscal (R$)."}},"description":"Negociada: parcelamento ou transação com a PGFN (programas como SISPAR, REFIS, PAES, Leis 11.941 e 12.996)."},"em_cobranca":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":"integer","description":"Quantidade de inscrições."},"valor":{"type":"number","description":"Valor consolidado (R$)."},"subflags":{"type":["object","null"],"properties":{"protesto":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Com protesto."},"em_negociacao":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Negociação iniciada e ainda não consolidada."},"discussao_judicial":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Em discussão judicial sem suspensão formal."},"falencia_concordata":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Em falência ou concordata."},"parcelamento_rescindido":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."}},"description":"Voltou à cobrança por parcelamento rescindido."}},"description":"Detalhe informativo dentro da situação (não muda a classificação)."},"qtd_ajuizada":{"type":["integer","null"],"description":"Das inscrições, quantas têm execução fiscal."},"valor_ajuizado":{"type":["number","null"],"description":"Valor das inscrições com execução fiscal (R$)."}},"description":"Em cobrança: dívida exigível, sem negociação, garantia ou suspensão. É o que a lista pública de devedores da PGFN mostra."},"beneficio_fiscal":{"type":["object","null"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Valor consolidado (R$)."},"qtd_ajuizada":{"type":["integer","null"],"description":"Das inscrições, quantas têm execução fiscal."},"valor_ajuizado":{"type":["number","null"],"description":"Valor das inscrições com execução fiscal (R$)."}},"description":"Moratória prevista em lei (residual, ex.: PROSUS)."},"suspensa_judicial":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":"integer","description":"Quantidade de inscrições."},"valor":{"type":"number","description":"Valor consolidado (R$)."},"qtd_ajuizada":{"type":["integer","null"],"description":"Das inscrições, quantas têm execução fiscal."},"valor_ajuizado":{"type":["number","null"],"description":"Valor das inscrições com execução fiscal (R$)."}},"description":"Suspensa por decisão judicial."}},"description":"Foto ATUAL da dívida ativa da empresa, por situação: o mesmo objeto `pgfn.resumo` da consulta `situacao-fiscal-pj`, montado pela mesma regra."},"eventos":{"type":"array","items":{"type":"object","required":["safra","desde","evento","origem","cnpj","numero_inscricao","situacao_antes","situacao_depois","ajuizada_antes","ajuizada_depois","valor_anterior","data_inscricao"],"properties":{"cnpj":{"type":["string","null"],"description":"CNPJ (estabelecimento) em que a inscrição está."},"desde":{"type":["string","null"],"description":"Foto anterior comparada (AAAA-MM-DD): o evento ocorreu depois desta data e até `safra`."},"safra":{"type":["string","null"],"description":"Fim do trimestre da foto da PGFN em que o evento apareceu (AAAA-MM-DD)."},"evento":{"type":["string","null"],"description":"`deixou_de_constar`, `parcelou`, `rompeu_parcelamento`, `ajuizada`, `mudou_situacao` ou `renumerada`."},"origem":{"type":["string","null"],"description":"Tipo de dívida: `geral` (tributos e demais), `previdenciaria` ou `fgts`."},"ajuizada_antes":{"type":["boolean","null"],"description":"Se estava ajuizada (execução fiscal) na foto anterior."},"data_inscricao":{"type":["string","null"],"description":"Data de inscrição na dívida ativa (AAAA-MM-DD)."},"situacao_antes":{"type":["string","null"],"description":"Situação na foto anterior: `em_cobranca`, `negociada`, `garantida`, `suspensa_judicial` ou `outras`."},"valor_anterior":{"type":["number","null"],"description":"Último valor consolidado antes do evento, em R$ (com juros)."},"ajuizada_depois":{"type":["boolean","null"],"description":"Se está ajuizada na foto do trimestre; nulo quando deixou de constar."},"situacao_depois":{"type":["string","null"],"description":"Situação na foto do trimestre (`em_cobranca`, `negociada`, `garantida`, `suspensa_judicial` ou `outras`); nulo quando a inscrição deixou de constar."},"numero_inscricao":{"type":["string","null"],"description":"Número da inscrição na dívida ativa."}},"description":"Um evento de uma inscrição."},"description":"Até 50 eventos, do mais recente para o mais antigo. Os totais dos outros blocos são sempre completos."},"indicadores":{"type":"object","required":["ja_deveu","em_cobranca_hoje","deixou_de_constar","parcelou","rompeu_parcelamento","nova_inscricao_apos_saida"],"properties":{"ja_deveu":{"type":"boolean","description":"Tem inscrição hoje ou teve algum evento desde 02/2020."},"parcelou":{"type":"boolean","description":"Alguma inscrição passou de em cobrança para negociada (parcelamento ou transação)."},"em_cobranca_hoje":{"type":"boolean","description":"Tem inscrição em cobrança na foto atual."},"deixou_de_constar":{"type":"boolean","description":"Alguma inscrição deixou de constar (não quer dizer que foi paga)."},"rompeu_parcelamento":{"type":"boolean","description":"Alguma inscrição voltou de negociada para em cobrança."},"nova_inscricao_apos_saida":{"type":"boolean","description":"Tem inscrição (atual ou antiga) com data de inscrição depois do trimestre em que outra deixou de constar."}},"description":"Respostas diretas sobre a trajetória da empresa."},"ajuizamentos":{"type":"object","required":["inscricoes","ultima_em"],"properties":{"ultima_em":{"type":["string","null"],"description":"Fim do trimestre mais recente (AAAA-MM-DD)."},"inscricoes":{"type":["integer","null"],"description":"Quantidade de inscrições."}},"description":"Inscrições que passaram a ter execução fiscal."},"eventos_total":{"type":["integer","null"],"description":"Total de eventos da empresa no período."},"parcelamentos":{"type":"object","required":["entradas","rompimentos"],"properties":{"entradas":{"type":"object","required":["inscricoes","trimestres","ultima_em"],"properties":{"ultima_em":{"type":["string","null"],"description":"Fim do trimestre mais recente em que aconteceu (AAAA-MM-DD)."},"inscricoes":{"type":["integer","null"],"description":"Quantidade de inscrições distintas."},"trimestres":{"type":["integer","null"],"description":"Em quantos trimestres isso aconteceu (episódios)."}},"description":"Inscrições que passaram de em cobrança para negociada."},"rompimentos":{"type":"object","required":["inscricoes","trimestres","ultima_em"],"properties":{"ultima_em":{"type":["string","null"],"description":"Fim do trimestre mais recente em que aconteceu (AAAA-MM-DD)."},"inscricoes":{"type":["integer","null"],"description":"Quantidade de inscrições distintas."},"trimestres":{"type":["integer","null"],"description":"Em quantos trimestres isso aconteceu (episódios)."}},"description":"Inscrições que voltaram de negociada para em cobrança."}},"description":"Entradas e rompimentos de parcelamento na PGFN."},"linha_do_tempo":{"type":"array","items":{"type":"object","required":["safra","desde","deixou_de_constar","parcelou","rompeu_parcelamento","ajuizada","mudou_situacao"],"properties":{"desde":{"type":["string","null"],"description":"Foto anterior comparada (AAAA-MM-DD)."},"safra":{"type":["string","null"],"description":"Fim do trimestre (AAAA-MM-DD)."},"ajuizada":{"type":["integer","null"],"description":"Inscrições que passaram a ter execução fiscal."},"parcelou":{"type":["integer","null"],"description":"Inscrições que passaram de em cobrança para negociada."},"mudou_situacao":{"type":["integer","null"],"description":"Outras mudanças de situação."},"deixou_de_constar":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Soma do último valor consolidado de cada inscrição, em R$."}},"description":"Inscrições que deixaram de constar no trimestre."},"rompeu_parcelamento":{"type":["integer","null"],"description":"Inscrições que voltaram de negociada para em cobrança."}},"description":"Resumo de um trimestre com eventos."},"description":"Um item por trimestre com evento, do mais recente para o mais antigo."},"deixou_de_constar":{"type":"object","required":["inscricoes","valor_ultimo","trimestres","primeira_em","ultima_em","por_situacao_anterior","renumeradas"],"properties":{"ultima_em":{"type":["string","null"],"description":"Fim do trimestre mais recente com saída (AAAA-MM-DD)."},"inscricoes":{"type":["integer","null"],"description":"Quantidade de inscrições."},"trimestres":{"type":["integer","null"],"description":"Em quantos trimestres houve saída."},"primeira_em":{"type":["string","null"],"description":"Fim do primeiro trimestre com saída (AAAA-MM-DD)."},"renumeradas":{"type":["integer","null"],"description":"Saídas com provável renumeração ou desmembramento (outra inscrição do mesmo devedor, papel, data e receita entrou na mesma foto). Ficam fora das contagens acima."},"valor_ultimo":{"type":["number","null"],"description":"Soma do último valor de cada uma antes de sair, em R$."},"por_situacao_anterior":{"type":"object","required":["em_cobranca","negociada","garantida","suspensa_judicial"],"properties":{"garantida":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Soma do último valor consolidado de cada inscrição, em R$."}},"description":"Saíram de garantida."},"negociada":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Soma do último valor consolidado de cada inscrição, em R$."}},"description":"Saíram de negociada (fim de parcelamento ou transação)."},"em_cobranca":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Soma do último valor consolidado de cada inscrição, em R$."}},"description":"Saíram de em cobrança."},"suspensa_judicial":{"type":"object","required":["qtd","valor"],"properties":{"qtd":{"type":["integer","null"],"description":"Quantidade de inscrições."},"valor":{"type":["number","null"],"description":"Soma do último valor consolidado de cada inscrição, em R$."}},"description":"Saíram de suspensa por decisão judicial."}},"description":"Saídas pela situação em que a inscrição estava antes de sair. Cada inscrição conta uma vez, na situação da saída mais recente: a soma nunca passa de inscricoes."}},"description":"Inscrições que deixaram de constar na dívida ativa (sem as renumeradas)."},"eventos_truncados":{"type":["boolean","null"],"description":"`true` quando há mais eventos do que os listados."}},"description":"Dívida ativa da União: histórico e foto atual."},"escopo":{"type":["string","null"],"description":"Sempre `raiz`."},"fontes":{"type":"object","required":["pgfn","pgfn_historico"],"properties":{"pgfn":{"type":"object","required":["referencia","atualizado_em"],"properties":{"referencia":{"type":["string","null"],"description":"Trimestre da publicação da PGFN."},"atualizado_em":{"type":["string","null"],"description":"Data em que a publicação foi incorporada (AAAA-MM-DD)."}},"description":"Foto atual da PGFN."},"pgfn_historico":{"type":"object","required":["referencia","desde","fotos","atualizado_em"],"properties":{"desde":{"type":["string","null"],"description":"Primeira foto do histórico (AAAA-MM-DD)."},"fotos":{"type":["integer","null"],"description":"Quantidade de fotos trimestrais comparadas."},"referencia":{"type":["string","null"],"description":"Fim do trimestre mais recente do histórico (AAAA-MM-DD)."},"atualizado_em":{"type":["string","null"],"description":"Data em que o trimestre mais recente foi incorporado (AAAA-MM-DD)."}},"description":"Histórico trimestral."}},"description":"De quando é cada dado."},"cnpj_raiz":{"type":["string","null"],"description":"Raiz do CNPJ (8 primeiras posições). O histórico cobre a empresa inteira: matriz e filiais com esta raiz."}},"description":"Histórico da dívida ativa da União da empresa inteira (raiz do CNPJ), trimestre a trimestre desde 02/2020, a partir das fotos públicas da Procuradoria-Geral da Fazenda Nacio