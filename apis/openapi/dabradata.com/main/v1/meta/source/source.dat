."},"consta":{"type":["boolean","null"],"format":"bool","description":"Indica se consta algum registro para o documento consultado."},"nomeMae":{"type":["string","null"],"description":"Nome da mãe da pessoa física."},"mensagem":{"type":["string","null"],"description":"Mensagem do resultado da consulta."},"parametros":{"type":["object","null"],"description":"Parâmetros informados na consulta."},"dataNascimento":{"type":["string","null"],"description":"Data de nascimento da pessoa física."}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"cpf":"string","pis":"string","nome":"string","nomeMae":"string","dataNascimento":"string"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/fgts-regularidade":{"get":{"summary":"FGTS - Regularidade do Empregador","description":"Consulta a regularidade de empregadores perante o FGTS, condição obrigatória para relacionamento com órgãos públicos e instituições de crédito. Fornece informações e emissão do Certificado de Regulari","operationId":"fgts-regularidade","tags":["Trabalhista"],"parameters":[{"name":"cnpj","in":"query","required":true,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"comprovante","in":"query","required":false,"de