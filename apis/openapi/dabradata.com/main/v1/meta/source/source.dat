":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":["string","null"],"description":"Mensagem descritiva sobre o resultado da consulta."},"processos":{"type":["array","null"],"items":{"type":"object","properties":{"tipo":{"type":["string","null"],"description":"Classificação ou tipo de processo."},"assunto":{"type":["string","null"],"description":"Assunto ou tema central do processo."},"qualificacao":{"type":["string","null"],"description":"Qualificação ou cargo do indivíduo no contexto do processo."},"estadoProcesso":{"type":["string","null"],"description":"Estado ou status atual do processo."},"numeroProcesso":{"type":["string","null"],"description":"Número identificador único do processo."}}},"description":"Lista de processos encontrados para o documento consultado."},"dataEmissao":{"type":["string","null"],"description":"Data e hora de emissão da certidão."},"dataValidade":{"type":["string","null"],"description":"Data e hora de expiração da validade da certidão."},"nomeEntidade":{"type":["string","null"],"description":"Nome da entidade ou razão social consultada."},"codigoCertidao":{"type":["string","null"],"description":"Código identificador único da certidão emitida."},"possuiProcesso":{"type":["boolean","null"],"description":"Indicador se a entidade possui processos registrados."},"documentoConsultado":{"type":["string","null"],"description":"Documento (CPF ou CNPJ) utilizado na consulta."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/tcu-consolidada":{"get":{"summary":"TCU - Consulta Consolidada PJ","description":"Consulta consolidada da situação cadastral e histórico de sanções de pessoas jurídicas em múltiplos registros públicos. Ideal para compliance, análise de crédito e qualificação de fornecedores.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"tcu-consolidada","tags":["Tribunais"],"parameters":[{"name":"cnpj","in":"query","required":true,"description":"CNPJ (14 dígitos) da pessoa jurídica a consultar, com ou sem formatação.","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"uf":{"type":["string","null"],"description":"Unidade Federativa (estado) referente ao registro."},"cnpj":{"type":["string","null"],"description":"CNPJ da empresa."},"consta":{"type":["boolean","null"],"format":"bool","description":"Indica se consta algum registro para o documento consultado."},"mensagem":{"type":["string","null"],"description":"Mensagem do resultado da consulta."},"certidoes":{"type":["array","null"],"items":{"type":"object","properties":{"tipo":{"type":["string","null"],"description":"Tipo do registro."},"status":{"type":["string","null"],"description":"Detalhes sobre o status do registro."},"emissor":{"type":["string","null"],"description":"Emissor da certidão."},"descricao":{"type":["string","null"],"description":"Descrição do registro."},"dataEmissao":{"type":["string","null"],"description":"Data da emissão da certidão."},"possuiSancao":{"type":["boolean","null"],"description":"Indica se a entidade possui sanção nesta certidão."}}},"description":"Lista de certidões disponíveis para o registro."},"parametros":{"type":["object","null"],"description":"Parâmetros informados na consulta."},"razaoSocial":{"type":["string","null"],"description":"Razão social da empresa."},"nomeFantasia":{"type":["string","null"],"description":"Nome fantasia da empresa."},"constamSancoes":{"type":["boolean","null"],"format":"bool","description":"Indica se a entidade possui sanções."}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"uf":null,"cnpj":"***","certidoes":[{"tipo":"Inidôneos","status":"A entidade não possui sanções.","emissor":"TCU","descricao":"Licitantes Inidôneos","dataEmissao":"17/03/2026 00:00:00","possuiSancao":false},{"tipo":"CNIA","status":"A entidade não possui sanções.","emissor":"CNJ","descricao":"CNIA - Cadastro Nacional de Condenações Cíveis por Ato de Improbidade Administrativa e Inelegibilidade","dataEmissao":"17/03/2026 00:00:00","possuiSancao":false},{"tipo":"CEIS","status":"A entidade não possui sanções.","emissor":"Portal da Transparência","descricao":"Cadastro Nacional de Empresas Inidôneas e Suspensas","dataEmissao":"17/03/2026 00:00:00","possuiSancao":false},{"tipo":"CNEP","status":"A entidade não possui sanções.","emissor":"Portal da Transparência","descricao":"CNEP - Cadastro Nacional de Empresas Punidas","dataEmissao":"17/03/2026 00:00:00","possuiSancao":false}],"razaoSocial":"***","nomeFantasia":null,"constamSancoes":false}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/tcu-licitante":{"get":{"summary":"TCU - Licitante Inidôneo","description":"Verifica se uma pessoa ou empresa foi declarada inidônea pelo TCU, confirmando sua elegibilidade para participar de processos licitatórios.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.","operationId":"tcu-licitante","tags":["Tribunais"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"status":{"type":["string","null"],"description":"Status da consulta informando a situação de sanções da entidade."},"dataEmissao":{"type":["string","null"],"description":"Data e hora de emissão da certidão."},"dataValidade":{"type":["string","null"],"description":"Data e hora de validade da certidão."},"nomeEntidade":{"type":["string","null"],"description":"Nome da entidade ou razão social consultada."},"possuiSancao":{"type":["boolean","null"],"format":"bool","description":"Indica se a entidade possui sanções."},"codigoValidacao":{"type":["string","null"],"description":"Código de validação da certidão."},"documentoConsultado":{"type":["string","null"],"description":"CPF ou CNPJ consultado."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/trt-consulta":{"get":{"summary":"Tribunal Regional do Trabalho (TRT)","description":"Certidão de ações trabalhistas no Tribunal Regional do Trabalho. Informe o CNPJ e a região é identificada automaticamente pela sede da empresa. Útil para due diligence trabalhista, análise de risco e compliance.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.","operationId":"trt-consulta","tags":["Tribunais"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF da pessoa a consultar. Aceita com ou sem pontuação. Exige o parâmetro `regiao`.","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ da empresa a consultar. Aceita com ou sem pontuação. Dispensa `regiao`: a região é identificada pela sede.","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"regiao","in":"query","required":false,"description":"Região do TRT (1 a 24). Opcional para CNPJ (derivada da sede) e obrigatória para CPF.","schema":{"type":"string","pattern":"^(0?[1-9]|1[0-9]|2[0-4])$"}},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome da pessoa ou empresa consultada."},"regiao":{"type":["string","null"],"description":"Região do tribunal onde foi realizada a consulta."},"status":{"type":["string","null"],"description":"Status da certidão indicando presença ou ausência de processos."},"documento":{"type":["string","null"],"description":"Documento CPF ou CNPJ consultado."},"processos":{"type":["array","null"],"items":{"type":"object","properties":{"local":{"type":["string","null"],"description":"Local onde o processo está registrado."},"processo":{"type":["array","null"],"items":{"type":["string","null"]},"description":"Números ou identificadores dos processos."}}},"description":"Lista de processos encontrados contra o documento."},"dataEmissao":{"type":["string","null"],"description":"Data e hora da emissão da certidão."},"dataValidade":{"type":["string","null"],"description":"Data e hora de validade da certidão."},"numeroCertidao":{"type":["string","null"],"description":"Número identificador único da certidão."},"possuiProcesso":{"type":["boolean","null"],"description":"Indica se existem processos tramitando contra o documento."},"codigoAutenticidade":{"type":["string","null"],"description":"Código de autenticidade da certidão."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/cep":{"get":{"summary":"Pesquisa de CEP","description":"Valide endereços por CEP. Retorna os dados de endereço correspondentes ao CEP informado, incluindo o código IBGE do município (usado por prefeituras no processo de emissão de notas fiscais).","operationId":"cep","tags":["Utilidades"],"parameters":[{"name":"cep","in":"query","required":true,"description":"CEP a ser consultado, com 8 dígitos numéricos.","schema":{"type":"string"}}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object"},"example":{"uf":"string","cep":"string","city":"string","city_ibge":"string","neighborhood":"string","street_address":"string"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/habilitacao-cnh-completa":{"get":{"summary":"CNH Completa","description":"Confira se a habilitação de um motorista está em dia, só com o CPF: categoria, validade, exame toxicológico, observações, cursos especializados e bloqueios, com os dados do condutor.","operationId":"habilitacao-cnh-completa","tags":["Veicular"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF do condutor, só números (11 dígitos).","schema":{"type":"string","format":"cpf","pattern":"^[0-9]{11}$"}}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"cursos":{"type":["array","null"],"items":{"type":"object","properties":{"uf":{"type":["string","null"],"description":"UF onde o curso foi realizado."},"nome":{"type":["string","null"],"description":"Nome do curso."},"dataFim":{"type":["string","null"],"description":"Fim do curso (DD/MM/AAAA)."},"categoria":{"type":["string","null"],"description":"Categoria do curso."},"dataInicio":{"type":["string","null"],"description":"Início do curso (DD/MM/AAAA)."},"modalidade":{"type":["string","null"],"description":"Modalidade do curso."},"dataValidade":{"type":["string","null"],"description":"Validade do curso (DD/MM/AAAA)."},"cidadeRealizacao":{"type":["string","null"],"description":"Cidade onde o curso foi realizado."}}},"description":"Cursos especializados registrados (ex.: transporte coletivo de passageiros). Lista vazia quando não há."},"exames":{"type":["array","null"],"items":{"type":"object","properties":{"data":{"type":["string","null"],"description":"Data do exame (DD/MM/AAAA)."},"nome":{"type":["string","null"],"description":"Nome do exame."},"validade":{"type":["string","null"],"description":"Validade do exame (DD/MM/AAAA)."},"resultado":{"type":["string","null"],"description":"Resultado do exame."},"categoriaPermitida":{"type":["string","null"],"description":"Categoria permitida pelo exame."},"categoriaPretendida":{"type":["string","null"],"description":"Categoria pretendida no exame."}}},"description":"Exames registrados na habilitação. Lista vazia quando não há."},"condutor":{"type":["object","null"],"properties":{"rg":{"type":["string","null"],"description":"Número do RG."},"cpf":{"type":["string","null"],"description":"CPF do condutor, formatado (000.000.000-00)."},"nome":{"type":["string","null"],"description":"Nome completo do condutor."},"rgUf":{"type":["string","null"],"description":"UF de emissão do RG."},"email":{"type":["string","null"],"description":"E-mail do condutor, quando a fonte informa."},"nomeMae":{"type":["string","null"],"description":"Nome da mãe."},"nomePai":{"type":["string","null"],"description":"Nome do pai, quando informado."},"endereco":{"type":["string","null"],"description":"Endereço do condutor, quando a fonte informa."},"telefone":{"type":["string","null"],"description":"Telefone do condutor, quando a fonte informa (só números, com DDI e DDD)."},"dataNascimento":{"type":["string","null"],"description":"Data de nascimento (DD/MM/AAAA)."},"rgOrgaoEmissor":{"type":["string","null"],"description":"Órgão emissor do RG."}},"description":"Dados do condutor."},"bloqueios":{"type":["array","null"],"items":{"type":"object","properties":{"uf":{"type":["string","null"],"description":"UF do registro do bloqueio."},"data":{"type":["string","null"],"description":"Data do registro (DD/MM/AAAA)."},"descricao":{"type":["string","null"],"description":"Descrição do bloqueio ou penalidade."},"diasPenalidade":{"type":["string","null"],"description":"Quantidade de dias da penalidade, quando informada."},"dataFimPenalidade":{"type":["string","null"],"description":"Fim da penalidade (DD/MM/AAAA)."},"dataInicioPenalidade":{"type":["string","null"],"description":"Início da penalidade (DD/MM/AAAA)."}}},"description":"Bloqueios e penalidades registrados na habilitação. Lista vazia quando não há."},"habilitacao":{"type":["object","null"],"properties":{"renach":{"type":["string","null"],"description":"Número do RENACH (Registro Nacional de Carteira de Habilitação)."},"categoria":{"type":["string","null"],"description":"Categoria da habilitação (ex.: B, AB, AD)."},"numeroCnh":{"type":["string","null"],"description":"Número da CNH (espelho do documento)."},"dataEmissao":{"type":["string","null"],"description":"Data de emissão da CNH atual (DD/MM/AAAA)."},"observacoes":{"type":["string","null"],"description":"Observações impressas na CNH, como a fonte as informa, em códigos (ex.: \"EAR, A\"; EAR = exerce atividade remunerada)."},"dataValidade":{"type":["string","null"],"description":"Data de validade da CNH atual (DD/MM/AAAA)."},"numeroRegistro":{"type":["string","null"],"description":"Número de registro da CNH."},"dataPrimeiraHabilitacao":{"type":["string","null"],"description":"Data da primeira habilitação (DD/MM/AAAA)."}},"description":"Dados da habilitação."},"temBloqueio":{"type":["boolean","null"],"description":"`true` quando há ao menos um bloqueio registrado na habilitação; `false` quando não há."},"exameToxicologico":{"type":["object","null"],"properties":{"situacao":{"type":["string","null"],"description":"Situação do exame toxicológico, como informada (ex.: \"Exame Toxicológico OK\", \"Não se aplica à categoria da sua CNH\")."},"dataColeta":{"type":["string","null"],"description":"Data da coleta do exame, quando informada (DD/MM/AAAA)."},"dataVencimento":{"type":["string","null"],"description":"Data de vencimento do exame, quando informada (DD/MM/AAAA)."}},"description":"Situação do exame toxicológico."}}},"example":{"cursos":[{"uf":null,"nome":"Curso Especializado de Transporte Coletivo de Passageiros","dataFim":null,"categoria":null,"dataInicio":null,"modalidade":null,"dataValidade":null,"cidadeRealizacao":null}],"exames":[],"condutor":{"rg":"12345678","cpf":"111.111.111-11","nome":"FULANO DE TAL","rgUf":"SP","email":null,"nomeMae":"MAE DE FULANO","nomePai":"PAI DE FULANO","endereco":null,"telefone":null,"dataNascimento":"05/12/1988","rgOrgaoEmissor":"SSP"},"bloqueios":[],"habilitacao":{"renach":"SP012345678","categoria":"AD","numeroCnh":"22222222222","dataEmissao":"25/03/2024","observacoes":"EAR, A","dataValidade":"12/03/2034","numeroRegistro":"09876543210","dataPrimeiraHabilitacao":"26/02/2010"},"temBloqueio":false,"exameToxicologico":{"situacao":"Exame Toxicológico OK","dataColeta":null,"dataVencimento":"08/03/2029"}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/habilitacao-cnh-plus":{"get":{"summary":"CNH Plus","description":"Os dados da CNH e do condutor, só com o CPF: categoria, validade, emissão, primeira habilitação, RENACH, filiação e RG.","operationId":"habilitacao-cnh-plus","tags":["Veicular"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF do condutor, só números (11 dígitos).","schema":{"type":"string","format":"cpf","pattern":"^[0-9]{11}$"}}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"condutor":{"type":["object","null"],"properties":{"rg":{"type":["string","null"],"description":"Número do RG."},"cpf":{"type":["string","null"],"description":"CPF do condutor, formatado (000.000.000-00)."},"nome":{"type":["string","null"],"description":"Nome completo do condutor."},"rgUf":{"type":["string","null"],"description":"UF de emissão do RG."},"nomeMae":{"type":["string","null"],"description":"Nome da mãe."},"nomePai":{"type":["string","null"],"description":"Nome do pai, quando informado."},"dataNascimento":{"type":["string","null"],"description":"Data de nascimento (DD/MM/AAAA)."},"rgOrgaoEmissor":{"type":["string","null"],"description":"Órgão emissor do RG."}},"description":"Dados do condutor."},"habilitacao":{"type":["object","null"],"properties":{"renach":{"type":["string","null"],"description":"Número do RENACH (Registro Nacional de Carteira de Habilitação)."},"categoria":{"type":["string","null"],"description":"Categoria da habilitação (ex.: B, AB, AD)."},"numeroCnh":{"type":["string","null"],"description":"Número da CNH (espelho do documento)."},"dataEmissao":{"type":["string","null"],"description":"Data de emissão da CNH atual (DD/MM/AAAA)."},"dataValidade":{"type":["string","null"],"description":"Data de validade da CNH atual (DD/MM/AAAA)."},"numeroRegistro":{"type":["string","null"],"description":"Número de registro da CNH."},"dataPrimeiraHabilitacao":{"type":["string","null"],"description":"Data da primeira habilitação (DD/MM/AAAA)."}},"description":"Dados da habilitação."}}},"example":{"condutor":{"rg":"12345678","cpf":"111.111.111-11","nome":"FULANO DE TAL","rgUf":"SP","nomeMae":"MAE DE FULANO","nomePai":"PAI DE FULANO","dataNascimento":"05/12/1988","rgOrgaoEmissor":"SSP"},"habilitacao":{"renach":"SP012345678","categoria":"AD","numeroCnh":"22222222222","dataEmissao":"25/03/2024","dataValidade":"12/03/2034","numeroRegistro":"09876543210","dataPrimeiraHabilitacao":"26/02/2010"}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/consulta-veicular":{"get":{"summary":"Consulta Veicular","description":"Consulta informações completas de um veículo pela placa, retornando marca, modelo, ano de fabricação e cor. Inclui dados do proprietário e valor de mercado atualizado.","operationId":"consulta-veicular","tags":["Veicular"],"parameters":[{"name":"placa","in":"query","required":true,"description":"Placa do veiculo, com ou sem hifen. Aceita o formato antigo (ABC1234) e o Mercosul (ABC1D23).","schema":{"type":"string"},"example":"ABC1D23"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"veiculo":{"type":["object","null"],"properties":{"uf":{"type":["string","null"],"description":"Unidade Federativa do registro."},"cor":{"type":["string","null"],"description":"Cor do veículo."},"fipe":{"type":["object","null"],"properties":{"valor":{"type":["string","null"],"description":"Valor de mercado do veiculo segundo a Tabela Fipe, formatado em reais (ex.: 'R$ 23.241,00'). Null quando nao ha valor Fipe disponivel para o modelo — ver `status`."},"status":{"type":["string","null"],"description":"Frase explicando o desfecho da avaliacao Fipe — em especial POR QUE o valor veio nulo: tipo de veiculo que a Fipe nao tabela (reboque/semirreboque), ano indisponivel para o modelo, motorizacao sem correspondencia, ou versao nao identificavel com seguranca. Null quando a avaliacao nao pode ser executada."},"anoModelo":{"type":["integer","null"],"description":"Ano-modelo do veiculo que foi precificado (ex.: 2023). E a chave que a Fipe usa para precificar — ela tabela por ano MODELO, nunca por ano de fabricacao. Confira contra `veiculo.anoModelo` (mesmo ano, ali como string): divergencia significa que precificamos o veiculo errado. Um 2022/2023 (fabricado em 2022, modelo 2023) tem `veiculo.anoFabricacao` = '2022' e este campo = 2023, e isso esta correto."},"marcaFipe":{"type":["string","null"],"description":"Marca na nomenclatura da Fipe (ex.: 'Citroen'), que pode diferir da grafia do DENATRAN em `veiculo.marca`."},"codigoFipe":{"type":["string","null"],"description":"Codigo Fipe do modelo, no formato oficial 'NNNNNN-N' (ex.: '011072-8'). Permite reconferir o preco na fonte oficial e acompanhar o mesmo modelo mes a mes."},"modeloFipe":{"type":["string","null"],"description":"Nome completo que a Fipe da a versao precificada (ex.: 'C3 GLX 1.4/ GLX Sonora 1.4 Flex 8V 5p'). Existe para auditoria: e com ele que se confere que o preco e da versao do veiculo consultado, e nao de uma parente."},"combustivel":{"type":["string","null"],"description":"Combustivel da versao precificada, como a Fipe o nomeia (ex.: 'Flex', 'Gasolina', 'Diesel'). Difere de `veiculo.combustivel`, que vem do DENATRAN com outra nomenclatura ('ALCOOL/GASOLINA'): sao a MESMA informacao em dois vocabularios, e e o desta chave que corresponde a versao cujo preco esta em `valor`."},"mesReferencia":{"type":["string","null"],"description":"Mes/ano da TABELA DE REFERENCIA Fipe consultada, no formato 'MM/AAAA' (ex.: '07/2026'). Descreve a TABELA DE PRECOS, nao o veiculo — o ano do veiculo esta em `anoModelo`. E sempre a tabela do mes corrente."},"valorNumerico":{"type":["number","null"],"description":"O mesmo valor em numero, para calculo direto sem parse (ex.: 23241.0). Null sempre que `valor` for null."}},"description":"Valor de referencia da Tabela Fipe para o veiculo identificado, da tabela do MES CORRENTE. Quando nao ha valor seguro para o modelo, os campos vem nulos e `status` explica o motivo — a consulta veicular continua respondendo normalmente."},"tipo":{"type":["string","null"],"description":"Tipo de veículo."},"marca":{"type":["string","null"],"description":"Marca do veículo."},"placa":{"type":["string","null"],"description":"Placa do veículo."},"chassi":{"type":["string","null"],"description":"Número do chassi."},"modelo":{"type":["string","null"],"description":"Modelo do veículo."},"especie":{"type":["string","null"],"description":"Espécie do veículo."},"renavam":{"type":["string","null"],"description":"Número RENAVAM."},"faturado":{"type":["object","null"],"properties":{"tipo":{"type":["string","null"],"description":"Tipo de faturamento."},"documento":{"type":["string","null"],"description":"Documento relacionado ao faturamento."}},"description":"Informações de faturamento do veículo."},"potencia":{"type":["number","null"],"description":"Potência do motor em cavalos-vapor."},"anoModelo":{"type":["string","null"],"description":"Ano do modelo do veículo."},"categoria":{"type":["string","null"],"description":"Categoria do veículo."},"municipio":{"type":["string","null"],"description":"Município de registro."},"cilindrada":{"type":["string","null"],"description":"Cilindrada do motor em cc."},"importacao":{"type":["object","null"],"properties":{"data":{"type":["string","null"],"description":"Data da importação."},"numeroDeclaracao":{"type":["string","null"],"description":"Número da declaração de importação."}},"description":"Informações de importação do veículo. Pode vir nulo mesmo com o restante da ficha preenchido, quando a fonte consultada não disponibiliza este dado pontualmente — nulo não deve ser lido como confirmação de ausência."},"restricoes":{"type":["array","null"],"items":{"type":["string","null"]},"description":"Lista de restrições do veículo. Pode vir nulo mesmo com o restante da ficha preenchido, quando a fonte consultada não disponibiliza este dado pontualmente — nulo não deve ser lido como confirmação de ausência."},"combustivel":{"type":["string","null"],"description":"Tipo de combustível utilizado."},"indicadores":{"type":["object","null"],"properties":{"rfb":{"type":["boolean","null"],"description":"Restrição junto à Receita Federal do Brasil."},"alarme":{"type":["boolean","null"],"description":"Presença de alarme registrado."},"leilao":{"type":["boolean","null"],"description":"Veículo participou ou participa de leilão."},"recall":{"type":["boolean","null"],"description":"Recall registrado pelo fabricante."},"siniav":{"type":["boolean","null"],"description":"Registro no sistema de sinistros."},"renainf":{"type":["boolean","null"],"description":"Infrações registradas no RENAINF."},"renajud":{"type":["boolean","null"],"description":"Restrição judicial no RENAJUD."},"rouboFurto":{"type":["boolean","null"],"description":"Ocorrência de roubo ou furto registrada."},"comunicadoVenda":{"type":["boolean","null"],"description":"Comunicado de venda registrado."},"pendenciaEmissao":{"type":["boolean","null"],"description":"Pendência de emissão de documento."}},"description":"Indicadores e flags de situações especiais do veículo. Pode vir nulo mesmo com o restante da ficha preenchido, quando a fonte consultada não disponibiliza este dado pontualmente — nulo não deve ser lido como confirmação de ausência."},"numeroEixos":{"type":["string","null"],"description":"Número de eixos do veículo."},"numeroMotor":{"type":["string","null"],"description":"Número de série do motor."},"numeroCambio":{"type":["string","null"],"description":"Número de série do câmbio."},"anoFabricacao":{"type":["string","null"],"description":"Ano de fabricação do veículo."},"dataEmissaoCrv":{"type":["string","null"],"description":"Data de emissão do Certificado de Registro de Veículo."},"pesoBrutoTotal":{"type":["string","null"],"description":"Peso bruto total em toneladas."},"tipoCarroceria":{"type":["string","null"],"description":"Tipo de carroceria."},"capacidaDeCarga":{"type":["string","null"],"description":"Capacidade de carga especificada."},"dataEmissaoCrlv":{"type":["string","null"],"description":"Data de emissão do Certificado de Registro e Licenciamento de Veículo. Pode vir nulo mesmo com o restante da ficha preenchido, quando a fonte consultada não disponibiliza este dado pontualmente — nulo não deve ser lido como confirmação de ausência."},"situacaoVeiculo":{"type":["string","null"],"description":"Situação atual do veículo."},"numeroCarroceria":{"type":["string","null"],"description":"Número de série da carroceria."},"numeroEixoTraseiro":{"type":["string","null"],"description":"Número do eixo traseiro."},"procedenciaVeiculo":{"type":["string","null"],"description":"Procedência do veículo."},"numeroDoEixoAuxiliar":{"type":["string","null"],"description":"Número do eixo auxiliar se aplicável."},"capacidadeMaximaCarga":{"type":["string","null"],"description":"Capacidade máxima de carga em toneladas. Pode vir nulo mesmo com o restante da ficha preenchido, quando a fonte consultada não disponibiliza este dado pontualmente — nulo não deve ser lido como confirmação de ausência."},"capacidadeMaximaTracao":{"type":["string","null"],"description":"Capacidade máxima de tração em toneladas."},"capacidadedePassageiros":{"type":["string","null"],"description":"Capacidade máxima de passageiros."},"descricaoRemarcacaoChassi":{"type":["string","null"],"description":"Descrição detalhada da remarcação de chassi. Pode vir nulo mesmo com o restante da ficha preenchido, quando a fonte consultada não disponibiliza este dado pontualmente — nulo não deve ser lido como confirmação de ausência."},"indicadorRemarcacaoChassi":{"type":["boolean","null"],"description":"Indicador de remarcação de chassi. Pode vir nulo mesmo com o restante da ficha preenchido, quando a fonte consultada não disponibiliza este dado pontualmente — nulo não deve ser lido como confirmação de ausência."}},"description":"Dados do veículo consultado."},"documento":{"type":["string","null"],"description":"Documento do proprietário (CPF ou CNPJ)."},"anoExercicio":{"type":["string","null"],"description":"Ano de exercício da consulta."},"proprietario":{"type":["string","null"],"description":"Nome do proprietário do veículo."}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/frotas-nacional":{"get":{"summary":"Consulta Veicular — Frotas Nacional","description":"Lista os veículos vinculados a um CPF ou CNPJ em todo o território nacional: placa, marca/modelo, cor, ano, UF, chassi e RENAVAM. Para verificação patrimonial, análise de crédito e gestão de frotas.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.","operationId":"frotas-nacional","tags":["Veicular"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF do proprietário, com ou sem máscara. Informe `cpf` OU `cnpj`.","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ do proprietário, com ou sem máscara. Informe `cpf` OU `cnpj`.","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"veiculos":{"type":["array","null"],"items":{"type":"object","properties":{"uf":{"type":["string","null"],"description":"UF de registro do veículo."},"cor":{"type":["string","null"],"description":"Cor predominante do veículo."},"motor":{"type":["string","null"],"description":"Número do motor. Frequentemente vazio na fonte."},"placa":{"type":["string","null"],"description":"Placa do veículo."},"chassi":{"type":["string","null"],"description":"Número do chassi."},"renavam":{"type":["string","null"],"description":"Número do RENAVAM."},"anoModelo":{"type":["string","null"],"description":"Ano do modelo."},"marcaModelo":{"type":["string","null"],"description":"Marca e modelo do veículo (ex.: `VW/GOL 1.0`)."},"tipoVeiculo":{"type":["string","null"],"description":"Tipo do veículo (automóvel, motocicleta, caminhão…). Frequentemente vazio na fonte."},"anoFabricacao":{"type":["string","null"],"description":"Ano de fabricação."}}},"description":"Veículos vinculados ao documento, em todo o território nacional. No máximo 20 itens por consulta."},"documento":{"type":["string","null"],"description":"CPF ou CNPJ consultado, com máscara."},"proprietario":{"type":["string","null"],"description":"Nome ou razão social do proprietário dos veículos."},"quantidadeVeiculos":{"type":["integer","null"],"description":"Total de veículos que a fonte encontrou para o documento. ATENÇÃO: pode ser MAIOR que o número de itens em `veiculos[]` — a fonte devolve no máximo 20 registros por consulta."}}},"example":{"veiculos":[{"uf":"SP","cor":"PRATA","motor":null,"placa":"ABC-1D23","chassi":"9BWZZZ00000000000","renavam":"000000000","anoModelo":"2019","marcaModelo":"VW/GOL 1.0","tipoVeiculo":null,"anoFabricacao":"2018"},{"uf":"MG","cor":"VERMELHA","motor":null,"placa":"XYZ-4A56","chassi":"9C2ZZZ00000000000","renavam":"111111111","anoModelo":"2021","marcaModelo":"HONDA/CG 160 TITAN","tipoVeiculo":null,"anoFabricacao":"2021"}],"documento":"111.111.111-11","proprietario":"NOME DO PROPRIETARIO EXEMPLO","quantidadeVeiculos":2}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/gravame-veicular":{"post":{"summary":"Gravame Veicular","description":"Consulta de gravame/alienação fiduciária por placa: informa se há restrição financeira sobre o veículo, o agente financeiro (credor), a data e os dados do contrato.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"gravame-veicular","tags":["Veicular"],"parameters":[{"name":"placa","in":"query","required":true,"description":"Placa do veículo, sem hífen — formato antigo (ABC1234) ou Mercosul (ABC1D34).","schema":{"type":"string","format":"upper","pattern":"^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$"},"example":"ABC1D23"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","required":["veiculo","temGravame","situacao","situacaoDescricao","agenteFinanceiro","restricao","contrato"],"properties":{"veiculo":{"type":"object","properties":{"placa":{"type":["string","null"]},"chassi":{"type":["string","null"]},"marcaModelo":{"type":["string","null"]}},"additionalProperties":false},"contrato":{"type":["object","null"],"properties":{"uf":{"type":["string","null"]},"data":{"type":["string","null"]},"numero":{"type":["string","null"]}},"additionalProperties":false},"gravames":{"type":"array","items":{"type":"object","properties":{"contrato":{"type":["object","null"],"properties":{"uf":{"type":["string","null"]},"data":{"type":["string","null"]},"numero":{"type":["string","null"]}},"additionalProperties":false},"situacao":{"enum":["ATIVO","BAIXADO","CANCELADO","INDETERMINADO"],"type":"string"},"restricao":{"type":["object","null"],"properties":{"uf":{"type":["string","null"]},"data":{"type":["string","null"]},"numero":{"type":["string","null"]}},"additionalProperties":false},"codigoSituacao":{"type":["string","null"]},"agenteFinanceiro":{"type":["object","null"],"properties":{"nome":{"type":["string","null"]},"codigo":{"type":["string","null"]},"documento":{"type":["string","null"]}},"additionalProperties":false},"situacaoDescricao":{"type":["string","null"]}},"additionalProperties":false}},"situacao":{"enum":["ATIVO","BAIXADO","CANCELADO","SEM_GRAVAME","INDETERMINADO"],"type":"string"},"restricao":{"type":["object","null"],"properties":{"uf":{"type":["string","null"]},"data":{"type":["string","null"]},"numero":{"type":["string","null"]}},"additionalProperties":false},"temGravame":{"type":"boolean"},"agenteFinanceiro":{"type":["object","null"],"properties":{"nome":{"type":["string","null"]},"codigo":{"type":["string","null"]},"documento":{"type":["string","null"]}},"additionalProperties":false},"situacaoDescricao":{"type":["string","null"]}},"additionalProperties":false},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"veiculo":{"placa":"ABC1D23","chassi":"9BWZZZ00000000000","marcaModelo":"MARCA/MODELO EXEMPLO"},"contrato":{"uf":"SP","data":"15/12/2023","numero":"87654321"},"gravames":[{"contrato":{"uf":"SP","data":"15/12/2023","numero":"87654321"},"situacao":"ATIVO","restricao":{"uf":"SP","data":"01/01/2024","numero":"12345678"},"codigoSituacao":null,"agenteFinanceiro":{"nome":"BANCO EXEMPLO S.A.","codigo":"0001","documento":"11111111000111"},"situacaoDescricao":"COM ALIENACAO FIDUCIARIA DOC. EMITIDO"}],"situacao":"ATIVO","restricao":{"uf":"SP","data":"01/01/2024","numero":"12345678"},"temGravame":true,"agenteFinanceiro":{"nome":"BANCO EXEMPLO S.A.","codigo":"0001","documento":"11111111000111"},"situacaoDescricao":"COM ALIENACAO FIDUCIARIA DOC. EMITIDO"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/habilitacao-cnh":{"get":{"summary":"Habilitação (CNH)","description":"Consulta a situação da habilitação de um condutor a partir do CPF, retornando o número da CNH, a UF emissora, a data da primeira habilitação e se o condutor está na fase de Permissão Para Dirigir (PPD). Útil para validar se uma pessoa possui carteira de motorista ativa e há quanto tempo dirige.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"habilitacao-cnh","tags":["Veicular"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"uf":{"type":["string","null"],"description":"Unidade da federação (Detran) que emitiu a CNH."},"cnh":{"type":["string","null"],"description":"Número de registro da Carteira Nacional de Habilitação."},"cpf":{"type":["string","null"],"description":"CPF vinculado à habilitação consultada."},"nome":{"type":["string","null"],"description":"Nome completo do condutor."},"nacionalidade":{"type":["string","null"],"description":"Nacionalidade registrada no cadastro do condutor."},"permissionario":{"type":["boolean","null"],"format":"bool","description":"Indica se o condutor possui apenas a Permissão Para Dirigir (PPD, fase provisória antes da CNH definitiva). true = em período de permissão; false = habilitação definitiva."},"dataPrimeiraCNH":{"type":["string","null"],"description":"Data da primeira habilitação do condutor."}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/leilao-veicular":{"get":{"summary":"Leilão Veicular","description":"Descubra em poucos segundos se um veículo já passou por leilão, só com a placa: data, leiloeiro, pátio e quem o levou a leilão (seguradora, financeira ou órgão público). Um histórico que o documento do Detran não mostra.","operationId":"leilao-veicular","tags":["Veicular"],"parameters":[{"name":"placa","in":"query","required":true,"description":"Placa do veículo, sem hífen — formato antigo (ABC1234) ou Mercosul (ABC1D34).","schema":{"type":"string","format":"upper","pattern":"^[A-Z]{3}[0-9][A-Z0-9][0-9]{2}$"},"example":"ABC1D23"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"leiloes":{"type":["array","null"],"items":{"type":"object","properties":{"data":{"type":["string","null"],"description":"Data do leilão, no formato DD/MM/AAAA."},"lote":{"type":["string","null"],"description":"Número do lote, quando a fonte informa."},"patio":{"type":["string","null"],"description":"Pátio ou casa de leilões do registro, quando a fonte informa."},"comitente":{"type":["string","null"],"description":"Quem colocou o veículo em leilão (seguradora, instituição financeira, órgão público etc.)."},"leiloeiro":{"type":["string","null"],"description":"Nome do leiloeiro responsável, quando a fonte informa."},"classificacao":{"type":["string","null"],"description":"Classificação do registro de leilão, quando a fonte informa."}}},"description":"Registros de leilão encontrados. Lista vazia quando `temLeilao` é `false`."},"veiculo":{"type":["object","null"],"properties":{"cor":{"type":["string","null"],"description":"Cor predominante do veículo."},"placa":{"type":["string","null"],"description":"Placa do veículo, com hífen."},"chassi":{"type":["string","null"],"description":"Número do chassi."},"anoModelo":{"type":["string","null"],"description":"Ano do modelo. A fonte informa um único ano (o do modelo); o ano de fabricação não é informado."},"marcaModelo":{"type":["string","null"],"description":"Marca e modelo do veículo."}},"description":"Identificação do veículo consultado. Sem registro de leilão, só `placa` vem preenchida."},"temLeilao":{"type":["boolean","null"],"description":"`true` quando a fonte tem ao menos um registro de leilão para o veículo; `false` quando não há registro para a placa."},"quantidadeRegistros":{"type":["integer","null"],"description":"Quantidade de registros de leilão devolvidos. Um mesmo leilão pode aparecer em mais de um registro."}}},"example":{"leiloes":[{"data":"01/03/2026","lote":"123","patio":"PATIO EXEMPLO","comitente":"SEGURADORA EXEMPLO S.A.","leiloeiro":"NOME DO LEILOEIRO EXEMPLO","classificacao":"SUCATA"},{"data":"01/03/2026","lote":null,"patio":null,"comitente":"SEGURADORA EXEMPLO S.A.","leiloeiro":null,"classificacao":null}],"veiculo":{"cor":"PRATA","placa":"ABC-1D23","chassi":"9BWZZZ00000000000","anoModelo":"2019","marcaModelo":"MARCA/MODELO EXEMPLO"},"temLeilao":true,"quantidadeRegistros":2}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/fipe-veiculo":{"get":{"summary":"Tabela Fipe — Valor de Veículo","description":"Devolve o valor de referencia da Tabela Fipe (preco medio de veiculos) a partir de marca, modelo e ano-modelo — sem precisar de placa. A tabela consultada e sempre a do mes corrente. Cobre carros, motos e caminhoes; quando nao ha correspondencia segura de versao, o valor vem nulo com o motivo, em vez de um numero chutado.","operationId":"fipe-veiculo","tags":["Veicular"],"parameters":[{"name":"marca","in":"query","required":true,"description":"Marca/montadora do veiculo (ex.: 'CITROEN', 'HONDA', 'VW'). Aceita a grafia do DENATRAN/BIN, sem acento; a marca 'I' (importado) e resolvida a partir do proprio modelo.","schema":{"type":"string"}},{"name":"modelo","in":"query","required":true,"description":"Modelo/versao do veiculo. Aceita tanto o nome comercial completo ('C3 GLX 1.4 Flex') quanto a abreviacao do DENATRAN/BIN ('C3 GLX 14 FLEX', 'HB2010TA EVOLUTI').","schema":{"type":"string"}},{"name":"anoModelo","in":"query","required":true,"description":"Ano-modelo do veiculo, 4 digitos (ex.: '2011').","schema":{"type":"string","pattern":"^[0-9]{4}$"}},{"name":"tipo","in":"query","required":false,"description":"Tipo do veiculo (ex.: 'AUTOMOVEL', 'CAMIONETA', 'MOTOCICLETA', 'CAMINHAO', 'ONIBUS', 'REBOQUE'). Opcional, mas MUITO recomendado: sem ele a busca precisa varrer carro, moto e caminhao. Tipos que a Fipe nao tabela (reboque/semirreboque) sao respondidos na hora, sem tocar a fonte.","schema":{"type":"string"}},{"name":"combustivel","in":"query","required":false,"description":"Combustivel (ex.: 'GASOLINA', 'ALCOOL/GASOLINA', 'DIESEL'). Opcional. Estreita os candidatos; a busca cobre mais de um codigo de combustivel porque a Fipe arquiva o mesmo modelo flex sob codigos diferentes.","schema":{"type":"string"}},{"name":"cilindrada","in":"query","required":false,"description":"Cilindrada do motor em cm3 (ex.: '1360', '1449', '125'). Opcional, e o desempate mais forte que existe entre versoes homonimas — comparado com tolerancia, porque o nome comercial nao e o arredondamento da cilindrada (1449 cm3 e vendido como '1.5').","schema":{"type":"string"}},{"name":"tipoCarroceria","in":"query","required":false,"description":"Tipo de carroceria do veiculo, como a BIN devolve (ex.: 'ABERTA/CABINE DUPLA' para picape de cabine dupla, 'NAO APLICAVEL' para a maioria dos carros). Opcional; so importa para picape/utilitario com versoes de cabine simples e dupla no mesmo nome comercial — nos demais tipos o campo nao influencia o resultado.","schema":{"type":"string"}}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"valor":{"type":["string","null"],"description":"Valor Fipe formatado exatamente como a fonte oficial escreve, em reais (ex.: 'R$ 23.241,00'). Null quando a Fipe nao publica preco para este veiculo/ano ou quando nao foi possivel identificar a versao com seguranca — ver `status`."},"status":{"type":["string","null"],"description":"Frase em portugues explicando o desfecho da consulta. Com valor: 'Valor Fipe do mes corrente para o modelo identificado.'. Sem valor, diz POR QUE: tipo de veiculo que a Fipe nao tabela (reboque/semirreboque), ano indisponivel para o modelo, motorizacao sem correspondencia, ou versao nao identificavel com seguranca. Nunca null numa resposta bem-sucedida."},"anoModelo":{"type":["integer","null"],"description":"Ano-modelo ao qual o preco se refere (ex.: 2011). Null quando nao houve valor."},"marcaFipe":{"type":["string","null"],"description":"Marca como a Fipe a nomeia (ex.: 'Citroen'), que pode diferir da grafia do DENATRAN informada na consulta. Null quando nao houve valor."},"codigoFipe":{"type":["string","null"],"description":"Codigo Fipe do modelo, no formato oficial 'NNNNNN-N' (ex.: '011072-8'). E a chave que permite reconferir o preco na fonte oficial e acompanhar o mesmo modelo mes a mes. Null quando nao houve valor."},"modeloFipe":{"type":["string","null"],"description":"Nome COMPLETO que a Fipe da a versao precificada (ex.: 'C3 GLX 1.4/ GLX Sonora 1.4 Flex 8V 5p'). Existe para auditoria: e com ele que se confere que o preco e do veiculo consultado e nao de uma versao parente. Null quando nao houve valor."},"combustivel":{"type":["string","null"],"description":"Combustivel da versao precificada, como a Fipe o nomeia (ex.: 'Gasolina', 'Alcool', 'Diesel'). Null quando nao houve valor."},"mesReferencia":{"type":["string","null"],"description":"Rotulo da tabela de referencia como a Fipe o publica, em portugues (ex.: 'julho de 2026'). E o campo que diz de QUAL mes e o preco. Null quando nao houve valor."},"valorNumerico":{"type":["number","null"],"description":"O mesmo valor em numero, para calculo direto sem parse (ex.: 23241.0). Null sempre que `valor` for null."}},"description":"Valor de referencia da Tabela Fipe (preco medio de veiculos) para o veiculo identificado por marca, modelo e ano-modelo. A tabela e sempre a do MES CORRENTE. Todas as chaves estao SEMPRE presentes: quando nao ha valor seguro, elas vem nulas e `status` explica o motivo — ausencia de dado nunca vira chave faltando."}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/v1/notas":{"post":{"tags":["NFS-e"],"summary":"Emitir uma nota","operationId":"emitir_v1_notas_post","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Obrigatório. 1 a 160 caracteres [A-Za-z0-9._:-]. Um pagamento = uma chave = uma nota.","title":"Idempotency-Key"},"description":"Obrigatório. 1 a 160 caracteres [A-Za-z0-9._:-]. Um pagamento = uma chave = uma nota."},{"name":"prefer","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"`wait=<segundos>` (até 25): espera o desfecho da Sefin e responde 200 com a nota final; estourando, 202. No máximo 4 esperas simultâneas por tenant: acima disto, 202 na hora","title":"Prefer"},"description":"`wait=<segundos>` (até 25): espera o desfecho da Sefin e responde 200 com a nota final; estourando, 202. No máximo 4 esperas simultâneas por tenant: acima disto, 202 na hora"},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseNotaEntrada"}}}},"responses":{"200":{"description":"Nota em estado final (autorizada ou rejeitada) dentro do `Prefer: wait`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseNotaSaida"}}}},"202":{"description":"Nota aceita e na fila (ou em `quarentena`, com o motivo em `erro`: o tomador não passou na qualidade); consulte GET /v1/notas/{id} ou aguarde o evento nos webhooks da Dabra","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseNotaSaida"}}}},"409":{"description":"`conflito_idempotencia` (mesma chave, corpo diferente) ou emissor sem certificado/inativo"},"422":{"description":"`dados_invalidos` ou `dps_invalida`: nada foi gravado, nenhum número foi gasto"}},"security":[{"ApiKeyAuth":[]}]},"get":{"tags":["NFS-e"],"summary":"Listar as notas do tenant (filtro por referência externa)","description":"Mais recentes primeiro, sem PDF/XML (use GET /v1/notas/{id}). Com a chave de teste, só as notas do sandbox.","operationId":"listar_v1_notas_get","parameters":[{"name":"referencia","in":"query","required":false,"schema":{"anyOf":[{"type":"string","minLength":1,"maxLength":160},{"type":"null"}],"description":"`referencia_externa` exata informada na emissão (o id do pagamento/pedido no seu sistema)","title":"Referencia"},"description":"`referencia_externa` exata informada na emissão (o id do pagamento/pedido no seu sistema)"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfsePaginaNotas"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseHTTPValidationError"}}}}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/notas/{nota_id}":{"get":{"tags":["NFS-e"],"summary":"Consultar uma nota","operationId":"consultar_v1_notas__nota_id__get","parameters":[{"name":"nota_id","in":"path","required":true,"schema":{"type":"string","title":"Nota Id"}},{"name":"incluir","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"`pdf_base64` e/ou `xml_base64` (separados por vírgula): o DANFSe e o XML da NFS-e em base64 na própria resposta (~60 KB; só nesta rota, nunca em listagens)","title":"Incluir"},"description":"`pdf_base64` e/ou `xml_base64` (separados por vírgula): o DANFSe e o XML da NFS-e em base64 na própria resposta (~60 KB; só nesta rota, nunca em listagens)"},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseNotaConsulta"}}}},"409":{"description":"`nota_sem_nfse` ou `danfse_indisponivel` (só com `incluir`)"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseHTTPValidationError"}}}}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/notas/{nota_id}/xml":{"get":{"tags":["NFS-e"],"summary":"XML da NFS-e autorizada","operationId":"xml_v1_notas__nota_id__xml_get","parameters":[{"name":"nota_id","in":"path","required":true,"schema":{"type":"string","title":"Nota Id"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/xml":{}}},"409":{"description":"`nota_sem_nfse`"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseHTTPValidationError"}}}}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/notas/{nota_id}/pdf":{"get":{"tags":["NFS-e"],"summary":"DANFSe (PDF) da NFS-e autorizada","operationId":"pdf_v1_notas__nota_id__pdf_get","parameters":[{"name":"nota_id","in":"path","required":true,"schema":{"type":"string","title":"Nota Id"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/pdf":{}}},"409":{"description":"`nota_sem_nfse` ou `danfse_indisponivel` (o XML não traz o necessário)"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseHTTPValidationError"}}}}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/notas/{nota_id}/cancelar":{"post":{"tags":["NFS-e"],"summary":"Cancelar uma NFS-e autorizada (evento e101101)","description":"Síncrono: a Sefin registra o evento na hora. Repetir a chamada é seguro: todo pedido confere antes na Sefin\n(GET do evento) e só envia se o cancelamento ainda não existir lá.","operationId":"cancelar_v1_notas__nota_id__cancelar_post","parameters":[{"name":"nota_id","in":"path","required":true,"schema":{"type":"string","title":"Nota Id"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseCancelamento"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseNotaSaida"}}}},"409":{"description":"`nota_nao_autorizada`, `cancelamento_exige_certificado_do_emitente` (o emissor usa o certificado de um procurador, e a Receita só aceita o cancelamento assinado pela própria empresa: envie o A1 dela ou cancele pelo Emissor Nacional) ou `emissor_sem_certificado` (o certificado do emissor foi desligado: ligue-o de novo ou cancele pelo Emissor Nacional)"},"422":{"description":"`cancelamento_recusado` (com os códigos da Sefin)"},"503":{"description":"`sefin_indisponivel`: o pedido fica pendente; repita a chamada"}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/notas/{nota_id}/eventos":{"get":{"tags":["NFS-e"],"summary":"Eventos da nota (cancelamento...)","operationId":"eventos_v1_notas__nota_id__eventos_get","parameters":[{"name":"nota_id","in":"path","required":true,"schema":{"type":"string","title":"Nota Id"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NfseEventoSaida"},"title":"Response Eventos V1 Notas  Nota Id  Eventos Get"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseHTTPValidationError"}}}}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/notas/{nota_id}/substituir":{"post":{"tags":["NFS-e"],"summary":"Substituir uma NFS-e autorizada (nova DPS com o grupo subst)","operationId":"substituir_v1_notas__nota_id__substituir_post","parameters":[{"name":"nota_id","in":"path","required":true,"schema":{"type":"string","title":"Nota Id"}},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Obrigatório. Identifica a nota substituta (1 a 160 caracteres [A-Za-z0-9._:-]).","title":"Idempotency-Key"},"description":"Obrigatório. Identifica a nota substituta (1 a 160 caracteres [A-Za-z0-9._:-])."},{"name":"prefer","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"`wait=<segundos>` (até 25), como em POST /v1/notas","title":"Prefer"},"description":"`wait=<segundos>` (até 25), como em POST /v1/notas"},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseNotaSubstituta"}}}},"responses":{"200":{"description":"Substituta em estado final dentro do `Prefer: wait`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseNotaSaida"}}}},"202":{"description":"Substituta aceita e na fila; a original passa a `substituida` quando ela for autorizada (eventos `nfse.autorizada` e `nfse.substituida` nos webhooks da Dabra)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseNotaSaida"}}}},"403":{"description":"`sem_escopo`: exige `notas:emitir` e `notas:cancelar`"},"409":{"description":"`nota_nao_substituivel` (não autorizada, de outro emissor ou com substituição em andamento) ou `conflito_idempotencia`"},"422":{"description":"`dados_invalidos`, `dps_invalida` ou `substituicao_invalida` (ME/EPP não muda tomador, competência nem valor: E0061)"}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/notas/{nota_id}/tomador":{"patch":{"tags":["NFS-e"],"summary":"Corrigir o tomador de uma nota em quarentena","operationId":"corrigir_v1_notas__nota_id__tomador_patch","parameters":[{"name":"nota_id","in":"path","required":true,"schema":{"type":"string","title":"Nota Id"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseTomadorAlteracao"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseNotaSaida"}}}},"409":{"description":"`nota_fora_da_quarentena`"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseHTTPValidationError"}}}}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/notas/{nota_id}/aprovar":{"post":{"tags":["NFS-e"],"summary":"Aprovar uma nota em quarentena (confere o tomador e manda para a fila)","operationId":"aprovar_v1_notas__nota_id__aprovar_post","parameters":[{"name":"nota_id","in":"path","required":true,"schema":{"type":"string","title":"Nota Id"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseNotaSaida"}}}},"409":{"description":"`nota_fora_da_quarentena`, `nota_alterada`, `emissor_inativo`, `emissor_sem_certificado` ou `certificado_vencido`"},"422":{"description":"o tomador ainda não passa (`tomador_*`, com o motivo) ou `dados_invalidos`/`dps_invalida`: a nota continua em quarentena"},"503":{"description":"certificado do emissor ilegível pelo serviço: nada muda"}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/notas/{nota_id}/descartar":{"post":{"tags":["NFS-e"],"summary":"Descartar uma nota em quarentena (não vai à Sefin; terminal)","description":"Para a nota que não deve mais ser emitida (o tomador não tem correção, o pagamento foi desfeito): vira `descartada`,\nsem número, sem DPS e sem nada na Sefin, com o evento `nfse.descartada` nos webhooks da Dabra. Repetir devolve a mesma nota. A\nIdempotency-Key continua presa a ela: para emitir de novo, use outra chave.","operationId":"descartar_v1_notas__nota_id__descartar_post","parameters":[{"name":"nota_id","in":"path","required":true,"schema":{"type":"string","title":"Nota Id"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"$ref":"#/components/schemas/NfseDescarte"},{"type":"null"}],"title":"Corpo"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseNotaSaida"}}}},"409":{"description":"`nota_fora_da_quarentena`"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseHTTPValidationError"}}}}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/emissores":{"get":{"tags":["NFS-e"],"summary":"Listar emissores do tenant (com a chave de teste, só os do sandbox)","operationId":"listar_v1_emissores_get","parameters":[{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NfseEmissorSaida"},"title":"Response Listar V1 Emissores Get"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseHTTPValidationError"}}}}},"security":[{"ApiKeyAuth":[]}]},"post":{"tags":["NFS-e"],"summary":"Cadastrar emissor (nasce sem certificado: grave o A1 do próprio CNPJ para emitir; o do sandbox emite sem)","operationId":"criar_v1_emissores_post","parameters":[{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseEmissorEntrada"}}}},"responses":{"201":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseEmissorSaida"}}}},"403":{"description":"`kyc_obrigatorio` (produção com a verificação de identidade pendente na conta) ou `ambiente_indisponivel` (chave de teste fora do sandbox)"},"409":{"description":"`emissor_duplicado`: no cadastro, outro emissor desta conta já usa este CNPJ e esta série; ao ligar o certificado, outro emissor com certificado já usa o CNPJ e a série e este emissor já tem notas nela (sem notas, ele troca sozinho para a menor série livre). A numeração da DPS é por CNPJ + série na Receita. `error.serie_livre` sugere a menor série livre do CNPJ (null: nenhuma); cadastre o emissor nela"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseHTTPValidationError"}}}}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/emissores/{emissor_id}":{"patch":{"tags":["NFS-e"],"summary":"Alterar a configuração do emissor (só os campos enviados)","operationId":"alterar_v1_emissores__emissor_id__patch","parameters":[{"name":"emissor_id","in":"path","required":true,"schema":{"type":"integer","title":"Emissor Id"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseEmissorAlteracao"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseEmissorSaida"}}}},"404":{"description":"`emissor_nao_encontrado`"},"422":{"description":"`campo_nao_editavel` (cnpj, série, próximo número, ambiente) ou `dados_invalidos` (configuração fiscal incoerente)"}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/emissores/{emissor_id}/certificado":{"put":{"tags":["NFS-e"],"summary":"Gravar o certificado A1 (PFX + senha; só escrita)","operationId":"gravar_certificado_v1_emissores__emissor_id__certificado_put","parameters":[{"name":"emissor_id","in":"path","required":true,"schema":{"type":"integer","title":"Emissor Id"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/NfseBody_gravar_certificado_v1_emissores__emissor_id__certificado_put"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseEmissorSaida"}}}},"409":{"description":"`emissor_duplicado`: no cadastro, outro emissor desta conta já usa este CNPJ e esta série; ao ligar o certificado, outro emissor com certificado já usa o CNPJ e a série e este emissor já tem notas nela (sem notas, ele troca sozinho para a menor série livre). A numeração da DPS é por CNPJ + série na Receita. `error.serie_livre` sugere a menor série livre do CNPJ (null: nenhuma); cadastre o emissor nela"},"422":{"description":"PFX ilegível, senha errada, vencido, `certificado_pesado` (o PFX demora demais para abrir: exporte de novo com as opções padrão), `certificado_de_outro_cnpj` ou `certificado_sem_cnpj` (e-CPF) sem `procuracao=true`, `certificado_sem_titular`, `certificado_nao_reconhecido` (o ADN da Receita não aceitou o certificado: autoassinado, fora da ICP-Brasil, revogado) ou `procuracao_nao_encontrada` (com `procuracao=true`, o ADN não tem a procuração), `procuracao_indisponivel_no_ambiente` (procuração em emissor da produção restrita, que a Sefin recusa) ou `certificado_dispensado` (emissor do sandbox)"},"429":{"description":"`limite_excedido`: outro certificado está sendo aberto agora; repita em instantes (`Retry-After`)"},"503":{"description":"`adn_indisponivel`: o ADN não respondeu à conferência do certificado; nada foi gravado, repita"}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/emissores/{emissor_id}/certificado/desligar":{"post":{"tags":["NFS-e"],"summary":"Desligar o certificado A1 do emissor (volta a não ter certificado e não emite)","description":"O emissor volta a `certificado: null` e não emite até receber um certificado (o mesmo ou outro); o CNPJ + série\ndeixa de estar reservado. Os outros emissores ligados ao mesmo certificado continuam com ele; se nenhum ficar, o\ncertificado deixa de existir para o tenant (não aparece e `certificado_id` não o encontra). Emissor sem certificado:\ndevolve o emissor como está. As notas já autorizadas continuam valendo; cancelar uma delas pede o certificado (409\n`emissor_sem_certificado`): ligue-o de novo ou cancele pelo Emissor Nacional (site da Receita). Para desligar de todos\nos emissores de uma vez: `POST /v1/certificados/{id}/desligar`.","operationId":"desligar_v1_emissores__emissor_id__certificado_desligar_post","parameters":[{"name":"emissor_id","in":"path","required":true,"schema":{"type":"integer","title":"Emissor Id"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseEmissorSaida"}}}},"404":{"description":"`emissor_nao_encontrado`"},"409":{"description":"`emissor_com_notas_pendentes`: há nota do emissor a caminho da Sefin (`recebida`, `na_fila`, `enviando` ou `aguardando_sefin`) ou cancelamento sem desfecho (pendente ou em curso), que precisa do certificado (inclusive o de outro emissor da mesma raiz que cancela com este certificado); nada foi desligado, repita depois do desfecho"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseHTTPValidationError"}}}}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/emissores/{emissor_id}/ptottribsn/{competencia}":{"put":{"tags":["NFS-e"],"summary":"pTotTribSN de uma competência (alíquota efetiva do DAS)","description":"`competencia`: qualquer dia do mês (vale o mês inteiro). Sem valor do mês, a DPS usa o padrão do emissor.","operationId":"gravar_aliquota_v1_emissores__emissor_id__ptottribsn__competencia__put","parameters":[{"name":"emissor_id","in":"path","required":true,"schema":{"type":"integer","title":"Emissor Id"}},{"name":"competencia","in":"path","required":true,"schema":{"type":"string","format":"date","title":"Competencia"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseAliquotaSN"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseEmissorSaida"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseHTTPValidationError"}}}}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/certificados":{"post":{"tags":["NFS-e"],"summary":"Enviar um certificado A1 e ligá-lo a até 50 emissores (ou ligar um já enviado)","description":"Confere cada emissor em `emissores` e liga o certificado aos que passaram: um emissor que falha\n(`emissor_nao_encontrado`, `emissor_duplicado`, `certificado_de_outro_cnpj`, `certificado_nao_encontrado`...) vai para\n`erros` com o código do PUT, e os outros ficam ligados. O ADN da Receita confere, com o certificado enviado e ANTES de\ngravar, que ele é aceito e alcança o CNPJ de cada emissor: senão, o emissor vai para `erros` com\n`certificado_nao_reconhecido` ou, no modo `procuracao`, `procuracao_nao_encontrada`\n(`procuracao_indisponivel_no_ambiente` na produção restrita). Se o ADN não responder, esse emissor e os seguintes vão\npara `erros` com `adn_indisponivel`, sem nova consulta; se recusar o certificado no TLS (vale para qualquer CNPJ), esse\ne os seguintes vão com `certificado_nao_reconhecido`, também sem nova consulta. O certificado novo só é gravado (UMA vez,\nrenovando o do mesmo titular para todos os emissores ligados a ele) se ao menos um emissor for ligado; senão,\n`certificado` volta null e nada muda.","operationId":"enviar_v1_certificados_post","parameters":[{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"requestBody":{"content":{"multipart/form-data":{"schema":{"$ref":"#/components/schemas/NfseBody_enviar_v1_certificados_post"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseCertificadoEnvioSaida"}}}},"401":{"description":"`nao_autenticado` ou `chave_invalida`"},"403":{"description":"`sem_escopo` ou `ambiente_indisponivel` (chave de teste: o sandbox emite sem certificado)"},"422":{"description":"`requisicao_invalida` (`emissores` fora de 1 a 50), `dados_invalidos` (envie `arquivo` + `senha` OU `certificado_id`), ou PFX ilegível, senha errada, vencido, `certificado_pesado` (o PFX demora demais para abrir: exporte de novo com as opções padrão), `certificado_de_outro_cnpj` ou `certificado_sem_cnpj` (e-CPF) sem `procuracao=true`, `certificado_sem_titular`: nada é gravado nem ligado. Com o ticket, também `certificado_nao_reconhecido` (o ADN da Receita não aceitou o certificado: autoassinado, fora da ICP-Brasil, revogado) ou `procuracao_nao_encontrada` (com `procuracao=true`, o ADN não tem a procuração) e `procuracao_indisponivel_no_ambiente`"},"429":{"description":"`limite_excedido`: outro certificado está sendo aberto agora (repita em instantes) ou, com o ticket, envios demais do tenant no minuto"},"503":{"description":"`adn_indisponivel` (com o ticket): o ADN não respondeu à conferência do certificado; nada foi gravado, repita"}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]},"/v1/certificados/{certificado_id}/desligar":{"post":{"tags":["NFS-e"],"summary":"Desligar o certificado A1 de todos os emissores ligados a ele","description":"Os emissores ligados a ele voltam a `certificado: null` e não emitem até receber um certificado; os CNPJ + série\ndeixam de estar reservados. O certificado deixa de existir para o tenant: não aparece e `certificado_id` não o encontra\n(enviar o A1 do mesmo titular de novo o traz de volta). Tudo ou nada: com nota a caminho da Sefin ou cancelamento sem\ndesfecho em qualquer um dos emissores, nada muda (409). As notas já autorizadas continuam valendo; cancelar uma delas\npede o certificado (409 `emissor_sem_certificado`): ligue-o de novo ou cancele pelo Emissor Nacional (site da Receita).\nPara um emissor só: `POST /v1/emissores/{id}/certificado/desligar`.","operationId":"desligar_v1_certificados__certificado_id__desligar_post","parameters":[{"name":"certificado_id","in":"path","required":true,"schema":{"type":"integer","title":"Certificado Id"}},{"name":"X-Api-Key","in":"header","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"X-Api-Key"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseCertificadoDesligadoSaida"}}}},"403":{"description":"`sem_escopo` ou `ambiente_indisponivel` (chave de teste: o sandbox não tem certificado)"},"404":{"description":"`certificado_nao_encontrado`"},"409":{"description":"`emissor_com_notas_pendentes`: há nota de um dos emissores a caminho da Sefin (`recebida`, `na_fila`, `enviando` ou `aguardando_sefin`) ou cancelamento sem desfecho (pendente ou em curso), que precisa do certificado (inclusive o de outro emissor da mesma raiz que cancela com este certificado); nada foi desligado, repita depois do desfecho"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NfseHTTPValidationError"}}}}},"security":[{"ApiKeyAuth":[]}]},"servers":[{"url":"https://fiscal.dabradata.com"}]}},"components":{"securitySchemes":{"ApiKeyAuth":{"type":"apiKey","in":"header","name":"X-API-Key"}},"schemas":{"Error":{"type":"object","required":["error"],"properties":{"error":{"type":"object","required":["code","message"],"properties":{"code":{"type":"string"},"message":{"type":"string"}}}}},"NfseAjusteBC":{"properties":{"pAjusteBCISSQN":{"anyOf":[{"type":"number","exclusiveMaximum":1000,"exclusiveMinimum":0},{"type":"string"},{"type":"null"}],"title":"Pajustebcissqn"},"vAjusteBCISSQN":{"anyOf":[{"type":"number","exclusiveMinimum":0},{"type":"string"},{"type":"null"}],"title":"Vajustebcissqn"}},"additionalProperties":false,"type":"object","title":"AjusteBC"},"NfseAliquotaSN":{"properties":{"p_tot_trib_sn":{"anyOf":[{"type":"number","exclusiveMaximum":100,"minimum":0},{"type":"string"}],"title":"P Tot Trib Sn"}},"additionalProperties":false,"type":"object","required":["p_tot_trib_sn"],"title":"AliquotaSN"},"NfseBody_enviar_v1_certificados_post":{"properties":{"arquivo":{"anyOf":[{"type":"string","contentMediaType":"application/octet-stream"},{"type":"null"}],"title":"Arquivo","description":"PFX/P12 (com `senha`; ou use `certificado_id`)"},"senha":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Senha","description":"senha do PFX; usada uma vez e descartada"},"certificado_id":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Certificado Id","description":"um certificado já enviado por este tenant (o `id` de `certificado`), no lugar de `arquivo` e `senha`"},"emissores":{"anyOf":[{"items":{"type":"integer"},"type":"array"},{"type":"null"}],"title":"Emissores","description":"ids dos emissores (1 a 50; repita o campo para cada um)"},"procuracao":{"type":"boolean","title":"Procuracao","description":"true: aceita o A1 de outro titular (e-CNPJ de outra raiz ou e-CPF) que tenha procuração eletrônica do CNPJ do emissor na Receita (serviço NFS-e); sem ele, só o A1 do próprio CNPJ (matriz ou filial)","default":false},"ticket":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Ticket","description":"uso exclusivo da tela do portal da Dabra; quem integra por código autentica com `X-Api-Key` e não envia este campo"}},"type":"object","title":"Body_enviar_v1_certificados_post"},"NfseBody_gravar_certificado_v1_emissores__emissor_id__certificado_put":{"properties":{"arquivo":{"type":"string","contentMediaType":"application/octet-stream","title":"Arquivo","description":"PFX/P12"},"senha":{"type":"string","title":"Senha","description":"senha do PFX; usada uma vez e descartada"},"procuracao":{"type":"boolean","title":"Procuracao","description":"true: aceita o A1 de outro titular (e-CNPJ de outra raiz ou e-CPF) que tenha procuração eletrônica do CNPJ do emissor na Receita (serviço NFS-e); sem ele, só o A1 do próprio CNPJ (matriz ou filial)","default":false}},"type":"object","required":["arquivo","senha"],"title":"Body_gravar_certificado_v1_emissores__emissor_id__certificado_put"},"NfseCancelamento":{"properties":{"cMotivo":{"type":"integer","enum":[1,2,9],"title":"Cmotivo","description":"1 erro na emissão, 2 serviço não prestado, 9 outros"},"xMotivo":{"type":"string","maxLength":255,"minLength":15,"title":"Xmotivo"}},"additionalProperties":false,"type":"object","required":["cMotivo","xMotivo"],"title":"Cancelamento"},"NfseCertificadoDesligadoSaida":{"properties":{"emissores":{"items":{"$ref":"#/components/schemas/NfseEmissorSaida"},"type":"array","title":"Emissores","description":"os emissores que estavam ligados ao certificado, agora sem certificado"}},"type":"object","required":["emissores"],"title":"CertificadoDesligadoSaida"},"NfseCertificadoEnvioErro":{"properties":{"emissor_id":{"type":"integer","title":"Emissor Id"},"code":{"type":"string","title":"Code","description":"o mesmo código do erro no `PUT /v1/emissores/{id}/certificado` (p. ex. `emissor_duplicado`, `certificado_de_outro_cnpj`, `emissor_nao_encontrado`) ou `certificado_nao_encontrado`"},"message":{"type":"string","title":"Message"}},"type":"object","required":["emissor_id","code","message"],"title":"CertificadoEnvioErro"},"NfseCertificadoEnvioSaida":{"properties":{"certificado":{"anyOf":[{"$ref":"#/components/schemas/NfseCertificadoGravado"},{"type":"null"}],"description":"o certificado gravado (ou o de `certificado_id`); null se `certificado_id` não for deste tenant ou se nenhum emissor foi ligado ao certificado novo (nada é gravado)"},"emissores":{"items":{"$ref":"#/components/schemas/NfseEmissorSaida"},"type":"array","title":"Emissores","description":"os emissores ligados, já com o certificado"},"erros":{"items":{"$ref":"#/components/schemas/NfseCertificadoEnvioErro"},"type":"array","title":"Erros","description":"os emissores não ligados: cada um falha sozinho, sem desfazer os outros"}},"type":"object","required":["certificado","emissores","erros"],"title":"CertificadoEnvioSaida"},"NfseCertificadoGravado":{"properties":{"id":{"type":"integer","title":"Id"},"cnpj":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Cnpj","description":"o titular quando é um CNPJ; null só no e-CPF"},"titular":{"type":"string","title":"Titular","description":"CNPJ (14) ou CPF (11) do titular do A1"},"valido_ate":{"type":"string","format":"date-time","title":"Valido Ate"}},"type":"object","required":["id","cnpj","titular","valido_ate"],"title":"CertificadoGravado"},"NfseCertificadoSaida":{"properties":{"id":{"type":"integer","title":"Id","description":"o certificado no tenant (um por titular): `certificado_id` em `POST /v1/certificados` liga o mesmo A1 a outros emissores"},"cnpj":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Cnpj","description":"o titular quando é um CNPJ; null só no e-CPF"},"titular":{"type":"string","title":"Titular","description":"CNPJ (14) ou CPF (11) do titular do A1"},"modo":{"type":"string","enum":["proprio","procuracao"],"title":"Modo","description":"`proprio`: A1 do próprio CNPJ (mesma raiz); `procuracao`: A1 de outro titular, com procuração eletrônica do CNPJ do emissor"},"valido_ate":{"type":"string","format":"date-time","title":"Valido Ate","description":"fim da validade do A1; o evento `nfse.certificado_vencendo` (webhooks da Dabra) avisa 30, 15 e 7 dias antes"}},"type":"object","required":["id","cnpj","titular","modo","valido_ate"],"title":"CertificadoSaida"},"NfseCobrancaNota":{"properties":{"estado":{"type":"string","enum":["nao_aplicavel","pendente","cobrada"],"title":"Estado","description":"`cobrada`: o valor entrou no extrato da conta Dabra; `pendente`: a cobrança será confirmada em instantes (a nota vale do mesmo jeito); `nao_aplicavel`: sem cobrança (sandbox ou produção restrita)"},"valor":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Valor","description":"preço desta nota, em reais (string decimal); null até a confirmação"},"cobrada_em":{"anyOf":[{"type":"string","format":"date-time"},{"type":"null"}],"title":"Cobrada Em"}},"type":"object","required":["estado","valor","cobrada_em"],"title":"CobrancaNota"},"NfseComExt":{"properties":{"mdPrestacao":{"anyOf":[{"type":"integer","enum":[0,1,2,3,4]},{"type":"null"}],"title":"Mdprestacao"},"vincPrest":{"anyOf":[{"type":"integer","enum":[0,1,2,3,4,5,6,9]},{"type":"null"}],"title":"Vincprest"},"tpMoeda":{"type":"string","pattern":"^[0-9]{3}$","title":"Tpmoeda"},"vServMoeda":{"anyOf":[{"type":"number","exclusiveMinimum":0},{"type":"string"}],"title":"Vservmoeda"},"mecAFComexP":{"anyOf":[{"type":"string","pattern":"^0[0-8]$"},{"type":"null"}],"title":"Mecafcomexp"},"mecAFComexT":{"anyOf":[{"type":"string","pattern":"^(0[0-9]|1[0-9]|2[0-6])$"},{"type":"null"}],"title":"Mecafcomext"},"movTempBens":{"anyOf":[{"type":"integer","enum":[0,1,2,3]},{"type":"null"}],"title":"Movtempbens"},"nDI":{"anyOf":[{"type":"string","maxLength":12,"minLength":1},{"type":"null"}],"title":"Ndi"},"nRE":{"anyOf":[{"type":"string","maxLength":12,"minLength":1},{"type":"null"}],"title":"Nre"},"mdic":{"anyOf":[{"type":"integer","enum":[0,1]},{"type":"null"}],"title":"Mdic"}},"additionalProperties":false,"type":"object","required":["tpMoeda","vServMoeda"],"title":"ComExt","description":"Grupo comExt da DPS (tomador no exterior). Campos ausentes vêm do padrão do emissor (`com_ext_padrao`); `tpMoeda` e\n`vServMoeda` são sempre da nota."},"NfseDescarte":{"properties":{"motivo":{"anyOf":[{"type":"string","maxLength":255,"minLength":1},{"type":"null"}],"title":"Motivo","description":"por que a nota não será emitida"}},"additionalProperties":false,"type":"object","title":"Descarte"},"NfseEmissorAlteracao":{"properties":{"razao":{"type":"string","maxLength":300,"minLength":1,"title":"Razao"},"im":{"anyOf":[{"type":"string","pattern":"^[0-9A-Za-z]{1,15}$"},{"type":"null"}],"title":"Im"},"c_trib_nac":{"type":"string","pattern":"^[0-9]{6}$","title":"C Trib Nac"},"p_tot_trib_sn":{"anyOf":[{"type":"number","exclusiveMaximum":100,"minimum":0},{"type":"string"},{"type":"null"}],"title":"P Tot Trib Sn"},"op_simp_nac":{"type":"integer","enum":[1,2,3,4],"title":"Op Simp Nac"},"reg_ap_trib_sn":{"anyOf":[{"type":"integer","enum":[1,2,3]},{"type":"null"}],"title":"Reg Ap Trib Sn"},"reg_esp_trib":{"type":"integer","enum":[0,1,2,3,4,5,6,9],"title":"Reg Esp Trib"},"reg_ap_ibscbs_sn":{"anyOf":[{"type":"integer","enum":[1,2,3]},{"type":"null"}],"title":"Reg Ap Ibscbs Sn"},"c_atv_sn":{"anyOf":[{"type":"integer","enum":[7,8,9,10,11,12,13,14,90]},{"type":"null"}],"title":"C Atv Sn"},"c_nbs":{"anyOf":[{"type":"string","pattern":"^[0-9]{9}$"},{"type":"null"}],"title":"C Nbs"},"com_ext_padrao":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Com Ext Padrao","description":"mdPrestacao, vincPrest, mecAFComexP, mecAFComexT, movTempBens, mdic"},"email":{"anyOf":[{"type":"string","maxLength":80,"minLength":3},{"type":"null"}],"title":"Email"},"fone":{"anyOf":[{"type":"string","pattern":"^[0-9]{6,20}$"},{"type":"null"}],"title":"Fone"}},"additionalProperties":false,"type":"object","title":"EmissorAlteracao","description":"PATCH do emissor: só os campos enviados mudam; `null` limpa os opcionais. CNPJ, série, próximo número, ambiente e\ntenant nunca mudam (422 `campo_nao_editavel`): numeração e identidade fiscal são do serviço."},"NfseEmissorEntrada":{"properties":{"cnpj":{"type":"string","pattern":"^[0-9A-Z]{12}[0-9]{2}$","title":"Cnpj"},"razao":{"type":"strin