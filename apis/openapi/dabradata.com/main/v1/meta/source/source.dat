,"fone":{"anyOf":[{"type":"string","pattern":"^[0-9]{6,20}$"},{"type":"null"}],"title":"Fone"},"ambiente":{"type":"integer","enum":[1,2,3],"title":"Ambiente","description":"1 produção (exige o A1 do CNPJ e, se a conta tiver a verificação de identidade pendente, concluí-la), 2 produção restrita da Sefin (uso interno), 3 sandbox: simulador da Dabra, sem certificado, sem verificação de identidade e sem custo; a nota sai com a tarja \"SIMULAÇÃO — SEM VALOR FISCAL\" e é apagada 30 dias depois. A chave de teste só cadastra o 3"}},"additionalProperties":false,"type":"object","required":["cnpj","razao","c_mun","op_simp_nac","c_trib_nac","ambiente"],"title":"EmissorEntrada"},"NfseEmissorSaida":{"properties":{"id":{"type":"integer","title":"Id"},"cnpj":{"type":"string","title":"Cnpj"},"razao":{"type":"string","title":"Razao"},"c_mun":{"type":"string","title":"C Mun"},"im":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Im"},"op_simp_nac":{"type":"integer","title":"Op Simp Nac"},"reg_ap_trib_sn":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Reg Ap Trib Sn"},"reg_esp_trib":{"type":"integer","title":"Reg Esp Trib"},"p_tot_trib_sn":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"P Tot Trib Sn"},"reg_ap_ibscbs_sn":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Reg Ap Ibscbs Sn"},"c_atv_sn":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"C Atv Sn"},"c_trib_nac":{"type":"string","title":"C Trib Nac"},"c_nbs":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"C Nbs"},"com_ext_padrao":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Com Ext Padrao"},"serie":{"type":"integer","title":"Serie"},"proximo_numero":{"type":"integer","title":"Proximo Numero"},"email":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Email"},"fone":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Fone"},"ambiente":{"type":"integer","title":"Ambiente","description":"1 produção, 2 produção restrita, 3 sandbox (simulador, sem certifi