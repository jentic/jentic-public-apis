oi concedido por via judicial."}},"description":"Dados retornados da consulta de benefício."},"metaDados":{"type":["object","null"],"properties":{"ip":{"type":["string","null"],"description":"Endereço IP da requisição."},"data":{"type":["string","null"],"description":"Data e hora da execução da consulta."},"chave":{"type":["string","null"],"description":"Chave de identificação da consulta."},"usuario":{"type":["string","null"],"description":"Usuário que realizou a consulta."},"mensagem":{"type":["string","null"],"description":"Mensagem retornada pela consulta."},"apiVersao":{"type":["string","null"],"description":"Versão da API utilizada."},"resultado":{"type":["string","null"],"description":"Status ou descrição do resultado da consulta."},"assincrono":{"type":["boolean","null"],"description":"Indica se a consulta foi executada de forma assíncrona."},"consultaUid":{"type":["string","null"],"description":"Identificador único da consulta."},"resultadoId":{"type":["number","null"],"description":"Identificador numérico do resultado."},"consultaNome":{"type":["string","null"],"description":"Nome da consulta realizada."},"enviarCallback":{"type":["boolean","null"],"description":"Indica se um callback será enviado."},"urlComprovante":{"type":["string","null"],"description":"URL para acessar o comprovante gerado."},"tempoExecucaoMs":{"type":["number","null"],"description":"Tempo de execução da consulta em milissegundos."},"gerarComprovante":{"type":["boolean","null"],"description":"Indica se um comprovante será gerado."}},"description":"Metadados da consulta."}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consulta