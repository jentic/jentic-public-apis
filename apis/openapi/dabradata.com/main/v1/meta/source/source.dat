g","null"],"description":"Data de nascimento do indivíduo."},"perfilDomiciliar":{"type":["object","null"],"properties":{"tipoDomicilio":{"type":["string","null"],"description":"Tipo de domicílio."},"confiabilidade":{"type":["string","null"],"description":"Confiabilidade da estimativa."},"rendaPerCapita":{"type":["string","null"],"format":"currency","description":"Renda per capita estimada."},"rendaDomiciliar":{"type":["string","null"],"format":"currency","description":"Renda domiciliar estimada."},"quantidadeAdultos":{"type":["number","null"],"description":"Quantidade de adultos no domicílio."},"quantidadeMenores":{"type":["number","null"],"description":"Quantidade de menores no domicílio."},"faixaRendaPerCapita":{"type":["string","null"],"description":"Faixa de renda per capita."},"quantidadeMoradores":{"type":["number","null"],"description":"Quantidade total de moradores."},"classeSocialFamiliar":{"type":["string","null"],"description":"Classe social familiar estimada."}},"description":"Perfil do domicílio do indivíduo (composição e renda familiar)."},"situacaoCadastral":{"type":["string","null"],"description":"Situação cadastral do indivíduo."},"rendaFaixaSalarial":{"type":["string","null"],"description":"Faixa de renda salarial baseada em salários mínimos."},"dataSituacaoCadastral":{"type":["string","null"],"description":"Data da consulta da situação cadastral."}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/cadastro-pf-basica":{"get":{"summary":"Cadastro Pessoal - Telefones e endereços","description":"Consulta dados cadastrais de um CPF, retornando informações pessoais, endereço e contato de fontes oficiais. Aplicável para verificação de identidade, análise de risco e prevenção a fraude.","op