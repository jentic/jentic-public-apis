 parcela."},"municipio":{"type":["string","null"],"description":"Município referente ao registro."},"numeroRegistro":{"type":["integer","null"],"description":"Número do registro."},"dataMesReferencia":{"type":["string","null"],"description":"Data do mês de referência."},"dataMesCompetencia":{"type":["string","null"],"description":"Data do mês de competência."}}},"description":"Lista de benefícios consultados."}},"description":"Dados do retorno da consulta."},"metaDados":{"type":["object","null"],"properties":{"ip":{"type":["string","null"],"description":"Endereço IP da requisição."},"data":{"type":["string","null"],"description":"Data e hora da consulta."},"chave":{"type":["string","null"],"description":"Chave de acesso da consulta."},"usuario":{"type":["string","null"],"description":"Usuário que realizou a consulta."},"mensagem":{"type":["string","null"],"description":"Mensagem de retorno da consulta."},"apiVersao":{"type":["string","null"],"description":"Versão da API utilizada."},"resultado":{"type":["string","null"],"description":"Status do resultado da consulta."},"assincrono":{"type":["boolean","null"],"description":"Indica se a consulta foi assíncrona."},"consultaUid":{"type":["string","null"],"description":"Identificador único da consulta."},"resultadoId":{"type":["integer","null"],"description":"Identificador do resultado."},"consultaNome":{"type":["string","null"],"description":"Nome da consulta realizada."},"enviarCallback":{"type":["boolean","null"],"description":"Indica se deve enviar callback."},"urlComprovante":{"type":["string","null"],"description":"URL do comprovante gerado."},"tempoExecucaoMs":{"type":["integer","null"],"description":"Tempo de execução em milissegundos."},"gerarComprovante":{"type":["boolean","null"],"description":"Indica se deve gerar comprovante."}},"description":"Metadados da consulta."}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/garantia-safra":{"get":{"summary":"Garantia Safra","description":"Consulta informações sobre benefícios do programa Garantia Safra para agricultores familiares, validando dados cadastrais (CPF, NIS) e retornando histórico de parcelas por município e estado.","operationId":"garantia-safra","tags":["Benefícios Sociais"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":["object","null"],"properties":{"retorno":{"type":["object","null"],"properties":{"cpf":{"type":["string","null"],"description":"CPF do indivíduo consultado."},"nis":{"type":["string","null"],"description":"Número de Identificação Social do indivíduo."},"nome":{"type":["string","null"],"description":"Nome do indivíduo consultado."},"beneficios":{"type":["array","null"],"items":{"type":"object","properties":{"uf":{"type":["string","null"],"description":"Unidade Federativa referente ao benefício."},"data":{"type":["string","null"],"description":"Data do registro do benefício."},"valor":{"type":["string","null"],"description":"Valor da parcela ou benefício."},"municipio":{"type":["string","null"],"description":"Município referente ao benefício."},"numeroRegistro":{"type":["number","null"],"description":"Número sequencial do registro do benefício."}}},"description":"Lista de benefícios registrados."}},"description":"Dados retornados pela consulta."},"metaDados":{"type":["object","null"],"properties":{"ip":{"type":["string","null"],"description":"Endereço IP da requisição."},"data":{"type":["string","null"],"description":"Data e hora de execução da consulta."},"chave":{"type":["string","null"],"description":"Chave de autenticação ou identificação."},"usuario":{"type":["string","null"],"description":"Usuário que realizou a consulta."},"mensagem":{"type":["string","null"],"description":"Mensagem de status da consulta."},"apiVersao":{"type":["string","null"],"description":"Versão da API utilizada."},"resultado":{"type":["string","null"],"description":"Descrição textual do resultado."},"assincrono":{"type":["boolean","null"],"description":"Indicador se a consulta foi processada de forma assíncrona."},"consultaUid":{"type":["string","null"],"description":"Identificador único da consulta."},"resultadoId":{"type":["number","null"],"description":"Identificador numérico do resultado."},"consultaNome":{"type":["string","null"],"description":"Nome da consulta realizada."},"enviarCallback":{"type":["boolean","null"],"description":"Indicador se será enviado callback."},"urlComprovante":{"type":["string","null"],"description":"URL para acessar o comprovante gerado."},"tempoExecucaoMs":{"type":["number","null"],"description":"Tempo total de execução em milissegundos."},"gerarComprovante":{"type":["boolean","null"],"description":"Indicador se será gerado comprovante."}},"description":"Metadados e informações de execução da consulta."}},"description":"Dados da consulta."},"found":{"type":["boolean","null"],"description":"Indicador se registros foram encontrados na consulta."},"message":{"type":["string","null"],"description":"Mensagem descritiva do resultado da consulta."}}},"example":{"data":null,"found":false,"message":"Nenhum registro encontrado"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/peti-trabalho-infantil":{"get":{"summary":"PETI - Erradicação do Trabalho Infantil","description":"Verifica inclusão no PETI (Programa de Erradicação do Trabalho Infantil) por CPF. Retorna situação e período. Para compliance de cadeias produtivas.","operationId":"peti-trabalho-infantil","tags":["Benefícios Sociais"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/seguro-defeso":{"get":{"summary":"Seguro Defeso - Pescador Artesanal","description":"Retorna dados de Seguro Defeso para pescadores artesanais em período de defeso, incluindo parcelas, valores e situação do benefício.","operationId":"seguro-defeso","tags":["Benefícios Sociais"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":["object","null"],"properties":{"retorno":{"type":["object","null"],"properties":{"cpf":{"type":["string","null"],"description":"CPF do indivíduo."},"nis":{"type":["string","null"],"description":"Número de Identificação Social (NIS)."},"rgp":{"type":["string","null"],"description":"Registro Geral da Atividade Pesqueira."},"nome":{"type":["string","null"],"description":"Nome completo do indivíduo."},"beneficios":{"type":["array","null"],"items":{"type":"object","properties":{"uf":{"type":["string","null"],"description":"Unidade Federativa (estado) do registro."},"data":{"type":["string","null"],"description":"Data do registro do benefício."},"valor":{"type":["string","null"],"description":"Valor da parcela do benefício."},"portaria":{"type":["string","null"],"description":"Portaria referente ao benefício."},"situacao":{"type":["string","null"],"description":"Situação atual do registro."},"municipio":{"type":["string","null"],"description":"Município referente ao registro."},"numeroParcela":{"type":["number","null"],"description":"Número sequencial da parcela."}}},"description":"Lista de benefícios do pescador artesanal."}},"description":"Dados do indivíduo e benefícios consultados."},"metaDados":{"type":["object","null"],"properties":{"ip":{"type":["string","null"],"description":"Endereço IP da requisição."},"data":{"type":["string","null"],"description":"Data e hora de execução da consulta."},"chave":{"type":["string","null"],"description":"Chave de referência da consulta."},"usuario":{"type":["string","null"],"description":"Usuário que realizou a consulta."},"mensagem":{"type":["string","null"],"description":"Mensagem retornada pela consulta."},"apiVersao":{"type":["string","null"],"description":"Versão da API utilizada."},"resultado":{"type":["string","null"],"description":"Status textual do resultado da consulta."},"assincrono":{"type":["boolean","null"],"description":"Indica se a consulta foi executada de forma assíncrona."},"consultaUid":{"type":["string","null"],"description":"Identificador único da consulta."},"resultadoId":{"type":["number","null"],"description":"Identificador numérico do resultado."},"consultaNome":{"type":["string","null"],"description":"Nome da consulta realizada."},"enviarCallback":{"type":["boolean","null"],"description":"Indica se será enviado callback."},"urlComprovante":{"type":["string","null"],"description":"URL de acesso ao comprovante."},"tempoExecucaoMs":{"type":["number","null"],"description":"Tempo de execução em milissegundos."},"gerarComprovante":{"type":["boolean","null"],"description":"Indica se será gerado comprovante."}},"description":"Metadados da execução da consulta."}},"description":"Dados da consulta de benefício de pescador artesanal."},"found":{"type":["boolean","null"],"description":"Indica se registros de benefício foram encontrados."},"message":{"type":["string","null"],"description":"Mensagem descritiva do resultado da operação."}}},"example":{"data":null,"found":false,"message":"Nenhum registro encontrado"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/ccd-pf":{"get":{"summary":"Certidão Conjunta de Débitos - PF","description":"Consulta a Certidão Conjunta de Débitos relativos a Tributos Federais e à Dívida Ativa da União (RFB/PGFN) de uma pessoa física, a partir do CPF, indicando regularidade fiscal, dívidas listadas, validade e código de controle. Não substitui certidões estaduais ou municipais.","operationId":"ccd-pf","tags":["Certidões"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"data_nascimento","in":"query","required":false,"description":"OPCIONAL (DD/MM/AAAA). Só é necessária quando a resposta vier com status requer_dados (data de nascimento não localizada ou não conferida): reenvie a consulta com a data.","schema":{"type":"string","format":"br_date"}},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"cpf":{"type":["string","null"],"description":"CPF da pessoa física."},"nome":{"type":["string","null"],"description":"Nome da pessoa física."},"status":{"type":["string","null"],"description":"Status da certidão."},"titulo":{"type":["string","null"],"description":"Título da certidão."},"portaria":{"type":["string","null"],"description":"Portaria que refere à certidão."},"emitidaAs":{"type":["string","null"],"description":"Data e hora de emissão da certidão."},"validaAte":{"type":["string","null"],"description":"Data de validade da certidão."},"dataConsulta":{"type":["string","null"],"description":"Data e hora em que a certidão foi consultada."},"listaDividas":{"type":["array","null"],"items":{"type":["string","null"]},"description":"Lista de dívidas do indivíduo."},"linkValidacao":{"type":["string","null"],"description":"URL oficial da Receita Federal para conferir a autenticidade da certidão."},"possuiDividas":{"type":["boolean","null"],"description":"Indicador de presença de dívidas."},"regularidadeFiscal":{"type":["boolean","null"],"format":"bool","description":"Indica se a pessoa está fiscalmente regular (certidão negativa ou positiva com efeitos de negativa)."},"validadeProrrogada":{"type":["string","null"],"description":"Indicação de validade prorrogada, quando aplicável."},"codigoControleCertidao":{"type":["string","null"],"description":"Código identificador da certidão."},"possuiDividaAtivaUniao":{"type":["boolean","null"],"format":"bool","description":"Indica débitos inscritos em Dívida Ativa da União (PGFN)."},"possuiDebitosReceitaFederal":{"type":["boolean","null"],"format":"bool","description":"Indica débitos junto à Receita Federal (RFB)."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/ccd-pj":{"get":{"summary":"Certidão Conjunta de Débitos - PJ","description":"Emite a Certidão Negativa de Débitos relativos a Créditos Tributários Federais e à Dívida Ativa da União (RFB/PGFN) de uma pessoa jurídica, a partir do CNPJ. Comprova a regularidade fiscal da empresa perante a Receita Federal e a Procuradoria-Geral da Fazenda Nacional, indicando se há débitos federais em aberto ou inscritos em dívida ativa.","operationId":"ccd-pj","tags":["Certidões"],"parameters":[{"name":"cnpj","in":"query","required":true,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"cnpj":{"type":["string","null"],"format":"cnpj","description":"CNPJ da empresa consultada (sempre a matriz)."},"nome":{"type":["string","null"],"description":"Razão social da empresa."},"consta":{"type":["boolean","null"],"format":"bool","description":"Indica se consta algum registro (falso = nada consta)."},"status":{"type":["string","null"],"description":"Texto da certidão emitida (negativa, ou positiva com efeitos de negativa)."},"mensagem":{"type":["string","null"],"description":"Mensagem do resultado da consulta."},"emitidaAs":{"type":["string","null"],"description":"Data de emissão da certidão."},"validaAte":{"type":["string","null"],"description":"Data de validade da certidão."},"dataConsulta":{"type":["string","null"],"description":"Data e hora em que a certidão foi consultada."},"linkValidacao":{"type":["string","null"],"description":"URL oficial da Receita Federal para conferir a autenticidade da certidão."},"possuiDividas":{"type":["boolean","null"],"format":"bool","description":"Resumo: indica se há qualquer débito (Dívida Ativa da União ou Receita Federal)."},"regularidadeFiscal":{"type":["boolean","null"],"format":"bool","description":"Indica se a empresa está fiscalmente regular (certidão negativa ou positiva com efeitos de negativa)."},"validadeProrrogada":{"type":["string","null"],"description":"Indicação de validade prorrogada, quando aplicável."},"situacaoCadastralCnpj":{"type":["string","null"],"description":"Situação cadastral do CNPJ (ex.: Válida)."},"codigoControleCertidao":{"type":["string","null"],"description":"Código de controle único da certidão."},"possuiDividaAtivaUniao":{"type":["boolean","null"],"format":"bool","description":"Indica débitos inscritos em Dívida Ativa da União (PGFN)."},"possuiDebitosReceitaFederal":{"type":["boolean","null"],"format":"bool","description":"Indica débitos junto à Receita Federal (RFB)."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/tst-cndt":{"get":{"summary":"Certidão Negativa de Débitos Trabalhistas (CNDT)","description":"Emite e consulta a Certidão Negativa de Débitos Trabalhistas (CNDT) do TST — Banco Nacional de Devedores Trabalhistas (BNDT) — para CPF ou CNPJ. Aponta se há débito trabalhista pendente e lista os processos.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.","operationId":"tst-cndt","tags":["Certidões"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (11 dígitos) do titular da certidão, somente números. Informe cpf OU cnpj.","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (14 dígitos) do titular da certidão, somente números. Informe cpf OU cnpj.","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome/razão social do titular conforme consta no BNDT (ex.: 'PETROLEO BRASILEIRO S A PETROBRAS (MATRIZ E FILIAIS)'). Null quando a fonte não informa."},"status":{"type":["string","null"],"description":"Texto oficial do resultado da certidão, reproduzindo a frase do TST (ex.: 'Certifica-se que ... NAO CONSTA/CONSTA ... no Banco Nacional de Devedores Trabalhistas.'). Null quando a fonte não informa."},"processos":{"type":"array","items":{"type":"object","properties":{"local":{"type":["string","null"],"description":"Órgão/vara onde tramita a execução (ex.: 'TRT 2a Regiao (1a VARA DO TRABALHO DE SAO PAULO)')."},"codigo":{"type":["string","null"],"description":"Número único do processo no padrão CNJ (ex.: '0000000-00.2026.5.02.0000')."}},"description":"Um processo/execução trabalhista com débito pendente."},"description":"Lista dos processos/execuções trabalhistas que sustentam a inscrição no BNDT. Vazia ([]) numa certidão negativa. Nunca null: ausência de processo é afirmada por [], não por null."},"dataValidade":{"type":["string","null"],"description":"Data e hora de validade da certidão (validade legal de 180 dias a partir da expedição), no formato 'DD/MM/AAAA HH:MM:SS' (ex.: '14/01/2027 00:00:00'). Null quando não emitida."},"dataExpedicao":{"type":["string","null"],"description":"Data e hora de expedição da certidão, no formato 'DD/MM/AAAA HH:MM:SS' (ex.: '18/07/2026 07:37:32'). Null quando não emitida."},"numeroCertidao":{"type":["string","null"],"description":"Número da certidão emitida pelo TST, no formato 'sequencial/ano' (ex.: '00000000/2026'). Serve para validar a autenticidade no site do TST. Null quando não emitida."},"possuiProcesso":{"type":["boolean","null"],"description":"true = CONSTA registro de débito trabalhista no BNDT (certidão positiva ou positiva com efeito de negativa); false = NADA CONSTA (certidão negativa). Null quando a fonte não conclui a consulta."},"totalProcessos":{"type":["integer","null"],"description":"Quantidade de processos/execuções trabalhistas em que o titular consta como devedor no BNDT. 0 numa certidão negativa. Null quando a fonte não informa."},"documentoConsultado":{"type":["string","null"],"description":"CPF ou CNPJ consultado, formatado com máscara (ex.: '11.111.111/0001-11'). Null quando a fonte não informa."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}},"description":"Certidão Negativa de Débitos Trabalhistas (CNDT) emitida pelo TST — Banco Nacional de Devedores Trabalhistas (BNDT)."}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/leads-contato":{"post":{"summary":"Contato do Lead","description":"Retorna telefones e e-mails de um registro localizado pela consulta Leads por Endereço. Cobrado por registro consultado.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"leads-contato","tags":["Comercial"],"parameters":[{"name":"id","in":"query","required":true,"description":"Identificador do registro, obtido no campo `id` da consulta Leads por Endereço.","schema":{"type":"string","pattern":"^[0-9]{1,20}$"}}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Razão social completa quando o registro é empresa; nome parcialmente mascarado quando é pessoa física."},"emails":{"type":["array","null"],"items":{"type":"string"},"description":"E-mails associados ao registro."},"documento":{"type":["string","null"],"description":"CNPJ completo quando o registro é empresa; CPF parcialmente mascarado quando é pessoa física."},"telefones":{"type":["array","null"],"items":{"type":"object","properties":{"ddd":{"type":["string","integer","null"],"description":"DDD do telefone, sem o zero."},"numero":{"type":["string","integer","null"],"description":"Número do telefone, sem o DDD."}}},"description":"Telefones associados ao registro. O DDD é o do telefone e pode não corresponder à região do endereço — a pessoa ou empresa pode ter mantido um número de outra praça."},"tipoPessoa":{"type":["string","null"],"description":"PF para pessoa física, PJ para empresa."},"idConsultado":{"type":["string","null"],"description":"Eco do identificador informado na consulta."}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"nome":"CONDOMINIO EDIFICIO EXEMPLO","emails":["contato@exemplo.com.br"],"documento":"11111111000111","telefones":[{"ddd":"11","numero":"00000001"},{"ddd":"11","numero":"00000002"},{"ddd":"11","numero":"00000003"}],"tipoPessoa":"PJ","idConsultado":"90000000000000000001"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/enriquecimento-lead":{"get":{"summary":"Enriquecimento de Lead","description":"Retorna dados de cadastro de um CPF a partir de e-mail e/ou celular, combinando fontes oficiais com inferências para enriquecimento e qualificação de leads.\n\nObrigatório informar pelo menos um de: celular ou email.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"enriquecimento-lead","tags":["Comercial"],"parameters":[{"name":"email","in":"query","required":false,"description":"Endereço de e-mail do contato a identificar. Via de entrada alternativa a `celular` — envie ao menos um dos dois, ou ambos para enriquecer o resultado.","schema":{"type":"string"}},{"name":"celular","in":"query","required":false,"description":"Telefone celular do contato, aceito com ou sem formatação. Via de entrada alternativa a `email` — envie ao menos um dos dois; se informado, precisa ser um número válido, senão a consulta inteira é rejeitada.","schema":{"type":"string"}}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"cpf":{"type":["string","null"],"description":"CPF do indivíduo."},"nome":{"type":["string","null"],"description":"Nome do indivíduo."},"sexo":{"type":["string","null"],"description":"Gênero do indivíduo."},"idade":{"type":["integer","null"],"description":"Idade do indivíduo."},"signo":{"type":["string","null"],"description":"Signo do indivíduo."},"emails":{"type":["array","null"],"items":{"type":"object","properties":{"enderecoEmail":{"type":["string","null"],"description":"Endereço de e-mail."}}},"description":"Lista de endereços de e-mail."},"nomeMae":{"type":["string","null"],"description":"Nome da mãe do indivíduo."},"enderecos":{"type":["array","null"],"items":{"type":"object","properties":{"uf":{"type":["string","null"],"description":"Unidade Federativa do endereço."},"cep":{"type":["string","null"],"description":"CEP do endereço."},"bairro":{"type":["string","null"],"description":"Bairro do endereço."},"cidade":{"type":["string","null"],"description":"Cidade do endereço."},"numero":{"type":["string","null"],"description":"Número do endereço."},"logradouro":{"type":["string","null"],"description":"Logradouro do endereço."},"complemento":{"type":["string","null"],"description":"Complemento do endereço."}}},"description":"Lista de endereços."},"telefones":{"type":["array","null"],"items":{"type":"object","properties":{"whatsApp":{"type":["boolean","null"],"description":"Indica se o telefone está vinculado ao WhatsApp."},"operadora":{"type":["string","null"],"description":"Operadora do telefone."},"tipoTelefone":{"type":["string","null"],"description":"Tipo do telefone."},"telefoneComDDD":{"type":["string","null"],"description":"Número de telefone com DDD."},"telemarketingBloqueado":{"type":["boolean","null"],"description":"Indica se o telefone está bloqueado para telemarketing."}}},"description":"Lista de telefones."},"rendaEstimada":{"type":["string","null"],"description":"Renda estimada do indivíduo."},"dataNascimento":{"type":["string","null"],"description":"Data de nascimento do indivíduo."},"rendaFaixaSalarial":{"type":["string","null"],"description":"Faixa salarial estimada."}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"cpf":"***","nome":"***","sexo":"***","idade":0,"signo":null,"emails":[],"nomeMae":"***","enderecos":[{"uf":"GO","cep":"***","bairro":"***","cidade":"GOIANIA","numero":null,"logradouro":"***","complemento":"***"},{"uf":"RJ","cep":"***","bairro":"***","cidade":"RIO DE JANEIRO","numero":"435","logradouro":"***","complemento":"***"}],"telefones":[{"whatsApp":null,"operadora":null,"tipoTelefone":null,"telefoneComDDD":"***","telemarketingBloqueado":null},{"whatsApp":null,"operadora":null,"tipoTelefone":null,"telefoneComDDD":"***","telemarketingBloqueado":null},{"whatsApp":null,"operadora":null,"tipoTelefone":null,"telefoneComDDD":"***","telemarketingBloqueado":null},{"whatsApp":null,"operadora":null,"tipoTelefone":null,"telefoneComDDD":"***","telemarketingBloqueado":null},{"whatsApp":null,"operadora":null,"tipoTelefone":null,"telefoneComDDD":"***","telemarketingBloqueado":null}],"rendaEstimada":"***","dataNascimento":"***","rendaFaixaSalarial":"Faixa 1 salário mínimo"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["celular","email"]],"x-empty-as-negative":true}},"/api/v1/consulta/leads-endereco":{"post":{"summary":"Leads por Endereço","description":"Lista os registros de pessoas e empresas associados a um endereço, a partir do CEP e do número. Use para prospecção e para descobrir quem está ligado a um imóvel.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"leads-endereco","tags":["Comercial"],"parameters":[{"name":"cep","in":"query","required":true,"description":"CEP do endereço, com ou sem hífen (ex.: 11700-200 ou 11700200).","schema":{"type":"string","pattern":"^\\s*[0-9]{5}-?[0-9]{3}\\s*$"}},{"name":"numero","in":"query","required":false,"description":"Número do imóvel. Sem ele a busca devolve todo o CEP, que pode cobrir a rua inteira — informe o número para restringir ao endereço.","schema":{"type":"string","pattern":"^\\s*[0-9A-Za-z./ -]{1,15}\\s*$"}},{"name":"tipo_pessoa","in":"query","required":false,"description":"Filtra o resultado: PF (pessoas físicas) ou PJ (empresas). Sem o filtro, retorna os dois.","schema":{"type":"string","format":"upper","pattern":"^\\s*(PF|PJ)\\s*$"}}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"leads":{"type":["array","null"],"items":{"type":"object","properties":{"id":{"type":["string","integer","null"],"description":"Identificador do registro na base de origem. Informe-o no parâmetro `id` da consulta Contato do Lead. Use na sequência da busca — não é um identificador permanente."},"cnae":{"type":["string","integer","null"],"description":"Código CNAE da atividade principal, quando o registro é empresa. Nulo para pessoa física."},"nome":{"type":["string","null"],"description":"Razão social completa quando o registro é empresa; nome parcialmente mascarado quando é pessoa física."},"documento":{"type":["string","null"],"description":"CNPJ completo quando o registro é empresa; CPF parcialmente mascarado quando é pessoa física."},"tipoPessoa":{"type":["string","null"],"description":"PF para pessoa física, PJ para empresa."}}},"description":"Todos os registros contados em `totalLeads` — a lista não é truncada nem paginada. Para obter telefone e e-mail, use o `id` na consulta Contato do Lead."},"totalLeads":{"type":["integer","null"],"description":"Total de registros localizados. Quando o número do imóvel é informado, refere-se ao endereço; sem ele, ao CEP inteiro — que pode cobrir a rua toda."},"enderecoConsultado":{"type":["object","null"],"properties":{"cep":{"type":["string","null"],"description":"CEP consultado, somente dígitos."},"numero":{"type":["string","null"],"description":"Número do imóvel, quando informado."},"tipoPessoa":{"type":["string","null"],"description":"Filtro aplicado (PF ou PJ), quando informado."}},"description":"Eco dos parâmetros usados na busca."},"totalPessoasFisicas":{"type":["integer","null"],"description":"Quantos dos registros são pessoas físicas."},"totalPessoasJuridicas":{"type":["integer","null"],"description":"Quantos dos registros são empresas."}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"leads":[{"id":"90000000000000000001","cnae":"8112500","nome":"CONDOMINIO EDIFICIO EXEMPLO","documento":"11111111000111","tipoPessoa":"PJ"},{"id":"90000000000000000002","cnae":null,"nome":"FULANO ****** *******","documento":"000***000**","tipoPessoa":"PF"}],"totalLeads":12,"enderecoConsultado":{"cep":"00000000","numero":"100","tipoPessoa":null},"totalPessoasFisicas":10,"totalPessoasJuridicas":2}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/acordos-leniencia":{"get":{"summary":"Acordos de Leniência","description":"Consulta dados sobre Acordos de Leniência conforme Lei Anticorrupção nº 12.846/2013, retornando informações sobre acordos celebrados entre administração pública e pessoas jurídicas colaboradoras, incl\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"acordos-leniencia","tags":["Compliance & Risco"],"parameters":[{"name":"cnpj","in":"query","required":true,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":"object","properties":{"consta":{"type":["boolean","null"]},"acordos":{"type":["array","null"],"items":{"type":"object","properties":{"sancoes":{"type":["array","null"],"items":{"type":"object","properties":{"cnpj":{"type":["string","null"]},"razaoSocial":{"type":["string","null"]},"nomeFantasia":{"type":["string","null"]}}}},"numeroRegistro":{"type":["number","null"]},"quantidadeSancoes":{"type":["number","null"]},"detalhamentoAcordo":{"type":["object","null"],"properties":{"dataFimAcordo":{"type":["string","null"]},"situacaoAcordo":{"type":["string","null"]},"dataInicioAcordo":{"type":["string","null"]},"orgaoResponsavel":{"type":["string","null"]}}}}}},"mensagem":{"type":["string","null"]},"parametros":{"type":["object","null"]},"observacoes":{"type":["string","null"]},"razaoSocial":{"type":["string","null"]},"totalSancoes":{"type":["number","null"]},"constamAcordos":{"type":["boolean","null"]},"quantidadeAcordos":{"type":["number","null"]},"documentoConsultado":{"type":["string","null"]}}},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]},"example":{"acordos":[{"sancoes":[],"numeroRegistro":900001,"quantidadeSancoes":0,"detalhamentoAcordo":{"dataFimAcordo":"30/01/2025 00:00:00","situacaoAcordo":"Em Execução","dataInicioAcordo":"31/05/2019 00:00:00","orgaoResponsavel":"Controladoria-Geral da União - Unidades com vínculo direto"}}],"observacoes":"Foi encontrado um resultado compatível com a pesquisa.","razaoSocial":"INDUSTRIAS REUNIDAS VALE VERDE S.A","totalSancoes":0,"constamAcordos":true,"quantidadeAcordos":1,"documentoConsultado":"22222222000122"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-empty-as-negative":true}},"/api/v1/consulta/oab-advogados":{"get":{"summary":"Advogados — Cadastro Nacional (OAB)","description":"Localiza profissionais inscritos no Cadastro Nacional dos Advogados da OAB, retornando a lista de advogados e estagiários que correspondem à busca, com número de inscrição, seccional (UF) e tipo de inscrição. Útil para conferir se um advogado possui registro válido e em qual estado atua.\n\nObrigatório informar pelo menos um de: nome ou inscricao.","operationId":"oab-advogados","tags":["Compliance & Risco"],"parameters":[{"name":"nome","in":"query","required":false,"description":"Nome completo ou parcial do advogado. Retorna todos os homônimos e nomes semelhantes de todas as seccionais.","schema":{"type":"string"},"example":"Fulano de Tal"},{"name":"inscricao","in":"query","required":false,"description":"Número de inscrição do profissional na OAB (só dígitos, sem a sigla da UF). Use junto com `uf` para identificar um registro único.","schema":{"type":"string"}},{"name":"uf","in":"query","required":false,"description":"Sigla da seccional (UF) onde a inscrição foi emitida — 2 letras (ex.: SP, MG). Acompanha o parâmetro `inscricao`. Aceita minúsculas.","schema":{"type":"string","format":"upper","enum":["AC","AL","AP","AM","BA","CE","DF","ES","GO","MA","MT","MS","MG","PA","PB","PR","PE","PI","RJ","RN","RS","RO","RR","SC","SP","SE","TO"]},"example":"SP"},{"name":"comprovante","in":"query","required":false,"description":"Inclui o comprovante da consulta (link válido por 7 dias). Acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue.","schema":{"type":"boolean"},"example":true}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"uf":{"type":["string","null"],"description":"Seccional (UF) informada na consulta, quando a busca é feita por inscrição."},"advogados":{"type":["array","null"],"items":{"type":"object","properties":{"uf":{"type":["string","null"],"description":"Sigla da seccional em que o profissional está inscrito."},"foto":{"type":["string","null"],"description":"Foto do profissional (URL ou conteúdo), quando disponível."},"nome":{"type":["string","null"],"description":"Nome do profissional conforme cadastro da OAB."},"endereco":{"type":["object","null"],"properties":{"cep":{"type":["string","null"],"description":"CEP do endereço profissional."},"bairro":{"type":["string","null"],"description":"Bairro do endereço profissional."},"cidade":{"type":["string","null"],"description":"Cidade do endereço profissional."},"numero":{"type":["string","null"],"description":"Número do endereço profissional."},"logradouro":{"type":["string","null"],"description":"Logradouro do endereço profissional."},"complemento":{"type":["string","null"],"description":"Complemento do endereço profissional."}},"description":"Endereço profissional, quando disponível."},"situacao":{"type":["string","null"],"description":"Situação do registro, quando disponível."},"telefone":{"type":["string","null"],"description":"Telefone de contato profissional, quando disponível."},"inscricao":{"type":["string","null"],"description":"Número de inscrição do profissional na OAB."},"nomeSocial":{"type":["string","null"],"description":"Nome social do profissional, quando registrado."},"organizacao":{"type":["string","null"],"description":"Sociedade ou organização vinculada, quando disponível."},"tipoInscricao":{"type":["string","null"],"description":"Categoria do registro (ex.: ADVOGADO, ESTAGIÁRIO)."}}},"description":"Lista de profissionais que correspondem aos critérios da busca."},"inscricao":{"type":["string","null"],"description":"Número de inscrição informado na consulta, quando a busca é feita por inscrição."},"observacoes":{"type":["string","null"],"description":"Resumo textual do resultado da consulta, com a quantidade de registros encontrados."},"nomePesquisado":{"type":["string","null"],"description":"Nome informado na consulta, quando a busca é feita por nome."},"possuiRegistros":{"type":["boolean","null"],"description":"Indica se algum profissional foi localizado na base."},"comprovante":{"type":"array","description":"Comprovante da consulta: o documento emitido pela fonte, num link aberto para você guardar. Só vem quando você pede com o parâmetro `comprovante` (acréscimo de 25% sobre o preço da consulta, cobrado somente quando o comprovante é entregue). O link vale por 7 dias a partir da emissão e o arquivo pode levar alguns segundos para ficar disponível. Chave opcional: leia como ausente quando não vier.","items":{"type":"string","format":"uri"}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["nome","inscricao"]]}},"/api/v1/consulta/cvm-processos-sancionadores":{"get":{"summary":"CVM — Processos Sancionadores","description":"Levanta os Processos Administrativos Sancionadores (PAS) da CVM associados a um CPF ou CNPJ, detalhando cada processo, sua fase e movimentações e os acusados envolvidos. Serve para avaliar risco regulatório e histórico de infrações no mercado de capitais.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"cvm-processos-sancionadores","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":["object","null"],"properties":{"consta":{"type":["boolean","null"],"description":"Presente apenas no nada consta: false quando a consulta foi concluída e não localizou registro para o documento."},"mensagem":{"type":["string","null"],"description":"Presente apenas no nada consta: \"Nada consta para os parâmetros informados.\""},"processos":{"type":["array","null"],"items":{"type":"object","properties":{"ementa":{"type":["string","null"],"description":"Ementa do processo."},"acusados":{"type":["array","null"],"items":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome do acusado."},"situacao":{"type":["string","null"],"description":"Situação processual do acusado."},"dataSituacao":{"type":["string","null"],"description":"Data da situação do acusado."}}},"description":"Acusados no processo."},"faseAtual":{"type":["string","null"],"description":"Fase atual do processo."},"localAtual":{"type":["string","null"],"description":"Local atual do processo."},"dataAbertura":{"type":["string","null"],"description":"Data de abertura do processo."},"subfaseAtual":{"type":["string","null"],"description":"Subfase atual do processo."},"assuntoObjeto":{"type":["string","null"],"description":"Assunto ou objeto do processo."},"movimentacoes":{"type":["array","null"],"items":{"type":"object","properties":{"local":{"type":["string","null"],"description":"Local da movimentação."},"subfase":{"type":["string","null"],"description":"Subfase da movimentação."},"dataMovimentacao":{"type":["string","null"],"description":"Data da movimentação."}}},"description":"Histórico de movimentações do processo."},"totalAcusados":{"type":["integer","null"],"description":"Total de acusados no processo."},"numeroProcesso":{"type":["string","null"],"description":"Número do processo."},"processoEncerrado":{"type":["boolean","null"],"description":"Indica se o processo está encerrado."},"encarregadoInstrucao":{"type":["string","null"],"description":"Encarregado da instrução do processo."},"dataUltimaMudancaFase":{"type":["string","null"],"description":"Data da última mudança de fase."},"dataRelatorioInquerito":{"type":["string","null"],"description":"Data do relatório ou inquérito."},"dataUltimaMovimentacaoLocal":{"type":["string","null"],"description":"Data da última movimentação de local."}}},"description":"Lista de processos administrativos sancionadores."},"parametros":{"type":["object","null"],"description":"Presente apenas no nada consta: eco dos parâmetros informados (cpf ou cnpj)."},"observacoes":{"type":["string","null"],"description":"Observações gerais sobre o resultado."},"nomeEntidade":{"type":["string","null"],"description":"Nome ou razão social vinculada ao documento."},"possuiProcesso":{"type":["boolean","null"],"description":"Indica se o documento possui processos sancionadores."},"totalProcessos":{"type":["integer","null"],"description":"Quantidade total de processos encontrados."},"documentoConsultado":{"type":["string","null"],"description":"CPF ou CNPJ informado na consulta."}},"description":"Resumo e lista de processos sancionadores."},{"type":"object","description":"Resultado negativo: nada consta para os parâmetros informados.","required":["consta","mensagem","parametros"],"properties":{"consta":{"type":"boolean","enum":[false],"description":"Sempre `false`: nada consta."},"mensagem":{"type":"string","description":"Explicação do resultado negativo."},"parametros":{"type":"object","additionalProperties":true,"description":"Os parâmetros consultados, como foram recebidos."}},"additionalProperties":false}]}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]],"x-empty-as-negative":true}},"/api/v1/consulta/cvm-valores-mobiliarios":{"get":{"summary":"CVM — Valores Mobiliários","description":"Verifica se um CPF ou CNPJ está registrado na CVM como participante do mercado de valores mobiliários, trazendo o cadastro da entidade (código CVM, situação, categoria, patrimônio líquido) e a relação de diretores. Útil para due diligence, compliance e checagem de emissores e agentes regulados.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.\n\nQuando nada consta para os parâmetros informados, a resposta é `200` com corpo `{\"consta\": false, \"mensagem\": \"...\", \"parametros\": {...}}` — resultado negativo autoritativo, cobrado normalmente. O `404` fica restrito a recurso inexistente.","operationId":"cvm-valores-mobiliarios","tags":["Compliance & Risco"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso (inclui resultado negativo)","content":{"application/json":{"schema":{"anyOf":[{"type":["object","null"],"properties":{"uf":{"type":["string","null"],"description":"Unidade federativa do endereço."},"cep":{"type":["string","null"],"description":"CEP do endereço cadastrado."},"bairro":{"type":["string","null"],"description":"Bairro do endereço cadastrado."},"cidade":{"type":["string","null"],"description":"Cidade do endereço cadastrado."},"consta":{"type":["boolean","null"],"description":"Presente apenas no nada consta: false quando a consulta foi concluída e não localizou registro para o documento."},"website":{"type":["string","null"],"description":"Website da entidade."},"endereco":{"type":["string","null"],"description":"Logradouro do endereço cadastrado."},"mensagem":{"type":["string","null"],"description":"Presente apenas no nada consta: \"Nada consta para os parâmetros informados.\""},"situacao":{"type":["string","null"],"description":"Situação atual do registro."},"telefone":{"type":["string","null"],"description":"Telefone de contato da entidade."},"categoria":{"type":["string","null"],"description":"Categoria da entidade no mercado."},"codigoCVM":{"type":["string","null"],"description":"Código identificador da entidade na CVM."},"diretores":{"type":["array","null"],"items":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome do diretor."},"instrucao":{"type":["string","null"],"description":"Instrução normativa aplicável ao cargo."},"dataInicio":{"type":["string","null"],"description":"Data de início do mandato."}}},"description":"Diretores vinculados à entidade."},"parametros":{"type":["object","null"],"description":"Presente apenas no nada consta: eco dos parâmetros informados (cpf ou cnpj)."},"dataRegistro":{"type":["string","null"],"description":"Data de registro na CVM."},"dataSituacao":{"type":["string","null"],"description":"Data da situação atual."},"nomeEntidade":{"type":["string","null"],"description":"Nome ou razão social da entidade registrada."},"categoriaRegistro":{"type":["string","nul