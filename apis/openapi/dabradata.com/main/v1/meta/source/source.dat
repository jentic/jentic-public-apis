hema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"processos":{"type":["array","null"],"items":{"type":"object","properties":{"grau":{"type":["string","null"],"description":"Instância ou grau de jurisdição."},"classe":{"type":["string","null"],"description":"Classe processual."},"partes":{"type":["array","null"],"items":{"type":"object","properties":{"polo":{"type":["string","null"],"description":"Polo em que a parte atua (ativo, passivo, neutro)."},"tipo":{"type":["string","null"],"description":"Papel processual da parte (ex.: AGRAVANTE, REQUERIDO)."},"documento":{"type":["string","null"],"description":"CPF ou CNPJ da parte, quando disponível."},"tipoPessoa":{"type":["string","null"],"description":"Natureza da parte (física ou jurídica)."},"nomeCompleto":{"type":["string","null"],"description":"Nome ou razão social da parte."}}},"description":"Relação das partes envolvidas no processo."},"status":{"type":["string","null"],"description":"Situação do processo (ex.: ATIVO, ARQUIVADO)."},"segmento":{"type":["string","null"],"description":"Segmento da Justiça (ex.: Justiça Estadual)."},"tribunal":{"type":["string","null"],"description":"Sigla do tribunal onde o processo tramita."},"valorAcao":{"type":["number","null"],"description":"Valor da causa, em reais."},"numeroProcesso":{"type":["string","null"],"description":"Número do processo (padrão CNJ ou numeração do tribunal)."},"dataAjuizamento":{"type":["string","null"],"description":"Data de ajuizamento do processo, quando disponível."},"assuntoPrincipal":{"type":["string","null"],"description":"Assunto ou tema principal do processo."},"ultimaMovimentacao":{"type":["object","null"],"properties":{"data":{"type":["string","null"],"descripti