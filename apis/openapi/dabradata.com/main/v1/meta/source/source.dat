"Im"},"xNome":{"anyOf":[{"type":"string","maxLength":300,"minLength":1},{"type":"null"}],"title":"Xnome"},"end":{"anyOf":[{"$ref":"#/components/schemas/NfseEndereco"},{"type":"null"}]},"fone":{"anyOf":[{"type":"string","pattern":"^[0-9]{6,20}$"},{"type":"null"}],"title":"Fone"},"email":{"anyOf":[{"type":"string","maxLength":80,"minLength":1},{"type":"null"}],"title":"Email"}},"additionalProperties":false,"type":"object","title":"TomadorAlteracao","description":"PATCH do tomador de uma nota em quarentena: só os campos enviados mudam (`end` inteiro); `null` apaga o campo; um\ndocumento enviado substitui o anterior."},"NfseValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}},"responses":{"Error400":{"description":"Parâmetros inválidos","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Error401":{"description":"Não autenticado","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Error402":{"description":"Saldo insuficiente","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Error404":{"description":"Recurso não encontrado","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Error429":{"description":"Limite de requisições excedido","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Error500":{"description":"Erro interno","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}