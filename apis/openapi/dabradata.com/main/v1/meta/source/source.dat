efones":{"type":["array","null"],"items":{"type":["object","null"],"properties":{"whatsApp":{"type":["boolean","null"],"description":"Indica se o telefone está vinculado ao WhatsApp."},"operadora":{"type":["string","null"],"description":"Nome da operadora de telecomunicações."},"tipoTelefone":{"type":["string","null"],"description":"Tipo de telefone (comercial, celular, fixo, etc)."},"telefoneComDDD":{"type":["string","null"],"description":"Número de telefone incluindo o código de área."},"telemarketingBloqueado":{"type":["boolean","null"],"description":"Indica se o telefone está bloqueado para telemarketing."}}},"description":"Lista de telefones de contato da empresa."},"cnaeCodigo":{"type":["number","null"],"description":"Código numérico da classificação de atividade econômica principal."},"tributacao":{"type":["string","null"],"description":"Tipo ou regime de tributação adotado pela empresa."},"razaoSocial":{"type":["string","null"],"description":"Razão social registrada da empresa."},"tipoEmpresa":{"type":["string","null"],"description":"Tipo de constituição legal da empresa."},"dataFundacao":{"type":["string","null"],"description":"Data de fundação da empresa no formato dd/MM/yyyy HH:mm:ss."},"nomeFantasia":{"type":["string","null"],"description":"Nome fantasia ou nome de marca da empresa."},"opcaoSimples":{"type":["string","null"],"description":"Indica se a empresa é optante do regime tributário simplificado."},"orgaoPublico":{"type":["string","null"],"description":"Indicação se a empresa possui relação com órgão público."},"cnaeDescricao":{"type":["string","null"],"description":"Descrição textual da classificação de atividade econômica principal."},"cnaEsSecundarios":{"type":["array","null"],"items":{"type":["object","null"],"properties":{"cnaeCodigoSecundario":{"type":["number","null"],"description":"Código da atividade econômica secundária."},"cnaeDescricaoSecundario":{"type":["string","null"],"description":"Descrição da atividade econômica secundária."}}},"description":"Lista de classificações de atividades econômicas secundárias."},"faixaFaturamento":{"type":["string","null"],"description":"Faixa estimada de faturamento anual da empresa."},"situacaoEspecial":{"type":["string","null"],"description":"Situação especial ou regime especial da empresa, se aplicável."},"faixaFuncionarios":{"type":["string","null"],"description":"Faixa estimada de quantidade de funcionários."},"quantidadeFiliais":{"type":["string","null"],"description":"Quantidade de filiais que a empresa possui."},"situacaoCadastral":{"type":["string","null"],"description":"Situação cadastral da empresa junto aos órgãos reguladores."},"ultimaAtualizacaoPJ":{"type":["string","null"],"description":"Data da última atualização dos dados cadastrais da empresa."},"faturamentoMedioCNAE":{"type":["string","null"],"description":"Faturamento médio de empresas do mesmo segmento de atividade."},"faturamentoPresumido":{"type":["string","null"],"description":"Estimativa de faturamento presumido da empresa."},"naturezaJuridicaTipo":{"type":["string","null"],"description":"Tipo ou classificação da natureza jurídica."},"naturezaJuridicaCodigo":{"type":["number","null"],"description":"Código identificador da natureza jurídica da empresa."},"quantidadeFuncionarios":{"type":["number","null"],"description":"Quantidade estimada de funcionários da empresa."},"naturezaJuridicaDescricao":{"type":["string","null"],"description":"Descrição da natureza jurídica da empresa."}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/participacao-societaria":{"get":{"summary":"Participação Societária — percentual por sócio","description":"Percentual do capital detido por cada sócio de um CNPJ, com o documento completo (CPF ou CNPJ) de cada um. É a única consulta do catálogo que informa QUANTO cada sócio detém — nenhuma fonte cadastral pública divulga percentual. Traz apenas os vínculos diretos e vigentes: para vínculo indireto, histórico, empresas controladas ou a cadeia até o beneficiário final, use a consulta de vínculos societários (UBO).","operationId":"participacao-societaria","tags":["Pessoa Jurídica"],"parameters":[{"name":"cnpj","in":"query","required":true,"description":"CNPJ da empresa consultada, com ou sem máscara (`00000000000000` ou `00.000.000/0000-00`). O dígito verificador é validado antes da consulta.","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"cnpj":{"type":["string","null"],"description":"CNPJ consultado, no formato 00.000.000/0000-00. É o eco do parâmetro enviado — a origem não devolve o documento da consultada."},"socios":{"type":["array","null"],"items":{"type":"object","properties":{"nome":{"type":["string","null"],"description":"Nome completo (pessoa física) ou razão social (pessoa jurídica) do participante."},"papel":{"type":["string","null"],"description":"Papel na sociedade conforme a origem — ex.: `SOCIO`, `SOCIO-ADMINISTRADOR`, `ADMINISTRADOR`. Quem aparece como `ADMINISTRADOR` puro costuma vir com `percentual` 0."},"documento":{"type":["string","null"],"description":"CPF (000.000.000-00) ou CNPJ (00.000.000/0000-00) do participante, COMPLETO — sem a máscara de ocultação das consultas cadastrais públicas. Vem vazio quando o participante é estrangeiro sem documento brasileiro (observado em ~4,6% dos itens); nesses casos identifique pelo `nome`."},"percentual":{"type":["number","null"],"description":"Percentual do capital detido, de 0 a 100. É o campo que só esta consulta entrega — nenhuma fonte cadastral pública informa quanto cada sócio detém. Pode vir com muitas casas decimais (ex.: 49.75124378). O valor 0 significa participante sem cota (tipicamente administrador), não dado ausente."},"dataEntrada":{"type":["string","null"],"description":"Data de entrada na sociedade, `AAAA-MM-DD`. ATENÇÃO: a origem carimba parte dos registros com uma data de carga (`2017-01-01` é a mais comum) em vez da data real de entrada, e usa `0001-01-01` para data desconhecida. Quando a data de entrada for decisiva, confirme pelo quadro societário da Receita Federal (consulta `vinculos-ubo`), que traz a data registrada."},"tipoDocumento":{"type":["string","null"],"description":"`CPF` ou `CNPJ`. Vem vazio junto com `documento` no caso do participante estrangeiro."},"indicioDeDebito":{"type":["boolean","null"],"description":"Sinalização de débito do participante feita pela origem, sem detalhamento do que a originou. Trate como pista para aprofundar (consulta de dívidas/protestos), nunca como fato. Ausente em parte das respostas."},"indicioDeFraude":{"type":["boolean","null"],"description":"Sinalização de indício de fraude do participante feita pela origem, sem detalhamento do que a originou. Trate como pista para aprofundar, nunca como fato — e não comunique ao titular como conclusão. Ausente em parte das respostas."},"situacaoDocumento":{"type":["string","null"],"description":"Situação do documento do participante na Receita Federal — `REGULAR` para CPF, `ATIVA`/`ATIVO` para CNPJ. É a situação do participante, não da empresa consultada."},"podeAssinarPelaEmpresa":{"type":["boolean","null"],"description":"Indica que o participante tem poder de assinatura pela empresa segundo a origem. Serve para orientar quem procurar; não substitui a leitura do contrato social."}}},"description":"Participantes da empresa com o percentual de cada um. Lista de vínculos DIRETOS e VIGENTES: esta consulta não traz vínculo indireto (sócio que entra via holding), não traz vínculo encerrado e não traz as empresas controladas pela consultada — para isso use `vinculos-ubo`."},"totalSocios":{"type":["integer","null"],"description":"Quantidade de participantes retornados em `socios`. Inclui quem aparece com participação 0% (administrador sem cota), por isso não é o número de detentores de capital."},"ultimaEntrada":{"type":["string","null"],"description":"Data de entrada mais recente do quadro, `AAAA-MM-DD`. Sujeita à mesma ressalva de `socios[].dataEntrada`."},"primeiraEntrada":{"type":["string","null"],"description":"Data de entrada mais antiga do quadro, `AAAA-MM-DD`. Sujeita à mesma ressalva de `socios[].dataEntrada`."},"maiorParticipacao":{"type":["number","null"],"description":"Maior percentual entre os participantes."},"menorParticipacao":{"type":["number","null"],"description":"Menor percentual entre os participantes. Vem 0 sempre que há administrador sem cota na lista."},"participacaoMedia":{"type":["number","null"],"description":"Média aritmética simples dos percentuais, administradores de 0% incluídos — não é participação média dos detentores de capital."},"temSocioMajoritario":{"type":["boolean","null"],"description":"`true` quando algum participante detém mais da metade do capital. Calculado pela origem sobre os percentuais desta resposta."},"totalPessoasFisicas":{"type":["integer","null"],"description":"Quantos dos participantes são pessoa física (CPF)."},"totalPessoasJuridicas":{"type":["integer","null"],"description":"Quantos dos participantes são pessoa jurídica (CNPJ). Sócio PJ é o ponto onde a cadeia continua: consulte o CNPJ dele para subir mais um nível."}}},"example":{"cnpj":"11.111.111/0001-11","socios":[{"nome":"MARIA EXEMPLO DA SILVA","papel":"SOCIO-ADMINISTRADOR","documento":"111.111.111-11","percentual":60,"dataEntrada":"2018-03-12","tipoDocumento":"CPF","indicioDeDebito":false,"indicioDeFraude":false,"situacaoDocumento":"REGULAR","podeAssinarPelaEmpresa":true},{"nome":"HOLDING EXEMPLO PARTICIPACOES LTDA","papel":"SOCIO","documento":"22.222.222/0001-22","percentual":40,"dataEntrada":"2020-09-01","tipoDocumento":"CNPJ","indicioDeDebito":false,"indicioDeFraude":false,"situacaoDocumento":"ATIVA","podeAssinarPelaEmpresa":true},{"nome":"JOSE EXEMPLO PEREIRA","papel":"ADMINISTRADOR","documento":"222.222.222-22","percentual":0,"dataEntrada":"2019-05-20","tipoDocumento":"CPF","indicioDeDebito":false,"indicioDeFraude":false,"situacaoDocumento":"REGULAR","podeAssinarPelaEmpresa":false}],"totalSocios":3,"ultimaEntrada":"2020-09-01","primeiraEntrada":"2018-03-12","maiorParticipacao":60,"menorParticipacao":0,"participacaoMedia":33.33333333,"temSocioMajoritario":true,"totalPessoasFisicas":2,"totalPessoasJuridicas":1}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/vinculos-societarios-bases":{"get":{"summary":"Participações Societárias do CPF (base Receita Federal)","description":"Mapeia as participações societárias de um CPF a partir do Quadro de Sócios e Administradores (QSA) da Receita Federal — empresas onde a pessoa é sócia, com qualificação, data de entrada e situação cadastral.","operationId":"vinculos-societarios-bases","tags":["Pessoa Jurídica"],"parameters":[{"name":"cpf","in":"query","required":true,"description":"CPF da pessoa física. Aceita com ou sem pontuação. É o único parâmetro necessário.","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"safra":{"type":["string","null"],"description":"Data de referência (safra) da base da Receita Federal utilizada na consulta."},"vinculos":{"type":["array","null"],"items":{"type":"object","properties":{"uf":{"type":["string","null"],"description":"UF da empresa."},"cnpj":{"type":["string","null"],"description":"CNPJ da empresa."},"dataEntrada":{"type":["string","null"],"description":"Data de entrada na sociedade (AAAA-MM-DD)."},"razaoSocial":{"type":["string","null"],"description":"Razão social da empresa."},"nomeFantasia":{"type":["string","null"],"description":"Nome fantasia da empresa, quando houver."},"qualificacao":{"type":["string","null"],"description":"Qualificação do vínculo (ex.: Sócio, Sócio-Administrador, Administrador)."},"situacaoCadastral":{"type":["string","null"],"description":"Situação cadastral da empresa (ATIVA, BAIXADA, etc.)."},"qualificacaoCodigo":{"type":["string","null"],"description":"Código oficial da qualificação do sócio."}}},"description":"Lista das empresas em que a pessoa participa."},"cpfConsultado":{"type":["string","null"],"description":"CPF consultado (parcialmente mascarado)."},"totalVinculos":{"type":["number","null"],"description":"Quantidade de vínculos societários encontrados."},"nomeConsultado":{"type":["string","null"],"description":"Nome do titular do CPF."}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/cadin-prefeitura-sp":{"get":{"summary":"Prefeitura SP - CADIN","description":"Consulta pendências no CADIN da Prefeitura de São Paulo por CNPJ ou CPF. Retorna mensagem e lista de pendências com órgão responsável e local para regularização.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.","operationId":"cadin-prefeitura-sp","tags":["Pessoa Jurídica"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF (somente números, 11 dígitos)","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object"}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}},"x-one-of-groups":[["cpf","cnpj"]]}},"/api/v1/consulta/relacao-filiais":{"get":{"summary":"Relação de Filiais","description":"Retorna todos os estabelecimentos (matriz e filiais) vinculados a um CNPJ numa única chamada, sem paginação, com endereço, situação cadastral e dados de contato da RF. Informe o CNPJ completo (14 dígitos) de qualquer estabelecimento do grupo — matriz ou filial.","operationId":"relacao-filiais","tags":["Pessoa Jurídica"],"parameters":[{"name":"cnpj","in":"query","required":true,"description":"CNPJ (somente números, 14 dígitos)","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"porte":{"type":["string","null"],"description":"Porte da empresa."},"razaoSocial":{"type":["string","null"],"description":"Razão social da empresa."},"totalAtivos":{"type":["number","null"],"description":"Total de estabelecimentos ativos."},"capitalSocial":{"type":["string","null"],"format":"currency","description":"Capital social da empresa."},"cnpjConsultado":{"type":["string","null"],"format":"cnpj","description":"CNPJ consultado."},"estabelecimentos":{"type":["array","null"],"items":{"type":"object","properties":{"cnpj":{"type":["string","null"],"format":"cnpj","description":"CNPJ do estabelecimento"},"tipo":{"type":["string","null"],"description":"Tipo (matriz ou filial)"},"email":{"type":["string","null"],"description":"E-mail"},"endereco":{"type":["object","null"],"properties":{"uf":{"description":"UF"},"cep":{"format":"cep","description":"CEP"},"bairro":{"description":"Bairro"},"numero":{"description":"Número"},"municipio":{"description":"Município"},"logradouro":{"description":"Logradouro"},"complemento":{"description":"Complemento"}},"description":"Endereço"},"telefone":{"type":["string","null"],"description":"Telefone"},"dataSituacao":{"type":["string","null"],"format":"date","description":"Data da situação"},"nomeFantasia":{"type":["string","null"],"description":"Nome fantasia"},"cnaePrincipal":{"type":["string","null"],"description":"CNAE principal"},"situacaoCadastral":{"type":["string","null"],"description":"Situação cadastral"},"dataInicioAtividade":{"type":["string","null"],"format":"date","description":"Início da atividade"}}},"description":"Lista de estabelecimentos (matriz e filiais)."},"totalEstabelecimentos":{"type":["number","null"],"description":"Total de estabelecimentos (matriz + filiais)."}}},"example":{"porte":"EMPRESA DE PEQUENO PORTE","razaoSocial":"COMERCIAL NORDESTE DISTRIBUIDORA LTDA","totalAtivos":2,"capitalSocial":"500000.00","cnpjConsultado":"22.222.222/0001-22","estabelecimentos":[{"cnpj":"22.222.222/0001-22","tipo":"MATRIZ","email":"FINANCEIRO@EXEMPLO.COM.BR","endereco":{"uf":"SP","cep":"01310-100","bairro":"BELA VISTA","numero":"1500","municipio":"SAO PAULO","logradouro":"AVENIDA PAULISTA 1500","complemento":"SALA 12"},"telefone":"(11) 0000-0001","dataSituacao":"2015-11-03","nomeFantasia":"NORDESTE DISTRIB","cnaePrincipal":"4669999","situacaoCadastral":"ATIVA","dataInicioAtividade":"2010-04-18"},{"cnpj":"22.222.222/0001-22","tipo":"FILIAL","email":"FISCAL@EXEMPLO.COM.BR","endereco":{"uf":"RJ","cep":"22041-001","bairro":"COPACABANA","numero":"300","municipio":"RIO DE JANEIRO","logradouro":"RUA BARATA RIBEIRO 300","complemento":""},"telefone":"(21) 0000-0002","dataSituacao":"2022-09-27","nomeFantasia":"NORDESTE DISTRIB","cnaePrincipal":"4757100","situacaoCadastral":"ATIVA","dataInicioAtividade":"2018-02-24"},{"cnpj":"22.222.222/0001-22","tipo":"FILIAL","email":"CONTATO@EXEMPLO.COM.BR","endereco":{"uf":"MG","cep":"30130-010","bairro":"CENTRO","numero":"45","municipio":"BELO HORIZONTE","logradouro":"RUA DA BAHIA 45","complemento":""},"telefone":"(31) 0000-0003","dataSituacao":"2020-09-22","nomeFantasia":"","cnaePrincipal":"3314707","situacaoCadastral":"BAIXADA","dataInicioAtividade":"2015-07-20"}],"totalEstabelecimentos":3}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"402":{"$ref":"#/components/responses/Error402"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"}}}},"/api/v1/consulta/vinculos-societarios":{"get":{"summary":"Vínculos Societários","description":"Mapeia a rede de vínculos societários e de parentesco de um CPF ou CNPJ, em vários níveis de profundidade, com o documento completo de cada pessoa ou empresa ligada.\n\nObrigatório informar pelo menos um de: cpf ou cnpj.","operationId":"vinculos-societarios","tags":["Pessoa Jurídica"],"parameters":[{"name":"cpf","in":"query","required":false,"description":"CPF a consultar, com ou sem máscara (`00000000000` ou `000.000.000-00`). O dígito verificador é validado antes da consulta. Envie o nome do parâmetro em minúsculas.","schema":{"type":"string","format":"cpf"},"example":"SEU_CPF"},{"name":"cnpj","in":"query","required":false,"description":"CNPJ a consultar, com ou sem máscara (`00000000000000` ou `00.000.000/0000-00`). O dígito verificador é validado antes da consulta. Envie o nome do parâmetro em minúsculas.","schema":{"type":"string","format":"cnpj"},"example":"SEU_CNPJ"}],"responses":{"200":{"description":"Sucesso","content":{"application/json":{"schema":{"type":"object","properties":{"nomeEntidade":{"type":["string","null"],"description":"Nome completo da pessoa física ou razão social da entidade consultada."},"relacionamentos":{"type":["array","null"],"items":{"type":"object","properties":{"grau":{"type":["string","null"],"description":"Qual é o vínculo, e depende do `tipo`: com `Sociedade` traz o papel exercido (`Sócio Administrador`, `Administrador`, `Sócio`, `Diretor` e outros); com `Parentesco` traz o laço (`Mãe`, `Pai`, `Irmão`, `Filho`, `Conjuge`, `Tio`, `Avó` e outros). Chega como está na origem, sem normalização: pode vir com prefixo numérico ou espaçamento irregular. Nulo em cerca de 7% dos vínculos societários."},"tipo":{"type":["string","null"],"description":"Tipo do vínculo. Assume exatamente dois valores: `Sociedade` (participação societária ou cargo de administração) ou `Parentesco` (laço familiar)."},"nivel":{"type":["number","null"],"description":"Profundidade do item na árvore, começando em 1 para o vínculo direto com o documento consultado. Foi observada profundidade de até 8."},"status":{"type":["boolean","null"],"description":"`true` indica vínculo vigente e `false` indica vínculo encerrado. Em vínculo de parentesco vem sempre `true` e não carrega informação."},"documento":{"type":["string","null"],"description":"CPF ou CNPJ completo da entidade relacionada, sempre com máscara (`000.000.000-00` ou `00.000.000/0000-00`)."},"historicos":{"type":["array","null"],"items":{"type":"object","properties":{"cargo":{"type":["string","null"],"description":"Cargo ou função exercida. Preenchido em cerca de 93% dos registros."},"status":{"type":["boolean","null"],"description":"`true` indica cargo em exercício e `false` indica cargo encerrado. `false` coincide sempre com `dataFim` preenchida."},"dataFim":{"type":["string","null"],"description":"Data de término do cargo, no formato `DD/MM/AAAA HH:MM:SS`. Preenchida em cerca de 16% dos registros; quando vem, o cargo está encerrado."},"dataInicio":{"type":["string","null"],"description":"Data de início do cargo, no formato `DD/MM/AAAA HH:MM:SS`. A origem informa esta data em apenas cerca de 19% dos registros — trate a ausência como normal."}}},"description":"Períodos de cada cargo exercido. Vem vazio em todo vínculo de parentesco. As datas são esparsas — ver os campos abaixo."},"nomeEntidade":{"type":["string","null"],"description":"Nome completo ou razão social da entidade relacionada."},"relacionamentos":{"type":["array","null"],"items":{"type":"object"},"description":"Vínculos do nível seguinte, com a mesma estrutura deste objeto. É o que torna a resposta uma árvore — percorra recursivamente."},"detalhesPessoaFisica":{"type":["object","null"],"properties":{"pep":{"type":["boolean","null"],"description":"Indica pessoa exposta politicamente. Preenchido em cerca de 87% dos casos em que este objeto vem."},"obito":{"type":["boolean","null"],"description":"Indica óbito registrado. Preenchido em cerca de 92% dos casos em que este objeto vem."},"endereco":{"type":["object","null"],"description":"Endereço da pessoa física. **Quase nunca vem preenchido** (cerca de 2%) — não construa fluxo que dependa dele."},"dataNascimento":{"type":["string","null"],"description":"Data de nascimento, no formato `DD/MM/AAAA HH:MM:SS` (a hora é sempre `00:00:00`). Preenchida em cerca de 91% dos casos em que este objeto vem."},"situacaoCadastral":{"type":["string","null"],"description":"Situação cadastral do CPF. **Quase nunca vem preenchida** (cerca de 2%) e a caixa do texto varia (`Regular`, `REGULAR`) — compare sem diferenciar maiúsculas de minúsculas."}},"description":"Complemento sobre a pessoa física. Opcional: em cerca de dois terços dos vínculos nem este objeto nem `detalhesPessoaJuridica` vêm preenchidos."},"detalhesPessoaJuridica":{"type":["object","null"],"properties":{"matriz":{"type":["boolean","null"],"description":"Indica estabelecimento matriz, correspondendo à ordem `0001` do CNPJ."},"baixada":{"type":["boolean","null"],"description":"Indica **estritamente** situação cadastral `BAIXADA`. Empresa `INAPTA` ou `SUSPENSA` vem com `baixada = false` — não use este campo como sinônimo de inativa; leia `situacaoCadastral`."},"endereco":{"type":["object","null"],"properties":{"uf":{"type":["string","null"],"description":"Unidade federativa."},"cep":{"type":["string","null"],"description":"CEP do endereço."},"bairro":{"type":["string","null"],"description":"Bairro."},"cidade":{"type":["string","null"],"description":"Cidade."},"numero":{"type":["string","null"],"description":"Número do endereço."},"logradouro":{"type":["string","null"],"description":"Logradouro."},"complemento":{"type":["string","null"],"description":"Complemento do endereço."}},"description":"Endereço da empresa. Vem preenchido em mais de 99% dos casos em que este objeto vem."},"dataAbertura":{"type":["string","null"],"description":"Data de abertura da empresa, no formato `DD/MM/AAAA HH:MM:SS`."},"dataEncerramento":{"type":["string","null"],"description":"Data de encerramento, no formato `DD/MM/AAAA HH:MM:SS`. Vem preenchida somente quando a empresa está baixada."},"situacaoCadastral":{"type":["string","null"],"description":"Situação cadastral do CNPJ: `ATIVA`, `BAIXADA`, `INAPTA` ou `SUSPENSA`. É o campo correto para triar empresa irregular."},"recuperacaoJudicial":{"type":["boolean","null"],"description":"Indicador de recuperação judicial. Vem `false` em praticamente toda a base — **não serve como triagem de recuperação judicial**, use uma consulta dedicada."}},"description":"Complemento sobre a pessoa jurídica. Opcional: em cerca de dois terços dos vínculos nem este objeto nem `detalhesPessoaFisica` vêm preenchidos."}}},"description":"Árvore de vínculos. Lista recursiva: cada item pode conter o seu próprio `relacionamentos`. Vem vazia quando não há vínculo registrado para o documento."},"documentoConsultado":{"type":["string","null"],"description":"Documento (CPF ou CNPJ) consultado, com máscara."},"detalhesPessoaFisica":{"type":["object","null"],"properties":{"pep":{"type":["boolean","null"],"description":"Indica pessoa exposta politicamente. Preenchido em cerca de 87% dos casos em que este objeto vem."},"obito":{"type":["boolean","null"],"description":"Indica óbito registrado. Preenchido em cerca de 92% dos casos em que este objeto vem."},"endereco":{"type":["object","null"],"description":"Endereço da pessoa física. **Quase nunca vem preenchido** (cerca de 2%) — não construa fluxo que dependa dele."},"dataNascimento":{"type":["string","null"],"description":"Data de nascimento, no formato `DD/MM/AAAA HH:MM:SS` (a hora é sempre `00:00:00`). Preenchida em cerca de 91% dos casos em que este objeto vem."},"situacaoCadastral":{"type":["string","null"],"description":"Situação cadastral do CPF. **Quase nunca vem preenchida** (cerca de 2%) e a caixa do texto varia (`Regular`, `REGULAR`) — compare sem diferenciar maiúsculas de minúsculas."}},"description":"Complemento sobre a pessoa física. Opcional: em cerca de dois terços dos vínculos nem este objeto nem `detalhesPessoaJuridica` vêm preenchidos."},"detalhesPessoaJuridica":{"type":["object","null"],"properties":{"matriz":{"type":["boolean","null"],"description":"Indica estabelecimento matriz, correspondendo à ordem `0001` do CNPJ."},"baixada":{"type":["boolean","null"],"description":"Indica **estritamente** situação cadastral `BAIXADA`. Empresa `INAPTA` ou `SUSPENSA` vem com `baixada = false` — não use este campo como sinônimo de inativa; leia `situacaoCadastral`."},"endereco":{"type":["object","null"],"properties":{"uf":{"type":["string","null"],"description":"Unidade federativa."},"cep":{"type":["string","null"],"description":"CEP do endereço."},"bairro":{"type":["string","null"],"description":"Bairro."},"cidade":{"type":["string","null"],"description":"Cidade."},"numero":{"type":["string","null"],"description":"Número do endereço."},"logradouro":{"type":["string","null"],"description":"Logradouro."},"complemento":{"type":["string","null"],"description":"Complemento do endereço."}},"description":"Endereço da empresa. Vem preenchido em mais de 99% dos casos em que este objeto vem."},"dataAbertura":{"type":["string","null"],"description":"Data de abertura da empresa, no formato `DD/MM/AAAA HH:MM:SS`."},"dataEncerramento":{"type":["string","null"],"description":"Data de encerramento, no for