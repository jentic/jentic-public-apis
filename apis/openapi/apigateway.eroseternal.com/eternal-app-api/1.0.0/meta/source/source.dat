                      "message": "Missing required field: report_type",
                      "error": {
                        "type": "MissingField",
                        "details": "The 'report_type' field is required but was not provided."
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "ServerError": {
                    "value": {
                      "status": "error",
                      "code": 500,
                      "message": "Failed to generate report",
                      "error": {
                        "type": "ServerError",
                        "details": "Internal server error occurred while generating the report."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
