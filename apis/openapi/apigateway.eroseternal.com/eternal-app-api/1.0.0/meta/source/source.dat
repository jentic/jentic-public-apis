{
  "openapi": "3.0.3",
  "info": {
    "title": "Eternal App API",
    "description": "Spiritual and astrological insights platform API",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@eroseternal.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://eroseternal.com/terms"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/eternal-ab7/eternal-app-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://apigateway.eroseternal.com/api",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "status",
          "code",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ],
            "example": "error"
          },
          "code": {
            "type": "integer",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Missing required field"
          },
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "example": "MissingField"
              },
              "details": {
                "type": "string",
                "example": "The field is required but was not provided."
              }
            }
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "required": [
          "status",
          "code",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "Operation completed successfully"
          }
        }
      },
      "UserRegistration": {
        "type": "object",
        "required": [
          "name",
          "gender",
          "birth_location",
          "current_location",
          "date_of_birth",
          "time_of_birth"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Achal"
          },
          "gender": {
            "type": "string",
            "enum": [
              "Male",
              "Female",
              "Not Specified"
            ],
            "example": "Male"
          },
          "birth_location": {
            "type": "string",
            "example": "Chennai"
          },
          "current_location": {
            "type": "string",
            "example": "Chennai"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date-time",
            "example": "2000-03-20T00:00:00Z"
          },
          "time_of_birth": {
            "type": "string",
            "format": "date-time",
            "example": "2000-03-20T10:26:00Z"
          }
        }
      },
      "UserLogin": {
        "type": "object",
        "required": [
          "user_id"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "example": "3a16f48c-0b47-4bc2-a97e-6c91b66e4e56"
          }
        }
      },
      "LoginResponseData": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "token_type": {
            "type": "string",
            "enum": [
              "bearer"
            ],
            "example": "bearer"
          }
        }
      },
      "RegistrationResponseData": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "example": "3a16f48c-0b47-4bc2-a97e-6c91b66e4e56"
          },
          "access_token": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "token_type": {
            "type": "string",
            "enum": [
              "bearer"
            ],
            "example": "bearer"
          }
        }
      },
      "SoulProfileRequest": {
        "type": "object",
        "required": [
          "name",
          "gender",
          "birth_location",
          "current_location",
          "date_of_birth",
          "time_of_birth",
          "access_token"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Achal"
          },
          "gender": {
            "type": "string",
            "enum": [
              "Male",
              "Female",
              "Not Specified"
            ],
            "example": "Male"
          },
          "birth_location": {
            "type": "string",
            "example": "Chennai"
          },
          "current_location": {
            "type": "string",
            "example": "Chennai"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date-time",
            "example": "2000-03-20T00:00:00Z"
          },
          "time_of_birth": {
            "type": "string",
            "format": "date-time",
            "example": "2000-03-20T10:26:00Z"
          }
        }
      },
      "SoulProfileResponse": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "example": "3a16f48c-0b47-4bc2-a97e-6c91b66e4e56"
          },
          "name": {
            "type": "string",
            "example": "Achal"
          },
          "gender": {
            "type": "string",
            "example": "Male"
          },
          "birth_location": {
            "type": "string",
            "example": "Chennai"
          },
          "current_location": {
            "type": "string",
            "example": "Chennai"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date-time",
            "example": "2000-03-20T00:00:00Z"
          },
          "time_of_birth": {
            "type": "string",
            "format": "date-time",
            "example": "2000-03-20T10:26:00Z"
          },
          "modified_on": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-10T09:40:00Z"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-10T09:40:00Z"
          }
        }
      },
      "ChatQuestionsRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Harish"
          }
        }
      },
      "QuestionOption": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Harish"
          }
        }
      },
      "ChatQuestionsResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "200"
          },
          "message": {
            "type": "string",
            "example": "Hey Harish, what do you want from Eternal AI?"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionOption"
            }
          }
        }
      },
      "ChatMessageRequest": {
        "type": "object",
        "required": [
          "user_id",
          "question"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "example": "3a16f48c-0b47-4bc2-a97e-6c91b66e4e56"
          },
          "question": {
            "type": "string",
            "example": "What's my vibe right now?"
          }
        }
      },
      "ChatMessageResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string"
          },
          "bot": {
            "type": "string"
          },
          "suggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "redirect_url": {
                  "type": "string"
                }
              }
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReportGeneration": {
        "type": "object",
        "required": [
          "report_type"
        ],
        "properties": {
          "report_type": {
            "type": "string",
            "enum": [
              "star_map",
              "aura",
              "longevity_blueprint"
            ],
            "example": "star_map"
          }
        }
      },
      "LongevityBlueprintRequest": {
        "type": "object",
        "required": [
          "date_of_birth",
          "gender",
          "lifestyle"
        ],
        "properties": {
          "date_of_birth": {
            "type": "string",
            "format": "date-time",
            "example": "1999-02-11T00:00:00Z"
          },
          "gender": {
            "type": "string",
            "enum": [
              "Male",
              "Female",
              "Not Specified"
            ],
            "example": "Male"
          },
          "lifestyle": {
            "type": "object",
            "properties": {
              "diet": {
                "type": "string",
                "example": "vegetarian"
              },
              "exercise_frequency": {
                "type": "string",
                "example": "moderate"
              },
              "sleep_hours": {
                "type": "integer",
                "example": 7
              }
            }
          }
        }
      },
      "TarotReadingRequest": {
        "type": "object",
        "required": [
          "spread_type"
        ],
        "properties": {
          "spread_type": {
            "type": "string",
            "example": "three_card"
          },
          "focus": {
            "type": "string",
            "example": "career"
          }
        }
      },
      "HarmonyIndexRequest": {
        "type": "object",
        "required": [
          "user1",
          "user2"
        ],
        "properties": {
          "user1": {
            "type": "object",
            "properties": {
              "date_of_birth": {
                "type": "string",
                "format": "date-time",
                "example": "1999-02-11T00:00:00Z"
              }
            }
          },
          "user2": {
            "type": "object",
            "properties": {
              "date_of_birth": {
                "type": "string",
                "format": "date-time",
                "example": "2001-06-23T00:00:00Z"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/eternal/v1/auth/register": {
      "post": {
        "summary": "Register a new user",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegistration"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/RegistrationResponseData"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "User already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "DuplicateUser": {
                    "value": {
                      "status": "error",
                      "code": 409,
                      "message": "User already exists",
                      "error": {
                        "type": "DuplicateUser",
                        "details": "The user profile already exists for the provided details."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "status": "error",
                      "code": 401,
                      "message": "Authentication failed",
                      "error": {
                        "type": "Unauthorized",
                        "details": "Invalid or missing token. Please provide a valid JWT token."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/eternal/v1/auth/login": {
      "post": {
        "summary": "Authenticate user and get JWT token",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/LoginResponseData"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing required field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MissingField": {
                    "value": {
                      "status": "error",
                      "code": 400,
                      "message": "Missing required field: user_id",
                      "error": {
                        "type": "MissingField",
                        "details": "The 'user_id' field is required but was not provided."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InvalidCredentials": {
                    "value": {
                      "status": "error",
                      "code": 401,
                      "message": "Invalid credentials",
                      "error": {
                        "type": "InvalidCredentials",
                        "details": "The provided user_id is incorrect."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/eternal/v1/profile": {
      "post": {
        "summary": "Create or update soul profile",
        "tags": [
          "Soul Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SoulProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SoulProfileResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing required field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MissingField": {
                    "value": {
                      "status": "error",
                      "code": 400,
                      "message": "Missing required field: name",
                      "error": {
                        "type": "MissingField",
                        "details": "The 'name' field is required but was not provided."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "status": "error",
                      "code": 401,
                      "message": "Authentication failed",
                      "error": {
                        "type": "Unauthorized",
                        "details": "Invalid or missing token. Please provide a valid JWT token."
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid data format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InvalidData": {
                    "value": {
                      "status": "error",
                      "code": 422,
                      "message": "Invalid date format for date_of_birth",
                      "error": {
                        "type": "InvalidData",
                        "details": "The 'date_of_birth' must be in ISO format (YYYY-MM-DDTHH:MM:SSZ)."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/eternal/v1/profile/{user_id}": {
      "get": {
        "summary": "Get soul profile by user ID",
        "tags": [
          "Soul Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "3a16f48c-0b47-4bc2-a97e-6c91b66e4e56"
          }
        ],
        "responses": {
          "200": {
            "description": "Profile fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SoulProfileResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "status": "error",
                      "code": 401,
                      "message": "Authentication failed",
                      "error": {
                        "type": "Unauthorized",
                        "details": "Invalid or missing token. Please provide a valid JWT token."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "NotFound": {
                    "value": {
                      "status": "error",
                      "code": 404,
                      "message": "Profile not found",
                      "error": {
                        "type": "NotFound",
                        "details": "The requested soul profile was not found."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/eternal/v1/chat/questions": {
      "post": {
        "summary": "Get available questions with personalized greeting",
        "tags": [
          "Chat"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatQuestionsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Questions fetched successfully with personalized greeting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatQuestionsResponse"
                },
                "examples": {
                  "SuccessResponse": {
                    "value": {
                      "status": "200",
                      "message": "Hey Harish, what do you want from Eternal AI?",
                      "options": [
                        {
                          "id": 1,
                          "title": "What's my vibe right now?",
                          "icon": "https://sosnm1.shakticloud.ai:9024/prodimmersobuk01/eternal_icon/Glowing-star.svg?AWSAccessKeyId=immersouser&Signature=fKWt1r98fDlYp8Qs6fdN0dU%2Bk3A%3D&Expires=1768469467",
                          "action_url": "/ai/vibe"
                        },
                        {
                          "id": 2,
                          "title": "What's my Aura saying?",
                          "icon": "https://sosnm1.shakticloud.ai:9024/prodimmersobuk01/eternal_icon/Crystal-ball.svg?AWSAccessKeyId=immersouser&Signature=bFOvNID0wS9YDWqbPor6bdzIjqk%3D&Expires=1768469449",
                          "action_url": "/ai/aura"
                        },
                        {
                          "id": 3,
                          "title": "What planet is affecting me?",
                          "icon": "https://sosnm1.shakticloud.ai:9024/prodimmersobuk01/eternal_icon/Frame%201171281313.svg?AWSAccessKeyId=immersouser&Signature=1EuGnV7q4V0V1Cl42EkUIhLS92Y%3D&Expires=1768469398",
                          "action_url": "/ai/planet"
                        },
                        {
                          "id": 4,
                          "title": "What should I eat for energy today?",
                          "icon": "https://sosnm1.shakticloud.ai:9024/prodimmersobuk01/eternal_icon/Steaming-bowl.svg?AWSAccessKeyId=immersouser&Signature=Ij52VxKaYX8CpI5CN%2Fh%2BW3J2gD0%3D&Expires=1768469334",
                          "action_url": "/ai/food"
                        },
                        {
                          "id": 5,
                          "title": "How bright is my inner flame burning?",
                          "icon": "https://sosnm1.shakticloud.ai:9024/prodimmersobuk01/eternal_icon/Fire.svg?AWSAccessKeyId=immersouser&Signature=5qVBquyMl%2Fm7Kmn5u3A0%2FuELWpI%3D&Expires=1768469427",
                          "action_url": "/ai/flame"
                        },
                        {
                          "id": 6,
                          "title": "Which of my energy bodies needs the most love today?",
                          "icon": "https://sosnm1.shakticloud.ai:9024/prodimmersobuk01/eternal_icon/Frame%201171281316.svg?AWSAccessKeyId=immersouser&Signature=9tdYyLkg9NHL7yjlEUtzY8XSmVE%3D&Expires=1768469484",
                          "action_url": "/ai/energy"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing required field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MissingField": {
                    "value": {
                      "status": "error",
                      "code": 400,
                      "message": "Missing required field: name",
                      "error": {
                        "type": "MissingField",
                        "details": "The 'name' field is required but was not provided."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "status": "error",
                      "code": 401,
                      "message": "Authentication failed",
                      "error": {
                        "type": "Unauthorized",
