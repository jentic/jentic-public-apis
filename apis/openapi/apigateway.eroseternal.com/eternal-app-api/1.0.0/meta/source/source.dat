              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "processing"
                      ],
                      "example": "processing"
                    },
                    "code": {
                      "type": "integer",
                      "example": 202
                    },
                    "report_id": {
                      "type": "string",
                      "format": "uuid",
                      "example": "b2c3d4e5-f6g7-8901-bcde-f23456789012"
                    },
                    "report_type": {
                      "type": "string",
                      "example": "star_map"
                    },
                    "message": {
                      "type": "string",
                      "example": "Your Star Map report is being generated."
                    }
                  }
                }
              }
            }
          },
