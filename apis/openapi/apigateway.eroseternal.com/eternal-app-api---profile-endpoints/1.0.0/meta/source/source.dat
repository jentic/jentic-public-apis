{
  "openapi": "3.0.3",
  "info": {
    "title": "Eternal App API - Profile Endpoints",
    "description": "Soul profile management APIs",
    "version": "1.0.0",
    "contact": {
      "name": "API Support",
      "email": "support@eroseternal.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://eroseternal.com/terms"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/eternal-ab7/eternal-app-api-profile-endpoints/1.0.0"
  },
  "servers": [
    {
      "url": "https://apigateway.eroseternal.com/api",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "status",
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ],
            "example": "error"
          },
          "code": {
            "type": "integer",
            "example": 400
          },
          "message": {
            "type": "string",
            "example": "Missing required field"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "example": "daaffdc7-140c-4604-96bc-e50acf9b2e06"
          },
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "example": "MissingField"
              },
              "details": {
                "type": "string",
                "example": "The field is required but was not provided."
              }
            }
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "required": [
          "status",
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "code": {
            "type": "integer",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "Operation completed successfully"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "example": "daaffdc7-140c-4604-96bc-e50acf9b2e06"
          }
        }
      },
      "SoulProfileRequest": {
        "type": "object",
        "required": [
          "gender",
          "place_of_birth",
          "current_location",
          "date_of_birth",
          "time_of_birth"
        ],
        "properties": {
          "gender": {
            "type": "string",
            "enum": [
              "Male",
              "Female",
              "Not Specified"
            ],
            "example": "Female"
          },
          "birth_location": {
            "type": "string",
            "example": "Chennai"
          },
          "current_location": {
            "type": "string",
            "example": "Chennai"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date-time",
            "example": "2000-03-20T00:00:00Z"
          },
          "time_of_birth": {
            "type": "string",
            "format": "date-time",
            "example": "2000-03-20T10:26:00Z"
          }
        }
      },
      "SoulProfileResponse": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "example": "3a16f48c-0b47-4bc2-a97e-6c91b66e4e56"
          },
          "gender": {
            "type": "string",
            "example": "Female"
          },
          "birth_location": {
            "type": "string",
            "example": "Chennai"
          },
          "current_location": {
            "type": "string",
            "example": "Chennai"
          },
          "date_of_birth": {
            "type": "string",
            "format": "date-time",
            "example": "2000-03-20T00:00:00Z"
          },
          "time_of_birth": {
            "type": "string",
            "format": "date-time",
            "example": "2000-03-20T10:26:00Z"
          },
          "modified_on": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-10T09:40:00Z"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2025-10-10T09:40:00Z"
          }
        }
      },
      "UserChatResponse": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "example": "3a16f48c-0b47-4bc2-a97e-6c91b66e4e56"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid",
            "example": "f7c53b61-9b6c-4b0d-8b22-0d8f6cbf5e3c"
          },
          "assessment_status": {
            "type": "string",
            "description": "Current assessment progress or state.",
            "example": "question"
          },
          "current_question": {
            "type": "string",
            "description": "The most recent question asked to the user.",
            "example": "How are you feeling today?"
          },
          "report": {
            "type": "object",
            "description": "Generated report or related analytical data."
          }
        }
      },
      "ProfileUpdateRequest": {
        "type": "object",
        "properties": {
          "gender": {
            "type": "string",
            "enum": [
              "male",
              "female",
              "other"
            ],
            "example": "male"
          }
        }
      },
      "LandingServiceResponse": {
        "type": "object",
        "properties": {
          "service_type": {
            "type": "string",
            "example": "tarot-reading"
          },
          "title": {
            "type": "string",
            "example": "Daily Tarot Reading"
          },
          "description": {
            "type": "string",
            "example": "Get insights into your day with our AI-powered tarot reading"
          },
          "available": {
            "type": "boolean",
            "example": true
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "example": "https://media.eroseternal.com/tarot-reading.jpg"
          },
          "action_url": {
            "type": "string",
            "format": "uri",
            "example": "/tarot/start-reading"
          }
        }
      },
      "ChatSessionResponse": {
        "type": "object",
        "properties": {
          "chat_session": {
            "type": "object",
            "properties": {
              "conversation_id": {
                "type": "string",
                "format": "uuid",
                "example": "3a60f984-e4bf-4055-bd72-c4ee786c7e77"
              },
              "user_id": {
                "type": "string",
                "format": "uuid",
                "example": "8e2b7c40-5a44-4c6b-9f34-1f97df4e11b2"
              },
              "type": {
                "type": "string",
                "example": "vibration"
              },
              "title": {
                "type": "string",
                "example": "Chat Session Title"
              },
              "completed": {
                "type": "boolean",
                "example": false
              },
              "active": {
                "type": "boolean",
                "example": true
              },
              "report_available": {
                "type": "boolean",
                "example": false
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-06T10:15:30Z"
              },
              "modified_on": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-06T10:20:45Z"
              }
            }
          },
          "chat_messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "example": "21b7f334-8d21-42af-95b3-61b9a6e0cf90"
                },
                "chat_session_id": {
                  "type": "string",
                  "format": "uuid",
                  "example": "3a60f984-e4bf-4055-bd72-c4ee786c7e77"
                },
                "mime_type": {
                  "type": "string",
                  "example": "text"
                },
                "text": {
                  "type": "string",
                  "example": "Hello, how can I help?"
                },
                "thumbnail_link": {
                  "type": "string",
                  "format": "uri",
                  "example": ""
                },
                "media_link": {
                  "type": "string",
                  "format": "uri",
                  "example": ""
                },
                "active": {
                  "type": "string",
                  "example": "true"
                },
                "status": {
                  "type": "string",
                  "example": "Sent"
                },
                "error_message": {
                  "type": "string",
                  "example": ""
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2025-11-06T10:15:31Z"
                },
                "modified_on": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2025-11-06T10:16:00Z"
                }
              }
            }
          },
          "report": {
            "type": "object",
            "properties": {
              "conversation_id": {
                "type": "string",
                "format": "uuid",
                "example": "3a60f984-e4bf-4055-bd72-c4ee786c7e77"
              },
              "report": {
                "type": "object",
                "description": "Detailed chat report data (could include metrics, summaries, etc.)",
                "example": {}
              },
              "created_at": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-06T10:25:00Z"
              },
              "modified_on": {
                "type": "string",
                "format": "date-time",
                "example": "2025-11-06T10:30:00Z"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/v2/eternalprofile": {
      "post": {
        "summary": "Create or update soul profile",
        "tags": [
          "Soul Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Access token for authentication"
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "daaffdc7-140c-4604-96bc-e50acf9b2e06"
            },
            "description": "Unique request ID for tracking and debugging"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SoulProfileRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SoulProfileResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing required field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MissingField": {
                    "value": {
                      "status": "error",
                      "code": 400,
                      "message": "Missing required field: name",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "MissingField",
                        "details": "The 'name' field is required but was not provided."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "status": "error",
                      "code": 401,
                      "message": "Authentication failed",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "Unauthorized",
                        "details": "Invalid or missing token. Please provide a valid JWT token."
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid data format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InvalidData": {
                    "value": {
                      "status": "error",
                      "code": 422,
                      "message": "Invalid date format for date_of_birth",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "InvalidData",
                        "details": "The 'date_of_birth' must be in ISO format (YYYY-MM-DDTHH:MM:SSZ)."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/eternal/profile/{user_id}": {
      "get": {
        "summary": "Get soul profile by user ID",
        "tags": [
          "Soul Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "3a16f48c-0b47-4bc2-a97e-6c91b66e4e56"
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "daaffdc7-140c-4604-96bc-e50acf9b2e06"
            },
            "description": "Unique request ID for tracking and debugging"
          }
        ],
        "responses": {
          "200": {
            "description": "Profile fetched successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SoulProfileResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "status": "error",
                      "code": 401,
                      "message": "Authentication failed",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "Unauthorized",
                        "details": "Invalid or missing token. Please provide a valid JWT token."
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "NotFound": {
                    "value": {
                      "status": "error",
                      "code": 404,
                      "message": "Profile not found",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "NotFound",
                        "details": "The requested soul profile was not found."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/eternal/profile": {
      "patch": {
        "summary": "Update user profile",
        "description": "Partially update user profile information",
        "tags": [
          "Soul Profile"
        ],
        "parameters": [
          {
            "name": "x-Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Access token for authentication"
          },
          {
            "name": "x-platform",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "web"
            },
            "description": "Platform identifier (e.g., web, android, ios)"
          },
          {
            "name": "x-version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "1.0.0"
            },
            "description": "App version for compatibility tracking"
          },
          {
            "name": "x-appname",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "eternal"
            },
            "description": "Application name making the request"
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "daaffdc7-140c-4604-96bc-e50acf9b2e06"
            },
            "description": "Unique request ID for tracking and debugging"
          },
          {
            "name": "x-country",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "IN"
            },
            "description": "Country code for localization"
          },
          {
            "name": "x-device-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "ff7a0737-efc2-562a-8ccc-d726db282834"
            },
            "description": "Unique device identifier"
          },
          {
            "name": "x-api-client",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "example": "CZgbPYnmcj5iyEH9tg0GYvB4lm9gGQ9qs6jQwllV"
            },
            "description": "API client identifier"
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileUpdateRequest"
              },
              "example": {
                "gender": "male"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SoulProfileResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InvalidGender": {
                    "value": {
                      "status": "error",
                      "code": 400,
                      "message": "Invalid gender value",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "InvalidData",
                        "details": "Gender must be one of: male, female, other"
                      }
                    }
                  },
                  "MissingRequiredHeader": {
                    "value": {
                      "status": "error",
                      "code": 400,
                      "message": "Missing required headers",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "MissingHeader",
                        "details": "x-platform, x-version, and x-appname headers are required"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "status": "error",
                      "code": 401,
                      "message": "Authentication failed",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "Unauthorized",
                        "details": "Invalid or missing token. Please provide a valid JWT token."
                      }
                    }
                  },
                  "InvalidToken": {
                    "value": {
                      "status": "error",
                      "code": 401,
                      "message": "Invalid token",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "InvalidToken",
                        "details": "The provided authentication token is invalid or expired"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Profile not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "ProfileNotFound": {
                    "value": {
                      "status": "error",
                      "code": 404,
                      "message": "Profile not found",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "NotFound",
                        "details": "User profile not found for the authenticated user"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid data format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InvalidData": {
                    "value": {
                      "status": "error",
                      "code": 422,
                      "message": "Invalid request body",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "InvalidData",
                        "details": "Request body must be a valid JSON object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/landing/tarot-reading": {
      "get": {
        "summary": "Get tarot reading service",
        "tags": [
          "Exploer Section"
        ],
        "parameters": [
          {
            "name": "accept",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "application/json"
            },
            "description": "Accept header"
          },
          {
            "name": "x-platform",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "web"
            },
            "description": "Platform identifier (e.g., web, android, ios)"
          },
          {
            "name": "x-version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "1.0.0"
            },
            "description": "App version for compatibility tracking"
          },
          {
            "name": "x-appname",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "eternal"
            },
            "description": "Application name making the request"
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
