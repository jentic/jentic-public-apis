    "/v2/eternal/chat/session": {
      "get": {
        "summary": "Get Chat Report.",
        "tags": [
          "Soul Profile Report"
        ],
        "parameters": [
          {
            "name": "x-platform",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "web"
            },
            "description": "Platform identifier (e.g., web, android, ios)"
          },
          {
            "name": "x-version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "1.0.0"
            },
            "description": "App version for compatibility tracking"
          },
          {
            "name": "x-appname",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "eternal"
            },
            "description": "Application name making the request"
          },
          {
            "name": "user_id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "a4905e82-bd9a-44e2-a3ba-a976b550f047"
            },
            "description": "User id for which report have to be generate."
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "a4905e82-bd9a-44e2-a3ba-a976b550f047"
            },
            "description": "Unique request ID for tracking and debugging"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "vibrational_frequency,aura_profile,star_map,longevity_blueprint,flame_score,kosha_map"
            },
            "description": "For which report to generate."
          },
          {
            "name": "conversation_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "a4905e82-bd9a-44e2-a3ba-a976b550f047"
            },
            "description": "Unique conversation ID for report to generate."
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "chat_session,chat_message,report"
            },
            "description": "To get the chat session report to generate."
          }
        ],
        "responses": {
          "200": {
            "description": "chat report fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/ChatSessionResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MissingRequiredHeader": {
                    "value": {
                      "status": "error",
                      "code": 400,
                      "message": "Missing required headers",
                      "request_id": "a4905e82-bd9a-44e2-a3ba-a976b550f047",
                      "error": {
                        "type": "MissingHeader",
                        "details": "x-platform, x-version, and x-appname, user_id headers are required"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Service not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "ServiceNotFound": {
                    "value": {
                      "status": "error",
                      "code": 404,
                      "message": "Chat session not found for the user.",
                      "request_id": "a4905e82-bd9a-44e2-a3ba-a976b550f047",
                      "error": {
                        "type": "NotFound",
                        "details": "chat session not found."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/eternal/chat": {
      "post": {
        "summary": "Start chat Session.",
        "tags": [
          "Soul Profile Report"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "x-platform",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "web"
            },
            "description": "Platform identifier (e.g., web, android, ios)"
          },
          {
            "name": "x-version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "1.0.0"
            },
            "description": "App version for compatibility tracking"
          },
          {
            "name": "x-appname",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "example": "eternal"
            },
            "description": "Application name making the request"
          },
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "daaffdc7-140c-4604-96bc-e50acf9b2e06"
            },
            "description": "Unique request ID for tracking and debugging"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "report_type"
                ],
                "properties": {
                  "report_type": {
                    "type": "string",
                    "enum": [
                      "vibrational_frequency"
                    ],
                    "description": "The type of report to generate eg.:- vibrational_frequency,aura_profile,star_map,longevity_blueprint,flame_score,kosha_map."
                  },
                  "answer": {
                    "type": "string",
                    "description": "User's emotional or situational input text eg.:- \"at work able to do proper talk happy and get energitic eat happy and enjoy every moment\"."
                  },
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The file to analyze (e.g., image, voice)."
                  },
                  "conversation_id": {
                    "type": "string.",
                    "format": "uuid",
                    "description": "To get the chat conversation."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chat Started successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/UserChatResponse"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Missing required field",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MissingField": {
                    "value": {
                      "status": "error",
                      "code": 400,
                      "message": "Missing required field",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "MissingField",
                        "details": "The report_type and answer field is required but was not provided."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "Unauthorized": {
                    "value": {
                      "status": "error",
                      "code": 401,
                      "message": "Authentication failed",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "Unauthorized",
                        "details": "Invalid or missing token. Please provide a valid JWT token."
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid data format",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "InvalidData": {
                    "value": {
                      "status": "error",
                      "code": 422,
                      "message": "Invalid date format for date_of_birth",
                      "request_id": "daaffdc7-140c-4604-96bc-e50acf9b2e06",
                      "error": {
                        "type": "InvalidData",
                        "details": "The 'date_of_birth' must be in ISO format (YYYY-MM-DDTHH:MM:SSZ)."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Soul Profile",
      "description": "User astrological profile management."
    },
    {
      "name": "Exploer Section",
      "description": "Exploer section page services and features."
    },
    {
      "name": "Soul Profile Report",
      "description": "To generate soul report."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
