    "/organizations": {
      "get": {
        "operationId": "organizations",
        "summary": "Organizations",
        "description": "Retrieve organization details.",
        "tags": [
          "Cheers Public API"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "organization_id",
            "in": "query",
            "required": false,
            "description": "Specific organization ID (one of organization_id or parent_organization_id required)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "parent_organization_id",
            "in": "query",
            "required": false,
            "description": "Get all child organizations (one of organization_id or parent_organization_id required)",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "description": "Organization ID"
                      },
                      "name": {
                        "type": "string",
                        "description": "Organization name"
                      },
                      "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "When the organization was created"
                      },
                      "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Last update timestamp"
                      },
                      "subscription_tier": {
                        "type": "string",
                        "description": "Subscription level"
                      },
                      "parent_organization_id": {
                        "type": "integer",
                        "description": "Parent organization ID (null if root)"
                      }
                    }
                  }
                },
                "example": [
                  {
                    "id": 123,
                    "name": "Acme Restaurant",
                    "created_at": "2024-01-15T10:30:00Z",
                    "updated_at": "2024-06-20T14:45:00Z",
                    "subscription_tier": "pro",
                    "parent_organization_id": null
                  }
                ]
              }
            }
          },
          "400": {
            "description": "Missing or invalid parameters"
          },
          "401": {
            "description": "Invalid or missing API key"
          },
          "403": {
            "description": "No access to requested resource"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
