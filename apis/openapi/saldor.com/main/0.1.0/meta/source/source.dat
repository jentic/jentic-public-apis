l flows for the org: its Saldor-hosted address, the connected Gmail accounts, and — per email kind — the channel a send would actually come from right now. The hosted address is the floor, so a kind always resolves to something; `blocked` is set only when the deployment itself has no outbound transport. The connections themselves are managed at `/api/integrations/gmail`.","tags":["Settings"],"x-admin":true,"responses":{"200":{"description":"Get email settings","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/EmailSettings"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"patch":{"summary":"Update email settings","description":"Admin-only. Changes which channel each email kind sends through — the org's hosted address or a connected Gmail account — whether inbound mail from unknown senders is screened for new vendors, and whether purchase orders are emailed to vendors at all. A channel ref must be `hosted` or an active connection. Returns the full, freshly-resolved email settings document.","tags":["Settings"],"x-admin":true,"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/EmailRoutingPatch"}}}},"responses":{"200":{"description":"Update email settings","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/EmailSettings"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/settings/notifications":{"get":{"summary":"Get notification preferences","description":"Returns the signed-in user's account-wide workflow-task notification channels.","tags":["Settings"],"responses":{"200":{"description":"Get notification preferences","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/NotificationPreferences"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"patch":{"summary":"Update notification preferences","description":"Updates the signed-in user's account-wide workflow-task notification channels.","tags":["Settings"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotificationPreferencesPatch"}}}},"responses":{"200":{"description":"Update notification preferences","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/NotificationPreferences"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/settings/po-numbering":{"get":{"summary":"Get the purchase-order number format","description":"The purchase-order number format: `prefix` + the counter, optionally zero-padded to `pad` digits. A `{vendor}` token in the prefix numbers orders per supplier (`PO-ABC-1`) off that vendor's own counter. References are assigned when the order is created and are immutable thereafter, so a change here affects only future orders.","tags":["Settings"],"responses":{"200":{"description":"Get the purchase-order number format","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/PoNumbering"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"put":{"summary":"Set the purchase-order number format","description":"Admin-only. The purchase-order number format: `prefix` + the counter, optionally zero-padded to `pad` digits. A `{vendor}` token in the prefix numbers orders per supplier (`PO-ABC-1`) off that vendor's own counter. References are assigned when the order is created and are immutable thereafter, so a change here affects only future orders. Every field sent is replaced; an omitted `pad` is kept.","tags":["Settings"],"x-admin":true,"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/PoNumberingInput"}}}},"responses":{"200":{"description":"Set the purchase-order number format","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/PoNumbering"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/features":{"get":{"summary":"Get the org's feature flags","description":"The org's feature toggles (Linear-style progressive disclosure): which optional features (accounting, projects, inventory, the item-receipt list) are turned on. Core procurement (requests, POs, bills, vendors, approval workflows) is always on and not listed. New orgs default off; existing orgs were backfilled on. Readable by any member (the app chrome gates on it).","tags":["Settings"],"responses":{"200":{"description":"Get the org's feature flags","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/FeaturesDocument"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"put":{"summary":"Set the org's feature flags","description":"Admin-only. Turns one or more features on or off. Returns the full effective document.","tags":["Settings"],"x-admin":true,"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/FeatureFlagsPatch"}}}},"responses":{"200":{"description":"Set the org's feature flags","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/FeaturesDocument"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/comments":{"get":{"summary":"List comments","description":"An object's conversation log, oldest first. Identify the object with `subject_type` + `subject_id`. Anyone in the org may read it.","tags":["Comments"],"parameters":[{"in":"query","name":"subject_type","schema":{"$ref":"#/components/schemas/CommentSubjectType"},"required":true,"description":"The kind of object the comment is attached to."},{"in":"query","name":"subject_id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"The id of the object to read the log of."},"required":true,"description":"The id of the object to read the log of."}],"responses":{"200":{"description":"List comments","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Comment"}},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"post":{"summary":"Post a comment","description":"Append a note to an object's conversation log. Identify the object with `subject_type` + `subject_id`. Anyone in the org may comment.","tags":["Comments"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CommentCreateInput"}}}},"responses":{"201":{"description":"Post a comment","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Comment"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/comments/{id}":{"delete":{"summary":"Delete a comment","description":"Remove a note from an object's conversation log. Only the note's own author may delete it (403 otherwise); system notes cannot be deleted.","tags":["Comments"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"The id of the comment to delete."},"required":true,"description":"The id of the comment to delete."}],"responses":{"200":{"description":"Delete a comment","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Comment"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/events":{"get":{"summary":"List events","description":"Read the org's **append-only activity log** — the single chronological record of everything that has happened across procurement.\n\n## What an event is\n\nEvery meaningful mutation in the platform emits exactly one event: a purchase order is created, an invoice gets matched, an item receipt is recorded, a team member is added, a workflow advances. Events are **immutable** — they are never updated or deleted, so the log is a trustworthy audit trail. A correction is just a later event, not an edit to an earlier one.\n\nEvents are written **internally** by the data layer as a side effect of those mutations; there is no `POST /api/events`. This endpoint is the read side.\n\n## Anatomy of an event\n\n- **`type`** — `<subject>.<verb>`, e.g. `purchase_order.created`. Stable and machine-readable.\n- **`subject_type` / `subject_id`** — what the event is about (the kind, and the specific row's uuid).\n- **`payload`** — `type`-specific JSON detail (changed fields, new status, …).\n- **`actor` / `actor_label`** — who did it. `actor` is an opaque token (a user uuid, `vendor:<id>`, a `system:*` label, or null); `actor_label` is the human-readable name resolved for you on read, so feeds can show \"Dana created PO-1042\" without a second lookup.\n- **`created_at`** — when it was recorded. Results come back **oldest-first**.\n\n## Filtering\n\nAll filters are optional and combine with AND:\n\n- `?type=purchase_order.created` — one event type.\n- `?subject_type=invoice` — every event about invoices.\n- `?subject_type=purchase_order&subject_id=<uuid>` — **one object's full history**, the most common use.\n- `?limit=100` — cap the number of rows (1–1000).\n\n## Typical uses\n\n- Render an activity feed or an object-level timeline.\n- Reconstruct derived state (e.g. an object's history) from the log.\n- Drive integrations or analytics off a stable, namespaced event stream.","tags":["Events"],"parameters":[{"in":"query","name":"type","schema":{"description":"Return only events of this exact `type` (e.g. `purchase_order.created`).","type":"string"},"description":"Return only events of this exact `type` (e.g. `purchase_order.created`)."},{"in":"query","name":"subject_type","schema":{"description":"Return only events about this kind of subject (e.g. `invoice`).","type":"string"},"description":"Return only events about this kind of subject (e.g. `invoice`)."},{"in":"query","name":"subject_id","schema":{"description":"Return only events about this subject row. Combine with `subject_type` to pull one object's full audit trail in chronological order.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"description":"Return only events about this subject row. Combine with `subject_type` to pull one object's full audit trail in chronological order."},{"in":"query","name":"limit","schema":{"description":"Maximum number of events to return (1–1000). Omit for the server default.","type":"integer","exclusiveMinimum":0,"maximum":1000},"description":"Maximum number of events to return (1–1000). Omit for the server default."}],"responses":{"200":{"description":"List events","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Event"}},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/events/undoable":{"get":{"summary":"Find the undoable event","description":"Return the event for your most recent reversible line-item edit on a document, if there is one — the id to pass to `POST /api/events/{id}/undo`.\n\nOnly **your own** last edit is offered, and only while the document's lines still match what that edit produced; an edit by anyone else since makes it unavailable rather than reversing over them.","tags":["Events"],"parameters":[{"in":"query","name":"subject_type","schema":{"type":"string","description":"The kind of document to check (e.g. `purchase_order`)."},"required":true,"description":"The kind of document to check (e.g. `purchase_order`)."},{"in":"query","name":"subject_id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"The document to check."},"required":true,"description":"The document to check."}],"responses":{"200":{"description":"Find the undoable event","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/UndoableStatus"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/events/{id}/undo":{"post":{"summary":"Undo an event","description":"Reverse the line-item edit this event recorded, restoring the document's lines as they were before it. Get the id from `GET /api/events/undoable`.\n\nOnly line-edit events on purchase orders, item receipts, invoices and procurement requests are reversible — anything else is `404`. You can only undo an edit **you** made (`403` otherwise).\n\nSafe to retry: the undo is bound to this event, so calling it again once the edit is reversed returns `{ undone: false, reason: \"nothing\" }` instead of undoing the edit before it. If the document's lines changed after the edit, nothing is restored and the reason is `stale`.\n\nThe log itself stays append-only — the reversal appends a `<subject>.line_edit_reverted` event.","tags":["Events"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Undo an event","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/UndoResult"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/users":{"post":{"summary":"Add a member without an account","description":"**Admin only.** Creates a placeholder member: someone the org can assign work to who has no login and is never emailed. Invite them later to turn the same record into a real account.","tags":["Users"],"x-admin":true,"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatePlaceholderBody"}}}},"responses":{"201":{"description":"Add a member without an account","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/UserInfo"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"get":{"summary":"List org members","tags":["Users"],"responses":{"200":{"description":"List org members","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/UserInfo"}},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/users/{id}":{"patch":{"summary":"Update a member","description":"**Admin only.**","tags":["Users"],"x-admin":true,"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateMemberBody"}}}},"responses":{"200":{"description":"Update a member","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/UserInfo"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"delete":{"summary":"Remove a member","description":"**Admin only.** Removes them from the organization. Their past activity keeps their name — only the membership goes.","tags":["Users"],"x-admin":true,"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Remove a member","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"removed":{"type":"boolean"}},"required":["removed"],"additionalProperties":false},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/users/{id}/invite":{"post":{"summary":"Invite a placeholder member","description":"**Admin only.** Emails an invitation to a placeholder's address. Accepting it adopts their existing record.","tags":["Users"],"x-admin":true,"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"201":{"description":"Invite a placeholder member","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Invitation"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/users/invitations":{"get":{"summary":"List pending invitations","description":"**Admin only.**","tags":["Users"],"x-admin":true,"responses":{"200":{"description":"List pending invitations","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Invitation"}},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"post":{"summary":"Invite someone by email","description":"**Admin only.**","tags":["Users"],"x-admin":true,"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateInvitationBody"}}}},"responses":{"201":{"description":"Invite someone by email","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Invitation"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/users/invitations/{id}":{"delete":{"summary":"Revoke an invitation","description":"**Admin only.**","tags":["Users"],"x-admin":true,"parameters":[{"in":"path","name":"id","schema":{"type":"string"},"required":true}],"responses":{"200":{"description":"Revoke an invitation","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"revoked":{"type":"boolean"}},"required":["revoked"],"additionalProperties":false},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/organization":{"get":{"summary":"Retrieve the organization","tags":["Organization"],"responses":{"200":{"description":"Retrieve the organization","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Organization"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"patch":{"summary":"Rename the organization","description":"**Admin only.**","tags":["Organization"],"x-admin":true,"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateOrganizationBody"}}}},"responses":{"200":{"description":"Rename the organization","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Organization"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/search":{"get":{"summary":"Search entities","description":"Full-text + trigram search across invoices, purchase orders, vendors, and receipts.","tags":["Search"],"parameters":[{"in":"query","name":"q","schema":{"type":"string","minLength":1,"description":"Search query string."},"required":true,"description":"Search query string."}],"responses":{"200":{"description":"Search entities","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/SearchResult"}},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal s