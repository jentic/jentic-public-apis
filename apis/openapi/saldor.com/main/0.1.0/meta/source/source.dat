F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"The org the rule belongs to."},"position":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"0-based evaluation order; rules are tried lowest-first and the FIRST match wins. Position reflects the order the rules were sent in the last replace."},"match_state":{"anyOf":[{"$ref":"#/components/schemas/StateName"},{"type":"null"}],"description":"Only fire for an exception in this derived state (e.g. `billed_qty_over_ordered`). Null means the rule is not constrained by state."},"po_total_operator":{"anyOf":[{"type":"string","enum":["gte","gt","lte","lt","eq"],"description":"Comparison applied to the PO total against `po_total_amount`: gte (≥), gt (>), lte (≤), lt (<), eq (=)."},{"type":"null"}],"description":"Operator for the PO-total condition; null when the rule has no amount condition."},"po_total_amount":{"anyOf":[{"type":"number"},{"type":"null"}],"description":"Threshold the PO total is compared against via `po_total_operator`; null when the rule has no amount condition. Set together with `po_total_operator` or not at all."},"assignee_user_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}],"description":"User this rule routes matching exceptions to (mutually exclusive with team)."},"assignee_team_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}],"description":"Team queue this rule routes matching exceptions to (mutually exclusive with user). A queued item is owned by the team until a member claims it."},"note":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Optional human note explaining the rule, surfaced in the settings UI."},"created_at":{"type":"string"},"updated_at":{"type":"string"}},"required":["id","organization_id","position","match_state","po_total_operator","po_total_amount","assignee_user_id","assignee_team_id","note","created_at","updated_at"],"additionalProperties":false},"EmailSettings":{"type":"object","properties":{"hosted_address":{"type":"string","description":"The org's Saldor-hosted email address — assigned when the org is created, fixed for its lifetime (it does not follow a rename), and the address vendors reply to."},"gmail_configured":{"type":"boolean","description":"Whether Gmail OAuth is configured for this deployment (so a Connect action is possible)."},"channels":{"type":"array","items":{"$ref":"#/components/schemas/EmailChannel"},"description":"The org's connected Gmail accounts — the peers email flows through."},"routing":{"type":"array","items":{"$ref":"#/components/schemas/EmailRoute"},"description":"Per email kind, which Gmail account a send would go through right now — resolved with the same rules the send paths use."},"held":{"type":"object","properties":{"quarantined":{"type":"number","description":"Count of vendor-matched messages held because authentication failed (spoof case)."},"unsure":{"type":"number","description":"Count of messages the classifier could not confidently label."}},"required":["quarantined","unsure"],"additionalProperties":false},"scan_unknown_senders":{"type":"boolean","description":"Whether inbound mail from senders no vendor owns is read and screened for a possible new vendor (surfacing a 'New vendor?' suggestion a human accepts). Off means such mail is recorded and never read. Default on."},"email_purchase_orders":{"type":"boolean","description":"Whether sending a purchase order emails it to the vendor. Off means the send only records the order as placed — no email goes out, and no vendor email is required. Default on."}},"required":["hosted_address","gmail_configured","channels","routing","held","scan_unknown_senders","email_purchase_orders"],"additionalProperties":false},"EmailChannel":{"type":"object","properties":{"id":{"type":"string","description":"The Gmail connection id."},"kind":{"type":"string","enum":["gmail"]},"address":{"type":"string","description":"The Gmail account address."},"label":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"A user-set display name; null falls back to the address."},"status":{"type":"string","enum":["active","needs_reconnect"],"description":"'active' healthy; 'needs_reconnect' a Gmail whose grant lapsed."},"can_send":{"type":"boolean"},"can_receive":{"type":"boolean","description":"Whether the channel reads inbound mail — true for any active connection."},"last_seen_at":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"When we last processed inbound mail on this channel (diagnostics); null if never."}},"required":["id","kind","address","label","status","can_send","can_receive","last_seen_at"],"additionalProperties":false},"EmailRoute":{"type":"object","properties":{"kind":{"type":"string","enum":["po_send","rfx_invite","dispute","bill_pay"],"description":"Which email this route is for: `po_send` (the purchase order emailed on final approval), `rfx_invite` (a sourcing RFX sent to a candidate's vendor), `dispute` (an invoice-mismatch notice to the vendor), or `bill_pay` (a bill forwarded to the Brex Bill Pay inbox)."},"channel":{"type":"string","description":"The resolved channel this kind sends through: `hosted` (the org's Saldor address), or a Gmail connection id."},"provider":{"type":"string","enum":["gmail","hosted"],"description":"The transport a send of this kind would use right now: a connected Gmail, or the org's hosted address."},"from":{"type":"string","description":"The from-address the vendor would see."},"blocked":{"type":"boolean","description":"True only when this DEPLOYMENT has no working transport at all (no Gmail connected, and no outbound provider configured). An org can no longer block itself — hosted is always available."},"reason":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Human-readable explanation of why the kind is blocked (null when it isn't)."}},"required":["kind","channel","provider","from","blocked","reason"],"additionalProperties":false},"NotificationPreferences":{"type":"object","properties":{"email_enabled":{"type":"boolean","description":"Receive direct workflow-task alerts by email. Off by default."},"slack_enabled":{"type":"boolean","description":"Receive direct workflow-task alerts by Slack DM."}},"required":["email_enabled","slack_enabled"],"additionalProperties":false},"PoNumbering":{"type":"object","properties":{"prefix":{"type":"string","description":"Literal text in front of the counter, e.g. `ACME-PO-`. May be empty for a bare number. A `{vendor}` token is replaced by the vendor's code and switches counting to that vendor."},"pad":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"Zero-pad the counter to this width (0 = no padding, the default). `ACME-PO-` with pad 5 gives `ACME-PO-01001`. API-only — the settings UI doesn't offer it, and a PUT that omits it leaves the stored width alone."},"next_value":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"The number the NEXT purchase order will use. Lowering it is allowed; the trigger skips references already taken. Under a `{vendor}` prefix this covers only orders with no vendor — each vendor carries its own counter (PUT /api/vendors/{id}/po-numbering)."},"vendor_scoped":{"type":"boolean","description":"True when the prefix carries `{vendor}`, i.e. numbering runs per vendor."},"example":{"type":"string","description":"What the next reference will read, given the fields above."}},"required":["prefix","pad","next_value","vendor_scoped","example"],"additionalProperties":false},"FeaturesDocument":{"type":"object","properties":{"flags":{"description":"The org's effective feature flags.","$ref":"#/components/schemas/FeatureFlags"},"catalog":{"type":"array","items":{"$ref":"#/components/schemas/FeatureDef"},"description":"The toggleable-feature catalog — one entry per flag, with label/description/default."}},"required":["flags","catalog"],"additionalProperties":false},"FeatureFlags":{"type":"object","properties":{"accounting":{"type":"boolean","description":"GL accounts, bill coding, and ERP sync. Off hides the accounting UI and blocks its APIs."},"projects":{"type":"boolean","description":"The project dimension on requests, POs, and bills. Off hides the project pickers and blocks project writes."},"inventory":{"type":"boolean","description":"Items, builds, and BOMs. Off hides the Inventory nav and blocks inventory writes."},"itemReceipts":{"type":"boolean","description":"The standalone item-receipt list. Off hides its nav row and page; receiving on a purchase and the item-receipt APIs are unaffected."}},"required":["accounting","projects","inventory","itemReceipts"],"additionalProperties":false},"FeatureDef":{"type":"object","properties":{"key":{"type":"string"},"label":{"type":"string"},"description":{"type":"string"},"default":{"type":"boolean"}},"required":["key","label","description","default"],"additionalProperties":false},"Event":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"Unique identifier for this event row."},"organization_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"The org this event belongs to. Every list is scoped to the caller's org — you never see another org's events."},"type":{"type":"string","description":"What happened, as a dot-namespaced `<subject>.<verb>` string — e.g. `purchase_order.created`, `invoice.matched`, `team.deleted`. The namespace is stable and machine-readable; switch on it to drive feeds, integrations, or your own derived state."},"subject_type":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"The kind of thing the event is about — e.g. `purchase_order`, `invoice`, `vendor`, `team`. `null` for org-level events that have no single subject."},"subject_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}],"description":"The uuid of the subject row. Pair it with `subject_type` (pass both as filters) to read one object's complete history. `null` when `subject_type` is null."},"payload":{"anyOf":[{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},{"type":"null"}],"description":"Event-specific detail captured at emit time — e.g. the fields that changed, the new status, the amount. The shape varies by `type`; treat it as opaque JSON and read defensively. `null` when the event carries no extra detail."},"actor":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Who caused the event, as an opaque token. One of: a `users.id` uuid (an internal user), `vendor:<id>` (a vendor-portal user), a `system:*` label (a headless/automated actor such as a sweep or webhook), or `null` when no actor was attributed. For display, prefer `actor_label`."},"actor_label":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Display name for `actor`: the resolved user's name, the `system:*` label, or null."},"created_at":{"type":"string","description":"When the event was recorded. Events are returned oldest-first by this timestamp."}},"required":["id","organization_id","type","subject_type","subject_id","payload","actor","actor_label","created_at"],"additionalProperties":false,"description":"A single immutable entry in the org's activity log. One event is emitted for every meaningful change in the system (a PO created, an invoice matched, a team member added, …). Events are never updated or deleted — corrections are expressed as new events."},"UndoableStatus":{"type":"object","properties":{"available":{"type":"boolean","description":"Whether you have a line edit on this document that can still be reversed."},"event_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}],"description":"The event to `POST /api/events/{id}/undo`, or null when there is nothing to undo."}},"required":["available","event_id"],"additionalProperties":false},"UndoResult":{"type":"object","properties":{"undone":{"type":"boolean","description":"True when the edit was reversed."},"reason":{"description":"Why nothing was undone: `nothing` (the edit was already undone) or `stale` (the document's lines changed after the edit, so restoring them would discard the newer change).","anyOf":[{"type":"string","enum":["nothing","stale"]},{"type":"null"}]}},"required":["undone"],"additionalProperties":false},"UserInfo":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"name":{"type":"string"},"email":{"type":"string"},"first_name":{"anyOf":[{"type":"string"},{"type":"null"}]},"last_name":{"anyOf":[{"type":"string"},{"type":"null"}]},"role":{"type":"string"},"image_url":{"anyOf":[{"type":"string"},{"type":"null"}]},"is_self":{"type":"boolean"},"is_placeholder":{"type":"boolean"},"auto_approve":{"type":"boolean"}},"required":["id","name","email","first_name","last_name","role","image_url","is_self","is_placeholder","auto_approve"],"additionalProperties":false},"Invitation":{"type":"object","properties":{"id":{"type":"string"},"email":{"type":"string"},"role":{"type":"string","enum":["admin","member"]},"created_at":{"type":"string"}},"required":["id","email","role","created_at"],"additionalProperties":false},"Organization":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"name":{"type":"string"},"slug":{"anyOf":[{"type":"string"},{"type":"null"}]},"email_slug":{"anyOf":[{"type":"string"},{"type":"null"}]},"hosted_address":{"type":"string"}},"required":["id","name","slug","email_slug","hosted_address"],"additionalProperties":false},"SearchResult":{"type":"object","properties":{"type":{"type":"string","description":"Entity type: invoice, purchase_order, vendor, goods_receipt"},"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"title":{"type":"string"},"subtitle":{"anyOf":[{"type":"string"},{"type":"null"}]},"url":{"type":"string"}},"required":["type","id","title","subtitle","url"],"additionalProperties":false},"VendorTeamsOutput":{"type":"object","properties":{"team_ids":{"type":"array","items":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"}}},"required":["team_ids"],"additionalProperties":false},"WorkflowPredicateOutput":{"anyOf":[{"type":"object","properties":{"kind":{"type":"string","const":"group"},"op":{"type":"string","enum":["and","or"]},"children":{"type":"array","items":{"$ref":"#/components/schemas/WorkflowPredicateOutput"}}},"required":["kind","op","children"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"leaf"},"field":{"type":"string"},"operator":{"$ref":"#/components/schemas/WorkflowConditionOperator"},"value":{"anyOf":[{"type":"number"},{"type":"string"},{"type":"array","items":{"type":"string"}}]}},"required":["kind","field","operator","value"],"additionalProperties":false}]},"QuestionOptionOutput":{"type":"object","properties":{"id":{"type":"string"},"label":{"type":"string"}},"required":["id","label"],"additionalProperties":false},"ChargeOutput":{"type":"object","properties":{"label":{"anyOf":[{"type":"string"},{"type":"null"}]},"amount":{"anyOf":[{"type":"number"},{"type":"null"}]}},"additionalProperties":false},"MatchingPolicyOutput":{"type":"object","properties":{"early_invoice":{"type":"boolean","description":"When true, a line that is billed for more quantity than has been received is treated as an OPEN (not-yet-matched) state rather than a blocking exception — appropriate for spaces where the invoice routinely arrives before the goods. When false (the default), over-billing relative to receipts raises a `billed_qty_over_ordered`-style exception that blocks payment."},"price_tolerance_pct":{"default":0,"description":"Allowed slack on a billed UNIT PRICE vs the PO price, as a fraction of the PO price (0.02 = 2%). A per-unit difference within the larger of this and `price_tolerance_abs` is treated as a match; beyond it raises billed_price_over/under_ordered. Default 0 = any difference flags.","type":"number","minimum":0,"maximum":1},"price_tolerance_abs":{"default":0,"description":"Absolute per-unit price slack, in the document's currency (e.g. 0.01 to absorb a cent of OCR rounding). Combined with `price_tolerance_pct` — the larger allowance wins. Default 0.","type":"number","minimum":0},"amount_tolerance_pct":{"default":0,"description":"Allowed slack on the cumulative billed DOLLARS vs the ordered dollars on a PO line, as a fraction of the ordered amount (0.05 = 5%). Cumulative billing beyond the larger of this and `amount_tolerance_abs` raises a blocking billed_amount_over_ordered. Default 0 = any overage flags.","type":"number","minimum":0,"maximum":1},"amount_tolerance_abs":{"default":0,"description":"Absolute slack on the cumulative billed dollars vs the ordered dollars on a PO line. Combined with `amount_tolerance_pct` — the larger allowance wins. Default 0.","type":"number","minimum":0}},"required":["early_invoice","price_tolerance_pct","price_tolerance_abs","amount_tolerance_pct","amount_tolerance_abs"],"additionalProperties":false},"ExceptionAssignmentSettingsOutput":{"type":"object","properties":{"fallback_assignee_user_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}],"description":"The user who owns a new payment-blocking exception when nobody else can be resolved — i.e. after the routing rules miss AND the PO has no usable creator. Null leaves such exceptions unassigned (visible in the queue but owned by no one)."}},"required":["fallback_assignee_user_id"],"additionalProperties":false},"RequestCoordinatorSettingsOutput":{"type":"object","properties":{"coordinator_user_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}],"description":"The user every newly created procurement request is assigned to (the effective owner who shepherds it through approval, alongside its requester). Stamped at creation; changing it does not move requests already created. Null leaves new requests owned by their creator."}},"required":["coordinator_user_id"],"additionalProperties":false}},"securitySchemes":{"BearerAuth":{"type":"http","scheme":"bearer","description":"Create an API key in **Settings** at console.saldor.com."}}}}