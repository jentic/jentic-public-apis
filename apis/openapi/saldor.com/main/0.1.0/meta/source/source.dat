/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"delete":{"summary":"Drop a team's workflow","description":"Admin-only. The team goes back to what it inherits (its nearest ancestor's graph, else the org default). 404 when it has no workflow of its own.","tags":["Workflows"],"x-admin":true,"parameters":[{"in":"path","name":"type","schema":{"$ref":"#/components/schemas/WorkflowType"},"required":true,"description":"What triggers the workflow. One template per type per org, plus a per-team override for procurement requests."},{"in":"path","name":"teamId","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Drop a team's workflow","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"ok":{"type":"boolean","const":true}},"required":["ok"],"additionalProperties":false},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/workflows/simulate":{"post":{"summary":"Simulate a workflow","description":"Dry-run which workflow and which path a hypothetical request would trigger — the resolved template (org default vs a team override), the taken path with conditions settled, and the resulting approval chain. Read-only: creates no instance and writes nothing.","tags":["Workflows"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowSimulateBody"}}}},"responses":{"200":{"description":"Simulate a workflow","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/WorkflowSimulation"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/workflow-instances":{"get":{"summary":"List workflow instances for a subject","description":"Oldest first — the newest is the current one.","tags":["Workflows"],"parameters":[{"in":"query","name":"subject_type","schema":{"$ref":"#/components/schemas/WorkflowSubjectType"},"required":true},{"in":"query","name":"subject_id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"List workflow instances for a subject","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/WorkflowInstance"}},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/workflow-nodes/{id}/approve":{"post":{"summary":"Approve a workflow step","description":"Assignee-only (403). 409 when the step or its flow is not active. Cascades activation; when every node is approved, a procurement-request flow marks the purchase approved — the order is sent separately from there. The step that COMPLETES a procurement-request flow is held until what that approval establishes holds: 422 vendor_not_approved while the purchase's vendor is still pending (a purchase with no vendor yet is not held), and 422 contract_not_active when an already-linked contract hasn't been activated. Both throw before any state change, so the same approval simply succeeds once they settle.","tags":["Workflows"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowNodeActionBody"}}}},"responses":{"200":{"description":"Approve a workflow step","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/WorkflowInstance"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/workflow-nodes/{id}/reject":{"post":{"summary":"Reject a workflow step","description":"Assignee-only (403). Finalizes the flow as rejected; a procurement-request flow returns the purchase to the requester for edits.","tags":["Workflows"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowNodeActionBody"}}}},"responses":{"200":{"description":"Reject a workflow step","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/WorkflowInstance"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"