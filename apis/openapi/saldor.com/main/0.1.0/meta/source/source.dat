,"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/WorkflowTemplate"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"put":{"summary":"Replace a workflow template","description":"Admin-only. Replaces the whole graph for the type; in-flight instances keep their snapshot. 422 invalid_graph on a cyclic/malformed graph; 422 invalid_assignee on a non-member assignee.","tags":["Workflows"],"x-admin":true,"parameters":[{"in":"path","name":"type","schema":{"$ref":"#/components/schemas/WorkflowType"},"required":true,"description":"What triggers the workflow. One template per type per org, plus a per-team override for procurement requests."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WorkflowTemplatePut"}}}},"responses":{"200":{"description":"Replace a workflow template","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/WorkflowTemplate"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/workflows/templates/{type}/teams/{teamId}":{"get":{"summary":"Get a team's workflow","description":"The graph this team's requests run: its own, else the nearest ancestor team's, else the org default. `customized` false means the team has none of its own and the inherited graph is returned (`template.team_id` says whose) — customizing starts from exactly that copy. 404 on an unknown team.","tags":["Workflows"],"parameters":[{"in":"path","name":"type","schema":{"$ref":"#/components/schemas/WorkflowType"},"required":true,"description":"What triggers the workflow. One template per type per org, plus a per-team override for procurement requests."},{"in":"path","name":"teamId","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Get a team's workflow","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/WorkflowTeamTemplate"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{