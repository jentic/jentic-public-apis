ntact. The contact must belong to the purchase's vendor.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AddPurchaseContact"}}}},"responses":{"200":{"description":"Add a point of contact to a purchase","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/PurchaseContact"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/contacts/{contactId}":{"delete":{"summary":"Remove a point of contact from a purchase","description":"Unpins a point of contact. The underlying vendor contact is left untouched.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true},{"in":"path","name":"contactId","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Remove a point of contact from a purchase","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"removed":{"type":"boolean"}},"required":["removed"],"additionalProperties":false},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/request-review":{"post":{"summary":"Ask someone to review a draft","description":"The optional first step in front of approval: names a member to review the draft and blocks publishing until they approve. Re-requesting while one is pending re-points it. 422 not_draft unless the purchase is a draft; 422 invalid_reviewer for a non-member, a placeholder member, or the requester themselves; 403 unless you created it or are an admin.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RequestReviewBody"}}}},"responses":{"200":{"description":"Ask someone to review a draft","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/ProcurementRequest"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/cancel-review":{"post":{"summary":"Withdraw a requested review","description":"Clears the pending review so the draft can be published normally — also the admin escape hatch for a review nobody can clear. The reviewer is kept so it can be re-requested in one click. No-op when nothing is pending. 422 not_draft unless the purchase is a draft; 403 unless you created it or are an admin.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Withdraw a requested review","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/ProcurementRequest"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/review":{"post":{"summary":"Decide a requested review","description":"The requested reviewer's verdict. `approve` records the review and publishes the purchase in the same call — clearing the gate is what releases it. `send_back` clears the pending review and leaves the draft with its requester to edit and re-request. 403 not_reviewer unless you are the named reviewer; 422 no_review_pending when no review is waiting.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReviewDecisionBody"}}}},"responses":{"200":{"description":"Decide a requested review","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/ProcurementRequest"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/publish":{"post":{"summary":"Publish a draft purchase","description":"Moves a draft to in_review and instantiates the org's procurement-request workflow over it — the intake endpoint creates the draft, this submits it for approval. When the purchase's vendor isn't approved yet, the VENDOR's approval starts instead and the purchase waits: it is published, carries no workflow instance, and its chain opens automatically once that vendor is approved. 422 not_publishable unless the purchase is a draft; 422 lines_required if it has no line items and 422 line_figures_required if any line is missing a quantity or a price (approval is a decision about spend — without both figures there is no total for thresholds to route on); 422 shipping_address_required if any line is goods and no live shipping address is set (approval mints the order, which has no ship-to of its own, so an address-less purchase would strand its order at Send); 403 unless you created it or are an admin.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Publish a draft purchase","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/ProcurementRequest"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/cancel":{"post":{"summary":"Cancel a purchase","description":"The requester — or an org admin — abandons a purchase that is still under review: any live approval workflow is superseded and the case moves to the terminal `cancelled` status. 422 not_cancellable once the purchase has been rejected or approved (an approved case has already emailed a PO to the vendor); 403 unless you created it or are an admin.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Cancel a purchase","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/ProcurementRequest"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/restart":{"post":{"summary":"Resubmit a rejected purchase","description":"Returns the case to in_review with a fresh workflow instance snapshotted from the current template. 422 unless the case is rejected. Null when the purchase is waiting on its vendor's approval — the resubmission stands and the chain opens once that vendor is approved.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Resubmit a rejected purchase","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"anyOf":[{"$ref":"#/components/schemas/WorkflowInstance"},{"type":"null"}]},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/accept-sourcing-award":{"post":{"summary":"Accept the sourcing award","description":"Applies the award from a sourcing event fired by this purchase: the winning vendor and its quoted pricing become the purchase's vendor + lines. 422 no_award if no awarded sourcing event is linked; 403 unless you created it or are an admin.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Accept the sourcing award","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/ProcurementRequest"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/record":{"post":{"summary":"Record an in-flight purchase","description":"Bring a purchase placed OUTSIDE the platform (by phone, email, or a vendor website) into the system: creates an approved procurement request + an issued purchase order pair, marked origin='recorded'. No approval workflow runs and no email reaches the vendor. Everything downstream (item receipts, bills, three-way match, Order Watch, payment) then works exactly as for any issued PO. A new vendor (vendor_name) is minted pending + sent through approval. When already_paid is given, the matching bill is created and marked paid. Returns the created PO.","tags":["Purchases"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RecordPurchaseInput"}}}},"responses":{"201":{"description":"Record an in-flight purchase","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/PurchaseOrder"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/order/notify-vendor":{"post":{"summary":"Email mismatch notice","description":"If the PO's three-way match has unresolved discrepancies (price variance, over-billing, or a bill with no item receipt), composes and sends the vendor an email explaining each one, with a reply-to of the org's invoice inbox so a corrected invoice flows back in. Returns 422 when the documents already match (nothing to dispute) or the vendor has no email on file. Pass `dry_run: true` to preview the composed email without sending it.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/NotifyVendorInput"}}}},"responses":{"200":{"description":"Email mismatch notice","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/VendorNotification"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/order/email-preview":{"get":{"summary":"Preview a purchase order's vendor email","description":"Composes (without sending) the exact email + attached PDF the purchase order was emailed to its vendor with — for the audit/'view email' affordance. Read-only; mutates nothing.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Preview a purchase order's vendor email","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/PurchaseOrderSentEmailPreview"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/order/emails":{"get":{"summary":"List purchase order emails","description":"The full email history for a purchase order — the order itself, dispute notices, follow-ups, and inbound vendor replies. Read-only.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"List purchase order emails","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/PoEmailsView"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/agent":{"get":{"summary":"Get a purchase's order-watch agent","description":"The on-demand agent for this purchase: its editable system prompt and the latest verdict, plus the app default prompt and everything awaiting a decision. Returns { watch: null } when the purchase has no watch (created before the feature).","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true},{"in":"query","name":"context","schema":{"description":"Pass `1` to compute and return the expensive `context` field (the agent's assembled prompt input). Omitted by default so the hot page-load path skips it.","type":"string","enum":["1"]},"description":"Pass `1` to compute and return the expensive `context` field (the agent's assembled prompt input). Omitted by default so the hot page-load path skips it."}],"responses":{"200":{"description":"Get a purchase's order-watch agent","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/AgentWatchView"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"patch":{"summary":"Edit a purchase's agent instruction","description":"Set the per-purchase system prompt the agent follows, or pass null to reset to the app default.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AgentWatchPatch"}}}},"responses":{"200":{"description":"Edit a purchase's agent instruction","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/AgentWatchView"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/agent/run":{"post":{"summary":"Run a purchase's agent now","description":"Runs the agent inline: it reads the purchase and its vendor emails and returns a fresh verdict, a summary, and what it looked at. Creates the watch if the purchase has none.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Run a purchase's agent now","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref