fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}],"description":"The member asked to review this draft before it is published. Kept after a send-back so the review can be re-requested in one click; null means none was ever asked for."},"review_requested_at":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"When the review was asked for. Set on a draft with reviewed_at null, the review is PENDING and publishing 422s review_pending. Cleared by a send-back or a cancel."},"reviewed_at":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"When the requested reviewer approved — the same call publishes the purchase."},"changes_requested_at":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"When an approver last sent this purchase back for changes. Set on a draft, its owner (coordinator ?? requester) owes it an edit and a re-publish, and carries the task for it. Cleared at publish."},"changes_requested_by":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}],"description":"The approver who sent it back for changes; null when it was never sent back."},"shipping_address_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}],"description":"The org address-book entry goods on this purchase ship to. Required to publish whenever any line is goods; snapshotted onto the PO."},"lead_time_days":{"anyOf":[{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},{"type":"null"}],"description":"Expected supplier lead time in days; carried to the PO's expected delivery date on approval."},"lead_time_source":{"anyOf":[{"$r