"object","properties":{"vendor_name":{"type":"string"},"invoice_number":{"type":"string"},"declared_po_ref":{"type":"string"},"invoice_date":{"type":"string"},"due_date":{"type":"string"},"payment_terms_days":{"type":"integer","minimum":0,"maximum":9007199254740991},"currency":{"type":"string"},"subtotal":{"type":"number"},"tax":{"type":"number"},"total":{"type":"number"},"lines":{"type":"array","items":{"$ref":"#/components/schemas/LineItemInput"}}}},"InvoiceStatus":{"type":"string","enum":["received","paid","voided"],"description":"Invoice lifecycle state (Three Way Match spec, Payment): received → paid (gated on derived payability) | voided (ungated; never to be paid). Both are explicit human facts and reversible (→ received). Paid/voided are never derived by the system."},"InvoicePatch":{"type":"object","properties":{"status":{"$ref":"#/components/schemas/InvoiceStatus"},"vendor_name":{"anyOf":[{"type":"string"},{"type":"null"}]},"invoice_number":{"type":"string"},"declared_po_ref":{"type":"string"},"invoice_date":{"type":"string"},"due_date":{"type":"string"},"payment_terms_days":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}]},"currency":{"type":"string"},"subtotal":{"description":"Extracted net amount before tax; corrects an OCR/format slip.","anyOf":[{"type":"number"},{"type":"null"}]},"tax":{"description":"Extracted tax amount; editing it recomputes the total.","anyOf":[{"type":"number"},{"type":"null"}]},"total":{"description":"Extracted gross amount; kept as an override when it can't be reconciled from the lines.","anyOf":[{"type":"number"},{"type":"null"}]},"paid_at":{"type":"string"},"note":{"description":"Attached to the paid/voided fact as its note.","type":"string"}}},"InvoiceUploadForm":{"type":"object","properties":{"file":{"type":"string","format":"binary","description":"Invoice PDF (application/pdf)."}},"required":["file"]},"DuplicateResolveBody":{"type":"object","properties":{"resolution":{"type":"string","enum":["confirmed","dismissed"],"description":"confirmed = yes, this IS a duplicate (the bill is voided and stays unpayable); dismissed = not a duplicate (clears the payment block)."},"note":{"description":"Why — recorded on the resolution.","type":"string"}},"required":["resolution"]},"InvoiceLinesReplaceBody":{"type":"object","properties":{"lines":{"minItems":1,"type":"array","items":{"$ref":"#/components/schemas/LineItemInput"}},"coding":{"type":"array","items":{"type":"object","properties":{"gl_account_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}]},"project_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}]}}}}},"required":["lines"]},"MatchBillPurchaseInput":{"type":"object","properties":{"purchase_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}],"description":"The purchase to file this bill under, or null to detach it back to a standalone bill."}},"required":["purchase_id"]},"RecordPurchaseFromBillInput":{"type":"object","properties":{"placed_at":{"description":"When the purchase was placed; defaults to the invoice date.","type":"string","format":"date","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"},"placed_via":{"description":"How the purchase was placed with the vendor.","type":"string","enum":["email","phone","website","other"]}}},"InvoiceCodingPut":{"type":"object","properties":{"default_gl_account_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}]},"project_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}]},"lines":{"default":[],"type":"array","items":{"$ref":"#/components/schemas/InvoiceCodingLineInput"}}}},"InvoiceCodingLineInput":{"type":"object","properties":{"id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"gl_account_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}]},"project_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}]}},"required":["id"]},"BudgetSet":{"type":"object","properties":{"scope_type":{"type":"string","enum":["team","vendor"],"description":"What a budget limits — one team or one vendor. There is no company-wide scope."},"scope_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","description":"The team or vendor to limit; must resolve to a live row."},"period":{"type":"string","pattern":"^\\d{4}(-Q[1-4])?$","description":"A quarter (`2026-Q3`) or a year (`2026`).","example":"2026-Q3"},"amount":{"anyOf":[{"type":"number","minimum":0},{"type":"null"}],"description":"The limit, from this period onward. Null stops a limit carried in from an earlier period."},"currency":{"description":"Defaults to USD. Budgets are denominated, never converted.","type":"string"}},"required":["scope_type","scope_id","period","amount"]},"MatchAccept":{"type":"object","properties":{"purchase_line_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"receipt_line_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"invoice_line_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"note":{"type":"string"}},"required":["purchase_line_id"],"description":"Confirm a pairing: the PO line plus exactly ONE of receipt_line_id / invoice_line_id. Confirms a suggested pairing or asserts a manual one — the input is identical either way. Always allowed, including into a derived-closed PO (which then derives back open) and over a prior rejection (the explicit human assertion wins)."},"MatchReject":{"type":"object","properties":{"purchase_line_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"purchase_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"receipt_line_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"invoice_line_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"note":{"type":"string"}},"description":"Refuse a pairing for the incoming line (exactly one of receipt_line_id / invoice_line_id). Pass purchase_line_id to refuse one pairing — unmatching it first if it is currently matched; pass purchase_id to refuse a document-level suggestion (covers the whole PO). Records a sticky rejection so the pairing is never re-suggested nor auto-matched; re-accept to override."},"AcceptanceCreate":{"type":"object","properties":{"state":{"$ref":"#/components/schemas/AcceptableStateName"},"purchase_line_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"receipt_line_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"invoice_line_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"note":{"type":"string"}},"required":["state"],"description":"Subject: purchase_line_id for tally states; purchase_line_id + invoice_line_id for price states; receipt_line_id or invoice_line_id alone for unmatched_line. The state must currently be derived; its values are snapshotted server-side (value-binding)."},"AcceptableStateName":{"type":"string","enum":["billed_qty_over_ordered","billed_amount_over_ordered","billed_price_over_ordered","billed_price_under_ordered","received_over_ordered","billed_qty_over_received","billed_qty_under_ordered","billed_qty_under_received","received_under_ordered","delivery_overdue","unmatched_line"]},"AssignExceptionBody":{"type":"object","properties":{"assignee_user_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"assignee_team_id":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"note":{"type":"string"}},"description":"Assign a payment-blocking exception to a person (assignee_user_id) or a team queue (assignee_team_id). Pass at most one — omit both to assign it to YOURSELF. The exception must currently be derived and blocking. A person is notified in Slack; a team queue is NOT notified until someone takes it. Assigning yourself onto a team queue you belong to CLAIMS it (moves it into your work, keeping the team for provenance); a self-assign is never Slacked. Reverse with DELETE: a claimed queue item returns to its team's queue, anything else reverts to the default owner."},"MatchingPolicy":{"type":"object","properties":{"early_invoice":{"type":"boolean","description":"When true, a line that is billed for more quantity than has been received is treated as an OPEN (not-yet-matched) state rather than a blocking exception — appropriate for spaces where the invoice routinely arrives before the goods. When false (the default), over-billing relative to receipts raises a `billed_qty_over_ordered`-style exception that blocks payment."},"price_tolerance_pct":{"default":0,"description":"Allowed slack on a billed UNIT PRICE vs the PO price, as a fraction of the PO price (0.02 = 2%). A per-unit difference within the larger of this and `price_tolerance_abs` is treated as a match; beyond it raises billed_price_over/under_ordered. Default 0 = any difference flags.","type":"number","minimum":0,"maximum":1},"price_tolerance_abs":{"default":0,"description":"Absolute per-unit price slack, in the document's currency (e.g. 0.01 to absorb a cent of OCR rounding). Combined with `price_tolerance_pct` — the larger allowance wins. Default 0.","type":"number","minimum":0},"amount_tolerance_pct":{"default":0,"description":"Allowed slack on the cumulative billed DOLLARS vs the ordered dollars on a PO line, as a fraction of the ordered amount (0.05 = 5%). Cumulative billing beyond the larger of this and `amount_tolerance_abs` raises a blocking billed_amount_over_ordered. Default 0 = any overage flags.","type":"number","minimum":0,"maximum":1},"amount_tolerance_abs":{"default":0,"description":"Absolute slack on the cumulative billed dollars vs the ordered dollars on a PO line. Combined with `amount_tolerance_pct` — the larger allowance wins. Default 0.","type":"number","minimum":0}},"required":["early_invoice"]},"ExceptionAssignmentSettings":{"type":"object","properties":{"fallback_assignee_user_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}],"description":"The user who owns a new payment-blocking exception when nobody else can be resolved — i.e. after the routing rules miss AND the PO has no usable creator. Null leaves such exceptions unassigned (visible in the queue but owned by no one)."}},"required":["fallback_assignee_user_id"]},"RequestCoordinatorSettings":{"type":"object","properties":{"coordinator_user_id":{"anyOf":[{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},{"type":"null"}],"description":"The user every newly created procurement request is assigned to (the effective owner who shepherds it through approval, alongside its requester). Stamped at creation; changing it does not move requests already created. Null leaves new requests owned by their creator."}},"required":["coordinator_user_id"]},"ExceptionRoutingRuleInput":{"type":"object","properties":{"match_state":{"description":"Restrict the rule to this derived exception state; omit to match any state.","$ref":"#/components/schemas/StateName"},"po_total_operator":{"description":"Operator for the PO-total condition; must be sent together with `po_total_amount`.","type":"string","enum":["gte","gt","lte","lt","eq"]},"po_total_amount":{"description":"Threshold for the PO-total condition; must be sent together with `po_total_operator`.","type":"number"},"assignee_user_id":{"description":"Route to this user. Provide exactly one of assignee_user_id / assignee_team_id.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"assignee_team_id":{"description":"Route to this team queue. Provide exactly one of assignee_user_id / assignee_team_id.","type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"note":{"description":"Optional human note explaining the rule.","type":"string"}},"description":"A single routing rule. Order in the request array becomes the rule's evaluation order (first match wins). Each rule routes to exactly one owner (a user or a team), with an optional state and/or PO-total condition gating when it fires."},"StateName":{"type":"string","enum":["billed_qty_over_ordered","billed_amount_over_ordered","billed_price_over_ordered","billed_price_under_ordered","received_over_ordered","billed_qty_over_received","billed_qty_under_ordered","billed_qty_under_received","received_under_ordered","delivery_overdue","unmatched_line","happy"]},"EmailRoutingPatch":{"type":"object","properties":{"routing":{"description":"Per-kind channel choices to change; each value is `hosted` or a Gmail connection id. Omitted kinds keep their current setting.","type":"object","properties":{"po_send":{"type":"string"},"rfx_invite":{"type":"string"},"dispute":{"type":"string"},"bill_pay":{"type":"string"}}},"scan_unknown_senders":{"description":"Turn unknown-sender screening (new-vendor suggestions) on or off for the org.","type":"boolean"},"email_purchase_orders":{"description":"Turn emailing purchase orders to vendors on or off for the org.","type":"boolean"}}},"NotificationPreferencesPatch":{"type":"object","properties":{"email_enabled":{"type":"boolean","description":"Receive direct workflow-task alerts by email. Off by default."},"slack_enabled":{"type":"boolean","description":"Receive direct workflow-task alerts by Slack DM."}}},"PoNumberingInput":{"type":"object","properties":{"prefix":{"type":"string","maxLength":40},"pad":{"type":"integer","minimum":0,"maximum":12},"next_value":{"type":"integer","minimum":1,"maximum":999999999}},"required":["prefix","next_value"]},"FeatureFlagsPatch":{"type":"object","properties":{"accounting":{"type":"boolean"},"projects":{"type":"boolean"},"inventory":{"type":"boolean"},"itemReceipts":{"type":"boolean"}}},"CommentSubjectType":{"type":"string","enum":["purchase_order","goods_receipt","invoice","sourcing_event","purchase","quote"],"description":"The kind of object the comment is attached to."},"CommentCreateInput":{"type":"object","properties":{"subject_type":{"$ref":"#/components/schemas/C