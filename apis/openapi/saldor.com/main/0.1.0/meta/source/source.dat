on":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/archive":{"post":{"summary":"Archive a purchase","description":"Hides a purchase from the default list (sets archived_at) and takes its open tasks and blocking exceptions out of the inbox with it. Reversible via unarchive; orthogonal to the derived match state, so it never changes whether the purchase is settled. Admin only.","tags":["Purchases"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Archive a purchase","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Purchase"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/purchases/{id}/unarchive":{"post":{"summary":"Unarchive a purchase","description":"Clears archived_at, returning the purchase to the default list. Admin only.","tags":["Purchases"],"parameters":[{"in":"path","n