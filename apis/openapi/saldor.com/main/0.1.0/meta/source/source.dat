"#/components/schemas/ErrorEnvelope"}}}}}},"put":{"summary":"Set a vendor's payment details","description":"Admin-only. Upserts the vendor's remittance/banking details. The account number is stored as given and returned masked (last 4); leave it blank to keep the stored one. Other empty fields are cleared. A wire/check remittance address must be either empty or complete (street, city, country — plus a valid state and ZIP in the US); a partial one is rejected rather than sent on to a payment rail. When the vendor is approved, a real change is HELD behind a vendor_edit workflow (returned as `pending_edit`, account number masked) and applied on approval — 409 if one is already in flight. A pending vendor or a no-op change applies immediately.","tags":["Vendors"],"x-admin":true,"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VendorPaymentDetailsUpsert"}}}},"responses":{"200":{"description":"Set a vendor's payment details","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/VendorPaymentDetailsPut"},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}},"delete":{"summary":"Clear a vendor's payment details","description":"Admin-only. Removes the vendor's stored payment details. When the vendor is approved, the removal is HELD behind a vendor_edit workflow (returned as `pending_edit`, `removed` false) and applied on approval — 409 if a change is already in flight. On a pending vendor it removes immediately.","tags":["Vendors"],"x-admin":true,"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Clear a vendor's payment details","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"removed":{"type":"boolean"},"pending_edit":{"anyOf":[{"$ref":"#/components/schemas/VendorPendingEdit"},{"type":"null"}]}},"required":["removed"],"additionalProperties":false},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/vendors/{id}/company-details":{"get":{"summary":"Get a vendor's company details","description":"The vendor's business profi