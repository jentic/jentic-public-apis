,"responses":{"200":{"description":"Send the RFX to a candidate","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"sent":{"type":"boolean"},"to":{"type":"string"},"subject":{"type":"string"},"message_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"simulated":{"type":"boolean"},"delivery":{"type":"string","enum":["portal","document"],"description":"`portal` = a deep link to the quote form; `document` = emailed to reply to, with any RFX document attached."}},"required":["sent","to","subject","message_id","simulated","delivery"],"additionalProperties":false},"meta":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["data"],"additionalProperties":false}}}},"400":{"description":"Invalid request body or query","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Authentication required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"A domain rule was violated (e.g. illegal status transition)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/api/sourcing-events/{id}/comparison":{"get":{"summary":"Get the quote comparison grid","description":"A normalized candidate × requisition-line grid with per-candidate totals — the Phase-1 evaluation surface (no auto-scoring).","tags":["Sourcing"],"parameters":[{"in":"path","name":"id","schema":{"type":"string","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"},"required":true}],"responses":{"200":{"description":"Get the quote comparison grid","content":{"application/json":{"schema":{"type":"object",