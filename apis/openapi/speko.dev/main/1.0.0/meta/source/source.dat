                "properties": {
                  "reason": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Revoked consent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsConsent"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sms/suppressions": {
      "get": {
        "tags": [
