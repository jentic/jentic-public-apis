          "last_synced_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SmsSettingsUpdate": {
        "type": "object",
        "properties": {
          "help_message": {
            "type": "string",
            "maxLength": 320
          },
          "opt_out_message": {
            "type": "string",
            "maxLength": 320
          },
          "opt_in_message": {
            "type": "string",
            "maxLength": 320
          },
          "retention_days": {
            "type": "integer",
            "minimum": 30,
            "maximum": 3650
          },
          "quiet_hours_start": {
            "type": "string"
          },
          "quiet_hours_end": {
            "type": "string"
          },
          "default_timezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "default_automation_enabled": {
            "type": "boolean"
          }
        }
      },
      "WebhookEventType": {
        "type": "string",
        "enum": [
          "call.pre_call",
          "call.status",
          "call.report",
          "call.analysis",
          "call.recording",
          "imessage.received",
          "imessage.reaction_received",
          "imessage.sent",
          "imessage.delivered",
          "imessage.delivery_failed",
          "sms.received",
          "sms.accepted",
          "sms.sent",
          "sms.delivered",
          "sms.delivery_failed",
          "sms.submission_unknown",
          "sms.opted_out",
          "sms.opted_in"
        ]
      },
      "WorkspaceWebhookEventType": {
        "type": "string",
        "enum": [
          "call.pre_call",
          "call.status",
          "call.report",
          "call.analysis",
          "call.recording",
          "sms.received",
          "sms.accepted",
          "sms.sent",
          "sms.delivered",
          "sms.delivery_failed",
          "sms.submission_unknown",
          "sms.opted_out",
          "sms.opted_in"
        ]
      },
      "WebhookDeliveryStatus": {
        "type": "string",
        "enum": [
          "pending",
          "delivering",
          "succeeded",
          "failed",
          "cancelled",
          "expired"
        ]
      },
      "WebhookExtractionField": {
        "type": "object",
        "required": [
          "name",
          "type",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "enum"
            ]
          },
          "description": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "WebhookEndpointAuthHeaderInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string",
            "writeOnly": true,
            "description": "Required when creating a new secret header. Omit during update to preserve its encrypted value."
          }
        }
      },
      "WebhookEndpointWritable": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/WorkspaceWebhookEventType"
            }
          },
          "allAgents": {
            "type": "boolean",
            "default": true
          },
          "agentIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 250
          },
          "filterTags": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 256
            },
            "description": "Case-sensitive subset match. Tagged matches override untagged defaults."
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "authHeaders": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/WebhookEndpointAuthHeaderInput"
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 500,
            "maximum": 8000,
            "default": 4000
          },
          "signingSecretSource": {
            "type": "string",
            "enum": [
              "workspace",
              "custom"
            ],
            "default": "workspace"
          },
          "signingSecret": {
            "type": "string",
            "minLength": 8,
            "writeOnly": true,
            "description": "Required when signingSecretSource is custom. Never returned."
          },
          "extractionFields": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "$ref": "#/components/schemas/WebhookExtractionField"
            }
          },
          "contentMode": {
            "type": "string",
            "enum": [
              "full",
              "metadata_only"
            ],
            "default": "full",
            "description": "Controls whether SMS webhook payloads include message text."
          }
        }
      },
      "WebhookEndpointInput": {
        "allOf": [
          {
            "$ref": "#/components/schemas/WebhookEndpointWritable"
          }
        ],
        "required": [
          "name",
          "url",
          "events"
        ]
      },
      "WebhookEndpointUpdate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/WebhookEndpointWritable"
          }
        ]
      },
      "WebhookEndpoint": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "events",
          "allAgents",
          "agentIds",
          "filterTags",
          "headers",
          "authHeaders",
          "timeoutMs",
          "signingSecretSource",
          "hasCustomSigningSecret",
          "extractionFields",
          "contentMode",
          "legacyManaged",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkspaceWebhookEventType"
            }
          },
          "allAgents": {
            "type": "boolean"
          },
          "agentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "filterTags": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "authHeaders": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "configured"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "configured": {
                  "type": "boolean",
                  "const": true
                }
              }
            }
          },
          "timeoutMs": {
            "type": "integer"
          },
          "signingSecretSource": {
            "type": "string",
            "enum": [
              "workspace",
              "custom"
            ]
          },
          "hasCustomSigningSecret": {
            "type": "boolean"
          },
          "extractionFields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookExtractionField"
            }
          },
          "contentMode": {
            "type": "string",
            "enum": [
              "full",
              "metadata_only"
            ]
          },
          "legacyManaged": {
            "type": "boolean",
            "description": "True when synchronized from deprecated agent.webhooks fields."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WebhookDelivery": {
        "type": "object",
        "required": [
          "id",
          "eventId",
          "endpointId",
          "endpointName",
          "endpointKind",
          "endpointDeleted",
          "event",
          "sessionId",
          "agentId",
          "webhookTags",
          "status",
          "attempts",
          "httpStatus",
          "error",
          "occurredAt",
          "expiresAt",
          "deliveredAt",
          "createdAt",
          "canRedeliver"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "description": "Stable Speko or upstream-provider webhook ID."
          },
          "endpointId": {
            "type": "string"
          },
          "endpointName": {
            "type": "string"
          },
          "endpointKind": {
            "type": "string",
            "enum": [
              "workspace",
              "imessage"
            ]
          },
          "endpointDeleted": {
            "type": "boolean"
          },
          "event": {
            "$ref": "#/components/schemas/WebhookEventType"
          },
          "sessionId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "agentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "webhookTags": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "status": {
            "$ref": "#/components/schemas/WebhookDeliveryStatus"
          },
          "attempts": {
            "type": "integer"
          },
          "httpStatus": {
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "deliveredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "canRedeliver": {
            "type": "boolean",
            "description": "Whether manual redelivery is currently available."
          }
        }
      },
      "WebhookDeliveryEndpointOption": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "deleted"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "workspace",
              "imessage"
            ]
          },
          "deleted": {
            "type": "boolean"
          }
        }
      },
      "WebhookDeliveryPage": {
        "type": "object",
        "required": [
          "data",
          "nextCursor",
          "endpointOptions"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookDelivery"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "endpointOptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookDeliveryEndpointOption"
            }
          }
        }
      },
      "WebhookDeliveryAttempt": {
        "type": "object",
        "required": [
          "id",
          "attemptNumber",
          "trigger",
          "requestUrl",
          "requestHeaders",
          "requestBody",
          "responseStatus",
          "responseBody",
          "responseTruncated",
          "durationMs",
          "error",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "attemptNumber": {
            "type": "integer"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "automatic",
              "manual"
            ]
          },
          "requestUrl": {
            "type": "string",
            "description": "Sanitized URL with query values redacted."
          },
          "requestHeaders": {
            "$ref": "#/components/schemas/JsonObject"
          },
          "requestBody": {
            "$ref": "#/components/schemas/JsonObject"
          },
          "responseStatus": {
            "type": [
              "integer",
              "null"
            ]
          },
          "responseBody": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 65536
          },
          "responseTruncated": {
            "type": "boolean"
          },
          "durationMs": {
            "type": "integer"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WebhookDeliveryDetail": {
        "type": "object",
        "description": "Includes all WebhookDelivery fields, with the numeric list-row attempts field exposed as attemptCount and attempts containing chronological attempt records.",
        "required": [
          "attemptCount",
          "requestPayload",
          "attempts"
        ],
        "properties": {
          "attemptCount": {
            "type": "integer"
          },
          "requestPayload": {
            "$ref": "#/components/schemas/JsonObject"
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookDeliveryAttempt"
            }
          }
        },
        "additionalProperties": true
      },
      "WebhookRedeliveryResult": {
        "type": "object",
        "required": [
          "delivered",
          "httpStatus",
          "error"
        ],
        "properties": {
          "delivered": {
            "type": "boolean"
          },
          "httpStatus": {
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "RoutingIntent": {
        "type": "object",
        "required": [
          "language"
        ],
        "properties": {
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
            "description": "BCP-47 language tag, e.g. `en`, `en-US`, `es-MX`.",
            "examples": [
              "en-US"
            ]
          },
          "region": {
            "type": "string",
            "enum": [
              "global",
              "us-east4",
              "europe-west3",
              "asia-southeast1"
            ],
            "default": "global",
            "description": "Region whose streaming-latency measurements should be used. `global` falls through to batch-mode rows when no per-region data matches."
          },
          "optimizeFor": {
            "type": "string",
            "enum": [
              "balanced",
              "accuracy",
              "latency",
              "cost"
            ],
            "default": "balanced"
          }
        }
      },
      "PipelineConstraints": {
        "type": "object",
        "properties": {
          "allowedProviders": {
            "type": "object",
            "description": "Restrict candidate pool per modality. Router still ranks by score. Each entry is either `\"<vendor>\"` (vendor wildcard — allow any model from that vendor) or `\"<vendor>:<model>\"` (allow only that specific model). Failover stays active across all entries in the layer.",
            "properties": {
              "stt": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Allowed STT provider entry. Either a vendor id (e.g. `\"deepgram\"` — any Deepgram model) or `\"<vendor>:<model>\"` (e.g. `\"deepgram:nova-3\"` — only Nova-3, no fallback to other Deepgram models within the vendor). Both forms can be mixed in the same array.",
                  "examples": [
                    "deepgram",
                    "deepgram:nova-3",
                    "assemblyai"
                  ]
                }
              },
              "llm": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Allowed LLM provider entry. Either a vendor id (e.g. `\"openai\"` — any OpenAI model) or `\"<vendor>:<model>\"` (e.g. `\"openai:gpt-5\"` — only that model). Both forms can be mixed in the same array.",
                  "examples": [
                    "openai",
                    "openai:gpt-5",
                    "anthropic"
                  ]
                }
              },
              "tts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Allowed TTS provider entry. Either a vendor id (e.g. `\"elevenlabs\"` — any ElevenLabs model) or `\"<vendor>:<model>\"` (e.g. `\"elevenlabs:eleven_flash_v2_5\"` — only that model). Both forms can be mixed in the same array.",
                  "examples": [
                    "elevenlabs",
                    "elevenlabs:eleven_flash_v2_5",
                    "cartesia"
                  ]
                }
              },
              "s2s": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Allowed S2S provider entry. Either a vendor id (e.g. `\"openai\"` — any OpenAI realtime model) or `\"<vendor>:<model>\"` (e.g. `\"openai:gpt-realtime-2.1\"` — only that model). Both forms can be mixed in the same array.",
                  "examples": [
                    "openai",
                    "openai:gpt-realtime-2.1",
                    "google:gemini-3.1-flash-live-preview",
                    "xai:grok-voice-latest"
                  ]
                }
              }
            }
          }
        }
      },
      "JsonObject": {
        "type": "object",
        "additionalProperties": true
      },
      "E164": {
        "type": "string",
        "pattern": "^\\+[1-9]\\d{6,14}$",
        "examples": [
          "+12015551234"
        ]
      },
      "TelephonyOptions": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "description": "Optional SIP routing region hint forwarded as `X-Speko-Region`."
          },
          "amd": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "agent",
                  "carrier",
                  "disabled"
                ],
                "default": "agent"
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              }
            }
          }
        }
      },
      "VoiceDialRequest": {
        "type": "object",
        "required": [
          "to"
        ],
        "properties": {
          "to": {
            "$ref": "#/components/schemas/E164"
          },
          "from": {
            "$ref": "#/components/schemas/E164"
          },
          "agentId": {
            "type": "string",
            "description": "Persisted agent to run. Required unless `intent` is supplied."
          },
          "useDraft": {
            "type": "boolean",
            "description": "Dial with the agent's unpublished draft instead of its deployed version, to hear a change before you ship it. Only applies with `agentId`."
          },
          "runMode": {
            "type": "string",
            "enum": [
              "cascade",
              "s2s"
            ],
            "description": "Run mode for this call. `s2s` hosts the call on the default speech-to-speech model (GPT-Live) instead of the STT → LLM → TTS cascade; `cascade` forces the cascade. Overrides the agent's saved run mode, and is the only way a call without an agent can run speech-to-speech. If the speech-to-speech route cannot be hosted, the call runs the cascade and records an `s2s.fallback` event; it never fails with a 4xx."
          },
          "intent": {
            "$ref": "#/components/schemas/RoutingIntent"
          },
          "constraints": {
            "$ref": "#/components/schemas/PipelineConstraints"
          },
          "voice": {
            "type": "string"
          },
          "systemPrompt": {
            "type": "string",
            "description": "Replaces the agent's system prompt for this call. Compiled as a template when `variables` is sent."
          },
          "firstMessage": {
            "type": "string",
            "description": "Replaces the agent's opening line for this call. Compiled as a template when `variables` is sent."
          },
          "variables": {
            "$ref": "#/components/schemas/TemplateVariables",
            "description": "Per-call values for `{{name}}` placeholders in the prompt and greeting. Strings, up to 10,000 characters each. Sending this key makes an unresolved variable a 400 `MISSING_TEMPLATE_VARIABLES`."
          },
          "toolSecrets": {
            "$ref": "#/components/schemas/ToolSecrets",
            "description": "Per-call values only tools can read, such as an access token. Never reach the prompt or transcript. Each value at least 6 characters."
          },
          "timezone": {
            "$ref": "#/components/schemas/CallTimeZone",
            "description": "IANA time zone for this call. Sets the agent's clock and `{{system.now}}`; overrides the agent's saved `timezone`."
          },
          "llm": {
            "$ref": "#/components/schemas/JsonObject"
          },
          "ttsOptions": {
            "$ref": "#/components/schemas/JsonObject"
          },
          "sttOptions": {
            "$ref": "#/components/schemas/JsonObject"
          },
          "telephony": {
            "$ref": "#/components/schemas/TelephonyOptions"
          },
          "turnHandling": {
            "$ref": "#/components/schemas/PhoneTurnHandling"
          },
          "webhookTags": {
            "type": "object",
            "maxProperties": 20,
            "additionalProperties": {
              "type": "string",
              "maxLength": 256
            },
            "description": "Case-sensitive routing tags for workspace webhook endpoints. Requires agentId."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Your own key/value pairs, stored on the session and echoed back in session reads, call reports, and webhook payloads. Opaque to Speko: it never reaches the agent's prompt and overrides nothing. Use `variables` for values the agent should say or use, and `toolSecrets` for values only tools should see."
          },
          "maxDurationSeconds": {
            "type": "integer",
            "default": 3600,
            "description": "Hard cap on the call's duration in seconds, measured from session creation, so dialing and ringing count. The call is ended when the cap passes. Values outside 30–14,400 are clamped to that range, and a call hosted on a speech-to-speech model is held to 3,600."
          }
        }
      },
      "TemplateVariables": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "maxLength": 10000
        },
        "description": "Call-time values for `{{name}}` placeholders in `systemPrompt`, `firstMessage`, and `turnHandling.voicemailMessage` (yours or the agent's). Values are strings of up to 10,000 characters. Sending this key, even as `{}`, compiles those strings as Liquid templates when the session is created: `{{name}}` interpolation, `{% if %}` branching, `| default:` filters, and the reserved `system.*` values (`system.now`, `system.call_id`, `system.caller_number`). Each variable resolves from this map, then the agent's variable-registry default, then an inline `| default:`. If any stay unresolved, the request fails with 400 `MISSING_TEMPLATE_VARIABLES` and lists the names. Keys under `system.` fail with 400 `RESERVED_VARIABLE_NAMESPACE`. Omit the key to send the strings as written; an agent with registry entries still renders, but an unbound variable renders blank instead of failing. Values reach the model, so never put tokens here — use `toolSecrets`.",
        "example": {
          "customer_name": "Priya",
          "appointment_time": "Thursday at 1 PM"
        }
      },
      "ToolSecrets": {
        "type": "object",
        "maxProperties": 32,
        "propertyNames": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 64
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 6,
          "description": "At most 4,096 UTF-8 bytes."
        },
        "description": "Per-call values for tools only, such as a short-lived access token scoped to the person being called. They never enter the prompt, the model's context, the transcript, or the worker's dispatch metadata, and no read endpoint returns them. They are stored encrypted and released only to tool execution: custom-code tools read `session.secrets.<name>`, and webhook tools can reference `{{name}}` in their `url` and `headers`. Names are identifiers (`[A-Za-z_][A-Za-z0-9_]*`, up to 64 characters). Up to 32 entries; each value is at least 6 characters and at most 4,096 bytes, and all values together at most 16,384 bytes. Values shorter than 6 characters are rejected because they cannot be redacted from tool output; put short non-secret values in `variables`.",
        "example": {
          "access_token": "eyJhbGciOiJIUzI1NiJ9.example"
        }
      },
      "CallTimeZone": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "description": "IANA time zone for this call, for example `America/Chicago`. Sets the current date and time the agent schedules from and the value of `{{system.now}}`, so \"Thursday at 1 PM\" resolves to the right date. Overrides the agent's saved `timezone` for this call only. Omit to use the agent's. An unknown zone fails validation.",
        "example": "America/Chicago"
      },
      "VoiceDialResponse": {
        "type": "object",
        "required": [
          "sessionId",
          "callControlId",
          "roomName",
          "status",
          "to",
          "from"
        ],
        "properties": {
