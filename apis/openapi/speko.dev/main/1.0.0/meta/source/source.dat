            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentAnalysisRow"
            }
          },
          "page": {
            "type": "integer"
          },
          "has_more": {
            "type": "boolean"
          },
          "extraction_conflicts": {
            "type": "array",
            "description": "Fields declared more than once with different definitions. The first declaration wins (the agent's own beats a webhook's); the loser is reported here rather than failing the call report.",
            "items": {
              "$ref": "#/components/schemas/AgentExtractionConflict"
            }
          }
        }
      },
