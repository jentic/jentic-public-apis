    "/v1/calls/{id}/end": {
      "post": {
        "summary": "End a live session now",
        "description": "Kill switch for any live session — browser/WebRTC sessions included (`calls` routes accept any session id). Deletes the room, which drops every participant; the normal close and metering flow runs via the room webhooks. Idempotent: ending an already-ended session returns `status: \"already_ended\"`. Use this from your backend to stop billing for a session your client can no longer reach.",
        "operationId": "endCall",
        "tags": [
          "Telephony"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Session already ended",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "status"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "already_ended"
                      ]
                    },
                    "ended_at": {
                      "type": "string",
                      "format": "date-time",
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "202": {
            "description": "Teardown requested",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "status"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "ending"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Session has no room to tear down"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No session with this id in your organization"
          }
        }
      }
    },
    "/v1/calls/{id}/messages": {
      "post": {
        "summary": "Send a message into a live call",
        "description": "Push an update from your backend into a live call, for results that finish after the tool call that started them returned. The voice model only acts after the caller speaks, so it cannot pick a late result up by itself. In `respond` mode (default) the text is added to the agent's context and, at the next gap in the conversation, the agent tells the caller in its own words; the caller can interrupt and ask follow-ups as usual. In `context` mode the text is only added to the agent's context and nothing is spoken. Delivery is asynchronous: `202` means the message was published to the call, and the outcome appears on the call's events as `worker.agent_message_delivered`. Not available for provider-direct S2S sessions.",
        "operationId": "sendCallMessage",
        "tags": [
          "Telephony"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000,
                    "description": "The update for the caller."
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "respond",
                      "context"
                    ],
                    "default": "respond",
                    "description": "`respond` has the agent tell the caller at the next gap in the conversation; `context` only adds the text to the agent's context."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Message published to the live call",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "status",
                    "message_id",
                    "mode"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "sent"
                      ]
                    },
                    "message_id": {
                      "type": "string"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "respond",
                        "context"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid body (`VALIDATION_ERROR`)"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No session with this id in your organization"
          },
          "409": {
            "description": "The call is not live (`CALL_NOT_LIVE`), or it is a provider-direct S2S session (`MESSAGES_UNSUPPORTED`)"
          }
        }
      }
    },
