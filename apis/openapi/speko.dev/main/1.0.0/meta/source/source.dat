        "type": "object",
        "required": [
          "fields",
          "rows",
          "page",
          "has_more",
          "extraction_conflicts"
        ],
        "properties": {
          "fields": {
            "type": "array",
            "description": "The agent's declared extraction schema — the table's columns, in order.",
            "items": {
              "$ref": "#/components/schemas/AgentExtractionField"
            }
          },
