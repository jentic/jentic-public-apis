                ]
              }
            ],
            "description": "End-of-turn detection. Unset uses the semantic turn model; `false` falls back to plain voice-activity detection; `\"stt\"` commits on final transcripts without waiting for acoustic end-of-speech (experimental)."
          },
          "contextThreshold": {
            "type": "boolean",
            "description": "Context-conditioned turn-taking: the commit threshold adapts to the shape of what the agent just asked. Unset uses the platform default."
          },
          "heardBy": {
            "type": "string",
            "enum": [
              "content",
              "timing"
            ],
            "description": "Graph agents: how a caller turn is judged to have heard the scripted step's question. `content` checks that the question had fully played (LiveKit played text) before the caller's first transcribed word, and re-asks only the question otherwise; `timing` (default) uses the original audio-timing rules."
          },
          "dtmfToolDescription": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Replaces the built-in description the model sees on the `send_dtmf` keypad tool — for steering when and what the agent presses on a specific menu. Only meaningful with the `ivr` profile, which is what creates the tool."
          },
          "amdPrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Replaces the built-in prompt the answering-machine classifier sees when deciding whether a person, a phone menu, or voicemail answered. Write it as classification instructions with examples; the callee's greeting transcript is appended as the input. The category vocabulary is always supplied for you, so a prompt that never names the categories still works. Outbound calls only — inbound never runs the detector, and this is accepted and inert there. It steers only the judgement on what was said: a pickup with no speech at all is decided on timing before the prompt is read. On a Realtime (`runMode: s2s`) call it steers the GPT-Live detector, which reads the voice model's own transcript of the greeting; Gemini Live runs no detector."
          },
          "onMachine": {
            "type": "string",
            "enum": [
              "hangup",
              "leave_message",
              "agent_decides"
            ],
            "default": "agent_decides",
            "description": "Per-call override of the agent's `onMachine`. What happens when answering-machine detection says a VOICEMAIL (or an \"unavailable\" recording) answered an outbound call. `hangup` ends the call the moment the verdict lands. `leave_message` waits for the greeting to finish, speaks `voicemailMessage` once in the agent's voice, then hangs up. `agent_decides` (default) hands the verdict to the model as a system note and lets the prompt's own voicemail rules act. Never applies to phone menus or call-screening services, which lead to a person. Calls ended this way close with `endReason: voicemail_reached` and report outcome `voicemail`. On a Realtime (`runMode: s2s`) call this applies only to GPT-Live, and only once worker detection is enabled for the workspace — until then it just records verdicts — with `leave_message` spoken in the voice model's own words (Gemini Live runs no worker detection)."
          },
          "voicemailMessage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Spoken once into the mailbox under `onMachine: leave_message`, after the greeting ends. Plain text, rendered by the agent's TTS voice. On a Realtime (GPT-Live) call there is no TTS: the voice model says it in its own words, after it is shortened to fit the model's instruction limit — about 1,200 characters of English, fewer in Chinese, Japanese, Korean or Thai — at a sentence boundary where one exists."
          }
        }
      },
      "PhoneTurnHandling": {
        "type": "object",
        "description": "Per-call turn-taking posture for an outbound phone call — e.g. dialling a number known to answer with a menu. Replaces the agent's stored `turnHandling` wholesale for this call.",
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "conversational",
              "ivr"
            ],
            "default": "conversational",
            "description": "Turn-taking posture preset. `ivr` is for calls INTO phone menus: it unlocks the `send_dtmf` keypad tool plus the menu-loop and dead-air watch — armed by the answering-machine verdict on outbound calls, and from call start elsewhere. Turn-taking itself stays conversational under both presets. The legacy value `ivr_patient` is still accepted and normalized to `ivr`."
          },
          "endpointing": {
            "type": "object",
            "description": "How long a caller has to stay silent before their turn is committed.",
            "properties": {
              "minDelay": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000,
                "description": "Milliseconds."
              },
              "maxDelay": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000,
                "description": "Milliseconds."
              }
            }
          },
          "interruption": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "adaptive",
                  "vad"
                ],
                "description": "`vad` barges in on any overlapping speech, honoring `minDuration`/`minWords`. `adaptive` classifies a real interruption from a backchannel (\"mhm\", \"right\") first and ignores both thresholds. Unset uses the platform default."
              },
              "minDuration": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000,
                "description": "Milliseconds of caller speech required to interrupt. `vad` mode only."
              },
              "minWords": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10,
                "description": "Words required to interrupt. `vad` mode only."
              }
            }
          },
          "turnDetection": {
            "type": "boolean",
            "description": "End-of-turn detection. Unset uses the semantic turn model; `false` falls back to plain voice-activity detection."
          },
          "contextThreshold": {
            "type": "boolean",
            "description": "Context-conditioned turn-taking: the commit threshold adapts to the shape of what the agent just asked. Unset uses the platform default."
          },
          "heardBy": {
            "type": "string",
            "enum": [
              "content",
              "timing"
            ],
            "description": "Graph agents: how a caller turn is judged to have heard the scripted step's question. `content` checks that the question had fully played (LiveKit played text) before the caller's first transcribed word, and re-asks only the question otherwise; `timing` (default) uses the original audio-timing rules."
          },
          "amdPrompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Replaces the built-in prompt the answering-machine classifier sees when deciding whether a person, a phone menu, or voicemail answered. Write it as classification instructions with examples; the callee's greeting transcript is appended as the input. The category vocabulary is always supplied for you, so a prompt that never names the categories still works. Outbound calls only — inbound never runs the detector, and this is accepted and inert there. It steers only the judgement on what was said: a pickup with no speech at all is decided on timing before the prompt is read. On a Realtime (`runMode: s2s`) call it steers the GPT-Live detector, which reads the voice model's own transcript of the greeting; Gemini Live runs no detector."
          },
          "greetFirst": {
            "type": "boolean",
            "default": true,
            "description": "Play the opening line immediately on answer while answering-machine detection classifies in the background. `false` holds the OPENING LINE ONLY — never later replies — until the verdict lands, bounded at roughly 8 seconds, so the agent never greets a machine. Not honoured on a Realtime (`runMode: s2s`) call, where the opening is never held."
          },
          "waitForCallee": {
            "type": "boolean",
            "default": true,
            "description": "Outbound opening etiquette: after pickup, hold the opening line briefly so the callee's own hello (\"Good morning, Riverside Dental…\") finishes first. `false` greets the instant they answer."
          },
          "onMachine": {
            "type": "string",
            "enum": [
              "hangup",
              "leave_message",
              "agent_decides"
            ],
            "default": "agent_decides",
            "description": "Per-call override of the agent's `onMachine`. What happens when answering-machine detection says a VOICEMAIL (or an \"unavailable\" recording) answered an outbound call. `hangup` ends the call the moment the verdict lands. `leave_message` waits for the greeting to finish, speaks `voicemailMessage` once in the agent's voice, then hangs up. `agent_decides` (default) hands the verdict to the model as a system note and lets the prompt's own voicemail rules act. Never applies to phone menus or call-screening services, which lead to a person. Calls ended this way close with `endReason: voicemail_reached` and report outcome `voicemail`. On a Realtime (`runMode: s2s`) call this applies only to GPT-Live, and only once worker detection is enabled for the workspace — until then it just records verdicts — with `leave_message` spoken in the voice model's own words (Gemini Live runs no worker detection)."
          },
          "voicemailMessage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Spoken once into the mailbox under `onMachine: leave_message`, after the greeting ends. Plain text, rendered by the agent's TTS voice. On a Realtime (GPT-Live) call there is no TTS: the voice model says it in its own words, after it is shortened to fit the model's instruction limit — about 1,200 characters of English, fewer in Chinese, Japanese, Korean or Thai — at a sentence boundary where one exists."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable message."
          },
          "code": {
            "type": "string",
            "description": "Machine-readable code."
          }
        }
      },
      "AgentStackPreferences": {
        "type": "object",
        "description": "Per-agent stack preferences. Empty / missing layers leave the router unconstrained for that layer; failover stays active within the allowed set.",
        "additionalProperties": false,
        "properties": {
          "allowedProviders": {
            "type": "object",
            "description": "Per-pipeline-layer provider allowlists (e.g. STT must be Deepgram or AssemblyAI). Each entry is either `\"<vendor>\"` (vendor wildcard — allow any model from that vendor) or `\"<vendor>:<model>\"` (allow only that specific model). Failover stays active across all entries in the layer.",
            "additionalProperties": false,
            "properties": {
              "stt": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Allowed STT provider entry. Either a vendor id (e.g. `\"deepgram\"` — any Deepgram model) or `\"<vendor>:<model>\"` (e.g. `\"deepgram:nova-3\"` — only Nova-3, no fallback to other Deepgram models within the vendor). Both forms can be mixed in the same array.",
                  "examples": [
                    "deepgram",
                    "deepgram:nova-3",
                    "assemblyai"
                  ]
                },
                "description": "Allowed STT provider entries. Empty / absent = no constraint."
              },
              "llm": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Allowed LLM provider entry. Either a vendor id (e.g. `\"openai\"` — any OpenAI model) or `\"<vendor>:<model>\"` (e.g. `\"openai:gpt-5\"` — only that model). Both forms can be mixed in the same array.",
                  "examples": [
                    "openai",
                    "openai:gpt-5",
                    "anthropic"
                  ]
                },
                "description": "Allowed LLM provider entries. Empty / absent = no constraint."
              },
              "tts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Allowed TTS provider entry. Either a vendor id (e.g. `\"elevenlabs\"` — any ElevenLabs model) or `\"<vendor>:<model>\"` (e.g. `\"elevenlabs:eleven_flash_v2_5\"` — only that model). Both forms can be mixed in the same array.",
                  "examples": [
                    "elevenlabs",
                    "elevenlabs:eleven_flash_v2_5",
                    "cartesia"
                  ]
                },
                "description": "Allowed TTS provider entries. Empty / absent = no constraint."
              },
              "s2s": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Allowed provider-direct S2S entry. Use a provider id or an exact provider:model pair.",
                  "examples": [
                    "openai:gpt-realtime-2.1",
                    "google:gemini-3.1-flash-live-preview",
                    "xai:grok-voice-latest"
                  ]
                },
                "description": "Allowed S2S provider entries. Empty / absent = no constraint."
              }
            }
          }
        }
      },
      "ProviderModelEntry": {
        "type": "object",
        "description": "A single allowlist-eligible entry returned by `/v1/providers/known`. The `id` is the verbatim string callers put into `allowedProviders` — either a vendor wildcard (`\"deepgram\"`) or a specific (vendor, model) pair (`\"deepgram:nova-3\"`).",
        "required": [
          "id",
          "vendor",
          "vendorName",
          "model",
          "benchmarked"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Verbatim string for `allowedProviders` entries. `\"<vendor>\"` for vendor-wildcard rows, `\"<vendor>:<model>\"` for model-specific rows.",
            "examples": [
              "deepgram",
              "deepgram:nova-3"
            ]
          },
          "vendor": {
            "type": "string",
            "description": "Lowercase vendor id.",
            "examples": [
              "deepgram"
            ]
          },
          "vendorName": {
            "type": "string",
            "description": "Human-readable vendor name.",
            "examples": [
              "Deepgram"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "Model id within the vendor, or `null` for the vendor-wildcard row.",
            "examples": [
              "nova-3"
            ]
          },
          "benchmarked": {
            "type": "boolean",
            "description": "Whether the router has benchmark data for this entry. `false` entries are visible but cannot win selection — including them in `allowedProviders` without a benchmarked fallback will fail to route."
          }
        }
      },
      "KnownProviders": {
        "type": "object",
        "description": "Per-modality lists of allowlist-eligible entries. Each layer's array contains one vendor-wildcard row per known vendor plus one row per known (vendor, model) pair. Use the `id` field as the verbatim string for `allowedProviders`.",
        "required": [
          "stt",
          "llm",
          "tts",
          "s2s"
        ],
        "properties": {
          "stt": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModelEntry"
            }
          },
          "llm": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModelEntry"
            }
          },
          "tts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModelEntry"
            }
          },
          "s2s": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModelEntry"
            }
          }
        }
      },
      "SessionEntries": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionEntry"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Cursor to pass to the next call. Null/absent when there are no more pages."
          }
        }
      },
      "SessionEntry": {
        "type": "object",
        "required": [
          "sessionId",
          "createdAt"
        ],
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "description": "Lifecycle status of the session."
          },
          "kind": {
            "type": "string",
            "description": "Session kind."
          },
          "pipelineConfig": {
            "type": "object",
            "description": "Snapshot of the pipeline config the session was minted with.",
            "properties": {
              "agentId": {
                "type": "string",
                "nullable": true,
                "description": "The agent the session was started against, if any. Filtered on by the `?agent=` query param."
              }
            }
          },
          "billing": {
            "type": "object",
            "nullable": true,
            "description": "Billing projection for provider-direct S2S. The create-time amount is estimated until Runtime exports canonical settlement evidence.",
            "properties": {
              "mode": {
                "type": "string",
                "examples": [
                  "direct_entitlement"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "estimated",
                  "final"
                ]
              },
              "estimatedCostMicroUsd": {
                "type": "string",
                "nullable": true
              },
              "finalCostMicroUsd": {
                "type": "string",
                "nullable": true
              },
              "evidence": {
                "type": "string",
                "nullable": true
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "nullable": true
              }
            }
          },
          "recordingObjectPath": {
            "type": "string",
            "nullable": true,
            "description": "GCS object path of the recorded audio file, when a recording exists. Null while the recording is still being produced, when recording is suppressed for the organization, or when the upload failed. Use `GET /v1/sessions/{id}/recording` to fetch a short-lived signed URL — never construct one yourself."
          },
          "recordingDurationMs": {
            "type": "integer",
            "nullable": true,
            "description": "Duration of the finalized recording in milliseconds. Null until `recordingStatus` is `ready`."
          },
          "recordingStatus": {
            "type": "string",
            "nullable": true,
            "enum": [
              "pending",
              "uploading",
              "ready",
              "failed",
              "suppressed",
              "discarded"
            ],
            "description": "Lifecycle of this session's recording. `pending` after the call ends and before the agent worker has finished assembling the file. `uploading` while the file is being pushed to GCS. `ready` once it is fully persisted and downloadable via the signed-URL endpoint. `failed` if the upload errored — the recording is unrecoverable. `suppressed` for organizations whose `recordingEnabled` flag is false; no file was ever produced. `discarded` when the call never connected (`endReason: sip_dial_rejected` or `sip_no_answer`, or `caller_abandoned` when the inbound leg was still ringing) — the capture held only an empty room and is withheld. Null for provider-direct S2S and legacy sessions that predate recording."
          },
          "endReason": {
            "type": "string",
            "nullable": true,
            "description": "Why the session closed. Null while live and after a normal close with no recorded cause (most often the caller hanging up). Normal ends (`status: ended`): `agent_ended`, `voicemail_reached`, `machine_unavailable`, `normal_timeout`, `dead_air`, `max_duration`, `ended_by_api`, `sip_no_answer`, `caller_abandoned`, `stale_timeout`. Failures (`status: failed`): `sip_dial_rejected`, `originate_failed`, `no_agent_assigned`, `config_rejected`, `silent_bot_no_agent_audio`, `stt_stream_lost`, `llm_empty_completion`, `tts_empty_audio`, `provider_failed`, `credits_exhausted`, `worker_crash`, `worker_joined_late`, `worker_response_timeout`, `key_vend_failed`, `machine_action_failed`, `unknown`. An open set: treat unrecognized values as other. Also returned by `GET /v1/sessions/{id}`."
          }
        }
      },
      "TurnIngest": {
        "type": "object",
        "required": [
          "index",
          "source",
          "text",
          "startedAt"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "description": "Monotonically increasing position of this turn within the session, starting at 0. The `(session_id, index)` pair is the idempotency key — re-posting a turn with the same index replaces the prior entry."
          },
          "source": {
            "type": "string",
            "enum": [
              "user",
              "agent",
              "system"
            ],
            "description": "Who produced this turn. `user` = finalized STT from the caller. `agent` = finalized LLM output spoken by the agent. `system` = synthetic entries (e.g. session boundary markers)."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "description": "Finalized transcript text. Interim STT partials are not accepted."
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Wall-clock time at which the turn began, ISO 8601."
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Wall-clock time at which the turn ended, ISO 8601. Null while the turn is still considered open (e.g. a streaming agent reply that hasn't fully closed)."
          },
          "provider": {
            "type": "string",
            "nullable": true,
            "description": "Provider that produced this turn (e.g. `deepgram`, `openai`). Null for `system` turns."
          },
          "model": {
            "type": "string",
            "nullable": true,
            "description": "Specific model id within the provider (e.g. `nova-3`, `gpt-4o-mini`). Null for `system` turns."
          }
        }
      },
      "TurnEntry": {
        "type": "object",
        "required": [
          "id",
          "index",
          "source",
          "text",
          "startedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Server-assigned id for this turn entry. Stable across reads."
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "description": "Monotonically increasing position of this turn within the session, starting at 0."
          },
          "source": {
            "type": "string",
            "enum": [
              "user",
              "agent",
              "system"
            ],
            "description": "Who produced this turn."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "description": "Finalized transcript text."
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Wall-clock time at which the turn began, ISO 8601."
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Wall-clock time at which the turn ended, ISO 8601. Null if the turn is still open."
          },
          "provider": {
            "type": "string",
            "nullable": true,
            "description": "Provider that produced this turn. Null for `system` turns."
          },
          "model": {
            "type": "string",
            "nullable": true,
            "description": "Specific model id within the provider. Null for `system` turns."
          }
        }
      },
      "PostSessionTurnsRequest": {
        "type": "object",
        "required": [
          "turns"
        ],
        "properties": {
          "turns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "description": "Batch of finalized turns to ingest. Workers should debounce (~200ms) and batch — single-turn POSTs are accepted but inefficient at scale.",
            "items": {
              "$ref": "#/components/schemas/TurnIngest"
            }
          }
        }
      },
      "SessionTranscript": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "description": "Finalized turns for this session, ordered by `index` ascending.",
            "items": {
              "$ref": "#/components/schemas/TurnEntry"
            }
          }
        }
      },
      "HumanCallLeg": {
        "type": "object",
        "description": "One participant's connection to a human call.",
        "properties": {
          "id": {
            "type": "string"
          },
          "controlId": {
            "type": "string",
            "description": "The command handle. Address every leg action to this."
          },
          "callId": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "browser",
              "pstn",
              "agent"
            ],
            "description": "`browser` is a person on a softphone, `pstn` a phone number, `agent` an AI session bridged in."
          },
          "direction": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound",
              "internal"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "initiating",
              "ringing",
              "active",
              "held",
              "ended",
              "failed"
            ]
          },
          "brokerId": {
            "type": "string",
            "nullable": true,
            "description": "Owning org-defined broker, when `kind` is `browser`."
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true,
            "description": "E.164 of the far end, when `kind` is `pstn`."
          },
          "muted": {
            "type": "boolean"
          },
          "onHold": {
            "type": "boolean"
          },
          "answeredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endReason": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HumanCall": {
        "type": "object",
        "description": "A call between people. Distinct from an AI voice session — see `/v1/calls` for those.",
        "properties": {
          "id": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound",
              "internal"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "initiating",
              "ringing",
              "active",
              "ended",
              "declined",
              "missed",
              "cancelled",
              "failed"
            ]
          },
          "answeredAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endReason": {
            "type": "string",
            "nullable": true
          },
          "legs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HumanCallLeg"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HumanCallJoinCredentials": {
        "type": "object",
        "description": "What a browser needs to join a room. Short-lived; minted per join, never cached.",
        "properties": {
          "token": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Media transport URL to connect `livekit-client` to."
          },
          "identity": {
            "type": "string"
          },
          "roomName": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HumanCallEvent": {
        "type": "object",
        "description": "One entry in a call's ordered event history. The same events (except `call.dtmf.received`) can be delivered as one-shot workspace webhooks.",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "call.initiated",
              "call.ringing",
              "call.answered",
              "call.bridged",
              "call.hold",
              "call.unhold",
              "call.mute",
              "call.unmute",
              "call.dtmf.received",
              "call.dtmf.sent",
              "call.transfer.initiated",
              "call.transfer.completed",
              "call.transfer.failed",
              "call.leg.hangup",
              "call.hangup"
            ]
          },
          "callId": {
            "type": "string"
          },
          "controlId": {
            "type": "string",
            "nullable": true,
            "description": "Null for call-scoped events (`call.initiated`, `call.hangup`)."
          },
          "payload": {
            "type": "object",
            "additionalProperties": true
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "HumanCallDialRequest": {
        "type": "object",
        "required": [
          "brokerId",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "brokerId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "to": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{1,14}$",
            "description": "Destination, E.164."
          },
          "from": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{1,14}$",
            "description": "Caller ID. Must be a number this organization owns; defaults to the org's first outbound-capable number."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "HumanCallCommandRequest": {
        "type": "object",
        "description": "Body shape depends on the command. `answer`, `hold`, `unhold`, `mute`, `unmute` take an empty object. `hangup` accepts `reason`; `dtmf` requires `digits`; `bridge` requires `bridgeTo`; `transfer` requires `to` and `mode`. Unknown keys are rejected.",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 120,
            "description": "`hangup` only. Recorded as the leg's `endReason`."
          },
          "digits": {
            "type": "string",
            "pattern": "^[0-9*#w,]{1,64}$",
            "description": "`dtmf` only. `0-9`, `*`, `#`, `,`, and `w` for a pause; max 64."
          },
          "bridgeTo": {
            "type": "string",
            "description": "`bridge` only. `controlId` of the leg to bridge this one to."
          },
          "to": {
            "type": "string",
            "description": "`transfer` only. An E.164 number, or the `controlId` of another broker's leg."
          },
          "mode": {
            "type": "string",
            "enum": [
              "blind",
              "warm"
            ],
            "description": "`transfer` only. `blind` hands off and drops the leg; `warm` opens a consultation room you complete with `bridge`."
          }
        }
      },
      "HumanCallCommandResult": {
        "type": "object",
        "description": "Every command resolves to the leg's post-command state, so a client never re-reads to learn what it just did.",
        "properties": {
          "leg": {
            "$ref": "#/components/schemas/HumanCallLeg"
          },
          "noop": {
            "type": "boolean",
            "description": "Present when the command changed nothing, e.g. muting a muted leg."
          }
        }
      },
      "BrokerPresence": {
        "type": "object",
        "description": "One broker's availability for inbound routing.",
        "properties": {
          "brokerId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "busy",
              "away",
              "offline"
            ]
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "reachable": {
            "type": "boolean",
            "description": "False once the heartbeat is stale (90 s), regardless of `status`. Routing only rings reachable brokers."
          }
        }
      },
      "SmsSuppression": {
        "type": "object",
        "description": "A recipient the workspace must not message, and why.",
        "required": [
          "id",
          "recipient",
          "status",
          "suppressed_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "recipient": {
            "type": "string",
            "description": "E.164 number that opted out."
          },
          "status": {
            "type": "string",
            "description": "`suppressed` while the opt-out stands."
          },
          "keyword": {
            "type": [
              "string",
              "null"
            ],
            "description": "The keyword that triggered it, e.g. STOP."
          },
          "source_phone_number_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_message_provider_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "suppressed_at": {
            "type": "string",
            "format": "date-time"
          },
          "lifted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Set when the suppression was lifted."
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TtsCatalogMeta": {
        "type": "object",
        "properties": {
          "benchmark": {
            "type": "object",
            "properties": {
              "schema": {
                "type": "integer"
              },
              "routing_policy_version": {
                "type": "string"
              }
            }
          },
          "quality_overlay": {
            "type": "object",
            "properties": {
              "generated_at": {
                "type": "string"
              },
              "run_id": {
                "type": "string"
              }
            }
          },
          "org_routable_vendors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverage": {
            "type": "object",
            "properties": {
              "models_routable": {
                "type": "integer"
              },
              "models_measured": {
                "type": "integer"
              },
              "voices_routable": {
                "type": "integer"
              },
              "voices_measured": {
                "type": "integer"
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The caveats that stop a number being read as something it is not."
          }
        }
      },
      "TtsLatency": {
        "type": "object",
        "description": "TTS latency detail, published beside `latency_ms` and `latency_evidence` rather than in place of them. The blocks are different quantities, so do not compare them with each other or with `latency_ms`.",
        "properties": {
          "vendor_direct": {
            "type": "array",
            "description": "The reading in each region it covers. The row whose `location` equals `latency_evidence.region` is the same number as `latency_ms`; the others are the regional siblings the ranked field does not carry.",
            "items": {
              "type": "object",
              "properties": {
                "region": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "p50_ms": {
                  "type": "number"
                },
                "p90_ms": {
                  "type": "number",
                  "nullable": true
                }
              }
            }
          },
          "per_language": {
            "type": "array",
            "description": "Per-language time to first audio, p50 and p90. Measured differently from `latency_ms`, so these rows compare with each other and never against it. `n`, `sweeps` and `wide_tail` describe each row on its own terms.",
            "items": {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string"
                },
                "p50": {
                  "type": "number"
                },
                "p90": {
                  "type": "number"
                },
                "n": {
                  "type": "integer"
                },
                "sweeps": {
                  "type": "integer"
                },
                "wide_tail": {
                  "type": "boolean",
                  "description": "p90/p50 above 1.7, a tail this row’s sample size cannot resolve. Do not read movement between sweeps as change."
                },
                "voice": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "TtsMetricValue": {
        "type": "object",
        "required": [
          "value",
          "unit",
          "higher_is_better"
        ],
        "description": "One measured axis, with its unit and direction stated so a caller never has to infer them.",
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "description": "`elo_arena`, `score_0_1`, `mos_0_5`, `percent`."
          },
          "higher_is_better": {
            "type": "boolean"
          },
          "board": {
            "type": "string"
          },
          "ci": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "n": {
            "type": "integer"
          },
          "basis": {
            "type": "string",
            "description": "Robustness fixture basis. Do not read small gaps across different bases as real."
          },
          "unjudgeable": {
            "type": "integer"
          },
          "field_mean": {
            "type": "number",
            "description": "Naturalness only: 1500, the per-language field average."
          },
          "comparable_across_languages": {
            "type": "boolean",
            "description": "Naturalness only, and always false. Arena Elo is fit per language."
          },
          "estimated": {
            "type": "boolean",
            "description": "Present and true when the score came from Speko’s own scorer rather than human votes."
          }
        }
      },
      "TtsModel": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "model",
          "routable",
          "benchmark"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "cartesia:sonic-3.5"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "routable": {
            "type": "boolean"
          },
          "routable_via": {
            "type": "string",
            "nullable": true,
            "enum": [
              "platform_key",
              "byok",
              null
            ]
          },
          "benchmark": {
            "type": "object",
            "properties": {
              "language": {
                "type": "string"
              },
              "board": {
                "type": "string"
              },
              "naturalness": {
                "$ref": "#/components/schemas/TtsMetricValue"
              },
              "robustness": {
                "$ref": "#/components/schemas/TtsMetricValue"
              },
              "panel_mos": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/TtsMetricValue"
                  }
                ],
                "description": "A 0-5 direct-rating scale. `naturalness` uses a different scale."
              },
              "panel_named_pct": {
                "$ref": "#/components/schemas/TtsMetricValue"
              },
              "latency_ms": {
                "type": "number",
                "nullable": true,
                "description": "The ranked reading: first-audio p50. The only latency to sort on. Null where the model has no reading."
              },
              "latency_evidence": {
                "type": "object",
                "description": "The region and sample size behind `latency_ms`. Present whenever `latency_ms` is non-null.",
                "properties": {
                  "board": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "n": {
                    "type": "integer"
                  },
                  "p90_ms": {
                    "type": "number"
                  }
                }
              },
              "latency": {
                "$ref": "#/components/schemas/TtsLatency"
              },
              "cost": {
                "type": "object",
                "properties": {
                  "per_1m_chars_usd": {
                    "type": "number",
                    "nullable": true
                  },
                  "per_min_usd": {
                    "type": "number",
                    "nullable": true,
                    "description": "Derived, not measured: `per_1m_chars_usd x 900 / 1e6`."
                  },
                  "higher_is_better": {
                    "type": "boolean"
                  }
                },
                "description": "Always present. On a model with no board row every number is null, which is a different answer from the field being absent."
              }
            }
          },
          "languages": {
            "type": "object",
            "properties": {
              "measured": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Language tags this model is measured on."
              },
              "vendor_claimed": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The vendor lists the language but we have not probed it."
              },
              "count": {
                "type": "integer"
              }
            }
          },
          "voices": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "measured": {
                "type": "integer",
                "description": "How many of those voices carry a measurement."
              },
              "compatibility": {
                "type": "string",
                "enum": [
                  "verified",
                  "vendor_roster",
                  "restricted"
                ]
              }
            },
            "description": "How many voices can be used with this model, how many of those carry a measurement, and how the pairing was established. Pass `?model=` to `/v1/tts/voices` to list them."
          }
        }
      },
      "TtsVoice": {
        "type": "object",
        "required": [
          "id",
          "vendor",
          "voice_id",
          "name",
          "use_with",
          "model_id",
          "quality"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "cartesia:f9836c6e-a0bd-460e-9d3c-f7299fa60f94"
          },
          "vendor": {
            "type": "string"
          },
          "voice_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "gender": {
            "type": "string",
            "nullable": true
          },
          "accent": {
            "type": "string",
            "nullable": true
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "styles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Descriptive words only. Measured quality is in `quality.labels`."
          },
          "use_with": {
            "type": "object",
            "description": "The exact triple to send to `POST /v1/synthesize` or `POST /v1/sessions`. Pass it through unmodified.",
            "required": [
              "provider",
              "model",
              "voice"
            ],
            "properties": {
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "voice": {
                "type": "string"
              }
            }
          },
          "model_id": {
            "type": "string"
          },
          "voice_compatibility": {
            "type": "string",
            "enum": [
              "verified",
              "vendor_roster",
              "restricted"
            ],
            "description": "`verified` = this voice/model pairing is individually confirmed. `vendor_roster` = same vendor, pairing inferred from vendor-level voice ownership. `restricted` = the model accepts only a documented subset of its vendor’s voices."
          },
          "quality": {
            "type": "object",
            "required": [
              "verdict",
              "labels"
            ],
            "properties": {
              "verdict": {
                "type": "string",
                "enum": [
                  "measured",
                  "measured_no_labels",
                  "unmeasured"
                ],
                "description": "`measured_no_labels` means we measured the voice and it cleared nothing. `unmeasured` means we never measured it. Only positive labels are emitted, so an empty `labels` array is a result in the first case and a gap in the second."
              },
              "basis": {
                "type": "string",
                "nullable": true,
                "description": "`longform-render` or `preview-clip`. Several axes are only computable from a long-form render."
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Human display strings, e.g. `[\"no hiss\",\"steady to the end\",\"10k chars\"]`, in canonical chip order. The cumulative capacity rungs collapse to the highest one held."
              },
              "summary": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "max_chars_per_call": {
                "type": "integer",
                "nullable": true
              },
              "words_per_minute": {
                "type": "number",
                "nullable": true
              }
            }
          },
          "why": {
            "type": "object",
            "nullable": true,
            "description": "Generated from deterministic templates over the measured numbers. No model writes this copy.",
            "properties": {
              "best_for": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "strengths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "weaknesses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tradeoffs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid bearer token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "default": {
                "value": {
                  "error": "Unauthorized",
                  "code": "UNAUTHORIZED"
                }
              }
            }
          }
        }
      },
      "ValidationError": {
        "description": "Request body or query parameters failed validation.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "default": {
                "value": {
                  "error": "Invalid request body",
                  "code": "VALIDATION_ERROR"
                }
              }
            }
          }
        }
      },
      "InvalidAudio": {
        "description": "Empty body, missing/invalid `x-speko-intent` header, or malformed `x-speko-constraints`.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "default": {
                "value": {
                  "error": "Audio body is empty.",
                  "code": "INVALID_AUDIO"
                }
              }
            }
          }
        }
      },
      "TranscribeFailed": {
        "description": "No STT provider available for the intent, or every candidate failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "default": {
                "value": {
                  "error": "All providers failed",
                  "code": "TRANSCRIBE_FAILED"
                }
              }
            }
          }
        }
      },
      "SynthesizeFailed": {
        "description": "No TTS provider available for the intent, no default voice for chosen provider, or every candidate failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "default": {
                "value": {
                  "error": "All providers failed",
                  "code": "SYNTHESIZE_FAILED"
                }
              }
            }
          }
        }
      },
      "CompleteFailed": {
        "description": "No LLM provider available for the intent, or every candidate failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "default": {
                "value": {
                  "error": "All providers failed",
                  "code": "COMPLETE_FAILED"
                }
              }
            }
          }
        }
      },
      "SessionCreateFailed": {
        "description": "Token mint failed, agent dispatch failed, or DB insert failed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "default": {
                "value": {
                  "error": "Failed to dispatch voice agent",
                  "code": "SESSION_CREATE_FAILED"
                }
              }
            }
          }
        }
      },
      "AgentNotFound": {
        "description": "No agent with this id exists in the authenticated organization.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "default": {
                "value": {
                  "error": "not found",
                  "code": "NOT_FOUND"
                }
              }
            }
          }
        }
      },
      "AgentDeleteConflict": {
        "description": "The organization's only remaining agent cannot be deleted.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "default": {
                "value": {
                  "error": "Cannot delete the only agent in this organization",
                  "code": "LAST_AGENT"
                }
              }
            }
          }
        }
      },
      "HumanCallingUnavailable": {
        "description": "Human calling is not enabled for this organization (it is in early access — ask us to enable it), or is not configured on this deployment.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "default": {
                "value": {
                  "error": "human calling is not enabled for this organization",
                  "code": "HUMAN_CALLING_DISABLED"
                }
              }
            }
          }
        }
      }
    }
  }
}