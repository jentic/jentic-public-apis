          },
          "isError": {
            "type": "boolean",
            "description": "Marks a tool message as an error result."
          }
        }
      },
      "CreateSessionRequest": {
        "description": "Set `mode` explicitly when possible. If omitted, the server uses the persisted agent's S2S run mode when applicable and otherwise defaults to cascade.",
        "anyOf": [
          {
            "$ref": "#/components/schemas/CreateCascadeSessionRequest"
          },
          {
            "$ref": "#/components/schemas/CreateS2SSessionRequest"
          }
        ]
      },
      "CreateCascadeSessionRequest": {
        "type": "object",
        "description": "Cascade session creation fields. Exactly one of `agentId` or `intent` must be supplied. When `agentId` is given, the persisted agent's `systemPrompt`, `voice`, `intent`, and `llmOptions` seed the session as defaults; any per-call field on this body still overrides the agent's stored value. The server defaults an omitted mode to cascade unless the persisted agent uses S2S run mode.",
        "properties": {
          "mode": {
            "type": "string",
            "const": "cascade",
            "description": "Creates the LiveKit-backed STT → LLM → TTS pipeline. Optional for backward compatibility."
          },
          "agentId": {
            "type": "string",
            "description": "Optional pointer to a persisted `agent` row whose fields seed this session. When supplied, the agent's `systemPrompt`, `voice`, `intent`, and `llmOptions` become defaults; any per-call field on this body overrides the agent's stored value. When absent, `intent` is required."
          },
          "intent": {
            "$ref": "#/components/schemas/RoutingIntent"
          },
          "constraints": {
            "$ref": "#/components/schemas/PipelineConstraints"
          },
          "voice": {
            "type": "string",
            "description": "Force a specific TTS voice id."
          },
          "systemPrompt": {
            "type": "string",
            "description": "Initial agent instructions."
          },
          "firstMessage": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000,
            "description": "First line the agent speaks on connect. Omit to use the agent's or the default greeting; pass `null` or `\"\"` to open in listening mode."
          },
          "variables": {
            "$ref": "#/components/schemas/TemplateVariables",
            "description": "Per-call values for `{{name}}` placeholders in the prompt and greeting. Strings, up to 10,000 characters each. Sending this key makes an unresolved variable a 400 `MISSING_TEMPLATE_VARIABLES`."
          },
          "toolSecrets": {
            "$ref": "#/components/schemas/ToolSecrets",
            "description": "Per-call values only tools can read, such as an access token. Never reach the prompt or transcript. Each value at least 6 characters."
          },
          "timezone": {
            "$ref": "#/components/schemas/CallTimeZone",
            "description": "IANA time zone for this call. Sets the agent's clock and `{{system.now}}`; overrides the agent's saved `timezone`."
          },
          "llm": {
            "type": "object",
            "properties": {
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "maxTokens": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "ttsOptions": {
            "type": "object",
            "properties": {
              "sampleRate": {
                "type": "integer",
                "minimum": 1
              },
              "speed": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2
              }
            }
          },
          "turnHandling": {
            "$ref": "#/components/schemas/SessionTurnHandling"
          },
          "webhookTags": {
            "type": "object",
            "maxProperties": 20,
            "additionalProperties": {
              "type": "string",
              "maxLength": 256
            },
            "description": "Case-sensitive routing tags for workspace webhook endpoints. Requires agentId."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Arbitrary key/value pairs stored on the session row."
          },
          "ttlSeconds": {
            "type": "integer",
            "default": 900,
            "minimum": 1,
            "maximum": 86400,
            "description": "Join-token TTL. Bounds how long the returned transport token stays valid to connect — not how long the session may run. Use `maxDurationSeconds` to cap connected duration."
          },
          "maxDurationSeconds": {
            "type": "integer",
            "default": 3600,
            "minimum": 30,
            "maximum": 14400,
            "description": "Hard cap on session lifetime in seconds, measured from session creation (not from client connect). The session is force-ended when the deadline passes, even if the client stays connected — a client that joins late gets the remainder. Billing accrues per second from session creation (on an outbound phone call that includes dialing and ringing; failed sessions and carrier-refused dials are not billed), so this is the spend guardrail for abandoned clients."
          },
          "identity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Transport participant identity. Defaults to `user_<uuid>`."
          }
        }
      },
      "CreateS2SSessionRequest": {
        "type": "object",
        "description": "Provider-direct speech-to-speech fields. Speko reserves a bounded entitlement and returns a scoped provider credential; media flows directly between the caller and the selected provider. Mode may be omitted when the persisted agent uses S2S run mode.",
        "properties": {
          "mode": {
            "type": "string",
            "const": "s2s",
            "description": "Creates a provider-direct S2S session. Optional when agentId resolves to an S2S agent."
          },
          "agentId": {
            "type": "string",
            "minLength": 1,
            "description": "Optional persisted agent whose prompt, voice, language intent, and registered tools seed the S2S session."
          },
          "intent": {
            "$ref": "#/components/schemas/RoutingIntent"
          },
          "constraints": {
            "$ref": "#/components/schemas/PipelineConstraints"
          },
          "s2s": {
            "type": "object",
            "description": "Provider-native S2S configuration. Omit both provider and model to let Speko route; if either is supplied, both are required.",
            "properties": {
              "provider": {
                "type": "string",
                "enum": [
                  "openai",
                  "google",
                  "xai"
                ],
                "description": "Managed provider-direct S2S provider."
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "description": "Exact provider model id."
              },
              "voice": {
                "type": "string",
                "description": "Provider-specific voice id."
              },
              "systemPrompt": {
                "type": "string",
                "description": "Initial provider session instructions."
              },
              "temperature": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "inputSampleRate": {
                "type": "integer",
                "enum": [
                  16000,
                  24000
                ],
                "description": "PCM16 input rate. Gemini Live requires 16 kHz; OpenAI and xAI require 24 kHz."
              },
              "outputSampleRate": {
                "type": "integer",
                "enum": [
                  16000,
                  24000
                ],
                "description": "PCM16 output rate. Current managed OpenAI, Gemini Live, and xAI routes require 24 kHz."
              },
              "tools": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/RealtimeToolSpec"
                }
              }
            }
          },
          "variables": {
            "$ref": "#/components/schemas/TemplateVariables",
            "description": "Per-call values for `{{name}}` placeholders in the prompt and greeting. Strings, up to 10,000 characters each. Sending this key makes an unresolved variable a 400 `MISSING_TEMPLATE_VARIABLES`."
          },
          "timezone": {
            "$ref": "#/components/schemas/CallTimeZone",
            "description": "IANA time zone for this call. Sets the agent's clock and `{{system.now}}`; overrides the agent's saved `timezone`."
          },
          "webhookTags": {
            "type": "object",
            "maxProperties": 20,
            "additionalProperties": {
              "type": "string",
              "maxLength": 256
            },
            "description": "Case-sensitive workspace webhook routing tags. Requires agentId."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Arbitrary key/value pairs stored on the session row."
          },
          "ttlSeconds": {
            "type": "integer",
            "default": 1800,
            "minimum": 1,
            "maximum": 3600,
            "description": "Requested maximum S2S session horizon. The returned entitlement or provider credential may authorize a shorter initial slice."
          }
        }
      },
      "RealtimeToolSpec": {
        "type": "object",
        "required": [
          "name",
          "description",
          "parameters"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true,
            "description": "JSON Schema parameters object."
          }
        }
      },
      "CreateSessionResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/CreateCascadeSessionResponse"
          },
          {
            "$ref": "#/components/schemas/CreateS2SSessionResponse"
          }
        ]
      },
      "CreateCascadeSessionResponse": {
        "type": "object",
        "required": [
          "mode",
          "sessionId",
          "transportToken",
          "transportUrl",
          "conversationToken",
          "livekitUrl",
          "roomName",
          "identity",
          "expiresAt"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "const": "cascade"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "transportToken": {
            "type": "string",
            "description": "Browser-safe media transport token."
          },
          "transportUrl": {
            "type": "string",
            "format": "uri",
            "description": "Media transport URL."
          },
          "conversationToken": {
            "type": "string",
            "deprecated": true,
            "description": "Compatibility alias for `transportToken`."
          },
          "livekitUrl": {
            "type": "string",
            "format": "uri",
            "deprecated": true,
            "description": "Compatibility alias for `transportUrl`."
          },
          "roomName": {
            "type": "string",
            "examples": [
              "speko_..."
            ]
          },
          "identity": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateS2SSessionResponse": {
        "type": "object",
        "description": "Provider-direct S2S bootstrap. Pass this response unchanged to `RealtimeVoiceConversation.create()`; do not log or persist the credential value.",
        "required": [
          "mode",
          "transport",
          "sessionId",
          "planId",
          "attemptId",
          "provider",
          "model",
          "adapter",
          "providerTransport",
          "endpoint",
          "credential",
          "telemetry",
          "reservation",
          "session",
          "inputSampleRate",
          "outputSampleRate",
          "expiresAt"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "const": "s2s"
          },
          "transport": {
            "type": "string",
            "const": "provider_direct"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "planId": {
            "type": "string"
          },
          "attemptId": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "openai",
              "google",
              "xai"
            ]
          },
          "model": {
            "type": "string"
          },
          "adapter": {
            "type": "string",
            "enum": [
              "openai.realtime.v1",
              "google.live.v1",
              "xai.realtime.v1"
            ]
          },
          "providerTransport": {
            "type": "string",
            "enum": [
              "webrtc",
              "websocket"
            ],
            "description": "OpenAI uses WebRTC; Gemini Live and xAI use WebSockets."
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "description": "Allowlisted provider endpoint."
          },
          "credential": {
            "type": "object",
            "required": [
              "kind",
              "value",
              "expiresAt"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "const": "bearer"
              },
              "value": {
                "type": "string",
                "description": "Scoped, short-lived provider credential. Never persist or log it."
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "telemetry": {
            "type": "object",
            "required": [
              "endpoint",
              "token",
              "flushIntervalMs"
            ],
            "properties": {
              "endpoint": {
                "type": "string",
                "format": "uri",
                "description": "Speko control endpoint. It never receives media."
              },
              "token": {
                "type": "string",
                "description": "Short-lived token scoped to this session's control events."
              },
              "flushIntervalMs": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "sidebandUrl": {
            "type": "string",
            "format": "uri",
            "description": "OpenAI-only Speko endpoint that binds the provider call to authenticated billing evidence without receiving media."
          },
          "reservation": {
            "type": "object",
            "required": [
              "id",
              "authorizedDurationSeconds",
              "leaseExpiresAt",
              "billing"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "authorizedDurationSeconds": {
                "type": "integer",
                "minimum": 1,
                "description": "Duration authorized by this entitlement slice."
              },
              "leaseExpiresAt": {
                "type": "string",
                "format": "date-time"
              },
              "billing": {
                "type": "object",
                "required": [
                  "mode",
                  "state",
                  "maximumAmountMicros",
                  "currency"
                ],
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "direct_entitlement"
                  },
                  "state": {
                    "type": "string",
                    "const": "estimated"
                  },
                  "maximumAmountMicros": {
                    "type": "string",
                    "pattern": "^[0-9]+$",
                    "description": "Maximum charge for this authorized slice, in millionths of the stated currency."
                  },
                  "currency": {
                    "type": "string",
                    "examples": [
                      "USD"
                    ]
                  },
                  "renewalUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "Present when the client may reserve another entitlement slice, currently for Gemini Live."
                  },
                  "renewableUntil": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          },
          "session": {
            "type": "object",
            "properties": {
              "voice": {
                "type": "string"
              },
              "instructions": {
                "type": "string"
              },
              "temperature": {
                "type": "number"
              },
              "tools": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/RealtimeToolSpec"
                }
              }
            }
          },
          "inputSampleRate": {
            "type": "integer",
            "enum": [
              16000,
              24000
            ]
          },
          "outputSampleRate": {
            "type": "integer",
            "enum": [
              24000
            ]
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expiry of the currently returned provider credential."
          }
        }
      },
      "TranscribeResponse": {
        "type": "object",
        "required": [
          "text",
          "provider",
          "model",
          "failoverCount"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "description": "Provider that actually ran (post-failover)."
          },
          "model": {
            "type": "string"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "failoverCount": {
            "type": "integer",
            "minimum": 0
          },
          "scoresRunId": {
            "type": [
              "string",
              "null"
            ]
          },
          "effectiveParams": {
            "type": "object",
            "description": "Present only when the request used `workload`, `providerOptions`, or a canonical STT field. Reports what actually applied on the winning provider.",
            "required": [
              "provider",
              "model",
              "applied",
              "defaultsVersion"
            ],
            "properties": {
              "provider": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "applied": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Param names applied to the winning provider (never values)."
              },
              "defaultsVersion": {
                "type": "string",
                "description": "Version of the param registry whose workload defaults applied."
              }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "Present only when non-empty and the request used the new fields. Entries carry a `kind`: `candidate_excluded` (demote-class param removed a failover candidate), `param_dropped` (drop-class param omitted for the winning provider), `out_of_range`, or `provider_not_pinned`."
          }
        }
      },
      "VoiceCatalogEntry": {
        "type": "object",
        "required": [
          "vendor",
          "id",
          "name"
        ],
        "properties": {
          "vendor": {
            "type": "string",
            "description": "Routing-key vendor (matches `allowedProviders.tts` entries)."
          },
          "id": {
            "type": "string",
            "description": "Voice id passed through to the provider's TTS API."
          },
          "name": {
            "type": "string",
            "description": "Human-readable label."
          }
        }
      },
      "VoicesProviderEntry": {
        "type": "object",
        "required": [
          "key",
          "name",
          "models",
          "voicesFetchedLive",
          "source"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "voicesFetchedLive": {
            "type": "boolean",
            "description": "`true` when the provider's voice library is account-scoped and must be fetched live from the provider (currently ElevenLabs)."
          },
          "source": {
            "type": "string",
            "enum": [
              "BYOK",
              "MANAGED"
            ],
            "description": "Which credential routes this provider for your organization. `BYOK` when you have configured your own key for it, `MANAGED` when it rides a Speko platform key. There is no third value — a provider covered by neither is not returned at all."
          }
        }
      },
      "VoicesListResponse": {
        "type": "object",
        "required": [
          "voices",
          "providers"
        ],
        "properties": {
          "voices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoiceCatalogEntry"
            }
          },
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VoicesProviderEntry"
            }
          }
        }
      },
      "SynthesizeRequest": {
        "type": "object",
        "required": [
          "text",
          "intent"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          },
          "intent": {
            "$ref": "#/components/schemas/RoutingIntent"
          },
          "voice": {
            "type": "string",
            "description": "Provider-specific voice id. Speko falls back to a sane default per provider when omitted."
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Optional upstream model name (e.g. `eleven_multilingual_v2`, `sonic-2`, `gpt-4o-mini-tts`, `qwen3-tts-flash`). When set, overrides the selector's chosen model on the primary candidate only — failover candidates still use the selector's model so a model intended for provider A is not sent to provider B."
          },
          "speed": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 2
          },
          "workload": {
            "type": "string",
            "enum": [
              "conversation",
              "transcription",
              "narration"
            ],
            "description": "Applies per-provider defaults from the param registry (e.g. `narration` sets ElevenLabs `voice_settings` and prefers a 24 kHz ladder when `sampleRate` is unset). Explicit fields override defaults. Applied param names are reported in the `X-Speko-Applied-Params` response header."
          },
          "providerOptions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "Per-provider TTS params keyed by provider id, validated against the registry (e.g. `{\"elevenlabs\":{\"voice_settings\":{\"stability\":0.6}}}`). A provider's options apply only when that provider serves the request and never cross providers on failover. Setting a provider spelling of `speed` alongside the top-level `speed` is rejected as `canonical_collision`."
          },
          "constraints": {
            "$ref": "#/components/schemas/PipelineConstraints"
          }
        }
      },
      "CompleteRequest": {
        "type": "object",
        "required": [
          "messages",
          "intent"
        ],
        "properties": {
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            }
          },
          "intent": {
            "$ref": "#/components/schemas/RoutingIntent"
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 1
          },
          "systemPrompt": {
            "type": "string",
            "description": "Forwarded via the canonical system-prompt slot. Don't *also* prepend the same content as a `system` message."
          },
          "constraints": {
            "$ref": "#/components/schemas/PipelineConstraints"
          },
          "reasoningEffort": {
            "type": "string",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh"
            ]
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatTool"
            }
          },
          "toolChoice": {
            "oneOf": [
              {
                "type": "string",
                "enum": [
                  "auto",
                  "none",
                  "required"
                ]
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          },
          "parallelToolCalls": {
            "type": "boolean"
          },
          "maxToolHops": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          }
        }
      },
      "CompleteResponse": {
        "type": "object",
        "required": [
          "text",
          "provider",
          "model",
          "usage",
          "failoverCount"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "usage": {
            "type": "object",
            "required": [
              "promptTokens",
              "completionTokens"
            ],
            "properties": {
              "promptTokens": {
                "type": "integer",
                "minimum": 0
              },
              "completionTokens": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "failoverCount": {
            "type": "integer",
            "minimum": 0
          },
          "scoresRunId": {
            "type": [
              "string",
              "null"
            ]
          },
          "toolCalls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatToolCall"
            }
          }
        }
      },
      "AgentIntent": {
        "type": "object",
        "description": "Routing defaults stored on an agent row. Hydrated into a session's `RoutingIntent` when the session is created with `agentId` and no inline `intent`. Note: agents accept a smaller `optimizeFor` enum than the per-session `RoutingIntent`.",
        "required": [
          "language"
        ],
        "properties": {
          "language": {
            "type": "string",
            "minLength": 2,
            "description": "BCP-47 language tag, e.g. `en`, `en-US`, `es-MX`.",
            "examples": [
              "en-US"
            ]
          },
          "optimizeFor": {
            "type": "string",
            "enum": [
              "latency",
              "quality",
              "cost"
            ]
          }
        }
      },
      "AgentLlmOptions": {
        "type": "object",
        "description": "Optional LLM tuning defaults stored on an agent. Strict object — only these three keys are accepted.",
        "additionalProperties": false,
        "properties": {
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 1
          },
          "model": {
            "type": "string",
            "description": "Pin a specific LLM model id. When omitted, the router picks per intent."
          }
        }
      },
      "Agent": {
        "type": "object",
        "description": "Reusable voice persona — `systemPrompt` + optional `voice` + routing `intent` defaults, plus optional `llmOptions`. Pass the `id` as `agentId` on `POST /v1/sessions` to seed a session from this agent.",
        "required": [
          "id",
          "organizationId",
          "name",
          "systemPrompt",
          "voice",
          "intent",
          "llmOptions",
          "createdAt",
          "updatedAt",
          "stackPreferences",
          "turnHandling"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Agent id, prefixed `agent_`.",
            "examples": [
              "agent_01HW..."
            ]
          },
          "organizationId": {
            "type": "string",
            "description": "Owning organization. Always equal to the authenticated org — agents are never visible across orgs."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Human-readable name. Unique within an organization."
          },
          "systemPrompt": {
            "type": "string",
            "minLength": 1,
            "description": "Initial agent instructions. Hydrated as the session's `systemPrompt` default when no per-call value is supplied."
          },
          "voice": {
            "type": [
              "string",
              "null"
            ],
            "description": "Default TTS voice id. `null` when unset — the router picks a sane default per provider."
          },
          "intent": {
            "$ref": "#/components/schemas/AgentIntent"
          },
          "llmOptions": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AgentLlmOptions"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional LLM tuning defaults. `null` when unset."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "stackPreferences": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AgentStackPreferences"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-agent stack preferences. `null` when the agent has no preferences set."
          },
          "turnHandling": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AgentTurnHandling"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-agent turn-taking posture. `null` when the agent runs the platform defaults."
          }
        }
      },
      "CreateAgentRequest": {
        "type": "object",
        "required": [
          "name",
          "systemPrompt",
          "intent"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Human-readable display name. Does not need to be unique — agents are identified by `id`."
          },
          "systemPrompt": {
            "type": "string",
            "minLength": 1,
            "description": "Initial agent instructions used as the session-level `systemPrompt` default."
          },
          "voice": {
            "type": "string",
            "description": "Default TTS voice id. Omit to let the router pick per provider."
          },
          "intent": {
            "$ref": "#/components/schemas/AgentIntent"
          },
          "llmOptions": {
            "$ref": "#/components/schemas/AgentLlmOptions"
          },
          "stackPreferences": {
            "$ref": "#/components/schemas/AgentStackPreferences"
          },
          "turnHandling": {
            "$ref": "#/components/schemas/AgentTurnHandling"
          },
          "audioOutput": {
            "type": "object",
            "description": "Static gain in dB on the agent's own speech, applied before the audio reaches the call (and so before a phone leg), whichever TTS provider spoke. Negative is quieter: `-6` roughly halves the amplitude, for voices mastered hotter than telephone speech. Boost saturates at full scale, so it clips a voice that already peaks near 0 dBFS. `0` is a passthrough. Background audio is not affected.",
            "properties": {
              "gainDb": {
                "type": "number",
                "minimum": -24,
                "maximum": 12
              }
            },
            "required": [
              "gainDb"
            ],
            "additionalProperties": false
          },
          "backgroundAudio": {
            "type": "object",
            "properties": {
              "ambient": {
                "type": "object",
                "properties": {
                  "clip": {
                    "type": "string",
                    "enum": [
                      "office-ambience",
                      "city-ambience",
                      "forest-ambience",
                      "crowded-room",
                      "keyboard-typing",
                      "keyboard-typing2"
                    ]
                  },
                  "volume": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 16
                  }
                },
                "required": [
                  "clip"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "endCall": {
            "type": "object",
            "description": "Deprecated. The `end_call` tool is always on for every agent. `{ \"enabled\": true }` is accepted and ignored; `{ \"enabled\": false }` is rejected with a 400 `VALIDATION_ERROR` instead of being silently dropped. Responses always report `{ \"enabled\": true }`.",
            "deprecated": true,
            "properties": {
              "enabled": {
                "type": "boolean",
                "enum": [
                  true
                ]
              }
            },
            "required": [
              "enabled"
            ],
            "additionalProperties": false
          },
          "firstMessage": {
            "type": "string",
            "maxLength": 2000,
            "description": "Opening line for any call without a direction-specific override (`inboundFirstMessage` / `outboundFirstMessage`). `\"\"` (empty string) means say nothing until the other side speaks; omitted means the default greeting for the call language (\"Hi, how can I help?\" in English)."
          },
          "idleRePrompts": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "delayMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 600000
              },
              "maxPrompts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "messages": {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              }
            },
            "required": [
              "enabled"
            ],
            "additionalProperties": false
          },
          "inboundFirstMessage": {
            "type": "string",
            "maxLength": 2000,
            "description": "Opening line on inbound calls. Wins over `firstMessage`. `\"\"` (empty string) means say nothing until the caller speaks; omitted falls back to `firstMessage`, then to the default greeting for the call language."
          },
          "languageRouting": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "maxDetectionTurns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "languages": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "language": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 35
                    },
                    "allowedProviders": {
                      "type": "object",
                      "properties": {
                        "stt": {
                          "maxItems": 8,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "llm": {
                          "maxItems": 8,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "tts": {
                          "maxItems": 8,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "voice": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "systemPrompt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100000
                    }
                  },
                  "required": [
                    "language"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "enabled",
              "languages"
            ],
            "additionalProperties": false
          },
          "outboundFirstMessage": {
            "type": "string",
            "maxLength": 2000,
            "description": "Opening line on outbound calls. Wins over `firstMessage`. A non-empty string is spoken as soon as the call connects. `\"\"` (empty string) means say nothing: the agent listens until the callee speaks. Omitting it is NOT silence: the call falls back to `firstMessage`, and if that is also unset, to the default greeting for the call language (\"Hi, how can I help?\" in English). Set `\"\"` to open in silence."
          },
          "promptVariables": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[\\w-]+(\\.[\\w-]+)*$"
                },
                "defaultValue": {
                  "type": "string",
                  "maxLength": 1000
                },
                "description": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "runMode": {
            "type": "string",
            "enum": [
              "cascade",
              "s2s"
            ]
          },
          "graphClassifier": {
            "type": "string",
            "enum": [
              "llm",
              "jev",
              "gpt-live"
            ],
            "default": "llm",
            "description": "Which judge answers `llm` edge conditions in graph mode. `llm` (the default) runs a temperature-0 one-shot on this agent's own cascade model. `jev` routes the decision through TypeSafe's System One as a choice over the candidate edges, returning a calibrated confidence per branch. Ignored by agents with no graph. `gpt-live` walks the graph on the agent's own GPT-Live speech-to-speech session; a call that runs on the cascade judges with `llm`. Any failure of the `jev` judge falls back to the `llm` path rather than failing the call."
          },
          "runtime": {
            "type": "string",
            "enum": [
              "livekit",
              "pipecat"
            ],
            "description": "Managed-agent runtime. It is chosen for the whole organization, not per agent: omit it, or send the organization's current runtime — any other value is refused with `409 RUNTIME_CONTROLLED_BY_ORGANIZATION`. The `pipecat` runtime runs `runMode: cascade` only."
          },
          "speechNormalization": {
            "type": "object",
            "properties": {
              "pronunciationDictionary": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
