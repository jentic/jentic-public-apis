            "type": "string",
            "enum": [
              "heuristic",
              "completed",
              "failed"
            ]
          },
          "custom_data": {
            "description": "The extracted values for this call, keyed by field name. A field the call gave no basis for is absent.",
            "$ref": "#/components/schemas/JsonObject"
          }
        }
      },
      "AgentExtractionField": {
        "type": "object",
        "required": [
          "name",
          "type",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "A valid identifier; the key the value lands under in `custom_data`."
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "enum"
            ]
          },
          "description": {
            "type": "string",
            "description": "The instruction the analysis LLM follows to pull this value from the transcript."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Allowed values. Required on `enum` fields, rejected on every other type."
          }
        }
      },
