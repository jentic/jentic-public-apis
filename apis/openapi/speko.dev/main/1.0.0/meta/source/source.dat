    "/v1/sessions/{id}/recording": {
      "get": {
        "summary": "Get a signed URL for the session recording",
        "description": "Returns a 302 redirect to a short-lived (5 minute) signed Google Cloud Storage URL for the mixed-mono Opus recording of this session. Follow the redirect to download the file — clients should pass the equivalent of `curl -L`. The signed URL is single-use within its TTL window; refetch this endpoint to get a fresh one. Recordings are retained for 30 days after the session ends, then deleted by a GCS lifecycle policy.",
        "operationId": "getSessionRecording",
        "tags": [
          "Voice"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Session id."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to a signed GCS URL valid for 5 minutes. The URL is returned in the `Location` header; the response body is empty.",
            "headers": {
              "Location": {
                "description": "Short-lived signed GCS URL. Follow to download the recording.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No recording exists for this session — either the id is unknown to the calling organization, recording was suppressed (`recordingStatus: \"suppressed\"`), the session is still in flight (`pending` / `uploading`), or the upload failed (`failed`). Inspect the parent session entry to disambiguate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "default": {
                    "value": {
                      "error": "recording not available",
                      "code": "RECORDING_NOT_AVAILABLE"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}/turns": {
      "post": {
        "summary": "Ingest finalized transcript turns",
        "description": "Append finalized STT and LLM turns to a session's transcript. Worker-only — the agent worker batches and debounces (~200ms) finalized turns and POSTs them here. Interim STT partials are not accepted; only finalized turns are persisted. Idempotent on `(session_id, index)`: re-posting a turn with the same index replaces the existing entry, so retries on transient errors are safe.",
        "operationId": "postSessionTurns",
        "tags": [
          "Voice"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Session id."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostSessionTurnsRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Turns accepted for persistence. Response body is empty."
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Session id is unknown to the calling organization.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "default": {
                    "value": {
                      "error": "session not found",
                      "code": "SESSION_NOT_FOUND"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}/transcript": {
      "get": {
        "summary": "Get a session's full transcript",
        "description": "Returns every finalized STT and LLM turn captured during the session, sorted by `index` ascending. The dashboard's session detail page surfaces these under the Transcript card. S2S sessions don't currently produce transcripts (the audio path bypasses our STT/LLM components) — expect an empty `entries` array for those. Interim STT partials are never returned; only finalized turns make it into this response.",
        "operationId": "getSessionTranscript",
        "tags": [
          "Voice"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Session id."
          }
        ],
        "responses": {
          "200": {
            "description": "Full transcript for the session, ordered by `index`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTranscript"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Session id is unknown to the calling organization.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "default": {
                    "value": {
                      "error": "session not found",
                      "code": "SESSION_NOT_FOUND"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/voice/calls": {
      "post": {
        "summary": "Dial an outbound human call",
        "description": "Places a PSTN call with the supplied org-defined broker's softphone as the other leg. Resolves as soon as the call exists — the PSTN leg is still `initiating`/`ringing`; watch the event stream for `call.answered`. The response carries join credentials for that browser leg: connect immediately, or the first moments after the far end answers are silence.",
        "operationId": "dialHumanCall",
        "tags": [
          "Call control"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HumanCallDialRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Call created. `call` carries both legs (the `browser` leg is the caller's softphone, the `pstn` leg the far end); `join` is the caller's own room credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "call",
                    "join"
                  ],
                  "properties": {
                    "call": {
                      "$ref": "#/components/schemas/HumanCall"
                    },
                    "join": {
                      "$ref": "#/components/schemas/HumanCallJoinCredentials"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/HumanCallingUnavailable"
          }
        }
      },
      "get": {
        "summary": "List human calls",
        "description": "The organization's calls, newest first. Filters combine via AND and are validated — an unknown `status` is a 400, not an ignored filter.",
        "operationId": "listHumanCalls",
        "tags": [
          "Call control"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "initiating",
                "ringing",
                "active",
                "ended",
                "declined",
                "missed",
                "cancelled",
                "failed"
              ]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "inbound",
                "outbound",
                "internal"
              ]
            }
          },
          {
            "name": "brokerId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Calls with a `browser` leg owned by this broker."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Calls, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "calls": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/HumanCall"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/HumanCallingUnavailable"
          }
        }
      }
    },
    "/v1/voice/calls/{callId}": {
      "get": {
        "summary": "Get a human call",
        "operationId": "getHumanCall",
        "tags": [
          "Call control"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CallId"
          }
        ],
        "responses": {
          "200": {
            "description": "The call and every leg on it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanCall"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Call or leg not found — including a leg that exists but belongs to another organization or broker.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "default": {
                    "value": {
                      "error": "not found",
                      "code": "NOT_FOUND"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/HumanCallingUnavailable"
          }
        }
      }
    },
    "/v1/voice/calls/{callId}/events": {
      "get": {
        "summary": "List a call's events",
        "description": "The call's ordered history, oldest first — the durable record behind the one-shot webhook stream. Reconcile from here.",
        "operationId": "listHumanCallEvents",
        "tags": [
          "Call control"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CallId"
          }
        ],
        "responses": {
          "200": {
            "description": "Events, oldest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/HumanCallEvent"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Call or leg not found — including a leg that exists but belongs to another organization or broker.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "default": {
                    "value": {
                      "error": "not found",
                      "code": "NOT_FOUND"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/HumanCallingUnavailable"
          }
        }
      }
    },
    "/v1/voice/legs/{controlId}/join": {
      "post": {
        "summary": "Mint join credentials for your leg",
        "description": "Room credentials for one of the supplied broker's own `browser` legs. Join first, then `answer`. Tokens are short-lived and minted per join; re-join on reconnect rather than caching one. A leg owned by another broker returns 404, deliberately indistinguishable from a leg that does not exist.",
        "operationId": "joinHumanCallLeg",
        "tags": [
          "Call control"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ControlId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "brokerId"
                ],
                "additionalProperties": false,
                "properties": {
                  "brokerId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Join credentials for the leg's room.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanCallJoinCredentials"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Call or leg not found — including a leg that exists but belongs to another organization or broker.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "default": {
                    "value": {
                      "error": "not found",
                      "code": "NOT_FOUND"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/HumanCallingUnavailable"
          }
        }
      }
    },
    "/v1/voice/legs/{controlId}/actions/{command}": {
      "post": {
        "summary": "Command a live leg",
        "description": "The command surface: `answer`, `hangup`, `bridge`, `hold`, `unhold`, `mute`, `unmute`, `dtmf`, `transfer`, each addressed to the leg it acts on. Commands are idempotent by intent — repeating one is a no-op that still returns the leg. Accepts an API key: server-side automation on live calls is the point of a programmable-voice API. Notable semantics: `hold` is silent (no hold-music source yet); `dtmf` must be addressed to a `pstn` leg and requires a connected browser leg on the call to relay the tones; a warm `transfer` is completed by a later `bridge`.",
        "operationId": "commandHumanCallLeg",
        "tags": [
          "Call control"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ControlId"
          },
          {
            "name": "command",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "answer",
                "hangup",
                "bridge",
                "hold",
                "unhold",
                "mute",
                "unmute",
                "dtmf",
                "transfer"
              ]
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HumanCallCommandRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The leg after the command.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanCallCommandResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid payload (`VALIDATION_ERROR`), a command the leg kind cannot take (`UNSUPPORTED_COMMAND`), or a bridge to a leg that is not live or not yours (`BRIDGE_TARGET_INVALID`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "default": {
                    "value": {
                      "error": "DTMF is only meaningful towards a PSTN leg",
                      "code": "UNSUPPORTED_COMMAND"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Call or leg not found — including a leg that exists but belongs to another organization or broker.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "default": {
                    "value": {
                      "error": "not found",
                      "code": "NOT_FOUND"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "The leg (`LEG_NOT_LIVE`) or call (`CALL_NOT_LIVE`) has already ended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "default": {
                    "value": {
                      "error": "leg is not live",
                      "code": "LEG_NOT_LIVE"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/HumanCallingUnavailable"
          }
        }
      }
    },
    "/v1/voice/presence/token": {
      "post": {
        "summary": "Register and mint presence credentials",
        "description": "Marks the supplied broker `available` AND mints credentials for their presence room in one round trip. Connect with `livekit-client` and listen for JSON data messages on topic `speko.human_call` — ring offers and live call events arrive there. A broker with no open presence connection cannot be rung, whatever their status.",
        "operationId": "mintPresenceToken",
        "tags": [
          "Call control"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "brokerId"
                ],
                "additionalProperties": false,
                "properties": {
                  "brokerId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presence-room credentials.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HumanCallJoinCredentials"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/HumanCallingUnavailable"
          }
        }
      }
    },
    "/v1/voice/presence/heartbeat": {
      "post": {
        "summary": "Heartbeat",
        "description": "Keeps the supplied broker reachable. Presence goes stale 90 seconds after the last heartbeat and a stale broker is skipped by inbound routing regardless of stored status — call this on a timer, every 30 seconds is a good default.",
        "operationId": "presenceHeartbeat",
        "tags": [
          "Call control"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "brokerId"
                ],
                "additionalProperties": false,
                "properties": {
                  "brokerId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The broker's presence after the heartbeat.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrokerPresence"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/HumanCallingUnavailable"
          }
        }
      }
    },
    "/v1/voice/presence": {
      "put": {
        "summary": "Set availability",
        "description": "Sets the supplied broker's status. `busy` and `away` keep the heartbeat alive while diverting inbound; `offline` leaves routing entirely.",
        "operationId": "setPresenceStatus",
        "tags": [
          "Call control"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "brokerId",
                  "status"
                ],
                "additionalProperties": false,
                "properties": {
                  "brokerId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "available",
                      "busy",
                      "away",
                      "offline"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated presence.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrokerPresence"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/HumanCallingUnavailable"
          }
        }
      },
      "get": {
        "summary": "List the availability roster",
        "description": "Every registered broker in the organization with their status and a computed `reachable`. Build your team's availability board from it.",
        "operationId": "listPresence",
        "tags": [
          "Call control"
        ],
        "responses": {
          "200": {
            "description": "The org roster.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "brokers": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BrokerPresence"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "503": {
            "$ref": "#/components/responses/HumanCallingUnavailable"
          }
        }
      }
    },
