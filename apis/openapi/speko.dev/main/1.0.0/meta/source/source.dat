                }
              }
            }
          }
        }
      }
    },
    "/v1/tts/models": {
      "get": {
        "summary": "Compare TTS models",
        "description": "Every TTS model this organization can route, with all measured benchmarks for one language. Scoped to what you can call: a vendor with no platform key and no BYOK credential is absent unless you pass `include_unroutable=true`.\n\nThere is no composite score. The TTS board publishes no overall rank column, so results come back measured-first and then ordered by the single axis you name. A model with no value on that axis sorts last in either direction, so an unmeasured model cannot win a cheapest-or-fastest sort by having no number.",
        "operationId": "listTtsModels",
        "tags": [
          "Voice"
        ],
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "en"
            },
            "description": "Which language cell to report. Robustness is measured for English only."
          },
          {
            "name": "use_case",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "longform",
                "phone"
              ]
            },
            "description": "Narrow to models with at least one voice meeting this use case. Rows included only by `include_unroutable=true` are not narrowed, since no voice evidence exists for a model this organization cannot route."
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "natural",
                "latency",
                "cost",
                "robustness"
              ],
              "default": "natural"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "description": "Defaults to ascending for `latency` and `cost`, descending for the other axes."
          },
          {
            "name": "include_unroutable",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false",
                "1",
                "0"
              ],
              "default": "false"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Model comparison",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string"
                    },
                    "language": {
                      "type": "string"
                    },
                    "sort": {
                      "type": "string"
                    },
                    "order": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TtsModel"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/TtsCatalogMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/tts/voices": {
      "get": {
        "summary": "Browse TTS voices by measured quality",
        "description": "Paginated voice list with measured quality labels and the benchmarks of the model each voice would run on.\n\nOne parameter gets you a long way: `?use_case=longform` or `?use_case=phone`. Longform returns a short list, because it requires the `consistent` label that roughly a fifth of routed voices hold, concentrated in two vendors. When a filter set returns little, `blockers` names the requirements holding the rest back, and each entry says whether relaxing that one alone would admit anything.\n\nEvery row carries `use_with`, the provider, model and voice ids to send to `POST /v1/synthesize`.\n\nAlways scoped to what this organization can route. Unlike `/v1/tts/models` there is no way to widen it.",
        "operationId": "listTtsVoices",
        "tags": [
          "Voice"
        ],
        "parameters": [
          {
            "name": "use_case",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "longform",
                "phone"
              ]
            },
            "description": "Expands to a bundle of quality requirements plus a capacity floor. Combine with `quality` to tighten it."
          },
          {
            "name": "quality",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "clean",
                  "full_band",
                  "peak_safe",
                  "longform_stable",
                  "consistent"
                ]
              }
            },
            "description": "Repeatable, and repeats mean AND. `GET /v1/tts/meta` documents what each value asserts."
          },
          {
            "name": "min_chars_per_call",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                5000,
                7500,
                10000,
                20000
              ]
            },
            "description": "A floor. Returns voices that accept at least this much in one call."
          },
          {
            "name": "pace",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "slow",
                "normal",
                "brisk",
                "fast"
              ]
            },
            "description": "An exact bucket. `normal` excludes `brisk`."
          },
          {
            "name": "vendor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "gender",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "male",
                "female",
                "neutral"
              ]
            }
          },
          {
            "name": "accent",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter voices by supported language. Exact when a region is named, prefix otherwise."
          },
          {
            "name": "model",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Pin to one model id. Compatible voices are re-paired onto it, so `use_with` names the model you asked for rather than the vendor default, and `voice_compatibility` says whether that pairing is individually verified."
          },
          {
            "name": "benchmark_language",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "en"
            },
            "description": "Which language the embedded model benchmarks report."
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "model_naturalness",
                "latency",
                "model_cost",
                "pace",
                "max_chars",
                "name"
              ],
              "default": "model_naturalness"
            },
            "description": "Measured voices sort before unmeasured ones on every axis except `name`, which is purely alphabetical. A voice with no value on the chosen axis sorts last in either direction."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "From a previous `next_cursor`. Tied to the filter and sort it was issued for; changing either returns `INVALID_CURSOR` instead of silently reshuffling the page."
          },
          {
            "name": "include_unmeasured",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false",
                "1",
                "0"
              ],
              "default": "true"
            },
            "description": "Set `false` to drop voices that were never measured. Voices that were measured and cleared no label (`verdict: measured_no_labels`) are kept, since that is a result rather than a gap."
          }
        ],
        "responses": {
          "200": {
            "description": "Voice list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string"
                    },
                    "total": {
                      "type": "integer",
                      "description": "Total matching the filters, not the page size."
                    },
                    "next_cursor": {
                      "type": "string",
                      "nullable": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TtsVoice"
                      }
                    },
                    "models": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/TtsModel"
                      },
                      "description": "The models this page references, keyed by id, included once rather than repeated per voice."
                    },
                    "facets": {
                      "type": "object",
                      "description": "Self-excluding counts: each group is computed with its own filter dropped, so `vendor` still lists every vendor when `?vendor=` is set. `quality` is multi-valued, so its whole group is dropped and each axis reports what that axis alone would return with the other slots still applied. The quality counts therefore do not move when the quality selection changes, and a count is not \"what relaxing this one requirement would give\" once two or more axes are selected. For that, read `blockers`.",
                      "properties": {
                        "vendor": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "value": {
                                "type": "string"
                              },
                              "count": {
                                "type": "integer"
                              }
                            }
                          }
                        },
                        "accent": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "value": {
                                "type": "string"
                              },
                              "count": {
                                "type": "integer"
                              }
                            }
                          }
                        },
                        "quality": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "value": {
                                "type": "string"
                              },
                              "label": {
                                "type": "string"
                              },
                              "count": {
                                "type": "integer"
                              }
                            }
                          }
                        }
                      }
                    },
                    "blockers": {
                      "type": "array",
                      "description": "Which requirements are holding voices back, so a short result set explains itself. `param` and `value` are what to change or drop to widen the search. `sole_binding` says whether relaxing that one requirement alone would admit anything; when it is false, two or more bind together and `blocks` is that requirement's cost on its own. Counts cover measured voices only, since an unmeasured voice holds no label and so fails every requirement rather than any one of them.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "param": {
                            "type": "string",
                            "enum": [
                              "quality",
                              "pace",
                              "min_chars_per_call"
                            ],
                            "description": "The query parameter this requirement came from."
                          },
                          "value": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "integer"
                              }
                            ],
                            "description": "The value to drop or relax on that parameter."
                          },
                          "label": {
                            "type": "string"
                          },
                          "blocks": {
                            "type": "integer"
                          },
                          "hint": {
                            "type": "string"
                          },
                          "sole_binding": {
                            "type": "boolean",
                            "description": "True when relaxing this requirement alone would admit more voices. False when no single relaxation helps."
                          }
                        }
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/TtsCatalogMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error (`VALIDATION_ERROR`); `INVALID_CURSOR` when a cursor is reused across a different filter or sort; `CURSOR_EXPIRED` when the row a cursor resumes after has left the result set. In both cursor cases, restart the listing without a cursor."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/tts/voices/{vendor}/{voiceId}": {
      "get": {
        "summary": "One voice and the model it runs on",
        "description": "Everything the list returns for a single voice, plus the model it would run on and that model’s benchmarks. Quality labels state what was checked, and `quality.verdict` says whether the voice was measured at all.",
        "operationId": "getTtsVoice",
        "tags": [
          "Voice"
        ],
        "parameters": [
          {
            "name": "vendor",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "voiceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Case-sensitive, exactly as the provider spells it."
          }
        ],
        "responses": {
          "200": {
            "description": "Voice detail",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TtsVoice"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "model": {
                          "allOf": [
                            {
                              "$ref": "#/components/schemas/TtsModel"
                            }
                          ],
                          "nullable": true
                        },
                        "meta": {
                          "$ref": "#/components/schemas/TtsCatalogMeta"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No such voice, or it is not routable for this organization."
          }
        }
      }
    },
    "/v1/tts/meta": {
      "get": {
        "summary": "The quality vocabulary",
        "description": "What every quality label asserts, plus the pace buckets, capacity rungs and use-case bundles. Every value the filters accept is listed here.",
        "operationId": "getTtsMeta",
        "tags": [
          "Voice"
        ],
        "responses": {
          "200": {
            "description": "Vocabulary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "quality": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "means": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "pace": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "range_wpm": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    },
                    "chars_per_call": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "integer"
                          },
                          "label": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "use_cases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "value": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "hint": {
                            "type": "string"
                          },
                          "requires": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "min_chars_per_call": {
                            "type": "integer"
                          }
                        }
                      }
                    },
                    "notes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key (sk_live_...)"
      }
    },
    "parameters": {
      "Id": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Resource id."
      },
      "CallId": {
        "name": "callId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Call id."
      },
      "ControlId": {
        "name": "controlId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Leg control id — the opaque command handle returned on every leg (the Telnyx `call_control_id` equivalent)."
      },
      "SmsConversationId": {
        "name": "conversation_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "SmsAssignee": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "SmsConversationNote": {
        "type": "object",
        "required": [
          "id",
          "conversation_id",
          "created_by_user_id",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_by_user_id": {
            "type": "string"
          },
          "redacted_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SmsMessageStatus": {
        "type": "string",
        "enum": [
          "queued",
          "scheduled",
          "submitting",
          "accepted",
          "sent",
          "delivered",
          "delivery_failed",
          "rejected",
          "submission_unknown",
          "canceled",
          "received"
        ]
      },
      "SmsMessage": {
        "type": "object",
        "required": [
          "id",
          "conversation_id",
          "from_phone_number_id",
          "direction",
          "origin",
          "from",
          "to",
          "status",
          "estimated_segments",
          "segment_count",
          "charged_micro_usd",
          "metadata",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "batch_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "from_phone_number_id": {
            "type": "string",
            "format": "uuid"
          },
          "direction": {
            "type": "string",
            "enum": [
              "inbound",
              "outbound"
            ]
          },
          "origin": {
            "type": "string",
            "enum": [
              "api",
              "dashboard",
              "agent_tool",
              "agent_auto_reply",
              "telnyx"
            ]
          },
          "from": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{6,14}$"
          },
          "to": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{6,14}$"
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1600
          },
          "campaign_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "brand_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "campaign_snapshot": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "consent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "consent_basis": {
            "type": [
              "string",
              "null"
            ]
          },
          "recipient_timezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "requested_send_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "effective_send_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "terminal_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/SmsMessageStatus"
          },
          "provider_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "encoding": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "gsm7",
              "ucs2",
              null
            ]
          },
          "estimated_segments": {
            "type": "integer",
            "minimum": 1
          },
          "segment_count": {
            "type": "integer",
            "minimum": 1
          },
          "estimated": {
            "type": "object",
            "required": [
              "encoding",
              "units",
              "segments",
              "per_segment"
            ],
            "properties": {
              "encoding": {
                "type": "string",
                "enum": [
                  "gsm7",
                  "ucs2"
                ]
              },
              "units": {
                "type": "integer"
              },
              "segments": {
                "type": "integer"
              },
              "per_segment": {
                "type": "integer"
              }
            }
          },
          "charged_micro_usd": {
            "type": "string"
          },
          "provider_cost_micro_usd": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "error": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SmsMessagePage": {
        "type": "object",
        "required": [
          "data",
