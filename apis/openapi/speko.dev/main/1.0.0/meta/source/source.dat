        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SmsMessage"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SmsSendRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_phone_number_id",
          "to",
          "text"
        ],
        "properties": {
          "from_phone_number_id": {
            "type": "string",
            "format": "uuid"
          },
          "to": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{6,14}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "send_at": {
            "type": "string",
            "format": "date-time",
            "description": "At most 90 days ahead."
          },
          "consent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "recipient_timezone": {
            "type": [
              "string",
              "null"
            ],
            "description": "IANA timezone required for proactive traffic unless stored consent supplies it."
          },
          "metadata": {
            "type": "object",
            "maxProperties": 50,
            "additionalProperties": true
          }
        }
      },
      "SmsConversationSendRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "send_at": {
            "type": "string",
            "format": "date-time"
          },
          "consent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "recipient_timezone": {
            "type": [
              "string",
              "null"
            ]
          },
          "metadata": {
            "type": "object",
            "maxProperties": 50,
            "additionalProperties": true
          }
        }
      },
      "SmsBatchRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_phone_number_id",
          "recipients"
        ],
        "properties": {
          "from_phone_number_id": {
            "type": "string",
            "format": "uuid"
          },
          "send_at": {
            "type": "string",
            "format": "date-time"
          },
          "recipients": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "required": [
                "to",
                "text"
              ],
              "properties": {
                "to": {
                  "type": "string"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1600
                },
                "consent_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uuid"
                },
                "recipient_timezone": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "metadata": {
                  "type": "object",
                  "maxProperties": 50,
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "SmsBatch": {
        "type": "object",
        "required": [
          "id",
