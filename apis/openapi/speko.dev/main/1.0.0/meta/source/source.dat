{
  "openapi": "3.1.0",
  "info": {
    "title": "Speko API",
    "version": "1.0.0",
    "description": "Public REST API for the Speko voice gateway. Routes, transcribes, synthesizes, and completes via the highest-scoring provider for your routing intent, with transparent server-side failover.",
    "contact": {
      "email": "abat@speko.ai"
    }
  },
  "servers": [
    {
      "url": "https://api.speko.dev",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/sessions": {
      "post": {
        "summary": "Create a real-time voice session",
        "description": "Creates either a provider-direct S2S session or a LiveKit-backed cascade session. S2S returns a scoped, short-lived provider credential so the client connects directly to OpenAI Realtime, Gemini Live, or xAI Grok Voice; Speko remains in the control and billing path but never proxies media. Cascade returns browser-safe LiveKit credentials and dispatches an STT → LLM → TTS worker.",
        "operationId": "createSession",
        "tags": [
          "Voice"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 256
            },
            "description": "Required when the session resolves to `s2s`. Reuse the same value after an ambiguous timeout to recover the same reservation."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSessionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "description": "Insufficient credit balance for the requested S2S entitlement."
          },
          "403": {
            "description": "Provider-direct S2S is not enabled for the organization."
          },
          "409": {
            "description": "The idempotency key is already in use by a different S2S bootstrap."
          },
          "422": {
            "description": "The requested S2S provider, model, voice, sample rate, or route is unavailable."
          },
          "429": {
            "description": "Realtime session capacity is currently exhausted."
          },
          "500": {
            "$ref": "#/components/responses/SessionCreateFailed"
          },
          "502": {
            "description": "The provider-direct control plane returned an invalid session plan."
          },
          "503": {
            "description": "Provider-direct S2S bootstrap is temporarily unavailable."
          }
        }
      },
      "get": {
        "summary": "List voice sessions",
        "description": "Returns sessions visible to the calling key, newest first. Supports cursor pagination and filtering by `status`, `kind`, and `agent`. All filters combine via AND.",
        "operationId": "listSessions",
        "tags": [
          "Voice"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opaque cursor returned by a prior call. Omit on the first page."
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Max number of entries to return."
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by session lifecycle status (e.g. `active`, `ended`, `failed`)."
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "cascade",
                "s2s",
                "realtime"
              ]
            },
            "description": "Filter by session kind: `cascade` (STT -> LLM -> TTS) or `s2s` (speech-to-speech, also called realtime). `realtime` is accepted as an alias for `s2s`. Any other value is rejected with 400."
          },
          {
            "in": "query",
            "name": "minDuration",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Inclusive minimum displayed session duration in whole seconds. Combined with other filters before pagination. Open sessions with no final duration are excluded. Rejected dials have duration zero."
          },
          {
            "in": "query",
            "name": "maxDuration",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Inclusive maximum displayed session duration in whole seconds. Must be at least minDuration when both are supplied."
          },
          {
            "in": "query",
            "name": "agent",
            "required": false,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "description": "Filter to sessions started against any selected agent. Repeat the parameter for multiple agents, for example `agent=one&agent=two`. Matches `pipelineConfig.agentId` and combines with other filters via AND. Single-agent URLs remain supported."
          }
        ],
        "responses": {
          "200": {
            "description": "Page of session entries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionEntries"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/sessions/phone": {
      "post": {
        "summary": "Place an outbound phone call",
        "description": "Creates a voice session, dispatches the configured agent worker, and dials the destination over LiveKit SIP. Supply either `agentId` or `intent`.",
        "operationId": "createPhoneSession",
        "tags": [
          "Telephony"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoiceDialRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Call dialing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceDialResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/AgentNotFound"
          }
        }
      }
    },
    "/v1/transcribe": {
      "post": {
        "summary": "Transcribe audio (speech to text)",
        "description": "Routes the request to the best STT provider for your `(language, region, optimizeFor)` intent, with automatic failover to runner-up providers before the first event is emitted. Body is binary audio. Routing intent goes in the `x-speko-intent` header (JSON). The response is a Server-Sent Events stream: `meta`, `transcript`, `done`, and `error`.",
        "operationId": "transcribe",
        "tags": [
          "Voice"
        ],
        "parameters": [
          {
            "in": "header",
            "name": "x-speko-intent",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "JSON-encoded `RoutingIntent`. Example: `{\"language\":\"en-US\",\"region\":\"global\"}`."
          },
          {
            "in": "header",
            "name": "x-speko-constraints",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional JSON-encoded `PipelineConstraints`. Each `allowedProviders` entry is either `\"<vendor>\"` (any model from that vendor) or `\"<vendor>:<model>\"` (a specific model). Example: `{\"allowedProviders\":{\"stt\":[\"deepgram:nova-3\"]}}`."
          },
          {
            "in": "header",
            "name": "x-speko-stt-options",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional JSON-encoded STT options, max 4 KB. Fields: `keywords` (string[], <=200, vocabulary bias), `language` (BCP-47 or `auto`, provider-level override that does not change routing), `workload` (`conversation` | `transcription` | `narration`, applies registry defaults per provider), `diarization` (batch-only boolean, demote-class: incapable providers are excluded from failover; 422 `no_capable_provider` when none remain), `speakersExpected` (integer hint), `smartFormat` (boolean), `fillerWords` (boolean), `profanityFilter` (boolean), `wordTimestamps` (batch-only boolean, demote-class; the `done` frame carries `words: [{text, start, end}]` in seconds — served by `gemini-3.5-transcribe`, which must be pinned through `X-Speko-Constraints` or the request answers 422 `no_capable_provider`, and which cannot combine it with `keywords`), `providerOptions` (per-provider params validated against the registry, e.g. `{\"deepgram\":{\"dictation\":true}}`; apply only when that provider serves the request and never cross providers on failover). Example: `{\"workload\":\"transcription\",\"diarization\":true}`."
          },
          {
            "in": "header",
            "name": "Content-Type",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Audio MIME type, e.g. `audio/wav`, `audio/mpeg`, `audio/pcm;rate=16000`."
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Binary audio. WAV, MP3, or raw PCM accepted.",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "audio/wav": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "audio/mpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transcript event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE events: `meta` with provider/model, zero or more `transcript` events, final `done` containing a `TranscribeResponse`, or `error` after streaming has started."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidAudio"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/TranscribeFailed"
          }
        }
      }
    },
    "/v1/voices": {
      "get": {
        "summary": "List TTS voices",
        "description": "Returns the curated catalog of TTS voices grouped by provider, plus the list of TTS providers Speko can route for YOUR organization. Providers are filtered by key coverage: one appears only when your organization has its own credential for it (`source: \"BYOK\"`) or Speko holds a managed key (`source: \"MANAGED\"`). A provider with neither is omitted, and its voices are omitted with it — so a voice returned here is always one a session can actually be created with. ElevenLabs is included in `providers` with `voicesFetchedLive: true` because its voice library is account-scoped — fetch it directly from `https://api.elevenlabs.io/v1/voices` with the org's key.",
        "operationId": "listVoices",
        "tags": [
          "Voice"
        ],
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter to a single provider's voices. Accepts either the routing key (`cartesia`, `xai`, `alibaba`, `openai`, `inworld`, `elevenlabs`) or the catalog suffix form (`xai-tts`, `alibaba-tts`, `openai-tts`)."
          }
        ],
        "responses": {
          "200": {
            "description": "Voice catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoicesListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/synthesize": {
      "post": {
        "summary": "Synthesize speech (text to speech)",
        "description": "Routes the request to the best TTS provider for your intent, with automatic failover before the first audio chunk. Returns chunked binary audio. The `Content-Type` header (mirrored in `X-Speko-Audio-Format`) tells you the format.",
        "operationId": "synthesize",
        "tags": [
          "Voice"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SynthesizeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Chunked audio bytes",
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string"
                },
                "description": "Audio MIME type, e.g. `audio/pcm;rate=24000` or `audio/mpeg`."
              },
              "X-Speko-Audio-Format": {
                "schema": {
                  "type": "string"
                },
                "description": "Mirrors `Content-Type` for client-side dispatch."
              },
              "X-Speko-Provider": {
                "schema": {
                  "type": "string"
                },
                "description": "Provider that actually handled the request."
              },
              "X-Speko-Model": {
                "schema": {
                  "type": "string"
                },
                "description": "Specific model used."
              },
              "X-Speko-Failover-Count": {
                "schema": {
                  "type": "integer"
                },
                "description": "Number of providers tried before success."
              },
              "X-Speko-First-Byte-Ms": {
                "schema": {
                  "type": "integer"
                },
                "description": "Server-side time to first audio from the WINNING provider only (its synthesize call to its first audio chunk). Excludes failed failover attempts, so it is lower than the time a client waits."
              },
              "X-Speko-Request-First-Byte-Ms": {
                "schema": {
                  "type": "integer"
                },
                "description": "Server-side time to first audio for the whole request: gateway entry to first audio chunk, including routing, credit gating and every failed failover attempt. Use this one for client timeout budgeting."
              },
              "X-Speko-Scores-Run-Id": {
                "schema": {
                  "type": "string"
                },
                "description": "Benchmark snapshot id used for routing."
              },
              "X-Speko-Applied-Params": {
                "schema": {
                  "type": "string"
                },
                "description": "JSON array of param names applied to the winning provider. Present only when the request used `workload` or `providerOptions`."
              },
              "X-Speko-Warnings": {
                "schema": {
                  "type": "string"
                },
                "description": "JSON array of param warnings (`param_dropped`, `out_of_range`, `provider_not_pinned`), capped at 2 KB. Present only when non-empty."
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/SynthesizeFailed"
          }
        }
      }
    },
    "/v1/complete": {
      "post": {
        "summary": "Generate an LLM completion",
        "description": "Single-turn LLM call routed to the best provider for your intent, with automatic failover before the first event is emitted. The response is a Server-Sent Events stream: `meta`, `delta`, `tool_call`, `server_tool_call`, `done`, and `error`.",
        "operationId": "complete",
        "tags": [
          "Voice"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completion event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "SSE events: `meta`, zero or more `delta` and tool events, final `done` containing a `CompleteResponse`, or `error` after streaming has started."
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/CompleteFailed"
          }
        }
      }
    },
    "/v1/webhooks": {
      "get": {
        "summary": "List webhook endpoints",
        "description": "Lists active organization-level lifecycle webhook endpoints. Secret values are never returned.",
        "operationId": "listWebhookEndpoints",
        "tags": [
          "Webhooks"
        ],
        "responses": {
          "200": {
            "description": "Active webhook endpoints.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WebhookEndpoint"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Create a webhook endpoint",
        "description": "Creates an organization endpoint with event, agent, and optional tag routing. Plaintext signing and auth-header secrets are write-only.",
        "operationId": "createWebhookEndpoint",
        "tags": [
          "Webhooks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEndpointInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Endpoint created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpoint"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "The endpoint conflicts with an existing extraction definition or pre-call route.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Get a webhook endpoint",
        "operationId": "getWebhookEndpoint",
        "tags": [
          "Webhooks"
        ],
        "responses": {
          "200": {
            "description": "Webhook endpoint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpoint"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Endpoint not found."
          }
        }
      },
      "patch": {
        "summary": "Update a webhook endpoint",
        "description": "Updates supplied endpoint fields. Omit an existing secret auth-header value to retain it.",
        "operationId": "updateWebhookEndpoint",
        "tags": [
          "Webhooks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookEndpointUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated endpoint.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpoint"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Endpoint not found."
          },
          "409": {
            "description": "Routing or extraction conflict."
          }
        }
      },
      "delete": {
        "summary": "Delete a webhook endpoint",
        "description": "Soft-deletes the endpoint and cancels pending retries. Existing delivery history remains until its 30-day expiry.",
        "operationId": "deleteWebhookEndpoint",
        "tags": [
          "Webhooks"
        ],
        "responses": {
          "204": {
            "description": "Endpoint deleted."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Endpoint not found."
          }
        }
      }
    },
    "/v1/webhook-deliveries": {
      "get": {
        "summary": "List webhook deliveries",
        "description": "Returns one row per endpoint delivery, newest first. Bodies and logs expire after 30 days.",
        "operationId": "listWebhookDeliveries",
        "tags": [
          "Webhooks"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "endpointId",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "event",
            "schema": {
              "$ref": "#/components/schemas/WebhookEventType"
            }
          },
          {
            "in": "query",
            "name": "agentId",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "$ref": "#/components/schemas/WebhookDeliveryStatus"
            }
          },
          {
            "in": "query",
            "name": "sessionId",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "eventId",
            "schema": {
              "type": "string"
            },
            "description": "Speko lifecycle webhook UUID or stable provider event ID."
          },
          {
            "in": "query",
            "name": "from",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "to",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "description": "Opaque cursor from a previous response."
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delivery page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookDeliveryPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/webhook-deliveries/{id}": {
      "get": {
        "summary": "Get webhook delivery details",
        "description": "Returns the stored endpoint-specific payload and chronological sanitized attempt history.",
        "operationId": "getWebhookDelivery",
        "tags": [
          "Webhooks"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delivery details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookDeliveryDetail"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Delivery not found."
          }
        }
      }
    },
    "/v1/webhook-deliveries/{id}/redeliver": {
      "post": {
        "summary": "Redeliver a webhook",
        "description": "Adds a manual attempt using the original event payload and webhook ID with the endpoint's current URL and credentials. Pre-call, expired, and provider-retried iMessage deliveries cannot be manually redelivered.",
        "operationId": "redeliverWebhook",
        "tags": [
          "Webhooks"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Manual delivery result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookRedeliveryResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Delivery not found."
          },
          "409": {
            "description": "Delivery is expired, pre-call, provider-retried, or belongs to a deleted endpoint."
          }
        }
      }
    },
    "/v1/agents": {
      "get": {
        "summary": "List agents",
        "description": "Returns every agent belonging to the authenticated organization. Agents are scoped per-org — IDs from another org will never appear here.",
        "operationId": "listAgents",
        "tags": [
          "Agents"
        ],
        "responses": {
          "200": {
            "description": "Agents owned by the authenticated organization.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agent"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "summary": "Create an agent",
        "description": "Persists a reusable voice persona — `systemPrompt`, optional `voice`, routing `intent`, and optional `llmOptions` — keyed by `name` within the authenticated organization. Pass the returned `id` as `agentId` on `POST /v1/sessions` to seed a session from this agent.",
        "operationId": "createAgent",
        "tags": [
          "Agents"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAgentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Agent created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/agents/{id}": {
      "get": {
        "summary": "Get an agent",
        "description": "Fetch a single agent by id. Scoped to the authenticated organization — agents owned by another org always return 404.",
        "operationId": "getAgent",
        "tags": [
          "Agents"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Agent id, prefixed `agent_`."
          }
        ],
        "responses": {
          "200": {
            "description": "Agent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/AgentNotFound"
          }
        }
      },
      "patch": {
        "summary": "Update an agent",
        "description": "Partial update — every field on the body is optional and only supplied keys are written.",
        "operationId": "updateAgent",
        "tags": [
          "Agents"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Agent id, prefixed `agent_`."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAgentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/AgentNotFound"
          }
        }
      },
      "delete": {
        "summary": "Delete an agent",
        "description": "Removes the agent and its registered tools. The organization's only remaining agent cannot be deleted and returns 409.",
        "operationId": "deleteAgent",
        "tags": [
          "Agents"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Agent id, prefixed `agent_`."
          }
        ],
        "responses": {
          "200": {
            "description": "Agent deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "deleted"
                  ],
                  "properties": {
                    "deleted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/AgentNotFound"
          },
          "409": {
            "$ref": "#/components/responses/AgentDeleteConflict"
          }
        }
      }
    },
    "/v1/agents/{id}/calls": {
      "get": {
        "summary": "List calls for an agent",
        "description": "Returns recent calls whose session pipeline config references this agent. Results are newest first and support cursor pagination.",
        "operationId": "listAgentCalls",
        "tags": [
          "Telephony"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Agent id."
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Use `next_cursor` from the previous page."
          },
          {
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Only include calls created at or after this timestamp."
          }
        ],
        "responses": {
          "200": {
            "description": "Page of calls",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentCallListPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/AgentNotFound"
          }
        }
      }
    },
    "/v1/agents/{id}/analysis": {
      "get": {
        "summary": "Post-call analysis for an agent",
        "description": "One row per call, with the values the post-call analysis extracted for each declared field. The schema is the same merge the analysis itself uses — the agent's own `extractionFields` plus any declared on the webhook endpoints that resolve for this agent, agent-level winning a name collision — and is returned alongside the rows so a client can render columns without a second request.\n\nOffset-paginated rather than cursor-paginated: a cursor cannot express a position in an ordering by an arbitrary extracted column. Capped at 10,000 rows: a `page` whose first row would fall past the cap returns an empty page with `has_more: false`.",
        "operationId": "getAgentAnalysis",
        "tags": [
          "Agents"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Agent id."
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string",
              "default": "created_at"
            },
            "description": "`created_at`, or the name of an extraction field the agent declares. Any other value is a 400 — an ordering we cannot produce is never silently ignored."
          },
          {
            "in": "query",
            "name": "dir",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          },
          {
            "in": "query",
            "name": "filter[FIELD]",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by one declared field, typed by its declaration: exact match for `number`, `boolean` and `enum`; substring match for `string`. A value that cannot be read as the declared type is a 400."
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "gate",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "readiness",
                "all"
              ],
              "default": "live"
            },
            "description": "Production-readiness gate runs are excluded by default — they are not real calls."
          }
        ],
        "responses": {
          "200": {
            "description": "Page of analysed calls",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentAnalysisPage"
                }
              }
            }
          },
          "400": {
            "description": "Unknown sort field, or a filter value that does not match its declared type."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/AgentNotFound"
          }
        }
      }
    },
    "/v1/agents/{id}/analysis.csv": {
      "get": {
        "summary": "Export an agent's post-call analysis as CSV",
        "description": "The same rows as `GET /v1/agents/{id}/analysis`, with the same sort, filters and merged schema, but unpaginated (capped at 10,000 rows). Header columns follow the declared schema order, so two exports of one agent line up column for column even when a call left a field empty.",
        "operationId": "exportAgentAnalysisCsv",
        "tags": [
          "Agents"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Agent id."
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "type": "string",
              "default": "created_at"
            }
          },
          {
            "in": "query",
            "name": "dir",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          },
          {
            "in": "query",
            "name": "filter[FIELD]",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "in": "query",
            "name": "gate",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "readiness",
                "all"
              ],
              "default": "live"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV file",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Unknown sort field, or a filter value that does not match its declared type."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/AgentNotFound"
          }
        }
      }
    },
    "/v1/providers/known": {
      "get": {
        "summary": "List known providers",
        "description": "Returns every (vendor, model) pair the router knows about per pipeline layer, plus one vendor-wildcard row per vendor. The `id` field on each entry is the verbatim string callers put into `allowedProviders` on session create, transcribe, synthesize, complete, or `stackPreferences` on an agent. Use this to populate UI pickers or validate user-supplied allowlists.",
        "operationId": "getKnownProviders",
        "tags": [
          "Providers"
        ],
        "responses": {
          "200": {
            "description": "Per-modality lists of allowlist-eligible entries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnownProviders"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/phone-numbers": {
      "get": {
        "summary": "List phone numbers",
        "description": "Returns managed and customer SIP-trunk phone numbers registered to the authenticated organization.",
