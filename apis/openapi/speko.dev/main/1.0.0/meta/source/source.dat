            "type": "integer"
          },
          "rejected_count": {
            "type": "integer"
          },
          "delivered_count": {
            "type": "integer"
          },
          "failed_count": {
            "type": "integer"
          },
          "canceled_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
