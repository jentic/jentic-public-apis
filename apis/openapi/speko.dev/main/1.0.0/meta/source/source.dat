                  "type": "object",
                  "properties": {
                    "language": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 35
                    },
                    "allowedProviders": {
                      "type": "object",
                      "properties": {
                        "stt": {
                          "maxItems": 8,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "llm": {
                          "maxItems": 8,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "tts": {
                          "maxItems": 8,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "voice": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "systemPrompt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100000
                    }
                  },
                  "required": [
                    "language"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "enabled",
              "languages"
            ],
            "additionalProperties": false
          },
          "outboundFirstMessage": {
            "type": "string",
            "maxLength": 2000,
            "nullable": true,
            "description": "Opening line on outbound calls. Wins over `firstMessage`. A non-empty string is spoken as soon as the call connects. `\"\"` (empty string) means say nothing: the agent listens until the callee speaks. `null` clears a stored value, and a cleared (or never set) value is NOT silence: the call falls back to `firstMessage`, and if that is also unset, to the default greeting for the call language (\"Hi, how can I help?\" in English). Set `\"\"` to open in silence."
          },
          "promptVariables": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[\\w-]+(\\.[\\w-]+)*$"
                },
                "defaultValue": {
                  "type": "string",
                  "maxLength": 1000
                },
                "description": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "runMode": {
            "type": "string",
            "enum": [
              "cascade",
              "s2s"
            ]
          },
          "graphClassifier": {
            "type": "string",
            "enum": [
              "llm",
              "jev",
              "gpt-live"
            ],
            "default": "llm",
            "description": "Which judge answers `llm` edge conditions in graph mode. `llm` (the default) runs a temperature-0 one-shot on this agent's own cascade model. `jev` routes the decision through TypeSafe's System One as a choice over the candidate edges, returning a calibrated confidence per branch. Ignored by agents with no graph. `gpt-live` walks the graph on the agent's own GPT-Live speech-to-speech session; a call that runs on the cascade judges with `llm`. Any failure of the `jev` judge falls back to the `llm` path rather than failing the call."
          },
          "runtime": {
            "type": "string",
            "enum": [
              "livekit",
              "pipecat"
            ],
            "description": "Managed-agent runtime. Omit it: the runtime that actually serves the agent is chosen for the whole organization, and agent responses carry that effective value, never the value sent here. A value sent here is stored on the agent without changing the organization's runtime, and while the stored value is `pipecat`, `runMode: s2s` is refused with `400 INCOMPATIBLE_RUNTIME_MODE` (the `pipecat` runtime runs `runMode: cascade` only)."
          },
          "speechNormalization": {
            "type": "object",
            "properties": {
              "pronunciationDictionary": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "textReplacements": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              }
            },
            "additionalProperties": false
          },
          "sttMissRecovery": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "additionalProperties": false
          },
          "sttOptions": {
            "type": "object",
            "properties": {
              "keywords": {
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "language": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9-]{1,15}$"
              },
              "workload": {
                "type": "string",
                "enum": [
                  "conversation",
                  "transcription",
                  "narration"
                ]
              },
              "diarization": {
                "type": "boolean"
              },
              "speakersExpected": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "smartFormat": {
                "type": "boolean"
              },
              "fillerWords": {
                "type": "boolean"
              },
              "profanityFilter": {
                "type": "boolean"
              },
              "providerOptions": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              }
            },
            "additionalProperties": false
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "ttsOptions": {
            "type": "object",
            "properties": {
              "speed": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2
              },
              "model": {
                "type": "string"
              },
              "workload": {
                "type": "string",
                "enum": [
                  "conversation",
                  "transcription",
                  "narration"
                ]
              },
