              "schema": {
                "$ref": "#/components/schemas/SmsConversationUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated conversation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsConversation"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "SMS"
        ],
        "summary": "Immediately redact conversation content",
        "operationId": "redactSmsConversation",
        "parameters": [
          {
            "$ref": "#/components/parameters/SmsConversationId"
          }
        ],
        "responses": {
          "204": {
            "description": "Content redacted; compliance and billing facts retained"
          }
        }
      }
    },
