    "/v1/sms/consents": {
      "get": {
        "tags": [
          "SMS"
        ],
        "summary": "List SMS consent records",
        "operationId": "listSmsConsents",
        "parameters": [
          {
            "name": "recipient",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "campaign_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "revoked",
                "expired"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consent records",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SmsConsent"
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Pass as `cursor` for the next page. Null on the last page."
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "SMS"
        ],
        "summary": "Record SMS consent",
        "operationId": "createSmsConsent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SmsConsentInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Consent recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SmsConsent"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sms/consents/import": {
      "post": {
        "tags": [
          "SMS"
        ],
        "summary": "Import up to 1,000 consent records",
        "operationId": "importSmsConsents",
        "requestBody": {
          "required": true,
