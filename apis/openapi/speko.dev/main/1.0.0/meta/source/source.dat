                ],
                "properties": {
                  "records": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1000,
                    "items": {
                      "$ref": "#/components/schemas/SmsConsentInput"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Idempotent import result"
          }
        }
      }
    },
    "/v1/sms/consents/{consent_id}/revoke": {
      "post": {
        "tags": [
