    "/v1/sms/messages": {
      "post": {
        "tags": [
          "SMS"
        ],
        "summary": "Queue an SMS message",
        "operationId": "sendSmsMessage",
        "description": "Durably validates compliance and reserves credits before queueing. The campaign and brand are derived from the sender number.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
