      "SingleOrderPayload": {
        "type": "object",
        "required": [
          "pickup",
          "dropoff",
          "customer",
          "description"
        ],
        "properties": {
          "pickup": {
            "$ref": "#/components/schemas/address"
          },
          "dropoff": {
            "$ref": "#/components/schemas/address"
          },
          "buyer": {
            "type": "object",
            "required": [
              "phone"
            ],
            "properties": {
              "phone": {
                "type": "string"
              },
              "full_name": {
                "type": "string"
              }
            }
          },
          "store": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              }
            }
          },
          "shipment_value": {
            "type": "number"
          },
          "partner_order_id": {
            "type": "number"
          },
          "description": {
            "type": "string"
          },
          "pickup_type": {
            "type": "string",
            "description": "Pickup type for the order (optional):\n- buyer_pickup = courier picks up from customer, delivers to store (reverse logistics)\n- shop_pickup = courier picks up from store, delivers to customer (default)\n\nDefaults to shop_pickup if not provided.\n",
            "enum": [
              "buyer_pickup",
              "shop_pickup"
            ],
            "example": "shop_pickup"
          },
          "national_saudi_short_code": {
            "type": "string",
            "maxLength": 8,
            "description": "Saudi national address short code (8 characters).\nOptional field for Saudi Arabia addresses.\n",
            "example": "RANB6767"
          },
          "full_address": {
            "type": "string",
            "maxLength": 512,
            "description": "Full address text corresponding to the national_saudi_short_code.\nOptional field for Saudi Arabia addresses.\n",
            "example": "675 KING JAMIL RD."
          }
        }
      },
