                ],
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "full_name": {
                    "type": "string"
                  }
                }
              },
              "shipment_value": {
                "type": "number"
              },
              "partner_order_id": {
                "type": "number"
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      },
