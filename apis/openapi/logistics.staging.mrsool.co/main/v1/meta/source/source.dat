{
  "openapi": "3.0.1",
  "meta": {
    "doc": "laas"
  },
  "info": {
    "title": "LAAS API V1",
    "version": "v1",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/wemaxdevs/laas-api-v1/v1"
  },
  "produces": "application/json",
  "paths": {
    "/api/v1/orders/{order_id}/cancel": {
      "post": {
        "summary": "order",
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "header",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ar"
              ]
            }
          },
          {
            "name": "order_id",
            "in": "path",
            "schema": {
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "order canceled",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/OrderSerializer"
                    },
                    {
                      "$ref": "#/components/schemas/SubOrderSerializer"
                    },
                    {
                      "$ref": "#/components/schemas/StackedOrderSerializer"
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "order not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/FailureSerializer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized"
          }
        }
      }
    },
    "/api/v1/orders/{order_id}/air_waybill": {
      "get": {
        "summary": "Get air waybill",
        "description": "Retrieves the air waybill (AWB) URL for a specific order.\nThe air waybill is a PDF document that contains shipping information.\nIf the AWB has been generated before, a cached URL is returned.\nOtherwise, a new AWB is generated and attached to the order.\n",
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "header",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ar"
              ]
            },
            "description": "Preferred language for response messages"
          },
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The ID of the order to retrieve the air waybill for"
          }
        ],
        "responses": {
          "200": {
            "description": "Air waybill URL retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "string",
                      "format": "uri",
                      "description": "URL to the air waybill PDF document",
                      "example": "https://example.com/awb-12345.pdf"
                    }
                  }
                },
                "examples": {
                  "success": {
                    "summary": "Successful response",
                    "description": "Air waybill URL returned",
                    "value": {
                      "data": "https://example.com/awb-12345.pdf"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Order not found or laas_order_detail not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "message",
                          "path",
                          "predicate"
                        ],
                        "properties": {
                          "message": {
                            "type": "string",
                            "example": "Order not found"
                          },
                          "path": {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "integer"
                                }
                              ]
                            },
                            "example": []
                          },
                          "predicate": {
                            "type": "string",
                            "nullable": true
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "order_not_found": {
                    "summary": "Order not found",
                    "value": {
                      "errors": [
                        {
                          "message": "Order not found",
                          "path": [],
                          "predicate": null
                        }
                      ]
                    }
                  },
                  "laas_order_detail_not_found": {
                    "summary": "LAAS order detail not found",
                    "value": {
                      "errors": [
                        {
                          "message": "LAAS order detail not found",
                          "path": [],
                          "predicate": null
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadCredentialsSerializer"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{order_id}": {
      "get": {
        "summary": "order",
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "header",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ar"
              ]
            }
          },
          {
            "name": "order_id",
            "in": "path",
            "schema": {
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "order found",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/OrderSerializer"
                    },
                    {
                      "$ref": "#/components/schemas/SubOrderSerializer"
                    },
                    {
                      "$ref": "#/components/schemas/StackedOrderSerializer"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "order not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/FailureSerializer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized"
          }
        }
      }
    },
    "/api/v1/orders": {
      "post": {
        "summary": "creates order",
        "description": "⚠️ **Deprecated:** Stacked order creation is deprecated and will be removed in a future release.\nPlease use `/laas/api/v1/orders/bulk` for atomic bulk order creation.\n",
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "header",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ar"
              ]
            }
          }
        ],
        "responses": {
          "422": {
            "description": "invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureSerializer"
                }
              }
            }
          },
          "201": {
            "description": "Supports Optional Store detail params",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/OrderSerializer"
                        },
                        {
                          "$ref": "#/components/schemas/StackedOrderSerializer"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadCredentialsSerializer"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/SingleOrderPayload"
                  },
                  {
                    "$ref": "#/components/schemas/StackedOrderPayload"
                  }
                ]
              },
              "examples": {
                "SingleOrderExample": {
                  "$ref": "#/components/examples/SingleOrderExample"
                },
                "StackedOrderExample": {
                  "$ref": "#/components/examples/StackedOrderExample"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/calculate_price": {
      "post": {
        "summary": "calculate price",
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "header",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ar"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "price calculated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureSerializer"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadCredentialsSerializer"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "pickup",
                  "dropoff"
                ],
                "properties": {
                  "pickup": {
                    "type": "object",
                    "required": [
                      "latitude",
                      "longitude"
                    ],
                    "properties": {
                      "latitude": {
                        "type": "string"
                      },
                      "longitude": {
                        "type": "string"
                      }
                    }
                  },
                  "dropoff": {
                    "type": "object",
                    "required": [
                      "latitude",
                      "longitude"
                    ],
                    "properties": {
                      "latitude": {
                        "type": "string"
                      },
                      "longitude": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/bulk": {
      "post": {
        "summary": "Create multiple orders",
        "description": "Create multiple orders. All orders will be created or none will be created.\nIf any order is invalid or fails, no orders will be created and an error will be returned.\n",
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "header",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ar"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/SingleOrderPayload"
                }
              },
              "examples": {
                "BulkOrderExample": {
                  "value": [
                    {
                      "pickup": {
                        "latitude": "24.7136",
                        "longitude": "46.6753"
                      },
                      "dropoff": {
                        "latitude": "24.7743",
                        "longitude": "46.7386"
                      },
                      "buyer": {
                        "phone": "0500000000",
                        "full_name": "John Doe"
                      },
                      "store": {
                        "name": "Store A",
                        "phone": "0111111111"
                      },
                      "shipment_value": 100,
                      "partner_order_id": "A123",
                      "description": "Order 1",
                      "pickup_type": "shop_pickup",
                      "national_saudi_short_code": "RANB6767",
                      "full_address": "675 KING JAMIL RD."
                    },
                    {
                      "pickup": {
                        "latitude": "24.7136",
                        "longitude": "46.6753"
                      },
                      "dropoff": {
                        "latitude": "24.7743",
                        "longitude": "46.7386"
                      },
                      "buyer": {
                        "phone": "0500000001",
                        "full_name": "Jane Smith"
                      },
                      "store": {
                        "name": "Store B",
                        "phone": "0222222222"
                      },
                      "shipment_value": 200,
                      "partner_order_id": "B456",
                      "description": "Order 2",
                      "national_saudi_short_code": "RANB6767",
                      "full_address": "675 KING JAMIL RD."
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderSerializer"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid input or atomicity failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureSerializer"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadCredentialsSerializer"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{order_id}/test_status": {
      "post": {
        "summary": "Change order status for testing",
        "description": "Changes the order status for testing purposes and triggers real webhooks.\nThis endpoint performs actual status updates on the order and notifies configured webhook endpoints.\n\n**Valid Status Transitions:**\n- `COURIER_PENDING` → Waiting for courier assignment\n- `COURIER_ASSIGNED` → Courier has been assigned\n- `COURIER_REASSIGNED` → Courier has been reassigned\n- `PICKUP_ARRIVED` → Courier has arrived at pickup location\n- `COLLECTING` → Courier is collecting the package\n- `CONFIRMED_PICKUP` → Package pickup has been confirmed\n- `WAITING_FOR_DELIVERY` → Waiting for delivery to start\n- `DELIVERING` → Courier is delivering the package\n- `DROPOFF_ARRIVED` → Courier has arrived at dropoff location\n- `PARTIALLY_DELIVERED` → Order has been partially delivered\n- `DELIVERED` → Order has been successfully delivered\n- `RETURN` → Order is being returned to pickup location\n- `CANCELED` → Order has been canceled\n- `EXPIRED` → Order has expired\n",
        "tags": [
          "Testing"
        ],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "The ID of the order to update"
            }
          },
          {
            "name": "locale",
            "in": "header",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ar"
              ],
              "description": "Preferred language for response messages"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "COURIER_PENDING",
                      "COURIER_ASSIGNED",
                      "COURIER_REASSIGNED",
                      "PICKUP_ARRIVED",
                      "COLLECTING",
                      "CONFIRMED_PICKUP",
                      "WAITING_FOR_DELIVERY",
                      "DELIVERING",
                      "DROPOFF_ARRIVED",
                      "PARTIALLY_DELIVERED",
                      "DELIVERED",
                      "RETURN",
                      "CANCELED",
                      "EXPIRED"
                    ],
                    "description": "New LAAS order status to set"
                  }
                }
              },
              "examples": {
                "test_collecting": {
                  "summary": "Start collecting",
                  "description": "Change status to collecting (courier picks up package)",
                  "value": {
                    "status": "COLLECTING"
                  }
                },
                "test_delivering": {
                  "summary": "Start delivering",
                  "description": "Change status to delivering (courier en route to customer)",
                  "value": {
                    "status": "DELIVERING"
                  }
                },
                "test_delivered": {
                  "summary": "Complete delivery",
                  "description": "Mark order as successfully delivered",
                  "value": {
                    "status": "DELIVERED"
                  }
                },
                "test_canceled": {
                  "summary": "Cancel order",
                  "description": "Mark order as canceled",
                  "value": {
                    "status": "CANCELED"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "success",
                        "message",
                        "order",
                        "next_actions"
                      ],
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": true,
                          "description": "Indicates if the operation was successful"
                        },
                        "message": {
                          "type": "string",
                          "example": "Order status changed successfully. Webhooks have been triggered.",
                          "description": "Human-readable success message"
                        },
                        "order": {
                          "$ref": "#/components/schemas/OrderSerializer",
                          "description": "Complete order object with updated status"
                        },
                        "next_actions": {
                          "type": "array",
                          "description": "Available next status transitions",
                          "items": {
                            "type": "object",
                            "required": [
                              "action",
                              "description"
                            ],
                            "properties": {
                              "action": {
                                "type": "string",
                                "example": "DELIVERED",
                                "description": "Next available LAAS status"
                              },
                              "description": {
                                "type": "string",
                                "example": "Complete delivery",
                                "description": "Human-readable description of the action"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid status or validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureSerializer"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureSerializer"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadCredentialsSerializer"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/webhook_logs": {
      "get": {
        "summary": "Get webhook delivery logs",
        "description": "Retrieves all webhook delivery logs for the merchant's shop.\nThis endpoint returns the complete history of webhook attempts, including successful deliveries,\nfailed attempts, and retry information. Useful for debugging webhook integration issues.\n",
        "tags": [
          "Testing"
        ],
        "parameters": [
          {
            "name": "locale",
            "in": "header",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ar"
              ],
              "description": "Preferred language for response messages"
            }
          },
          {
            "name": "order_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "Filter webhook logs by specific order ID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook logs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "success",
                        "shop_id",
                        "total_logs",
                        "logs"
                      ],
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": true,
                          "description": "Indicates if the operation was successful"
                        },
                        "shop_id": {
                          "type": "integer",
                          "example": 12345,
                          "description": "The shop ID that owns these webhook logs"
                        },
                        "total_logs": {
                          "type": "integer",
                          "example": 5,
                          "description": "Total number of webhook logs returned"
                        },
                        "filtered_by_order_id": {
                          "type": "integer",
                          "nullable": true,
                          "example": 123,
                          "description": "Order ID used for filtering (null if no filter applied)"
                        },
                        "logs": {
                          "type": "array",
                          "description": "Array of webhook log entries",
                          "items": {
                            "type": "object",
                            "required": [
                              "id",
                              "request_url",
                              "request_body",
                              "response_body",
                              "response_status",
                              "created_at"
                            ],
                            "properties": {
                              "id": {
                                "type": "integer",
                                "example": 123,
                                "description": "Unique webhook log ID"
                              },
                              "request_url": {
                                "type": "string",
                                "example": "https://merchant.example.com/webhooks/laas",
                                "description": "URL where the webhook was sent"
                              },
                              "request_body": {
                                "type": "string",
                                "example": "{\"id\": 789, \"status\": \"DELIVERED\", \"created_at\": \"2024-01-15T10:30:00Z\"}",
                                "description": "JSON payload sent in the webhook request"
                              },
                              "response_body": {
                                "type": "string",
                                "example": "{\"received\": true}",
                                "nullable": true,
                                "description": "Response body from the webhook endpoint"
                              },
                              "response_status": {
                                "type": "integer",
                                "example": 200,
                                "nullable": true,
                                "description": "HTTP status code returned by the webhook endpoint"
                              },
                              "created_at": {
                                "type": "string",
                                "format": "date-time",
                                "example": "2024-01-15T10:30:00Z",
                                "description": "When the webhook was sent"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "successful_logs": {
                    "summary": "Successful webhook logs",
                    "description": "Example of webhook logs with successful deliveries",
                    "value": {
                      "data": {
                        "success": true,
                        "shop_id": 12345,
                        "total_logs": 2,
                        "logs": [
                          {
                            "id": 101,
                            "request_url": "https://merchant.example.com/webhooks/laas",
                            "request_body": "{\"id\": 789, \"status\": \"DELIVERED\", \"created_at\": \"2024-01-15T10:30:00Z\"}",
                            "response_body": "{\"received\": true}",
                            "response_status": 200,
                            "created_at": "2024-01-15T10:30:00Z"
                          },
                          {
                            "id": 102,
                            "request_url": "https://merchant.example.com/webhooks/laas",
                            "request_body": "{\"id\": 790, \"status\": \"COLLECTING\", \"created_at\": \"2024-01-15T11:00:00Z\"}",
                            "response_body": "{\"received\": true}",
                            "response_status": 200,
                            "created_at": "2024-01-15T11:00:00Z"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailureSerializer"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadCredentialsSerializer"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer_auth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "BadCredentialsSerializer": {
        "type": "object",
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "message",
                "path",
                "predicate"
              ],
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Bad Credentials"
                },
                "path": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  },
                  "example": []
                },
                "predicate": {
                  "type": "string",
                  "example": "bad_credentials",
                  "nullable": true
                }
              }
            }
          }
        }
      },
      "FailureSerializer": {
        "type": "object",
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "message",
                "path",
                "predicate"
              ],
