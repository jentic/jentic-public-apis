          "description": {
            "type": "string"
          },
          "shipment_value": {
            "type": "number",
            "nullable": true
          },
          "partner_order_id": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "COURIER_PENDING",
              "COURIER_ASSIGNED",
              "COURIER_REASSIGNED",
