uspended"]},"plan":{"type":"string","enum":["launch","growth","scale"]},"subscriptionStatus":{"type":"string"},"billingProvider":{"anyOf":[{"type":"string","enum":["lemonsqueezy","paddle"]},{"type":"null"}]},"billingPeriodStart":{"anyOf":[{"type":"string","format":"date-time","description":"Current period start."},{"type":"null"}]},"billingPeriodEnd":{"anyOf":[{"type":"string","format":"date-time","description":"Current period end."},{"type":"null"}]},"subscriptionEndsAt":{"anyOf":[{"type":"string","format":"date-time","description":"Scheduled end of the subscription."},{"type":"null"}]},"createdAt":{"type":"string","format":"date-time","description":"Creation time."},"updatedAt":{"type":"string","format":"date-time","description":"Last update."}},"required":["id","name","email","status","plan","subscriptionStatus","billingProvider","billingPeriodStart","billingPeriodEnd","subscriptionEndsAt","createdAt","updatedAt"]},"billingCycle":{"anyOf":[{"type":"string","enum":["monthly","annual"]},{"type":"null"}]},"sandbox":{"type":"boolean","description":"True for a free sandbox workspace: one built-in connection, a one-off allowance, no subscription."},"processing":{"type":"object","properties":{"status":{"type":"string","enum":["available","paused"]},"remainingPercent":{"type":"number"},"usedPercent":{"type":"number"},"resetsAt":{"anyOf":[{"type":"string","format":"date-time","description":"Next processing limit reset."},{"type":"null"}]},"overageCharges":{"type":"boolean","const":false}},"required":["status","remainingPercent","usedPercent","resetsAt","overageCharges"]},"plan":{"type":"object","properties":{"monthlyPriceUsd":{"type":"number"},"annualPriceUsd":{"type":"number"},"maxConnections":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"reportStorageBytes":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}},"required":["monthlyPriceUsd","annualPriceUsd","maxConnections","reportStorageBytes"]},"storage":{"type":"object