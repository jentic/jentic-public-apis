query","name":"end_date","required":false,"description":"Only days on or before this date (UTC). Format: YYYY-MM-DD."},{"schema":{"type":"integer","default":1},"in":"path","name":"id","required":true,"description":"The MAL Anime ID"}],"responses":{"200":{"description":"Successful response returning the anime's statistics history","content":{"application/json":{"schema":{"description":"Successful response returning the anime's statistics history","type":"object","properties":{"pagination":{"type":"object","properties":{"last_visible_page":{"type":"integer"},"has_next_page":{"type":"boolean"}},"required":["last_visible_page","has_next_page"]},"data":{"type":"array","items":{"type":"object","properties":{"date":{"type":"string","description":"Day of the record (UTC), YYYY-MM-DD"},"score":{"type":"number","nullable":true,"description":"Score that day. Null while MyAnimeList shows no score."},"scored_by":{"type":"integer","nullable":true,"description":"Number of users who scored it that day"},"rank":{"type":"integer","nullable":true,"description":"Rank that day. Null while it is unranked."},"popularity":{"type":"integer","nullable":true,"description":"Popularity rank that day"},"members":{"type":"integer","nullable":true,"description":"Members that day"},"favorites":{"type":"integer","nullable":true,"description":"Favorites that day"},"statistics":{"type":"object","nullable":true,"description":"The statistics page of that day, in the shape of /anime/{id}/statistics. Null on a day without a read.","properties":{"watching":{"type":"integer"},"completed":{"type":"integer"},"on_hold":{"type":"integer"},"dropped":{"type":"integer"},"plan_to_watch":{"type":"integer"},"total":{"type":"integer"},"scores":{"type":"array","items":{"type":"object","properties":{"score":{"type":"integer"},"votes":{"type":"integer"},"percentage":{"type":"number"}}}}}}}}}},"example":{"pagination":{"last_visible_page":9,"has_next_page":true},"data":[{"date":"2026-10-15","score":8.75,"scored_by":1078526