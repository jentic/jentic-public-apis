":[{"mal_id":45383,"url":"https://myanimelist.net/manga/45383/Crepuscule_Yamachi","images":{"jpg":{"image_url":"https://cdn.myanimelist.net/images/manga/2/80151.jpg","small_image_url":"https://cdn.myanimelist.net/images/manga/2/80151t.jpg","large_image_url":"https://cdn.myanimelist.net/images/manga/2/80151l.jpg"},"webp":{"image_url":"https://cdn.myanimelist.net/images/manga/2/80151.webp","small_image_url":"https://cdn.myanimelist.net/images/manga/2/80151t.webp","large_image_url":"https://cdn.myanimelist.net/images/manga/2/80151l.webp"}},"approved":false,"titles":[{"type":"Default","title":"Crepuscule (Yamachi)"},{"type":"Japanese","title":"크리퍼스큘 (밀치 / 얌치)"},{"type":"Synonym","title":"Crepuscule (Mirchi)"},{"type":"Synonym","title":"Crepuscule (Yamchi/Mirchi)"}],"title":"Crepuscule (Yamachi)","title_english":"","title_japanese":"크리퍼스큘 (밀치 / 얌치)","title_synonyms":["Crepuscule (Mirchi)","Crepuscule (Yamchi/Mirchi)"],"type":"Manga","chapters":null,"volumes":null,"status":"Publishing","publishing":true,"published":{"from":"2011-02-11T00:00:00+00:00","to":null,"prop":{"from":{"day":11,"month":2,"year":2011},"to":{"day":null,"month":null,"year":null}},"string":"Feb 11, 2011"},"score":null,"scored_by":33,"rank":0,"popularity":0,"members":120,"favorites":null,"synopsis":"Crepuscule is a Korean Webtoon from Naver. It is written by Mirchi and the art is done by Yamchi.\nLark is different from the rest of the kids. He has red eyes and he is bullied by the other kids for that. One day he meets Setz, a genuine vampire of a noble clan, who is the only one who doesn't call him a monster. Eventually, they become friends, but when an incident happens, Setz doesn't want to lose a friend, so he invites Lark to his home... The world of Vampires....\n\nThere are two Webtoons released. The first one was discontinued and the artist restarted the story with a new author, with a few changes in the storyline.\n(http://crepuscule.wikia.com/wiki/Crepuscule_Wiki)","background":null,"authors":[],