            "style": "form",
            "explode": true,
            "description": "Whole-word match on normalized brand, firm, or product text. Repeatable."
          },
          {
            "name": "company",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Company slug or name (firm, else brand)."
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Free text over product, reason, firm (web search syntax)."
          },
          {
            "name": "agency",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "fda_food",
                "fda_drug",
                "fda_device",
                "fsis",
                "cpsc"
              ]
            }
          },
          {
            "name": "class",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "I",
                  "II",
                  "III",
                  "PHA"
                ]
              }
            },
            "style": "form",
            "explode": true,
            "description": "Rows without a class (CPSC) always match."
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ongoing",
                "terminated",
                "completed",
                "unknown"
              ]
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Ongoing, or unknown for agencies without lifecycle status."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "next_cursor from the previous page."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          }
        ],
        "security": [
          {
            "apiKey": []
          },
          {
            "x402": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecallList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unknown or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Payment required. PAYMENT-REQUIRED header (x402 v2) plus api_key hints in the body."
          },
          "403": {
            "description": "Plan inactive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/export": {
      "get": {
        "summary": "Bulk NDJSON export ordered by updated_at (API key only)",
        "description": "One recall per line. Omit since for full history. Continue with the X-Next-Cursor header value (also in Link rel=next) until it is absent. Metered on rows returned.",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 10000
            }
          }
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "NDJSON",
            "content": {
              "application/x-ndjson": {}
            }
          },
          "401": {
            "description": "API key required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Plan inactive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
