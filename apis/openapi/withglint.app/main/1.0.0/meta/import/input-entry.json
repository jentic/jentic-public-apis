  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "rk_… key from /account. Metered per request plus rows returned."
      },
      "x402": {
        "type": "apiKey",
        "in": "header",
        "name": "PAYMENT-SIGNATURE",
        "description": "x402 v2 payment payload, base64 JSON. exact for single recalls, upto for lists."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Meta": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "disclaimer": {
            "type": "string"
          },
          "freshness_url": {
            "type": "string"
          }
        }
      },
      "Recall": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "company_slug": {
            "type": [
              "string",
              "null"
            ]
          },
          "agency": {
            "type": "string"
          },
          "official_id": {
            "type": "string"
          },
          "class": {
            "type": [
              "string",
              "null"
            ]
          },
          "product_raw": {
            "type": "string"
          },
          "brand_norm": {
            "type": [
              "string",
              "null"
            ]
          },
          "firm_norm": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "initiated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "geography": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            }
          },
          "source_url": {
            "type": "string",
            "description": "The official agency notice. Authoritative."
          },
          "url": {
            "type": "string"
          },
          "company_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "transform_version": {
            "type": "string"
          },
          "first_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "ingested_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RecallList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Recall"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "Watchlist": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "brands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "channels": {
            "type": "object",
            "properties": {
              "email": {
                "type": "object",
                "properties": {
                  "to": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "email"
                    }
                  }
                }
              },
              "telegram": {
                "type": "object",
                "properties": {
                  "chat_id": {
                    "type": "string"
                  }
                },
                "description": "Set by the Telegram link flow on /account."
              },
              "discord": {
                "type": "object",
                "properties": {
                  "webhook_url": {
                    "type": "string",
                    "pattern": "^https://discord.com/api/webhooks/"
                  }
                }
              },
              "slack": {
                "type": "object",
                "properties": {
                  "webhook_url": {
                    "type": "string",
                    "pattern": "^https://hooks.slack.com/services/"
                  }
                }
              }
            }
          },
          "muted": {
            "type": "boolean"
          },
          "cursor_at": {
            "type": "string",
