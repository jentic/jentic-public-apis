          },
          "402": {
            "description": "Payment required. PAYMENT-REQUIRED header (x402 v2) plus api_key hints in the body."
          },
          "403": {
            "description": "Plan inactive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/diff": {
      "get": {
        "summary": "Rows created or updated in (since, now], oldest change first",
        "description": "Each row carries change = created | updated. meta.until is the upper bound: pass it as the next since. A truncated window continues with next_cursor. x402 scheme exact (fixed price per call). API key: metered max(40, rows) row units.",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "brand",
            "in": "query",
