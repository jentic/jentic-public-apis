{
  "openapi": "3.1.0",
  "info": {
    "title": "RecallRadar API",
    "version": "1.0.0",
    "description": "US product recalls from FDA, USDA FSIS, and CPSC in one schema. RecallRadar indexes public recall notices from the FDA, USDA FSIS, and CPSC. The official agency notice is the authoritative source. Always confirm details at the linked source before acting. Every row's source_url is the authoritative notice.",
    "x-jentic-source-url": "https://recallradar.withglint.app/v1/openapi.json"
  },
  "servers": [
    {
      "url": "https://recallradar.withglint.app"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Readiness: DB reachable, and which surfaces are enabled",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Database unreachable"
          }
        }
      }
    },
    "/v1/freshness": {
      "get": {
        "summary": "Per-agency counts, newest dates, last successful run, alerts",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "summary": "This document",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/agencies": {
      "get": {
        "summary": "Agencies indexed and what each covers",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/recalls": {
      "get": {
        "summary": "Search recalls, newest published first",
        "description": "x402 scheme upto: cap = base + limit × row price, settled on rows returned. API key: metered max(40, rows) row units.",
        "parameters": [
          {
            "name": "brand",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": true,
            "description": "Whole-word match on normalized brand, firm, or product text. Repeatable."
          },
          {
            "name": "company",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Company slug or name (firm, else brand)."
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Free text over product, reason, firm (web search syntax)."
          },
          {
            "name": "agency",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "fda_food",
                "fda_drug",
                "fda_device",
                "fsis",
                "cpsc"
              ]
            }
          },
          {
            "name": "class",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "I",
                  "II",
                  "III",
                  "PHA"
                ]
              }
            },
            "style": "form",
            "explode": true,
            "description": "Rows without a class (CPSC) always match."
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ongoing",
                "terminated",
                "completed",
                "unknown"
              ]
            }
          },
          {
            "name": "active",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Ongoing, or unknown for agencies without lifecycle status."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "next_cursor from the previous page."
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "published_at >= since"
          },
          {
            "name": "until",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "published_at <= until"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          }
        ],
        "security": [
          {
            "apiKey": []
          },
          {
            "x402": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecallList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid filter or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unknown or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Payment required. PAYMENT-REQUIRED header (x402 v2) plus api_key hints in the body."
          },
          "403": {
            "description": "Plan inactive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/recalls/{id}": {
      "get": {
        "summary": "One recall with raw_payload and status_history",
        "description": "id is the 32-hex id or the page slug. x402 scheme exact.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "apiKey": []
          },
          {
            "x402": []
