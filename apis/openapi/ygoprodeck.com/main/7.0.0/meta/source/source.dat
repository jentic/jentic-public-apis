{
  "openapi": "3.0.3",
  "info": {
    "title": "YGOPRODeck Yu-Gi-Oh! Card Database API",
    "description": "Public API for accessing the Yu-Gi-Oh! card database, including card information, card sets, archetypes, and card images. Rate limited to 20 requests per second.",
    "version": "7.0.0",
    "x-jentic-source-url": "https://ygoprodeck.com/api-guide/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://db.ygoprodeck.com/api/v7",
      "description": "YGOPRODeck API v7"
    }
  ],
  "paths": {
    "/cardinfo.php": {
      "get": {
        "operationId": "getCardInfo",
        "summary": "Get Yu-Gi-Oh! card information",
        "description": "Search and retrieve card data with extensive filtering options. Returns card details including name, type, stats, sets, images, and prices.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Exact card name"
          },
          {
            "name": "fname",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Fuzzy card name search"
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Card ID (Passcode)"
          },
          {
            "name": "konami_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Konami official card ID"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Card type (e.g., Effect Monster, Spell Card, Trap Card)"
          },
          {
            "name": "atk",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ATK value or range (e.g., 2500 or gte2500)"
          },
          {
            "name": "def",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "DEF value or range"
          },
          {
            "name": "level",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Level/Rank value or range"
          },
          {
            "name": "race",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Monster race/type (e.g., Dragon, Warrior, Spellcaster)"
          },
          {
            "name": "attribute",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Monster attribute (DARK, LIGHT, EARTH, WATER, FIRE, WIND, DIVINE)"
          },
          {
            "name": "link",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Link rating value"
          },
          {
            "name": "linkmarker",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Link markers (e.g., Top, Bottom, Left, Right)"
          },
          {
            "name": "scale",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Pendulum scale value"
          },
          {
            "name": "cardset",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Card set name"
          },
          {
            "name": "archetype",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Archetype name"
          },
          {
            "name": "banlist",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Banlist filter (TCG, OCG, Goat)"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sort order (atk, def, name, type, level, id, new)"
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Game format filter (e.g., tcg, ocg, goat, speed duel)"
          },
          {
            "name": "misc",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "yes"
              ]
            },
            "description": "Include misc info (e.g., views, release dates, ban statuses)"
          },
          {
            "name": "staple",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "yes"
              ]
            },
            "description": "Filter for staple cards"
          },
          {
            "name": "has_effect",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "yes"
              ]
            },
            "description": "Filter for cards with effects"
          },
          {
            "name": "startdate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Start date filter (MM/DD/YYYY)"
          },
          {
            "name": "enddate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "End date filter (MM/DD/YYYY)"
          },
          {
            "name": "dateregion",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Date region for filtering (tcg_date or ocg_date)"
          },
          {
            "name": "language",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Language for card names (e.g., fr, de, it, pt)"
          },
          {
            "name": "num",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Number of results to return (pagination)"
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Offset for pagination"
          }
        ],
        "responses": {
          "200": {
            "description": "Card information results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "name": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "desc": {
                            "type": "string"
                          },
                          "atk": {
                            "type": "integer"
                          },
                          "def": {
                            "type": "integer"
                          },
                          "level": {
                            "type": "integer"
                          },
                          "race": {
                            "type": "string"
                          },
                          "attribute": {
                            "type": "string"
                          },
                          "card_sets": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "card_images": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "card_prices": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request or no cards found matching criteria"
          }
        }
      }
    },
    "/randomcard.php": {
      "get": {
        "operationId": "getRandomCard",
        "summary": "Get a random Yu-Gi-Oh! card",
        "description": "Returns a single random card from the database. Does not accept any query parameters.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Random card data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cardsets.php": {
      "get": {
        "operationId": "getAllCardSets",
        "summary": "Get all Yu-Gi-Oh! card sets",
        "description": "Returns a list of all card sets in the database. Does not accept any query parameters.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of all card sets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "set_name": {
                        "type": "string"
                      },
                      "set_code": {
                        "type": "string"
                      },
                      "num_of_cards": {
                        "type": "integer"
                      },
                      "tcg_date": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cardsetsinfo.php": {
      "get": {
        "operationId": "getCardSetInfo",
        "summary": "Get info for a specific card set",
        "description": "Returns detailed information about a specific card set by set code.",
        "parameters": [
          {
            "name": "setcode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The set code to look up (e.g., SDY-046)"
          }
        ],
        "responses": {
          "200": {
            "description": "Card set information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "set_name": {
                      "type": "string"
                    },
                    "set_code": {
                      "type": "string"
                    },
                    "num_of_cards": {
                      "type": "integer"
                    },
                    "tcg_date": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid set code"
          }
        }
      }
    },
    "/archetypes.php": {
      "get": {
        "operationId": "getAllArchetypes",
        "summary": "Get all Yu-Gi-Oh! archetypes",
        "description": "Returns a list of all card archetypes in the database. Does not accept any query parameters.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of all archetypes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "archetype_name": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/checkDBVer.php": {
      "get": {
        "operationId": "checkDatabaseVersion",
        "summary": "Check the database version",
        "description": "Returns the current version of the card database and the last update date.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Database version information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "database_version": {
                        "type": "string"
                      },
                      "last_update": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "Cards",
      "description": "Card data operations"
    },
    {
      "name": "Sets",
      "description": "Card set operations"
    }
  ]
}
