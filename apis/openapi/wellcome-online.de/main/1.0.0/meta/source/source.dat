{
  "openapi": "3.1.0",
  "info": {
    "title": "Wellcome Backend API",
    "version": "1.0.0",
    "description": "Consolidated API contracts for Chat Service, Voice Gateway, and Local Services.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/thinkit-1cd/Wellcome-Online-backend/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.wellcome-online.de",
      "description": "Production API Gateway"
    }
  ],
  "security": [
    {
      "CognitoAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "CognitoAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "SSEEnvelope": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "ConverseMessage": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "system"
            ]
          },
          "content": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ConverseRequest": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConverseMessage"
            }
          },
          "includeKnowledgeRetrieval": {
            "type": "boolean"
          },
          "maxTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "userZipcode": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "sessionId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "messages"
        ]
      },
      "DatasetCreateRequest": {
        "type": "object",
        "properties": {
          "datasetName": {
            "type": "string"
          },
          "datasetDescription": {
            "type": "string"
          },
          "projectName": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "datasetName",
          "projectName"
        ]
      },
      "DatasetCreateResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "datasetId": {
            "type": "string"
          },
          "exampleCount": {
            "type": "integer"
          },
          "newExamplesAdded": {
            "type": "integer"
          },
          "isNewDataset": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "RunExperimentRequest": {
        "type": "object",
        "properties": {
          "datasetId": {
            "type": "string"
          },
          "stagingPrompt": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              }
            }
          },
          "productionPrompt": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              }
            }
          },
          "modelId": {
            "type": "string"
          },
          "temperature": {
            "type": "number"
          },
          "maxTokens": {
            "type": "integer"
          }
        },
        "required": [
          "datasetId",
          "stagingPrompt",
          "productionPrompt"
        ]
      },
      "RunExperimentResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "stagingExperimentId": {
            "type": "string"
          },
          "productionExperimentId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "EvaluateExperimentRequest": {
        "type": "object",
        "properties": {
          "experimentId": {
            "type": "string"
          },
          "evaluatorNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "experimentId",
          "evaluatorNames"
        ]
      },
      "GenericSuccess": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "MetricsRequest": {
        "type": "object",
        "properties": {
          "projectName": {
            "type": "string"
          },
          "hours": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "projectName"
        ]
      },
      "MetricsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "timeWindow": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "LocalServicesQuery": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "enum": [
              "berlin",
              "hamburg",
              "bremen"
            ]
          },
          "serviceType": {
            "type": "string"
          },
          "zipcode": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "radiusMeters": {
            "type": "integer",
            "minimum": 1
          },
          "maxResults": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "city",
          "serviceType"
        ]
      },
      "Coordinates": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        }
      },
      "Contact": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "openingHours": {
            "type": "string"
          }
        }
      },
      "LocalService": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "serviceType": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "coordinates": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "contact": {
            "$ref": "#/components/schemas/Contact"
          },
          "distanceFromCityCenter": {
            "type": "integer"
          },
          "city": {
            "type": "string"
          }
        }
      },
      "LocalServicesResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "count": {
            "type": "integer"
          },
          "searchParams": {
            "$ref": "#/components/schemas/LocalServicesQuery"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocalService"
            }
          }
        }
      },
      "OSMSearchRequest": {
        "type": "object",
        "properties": {
          "zipcode": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "categories": {
            "type": "string",
            "description": "comma-separated categories"
          }
        },
        "required": [
          "zipcode",
          "categories"
        ]
      },
      "OSMSearchResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "zipcode": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "city": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocalService"
            }
          }
        }
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "s3Key": {
            "type": "string"
          },
          "s3Bucket": {
            "type": "string"
          },
          "fileSize": {
            "type": "integer"
          },
          "contentType": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "uploaded",
              "ingesting",
              "published",
              "failed"
            ]
          },
          "syncStatus": {
            "type": "string",
            "enum": [
              "pending",
              "synced",
              "failed"
            ]
          },
          "uploadedBy": {
            "type": "string"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "tags": {
            "description": "Structured metadata stored as JSON",
            "type": "object",
            "additionalProperties": true
          },
          "bedrockDataSourceId": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSyncedAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UploadRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "keyPrefix": {
            "type": "string",
            "enum": [
              "structured_documents_en",
              "structured_documents_de"
            ]
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "description": "Array of tag strings (e.g., 'main_primary:xyz')",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "autoPublish": {
            "type": "boolean"
          },
          "size": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "contentType",
          "tags"
        ]
      },
      "UploadResponse": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "documentId": {
            "type": "string"
          },
          "document": {
            "$ref": "#/components/schemas/Document"
          }
        }
      },
      "PublishResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "s3Key": {
            "type": "string"
          }
        }
      },
      "IngestJobRequest": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          }
        },
        "required": [
          "documentId"
        ]
      },
      "IngestJobResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "documentDetail": {
            "description": "Bedrock ingestion job details",
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "paths": {
    "/converse": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Converse via Bedrock with optional knowledge retrieval",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConverseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-sent events stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/SSEEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/evaluation/create-dataset": {
      "post": {
        "tags": [
          "evaluation"
        ],
        "summary": "Create or update a Phoenix dataset from traces",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DatasetCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetCreateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/evaluation/run-experiment": {
      "post": {
        "tags": [
          "evaluation"
        ],
        "summary": "Run staging vs production prompt experiments",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunExperimentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunExperimentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/evaluation/evaluate-experiment": {
      "post": {
        "tags": [
          "evaluation"
        ],
        "summary": "Add evaluator results to an experiment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateExperimentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericSuccess"
                }
              }
            }
          }
        }
      }
    },
    "/evaluation/evaluate-original-spans": {
      "post": {
        "tags": [
          "evaluation"
        ],
        "summary": "Evaluate production spans directly",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectName": {
                    "type": "string"
                  },
                  "startTime": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endTime": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "evaluatorNames": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "projectName",
                  "startTime",
                  "endTime"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericSuccess"
                }
              }
            }
          }
        }
      }
    },
    "/evaluation/metrics": {
      "post": {
        "tags": [
          "evaluation"
        ],
        "summary": "Aggregate metrics",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MetricsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/evaluation/status": {
      "get": {
        "tags": [
          "evaluation"
        ],
        "summary": "Evaluation service status",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "phoenixEndpoint": {
                      "type": "string"
                    },
                    "authenticated": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/local-services": {
      "get": {
        "tags": [
          "local"
        ],
        "summary": "Search family support services",
        "parameters": [
          {
            "in": "query",
            "name": "city",
            "schema": {
              "type": "string",
              "enum": [
                "berlin",
                "hamburg",
                "bremen"
              ]
            },
            "required": true
          },
          {
            "in": "query",
            "name": "serviceType",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "zipcode",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            }
          },
          {
            "in": "query",
            "name": "radiusMeters",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "maxResults",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalServicesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/local-services": {
      "get": {
        "tags": [
          "local"
        ],
        "summary": "Legacy alias - Search family support services",
        "parameters": [
          {
            "in": "query",
            "name": "city",
            "schema": {
              "type": "string",
              "enum": [
                "berlin",
                "hamburg",
                "bremen"
              ]
            },
            "required": true
          },
          {
            "in": "query",
            "name": "serviceType",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "zipcode",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            }
          },
          {
            "in": "query",
            "name": "radiusMeters",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "in": "query",
            "name": "maxResults",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocalServicesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/osm/search": {
      "post": {
        "tags": [
          "local"
        ],
        "summary": "Batch search for multiple service categories",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OSMSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSMSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "chat",
          "local",
          "voice"
        ],
        "summary": "Health endpoint for each service",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/status": {
      "get": {
        "tags": [
          "voice"
        ],
        "summary": "Voice Gateway status (active sessions and connections)",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "activeSessions": {
                      "type": "integer"
                    },
                    "activeConnections": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/upload": {
      "post": {
        "tags": [
          "backoffice"
        ],
        "summary": "Generate presigned S3 upload URL and create document record",
        "security": [
          {
            "CognitoAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UploadRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Presigned URL and document info",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Not authenticated"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/documents/{id}": {
      "get": {
        "tags": [
          "backoffice"
        ],
        "summary": "Get a single document by ID",
        "security": [
          {
            "CognitoAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Document"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      },
      "patch": {
        "tags": [
          "backoffice"
        ],
        "summary": "Update document metadata",
        "security": [
          {
            "CognitoAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string",
                    "nullable": true
                  },
                  "tags": {
                    "description": "Array of tag strings (e.g., 'main_primary:xyz')",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "document": {
                      "$ref": "#/components/schemas/Document"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      },
      "delete": {
        "tags": [
          "backoffice"
        ],
        "summary": "Delete document (and S3 objects), removing from Bedrock if published",
        "security": [
          {
            "CognitoAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "401": {
            "description": "Not authenticated"
          }
        }
      }
    },
    "/api/documents/{id}/publish": {
      "post": {
        "tags": [
          "backoffice"
        ],
        "summary": "Publish a document by triggering Bedrock ingestion",
        "security": [
          {
            "CognitoAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Publish initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "401": {
            "description": "Not authenticated"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/jobs/ingest": {
      "post": {
        "tags": [
          "backoffice"
        ],
        "summary": "Background job to ingest a document to Bedrock",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestJobRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ingestion success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestJobResponse"
                }
              }
            }
          },
          "500": {
            "description": "Ingestion failed"
          }
        }
      }
    }
  }
}
