{
  "openapi": "3.1.0",
  "info": {
    "title": "rombik API",
    "version": "1.3.5",
    "description": "Генерація блок-схем алгоритмів з коду за ДСТУ. Той самий рушій, що й на сайті rombik, по HTTP. Авторизація — API-ключем (rk_…) у заголовку X-API-Key або Authorization: Bearer. Рендер за ключем — у тарифі Pro; кожен експортований файл іде в місячний ліміт тарифу. Стороннім застосункам доступний вхід «через rombik» — OAuth 2.0 з PKCE + OIDC: див. /oauth/token.",
    "x-jentic-source-url": "https://rombik.app/api/v1/openapi.json"
  },
  "servers": [
    {
      "url": "https://rombik.app/api/v1"
    }
  ],
  "paths": {
    "/render": {
      "post": {
        "summary": "Рендер блок-схеми з коду",
        "description": "Код → блок-схема у вибраному форматі. Потрібен тариф Pro (інакше 402 pro_required); 1 файл — 1 експорт місячного ліміту, інший формат того самого файлу безкоштовний (понад ліміт — 402 fair_use). Тіло — JSON {code,lang,…} або multipart-файл (-F file=@…). Типово повертає файл; з ?json=1 — JSON із полем content.",
        "parameters": [
          {
            "name": "json",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Повернути JSON {content} замість файлу"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Файл вихідного коду (мова — за розширенням)"
                  },
                  "format": {
                    "type": "string"
                  },
                  "lang": {
                    "type": "string"
                  },
                  "fn": {
                    "type": "string"
                  },
                  "scale": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Схема — файл або JSON (за ?json=1)",
            "content": {
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderJSONResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/render/batch": {
      "post": {
        "summary": "Пакетний рендер кількох джерел за один виклик",
        "description": "Багато елементів (code або url) → один результат. Потрібен тариф Pro. Зараховує по одному експорту за кожен успішний елемент; у ліміті місяця має лишатись щонайменше стільки, скільки елементів (1..100). format=pdf (і не bundle=zip) → один багатосторінковий PDF (сторінка на елемент); інші формати → zip із файлом на елемент. З ?json=1 — звіт по кожному елементу + bundle у base64; інакше — файл (pdf|zip) із заголовками X-Rombik-Rendered та X-Rombik-Failed.",
        "parameters": [
          {
            "name": "json",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Повернути JSON-звіт {items,content} замість файлу"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bundle (pdf|zip) або JSON-звіт (за ?json=1)",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Тариф і ліміт місяця за ключем",
        "responses": {
          "200": {
            "description": "Тариф, до коли діє, використання ліміту місяця",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/topup": {
      "post": {
        "summary": "Оплата тарифу — лінк на оплату (лише Україна, грн)",
        "description": "Створює pending-платіж і повертає посилання на оплату plata by mono (картка / Apple·Google Pay). ⚠️ УВАГА: оплата тут — ЛИШЕ для України (у гривні). Міжнародним користувачам: оформлюйте тариф на сайті rombik.app — там є оплата карткою в USD (Paddle), а API-ключем далі користуйтесь як завжди (тариф той самий). Тіло: {kind: plan, id} — id особистого тарифу з /products. 409 plan_conflict — Студент, поки діє Pro.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TopupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Лінк на оплату",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopupResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Каталог тарифів",
        "responses": {
          "200": {
            "description": "Каталог цін",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Products"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/r": {
      "post": {
        "summary": "Тимчасовий публічний лінк на результат (1 година)",
        "description": "Кладе готовий файл у тимчасове сховище і повертає посилання на нього — для клієнтів, які не показують файли (чат-боти, вебхуки, листи). Тіло запиту — САМ файл (байти з /render), Content-Type — його MIME. Посилання живе годину; картинки й PDF відкриваються в браузері, решта віддається на завантаження. У CLI те саме робить прапорець --link.",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Імʼя файлу для завантаження (напр. schema.pdf)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Посилання на результат",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TempLink"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/r/{token}": {
      "get": {
        "summary": "Забрати результат за тимчасовим лінком",
        "description": "Публічно (без ключа) — посилання й є секретом. Після спливання години повертає 404.",
        "security": [],
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Токен із відповіді POST /r"
          }
        ],
        "responses": {
          "200": {
            "description": "Файл із тим самим MIME, що клали",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Лінк недійсний або протермінований"
          }
        }
      }
    },
    "/skill.md": {
      "get": {
        "summary": "Готовий скіл для AI-агентів (Markdown)",
        "description": "Уся довідка по API одним файлом у форматі Agent Skills — постав його агенту, і той працюватиме з rombik без додаткових пояснень. Мова — за ?lang (uk|en), ?download=1 віддає як файл.",
        "security": [],
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "uk",
                "en"
              ]
            }
          },
          {
            "name": "download",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Віддати як файл (Content-Disposition: attachment)"
          }
        ],
        "responses": {
          "200": {
            "description": "Скіл",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/rombik-format.md": {
      "get": {
        "summary": "Специфікація рідного формату (astJSON)",
        "description": "Види вузлів і поля дерева схеми для lang=rombik — той самий текст, що всередині skill.md. Дай його своїй моделі, щоб вона будувала схеми для мов, яких у списку немає.",
        "security": [],
        "parameters": [
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "uk",
                "en"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Специфікація",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/cli/version": {
      "get": {
        "summary": "Найновіша версія CLI",
        "description": "Джерело правди для автооновлення (rombik update) і для власних інсталяторів чи дзеркал.",
        "security": [],
        "responses": {
          "200": {
            "description": "Версія",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cli/dl/{name}": {
      "get": {
        "summary": "Завантажити бінарник CLI",
        "description": "Готові збірки під платформу: rombik-linux-amd64, rombik-linux-arm64, rombik-darwin-amd64, rombik-darwin-arm64, rombik-windows-amd64.exe, rombik-windows-arm64.exe.",
        "security": [],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Імʼя бінарника"
          }
        ],
        "responses": {
          "200": {
            "description": "Виконуваний файл",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/oauth/token": {
      "post": {
        "summary": "Обмін коду авторизації на токен",
        "description": "Вхід «через rombik» у три кроки. 1) Опублікуй на своєму домені JSON-документ метаданих клієнта (CIMD) {\"client_id\": \"<URL цього документа>\", \"client_name\": \"…\", \"redirect_uris\": [\"https://…/callback\"]} — його https-URL і є client_id, реєстрація не потрібна; користувач на сторінці згоди бачить домен застосунку. Конфіденційного клієнта з секретом видає адміністрація rombik на запит. 2) Відправ користувача на https://rombik.app/oauth/authorize?response_type=code&client_id=…&redirect_uri=…&scope=openid+email+api&state=…&code_challenge=…&code_challenge_method=S256. 3) Обміняй code тут. Метадані: https://rombik.app/.well-known/oauth-authorization-server, OIDC — https://rombik.app/.well-known/openid-configuration. RFC 6749; тіло — application/x-www-form-urlencoded. Секрет конфіденційного клієнта передається у формі (client_secret) або в HTTP Basic. CIMD-клієнт секрета не має і зобов’язаний використати PKCE S256, redirect_uri мусить збігатися з тим, що був в authorize. Отриманий access_token — це звичайний ключ API rombik (rk_…): ним викликають /render і решту ендпоінтів, а рендер іде за тарифом користувача, який дав згоду (потрібен Pro). Термін дії не обмежений; користувач відкликає доступ у своєму акаунті (ключ зникає). Зі scope openid у відповіді додатково приходить id_token (RS256; ключі — GET /oauth/jwks).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/OAuthTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Токен доступу (плюс id_token за scope openid)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthTokenResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/OAuthError"
          },
          "401": {
            "$ref": "#/components/responses/OAuthError"
          }
        }
      }
    },
    "/oauth/userinfo": {
      "get": {
        "summary": "Хто цей користувач (OIDC userinfo)",
        "description": "Ідентичність власника токена. Токен — у заголовку Authorization: Bearer.",
        "security": [
          {
            "OAuth2": [
              "openid"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Профіль користувача",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInfo"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/OAuthError"
          }
        }
      }
    },
    "/oauth/jwks": {
      "get": {
        "summary": "Публічні ключі для перевірки id_token (JWKS)",
        "description": "Набір ключів RFC 7517. Перевіряй підпис id_token за kid із його заголовка.",
        "security": [],
        "responses": {
          "200": {
            "description": "Набір ключів",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JWKS"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Ця специфікація",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI-документ"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "OAuth2": {
        "type": "oauth2",
        "description": "«Увійти через rombik»: користувач дає згоду у своєму акаунті, а застосунок отримує ключ до API від його імені. PKCE S256 обов’язковий для клієнтів без секрета.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://rombik.app/oauth/authorize",
            "tokenUrl": "https://rombik.app/api/v1/oauth/token",
            "scopes": {
              "api": "виклики API від імені користувача (за його тарифом)",
              "openid": "видати id_token з ідентичністю",
              "email": "пошта користувача",
              "profile": "ім’я користувача"
            }
          }
        }
      }
    },
    "responses": {
      "OAuthError": {
        "description": "Помилка OAuth (RFC 6749 §5.2)",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "description": "код помилки: invalid_request, invalid_client, invalid_grant, unsupported_grant_type, invalid_client_metadata, invalid_redirect_uri, server_error",
                  "enum": [
                    "invalid_request",
                    "invalid_client",
                    "invalid_grant",
                    "unsupported_grant_type",
                    "invalid_client_metadata",
                    "invalid_redirect_uri",
                    "invalid_token",
                    "server_error"
                  ]
                },
                "error_description": {
                  "type": "string",
                  "description": "людський опис"
                }
              }
            }
          }
        }
      },
      "Error": {
        "description": "Помилка",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string",
                  "description": "людський опис"
                },
                "code": {
                  "type": "string",
                  "description": "машиночитаний код (стабільний; гілкуйся по ньому, не по тексту): unauthorized, pro_required, no_credits, fair_use, plan_conflict, unknown_format, unknown_lang, bad_request, bad_source, render_failed, rate_limited, payment_unavailable, server_error, busy, chart_too_large",
                  "enum": [
                    "unauthorized",
                    "pro_required",
                    "no_credits",
                    "fair_use",
                    "plan_conflict",
                    "unknown_format",
                    "unknown_lang",
                    "bad_request",
                    "bad_source",
                    "render_failed",
                    "rate_limited",
                    "payment_unavailable",
                    "server_error",
                    "busy",
                    "chart_too_large"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "TempLink": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Публічне посилання на файл"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Скільки секунд житиме посилання (3600)"
          }
        }
      },
      "OAuthTokenRequest": {
        "type": "object",
        "required": [
          "grant_type",
          "code",
          "redirect_uri",
          "client_id"
        ],
        "properties": {
          "grant_type": {
            "type": "string",
            "enum": [
              "authorization_code"
            ]
          },
          "code": {
            "type": "string",
            "description": "одноразовий код зі сторінки згоди; живе 10 хвилин"
