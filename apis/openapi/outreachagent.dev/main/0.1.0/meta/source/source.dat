                    "description": "HTML email body content (supports Liquid variables)"
                  },
                  "text": {
                    "type": "string",
                    "description": "Plaintext email body content (supports Liquid variables)"
                  },
                  "body": {
                    "type": "string",
                    "description": "Alias for text \u2014 plaintext email body content"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
