{
  "openapi": "3.0.3",
  "info": {
    "title": "Lorem Picsum API",
    "description": "Lorem Picsum is a placeholder image service. Get random or specific placeholder images of any size with optional grayscale and blur effects.",
    "version": "2.0.0",
    "x-jentic-source-url": "https://picsum.photos/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://picsum.photos"
    }
  ],
  "paths": {
    "/v2/list": {
      "get": {
        "operationId": "listImages",
        "summary": "List all available images",
        "description": "Returns a paginated list of all available images with metadata including author, dimensions, and URLs.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items per page",
            "schema": {
              "type": "integer",
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of image metadata objects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ImageInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/id/{id}/info": {
      "get": {
        "operationId": "getImageInfo",
        "summary": "Get image metadata by ID",
        "description": "Returns metadata for a specific image including author, dimensions, and download URL.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The image ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Image metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageInfo"
                }
              }
            }
          },
          "404": {
            "description": "Image not found"
          }
        }
      }
    },
    "/seed/{seed}/info": {
      "get": {
        "operationId": "getSeededImageInfo",
        "summary": "Get image metadata by seed",
        "description": "Returns metadata for a deterministic image selected by the given seed value.",
        "parameters": [
          {
            "name": "seed",
            "in": "path",
            "required": true,
            "description": "The seed value for deterministic image selection",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Image metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageInfo"
                }
              }
            }
          }
        }
      }
    },
    "/{width}/{height}": {
      "get": {
        "operationId": "getRandomImage",
        "summary": "Get a random placeholder image",
        "description": "Returns a random placeholder image with the specified dimensions. Optionally apply grayscale or blur effects.",
        "parameters": [
          {
            "name": "width",
            "in": "path",
            "required": true,
            "description": "Desired image width in pixels",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "height",
            "in": "path",
            "required": true,
            "description": "Desired image height in pixels",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "grayscale",
            "in": "query",
            "description": "Apply grayscale filter (parameter presence enables it, no value needed)",
            "schema": {
              "type": "boolean"
            },
            "allowEmptyValue": true
          },
          {
            "name": "blur",
            "in": "query",
            "description": "Apply blur effect, value from 1 to 10",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A placeholder image",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/id/{id}/{width}/{height}": {
      "get": {
        "operationId": "getImageById",
        "summary": "Get a specific image by ID with custom dimensions",
        "description": "Returns a specific image resized to the given dimensions. Optionally apply grayscale or blur effects.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The image ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "width",
            "in": "path",
            "required": true,
            "description": "Desired image width in pixels",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "height",
            "in": "path",
            "required": true,
            "description": "Desired image height in pixels",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "grayscale",
            "in": "query",
            "description": "Apply grayscale filter",
            "schema": {
              "type": "boolean"
            },
            "allowEmptyValue": true
          },
          {
            "name": "blur",
            "in": "query",
            "description": "Apply blur effect, value from 1 to 10",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested image",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Image not found"
          }
        }
      }
    },
    "/seed/{seed}/{width}/{height}": {
      "get": {
        "operationId": "getSeededImage",
        "summary": "Get a deterministic image by seed with custom dimensions",
        "description": "Returns a deterministic image based on the seed value, resized to the given dimensions. The same seed always returns the same image.",
        "parameters": [
          {
            "name": "seed",
            "in": "path",
            "required": true,
            "description": "The seed value for deterministic image selection",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "width",
            "in": "path",
            "required": true,
            "description": "Desired image width in pixels",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "height",
            "in": "path",
            "required": true,
            "description": "Desired image height in pixels",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "grayscale",
            "in": "query",
            "description": "Apply grayscale filter",
            "schema": {
              "type": "boolean"
            },
            "allowEmptyValue": true
          },
          {
            "name": "blur",
            "in": "query",
            "description": "Apply blur effect, value from 1 to 10",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The requested image",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ImageInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The image ID"
          },
          "author": {
            "type": "string",
            "description": "The image author name"
          },
          "width": {
            "type": "integer",
            "description": "Original image width"
          },
          "height": {
            "type": "integer",
            "description": "Original image height"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "URL to the image source page"
          },
          "download_url": {
            "type": "string",
            "format": "uri",
            "description": "Direct download URL for the original image"
          }
        }
      }
    }
  },
  "security": []
}
