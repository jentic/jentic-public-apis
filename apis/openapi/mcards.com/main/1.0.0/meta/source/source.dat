{
  "openapi": "3.0.1",
  "info": {
    "title": "Cards API",
    "version": "1.0.0",
    "description": "Cards API library (v1) - payment card resource retrieval endpoints.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/mcardsinc/cards-api-option-1/1.0.0"
  },
  "servers": [
    {
      "url": "https://uat-us.mcards.com"
    }
  ],
  "tags": [
    {
      "name": "Distributor Cards",
      "description": "Distributor card resources."
    },
    {
      "name": "Cardholder Cards",
      "description": "Cardholder card resources."
    },
    {
      "name": "Transactions",
      "description": "Cardholder card transaction resources."
    },
    {
      "name": "Payment Accounts",
      "description": "Payment accounts usable to fund cardholder card transactions (mCards payment currencies, partner payment currencies, payment gateway accounts)."
    }
  ],
  "components": {
    "securitySchemes": {
      "Authorization": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    },
    "schemas": {
      "pagination": {
        "type": "object",
        "required": [
          "page",
          "per_page",
          "count",
          "total_count"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "count": {
            "type": "integer"
          },
          "total_count": {
            "type": "integer"
          }
        }
      },
      "distributor_card": {
        "type": "object",
        "required": [
          "distributor_card_uuid",
          "distributor_card_title",
          "distributor_card_image_url"
        ],
        "properties": {
          "distributor_card_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "distributor_card_title": {
            "type": "string"
          },
          "distributor_card_image_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "cardholder_card": {
        "type": "object",
        "required": [
          "cardholder_card_uuid"
        ],
        "properties": {
          "cardholder_card_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "distributor_card_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "card_image_url": {
            "type": "string",
            "format": "uri"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "locked": {
            "type": "boolean"
          }
        }
      },
      "payment_account_transaction": {
        "type": "object",
        "description": "A transaction record representing the use of a payment account to fund a cardholder card transaction.",
        "required": [
          "amount",
          "created_at",
          "payment_account_transaction_uuid",
          "payment_account_uuid",
          "updated_at"
        ],
        "properties": {
          "payment_account_transaction_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "payment_account_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "float"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "cardholder_card_transaction_uuid": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Optional UUID of the associated cardholder card transaction."
          }
        }
      },
      "mcards_currency": {
        "type": "object",
        "required": [
          "title",
          "image",
          "mcards_currency_balance_type",
          "available_balance"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "format": "uri"
          },
          "mcards_currency_balance_type": {
            "type": "string",
            "enum": [
              "prepaid_balance",
              "campaign_balance",
              "free_money_balance",
              "mcash_balance"
            ]
          },
          "available_balance": {
            "type": "number",
            "format": "float"
          }
        },
        "description": "mCards internal currency balance (no UUID). Identified by mcards_currency_balance_type."
      },
      "partner_currency": {
        "allOf": [
          {
            "$ref": "#/components/schemas/payment_currency_base"
          },
          {
            "type": "object",
            "properties": {
              "payment_currency_type": {
                "type": "string",
                "enum": [
                  "partner_currency"
                ]
              },
              "available_balance": {
                "type": "number",
                "format": "float",
                "nullable": true
              }
            }
          }
        ]
      },
      "payment_gateway": {
        "allOf": [
          {
            "$ref": "#/components/schemas/payment_currency_base"
          },
          {
            "type": "object",
            "required": [
              "payment_gateway_type"
            ],
            "properties": {
              "payment_currency_type": {
                "type": "string",
                "enum": [
                  "payment_gateway"
                ]
              },
              "payment_gateway_type": {
                "type": "string",
                "enum": [
                  "linked_bank_account",
                  "linked_payment_card",
                  "dda",
                  "heloc",
                  "crypto",
                  "hsa"
                ]
              },
              "available_balance": {
                "type": "number",
                "format": "float",
                "nullable": true
              }
            }
          }
        ]
      },
      "payment_account_summary": {
        "type": "object",
        "required": [
          "payment_account_uuid",
          "payment_account_title",
          "payment_account_image",
          "payment_account_amount"
        ],
        "properties": {
          "payment_account_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "payment_account_title": {
            "type": "string"
          },
          "payment_account_image": {
            "type": "string",
            "format": "uri"
          },
          "payment_account_amount": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "payment_account_transactions_collection": {
        "type": "object",
        "required": [
          "payment_account_transactions",
          "pagination"
        ],
        "properties": {
          "payment_account_transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/payment_account_transaction"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/pagination"
          }
        }
      },
      "linked_bank_account_transaction": {
        "type": "object",
        "required": [
          "transaction_id",
          "amount",
          "currency",
          "date",
          "name"
        ],
        "properties": {
          "transaction_id": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "float"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "authorized_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "merchant_name": {
            "type": "string",
            "nullable": true
          },
          "merchant_logo_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "subcategory": {
            "type": "string",
            "nullable": true
          },
          "pending": {
            "type": "boolean"
          },
          "transaction_type": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/linked_bank_account_transaction_location"
          }
        }
      },
      "linked_bank_account_transactions_collection": {
        "type": "object",
        "required": [
          "linked_bank_account_transactions",
          "pagination"
        ],
        "properties": {
          "linked_bank_account_transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/linked_bank_account_transaction"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/pagination"
          }
        }
      },
      "distributor_cards_collection": {
        "type": "object",
        "required": [
          "distributor_cards",
          "pagination"
        ],
        "properties": {
          "distributor_cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/distributor_card"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/pagination"
          }
        }
      },
      "cardholder_cards_collection": {
        "type": "object",
        "required": [
          "cardholder_cards",
          "pagination"
        ],
        "properties": {
          "cardholder_cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/cardholder_card"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/pagination"
          }
        }
      },
      "cardholder_transactions_collection": {
        "type": "object",
        "required": [
          "transactions",
          "pagination"
        ],
        "properties": {
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/cardholder_card_transaction"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/pagination"
          }
        }
      },
      "linked_bank_account_transaction_location": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "nullable": true
          },
          "region": {
            "type": "string",
            "nullable": true
          },
          "country": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "cardholder_card_transaction_merchant": {
        "type": "object",
        "description": "Merchant information sent in ISO 8583 message",
        "properties": {
          "merchant_trade_name": {
            "type": "string",
            "example": "STARBUCKS STORE 2335",
            "description": "Merchant Trade Name sent in ISO 8583 message"
          },
          "merchant_category_code": {
            "type": "string",
            "example": "5814",
            "description": "Merchant Category Code sent in ISO 8583 message"
          },
          "merchant_id": {
            "type": "string",
            "example": "991000000034031",
            "description": "Merchant ID sent in ISO 8583 message"
          }
        }
      },
      "cardholder_card_transaction_location": {
        "type": "object",
        "description": "Card transaction location information",
        "properties": {
          "location_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "full_address": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "float"
          },
          "longitude": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "payment_currency_base": {
        "type": "object",
        "required": [
          "payment_account_uuid",
          "payment_account_title",
          "payment_account_image",
          "payment_currency_type"
        ],
        "properties": {
          "payment_account_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "payment_account_title": {
            "type": "string"
          },
          "payment_account_image": {
            "type": "string",
            "format": "uri"
          },
          "payment_currency_type": {
            "type": "string",
            "enum": [
              "partner_currency",
              "payment_gateway"
            ]
          }
        },
        "description": "A UUID-addressable funding source (partner currency or payment gateway)."
      },
      "payment_currency": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/partner_currency"
          },
          {
            "$ref": "#/components/schemas/payment_gateway"
          }
        ],
        "discriminator": {
          "propertyName": "payment_currency_type"
        }
      },
      "funding_sources_collection": {
        "type": "object",
        "required": [
          "mcards_currencies",
          "payment_currencies"
        ],
        "properties": {
          "mcards_currencies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/mcards_currency"
            }
          },
          "payment_currencies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/payment_currency"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/pagination"
          }
        },
        "description": "Funding sources for a cardholder card. Pagination applies to payment_currencies."
      },
      "mcards_currency_summary": {
        "type": "object",
        "required": [
          "title",
          "image",
          "mcards_currency_balance_type",
          "amount"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "format": "uri"
          },
          "mcards_currency_balance_type": {
            "type": "string",
            "enum": [
              "prepaid_balance",
              "campaign_balance",
              "free_money_balance",
              "mcash_balance"
            ]
          },
          "amount": {
            "type": "number",
            "format": "float"
          }
        },
        "description": "mCards currency funding used for a transaction."
      },
      "payment_currency_summary": {
        "type": "object",
        "required": [
          "payment_account_uuid",
          "payment_account_title",
          "payment_account_image",
          "amount"
        ],
        "properties": {
          "payment_account_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "payment_account_title": {
            "type": "string"
          },
          "payment_account_image": {
            "type": "string",
            "format": "uri"
          },
          "amount": {
            "type": "number",
            "format": "float"
          }
        },
        "description": "Payment currency funding used for a transaction."
      },
      "funding_source_summary": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/mcards_currency_summary"
          },
          {
            "$ref": "#/components/schemas/payment_currency_summary"
          }
        ],
        "description": "Funding sources used to pay for a transaction."
      },
      "payment_account_type": {
        "type": "string",
        "enum": [
          "mcards_payment_currency",
          "partner_payment_currency",
          "payment_gateway_account"
        ]
      },
      "mcards_payment_currency_balance_type": {
        "type": "string",
        "enum": [
          "prepaid_balance",
          "campaign_balance",
          "free_money_balance",
          "mcash_balance"
        ]
      },
      "payment_gateway_type": {
        "type": "string",
        "enum": [
          "linked_bank_account",
          "linked_payment_card",
          "dda",
          "heloc",
          "crypto",
          "hsa"
        ]
      },
      "mcards_payment_account": {
        "type": "object",
        "description": "mCards payment currency balance usable to fund cardholder card transactions.",
        "required": [
          "payment_account_uuid",
          "payment_account_type",
          "mcards_payment_currency_balance_type",
          "title",
          "image",
          "available_balance"
        ],
        "properties": {
          "payment_account_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "payment_account_type": {
            "type": "string",
            "enum": [
              "mcards_payment_currency"
            ]
          },
          "mcards_payment_currency_balance_type": {
            "$ref": "#/components/schemas/mcards_payment_currency_balance_type"
          },
          "title": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "format": "uri"
          },
          "available_balance": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "partner_payment_account": {
        "type": "object",
        "description": "Partner payment currency usable to fund cardholder card transactions.",
        "required": [
          "payment_account_uuid",
          "payment_account_type",
          "payment_account_title",
          "payment_account_image",
          "available_balance"
        ],
        "properties": {
          "payment_account_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "payment_account_type": {
            "type": "string",
            "enum": [
              "partner_payment_currency"
            ]
          },
          "payment_account_title": {
            "type": "string"
          },
          "payment_account_image": {
            "type": "string",
            "format": "uri"
          },
          "available_balance": {
            "type": "number",
            "format": "float",
            "nullable": true
          }
        }
      },
      "payment_gateway_account": {
        "type": "object",
        "description": "External ledger-backed account integrated via a payment gateway (bank account, card, crypto wallet, etc.).",
        "required": [
          "payment_account_uuid",
          "payment_account_type",
          "payment_gateway_type",
          "payment_account_title",
          "payment_account_image",
          "available_balance"
        ],
        "properties": {
          "payment_account_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "payment_account_type": {
            "type": "string",
            "enum": [
              "payment_gateway_account"
            ]
          },
          "payment_gateway_type": {
            "$ref": "#/components/schemas/payment_gateway_type"
          },
          "payment_account_title": {
            "type": "string"
          },
          "payment_account_image": {
            "type": "string",
            "format": "uri"
          },
          "available_balance": {
            "type": "number",
            "format": "float",
            "nullable": true
          }
        }
      },
      "payment_account": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/mcards_payment_account"
          },
          {
            "$ref": "#/components/schemas/partner_payment_account"
          },
          {
            "$ref": "#/components/schemas/payment_gateway_account"
          }
        ],
        "description": "A payment account usable to fund cardholder card transactions."
      },
      "payment_accounts_collection": {
        "type": "object",
        "required": [
          "payment_accounts",
          "pagination"
        ],
        "properties": {
          "payment_accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/payment_account"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/pagination"
          }
        }
      },
      "cardholder_card_payment_account_transaction": {
        "type": "object",
        "description": "Funding line item applied to a cardholder card transaction from a payment account. For mCards payment currencies, payment_account_transaction_uuid may be null.",
        "required": [
          "payment_account_uuid",
          "amount",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "payment_account_transaction_uuid": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "payment_account_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "float"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "cardholder_card_transaction_uuid": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "cardholder_card_transaction": {
        "type": "object",
        "required": [
          "cardholder_card_transaction_uuid",
          "created_at",
          "total_amount",
          "updated_at"
        ],
        "properties": {
          "transaction_title": {
            "type": "string"
          },
          "transaction_icon_url": {
            "type": "string",
            "format": "uri"
          },
          "total_amount": {
            "type": "number",
            "format": "float"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "payment_accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/funding_source_summary"
            },
            "deprecated": true,
            "description": "Deprecated: use payment_account_transactions."
          },
          "merchant": {
            "$ref": "#/components/schemas/cardholder_card_transaction_merchant"
          },
          "location": {
            "$ref": "#/components/schemas/cardholder_card_transaction_location"
          },
          "payment_account_transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/cardholder_card_payment_account_transaction"
            },
            "description": "Funding line items for this cardholder card transaction."
          },
          "cardholder_card_transaction_uuid": {
            "type": "string",
            "format": "uuid"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Represents a card program transaction (cardholder card transaction)."
      }
    }
  },
  "paths": {
    "/api/cards/v1/distributor_cards": {
      "get": {
        "tags": [
          "Distributor Cards"
        ],
        "summary": "Get distributor cards",
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of distributor cards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/distributor_cards_collection"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/cards/v1/distributor_cards/{distributor_card_uuid}": {
      "get": {
        "tags": [
          "Distributor Cards"
        ],
        "summary": "Get distributor card details",
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
          {
            "name": "distributor_card_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Distributor card details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/distributor_card"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/cards/v1/distributor_cards/{distributor_card_uuid}/cardholder_cards": {
      "get": {
        "tags": [
          "Cardholder Cards"
        ],
        "summary": "Get cardholder cards for distributor card",
        "security": [
          {
            "Authorization": []
          }
        ],
        "parameters": [
