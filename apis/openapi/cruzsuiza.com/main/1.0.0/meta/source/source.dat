{
  "openapi": "3.0.3",
  "info": {
    "title": "Cruz Suiza Seguros — Producers API",
    "description": "API de acceso externo para productores de Cruz Suiza Seguros.\n\n## Autenticación\nEsta API utiliza OAuth 2.0 Client Credentials Flow. Cada productor recibe un\n`client_id` y `client_secret` únicos. Con esas credenciales obtiene un JWT token\nde Amazon Cognito, que debe incluir en cada request como Bearer token.\n\n## Flujo de autenticación\n```\nPOST https://insurance-test.auth.us-east-1.amazoncognito.com/oauth2/token\nAuthorization: Basic base64(client_id:client_secret)\nContent-Type: application/x-www-form-urlencoded\n\ngrant_type=client_credentials&scope=api/quotes:read\n```\n\n## Ambientes\n| Ambiente | OAuth URL | API Base URL |\n|----------|-----------|--------------|\n| TEST | https://insurance-test.auth.us-east-1.amazoncognito.com | https://api-test.cruzsuiza.com |\n| QA   | https://insurance-qa.auth.us-east-1.amazoncognito.com   | https://api-qa.cruzsuiza.com  |\n| PROD | https://insurance.auth.us-east-1.amazoncognito.com      | https://api.cruzsuiza.com     |\n",
    "version": "1.0.0",
    "contact": {
      "name": "Equipo de Tecnología Cruz Suiza",
      "email": "api-support@cruzsuiza.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/lea-e7c/cruz-suiza-seguros-producers-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.cruzsuiza.com",
      "description": "Ambiente Producción"
    }
  ],
  "security": [
    {
      "CognitoJWT": []
    }
  ],
  "components": {
    "securitySchemes": {
      "CognitoJWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token JWT emitido por Amazon Cognito mediante el flujo Client Credentials.\nEl token incluye los siguientes claims del productor:\n- `custom:producer_id` — Código de productor del backoffice (char(10)). Es el\n  identificador único que distingue productor + punto de venta + organizador.\n  API Gateway lo inyecta como header `X-Producer-Id` en cada request al backend.\n- `custom:company_code` — Código de compañía\n\nLos ramos habilitados, zona y demás parámetros operativos NO viajan en el token.\nSe resuelven siempre desde la base de datos usando el `producer_id` como clave,\ngarantizando que los permisos estén siempre actualizados.\n"
      }
    },
    "schemas": {
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT token para usar en los requests",
            "example": "eyJraWQiOiJxxxxxx..."
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "description": "Tiempo de expiración en segundos",
            "example": 3600
          }
        }
      },
      "Ocupacion": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "description": "Código de la ocupación",
            "example": "13001"
          },
          "descripcion": {
            "type": "string",
            "description": "Descripción de la ocupación",
            "example": "Empleado administrativo"
          },
          "clase": {
            "type": "string",
            "description": "Clase de riesgo de la ocupación",
            "example": "A"
          }
        },
        "required": [
          "codigo",
          "descripcion"
        ]
      },
      "OcupacionesResponse": {
        "type": "object",
        "properties": {
          "ocupaciones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ocupacion"
            }
          },
          "total": {
            "type": "integer",
            "description": "Total de ocupaciones disponibles",
            "example": 150
          }
        },
        "required": [
          "ocupaciones",
          "total"
        ]
      },
      "ContextoProductor": {
        "type": "object",
        "description": "Información del productor autenticado y sus permisos",
        "properties": {
          "productor": {
            "type": "object",
            "properties": {
              "matricula": {
                "type": "string",
                "description": "Matrícula del productor",
                "example": "71066"
              },
              "matriculaOrganizador": {
                "type": "string",
                "description": "Matrícula del organizador",
                "example": "71066"
              },
              "puntoDeVenta": {
                "type": "string",
                "description": "Punto de venta asignado",
                "example": "001"
              },
              "comisionMaxima": {
                "type": "number",
                "description": "Porcentaje máximo de comisión permitido",
                "example": 15.0
              }
            }
          },
          "condicionesIVA": {
            "type": "array",
            "description": "Valores permitidos para condición de IVA del tomador",
            "items": {
              "type": "object",
              "properties": {
                "codigo": {
                  "type": "string",
                  "example": "IN"
                },
                "descripcion": {
                  "type": "string",
                  "example": "Inscripto"
                }
              }
            },
            "example": [
              {
                "codigo": "EX",
                "descripcion": "Exento"
              },
              {
                "codigo": "CF",
                "descripcion": "Consumidor Final"
              },
              {
                "codigo": "IN",
                "descripcion": "Inscripto"
              }
            ]
          },
          "ramos": {
            "type": "array",
            "description": "Ramos habilitados para el productor",
            "items": {
              "$ref": "#/components/schemas/RamoHabilitado"
            }
          }
        }
      },
      "RamoHabilitado": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "example": "AP"
          },
          "descripcion": {
            "type": "string",
            "example": "Accidentes Personales"
          },
          "ambitos": {
            "type": "array",
            "description": "Ámbitos habilitados (24H, LTI)",
            "items": {
              "type": "string"
            },
            "example": [
              "24H",
              "LTI"
            ]
          },
          "provincias": {
            "type": "array",
            "description": "Provincias donde puede emitir",
            "items": {
              "type": "object",
              "properties": {
                "codigo": {
                  "type": "string",
                  "example": "01"
                },
                "descripcion": {
                  "type": "string",
                  "example": "Buenos Aires"
                }
              }
            }
          },
          "coberturas": {
            "type": "array",
            "description": "Coberturas habilitadas con importes máximos",
            "items": {
              "$ref": "#/components/schemas/CoberturaHabilitada"
            }
          }
        }
      },
      "CoberturaHabilitada": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "description": "Código de cobertura",
            "example": "MUE"
          },
          "descripcion": {
            "type": "string",
            "example": "Muerte"
          },
          "sumaMaxima": {
            "type": "number",
            "description": "Importe máximo de suma asegurada permitido",
            "example": 5000000
          },
          "regla": {
            "type": "string",
            "description": "Regla de negocio aplicable",
            "example": "ITP no puede ser mayor que MUE"
          }
        }
      },
      "CotizacionRequest": {
        "type": "object",
        "description": "Request de cotización de Accidentes Personales.\nEl productor solo envía los campos de negocio.\nEl sistema inyecta automáticamente: MatriculaProductor, MatriculaOrganizador,\nPuntoDeVenta y ComisionOrganizador desde el token JWT.\n",
        "properties": {
          "ramo": {
            "type": "string",
            "description": "Código de ramo",
            "example": "12"
          },
          "ambito": {
            "type": "string",
            "description": "Ámbito de cobertura",
            "enum": [
              "24H",
              "LTI"
            ],
            "example": "LTI"
          },
          "provinciaRiesgo": {
            "type": "string",
            "description": "Código de provincia del riesgo",
            "example": "02"
          },
          "porcentajeComisionProductor": {
            "type": "number",
            "description": "Porcentaje de comisión del productor (debe ser <= comisionMaxima del contexto)",
            "example": 10.0
          },
          "cuit": {
            "type": "string",
            "description": "CUIT del tomador",
            "example": "30666048918"
          },
          "condicionIVA": {
            "type": "string",
            "description": "Condición de IVA del tomador",
            "enum": [
              "EX",
              "CF",
              "IN"
            ],
            "example": "IN"
          },
          "fechaInicioVigencia": {
            "type": "string",
            "format": "date",
            "description": "Fecha de inicio de vigencia (para toda la cotización).\nNo puede ser anterior a la fecha actual.\n",
            "example": "2026-10-01"
          },
          "fechaFinVigencia": {
            "type": "string",
            "format": "date",
            "description": "Fecha de fin de vigencia (para toda la cotización).\nNo puede ser mayor a un año desde el inicio.\n",
            "example": "2027-09-30"
          },
          "coberturas": {
            "type": "array",
            "description": "Coberturas y sumas aseguradas (para toda la cotización).\nReglas: ITP <= MUE, GAME <= 10% de MUE, GAME <= sumaMaxima del productor.\n",
            "items": {
              "$ref": "#/components/schemas/Cobertura"
            }
          },
          "asegurados": {
            "type": "array",
            "description": "Grupos de asegurados a cotizar",
            "items": {
              "$ref": "#/components/schemas/AseguradoRequest"
            }
          }
        },
        "required": [
          "ramo",
          "ambito",
          "provinciaRiesgo",
          "porcentajeComisionProductor",
          "cuit",
          "condicionIVA",
          "fechaInicioVigencia",
          "fechaFinVigencia",
          "coberturas",
          "asegurados"
        ]
      },
      "Cobertura": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "enum": [
              "MUE",
              "ITP",
              "GAME"
            ],
            "example": "MUE"
          },
          "suma": {
            "type": "number",
            "example": 400000
          },
          "deducible": {
            "type": "number",
            "example": 0
          },
          "plazo": {
            "type": "integer",
            "example": 1
          },
          "espera": {
            "type": "integer",
            "example": 1
          }
        },
        "required": [
          "codigo",
          "suma"
        ]
      },
      "AseguradoRequest": {
        "type": "object",
        "properties": {
          "ocupacion": {
            "type": "string",
            "description": "Código de ocupación (debe existir en GET /ocupaciones)",
            "example": "13001"
          },
          "cantidad": {
            "type": "integer",
            "description": "Cantidad de asegurados con esta ocupación",
            "example": 1
          }
        },
        "required": [
          "ocupacion",
          "cantidad"
        ]
      },
      "CotizacionResponse": {
        "type": "object",
        "properties": {
          "numeroCotizacion": {
            "type": "string",
            "example": "COT-2026-001234"
          },
          "prima": {
            "type": "number",
            "description": "Prima calculada",
            "example": 1250.5
          },
          "detalleAsegurados": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ocupacion": {
                  "type": "string",
                  "example": "13001"
                },
                "cantidad": {
                  "type": "integer",
                  "example": 1
                },
                "primaUnitaria": {
                  "type": "number",
                  "example": 1250.5
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "codigo": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "mensaje": {
            "type": "string",
            "example": "La suma asegurada de ITP no puede ser mayor que MUE"
          },
          "detalle": {
            "type": "string",
            "example": "ITP: 500000 > MUE: 400000"
          }
        },
        "required": [
          "codigo",
          "mensaje"
        ]
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Token JWT ausente, inválido o expirado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "codigo": "UNAUTHORIZED",
              "mensaje": "Token inválido o expirado"
            }
          }
        }
      },
      "Forbidden": {
        "description": "El productor no tiene permisos para esta operación",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "codigo": "FORBIDDEN",
              "mensaje": "El productor no tiene habilitado el ramo solicitado"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Request inválido — parámetros faltantes o incorrectos",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Se superó el límite de requests asignado al productor",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "codigo": "RATE_LIMIT_EXCEEDED",
              "mensaje": "Límite de requests excedido. Intente nuevamente en unos segundos."
            }
          }
        }
      },
      "InternalError": {
        "description": "Error interno del servidor",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "codigo": "INTERNAL_ERROR",
              "mensaje": "Error interno. Contacte a soporte."
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Verifica que la API está operativa. No requiere autenticación.",
        "operationId": "healthCheck",
        "security": [],
        "tags": [
          "Sistema"
        ],
        "responses": {
          "200": {
            "description": "API operativa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-03-08T12:00:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ocupaciones": {
      "get": {
        "summary": "Listar ocupaciones disponibles",
        "description": "Devuelve la lista de ocupaciones habilitadas para cotizar Accidentes Personales.\n\n**Fase:** MVP — Este endpoint es el primero en implementarse.\nInternamente invoca `GET /Services/api/AP/Ocupaciones` del backend existente.\n\nEl producer_id del token JWT se inyecta automáticamente como header\n`X-Producer-Id` antes de llegar al backend.\n",
        "operationId": "getOcupaciones",
        "tags": [
          "Accidentes Personales"
        ],
        "security": [
          {
            "CognitoJWT": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de ocupaciones",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OcupacionesResponse"
                },
                "example": {
                  "ocupaciones": [
                    {
                      "codigo": "13001",
                      "descripcion": "Empleado administrativo",
                      "clase": "A"
                    },
                    {
                      "codigo": "13002",
                      "descripcion": "Operario de construcción",
                      "clase": "C"
                    },
                    {
                      "codigo": "13003",
                      "descripcion": "Conductor de vehículos",
                      "clase": "B"
                    }
                  ],
                  "total": 3
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/contexto": {
      "get": {
        "summary": "Obtener contexto del productor autenticado",
        "description": "Devuelve la información completa del productor autenticado:\ncódigos internos, permisos, ramos habilitados, provincias,\ncoberturas permitidas y condiciones de IVA.\n\n**Fase:** 2 — Requiere desarrollo del WS wrapper.\n\nEl backend consulta la base de datos relacional existente\nusando el `producer_id` extraído del token JWT.\n",
        "operationId": "getContextoProductor",
        "tags": [
          "Productor"
        ],
        "security": [
          {
            "CognitoJWT": []
          }
        ],
        "responses": {
          "200": {
            "description": "Contexto del productor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContextoProductor"
                },
                "example": {
                  "productor": {
                    "matricula": "71066",
                    "matriculaOrganizador": "71066",
                    "puntoDeVenta": "001",
                    "comisionMaxima": 15.0
                  },
                  "condicionesIVA": [
                    {
                      "codigo": "EX",
                      "descripcion": "Exento"
                    },
                    {
                      "codigo": "CF",
                      "descripcion": "Consumidor Final"
                    },
                    {
                      "codigo": "IN",
                      "descripcion": "Inscripto"
                    }
                  ],
                  "ramos": [
                    {
                      "codigo": "AP",
                      "descripcion": "Accidentes Personales",
                      "ambitos": [
                        "24H",
                        "LTI"
                      ],
                      "provincias": [
                        {
                          "codigo": "01",
                          "descripcion": "Buenos Aires"
                        },
                        {
                          "codigo": "02",
                          "descripcion": "CABA"
                        }
                      ],
                      "coberturas": [
                        {
                          "codigo": "MUE",
                          "descripcion": "Muerte",
                          "sumaMaxima": 5000000,
                          "regla": "Valor máximo por productor"
                        },
                        {
                          "codigo": "ITP",
                          "descripcion": "Incapacidad Total y Permanente",
                          "sumaMaxima": 5000000,
                          "regla": "No puede ser mayor que MUE"
                        },
                        {
                          "codigo": "GAME",
                          "descripcion": "Gastos Médicos",
                          "sumaMaxima": 500000,
                          "regla": "No puede ser mayor que 10% de MUE ni mayor al máximo del productor"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/cotizaciones": {
      "post": {
        "summary": "Solicitar cotización de Accidentes Personales",
        "description": "Genera una cotización de Accidentes Personales.\n\n**Fase:** 2 — Requiere desarrollo del WS wrapper.\n\nEl wrapper realiza internamente:\n1. Extrae `producer_id` del token JWT\n2. Consulta MatriculaProductor, MatriculaOrganizador, PuntoDeVenta y ComisionOrganizador\n3. Valida comisión, sumas aseguradas, fechas y ocupaciones\n4. Remapea el JSON al formato del backend interno\n5. Invoca `POST /Services/api/AP/Cotizar`\n\n**Validaciones aplicadas:**\n- Comisión del productor <= máximo permitido\n- ITP <= MUE\n- GAME <= 10% de MUE\n- GAME <= suma máxima del productor\n- Fecha inicio >= hoy\n- Fecha fin <= fecha inicio + 1 año\n- Todas las ocupaciones deben existir en GET /ocupaciones\n",
        "operationId": "crearCotizacion",
        "tags": [
          "Accidentes Personales"
        ],
        "security": [
          {
            "CognitoJWT": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CotizacionRequest"
              },
              "example": {
                "ramo": "12",
                "ambito": "LTI",
                "provinciaRiesgo": "02",
                "porcentajeComisionProductor": 10,
                "cuit": "30666048918",
                "condicionIVA": "IN",
                "fechaInicioVigencia": "2026-10-01",
                "fechaFinVigencia": "2027-09-30",
                "coberturas": [
                  {
                    "codigo": "MUE",
                    "suma": 400000,
                    "deducible": 0,
                    "plazo": 1,
                    "espera": 1
                  },
                  {
                    "codigo": "ITP",
                    "suma": 400000,
                    "deducible": 0,
                    "plazo": 1,
                    "espera": 1
                  },
                  {
                    "codigo": "GAME",
                    "suma": 40000,
                    "deducible": 0,
                    "plazo": 1,
                    "espera": 1
                  }
                ],
                "asegurados": [
                  {
                    "ocupacion": "13001",
                    "cantidad": 1
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cotización generada exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CotizacionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Sistema",
      "description": "Endpoints de infraestructura"
    },
    {
      "name": "Productor",
      "description": "Información y contexto del productor autenticado"
    },
    {
      "name": "Accidentes Personales",
      "description": "Operaciones del ramo Accidentes Personales (AP)"
    }
  ]
}
