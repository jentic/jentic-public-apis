{"openapi":"3.1.0","info":{"title":"Clypmint API","version":"1.1.0","description":"Everything the Clypmint MCP tools do, over HTTP: make videos from footage, links or words; change them in words, by scene or caption; plan, make and schedule a month of posts. Start an edit to get a private upload link for the video, then check the video until it is ready. Spending calls say their credit cost and take dry_run: true to price a request first."},"servers":[{"url":"https://clypmint.com/api/v1"}],"security":[{"bearerAuth":[]}],"paths":{"/styles":{"get":{"summary":"List styles","security":[{},{"bearerAuth":[]}],"responses":{"200":{"description":"Styles","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StyleList"}}}},"503":{"description":"Clypmint is busy. Try again in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"post":{"summary":"Copy a style from a reference video link","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"reference_url":{"type":"string","format":"uri"},"name":{"type":"string","maxLength":60}},"required":["reference_url"],"additionalProperties":false}}}},"responses":{"200":{"description":"Style copy started","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StyleCopy"}}}},"400":{"description":"The request is invalid. The message names each field to fix.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"A valid bearer token (API key or OAuth access token) is required.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"This account has no allowance left for this, or does not include it. error.checkout_url is where to add it.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"This needs publishing permission (scope clypmint.publish), or is not open on this account yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"The video, upload, memory or calendar was not found in this account.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Busy: an upload or edit is already running, the video changed, or too many upload links are waiting.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"The request body is too large.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Clypmint could not apply it as asked; error.problems names each part.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"A daily limit was reached (direct edits, caption fixes, upload links).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"501":{"description":"This is not available on Clypmint yet; the message says what to use instead.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Clypmint is busy. Try again in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/videos":{"get":{"summary":"List up to 20 recent videos","responses":{"200":{"description":"Videos","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VideoList"}}}},"400":{"description":"The request is invalid. The message names each field to fix.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"A valid bearer token (API key or OAuth access token) is required.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"This account has no allowance left for this, or does not include it. error.checkout_url is where to add it.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"This needs publishing permission (scope clypmint.publish), or is not open on this account yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"The video, upload, memory or calendar was not found in this account.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Busy: an upload or edit is already running, the video changed, or too many upload links are waiting.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"The request body is too large.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Clypmint could not apply it as asked; error.problems names each part.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"A daily limit was reached (direct edits, caption fixes, upload links).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"501":{"description":"This is not available on Clypmint yet; the message says what to use instead.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Clypmint is busy. Try again in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}},"post":{"summary":"Start a video edit: a private upload link for the video, or footage from source_url","description":"The full brief of the MCP tool edit_video: purpose, hooks, shorts (or \"all\"), formats, sound_effects, speaker_name, instructions (8,000 characters), asset_ids, music_staging_key, style_id/style_version, source_url, or clips to cut a long recording into clips. format: vertical/horizontal still works. Cost: 3 credits to make, plus 1 for each started minute of footage and 1 for each started minute of finished video after the first, plus 2 for each extra hook, length or format and 2 for each clip; dry_run: true answers it first.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"operation_id":{"type":"string","pattern":"^[a-zA-Z0-9_.:-]{1,100}$","description":"A stable ID for this request. Preserve it on retries. Use a new ID only for a deliberate new request."},"purpose":{"type":"string","enum":["organic","ad","youtube","sales_page"],"description":"organic (a post), ad (three openings by default), youtube (horizontal), sales_page."},"hooks":{"description":"Openings to make (1-3): an ad gets 3 by default, the main cut counting as one.","type":"integer","minimum":1,"maximum":3},"shorts":{"description":"Shorts to cut from the recording too (0-10), or 'all' the good ones.","anyOf":[{"type":"integer","minimum":0,"maximum":10},{"type":"string","enum":["all"]}]},"style_id":{"type":"string","pattern":"^[a-z0-9-]{1,40}$","description":"A style id from browse_styles, e.g. serif-editorial-launch, bold-navy-statement, crimson-serif-explainer, warm, luxe, brand, or a saved style of your own (my-...)."},"style_version":{"type":"integer","minimum":1,"maximum":10000},"reference_url":{"description":"A video to make this edit LIKE (a public https link from Instagram, TikTok, X, Facebook, Loom or LinkedIn): Clypmint copies its style beside the upload, saves it to the user's styles, and the edit waits for it. Use it when the user says \"like this one\"; leave style_id out. reference_mode picks how.","type":"string","maxLength":2048,"format":"uri"},"reference_mode":{"description":"How to copy reference_url. clone (the default): deep, copies the reference's own motion and captions; slower, uses one of the monthly style copies, then credits. match: fast and approximate, included.","type":"string","enum":["clone","match"]},"kind":{"type":"string","enum":["talking","montage"],"description":"talking: someone speaks and their words lead the cut (talking head, interview, podcast, tutorial). montage: the pictures and the music lead (sport, action, travel, events, scenery, b-roll); what people say is not followed. Leave out when unsure: Clypmint decides from the footage."},"length":{"type":"object","properties":{"min_seconds":{"type":"integer","minimum":5,"maximum":3600},"max_seconds":{"type":"integer","minimum":5,"maximum":3600}},"required":["max_seconds"],"additionalProperties":false,"description":"How long the finished video should be. \"45-60 s\" is {min_seconds: 45, max_seconds: 60}; \"under a minute\" is {max_seconds: 60}; \"about 30 s\" is {min_seconds: 25, max_seconds: 35}. Leave out when the user named no length."},"camera_sound":{"type":"string","enum":["keep","mute"],"description":"The footage's own sound. mute: only the song plays (the default for a montage with a song). keep: the camera sound stays (the default otherwise)."},"instructions":{"description":"Anything else the user asked for, in their own words, usually one or two sentences. Length, kind, song, style and formats go in their own fields, not here. Clypmint watches the footage itself: do not describe the footage, write rules or explain how to edit. Kept in full.","type":"string","maxLength":8000},"format":{"description":"The older one-shape switch; formats says more.","type":"string","enum":["vertical","horizontal"]},"title":{"type":"string","maxLength":120},"formats":{"description":"Only when the user asked for a shape: vertical, TikTok, Reels or Shorts is 9:16; square is 1:1; 4:5; YouTube or widescreen is 16:9. Every shape to make, the main one first. Leave it out otherwise: the video keeps its own shape and nothing is cropped.","minItems":1,"maxItems":4,"type":"array","items":{"type":"string","enum":["9:16","16:9","1:1","4:5"]}},"sound_effects":{"description":"true: sound effects on the edit.","type":"boolean"},"voice":{"type":"string","enum":["matilda","sarah","jessica","alice","liam","chris","brian","george","roger","laura","charlie","river","will","eric","bella","daniel","lily","bill","adam","callum","harry"],"description":"The narrator for a video made from words: matilda, sarah, jessica, alice, liam, chris, brian, george, roger, laura, charlie, river, will, eric, bella, daniel, lily, bill, adam, callum, harry (sarah: calm, reassuring, health and money; alice: a clear British educator; brian: deep documentary; liam: energetic ads). Leave out to let Clypmint pick one that fits the words. \"Voice: <name>\" in instructions does the same."},"speaker_name":{"description":"Who is talking, spelled right, e.g. \"Dr. Ana Ruiz\".","type":"string","minLength":1,"maxLength":80},"speaker_company":{"description":"The speaker's company or business, spelled exactly for this video.","type":"string","minLength":1,"maxLength":80},"names":{"description":"Exact person, company and product names to spell correctly in this video; not a lasting account rule.","maxItems":50,"type":"array","items":{"type":"string","minLength":1,"maxLength":80}},"spellings":{"description":"Explicit heard-to-correct spelling pairs for this video, for example {\"KMAC\":\"KMAK\"}.","type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":80},"additionalProperties":{"type":"string","minLength":1,"maxLength":80}},"asset_ids":{"maxItems":50,"type":"array","items":{"type":"string","pattern":"^src_[A-Za-z0-9][A-Za-z0-9_-]{7,95}$"}},"asset_staging_keys":{"maxItems":50,"type":"array","items":{"type":"string","pattern":"^stg_[A-Za-z0-9][A-Za-z0-9_-]{7,95}$"}},"music_staging_key":{"description":"The song for this video, from import_asset (mp3, wav or m4a): a montage's soundtrack, or music under the speech.","type":"string","pattern":"^stg_[A-Za-z0-9][A-Za-z0-9_-]{7,95}$"},"song_upload":{"description":"true when the user has a song file but no public link to it (a song attached in Claude, a file on their computer): the private upload link asks for the video and the song together. Leave out when music_staging_key is set.","type":"boolean"},"source_url":{"description":"A public https link to the footage (where links are open), instead of a file.","type":"string","maxLength":2048,"format":"uri"},"footage_from":{"description":"The video_id of a video already made from this footage: a new edit of the same footage with no new upload (another kind, length or style). To change that video itself, use revise_video or apply_edits instead.","type":"string","pattern":"^prj_[A-Za-z0-9_-]{6,96}$"},"source_duration_seconds":{"type":"number","exclusiveMinimum":0,"maximum":21600},"clips":{"type":"object","properties":{"count":{"anyOf":[{"type":"integer","minimum":1,"maximum":30},{"type":"string","enum":["all"]}],"description":"How many clips (1-30), or 'all' the good ones."},"min_seconds":{"type":"integer","minimum":10,"maximum":95},"max_seconds":{"type":"integer","minimum":10,"maximum":95},"shape":{"description":"source keeps the recording's shape; 9:16 cuts each clip vertical on the speaker.","type":"string","enum":["source","9:16"]},"from_seconds":{"type":"number","minimum":0,"maximum":21600},"to_seconds":{"type":"number","exclusiveMinimum":0,"maximum":21600},"about":{"description":"Topics to look for first, in plain words.","type":"string","minLength":2,"maxLength":300}},"required":["count"],"additionalProperties":false,"description":"Clips alone from one recording (no main film): podcasts, streams, long talks."},"dry_run":{"description":"true: answer the credit cost and start nothing.","type":"boolean"}},"additionalProperties":false},"example":{"purpose":"ad","hooks":3,"formats":["9:16","1:1"],"sound_effects":true,"instructions":"Lead with the price. Spell the brand ClipMint."}}}},"responses":{"200":{"description":"Upload link ready; editing starts when the video arrives","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VideoStatus"}}}},"400":{"description":"The request is invalid. The message names each field to fix.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"A valid bearer token (API key or OAuth access token) is required.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"This account has no allowance left for this, or does not include it. error.checkout_url is where to add it.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"This needs publishing permission (scope clypmint.publish), or is not open on this account yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"The video, upload, memory or calendar was not found in this account.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Busy: an upload or edit is already running, the video changed, or too many upload links are waiting.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"The request body is too large.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Clypmint could not apply it as asked; error.problems names each part.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"A daily limit was reached (direct edits, caption fixes, upload links).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"501":{"description":"This is not available on Clypmint yet; the message says what to use instead.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Clypmint is busy. Try again in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/videos/{id}":{"get":{"summary":"Check a video (its id) or an upload (an id starting with imp_)","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}},{"name":"with_download","in":"query","required":false,"schema":{"type":"boolean","default":true},"description":"false: leave out the 15-minute download link (playback only)."}],"responses":{"200":{"description":"Video status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/VideoStatus"}}}},"400":{"description":"The request is invalid. The message names each field to fix.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"A valid bearer token (API key or OAuth access token) is required.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"This account has no allowance left for this, or does not include it. error.checkout_url is where to add it.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"This needs publishing permission (scope clypmint.publish), or is not open on this account yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"The video, upload, memory or calendar was not found in this account.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Busy: an upload or edit is already running, the video changed, or too many upload links are waiting.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"The request body is too large.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Clypmint could not apply it as asked; error.problems names each part.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"A daily limit was reached (direct edits, caption fixes, upload links).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"501":{"description":"This is not available on Clypmint yet; the message says what to use instead.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Clypmint is busy. Try again in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/videos/{id}/changes":{"post":{"summary":"Ask for a change to a finished video in plain words","description":"Uses an included change round, never credits. output_id selects one output. Optional voice replaces retained main scratch narration only, preserving script/edit with 'Change narrator to Brian. Keep the script and edit.' (selected name). Send other edits separately; unsupported/mixed narration changes return422.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"change":{"type":"string","minLength":1,"maxLength":2000},"output_id":{"type":"string","maxLength":200},"operation_id":{"type":"string","maxLength":100},"base_version":{"type":"string","maxLength":200},"voice":{"type":"string","enum":["matilda","sarah","jessica","alice","liam","chris","brian","george","roger","laura","charlie","river","will","eric","bella","daniel","lily","bill","adam","callum","harry"],"description":"Retained main scratch narration only; use a voice-only change."},"dry_run":{"type":"boolean"}},"required":["change"],"additionalProperties":false},"example":{"change":"Open on the price","output_id":"hook-2-9x16"}}}},"responses":{"200":{"description":"Change requested, or why it cannot be","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Change"}}}},"400":{"description":"The request is invalid. The message names each field to fix.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"A valid bearer token (API key or OAuth access token) is required.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"This account has no allowance left for this, or does not include it. error.checkout_url is where to add it.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"This needs publishing permission (scope clypmint.publish), or is not open on this account yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"The video, upload, memory or calendar was not found in this account.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Busy: an upload or edit is already running, the video changed, or too many upload links are waiting.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"The request body is too large.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Clypmint could not apply it as asked; error.problems names each part.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"A daily limit was reached (direct edits, caption fixes, upload links).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"501":{"description":"This is not available on Clypmint yet; the message says what to use instead.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Clypmint is busy. Try again in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/me":{"get":{"summary":"Get the account profile, its credits and videos used this month","responses":{"200":{"description":"Profile","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Profile"}}}},"400":{"description":"The request is invalid. The message names each field to fix.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"A valid bearer token (API key or OAuth access token) is required.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"This account has no allowance left for this, or does not include it. error.checkout_url is where to add it.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"403":{"description":"This needs publishing permission (scope clypmint.publish), or is not open on this account yet.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"The video, upload, memory or calendar was not found in this account.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"Busy: an upload or edit is already running, the video changed, or too many upload links are waiting.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"413":{"description":"The request body is too large.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Clypmint could not apply it as asked; error.problems names each part.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"A daily limit was reached (direct edits, caption fixes, upload links).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"501":{"description":"This is not available on Clypmint yet; the message says what to use instead.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"503":{"description":"Clypmint is busy. Try again in a moment.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/videos/{id}/edits":{"post":{"operationId":"apply_edits","summary":"Apply direct edits to scenes by id","description":"Apply exact edits without a Clypmint model round. Read get_project_context first. Canvas ops: output_frame {frame: {ratio: 9:16, 16:9, 1:1 or 4:5, fit}} reshapes this video (\"make it vertical\"); fit subject (the default) follows the subject, contain keeps the whole picture with bars (only when they ask to fit or keep everything in), cover fills; optional x/y (0-1, with fit cover only) move the centre of the filled frame; add: true makes the shape an extra output and keeps this one (\"a square version too\"); frame: null alone (no second op) is the original shape again (\"undo the crop\"); layout moves/scales/rotates a returned element ID using its units; element changes supported text/color/hidden; put_overlay adds or updates timed text/images with none/fade/slide/pop animation; remove_overlay removes an added element. Use only returned editable capabilities and existing canvas image assetIds. These are the manual editor operations and preserve authored animation. Music: {op:\"music\",enabled:false} removes only added music; enabled:true with track (one of Clypmint's own tracks, never claimed when posted: bright-house (upbeat), lofi-desk (calm), tech-forward (tech), documentary-pulse (story), gym-phonk (energetic), acoustic-morning (warm), soft-piano (emotional), funk-pop (fun), night-suspense (mystery), rise-up (inspiring)) or with music_staging_key from import_asset (a song of their own). Optional level_db (-36 to 0 relative to source audio) and beat_sync:true for source-shot action montages; other editing clocks refuse beat sync explicitly. Scene ops: remove, remove_layer, replace_screen, set_text, swap_picture (an existing picture key), move, add, cut_words, emphasis, captions, sound, scene_sounds. remove and cut_words take footage time out of the video; to delete a graphic and keep the footage and captions under it use remove_layer {layer: graphic}, to delete a zoom or camera move remove_layer {layer: camera}, and to shorten or lengthen a graphic move its scene to fewer or more words. scene_sounds replaces the scene cue list (empty removes added cues): choose names from scenes.soundOptions, optional on from soundWords.index and gain -36 to -10 dB. It preserves speech; global sound mute still applies. Batch up to 40 ops: all apply or all refuse. Native canvas changes save a playable project; export separately for a video file. Older timeline operations may require rendering; unsupported native operations refuse without rebuilding the project. Set base_version and output_id from context. Hook openings use revise_video. Free, up to 30 a day. Preserve operation_id and exact arguments on retries. Cost: Free: no credits. Same as the MCP tool apply_edits.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"base_version":{"description":"The version the edits are for; the current one when left out.","type":"string","minLength":1,"maxLength":200},"output_id":{"description":"One output (a hook, a Short, a format) from check_video; the main film when left out.","type":"string","minLength":1,"maxLength":200},"operation_id":{"type":"string","pattern":"^[a-zA-Z0-9_.:-]{1,100}$","description":"A stable ID for this request. Preserve it on retries. Use a new ID only for a deliberate new request."},"ops":{"minItems":1,"maxItems":40,"type":"array","items":{"anyOf":[{"type":"object","properties":{"op":{"type":"string","const":"remove"},"scene_id":{"type":"string","minLength":1,"maxLength":120,"description":"A scene id (sceneId) from get_project_context."}},"required":["op","scene_id"],"additionalProperties":false},{"type":"object","properties":{"op":{"type":"string","const":"remove_layer"},"scene_id":{"type":"string","minLength":1,"maxLength":120,"description":"A scene id (sceneId) from get_project_context."},"layer":{"type":"string","enum":["graphic","camera"]}},"required":["op","scene_id","layer"],"additionalProperties":false},{"type":"object","properties":{"op":{"type":"string","const":"replace_screen"},"scene_id":{"type":"string","minLength":1,"maxLength":120,"description":"A scene id (sceneId) from get_project_context."},"screen":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"A screen in the shape get_project_context shows for that scene."}},"required":["op","scene_id","screen"],"additionalProperties":false},{"type":"object","properties":{"op":{"type":"string","const":"set_text"},"scene_id":{"type":"string","minLength":1,"maxLength":120,"description":"A scene id (sceneId) from get_project_context."},"path":{"type":"string","minLength":1,"maxLength":80,"description":"Which text, e.g. 'screen.title'."},"text":{"type":"string","maxLength":600}},"required":["op","scene_id","path","text"],"additionalProperties":false},{"type":"object","properties":{"op":{"type":"string","const":"swap_picture"},"scene_id":{"type":"string","minLength":1,"maxLength":120,"description":"A scene id (sceneId) from get_project_context."},"asset_id":{"type":"string","minLength":1,"maxLength":200,"description":"A picture key this version already uses (a scene's picture from get_project_context), not a library asset id."}},"required":["op","scene_id","asset_id"],"additionalProperties":false},{"type":"object","properties":{"op":{"type":"string","const":"move"},"scene_id":{"type":"string","minLength":1,"maxLength":120,"description":"A scene id (sceneId) from get_project_context."},"words":{"minItems":2,"maxItems":2,"type":"array","items":{"type":"integer","minimum":0,"maximum":9007199254740991},"description":"[first, last] word numbers from the transcript in get_project_context."}},"required":["op","scene_id","words"],"additionalProperties":false},{"type":"object","properties":{"op":{"type":"string","const":"add"},"after":{"anyOf":[{"type":"string","minLength":1,"maxLength":120,"description":"A scene id (sceneId) from get_project_context."},{"type":"null"}],"description":"The scene it follows; null for the start."},"scene":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"The new scene, shaped like the others."}},"required":["op","after","scene"],"additi