              "string",
              "null"
            ],
            "format": "date-time"
          },
          "authority": {
            "type": "string"
          }
        }
      },
      "Decision": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "proceed",
              "review",
              "stop",
              "insufficient_data"
