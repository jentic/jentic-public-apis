      "Receipt": {
        "type": "object",
        "properties": {
          "receipt_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "statement": {
            "type": "object",
            "description": "Exactly what was signed: type, version, receipt_id, issued_at, issuer, entity, inputs, decision, rules_version, reasons (code, met, effect, fact_ids, source, verified_at, fresh_until), facts (id, predicate, source, value_sha256, verified_at), terms."
          },
          "signature": {
            "type": "object",
            "properties": {
              "alg": {
                "const": "Ed25519"
              },
              "kid": {
                "type": "string"
              },
              "canonicalization": {
                "const": "sorted-keys-json"
              },
              "sig": {
