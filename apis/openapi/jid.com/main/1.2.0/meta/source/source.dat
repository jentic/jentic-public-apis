            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Reason": {
        "type": "object",
        "required": [
          "code",
          "requirement",
          "met",
          "fact_ids"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "requirement": {
            "type": "string"
