              {
                "type": "boolean"
              },
              {
                "type": "string",
                "const": "unknown"
              }
            ]
          },
          "effect": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "stop",
              "review",
              null
            ]
          },
          "detail": {
            "type": "string"
          },
          "fact_ids": {
            "type": "array",
