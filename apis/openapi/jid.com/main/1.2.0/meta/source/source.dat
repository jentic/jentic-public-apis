{
  "openapi": "3.1.0",
  "info": {
    "title": "Jid API",
    "version": "1.2.0",
    "summary": "The trust API for AI agents.",
    "description": "Before an agent pays, signs, books, hires or buys, Jid checks the business it is dealing with: real, active, licensed for this activity, not sanctioned, with the receipts. Every fact is cited to the registry that issued it. Decisions apply the published rules (https://jid.com/decision-rules, version 2026-10-09.1) and are not legal advice. No key: 10 requests a minute and 100 a day per IP. A free key (no card) includes 1,000 checks a month. Business information only; not a consumer report and not for FCRA purposes.",
    "termsOfService": "https://jid.com/api-terms",
    "contact": {
      "name": "Jid",
      "email": "hello@jid.com",
      "url": "https://jid.com"
    }
  },
  "externalDocs": {
    "description": "API reference",
    "url": "https://jid.com/api-docs"
  },
  "servers": [
    {
      "url": "https://jid.com"
    }
  ],
  "security": [
    {},
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "verify",
      "description": "Decisions, files and receipts"
    },
    {
      "name": "search"
    },
    {
      "name": "monitors",
      "description": "Change monitoring with signed webhooks"
    },
    {
      "name": "qualify",
      "description": "B2B lead and counterparty qualification"
    },
    {
      "name": "screen",
      "description": "Engage or not: a fast, deterministic answer for a lead, sender, vendor or website"
    }
  ],
  "paths": {
    "/v1/search": {
      "get": {
        "tags": [
          "search"
        ],
        "operationId": "searchBusinesses",
        "summary": "Resolve a name or registry number to candidate files",
        "description": "Free (not a check). Identifiers first (FEI, LEI, CIK, DUNS, NDC labeler, USDOT, NPI, EIN, UEI, state numbers), then name: exact, begins with, contains, similar.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/entities/{id}/verify": {
      "get": {
        "tags": [
          "verify"
        ],
        "operationId": "verifyBusiness",
        "summary": "Verify a business before acting; with an activity, get a decision and a signed receipt",
        "description": "One check. Without activity, jurisdiction or amount: status, flags and every current fact with its receipts (unchanged since 1.0). With any of them: also `decision` (proceed | review | stop | insufficient_data) with reasons, and `receipt` (stored 13 months, Ed25519-signed). Act only on proceed; requirements Jid cannot check are unknown and lead to review.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Jid file id, as returned by search (e.g. gland-pharma-limited-j9nehi).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "activity",
            "in": "query",
            "required": false,
            "description": "What the business is about to do for you. Default general_commerce when jurisdiction or amount is given. Rules: https://jid.com/decision-rules",
            "schema": {
              "type": "string",
              "enum": [
                "general_commerce",
                "sell_prescription_drugs",
                "manufacture_drugs",
                "sell_medical_devices",
                "haul_freight",
                "broker_freight",
                "sell_alcohol",
                "produce_spirits",
                "provide_investment_advice",
                "accept_deposits",
                "lend",
                "bill_medicare_medicaid",
                "healthcare_supplier",
                "federal_contracting",
                "charitable_solicitation",
                "construction",
                "operate_psilocybin_healing_center"
              ]
            }
          },
          {
            "name": "jurisdiction",
            "in": "query",
            "required": false,
            "description": "US state as US-XX (e.g. US-CO) or ISO 3166-1 alpha-2 country code.",
            "schema": {
              "type": "string",
              "pattern": "^(US-[A-Z]{2}|[A-Z]{2})$"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "required": false,
            "description": "Transaction amount. Context only: recorded on the receipt, never changes the rules.",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "ISO 4217 code for amount. Default USD.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file, and the decision when requested",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/entities/{id}": {
      "get": {
        "tags": [
          "verify"
        ],
        "operationId": "getBusinessFile",
        "summary": "The full file: verify plus location, owner statements, possible matches and the last 50 change events",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Jid file id, as returned by search (e.g. gland-pharma-limited-j9nehi).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/receipts/{receipt_id}": {
      "get": {
        "tags": [
          "verify"
        ],
        "operationId": "getReceipt",
        "summary": "Retrieve a signed verification receipt",
        "description": "Free; not a check. Readable by anyone holding the receipt id, so it can be shown to an auditor or counterparty. Verify `signature.sig` over the canonical statement with the key at /.well-known/jid-keys.json.",
        "parameters": [
          {
            "name": "receipt_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^rcpt_[A-Za-z0-9]{22}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/screen": {
      "get": {
        "tags": [
          "screen"
        ],
        "operationId": "screenGet",
        "summary": "Should you engage? (query parameters)",
        "description": "Same as POST /v1/screen, with the fields as query parameters.",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "phone",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company_name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "context",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "policy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ip_country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ip_region",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ip_asn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "browser_timezone",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stated_country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "signal",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "site",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Screen result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScreenResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "tags": [
          "screen"
        ],
        "operationId": "screen",
        "summary": "Should you engage? A fast, deterministic engage-or-not answer",
        "description": "No key: free tier (rate-limited per IP). With a key: 1 check. No AI in the decision. Pass any of domain, url, email, phone or company_name; the context; an amount; a policy. Returns engage (true/false), risk, confidence, subject_type, reasons with sources, mitigations, checks, a read (headline, engage | verify_first | do_not_engage, failed checks, lookup links: render the read for humans), the matched Jid file and a signed receipt. Hard rules (engage=false under every policy): confirmed exclusion, possible sanctions or export-list name match (manual review, never a finding), registry hard failure, phishing or malware listing, disposable e-mail, domain with no MX and no website, domain under 30 days old with an amount of $1,000 or more, and (strict only) an affiliation mismatch. Individuals get technical signals only. engage is advisory. Rules version 2026-10-05.2: https://jid.com/screen-rules",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "domain": {
                    "type": "string",
                    "maxLength": 253
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "Only the host is used."
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 40,
                    "description": "Ideally +E.164."
                  },
                  "company_name": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "A person's name: accepted, never looked up."
                  },
                  "context": {
                    "type": "string",
                    "enum": [
                      "lead",
                      "inbound_email",
                      "partnership",
                      "vendor",
                      "purchase",
                      "marketplace_seller",
                      "agent_action"
                    ],
                    "description": "Default lead, or purchase when only a url or domain is given."
                  },
                  "policy": {
                    "type": "string",
                    "enum": [
                      "strict",
                      "balanced",
                      "permissive"
                    ],
                    "default": "balanced"
                  },
                  "amount": {
                    "type": "number",
                    "minimum": 0,
                    "description": "USD at stake"
                  },
                  "country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$",
                    "description": "Default country for a phone number without +"
                  },
                  "retain": {
                    "type": "boolean",
                    "description": "Keep the receipt 13 months instead of 30 days"
                  },
                  "ip_country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$",
                    "description": "Location check: country of the request (e.g. x-vercel-ip-country)"
                  },
                  "ip_region": {
                    "type": "string",
                    "description": "Location check: ISO 3166-2 region of the request"
                  },
                  "ip_city": {
                    "type": "string",
                    "description": "Accepted, not compared, not stored"
                  },
                  "ip_asn": {
                    "type": "integer",
                    "description": "Location check: ASN of the request's network (hosting/VPN recognition)"
                  },
                  "ip": {
                    "type": "string",
                    "description": "Optional raw IP: used in memory for the Tor and ASN lookups only, never stored or returned"
                  },
                  "browser_timezone": {
                    "type": "string",
                    "description": "Location check: IANA time zone from the browser"
                  },
                  "stated_country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$",
                    "description": "Location check: the country the counterparty stated"
                  },
                  "signal": {
                    "type": "string",
                    "description": "Jid Signals token from the visitor's browser (the jid_signal form field set by https://jid.com/s/1.js; jid_signal is also accepted). When it verifies, its country, region, city, network type and time zone replace the ip_* fields and browser_timezone. Expired, altered or other-site tokens are skipped, never negative. See /signals."
                  },
                  "site": {
                    "type": "string",
                    "description": "The submitting website's domain. Binds the signal token loosely: a token issued to another site is skipped."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Screen result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScreenResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/email-check": {
      "post": {
        "tags": [
          "screen"
        ],
        "operationId": "emailCheck",
        "summary": "Is this e-mail really from who it says? (raw headers in, checks and read out)",
        "description": "No key: free tier (rate-limited per IP). With a key: 1 check. Reads the receiving server's Authentication-Results (SPF, DKIM, DMARC), Received-SPF, DKIM alignment with From, Reply-To vs From, and whether the From domain or a business display name imitates a known company's registered domain. Returns checks and a read (headline, engage | verify_first | do_not_engage, failed checks, lookup links), the From and Reply-To domains and the authentication results. The headers are processed in memory and never stored. Deterministic, no AI.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "headers"
                ],
                "properties": {
                  "headers": {
                    "type": "string",
                    "maxLength": 65536,
                    "description": "The raw message headers (Show original / View source); the body is not needed."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checks and read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/signal": {
      "get": {
        "operationId": "signal",
        "summary": "Jid Signals: a 30-minute signed location token for the visitor (call from the browser)",
        "description": "Called from the visitor's browser by https://jid.com/s/1.js. Jid reads the connection's country, region, city and network type itself and returns an HMAC-signed token (never the IP) for the form to forward to /v1/qualify or /v1/screen as `signal`. No key, CORS open, never cached, rate-limited per IP. See https://jid.com/signals.",
        "parameters": [
          {
            "name": "tz",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Browser IANA time zone"
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "signal": {
                      "type": "string"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "ttl": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/outcomes": {
      "post": {
        "tags": [
          "qualify"
        ],
        "operationId": "recordOutcome",
        "summary": "Record what you decided about a screen or qualify result",
        "description": "With the API key that ran the result: { result_id, outcome, note? }. Or { token } from a signed outcome link. Free. Stored without personal data for 13 months; outcomes tune the published rules.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "result_id": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "legit",
                      "sales_pitch",
                      "spam",
                      "scam",
                      "closed",
                      "good",
                      "junk",
                      "no_response"
                    ],
                    "description": "legit, sales_pitch, spam and scam on a qualification are also community reports (jid.com/privacy section 2b)."
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 280
                  },
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result_id": {
                      "type": "string"
                    },
                    "outcome": {
                      "type": "string"
                    },
                    "recorded_at": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "410": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/results": {
      "get": {
        "tags": [
          "qualify"
        ],
        "operationId": "getResults",
        "summary": "The read, checks and latest outcome of qualifications this key ran",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated qual_ ids, up to 200"
          }
        ],
        "responses": {
          "200": {
            "description": "Results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/qualify": {
      "post": {
        "tags": [
          "qualify"
        ],
        "operationId": "qualifyCounterparty",
        "summary": "Qualify a business lead or counterparty from a form submission or outreach",
        "description": "API key required; counts as 2 checks. Checks the domain (MX, SPF, DMARC, RDAP registration date, one website fetch), matches it to a Jid file and reads the file's standing, licences, filings, capital raises, loans and adverse records. Returns signals with sources, legitimacy/capacity/consistency scores (0 to 100, with reasons), a recommendation, a next step, questions to ask, checks and a read (headline, engage | verify_first | do_not_engage, failed checks, lookup links: render the read for humans), and a signed receipt. Businesses only: personal webmail, a disposable address or no confident business match returns assessment individual_or_unverified with no scores. A possible list match is effect review, never a finding. The raw message is hashed and never stored unless retain is true. Not for credit, employment, insurance or housing decisions about individuals.",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "domain": {
                    "type": "string",
                    "maxLength": 253
                  },
                  "company_name": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "context": {
                    "type": "object",
                    "properties": {
                      "form_type": {
                        "type": "string",
                        "enum": [
                          "seller_application",
                          "acquisition_inquiry",
                          "buyer_registration",
                          "nda_request",
                          "sourcing_request",
                          "listing_request",
                          "consultation",
                          "partnership",
                          "contact",
                          "other",
                          "vendor_claim",
                          "listing_claim",
                          "sponsor_inquiry",
                          "advertiser",
                          "broker_request",
                          "buyer_inquiry",
                          "seller_inquiry",
                          "data_purchase"
                        ]
                      },
                      "message": {
                        "type": "string",
                        "maxLength": 5000
                      },
                      "stated_value": {
                        "type": "number",
                        "minimum": 0,
                        "description": "USD"
                      },
                      "stated_role": {
                        "type": "string",
                        "enum": [
                          "buyer",
                          "seller",
                          "supplier",
                          "investor",
                          "operator"
                        ]
                      },
                      "country": {
                        "type": "string",
                        "pattern": "^[A-Z]{2}$"
                      },
                      "activity": {
                        "type": "string",
                        "enum": [
                          "general_commerce",
                          "sell_prescription_drugs",
                          "manufacture_drugs",
                          "sell_medical_devices",
                          "haul_freight",
                          "broker_freight",
                          "sell_alcohol",
                          "produce_spirits",
                          "provide_investment_advice",
                          "accept_deposits",
                          "lend",
                          "bill_medicare_medicaid",
                          "healthcare_supplier",
                          "federal_contracting",
                          "charitable_solicitation",
                          "construction",
                          "operate_psilocybin_healing_center"
                        ]
                      },
                      "claimed_website": {
                        "type": "string",
                        "description": "vendor_claim / listing_claim: the website of the business or listing being claimed. Enables the affiliation check."
                      },
                      "stated_location": {
                        "type": "string",
                        "maxLength": 80,
                        "description": "The place or market the sender stated (\"Jakarta\"): shown on read.sender, never stored"
                      }
                    }
                  },
                  "ip_country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$",
                    "description": "Location check: country of the request (e.g. x-vercel-ip-country). Stored."
                  },
                  "ip_region": {
                    "type": "string",
                    "description": "Location check: ISO 3166-2 region of the request (US-CA or CA). Stored."
                  },
                  "ip_city": {
                    "type": "string",
                    "description": "Accepted, not compared, not stored, not returned"
                  },
                  "ip_asn": {
                    "type": "integer",
                    "description": "Location check: ASN of the request's network (hosting/VPN recognition). Not stored."
                  },
                  "browser_timezone": {
                    "type": "string",
                    "description": "Location check: IANA time zone from the browser. Compared, not stored."
                  },
                  "stated_country": {
                    "type": "string",
                    "pattern": "^[A-Z]{2}$",
                    "description": "Location check: the country the submitter stated (same as context.country; either may be sent)"
                  },
                  "ip": {
                    "type": "string",
                    "description": "Optional raw IP: used in memory for the Tor and network lookups (Jid's Tor and GeoLite2 copies; IPinfo when enabled). Never stored, hashed or returned."
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 40,
                    "description": "Optional business phone: validity and country code (compared with the location), in memory only, never stored"
                  },
                  "signal": {
                    "type": "string",
                    "description": "Jid Signals token from the visitor's browser (the jid_signal form field set by https://jid.com/s/1.js; jid_signal is also accepted). When it verifies, its country, region, city, network type and time zone replace the ip_* fields and browser_timezone. Expired, altered or other-site tokens are skipped, never negative. See /signals."
                  },
                  "site": {
                    "type": "string",
                    "description": "The submitting website's domain. Binds the signal token loosely: a token issued to another site is skipped."
                  },
                  "summary": {
                    "type": "boolean",
                    "description": "Add a short summary written only from the signals."
                  },
                  "policy": {
                    "type": "string",
                    "enum": [
                      "strict",
                      "balanced",
                      "permissive"
                    ],
                    "description": "How cautious `engage` is. Default balanced."
                  },
                  "retain": {
                    "type": "boolean",
                    "description": "Opt in to keeping the message with the result for 13 months (default: hash only, 30 days)."
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "email"
                    ]
                  },
                  {
                    "required": [
                      "domain"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Qualification",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Qualification"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/activities": {
      "get": {
        "tags": [
          "verify"
        ],
        "operationId": "listActivities",
        "summary": "The published decision rules: activities, requirements, legal basis",
        "responses": {
          "200": {
            "description": "Rules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/monitors": {
      "get": {
        "tags": [
          "monitors"
        ],
        "operationId": "listMonitors",
        "summary": "List your monitors",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Monitors",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "tags": [
          "monitors"
        ],
        "operationId": "createMonitor",
        "summary": "Watch a file; each change is delivered with old and new values",
        "security": [
          {
            "bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "entity_id"
                ],
                "properties": {
                  "entity_id": {
                    "type": "string"
                  },
                  "webhook_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created. webhook_secret is returned once.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        },
        "callbacks": {
          "events": {
            "{$request.body#/webhook_url}": {
              "post": {
                "summary": "Change events. Headers: Jid-Signature: t=<unix>,v1=<hex HMAC-SHA256(secret, t + '.' + raw body)>; Jid-Delivery: <delivery_id>.",
                "requestBody": {
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/WebhookDelivery"
                      }
                    }
                  }
                },
                "responses": {
                  "2XX": {
                    "description": "Accepted. Anything else is retried on the next run with the same delivery_id."
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "monitors"
        ],
        "operationId": "deleteMonitor",
        "summary": "Delete a monitor",
        "security": [
          {
            "bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "jid_live_... key from https://jid.com/pricing (free key: no card)."
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "ScreenResult": {
        "type": "object",
        "properties": {
          "engage": {
            "type": "boolean"
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "subject_type": {
            "type": "string",
            "enum": [
              "business",
              "individual_or_unverified",
              "website"
            ]
          },
          "summary": {
            "type": "string"
          },
          "hard_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk_points": {
            "type": "number"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "hard",
                    "negative",
                    "positive",
                    "info",
                    "skipped"
                  ]
                },
                "points": {
                  "type": "number"
                },
                "text": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "source_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "checked_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "mitigations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "entity": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "match_confidence": {
                "type": "string"
              },
              "relied_on": {
                "type": "boolean"
              }
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Check"
            }
          },
          "read": {
            "$ref": "#/components/schemas/Read"
          },
          "outcome_links": {
            "$ref": "#/components/schemas/OutcomeLinks"
          },
          "check_runs": {
            "type": "object",
            "description": "Which live lookups ran (this was `checks` before 2026-10-05).",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "done",
                "cached",
                "skipped",
                "not_applicable",
                "failed"
              ]
            }
          },
          "receipt_id": {
            "type": "string"
          },
          "receipt_url": {
            "type": "string"
          },
          "rules_version": {
            "type": "string"
          },
          "latency_ms": {
            "type": "number"
          },
          "checks_used": {
            "type": "number"
          },
          "location": {
            "type": "object",
            "description": "Present when location inputs were given",
            "properties": {
              "consistent": {
                "type": [
                  "boolean",
                  "string"
                ],
                "description": "true, false or \"unknown\""
              },
              "reference": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "signals": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "network": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "tor",
                      "hosting_or_vpn",
                      "other",
                      "unknown"
                    ]
                  },
                  "asn": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              "detail": {
                "type": "string"
              }
            }
          }
        }
      },
      "Qualification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "assessment": {
            "type": "string",
            "enum": [
              "business",
              "individual_or_unverified"
            ]
          },
          "entity": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              "method": {
                "type": "string"
              },
              "relied_on": {
                "type": "boolean"
              },
              "url": {
                "type": "string"
              }
            }
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "value": {},
                "effect": {
                  "type": "string",
                  "enum": [
                    "+",
                    "-",
                    "neutral",
                    "review"
                  ]
                },
                "detail": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "source_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "verified_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "legitimacy": {
            "$ref": "#/components/schemas/SubScore"
          },
          "capacity": {
            "$ref": "#/components/schemas/SubScore"
          },
          "consistency": {
            "$ref": "#/components/schemas/SubScore"
          },
          "recommendation": {
            "type": "string",
            "enum": [
              "fast_track",
              "standard",
              "verify_first",
              "low_priority"
            ]
          },
          "engage": {
            "type": "boolean",
            "description": "Binary answer from the shared screen rules (same as /v1/screen) under `policy`. Advisory."
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "mitigations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              }
            }
          },
          "engage_policy": {
            "type": "string",
            "enum": [
              "strict",
              "balanced",
              "permissive"
            ]
          },
          "suggested_next_step": {
            "type": "string"
          },
          "questions_to_ask": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 4
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Check"
            }
          },
          "read": {
            "$ref": "#/components/schemas/Read"
          },
          "outcome_links": {
            "$ref": "#/components/schemas/OutcomeLinks"
          },
          "affiliation": {
            "type": [
              "object",
              "null"
            ],
            "description": "Claims only: does the address's domain match the claimed business (same domain, a registry domain of the business, or a link between the two websites)? A mismatch means manual review, never rejection.",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "matched",
                  "mismatched",
                  "unknown"
                ]
              },
              "email_domain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "claimed_domain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string"
                    },
                    "source_url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "location": {
            "type": [
              "object",
              "null"
            ],
            "description": "Present when location inputs were given: the same block as /v1/screen. A mismatch, Tor exit or hosting/VPN network adds risk only alongside another negative signal and never sets engage=false on its own. Jid keeps only ip_country, ip_region, network type and consistent.",
            "properties": {
              "consistent": {
                "type": [
                  "boolean",
                  "string"
                ],
                "description": "true, false or \"unknown\""
              },
              "reference": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "signals": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "network": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "tor",
                      "hosting_or_vpn",
                      "other",
                      "unknown"
                    ]
                  },
                  "asn": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              "detail": {
                "type": "string"
              }
            }
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "rules_version": {
            "type": "string"
          },
          "receipt": {
            "$ref": "#/components/schemas/Receipt"
          },
          "retention": {
            "type": "object",
            "properties": {
              "result_until": {
                "type": "string"
              },
              "message_stored": {
                "type": "boolean"
              }
            }
          },
          "checks_used": {
            "type": "integer"
          }
        }
      },
      "Check": {
        "type": "object",
        "description": "One check from the registry. New checks add rows, never fields.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable id: registered, sanctions, threat_feeds, email_address, mail_domain, domain_age, website, affiliation, adverse_records, licence, phone, location, enquiry, funding, complaints, lookalike_domain, email_auth, history"
          },
          "label": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "enum": [
              "identity",
              "legitimacy",
              "safety",
              "location",
              "capacity",
              "history"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "na"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "block",
              "warn",
              "info"
            ],
            "description": "What a fail means: block = do not engage, warn = verify first, info = never changes the recommendation"
          },
          "evidence": {
            "type": "string"
          },
          "lookup": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          },
          "phrase": {
            "type": "string"
          }
        }
      },
      "Read": {
        "type": "object",
        "description": "What to show a human: render this and nothing else.",
        "properties": {
          "headline": {
            "type": "string",
            "examples": [
              "Passed all 7 checks Jid could run. Recommendation: engage.",
              "Passed 6 of 7 checks Jid could run: sanctions failed. Recommendation: do not engage.",
              "Passed all 9 checks Jid could run. Not in an official registry Jid covers (Indonesia), so: verify first."
            ]
          },
          "recommendation": {
            "type": "string",
            "enum": [
              "engage",
              "verify_first",
              "do_not_engage"
            ]
          },
          "passed": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "description": "Checks that ran (status pass or fail) and decide (severity block or warn), plus location consistency, which is counted but never decides"
          },
          "reason": {
            "type": "string",
            "description": "Why a read with no registry match is not engage, e.g. \"Not found on the registers Jid checks for Indonesia (LEI records only)\". Also in the headline, followed by \", so: verify first\"."
          },
          "not_checked": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string"
            },
            "description": "Labels of deciding checks that did not run or did not finish"
          },
          "sender": {
            "type": "string",
            "description": "Qualify only, response only (never stored): the Jid Signals location next to the stated place and the company domain's age"
          },
          "failed": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "lookup": {
                  "type": "object"
                }
              }
            }
          },
          "lookups": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "file_url": {
            "type": "string"
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "OutcomeLinks": {
        "type": "object",
        "description": "Keyed calls only: signed one-click URLs that record an outcome (POST /v1/outcomes) without a login.",
        "properties": {
          "legit": {
            "type": "string"
          },
          "sales_pitch": {
            "type": "string"
          },
          "spam": {
            "type": "string"
          },
          "scam": {
            "type": "string"
          },
          "closed": {
            "type": "string"
          },
          "good": {
            "type": "string",
            "description": "2026-10-05 button, still accepted"
          },
          "junk": {
            "type": "string",
            "description": "2026-10-05 button, still accepted"
          }
        }
      },
      "SubScore": {
        "type": "object",
        "properties": {
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "null when assessment is individual_or_unverified"
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "points": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
