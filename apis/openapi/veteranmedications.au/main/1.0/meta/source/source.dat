{
  "openapi": "3.0.1",
  "info": {
    "title": "Apex Customer API",
    "version": "1.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/LightstormGlobal/ApexCustomer/1.0"
  },
  "servers": [
    {
      "url": "https://veteranmedications.au/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/ApexCustomer": {
      "get": {
        "summary": "query existing customer IDs based on demographics and key dates",
        "description": "supports the following parameter combinations:\n- chartedFrom and chartedTo - find new customers based on charted date.\n- hasChangesSince - find customers with medication changes since specified date.\n- firstname, lastname, email, medicareCardNumber, dvaCardNumber, and/or dob - find customers based on customer data, any combination of available parameters can be used.\n",
        "tags": [
          "ApexCustomer"
        ],
        "parameters": [
          {
            "name": "chartedFrom",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "chartedTo",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hasChangesSince",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "firstname",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lastname",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "medicareCardNumber",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dvaCardNumber",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dob",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              }
            }
          }
        }
      }
    },
