                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "used to register a new or existing customer for medpacks",
        "description": "pass 0 as customerID to register new customer for medpacks, set existing customerID to add medpacks for an existing customer.",
        "tags": [
          "ApexMedPackCustomer"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApexMedPackCustomer"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ApexMedPackCustomer"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ApexMedPackCustomer"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "409": {
            "description": "Conflict - new customer is duplicate based on email and DOB, or existing customer already registered for medpacks."
          },
          "400": {
            "description": "Bad Request - existing customer DOB not matching existing record."
          },
          "404": {
            "description": "Not Found - existing customer not found."
          }
        }
      }
    },
