{
  "openapi": "3.0.0",
  "info": {
    "title": "WSO2 IS Verifiable Credential Template Management API",
    "version": "1.0.0",
    "description": "Admin API for managing verifiable credential templates in WSO2 Identity Server.",
    "contact": {
      "name": "WSO2",
      "url": "http://wso2.com/products/identity-server/",
      "email": "architecture@wso2.org"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/THILINAS_1/OID4VCI_ADMIN/1.0.0"
  },
  "servers": [
    {
      "url": "https://{server-url}/t/{tenant-domain}/api/server/v1",
      "variables": {
        "tenant-domain": {
          "default": "carbon.super"
        },
        "server-url": {
          "default": "localhost:9443"
        }
      }
    }
  ],
  "security": [
    {
      "OAuth2": []
    },
    {
      "BasicAuth": []
    }
  ],
  "paths": {
    "/vc-templates": {
      "get": {
        "tags": [
          "VC Templates"
        ],
        "summary": "List templates",
        "operationId": "listVCTemplates",
        "parameters": [
          {
            "$ref": "#/components/parameters/before"
          },
          {
            "$ref": "#/components/parameters/after"
          },
          {
            "$ref": "#/components/parameters/filter"
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/attributes"
          }
        ],
        "responses": {
          "200": {
            "description": "Array of templates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VCTemplateList"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "VC Templates"
        ],
        "summary": "Add new template",
        "operationId": "addVCTemplate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VCTemplateCreationModel"
              },
              "examples": {
                "createEmployeeBadge": {
                  "value": {
                    "identifier": "EmployeeBadge",
                    "displayName": "Employee Badge",
                    "format": "jwt_vc_json",
                    "claims": [
                      {
                        "name": "given_name",
                        "type": "LOCAL",
                        "claimUri": "http://wso2.org/claims/givenname"
                      },
                      {
                        "name": "email",
                        "type": "LOCAL",
                        "claimUri": "http://wso2.org/claims/emailaddress"
                      },
                      {
                        "name": "department",
                        "type": "CUSTOMER_DATA_SERVICE",
                        "claimUri": "employeeDepartment"
                      },
                      {
                        "name": "clearance_level",
                        "type": "EXTERNAL",
                        "claimUri": "http://wso2.org/claims/clearanceLevel"
                      }
                    ],
                    "expiresIn": 31536000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "example": "/api/server/v1/vc-templates/7e5f9d2a-6b5e-4df6-9b87-8a3d1a4a0c31"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VCTemplate"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/vc-templates/{template-id}": {
      "parameters": [
        {
          "in": "path",
          "name": "template-id",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Server-generated UUID of the template."
        }
      ],
      "get": {
        "tags": [
          "VC Templates"
        ],
        "summary": "Get template",
        "operationId": "getVCTemplate",
        "responses": {
          "200": {
            "description": "Template",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VCTemplate"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "VC Templates"
        ],
        "summary": "Update template",
        "operationId": "updateVCTemplate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VCTemplateUpdateModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VCTemplate"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "VC Templates"
        ],
        "summary": "Delete template",
        "operationId": "deleteVCTemplate",
        "responses": {
          "204": {
            "description": "Template Deleted"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/vc-templates/{template-id}/offer": {
      "parameters": [
        {
          "in": "path",
          "name": "template-id",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Server-generated UUID of the template."
        }
      ],
      "post": {
        "tags": [
          "VC Templates"
        ],
        "summary": "Generate or regenerate credential offer",
        "description": "Creates a new credential offer for the template. If an offer already exists it is replaced.",
        "operationId": "generateVCCredentialOffer",
        "responses": {
          "200": {
            "description": "Offer generated or regenerated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VCTemplate"
                }
              }
            }
          },
          "404": {
            "description": "Template not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "VC Templates"
        ],
        "summary": "Revoke credential offer",
        "description": "Revokes and deletes the existing credential offer. Returns the updated template with offerId and offerUri set to null.",
        "operationId": "revokeVCCredentialOffer",
        "responses": {
          "200": {
            "description": "Offer revoked successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VCTemplate"
                }
              }
            }
          },
          "404": {
            "description": "Template or offer not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://localhost:9443/oauth2/authorize",
            "tokenUrl": "http://localhost:9443/oauth2/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "ClaimMapping": {
        "type": "object",
        "required": [
          "name",
          "type",
          "claimUri"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The claim name as it appears in the issued VC.",
            "example": "given_name"
          },
          "type": {
            "type": "string",
            "enum": [
              "LOCAL",
              "CUSTOMER_DATA_SERVICE",
              "EXTERNAL"
            ],
            "description": "Indicates how the claim value is resolved at credential issuance time.\n- LOCAL: resolved from the WSO2 IS user store. claimUri is the IS claim URI\n  (e.g. http://wso2.org/claims/givenname).\n- CUSTOMER_DATA_SERVICE: resolved from WSO2's customer data service.\n  claimUri is the remote attribute key (e.g. employeeDepartment).\n- EXTERNAL: resolved by the Pre-Issue Credential Action extension.\n  claimUri is passed to the extension so it knows which claim to inject.\n"
          },
          "claimUri": {
            "type": "string",
            "description": "The claim reference used for resolution. Always required regardless of type. For LOCAL this is the WSO2 IS claim URI. For CUSTOMER_DATA_SERVICE this is the remote attribute key. For EXTERNAL this is passed to the Pre-Issue Credential Action extension to identify which claim to inject.\n",
            "example": "http://wso2.org/claims/givenname"
          }
        },
        "examples": {
          "localClaim": {
            "value": {
              "name": "given_name",
              "type": "LOCAL",
              "claimUri": "http://wso2.org/claims/givenname"
            }
          },
          "customerDataServiceClaim": {
            "value": {
              "name": "department",
              "type": "CUSTOMER_DATA_SERVICE",
              "claimUri": "employeeDepartment"
            }
          },
          "externalClaim": {
            "value": {
              "name": "clearance_level",
              "type": "EXTERNAL",
              "claimUri": "http://wso2.org/claims/clearanceLevel"
            }
          }
        }
      },
      "VCTemplate": {
        "type": "object",
        "required": [
          "id",
          "identifier",
          "displayName",
          "format",
          "claims",
          "expiresIn"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "7e5f9d2a-6b5e-4df6-9b87-8a3d1a4a0c31"
          },
          "identifier": {
            "type": "string",
            "description": "Stable, immutable key; human and machine readable. Cannot be changed after creation.",
            "example": "EmployeeBadge"
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable display name for the template.",
            "example": "Employee Badge"
          },
          "description": {
            "type": "string",
            "description": "Optional description of the credential template.",
            "example": "Issued to employees upon completing IS developer certification."
          },
          "format": {
            "type": "string",
            "description": "Credential format. Cannot be changed after creation.",
            "example": "jwt_vc_json"
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClaimMapping"
            },
            "description": "Ordered list of claims to include in the issued credential."
          },
          "expiresIn": {
            "type": "integer",
            "description": "Credential validity period in seconds.",
            "example": 31536000
          },
          "offerId": {
            "type": "string",
            "nullable": true,
            "description": "Backend-generated UUID for the active credential offer. Null if no offer is currently active.",
            "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
          },
          "offerUri": {
            "type": "string",
            "nullable": true,
            "description": "The credential offer URI (openid-credential-offer://...) for QR code rendering. Null if no offer is active.",
            "example": "openid-credential-offer://?credential_offer_uri=https://example.com/vc/offers/a1b2c3d4"
          }
        }
      },
      "VCTemplateCreationModel": {
        "type": "object",
        "required": [
          "identifier",
          "format",
          "claims",
          "expiresIn"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "description": "Stable, immutable key. Cannot be changed after creation.",
            "example": "EmployeeBadge"
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable display name. Defaults to identifier if omitted.",
            "example": "Employee Badge"
          },
          "description": {
            "type": "string",
            "description": "Optional description of the credential template."
          },
          "format": {
            "type": "string",
            "description": "Credential format. Cannot be changed after creation.",
            "example": "jwt_vc_json"
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClaimMapping"
            },
            "description": "Claims to include in the issued credential."
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 60,
            "description": "Credential validity period in seconds.",
            "example": 31536000
          }
        }
      },
      "VCTemplateUpdateModel": {
        "type": "object",
        "description": "Fields allowed to change after creation. Note: identifier and format are immutable and cannot be updated.\n",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "If not provided, server retains the existing value."
          },
          "description": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClaimMapping"
            },
            "description": "Replaces the full claims list on the template."
          },
          "expiresIn": {
            "type": "integer",
            "minimum": 60
          }
        }
      },
      "VCTemplateList": {
        "type": "object",
        "properties": {
          "totalResults": {
            "type": "integer",
            "example": 1
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaginationLink"
            }
          },
          "vcTemplates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VCTemplateListItem"
            }
          }
        }
      },
      "VCTemplateListItem": {
        "type": "object",
        "required": [
          "id",
          "identifier",
          "displayName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "7e5f9d2a-6b5e-4df6-9b87-8a3d1a4a0c31"
          },
          "identifier": {
            "type": "string",
            "description": "Stable, immutable key. Published as the credential_configuration_id in issuer metadata.",
            "example": "EmployeeBadge"
          },
          "displayName": {
            "type": "string",
            "description": "Human-readable display name.",
            "example": "Employee Badge"
          }
        }
      },
      "PaginationLink": {
        "type": "object",
        "properties": {
          "rel": {
            "type": "string",
            "example": "before"
          },
          "href": {
            "type": "string",
            "example": "/api/server/v1/vc-templates?after=NDoy"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VCT-60001"
          },
          "message": {
            "type": "string",
            "example": "Invalid claim mapping."
          },
          "description": {
            "type": "string",
            "example": "claimUri is required for all claim types."
          },
          "traceId": {
            "type": "string",
            "example": "e0fbcfeb-3617-43c4-8dd0-7b7d38e13047"
          }
        }
      }
    },
    "parameters": {
      "before": {
        "name": "before",
        "in": "query",
        "required": false,
        "description": "Base64 encoded cursor value for backward pagination.",
        "schema": {
          "type": "string"
        },
        "example": "Ng=="
      },
      "after": {
        "name": "after",
        "in": "query",
        "required": false,
        "description": "Base64 encoded cursor value for forward pagination.",
        "schema": {
          "type": "string"
        },
        "example": "Ng=="
      },
      "filter": {
        "name": "filter",
        "in": "query",
        "required": false,
        "description": "Condition to filter the retrieval of records. Supports 'sw', 'co', 'ew' and 'eq' operations.",
        "schema": {
          "type": "string"
        },
        "example": "identifier+eq+EmployeeBadge"
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Maximum number of records to return.",
        "schema": {
          "type": "integer"
        },
        "example": 10
      },
      "attributes": {
        "name": "attributes",
        "in": "query",
        "required": false,
        "description": "Specifies the required attributes in the response. Only 'properties' attribute is currently supported.",
        "schema": {
          "type": "string"
        }
      }
    }
  }
}
