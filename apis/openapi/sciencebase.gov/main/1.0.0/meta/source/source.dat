{
  "openapi": "3.0.3",
  "info": {
    "title": "USGS ScienceBase Catalog API",
    "description": "ScienceBase is a collaborative scientific data and information management platform used by the USGS and partners. The catalog API provides RESTful access to search, read, and manage scientific data items with support for full-text search, spatial queries, and hierarchical browsing.",
    "version": "1.0.0",
    "contact": {
      "name": "USGS ScienceBase",
      "email": "sciencebase@usgs.gov",
      "url": "https://www.sciencebase.gov"
    },
    "x-jentic-source-url": "https://www.sciencebase.gov/catalog/items?format=json",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://www.sciencebase.gov/catalog",
      "description": "USGS ScienceBase Catalog API"
    }
  ],
  "paths": {
    "/items": {
      "get": {
        "operationId": "searchItems",
        "summary": "Search ScienceBase catalog items",
        "description": "Searches the ScienceBase catalog using keyword queries, filters, spatial queries, and other criteria. Returns paginated results.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Keyword search query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "description": "Response format",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "xml"
              ],
              "default": "json"
            }
          },
          {
            "name": "max",
            "in": "query",
            "description": "Maximum number of items to return (upper limit 1000)",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 1000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Paging offset (must be in increments of 5)",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Comma-separated list of fields to return",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Field to sort by",
            "schema": {
              "type": "string",
              "enum": [
                "title",
                "dateCreated",
                "lastUpdated",
                "firstContact"
              ]
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Sort order",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "description": "Filter expression (e.g., parentId=<id>, ancestors=<id>, systemType=Data Release, tags={type:...,name:...})",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CatalogItem"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "selflink": {
                      "type": "object"
                    },
                    "nextlink": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/item/{itemId}": {
      "get": {
        "operationId": "getItemById",
        "summary": "Get a specific catalog item by ID",
        "description": "Returns the full JSON representation of a ScienceBase catalog item.",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "description": "The unique ScienceBase item identifier",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "xml"
              ],
              "default": "json"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Comma-separated list of fields to return",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Catalog item details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItem"
                }
              }
            }
          },
          "404": {
            "description": "Item not found"
          }
        }
      }
    },
    "/items/{parentId}": {
      "get": {
        "operationId": "getChildItems",
        "summary": "Get child items of a parent item",
        "description": "Returns items nested directly under the specified parent item ID.",
        "parameters": [
          {
            "name": "parentId",
            "in": "path",
            "required": true,
            "description": "Parent item ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ],
              "default": "json"
            }
          },
          {
            "name": "max",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Child items"
          }
        }
      }
    },
    "/item/metrics/{itemId}": {
      "get": {
        "operationId": "getItemMetrics",
        "summary": "Get usage metrics for a catalog item",
        "description": "Returns analytics and usage metrics for a specific ScienceBase item.",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "description": "Start date (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "description": "End date (YYYY-MM-DD)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "timescale",
            "in": "query",
            "description": "Time grouping for metrics",
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ]
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ],
              "default": "json"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Item usage metrics"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "link": {
            "type": "object",
            "properties": {
              "rel": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          },
          "parentId": {
            "type": "string"
          },
          "hasChildren": {
            "type": "boolean"
          },
          "provenance": {
            "type": "object"
          },
          "materialRequestInstructions": {
            "type": "string"
          },
          "dates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "dateString": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "scheme": {
                  "type": "string"
                }
              }
            }
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "webLinks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "typeLabel": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          },
          "spatial": {
            "type": "object",
            "properties": {
              "boundingBox": {
                "type": "object",
                "properties": {
                  "minX": {
                    "type": "number"
                  },
                  "maxX": {
                    "type": "number"
                  },
                  "minY": {
                    "type": "number"
                  },
                  "maxY": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "contentType": {
                  "type": "string"
                },
                "size": {
                  "type": "integer"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
