ype":"number","minimum":0,"maximum":60},"maxSimultaneous":{"type":"integer","minimum":1,"maximum":6}},"required":["graphicsPerMin","maxSimultaneous"],"additionalProperties":false},"inspiration":{"type":"object","properties":{"sources":{"minItems":1,"maxItems":24,"type":"array","items":{"type":"string"}},"extractedAt":{"type":"number"},"extractionVersion":{"type":"string","minLength":1,"maxLength":60}},"required":["sources","extractedAt","extractionVersion"],"additionalProperties":false},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["id","name","description","tagline","colors","fonts","voiceGuidelines","captions","createdAt","updatedAt"],"additionalProperties":false,"description":"Brand kit response per §Brand Kits."},"PaginationMeta":{"type":"object","properties":{"hasMore":{"type":"boolean"},"nextCursor":{"type":["string","null"]},"prevCursor":{"type":["string","null"]}},"required":["hasMore","nextCursor","prevCursor"],"additionalProperties":false,"description":"Cursor pagination metadata."},"BriefBeat":{"type":"object","properties":{"id":{"type":"string","minLength":1},"intent":{"type":"string","minLength":1,"description":"What this beat DOES editorially (hook the claim, prove it, CTA…)."},"durationSec":{"type":"number","exclusiveMinimum":0},"source":{"description":"MOMENT PINNING: this beat uses EXACTLY this window of this media item — honored to-the-frame or refused. v1: every sourced beat must reference the SAME mediaId (multi-source briefs are refused loudly, not silently merged).","type":"object","properties":{"mediaId":{"type":"string","minLength":1},"startSec":{"type":"number","minimum":0},"endSec":{"type":"number","exclusiveMinimum":0}},"required":["mediaId","startSec","endSec"],"additionalProperties":false},"graphic":{"description":"GRAPHICS MANDATE: the plan MUST carry a graphics request of this role overlapping this beat's window — enforced at the plan gate (honor-or-refuse, like moment pinning). Prose mustIncludes reaches only the judge; this is the checkable form.","type":"object","properties":{"role":{"type":"string","enum":["title-card","stat","lower-third","pull-quote","hero","logo-tag","enumeration","sequence","comparison"],"description":"The mandated graphic's editorial role (the graphics-plan GraphicRole vocabulary)."},"items":{"description":"Mandated list items (enumeration/sequence) — carried VERBATIM into the plan's copy.items.","maxItems":8,"type":"array","items":{"type":"string","minLength":1,"maxLength":80}}},"required":["role"],"additionalProperties":false}},"required":["id","intent"],"additionalProperties":false},"BriefCreateRequest":{"type":"object","properties":{"projectId":{"type":"string","minLength":1},"name":{"type":"string","maxLength":200},"goal":{"type":"string","minLength":1,"maxLength":2000,"description":"What the video must accomplish."},"audience":{"type":"string","maxLength":500},"platform":{"type":"string","maxLength":100},"format":{"$ref":"#/components/schemas/FormatSpec"},"durationSec":{"description":"Target output duration. HONOR-OR-REFUSE: compose validates it against the beat-source window (±1.5s) and refuses a brief it cannot honor.","type":"number","exclusiveMinimum":0,"maximum":3600},"tone":{"type":"string","maxLength":500},"cta":{"type":"string","maxLength":500},"locale":{"description":"Output language (BCP-47 tag, e.g. 'es-419'): ALL on-screen copy + captions.","type":"string","maxLength":35},"hook":{"type":"string","maxLength":500},"caption":{"type":"string","maxLength":2000},"beats":{"maxItems":24,"type":"array","items":{"$ref":"#/components/schemas/BriefBeat"}},"mustIncludes":{"maxItems":24,"type":"array","items":{"type":"string","minLength":1}},"references":{"maxItems":12,"type":"array","items":{"type":"string"}},"captions":{"type":"object","properties":{"styleId":{"description":"Caption style id (e.g. 'serif-emphasis@1').","type":"string","minLength":1},"emphasisPhrases":{"description":"Phrases rendered in the caption EMPHASIS style (the big-serif treatment). Matched against the transcript; drives CaptionWord.emphasis.","maxItems":24,"type":"array","items":{"type":"string","minLength":1}}},"additionalProperties":false},"motionStyle":{"type":"object","properties":{"textAnimation":{"type":"string"},"transitions":{"type":"string"},"colorMood":{"type":"string"},"captionStyle":{"type":"string"}},"additionalProperties":false},"seededGraphics":{"maxItems":16,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","minLength":1},"startTime":{"type":"number","minimum":0,"description":"Timeline start (seconds)."},"duration":{"type":"number","exclusiveMinimum":0,"description":"Clip duration (seconds)."},"source":{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"media"},"mediaId":{"type":"string","minLength":1},"trim":{"type":"object","properties":{"start":{"type":"number","minimum":0,"description":"Source trim start (seconds)."},"end":{"type":"number","minimum":0,"description":"Source trim end (seconds)."}},"required":["start","end"],"additionalProperties":false},"excludedRanges":{"type":"array","items":{"type":"object","properties":{"start":{"type":"number","minimum":0},"end":{"type":"number","minimum":0},"reason":{"type":"string"}},"required":["start","end"],"additionalProperties":false}},"volume":{"type":"number","minimum":0,"maximum":4},"muted":{"type":"boolean"},"playbackRate":{"type":"number","exclusiveMinimum":0},"sync":{"type":"string","enum":["video","independent"]},"kenBurns":{"type":"string","enum":["in","out","pan-l","pan-r","none"]},"volumeDb":{"type":"number"},"fadeInMs":{"type":"number","minimum":0},"fadeOutMs":{"type":"number","minimum":0},"loop":{"type":"boolean"},"audioRole":{"type":"string","enum":["sfx","music","vo","ambience"]},"duck":{"type":"object","properties":{"duckDb":{"type":"number","maximum":0},"attackMs":{"type":"number","minimum":0},"releaseMs":{"type":"number","minimum":0},"windows":{"type":"array","items":{"type":"object","properties":{"startMs":{"type":"number"},"endMs":{"type":"number"}},"required":["startMs","endMs"],"additionalProperties":false}}},"required":["duckDb","attackMs","releaseMs"],"additionalProperties":false},"anchor":{"type":"object","properties":{"clipId":{"type":"string","minLength":1},"offsetMs":{"type":"number"}},"required":["clipId","offsetMs"],"additionalProperties":false},"reframe":{"type":"object","properties":{"segments":{"minItems":1,"type":"array","items":{"type":"object","properties":{"startSec":{"type":"number","minimum":0,"description":"Segment START in seconds, clip-relative. Segments tile the clip's duration in order."},"endSec":{"type":"number","exclusiveMinimum":0,"description":"Segment END in seconds, clip-relative. The span (endSec − startSec) is this segment's duration — the window `ease` ramps over."},"focus":{"oneOf":[{"type":"object","properties":{"mode":{"type":"string","const":"frame-center"}},"required":["mode"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"point"},"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1}},"required":["mode","x","y"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"face"},"faceId":{"type":"string","minLength":1},"shotScale":{"type":"string","enum":["close","standard","wide"]}},"required":["mode","faceId"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"all-faces"}},"required":["mode"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"active-speaker"}},"required":["mode"],"additionalProperties":false}],"description":"WHO/WHAT the camera tracks this segment (the reframe center), selected by `mode`: `frame-center` = no tracking, hold the geometric center (static/graphic footage, or a pure zoom); `point` = lock to a fixed source-normalized {x,y} (a non-moving on-screen element); `face` = track a detected face by `faceId` (from get_media_context), with optional `shotScale` close|standard|wide for tightness; `all-faces` = frame the bounding box of every detected face (group/ensemble shots); `active-speaker` = follow whoever is speaking (diarized talking-head / podcast). Pick by what the beat is about; pair with `zoom` for how tight.","type":"object"},"intent":{"description":"Optional editorial LABEL for diff/log readability (e.g. 'speaker-tight', 'wide-context'). Cosmetic — NOT honored by the derive math and excluded from the variant cache key.","type":"string"},"zoom":{"description":"How TIGHT the framing is — the fraction of the source the output viewport shows. <1 punches IN (a smaller source fraction, magnified to fill the frame); 1 = the full frame (no crop). ~0.6–0.8 is a moderate push-in, ~0.5 a tight close-up, 0.1 the maximum zoom. There is NO zoom-OUT past the full frame (max 1). Omit for the full frame. MUTUALLY EXCLUSIVE with `focus.shotScale` — a face-tracked shot is sized EITHER by the editorial scale (shotScale, which the bake calibrates to the detected face) OR by an explicit zoom, never both. A segment carrying both is REJECTED: shotScale wins at bake time and the zoom would be silently discarded.","type":"number","minimum":0.1,"maximum":1},"ease":{"description":"Zoom/center ramp DURATIONS in SECONDS at this segment's edges — NOT a unitless 0–1 curve. ~0.3–0.6s reads as a snappy push; >1s reads sluggish. Keep `in` + `out` ≤ the segment's duration (endSec − startSec): the two edges share the span, so to ramp across the WHOLE segment set one edge to the full duration and the other to 0. Omit for an instant cut to this framing.","type":"object","properties":{"in":{"type":"number","minimum":0,"description":"Ease-IN ramp DURATION in seconds at the segment START."},"out":{"type":"number","minimum":0,"description":"Ease-OUT ramp DURATION in seconds at the segment END."}},"required":["in","out"],"additionalProperties":false},"bias":{"description":"Optional FINE framing nudge off the focus center, source-normalized in [−0.3, 0.3]. A small correction (headroom, rule-of-thirds), NOT a reframe — use `focus`/`zoom` for the actual shot. Omit (treated as 0) to sit dead-center on the focus.","type":"object","properties":{"x":{"type":"number","minimum":-0.3,"maximum":0.3,"description":"Horizontal nudge, source-normalized (+ = right)."},"y":{"type":"number","minimum":-0.3,"maximum":0.3,"description":"Vertical nudge, source-normalized (+ = down)."}},"required":["x","y"],"additionalProperties":false}},"required":["startSec","endSec","focus"],"additionalProperties":false}}},"required":["segments"],"additionalProperties":false}},"required":["kind","mediaId"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"component"},"componentId":{"type":"string","minLength":1},"props":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"assets":{"description":"Manifest asset slot → project media id. At mount each slot arrives as `assets[slot].handle`, a fetchable URL for <Img>/<Video>/<Audio>; `props` becomes `params` and never carries an asset URL.","type":"object","propertyNames":{"type":"string","minLength":1},"additionalProperties":{"type":"string","minLength":1}},"assetTiming":{"type":"object","propertyNames":{"type":"string","minLength":1},"additionalProperties":{"type":"object","properties":{"trimStartSec":{"type":"number","minimum":0},"trimEndSec":{"type":"number","exclusiveMinimum":0},"playbackRate":{"type":"number","exclusiveMinimum":0,"maximum":16},"endPolicy":{"type":"string","enum":["loop","hold","reject"]},"timelineOffsetSec":{"type":"number","minimum":0}},"required":["endPolicy"],"additionalProperties":false}},"zPlane":{"type":"string","enum":["front","behind-subject"]},"execution":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"}