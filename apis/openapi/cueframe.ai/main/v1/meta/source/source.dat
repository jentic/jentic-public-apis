"type":"number"},"emphasisPlatePadY":{"type":"number"},"emphasisPlateReveal":{"description":"Grow a shared emphasis plate as saved words appear while reserving its final layout width.","type":"boolean"},"annotationColor":{"type":"string"},"annotationStrokeWidth":{"description":"Annotation stroke width in its 100×100 SVG coordinate system; default 4.","type":"number","minimum":0.5,"maximum":12},"annotationTexture":{"description":"Native annotation stroke finish; default clean.","type":"string","enum":["clean","pencil"]},"maxWidthPercent":{"type":"number","exclusiveMinimum":0,"maximum":100}},"additionalProperties":false},"layouts":{"type":"array","items":{"type":"object","properties":{"segmentIndex":{"type":"integer","minimum":0,"maximum":9007199254740991},"wordStartIndex":{"type":"integer","minimum":0,"maximum":9007199254740991},"wordEndIndex":{"type":"integer","exclusiveMinimum":0,"maximum":9007199254740991,"description":"Exclusive word index in the saved caption segment."},"region":{"type":"object","properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"w":{"type":"number","exclusiveMinimum":0,"maximum":1},"h":{"type":"number","exclusiveMinimum":0,"maximum":1}},"required":["x","y","w","h"],"additionalProperties":false},"scale":{"type":"number","minimum":0.25,"maximum":4},"rotation":{"type":"number","minimum":-45,"maximum":45},"style":{"type":"object","properties":{"fontFamily":{"type":"string","minLength":1},"fontSize":{"description":"Font size as % of composition height (1-15, default 5). NOT px.","type":"number","minimum":1,"maximum":15},"fontWeight":{"type":"integer","minimum":100,"maximum":900},"color":{"type":"string","minLength":1},"highlightColor":{"type":"string","minLength":1},"backgroundColor":{"type":"string"},"plate":{"type":"string","enum":["glass","solid","none"]},"textTransform":{"type":"string","enum":["none","uppercase","capitalize"]},"letterSpacing":{"description":"Base caption glyph spacing in pixels.","type":"number","minimum":-5,"maximum":20},"wordGapEm":{"description":"Gap between caption runs as a multiple of base font size; default 0.35.","type":"number","minimum":0,"maximum":2},"lineGapEm":{"description":"Gap between caption lines as a multiple of base font size; default 0.25.","type":"number","minimum":0,"maximum":2},"emphasisColor":{"type":"string"},"emphasisScale":{"type":"number","exclusiveMinimum":0},"emphasisFontFamily":{"type":"string"},"emphasisFontWeight":{"type":"integer","minimum":100,"maximum":900},"emphasisTextTransform":{"type":"string","enum":["none","uppercase","capitalize"]},"emphasisLetterSpacing":{"type":"number"},"emphasisFontStyle":{"type":"string","enum":["normal","italic"]},"emphasisPlate":{"type":"boolean"},"emphasisPlateColor":{"type":"string"},"emphasisPlateTextColor":{"type":"string"},"emphasisPlateAltColor":{"type":"string"},"emphasisPlateAltTextColor":{"type":"string"},"emphasisPlateRadius":{"type":"number","minimum":0},"emphasisPlatePadX":{"type":"number"},"emphasisPlatePadY":{"type":"number"},"emphasisPlateReveal":{"description":"Grow a shared emphasis plate as saved words appear while reserving its final layout width.","type":"boolean"},"annotationColor":{"type":"string"},"annotationStrokeWidth":{"description":"Annotation stroke width in its 100×100 SVG coordinate system; default 4.","type":"number","minimum":0.5,"maximum":12},"annotationTexture":{"description":"Native annotation stroke finish; default clean.","type":"string","enum":["clean","pencil"]},"entrance":{"type":"string","enum":["none","fade","word-pop","stagger-up"]},"entranceMs":{"type":"number","minimum":0},"entranceStaggerMs":{"type":"number","minimum":0},"exitMs":{"type":"number","minimum":0}},"additionalProperties":false},"holdThroughWordIndex":{"description":"Inclusive saved-word index in this segment. The layout stays visible until that word ends.","type":"integer","minimum":0,"maximum":9007199254740991},"wordMarks":{"type":"array","items":{"type":"object","properties":{"wordIndex":{"type":"integer","minimum":0,"maximum":9007199254740991},"emphasis":{"type":"boolean"},"annotate":{"anyOf":[{"type":"string","enum":["circle","underline"]},{"type":"null"}]}},"required":["wordIndex"],"additionalProperties":false}},"wordSignature":{"type":"string","pattern":"^[a-f0-9]{64}$"}},"required":["segmentIndex","wordStartIndex","wordEndIndex","region","wordSignature"],"additionalProperties":false}},"zPlane":{"type":"string","enum":["front","behind-subject"]}},"required":["source","segments"],"additionalProperties":false}],"type":"object"},"license":{"type":"object","properties":{"type":{"type":"string","minLength":1},"source":{"type":"string"},"notes":{"type":"string"}},"required":["type"],"additionalProperties":false},"accessibility":{"type":"object","properties":{"audioDescriptionTrackId":{"type":"string"},"captionsTrackId":{"type":"string"},"signLanguageTrackId":{"type":"string"},"notes":{"type":"string"}},"additionalProperties":false}},"required":["v","format","tracks"],"additionalProperties":{},"description":"Canonical composition wire shape (multi-track; carries reframe, captions, markers).","examples":[{"v":1,"format":{"aspectRatio":"16:9","fps":30},"tracks":[]}]},"CompositionApplyRequest":{"type":"object","properties":{"ops":{"minItems":1,"type":"array","items":{"$ref":"#/components/schemas/CompositionOp"}},"componentExecutionVersions":{"minItems":1,"maxItems":1,"type":"array","items":{"type":"number","const":3}},"builtinSources":{"minItems":1,"maxItems":512,"type":"array","items":{"type":"object","properties":{"scope":{"type":"object","properties":{"kind":{"type":"string","const":"builtin"},"collection":{"type":"string","minLength":1,"maxLength":256}},"required":["kind","collection"],"additionalProperties":false},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"sourceVersion":{"type":"number","const":3}},"required":["scope","componentId","sourceVersionId","sourceVersion"],"additionalProperties":false}},"expectedBrandIdentity":{"type":"string","pattern":"^[a-f0-9]{64}$"},"concurrency":{"description":"Version 1 shared dependency admission. Guarded requests must name the observed immutable composition with composition_id or concurrency.compositionId; changed or missing dependencies refuse the entire batch.","$ref":"#/components/schemas/CompositionConcurrency"},"if_match":{"description":"Optional OCC precondition — the strong etag (`\"<hex>\"`) the caller last saw. On mismatch the batch is rejected (409 stale_etag) before any op applies.","type":"string"},"dry_run":{"description":"When true, validate the batch (apply + projection accept/reject guards) WITHOUT persisting. Returns `{ valid, errors }` instead of applying.","type":"boolean"},"composition_id":{"description":"Target a SPECIFIC composition instead of the project's active one. Omit it and the project's active composition is edited, which is the default and the common case. `preview_frame` and `create_render` already accept a compositionId; this closes the gap so a second composition minted with `new_composition` can actually be authored into — build variant A, mint B, edit B, preview both. Mutually exclusive with `session_id`, which targets the session's scratch.","type":"string"},"session_id":{"description":"Optional compose-session id. When present, the ops target the session's SCRATCH composition (a derived sibling) instead of the project's active composition — the server never mutates active until commit.","type":"string"}},"required":["ops"],"additionalProperties":false,"description":"POST /projects/:id/composition/apply body — a batch of CompositionOps.","examples":[{"ops":[{"type":"clip.remove","clipId":"observed-clip"}]}]},"CompositionOp":{"oneOf":[{"type":"object","properties":{"type":{"type":"string","const":"scene.add"},"clipId":{"type":"string"},"trackId":{"type":"string"},"newTrack":{"type":"boolean"},"newTrackId":{"type":"string"},"startTime":{"type":"number","minimum":0},"duration":{"type":"number","exclusiveMinimum":0},"scene":{"$ref":"#/components/schemas/SceneShotSpecV2"},"assets":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"transitionIn":{"$ref":"#/components/schemas/TransitionSpec"}},"required":["type","clipId","startTime","duration","scene","assets"],"additionalProperties":false,"description":"Author a scene shot and place it on a dedicated overlay track. The host validates the scene, generates and registers an immutable wrapper component source, and emits the ordinary track/clip operations carrying `props.componentRef` — you edit a scene SPEC, never wrapper TSX or a source hash. Registration and the composition update are ONE undoable edit; a failure publishes nothing and leaves no clip pointing at an unresolved source. Pass EXACTLY ONE of `trackId` (an existing dedicated scene track) or `newTrack: true` (mint one). That track holds scene-shot clips and gaps only — no generic component/primitive/media clips in v1 — and existing generic overlay tracks are unaffected. Scene clips use front zPlane and full-frame placement: outer per-clip `region`, `position`, `scale`, `rotation`, `fit`, `effects`, `animate`, `params.transition`, `params.sequenceGroup` and internal fadeIn/fadeOut are REFUSED with a path, because the shot's own layer transforms are the single transform owner. TEXT: `space: \"screen\"` text is composed above the world result, stays fixed in the frame and stays sharp through focus; `space: \"world\"` text is rasterized into the 3D scene, moves with the camera and is occluded by geometry. Screenshots and world text are UNLIT and colour-managed so product UI colours are not tinted by the studio lighting, while device bodies are lit and cast shadows; an unlit surface still occludes. SCOPE GAP (pre-existing, neither closed nor changed by scene shots): global wrap effects — composition-level grades and camera effects — do not reach front-overlay clips, so they do not affect a scene shot. Author the look INSIDE the shot (`post.grain`, `post.vignette`, `post.focus`, `backdrop`, `environment`) instead. DISCOVERY: there is no built-in scene primitive to look up in list_catalog; the wrapper this operation registers appears afterwards as an ordinary INSTALLED component under the existing catalog rules. ASSETS: `assets` binds each slot name a layer references to a media id in the same project, and the slot's declared KIND decides what it admits — an image slot takes PNG, JPEG or WebP, a video slot MP4 or WebM. Binding the wrong kind is refused with the slot's path."},{"type":"object","properties":{"type":{"type":"string","const":"scene.update"},"clipId":{"type":"string"},"startTime":{"type":"number","minimum":0},"duration":{"type":"number","exclusiveMinimum":0},"scene":{"$ref":"#/components/schemas/SceneShotSpecV2"},"assets":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"transitionIn":{"$ref":"#/components/schemas/TransitionSpec"}},"required":["type","clipId"],"additionalProperties":false,"description":"Revise a scene shot in place by clip id. Send a replacement `scene` and/or `assets`; timing changes use the ordinary clip timing fields (`startTime`, `duration`, `transitionIn`). Omitted fields keep their persisted values and the MERGED result is re-validated as a whole, so a partial edit cannot leave the shot invalid. Changing only values or asset IDs updates props and bindings and REUSES the pinned source; changing the referenced SLOT SET regenerates the wrapper manifest and registers a new immutable source version atomically. Undo restores the source reference, spec, bindings and timing together. Topology, asset bindings, text content, font properties, device kind and colours are STATIC within a shot's animation — change them here (a revised spec) rather than trying to animate them. This is not a source trim or slip: a shortened or extended clip resamples the SAME normalized animation over its new duration, and trim/slip requests on generated animation are rejected rather than reinterpreted as media trims. In one batch, `scene.update` may target a shot added by an earlier `scene.add`. ASSETS: `assets` binds each slot name a layer references to a media id in the same project, and the slot's declared KIND decides what it admits — an image slot takes PNG, JPEG or WebP, a video slot MP4 or WebM. Binding the wrong kind is refused with the slot's path."},{"type":"object","properties":{"type":{"type":"string","const":"clip.add"},"clip":{"type":"object","properties":{"id":{"type":"string","minLength":1},"startTime":{"type":"number","minimum":0,"description":"Timeline start (seconds)."},"duration":{"type":"number","exclusiveMinimum":0,"description":"Clip duration (seconds)."},"source":{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"media"},"mediaId":{"type":"string","minLength":1},"trim":{"type":"object","properties":{"start":{"type":"number","minimum":0,"description":"Source trim start (seconds)."},"end":{"type":"number","minimum":0,"description":"Source trim end (seconds)."}},"required":["start","end"],"additionalProperties":false},"excludedRanges":{"type":"array","items":{"type":"object","properties":{"start":{"type":"number","minimum":0},"end":{"type":"number","minimum":0},"reason":{"type":"string"}},"required":["start","end"],"additionalProperties":false}},"volume":{"type":"number","minimum":0,"maximum":4},"muted":{"type":"boolean"},"playbackRate":{"type":"number","exclusiveMinimum":0},"sync":{"type":"string","enum":["video","independent"]},"kenBurns":{"type":"string","enum":["in","out","pan-l","pan-r","none"]},"volumeDb":{"type":"number"},"fadeInMs":{"type":"number","minimum":0},"fadeOutMs":{"type":"number","minimum":0},"loop":{"type":"boolean"},"audioRole":{"type":"string","enum":["sfx","music","vo","ambience"]},"duck":{"type":"object","properties":{"duckDb":{"type":"number","maximum":0},"attackMs":{"type":"number","minimum":0},"releaseMs":{"type":"number","minimum":0},"windows":{"type":"array","items":{"type":"object","properties":{"startMs":{"type":"number"},"endMs":{"type":"number"}},"required":["startMs","endMs"],"additionalProperties":false}}},"required":["duckDb","attackMs","releaseMs"],"additionalProperties":false},"anchor":{"type":"object","properties":{"clipId":{"type":"string","minLength":1},"offsetMs":{"type":"number"}},"required":["clipId","offsetMs"],"additionalProperties":false},"reframe":{"type":"object","properties":{"segments":{"minItems":1,"type":"array","items":{"type":"object","properties":{"startSec":{"type":"number","minimum":0,"description":"Segment START in seconds, clip-relative. Segments tile the clip's duration in order."},"endSec":{"type":"number","exclusiveMinimum":0,"description":"Segment END in seconds, clip-relative. The span (endSec − startSec) is this segment's duration — the window `ease` ramps over."},"focus":{"oneOf":[{"type":"object","properties":{"mode":{"type":"string","const":"frame-center"}},"required":["mode"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"point"},"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1}},"required":["mode","x","y"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"face"},"faceId":{"type":"string","minLength":1},"shotScale":{"type":"string","enum":["close","standard","wide"]}},"required":["mode","faceId"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"all-faces"}},"required":["mode"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"active-speaker"}},"required":["mode"],"additionalProperties":false}],"description":"WHO/WHAT the camera tracks this segment (the reframe center), selected by `mode`: `frame-center` = no tracking, hold the geometric center (static/graphic footage, or a pure zoom); `point` = lock to a fixed source-normalized {x,y} (a non-moving on-screen element); `face` = track a detected face by `faceId` (from get_media_context), with optional `shotScale` close|standard|wide for tightness; `all-faces` = frame the bounding box of every detected face (group/ensemble shots); `active-speaker` = follow whoever is speaking (diarized talking-head / podcast). Pick by what the beat is about; pair with `zoom` for how tight.","type":"object"},"intent":{"description":"Optional editorial LABEL for diff/log readability (e.g. 'speaker-tight', 'wide-context'). Cosmetic — NOT honored by the derive math and excluded from the variant cache key.","type":"string"},"zoom":{"description":"How TIGHT the framing is — the fraction of the source the output viewport shows. <1 punches IN (a smaller source fraction, magnified to fill the frame); 1 = the full frame (no crop). ~0.6–0.8 is a moderate push-in, ~0.5 a tight close-up, 0.1 the maximum zoom. There is NO zoom-OUT past the full frame (max 1). Omit for the full frame. MUTUALLY EXCLUSIVE with `focus.shotScale` — a face-tracked shot is sized EITHER by the editorial scale (shotScale, which the bake calibrates to the detected face) OR by an explicit zoom, never both. A segment carrying both is REJECTED: shotScale wins at bake time and the zoom would be silently discarded.","type":"number","minimum":0.1,"maximum":1},"ease":{"description":"Zoom/center ramp DURATIONS in SECONDS at this segment's edges — NOT a unitless 0–1 curve. ~0.3–0.6s reads as a snappy push; >1s reads sluggish. Keep `in` + `out` ≤ the segment's duration (endSec − startSec): the two edges share the span, so to ramp across the WHOLE segment set one edge to the full duration and the other to 0. Omit for an instant cut to this framing.","type":"object","properties":{"in":{"type":"number","minimum":0,"description":"Ease-IN ramp DURATION in seconds at the segment START."},"out":{"type":"number","minimum":0,"description":"Ease-OUT ramp DURATION in seconds at the segment END."}},"required":["in","out"],"additionalProperties":false},"bias":{"description":"Optional FINE framing nudge off the focus center, source-normalized in [−0.3, 0.3]. A small correction (headroom, rule-of-thirds), NOT a reframe — use `focus`/`zoom` for the actual shot. Omit (treated as 0) to sit dead-center on the focus.","type":"object","properties":{"x":{"type":"number","minimum":-0.3,"maximum":0.3,"description":"Horizontal nudge, source-normalized (+ = right)."},"y":{"type":"number","minimum":-0.3,"maximum":0.3,"description":"Vertical nudge, source-normalized (+ = down)."}},"required":["x","y"],"additionalProperties":false}},"required":["startSec","endSec","focus"],"additionalProperties":false}}},"required":["segments"],"additionalProperties":false}},"required":["kind","mediaId"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"component"},"componentId":{"type":"string","minLength":1},"props":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"assets":{"description":"Manifest asset slot → project media id. At mount each slot arrives as `assets[slot].handle`, a fetchable URL for <Img>/<Video>/<Audio>; `props` becomes `params` and never carries an asset URL.","type":"object","propertyNames":{"type":"string","minLength":1},"additionalProperties":{"type":"string","minLength":1}},"assetTiming":{"type":"object","propertyNames":{"type":"string","minLength":1},"additionalProperties":{"type":"object","properties":{"trimStartSec":{"type":"number","minimum":0},"trimEndSec":{"type":"number","exclusiveMinimum":0},"playbackRate":{"type":"number","exclusiveMinimum":0,"maximum":16},"endPolicy":{"type":"string","enum":["loop","hold","reject"]},"timelineOffsetSec":{"type":"number","minimum":0}},"required":["endPolicy"],"additionalProperties":false}},"zPlane":{"type":"string","enum":["front","behind-subject"]},"execution":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/ComponentParameterValue"}},"seed":{"type":"string","minLength":1},"assets":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":256},"additionalProperties":{"type":"string","minLength":1,"maxLength":256}},"mediaBindings":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":128},"additionalProperties":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128}}}},"required":["version","componentId","sourceVersionId","params","seed"],"additionalProperties":false},"placement":{"oneOf":[{"type":"object","properties":{"version":{"type":"number","const":3},"kind":{"type":"string","const":"clip"}},"required":["version","kind"],"additionalProperties":false},{"type":"object","properties":{"version":{"type":"number","const":3},"kind":{"type":"string","const":"content-slots"},"slots":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":256},"additionalProperties":{"type":"object","properties":{"targetClipIds":{"type":"array","items":{"type":"string","minLength":1,"maxLength":256}},"ownership":{"type":"string","enum":["reference","exclusive"]}},"required":["targetClipIds","ownership"],"additionalProperties":false}}},"required":["version","kind","slots"],"additionalProperties":false}],"type":"object"}},"required":["kind","componentId","props"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"overlay"},"primitiveId":{"type":"string","minLength":1},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"zPlane":{"type":"string","enum":["front","behind-subject"]},"anchor":{"type":"object","properties":{"space":{"type":"string","const":"scene"},"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1}},"required":["space","x","y"],"additionalProperties":false},"parallax":{"type":"number","minimum":-0.3,"maximum":0.3}},"required":["kind","primitiveId","params"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"effect"},"primitiveId":{"type":"string","minLength":1},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"component":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/ComponentParameterValue"}},"seed":{"type":"string","minLength":1},"assets":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":256},"additionalProperties":{"type":"string","minLength":1,"maxLength":256}},"mediaBindings":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":128},"additionalProperties":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128}}}},"required":["version","componentId","sourceVersionId","params","seed"],"additionalProperties":false},"targetTrackIds":{"minItems":1,"type":"array","items":{"type":"string","minLength":1}},"wrapperOrder":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"card"},"html":{"type":"string","minLength":1,"description":"Your card's HTML — rendered VERBATIM as the graphic (shell motion via applyMotionPreset in a FOLLOWING call). CANVAS CONTRACT: the card renders in a viewport equal to the composition format's pixel frame (1080×1920 at 9:16 fhd); the root is NOT auto-pinned — declare explicit width/height matching the frame (box-sizing:border-box) and anchor content with flex/grid; position:absolute;inset:0 on the root does NOT fill the frame; for edge-to-edge backgrounds add an inner absolutely-positioned layer with generous negative inset. Overlay compositing applies a ~92% safe-area inset — keep critical copy away from the extreme edges. FONTS: name a family from GET /v1/fonts (list_render_fonts) — the renderer loads those faces for the card and waits for them, so `font-family: Inter` draws Inter. `@import` and remote font files are REFUSED: the card renders with no network. A family that is not on that list has no bytes behind it and the browser falls back, so end any stack with a generic (`Inter, sans-serif`) rather than relying on a system face being present."},"tokens":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"zPlane":{"type":"string","const":"front"}},"required":["kind","html"],"additionalProperties":false}],"type":"object"},"kind":{"type":"string","enum":["video","audio","image","overlay","effect"]},"opacity":{"type":"number","minimum":0,"maximum":1},"scale":{"type":"number","exclusiveMinimum":0},"rotation":{"type":"number"},"position":{"type":"object","properties":{"x":{"type":"number","minimum":-1,"maximum":2},"y":{"type":"number","minimum":-1,"maximum":2}},"required":["x","y"],"additionalProperties":false,"description":"Clip CENTRE as a fraction of the frame: {x:0.5,y:0.5} is dead centre, 0 to 1 is inside the frame, and a little overshoot (down to -1, up to 2) is how an entrance starts off-canvas. NOT pixels: the renderer maps x to `left: x*100%`, so `x: 180` sits 180 frame-widths away and draws nothing."},"region":{"type":"object","properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"w":{"type":"number","exclusiveMinimum":0,"maximum":1},"h":{"type":"number","exclusiveMinimum":0,"maximum":1}},"required":["x","y","w","h"],"additionalProperties":false},"fit":{"type":"string","enum":["cover","contain"]},"captionVisibility":{"description":"Video media clip only. Hide native captions while this clip is topmost and covers the lower picture, or when an opaque, effect-free clip has an explicitly full-frame region, even with fit:contain. Caption words and timings remain stored and resume when another visible clip takes over.","type":"string","enum":["visible","hidden"]},"effects":{"type":"array","items":{"type":"object","properties":{"primitiveId":{"type":"string","minLength":1},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"id":{"type":"string","minLength":1},"component":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/ComponentParameterValue"}},"seed":{"type":"string","minLength":1},"assets":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":256},"additionalProperties":{"type":"string","minLength":1,"maxLength":256}},"mediaBindings":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":128},"additionalProperties":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128}}}},"required":["version","componentId","sourceVersionId","params","seed"],"additionalProperties":false},"window":{"type":"object","properties":{"startTime":{"type":"number","minimum":0},"duration":{"type":"number","exclusiveMinimum":0}},"required":["startTime","duration"],"additionalProperties":false}},"additionalProperties":false}},"transitionIn":{"type":"object","properties":{"type":{"type":"string","minLength":1},"duration":{"type":"number","exclusiveMinimum":0},"id":{"type":"string","minLength":1},"component":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"stri