installed component. It returns the SAME content-addressed VP9-alpha motion clip the production render composites. Returns a jobId — wait_job(kind='preview') for the artifact. Compile/runtime failures land on the job terminal with the sanitized author-fixable message.","security":[{"bearerAuth":[]},{"x402":[]}],"x-permissions":{"projects":["write"]},"x-x402":{"amount":"20000","deliverable":true,"maxTimeoutSeconds":600},"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComponentPreviewRequest"}}}},"responses":{"202":{"description":"Preview job queued.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobEnqueueResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required — billing_required or x402 payment_*.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"409":{"description":"Conflict — stale_etag / idempotency_conflict / suggestions_already_complete.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"Unprocessable — invalid_composition / media_in_use / session_in_use / render_not_cancellable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}