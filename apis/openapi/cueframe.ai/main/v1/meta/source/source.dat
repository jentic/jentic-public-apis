2. Free.","security":[{"bearerAuth":[]},{"x402":[]}],"x-x402":"write","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TraceScoresRequest"}}}},"responses":{"202":{"description":"Scores accepted and forwarded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TraceScoresResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required. Returned when the caller presents no API key on a priced operation: the body AND the `Payment-Required` header carry the x402 v2 challenge (accepted scheme, network, USDC asset, amount, payTo). Sign the EIP-3009 authorization and retry with a `PAYMENT-SIGNATURE` header. A KEYED caller sees this status instead when their plan lacks or has exhausted the feature (`billing_required`).","headers":{"Payment-Required":{"description":"Base64 x402 v2 PaymentRequired envelope — the same challenge as the body, for clients that read it off the header.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/X402PaymentRequired"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Rate limited. Retry-After header present.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"503":{"description":"Service unavailab