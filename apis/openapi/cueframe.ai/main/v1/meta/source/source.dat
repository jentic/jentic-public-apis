ec":{"type":"number","minimum":0,"description":"Segment START in seconds, clip-relative. Segments tile the clip's duration in order."},"endSec":{"type":"number","exclusiveMinimum":0,"description":"Segment END in seconds, clip-relative. The span (endSec − startSec) is this segment's duration — the window `ease` ramps over."},"focus":{"oneOf":[{"type":"object","properties":{"mode":{"type":"string","const":"frame-center"}},"required":["mode"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"point"},"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1}},"required":["mode","x","y"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"face"},"faceId":{"type":"string","minLength":1},"shotScale":{"type":"string","enum":["close","standard","wide"]}},"required":["mode","faceId"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"all-faces"}},"required":["mode"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"active-speaker"}},"required":["mode"],"additionalProperties":false}],"description":"WHO/WHAT the camera tracks this segment (the reframe center), selected by `mode`: `frame-center` = no tracking, hold the geometric center (static/graphic footage, or a pure zoom); `point` = lock to a fixed source-normalized {x,y} (a non-moving on-screen element); `face` = track a detected face by `faceId` (from get_media_context), with optional `shotScale` close|standard|wide for tightness; `all-faces` = frame the bounding box of every detected face (group/ensemble shots); `active-speaker` = follow whoever is speaking (diarized talking-head / podcast). Pick by what the beat is about; pair with `zoom` for how tight.","type":"object"},"intent":{"description":"Optional editorial LABEL for diff/log readability (e.g. 'speaker-tight', 'wide-context'). Cosmetic — NOT honored by the derive math and excluded from the variant cache key.","type":"string"},"zoom":{"description":"How TIGHT the framing is — the fraction of the source the output viewport shows. <1 punches IN (a smaller source fraction, magnified to fill the frame); 1 = the full frame (no crop). ~0.6–0.8 is a moderate push-in, ~0.5 a tight close-up, 0.1 the maximum zoom. There is NO zoom-OUT past the full frame (max 1). Omit for the full frame. MUTUALLY EXCLUSIVE with `focus.shotScale` — a face-tracked shot is sized EITHER by the editorial scale (shotScale, which the bake calibrates to the detected face) OR by an explicit zoom, never both. A segment carrying both is REJECTED: shotScale wins at bake time and the zoom would be silently discarded.","type":"number","minimum":0.1,"maximum":1},"ease":{"description":"Zoom/center ramp DURATIONS in SECONDS at this segment's edges — NOT a unitless 0–1 curve. ~0.3–0.6s reads as a snappy push; >1s reads sluggish. Keep `in` + `out` ≤ the segment's duration (endSec − startSec): the two edges share the span, so to ramp across the WHOLE segment set one edge to the full duration and the other to 0. Omit for an instant cut to this framing.","type":"object","properties":{"in":{"type":"number","minimum":0,"description":"Ease-IN ramp DURATION in seconds at the segment START."},"out":{"type":"number","minimum":0,"description":"Ease-OUT ramp DURATION in seconds at the segment END."}},"required":["in","out"],"additionalProperties":false},"bias":{"description":"Optional FINE framing nudge off the focus center, source-normalized in [−0.3, 0.3]. A small correction (headroom, rule-of-thirds), NOT a reframe — use `focus`/`zoom` for the actual shot. Omit (treated as 0) to sit dead-center on the focus.","type":"object","properties":{"x":{"type":"number","minimum":-0.3,"maximum":0.3,"description":"Horizontal nudge, source-normalized (+ = right)."},"y":{"type":"number","minimum":-0.3,"maximum":0.3,"description":"Vertical nudge, source-normalized (+ = down)."}},"required":[