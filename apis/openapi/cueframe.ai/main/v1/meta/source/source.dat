id/suggestions envelope."},"SuggestionsTriggerResponse":{"type":"object","properties":{"status":{"type":"string","enum":["queued","running","complete","failed"]},"alreadyRunning":{"type":"boolean"}},"required":["status"],"additionalProperties":false,"description":"POST /media/:id/suggestions response."},"TemplateApplyPendingResponse":{"type":"object","properties":{"templateId":{"type":"string"},"version":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"pendingMediaIds":{"type":"array","items":{"type":"string"}}},"required":["templateId","version","pendingMediaIds"],"additionalProperties":false},"TemplateApplyRequest":{"type":"object","properties":{"componentExecutionVersions":{"minItems":1,"maxItems":1,"type":"array","items":{"type":"number","const":3}},"expectedBrandIdentity":{"type":"string","pattern":"^[a-f0-9]{64}$"},"projectId":{"type":"string","minLength":1},"values":{"default":{},"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"media":{"default":{},"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/TemplateMediaValue"}},"preset":{"type":"string","minLength":1},"brandKitId":{"type":"string","minLength":1}},"required":["projectId","values","media"],"additionalProperties":false,"examples":[{"projectId":"observed-project","values":{},"media":{}}]},"TemplateMediaValue":{"anyOf":[{"type":"object","properties":{"mediaId":{"type":"string","minLength":1}},"required":["mediaId"],"additionalProperties":false},{"type":"object","properties":{"url":{"type":"string","format":"starts_with","pattern":"^https:\\/\\/.*"},"mimeType":{"type":"string","minLength":1}},"required":["url"],"additionalProperties":false},{"type":"object","properties":{"sample":{"type":"boolean","const":true}},"required":["sample"],"additionalProperties":false}]},"TemplateApplyResponse":{"type":"object","properties":{"projectId":{"type":"string"},"compositionId":{"type":"string"},"versionId":{"type"