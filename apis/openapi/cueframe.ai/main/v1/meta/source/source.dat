ontStyle":{"type":"string","enum":["normal","italic"]},"emphasisPlate":{"type":"boolean"},"emphasisPlateColor":{"type":"string"},"emphasisPlateTextColor":{"type":"string"},"emphasisPlateAltColor":{"type":"string"},"emphasisPlateAltTextColor":{"type":"string"},"emphasisPlateRadius":{"type":"number","minimum":0},"emphasisPlatePadX":{"type":"number"},"emphasisPlatePadY":{"type":"number"},"emphasisPlateReveal":{"description":"Grow a shared emphasis plate as saved words appear while reserving its final layout width.","type":"boolean"},"annotationColor":{"type":"string"},"annotationStrokeWidth":{"description":"Annotation stroke width in its 100×100 SVG coordinate system; default 4.","type":"number","minimum":0.5,"maximum":12},"annotationTexture":{"description":"Native annotation stroke finish; default clean.","type":"string","enum":["clean","pencil"]},"entrance":{"type":"string","enum":["none","fade","word-pop","stagger-up"]},"entranceMs":{"type":"number","minimum":0},"entranceStaggerMs":{"type":"number","minimum":0},"exitMs":{"type":"number","minimum":0}},"additionalProperties":false},"holdThroughWordIndex":{"description":"Inclusive saved-word index in this segment. The layout stays visible until that word ends.","type":"integer","minimum":0,"maximum":9007199254740991},"wordMarks":{"type":"array","items":{"type":"object","properties":{"wordIndex":{"type":"integer","minimum":0,"maximum":9007199254740991},"emphasis":{"type":"boolean"},"annotate":{"anyOf":[{"type":"string","enum":["circle","underline"]},{"type":"null"}]}},"required":["wordIndex"],"additionalProperties":false}}},"required":["segmentIndex","wordStartIndex","wordEndIndex","region"],"additionalProperties":false}}},"required":["type","layouts"],"additionalProperties":false,"description":"Replace native caption placements without changing transcript words or timings. Each layout references a half-open word-index range in one saved segment; a one-word range is valid. region places that group independently, optional bounded scale/rotation/style changes its look, and holdThroughWordIndex keeps it visible through a later saved word in the same segment. All words in a placed range occupy one page; rendering refuses a range that cannot fit its box, so enlarge region or split the range. The box reserves horizontal space of 1.6 font sizes and vertical space of 0.8 font sizes for padding, with at most three lines. Unreferenced words keep the default caption layout. Word ranges must not overlap. Reapply after caption regeneration or timeline cuts."},{"type":"object","properties":{"type":{"type":"string","const":"setCaptionDepth"},"zPlane":{"type":"string","enum":["front","behind-subject"]}},"required":["type","zPlane"],"additionalProperties":false,"description":"Set the caption compositing plane. Use `behind-subject` to place captions behind the segmented foreground subject; use `front` for conventional captions above all video layers."},{"type":"object","properties":{"type":{"type":"string","const":"setCaptions"},"segments":{"type":"array","items":{"type":"object","properties":{"words":{"type":"array","items":{"type":"object","properties":{"text":{"type":"string","minLength":1},"startMs":{"type":"number","minimum":0,"description":"Word start on the composition timeline, in milliseconds."},"endMs":{"type":"number","minimum":0,"description":"Word end on the composition timeline, in milliseconds."},"emphasis":{"type":"boolean"},"annotate":{"type":"string","enum":["circle","underline"]}},"required":["text","startMs","endMs"],"additionalProperties":false}}},"required":["words"],"additionalProperties":false}},"style":{"type":"object","properties":{"fontFamily":{"type":"string","minLength":1},"fontSize":{"description":"Font size as % of composition height (1-15, default 5). NOT px.","type":"number","minimum":1,"maximum":15},"fontWeight":{"type":"integer","minimum":100,"maximum":900},"color":{"type":"string","minLength":1},"highlightColor":{"type":"string","minLength":1},"backgroundColor":{"type":"string"},"plate":{"type":"string","enum":["glass","solid","none"]},"position":{"type":"string","enum":["top","center","bottom"]},"region":{"description":"Optional caption layout box {x,y,w,h} in normalized output-frame coordinates. Overrides position; text starts at its top edge and wraps/pages within its width and height.","type":"object","properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"w":{"type":"number","exclusiveMinimum":0,"maximum":1},"h":{"type":"number","exclusiveMinimum":0,"maximum":1}},"required":["x","y","w","h"],"additionalProperties":false},"textTransform":{"type":"string","enum":["none","uppercase","capitalize"]},"letterSpacing":{"description":"Base caption glyph spacing in pixels.","type":"number","minimum":-5,"maximum":20},"wordGapEm":{"description":"Gap between caption runs as a multiple of base font size; default 0.35.","type":"number","minimum":0,"maximum":2},"lineGapEm":{"description":"Gap between caption lines as a multiple of base font size; default 0.25.","type":"number","minimum":0,"maximum":2},"emphasisColor":{"type":"string"},"emphasisGradient":{"type":"string"},"emphasisScale":{"type":"number","exclusiveMinimum":0},"emphasisFontFamily":{"type":"string"},"emphasisFontWeight":{"type":"integer","minimum":100,"maximum":900},"emphasisTextTransform":{"type":"string","enum":["none","uppercase","capitalize"]},"emphasisLetterSpacing":{"type":"number"},"emphasisFontStyle":{"type":"string","enum":["normal","italic"]},"entrance":{"type":"string","enum":["none","fade","word-pop","stagger-up"]},"entranceMs":{"type":"number","minimum":0},"entranceStaggerMs":{"type":"number","minimum":0},"exitMs":{"type":"number","minimum":0},"emphasisPlate":{"type":"boolean"},"emphasisPlateColor":{"type":"string"},"emphasisPlateTextColor":{"type":"string"},"emphasisPlateAltColor":{"type":"string"},"emphasisPlateAltTextColor":{"type":"string"},"emphasisPlateRadius":{"type":"number","minimum":0},"emphasisPlatePadX":{"type":"number"},"emphasisPlatePadY":{"type":"number"},"emphasisPlateReveal":{"description":"Grow a shared emphasis plate as saved words appear while reserving its final layout width.","type":"boolean"},"annotationColor":{"type":"string"},"annotationStrokeWidth":{"description":"Annotation stroke width in its 100×100 SVG coordinate system; default 4.","type":"number","minimum":0.5,"maximum":12},"annotationTexture":{"description":"Native annotation stroke finish; default clean.","type":"string","enum":["clean","pencil"]},"maxWidthPercent":{"type":"number","exclusiveMinimum":0,"maximum":100}},"additionalProperties":false}},"required":["type","segments"],"additionalProperties":false,"description":"Replace the caption SEGMENTS wholesale — author the word-timed caption layer directly (each segment = one sentence/page of `words` with timeline-ms `startMs`/`endMs`, optional `emphasis`). This is how a client with its OWN word timings (e.g. a generated VO take) gets word-synced captions without a source transcript; the compose lane's transcript slice writes the same layer. `style`, when given, merges with setCaptionStyle semantics; an omitted style keeps the existing one. Renderer paginates within a segment and never pools words across two — keep segments sentence-bounded."},{"type":"object","properties":{"type":{"type":"string","const":"captions.fromTranscript"},"mediaId":{"type":"string","minLength":1},"window":{"type":"object","properties":{"startSec":{"type":"number","minimum":0},"endSec":{"type":"number","exclusiveMinimum":0}},"required":["startSec","endSec"],"additionalProperties":false}},"required":["type","mediaId"],"additionalProperties":false,"description":"Attach caption CONTENT from the media's cached transcript — no pasting words. ROUTE-MATERIALIZED like applyMotionPreset/materializeGrid: the server slices the word-timed transcript to `window` (source seconds; absent = the whole media), rebases times, sentence-splits into segments, and applies it as `setCaptions`. 422 media_no_transcript when the media has no transcript or no words in the window. For your OWN word timings use setCaptions directly. For edited multi-clip timelines, use captions.fromComposition after saving the edits; that operation projects all selected track clips, trims, exclusions, and placements."},{"type":"object","properties":{"type":{"type":"string","const":"captions.fromComposition"},"trackId":{"type":"string","minLength":1}},"required":["type","trackId"],"additionalProperties":false,"description":"Snapshot word-timed captions from the SAVED edits on one explicit enabled video or audio track. The host reads each source media transcript, projects words through clip trim, excluded ranges and placement, then replaces the caption segments. This is route-materialized to setCaptions; call it AFTER persisting clip edits and call it again when those edits change. The existing caption style and depth are preserved. Missing transcripts, unsupported clips, inconsistent clip durations, and overlapping audible clips fail loud. Playback rate scales source word times and playable duration on both audio and video tracks."},{"type":"object","properties":{"type":{"type":"string","const":"applyMotionPreset"},"clipId":{"type":"string"},"preset":{"type":"string"},"params":{"type":"object","properties":{"enterMs":{"type":"number"},"exitMs":{"type":"number"},"staggerMs":{"type":"number"}},"additionalProperties":false}},"required":["type","clipId","preset"],"additionalProperties":false,"description":"Shell a STATIC `card` clip with a frame-driven MOTION preset — the public card-shelling op (the layout renders VERBATIM; only the container animates in/out). The server wraps the card in the chosen `preset` (fade-up / slide-in-left / slide-in-right / scale-pop / stagger-reveal), transpiles it, mints it as a LIVE component, and swaps the clip source to that component (the bakeless live lane — no box). `params` tunes timing (`enterMs`/`exitMs`, `staggerMs` for stagger-reveal). The target must be a static card (components already carry motion; library overlays already move); re-run overwrites idempotently ONLY while the target is still a card (an uncompilable shell); once shelled, the clip is a COMPONENT — to change its motion, remove and re-add the card, then re-shell. Honored under `dry_run` (validates preset + target without transpiling or persisting). ORDERING: the preset resolves its target against the PERSISTED composition — a card added in the SAME batch is not yet visible to it. Persist the clip.add batch first, then shell in a following call."},{"type":"object","properties":{"type":{"type":"string","const":"materializeGrid"},"clipId":{"type":"string"},"grid":{"type":"string","enum":["beat","word","shot"]},"maxMarkers":{"type":"integer","exclusiveMinimum":0,"maximum":2000}},"required":["type","clipId","grid"],"additionalProperties":false,"description":"Materialize a clip's SOURCE-media temporal GRID as timeline markers — the rhythm authority you cut to. `grid:\"beat\"` reads a MUSIC bed's beat map (get_media_context.beatGrid), `grid:\"word\"` the VO word onsets (wordGrid); each grid point is projected from media time to TIMELINE time through the clip's placement (startTime, trim, playbackRate, excludedRanges) and written as a `kind:\"beat\"|\"word\"` marker (`metadata.sourceClipId` set). Points outside the clip's visible window are skipped. Re-running REPLACES the prior markers from the same clip+grid (idempotent). Land cuts and transition MIDPOINTS on the markers (a 0.5s transition starts 0.25s before its marker). `maxMarkers` (default 500, ceiling 2000) — exceeding it fails loud with the count. `grid:\"shot\"` is not yet exposed (shot_grid_unavailable). The target must be a media clip; absent evidence fails loud (grid_unavailable) naming how to get it (declare audioRole:\"music\" at ingest / transcribe)."},{"type":"object","properties":{"type":{"type":"string","const":"setFormat"},"format":{"type":"object","properties":{"aspectRatio":{"type":"string","enum":["16:9","9:16","1:1","4:5"]},"fps":{"anyOf":[{"type":"number","const":24},{"type":"number","const":25},{"type":"number","const":30},{"type":"number","const":60}]},"resolution":{"type":"string","enum":["hd","fhd","4k"]}},"required":["aspectRatio"],"additionalProperties":false}},"required":["type","format"],"additionalProperties":false,"description":"Set the output format — `aspectRatio` (16:9|9:16|1:1|4:5) plus optional `fps` and `resolution`. Merges: an omitted field keeps the current value."},{"type":"object","properties":{"type":{"type":"string","const":"addTrack"},"kind":{"type":"string","enum":["video","audio","image","overlay","effect"]},"name":{"type":"string"},"id":{"type":"string"}},"required":["type","kind"],"additionalProperties":false,"description":"Add an EMPTY track of a given family (video|audio|image|overlay|effect). Optional pinned `id`. The new track is appended, so it starts at the BACK: index 0 is the top layer and higher indices are further back (see `reorderTracks`). Track order only ranks clips on the same plane — every overlay draws above the video lane unless its `zPlane` is `behind-subject`, whatever its track index."},{"type":"object","properties":{"type":{"type":"string","const":"removeTrack"},"trackId":{"type":"string"}},"required":["type","trackId"],"additionalProperties":false,"description":"Remove a track AND all its clips by id."},{"type":"object","properties":{"type":{"type":"string","const":"updateTrack"},"trackId":{"type":"string"},"updates":{"type":"object","properties":{"name":{"type":"string"},"enabled":{"type":"boolean"}},"additionalProperties":false}},"required":["type","trackId","updates"],"additionalProperties":false,"description":"Patch a track's `name` / `enabled` by id."},{"type":"object","properties":{"type":{"type":"string","const":"reorderTracks"},"fromIndex":{"type":"number"},"toIndex":{"type":"number"}},"required":["type","fromIndex","toIndex"],"additionalProperties":false,"description":"Move a track from one index to another. ORDER: index 0 is the TOP layer, not the bottom — moving a backdrop to index 0 puts it in FRONT of everything and hides the composition. Higher index = further back. PRECEDENCE: track order decides compositing only among clips on the same plane. Overlays are composited in a lane ABOVE the video lane whatever their track index; the one exception is `zPlane:\"behind-subject\"`, which moves the overlay inside its host clip, behind the segmented foreground. So if reordering tracks does not change what you see, the plane split already decided it."},{"type":"object","properties":{"type":{"type":"string","const":"moveClipToTrack"},"clipId":{"type":"string"},"targetTrackId":{"type":"string"},"newStartTime":{"type":"number"}},"required":["type","clipId","targetTrackId"],"additionalProperties":false,"description":"Move a clip to another SAME-family track, optionally at a new `newStartTime`."},{"type":"object","properties":{"type":{"type":"string","const":"duplicateClip"},"clipId":{"type":"string"},"newClipId":{"type":"string"}},"required":["type","clipId"],"additionalProperties":false,"description":"Duplicate a clip by id. Pin `newClipId` to make the copy's id deterministic (required for a clean undo/inverse)."},{"type":"object","properties":{"type":{"type":"string","const":"cutAndRipple"},"start":{"type":"number"},"end":{"type":"number"}},"required":["type","start","end"],"additionalProperties":false,"description":"Server-authoritative: delete the [start,end] time window (seconds) and ripple every downstream clip/marker/caption earlier to close the gap."},{"type":"object","properties":{"type":{"type":"string","const":"ripple"},"time":{"type":"number"},"amount":{"type":"number"}},"required":["type","time","amount"],"additionalProperties":false,"description":"Server-authoritative: shift everything at/after `time` (seconds) by `amount` seconds (+ opens a gap, − closes one)."},{"type":"object","properties":{"type":{"type":"string","const":"addExcludedRange"},"clipId":{"type":"string"},"sourceStart":{"type":"number"},"sourceEnd":{"type":"number"},"reason":{"type":"string"}},"required":["type","clipId","sourceStart","sourceEnd"],"additionalProperties":false,"description":"Server-authoritative: exclude a [sourceStart,sourceEnd] span (seconds) of a clip's SOURCE (an internal trim) and ripple downstream — the preferred way to drop a sub-range vs a source patch."},{"type":"object","properties":{"type":{"type":"string","const":"removeExcludedRange"},"clipId":{"type":"string"},"rangeIdx":{"type":"number"}},"required":["type","clipId","rangeIdx"],"additionalProperties":false,"description":"Server-authoritative: remove a clip's previously-added excluded range by index (re-includes that span, ripples downstream)."},{"type":"object","properties":{"type":{"type":"string","const":"component.repin"},"componentId":{"type":"string"},"from":{"type":"string"},"to":{"type":"string"}},"required":["type","componentId","from","to"],"additionalProperties":false,"description":"Move every pin of a component at version `from` to version `to`: the clips that place it and the scene surfaces that nest it. A clip's version changes only through a composition write; a component edit issues this op over the composition it names."},{"type":"object","properties":{"type":{"type":"string","const":"component.repin-v3"},"componentId":{"type":"string","minLength":1},"from":{"type":"string","pattern":"^[a-f0-9]{64}$"},"to":{"type":"string","pattern":"^[a-f0-9]{64}$"},"expectedCompositionEtag":{"type":"string","minLength":1},"changes":{"minItems":1,"maxItems":512,"type":"array","items":{"type":"object","properties":{"placementId":{"type":"string","minLength":1},"before":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/ComponentParameterValue"}},"seed":{"type":"string","minLength":1},"assets":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":256},"additionalProperties":{"type":"string","minLength":1,"maxLength":256}},"mediaBindings":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":128},"additionalProperties":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128}}}},"required":["version","componentId","sourceVersionId","params","seed"],"additionalProperties":false},"after":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/ComponentParameterValue"}},"seed":{"type":"string","minLength":1},"assets":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":256},"additionalProperties":{"type":"string","minLength":1,"maxLength":256}},"mediaBindings":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":128},"additionalProperties":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128}}}},"required":["version","componentId","sourceVersionId","params","seed"],"additionalProperties":false}},"required":["placementId","before","after"],"additionalProperties":false}}},"required":["type","componentId","from","to","expectedCompositionEtag","changes"],"additionalProperties":false,"description":"Atomically repin explicit version3 invocations using complete before/after execution references and an exact composition etag. Persistence must canonically admit scoped source hashes, destination input schemas and every resulting target context before applying, including replay/undo. Never infer a latest head, downgrade versions or accept an admitted flag."}],"description":"One scoped composition operation. Discriminated by `type` — `clip.add` / `clip.remove` / `clip.update` patch clips across any family; the rest cover markers, reframe, effects, captions, format, tracks, and the server-authoritative ripple recomputes. Every variant is `.strict()`: an unknown field is refused, not ignored.","type":"object"},"SceneShotSpecV2":{"type":"object","properties":{"version":{"type":"number","const":2},"referenceSize":{"type":"object","properties":{"width":{"type":"integer","minimum":16,"maximum":8192},"height":{"type":"integer","minimum":16,"maximum":8192}},"required":["width","height"],"additionalProperties":false},"camera":{"type":"object","properties":{"position":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"items":false,"minItems":3,"maxItems":3},"rotation":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"}],"items":false,"minItems":3,"maxItems":3},"fov":{"type":"number","minimum":0.3141592653589793,"maximum":1.3962634015954636}},"additionalProperties":false},"environment":{"default":{"lightingProfile":"studio","preset":"soft","intensity":1,"floorY":-420,"shadowOpacity":0.5},"anyOf":[{"type":"object","properties":{"kind":{"type":"string","const":"studio"},"lightingProfile":{"default":"studio","type":"string","enum":["studio","studio-edge"]},"preset":{"default":"soft","type":"string","enum":["soft","key","rim"]},"intensity":{"default":1,"type":"number","minimum":0},"floorY":{"default":-420,"type":"number"},"shadowOpacity":{"default":0.5,"type":"number","minimum":0,"maximum":1}},"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"photographic-studio-v1"}},"required":["kind"],"additionalProperties":false}]},"backdrop":{"default":{"kind":"transparent"},"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"transparent"}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":