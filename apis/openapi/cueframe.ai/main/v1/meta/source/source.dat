ditionalProperties":false}},"required":["version","componentId","tsxSource","manifest","definition"],"additionalProperties":false}]},"supportedSourceVersions":{"minItems":1,"maxItems":2,"type":"array","items":{"anyOf":[{"type":"number","const":2},{"type":"number","const":3}]}},"projectId":{"description":"A project whose explicitly named composition moves its placements atomically with the source write. Requires compositionId and concurrency.","type":"string","minLength":1},"compositionId":{"description":"The exact composition observed by the caller. Required with projectId and concurrency.","type":"string","minLength":1},"concurrency":{"description":"Caller-observed placement guard. component.repin currently requires mode:exact; guarded mode refuses before writes.","$ref":"#/components/schemas/CompositionConcurrency"}},"additionalProperties":false,"description":"PUT /components/:id body: every writable field, all optional; an omitted field is carried forward. Org/user are server-resolved; never accepted from the body.","examples":[{"name":"Renamed title"}]},"ComponentUpdateResponse":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":200},"description":{"type":"string","maxLength":2000},"category":{"type":"string","enum":["text","effects","transitions","layouts","backgrounds","ui-blocks","scenes"]},"propSchema":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"origin":{"type":"string","enum":["customer-owned","server-native"]},"ejectedFrom":{"type":"string","maxLength":200},"tokens":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"examples":{"description":"Usage examples, as authored. A built-in primitive projects {name, mood?, params?, description?}; an authored component's examples are whatever it wrote, which is why the item is open. One shape for both directions: what you write here is what you read back.","type":"array","items":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"durationInFrames":{"type":"number","exclusiveMinimum":0},"manifest":{"description":"The stored runtime manifest (assets, graphics API, alpha policy) of an org-INSTALLED component: the same object the create/update body takes, so a manifest read back here can be written back unchanged. Built-in defaults have no stored manifest and omit it. Its `version` is always 2 (the contract version), unlike the entry's semver `version`.","$ref":"#/components/schemas/ComponentManifestV2"},"id":{"type":"string","description":"The entry's id: a `primitiveId` for a built-in, a `componentId` for an installed component."},"source":{"type":"string","enum":["default","installed"],"description":"'default' = built-in primitive (place by primitiveId); 'installed' = org-authored component (place by componentId)."},"kind":{"type":"string","enum":["component","transition","scene"],"description":"RENDER kind (component | transition | scene). NOT the ClipSource variant — see `placement` for how to author it on the timeline."},"version":{"type":"string","description":"The ENTRY's version: a semver string ('0.0.0' until an authored component is versioned). Distinct from `manifest.version`, which is the runtime contract version and is always the literal 2."},"propDefaults":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"textParam":{"description":"The param field that carries this primitive's primary text; null = no single text slot.","type":["string","null"]},"subtextParam":{"description":"The param field for secondary text (subtitle/byline); null = none.","type":["string","null"]},"format":{"$ref":"#/components/schemas/SceneFormat"},"intent":{"description":"Selection signal: a verb naming what this primitive accomplishes (e.g. 'product-trailer'). Match it to the beat you are authoring.","type":"string"},"useWhen":{"description":"When to use this — AND when not to. The negative guidance is load-bearing; read it before picking.","type":"string"},"pairsWith":{"description":"Authoring guidance: ids of primitives that COMPOSE well with this one in the same edit.","type":"array","items":{"type":"string"}},"avoidWith":{"description":"Authoring guidance: ids of primitives that CONFLICT with this one — do not place together.","type":"array","items":{"type":"string"}},"tags":{"description":"Free-text search keywords.","type":"array","items":{"type":"string"}},"mood":{"description":"Vibe/tone tags (e.g. 'cinematic', 'minimal'). Filter to match the edit's mood.","type":"array","items":{"type":"string"}},"tier":{"description":"Quality/applicability RANKING (a preference, not a flag). Prefer 'recommended'; reach for 'niche' only when its specific use-case is exactly the beat.","type":"string","enum":["recommended","standard","niche"]},"useCase":{"description":"The edit ROLE(s) this primitive fills — the dimension to filter by for a beat (e.g. 'intro', 'title-over-footage', 'grade').","type":"array","items":{"type":"string","enum":["intro","outro","full-scene","title-over-footage","transition","background","grade","emphasis","explainer","social-cut"]}},"fixedCopy":{"description":"On-screen strings this primitive BAKES — the read-side counterpart to propSchema. These literals render REGARDLESS of params (no param can change them); fork the source via get_component_source to edit them. Use this to see at author time what fixed copy (someone-else's marketing text, faux-code, faux-data) will appear before you render.","type":"array","items":{"type":"string"}},"brandBindings":{"description":"Params that can follow the project brand kit. Each {param, brandToken} says: set `param` to `brandToken` (a `$brand:` ref, e.g. '$brand:colors.accent') to track the brand instead of a literal. See the list response's `brandTokens` for the full ref vocabulary. Omitted when nothing is brand-bound.","type":"array","items":{"type":"object","properties":{"param":{"type":"string"},"brandToken":{"type":"string"}},"required":["param","brandToken"],"additionalProperties":false}},"placement":{"description":"How to author this entry as a ClipSource via apply_composition: the exact ClipSource `kind` + the id field to key it by. Built-ins place as {kind:'overlay'|'effect', primitiveId}; installed components place as {kind:'component', componentId}. A kind:'scene' primitive has no 'scene' ClipSource — it is placed as {kind:'overlay', primitiveId}.","$ref":"#/components/schemas/ComponentPlacement"},"warnings":{"description":"Non-blocking save-time advisories — the create/update SUCCEEDED. Currently: a `fontFamily` string literal referencing a NON-vendored font (a bare CSS generic like 'serif', or an unknown named family like 'Arial') whose LIVE-lane pixels vary by render host — re-author with a vendored family or 'Georgia'. Omitted when there is nothing to flag; only present on the create/update responses.","type":"array","items":{"type":"string"}},"repinned":{"description":"Present when the update named `projectId`: the composition whose placements moved to the new version.","type":"object","properties":{"compositionId":{"type":"string"},"pins":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Placements in that composition moved from the previous version to this one, nested scene surfaces included."},"etag":{"description":"The composition's ETag after the move; null when no pin moved.","type":["string","null"]}},"required":["compositionId","pins","etag"],"additionalProperties":false},"placementsPinnedToPrevious":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"Placements across the org that still pin the previous version and will keep rendering it. Name `projectId` (and `compositionId`) on the update to move a composition's placements with it."}},"required":["name","description","category","propSchema","id","source","kind","version","placement","placementsPinnedToPrevious"],"additionalProperties":false,"description":"Updated component entry plus where its placements point."},"ComposeCreateRequest":{"type":"object","properties":{"suggestionId":{"type":"string","minLength":1},"fromComposition":{"description":"Reuse the project's current composition as the compose starting point (critique-retry path). The Director RE-AUTHORS graphics: if the current composition is client-authored and contains graphic clips (overlay/component/card), the request is refused (validation_error naming the clips) — render it verbatim with create_render instead. The director's own output (critique-retry) is exempt.","type":"boolean"},"briefId":{"description":"Compose from a persisted Brief (create_brief) — the intent-first door: every Brief field is HONORED or the request is refused loudly naming the field (window from beat moment-pinning; seeded graphics carried VERBATIM as locked clips; exclusions enforced; locale + caption emphasis threaded to the Director). Exactly ONE of suggestionId | fromComposition | briefId.","type":"string","minLength":1},"format":{"description":"Optional format override. Phase 2 ignores this — format precedence is project.compositionFormat → 9:16 fhd 30fps default.","$ref":"#/components/schemas/FormatSpec"},"scope":{"description":"RequestScope discriminated union (per compose-api-contract.md). Editor-only scopes (captions/overlay-track/broll/overlay-instance/segment) require an editor-session token; API tokens get 403 on those."},"critique":{"description":"Structured critique block (per compose-api-contract.md decision #11). Capped at 2KB total; per-criterion blocks capped at 500 chars.","type":"string","maxLength":2000},"parentJobId":{"description":"Pointer to the prior compose job this run iterates on. Surfaced on the resulting compose job as baselineComposeJobId.","type":"string"},"maxCandidates":{"description":"Ensemble size. Currently pinned to 1 — the multi-candidate ensemble is disabled pending a capacity bound, so any value >1 is ignored and every compose runs a single candidate. Still accepted for forward-compat; will honor [1, 5] again once re-enabled.","type":"integer","minimum":1,"maximum":5},"budgetUsd":{"description":"Per-job budget cap (USD). Clamped at the route against the org's composeMaxBudgetUsdPerJob setting.","type":"number","exclusiveMinimum":0},"qualityThreshold":{"description":"Composite-score accept threshold. Server default per contract.","type":"number","minimum":0,"maximum":10},"seed":{"description":"Deterministic seed for replay.","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"clientNonce":{"description":"Opaque caller token that disambiguates intentional same-critique retries. Without it, identical (project, sug, seed, critique) tuples deduplicate; with it, retries create a fresh execution.","type":"string","maxLength":64},"holdAt":{"description":"Opt-in checkpoint gates. Each named stage pauses the compose at its boundary (status → awaiting_input) for client review via resume. Absent/empty ⇒ fully autonomous. Non-empty ⇒ the run is a single spine.","maxItems":3,"type":"array","items":{"type":"string","enum":["content","layout","motion"]}}},"additionalProperties":false,"description":"POST /projects/:id/compose body."},"ComposeCreateResponse":{"type":"object","properties":{"composeJobId":{"type":"string","description":"Opaque compose job id; pass to the SSE stream URL."},"projectId":{"type":"string"},"status":{"type":"string","enum":["queued","failed"],"description":"queued = normal; failed = startup failed and the job is already terminal (the SSE stream will emit a single `job_failed` frame and close)."},"streamUrl":{"description":"Relative SSE endpoint to stream this job's events (per compose-api-contract.md).","type":"string"}},"required":["composeJobId","projectId","status"],"additionalProperties":false,"description":"POST /projects/:id/compose response."},"ComposeJobDetailResponse":{"type":"object","properties":{"composeJobId":{"type":"string"},"projectId":{"type":"string"},"status":{"type":"string","enum":["queued",