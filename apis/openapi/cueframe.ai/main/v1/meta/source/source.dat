sans-serif`) rather than relying on a system face being present."},"tokens":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"zPlane":{"type":"string","const":"front"}},"required":["kind","html"],"additionalProperties":false}],"type":"object"},"kind":{"type":"string","enum":["video","audio","image","overlay","effect"]},"opacity":{"type":"number","minimum":0,"maximum":1},"scale":{"type":"number","exclusiveMinimum":0},"rotation":{"type":"number"},"position":{"type":"object","properties":{"x":{"type":"number","minimum":-1,"maximum":2},"y":{"type":"number","minimum":-1,"maximum":2}},"required":["x","y"],"additionalProperties":false,"description":"Clip CENTRE as a fraction of the frame: {x:0.5,y:0.5} is dead centre, 0 to 1 is inside the frame, and a little overshoot (down to -1, up to 2) is how an entrance starts off-canvas. NOT pixels: the renderer maps x to `left: x*100%`, so `x: 180` sits 180 frame-widths away and draws nothing."},"region":{"type":"object","properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"w":{"type":"number","exclusiveMinimum":0,"maximum":1},"h":{"type":"number","exclusiveMinimum":0,"maximum":1}},"required":["x","y","w","h"],"additionalProperties":false},"fit":{"type":"string","enum":["cover","contain"]},"captionVisibility":{"description":"Video media clip only. Hide native captions while this clip is topmost and covers the lower picture, or when an opaque, effect-free clip has an explicitly full-frame region, even with fit:contain. Caption words and timings remain stored and resume when another visible clip takes over.","type":"string","enum":["visible","hidden"]},"effects":{"type":"array","items":{"type":"object","properties":{"primitiveId":{"type":"string","minLength":1},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"id":{"type":"string","minLength":1},"component":{"type":"object","properties":{"version":{"ty