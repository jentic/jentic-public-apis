"data","pagination"],"additionalProperties":false},"TemplateSummary":{"type":"object","properties":{"id":{"type":"string"},"slug":{"type":"string"},"name":{"type":"string"},"version":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"documentSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"fromCatalog":{"type":"boolean"},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["id","slug","name","version","documentSha256","fromCatalog","createdAt","updatedAt"],"additionalProperties":false},"TemplatePublishRequest":{"anyOf":[{"$ref":"#/components/schemas/TemplatePublishDocumentRequest"},{"$ref":"#/components/schemas/TemplatePublishSlugRequest"}]},"TemplatePublishDocumentRequest":{"type":"object","properties":{"document":{"$ref":"#/components/schemas/TemplateDocument"},"dryRun":{"description":"When true, store nothing: answer 200 with the kernel's verdict on the document as `TemplateValidateResponse`. Without `values`, `media` or `preset` the document itself is checked (every preset binds against the parameters' samples and placeholder values for required parameters that have no default). With any of them, only the caller's inputs are bound, `{ mediaId }` values against this org's real media rows.","type":"boolean"},"values":{"description":"Dry run only (400 without `dryRun: true`): parameter values to bind, by parameter name.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"media":{"description":"Dry run only (400 without `dryRun: true`): media values to bind, by media parameter name.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/TemplateDryRunMediaValue"}},"preset":{"description":"Dry run only (400 without `dryRun: true`): the preset whose values the bind starts from.","type":"string","minLength":1}},"required":["document"],"additionalProperties":false},"TemplateDocument":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"A CueFrame template document (kernel TemplateDocument): v: 1, slug, name, composition with {{name}} references, parameters, components by value, an optional brandKit, presets, rubric, gallery and provenance."},"TemplateDryRunMediaValue":{"anyOf":[{"type":"object","properties":{"mediaId":{"type":"string","minLength":1}},"required":["mediaId"],"additionalProperties":false},{"type":"object","properties":{"sample":{"type":"boolean","const":true}},"required":["sample"],"additionalProperties":false}],"description":"A media value a dry run can resolve without importing anything: `{ mediaId }` (one of this org's media rows) or `{ sample: true }` (the parameter's pinned sample)."},"TemplatePublishSlugRequest":{"type":"object","properties":{"slug":{"type":"string","maxLength":80,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}},"required":["slug"],"additionalProperties":false},"TemplateRenderCreateRequest":{"type":"object","properties":{"values":{"default":{},"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"media":{"default":{},"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/TemplateMediaValue"}},"preset":{"type":"string","minLength":1},"brandKitId":{"type":"string","minLength":1},"posterAt":{"description":"Seconds into the render for the poster still; default 1.","type":"number","minimum":0}},"required":["values","media"],"additionalProperties":false},"TemplateRenderResponse":{"type":"object","properties":{"id":{"type":"string"},"status":{"type":"string","enum":["preparing","rendering","complete","failed","cancelled","revoked"]},"templateId":{"type":"string"},"version":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"preset":{"type":"string"},"brandKitId":{"type":"string"},"shareUrl":{"type":["string","null"]},"posterUrl":{"type":["string","null"]},"renderId":{"type":["string","null"]},"errorCode":{"type":"string"},"errorMessage":{"type":"string"},"expiresAt":{"type":"string"},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["id","status","templateId","version","shareUrl","posterUrl","renderId","createdAt","updatedAt"],"additionalProperties":false},"TemplateResponse":{"type":"object","properties":{"id":{"type":"string"},"slug":{"type":"string"},"name":{"type":"string"},"version":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991},"documentSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"fromCatalog":{"type":"boolean"},"document":{"$ref":"#/components/schemas/TemplateDocument"},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["id","slug","name","version","documentSha256","fromCatalog","document","createdAt","updatedAt"],"additionalProperties":false},"TemplateValidateResponse":{"type":"object","properties":{"ok":{"type":"boolean","description":"True when the kernel found no problem."},"slug":{"description":"The document's slug, or null when the document did not carry one.","type":["string","null"]},"problems":{"type":"array","items":{"$ref":"#/components/schemas/TemplateProblem"},"description":"Every problem found, in the order the kernel's checks run; empty when `ok`."}},"required":["ok","slug","problems"],"additionalProperties":false},"TemplateProblem":{"type":"object","properties":{"code":{"type":"string","description":"The problem's code: template_parse, template_parameter_undeclared, template_reference_misplaced, template_media_site, template_matte_stale, template_sample_missing, template_media_required, template_preset_unknown, template_values_invalid, template_media_kind_mismatch or payload_too_large."},"param":{"description":"The parameter the problem names, when it names one.","type":"string"},"message":{"type":"string"}},"required":["code","message"],"additionalProperties":false},"TimelineAnalysisRequest":{"type":"object","properties":{"words":{"minItems":1,"maxItems":12000,"type":"array","items":{"type":"object","properties":{"text":{"type":"string","minLength":1,"maxLength":1000},"timelineStart":{"type":"number","minimum":0},"timelineEnd":{"type":"number","minimum":0},"clipId":{"type":"string","minLength":1,"maxLength":256},"poolItemId":{"type":"string","minLength":1,"maxLength":256},"sourceStart":{"type":"number","minimum":0},"sourceEnd":{"type":"number","minimum":0},"speakerId":{"anyOf":[{"type":"string","maxLength":256},{"type":"null"}]}},"required":["text","timelineStart","timelineEnd","clipId","poolItemId","sourceStart","sourceEnd","speakerId"],"additionalProperties":false}}},"required":["words"],"additionalProperties":false,"description":"A bounded merged timeline transcript for CueFrame edit analysis. The server selects the model; clients cannot provide a provider, API key, or model override."},"TimelineAnalysisResponse":{"type":"object","properties":{"fillers":{"type":"array","items":{"type":"integer","minimum":0,"maximum":9007199254740991}},"silenceGaps":{"type":"array","items":{"type":"integer","minimum":0,"maximum":9007199254740991}},"emphasis":{"type":"array","items":{"type":"integer","minimum":0,"maximum":9007199254740991}}},"required":["fillers","silenceGaps","emphasis"],"additionalProperties":false,"description":"CueFrame-model analysis of timeline word indices. Every returned index refers to the request's words array."},"TraceScoresRequest":{"type":"object","properties":{"scores":{"minItems":1,"maxItems":10,"type":"array","items":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":64,"pattern":"^[a-z][a-z0-9_]*$"},"value":{"type":"number","minimum":0,"maximum":1},"comment":{"type":"string","maxLength":500}},"required":["name","value"],"additionalProperties":false}}},"required":["scores"],"additionalProperties":false,"description":"POST /traces/:traceId/scores body."},"TraceScoresResponse":{"type":"object","properties":{"accepted":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}},"required":["accepted"],"additionalProperties":false,"description":"POST /traces/:traceId/scores response."},"TranscriptAnalyzeRequest":{"type":"object","properties":{"task":{"type":"string","enum":["summary","chapters","highlights"],"description":"What to ask of the transcript. `summary` — prose: the argument plus the concrete takeaways as bullets. `chapters` — one line per subject change, `[h:mm:ss] Title — description`. `highlights` — up to 8 standalone moments, strongest first, one line each as `[h:mm:ss]-[h:mm:ss] Title — why it lands` plus the line that carries it. Every timestamp is ABSOLUTE seconds from the start of the media, including when you pass a `window`, and every one is verified against the transcript before you see it — but they are LINE-START markers about 15s apart, so treat a span as APPROXIMATE (up to 15s early) and refine it against the word timings from GET /v1/media/{id}/context before you cut."},"window":{"description":"Analyse only this slice of the transcript. Omit to analyse all of it. Words are windowed exactly as captions.fromTranscript windows them (a word straddling an edge is clamped, a word wholly outside is dropped). Use this when a long recording is rejected with `transcript_too_long`, and to chapter a single segment of a podcast without paying for the whole thing.","type":"object","properties":{"startSec":{"type":"number","minimum":0,"description":"Window start, SECONDS from the start of the media."},"endSec":{"type":"number","minimum":0,"description":"Window end, SECONDS from the start of the media."}},"required":["startSec","endSec"],"additionalProperties":false}},"required":["task"],"additionalProperties":false,"description":"One editorial question about a media item's transcript."},"TranscriptAnalyzeResponse":{"type":"object","properties":{"task":{"type":"string","enum":["summary","chapters","highlights"],"description":"Echo of the requested task — so a batched caller can pair answers to asks."},"result":{"type":"string","description":"The answer, as text. `summary` is prose; `chapters` and `highlights` are one record per LINE in the shape documented on the request's `task` field — split on newlines to parse them. Timestamps are absolute seconds from the start of the media and every one is CHECKED against the transcript before the response is returned (a fabricated timestamp fails the call rather than shipping), but they are line-start markers about 15s apart — a boundary can sit up to 15s BEFORE the moment you want. Use them to locate, not to cut: refine against the word timings in GET /v1/media/{id}/context."}},"required":["task","result"],"additionalProperties":false,"description":"The analysis of one media item's transcript. Metered: this is a real LLM call, billed on measured token spend, so it is not a read to poll."},"UploadTokenRequest":{"type":"object","properties":{"projectId":{"description":"Optional project to scope the token to; omitted = org library.","type":"string"}},"additionalProperties":false},"UploadTokenResponse":{"type":"object","properties":{"token":{"type":"string"},"expiresAt":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"Expiry, ms since epoch (~30 min TTL)."}},"required":["token","expiresAt"],"additionalProperties":false,"description":"POST /uploads/token response: a short-lived token for the signed upload lane (the upload-signing worker's `uppy-auth-token` header). The org is derived from the session server-side and stamped into the token."},"UsageEventResponse":{"type":"object","properties":{"featureId":{"type":"string","description":"The metered plan feature (exports, compose, compose_verify, …)."},"value":{"description":"Metered amount, in the feature's own unit (exports = render-minutes, storage = GB). Absent for a discrete single use, AND deliberately absent on the cost-plus lines (compose, generate, ai_tokens, compose_verify) whose internal metered unit is not a quantity — read `listUsd` for what those events cost you.","type":"number"},"projectId":{"type":"string"},"jobId":{"description":"The job that produced the meter: a render/compose/preview job id, a media id (transcription, generate), or a clip-suggestion run id (jobKind `suggestions` — see `mediaItemId` for the media it analyzed).","type":"string"},"jobKind":{"description":"render | compose | consult_* | verify | preview | generate | suggestions | session_uptime | …","type":"string"},"mediaItemId":{"description":"The media item the job ran over, when it ran over one (suggestions, transcription). Resolve it with GET /v1/media/{id}.","type":"string"},"listUsd":{"description":"LIST price of this metered event, USD. Honest naming: the invoice may zero it inside a plan allowance — this is the event's list price, not a Stripe line item.","type":"number"},"createdAt":{"type":"number","description":"Epoch-ms when the meter landed."}},"required":["featureId","createdAt"],"additionalProperties":false},"UsageListResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/UsageEventResponse"}},"pagination":{"$ref":"#/components/schemas/PaginationMeta"}},"required":["data","pagination"],"additionalProperties":false},"WebhookCreateRequest":{"type":"object","properties":{"url":{"type":"string","minLength":1,"format":"uri","example":"https://hooks.example.com/cueframe"},"events":{"minItems":1,"type":"array","items":{"$ref":"#/components/schemas/WebhookEvent"}},"settleMs":{"type":"integer","minimum":0,"maximum":60000}},"required":["url","events"],"additionalProperties":false,"description":"POST /webhooks body."},"WebhookEvent":{"type":"string","enum":["media.transcribed","media.completed","suggest.completed","session.mux.complete","session.mux.failed","render.completed","compose.completed","checkpoint.ready","project.updated","composition.updated","webhook.test"]},"WebhookCreateResponse":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string","format":"uri"},"events":{"type":"array","items":{"$ref":"#/components/schemas/WebhookEvent"}},"settleMs":{"type":"integer","minimum":0,"maximum":9007199254740991},"enabled":{"type":"boolean"},"status":{"type":"string","enum":["active","pending"],"description":"active = ownership verified + receiving events; pending = challenge not echoed, inactive."},"secret":{"type":"string","description":"Standard Webhooks signing secret, format `whsec_<base64>`. Returned ONCE at create; rotate = delete + recreate. Every delivery carries `webhook-id`, `webhook-timestamp` (unix seconds), and `webhook-signature: v1,<base64>` (HMAC-SHA256 over `{id}.{timestamp}.{rawBody}`). Verify with any Standard-Webhooks library (`standardwebhooks` / `svix`): `new Webhook(secret).verify(rawBody, headers)`."},"verification":{"description":"Present ONLY when ownership verification did not complete (status:\"pending\"). CueFrame POSTs a signed `webhook.verify` challenge whose `data.token` your endpoint must echo in a 2xx to activate; `reason` is one of token_not_echoed | non_2xx_<code> | unreachable | ssrf_blocked. A pending webhook receives no events — fix the receiver and POST /webhooks/:id/verify (no delete/recreate needed). See GET /webhooks/events for the full contract.","type":"object","properties":{"status":{"type":"string","const":"pending"},"reason":{"type":"string"}},"required":["status","reason"],"additionalProperties":false}},"required":["id","url","events","settleMs","enabled","status","secret"],"additionalProperties":false,"description":"POST /webhooks response (secret present exactly once)."},"WebhookEventCatalogResponse":{"type":"object","properties":{"delivery":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"The shared HTTP envelope + headers + retry semantics."},"signing":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"Standard Webhooks signing: secret format, signed content, how to verify."},"ownershipVerification":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"The synchronous echo-the-token activation handshake + recovery."},"events":{"type":"array","items":{"type":"object","properties":{"event":{"$ref":"#/components/schemas/WebhookEvent"},"when":{"type":"string"},"data":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}}},"required":["event","when","data"],"additionalProperties":{}},"description":"Every subscribable event with its exact delivery `data` fields."},"sample":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{},"description":"A fully-worked example delivery (headers + body)."}},"required":["delivery","signing","ownershipVerification","events","sample"],"additionalProperties":false,"description":"The webhook delivery/signing/verification contract, as data. Read this before building a receiver."},"WebhookListResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/WebhookResponse"}},"pagination":{"$ref":"#/components/schemas/PaginationMeta"}},"required":["data","pagination"],"additionalProperties":false},"WebhookResponse":{"type":"object","properties":{"id":{"type":"string"},"url":{"type":"string","format":"uri"},"events":{"type":"array","items":{"$ref":"#/components/schemas/WebhookEvent"}},"settleMs":{"type":"integer","minimum":0,"maximum":9007199254740991},"enabled":{"type":"boolean"},"verificationStatus":{"type":"string","enum":["pending","verified"],"description":"pending = callback URL has not echoed the ownership challenge (receives no events); verified = ownership proven."},"createdAt":{"type":"string"},"lastDeliveredAt":{"type":["string","null"]},"lastFailedAt":{"type":["string","null"]},"consecutiveFailures":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["id","url","events","settleMs","enabled","verificationStatus","createdAt","lastDeliveredAt","lastFailedAt","consecutiveFailures"],"additionalProperties":false,"description":"Webhook endpoint record (secret omitted after create)."},"WebhookPatchRequest":{"type":"object","properties":{"url":{"type":"string","minLength":1,"format":"uri","example":"https://hooks.example.com/cueframe"},"events":{"minItems":1,"type":"array","items":{"$ref":"#/components/schemas/WebhookEvent"}},"settleMs":{"type":"integer","minimum":0,"maximum":60000},"enabled":{"type":"boolean"}},"additionalProperties":false,"description":"PATCH /webhooks/:id body."},"WebhookTestResponse":{"type":"object","properties":{"deliveryId":{"type":"string"},"status":{"type":"string","const":"queued"}},"required":["deliveryId","status"],"additionalProperties":false,"description":"POST /webhooks/:id/test response."},"WebhookVerifyResponse":{"type":"object","properties":{"id":{"type":"string"},"status":{"type":"string","enum":["active","pending"],"description":"active = ownership verified + receiving events; pending = challenge not echoed."},"verification":{"description":"Present only when the re-challenge did not verify; `reason` names why (see WebhookCreateResponse.verification).","type":"object","properties":{"status":{"type":"string","const":"pending"},"reason":{"type":"string"}},"required":["status","reason"],"additionalProperties":false}},"required":["id","status"],"additionalProperties":false,"description":"POST /webhooks/:id/verify response."},"WhoamiResponse":{"type":"object","properties":{"orgId":{"type":"string"},"permissions":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"array","items":{"type":"string"}}},"keyId":{"type":"string"},"keyName":{"type":"string"}},"required":["orgId","permissions","keyId","keyName"],"additionalProperties":false,"description":"Whoami response."},"WorkspaceCreateRequest":{"type":"object","properties":{"videoUrl":{"type":"string","maxLength":2048,"format":"uri"},"format":{"$ref":"#/components/schemas/FormatSpec"}},"required":["videoUrl"],"additionalProperties":false,"example":{"videoUrl":"https://example.com/talk.mp4"}},"X402PaymentRequired":{"type":"object","title":"X402PaymentRequired","description":"x402 v2 PaymentRequired challenge — the body of a 402 on a priced operation.","properties":{"x402Version":{"type":"integer","const":2},"accepts":{"type":"array","description":"Accepted payment requirements. Read `accepts[0]` for scheme (`exact` for a fixed price, `upto` for a measured one), network (CAIP-2), asset, amount and payTo.","items":{"type":"object"}},"error":{"type":"string","description":"Human-readable reason."}},"required":["x402Version","accepts"]}}},"paths":{"/v1/health":{"get":{"operationId":"health","tags":["health"],"summary":"Shallow + deep health check","description":"Shallow (default) returns 200 with a minimal liveness payload for load balancers. Append `?deep=1` to exercise component bindings (rate-limiter). Unauthenticated.","parameters":[{"name":"deep","in":"query","required":false,"description":"Pass `1` to run the deep dependency checks instead of the shallow liveness probe.","schema":{"type":"string","const":"1"}}],"security":[],"responses":{"200":{"description":"Healthy (or `?deep=1` checks pass).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"503":{"description":"Service unavailable — billing_unavailable / honest-503 for runtime deps.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}}}},"/v1/review/{id}":{"get":{"operationId":"getReviewPacket","tags":["checkpoints"],"summary":"Read a hosted review packet (token-authenticated page data)","description":"The checkpoint page's data: stage artifact (rendered from the packet's own snapshot), presigned stills, critic verdicts, the money triple, the recorded decision once resolved, and the run's v1→vN version stack. Authenticated by the packet's reviewToken (?token=) — the URL from the checkpoint.ready webhook / get_checkpoint. Expired or already-answered packets still render (with their decision), never an error page.","security":[],"responses":{"200":{"description":"The review packet + version stack.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReviewPacketResponse"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Rate limited. Retry-After header present.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true}]}},"/v1/review/{id}/decision":{"post":{"operationId":"recordReviewDecision","tags":["checkpoints"],"summary":"Record a hosted review decision (the same resume rail)","description":"Record approve / revise / abandon from the hosted page. Server-side this IS POST /v1/checkpoints/{id}/resume — one implementation; the driving agent learns of the decision via the checkpoint webhooks / wait_job. 409 when the packet is no longer awaiting (superseded, expired, or already decided).","security":[],"responses":{"200":{"description":"Decision recorded; the run resumes.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReviewDecisionResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required — billing_required or x402 payment_*.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"4