d","niche"]}},{"name":"useCase","in":"query","required":false,"description":"Filter to entries whose useCase includes this edit role (e.g. intro, title-over-footage, grade).","schema":{"type":"string","enum":["intro","outro","full-scene","title-over-footage","transition","background","grade","emphasis","explainer","social-cut"]}},{"name":"mood","in":"query","required":false,"description":"Filter to entries whose mood tags include this value (e.g. cinematic, minimal).","schema":{"type":"string"}},{"name":"q","in":"query","required":false,"description":"Free-text match across id/name/description/intent/useWhen/tags/mood. Recommend-orders results.","schema":{"type":"string"}},{"name":"intent","in":"query","required":false,"description":"Alias of `q` framed as recommend-by-intent (e.g. intent=intro). Recommend-orders results.","schema":{"type":"string"}},{"name":"limit","in":"query","required":false,"description":"Page size (1..100). Omit to return the whole filtered catalog in one page.","schema":{"type":"integer","minimum":1,"maximum":100}},{"name":"after","in":"query","required":false,"description":"Opaque cursor from a previous page's nextCursor (forward-only).","schema":{"type":"string"}}],"responses":{"200":{"description":"Component catalog (filtered + recommend-ordered).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComponentListResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required. Returned when the caller presents no API key on a priced operation: the body AND the `Payment-Required` header carry the x402 v2 challenge (accepted scheme, network, USDC asset, amount, payTo). Sign the EIP-3009 authorization and retry w