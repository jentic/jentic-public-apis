_checkpoint re-reads the envelope later). Stamped at the consult success terminal.","type":"string"}},"required":["mode","proposals","principles"],"additionalProperties":false,"description":"The advisory envelope returned by a completed consult job (on ComposeJobDetailResponse.advisoryResult)."},"ComposeJobListItem":{"type":"object","properties":{"composeJobId":{"type":"string"},"projectId":{"type":"string"},"status":{"type":"string","enum":["queued","running","awaiting_input","complete","failed","cancelled"]},"suggestionId":{"type":"string"},"createdAt":{"type":"number"},"completedAt":{"type":["number","null"]}},"required":["composeJobId","projectId","status","createdAt","completedAt"],"additionalProperties":false},"ComposeJobListResponse":{"type":"object","properties":{"jobs":{"type":"array","items":{"$ref":"#/components/schemas/ComposeJobListItem"}}},"required":["jobs"],"additionalProperties":false},"ComposeSelectRequest":{"type":"object","properties":{"candidateIndex":{"type":"integer","minimum":0,"maximum":9007199254740991},"selectStrategy":{"type":"string","enum":["agent-authoritative","editor-merge","editor-replace"]},"ifMatch":{"type":"string"}},"required":["candidateIndex","selectStrategy"],"additionalProperties":false,"description":"POST /projects/:id/compose/jobs/:jobId/select body."},"ComposeSelectResponse":{"type":"object","properties":{"newCompositionEtag":{"type":"string"},"mergeResult":{"type":"object","properties":{"replayedEdits":{"type":"integer","minimum":0,"maximum":9007199254740991},"droppedEdits":{"type":"array","items":{"type":"object","properties":{"trackId":{"type":"string"},"clipId":{"type":"string"},"wordStartMs":{"type":"number"},"reason":{"type":"string","enum":["target_removed","conflict"]}},"required":["trackId","reason"],"additionalProperties":false}}},"required":["replayedEdits","droppedEdits"],"additionalProperties":false}},"required":["newCompositionEtag"],"additionalProperties":false,"description":"POST /projects/:id/compose/jobs