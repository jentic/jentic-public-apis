their plan lacks or has exhausted the feature (`billing_required`).","headers":{"Payment-Required":{"description":"Base64 x402 v2 PaymentRequired envelope — the same challenge as the body, for clients that read it off the header.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/X402PaymentRequired"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"409":{"description":"Conflict — stale_etag / idempotency_conflict / suggestions_already_complete.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"Unprocessable — invalid_composition / media_in_use / session_in_use / render_not_cancellable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Rate limited. Retry-After header present.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"x-payment-info":{"price":{"mode":"dynamic","currency":"USDC"},"protocols":[{"x402":{}}]}},"delete":{"operationId":"resetMediaSuggestions","tags":["clips"],"summary":"Reset clip suggestions for a media item","description":"Required permission: media:write","security":[{"bearerAuth":[]},{"x402":[]}],"x-permissions":{"media":["write"]},"responses":{"200":{"description":"Suggestions deleted (count returned)."},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required. Returned when the caller presents no API key on a priced operation: the body AND the `Payment-Required` header carry the x402 v2 challenge (accepted scheme, network, USDC asset, amount, payTo). Sign the EIP-3009 authorization and retry with a `PAYMENT-SIGNATURE` header. A KEYED caller sees this status instead when their plan lacks or has exhausted the feature (`billing_required`).","headers":{"Payment-Required":{"description":"Base64 x402 v2 PaymentRequired envelope — the same challenge as the body, for clients that read it off the header.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/X402PaymentRequired"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"Unprocessable — invalid_composition / media_in_use / session_in_use / render_not_cancellable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Rate limited. Retry-After header present.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"x-payment-info":{"price":{"mode":"fixed","currency":"USDC","amount":"10000"},"protocols":[{"x402":{}}]}}},"/v1/media/{id}/detect-subjects":{"post":{"operationId":"triggerSubjectDetection","tags":["media"],"summary":"Trigger standalone subject/face detection","description":"Required permission: media:write","security":[{"bearerAuth":[]},{"x402":[]}],"x-permissions":{"media":["write"]},"x-x402":"detect","parameters":[{"name":"detector","in":"query","required":false,"description":"Which detector to run. Defaults to `face`; an unknown value is refused, never defaulted.","schema":{"type":"string","enum":["face","person"]}},{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"responses":{"202":{"description":"Detection claimed. `alreadyExisted:true` means this exact detection was already pending or ready — nothing was dispatched and nothing will be charged.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SubjectDetectionTriggerResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required — billing_required or x402 payment_*.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"Unprocessable — invalid_composition / media_in_use / session_in_use / render_not_cancellable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Rate limited. Retry-After header present.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"503":{"description":"Service unavailable — billing_unavailable / honest-503 for runtime deps.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"x-payment-info":{"price":{"mode":"fixed","currency":"USDC","amount":"100000"},"protocols":[{"x402":{}}]}}},"/v1/media/{id}/matte":{"post":{"operationId":"triggerMatteBake","tags":["media"],"summary":"Buy a behind-subject matte for one source window","description":"Bakes the alpha matte that lets a graphic sit BEHIND the subject for a specific source window. The window is the clip's SOURCE trim (`startSec`/`endSec` in seconds into the underlying file), not timeline time, and it is required — a matte's cost scales with its duration. Async: poll `GET /media/{id}/facts` for the matte fact's status. If a matte for this exact window already exists (bought earlier, or baked by a compose that put a graphic behind the subject) this returns 200 with the existing state and charges NOTHING. `summary.presenceFraction` on the delivered fact is the viability signal: below 0.6 there is no reliable silhouette, and that matte is delivered free.","security":[{"bearerAuth":[]},{"x402":[]}],"x-permissions":{"media":["write"]},"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MatteBakeRequest"}}}},"responses":{"202":{"description":"Matte bake dispatched (`alreadyExisted:false`), or the matte already exists (`alreadyExisted:true`) — in which case nothing was dispatched and nothing will be charged.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MatteBakeTriggerResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required — billing_required or x402 payment_*.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"Unprocessable — invalid_composition / media_in_use / session_in_use / render_not_cancellable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Rate limited. Retry-After header present.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"503":{"description":"Service unavailable — billing_unavailable / honest-503 for runtime deps.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"x-payment-info":{"price":{"mode":"fixed","currency":"USDC","amount":"10000"},"protocols":[{"x402":{}}]}}},"/v1/media/{id}/facts":{"get":{"operationId":"listMediaFacts","tags":["media"],"summary":"List derived facts for a media item, with quotes for what is missing","description":"The enhancement menu. `facts` is everything expensive we have already computed about this source — subject tracks, mattes — with its status, a small summary a caller can act on without fetching the artifact, and `charge` (what it was billed; absent when it cost nothing, e.g. a matte produced as a side effect of a compose you already paid for, or one delivered below the behind-subject presence floor). `offers` is what is NOT present yet, with a real server quote. A matte is offered ONLY when you pass `startSec`+`endSec` — the clip's SOURCE window — because a matte's price is a function of its duration and a whole-source quote for a three-second clip is not a price. Pass the window from the editor and you get a per-clip matte quote plus the status of that window's matte; omit it from the library and you get everything except the matte.","security":[{"bearerAuth":[]},{"x402":[]}],"x-permissions":{"media":["read"]},"parameters":[{"name":"kind","in":"query","required":false,"description":"Resolve one exact editor prerequisite. Requires startSec and endSec; the response includes the server-selected `exact` result.","schema":{"type":"string","enum":["subjectTrack","matte"]}},{"name":"startSec","in":"query","required":false,"description":"Source-in of the clip's trim, in seconds. Must be sent WITH endSec — one without the other is a 400, never a silent whole-source default.","schema":{"type":"number"}},{"name":"endSec","in":"query","required":false,"description":"Source-out of the clip's trim, in seconds. Must be sent WITH startSec.","schema":{"type":"number"}},{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"responses":{"200":{"description":"Facts + offers.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MediaFactsResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required. Returned when the caller presents no API key on a priced operation: the body AND the `Payment-Required` header carry the x402 v2 challenge (accepted scheme, network, USDC asset, amount, payTo). Sign the EIP-3009 authorization and retry with a `PAYMENT-SIGNATURE` header. A KEYED caller sees this status instead when their plan lacks or has exhausted the feature (`billing_required`).","headers":{"Payment-Required":{"description":"Base64 x402 v2 PaymentRequired envelope — the same challenge as the body, for clients that read it off the header.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/X402PaymentRequired"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"503":{"description":"Service unavailable — billing_unavailable / honest-503 for runtime deps.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"x-payment-info":{"price":{"mode":"fixed","currency":"USDC","amount":"10000"},"protocols":[{"x402":{}}]}},"post":{"operationId":"purchaseMediaFact","tags":["media"],"summary":"Buy a derived fact (subject track or behind-subject matte)","description":"Purchases one enhancement for this source. `matte` REQUIRES `intent:{startSec,endSec}` — the clip's SOURCE window — because a matte's cost scales with its duration. For `subjectTrack` the same `intent` is OPTIONAL: give the clip's source window to buy the track the render will look up for THAT clip (and pay only for its duration); omit it for the whole source. If the fact already exists (pending or ready) this returns it with `alreadyExisted:true` and charges nothing. Charging happens on DELIVERY, never here: a job that never lands is never billed.","security":[{"bearerAuth":[]},{"x402":[]}],"x-permissions":{"media":["write"]},"x-x402":"detect","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MediaFactPurchaseRequest"}}}},"responses":{"202":{"description":"Fact claimed (dispatched, or already present).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MediaFactPurchaseResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required — billing_required or x402 payment_*.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"Unprocessable — invalid_composition / media_in_use / session_in_use / render_not_cancellable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Rate limited. Retry-After header present.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"503":{"description":"Service unavailable — billing_unavailable / honest-503 for runtime deps.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"x-payment-info":{"price":{"mode":"fixed","currency":"USDC","amount":"100000"},"protocols":[{"x402":{}}]}}},"/v1/media/{id}/transcript/analyze":{"post":{"operationId":"analyzeTranscript","tags":["media"],"summary":"Analyse a media item's transcript","description":"Ask ONE editorial question of a transcript and get the answer as text: `summary` (what is actually said, plus the takeaways), `chapters` (where the subject changes), or `highlights` (the moments that stand alone as a short). PRECISION: timestamps are ABSOLUTE seconds from the start of the media and every one is verified against the transcript before you see it (a fabricated timestamp fails the call rather than shipping) — but they are LINE-START markers roughly 15s apart, so a boundary can sit up to 15s BEFORE the moment you asked for. Treat every span as APPROXIMATE: use it to LOCATE the moment, then refine the in/out against the word timings from GET /v1/media/{id}/context before you cut. Feeding a raw span straight into a clip trim will start it mid-sentence. Pass `window` to analyse one slice; omit it for the whole thing. This is a METERED LLM call, not a read: it bills on measured token spend, and a recording too long to analyse in one pass is rejected with 422 `transcript_too_long` (over ~100k characters, roughly two hours of speech) rather than silently summarising only its first half — narrow it with `window`. 422 `media_no_transcript` means the item has no speech on file (or none inside your window); GET /v1/media/{id}/context shows transcript state, and GET /v1/media/{id}/transcript returns the raw words.","security":[{"bearerAuth":[]},{"x402":[]}],"x-permissions":{"media":["write"]},"x-x402":{"amount":"50000"},"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TranscriptAnalyzeRequest"}}}},"responses":{"200":{"description":"The analysis.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TranscriptAnalyzeResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required — billing_required or x402 payment_*.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"Unprocessable — invalid_composition / media_in_use / session_in_use / render_not_cancellable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Rate limited. Retry-After header present.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"503":{"description":"Service unavailable — billing_unavailable / honest-503 for runtime deps.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"x-payment-info":{"price":{"mode":"dynamic","currency":"USDC"},"protocols":[{"x402":{}}]}}},"/v1/timeline-analysis":{"post":{"operationId":"analyzeTimeline","tags":["media"],"summary":"Analyze a timeline transcript for edit decisions","description":"Returns filler, silence-gap, and emphasis word indices for an editor timeline. Analysis settings are selected server-side and cannot be overridden.","security":[{"bearerAuth":[]},{"x402":[]}],"x-permissions":{"media":["write"]},"x-x402":{"amount":"50000"},"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimelineAnalysisRequest"}}}},"responses":{"200":{"description":"Timeline analysis completed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TimelineAnalysisResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required — billing_required or x402 payment_*.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"Unprocessable — invalid_composition / media_in_use / session_in_use / render_not_cancellable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Rate limited. Retry-After header present.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"503":{"description":"Service unavailable — billing_unavailable / honest-503 for runtime deps.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"x-payment-info":{"price":{"mode":"dynamic","currency":"USDC"},"protocols":[{"x402":{}}]}}},"/v1/projects/{id}/context":{"get":{"operationId":"getProjectContext","tags":["projects"],"summary":"One-call agent context: composition + media + transcript + brand","description":"Everything an authoring agent needs to open a project, in ONE read: the active composition (with its format and markers hoisted), the org's media pool with a `hasTranscript` flag per item, the first transcribed item's word-timed transcript, and the brand kit bound to the project. Replaces the get_composition + get_media_context + get_profile opening sequence. A freshly created project reads back with `composition: null` — that is the empty state, not an error; 404 means the project doesn't exist for your org. Transcript BODIES are never inlined per media item — read another item's with GET /v1/media/{id}/transcript, and its faces/beat/word grids with GET /v1/media/{id}/context.","security":[{"bearerAuth":[]},{"x402":[]}],"x-permissions":{"projects":["read"],"media":["read"]},"responses":{"200":{"description":"Aggregated context.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProjectContextResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required. Returned when the caller presents no API key on a priced operation: the body AND the `Payment-Required` header carry the x402 v2 challenge (accepted scheme, network, USDC asset, amount, payTo). Sign the EIP-3009 authorization and retry with a `PAYMENT-SIGNATURE` header. A KEYED caller sees this status instead when their plan lacks or has exhausted the feature (`billing_required`).","headers":{"Payment-Required":{"description":"Base64 x402 v2 PaymentRequired envelope — the same challenge as the body, for clients that read it off the header.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/X402PaymentRequired"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Rate limited. Retry-After header present.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"parameters":[{"schema":{"type":"string"},"in":"path","name":"id","required":true}],"x-payment-info":{"price":{"mode":"fixed","currency":"USDC","amount":"10000"},"protocols":[{"x402":{}}]}}},"/v1/resources/search":{"post":{"operationId":"searchResources","tags":["resources"],"summary":"Search stock media (Pexels / Pixabay / Freesound / Klipy)","description":"Search licensed stock media by keyword. Pass `query` for one search, or `queries[]` (≤10) to run a batch in ONE call — the batch returns `results[]`, one entry per query in order, each with its own `candidates` (and an `error` string if that single query failed; one bad query never discards the rest). `kind` selects the corpus (video/photo default to Pexels; Pixabay is explicitly selectable; sfx → Freesound CC0-only; gif → Klipy); defaults to video. Returns ranked candidates each carrying an opaque `candidateId` — pass it to import_resource to bring the asset into a project. Free + rate-limited; results are cached for 7 days, after which a candidateId must be refreshed by searching again. For sfx, bound the result by clip length with `durationSec` — impacts/ticks ≈ 0–2s, risers/whooshes ≈ 2–8s, ambients unbounded. For video, use minWidth/minHeight to exclude smaller renditions.","security":[{"bearerAuth":[]},{"x402":[]}],"x-permissions":{"media":["read"]},"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceSearchRequest"}}}},"responses":{"200":{"description":"Ranked stock candidates.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceSearchResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required. Returned when the caller presents no API key on a priced operation: the body AND the `Payment-Required` header carry the x402 v2 challenge (accepted scheme, network, USDC asset, amount, payTo). Sign the EIP-3009 authorization and retry with a `PAYMENT-SIGNATURE` header. A KEYED caller sees this status instead when their plan lacks or has exhausted the feature (`billing_required`).","headers":{"Payment-Required":{"description":"Base64 x402 v2 PaymentRequired envelope — the same challenge as the body, for clients that read it off the header.","schema":{"type":"string"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/X402PaymentRequired"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Rate limited. Retry-After header present.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"503":{"description":"Service unavailable — billing_unavailable / honest-503 for runtime deps.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"x-payment-info":{"price":{"mode":"fixed","currency":"USDC","amount":"10000"},"protocols":[{"x402":{}}]}}},"/v1/resources/import":{"post":{"operationId":"importResource","tags":["resources"],"summary":"Import a stock candidate or a curated SFX-pack sound","description":"Two lanes. STOCK { projectId, candidateId }: import a candidate returned by search_resources into a project as an org-owned media item (preserving provider/externalId/license provenance; bytes deduped across orgs). Async: returns { id, status:'importing' }; status flips to complete when the import finishes (poll GET /media/:id). A candidate whose 7-day search cache has expired returns 422 — re-search. PACK { kind:\"sfx-pack\", id:<soundId> }: mint/return the org media item for a curated CC0 SFX-pack sound (soundId from list_catalog's sfx[]) — returns { id, status:'ready' } immediately to place as a normal sfx clip. Idempotent per (org, soundId); an unknown soundId is a 422. Pack imports are FREE: no plan feature required, and an x402 payment is released unsettled (no charge). PRICE of a stock import for a keyed (API-key / session) caller: 0 credits — the resource_import entitlement is a plan grant, not a meter (get_account reports `entitlements.resource_import.listUsdPerUnit: 0`); the imported bytes count toward the `storage` gauge. Only an unkeyed x402 caller pays the $0.01 import tier.","security":[{"bearerAuth":[]},{"x402":[]}],"x-permissions":{"media":["write"]},"x-x402":"import","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceImportRequest"}}}},"responses":{"201":{"description":"Import reserved.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResourceImportResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Missing or invalid Authorization header.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"402":{"description":"Payment required — billing_required or x402 payment_*.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"403":{"description":"Forbidden — permission insufficient.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"404":{"description":"Resource not found.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"422":{"description":"Unprocessable — invalid_composition / media_in_use / session_in_use / render_not_cancellable.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"429":{"description":"Rate limited. Retry-After header present.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"503":{"description":"Service unavailable — billing_unavailable / honest-503 for runtime deps.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},"x-payment-info":{"price":{"mode":"fixed","currency":"USDC","amount":"10000"},"protocols":[{"x402":{}}]}}},"/v1/fonts/search":{"post":{"operationId":"searchFonts","tags":["fonts"],"summary":"Search web font families by name/style","description":"Search the Google Fonts web-font catalog by keyword. Returns matching font families (family name + category + available variants + a css2 stylesheet URL). DISCOVERY ONLY, and this is NOT the set the renderer can draw: a cloud render draws only the faces GET /v1/fonts lists, or a face sealed in a brand kit font asset. Naming any other family in captions/params fails validate_composition with font_not_reproducible. Read GET /v1/fonts to choose a family AND an admitted weight and style before authoring. Read-only and free; results are cached server-side. An empty `results` array means no match (or the upstream catalog was unavailable).","security":[{"bearerAuth":[]},{"x402":[]}],"x-permissions":{"media":["read"]},"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/FontSearchRequest"}}}},"responses":{"200":{"description":"Matching web font families.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FontSearchResponse"}}}},"400":{"description":"Bad request — validation_error / invalid_cursor / invalid_query.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},"401":{"description":"Mis