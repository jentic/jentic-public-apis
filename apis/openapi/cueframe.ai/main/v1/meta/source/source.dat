:["type","clipId","effects"],"additionalProperties":false,"description":"Set (or CLEAR, with `effects: []`) a clip's EFFECT channel — the registered effect primitives stacked onto that clip, each `{ primitiveId, params? }`. WHOLESALE: the array REPLACES the clip's current effects, so send the full stack (read the clip first to add one). This is the ONLY way to change effects on an existing clip — do NOT reach for a `clip.update` patch, whose top-level merge is the source-clobbering footgun documented above."},{"type":"object","properties":{"type":{"type":"string","const":"setCaptionStyle"},"style":{"type":"object","properties":{"fontFamily":{"type":"string","minLength":1},"fontSize":{"description":"Font size as % of composition height (1-15, default 5). NOT px.","type":"number","minimum":1,"maximum":15},"fontWeight":{"type":"integer","minimum":100,"maximum":900},"color":{"type":"string","minLength":1},"highlightColor":{"type":"string","minLength":1},"backgroundColor":{"type":"string"},"plate":{"type":"string","enum":["glass","solid","none"]},"position":{"type":"string","enum":["top","center","bottom"]},"region":{"description":"Optional caption layout box {x,y,w,h} in normalized output-frame coordinates. Overrides position; text starts at its top edge and wraps/pages within its width and height.","type":"object","properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"w":{"type":"number","exclusiveMinimum":0,"maximum":1},"h":{"type":"number","exclusiveMinimum":0,"maximum":1}},"required":["x","y","w","h"],"additionalProperties":false},"textTransform":{"type":"string","enum":["none","uppercase","capitalize"]},"letterSpacing":{"description":"Base caption glyph spacing in pixels.","type":"number","minimum":-5,"maximum":20},"wordGapEm":{"description":"Gap between caption runs as a multiple of base font size; default 0.35.","type":"number","minimum":0,"maximum":2},"lineGapEm":{"description":"Gap between caption lines as a m