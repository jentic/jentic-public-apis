mber","minimum":-0.3,"maximum":0.3}},"required":["kind","primitiveId","params"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"effect"},"primitiveId":{"type":"string","minLength":1},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"component":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/ComponentParameterValue"}},"seed":{"type":"string","minLength":1},"assets":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":256},"additionalProperties":{"type":"string","minLength":1,"maxLength":256}},"mediaBindings":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":128},"additionalProperties":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128}}}},"required":["version","componentId","sourceVersionId","params","seed"],"additionalProperties":false},"targetTrackIds":{"minItems":1,"type":"array","items":{"type":"string","minLength":1}},"wrapperOrder":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"card"},"html":{"type":"string","minLength":1,"description":"Your card's HTML — rendered VERBATIM as the graphic (shell motion via applyMotionPreset in a FOLLOWING call). CANVAS CONTRACT: the card renders in a viewport equal to the composition format's pixel frame (1080×1920 at 9:16 fhd); the root is NOT auto-pinned — declare explicit width/height matching the frame (box-sizing:border-box) and anchor content with flex/grid; position:absolute;inset:0 on the root does NOT fill the frame; for edge-to-edge backgrounds add an inner absolutely-positioned layer with generous negative inset. Overlay compositing applies a ~92% safe-area inset — keep critical copy away from the extreme edges. FONTS: name a family from GET /v1/fonts (list_render_fonts) — the renderer loads those faces for the card and waits for them, so `font-family: Inter` draws Inter. `@import` and remote font files are REFUSED: the card renders with no network. A family that is not on that list has no bytes behind it and the browser falls back, so end any stack with a generic (`Inter, sans-serif`) rather than relying on a system face being present."},"tokens":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"zPlane":{"type":"string","const":"front"}},"required":["kind","html"],"additionalProperties":false}],"type":"object"},"kind":{"type":"string","enum":["video","audio","image","overlay","effect"]},"opacity":{"type":"number","minimum":0,"maximum":1},"scale":{"type":"number","exclusiveMinimum":0},"rotation":{"type":"number"},"position":{"type":"object","properties":{"x":{"type":"number","minimum":-1,"maximum":2},"y":{"type":"number","minimum":-1,"maximum":2}},"required":["x","y"],"additionalProperties":false,"description":"Clip CENTRE as a fraction of the frame: {x:0.5,y:0.5} is dead centre, 0 to 1 is inside the frame, and a little overshoot (down to -1, up to 2) is how an entrance starts off-canvas. NOT pixels: the renderer maps x to `left: x*100%`, so `x: 180` sits 180 frame-widths away and draws nothing."},"region":{"type":"object","properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"w":{"type":"number","exclusiveMinimum":0,"maximum":1},"h":{"type":"number","exclusiveMinimum":0,"maximum":1}},"required":["x","y","w","h"],"additionalProperties":false},"fit":{"type":"string","enum":["cover","contain"]},"captionVisibility":{"description":"Video media clip only. Hide native captions while this clip is topmost and covers the lower picture, or when an opaque, effect-free clip has an explicitly full-frame region, even with fit:contain. Caption words and timings remain stored and resume when another visible clip takes over.","type":"string","enum":["visible","hidden"]},"effects":{"type":"array","items":{"type":"object","properties":{"primitiveId":{"type":"string","minLength":1},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"id":{"type":"string","minLength":1},"component":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/ComponentParameterValue"}},"seed":{"type":"string","minLength":1},"assets":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":256},"additionalProperties":{"type":"string","minLength":1,"maxLength":256}},"mediaBindings":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":128},"additionalProperties":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128}}}},"required":["version","componentId","sourceVersionId","params","seed"],"additionalProperties":false},"window":{"type":"object","properties":{"startTime":{"type":"number","minimum":0},"duration":{"type":"number","exclusiveMinimum":0}},"required":["startTime","duration"],"additionalProperties":false}},"additionalProperties":false}},"transitionIn":{"type":"object","properties":{"type":{"type":"string","minLength":1},"duration":{"type":"number","exclusiveMinimum":0},"id":{"type":"string","minLength":1},"component":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/ComponentParameterValue"}},"seed":{"type":"string","minLength":1},"assets":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":256},"additionalProperties":{"type":"string","minLength":1,"maxLength":256}},"mediaBindings":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":128},"additionalProperties":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128}}}},"required":["version","componentId","sourceVersionId","params","seed"],"additionalProperties":false},"fromClipId":{"type":"string","minLength":1},"toClipId":{"type":"string","minLength":1},"handlePolicy":{"type":"string","const":"outgoing-overrun-at-cut-v1"}},"required":["type","duration"],"additionalProperties":false},"linkGroupId":{"type":"string","minLength":1},"animate":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"minItems":2,"type":"array","items":{"type":"object","properties":{"time":{"type":"number","minimum":0},"value":{"type":"number"},"easing":{"anyOf":[{"type":"string","enum":["linear","ease","easeIn","easeOut","easeInOut"]},{"type":"object","properties":{"cubicBezier":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"},{"type":"number"},{"type":"number"}],"items":false,"minItems":4,"maxItems":4}},"required":["cubicBezier"],"additionalProperties":false}]}},"required":["time","value"],"additionalProperties":false}},"description":"Keyframe channels, clip-relative seconds. Each channel's values use the SAME unit as the scalar it animates: `opacity` 0 to 1, `scale` a multiplier (>0), `rotation` degrees, `position.x`/`position.y` a FRACTION of the frame like `position` (0.5 = centre; NOT pixels), `volume` 0 to 4."}},"required":["id","startTime","duration","source"],"additionalProperties":false},"description":"Client-authored graphic clips the Director must carry VERBATIM: seeded into the design loop's base composition as LOCKED clips (never re-authored, never discarded)."},"exclusions":{"maxItems":8,"type":"array","items":{"$ref":"#/components/schemas/BriefExclusion"}},"gates":{"$ref":"#/components/schemas/BriefGates"},"audio":{"$ref":"#/components/schemas/BriefAudio"}},"required":["projectId","goal"],"additionalProperties":false},"FormatSpec":{"type":"object","properties":{"aspectRatio":{"type":"string","enum":["16:9","9:16","1:1","4:5"]},"fps":{"anyOf":[{"type":"number","const":24},{"type":"number","const":25},{"type":"number","const":30},{"type":"number","const":60}]},"resolution":{"type":"string","enum":["hd","fhd","4k"]}},"required":["aspectRatio"],"additionalProperties":false,"description":"Output-format spec per §Format."},"ComponentParameterValue":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"},{"type":"array","items":{"$ref":"#/components/schemas/ComponentParameterValue"}},{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/ComponentParameterValue"}}]},"BriefExclusion":{"type":"string","enum":["overlay","component","card","no-transitions"]},"BriefGates":{"type":"object","properties":{"holdAt":{"description":"Checkpoint gates — the compose pauses at each named stage for review via resume. DEFAULT (gates absent): the compose holds at EVERY stage — your agent reviews and resumes each one; an unreviewed checkpoint times out loudly after 60min. Auto-progression is the opt-in (gates.autoApprove: true).","maxItems":3,"type":"array","items":{"type":"string","enum":["content","layout","motion"]}},"autoApprove":{"description":"true = fully autonomous (compose runs with NO gates — the headless opt-in; without it a brief holds at every stage by default). Mutually exclusive with a non-empty holdAt.","type":"boolean"},"reviewMode":{"description":"Who captures the review decision. Default 'agent': you relay the packet and call resume. 'hosted': every checkpoint mints a review-page URL (checkpoint.ready payload + get_checkpoint's reviewUrl) where a human approves/revises from the browser — no account, no agent session; the recorded decision rides the SAME resume rail and you learn of it via checkpoint webhooks / wait_job.","type":"string","enum":["agent","hosted"]}},"additionalProperties":false},"BriefAudio":{"type":"object","properties":{"music":{"type":"object","properties":{"enabled":{"type":"boolean","description":"Whether the compose carries a music bed."},"mood":{"description":"Freeform mood/genre prompt for the GENERATED bed (e.g. 'understated editorial, warm'). Ignored when mediaId pins a track.","type":"string","maxLength":300},"mediaId":{"description":"Pin a client-imported track as the bed. HONOR-OR-REFUSE: must be an org-owned kind:'audio' media item, else 422 — never accept-and-ignore. Absent ⇒ generate from mood.","type":"string","minLength":1}},"required":["enabled"],"additionalProperties":false},"sfx":{"type":"object","properties":{"intensity":{"type":"string","enum":["off","light","standard","dense"],"description":"SFX placement density. Real-footage content keeps restraint caps regardless ('dense' is the explicit opt-out); generated/graphic-led content unlocks the standard tier."}},"required":["intensity"],"additionalProperties":false}},"additionalProperties":false},"BriefListResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/BriefResponse"}},"pagination":{"$ref":"#/components/schemas/PaginationMeta"}},"required":["data","pagination"],"additionalProperties":false},"BriefResponse":{"type":"object","properties":{"id":{"type":"string"},"projectId":{"type":"string"},"kind":{"type":"string","enum":["authored","clip"],"description":"authored = create_brief; clip = minted by suggest_briefs from an AI clip suggestion."},"sourceSuggestionId":{"description":"kind:'clip' provenance — the suggestion this Brief was minted from.","type":"string"},"name":{"type":"string","maxLength":200},"goal":{"type":"string","minLength":1,"maxLength":2000,"description":"What the video must accomplish."},"audience":{"type":"string","maxLength":500},"platform":{"type":"string","maxLength":100},"format":{"$ref":"#/components/schemas/FormatSpec"},"durationSec":{"description":"Target output duration. HONOR-OR-REFUSE: compose validates it against the beat-source window (±1.5s) and refuses a brief it cannot honor.","type":"number","exclusiveMinimum":0,"maximum":3600},"tone":{"type":"string","maxLength":500},"cta":{"type":"string","maxLength":500},"locale":{"description":"Output language (BCP-47 tag, e.g. 'es-419'): ALL on-screen copy + captions.","type":"string","maxLength":35},"hook":{"type":"string","maxLength":500},"caption":{"type":"string","maxLength":2000},"beats":{"maxItems":24,"type":"array","items":{"$ref":"#/components/schemas/BriefBeat"}},"mustIncludes":{"maxItems":24,"type":"array","items":{"type":"string","minLength":1}},"references":{"maxItems":12,"type":"array","items":{"type":"string"}},"captions":{"type":"object","properties":{"styleId":{"description":"Caption style id (e.g. 'serif-emphasis@1').","type":"string","minLength":1},"emphasisPhrases":{"description":"Phrases rendered in the caption EMPHASIS style (the big-serif treatment). Matched against the transcript; drives CaptionWord.emphasis.","maxItems":24,"type":"array","items":{"type":"string","minLength":1}}},"additionalProperties":false},"motionStyle":{"type":"object","properties":{"textAnimation":{"type":"string"},"transitions":{"type":"string"},"colorMood":{"type":"string"},"captionStyle":{"type":"string"}},"additionalProperties":false},"seededGraphics":{"maxItems":16,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","minLength":1},"startTime":{"type":"number","minimum":0,"description":"Timeline start (seconds)."},"duration":{"type":"number","exclusiveMinimum":0,"description":"Clip duration (seconds)."},"source":{"oneOf":[{"type":"object","properties":{"kind":{"type":"string","const":"media"},"mediaId":{"type":"string","minLength":1},"trim":{"type":"object","properties":{"start":{"type":"number","minimum":0,"description":"Source trim start (seconds)."},"end":{"type":"number","minimum":0,"description":"Source trim end (seconds)."}},"required":["start","end"],"additionalProperties":false},"excludedRanges":{"type":"array","items":{"type":"object","properties":{"start":{"type":"number","minimum":0},"end":{"type":"number","minimum":0},"reason":{"type":"string"}},"required":["start","end"],"additionalProperties":false}},"volume":{"type":"number","minimum":0,"maximum":4},"muted":{"type":"boolean"},"playbackRate":{"type":"number","exclusiveMinimum":0},"sync":{"type":"string","enum":["video","independent"]},"kenBurns":{"type":"string","enum":["in","out","pan-l","pan-r","none"]},"volumeDb":{"type":"number"},"fadeInMs":{"type":"number","minimum":0},"fadeOutMs":{"type":"number","minimum":0},"loop":{"type":"boolean"},"audioRole":{"type":"string","enum":["sfx","music","vo","ambience"]},"duck":{"type":"object","properties":{"duckDb":{"type":"number","maximum":0},"attackMs":{"type":"number","minimum":0},"releaseMs":{"type":"number","minimum":0},"windows":{"type":"array","items":{"type":"object","properties":{"startMs":{"type":"number"},"endMs":{"type":"number"}},"required":["startMs","endMs"],"additionalProperties":false}}},"required":["duckDb","attackMs","releaseMs"],"additionalProperties":false},"anchor":{"type":"object","properties":{"clipId":{"type":"string","minLength":1},"offsetMs":{"type":"number"}},"required":["clipId","offsetMs"],"additionalProperties":false},"reframe":{"type":"object","properties":{"segments":{"minItems":1,"type":"array","items":{"type":"object","properties":{"startSec":{"type":"number","minimum":0,"description":"Segment START in seconds, clip-relative. Segments tile the clip's duration in order."},"endSec":{"type":"number","exclusiveMinimum":0,"description":"Segment END in seconds, clip-relative. The span (endSec − startSec) is this segment's duration — the window `ease` ramps over."},"focus":{"oneOf":[{"type":"object","properties":{"mode":{"type":"string","const":"frame-center"}},"required":["mode"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"point"},"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1}},"required":["mode","x","y"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"face"},"faceId":{"type":"string","minLength":1},"shotScale":{"type":"string","enum":["close","standard","wide"]}},"required":["mode","faceId"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"all-faces"}},"required":["mode"],"additionalProperties":false},{"type":"object","properties":{"mode":{"type":"string","const":"active-speaker"}},"required":["mode"],"additionalProperties":false}],"description":"WHO/WHAT the camera tracks this segment (the reframe center), selected by `mode`: `frame-center` = no tracking, hold the geometric center (static/graphic footage, or a pure zoom); `point` = lock to a fixed source-normalized {x,y} (a non-moving on-screen element); `face` = track a detected face by `faceId` (from get_media_context), with optional `shotScale` close|standard|wide for tightness; `all-faces` = frame the bounding box of every detected face (group/ensemble shots); `active-speaker` = follow whoever is speaking (diarized talking-head / podcast). Pick by what the beat is about; pair with `zoom` for how tight.","type":"object"},"intent":{"description":"Optional editorial LABEL for diff/log readability (e.g. 'speaker-tight', 'wide-context'). Cosmetic — NOT honored by the derive math and excluded from the variant cache key.","type":"string"},"zoom":{"description":"How TIGHT the framing is — the fraction of the source the output viewport shows. <1 punches IN (a smaller source fraction, magnified to fill the frame); 1 = the full frame (no crop). ~0.6–0.8 is a moderate push-in, ~0.5 a tight close-up, 0.1 the maximum zoom. There is NO zoom-OUT past the full frame (max 1). Omit for the full frame. MUTUALLY EXCLUSIVE with `focus.shotScale` — a face-tracked shot is sized EITHER by the editorial scale (shotScale, which the bake calibrates to the detected face) OR by an explicit zoom, never both. A segment carrying both is REJECTED: shotScale wins at bake time and the zoom would be silently discarded.","type":"number","minimum":0.1,"maximum":1},"ease":{"description":"Zoom/center ramp DURATIONS in SECONDS at this segment's edges — NOT a unitless 0–1 curve. ~0.3–0.6s reads as a snappy push; >1s reads sluggish. Keep `in` + `out` ≤ the segment's duration (endSec − startSec): the two edges share the span, so to ramp across the WHOLE segment set one edge to the full duration and the other to 0. Omit for an instant cut to this framing.","type":"object","properties":{"in":{"type":"number","minimum":0,"description":"Ease-IN ramp DURATION in seconds at the segment START."},"out":{"type":"number","minimum":0,"description":"Ease-OUT ramp DURATION in seconds at the segment END."}},"required":["in","out"],"additionalProperties":false},"bias":{"description":"Optional FINE framing nudge off the focus center, source-normalized in [−0.3, 0.3]. A small correction (headroom, rule-of-thirds), NOT a reframe — use `focus`/`zoom` for the actual shot. Omit (treated as 0) to sit dead-center on the focus.","type":"object","properties":{"x":{"type":"number","minimum":-0.3,"maximum":0.3,"description":"Horizontal nudge, source-normalized (+ = right)."},"y":{"type":"number","minimum":-0.3,"maximum":0.3,"description":"Vertical nudge, source-normalized (+ = down)."}},"required":["x","y"],"additionalProperties":false}},"required":["startSec","endSec","focus"],"additionalProperties":false}}},"required":["segments"],"additionalProperties":false}},"required":["kind","mediaId"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"component"},"componentId":{"type":"string","minLength":1},"props":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"assets":{"description":"Manifest asset slot → project media id. At mount each slot arrives as `assets[slot].handle`, a fetchable URL for <Img>/<Video>/<Audio>; `props` becomes `params` and never carries an asset URL.","type":"object","propertyNames":{"type":"string","minLength":1},"additionalProperties":{"type":"string","minLength":1}},"assetTiming":{"type":"object","propertyNames":{"type":"string","minLength":1},"additionalProperties":{"type":"object","properties":{"trimStartSec":{"type":"number","minimum":0},"trimEndSec":{"type":"number","exclusiveMinimum":0},"playbackRate":{"type":"number","exclusiveMinimum":0,"maximum":16},"endPolicy":{"type":"string","enum":["loop","hold","reject"]},"timelineOffsetSec":{"type":"number","minimum":0}},"required":["endPolicy"],"additionalProperties":false}},"zPlane":{"type":"string","enum":["front","behind-subject"]},"execution":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/ComponentParameterValue"}},"seed":{"type":"string","minLength":1},"assets":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":256},"additionalProperties":{"type":"string","minLength":1,"maxLength":256}},"mediaBindings":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":128},"additionalProperties":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128}}}},"required":["version","componentId","sourceVersionId","params","seed"],"additionalProperties":false},"placement":{"oneOf":[{"type":"object","properties":{"version":{"type":"number","const":3},"kind":{"type":"string","const":"clip"}},"required":["version","kind"],"additionalProperties":false},{"type":"object","properties":{"version":{"type":"number","const":3},"kind":{"type":"string","const":"content-slots"},"slots":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":256},"additionalProperties":{"type":"object","properties":{"targetClipIds":{"type":"array","items":{"type":"string","minLength":1,"maxLength":256}},"ownership":{"type":"string","enum":["reference","exclusive"]}},"required":["targetClipIds","ownership"],"additionalProperties":false}}},"required":["version","kind","slots"],"additionalProperties":false}],"type":"object"}},"required":["kind","componentId","props"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"overlay"},"primitiveId":{"type":"string","minLength":1},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"zPlane":{"type":"string","enum":["front","behind-subject"]},"anchor":{"type":"object","properties":{"space":{"type":"string","const":"scene"},"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1}},"required":["space","x","y"],"additionalProperties":false},"parallax":{"type":"number","minimum":-0.3,"maximum":0.3}},"required":["kind","primitiveId","params"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"effect"},"primitiveId":{"type":"string","minLength":1},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"component":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/ComponentParameterValue"}},"seed":{"type":"string","minLength":1},"assets":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":256},"additionalProperties":{"type":"string","minLength":1,"maxLength":256}},"mediaBindings":{"type":"object","propertyNames":{"type":"string","minLength":1,"maxLength":128},"additionalProperties":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128}}}},"required":["version","componentId","sourceVersionId","params","seed"],"additionalProperties":false},"targetTrackIds":{"minItems":1,"type":"array","items":{"type":"string","minLength":1}},"wrapperOrder":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":["kind"],"additionalProperties":false},{"type":"object","properties":{"kind":{"type":"string","const":"card"},"html":{"type":"string","minLength":1,"description":"Your card's HTML — rendered VERBATIM as the graphic (shell motion via applyMotionPreset in a FOLLOWING call). CANVAS CONTRACT: the card renders in a viewport equal to the composition format's pixel frame (1080×1920 at 9:16 fhd); the root is NOT auto-pinned — declare explicit width/height matching the frame (box-sizing:border-box) and anchor content with flex/grid; position:absolute;inset:0 on the root does NOT fill the frame; for edge-to-edge backgrounds add an inner absolutely-positioned layer with generous negative inset. Overlay compositing applies a ~92% safe-area inset — keep critical copy away from the extreme edges. FONTS: name a family from GET /v1/fonts (list_render_fonts) — the renderer loads those faces for the card and waits for them, so `font-family: Inter` draws Inter. `@import` and remote font files are REFUSED: the card renders with no network. A family that is not on that list has no bytes behind it and the browser falls back, so end any stack with a generic (`Inter, sans-serif`) rather than relying on a system face being present."},"tokens":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},"zPlane":{"type":"string","const":"front"}},"required":["kind","html"],"additionalProperties":false}],"type":"object"},"kind":{"type":"string","enum":["video","audio","image","overlay","effect"]},"opacity":{"type":"number","minimum":0,"maximum":1},"scale":{"type":"number","exclusiveMinimum":0},"rotation":{"type":"number"},"position":{"type":"object","properties":{"x":{"type":"number","minimum":-1,"maximum":2},"y":{"type":"number","minimum":-1,"maximum":2}},"required":["x","y"],"additionalProperties":false,"description":"Clip CENTRE as a fraction of the frame: {x:0.5,y:0.5} is dead centre, 0 to 1 is inside the frame, and a little overshoot (down to -1, up to 2) is how an entrance starts off-canvas. NOT pixels: the renderer maps x to `left: x*100%`, so `x: 180` sits 180 frame-widths away and draws nothing."},"region":{"type":"object","properties":{"x":{"type":"number","minimum":0,"maximum":1},"y":{"type":"number","minimum":0,"maximum":1},"w":{"type":"number","exclusiveMinimum":0,"maximum":1},"h":{"type":"number","exclusiveMinimum":0,"maximum":1}},"required":["x","y","w","h"],"additionalProperties":false},"fit":{"type":"string","enum":["cover","contain"]},"captionVisibility":{"description":"Video media clip only. Hide native captions while this clip is topmost and covers the lower picture, or when an opaque, effect-free clip has an explicitly full-frame region, even with fit:contain. Caption words and timings remain stored and resume when another visible clip takes over.","type":"string","enum":["visible","hidden"]},"effects":{"type":"array","items":{"type":"object","properties":{"primitiveId":{"type":"string","minLength":1},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"id":{"type":"string","minLength":1},"component":{"type":"object","properties":{"version":{"type":"number","const":3},"componentId":{"type":"string","minLength":1,"maxLength":256},"sourceVersionId":{"type":"string","pattern":"^[a-f0-9]{64}$"},"params":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"$ref":"#/components/schemas/ComponentParameterValue"}},"seed":{"type":"string","minLength":1},"assets":{"type":"object","propertyN