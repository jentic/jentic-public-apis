 SEE (\"wide shot of the speaker at a whiteboard\") finds the moment even when nobody says those words."},"LibrarySearchResult":{"type":"object","properties":{"mediaId":{"type":"string","description":"The media item this moment belongs to — feed it to apply_composition as a clip source, or GET /v1/media/{id}/context for its faces/beat/word grids."},"name":{"type":"string","description":"The media item's name, so a result is readable without a second call."},"score":{"type":"number","description":"Cosine similarity between the query text and the chunk's frame, in [-1, 1]. Higher is closer. Compare scores WITHIN one response; absolute values are not calibrated across queries."},"startSec":{"type":"number","description":"Moment start, SECONDS from the media item's start."},"endSec":{"type":"number","description":"Moment end, SECONDS from the media item's start."},"thumbUrl":{"description":"Presigned URL for the media item's thumbnail, or null when it has none. This is the ITEM's thumbnail, not a still of this moment — render a still of the exact range with preview_frame.","type":["string","null"]}},"required":["mediaId","name","score","startSec","endSec","thumbUrl"],"additionalProperties":false},"MatteBakeRequest":{"type":"object","properties":{"startSec":{"type":"number","minimum":0,"description":"Source-in of the window to matte, in seconds into the underlying source."},"endSec":{"type":"number","exclusiveMinimum":0,"description":"Source-out of the window to matte, in seconds into the underlying source."}},"required":["startSec","endSec"],"additionalProperties":false,"description":"POST /media/:id/matte body. The window is REQUIRED and is the clip's SOURCE trim, not timeline time: a matte's cost scales with its duration, so there is no whole-source default to fall back on."},"MatteBakeTriggerResponse":{"type":"object","properties":{"factId":{"type":"string"},"status":{"type":"string","enum":["pending","ready","failed"]},"quotedUsd":{"type":"number","description":"The server's price for this matte, in USD, quoted from the window duration."},"alreadyExisted":{"type":"boolean","description":"True when a matte for this exact window was already pending or ready. Nothing was dispatched and nothing will be charged."}},"required":["factId","status","quotedUsd","alreadyExisted"],"additionalProperties":false,"description":"POST /media/:id/matte response — the claimed matte fact."},"MediaContextResponse":{"type":"object","properties":{"mediaId":{"type":"string"},"durationSec":{"type":["number","null"]},"width":{"type":["number","null"]},"height":{"type":["number","null"]},"thumbnail":{"anyOf":[{"type":"object","properties":{"url":{"type":"string"}},"required":["url"],"additionalProperties":false},{"type":"null"}],"description":"Presigned processing thumbnail (~1 week) — the footage at a glance. For stills at chosen timestamps, use preview_frame with a one-clip composition over this media."},"faces":{"type":"object","properties":{"status":{"type":"string","enum":["ready","not_detected"]},"windows":{"type":"array","items":{"$ref":"#/components/schemas/ContextSubjectWindow"}}},"required":["status","windows"],"additionalProperties":false},"transcript":{"type":"object","properties":{"status":{"type":"string","enum":["ready","not_transcribed","unavailable"]},"data":{"anyOf":[{"$ref":"#/components/schemas/TranscriptResponse"},{"type":"null"}]}},"required":["status","data"],"additionalProperties":false},"beatGrid":{"anyOf":[{"type":"object","properties":{"bpm":{"type":"number"},"beatTimesMs":{"type":"array","items":{"type":"number"},"description":"Beat onset times in MILLISECONDS — divide by 1000 for timeline startTime (composition timeline fields are seconds)."},"confidence":{"type":"number","description":"Rhythmic-periodicity strength (0–1). Trust the grid for cutting when high; a beatless bed reports low."},"method":{"type":"string","enum":["requested-anchored","detected"],"description":"`requested-anchored` = phase-locked to a requested BPM (a generated bed whose prompt named a tempo); `detected` = full beat tracking (import/upload)."}},"required":["bpm","beatTimesMs","confidence","method"],"additionalProperties":false},{"type":"null"}],"description":"The MUSIC-role rhythm grid (audio-substrate MVP). Present only for a music bed that carries a computed beat grid; null otherwise. For a music-driven film, cut on these beats (transition midpoints on beats, risers resolving on downbeats)."},"wordGrid":{"anyOf":[{"type":"object","properties":{"wordTimesMs":{"type":"array","items":{"type":"number"},"description":"Word onset times in MILLISECONDS, in order — divide by 1000 for timeline startTime (composition timeline fields are seconds)."}},"required":["wordTimesMs"],"additionalProperties":false},{"type":"null"}],"description":"The VO-role rhythm grid: word onsets surfaced from the transcript (pure exposure). Present only when a transcript exists; null otherwise. For a VO-driven (narration) film, cut every beat boundary to the voice — the film-spine rule."},"audioRole":{"anyOf":[{"type":"string","enum":["vo","music","sfx","ambience"]},{"type":"null"}],"description":"DECLARED audio role of this asset (audio-substrate P0): 'vo' (narration), 'music' (bed that ducks under speech), 'sfx' (one-shot hit), 'ambience' (a bed that HOLDS under VO — never ducks). Author the clip source's `audioRole` from this. Null for footage/images or an undeclared audio asset."},"envelope":{"anyOf":[{"type":"object","properties":{"envelopeClass":{"type":"string","enum":["transient","sweep","ambient"],"description":"Coarse temporal shape: 'transient' (a sharp one-shot), 'sweep' (a bounded rise/fall over ~0.5–2s), 'ambient' (an unbounded bed)."},"attackMs":{"type":"number"},"spectralCentroidHz":{"type":"number"},"meanVolumeDb":{"type":"number"},"maxVolumeDb":{"type":"number"}},"required":["envelopeClass"],"additionalProperties":false},{"type":"null"}],"description":"Envelope evidence (audio-substrate P0). `envelopeClass` is always present when an envelope exists (the SFX pack carries it); the numeric probe stats are present only when an audio probe has run. Null when no envelope is stored."},"facts":{"type":"array","items":{"$ref":"#/components/schemas/MediaFact"},"description":"Derived facts about this source (subject tracks, mattes): what has been computed, its status, and what it was billed. Same shape as GET /media/{id}/facts."},"offers":{"type":"array","items":{"$ref":"#/components/schemas/MediaFactOffer"},"description":"Enhancements this source does not have yet, with a server quote. Same shape as GET /media/{id}/facts. Mattes are quoted per-window via POST /media/{id}/matte, never here."}},"required":["mediaId","durationSec","width","height","thumbnail","faces","transcript","beatGrid","wordGrid","audioRole","envelope","facts","offers"],"additionalProperties":false,"description":"Read-only authoring context for a source media item: detected face roster + transcript + the temporal grids (beat / word) an agent cuts to, the DECLARED audioRole + envelope of an audio asset, and the paid-enhancement block (facts already computed + offers for what is missing)."},"ContextSubjectWindow":{"type":"object","properties":{"detectorVersion":{"type":"string","description":"Version of the face detector that produced this source-window roster."},"window":{"type":"object","properties":{"startSec":{"type":"number"},"endSec":{"type":"number"}},"required":["startSec","endSec"],"additionalProperties":false},"faces":{"type":"array","items":{"$ref":"#/components/schemas/ContextFace"}}},"required":["detectorVersion","window","faces"],"additionalProperties":false},"ContextFace":{"type":"object","properties":{"faceId":{"type":"string"},"bbox":{"type":"object","properties":{"x":{"type":"number"},"y":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"}},"required":["x","y","width","height"],"additionalProperties":false},"speakingShare":{"type":"number"}},"required":["faceId","bbox"],"additionalProperties":false},"TranscriptResponse":{"type":"object","properties":{"mediaItemId":{"type":"string"},"language":{"type":["string","null"]},"fullText":{"type":"string"},"utterances":{"type":"array","items":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"data":{"type":"array","items":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"pagination":{"$ref":"#/components/schemas/PaginationMeta"}},"required":["mediaItemId","language","fullText","utterances"],"additionalProperties":false,"description":"Transcript response."},"MediaDirectUploadResponse":{"type":"object","properties":{"id":{"type":"string"},"uploadUrl":{"type":"string","format":"uri"},"expiresAt":{"type":"string"}},"required":["id","uploadUrl","expiresAt"],"additionalProperties":false,"description":"POST /media response: reserved media id + a presigned PUT URL. PUT the raw bytes to uploadUrl (≤ ~5 GiB), then POST /media/:id/finalize."},"MediaFactPurchaseRequest":{"type":"object","properties":{"kind":{"type":"string","enum":["subjectTrack","matte"],"description":"Which enhancement to buy. `transcript` is NOT purchasable here — it is delivered by the transcription pipeline."},"intent":{"description":"The SOURCE window. REQUIRED for `matte` (its cost scales with duration). OPTIONAL for `subjectTrack`: give a clip's source window to buy the track the render looks up for THAT clip, and pay only for its duration; omit it to detect the whole source.","type":"object","properties":{"startSec":{"type":"number","minimum":0},"endSec":{"type":"number","exclusiveMinimum":0}},"required":["startSec","endSec"],"additionalProperties":false}},"required":["kind"],"additionalProperties":false,"description":"POST /media/:id/facts body."},"MediaFactPurchaseResponse":{"type":"object","properties":{"factId":{"type":"string"},"status":{"type":"string","enum":["pending","ready","failed"]},"quotedUsd":{"type":"number"},"alreadyExisted":{"type":"boolean","description":"True when this exact fact was already pending or ready. Nothing was dispatched and nothing will be charged."}},"required":["factId","status","quotedUsd","alreadyExisted"],"additionalProperties":false,"description":"POST /media/:id/facts response."},"MediaFactsResponse":{"type":"object","properties":{"facts":{"type":"array","items":{"$ref":"#/components/schemas/MediaFact"}},"offers":{"type":"array","items":{"$ref":"#/components/schemas/MediaFactOffer"},"description":"What is NOT yet present and could be bought. A `matte` offer appears ONLY when the request carried `startSec`+`endSec` (the clip's SOURCE window) — a matte's price is a function of its duration, so there is no honest whole-source matte quote. `transcript` is never offered: it is produced by the ingest pipeline, not bought here."},"exact":{"$ref":"#/components/schemas/ExactMediaFactResolution"}},"required":["facts","offers"],"additionalProperties":false,"description":"Facts and offers for a media item, plus an exact-window resolution when requested."},"MediaFinalizeRequest":{"type":"object","properties":{"audioRole":{"type":"string","enum":["vo","music","sfx","ambience"],"description":"Declared audio role: 'vo' (narration), 'music' (bed that ducks under speech), 'sfx' (one-shot hit), 'ambience' (a bed that HOLDS under VO — never ducks)."}},"additionalProperties":false,"description":"POST /media/:id/finalize body — optional declared audioRole."},"MediaFinalizeResponse":{"type":"object","properties":{"id":{"type":"string"},"status":{"type":"string","enum":["processing","complete"]},"processingPhase":{"type":"string"}},"required":["id","status","processingPhase"],"additionalProperties":false,"description":"POST /media/:id/finalize response: ingest triggered (audio/video → processing) or the item is immediately ready (image/asset → complete)."},"MediaGenerateRequest":{"type":"object","properties":{"generator":{"type":"string","enum":["text-to-video","text-to-image","image-to-video","text-to-music","text-to-speech","text-to-sfx","auto"]},"prompt":{"type":"string","minLength":1,"maxLength":10000},"style":{"description":"Free-form generation parameters, read per generator. All generators honor `aspect` (string) + `durationSec` (number) where applicable. text-to-speech honors `voice` (string; default voice when omitted), `speed` (number 0.7-1.2), `stability` (number 0-1), and `styleExaggeration` (number 0-1 → the endpoint's style exaggeration). Provider and model selection are server-owned and cannot be overridden.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"refs":{"type":"object","properties":{"firstFrameMediaId":{"type":"string"},"lastFrameMediaId":{"type":"string"},"imageMediaIds":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}},"required":["generator","prompt"],"additionalProperties":false,"description":"POST /media/generate body."},"MediaGenerateResponse":{"type":"object","properties":{"id":{"type":"string"},"status":{"type":"string","const":"generating"},"estimateUsd":{"type":"number"}},"required":["id","status"],"additionalProperties":false,"description":"POST /media/generate response."},"MediaImportRequest":{"type":"object","properties":{"url":{"type":"string","maxLength":2048,"format":"uri"},"filename":{"type":"string","minLength":1,"maxLength":500},"contentType":{"type":"string","enum":["video/mp4","video/quicktime","video/x-matroska","video/webm","audio/mpeg","audio/wav","audio/x-wav","audio/mp4","audio/aac","image/png","image/jpeg","image/webp","image/gif","image/svg+xml","application/json","font/ttf","font/otf","font/woff","font/woff2"]},"size":{"type":"integer","exclusiveMinimum":0,"maximum":10737418240},"audioRole":{"type":"string","enum":["vo","music","sfx","ambience"],"description":"Declared audio role: 'vo' (narration), 'music' (bed that ducks under speech), 'sfx' (one-shot hit), 'ambience' (a bed that HOLDS under VO — never ducks)."}},"required":["url","filename","contentType"],"additionalProperties":false,"description":"POST /media/import body."},"MediaImportResponse":{"type":"object","properties":{"id":{"type":"string"},"status":{"type":"string","const":"importing"}},"required":["id","status"],"additionalProperties":false,"description":"POST /media/import response."},"MediaListResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/MediaResponse"}},"pagination":{"$ref":"#/components/schemas/PaginationMeta"}},"required":["data","pagination"],"additionalProperties":false},"MediaResponse":{"type":"object","properties":{"id":{"type":"string"},"status":{"type":"string"},"source":{"type":"string","enum":["upload","generated","stock"]},"name":{"type":"string"},"mimeType":{"type":"string"},"fileSize":{"type":"number"},"duration":{"type":["number","null"]},"width":{"type":["number","null"]},"height":{"type":["number","null"]},"frameRate":{"type":["number","null"]},"progress":{"anyOf":[{"type":"object","properties":{"phase":{"type":"string"},"percent":{"type":["number","null"]}},"required":["phase","percent"],"additionalProperties":false},{"type":"null"}]},"analysis":{"anyOf":[{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},{"type":"null"}]},"listUsd":{"description":"A2 money stamp — GENERATED media only: the generate meter's LIST price (USD) at the success terminal. A plan allowance may zero the invoice line. Absent for uploads/imports, failures, x402 (on-chain receipts).","type":"number"},"thumbnailUrl":{"description":"Presigned GET URL for the item's thumbnail (an uploaded image is its own thumbnail), valid ~7 days — fetch it directly, no auth header. null when no thumbnail exists yet (still processing, stock imports, audio).","type":["string","null"]},"kind":{"type":["string","null"]},"tags":{"anyOf":[{"type":"array","items":{"type":"string"}},{"type":"null"}]},"attribution":{"anyOf":[{"type":"object","properties":{"provider":{"type":"string","enum":["pexels","pixabay","freesound","klipy"]},"externalId":{"type":["string","null"]},"assetUrl":{"type":["string","null"]},"license":{"type":["string","null"]}},"required":["provider","externalId","assetUrl","license"],"additionalProperties":false},{"type":"null"}]},"processingStatus":{"anyOf":[{"$ref":"#/components/schemas/MediaProcessingStatus"},{"type":"null"}]},"createdAt":{"type":"string"},"updatedAt":{"type":"string"}},"required":["id","status","source","name","mimeType","fileSize","duration","width","height","frameRate","progress","analysis","thumbnailUrl","kind","tags","attribution","processingStatus","createdAt","updatedAt"],"additionalProperties":false,"description":"Media item response per §Media."},"MediaProcessingStatus":{"type":"object","properties":{"phase":{"type":"string","enum":["idle","pending_import","pending_upload","uploading","extracting","loading_model","transcribing","proxy","embedding","analyzing","indexing","generating","rendering","processing","complete","error","cancelled"]},"percent":{"type":["number","null"]},"message":{"type":["string","null"]},"error":{"type":["string","null"]}},"required":["phase"],"additionalProperties":false,"description":"Processing status stored on mediaItems rows."},"MediaUploadRequest":{"type":"object","properties":{"filename":{"type":"string","minLength":1,"maxLength":500},"contentType":{"type":"string","enum":["video/mp4","video/quicktime","video/x-matroska","video/webm","audio/mpeg","audio/wav","audio/x-wav","audio/mp4","audio/aac","image/png","image/jpeg","image/webp","image/gif","image/svg+xml","application/json","font/ttf","font/otf","font/woff","font/woff2"]},"size":{"type":"integer","exclusiveMinimum":0,"maximum":10737418240},"projectId":{"type":"string","minLength":1}},"required":["filename","contentType","size"],"additionalProperties":false,"description":"POST /media upload initiation body."},"MuxJobResponse":{"type":"object","properties":{"jobId":{"type":"string"},"status":{"type":"string"},"muxedItems":{"anyOf":[{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{"type":"string"}},{"type":"null"}]},"error":{"type":["string","null"]},"startedAt":{"type":["string","null"]},"completedAt":{"type":["string","null"]}},"required":["jobId","status"],"additionalProperties":false,"description":"Mux job response."},"PreviewClipRequest":{"type":"object","properties":{"fromSec":{"type":"number","minimum":0,"description":"Window start, seconds into the composition."},"toSec":{"type":"number","exclusiveMinimum":0,"description":"Window end (exclusive), seconds."},"compositionId":{"description":"Target a specific composition; defaults to the project's active composition.","type":"string","minLength":1}},"required":["fromSec","toSec"],"additionalProperties":false,"description":"POST /projects/:id/preview-clip body."},"PreviewFrameRequest":{"type":"object","properties":{"composition":{"description":"The composition to render. Absent ⇒ the project's ACTIVE composition — what create_render will encode. The response's `previewed.source` names what was rendered."},"compositionId":{"description":"Preview a SPECIFIC persisted composition of this project (create_render parity). Absent ⇒ the active one. A stale/foreign id is a 404 — never a silent fall-through.","type":"string"},"session_id":{"description":"Compose-session id: render that session's SCRATCH composition (what the session has been editing) instead of the active row. Ignored when `composition` is passed.","type":"string"},"timestamps":{"minItems":1,"maxItems":18,"type":"array","items":{"type":"number"},"description":"Composition seconds to capture, 18 per request. The batch renders as ONE unit of work — one warm container, one source decode, N seeks — and that unit has a fixed time budget, so a larger batch is refused here rather than accepted and timed out minutes later. For a denser sweep, split it across calls; identical beats are served from the still cache, so overlapping batches are cheap."},"imageFormat":{"description":"Still format. Default jpeg — these pixels go to a vision model, where jpeg is equivalent and png costs multiples in bytes to store and move. Pass png only when you need full fidelity.","type":"string","enum":["png","jpeg"]},"scale":{"description":"Render scale 0.1–1. Default 0.5, which is what this schema has always recommended for vision-bound looks. Pass 1 when judging fine detail — it costs ~4x the vision tokens.","type":"number","minimum":0.1,"maximum":1},"jpegQuality":{"description":"JPEG quality (jpeg only). Default 70 — the quality the eval panel grades at.","type":"integer","minimum":1,"maximum":100}},"required":["timestamps"],"additionalProperties":false,"example":{"timestamps":[1.5,4],"imageFormat":"jpeg"}},"ProfileResponse":{"type":"object","properties":{"brandKits":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"audio":{"type":"object","properties":{"sfxIntensity":{"type":"string","enum":["off","light","standard","dense"]},"musicEnabled":{"type":"boolean"},"musicMood":{"type":"string","maxLength":300},"sonicLogo":{"description":"A brand sound signature bound to the intro/outro bookend. `ref` = a palette reference; bound only when the kit carries the matching bumper (intro/outro), else a non-blocking advisory.","type":"object","properties":{"ref":{"type":"string","minLength":1},"placement":{"type":"string","enum":["intro","outro","both"]},"offsetMs":{"type":"integer","minimum":0,"maximum":10000}},"required":["ref","placement"],"additionalProperties":false},"uiSoundSet":{"description":"Per-family SFX overrides (the brand's own tick/pop/…). Highest-priority tier over the org palette + pack default in the compose SFX draw.","type":"object","properties":{"tick":{"type":"string","minLength":1},"pop":{"type":"string","minLength":1},"impact":{"type":"string","minLength":1},"confirm":{"type":"string","minLength":1},"error":{"type":"string","minLength":1},"whoosh":{"type":"string","minLength":1},"riser":{"type":"string","minLength":1}},"additionalProperties":false},"bedStyle":{"description":"Preferred music bed (`bedId`) or a style hint (`genre` / `bpmRange`). Surfaced for driving agents; compose does not auto-select a pack bed.","type":"object","properties":{"bedId":{"type":"string","minLength":1},"genre":{"type":"string","maxLength":120},"bpmRange":{"type":"object","properties":{"min":{"type":"number"},"max":{"type":"number"}},"required":["min","max"],"additionalProperties":false}},"additionalProperties":false},"ambiencePreference":{"description":"Preferred ambience bed (`{ref}`) or explicit null (opt-out). Surfaced for driving agents; compose has no ambience auto-placement.","anyOf":[{"type":"object","properties":{"ref":{"type":"string","minLength":1}},"required":["ref"],"additionalProperties":false},{"type":"null"}]}},"additionalProperties":false}},"required":["id","name"],"additionalProperties":false},"description":"The org's brand kits (bind one to a project via update_project). `audio` carries the brand sound kit when set."},"critics":{"type":"array","items":{"$ref":"#/components/schemas/CriticSummary"},"description":"Registered critics — run in the Director's gates AND score_composition."},"references":{"type":"array","items":{"type":"object","properties":{"mediaId":{"type":"string"},"name":{"type":"string"},"thumbnailUrl":{"description":"Presigned reference thumbnail (~1 week).","type":"string"}},"required":["mediaId"],"additionalProperties":false},"description":"The union of critic reference media — the org's visual standard, with provenance."},"recentDecisions":{"type":"array","items":{"type":"object","properties":{"checkpointId":{"type":"string"},"projectId":{"type":"string"},"kind":{"type":"string","enum":["gate","score"]},"stage":{"type":"string","enum":["content","layout","motion"]},"decision":{"type":"string"},"decidedAt":{"type":"number"}},"required":["checkpointId","projectId","kind","decision","decidedAt"],"additionalProperties":false},"description":"The last recorded checkpoint decisions — the raw taste log phase 2 will distill."}},"required":["brandKits","critics","references","recentDecisions"],"additionalProperties":false,"description":"The org's legible taste: brand + critics + references + decision log."},"ProjectCompositionSummary":{"type":"object","properties":{"hasComposition":{"type":"boolean"},"sceneCount":{"type":"integer","minimum":0,"maximum":9007199254740991},"duration":{"type":["number","null"]},"updatedAt":{"type":["string","null"]}},"required":["hasComposition","sceneCount","duration","updatedAt"],"additionalProperties":false,"description":"Summary of a project's stored composition."},"ProjectContextResponse":{"type":"object","properties":{"composition":{"anyOf":[{"$ref":"#/components/schemas/Composition"},{"type":"null"}],"description":"The project's ACTIVE composition wire shape — identical to GET /v1/projects/{id}/composition. NULL when the project has no composition yet (a freshly created project): mint one with new_composition, or let the first apply_composition create it."},"format":{"anyOf":[{"type":"object","properties":{"aspectRatio":{"type":"string","enum":["16:9","9:16","1:1","4:5"]},"fps":{"anyOf":[{"type":"number","const":24},{"type":"number","const":25},{"type":"number","const":30},{"type":"number","const":60}]},"resolution":{"type":"string","enum":["hd","fhd","4k"]},"platform":{"type":"string"}},"required":["aspectRatio"],"additionalProperties":false},{"type":"null"}],"description":"The composition's format, hoisted — the pixel frame every card/graphic must be authored against. Null whenever `composition` is null."},"media":{"type":"array","items":{"$ref":"#/components/schemas/ProjectContextMedia"},"description":"The org's media library (most recent first, capped) — the pool this project can draw clips from."},"transcript":{"anyOf":[{"$ref":"#/components/schemas/ProjectContextTranscript"},{"type":"null"}],"description":"The FIRST transcribed media item's word-timed transcript, flattened — the spine a VO-driven film cuts to. `status:\"ready\"` carries the words; `status:\"unavailable\"` means the transcript exists but its body could not be fetched (retry); null means nothing in `media` is transcribed. For any OTHER transcribed item (see each entry's `hasTranscript`), read GET /v1/media/{id}/transcript."},"brandKit":{"anyOf":[{"$ref":"#/components/schemas/BrandKitResponse"},{"type":"null"}],"description":"The kit BOUND to this project (`projects.brandKitId` is the brand SSOT — bind one via update_project). Null when the project has no kit bound; enumerate the org's kits with GET /v1/brand-kits."},"markers":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","minLength":1},"startTime":{"type":"number","minimum":0},"endTime":{"type":"number","minimum":0},"kind":{"type":"string","minLength":1},"name":{"type":"string"},"metadata":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}},"required":["id","startTime","kind"],"additionalProperties":false},"description":"The composition's markers — hoisted alongside `format`. Empty when the composition carries none AND when there is no composition yet."}},"required":["composition","format","media","transcript","brandKit","markers"],"additionalProperties":false,"description":"One-call agent context for a project: composition + format + media pool + the lead transcript + the bound brand kit + markers. Replaces get_composition + get_media_context + get_profile at the start of an authoring session. A 404 means the project doesn't exist for your org — never that it is empty."},"ProjectContextMedia":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"},"kind":{"type":["string","null"]},"durationSec":{"description":"Seconds. Uses the media duration when known; audio without one falls back to its transcript's measured duration (same rule as get_media_context).","type":["number","null"]},"hasTranscript":{"type":"boolean","description":"A cached transcript EXISTS for this item. The bodies are never inlined here — fetch one with GET /v1/media/{id}/transcript (or get_media_context for faces + grids too)."}},"required":["id","name","kind","durationSec","hasTranscript"],"additionalProperties":false,"description":"One media item as the project context lists it: identity + duration + whether a transcript exists."},"ProjectContextTranscript":{"oneOf":[{"type":"object","properties":{"status":{"type":"string","const":"ready"},"mediaId":{"type":"string"},"words":{"type":"array","items":{"type":"object","properties":{"text":{"type":"string"},"start":{"type":"number","description":"Word onset (SECONDS from source start)."},"end":{"type":"number","description":"Word end (SECONDS from source start)."}},"required":["text","start","end"],"additionalProperties":false}}},"required":["status","mediaId","words"],"additionalProperties":false},{"type":"object","properties":{"status":{"type":"string","const":"unavailable"},"mediaId":{"type":"string"}},"required":["status","mediaId"],"additionalProperties":false}],"type":"object"},"ProjectCreateRequest":{"type":"object","properties":{"name":{"type":"string","minLength":1,"maxLength":200},"description":{"type":"string"},"format":{"$ref":"#/components/schemas/FormatSpec"},"brandKitId":{"type":"string","minLength":1},"width":{"deprecated":true,"type":"number","exclusiveMinimum":0},"height":{"deprecated":true,"type":"number","exclusiveMinimum":0}},"required":["name"],"additionalProperties":false,"description":"POST /projects body."},"ProjectLastRender":{"anyOf":[{"type":"object","properties":{"id":{"type":"string"},"status":{"type":"string"},"createdAt":{"type":"string"},"outputUrl":{"type":["string","null"]},"outputExpiresAt":{"type":["string","null"]}},"required":["id","status","createdAt","outputUrl","outputExpiresAt"],"additionalProperties":false},{"type":"null"}],"description":"Most recent render for a project, if any."},"ProjectListResponse":{"type":"object","properties":{"data":{"type":"array","ite