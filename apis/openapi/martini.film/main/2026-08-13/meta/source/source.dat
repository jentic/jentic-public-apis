{
  "openapi": "3.1.0",
  "info": {
    "title": "Martini API",
    "version": "2026-08-13",
    "summary": "Generate images and video, run saved workflows, upload reusable media, and find the projects and canvases to do it in — with one API key.",
    "description": "Authenticate every request with `Authorization: Bearer <key>` (the `Key <key>` form is accepted too).\nKeys are created under Settings → Martini API and are server-side secrets.\nOptionally pin the envelope with `X-Martini-API-Version`; the served version is echoed on every response.\n\nGenerations and runs are asynchronous: submit, then poll the status route until the status is terminal\n(`completed`, `failed`, `cancelled`). There are no webhooks. Retry only 429 (after `Retry-After`) and 5xx.\n\nPass an `idempotencyKey` on anything you might retry: the same key returns the same object instead of charging twice.\n\nPrices are in olives (Martini credits). Every non-2xx answer is `{ \"error\": <copy>, \"code\": <STABLE_CODE> }`;\nbranch on `code`. Human-readable documentation: https://www.martini.film/docs/api and https://www.martini.film/docs/workflows.",
    "contact": {
      "name": "Martini",
      "url": "https://www.martini.film/support",
      "email": "support@martini.film"
    }
  },
  "servers": [
    {
      "url": "https://api.martini.film"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Connection check and this document."
    },
    {
      "name": "Projects",
      "description": "The projects and canvases a key can generate into and run workflows in."
    },
    {
      "name": "Generations",
      "description": "Single image or video generations over the Martini-native routes."
    },
    {
      "name": "Workflows",
      "description": "Saved and placed workflows, and their runs."
    },
    {
      "name": "Assets",
      "description": "Reusable media to reference from generation inputs and workflow bins."
    },
    {
      "name": "Tools",
      "description": "Every MCP tool, callable with an API key: the manifest to generate from, and one route to invoke any tool. What the `martini` CLI is built on."
    }
  ],
  "paths": {
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "tags": [
          "Account"
        ],
        "summary": "Connection check",
        "description": "The key this request authenticates as and the organization it is bound to (null for an account key from `martini login` approved \"as you\"). `organizations` lists that one organization for an organization-bound key, and every organization its user belongs to for an account key. Call it first to confirm the key works.",
        "responses": {
          "200": {
            "description": "Who you are.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "description": "Error. `code` is one of: `UNSUPPORTED_API_VERSION`.",
            "x-martini-error-codes": [
              "UNSUPPORTED_API_VERSION"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error. `code` is one of: `API_KEY_EXPIRED`, `API_KEY_REVOKED`, `INVALID_API_KEY`.",
            "x-martini-error-codes": [
              "API_KEY_EXPIRED",
              "API_KEY_REVOKED",
              "INVALID_API_KEY"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error. `code` is one of: `API_KEY_DEFAULTS_MISSING`, `GENERATION_API_DISABLED`, `ORGANIZATION_REQUIRED`, `RUN_KEY_NOT_ALLOWED`.",
            "x-martini-error-codes": [
              "API_KEY_DEFAULTS_MISSING",
              "GENERATION_API_DISABLED",
              "ORGANIZATION_REQUIRED",
              "RUN_KEY_NOT_ALLOWED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error. `code` is one of: `GENERATION_API_ACCESS_UNAVAILABLE`.",
            "x-martini-error-codes": [
              "GENERATION_API_ACCESS_UNAVAILABLE"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects": {
      "get": {
        "operationId": "listProjects",
        "tags": [
          "Projects"
        ],
        "summary": "List projects",
        "description": "The organization’s projects the key’s user can see, most recently joined first. Use it to pick a `projectId` by name for a run, a placement, a generation, or an upload; `canEdit` says whether the user may write there. With `query`, matches are ranked: an exact id or name first, then a name that starts with, contains, or holds every word of the query, then an id fragment.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "description": "A project name or id, or a fragment of either. 1–200 characters.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "exactName",
            "in": "query",
            "required": false,
            "description": "With `query`: `true` keeps only projects whose name matches it exactly (case-insensitive), or whose id is it.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size, 1–50; defaults to 20. `truncated` in the answer says whether more matched.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The projects.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            }
          },
          "400": {
            "description": "Error. `code` is one of: `INVALID_REQUEST`, `UNSUPPORTED_API_VERSION`.",
            "x-martini-error-codes": [
              "INVALID_REQUEST",
              "UNSUPPORTED_API_VERSION"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error. `code` is one of: `API_KEY_EXPIRED`, `API_KEY_REVOKED`, `INVALID_API_KEY`.",
            "x-martini-error-codes": [
              "API_KEY_EXPIRED",
              "API_KEY_REVOKED",
              "INVALID_API_KEY"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error. `code` is one of: `API_KEY_DEFAULTS_MISSING`, `GENERATION_API_DISABLED`, `ORGANIZATION_REQUIRED`, `RUN_KEY_NOT_ALLOWED`.",
            "x-martini-error-codes": [
              "API_KEY_DEFAULTS_MISSING",
              "GENERATION_API_DISABLED",
              "ORGANIZATION_REQUIRED",
              "RUN_KEY_NOT_ALLOWED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error. `code` is one of: `GENERATION_API_ACCESS_UNAVAILABLE`.",
            "x-martini-error-codes": [
              "GENERATION_API_ACCESS_UNAVAILABLE"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{projectId}/canvases": {
      "get": {
        "operationId": "listProjectCanvases",
        "tags": [
          "Projects"
        ],
        "summary": "List a project’s canvases",
        "description": "The canvases of a project the key’s user can read, in the order the app lists them. Use it to pick a `canvasId`; the one marked `isDefault` is where the project opens. A project whose document cannot be opened answers 409 `PROJECT_DOCUMENT_TOO_LARGE` (durable — retrying will not help) or 503 `PROJECT_DOCUMENT_UNAVAILABLE` (retry).",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "description": "A project id from GET /v1/projects.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The project and its canvases.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CanvasList"
                }
              }
            }
          },
          "400": {
            "description": "Error. `code` is one of: `UNSUPPORTED_API_VERSION`.",
            "x-martini-error-codes": [
              "UNSUPPORTED_API_VERSION"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error. `code` is one of: `API_KEY_EXPIRED`, `API_KEY_REVOKED`, `INVALID_API_KEY`.",
            "x-martini-error-codes": [
              "API_KEY_EXPIRED",
              "API_KEY_REVOKED",
              "INVALID_API_KEY"
            ],
            "content": {
              "application/json": {
