                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          }
                        },
                        "required": [
                          "fileId"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              ]
            }
          },
          "bins": {
            "description": "Optional replacements keyed by input-bin name (case-insensitive) or id. Omit a bin to use its saved preset (saved workflow) or current contents (placed workflow). A supplied array replaces that bin; [] explicitly empties a media bin. JSON file inputs still require files. Only saved bins marked required need caller input. JSON file inputs can use inputs or saved default files. Each entry is an asset id, or a file to import first: a public https:// URL (up to 50 MB), a base64 data: URI (10 MB image, 30 MB MP4, 15 MB MP3/WAV, decoded), or { url, filename } for either. File inputs are for saved workflows (a placed workflow takes asset ids); imports land in the key’s default project, and the run starts once every import has processed (up to 60 s), at most 20 per run. The whole request body is capped at 41 MB, so several large files are better passed as URLs or uploads. A failed import answers WORKFLOW_INPUT_FETCH_FAILED and starts nothing.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "additionalProperties": {
              "maxItems": 200,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "An asset id (from GET /v1/runs/{runId}/results, or a finished upload)."
                  },
                  {
                    "type": "string",
                    "pattern": "^(https:\\/\\/|data:)",
                    "description": "A public https:// URL or a base64 data: URI. Martini imports it into the key’s workspace before the run starts."
                  },
                  {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "pattern": "^(https:\\/\\/|data:)",
                        "description": "A public https:// URL or a base64 data: URI."
                      },
                      "filename": {
                        "description": "The imported asset's filename; defaults to the URL's last path segment, or a name from the type.",
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "url"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          },
          "fingerprint": {
            "description": "The fingerprint last read for this workflow; the run is refused with WORKFLOW_CHANGED when it no longer matches.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "projectId": {
            "description": "Destination only, for saved workflows: store the new execution canvas in this project. Omit to use Workflow runs. The saved workflow ID still selects the definition and presets; this field never selects a source workflow or adopts project contents.",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "engine": {
            "description": "Which engine drives the run. Omitted: the saved workflow's pin, else Workflow Beta (\"fable\"), one autonomous session running the workflow's compiled scripts. \"harness\" is the classic per-Action engine, the only one that supports resume. A Beta run with no oliveBudget gets 1,000 olives and a DEFAULT_OLIVE_BUDGET_APPLIED warning.",
            "type": "string",
            "enum": [
              "fable",
              "harness"
            ]
          }
        },
        "additionalProperties": false
      },
      "WorkflowRun": {
        "type": "object",
        "properties": {
          "billing": {
            "type": "object",
