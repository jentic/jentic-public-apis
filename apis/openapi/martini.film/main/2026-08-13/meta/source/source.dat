                  "type": "object",
                  "properties": {
                    "multiplier": {
                      "description": "Legacy: the factor of the model-wide rule, when it has one.",
                      "type": "number"
                    },
                    "resolutionMultipliers": {
                      "description": "Legacy: the factors of resolution-scoped rules that have one.",
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "number"
                      }
                    },
                    "rules": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "object",
                            "properties": {
                              "scope": {
                                "anyOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "description": "Normalized resolution the rule prices (e.g. `720p`), or null for the model-wide rule. A resolution scope wins over the model-wide one."
                              },
                              "kind": {
                                "type": "string",
                                "const": "absolute"
                              },
                              "unit": {
                                "type": "string",
                                "enum": [
                                  "second",
                                  "image"
                                ]
                              },
                              "output": {
                                "type": "object",
                                "properties": {
                                  "olives": {
                                    "type": "number"
                                  },
                                  "per": {
                                    "type": "number"
                                  }
                                },
                                "required": [
                                  "olives",
                                  "per"
                                ],
                                "additionalProperties": false,
                                "description": "Price of generated output, independent of provider routing."
                              },
                              "videoReference": {
                                "anyOf": [
                                  {
                                    "type": "object",
                                    "properties": {
                                      "olives": {
                                        "type": "number"
                                      },
                                      "per": {
                                        "type": "number"
                                      }
                                    },
                                    "required": [
                                      "olives",
                                      "per"
                                    ],
                                    "additionalProperties": false,
                                    "description": "`olives` per `per` units, e.g. `{ \"olives\": 23, \"per\": 15 }` = 23 olives per 15 seconds."
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "description": "Price per combined second (output + trimmed reference video) when the request carries video references; null means the agreement does not price reference-to-video and the rule does not apply to such requests."
                              }
                            },
                            "required": [
                              "scope",
                              "kind",
                              "unit",
                              "output",
                              "videoReference"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "scope": {
                                "anyOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "description": "Normalized resolution the rule prices (e.g. `720p`), or null for the model-wide rule. A resolution scope wins over the model-wide one."
                              },
                              "kind": {
                                "type": "string",
                                "const": "percentage"
                              },
                              "percentOff": {
                                "type": "number",
                                "description": "Percent off the published list price (20 = 20% off)."
                              },
                              "basis": {
                                "type": "string",
                                "const": "published_list"
                              },
                              "basisPolicy": {
                                "type": "string",
                                "enum": [
                                  "floating",
                                  "pinned"
                                ]
                              },
                              "basisVersion": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "scope",
                              "kind",
                              "percentOff",
                              "basis",
                              "basisPolicy",
                              "basisVersion"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "scope": {
                                "anyOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "description": "Normalized resolution the rule prices (e.g. `720p`), or null for the model-wide rule. A resolution scope wins over the model-wide one."
                              },
                              "kind": {
                                "type": "string",
                                "const": "multiplier"
                              },
                              "multiplier": {
                                "type": "number",
                                "description": "Legacy factor over the routed list cost; being retired."
                              }
                            },
                            "required": [
                              "scope",
                              "kind",
                              "multiplier"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "type": "object",
                            "properties": {
                              "scope": {
                                "anyOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "description": "Normalized resolution the rule prices (e.g. `720p`), or null for the model-wide rule. A resolution scope wins over the model-wide one."
                              },
                              "kind": {
                                "type": "string",
                                "const": "standard"
                              }
                            },
                            "required": [
                              "scope",
                              "kind"
                            ],
                            "additionalProperties": false,
                            "description": "Standard pricing for this scope."
                          }
                        ],
                        "description": "One effective negotiated pricing rule for your organization."
                      }
                    }
                  },
                  "required": [
                    "rules"
                  ],
                  "additionalProperties": false,
                  "description": "Your organization's negotiated pricing for this model; absent at standard pricing."
                },
                "deprecation": {
                  "type": "object",
