                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Error. `code` is one of: `PROJECT_DOCUMENT_TOO_LARGE`.",
            "x-martini-error-codes": [
              "PROJECT_DOCUMENT_TOO_LARGE"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Error. `code` is one of: `GENERATION_API_ACCESS_UNAVAILABLE`, `PROJECT_DOCUMENT_UNAVAILABLE`.",
            "x-martini-error-codes": [
              "GENERATION_API_ACCESS_UNAVAILABLE",
              "PROJECT_DOCUMENT_UNAVAILABLE"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
