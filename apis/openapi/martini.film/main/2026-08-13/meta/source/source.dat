      },
      "WorkflowList": {
        "type": "object",
        "properties": {
          "workflows": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "const": "saved"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "version": {
                      "type": "number"
                    },
                    "fingerprint": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "string"
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "agent": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "agent"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "inputs": {
                      "type": "object",
                      "properties": {
                        "variables": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "Scoped to the returned workflow: saved source id or placed canvas id. Copies have new ids."
                              },
                              "name": {
                                "type": "string",
                                "description": "Accepted as a case-insensitive key in run variables; avoids reusing ids across copies."
                              },
                              "value": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "id",
                              "name",
                              "value"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "bins": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "hasDefault": {
                                "type": "boolean",
                                "description": "Omit this input to use its saved preset (including inherited folders) or default JSON files. An explicit bins entry replaces the preset subtree; [] empties media bins, while JSON file inputs still require files. False means the caller must supply this input."
                              },
                              "fileInput": {
                                "type": "object",
                                "properties": {
                                  "key": {
                                    "type": "string",
                                    "pattern": "^[a-z][a-z0-9_]{0,63}$"
                                  },
                                  "format": {
                                    "type": "string",
                                    "const": "json"
                                  },
                                  "cardinality": {
                                    "type": "string",
                                    "enum": [
                                      "one",
                                      "many"
                                    ]
                                  },
                                  "defaultFiles": {
                                    "maxItems": 20,
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "id": {
                                          "type": "string",
                                          "format": "uuid",
                                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                        },
                                        "storageAssetId": {
                                          "type": "string",
                                          "format": "uuid",
                                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                                        },
                                        "filename": {
                                          "type": "string",
                                          "maxLength": 200
                                        },
                                        "uri": {
                                          "type": "string",
                                          "maxLength": 2048
                                        },
                                        "checksum": {
                                          "type": "string",
                                          "pattern": "^[a-f0-9]{64}$"
                                        },
                                        "sizeBytes": {
                                          "type": "integer",
                                          "minimum": 1,
                                          "maximum": 10485760
                                        }
                                      },
                                      "required": [
                                        "id",
                                        "storageAssetId",
                                        "filename",
                                        "uri",
                                        "checksum",
                                        "sizeBytes"
                                      ],
                                      "additionalProperties": false
                                    }
                                  }
                                },
                                "required": [
                                  "key",
                                  "format",
                                  "cardinality"
                                ],
                                "additionalProperties": false
                              },
                              "required": {
                                "type": "boolean",
                                "description": "True when this saved bin needs caller input; false when omitted input uses saved defaults."
                              },
                              "defaultSource": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "enum": [
                                      "saved_preset",
                                      "saved_files"
                                    ]
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "description": "Contents used when the bin is omitted. null means caller input is required. Explicit bin overrides replace these defaults."
                              }
                            },
                            "required": [
                              "id",
