              "budgetPolicy",
              "status",
              "estimatedOlives",
              "accruedOlives",
              "reservedOlives",
              "chargedOlives",
              "resources"
            ],
            "additionalProperties": false
          },
          "warnings": {
            "description": "Non-blocking caveats, accumulated across attempts. Absence means none. Never changes status or clears errors.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "actionId": {
                  "anyOf": [
