                        "type": "string"
                      },
                      "unit": {
                        "description": "1-based unit number within the step.",
                        "type": "number"
                      },
                      "take": {
                        "type": "number"
                      },
                      "durationMs": {
                        "type": "number"
                      },
                      "note": {
                        "type": "string"
                      },
                      "detail": {
