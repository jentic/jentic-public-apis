          },
          "input": {
            "type": "object",
            "description": "The model input in its fal field names, validated strictly against the GenerationInput.* schema for `endpoint` (unknown fields are rejected with UNSUPPORTED_INPUT). The `allOf` conditionals select it; `x-martini-input-schemas` lists the same alias → schema map for tools that skip conditionals."
          },
          "projectId": {
            "description": "Override the key's default project. Without `canvasId`, the project's first canvas is used.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "canvasId": {
            "description": "Override the key's default canvas; requires `projectId`.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "placement": {
            "description": "Only `auto` (next to the last node on the canvas) is supported.",
            "type": "string",
