    "/v1/generations/{id}/cancel": {
      "post": {
        "operationId": "cancelGeneration",
        "tags": [
          "Generations"
        ],
        "summary": "Cancel a generation",
        "description": "Cancel a queued or running generation and refund its charge. Idempotent for an already cancelled one.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The generation id.",
            "schema": {
              "type": "string"
            }
