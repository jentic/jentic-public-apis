                    "link_view",
                    "link_edit"
                  ],
                  "description": "What a share link grants someone who is not a member: nothing, viewing, or editing."
                },
                "canEdit": {
                  "type": "boolean",
                  "description": "Whether the key’s user can edit the project — run workflows in it, place copies, upload and generate into it. A project listed with `false` is theirs to read only."
                },
