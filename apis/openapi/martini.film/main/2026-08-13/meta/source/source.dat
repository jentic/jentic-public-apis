          }
        }
      }
    },
    "/v1/tools/{name}": {
      "post": {
        "operationId": "invokeTool",
        "tags": [
          "Tools"
        ],
        "summary": "Invoke a tool",
        "description": "Run one MCP tool as the key’s user. The body is the tool’s arguments exactly as its `inputSchema` describes them (an empty body means no arguments); the response is the tool’s result with the MCP envelope removed — the JSON object the tool produced, or `{ ..., \"media\": [{ \"type\", \"mimeType\", \"data\" }] }` when it returned an image or audio block (base64 in `data`). `select` keeps only the listed dotted paths, through arrays (`nodes.id`) and, with an explicit `*` segment, every value of an id-keyed map (`assets.*.id`), so large listings never leave the server when a few fields are wanted. `format=raw` answers the bytes of a single media result with its own Content-Type and the JSON metadata in the X-Martini-Tool-Result header. Tool errors keep their MCP error code in `code`, with the status the code implies. Tools that need workflows (Actions) access answer TOOL_NOT_FOUND for callers without it, as the MCP does. A run key (`mtn_run_…`, minted for a workflow run’s sandbox) dispatches through that run’s live supervisor — same budgets, fences, and traces as the run’s own tool calls — and answers RUN_NOT_ACTIVE once the run stops.",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "The tool name, as `GET /v1/tools` lists it.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "select",
            "in": "query",
            "required": false,
            "description": "Comma-separated dotted field paths to keep in the JSON result (segments of letters, digits, `_`, `-`, or a lone `*`; at most 64). Arrays are traversed element-wise; a `*` segment fans out over every value of an object (keys kept) or every element of an array, e.g. `assets.*.id` on an id-keyed map. Paths that match nothing are dropped.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "`json` (default) answers JSON; `raw` answers the bytes of a result that is exactly one media block, or NOT_RAW_ELIGIBLE.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "raw"
              ],
              "default": "json"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "description": "The tool arguments, matching the tool’s `inputSchema` from GET /v1/tools.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool result: its JSON object (projected by `select` when given), or the raw media bytes with `format=raw`.",
            "headers": {
              "X-Martini-Tool": {
                "description": "The tool that answered.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Martini-Tool-Result": {
                "description": "With `format=raw`: the JSON metadata that accompanied the media.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "description": "The tool’s own result shape; see the tool’s description in the manifest."
                }
              },
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Error. `code` is one of: `INVALID_ARGUMENTS`, `INVALID_REQUEST`, `TOOL_ERROR`, `UNSUPPORTED_API_VERSION`.",
            "x-martini-error-codes": [
              "INVALID_ARGUMENTS",
              "INVALID_REQUEST",
              "TOOL_ERROR",
              "UNSUPPORTED_API_VERSION"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "401": {
            "description": "Error. `code` is one of: `API_KEY_EXPIRED`, `API_KEY_REVOKED`, `INVALID_API_KEY`.",
            "x-martini-error-codes": [
              "API_KEY_EXPIRED",
              "API_KEY_REVOKED",
              "INVALID_API_KEY"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "402": {
            "description": "Error. `code` is one of: `TOOL_ERROR`.",
            "x-martini-error-codes": [
              "TOOL_ERROR"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "403": {
            "description": "Error. `code` is one of: `API_KEY_DEFAULTS_MISSING`, `ORGANIZATION_REQUIRED`, `RUN_KEY_NOT_ALLOWED`, `TOOL_ERROR`.",
            "x-martini-error-codes": [
              "API_KEY_DEFAULTS_MISSING",
              "ORGANIZATION_REQUIRED",
              "RUN_KEY_NOT_ALLOWED",
              "TOOL_ERROR"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "404": {
            "description": "Error. `code` is one of: `TOOL_ERROR`, `TOOL_NOT_FOUND`.",
            "x-martini-error-codes": [
              "TOOL_ERROR",
              "TOOL_NOT_FOUND"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "406": {
            "description": "Error. `code` is one of: `NOT_RAW_ELIGIBLE`.",
            "x-martini-error-codes": [
              "NOT_RAW_ELIGIBLE"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "409": {
            "description": "Error. `code` is one of: `RUN_NOT_ACTIVE`, `TOOL_ERROR`.",
            "x-martini-error-codes": [
              "RUN_NOT_ACTIVE",
              "TOOL_ERROR"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "429": {
            "description": "Error. `code` is one of: `TOOL_ERROR`.",
            "x-martini-error-codes": [
              "TOOL_ERROR"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          },
          "500": {
            "description": "Error. `code` is one of: `TOOL_INVOCATION_FAILED`.",
            "x-martini-error-codes": [
              "TOOL_INVOCATION_FAILED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cli/login": {
      "post": {
        "operationId": "createCliLogin",
        "tags": [
          "Tools"
        ],
        "summary": "Start a CLI login (device-code pairing)",
        "description": "How `martini login` obtains a key without a browser on the same machine. Creates a pairing request and returns a short code plus a poll token. The person opens `verificationUrl` in the signed-in Martini app, types the code, picks an organization or \"as you\" (an account key with no organization), and approves; the CLI polls `GET /v1/cli/login/{pollToken}` until it is handed a fresh `mtn_cli_…` key (90-day expiry). Send `X-Martini-Client: martini-cli/<version>` so the approval page offers only what that CLI can collect. No authentication: the CLI has none yet. Rate limited per client.",
        "security": [],
        "requestBody": {
          "required": true,
          "description": "The device to label the key with.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CliLoginCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The pairing request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CliLoginCreated"
                }
              }
            }
          },
          "400": {
            "description": "Error. `code` is one of: `INVALID_REQUEST`, `INVALID_DEVICE_LABEL`.",
            "x-martini-error-codes": [
              "INVALID_REQUEST",
              "INVALID_DEVICE_LABEL"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Error. `code` is one of: `RATE_LIMITED`.",
            "x-martini-error-codes": [
              "RATE_LIMITED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error. `code` is one of: `LOGIN_UNAVAILABLE`.",
            "x-martini-error-codes": [
              "LOGIN_UNAVAILABLE"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cli/login/{pollToken}": {
      "get": {
        "operationId": "pollCliLogin",
        "tags": [
          "Tools"
        ],
        "summary": "Poll a CLI login",
        "description": "The pairing request’s state. `approved` carries the key exactly once — a later poll answers `claimed`. Wait `interval` seconds between polls; the request expires ten minutes after creation. An approval \"as you\" (an account key) is refused with 403 `CLI_UPDATE_REQUIRED` — before anything is minted, so the approval stands — when the polling `X-Martini-Client` names a CLI too old to hold one.",
        "security": [],
        "parameters": [
          {
            "name": "pollToken",
            "in": "path",
            "required": true,
            "description": "The poll token from POST /v1/cli/login.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The state, with the key when approved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CliLoginPoll"
                }
              }
            }
          },
          "403": {
            "description": "Error. `code` is one of: `CLI_UPDATE_REQUIRED`.",
            "x-martini-error-codes": [
              "CLI_UPDATE_REQUIRED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error. `code` is one of: `LOGIN_REQUEST_NOT_FOUND`.",
            "x-martini-error-codes": [
              "LOGIN_REQUEST_NOT_FOUND"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Error. `code` is one of: `RATE_LIMITED`.",
            "x-martini-error-codes": [
              "RATE_LIMITED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error. `code` is one of: `LOGIN_UNAVAILABLE`.",
            "x-martini-error-codes": [
              "LOGIN_UNAVAILABLE"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "tags": [
          "Account"
        ],
        "summary": "This document",
        "description": "The OpenAPI 3.1 description of the API-key surface. No authentication required.",
        "security": [],
        "responses": {
          "200": {
            "description": "The document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A Martini API key (`mtn_live_…`). `Authorization: Bearer <key>`; `Authorization: Key <key>` is also accepted."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Copy written for a human."
          },
          "code": {
            "type": "string",
            "description": "The stable Martini error code.",
            "enum": [
              "API_KEY_DEFAULTS_MISSING",
              "API_KEY_EXPIRED",
              "API_KEY_REVOKED",
              "ASSET_NOT_FOUND",
              "ASSET_UPLOAD_FAILED",
              "BATCH_EMPTY",
              "BATCH_TOO_LARGE",
              "BILLING_ORGANIZATION_MISMATCH",
              "BODY_TOO_LARGE",
              "CANVAS_NOT_FOUND",
              "CLI_UPDATE_REQUIRED",
              "DRAFT_ALREADY_GENERATING",
              "DUPLICATE_ASSET_ID",
              "ENDPOINT_NOT_REGISTERED",
              "GENERATION_API_ACCESS_UNAVAILABLE",
              "GENERATION_API_DISABLED",
              "GENERATION_SUBMISSION_FAILED",
              "INSUFFICIENT_OLIVES",
              "INVALID_API_KEY",
              "INVALID_ARGUMENTS",
              "INVALID_DESTINATION",
              "INVALID_DEVICE_LABEL",
              "INVALID_FILENAME",
              "INVALID_FILE_INPUT",
              "INVALID_FORMAT",
              "INVALID_INPUT",
              "INVALID_MEDIA",
              "INVALID_REQUEST",
              "INVALID_TARGET_URL",
              "KIT_STALE",
              "LOGIN_REQUEST_NOT_FOUND",
              "LOGIN_UNAVAILABLE",
              "MEDIA_TOO_LARGE",
              "NOT_RAW_ELIGIBLE",
              "ORGANIZATION_REQUIRED",
              "PLACEMENT_CONFLICT",
              "PLACEMENT_FAILED",
              "PROJECT_ACCESS_DENIED",
              "PROJECT_DOCUMENT_TOO_LARGE",
              "PROJECT_DOCUMENT_UNAVAILABLE",
              "PROJECT_NOT_FOUND",
              "PROJECT_WRITE_FORBIDDEN",
              "RATE_LIMITED",
              "REQUEST_ALREADY_TERMINAL",
              "REQUEST_NOT_FOUND",
              "RESULT_NOT_READY",
              "RUN_KEY_NOT_ALLOWED",
              "RUN_NOT_ACTIVE",
              "SIZE_EXCEEDED",
              "SPEND_CAP_EXCEEDED",
              "TOOL_ERROR",
              "TOOL_INVOCATION_FAILED",
              "TOOL_NOT_FOUND",
              "UNSUPPORTED_API_VERSION",
              "UNSUPPORTED_INPUT",
              "UNSUPPORTED_MARTINI_MODE",
              "UNSUPPORTED_OPERATION",
              "WEBHOOKS_UNSUPPORTED",
              "WORKFLOWS_NOT_ENABLED",
              "WORKFLOW_ASSET_NOT_FOUND",
              "WORKFLOW_BIN_NOT_FOUND",
              "WORKFLOW_BIN_REQUIRED",
              "WORKFLOW_CHANGED",
              "WORKFLOW_CREATE_FAILED",
              "WORKFLOW_CREATE_REJECTED",
              "WORKFLOW_INPUT_FETCH_FAILED",
              "WORKFLOW_NOT_FOUND",
              "WORKFLOW_RUN_FAILED",
              "WORKFLOW_RUN_NOT_FOUND",
              "WORKFLOW_RUN_NOT_RESUMABLE",
              "WORKFLOW_RUN_REJECTED",
              "WORKFLOW_VARIABLE_NOT_FOUND"
            ]
          }
        },
        "required": [
          "error",
          "code"
        ],
        "additionalProperties": {},
        "description": "Every non-2xx answer. `error` is copy for a human; `code` is the stable value to branch on."
      },
      "Me": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "organization",
              "user"
            ],
            "description": "`organization`: the key is bound to `organization`. `user`: an account key from `martini login` approved \"as you\"; it acts wherever its user is a member, on the tool routes only."
          },
          "organization": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "name"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "The organization the key is bound to; null for an account key."
          },
          "organizations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "slug": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "personal",
                    "team"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "slug",
                "type"
              ],
              "additionalProperties": false
            },
            "description": "For an account key, every organization its user belongs to, personal first. For an organization-bound key, only that organization (empty if the key’s user has since left it). Empty for a workflow run key."
          },
          "key": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "api",
                  "cli",
                  "run"
                ]
              },
              "expiresAt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "When the key expires; null for a key that only ends by revocation."
              }
            },
            "required": [
              "label",
              "kind",
              "expiresAt"
            ],
            "additionalProperties": false
          },
          "apiVersion": {
            "type": "string"
          }
        },
        "required": [
          "scope",
          "organization",
          "organizations",
          "key",
          "apiVersion"
        ],
