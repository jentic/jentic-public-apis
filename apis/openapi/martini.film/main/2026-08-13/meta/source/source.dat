    "/v1/generations": {
      "post": {
        "operationId": "createGeneration",
        "tags": [
          "Generations"
        ],
        "summary": "Submit a generation",
        "description": "Submit a generation (or, with `mode: \"draft\"`, an editable draft that is not charged or started). Answers 201 with the generation, or 200 with the existing one when `idempotencyKey` repeats an earlier request. Then poll GET /v1/generations/{id} until `status` is completed, failed, or cancelled.",
        "requestBody": {
          "required": true,
          "description": "The endpoint alias, its model input, and optional Martini options.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGeneration"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay: the generation the first call created, in its current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Generation"
                }
              }
            }
          },
          "201": {
            "description": "Created. `status` is `pending` (or `draft`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Generation"
                }
              }
            }
          },
          "400": {
            "description": "Error. `code` is one of: `INVALID_REQUEST`, `UNSUPPORTED_API_VERSION`, `UNSUPPORTED_MARTINI_MODE`, `WEBHOOKS_UNSUPPORTED`.",
            "x-martini-error-codes": [
              "INVALID_REQUEST",
              "UNSUPPORTED_API_VERSION",
              "UNSUPPORTED_MARTINI_MODE",
              "WEBHOOKS_UNSUPPORTED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error. `code` is one of: `API_KEY_EXPIRED`, `API_KEY_REVOKED`, `INVALID_API_KEY`.",
            "x-martini-error-codes": [
              "API_KEY_EXPIRED",
              "API_KEY_REVOKED",
              "INVALID_API_KEY"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Error. `code` is one of: `INSUFFICIENT_OLIVES`, `SPEND_CAP_EXCEEDED`.",
            "x-martini-error-codes": [
              "INSUFFICIENT_OLIVES",
              "SPEND_CAP_EXCEEDED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error. `code` is one of: `API_KEY_DEFAULTS_MISSING`, `BILLING_ORGANIZATION_MISMATCH`, `GENERATION_API_DISABLED`, `ORGANIZATION_REQUIRED`, `PROJECT_ACCESS_DENIED`, `RUN_KEY_NOT_ALLOWED`.",
            "x-martini-error-codes": [
              "API_KEY_DEFAULTS_MISSING",
              "BILLING_ORGANIZATION_MISMATCH",
              "GENERATION_API_DISABLED",
              "ORGANIZATION_REQUIRED",
              "PROJECT_ACCESS_DENIED",
              "RUN_KEY_NOT_ALLOWED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error. `code` is one of: `CANVAS_NOT_FOUND`, `ENDPOINT_NOT_REGISTERED`.",
            "x-martini-error-codes": [
              "CANVAS_NOT_FOUND",
