                    "agent"
                  ],
                  "additionalProperties": false,
                  "description": "`generation` is the step's spend summed from its takes; `agent` is the step's own measurement, not a share of the run-level `olives.agent`."
                },
                "events": {
                  "description": "The step's activity trail; present only with `?include=activity`. A finished step's events never change.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "elapsedMs": {
                        "type": "number",
