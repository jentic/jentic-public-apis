    "/v1/runs/{runId}": {
      "get": {
        "operationId": "getRun",
        "tags": [
          "Workflows"
        ],
        "summary": "Run status",
        "description": "The run with per-step and per-take progress and the live `phase` line. Poll until `status` is completed, failed, or cancelled — with `?wait=45`, each call holds until the run changes instead of answering at once; `?include=activity` adds each step's `events` (its activity trail).",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "description": "The run id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "description": "`activity` adds each step's `events`. Any other value answers 400 INVALID_REQUEST.",
            "schema": {
              "type": "string",
              "enum": [
                "activity"
              ]
            }
          },
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "description": "Long-poll: hold the call up to this many seconds (0–45) until the run changes — its status, its current step, its phase line, its progress, or its outputs — or settles (completed, failed, needs_revision, cancelled), then answer. A settled run answers at once, and so does every call when the server is holding too many polls; when nothing changed in time the answer is the run as it stands. Replaces sleeping between polls: call again with the same `wait` until `status` is terminal. Any other value answers 400 INVALID_REQUEST.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 45,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The run.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowRun"
                }
              }
            }
          },
          "400": {
            "description": "Error. `code` is one of: `INVALID_REQUEST`, `UNSUPPORTED_API_VERSION`.",
            "x-martini-error-codes": [
              "INVALID_REQUEST",
              "UNSUPPORTED_API_VERSION"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error. `code` is one of: `API_KEY_EXPIRED`, `API_KEY_REVOKED`, `INVALID_API_KEY`.",
            "x-martini-error-codes": [
              "API_KEY_EXPIRED",
              "API_KEY_REVOKED",
              "INVALID_API_KEY"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
