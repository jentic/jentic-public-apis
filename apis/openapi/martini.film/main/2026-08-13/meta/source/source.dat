                  "uploadUrl",
                  "uploadHeaders",
                  "directUpload",
                  "expiresIn",
                  "assetNumber",
                  "url",
                  "canvasPosition",
                  "assetType"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean",
                    "const": false
                  },
                  "index": {
                    "type": "number"
                  },
                  "filename": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "enum": [
                      "MISSING_FIELDS",
                      "INVALID_SIZE",
                      "INVALID_FORMAT",
                      "FILE_TOO_LARGE",
                      "SIZE_EXCEEDED",
                      "INVALID_FILENAME",
                      "AUDIO_EXTENSION_MISMATCH",
                      "STORAGE_UNAVAILABLE",
                      "UPLOAD_CAPACITY_EXCEEDED"
                    ],
                    "description": "Why this file was refused."
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "ok",
                  "index",
                  "filename",
                  "code",
                  "message"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Where the asset was placed. The bytes are already stored, so there is nothing to upload: `uploadUrl` is null, `uploadHeaders` is empty, and `directUpload` is false."
          }
        },
        "required": [
          "asset",
          "prepare"
        ],
        "additionalProperties": false
      },
      "ToolManifest": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "const": 1
          },
          "hash": {
            "type": "string",
            "description": "sha256 over the tool entries; also the response ETag. Equal hashes mean an identical tool surface."
          },
          "generatedAt": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The tool name; also the path segment of `POST /v1/tools/{name}`."
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string",
                  "description": "Written for an agent: what the tool does, its limits, and what to call next."
                },
                "inputSchema": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {},
                  "description": "JSON Schema (draft 2020-12) of the arguments the tool accepts; the request body must match it."
                },
                "outputSchema": {
                  "description": "JSON Schema (draft 2020-12) of the result body, when the tool declares one. Loose: it names the fields a caller can rely on (and project with `select`) without forbidding others.",
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "annotations": {
                  "type": "object",
                  "properties": {
                    "readOnlyHint": {
                      "type": "boolean",
                      "description": "The tool reads and never changes the project."
                    },
                    "destructiveHint": {
                      "type": "boolean",
                      "description": "The tool may delete or replace what exists."
                    },
                    "openWorldHint": {
                      "type": "boolean",
                      "description": "The tool reaches outside Martini (for example, files a support case)."
                    },
                    "idempotentHint": {
                      "description": "Repeating the call with the same arguments has no further effect.",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "readOnlyHint",
                    "destructiveHint",
                    "openWorldHint"
                  ],
                  "additionalProperties": false
                },
                "profiles": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "full",
                      "core"
                    ]
                  },
                  "description": "MCP profiles that serve the tool: `/mcp` serves `full`, `/mcp-core` serves `core`."
                },
                "requiresActions": {
                  "type": "boolean",
                  "description": "Only callers with workflows (Actions) access can see or invoke it; others get TOOL_NOT_FOUND."
                },
                "deprecated": {
                  "type": "object",
                  "properties": {
                    "sunsetDate": {
                      "description": "ISO-8601 date the tool stops being served, when scheduled.",
                      "type": "string"
                    },
                    "supersededBy": {
                      "description": "The tool to use instead, when there is a direct replacement.",
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "description",
                "inputSchema",
                "annotations",
                "profiles",
                "requiresActions"
              ],
              "additionalProperties": false
            },
            "description": "Every tool, sorted by name."
          }
        },
        "required": [
          "version",
          "hash",
          "generatedAt",
          "tools"
        ],
        "additionalProperties": false
      },
      "CliLoginCreateRequest": {
        "type": "object",
        "properties": {
          "deviceLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "What the person will see when asked to approve: the machine name, and the host agent if any."
          }
        },
        "required": [
          "deviceLabel"
        ]
      },
      "CliLoginCreated": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The short code to type into the app, `ABCD-EFGH`. Never put it in a link."
          },
          "pollToken": {
            "type": "string",
            "description": "The secret that collects the key; poll `GET /v1/cli/login/{pollToken}` with it."
          },
          "verificationUrl": {
            "type": "string",
            "description": "Where the person confirms the code (the signed-in app)."
          },
          "expiresAt": {
            "type": "string"
          },
          "interval": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Seconds to wait between polls."
          }
        },
        "required": [
          "code",
          "pollToken",
          "verificationUrl",
          "expiresAt",
          "interval"
        ],
        "additionalProperties": false
      },
      "CliLoginPoll": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "pending"
              },
              "expiresAt": {
                "type": "string"
              }
            },
            "required": [
              "status",
              "expiresAt"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "denied"
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "expired"
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "claimed"
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false,
            "description": "The key was already collected by an earlier poll."
          },
          {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "approved"
              },
              "key": {
                "type": "string",
                "description": "The minted `mtn_cli_…` key. Handed out exactly once; store it now."
              },
              "keyId": {
                "type": "string"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "organization",
                  "user"
                ],
                "description": "`organization`: bound to `organizationId`. `user`: an account key, approved \"as you\"."
              },
              "organizationId": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Null for an account key."
              },
              "expiresAt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "When the key expires (90 days); run `martini login` again to renew."
              }
            },
            "required": [
              "status",
              "key",
              "keyId",
              "scope",
              "organizationId",
              "expiresAt"
            ],
            "additionalProperties": false
          }
        ]
      },
      "ToolError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Copy written for a human."
          },
          "code": {
            "type": "string",
            "description": "A fixed route code (TOOL_NOT_FOUND, INVALID_REQUEST, INVALID_ARGUMENTS, NOT_RAW_ELIGIBLE, TOOL_INVOCATION_FAILED, or a key error), or the tool’s own error code — for example ASSET_NOT_READY — with TOOL_ERROR when the tool gave none."
          },
          "tool": {
            "description": "The tool that answered, when the error came from invoking one.",
            "type": "string"
          }
        },
        "required": [
          "error",
          "code"
        ],
        "additionalProperties": false,
        "description": "Every non-2xx answer of POST /v1/tools/{name}. `code` is a fixed route code or the tool’s own MCP error code (open set); branch on it."
      },
