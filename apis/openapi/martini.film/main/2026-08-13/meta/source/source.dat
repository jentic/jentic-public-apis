    "/v1/generations/{id}": {
      "get": {
        "operationId": "getGeneration",
        "tags": [
          "Generations"
        ],
        "summary": "Generation status and output",
        "description": "The generation. `output` is present once `status` is `completed`; `error` once it is `failed` or `cancelled`. A `draft` never settles until POST /v1/generations/{id}/generate starts it.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The generation id from POST /v1/generations.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The generation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Generation"
                }
              }
            }
          },
          "400": {
            "description": "Error. `code` is one of: `UNSUPPORTED_API_VERSION`.",
            "x-martini-error-codes": [
              "UNSUPPORTED_API_VERSION"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Error. `code` is one of: `API_KEY_EXPIRED`, `API_KEY_REVOKED`, `INVALID_API_KEY`.",
            "x-martini-error-codes": [
              "API_KEY_EXPIRED",
              "API_KEY_REVOKED",
              "INVALID_API_KEY"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error. `code` is one of: `API_KEY_DEFAULTS_MISSING`, `ORGANIZATION_REQUIRED`, `RUN_KEY_NOT_ALLOWED`.",
            "x-martini-error-codes": [
              "API_KEY_DEFAULTS_MISSING",
              "ORGANIZATION_REQUIRED",
              "RUN_KEY_NOT_ALLOWED"
            ],
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error. `code` is one of: `REQUEST_NOT_FOUND`.",
            "x-martini-error-codes": [
              "REQUEST_NOT_FOUND"
