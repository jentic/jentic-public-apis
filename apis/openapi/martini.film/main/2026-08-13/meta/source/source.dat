    "/v1/runs/{runId}/status": {
      "get": {
        "operationId": "getRunStatus",
        "tags": [
          "Workflows"
        ],
        "summary": "Compact run status",
        "description": "Durable activity, executor model, per-unit model steps, output counts and budget. Excludes definitions, input payloads, individual takes and diagnostic traces. Progress is the last observed work; lifecycle status is authoritative when paused or terminal. Planned outputs are not a required-shot ledger. `?wait=` holds the call until the run changes, as on GET /v1/runs/{runId}.",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "description": "The run id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "wait",
            "in": "query",
            "required": false,
            "description": "Long-poll: hold the call up to this many seconds (0–45) until the run changes — its status, its current step, its phase line, its progress, or its outputs — or settles (completed, failed, needs_revision, cancelled), then answer. A settled run answers at once, and so does every call when the server is holding too many polls; when nothing changed in time the answer is the run as it stands. Replaces sleeping between polls: call again with the same `wait` until `status` is terminal. Any other value answers 400 INVALID_REQUEST.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 45,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Compact run status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowRunStatus"
                }
              }
            }
          },
          "400": {
            "description": "Error. `code` is one of: `INVALID_REQUEST`, `UNSUPPORTED_API_VERSION`.",
            "x-martini-error-codes": [
              "INVALID_REQUEST",
              "UNSUPPORTED_API_VERSION"
            ],
            "content": {
