      "CreateWorkflow": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The saved workflow to place."
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The project to place it in; the key must be able to edit it."
          },
          "canvasId": {
            "description": "Target canvas; omitted → a new canvas named after the workflow.",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "description": "Name for the placed copy.",
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "from",
          "projectId"
        ],
        "additionalProperties": false
      },
      "CreateRun": {
        "type": "object",
        "properties": {
          "compile": {
            "description": "Fable only: build and dry-test scripts without generating media. Pass oliveBudget: 0. Run the compiled placed workflow afterwards, or save it as a new version for future saved-workflow runs.",
            "type": "boolean"
          },
          "oliveBudget": {
            "description": "Cap on what this run may spend, in olives. An explicit engine: \"fable\" request defaults to 1,000 olives when omitted and returns DEFAULT_OLIVE_BUDGET_APPLIED in warnings.",
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "idempotencyKey": {
            "description": "Re-posting the same key with the same body returns the run the first call created.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "description": "For a saved workflow, names its new run canvas (default: '<workflow name> · <UTC date time>'), so parallel runs are told apart; the run keeps the workflow's name. For a placed workflow, names the run.",
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "variables": {
            "description": "Values for the variables the workflow's Actions read, keyed by variable name (case-insensitive) or id.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "inputs": {
            "description": "JSON file inputs keyed by their stable input key. Use { json: value } or { fileId: id }.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "json": {},
