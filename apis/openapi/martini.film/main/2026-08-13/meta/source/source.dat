    "/v1/workflows/{workflowId}/runs": {
      "post": {
        "operationId": "createRun",
        "tags": [
          "Workflows"
        ],
        "summary": "Start a run",
        "description": "Run a saved workflow using its saved definition and presets on a fresh canvas, or a placed workflow in place using its canvas state. Omitted bins keep their defaults; explicit `bins` replace them. Only saved bins marked `required` need caller input. `projectId` selects the destination only; omit it to use Workflow runs. Do not choose a placed copy to recover a saved workflow’s presets. Pin variable values by name or the selected workflow’s own input ids. A bin entry may also be a public https:// URL, a data: URI, or `{ url, filename }`: Martini imports those files before the run starts and answers 400 `WORKFLOW_INPUT_FETCH_FAILED` (naming the bin and URL) without starting the run when one cannot be fetched or processed. Answers 201 with the run; poll GET /v1/runs/{runId}, and fetch GET /v1/runs/{runId}/results for the outputs settled so far or once it settles. Runs started here auto-approve.",
        "parameters": [
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "description": "A saved or placed workflow id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Per-run inputs and options. An empty object is valid for a placed workflow.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRun"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The run, `pending`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkflowRun"
                }
              }
            }
          },
          "400": {
            "description": "Error. `code` is one of: `INVALID_FILE_INPUT`, `INVALID_REQUEST`, `UNSUPPORTED_API_VERSION`, `WORKFLOW_ASSET_NOT_FOUND`, `WORKFLOW_BIN_NOT_FOUND`, `WORKFLOW_BIN_REQUIRED`, `WORKFLOW_INPUT_FETCH_FAILED`, `WORKFLOW_VARIABLE_NOT_FOUND`.",
