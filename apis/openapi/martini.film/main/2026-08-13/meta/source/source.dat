    "/v1/runs/{runId}/resume": {
      "post": {
        "operationId": "resumeRun",
        "tags": [
          "Workflows"
        ],
        "summary": "Resume a failed run",
        "description": "Retry the failed Action of a `failed` run with the same inputs; finished Actions and finished units keep their outputs, and the olives already spent are not charged again. A run that failed because an Action needs revision fails the same way when resumed unchanged: change the inputs and start a new run instead. Answers 200 with the run, `pending` again; poll GET /v1/runs/{runId}.",
        "parameters": [
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "description": "The run id.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
