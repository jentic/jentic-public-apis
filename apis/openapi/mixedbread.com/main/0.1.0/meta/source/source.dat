            "type": "array",
            "maxItems": 1,
            "minItems": 1,
            "title": "Items",
            "description": "Enhanced query item"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "QueryEnhanceResults",
        "description": "Enhanced query response."
      },
      "QueryEnhanceSortItem": {
        "properties": {
