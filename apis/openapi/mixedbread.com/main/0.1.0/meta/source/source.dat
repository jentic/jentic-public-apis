          "input_schema"
        ],
        "title": "McpListToolsTool",
        "description": "One tool an MCP server listed."
      },
      "McpTool": {
        "properties": {
          "type": {
            "type": "string",
            "const": "mcp",
            "title": "Type",
            "default": "mcp"
          },
          "server_label": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "title": "Server Label",
            "description": "Label identifying this server in tool calls"
          },
          "server_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Server Url",
            "description": "URL of the server's Streamable HTTP endpoint"
          },
          "connector_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Connector Id",
            "description": "OpenAI service connectors are not supported"
          },
          "server_description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Server Description",
            "description": "Shown to the model beside the server's tools"
          },
          "headers": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Headers",
            "description": "HTTP headers sent to the server"
          },
          "authorization": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authorization",
            "description": "OAuth access token sent as a bearer token"
          },
          "require_approval": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "always",
                  "never"
                ]
              },
              {
                "$ref": "#/components/schemas/McpApprovalFilter"
              }
            ],
            "title": "Require Approval",
            "description": "Which tools need the caller's approval before running; defaults to all of them",
            "default": "always"
          },
          "allowed_tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "$ref": "#/components/schemas/McpToolFilter"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allowed Tools",
            "description": "Tool names or a filter restricting the offer"
          }
        },
        "type": "object",
        "required": [
          "server_label"
        ],
        "title": "McpTool",
        "description": "Hosted tool: the tools of a remote MCP server, executed server-side.\n\nFollows the OpenAI Responses API `mcp` tool: the server's tools are listed\nwhen the request starts and offered to the model; a call runs against the\nserver unless it needs the caller's approval first, in which case the turn\nends with an approval request the caller answers on the next request.\n\n`headers` and `authorization` are credentials: they are never stored nor\nechoed back, so a continuation must declare the server again."
      },
      "McpToolFilter": {
        "properties": {
          "tool_names": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Names",
            "description": "Tool names the filter matches"
          },
          "read_only": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Read Only",
            "description": "Match tools whose `readOnlyHint` annotation equals this value"
          }
        },
        "type": "object",
        "title": "McpToolFilter",
        "description": "Selects tools of an MCP server by name and/or by their read-only annotation.\n\nShared by `allowed_tools` and the `require_approval` filters, as in the\nOpenAI Responses API."
      },
      "MessageToolCall": {
        "properties": {
          "id": {
            "type": "string",
