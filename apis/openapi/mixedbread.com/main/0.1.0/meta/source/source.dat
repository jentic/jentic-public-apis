          "auth_credentials_invalid_error",
          "auth_credentials_expired_error",
          "permission_user_required_error",
          "permission_admin_required_error",
          "permission_read_required_error",
          "permission_write_required_error",
          "permission_delete_required_error",
          "permission_list_required_error",
          "permission_create_required_error",
          "permission_search_required_error",
          "organization_not_found_error",
          "api_key_not_found_error",
          "api_key_invalid_error",
          "api_key_expired_error",
          "jwt_invalid_error",
          "file_not_found_error",
          "file_invalid_error",
          "store_not_found_error",
          "store_already_exists_error",
          "store_expired_error",
          "store_filter_invalid_error",
          "store_chunk_invalid_error",
          "store_chunk_not_found_error",
          "store_name_already_exists_error",
          "store_conflicting_search_rules_error",
          "store_search_rule_not_found_error",
          "store_unsupported_search_option_error",
          "store_incompatible_error",
          "store_public_disabled_error",
          "store_lsf_not_enabled_error",
          "store_in_use_by_data_source_error",
          "store_file_not_found_error",
          "store_file_already_exists_error",
          "store_file_invalid_chunk_indices_error",
          "store_file_bucket_mismatch_error",
          "bucket_not_found_error",
          "bucket_validation_failed_error",
          "bucket_in_use_error",
          "bucket_invalid_error",
          "bucket_already_exists_error",
          "bucket_propagation_failed_error",
          "bucket_feature_not_enabled_error",
          "trace_destination_not_found_error",
          "trace_destination_invalid_error",
          "trace_destination_unreachable_error",
          "trace_destination_already_exists_error",
          "parsing_job_not_found_error",
          "parsing_job_not_in_progress_error",
          "extraction_job_not_found_error",
          "extraction_job_not_in_progress_error",
          "model_not_found_error",
          "model_input_invalid_error",
          "data_source_feature_not_enabled_error",
          "data_source_not_found_error",
          "data_source_unsupported_error",
          "data_source_auth_type_not_supported_error",
          "data_source_type_can_not_be_changed_error",
          "data_source_connector_not_found_error",
          "invalid_state_error",
          "oauth2_token_exchange_failed_error",
          "data_source_connector_synced_file_not_found_error",
          "multipart_upload_not_available_error",
          "multipart_upload_not_found_error",
          "multipart_upload_part_too_small_error",
          "multipart_upload_missing_parts_error",
          "file_processing_error",
          "file_corrupted_error",
          "file_too_large_error",
          "file_empty_error",
          "file_password_protected_error"
        ],
        "title": "ErrorCode",
        "description": "Error codes for API responses.\n\nThese codes provide fine-grained error information to API users beyond HTTP status codes.\nOnly add error codes for situations where users need to know specific details about what went wrong.\nFor internal error handling that doesn't need to be exposed to users, use error types without codes.\n\nNaming convention:\n- Enum names use format: RESOURCE_STATE or RESOURCE_ACTION_RESULT (e.g., FILE_NOT_FOUND, AUTH_CREDENTIALS_EXPIRED)\n- String values use snake_case format: \"resource_specific_reason_error\" (e.g., \"file_not_found_error\")\n\nTODO @rui: Register these codes in the OpenAPI specification for each endpoint\nto provide better documentation and client-side error handling capabilities."
      },
