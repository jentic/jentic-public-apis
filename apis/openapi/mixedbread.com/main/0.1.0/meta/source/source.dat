        "deprecated": true
      },
      "StoreGrepEvent": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "description": "Unique identifier for the event"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Timestamp when the event was created"
          },
          "type": {
            "type": "string",
            "const": "grep",
            "title": "Type",
            "default": "grep"
          },
          "store_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "title": "Store Ids",
            "description": "IDs of the vector stores grepped"
          },
          "pattern": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pattern",
