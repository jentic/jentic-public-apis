        "type": "object",
        "required": [
          "id",
          "created_at",
          "store_ids"
        ],
        "title": "StoreGrepEvent",
        "description": "Represents a grep event in a vector store.\n\nGrep matches chunks against a regular expression rather than running a\nsemantic search, so it has no ranking, rewrite, or rerank fields."
      },
      "StoreGrepResponse": {
        "properties": {
