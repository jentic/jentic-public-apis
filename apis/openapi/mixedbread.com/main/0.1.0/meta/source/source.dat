          },
          "case_sensitive": {
            "type": "boolean",
            "title": "Case Sensitive",
            "description": "Whether the pattern was matched case-sensitively",
            "default": false
          },
          "search_time": {
            "type": "string",
            "format": "duration",
            "title": "Search Time",
            "description": "Time taken to grep the vector store",
            "default": "PT0S"
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SearchFilter-Output"
              },
              {
                "$ref": "#/components/schemas/SearchFilterCondition"
              },
              {
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/SearchFilter-Output"
                    },
                    {
                      "$ref": "#/components/schemas/SearchFilterCondition"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filters",
            "description": "Metadata filters submitted with the grep request"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/StoreSearchEventResult"
            },
            "type": "array",
            "title": "Results",
