                      "tool": "#/components/schemas/ToolMessage",
                      "user": "#/components/schemas/UserMessage"
                    }
                  }
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript",
            "description": "Complete stored conversation transcript when requested through include"
          }
        },
