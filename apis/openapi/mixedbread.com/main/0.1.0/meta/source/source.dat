          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At",
            "description": "When the client was last rotated"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "client_id",
          "redirect_uri"
        ],
        "title": "OAuthClientView",
        "description": "An organization's registered OAuth client as exposed to the dashboard.\n\nSecrets are never part of this shape: once stored they are only ever decrypted inside a token\nexchange or a webhook signature check. A client id is public by construction (it appears in the\nconsent URL), so it is returned in full to let the customer confirm which app is wired up."
      },
