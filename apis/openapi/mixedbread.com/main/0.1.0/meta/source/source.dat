            "type": "string",
            "enum": [
              "auto",
              "disabled"
            ],
            "title": "Truncation",
            "default": "disabled"
          },
          "reasoning": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResponseReasoningConfig"
              },
              {
                "type": "null"
              }
            ]
          },
          "service_tier": {
            "anyOf": [
              {
                "type": "string",
