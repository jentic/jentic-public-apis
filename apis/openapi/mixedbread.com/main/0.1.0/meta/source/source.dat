              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "McpApprovalFilter",
        "description": "Which of an MCP server's tools need the caller's approval before they run."
      },
      "McpListToolsTool": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "input_schema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Input Schema"
          },
          "annotations": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Annotations"
          }
        },
        "type": "object",
        "required": [
