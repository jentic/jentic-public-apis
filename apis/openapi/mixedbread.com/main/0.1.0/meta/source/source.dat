            "type": "string",
            "title": "Display Name",
            "description": "Human-readable provider name"
          },
          "auth_type": {
            "type": "string",
            "enum": [
              "oauth2",
              "bot_token",
              "user_token",
              "api_key"
            ],
            "title": "Auth Type",
            "description": "Primary authorization method"
          },
          "capabilities": {
            "items": {
              "type": "string",
              "enum": [
                "ingest_to_store",
                "notify",
                "external_action"
              ]
