              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "InspectMetadataCallItem",
        "description": "Record of one server-side metadata facets lookup."
      },
      "InspectMetadataTool": {
        "properties": {
          "store_identifiers": {
            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "string",
                      "format": "uuid"
                    }
                  ]
                },
                "type": "array",
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Store Identifiers",
            "description": "IDs or names of the stores the tool runs against; omit to let the model pick a store per call (requires the list_stores tool)"
          },
          "type": {
            "type": "string",
            "const": "inspect_metadata",
            "title": "Type",
            "default": "inspect_metadata"
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SearchFilter-Input"
              },
              {
                "$ref": "#/components/schemas/SearchFilterCondition"
              },
              {
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/SearchFilter-Input"
                    },
                    {
                      "$ref": "#/components/schemas/SearchFilterCondition"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filters",
            "description": "Optional filter conditions restricting the files the facets are computed over"
          }
        },
        "type": "object",
        "title": "InspectMetadataTool",
        "description": "Hosted tool: metadata field/value overview of the caller's stores, executed server-side.\n\nFacets tell the model which metadata keys exist and what their values look\nlike, so it can filter (`grep`, `filter_chunks`) and phrase queries\nagainst real values instead of guessing."
      },
