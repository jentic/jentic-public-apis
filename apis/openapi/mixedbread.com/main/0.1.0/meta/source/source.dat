        "parameters": [
          {
            "name": "api_key_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "The ID of the API key to delete",
              "title": "Api Key Id"
            },
            "description": "The ID of the API key to delete"
          }
        ],
        "responses": {
          "200": {
            "description": "The details of the deleted API key",
            "content": {
              "application/json": {
