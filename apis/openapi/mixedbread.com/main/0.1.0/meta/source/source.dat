      "OAuth2CreateOrUpdateParams": {
        "properties": {
          "type": {
            "type": "string",
            "const": "oauth2",
            "title": "Type",
            "default": "oauth2"
          }
        },
        "type": "object",
        "title": "OAuth2CreateOrUpdateParams",
        "description": "Base class for OAuth2 create or update parameters."
      },
      "OAuthClientBody": {
        "properties": {
          "client_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Client Id",
            "description": "The OAuth client ID from the customer's Google Cloud project or Slack app"
          },
          "client_secret": {
            "type": "string",
            "format": "password",
            "title": "Client Secret",
            "description": "The OAuth client secret. Write-only: it is encrypted at rest and never returned.",
            "writeOnly": true
          },
          "signing_secret": {
            "anyOf": [
              {
                "type": "string",
                "format": "password",
                "writeOnly": true
              },
              {
                "type": "null"
              }
            ],
            "title": "Signing Secret",
            "description": "The app's signing secret, used to verify the webhooks it sends. Required for Slack; not accepted for Google connectors. Write-only."
          },
          "return_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ],
            "title": "Return Url",
            "description": "Required. Where the connector's OAuth callback returns the user after consent. Must be an absolute https URL (http is allowed for localhost). The outcome is appended as query parameters: provider, status, and installation_id or error."
          }
        },
        "type": "object",
        "required": [
          "client_id",
          "client_secret"
        ],
        "title": "OAuthClientBody",
        "description": "Request body for registering or rotating an organization's own OAuth client.\n\nThe secrets are :class:`SecretStr` so they are masked in reprs and in the input echo that\npydantic attaches to validation errors; they are only ever read back inside a token exchange or\na webhook signature check. Only the credentials are accepted -- the authorization and token\nendpoints stay pinned to Google's and Slack's own URLs, so a registered client can never redirect\na token exchange elsewhere."
      },
      "OAuthClientConnection": {
        "properties": {
          "installation_id": {
            "type": "string",
            "title": "Installation Id",
            "description": "Installation ID"
          },
          "provider": {
            "type": "string",
            "enum": [
              "google_drive",
              "gmail",
              "slack"
            ],
            "title": "Provider",
            "description": "The connector the account is connected to"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Installation status"
          },
          "account": {
            "$ref": "#/components/schemas/ConnectorAccount",
            "description": "The authorized third-party account"
          },
          "store_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Store Id",
            "description": "Store the installation ingests into"
          },
          "store_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Store Name",
            "description": "Name of that store"
          },
          "sync": {
            "$ref": "#/components/schemas/ConnectorInstallationSync",
            "description": "Account-level sync facts recorded by the sync jobs"
          },
          "installed_by_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Installed By User Id",
            "description": "The dashboard user who authorized the connection, or null when an API key did"
          },
