              },
              {
                "$ref": "#/components/schemas/ToolChoiceStoreGrep"
              },
              {
                "$ref": "#/components/schemas/ToolChoiceStoreListChunks"
              },
              {
                "$ref": "#/components/schemas/ToolChoiceMetadataFacets"
              },
              {
                "$ref": "#/components/schemas/ToolChoiceListStores"
              }
            ],
            "title": "Tool Choice",
            "default": "auto"
          },
