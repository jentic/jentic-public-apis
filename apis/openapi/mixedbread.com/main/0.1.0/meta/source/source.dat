            "type": "number",
            "title": "Score",
            "description": "The score of the document.",
            "examples": [
              0.95
            ]
          },
          "input": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Input",
            "description": "The input document.",
            "examples": [
              {
                "field1": "value1",
                "field2": "value2"
              },
              "Hello, world!"
            ]
          },
          "object": {
            "type": "string",
            "const": "rank_result",
            "title": "Object",
