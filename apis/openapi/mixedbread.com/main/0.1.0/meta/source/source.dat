            "description": "Maximum number of store files scanned to compute facets.",
            "default": 10000
          }
        },
        "type": "object",
        "required": [
          "store_identifiers"
        ],
        "title": "MetadataFacetsParams",
        "description": "Parameters for getting metadata facets."
      },
