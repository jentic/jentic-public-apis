                      "text": "#/components/schemas/TextInputChunk",
                      "video_url": "#/components/schemas/VideoUrlInputChunk"
                    }
                  }
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chunks",
            "description": "chunks"
          },
          "content_url": {
            "type": "string",
            "title": "Content Url",
            "description": "Presigned URL for file content"
          }
        },
        "type": "object",
        "required": [
          "id",
          "store_id",
          "created_at",
          "content_url"
        ],
        "title": "StoreFile",
        "description": "Represents a file stored in a store."
      },
