          "tools": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/SearchCorpusTool"
                },
                {
                  "$ref": "#/components/schemas/GrepTool"
                },
                {
                  "$ref": "#/components/schemas/FilterChunksTool"
                },
                {
                  "$ref": "#/components/schemas/InspectMetadataTool"
