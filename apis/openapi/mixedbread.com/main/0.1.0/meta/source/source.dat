            "title": "Capabilities",
            "description": "Supported integration capabilities"
          },
          "required_scopes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Required Scopes",
            "description": "Provider scopes required for the initial install"
          },
          "ingestion_backing": {
            "anyOf": [
              {
                "type": "string",
