        ],
        "summary": "List events",
        "description": "List the organization's events of one type across all stores.\n\nCovers store activity (`search`, `agentic_search`, `grep`, `ingestion`) and\nchat completions (`completion`, one event per Chat Completions or Responses\nturn). Without `store_identifier` the listing spans every store and also\nreturns events tied to none, such as completions that never called a\nstore tool.",
        "operationId": "list_events",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
