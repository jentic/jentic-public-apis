          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id",
            "description": "Containing resource ID, for hierarchical providers"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url",
            "description": "Link to the resource on the provider, when available"
          },
          "message_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message Count",
            "description": "Approximate number of messages in the resource, when known"
          },
          "member_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
