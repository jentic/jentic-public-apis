          },
          "gross_usage_cost": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Gross Usage Cost",
            "description": "The gross usage cost"
          },
          "balance_applied": {
            "type": "string",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Balance Applied",
            "description": "The balance applied"
          }
        },
        "type": "object",
        "required": [
          "period",
          "net_usage_cost",
          "gross_usage_cost",
          "balance_applied"
        ],
        "title": "PhaseCostInfo",
