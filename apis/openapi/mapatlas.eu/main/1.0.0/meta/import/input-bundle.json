                "lon": {
                  "type": "number"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "break",
                    "via"
                  ]
                }
              }
            }
          },
          "costing": {
            "type": "string",
            "enum": [
              "auto",
              "pedestrian",
              "bicycle",
              "bus",
              "motor_scooter"
