                  "$ref": "#/components/schemas/DirectionsResponse/properties/trip"
                }
              }
            }
          },
          "units": {
            "type": "string"
          }
        }
      },
      "MapMatchRequest": {
        "type": "object",
        "required": [
          "shape",
          "costing"
        ],
        "properties": {
          "shape": {
            "type": "array",
