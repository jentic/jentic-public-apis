# Open AllDebrid: an OpenAPI description of the AllDebrid API.
# SPDX-License-Identifier: MIT
#
# The shapes below follow what the live API returns, not only what the
# official documentation says. Every place where they differ is listed in
# ERRATA.md.

openapi: 3.1.0

info:
  title: AllDebrid API
  version: 4.1.0
  summary: Unlock hoster links, manage magnets and torrents, and read account data.
  description: |
    An OpenAPI 3.1 description of the [AllDebrid](https://alldebrid.com) API v4 / v4.1,
    maintained by the [open-alldebrid](https://github.com/pierre-emmanuelJ/open-alldebrid)
    project and checked against the live API.

    ## Versions

    Most endpoints live under `/v4/`. Three endpoints were bumped to `/v4.1/`
    (`/pin/get`, `/user/hosts` and `/magnet/status`); their `/v4/` versions are
    deprecated or discontinued and are not described here.

    ## Authentication

    Authenticated endpoints need an API key, sent as `Authorization: Bearer <apikey>`.
    Users create keys in their [API key dashboard](https://alldebrid.com/apikeys/),
    or an application obtains one with the PIN flow:

    1. `GET /v4.1/pin/get` returns a `pin` and a `check` token.
    2. Show the `pin` (or `user_url`) to the user, who confirms it on alldebrid.com.
    3. Poll `POST /v4/pin/check` every 5 seconds until `activated` is `true`
       and an `apikey` is returned. The PIN expires after 600 seconds.

    When a key is used from a new location, the API may answer `AUTH_BLOCKED`
    with a verification `token` in the error object. Poll `POST /v4/user/verif`
    with that token until the user approves the login from the email they received.

    ## Response envelope

    Every response is a JSON object with a `status` of `success` or `error`.
    On success the payload is in `data`; on failure `error` holds a `code`
    and a `message`. **Errors are returned with HTTP 200**: only unknown endpoints
    answer 404, and rate limiting answers 429 or 503. Always check `status`.

    Deprecated endpoints add `"deprecated": true`; responses produced with a
    demo key add `"demo": true`.

    ## Demo keys

    These public keys return static sample data and never touch a real account:

    | Key                    | Account      |
    |------------------------|--------------|
    | `staticDemoApikeyPrem` | Premium user |
    | `staticDemoApikeyTria` | Trial user   |
    | `staticDemoApikeyFree` | Free user    |

    ## Rate limits

    12 requests per second and 600 requests per minute per key. Cache the
    `/v4/hosts*` endpoints for a few hours.

    ## Request encoding

    POST endpoints take `application/x-www-form-urlencoded` bodies (or
    `multipart/form-data`). List parameters use PHP-style names: send
    `magnets[]=a&magnets[]=b`.
  contact:
    name: open-alldebrid
    url: https://github.com/pierre-emmanuelJ/open-alldebrid
  license:
    name: MIT
    identifier: MIT

externalDocs:
  description: Official AllDebrid API documentation
  url: https://docs.alldebrid.com/

servers:
  - url: https://api.alldebrid.com
    description: Production

security:
  - bearerAuth: []

tags:
  - name: General
    description: Service health.
  - name: Pin
    description: Obtain an API key from the user with a PIN code, without asking for their password.
  - name: Hosts
    description: Public lists of supported file hosters, streaming sites and link redirectors.
  - name: User
    description: Account information, per-user host limits, login verification and notifications.
  - name: Links
    description: Unlock hoster and streaming links into direct download links.
  - name: Magnets
    description: Upload magnets and torrent files, follow their progress and get their files.
  - name: Saved links
    description: Links saved by the user, and the recent links history.
  - name: Reseller
    description: Voucher management, reserved to accredited AllDebrid resellers.

paths:
  /v4/ping:
    get:
      tags: [General]
      operationId: ping
      summary: Check that the API is up
      security: []
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The API answered.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PingResponse"
              example:
                status: success
                data: { ping: pong, version: "4" }

  /v4.1/pin/get:
    get:
      tags: [Pin]
      operationId: getPin
      summary: Start a PIN authentication
      description: |
        Returns a PIN code to show to the user and a `check` token for
        `/v4/pin/check`. The PIN is valid for `expires_in` seconds (600).
      security: []
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: A new PIN.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PinGetResponse"
              example:
                status: success
                data:
                  pin: ABCD
                  check: 664c3ca2635c99f291d28e11ea18e154750bd21a
                  expires_in: 600
                  user_url: https://alldebrid.com/pin/?pin=ABCD
                  base_url: https://alldebrid.com/pin/

  /v4/pin/check:
    post:
      tags: [Pin]
      operationId: checkPin
      summary: Poll a PIN authentication
      description: |
        Poll every 5 seconds until `activated` is `true`; the API key is then in `apikey`.

        Errors: `PIN_EXPIRED`, `PIN_INVALID`.
      security: []
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/PinCheckRequest"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The PIN status.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/PinCheckResponse"
              examples:
                waiting:
                  summary: The user has not entered the PIN yet
                  value:
                    status: success
                    data: { activated: false, expires_in: 581 }
                activated:
                  summary: The user confirmed the PIN
                  value:
                    status: success
                    data: { activated: true, expires_in: 570, apikey: abcdefABCDEF12345678 }
                expired:
                  summary: The PIN has expired
                  value:
                    status: error
                    error: { code: PIN_EXPIRED, message: The pin is expired }

  /v4/hosts:
    get:
      tags: [Hosts]
      operationId: getHosts
      summary: List supported hosts, streaming sites and redirectors
      description: |
        Static data about every service AllDebrid supports. For the hosts the
        current user can use, with their quotas, call `/v4.1/user/hosts`.
        Cache the result for a few hours.
      security:
        - {}
        - bearerAuth: []
      parameters:
        - $ref: "#/components/parameters/HostsOnly"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: Supported services, keyed by service name.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/HostsResponse"
              examples:
                example:
                  summary: "Example"
                  value: {"status": "success", "data": {"hosts": {"1fichier": {"name": "1fichier", "type": "premium", "domains": ["1fichier.com", "megadl.fr", "alterupload.com", "cjoint.net", "desfichiers.com", "dfichiers.com", "mesfichiers.org", "piecejointe.net", "pjointe.com", "tenvoi.com", "dl4free.com"], "regexps": ["((1fichier\\.com|megadl\\.fr|alterupload\\.com|cjoint\\.net|desfichiers\\.com|dfichiers\\.com|mesfichiers\\.org|piecejointe\\.net|pjointe\\.com|tenvoi\\.com|dl4free\\.com)/\\?[a-zA-Z0-9]{5,30}(&pw=[^&]+)?)"], "regexp": "((1fichier\\.com|megadl\\.fr|alterupload\\.com|cjoint\\.net|desfichiers\\.com|dfichiers\\.com|mesfichiers\\.org|piecejointe\\.net|pjointe\\.com|tenvoi\\.com|dl4free\\.com)/\\?[a-zA-Z0-9]{5,30}(&pw=[^&]+)?)", "status": true}, "rapidgator": {"name": "rapidgator", "type": "premium", "domains": ["rapidgator.net", "rg.to", "rapidgator.asia"], "regexps": ["(rapidgator\\.net|rg\\.to|rapidgator\\.asia)/file/([0-9a-zA-Z]{32})", "(rapidgator\\.net/file/[0-9]{7,8})"], "regexp": "((rapidgator\\.net|rg\\.to|rapidgator\\.asia)/file/([0-9a-zA-Z]{32}))|((rapidgator\\.net/file/[0-9]{7,8}))", "status": true}}, "streams": {"dailymotion": {"name": "dailymotion", "type": "free", "domains": ["dailymotion.com", "geo.dailymotion.com", "lequipe.fr", "dai.ly"], "regexps": ["(?ix)\n                    (?:https?:)?//\n                    (?:\n                        dai\\.ly/|\n                        (?:\n                            (?:(?:www|touch|geo)\\.)?dailymotion\\.[a-z]{2,3}|\n                            (?:www\\.)?lequipe\\.fr\n                        )/\n                        (?:\n                            swf/(?!video)|\n                            (?:(?:crawler|embed|swf)/)?video/|\n                            player(?:/[\\da-z]+)?\\.html\\?(?:video|(playlist))=\n                        )\n                    )\n                    ([^/?_&#]+)(?:[\\w-]*\\?playlist=(x[0-9a-z]+))?\n    ", "(?:https?://)?(?:www\\.)?dailymotion\\.[a-z]{2,3}/playlist/(x[0-9a-z]+)", "https?://(?:www\\.)?dailymotion\\.[a-z]{2,3}/search/([^/?#]+)/videos", "https?://(?:www\\.)?dailymotion\\.[a-z]{2,3}/(?!(?:embed|swf|#|video|playlist|search|crawler)/)(?:(?:old/)?user/)?([^/?#]+)"], "regexp": "((?ix)\n                    (?:https?:)?//\n                    (?:\n                        dai\\.ly/|\n                        (?:\n                            (?:(?:www|touch|geo)\\.)?dailymotion\\.[a-z]{2,3}|\n                            (?:www\\.)?lequipe\\.fr\n                        )/\n                        (?:\n                            swf/(?!video)|\n                            (?:(?:crawler|embed|swf)/)?video/|\n                            player(?:/[\\da-z]+)?\\.html\\?(?:video|(playlist))=\n                        )\n                    )\n                    ([^/?_&#]+)(?:[\\w-]*\\?playlist=(x[0-9a-z]+))?\n    )|((?:https?://)?(?:www\\.)?dailymotion\\.[a-z]{2,3}/playlist/(x[0-9a-z]+))|(https?://(?:www\\.)?dailymotion\\.[a-z]{2,3}/search/([^/?#]+)/videos)|(https?://(?:www\\.)?dailymotion\\.[a-z]{2,3}/(?!(?:embed|swf|#|video|playlist|search|crawler)/)(?:(?:old/)?user/)?([^/?#]+))"}, "twitch": {"name": "twitch", "type": "free", "domains": ["clips.twitch.tv", "twitch.tv", "m.twitch.tv", "go.twitch.tv", "player.twitch.tv"], "regexps": ["https?://(?:clips\\.twitch\\.tv/(?:embed\\?.*?\\bclip=|(?:[^/]+/)*)|(?:(?:www|go|m)\\.)?twitch\\.tv/(?:[^/]+/)?clip/)([^/?#&]+)", "https?://(?:(?:www|go|m)\\.)?twitch\\.tv/collections/([^/]+)", "https?://(?:(?:(?:www|go|m)\\.)?twitch\\.tv/|player\\.twitch\\.tv/\\?.*?\\bchannel=)([^/#?]+)", "https?://(?:(?:www|go|m)\\.)?twitch\\.tv/([^/]+)/(?:clips|videos/*?\\?.*?\\bfilter=clips)", "https?://(?:(?:www|go|m)\\.)?twitch\\.tv/([^/]+)/videos/*?\\?.*?\\bfilter=collections", "https?://(?:(?:www|go|m)\\.)?twitch\\.tv/([^/]+)/(?:videos|profile)", "https?://(?:(?:(?:www|go|m)\\.)?twitch\\.tv/(?:[^/]+/v(?:ideo)?|videos)/|player\\.twitch\\.tv/\\?.*?\\bvideo=v?|www\\.twitch\\.tv/[^/]+/schedule\\?vodID=)(\\d+)"], "regexp": "(https?://(?:clips\\.twitch\\.tv/(?:embed\\?.*?\\bclip=|(?:[^/]+/)*)|(?:(?:www|go|m)\\.)?twitch\\.tv/(?:[^/]+/)?clip/)([^/?#&]+))|(https?://(?:(?:www|go|m)\\.)?twitch\\.tv/collections/([^/]+))|(https?://(?:(?:(?:www|go|m)\\.)?twitch\\.tv/|player\\.twitch\\.tv/\\?.*?\\bchannel=)([^/#?]+))|(https?://(?:(?:www|go|m)\\.)?twitch\\.tv/([^/]+)/(?:clips|videos/*?\\?.*?\\bfilter=clips))|(https?://(?:(?:www|go|m)\\.)?twitch\\.tv/([^/]+)/videos/*?\\?.*?\\bfilter=collections)|(https?://(?:(?:www|go|m)\\.)?twitch\\.tv/([^/]+)/(?:videos|profile))|(https?://(?:(?:(?:www|go|m)\\.)?twitch\\.tv/(?:[^/]+/v(?:ideo)?|videos)/|player\\.twitch\\.tv/\\?.*?\\bvideo=v?|www\\.twitch\\.tv/[^/]+/schedule\\?vodID=)(\\d+))"}}, "redirectors": {"1fichier": {"name": "1fichier", "type": "premium", "domains": ["1fichier.com"], "regexps": ["(1fichier.com/dir/[a-zA-Z0-9]+)"], "heavy": false, "regexp": "(1fichier.com/dir/[a-zA-Z0-9]+)"}, "adfly": {"name": "adfly", "type": "premium", "domains": ["adf.ly"], "regexps": ["(adf\\.ly/[0-9]+/(https?://[^ \"'<>]+))", "(adf\\.ly/[0-9a-zA-Z]+)"], "heavy": false, "regexp": "((adf\\.ly/[0-9]+/(https?://[^ \"'<>]+)))|((adf\\.ly/[0-9a-zA-Z]+))"}}}}

  /v4/hosts/domains:
    get:
      tags: [Hosts]
      operationId: getHostDomains
      summary: List supported domains
      description: |
        Every domain (including alternative domains) of the supported hosts,
        streaming sites and redirectors. Use the `regexps` of `/v4/hosts` to
        validate a link.
      security:
        - {}
        - bearerAuth: []
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: Supported domains.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/HostDomainsResponse"
              examples:
                example:
                  summary: "Example"
                  value: {"status": "success", "data": {"hosts": ["1fichier.com", "megadl.fr", "alterupload.com", "cjoint.net"], "streams": ["dailymotion.com", "geo.dailymotion.com", "lequipe.fr", "dai.ly"], "redirectors": ["1fichier.com", "adf.ly", "pan.baidu.com", "big.to"]}}

  /v4/hosts/priority:
    get:
      tags: [Hosts]
      operationId: getHostPriority
      summary: Rank hosts from most open to most restricted
      security:
        - {}
        - bearerAuth: []
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: Host names mapped to their rank (1 is the most open).
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/HostPriorityResponse"
              examples:
                example:
                  summary: "Example"
                  value: {"status": "success", "data": {"hosts": {"1fichier": 3, "4shared": 4}}}

  /v4/user:
    get:
      tags: [User]
      operationId: getUser
      summary: Get the account information
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The current user.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UserResponse"
              example:
                status: success
                data:
                  user:
                    username: demoUserPremium
                    email: demo@example.com
                    isPremium: true
                    isSubscribed: false
                    isTrial: false
                    premiumUntil: 1792453902
                    lang: en
                    preferedDomain: com
                    fidelityPoints: 130
                    limitedHostersQuotas: { ddl: 2000, filefactory: 3000 }
                    notifications: []

  /v4.1/user/hosts:
    get:
      tags: [User]
      operationId: getUserHosts
      summary: List the hosts available to this user
      description: |
        The hosts the user can use right now, depending on their subscription
        (free, trial or premium), with live quotas. Quotas reset every day for
        premium users. Streaming sites and redirectors are only in `/v4/hosts`.
      parameters:
        - $ref: "#/components/parameters/HostsOnly"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: Available hosts, keyed by host name.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UserHostsResponse"
              examples:
                test_it:
                  summary: "Test it"
                  value: {"status": "success", "data": {"hosts": {"1fichier": {"name": "1fichier", "type": "premium", "domains": ["1fichier.com", "megadl.fr", "alterupload.com", "cjoint.net", "desfichiers.com", "dfichiers.com", "mesfichiers.org", "piecejointe.net", "pjointe.com", "tenvoi.com", "dl4free.com"], "regexps": ["((1fichier\\.com|megadl\\.fr|alterupload\\.com|cjoint\\.net|desfichiers\\.com|dfichiers\\.com|mesfichiers\\.org|piecejointe\\.net|pjointe\\.com|tenvoi\\.com|dl4free\\.com)/\\?[a-zA-Z0-9]{5,30}(&pw=[^&]+)?)"], "regexp": "((1fichier\\.com|megadl\\.fr|alterupload\\.com|cjoint\\.net|desfichiers\\.com|dfichiers\\.com|mesfichiers\\.org|piecejointe\\.net|pjointe\\.com|tenvoi\\.com|dl4free\\.com)/\\?[a-zA-Z0-9]{5,30}(&pw=[^&]+)?)", "status": true}, "rapidgator": {"name": "rapidgator", "type": "premium", "domains": ["rapidgator.net", "rg.to", "rapidgator.asia"], "regexps": ["(rapidgator\\.net|rg\\.to|rapidgator\\.asia)/file/([0-9a-zA-Z]{32})", "(rapidgator\\.net/file/[0-9]{7,8})"], "regexp": "((rapidgator\\.net|rg\\.to|rapidgator\\.asia)/file/([0-9a-zA-Z]{32}))|((rapidgator\\.net/file/[0-9]{7,8}))", "status": true, "quota": 100000, "quotaMax": 100000, "quotaType": "traffic"}}}}

  /v4/user/verif:
    post:
      tags: [User]
      operationId: getVerificationStatus
      summary: Follow a new-location login verification
      description: |
        When a key is used from a new location, the API answers `AUTH_BLOCKED`
        with a `token` and emails the user. Poll this endpoint with that token:
        `verif` becomes `allowed` (with the `apikey`) or `denied`.

        Errors: `PIN_EXPIRED` (the token is invalid or expired).
      security: []
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/VerificationRequest"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The verification status.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/VerificationResponse"
              examples:
                waiting:
                  summary: "Waiting"
                  value: {"status": "success", "data": {"verif": "waiting", "resendable": false}}
                allowed:
                  summary: "Allowed"
                  value: {"status": "success", "data": {"verif": "allowed", "apikey": "staticDemoApikeyPrem"}}
                denied:
                  summary: "Denied"
                  value: {"status": "success", "data": {"verif": "denied"}}
                expired:
                  summary: "Expired"
                  value: {"status": "error", "error": {"code": "PIN_EXPIRED", "message": "The pin is expired demo"}}

  /v4/user/verif/resend:
    post:
      tags: [User]
      operationId: resendVerification
      summary: Send the verification email again
      description: |
        Allowed once per token; check `resendable` from `/v4/user/verif` first.

        Errors: `PIN_EXPIRED`, `ALREADY_SENT`.
      security: []
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/VerificationRequest"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: Whether the email was sent.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ResendVerificationResponse"
              examples:
                resend:
                  summary: "Resend"
                  value: {"status": "success", "data": {"sent": true}}
                already_resent:
                  summary: "Already resent"
                  value: {"status": "error", "error": {"code": "ALREADY_SENT", "message": "The verification email has already been sent again demo"}}
                expired:
                  summary: "Expired"
                  value: {"status": "error", "error": {"code": "PIN_EXPIRED", "message": "The pin is expired demo"}}

  /v4/user/notification/clear:
    post:
      tags: [User]
      operationId: clearNotification
      summary: Clear a user notification
      description: Clears one of the codes listed in the `notifications` of `/v4/user`.
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/ClearNotificationRequest"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The notification was cleared.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/MessageResponse"
              examples:
                clear_notif:
                  summary: "Clear notif"
                  value: {"status": "success", "data": {"message": "Notification was cleared"}}

  /v4/link/infos:
    post:
      tags: [Links]
      operationId: getLinkInfos
      summary: Get file information for hoster links
      description: |
        Returns the file name and size of each link, or a per-link `error`
        (`LINK_HOST_NOT_SUPPORTED`, `LINK_DOWN`, `LINK_PASS_PROTECTED`,
        `LINK_TEMPORARY_UNAVAILABLE`). Redirector links are not supported here;
        use `/v4/link/redirector` first.

        Errors: `LINK_IS_MISSING`.
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/LinkInfosRequest"
            encoding:
              link[]:
                style: form
                explode: true
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: One entry per requested link, in order.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/LinkInfosResponse"
              examples:
                example_file:
                  summary: "Example file"
                  value: {"status": "success", "data": {"infos": [{"link": "https://example.com/file2MB.txt", "filename": "example.file2MB.txt.txt", "size": 2097152, "host": "example", "hostDomain": "example.com"}]}}
                errors:
                  summary: "Errors"
                  value: {"status": "success", "data": {"infos": [{"link": "https://example.com/down", "error": {"code": "LINK_DOWN", "message": "This link is not available on the file hoster website"}}, {"link": "https://not-supported.com/somefile.txt", "error": {"code": "LINK_HOST_NOT_SUPPORTED", "message": "This host or link is not supported"}}]}}

  /v4/link/redirector:
    post:
      tags: [Links]
      operationId: extractRedirector
      summary: Extract links from a redirector or link protector
      description: |
        Returns encrypted links (`https://redirect.alldebrid.com/...`) that only
        work with `/v4/link/infos` and `/v4/link/unlock`.

        Errors: `REDIRECTOR_NOT_SUPPORTED`, `REDIRECTOR_ERROR`, `REDIRECTOR_RATE_LIMITED`.
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/RedirectorRequest"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The extracted links.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RedirectorResponse"
              examples:
                get_links:
                  summary: "Get links"
                  value: {"status": "success", "data": {"links": ["https://redirect.alldebrid.com/mnsaj-0-fcdeaf3287", "https://redirect.alldebrid.com/mnsaj-1-fcdeaf3287"]}}
                not_supported:
                  summary: "Not supported"
                  value: {"status": "error", "error": {"code": "REDIRECTOR_NOT_SUPPORTED", "message": "Redirector not supported demo"}}
                rate_limited:
                  summary: "Rate limited"
                  value: {"status": "error", "error": {"code": "REDIRECTOR_RATE_LIMITED", "message": "Too much request to unlock folder demo"}}
                error:
                  summary: "Error"
                  value: {"status": "error", "error": {"code": "REDIRECTOR_ERROR", "message": "Could not extract links demo"}}

  /v4/link/unlock:
    post:
      tags: [Links]
      operationId: unlockLink
      summary: Unlock a link into a direct download link
      description: |
        Three outcomes on success:

        - `link` holds the download link.
        - `delayed` is set: the link is being generated; poll `/v4/link/delayed`.
        - `streaming` lists several qualities: pick one with `/v4/link/streaming`.

        Errors: `LINK_HOST_NOT_SUPPORTED`, `LINK_DOWN`, `LINK_HOST_UNAVAILABLE`,
        `LINK_TOO_MANY_DOWNLOADS`, `LINK_HOST_FULL`, `LINK_HOST_LIMIT_REACHED`,
        `LINK_PASS_PROTECTED`, `LINK_ERROR`, `LINK_NOT_SUPPORTED`,
        `LINK_TEMPORARY_UNAVAILABLE`, `MUST_BE_PREMIUM`, `FREE_TRIAL_LIMIT_REACHED`,
        `NO_SERVER`.
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/UnlockRequest"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The unlocked link.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UnlockResponse"
              example:
                status: success
                data:
                  link: https://ombfyx.debrid.it/dl/abcdefgh12/example.file2MB.txt
                  host: example
                  filename: example.file2MB.txt
                  streaming: []
                  filesize: 2097152
                  id: 3hk19hz3205
                  hostDomain: example.com

  /v4/link/streaming:
    post:
      tags: [Links]
      operationId: getStreamingLink
      summary: Choose a quality for a streaming link
      description: |
        `id` comes from `/v4/link/unlock` and `stream` from one of its
        `streaming` entries. Returns a `link`, or a `delayed` ID to poll.

        Errors: `STREAM_INVALID_GEN_ID`, `STREAM_INVALID_STREAM_ID`.
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/StreamingRequest"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The download link for that quality.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/StreamingResponse"
              examples:
                choose_quality:
                  summary: "Choose quality"
                  value: {"status": "success", "data": {"link": "http://ombfyx.alld.io/dl/abcdefgh12/somefile.mp4", "filename": "Some video", "filesize": 699400192}}
                invalid_gen:
                  summary: "Invalid gen"
                  value: {"status": "error", "error": {"code": "STREAM_INVALID_GEN_ID", "message": "Invalid generation ID demo"}}
                invalid_stream:
                  summary: "Invalid stream"
                  value: {"status": "error", "error": {"code": "STREAM_INVALID_STREAM_ID", "message": "Invalid stream ID demo"}}

  /v4/link/delayed:
    post:
      tags: [Links]
      operationId: getDelayedLink
      summary: Poll a delayed link
      description: |
        Poll every 5 seconds or more until `status` is `2` (ready, `link` is set)
        or `3` (failed).

        Errors: `DELAYED_INVALID_ID`.
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/DelayedRequest"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The delayed link status.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DelayedResponse"
              examples:
                still_processing:
                  summary: "Still processing"
                  value: {"status": "success", "data": {"status": 1, "time_left": 30}}
                link_ready:
                  summary: "Link ready"
                  value: {"status": "success", "data": {"status": 2, "time_left": 0, "link": "https://ombfyx.debrid.it/dl/abcdefgh12/file.txt"}}
                invalid_id:
                  summary: "Invalid id"
                  value: {"status": "error", "error": {"code": "DELAYED_INVALID_ID", "message": "This delayed link id is invalid demo"}}

  /v4/magnet/upload:
    post:
      tags: [Magnets]
      operationId: uploadMagnets
      summary: Upload magnets
      description: |
        Accepts magnet URIs or bare info hashes. Each entry of the response
        is either an uploaded magnet (with its `id`) or a per-magnet `error`.
        Uploading a magnet that is already in the account returns its existing `id`.

        Errors: `MAGNET_NO_URI`, `MAGNET_INVALID_URI`, `MAGNET_MUST_BE_PREMIUM`,
        `MAGNET_NO_SERVER`, `MAGNET_TOO_MANY_ACTIVE`, `MAGNET_TOO_MANY`.
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/UploadMagnetsRequest"
            encoding:
              magnets[]:
                style: form
                explode: true
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: One entry per magnet, in order.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UploadMagnetsResponse"
              examples:
                upload_magnet:
                  summary: "Upload magnet"
                  value: {"status": "success", "data": {"magnets": [{"magnet": "magnet:?xt=urn:btih:3A842783e3005495d5d1637f5364b59343c7844707&dn=ubuntu-18.04.2-live-server-amd64.iso", "hash": "3A842783e3005495d5d1637f5364b59343c7844707", "name": "ubuntu-18.04.2-live-server-amd64.iso", "size": 48216647, "id": 123456, "ready": false}]}}
                error:
                  summary: "Error"
                  value: {"status": "error", "error": {"code": "MAGNET_NO_URI", "message": "No magnet sent demo"}}

  /v4/magnet/upload/file:
    post:
      tags: [Magnets]
      operationId: uploadTorrentFiles
      summary: Upload torrent files
      description: |
        Each entry of the response is either an uploaded torrent (with its
        magnet `id`) or a per-file `error` naming the `file`.

        Errors: `MAGNET_FILE_UPLOAD_FAILED`, `MAGNET_INVALID_FILE`,
        `MAGNET_MUST_BE_PREMIUM`, `MAGNET_NO_SERVER`, `MAGNET_TOO_MANY_ACTIVE`.
      requestBody:
        required: true
        content:
          multipart/form-data:
            schema:
              $ref: "#/components/schemas/UploadTorrentFilesRequest"
            encoding:
              files[]:
                contentType: application/x-bittorrent, application/octet-stream
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: One entry per file, in order.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UploadTorrentFilesResponse"
              examples:
                upload_torrent:
                  summary: "Upload torrent"
                  value: {"status": "success", "data": {"files": [{"file": "ubuntu-18.04.2-live-server-amd64.iso.torrent", "hash": "842783e3005495d5d1637f5364b59343c7844707", "name": "Ubuntu 18.04.2 live server amd64", "size": 1954210119, "id": 123456, "ready": false}]}}
                error:
                  summary: "Error"
                  value: {"status": "error", "error": {"code": "MAGNET_FILE_UPLOAD_FAILED", "message": "File upload failed demo"}}

  /v4.1/magnet/status:
    post:
      tags: [Magnets]
      operationId: getMagnetStatus
      summary: Get the status of magnets
      description: |
        Without parameters, returns every magnet of the account. With `id`,
        returns that magnet **as a single object** (not an array), including
        its `files`. For the files of several magnets, use `/v4/magnet/files`.

        **Live mode.** To refresh a dashboard cheaply, pick a random integer
        `session` and start with `counter=0`. The first answer is a full list
        with `fullsync: true` and the `counter` to send next. Later answers
        only hold the magnets that changed, with only their changed fields
        (`magnets` may then be an array or a single object). A deleted magnet
        comes as `{"id": ..., "deleted": true}`. If the counter is out of sync,
        the API answers with a new full sync.

        Errors: `MAGNET_INVALID_ID`.
      requestBody:
        required: false
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/MagnetStatusRequest"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The magnets.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/MagnetStatusResponse"
              examples:
                get_all:
                  summary: "Get all"
                  value: {"status": "success", "data": {"magnets": [{"id": 123456, "filename": "ubuntu-16.04.2-live-server-amd64.iso", "hash": "123456789cef825718eda30637230585e3330599", "size": 587400285, "status": "Downloading", "statusCode": 1, "downloaded": 255400192, "uploaded": 0, "seeders": 7, "downloadSpeed": 18874368, "uploadSpeed": 0, "uploadDate": 1557133868, "completionDate": 0}, {"id": 56789, "filename": "ubuntu-20.04.2-live-server-amd64.iso", "hash": "987654321cef825718eda30637230585e3330599", "size": 256400192, "status": "Ready", "statusCode": 4, "uploadDate": 1657133868, "completionDate": 1657133968, "nbLinks": 1}, {"id": 99999, "filename": "ubuntu-12.04.2-live-server-amd64.iso", "hash": "999999999cef825718eda30637230585e3330599", "size": 256400192, "status": "Error : Download took more than 72h", "statusCode": 10, "uploadDate": 1657133868}]}}
                get_magnet_status:
                  summary: "Get magnet status"
                  value: {"status": "success", "data": {"magnets": [{"id": 56789, "filename": "ubuntu-20.04.2-live-server-amd64.iso", "hash": "987654321cef825718eda30637230585e3330599", "size": 256400192, "status": "Ready", "statusCode": 4, "uploadDate": 1657133868, "completionDate": 1657133968, "nbLinks": 1, "files": [{"n": "ubuntu-20.04.2-live-server-amd64.iso", "s": 145517304, "l": "https://alldebrid.com/f/xxxxxxaaaabbbbcccc"}, {"n": "docs", "e": [{"n": "README.txt", "s": 87207, "l": "https://alldebrid.com/f/qsklqdaaaabbbbcccc"}, {"n": "INSTALL.txt", "s": 242117, "l": "https://alldebrid.com/f/48qsoisg4aaabbbbcccc"}]}]}]}}
                get_active_magnets:
                  summary: "Get active magnets"
                  value: {"status": "success", "data": {"magnets": [{"id": 123456, "filename": "ubuntu-16.04.2-live-server-amd64.iso", "hash": "123456789cef825718eda30637230585e3330599", "size": 587400285, "status": "Downloading", "statusCode": 1, "downloaded": 255400192, "uploaded": 0, "seeders": 7, "downloadSpeed": 18874368, "uploadSpeed": 0, "uploadDate": 1557133868, "completionDate": 0}]}}
                first_data_fetch:
                  summary: "First data fetch"
                  value: {"status": "success", "data": {"fullsync": true, "counter": 1, "magnets": [{"id": 123456, "filename": "ubuntu-16.04.2-live-server-amd64.iso", "hash": "123456789cef825718eda30637230585e3330599", "size": 587400285, "status": "Downloading", "statusCode": 1, "downloaded": 255400192, "uploaded": 0, "seeders": 7, "downloadSpeed": 18874368, "uploadSpeed": 0, "uploadDate": 1557133868, "completionDate": 0}, {"id": 56789, "filename": "ubuntu-20.04.2-live-server-amd64.iso", "hash": "987654321cef825718eda30637230585e3330599", "size": 256400192, "status": "Ready", "statusCode": 4, "uploadDate": 1657133868, "completionDate": 1657133968, "nbLinks": 1}, {"id": 99999, "filename": "ubuntu-12.04.2-live-server-amd64.iso", "hash": "999999999cef825718eda30637230585e3330599", "size": 256400192, "status": "Error : Download took more than 72h", "statusCode": 10, "uploadDate": 1657133868}]}}
                delta_sync:
                  summary: "Delta sync"
                  value: {"status": "success", "data": {"counter": 2, "magnets": {"id": 123456, "downloaded": 358454178, "seeders": 9, "downloadSpeed": 27874410}}}

  /v4/magnet/files:
    post:
      tags: [Magnets]
      operationId: getMagnetFiles
      summary: Get the files and download links of magnets
      description: |
        Returns the file tree of each ready magnet. Each file has a link
        to pass to `/v4/link/unlock`. An entry carries a per-magnet `error`
        (`MAGNET_INVALID_ID`) when the ID is unknown.
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/MagnetFilesRequest"
            encoding:
              id[]:
                style: form
                explode: true
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: One entry per magnet ID.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/MagnetFilesResponse"
              examples:
                get_files:
                  summary: "Get files"
                  value: {"status": "success", "data": {"magnets": [{"id": 56789, "files": [{"n": "ubuntu-18.04.2-live-server-amd64.iso", "s": 145517304, "l": "https://alldebrid.com/f/xxxxxxaaaabbbbcccc"}, {"n": "docs", "e": [{"n": "README.txt", "s": 87207, "l": "https://alldebrid.com/f/qsklqdaaaabbbbcccc"}, {"n": "INSTALL.txt", "s": 242117, "l": "https://alldebrid.com/f/48qsoisg4aaabbbbcccc"}]}]}]}}
                error:
                  summary: "Error"
                  value: {"status": "error", "error": {"code": "MAGNET_INVALID_ID", "message": "This magnet ID does not exists or is invalid demo"}}

  /v4/magnet/delete:
    post:
      tags: [Magnets]
      operationId: deleteMagnet
      summary: Delete a magnet
      description: "Errors: `MAGNET_INVALID_ID`."
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/MagnetIdRequest"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The magnet was deleted.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/MessageResponse"
              examples:
                delete_magnet:
                  summary: "Delete magnet"
                  value: {"status": "success", "data": {"message": "Magnet was successfully deleted"}}
                error:
                  summary: "Error"
                  value: {"status": "error", "error": {"code": "MAGNET_INVALID_ID", "message": "This magnet ID does not exists or is invalid demo"}}

  /v4/magnet/restart:
    post:
      tags: [Magnets]
      operationId: restartMagnets
      summary: Restart failed magnets
      description: |
        Send `id` for one magnet, or `ids[]` for several. With `ids[]`, each
        entry of `magnets` reports its own success or `error`.

        Errors: `MAGNET_INVALID_ID`, `MAGNET_PROCESSING` (the magnet is not in error).
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/RestartMagnetsRequest"
            encoding:
              ids[]:
                style: form
                explode: true
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The restart result.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/RestartMagnetsResponse"
              examples:
                restart_magnet:
                  summary: "Restart magnet"
                  value: {"status": "success", "data": {"id": 99999, "message": "Magnet was successfully restarted"}}
                error:
                  summary: "Error"
                  value: {"status": "error", "error": {"code": "MAGNET_INVALID_ID", "message": "This magnet ID does not exists or is invalid demo"}}

  /v4/user/links:
    get:
      tags: [Saved links]
      operationId: getSavedLinks
      summary: List saved links
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The links the user saved.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SavedLinksResponse"
              examples:
                get_user_links:
                  summary: "Get user links"
                  value: {"status": "success", "data": {"links": [{"link": "https://example.com/l1ub83vil5c3", "filename": "ubuntu.16.04.1.iso", "size": 671088640, "date": 1546431734, "host": "example"}, {"link": "https://example.com/aaaabbbbcccc", "filename": "winter.holidays.photos.zip", "size": 91088640, "date": 1546421734, "host": "example"}]}}

  /v4/user/links/save:
    post:
      tags: [Saved links]
      operationId: saveLinks
      summary: Save links
      description: "Errors: `USER_LINK_MISSING`, `USER_LINK_INVALID`."
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/LinksRequest"
            encoding:
              links[]:
                style: form
                explode: true
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The links were saved.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/MessageResponse"
              examples:
                save_links:
                  summary: "Save links"
                  value: {"status": "success", "data": {"message": "Links were sucessfully saved"}}

  /v4/user/links/delete:
    post:
      tags: [Saved links]
      operationId: deleteSavedLinks
      summary: Delete saved links
      description: "Errors: `USER_LINK_MISSING`."
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/LinksRequest"
            encoding:
              links[]:
                style: form
                explode: true
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The links were deleted.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/MessageResponse"
              examples:
                delete_link:
                  summary: "Delete link"
                  value: {"status": "success", "data": {"message": "Links were sucessfully deleted"}}

  /v4/user/history:
    get:
      tags: [Saved links]
      operationId: getHistory
      summary: List recently unlocked links
      description: |
        History logging is off by default: the user enables it in their
        account settings (see `history` in `/v4/user`). Entries are kept 3 days.
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: Recent links.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/HistoryResponse"
              examples:
                get_history:
                  summary: "Get history"
                  value: {"status": "success", "data": {"links": [{"link": "http://example.com/file2MB.txt", "link_dl": "", "filename": "file2MB.txt", "size": 671088640, "date": 1546431734, "host": "example", "error": ""}, {"link": "http://example.com/file10MB.txt", "link_dl": "", "filename": "file10MB.txt", "size": 91088640, "date": 1546421734, "host": "example", "error": ""}]}}

  /v4/user/history/delete:
    post:
      tags: [Saved links]
      operationId: purgeHistory
      summary: Delete the whole recent links history
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The history was purged.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/MessageResponse"
              examples:
                purge_history:
                  summary: "Purge history"
                  value: {"status": "success", "data": {"message": "Recent links history was successfully purged"}}

  /v4/voucher/balance:
    get:
      tags: [Reseller]
      operationId: getVoucherBalance
      summary: Get the reseller balance
      description: Reseller accounts only; other accounts get `GENERIC`.
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The current balance.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/VoucherBalanceResponse"
              examples:
                reseller:
                  summary: "From the official docs (reseller accounts only, not checked live)"
                  value: {"status": "success", "data": {"balance": 51.6}}

  /v4/voucher/get:
    post:
      tags: [Reseller]
      operationId: getVouchers
      summary: Take vouchers from the reseller stock
      description: |
        Returns up to `nb` available vouchers of that duration. When the stock
        is short, `partialList` is `true`.

        Errors: `VOUCHER_DURATION_INVALID`, `VOUCHER_NB_INVALID`, `NO_MORE_VOUCHER`.
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/VoucherRequest"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The vouchers.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/VouchersResponse"
              examples:
                reseller:
                  summary: "From the official docs (reseller accounts only, not checked live)"
                  value: {"status": "success", "data": {"codes": ["AAAAAA-BBBBBB-CCCCCC-DDDDDD", "EEEEEE-FFFFFF-GGGGGG-HHHHHH"], "partialList": true}}

  /v4/voucher/generate:
    post:
      tags: [Reseller]
      operationId: generateVouchers
      summary: Generate new vouchers from the reseller balance
      description: |
        Errors: `VOUCHER_DURATION_INVALID`, `VOUCHER_NB_INVALID`, `INSUFFICIENT_BALANCE`.
      requestBody:
        required: true
        content:
          application/x-www-form-urlencoded:
            schema:
              $ref: "#/components/schemas/VoucherRequest"
      responses:
        "429":
          $ref: "#/components/responses/RateLimited"
        "200":
          description: The generated vouchers and the new balance.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/GeneratedVouchersResponse"
              examples:
                reseller:
                  summary: "From the official docs (reseller accounts only, not checked live)"
                  value: {"status": "success", "data": {"codes": ["AAAAAA-BBBBBB-CCCCCC-DDDDDD", "EEEEEE-FFFFFF-GGGGGG-HHHHHH"], "pricePerVoucher": 3.2, "total": 6.4, "balance": 18.21}}

components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      description: |
        An AllDebrid API key. The API also accepts it as an `apikey` query or
        form parameter; the header is the documented way.

  responses:
    RateLimited:
      description: |
        Too many requests: more than 12 per second or 600 per minute. The API
        may also answer 503 under load. Wait and retry.

  parameters:
    HostsOnly:
      name: hostsOnly
      in: query
      required: false
      description: Only return the `hosts` section.
      schema:
        type: boolean

  schemas:
    # ---------------------------------------------------------------- envelope

    ResponseStatus:
      type: string
      enum: [success, error]
      description: "`success` with `data`, or `error` with `error`."

    Error:
      type: object
      required: [code, message]
      properties:
        code:
          type: string
          description: A machine-readable error code; see `ErrorCode`.
          examples: [AUTH_BAD_APIKEY]
        message:
          type: string
          description: A human-readable message, in English.
        token:
          type: string
          description: With `AUTH_BLOCKED`, the token to poll on `/v4/user/verif`.

    ErrorCode:
      type: string
      description: |
        Error codes the API is known to return. New codes may appear, so
        `Error.code` is a plain string and this list is informational.
      enum:
        - GENERIC
        - "404"
        - MAINTENANCE
        - DISCONTINUED
        - AUTH_MISSING_APIKEY
        - AUTH_BAD_APIKEY
        - AUTH_BLOCKED
        - AUTH_USER_BANNED
        - ALREADY_SENT
        - NO_SERVER
        - LINK_IS_MISSING
        - BAD_LINK
        - LINK_HOST_NOT_SUPPORTED
        - LINK_DOWN
        - LINK_PASS_PROTECTED
        - LINK_HOST_UNAVAILABLE
        - LINK_TOO_MANY_DOWNLOADS
        - LINK_HOST_FULL
        - LINK_HOST_LIMIT_REACHED
        - LINK_ERROR
        - LINK_TEMPORARY_UNAVAILABLE
        - LINK_NOT_SUPPORTED
        - REDIRECTOR_NOT_SUPPORTED
        - REDIRECTOR_ERROR
        - REDIRECTOR_RATE_LIMITED
        - STREAM_INVALID_GEN_ID
        - STREAM_INVALID_STREAM_ID
        - DELAYED_INVALID_ID
        - FREE_TRIAL_LIMIT_REACHED
        - MUST_BE_PREMIUM
        - MAGNET_INVALID_ID
        - MAGNET_INVALID_URI
        - MAGNET_INVALID_FILE
        - MAGNET_FILE_UPLOAD_FAILED
        - MAGNET_NO_URI
        - MAGNET_PROCESSING
        - MAGNET_TOO_MANY_ACTIVE
        - MAGNET_TOO_MANY
        - MAGNET_MUST_BE_PREMIUM
        - MAGNET_NO_SERVER
        - MAGNET_TOO_LARGE
        - MAGNET_UPLOAD_FAILED
        - MAGNET_INTERNAL_ERROR
        - MAGNET_CANT_BOOTSTRAP
        - MAGNET_MAGNET_TOO_BIG
        - MAGNET_TOOK_TOO_LONG
        - MAGNET_LINKS_REMOVED
        - MAGNET_PROCESSING_FAILED
        - PIN_ALREADY_AUTHED
        - PIN_EXPIRED
        - PIN_INVALID
        - USER_LINK_MISSING
        - USER_LINK_INVALID
        - MISSING_NOTIF_ENDPOINT
        - VOUCHER_DURATION_INVALID
        - VOUCHER_NB_INVALID
        - NO_MORE_VOUCHER
        - INSUFFICIENT_BALANCE
        - DOWNLOAD_FAILED
        - ACCOUNT_INVALID
        - NO_JSON_PARAM
        - JSON_INVALID
        - FREEDAYS_INVALID_COUNTRY
        - FREEDAYS_INVALID_PHONE
        - FREEDAYS_INVALID_PROVIDER
        - FREEDAYS_USED_PHONE
        - FREEDAYS_ALREADY_REQUESTED
        - FREEDAYS_INVALID_STATUS
        - FREEDAYS_TOO_MUCH_RETRIES
        - FREEDAYS_INVALID_CODE
        - FREEDAYS_DENIED
        - FREEDAYS_ERROR_SENDING

    # ------------------------------------------------------------ flexible types

    StringOrInteger:
      description: A value the API sends either as a string or as an integer.
      oneOf:
        - type: string
        - type: integer
          format: int64

    StringOrStrings:
      description: A value the API sends either as one string or as a list of strings.
      oneOf:
        - type: string
        - type: array
          items:
            type: string

    # -------------------------------------------------------------------- general

    PingData:
      type: object
      required: [ping]
      properties:
        ping:
          type: string
          const: pong
        version:
          type: string
          description: API major version.
          examples: ["4"]
        subversion:
          type: boolean
          description: Only on `/v4.1/ping`.

    PingResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/PingData" }
        error: { $ref: "#/components/schemas/Error" }

    MessageData:
      type: object
      required: [message]
      properties:
        message:
          type: string
          description: A confirmation message.
          examples: [Magnet was successfully deleted]

    MessageResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/MessageData" }
        error: { $ref: "#/components/schemas/Error" }

    # ------------------------------------------------------------------------ pin

    PinGetData:
      type: object
      required: [pin, check, expires_in, user_url, base_url]
      properties:
        pin:
          type: string
          description: The code to show to the user.
          examples: [ABCD]
        check:
          type: string
          description: The token to send to `/v4/pin/check`.
        expires_in:
          type: integer
          description: Seconds before the PIN expires.
          examples: [600]
        user_url:
          type: string
          format: uri
          description: The page where the user enters the PIN, with the PIN filled in.
        base_url:
          type: string
          format: uri
          description: The page where the user enters the PIN.

    PinGetResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/PinGetData" }
        error: { $ref: "#/components/schemas/Error" }

    PinCheckRequest:
      type: object
      required: [pin, check]
      properties:
        pin:
          type: string
          description: The `pin` from `/v4.1/pin/get`.
        check:
          type: string
          description: The `check` token from `/v4.1/pin/get`.

    PinCheckData:
      type: object
      required: [activated, expires_in]
      properties:
        activated:
          type: boolean
          description: "`true` once the user has entered the PIN."
        expires_in:
          type: integer
          description: Seconds before the PIN expires.
        apikey:
          type: string
          description: The new API key, once `activated` is `true`.

    PinCheckResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/PinCheckData" }
        error: { $ref: "#/components/schemas/Error" }

    # ---------------------------------------------------------------------- hosts

    Service:
      type: object
      description: A supported file host, streaming site or redirector.
      required: [name, type, domains]
      properties:
        name:
          type: string
          examples: [1fichier]
        type:
          type: string
          description: "`premium` (needs a premium account) or `free`."
          examples: [premium]
        domains:
          type: array
          items: { type: string }
          description: Every domain of the service.
        regexps:
          type: array
          items: { type: string }
          description: Regular expressions matching the supported links.
        regexp:
          $ref: "#/components/schemas/StringOrStrings"
          description: The `regexps` joined into one expression (sometimes a list).
        status:
          type: boolean
          description: |
            Whether the service worked in the last 5 minutes. Only some hosts are
            checked, about every 10 minutes.
        display:
          type: string
          description: A display name, when it differs from `name`.
        hardRedirect:
          type: array
          items: { type: string }
          description: Domains that redirect to this host.
        heavy:
          type: boolean
          description: Redirectors only. Extraction is slow or rate limited.
        quota:
          type: integer
          format: int64
          description: "`/v4.1/user/hosts` only. The remaining quota (see `quotaType`)."
        quotaMax:
          type: integer
          format: int64
          description: "`/v4.1/user/hosts` only. The daily quota."
        quotaType:
          type: string
          description: |
            `/v4.1/user/hosts` only. `traffic` (quota in MB) or `nb_download`
            (number of downloads).
          examples: [traffic]
        limitSimuDl:
          type: integer
          description: "`/v4.1/user/hosts` only. Free simultaneous download slots."

    ServiceMap:
      type: object
      description: Services keyed by name.
      additionalProperties:
        $ref: "#/components/schemas/Service"

    HostsData:
      type: object
      required: [hosts]
      properties:
        hosts: { $ref: "#/components/schemas/ServiceMap" }
        streams: { $ref: "#/components/schemas/ServiceMap" }
        redirectors: { $ref: "#/components/schemas/ServiceMap" }

    HostsResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/HostsData" }
        error: { $ref: "#/components/schemas/Error" }

    HostDomainsData:
      type: object
      required: [hosts]
      properties:
        hosts:
          type: array
          items: { type: string }
        streams:
          type: array
          items: { type: string }
        redirectors:
          type: array
          items: { type: string }

    HostDomainsResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/HostDomainsData" }
        error: { $ref: "#/components/schemas/Error" }

    HostPriorityData:
      type: object
      required: [hosts]
      properties:
        hosts:
          type: object
          description: Host names mapped to their rank, 1 being the most open.
          additionalProperties:
            type: integer

    HostPriorityResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/HostPriorityData" }
        error: { $ref: "#/components/schemas/Error" }

    # ----------------------------------------------------------------------- user

    QuotaMap:
      description: |
        Remaining quota per limited host, in MB. An empty map may be sent as
        an empty JSON array.
      oneOf:
        - type: object
          additionalProperties:
            type: integer
            format: int64
        - type: array
          maxItems: 0

    User:
      type: object
      required:
        - username
        - email
        - isPremium
        - isSubscribed
        - isTrial
        - premiumUntil
        - lang
        - preferedDomain
        - fidelityPoints
        - limitedHostersQuotas
        - notifications
      properties:
        username: { type: string }
        email: { type: string }
        isPremium: { type: boolean }
        isSubscribed:
          type: boolean
          description: Whether the user has an active recurring subscription.
        isTrial:
          type: boolean
          description: Whether the account is in its free trial.
        premiumUntil:
          type: integer
          format: int64
          description: Unix time when premium ends, or 0 when not premium.
        lang:
          type: string
          description: Interface language, e.g. `en` or `fr`.
        preferedDomain:
          type: string
          description: Preferred alldebrid.* top-level domain, e.g. `com` or `fr`.
        fidelityPoints: { type: integer }
        limitedHostersQuotas: { $ref: "#/components/schemas/QuotaMap" }
        remainingTrialQuota:
          type: integer
          format: int64
          description: During the trial, the remaining traffic in MB.
        notifications:
          type: array
          items: { type: string }
          description: Codes of the current notifications; clear them with `/v4/user/notification/clear`.
        history:
          type: boolean
          description: Whether recent links history logging is enabled.

    UserData:
      type: object
      required: [user]
      properties:
        user: { $ref: "#/components/schemas/User" }

    UserResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/UserData" }
        error: { $ref: "#/components/schemas/Error" }

    UserHostsData:
      type: object
      required: [hosts]
      properties:
        hosts: { $ref: "#/components/schemas/ServiceMap" }

    UserHostsResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/UserHostsData" }
        error: { $ref: "#/components/schemas/Error" }

    VerificationRequest:
      type: object
      required: [token]
      properties:
        token:
          type: string
          description: The `token` returned with the `AUTH_BLOCKED` error.

    VerificationData:
      type: object
      required: [verif]
      properties:
        verif:
          type: string
          enum: [waiting, allowed, denied]
        resendable:
          type: boolean
          description: When `waiting`, whether `/v4/user/verif/resend` may be called.
        apikey:
          type: string
          description: When `allowed`, the API key.

    VerificationResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/VerificationData" }
        error: { $ref: "#/components/schemas/Error" }

    ResendVerificationData:
      type: object
      required: [sent]
      properties:
        sent: { type: boolean }

    ResendVerificationResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/ResendVerificationData" }
        error: { $ref: "#/components/schemas/Error" }

    ClearNotificationRequest:
      type: object
      required: [code]
      properties:
        code:
          type: string
          description: A notification code from `/v4/user`.

    # ---------------------------------------------------------------------- links

    LinkInfosRequest:
      type: object
      required: ["link[]"]
      properties:
        link[]:
          type: array
          minItems: 1
          items: { type: string }
          description: The links to look up.
        password:
          type: string
          description: The links' password, if any.

    LinkInfo:
      type: object
      required: [link]
      properties:
        link:
          type: string
          description: The requested link.
        filename: { type: string }
        size:
          type: integer
          format: int64
          description: File size in bytes.
        host: { type: string }
        hostDomain:
          type: string
          description: The host's main domain.
        error: { $ref: "#/components/schemas/Error" }

    LinkInfosData:
      type: object
      required: [infos]
      properties:
        infos:
          type: array
          items: { $ref: "#/components/schemas/LinkInfo" }

    LinkInfosResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/LinkInfosData" }
        error: { $ref: "#/components/schemas/Error" }

    RedirectorRequest:
      type: object
      required: [link]
      properties:
        link:
          type: string
          description: The redirector or link protector URL.

    RedirectorData:
      type: object
      required: [links]
      properties:
        links:
          type: array
          items: { type: string }
          description: Encrypted links, usable with `/v4/link/infos` and `/v4/link/unlock`.

    RedirectorResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/RedirectorData" }
        error: { $ref: "#/components/schemas/Error" }

    UnlockRequest:
      type: object
      required: [link]
      properties:
        link:
          type: string
          description: The link to unlock.
        password:
          type: string
          description: The link's password, if any.

    Stream:
      type: object
      description: One quality of a streaming link.
      required: [id]
      properties:
        id:
          type: string
          description: The `stream` value for `/v4/link/streaming`.
          examples: [hd-1080]
        ext:
          type: string
          examples: [mp4]
        quality:
          $ref: "#/components/schemas/StringOrInteger"
          description: Height in pixels (e.g. `1080`), or a label such as `mp3`.
        filesize:
          type: integer
          format: int64
        proto:
          type: string
          examples: [https]
        name: { type: string }
        tb:
          type: number
          format: double
          description: Audio-only streams. Total bitrate.
        abr:
          type: integer
          description: Audio-only streams. Audio bitrate.

    UnlockData:
      type: object
      properties:
        link:
          type: string
          description: The direct download link. Empty when `delayed` is set.
        host:
          type: string
        filename:
          type: string
        filesize:
          type: integer
          format: int64
          description: File size in bytes.
        id:
          type: string
          description: The generation ID, needed by `/v4/link/streaming`.
        hostDomain:
          type: string
        paws:
          type: boolean
          description: Unused.
        streaming:
          type: array
          items: { $ref: "#/components/schemas/Stream" }
          description: Available qualities for streaming links; empty otherwise.
        delayed:
          $ref: "#/components/schemas/StringOrInteger"
          description: Set when the link is still being generated; poll `/v4/link/delayed` with it.

    UnlockResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/UnlockData" }
        error: { $ref: "#/components/schemas/Error" }

    StreamingRequest:
      type: object
      required: [id, stream]
      properties:
        id:
          type: string
          description: The `id` returned by `/v4/link/unlock`.
        stream:
          type: string
          description: The `id` of the chosen entry of `streaming`.

    StreamingData:
      type: object
      properties:
        link:
          type: string
          description: The download link; absent when `delayed` is set.
        filename: { type: string }
        filesize:
          type: integer
          format: int64
        delayed:
          $ref: "#/components/schemas/StringOrInteger"
          description: Set when the link is still being generated; poll `/v4/link/delayed` with it.

    StreamingResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/StreamingData" }
        error: { $ref: "#/components/schemas/Error" }

    DelayedRequest:
      type: object
      required: [id]
      properties:
        id:
          type: string
          description: The `delayed` value from `/v4/link/unlock` or `/v4/link/streaming`.

    DelayedData:
      type: object
      required: [status, time_left]
      properties:
        status:
          type: integer
          enum: [1, 2, 3]
          description: "`1` still processing, `2` ready (`link` is set), `3` failed."
        time_left:
          type: integer
          description: Estimated seconds left.
        link:
          type: string
          description: The download link, once `status` is `2`.

    DelayedResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/DelayedData" }
        error: { $ref: "#/components/schemas/Error" }

    # -------------------------------------------------------------------- magnets

    UploadMagnetsRequest:
      type: object
      required: ["magnets[]"]
      properties:
        magnets[]:
          type: array
          minItems: 1
          items: { type: string }
          description: Magnet URIs or info hashes.

    UploadedMagnet:
      type: object
      description: An uploaded magnet or torrent, or a per-item `error`.
      properties:
        magnet:
          type: string
          description: The magnet as sent (for torrent files, the magnet built from the file).
        file:
          type: string
          description: Torrent file uploads with an `error` only. The file name sent.
        hash:
          type: string
          description: The info hash.
        name:
          type: string
          description: The torrent name, or `noname` when unknown.
        filename_original:
          type: string
        size:
          type: integer
          format: int64
          description: Total size in bytes.
        ready:
          type: boolean
          description: Whether the files are already available.
        id:
          type: integer
          format: int64
          description: The magnet ID, for `/v4.1/magnet/status`.
        error: { $ref: "#/components/schemas/Error" }

    UploadMagnetsData:
      type: object
      required: [magnets]
      properties:
        magnets:
          type: array
          items: { $ref: "#/components/schemas/UploadedMagnet" }

    UploadMagnetsResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/UploadMagnetsData" }
        error: { $ref: "#/components/schemas/Error" }

    UploadTorrentFilesRequest:
      type: object
      required: ["files[]"]
      properties:
        files[]:
          type: array
          minItems: 1
          items:
            type: string
            contentMediaType: application/x-bittorrent
          description: The .torrent files.

    UploadTorrentFilesData:
      type: object
      required: [files]
      properties:
        files:
          type: array
          items: { $ref: "#/components/schemas/UploadedMagnet" }

    UploadTorrentFilesResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/UploadTorrentFilesData" }
        error: { $ref: "#/components/schemas/Error" }

    MagnetStatusRequest:
      type: object
      properties:
        id:
          type: integer
          format: int64
          description: Only this magnet; the response then holds a single object.
        status:
          type: string
          enum: [active, ready, expired, error]
          description: |
            Documented filter. The live `/v4.1/` endpoint currently ignores it
            and returns every magnet.
        session:
          type: integer
          format: int64
          description: Live mode. A random session ID chosen by the client.
        counter:
          type: integer
          format: int64
          description: Live mode. `0` first, then the `counter` of the previous response.

    FileNode:
      type: object
      description: |
        A file (`n`, `s`, `l`) or a folder (`n`, `e`) of a magnet.
      required: [n]
      properties:
        n:
          type: string
          description: File or folder name.
        s:
          type: integer
          format: int64
          description: Files only. Size in bytes.
        l:
          type: string
          description: Files only. Link to unlock with `/v4/link/unlock`.
        e:
          type: array
          items: { $ref: "#/components/schemas/FileNode" }
          description: Folders only. The entries of the folder.

    Magnet:
      type: object
      description: |
        A magnet of the account. In a live mode delta, only `id` and the
        fields that changed are present.
      required: [id]
      properties:
        id:
          type: integer
          format: int64
        filename: { type: string }
        size:
          type: integer
          format: int64
          description: Total size in bytes.
        hash:
          type: string
          description: The info hash.
        status:
          type: string
          description: The status in plain English.
          examples: [Ready]
        statusCode:
          type: integer
          description: |
            `0` queued, `1` downloading, `2` compressing or moving, `3` uploading,
            `4` ready. `5` to `15` are errors: `5` upload failed, `6` unpacking error,
            `7` no peer, `8` too big, `9` internal error, `10` took too long,
            `11` files removed from the host, `12` and `13` processing failed,
            `14` tracker error, `15` no peer.
          minimum: 0
        downloaded:
          type: integer
          format: int64
          description: Bytes downloaded so far (while processing).
        uploaded:
          type: integer
          format: int64
          description: Bytes uploaded so far (while processing).
        seeders:
          type: integer
          description: Seeders (while downloading).
        downloadSpeed:
          type: integer
          format: int64
          description: Bytes per second (while downloading).
        uploadSpeed:
          type: integer
          format: int64
          description: Bytes per second (while uploading).
        processingPerc:
          type: number
          format: double
          description: Progress percentage while processing.
        uploadDate:
          type: integer
          format: int64
          description: Unix time the magnet was added.
        completionDate:
          type: integer
          format: int64
          description: Unix time the magnet became ready, or 0.
        type:
          type: string
          description: "`m` when added as a magnet, `b` when added as a torrent file."
        notified:
          type: boolean
        version:
          type: integer
        nbLinks:
          type: integer
          description: Number of files, once ready.
        files:
          type: array
          items: { $ref: "#/components/schemas/FileNode" }
          description: Only when a single magnet is requested with `id`.
        deleted:
          type: boolean
          description: Live mode deltas only. The magnet was deleted; drop it from the local state.

    MagnetList:
      description: |
        A list of magnets, or a single magnet object when one `id` was requested
        (and sometimes in live mode deltas).
      oneOf:
        - type: array
          items: { $ref: "#/components/schemas/Magnet" }
        - $ref: "#/components/schemas/Magnet"

    MagnetStatusData:
      type: object
      required: [magnets]
      properties:
        magnets: { $ref: "#/components/schemas/MagnetList" }
        counter:
          type: integer
          format: int64
          description: Live mode. The counter to send on the next call.
        fullsync:
          type: boolean
          description: Live mode. `true` when the response holds the full list.

    MagnetStatusResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/MagnetStatusData" }
        error: { $ref: "#/components/schemas/Error" }

    MagnetFilesRequest:
      type: object
      required: ["id[]"]
      properties:
        id[]:
          type: array
          minItems: 1
          items:
            type: integer
            format: int64
          description: Magnet IDs.

    MagnetFiles:
      type: object
      required: [id]
      properties:
        id:
          $ref: "#/components/schemas/StringOrInteger"
          description: The magnet ID (sent back as a string).
        files:
          type: array
          items: { $ref: "#/components/schemas/FileNode" }
        error: { $ref: "#/components/schemas/Error" }

    MagnetFilesData:
      type: object
      required: [magnets]
      properties:
        magnets:
          type: array
          items: { $ref: "#/components/schemas/MagnetFiles" }

    MagnetFilesResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/MagnetFilesData" }
        error: { $ref: "#/components/schemas/Error" }

    MagnetIdRequest:
      type: object
      required: [id]
      properties:
        id:
          type: integer
          format: int64
          description: The magnet ID.

    RestartMagnetsRequest:
      type: object
      properties:
        id:
          type: integer
          format: int64
          description: One magnet ID.
        ids[]:
          type: array
          items:
            type: integer
            format: int64
          description: Several magnet IDs.

    RestartedMagnet:
      type: object
      properties:
        magnet:
          type: string
          description: The magnet ID.
        message: { type: string }
        error: { $ref: "#/components/schemas/Error" }

    RestartMagnetsData:
      type: object
      properties:
        id:
          type: integer
          format: int64
          description: With `id`. The restarted magnet.
        message:
          type: string
          description: With `id`. A confirmation message.
        magnets:
          type: array
          items: { $ref: "#/components/schemas/RestartedMagnet" }
          description: With `ids[]`. One entry per magnet.

    RestartMagnetsResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/RestartMagnetsData" }
        error: { $ref: "#/components/schemas/Error" }

    # ---------------------------------------------------------------- saved links

    SavedLink:
      type: object
      required: [link]
      properties:
        link: { type: string }
        filename: { type: string }
        size:
          type: integer
          format: int64
        date:
          type: integer
          format: int64
          description: Unix time the link was saved or unlocked.
        host: { type: string }
        link_dl:
          type: string
          description: History only. The download link that was generated.
        error:
          type: string
          description: History only. The error the unlock gave, if any.

    SavedLinksData:
      type: object
      required: [links]
      properties:
        links:
          type: array
          items: { $ref: "#/components/schemas/SavedLink" }

    SavedLinksResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/SavedLinksData" }
        error: { $ref: "#/components/schemas/Error" }

    HistoryResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/SavedLinksData" }
        error: { $ref: "#/components/schemas/Error" }

    LinksRequest:
      type: object
      required: ["links[]"]
      properties:
        links[]:
          type: array
          minItems: 1
          items: { type: string }

    # ------------------------------------------------------------------- reseller

    VoucherBalanceData:
      type: object
      required: [balance]
      properties:
        balance:
          type: number
          format: double
          description: The reseller balance.

    VoucherBalanceResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/VoucherBalanceData" }
        error: { $ref: "#/components/schemas/Error" }

    VoucherRequest:
      type: object
      required: [duration, nb]
      properties:
        duration:
          type: integer
          enum: [15, 30, 90, 180, 365]
          description: Voucher duration in days.
        nb:
          type: integer
          minimum: 1
          maximum: 10
          description: Number of vouchers.

    VouchersData:
      type: object
      required: [codes]
      properties:
        codes:
          type: array
          items: { type: string }
        partialList:
          type: boolean
          description: "`true` when fewer vouchers than requested were available."

    VouchersResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/VouchersData" }
        error: { $ref: "#/components/schemas/Error" }

    GeneratedVouchersData:
      type: object
      required: [codes]
      properties:
        codes:
          type: array
          items: { type: string }
        pricePerVoucher: { type: number, format: double }
        total:
          type: number
          format: double
          description: Total price of the request.
        balance:
          type: number
          format: double
          description: The balance left after the generation.

    GeneratedVouchersResponse:
      type: object
      required: [status]
      properties:
        status: { $ref: "#/components/schemas/ResponseStatus" }
        demo: { type: boolean }
        deprecated: { type: boolean }
        data: { $ref: "#/components/schemas/GeneratedVouchersData" }
        error: { $ref: "#/components/schemas/Error" }
