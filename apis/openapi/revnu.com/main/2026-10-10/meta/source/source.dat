        "responses": {
          "200": {
            "description": "``json { \"status\": { \"sandbox\": \"alive\", \"running\": false, \"lastActivityAt\": 1789832474865, \"lastTurnAt\": 1789832490530, \"pendingWakes\": 2, \"nextWakeAt\": 1790002800000 } } ` running is derived: a turn that started in the last 30 minutes and has not finished. A dead` sandbox is normal between turns; ",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
