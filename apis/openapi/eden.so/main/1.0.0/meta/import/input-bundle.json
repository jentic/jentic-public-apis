{
  "openapi": "3.1.0",
  "info": {
    "title": "Eden MCP API",
    "version": "1.0.0",
    "summary": "Eden's public API for AI agents: a hosted MCP server for social research, analytics, boards, notes, and post scheduling.",
    "description": "Eden's agent API is a hosted [MCP](https://modelcontextprotocol.io) (Model Context Protocol) server. Agents speak JSON-RPC 2.0 over Streamable HTTP to `POST https://mcp.eden.so/mcp` and get 110 tools (namespaced `eden_*`) covering outlier research across X, LinkedIn, Instagram, TikTok, YouTube, and Substack, private analytics, boards and notes, and scheduling/publishing.\n\n**Connect (MCP clients):** add a remote MCP server at `https://mcp.eden.so/mcp`. Claude Code: `claude mcp add --transport http eden https://mcp.eden.so/mcp`. Claude.ai/Desktop: Settings → Connectors → Add custom connector. Auth is OAuth 2.0 (authorization code + PKCE, dynamic client registration per RFC 7591, discovery per RFC 8414/9728).\n\n**Connect (plain HTTP, e.g. n8n/Zapier/Make):** create an API key in Eden under Settings → API and send it as `Authorization: Bearer eden_pat_…` on every request.\n\n**REST, no MCP client:** every tool also runs as `POST https://mcp.eden.so/v1/tools/<name>` with its arguments as the JSON body (spec: https://mcp.eden.so/v1/openapi.json). The store API (sales, customers, products, email list, webhooks) has its own spec: https://api.eden.so/store-app/v1/openapi.json.\n\n**Tool errors:** tools return structured JSON. Failures are `{ ok: false, status, message }` — `status` says whether to fix input (`invalid`), reconnect (`auth-expired`), or surface to the user. Never retry an `invalid` payload unchanged.\n\nThe full tool catalog is enumerated under the top-level `x-mcp` extension, and in human/agent-readable form at https://eden.so/llms-full.txt.",
    "contact": {
      "name": "Eden",
      "url": "https://eden.so/help/"
    },
    "termsOfService": "https://eden.so/terms/",
    "x-jentic-source-url": "https://eden.so/openapi.json"
  },
  "servers": [
    {
      "url": "https://mcp.eden.so",
      "description": "Eden hosted MCP server"
    }
  ],
  "paths": {
    "/mcp": {
      "post": {
        "operationId": "mcp",
        "summary": "MCP endpoint (JSON-RPC 2.0 over Streamable HTTP)",
        "description": "The single MCP endpoint. Standard MCP methods apply: `initialize`, `tools/list`, `tools/call`. The server runs stateless — no `mcp-session-id` is issued and every request must carry `Authorization: Bearer <token>` (an OAuth access token or an `eden_pat_…` personal access token). Write-marked tools require a write-scoped token.",
        "security": [
          {
            "oauth": [
              "read"
            ]
          },
          {
            "oauth": [
              "read",
              "write"
            ]
          },
          {
            "personalAccessToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response. Tool-level failures still return 200 — check the `ok` field of tool results (see ToolFailure).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token. Carries `WWW-Authenticate: Bearer realm=\"mcp\", resource_metadata=\"https://mcp.eden.so/.well-known/oauth-protected-resource\"` and a JSON-RPC error body with code -32001."
          },
          "429": {
            "description": "Rate limited (per bearer token). Honor the `Retry-After` header; the body is a JSON-RPC error with code -32000."
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is up.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "stateless",
                        "stateful"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/oauth-protected-resource": {
      "get": {
        "operationId": "oauthProtectedResourceMetadata",
        "summary": "OAuth protected-resource metadata (RFC 9728)",
        "security": [],
        "responses": {
          "200": {
            "description": "Points clients at the authorization server and supported scopes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "resource": {
                      "type": "string"
                    },
                    "authorization_servers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "bearer_methods_supported": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "scopes_supported": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/oauth-authorization-server": {
      "servers": [
        {
          "url": "https://oauth.eden.so",
          "description": "Eden OAuth authorization server"
        }
      ],
      "get": {
        "operationId": "oauthAuthorizationServerMetadata",
        "summary": "OAuth authorization-server metadata (RFC 8414)",
        "description": "Discovery document for the authorization server. Grants: `authorization_code` (PKCE S256 required) and `refresh_token`. Dynamic client registration is open at `POST /oauth/register` (RFC 7591). Scopes: `read`, `write`.",
        "security": [],
        "responses": {
          "200": {
            "description": "RFC 8414 metadata document."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth": {
        "type": "oauth2",
        "description": "OAuth 2.0 with PKCE. Clients self-register via dynamic client registration (RFC 7591) at POST https://oauth.eden.so/oauth/register. Access tokens expire after 1 hour; use the refresh token.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://oauth.eden.so/oauth/authorize",
            "tokenUrl": "https://oauth.eden.so/oauth/token",
            "refreshUrl": "https://oauth.eden.so/oauth/token",
            "scopes": {
              "read": "Read-only access to workspace data, social research, and analytics",
              "write": "Create and modify boards, notes, scheduled posts, and other workspace data"
            }
          }
        }
      },
      "personalAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "eden_pat_…",
        "description": "Personal access token (API key) for non-OAuth clients (n8n, Zapier, Make, scripts). Created in Eden under Settings → API; shown once at creation. Sent exactly like an OAuth token: `Authorization: Bearer eden_pat_…`."
      }
    },
    "schemas": {
      "JsonRpcRequest": {
        "type": "object",
        "required": [
          "jsonrpc",
          "method"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "type": [
              "string",
              "number"
            ]
          },
          "method": {
            "type": "string",
            "description": "MCP method, e.g. `initialize`, `tools/list`, `tools/call`."
          },
          "params": {
            "type": "object",
            "description": "For `tools/call`: `{ name, arguments }` where `name` is one of the tools listed in the top-level `x-mcp.tools`."
          }
        }
      },
      "JsonRpcResponse": {
        "type": "object",
        "required": [
          "jsonrpc"
        ],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "const": "2.0"
          },
          "id": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "result": {
            "type": "object"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "ToolFailure": {
        "type": "object",
        "description": "Structured failure payload returned inside a tool result when a call cannot be fulfilled.",
        "required": [
          "ok",
          "status",
          "message"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "status": {
            "type": "string",
            "enum": [
              "auth-expired",
              "invalid",
              "conflict",
              "forbidden",
              "not-found",
              "unreachable",
              "missing-workspace"
            ]
          },
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "externalDocs": {
    "description": "Full agent reference: connection guide, skills, and the complete MCP tool catalog",
    "url": "https://eden.so/llms-full.txt"
