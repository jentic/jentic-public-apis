openapi: 3.0.3
info:
  title: leadtributor.cloud - Api
  description: |
    ## The Api of the leadtributor.cloud.
  version: 1.0.0
  contact:
    name: leadtributor GmbH
    url: https://www.leadtributor.com
  license:
    name: leadtributor.cloud - Terms Of Use
    url: https://legal.leadtributor.cloud/termsofuse/current/termsofuse.html
servers:
  - url: https://api.leadtributor.cloud
    description: Api of the leadtributor.cloud platform.
  - url: https://api.demo.leadtributor.cloud
    description: Api of the demonstration platform.
tags:
  - name: leads
    description: Leads are contacts with a certain interest.
  - name: markets
    description: A market is a place where leads can be offered and distributed to a group of sales partners.
  - name: forms
    description: Forms are named templates of leads. They consist of field lists with preconfigured fields.
  - name: preview
    description: |
      Have a preview look at these new operations.\
      They are not yet fully implemented and their interface might still be subject to change.\
      Production use is discouraged at the moment.
  - name: deprecated
    description: Operations which are about to be phased out in the near future.
  - name: sales-partners
    description: Manage your sales partner relationships.
paths:
  /test:
    get:
      operationId: test
      summary: Api access test
      description: |
        Use this operation to test your access to this api.
        If it responds with status 200, your access was successful.
      responses:
        "200":
          description: Access successful
          content:
            application/json:
              schema:
                type: string
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
      security:
        - apiKey: []
  /leads:
    post:
      operationId: createLead
      summary: Create a new lead.
      tags:
        - leads
      description: |
        A lead consists of two fieldlists:
        - prospect: A person or company along with contact information.
        - interest: The formulated interest of the prospect.

        A fieldlist is a collection of fields with an optional ordering, where each field consists of
        - an identifier - the name of the field,
        - a type, which describes syntax and semantic of the value,
        - the value of the field, which is a string-representation conforming to the given type.

        The field types are segmented in two classes:
        - generic types, which only describe the syntax of the value (e.g. 'text:singleline' or 'number:natural')
        - specific types, which additionally specify a semantic, on how to interpret the value (e.g. 'text:multiline:address')
      requestBody:
        $ref: "#/components/requestBodies/CreateLeadRequest"
      responses:
        "201":
          $ref: "#/components/responses/CreateLeadResponse"
        "400":
          $ref: "#/components/responses/400"
      security:
        - apiKey: []
    get:
      operationId: listLeads
      summary: List leads.
      description: |
        Use this operation to retrieve lists of leads that your company owns.\
        The owner of a lead is the creator of it.

        ### Continuation
        The amount of leads you can retrieve by a single request is limited.
        You can iterate through all your leads using a continuation token which you get with every response header.
        Use your previous query and add the returned continuation token to get the next set of results.
        Once you get an empty result you know that there are no more leads available.

        ### Sorting
        You may sort the results according to some sorting criteria in ascending or descending order.
        You can also sort by multiple fields.

        ### Filtering
        You may filter you list by some filter criteria.
        The most common use case is to filter by modified leads since the last time you fetched modified leads. (Incremental updates)
        - Example: GET /leads?modifiedAt=gte:2022-06-01

        ### FieldLists
        By default this operation returns meta data and transactional data of leads.
        So you will be able to tell when some lead has been modified as well as whether a lead has been won/lost or ist still in progress.\
        If you are interested in the field lists of your leads as well, use the "includeFieldLists" query parameter!

        ### Commissions
        A lead can be processed more than once — by several sales partners in turn or, with multi distribution, at the same time.
        Every item carries the **newest** processing (by startedAt) as the flat "commission" object, exactly as before,
        and additionally **all** processings of the lead as the "commissions" array, newest first, each element shaped like "commission".\
        A lead that has never been processed has no "commission" and an empty "commissions" array.\
        The array is additive and is being rolled out stage by stage; where it is not available yet, the field is absent.
        Integrations that only read "commission" keep working unchanged.
      tags:
        - leads
      parameters:
        - name: includeFieldLists
          in: query
          description: Whether field lists of leads shall be returned.
          required: false
          schema:
            type: boolean
            default: false
            example: true
        - name: sort
          in: query
          description: |
            Sort results by one or multiple fields.\
            \
            Only the following fields are supported:
            - modifiedAt
            - lead.leadId
            - lead.createdAt
            - lead.modifiedAt
            - commission.startedAt

            If you want to sort by multiple fields, list them comma-separated.\
            The sorting direction can by denoted by an (optional) '+' prefix for ascending order or a '-' prefix for descending order.
            - Example 1: sort=-modifiedAt   (sort by modifiedAt descending)
            - Example 2: sort=lead.createdAt,lead.leadId  (sort first by lead.createdAt ascending and second by lead.leadId ascending)

            Hint: Special characters need to be URL-encoded in query strings. Like '+' (%2B).
          required: false
          schema:
            type: string
        - name: modifiedAt
          in: query
          description: |
            Filter leads by field modifiedAt.\
            The filter expression consists of an (optional) operator followed by a colon (":") and an ISO8601 date-time.\
            \
            Available operations:
            - gte
            - gt
            - lte
            - lt
            - eq

            Syntax: [operation]:value\
            If operation is missing, then eq (equality) will be assumed.\
            Supports multiple filter expressions.\
            \
            Examples:
            - GET /leads?modifiedAt=2022-06-01
            - GET /leads?modifiedAt=gte:2022-06-01
            - GET /leads?modifiedAt=gte:2022-01-01&modifiedAt=lt:2023-01-1
          required: false
          explode: true
          style: form
          schema:
            type: array
            items:
              type: string
        - name: lead.createdAt
          in: query
          description: |
            Filter leads by field lead.createdAt.\
            The filter expression consists of an (optional) operator followed by a colon (":") and an ISO8601 date-time.\
            \
            Available operations:
            - gte
            - gt
            - lte
            - lt
            - eq

            Syntax: [operation]:value\
            If operation is missing, then eq (equality) will be assumed.\
            Supports multiple filter expressions.\
            \
            Examples:
            - GET /leads?lead.createdAt=2022-06-01
            - GET /leads?lead.createdAt=gte:2022-06-01
            - GET /leads?lead.createdAt=gte:2022-01-01&lead.createdAt=lt:2023-01-1
          required: false
          explode: true
          style: form
          schema:
            type: array
            items:
              type: string
        - name: commission.startedAt
          in: query
          description: |
            Filter leads by field commission.startedAt.\
            The filter expression consists of an (optional) operator followed by a colon (":") and an ISO8601 date-time.\
            \
            Available operations:
            - gte
            - gt
            - lte
            - lt
            - eq

            Syntax: [operation]:value\
            If operation is missing, then eq (equality) will be assumed.\
            Supports multiple filter expressions.\
            \
            Examples:
            - GET /leads?commission.startedAt=2022-06-01
            - GET /leads?commission.startedAt=gte:2022-06-01
            - GET /leads?commission.startedAt=gte:2022-01-01&commission.startedAt=lt:2023-01-1
          required: false
          explode: true
          style: form
          schema:
            type: array
            items:
              type: string
        - name: commission.responsible
          in: query
          description: |
            Filter leads by field commission.responsible.\
            \
            Available operations:
            - eq

            Syntax: [operation]:value\
            If operation is missing, then eq (equality) will be assumed.\
            \
            Example:
            - GET /leads?commission.responsible=urn:lt:sales-partners:sales-partner:740fc051-24eb-4a6a-b345-b8305c097269
          required: false
          explode: true
          style: form
          schema:
            type: array
            items:
              type: string
        - name: commission.responsibleName
          in: query
          description: |
            Filter leads by field commission.responsibleName.\
            \
            Available operations:
            - eq

            Syntax: [operation]:value\
            If operation is missing, then eq (equality) will be assumed.\
            \
            Example:
            - GET /leads?commission.responsibleName=SalespartnerCompanyName
          required: false
          explode: true
          style: form
          schema:
            type: array
            items:
              type: string
        - name: commission.stepName
          in: query
          description: |
            Filter leads by field commission.stepName.\
            \
            Available operations:
            - eq

            Syntax: [operation]:value\
            If operation is missing, then eq (equality) will be assumed.\
            \
            Example:
            - GET /leads?commission.stepName=Contact
          required: false
          explode: true
          style: form
          schema:
            type: array
            items:
              type: string
        - name: commission.closedAt
          in: query
          description: |
            Filter leads by field commission.closedAt.\
            The filter expression consists of an (optional) operator followed by a colon (":") and an ISO8601 date-time.\
            \
            Available operations:
            - gte
            - gt
            - lte
            - lt
            - eq

            Syntax: [operation]:value\
            If operation is missing, then eq (equality) will be assumed.\
            Supports multiple filter expressions.\
            \
            Examples:
            - GET /leads?commission.closedAt=2022-06-01
            - GET /leads?commission.closedAt=gte:2022-06-01
            - GET /leads?commission.closedAt=gte:2022-01-01&commission.closedAt=lt:2023-01-1
          required: false
          explode: true
          style: form
          schema:
            type: array
            items:
              type: string
        - $ref: "#/components/parameters/MaxResults"
        - $ref: "#/components/parameters/ContinuationToken"
      responses:
        "200":
          $ref: "#/components/responses/ListLeadsResponse"
      security:
        - apiKey: []
  /leads/{leadId}:
    get:
      operationId: getLead
      summary: Get a lead.
      tags:
        - leads
      description: Get a lead at its current state. (Consistently)
      parameters:
        - $ref: "#/components/parameters/leadId"
      responses:
        "200":
          $ref: "#/components/responses/GetLeadResponse"
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
      security:
        - apiKey: []
    patch:
      operationId: modifyLead
      summary: Modify a lead.
      description: |
        Modify the field lists of a lead. I.e. update contact information or add new/missing fields.\
        Only field lists given in the request body will be modified. A field list will be updated with all it's fields as a whole.
      tags:
        - leads
      parameters:
        - $ref: "#/components/parameters/leadId"
      requestBody:
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/Lead"
      responses:
        "204":
          description: Lead modified.
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
            Access-Control-Expose-Headers:
              $ref: "#/components/headers/Access-Control-Expose-Headers"
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
      security:
        - apiKey: []
  /leads/{leadId}/commissions:
    post:
      operationId: commissionToSalesPartner
      summary: Commission a lead to a sales partner.
      tags:
        - leads
      description: |
        This operation commissions the lead to the given sales partner directly.<br>
        It fails, if the lead has an active commission already.

        The operation is going to be dropped in future in favour of a new lead assignment mechanism to be announced.
      parameters:
        - $ref: "#/components/parameters/leadId"
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                salesPartnerId:
                  type: string
                  description: Id of the sales partner to commission the lead to.
                salesPipelineId:
                  type: string
                  description: Id of the sales pipeline to use.
              required:
                - salesPartnerId
      responses:
        "200":
          $ref: "#/components/responses/CommissionToSalesPartnerResponse"
        "400":
          $ref: "#/components/responses/400"
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
      security:
        - apiKey: []
  /leads/{leadId}/attachments:
    post:
      operationId: announceAttachmentUpload
      summary: Announce an attachment upload to a lead.
      description: |
        Uploading a file as an attachment to a lead consists of two steps.

        Step 1) Announce the upload. (This operation.)
        Step 2) Upload the file using a multipart/form-data POST request to the 'uploadUrl' along with the 'fields' you received from the response of step 1.

        See a code example on GitHub: https://github.com/leadtributor/examples/tree/master/attachment_upload
      tags:
        - leads
      parameters:
        - $ref: "#/components/parameters/leadId"
      requestBody:
        $ref: "#/components/requestBodies/AttachmentUploadRequest"
      responses:
        "200":
          $ref: "#/components/responses/AttachmentUploadResponse"
      security:
        - apiKey: []
  /leads/{leadId}/duplicates:
    get:
      operationId: getLeadDuplicates
      summary: Get duplicate candidates for a lead.
      description: |
        Returns a list of leads that are potential duplicates of the given lead.
        Each duplicate candidate contains a score between 0 (no match) and 100 (exact match)
        as well as a list of matches describing which criteria triggered the duplicate detection.

        ### Matching criteria
        - **email**: Exact, domain, and fuzzy email matching.
        - **name**: Fuzzy matching on first and last name.
        - **company**: Fuzzy company name matching.
        - **location**: Geographic proximity matching.
      tags:
        - leads
      parameters:
        - $ref: "#/components/parameters/leadId"
        - name: maxDistanceKm
          in: query
          description: Maximum distance in kilometers for location-based duplicate matching. Leads further apart than this threshold receive no location score.
          required: false
          schema:
            type: number
            minimum: 1
            default: 2
            example: 25
        - name: minScore
          in: query
          description: Minimum duplicate score (0–100) a candidate must reach to be included in the result.
          required: false
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 50
            example: 30
      responses:
        "200":
          description: Duplicate candidates returned.
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  required:
                    - leadId
                    - score
                    - matches
                  properties:
                    leadId:
                      type: string
                      format: uuid
                      description: Id of the potential duplicate lead.
                    leadName:
                      type: string
                      description: Display name of the potential duplicate lead.
                    score:
                      type: integer
                      minimum: 0
                      maximum: 100
                      description: Duplicate confidence score. 0 = no match, 100 = exact match.
                    matches:
                      type: array
                      description: List of criteria that contributed to the duplicate score.
                      items:
                        type: object
                        required:
                          - field
                          - type
                        properties:
                          field:
                            type: string
                            enum:
                              - email
                              - name
                              - company
                              - location
                            description: The field on which a match was detected.
                          type:
                            type: string
                            enum:
                              - exact
                              - domain
                              - fuzzy
                              - distance
                              - postalCode
                            description: The matching method used.
                          similarity:
                            type: number
                            minimum: 0
                            maximum: 1
                            description: Similarity score for fuzzy matches (0–1).
                          distanceKm:
                            type: number
                            minimum: 0
                            description: Distance in kilometers for location-based matches.
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
      security:
        - apiKey: []
  /leads/{leadId}/notes:
    get:
      operationId: listNotesOfLead
      summary: List notes of a lead.
      description: |
        Lists the notes of the journal to a lead.

        The notes, if any, will be returned in an ascending order by its creation date ascending.
      tags:
        - leads
      parameters:
        - $ref: "#/components/parameters/leadId"
      responses:
        "200":
          description: Notes returned.
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    noteId:
                      type: string
                      format: uuid
                    createdAt:
                      type: string
                      format: date-time
                    modifiedAt:
                      type: string
                      format: date-time
                    text:
                      type: string
                    intern:
                      type: boolean
                      default: false
                  required:
                    - noteId
                    - createdAt
                    - modifiedAt
                    - text
        "403":
          description: Forbidden
        "404":
          description: Lead not found
      security:
        - apiKey: []
    post:
      operationId: addNoteToLead
      summary: Add a note to a lead.
      description: |
        Adds a note to the journal of a lead.

        Only the owner of a lead can add notes to it.
      tags:
        - leads
      parameters:
        - $ref: "#/components/parameters/leadId"
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                text:
                  type: string
                  description: Text of the note.
                intern:
                  type: boolean
                  default: false
                  description: Whether the note is internal and only visible to your company.
              required:
                - text
      responses:
        "201":
          description: Note created.
          content:
            application/json:
              schema:
                type: object
                properties:
                  id:
                    type: string
                    format: uuid
                    description: Id of the created note.
                required:
                  - id
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
      security:
        - apiKey: []
  /markets/{marketId}/brokerages:
    post:
      operationId: offerLead
      summary: Offer a lead on a market.
      tags:
        - markets
      parameters:
        - $ref: "#/components/parameters/marketId"
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                leadId:
                  type: string
                  description: Id of the lead to be offered on the market.
              required:
                - leadId
      responses:
        "201":
          description: A brokerage has been started which distributes the lead to relevant sales partners.
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
            Access-Control-Expose-Headers:
              $ref: "#/components/headers/Access-Control-Expose-Headers"
          content:
            application/json:
              schema:
                type: object
                properties:
                  brokerageId:
                    type: string
                    description: Id of the brokerage.
        "400":
          $ref: "#/components/responses/400"
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
      security:
        - apiKey: []
  /forms:
    get:
      operationId: listForms
      summary: List forms.
      description: |
        Lists the forms defined by your company.
        Currently there can only be one form per company.
        It is the form that can be configured in the settings section of your company.
      tags:
        - forms
      responses:
        "200":
          $ref: "#/components/responses/ListFormsResponse"
      security:
        - apiKey: []
  /notes:
    get:
      operationId: listNotes
      summary: List notes of all leads.
      description: |
        Lists the notes of the journal for all leads.

        The notes will be returned in an ascending order by its creation date ascending.
      tags:
        - leads
      parameters:
        - name: modifiedSince
          in: query
          description: If given, filters notes by its last modification.
          schema:
            type: string
            format: date-time
        - $ref: "#/components/parameters/MaxResults"
        - $ref: "#/components/parameters/ContinuationToken"
      responses:
        "200":
          description: Notes returned.
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  properties:
                    noteId:
                      type: string
                      format: uuid
                    leadId:
                      type: string
                      format: uuid
                    createdAt:
                      type: string
                      format: date-time
                    modifiedAt:
                      type: string
                      format: date-time
                    text:
                      type: string
                    intern:
                      type: boolean
                      default: false
                  required:
                    - noteId
                    - leadId
                    - createdAt
                    - modifiedAt
                    - text
      security:
        - apiKey: []
  /webhooks:
    post:
      operationId: subscribeWebhook
      summary: Subscribe webhook.
      tags:
        - webhooks
      requestBody:
        content:
          application/json:
            schema:
              type: object
              properties:
                url:
                  type: string
                  description: The url to which events are being pushed.
                eventName:
                  type: string
                  description: The name of the event to be subscribed to.
                apiKey:
                  type: string
                  description: The api key used for authenticating when pushing to the provided url. (OPTIONAL)
                description:
                  type: string
                  description: A description for the webhook. (OPTIONAL)
              required:
                - url
                - eventName
      responses:
        "200":
          description: A subscription for the event has been successfully created. Events are being pushed to the provided targetUrl.
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
            Access-Control-Expose-Headers:
              $ref: "#/components/headers/Access-Control-Expose-Headers"
          content:
            application/json:
              schema:
                type: object
                properties:
                  hookId:
                    type: string
                    description: The Id of the hook, which is needed to unsubscribe later
                    format: uuid
        "400":
          $ref: "#/components/responses/400"
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
      security:
        - apiKey: []
  /webhooks/{hookId}:
    delete:
      operationId: unsubscribeWebhook
      summary: Unsubscribe webhook for hookId.
      tags:
        - webhooks
      parameters:
        - $ref: "#/components/parameters/hookId"
      responses:
        "204":
          description: The subscription for the event has been successfully deleted.
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
            Access-Control-Expose-Headers:
              $ref: "#/components/headers/Access-Control-Expose-Headers"
        "400":
          $ref: "#/components/responses/400"
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
      security:
        - apiKey: []
  /webhookEvents/{eventName}:
    get:
      operationId: listWebhooksForEventName
      summary: Gets the last 100 webhookEvents for your company for the given "eventName".
      tags:
        - webhooks
      parameters:
        - $ref: "#/components/parameters/eventName"
      responses:
        "200":
          description: The last 100 webhookEvents.
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
            Access-Control-Expose-Headers:
              $ref: "#/components/headers/Access-Control-Expose-Headers"
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
        "400":
          $ref: "#/components/responses/400"
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
      security:
        - apiKey: []
  /sales-partners:
    post:
      operationId: inviteSalesPartner
      summary: Invite a new sales partner.
      tags:
        - sales-partners
      description: |
        Sends an email invitation to a potential sales partner.
        The invited party must accept the invitation before the partnership becomes active.
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
                - email
              properties:
                email:
                  type: string
                  format: email
                  description: Email address of the person to invite.
                name:
                  type: string
                  description: Name of the partner company or contact person. (OPTIONAL)
                text:
                  type: string
                  description: Personal invitation message. (OPTIONAL)
                tags:
                  type: array
                  items:
                    type: string
                  description: Tags to assign to the partner. (OPTIONAL)
                attributes:
                  type: object
                  additionalProperties:
                    type: string
                  description: Custom key-value attributes. (OPTIONAL)
      responses:
        "201":
          description: Invitation sent. The sales partner is created with status PENDING.
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
            Access-Control-Expose-Headers:
              $ref: "#/components/headers/Access-Control-Expose-Headers"
          content:
            application/json:
              schema:
                type: object
                properties:
                  id:
                    type: string
                    format: uuid
        "400":
          $ref: "#/components/responses/400"
        "403":
          $ref: "#/components/responses/403"
      security:
        - apiKey: []
    get:
      operationId: listSalesPartners
      summary: List your sales partners.
      tags:
        - sales-partners
      parameters:
        - name: status
          in: query
          description: Filter by status. Defaults to ACTIVE and PENDING:INVITED.
          schema:
            type: array
            items:
              type: string
              enum:
                - ACTIVE
                - PENDING:INVITED
                - ENDED
          style: form
          explode: true
      responses:
        "200":
          description: List of sales partners.
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
            Access-Control-Expose-Headers:
              $ref: "#/components/headers/Access-Control-Expose-Headers"
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: "#/components/schemas/SalesPartner"
        "403":
          $ref: "#/components/responses/403"
      security:
        - apiKey: []
  /sales-partners/{salesPartnerId}:
    get:
      operationId: getSalesPartner
      summary: Get a sales partner by ID.
      tags:
        - sales-partners
      parameters:
        - $ref: "#/components/parameters/salesPartnerId"
      responses:
        "200":
          description: Sales partner.
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
            Access-Control-Expose-Headers:
              $ref: "#/components/headers/Access-Control-Expose-Headers"
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SalesPartner"
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
      security:
        - apiKey: []
    patch:
      operationId: modifySalesPartner
      summary: Update tags and attributes of a sales partner.
      tags:
        - sales-partners
      parameters:
        - $ref: "#/components/parameters/salesPartnerId"
        - name: x-serial
          in: header
          description: Current serial for optimistic locking.
          required: false
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                tags:
                  type: array
                  items:
                    type: string
                attributes:
                  type: object
                  additionalProperties:
                    type: string
      responses:
        "204":
          description: Sales partner updated.
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
            Access-Control-Expose-Headers:
              $ref: "#/components/headers/Access-Control-Expose-Headers"
        "400":
          $ref: "#/components/responses/400"
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
        "409":
          $ref: "#/components/responses/409"
      security:
        - apiKey: []
    delete:
      operationId: deleteSalesPartner
      summary: Delete a sales partner.
      tags:
        - sales-partners
      description: |
        Permanently removes a sales partner record.
        Only allowed when the partner status is ENDED, PENDING, or DECLINED.
        To end an active partnership first, use POST /sales-partners/{id}/end.
      parameters:
        - $ref: "#/components/parameters/salesPartnerId"
        - name: x-serial
          in: header
          description: Current serial for optimistic locking.
          required: false
          schema:
            type: integer
      responses:
        "204":
          description: Sales partner deleted.
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
            Access-Control-Expose-Headers:
              $ref: "#/components/headers/Access-Control-Expose-Headers"
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
        "409":
          $ref: "#/components/responses/409"
      security:
        - apiKey: []
  /sales-partners/{salesPartnerId}/end:
    post:
      operationId: endSalesPartner
      summary: End an active sales partner relationship.
      tags:
        - sales-partners
      description: |
        Terminates an active partnership. The sales partner status changes to ENDED.
        After ending, the record can be deleted via DELETE /sales-partners/{id}.
      parameters:
        - $ref: "#/components/parameters/salesPartnerId"
        - name: x-serial
          in: header
          description: Current serial for optimistic locking.
          required: false
          schema:
            type: integer
      responses:
        "204":
          description: Partnership ended.
          headers:
            Access-Control-Allow-Origin:
              $ref: "#/components/headers/Access-Control-Allow-Origin"
            Access-Control-Allow-Headers:
              $ref: "#/components/headers/Access-Control-Allow-Headers"
            Access-Control-Expose-Headers:
              $ref: "#/components/headers/Access-Control-Expose-Headers"
        "400":
          $ref: "#/components/responses/400"
        "403":
          $ref: "#/components/responses/403"
        "404":
          $ref: "#/components/responses/404"
        "409":
          $ref: "#/components/responses/409"
      security:
        - apiKey: []
components:
  securitySchemes:
    apiKey:
      type: apiKey
      name: Authorization
      in: header
  headers:
    Access-Control-Allow-Origin:
      schema:
        type: string
    Access-Control-Allow-Headers:
      schema:
        type: string
    Access-Control-Expose-Headers:
      schema:
        type: string
    ContinuationToken:
      description: Continuation token to retrieve further results.
      schema:
        type: string
    Total:
      description: Total number of results.
      schema:
        type: number
        minimum: 0
  parameters:
    leadId:
      name: leadId
      in: path
      description: Id of a lead.
      required: true
      schema:
        type: string
    marketId:
      name: marketId
      in: path
      description: Id of a market.
      required: true
      schema:
        type: string
    eventName:
      name: eventName
      in: path
      description: Name of the event.
      required: true
      schema:
        type: string
        enum:
          - LeadCreated
          - LeadDeleted
          - LeadClosed
          - SalesPartnerInvitationAccepted
          - SalesPartnerEnded
          - LeadAssignedDirectly
          - LeadOfferCreatedEvent
          - LeadOfferAcceptedEvent
          - BrokerageFailedEvent
    hookId:
      name: hookId
      in: path
      description: Id of the hook, i.e. the webhook-subscription.
      required: true
      schema:
        type: string
    salesPartnerId:
      name: salesPartnerId
      in: path
      description: Id of the sales partner.
      required: true
      schema:
        type: string
        format: uuid
    MaxResults:
      name: maxResults
      in: query
      description: Max. number of results to retrieve.
      required: false
      schema:
        type: number
        minimum: 1
        maximum: 100
        default: 100
    ContinuationToken:
      name: continuation
      in: query
      description: Continuation token. Used to resume retrieval of large lists.
      required: false
      schema:
        type: string
  requestBodies:
    CreateLeadRequest:
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Lead"
          examples:
            minimalistic:
              summary: Absolute minimalistic lead.
              value: |
                {
                  "prospect": { "fields": {} },
                  "interest": { "fields": {} }
                }
            typical:
              summary: Small but typical lead.
              value: |
                {
                  "prospect": {
                    "fields": {
                      "Anrede": {
                        "type": "text:singleline:salutation",
                        "value": "Herr"
                      },
                      "Vorname": {
                        "type": "text:singleline:firstname",
                        "value": "Max"
                      },
                      "Nachname": {
                        "type": "text:singleline:lastname",
                        "value": "Mustermann"
                      },
                      "Anschrift": {
                        "type": "text:multiline:address",
                        "value": "Musterstraße 1a 12345 Musterstadt"
                      }
                    },
                    "fieldOrder": [ "Anrede", "Vorname", "Nachname", "Anschrift" ]
                  },
                  "interest": {
                    "fields": {
                      "Kundenanfrage": {
                        "type": "text:multiline",
                        "value": "Der Interessent wünscht Kontaktaufnahme!"
                      }
                    }
                  }
                }
    AttachmentUploadRequest:
      content:
        application/json:
          schema:
            type: object
            properties:
              filename:
                type: string
                description: Name of the file.
                minLength: 3
                pattern: ^[^\\\/\:\?\"<>|\+]+\.[^\\\/\:\?\"<>|\+]+$
                example: quotation.pdf
              contentType:
                type: string
                description: Mime type of the file.
                example: application/pdf
            required:
              - filename
              - contentType
            additionalProperties: false
          example:
            filename: quotation.pdf
            contentType: application/pdf
  responses:
    "400":
      description: Bad request
      headers:
        Access-Control-Allow-Origin:
          $ref: "#/components/headers/Access-Control-Allow-Origin"
        Access-Control-Allow-Headers:
          $ref: "#/components/headers/Access-Control-Allow-Headers"
      content:
        application/json:
          schema:
            type: object
            properties:
              message:
                type: string
                description: Human-readable error message.
              errors:
                type: array
                description: List of validation errors (present instead of message for request validation failures).
                items:
                  type: object
                  properties:
                    message:
                      type: string
    "403":
      description: Forbidden
      headers:
        Access-Control-Allow-Origin:
          $ref: "#/components/headers/Access-Control-Allow-Origin"
        Access-Control-Allow-Headers:
          $ref: "#/components/headers/Access-Control-Allow-Headers"
      content:
        text/plain:
          schema:
            type: string
    "404":
      description: Not found
      headers:
        Access-Control-Allow-Origin:
          $ref: "#/components/headers/Access-Control-Allow-Origin"
        Access-Control-Allow-Headers:
          $ref: "#/components/headers/Access-Control-Allow-Headers"
      content:
        text/plain:
          schema:
            type: string
    "409":
      description: Conflict - optimistic lock failure
      headers:
        Access-Control-Allow-Origin:
          $ref: "#/components/headers/Access-Control-Allow-Origin"
        Access-Control-Allow-Headers:
          $ref: "#/components/headers/Access-Control-Allow-Headers"
      content:
        text/plain:
          schema:
            type: string
    CreateLeadResponse:
      description: Lead created.
      headers:
        Access-Control-Allow-Origin:
          $ref: "#/components/headers/Access-Control-Allow-Origin"
        Access-Control-Allow-Headers:
          $ref: "#/components/headers/Access-Control-Allow-Headers"
      content:
        application/json:
          schema:
            type: object
            properties:
              id:
                type: string
                description: Id of the created lead.
            required:
              - id
    ListLeadsResponse:
      description: Leads returned.
      headers:
        Access-Control-Allow-Origin:
          $ref: "#/components/headers/Access-Control-Allow-Origin"
        Access-Control-Allow-Headers:
          $ref: "#/components/headers/Access-Control-Allow-Headers"
      content:
        application/json:
          schema:
            type: array
            items:
              type: object
              required:
                - lead
                - modifiedAt
              properties:
                lead:
                  type: object
                  required:
                    - leadId
                    - owner
                    - fieldLists
                    - createdAt
                    - modifiedAt
                    - serial
                  properties:
                    leadId:
                      type: string
                      format: uuid
                    owner:
                      type: string
                      format: urn
                      description: Who owns the lead.
                    fieldLists:
                      type: object
                      properties:
                        prospect:
                          $ref: "#/components/schemas/FieldList"
                        interest:
                          $ref: "#/components/schemas/FieldList"
                    createdAt:
                      type: string
                      format: date-time
                      description: Creation time of lead.
                    modifiedAt:
                      type: string
                      format: date-time
                      description: Last modification of lead.
                    serial:
                      type: number
                      minimum: 1
                commission:
                  $ref: "#/components/schemas/Commission"
                commissions:
                  type: array
                  description: |
                    All processings of the lead, newest first; each element is shaped like "commission", and the first one is
                    the same processing. Empty for a lead that has never been processed. Additive and rolled out stage by
                    stage — where not available yet, the field is absent.
                  items:
                    $ref: "#/components/schemas/Commission"
                modifiedAt:
                  type: string
                  format: date-time
                  description: Last modification of lead or its latest commission.
    GetLeadResponse:
      description: Lead returned.
      headers:
        Access-Control-Allow-Origin:
          $ref: "#/components/headers/Access-Control-Allow-Origin"
        Access-Control-Allow-Headers:
          $ref: "#/components/headers/Access-Control-Allow-Headers"
        Access-Control-Expose-Headers:
          $ref: "#/components/headers/Access-Control-Expose-Headers"
      content:
        application/json:
          schema:
            $ref: "#/components/schemas/Lead"
    AttachmentUploadResponse:
      description: Attachment upload successfully announced.
      content:
        application/json:
          schema:
            type: object
            properties:
              uploadUrl:
                type: string
                format: url
                description: Upload url. Use this url to PUT your file to. This url is temporary and will expire in 5 minutes.
              fields:
                type: object
                description: A map of form fields which need to be sent along with the file upload in a form-data POST to the returned uploadUrl. These fields hold the request credentials.
                additionalProperties:
                  type: string
            example:
              url: https://s3.eu-central-1.amazonaws.com/attachment-service-attachmentsbucket-erfo3wwvll2c
              fields:
                key: quotation.pdf
                bucket: bucket-name to upload
                Policy: some policy
    ListFormsResponse:
      description: Forms returned.
      headers:
        Access-Control-Allow-Origin:
          $ref: "#/components/headers/Access-Control-Allow-Origin"
        Access-Control-Allow-Headers:
          $ref: "#/components/headers/Access-Control-Allow-Headers"
      content:
        application/json:
          schema:
            items:
              $ref: "#/components/schemas/Form"
    CommissionToSalesPartnerResponse:
      description: Lead commissioned to sales partner.
      headers:
        Access-Control-Allow-Origin:
          $ref: "#/components/headers/Access-Control-Allow-Origin"
        Access-Control-Allow-Headers:
          $ref: "#/components/headers/Access-Control-Allow-Headers"
      content:
        application/json:
          schema:
            type: object
            properties:
              commissionId:
                type: string
                description: Id of the created commission.
            required:
              - commissionId
  schemas:
    SalesPartner:
      type: object
      properties:
        id:
          type: string
          format: uuid
        serial:
          type: integer
        status:
          type: string
          enum:
            - ACTIVE
            - PENDING:INVITED
            - ENDED
            - DELETED
            - DECLINED
        name:
          type: string
        invitedAt:
          type: string
          format: date-time
        activatedAt:
          type: string
          format: date-time
        tags:
          type: array
          items:
            type: string
        attributes:
          type: object
          additionalProperties:
            type: string
        invitation:
          type: object
          description: Present only when status is PENDING:INVITED.
          properties:
            email:
              type: string
              format: email
            name:
              type: string
            text:
              type: string
        partnerCompany:
          type: object
          description: Present once the partner has accepted and their company is known.
          properties:
            name:
              type: string
            address:
              type: string
            contactEmail:
              type: string
              format: email
    Lead:
      type: object
      properties:
        prospect:
          $ref: "#/components/schemas/FieldList"
        interest:
          $ref: "#/components/schemas/FieldList"
    Form:
      type: object
      properties:
        id:
          type: string
        serial:
          type: integer
          format: int64
        name:
          type: string
          description: Name of the form.
        description:
          type: string
          description: A description of the form. It could describe a usage scenario for when a respective form would be useful, e.g.
        owner:
          type: string
          description: Urn of the owner of the form.
        definition:
          $ref: "#/components/schemas/FormDefinition"
      required:
        - id
        - serial
        - name
        - owner
        - definition
    FormDefinition:
      type: object
      properties:
        prospect:
          $ref: "#/components/schemas/FieldList"
        interest:
          $ref: "#/components/schemas/FieldList"
    Commission:
      type: object
      description: One processing of a lead by a sales partner. As the flat "commission" of a lead it is the newest processing (by startedAt), absent when the lead has never been processed.
      required:
        - commissionId
        - responsible
        - step
        - stepName
        - startedAt
        - serial
      properties:
        commissionId:
          type: string
          format: uuid
        responsible:
          type: string
          format: urn
          description: Who has been commissioned/assigned to process the lead.
        responsibleName:
          type: string
          description: The name of who has been commissioned/assigned to process the lead.
        step:
          type: number
          minimum: 0
          description: The current step within the lead processing pipeline. (Zero indexed)
        stepName:
          type: string
          minimum: 0
          description: The name of the current step within the lead processing pipeline.
        startedAt:
          type: string
          format: date-time
          description: Moment when the lead processing has been started.
        modifiedAt:
          type: string
          format: date-time
          description: Last modification of the lead processing.
        closedAt:
          type: string
          format: date-time
          description: Moment when the lead processing has been closed with an outcome.
        outcome:
          type: string
          description: The outcome of lead processing when it has been finished.
          enum:
            - WON
            - LOST
        serial:
          type: number
          minimum: 1
    FieldList:
      type: object
      properties:
        fields:
          type: object
          additionalProperties:
            $ref: "#/components/schemas/Field"
        fieldOrder:
          type: array
          description: Ordering of fields to be displayed.
          items:
            type: string
        required:
          type: array
          description: Fields which are required to be filled.
          items:
            type: string
      required:
        - fields
    Field:
      type: object
      properties:
        type:
          type: string
          enum:
            - text:singleline:salutation
            - text:singleline:firstname
            - text:singleline:lastname
            - text:singleline:company
            - text:singleline:email
            - text:singleline:phone
            - text:singleline
            - text:multiline
            - text:multiline:address
            - text:hyperlink
            - text:list
            - number:natural
            - bool:indeterminate
            - bool:determinate
        value:
          oneOf:
            - type: string
            - type: boolean
            - type: array
              items:
                type: string
      required:
        - type
        - value
