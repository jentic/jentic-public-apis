  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Any username (use api) and your API key as the password: curl --user api:YOUR_API_KEY. The key as the username with an empty password also works."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization: Bearer YOUR_API_KEY"
      }
    },
    "headers": {
      "Request-Id": {
        "description": "Identifier of this request; quote it when asking for support.",
        "schema": {
          "type": "string"
        }
      },
      "Cache-Control": {
        "description": "Always no-store.",
        "schema": {
          "type": "string"
        }
      },
      "Original-Size": {
        "description": "Size of the uploaded image in bytes.",
        "schema": {
          "type": "integer"
        }
      },
      "Compressed-Size": {
        "description": "Size of the returned image in bytes (equal to Original-Size when compression could not help).",
        "schema": {
          "type": "integer"
        }
      },
      "Compression-Count": {
        "description": "Compressions used by the account in the current UTC day, including this one when it succeeded. Sent on every response after the key was accepted.",
        "schema": {
          "type": "integer"
        }
      },
      "Compression-Limit": {
        "description": "The account's daily limit (100 on the free plan).",
        "schema": {
          "type": "integer"
        }
      },
      "Compression-Reset": {
        "description": "When the daily count starts over: the next 00:00 UTC, e.g. 2026-09-18T00:00:00Z.",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "Retry-After": {
        "description": "Seconds to wait before retrying. Without this header, do not retry.",
        "schema": {
          "type": "integer"
        }
      },
      "WWW-Authenticate": {
        "description": "Always Basic realm=\"compresso API\".",
        "schema": {
          "type": "string"
        }
      },
      "Allow": {
        "description": "Methods this endpoint accepts.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "ok",
          "error",
          "message",
          "docs",
          "request_id"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string",
            "enum": [
              "https_required",
              "input_missing",
              "invalid_multipart",
              "invalid_image",
              "unauthorized",
              "browser_not_supported",
              "not_found",
              "method_not_allowed",
              "file_too_large",
              "image_too_large",
              "unsupported_format",
              "animated_unsupported",
              "daily_limit_exceeded",
              "rate_limited",
              "server_busy",
              "daily_capacity_reached",
              "api_disabled",
              "compress_failed"
            ]
          },
          "message": {
            "type": "string",
            "description": "What happened and what to do."
          },
          "docs": {
            "type": "string",
            "format": "uri"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "Usage": {
        "type": "object",
        "required": [
          "ok",
          "plan",
          "compression_count",
          "compression_limit",
          "compression_reset",
          "key"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "plan": {
            "type": "string",
            "examples": [
              "free"
            ]
          },
          "compression_count": {
            "type": "integer",
            "description": "Compressions used today (UTC)."
          },
          "compression_limit": {
            "type": "integer",
            "description": "Daily limit."
          },
          "compression_reset": {
            "type": "string",
            "format": "date-time",
            "description": "Next 00:00 UTC."
          },
          "key": {
            "type": "string",
            "description": "The key used for this request, masked.",
            "examples": [
              "csk_…abcd"
            ]
          }
        }
      }
    }
