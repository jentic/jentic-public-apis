                  "api_disabled": {
                    "value": {
                      "ok": false,
                      "error": "api_disabled",
                      "message": "The API is temporarily disabled. Retry later.",
                      "docs": "https://compresso.space/developers#error-api_disabled",
                      "request_id": "3f2c9a8b7d6e5f4a3b2c1d0e9f8a7b6c"
                    }
                  }
                }
              }
            }
          }
        }
      }
