      "delete": {
        "summary": "Delete a template",
        "description": "Deletes the template. Refused with 409 while an active or paused automation has a step using it (the message lists them), so a live sequence cannot lose a step's body; delete those automations or set them to draft first. Campaigns carry their own html and never block it. Once deleted, a later send naming it is refused, and a draft automation step naming it fails each enrolment that reaches it after the automation is activated.",
        "x-required-scope": "templates:write",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
