      "post": {
        "summary": "Create a segment",
        "description": "Saves a named filter over one audience; nothing is evaluated yet. topic_key must name an existing topic (422 unknown_topic), but filter property keys are not checked against what exists, so call GET /v1/segments/{id}/metrics afterwards to confirm it matches who you expect. Keep the returned id: campaigns take it as segment_id. Rules that were not set are null, or [] for the list rules.",
        "x-required-scope": "contacts:write",
        "requestBody": {
          "required": true,
          "content": {
