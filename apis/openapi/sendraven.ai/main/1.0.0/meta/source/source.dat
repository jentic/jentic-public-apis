      "post": {
        "summary": "Create or update a topic",
        "description": "Creates the topic, or updates the one with this key (201 new, 200 updated), in one write. On an update name is replaced, and description and default_subscribed change only when sent; description: null clears it. The defaults (default_subscribed true, no description) apply only on creation. Default-on suits a newsletter people already expect; default-off suits anything a person should ask for. Changing default_subscribed on an existing topic moves everyone who never chose, so send it on an update only when that is what you mean.",
        "x-required-scope": "contacts:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "key",
                  "name"
                ],
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$",
                    "description": "Lower-case letters, digits and hyphens."
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "description": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 300,
                    "description": "null clears it on an existing topic."
                  },
                  "default_subscribed": {
                    "type": "boolean",
                    "description": "Whether someone with no recorded preference receives this topic. true on creation when left out; unchanged on update."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated: the stored topic.",
