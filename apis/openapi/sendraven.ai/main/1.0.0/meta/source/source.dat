    "/v1/threads/{id}/handled": {
      "post": {
        "summary": "Mark a conversation as handled",
        "description": "Clears awaiting_reply without sending and stamps handled_at. For the message that needs no answer (\"thanks, all sorted\"); do not send a courtesy reply just to clear the flag, that mails a person for bookkeeping. The next received message that is not automated sets awaiting_reply again. Calling it on a handled thread succeeds and moves handled_at to now. No body.",
        "x-required-scope": "emails:send",
