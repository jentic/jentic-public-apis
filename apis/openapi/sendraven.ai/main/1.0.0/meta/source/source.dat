                }
              }
            }
          },
          "429": {
            "description": "daily_limit: an API key with a daily_send_limit that has not paid for this campaign, and the addresses still pending would take it past today's limit. The campaign stays paused. Also rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
