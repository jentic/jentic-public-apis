    "/v1/contact-properties/{key}": {
      "delete": {
        "summary": "Delete a contact property",
        "description": "Removes the definition only. Values stay in every contact's attributes and segment filters on the key keep working; new values are no longer coerced, and an import carrying the key recreates it as string. A key no property has is 404 not_found.",
        "x-required-scope": "contacts:write",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The property's key, matched exactly (case-sensitive)."
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "key",
                    "deleted",
                    "values_kept"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "deleted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "values_kept": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  }
                }
              }
            }
          },
