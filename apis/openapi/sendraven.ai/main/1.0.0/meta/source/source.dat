                  "email"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120,
                    "description": "Matched exactly against each automation's trigger.event_name."
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "A single address. Trimmed."
