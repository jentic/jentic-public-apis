    "/v1/contacts": {
      "get": {
        "summary": "Find contacts across every audience",
        "description": "Answers \"is this address on any of our lists, and is it subscribed?\" without knowing the list. Pass email for one address: the response is still a list, with the contact or an empty data array; take its id for every other contact call. Newest first by created_at, then id. Page by passing next_cursor back as cursor while has_more is true, and send the same filters with every page. The cursor is the last row's creation time and id (not base64); treat it as opaque and URL-encode it. An email address as cursor, the format this endpoint used to return, still continues after that contact.",
        "x-required-scope": "contacts:read",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "An exact address, trimmed and lower-cased before matching. Takes precedence over q."
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The start of an address (q=ana matches ana@ and anabel@), case-insensitive. Prefix only, not a contains search."
          },
          {
            "name": "unsubscribed",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "true for only opted-out contacts, false for only subscribed ones. Any other value is ignored."
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": true,
            "description": "Repeatable: ?tag=vip&tag=beta returns people carrying both. Normalised like tags on write, so VIP matches vip."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Page size. A larger value is capped at 100, a fraction is rounded down, and zero, a negative or a non-number falls back to 50. None of these is an error."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The next_cursor from the previous page, unchanged (it has the form <created_at>|<id>). An unreadable cursor, or an address that is not a contact, returns the first page."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of contacts, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "object",
                    "data",
