    "/v1/automations/{id}/enroll": {
      "post": {
        "summary": "Enrol someone in an automation",
        "description": "Puts one address into the sequence; the first step is due delay_minutes after enrolment. Works for any active automation whatever its trigger kind, and the address needs no contact record (though without one it has no tags, so required_tags keep it out). Outcomes: 201 enrolled. 200 enrolled false with reason already_enrolled: safe to retry. 200 with previously_enrolled: the automation's reenrollment is never and this person has already been through it. 200 with suppressed, unsubscribed_from_topic, exit_tag or required_tag_missing: deliberately excluded by an automatic exit; do not work around it. 409 invalid_state with reason not_active, no_steps or topic_missing: the automation cannot take anyone until its definition or status is fixed; retrying will not help. Checks run in the order not_active, no_steps, suppressed, topic_missing, unsubscribed_from_topic, tag rules, previously_enrolled, already_enrolled. The calling key's guardrails decide whether it may enrol at all: a key that holds its sends for approval is refused outright (the steps would later send with no approval), and a key with a recipient allowlist may only enrol addresses on it. The key's daily cap is not checked and later steps do not count against it.",
        "x-required-scope": "emails:send",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The automation's id from GET /v1/automations (a UUID), not its name or slug."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Replaying the same key on the same path in this workspace within 24 hours returns the stored response, with an Idempotent-Replay: true header, instead of acting again. Only successful responses are stored, so a failed request can be fixed and retried under the same key. The body is compared (key order ignored): the same key with a different body is 422 idempotency_key_reused, so use a new key for every new request. Use an unguessable value such as a UUID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "A single address. Trimmed; stored lower-cased."
                  },
                  "variables": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "String values for the {{placeholders}} in the steps' subjects, inline bodies and templates, e.g. { \"name\": \"Ana\" }. Every value must be a string; a number is a 422. A placeholder with no value is not checked now: it fails that person's enrolment when the step comes due.",
                    "default": {}
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Not enrolled: enrolled false with reason (already enrolled, previously enrolled, or deliberately excluded) and enrollment null",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomationEnrollResult"
                }
              }
            }
          },
          "201": {
            "description": "Enrolled: enrolled true, reason null, with the enrollment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomationEnrollResult"
                }
              }
            }
          },
          "400": {
            "description": "invalid_json: the request body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the calling key holds its sends for approval, so it cannot enrol anyone; use a key without the hold. recipient_not_allowed: the key has a recipient allowlist and email is not on it. Checked after the body is valid. Also forbidden: the key lacks the emails:send scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found: no automation with this id in the workspace. A name or slug also 404s, with a message giving the id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "invalid_state: the automation cannot enrol anyone. The body carries enrolled false, reason (not_active, no_steps or topic_missing) and enrollment null alongside the error object. Also idempotency_in_progress: a request with the same Idempotency-Key was still running on this path after waiting up to 8 seconds for it (a retry that finds it finished receives its response instead). Retry after a short wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomationEnrollConflict"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large: the body is larger than this endpoint accepts (5 MB unless stated).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "invalid_request: email is missing or not an address, or variables is not an object of strings. The message names each field that failed and details lists them. Also idempotency_key_reused: this Idempotency-Key was already used on this path with a different request body (checked right after the scope, so a credential without the scope gets 403 instead, and answered at once even while the first request is still running). Do not retry; send the new request under a new key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "post": {
        "summary": "Emit an event",
        "description": "Enrols the address in every active automation whose trigger is event with event_name equal to name (exact, case-sensitive), just as enrolling directly would: each automation's exits still apply and nobody is enrolled twice. One call from your app, such as trial_started, instead of it knowing which sequences exist. Events are not stored: one nothing waits for does nothing and is not an error, and an automation created later is not started by earlier events. Guardrails are checked before any automation is looked up: a key that holds its sends for approval cannot record events, and a key with a recipient allowlist only for addresses on it. The key's daily cap is not checked. Check GET /v1/automations/{id} when automations_started is lower than expected.",
