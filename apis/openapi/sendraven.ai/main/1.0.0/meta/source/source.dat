    "/v1/threads": {
      "get": {
        "summary": "List conversations",
        "description": "Threads, most recently active first by last_message_at, cursor-paged. Pass awaiting_reply=true for the threads where someone has written to you and nobody has answered: the query to poll when deciding what needs work. Skip the ones with pending_reply true, whose answer is already held or scheduled. The cursor is anchored on last_message_at, so a thread that gets new mail while you page jumps to the top and is not returned again further down; start from the first page to catch it. Marketing mail and campaigns never start or join a thread.",
        "x-required-scope": "threads:read",
        "parameters": [
          {
            "name": "awaiting_reply",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "description": "true for threads waiting on an answer, false for the rest. Only these exact strings filter; any other value is ignored (not an error) and every thread is returned."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Page size. A larger value is capped at 100, a fraction is rounded down, and zero, a negative or a non-number falls back to 50. None of these is an error."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The next_cursor from the previous page, passed back unchanged. An unreadable cursor returns the first page."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of threads.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "object",
                    "data",
                    "has_more",
                    "next_cursor"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "list"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Thread"
                      }
                    },
                    "has_more": {
                      "type": "boolean",
                      "description": "True when another page exists; pass next_cursor back as cursor."
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
