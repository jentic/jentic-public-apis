    "/v1/webhook-endpoints/{id}": {
      "patch": {
        "summary": "Update a webhook endpoint",
        "description": "Changes the URL, events or enabled state; fields left out are unchanged, unknown fields ignored, and events replaces the whole list. The secret stays the same. enabled: false stops new deliveries and records retries that fall due as failed attempts (\"endpoint removed or disabled\"); deliveries with attempts left are retried again once re-enabled. A new url must be a public http or https address on an allowed port, as on creation. The endpoint is looked up before the body is validated.",
        "x-required-scope": "webhooks:write",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The webhook endpoint's id from GET /v1/webhook-endpoints (a UUID), not its URL."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "An absolute, public http or https URL."
                  },
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "inbound",
                        "send",
                        "delivery",
                        "bounce",
                        "complaint",
                        "reject",
                        "open",
                        "click",
                        "rendering_failure",
                        "delivery_delay"
                      ]
                    }
                  },
                  "enabled": {
                    "type": "boolean",
                    "description": "false pauses deliveries, true resumes them."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The endpoint as stored after the update, without its secret.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpoint"
