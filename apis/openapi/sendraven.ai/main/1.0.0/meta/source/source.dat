    "/v1/audiences/{id}/contacts/{contact_id}": {
      "delete": {
        "summary": "Remove a contact from an audience",
        "description": "Takes one person off this list. The contact still exists and keeps their other audiences, tags, attributes, history, suppressions and topic preferences; to forget the person, use DELETE /v1/contacts/{id}. Membership is not checked: removing someone who was not on the list still answers 200 with removed: true. Active automation enrolments are not ended.",
        "x-required-scope": "contacts:write",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The audience's id from GET /v1/audiences (a UUID), not its name."
          },
          {
            "name": "contact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The contact's id from GET /v1/contacts?email= (a UUID), not the email address. An address answers 404, and when it belongs to a contact in the workspace the message gives that contact's id."
          }
        ],
        "responses": {
          "200": {
