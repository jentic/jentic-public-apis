        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Replaying the same key on the same path in this workspace within 24 hours returns the stored response, with an Idempotent-Replay: true header, instead of acting again. Only successful responses are stored, so a failed request can be fixed and retried under the same key. The body is compared (key order ignored): the same key with a different body is 422 idempotency_key_reused, so use a new key for every new request. Use an unguessable value such as a UUID."
          }
        ]
      }
    },
    "/v1/topics/{key}/import": {
      "post": {
        "summary": "Import topic preferences in bulk",
        "description": "Sets the same preference for up to 50,000 addresses on one topic, overwriting what they had: the migration path for who opted out of which list at a previous provider, to run before the first send under the topic. subscribed: false immediately ends those addresses' active enrolments in automations sent under this topic; true restarts nothing. Does not touch suppressions; import those with POST /v1/suppressions/batch. The body is limited to 5 MB, so split very long lists.",
        "x-required-scope": "contacts:write",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The topic's key. Topics are addressed by key, never by id."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Replaying the same key on the same path in this workspace within 24 hours returns the stored response, with an Idempotent-Replay: true header, instead of acting again. Only successful responses are stored, so a failed request can be fixed and retried under the same key. The body is compared (key order ignored): the same key with a different body is 422 idempotency_key_reused, so use a new key for every new request. Use an unguessable value such as a UUID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "emails",
                  "subscribed"
                ],
                "properties": {
                  "emails": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50000,
                    "items": {
                      "type": "string",
                      "format": "email"
                    },
                    "description": "Lower-cased; duplicates written once."
                  },
                  "subscribed": {
                    "type": "boolean",
                    "description": "false records an opt-out for every address, true a subscription."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Imported.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TopicImportResult"
                }
