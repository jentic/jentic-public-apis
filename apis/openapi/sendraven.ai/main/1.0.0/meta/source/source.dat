    "/v1/templates/{slug}/render": {
      "post": {
        "summary": "Render a template without sending",
        "description": "Check the copy reads correctly before mailing a real person. Follows the send rules exactly: values are HTML-escaped into html, and every name in the template's variables must have a value. An empty string counts as a value; a missing key or null does not. Nothing is sent or stored.",
        "x-required-scope": "templates:read",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The template's slug. Templates are addressed by slug, never by id."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Replaying the same key on the same path in this workspace within 24 hours returns the stored response, with an Idempotent-Replay: true header, instead of acting again. Only successful responses are stored, so a failed request can be fixed and retried under the same key. The body is compared (key order ignored): the same key with a different body is 422 idempotency_key_reused, so use a new key for every new request. Use an unguessable value such as a UUID."
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "variables": {
                    "type": "object",
                    "default": {},
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "description": "Placeholder name to value. Numbers and booleans become their string form; null counts as no value; an object or array is refused. Names the template does not use are ignored."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The rendered subject and bodies.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateRenderResult"
                }
              }
            }
          },
          "400": {
            "description": "invalid_json: the request body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
