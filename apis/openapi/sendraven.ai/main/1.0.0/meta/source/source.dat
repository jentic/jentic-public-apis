    },
    "/v1/approvals/{id}": {
      "post": {
        "summary": "Approve or reject a held message",
        "description": "Decides one held send. Only an API key without guardrails that did not make the draft can decide: an OAuth access token, the key that made the draft, and any key with a guardrail (requires_approval, allowed_recipients or a daily_send_limit) are refused with 403 forbidden, so an agent cannot release its own mail, another held agent's, or mail its own limits would not allow. A person in the dashboard can always decide. Rejecting marks the message canceled. Approving first re-checks suppressions and topic opt-outs for every recipient (dropping anyone who left; if no To address remains nothing is sent, the message is recorded rejected, and the response carries skipped and reason) and the plan allowance. Then, if the draft carried a scheduled_at still in the future, the message is put on that schedule (status scheduled, scheduled_at in the response): approving does not bring the send forward. Otherwise it is sent now and scheduled_at is null. The approval is recorded as approved only once the release works: on any failure the approval stays pending with the reason, and can be approved again once the cause is fixed (until it expires). Only one decision lands: 409 invalid_state means it was decided or expired, do not retry; 409 approval_in_progress means another decision is releasing it right now, check the list again in a moment. The key's allowlist and daily cap are not re-checked.",
        "x-required-scope": "emails:send",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The approval's id: the approval_id a held POST /v1/emails returned, or an id from GET /v1/approvals."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Replaying the same key on the same path in this workspace within 24 hours returns the stored response, with an Idempotent-Replay: true header, instead of acting again. Only successful responses are stored, so a failed request can be fixed and retried under the same key. The body is compared (key order ignored): the same key with a different body is 422 idempotency_key_reused, so use a new key for every new request. Use an unguessable value such as a UUID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecideApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decided: approved (released, scheduled, or skipped) or rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalDecision"
                }
              }
            }
          },
          "400": {
            "description": "invalid_json: the request body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "plan_limit_reached: approving, and the plan's monthly allowance cannot cover the recipients and it has no overage. The approval stays pending; upgrading, not retrying, fixes it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the credential is an OAuth access token, the calling key made this draft, or the calling key has a guardrail (requires_approval, allowed_recipients or a daily_send_limit). Checked after the approval is found. A person in the dashboard, or a different API key without guardrails, has to decide; retrying with this credential will not help. Also forbidden: the key lacks the emails:send scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found: no approval with this id in the workspace; or approving, and its message no longer exists (the approval stays pending).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "invalid_state: already approved or rejected, or expired; or approving, and the held message is no longer queued or failed, so it cannot be released. Do not retry. approval_in_progress: another decision is releasing it now; check again in a moment. Also idempotency_in_progress: a request with the same Idempotency-Key was still running on this path after waiting up to 8 seconds for it (a retry that finds it finished receives its response instead). Retry after a short wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large: the body is larger than this endpoint accepts (5 MB unless stated).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "invalid_request: the body failed validation (checked before the approval is looked up; details lists each field). no_verified_identity: approving, but the sending domain the message was held on has been removed; add and verify it again, then approve. workspace_suspended: approving a message due now while sending is suspended. no_postal_address: approving marketing mail due now and the workspace has no postal address. warmup_limit: approving marketing mail due now and its sending domain has used today's warm-up allowance. In each of these the approval stays pending. Also idempotency_key_reused: this Idempotency-Key was already used on this path with a different request body (checked right after the scope, so a credential without the scope gets 403 instead, and answered at once even while the first request is still running). Do not retry; send the new request under a new key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "ses_error: approving, and the provider refused or throttled the message. A refused message is marked failed (a throttled one stays queued) and the approval stays pending, so approving again retries it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
