    "/v1/webhook-endpoints/{id}/events": {
      "get": {
        "summary": "List delivery attempts for an endpoint",
        "description": "The answer to \"why didn't my webhook fire?\": the most recent deliveries to this endpoint, newest first, one row per event with its latest attempt's outcome. Tells \"SendRaven never sent it\" apart from \"the endpoint answered 500\". The first attempt is made when the event happens; failures are retried up to six attempts in all (about +1m, +5m, +30m, +2h, +12h from the event). Not paged: cursor is ignored, next_cursor is always null, and has_more is true when the page came back full, meaning older attempts may exist that this cannot reach.",
        "x-required-scope": "webhooks:read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The webhook endpoint's id from GET /v1/webhook-endpoints (a UUID), not its URL."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            },
            "description": "How many recent deliveries to return. Capped at 200; a fraction is truncated; zero, a negative or a non-number falls back to 50. None of these is an error."
          }
        ],
        "responses": {
          "200": {
            "description": "Recent deliveries, in the list envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "object",
                    "data",
                    "has_more",
                    "next_cursor"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "list"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/WebhookDelivery"
                      }
                    },
                    "has_more": {
                      "type": "boolean",
                      "description": "Not paged: true only when the list hit its cap, meaning there is more than this endpoint can return."
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Always null; this list is not paged."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the webhooks:read scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found: no webhook endpoint with this id in the workspace (\"No such webhook endpoint\").",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}