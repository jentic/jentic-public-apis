    "/v1/contacts/tags": {
      "get": {
        "summary": "List the tags in use",
        "description": "Every tag in the workspace with how many contacts carry it, most used first, then alphabetically; at most 200. Check here before inventing a tag, so the workspace does not end up with both beta and beta-users. The list envelope, not paged: limit and cursor are ignored, next_cursor is always null, and has_more is true when 200 tags came back.",
