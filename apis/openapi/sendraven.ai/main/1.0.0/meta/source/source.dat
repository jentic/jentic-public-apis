    "/v1/approvals": {
      "get": {
        "summary": "List messages held for human approval",
        "description": "A key configured to require approval drafts rather than sends: POST /v1/emails answered 202 with status pending_approval and an approval_id, and the draft waits here. There is nothing to retry. Returns every approval still pending and not expired (they expire 72 hours after the send by default), oldest first. Not paged: limit and cursor are ignored and next_cursor is always null. Every pending approval is returned; has_more is true when there are 500 or more, even though nothing is left out.",
        "x-required-scope": "emails:read",
        "responses": {
          "200": {
            "description": "Pending approvals with the content to review",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "object",
                    "data",
                    "has_more",
                    "next_cursor"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "list"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Approval"
                      }
                    },
                    "has_more": {
                      "type": "boolean",
                      "description": "Not paged: true only when the list hit its cap, meaning there is more than this endpoint can return."
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Always null; this list is not paged."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the emails:read scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
