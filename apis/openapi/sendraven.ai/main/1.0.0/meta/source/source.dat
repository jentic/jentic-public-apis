    "/v1/broadcasts/{id}/preview": {
      "get": {
        "summary": "Preview a campaign",
        "description": "Who the campaign would reach if it started now, and whether it would be allowed to. Run it before every send: a send cannot be recalled, and this is the only way to learn a campaign's size without starting it. The audience is resolved live from current contacts, segment and topic preferences, so on a campaign that has already started it describes today's audience, not the frozen one. can_send covers the reputation gate and, for an A/B test, the 100-per-variant sample floor. It does not cover the plan allowance (GET /v1/usage), domain verification (GET /v1/domains), warm-up (not reported by the API), or a missing postal address or suspension (the send call refuses those with 422).",
        "x-required-scope": "broadcasts:read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The campaign's id from POST or GET /v1/broadcasts (a UUID), not its name."
          },
          {
            "name": "sample",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "How many addresses to return in sample. A larger value is capped at 100, a fraction is rounded down, and zero, a negative or a non-number gives 20. None of these is an error."
          }
        ],
        "responses": {
          "200": {
            "description": "Recipient counts, a sample of addresses, and the gate verdict.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BroadcastPreview"
                }
              }
            }
          },
          "401": {
