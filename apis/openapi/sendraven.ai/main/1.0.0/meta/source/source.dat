    "/v1/suppressions": {
      "get": {
        "summary": "List addresses we refuse to mail",
        "description": "Check here first when someone reports not receiving email. Pass ?email= to answer it for one address: data then holds every suppression that address has, one per scope, and an empty data means it is not suppressed at all (topic opt-outs are separate; see GET /v1/topics/preferences). Newest first, cursor-paged.",
        "x-required-scope": "emails:read",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Only this address, matched after trimming and lower-casing; returns every scope it is suppressed for."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Page size. A larger value is capped at 100, a fraction is rounded down, and zero, a negative or a non-number falls back to 50. None of these is an error."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The next_cursor from the previous page, passed back unchanged. An unreadable cursor returns the first page."
          }
        ],
        "responses": {
          "200": {
            "description": "Suppressions, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "object",
                    "data",
                    "has_more",
                    "next_cursor"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "list"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Suppression"
                      }
                    },
                    "has_more": {
                      "type": "boolean",
                      "description": "True when another page exists; pass next_cursor back as cursor."
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the emails:read scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Suppress an address",
        "description": "Takes effect on the next send, including scheduled mail and running campaigns and automations, which re-check at each address's turn. Idempotent on (address, scope): an existing row keeps its id, created_at and detail, and its reason is replaced unless the stored one is hard_bounce or complaint; the response reason is the one that stands. A narrower scope writes a separate row and the broader one still blocks. With reason unsubscribe this is an unsubscribe, which is two writes: the suppression, and ending the person's queued mail (pending scheduled sends cancelled, active automation enrolments ended), whatever the scope. It does not change the contact record or topic preferences. For someone who opted out of newsletters, send reason unsubscribe with scope marketing so transactional mail still arrives.",
        "x-required-scope": "emails:send",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Stored trimmed and lower-cased."
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "manual",
                      "list_hygiene",
                      "unsubscribe"
                    ],
                    "default": "manual",
                    "description": "hard_bounce and complaint cannot be set here. unsubscribe also ends queued mail."
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "all",
                      "transactional",
                      "marketing"
                    ],
                    "default": "all",
                    "description": "Which mail the suppression blocks, matched against the message's risk class: all blocks everything, transactional only transactional mail, marketing only marketing mail (campaigns, automations and sends marked marketing). Use marketing for someone who asked to stop newsletters, so their password resets still arrive."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The suppression as it stands after the write, the same object the list returns. 201 whether or not the address was already suppressed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Suppression"
                }
              }
            }
          },
          "400": {
            "description": "invalid_json: the request body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the emails:send scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "idempotency_in_progress: a request with the same Idempotency-Key was still running on this path after waiting up to 8 seconds for it (a retry that finds it finished receives its response instead). Retry after a short wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large: the body is larger than this endpoint accepts (5 MB unless stated).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "invalid_request: email missing or invalid, or reason or scope not a listed value. details lists the problems. Also idempotency_key_reused: this Idempotency-Key was already used on this path with a different request body (checked right after the scope, so a credential without the scope gets 403 instead, and answered at once even while the first request is still running). Do not retry; send the new request under a new key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Replaying the same key on the same path in this workspace within 24 hours returns the stored response, with an Idempotent-Replay: true header, instead of acting again. Only successful responses are stored, so a failed request can be fixed and retried under the same key. The body is compared (key order ignored): the same key with a different body is 422 idempotency_key_reused, so use a new key for every new request. Use an unguessable value such as a UUID."
          }
        ]
      }
    },
    "/v1/suppressions/batch": {
      "post": {
        "summary": "Suppress many addresses",
        "description": "The migration path: import the previous provider's unsubscribe list before the first campaign, or everyone who already opted out there is mailed again. Up to 10,000 addresses with one reason and one scope. The defaults differ from a single add: reason list_hygiene, scope marketing. Pass scope all explicitly for hard bounces or complaints. Addresses are trimmed, lower-cased, de-duplicated and written in one bulk operation with the same rules as a single add, so re-running an import creates nothing new. With reason unsubscribe every address's pending scheduled sends are cancelled and its active enrolments end. One invalid address fails the whole request and nothing is written.",
        "x-required-scope": "emails:send",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "emails"
                ],
                "properties": {
                  "emails": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10000,
                    "items": {
                      "type": "string",
                      "format": "email"
                    }
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "manual",
                      "list_hygiene",
                      "unsubscribe"
                    ],
                    "default": "list_hygiene"
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "all",
                      "transactional",
                      "marketing"
                    ],
                    "default": "marketing",
                    "description": "Which mail the suppression blocks, matched against the message's risk class: all blocks everything, transactional only transactional mail, marketing only marketing mail (campaigns, automations and sends marked marketing). Use marketing for someone who asked to stop newsletters, so their password resets still arrive."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Written.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuppressionBatchResult"
                }
              }
            }
          },
          "400": {
            "description": "invalid_json: the request body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
