    "/v1/emails/{id}": {
      "get": {
        "summary": "Get an email with its event timeline",
        "description": "One message plus its events: send, delivery, bounce (with the receiving server's diagnostic in detail), complaint, reject, open, click. This is the call to make when asked why an email did not arrive.",
        "x-required-scope": "emails:read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The message id (a UUID) from a send response or GET /v1/emails. Not a provider_message_id, and not the id of a received message."
          }
        ],
        "responses": {
