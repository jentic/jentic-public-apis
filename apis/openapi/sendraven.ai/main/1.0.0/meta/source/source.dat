        }
      },
      "delete": {
        "summary": "Delete a sending domain",
        "description": "Removes the identity from the workspace, releases its link. tracking hostname, and deletes the domain at SES with the configuration set created for it, so adding the domain again later issues new DKIM tokens. When another sending identity in any workspace still uses exactly this domain, the SES identity is kept; a configuration set shared with other identities is kept. A domain or set SES no longer has counts as deleted; any other SES refusal removes nothing and answers 502 ses_error, and the call can be repeated. Sent mail keeps its history; scheduled mail due from this identity fails at send time rather than going out from another domain. Deleting news. leaves mail. alone.",
        "x-required-scope": "domains:write",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The sending domain's id from GET /v1/domains (a UUID), not the domain name. Passing a domain name that exists in the workspace answers 404 with a message naming the id to use."
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "deleted"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "deleted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
