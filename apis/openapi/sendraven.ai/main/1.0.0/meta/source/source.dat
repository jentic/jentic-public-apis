    "/v1/broadcasts/{id}/winner": {
      "post": {
        "summary": "Decide an A/B test now",
        "description": "Decides an A/B test without waiting for decide_at, then sends the rest of the audience to the winner in the background. Pass 'variant' to choose, or an empty body to let the metric decide on the figures so far (highest unique rate; ties and all-zero results go to the first variant). There is no significance test, so read the live ab_test.results on GET /v1/broadcasts/{id} first. Only a campaign in 'testing' can be decided, and the decision cannot be reversed. Idempotent against the worker: if a winner was already recorded that winner stands, 'variant' is ignored, and the call answers 202 with that winner in ab_test (decided_by 'auto' when the worker decided). Once the campaign has left 'testing' the call answers 409 instead. The remainder can pause on warm-up or quota like any send. An API key that holds its sends for approval or has allowed_recipients cannot decide a winner (403, checked before the campaign's state), since deciding releases the rest of the audience; a key with a daily_send_limit that has not paid for the campaign is charged for the addresses still pending (429 daily_limit when they do not fit today, and no winner is decided).",
        "x-required-scope": "broadcasts:write",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The campaign's id from POST or GET /v1/broadcasts (a UUID), not its name."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Replaying the same key on the same path in this workspace within 24 hours returns the stored response, with an Idempotent-Replay: true header, instead of acting again. Only successful responses are stored, so a failed request can be fixed and retried under the same key. The body is compared (key order ignored): the same key with a different body is 422 idempotency_key_reused, so use a new key for every new request. Use an unguessable value such as a UUID."
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecideBroadcastWinnerRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The campaign object, the decision in ab_test (winner, decided_by, decided_at, results). Status 'sending' while the remainder goes to the winner, or wherever the worker has already moved it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Broadcast"
                }
              }
            }
          },
          "400": {
            "description": "invalid_json: the request body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the calling API key holds its sends for approval (a campaign cannot be held for approval), or has allowed_recipients (a campaign's audience cannot be held to an allowlist). The message says which. Use a key without that guardrail, or send the campaign from the dashboard; retrying with this key will not help. Also forbidden: the key lacks the broadcasts:write scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found: no campaign with this id in your workspace, or it was deleted while being decided.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "invalid_state: the campaign is not an A/B test; or it is not in 'testing', or left it without a winner while the call was being made (the message names its status). Also idempotency_in_progress: a request with the same Idempotency-Key was still running on this path after waiting up to 8 seconds for it (a retry that finds it finished receives its response instead). Retry after a short wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large: the body is larger than this endpoint accepts (5 MB unless stated).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "invalid_request: variant is not a non-empty string ('Bad variant'), or names a key the campaign does not have. Also idempotency_key_reused: this Idempotency-Key was already used on this path with a different request body (checked right after the scope, so a credential without the scope gets 403 instead, and answered at once even while the first request is still running). Do not retry; send the new request under a new key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "daily_limit: an API key with a daily_send_limit that has not paid for this campaign, and the addresses still pending would take it past today's limit. No winner is decided. Also rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
