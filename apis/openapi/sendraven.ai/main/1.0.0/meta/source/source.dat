    "/v1/audiences/{id}/contacts": {
      "get": {
        "summary": "List the contacts on an audience",
        "description": "The members of one list, sorted by email address A to Z. Unlike other lists, next_cursor is the last address on the page (not an opaque timestamp): pass it back unchanged as cursor while has_more is true, and only addresses after it are returned. after is an older alias for cursor; cursor wins when both are sent.",
        "x-required-scope": "contacts:read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The audience's id from GET /v1/audiences (a UUID), not its name."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Page size. A larger value is capped at 100, a fraction is rounded down, and zero, a negative or a non-number falls back to 50. None of these is an error."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The next_cursor from the previous page: an email address. Only addresses that sort after it are returned."
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "deprecated": true,
            "description": "Alias for cursor, kept for older callers. Ignored when cursor is sent."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of contacts, by address",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "object",
                    "data",
                    "has_more",
                    "next_cursor"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "list"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Contact"
                      }
                    },
                    "has_more": {
                      "type": "boolean",
                      "description": "True when another page exists; pass next_cursor back as cursor."
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The last email address on this page; null on the last page."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the contacts:read scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found: no audience with that id in this workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add or import contacts",
        "description": "One contact (a JSON object, answered with the contact) or an import of up to 5,000 (a JSON array, answered with counts). Both go through the same import: an upsert on the address, safe to re-run. status is the migration path: bring the old provider's unsubscribes, bounces and complaints across before the first campaign; an opt-out row also cancels pending sends and ends enrolments. An import never resubscribes anyone who opted out here. Automations start only for people new to this audience and never for a suppressed address: always for a single contact, and for an array only with ?trigger_automations=true. An array is validated whole before anything is written (each details path starts with the row index); repeats of an address after the first are skipped for the contact, but a repeat's status still writes its suppression. Bodies are limited to 5 MB; split very large imports.",
        "x-required-scope": "contacts:write",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The audience's id from GET /v1/audiences (a UUID), not its name."
          },
          {
            "name": "source",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "the API"
            },
            "description": "Where the list came from, e.g. Mailchimp. Recorded on each suppression as \"Imported from <source>\". Cut to 60 characters, never refused."
          },
          {
            "name": "trigger_automations",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "For an array only: true starts contact_added automations for everyone new to this audience, and tag_added automations for every tag a contact did not already carry; any other value is false. Off by default, because a migrated list mailed a welcome sequence all at once is a cold blast from a domain that has never mailed those people. Ignored for a single contact, which always starts them."
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Replaying the same key on the same path in this workspace within 24 hours returns the stored response, with an Idempotent-Replay: true header, instead of acting again. Only successful responses are stored, so a failed request can be fixed and retried under the same key. The body is compared (key order ignored): the same key with a different body is 422 idempotency_key_reused, so use a new key for every new request. Use an unguessable value such as a UUID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ImportContact"
                  },
                  {
                    "type": "array",
                    "maxItems": 5000,
                    "items": {
                      "$ref": "#/components/schemas/ImportContact"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "For an object, the contact as it stands after the write; for an array, the import counts",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Contact"
                    },
                    {
                      "$ref": "#/components/schemas/ContactImportResult"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "invalid_json: the request body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the contacts:write scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found: no audience with that id in this workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "idempotency_in_progress: a request with the same Idempotency-Key was still running on this path after waiting up to 8 seconds for it (a retry that finds it finished receives its response instead). Retry after a short wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large: the body is larger than this endpoint accepts (5 MB unless stated).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "invalid_request: an attribute key is empty, contains \".\" or starts with \"$\" (message starts \"attributes:\"; nothing is written), or a contact fails validation or an array has more than 5,000 entries (\"Validation failed\", with details). Also idempotency_key_reused: this Idempotency-Key was already used on this path with a different request body (checked right after the scope, so a credential without the scope gets 403 instead, and answered at once even while the first request is still running). Do not retry; send the new request under a new key.",
