    "/v1/automations/{id}/status": {
      "post": {
        "summary": "Activate or pause an automation",
        "description": "Any status can be set from any other. active lets it enrol people and send steps. draft or paused stops it: triggers no longer start enrolments, enrol answers 409 invalid_state with reason not_active, and no step is sent. Enrolments in flight are held, not ended: they stay active on their current step. Reactivating continues each from its current step, and steps that came due while paused go out from the worker's next run, oldest first, at the usual pace. Every exit still applies while paused. Activating does not re-check the sending domain.",
        "x-required-scope": "broadcasts:write",
