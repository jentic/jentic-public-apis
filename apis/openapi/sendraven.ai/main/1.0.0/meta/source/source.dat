    "/v1/topics/{key}": {
      "delete": {
        "summary": "Delete a topic",
        "description": "Deletes the topic and every preference recorded against it. Destructive beyond its name: every opt-out from the topic is erased and cannot be restored, and recreating the key brings back the default for the people who had opted out. Refused with 409 while the topic is used by an active or paused automation, or by a campaign that is draft, scheduled, sending, paused or testing (the message lists them); change or delete those first. Once deleted, a send naming the key is 422 unknown_topic. Do not delete a topic to rename it; POST it again with a new name.",
        "x-required-scope": "contacts:write",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The topic's key. Topics are addressed by key, never by id."
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "key",
                    "deleted"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "deleted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the contacts:write scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found: no topic with this key in the workspace, or it was deleted by another request meanwhile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "invalid_state: an active or paused automation, or a draft, scheduled, sending, paused or testing campaign, still uses the topic; the message names each one. Nothing was deleted. Retrying will not help until they are changed, deleted or finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/topics/preferences": {
      "get": {
        "summary": "Get one person's topic preferences",
        "description": "Every topic in the workspace, sorted by name, with subscribed resolved for one address: their recorded choice, or the topic's default. Check this before concluding that mail is failing to arrive; an opt-out looks like a delivery problem from outside. Topic preferences only: an address suppressed for marketing receives no marketing mail whatever this shows, so check GET /v1/suppressions?email= too.",
        "x-required-scope": "contacts:read",
        "parameters": [
