            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "invalid_request: url not a URL, on a port other than 80, 443 or 1024-65535, or not a public http or https address; events empty or containing an unknown type; or enabled not a boolean. details lists the problems.",
            "content": {
              "application/json": {
