          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Subscribe a URL to events",
        "description": "Creates an enabled endpoint. The signing secret is in this response and nowhere else, and cannot be rotated: store it first; to replace a lost one, create a new endpoint and delete the old. Verify the X-CN-Signature header on every delivery. The URL must be a public http or https address on port 80, 443 or 1024 to 65535 (or no port): another port, a URL with credentials, an IP address (or a name resolving to one, any record) in a private, loopback, link-local or other non-public range, a local name (localhost, .internal, .local, .localdomain, .home.arpa) or a single label with no dot is refused with 422. A name that does not resolve yet is accepted, and every delivery checks again. Prefer https; payloads carry recipient addresses. This response is never stored for idempotency, so a retry with the same Idempotency-Key after it answered creates a second endpoint with its own secret; after a timeout, list endpoints before retrying.",
        "x-required-scope": "webhooks:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url",
                  "events"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "An absolute, public http or https URL."
                  },
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "inbound",
                        "send",
                        "delivery",
                        "bounce",
                        "complaint",
                        "reject",
                        "open",
                        "click",
                        "rendering_failure",
                        "delivery_delay"
                      ]
                    },
                    "description": "inbound (a message arrived, usually a reply), send, delivery, bounce, complaint, reject, open (first open only), click (every click), rendering_failure, delivery_delay. open and click are recorded only for identities whose link. tracking hostname is active."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created, with the signing secret (the only time it is returned).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebhookEndpointWithSecret"
                }
              }
            }
          },
          "400": {
            "description": "invalid_json: the request body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the webhooks:write scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "idempotency_in_progress: a request with the same Idempotency-Key was still running on this path after waiting up to 8 seconds for it (a retry that finds it finished receives its response instead). Retry after a short wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large: the body is larger than this endpoint accepts (5 MB unless stated).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "invalid_request: url missing or not a URL, on a port other than 80, 443 or 1024-65535 (\"url: port must be 80, 443 or 1024-65535\"), or not a public http or https address; or events missing, empty or containing an unknown type. details lists the problems. Also idempotency_key_reused: this Idempotency-Key was already used on this path with a different request body (checked right after the scope, so a credential without the scope gets 403 instead, and answered at once even while the first request is still running). Do not retry; send the new request under a new key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Replaying the same key on the same path in this workspace within 24 hours returns the stored response, with an Idempotent-Replay: true header, instead of acting again. Only successful responses are stored, so a failed request can be fixed and retried under the same key. The body is compared (key order ignored): the same key with a different body is 422 idempotency_key_reused, so use a new key for every new request. Use an unguessable value such as a UUID."
          }
        ]
      }
