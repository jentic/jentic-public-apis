    "/v1/broadcasts/{id}/recipients": {
      "get": {
        "summary": "List a campaign's recipients",
        "description": "Every message the campaign produced, with its outcome: who got it and what happened. Rows come from the email log, so an address skipped at its turn (suppressed, opted out, undeliverable domain) has no message and is not listed; its count is in the campaign's progress. Pages differently from the rest of the API: rows are ordered by message id, not time, the cursor is a message id, the default and maximum page size is 200, and 'after' is another name for 'cursor'.",
        "x-required-scope": "broadcasts:read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The campaign's id from POST or GET /v1/broadcasts (a UUID), not its name."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 200
            },
            "description": "Rows per page. A larger value is capped at 200, a fraction is rounded down, and zero, a negative or a non-number gives 200. None of these is an error."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The next_cursor from the previous page (a message id), passed back unchanged."
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Alias for cursor, read only when cursor is not given."
          }
        ],
        "responses": {
          "200": {
            "description": "One page of the campaign's messages.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BroadcastRecipientList"
