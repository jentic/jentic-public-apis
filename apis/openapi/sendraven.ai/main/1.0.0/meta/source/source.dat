    "/v1/domains": {
      "get": {
        "summary": "List sending domains",
        "description": "Every sending identity in the workspace, newest first, each with the DNS records it needs and what live DNS last showed, so a stuck verification can be diagnosed record by record. status is SES's DKIM verdict and the only thing that makes a domain verified. Records with optional: true (the inbound MX and the link. CNAME for click tracking) turn on features and never hold up verification. click_tracking reports the link. hostname: links are rewritten and opens counted only while it is active. mail_from reports the bounce. Return-Path: pending while SES polls for the MX, which it does for 72 hours from when the domain was added (not from when the record is published), active once adopted, failed when SES gave up. Mail is delivered throughout; once the MX resolves, POST /v1/domains/{id}/verify restarts a failed one. Not paged: limit and cursor are ignored.",
        "x-required-scope": "domains:read",
        "responses": {
          "200": {
            "description": "Every sending domain, in the list envelope (not paged; cap 500).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "object",
                    "data",
                    "has_more",
                    "next_cursor"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "list"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SendingDomain"
                      }
                    },
                    "has_more": {
                      "type": "boolean",
                      "description": "Not paged: true only when the list hit its cap, meaning there is more than this endpoint can return."
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Always null; this list is not paged."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the domains:read scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add a sending domain",
        "description": "Pass the domain you own (example.com) and leave out risk_class: the API provisions mail.example.com (transactional) and news.example.com (marketing), so a campaign's complaint rate cannot affect password-reset delivery. A leading mail. or news. is stripped first, only when what remains is a registrable domain by the Public Suffix List (mail.example.co.uk becomes example.co.uk). Otherwise the domain given is the root, whatever its first label: mail.co.uk and news.io are registrable domains, so they get mail.mail.co.uk and news.mail.co.uk, or mail.news.io and news.news.io (never news.co.uk, which is somebody else's), and passing either identity back in files under the same root. A public suffix itself (co.uk, com.au, or github.io from the list's private section), or a name that is not a hostname (.example.com, -acme.com), is refused with 422. To register mail.co.uk itself, pass it with risk_class. With risk_class exactly one identity is created, on the domain as given. Safe to repeat: a domain already in the workspace is returned unchanged, still 201, looked up by name alone (so risk_class does not change an existing one). New identities come back pending with unchecked records; publish dns_records, then call POST /v1/domains/{id}/verify or wait for the monitor (about once a minute). A new marketing identity is warmed up: its marketing mail is capped per day on a ramp from its first send. Identities are created one after another, so a 500 part-way may leave the first stored; repeating the call creates only the missing one.",
        "x-required-scope": "domains:write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "domain"
                ],
                "properties": {
                  "domain": {
                    "type": "string",
                    "minLength": 3,
                    "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$",
                    "description": "A bare domain (case-insensitive), no scheme, path or @. Usually the root you own, e.g. example.com."
                  },
                  "risk_class": {
                    "type": "string",
                    "enum": [
                      "transactional",
                      "marketing"
                    ],
                    "description": "Leave out to provision both mail. and news. Pass it only to register one identity on the domain as given."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "One domain object per identity, transactional first, in the list envelope (has_more false, next_cursor null).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "object",
                    "data",
                    "has_more",
                    "next_cursor"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "list"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SendingDomain"
                      }
                    },
                    "has_more": {
                      "type": "boolean",
                      "description": "Not paged: true only when the list hit its cap, meaning there is more than this endpoint can return."
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Always null; this list is not paged."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "invalid_json: the request body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "plan_limit_reached: the plan allows no more sending domains (counted by root). Retrying will not help; upgrading will.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the domains:write scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found: the key's workspace no longer exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "idempotency_in_progress: a request with the same Idempotency-Key was still running on this path after waiting up to 8 seconds for it (a retry that finds it finished receives its response instead). Retry after a short wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large: the body is larger than this endpoint accepts (5 MB unless stated).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "invalid_request: domain missing or not a bare domain, domain is a public suffix rather than a domain someone can register (e.g. co.uk; the message suggests one under it), domain is not a hostname (an empty label or a label starting or ending with a hyphen, e.g. .example.com; message \"domain: ... is not a domain name\"), or risk_class not one of the two values. details lists the problems. Also idempotency_key_reused: this Idempotency-Key was already used on this path with a different request body (checked right after the scope, so a credential without the scope gets 403 instead, and answered at once even while the first request is still running). Do not retry; send the new request under a new key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Replaying the same key on the same path in this workspace within 24 hours returns the stored response, with an Idempotent-Replay: true header, instead of acting again. Only successful responses are stored, so a failed request can be fixed and retried under the same key. The body is compared (key order ignored): the same key with a different body is 422 idempotency_key_reused, so use a new key for every new request. Use an unguessable value such as a UUID."
          }
        ]
      }
    },
    "/v1/domains/{id}": {
      "get": {
        "summary": "Retrieve a sending domain",
        "description": "One domain as last checked; this does not re-check DNS. To check now, call POST /v1/domains/{id}/verify.",
        "x-required-scope": "domains:read",
        "parameters": [
          {
