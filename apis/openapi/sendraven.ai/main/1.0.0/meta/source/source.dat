          "status",
          "scheduled_at",
          "started_at",
          "completed_at",
          "pause_reason",
          "resume_after",
          "failure_reason",
          "total_recipients",
          "sent_count",
          "failed_count",
          "created_at",
          "variants",
          "ab_test",
          "progress",
          "warnings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "audience_id": {
            "type": "string",
            "description": "The audience it mails."
          },
          "identity_id": {
            "type": "string",
            "description": "The marketing sending domain it goes out on."
          },
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "string",
            "description": "An A/B variant can override it."
          },
          "from_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name on the From header. null when never set."
          },
          "view_in_browser": {
            "type": "boolean",
            "description": "Whether each message opens with a \"View this email in your browser\" link to web_version_url."
          },
          "web_version_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "A public page showing the campaign's HTML, on the sending domain's tracking domain. One URL per campaign, without any recipient's unsubscribe link, so it can be shared. Works whether or not view_in_browser is set. null while the sending domain has no live tracking domain."
          },
          "segment": {
            "type": [
              "object",
              "null"
            ],
            "description": "The inline engagement and tag filter, or null when none was given. A day rule not given is null, a tag list not given is [].",
            "required": [
              "opened_within_days",
              "clicked_within_days",
              "exclude_unengaged_days",
              "engaged_within_days",
              "tags",
              "exclude_tags"
            ],
            "properties": {
              "opened_within_days": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "clicked_within_days": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "exclude_unengaged_days": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "engaged_within_days": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Contacts must carry all of these. Normalised."
              },
              "exclude_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Contacts carrying any of these are left out. Normalised."
              }
            }
          },
          "segment_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The saved segment it targets. Wins over segment when both are set."
          },
          "topic_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "The topic it is sent under."
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "scheduled",
              "sending",
              "paused",
              "testing",
              "sent",
              "failed"
            ],
            "description": "draft: editable, nothing sent. scheduled: waiting for scheduled_at (a send-time test also returns here between its variants). sending: a run is mailing the frozen audience. paused: stopped with addresses still pending; pause_reason says why and what continues it. testing: an A/B sample is out and the winner is not yet decided or not yet handed on. sent: every address dealt with. failed: refused before sending (reputation gate, plan allowance, A/B sample too small, sending domain not verified or not marketing) or stopped by an unexpected error; see failure_reason. There is no canceled status."
          },
          "scheduled_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When it is due to start. null until scheduled, and again when unscheduled."
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When a run last claimed it. Rewritten by every run, including each resume. null before the first."
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When it finished as sent or failed; null before that."
          },
          "pause_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set only while paused: why, in words you can act on (warm-up limit, 24-hour quota, throttling, no postal address, suspension, an interrupted run). null otherwise; cleared when a run picks it up."
          },
          "resume_after": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Set while paused on the sending domain's warm-up allowance: when it renews (the next 00:00 UTC). The worker resumes the campaign on its own after that, and POST /v1/broadcasts/{id}/resume answers 409 before it. A warm-up pause is the protection working, not a failure. null otherwise."
          },
          "failure_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why it failed. Set on every failed campaign, null on every other."
          },
          "total_recipients": {
            "type": "integer",
            "description": "Size of the frozen audience after suppressions and topic opt-outs. 0 until the first run freezes it."
          },
          "sent_count": {
            "type": "integer",
            "description": "Messages accepted for delivery so far."
          },
          "failed_count": {
            "type": "integer",
            "description": "Messages the provider refused. Throttled messages and ones held back by a suspension or a missing postal address are not counted: they go back to pending and the campaign pauses."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BroadcastVariantRecord"
            },
            "description": "The arms of an A/B test; [] on a campaign that is not a test."
          },
          "ab_test": {
            "description": "A/B tests only; null otherwise.",
            "anyOf": [
              {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/BroadcastAbTestState"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "progress": {
            "description": "While sending, paused or testing (not on create or update); null otherwise.",
            "anyOf": [
              {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/BroadcastProgress"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Settings that will not do what they say yet (today, metric 'click' without click tracking). Derived from the stored campaign, so create, update, list and retrieve say the same thing; [] when there is nothing to say."
          }
        }
      },
      "SendingDomainDnsRecord": {
        "type": "object",
        "description": "One DNS record to publish, with the result of the last live check.",
        "required": [
          "kind",
          "name",
          "type",
          "value",
          "priority",
          "observed",
          "ok",
          "optional"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "dkim",
              "spf",
              "dmarc",
              "mail_from_mx",
              "mail_from_spf",
              "inbound_mx",
              "click_tracking"
            ],
            "description": "What the record is for. dkim (three CNAMEs) is what SES verifies the domain from. mail_from_mx and mail_from_spf put the bounce path on bounce.<domain>. dmarc is recommended. inbound_mx (receiving replies) and click_tracking (the link.<domain> CNAME) are optional features."
          },
          "name": {
            "type": "string",
            "description": "The hostname to publish the record at."
          },
          "type": {
            "type": "string",
            "enum": [
              "CNAME",
              "TXT",
              "MX"
            ]
          },
          "value": {
            "type": "string",
            "description": "The value to publish. Copy it from here: DKIM tokens are per domain and targets depend on the region."
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ],
            "description": "MX priority on MX records; null on the others."
          },
          "observed": {
            "type": [
              "string",
              "null"
            ],
            "description": "The first answer the last DNS check saw at name, or null when nothing was there or no check has run."
          },
          "ok": {
            "type": "boolean",
            "description": "Whether the last check found the expected value. DMARC matches any v=DMARC1 record and SPF any value including amazonses.com. A check that cannot reach a resolver keeps the previous ok and observed. A record showing ok does not verify the domain by itself; only SES's DKIM verdict sets status."
          },
          "optional": {
            "type": "boolean",
            "description": "True for records that turn on a feature (inbound_mx, click_tracking); leaving them out never holds up verification."
          }
        }
      },
      "SendingDomainClickTracking": {
        "type": "object",
        "description": "The link.<domain> hostname that carries click and open tracking on the customer's own name. Links are rewritten and opens counted only while status is active; tracking is never served from a shared SendRaven or Amazon hostname.",
        "required": [
          "hostname",
          "status",
          "active_at",
          "error"
        ],
        "properties": {
          "hostname": {
            "type": "string",
            "description": "link. followed by the sending domain."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "failed"
            ],
            "description": "pending until the CNAME resolves and a certificate is issued; active once it has; failed when that failed."
          },
          "active_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When tracking first became active."
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the hostname failed. Cleared when a later check finds it pending or active, but not when the CNAME stops resolving, so it can remain while status is pending."
          }
        }
      },
      "SendingDomainMailFrom": {
        "type": "object",
        "description": "Whether SES has adopted bounce.<domain> as the Return-Path. Tracked beside verification, never part of it: mail is delivered throughout, on an amazonses.com Return-Path (SPF then aligns with Amazon rather than the customer's domain) until this is active.",
        "required": [
          "domain",
          "status",
          "active_at"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "description": "The bounce subdomain, e.g. bounce.mail.example.com."
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "failed"
            ],
            "description": "pending while SES polls for the mail_from_mx record, active once adopted, failed when SES gave up. SES's 72-hour polling window starts when the domain is added, not when the MX record is published. A later check that sees the MX resolve restarts SES's verification and returns this to pending."
          },
          "active_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When the bounce path first became active."
          }
        }
      },
      "SendingDomain": {
        "type": "object",
        "description": "A sending identity: a domain SendRaven may put in the From line, with one risk class. Transactional and marketing mail go out from separate subdomains (mail. and news.) with separate SES configuration sets, because mailbox providers score reputation on the From domain.",
        "required": [
          "id",
          "domain",
          "risk_class",
          "status",
          "configuration_set",
          "dns_records",
          "click_tracking",
          "mail_from",
          "verified_at",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Every /v1/domains/{id} path takes this, not the domain name."
          },
          "domain": {
            "type": "string",
            "description": "Fully-qualified, lower-cased, e.g. mail.example.com."
          },
          "risk_class": {
            "type": "string",
            "enum": [
              "transactional",
              "marketing"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "failed",
              "temporary_failure"
            ],
            "description": "SES's DKIM verdict. Only this verdict changes it. A failed domain is not re-checked by the background monitor; call POST /v1/domains/{id}/verify after fixing its records."
          },
          "configuration_set": {
            "type": "string",
            "description": "The SES configuration set this identity's mail is sent through."
          },
          "dns_records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SendingDomainDnsRecord"
            }
          },
          "click_tracking": {
            "description": "Null when no tracking hostname has been registered for this identity; the next check retries.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/SendingDomainClickTracking"
              },
              {
                "type": "null"
              }
            ]
          },
          "mail_from": {
            "description": "Null until the first check that reaches SES.",
            "anyOf": [
              {
                "$ref": "#/components/schemas/SendingDomainMailFrom"
              },
              {
                "type": "null"
              }
            ]
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When a check first found the domain verified. Written once and never moved."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Suppression": {
        "type": "object",
        "description": "One suppressed address in one scope. The list and POST /v1/suppressions return this same object, with every field present.",
        "required": [
          "id",
          "email",
          "reason",
          "scope",
          "detail",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "Trimmed and lower-cased."
          },
          "reason": {
            "type": "string",
            "enum": [
              "hard_bounce",
              "complaint",
              "unsubscribe",
              "manual",
              "list_hygiene"
            ],
            "description": "hard_bounce and complaint are set by SendRaven (or a contact import) with scope all and are never replaced by a weaker reason, so after a POST this can differ from the reason sent. unsubscribe comes from unsubscribe links and the preference centre, with scope marketing. manual and list_hygiene are set by callers."
          },
          "scope": {
            "type": "string",
            "enum": [
              "all",
              "transactional",
              "marketing"
            ],
            "description": "Which mail the suppression blocks, matched against the message's risk class: all blocks everything, transactional only transactional mail, marketing only marketing mail (campaigns, automations and sends marked marketing). Use marketing for someone who asked to stop newsletters, so their password resets still arrive."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500,
            "description": "The SMTP diagnostic for a bounce, the feedback type for a complaint, how someone unsubscribed, or the import it came from. null when there is none. Never set through this API."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the address was first suppressed with this scope."
          }
        }
      },
      "SuppressionRemoveResult": {
        "type": "object",
        "required": [
          "email",
          "scope",
          "removed"
        ],
        "properties": {
          "email": {
            "type": "string",
            "description": "The address, trimmed and lower-cased."
          },
          "scope": {
            "type": "string",
            "enum": [
              "all",
              "transactional",
              "marketing"
            ]
          },
          "removed": {
            "type": "boolean",
            "description": "True when a suppression with exactly this scope existed and was deleted. False usually means the address is suppressed under another scope, or not at all; check GET /v1/suppressions?email=."
          }
        }
      },
      "SuppressionBatchResult": {
        "type": "object",
        "required": [
          "suppressed",
          "duplicates"
        ],
        "properties": {
          "suppressed": {
            "type": "integer",
            "description": "Distinct addresses written, including any already suppressed with this scope."
          },
          "duplicates": {
            "type": "integer",
            "description": "Entries in emails that repeated an earlier one after trimming and lower-casing."
          }
        }
      },
      "SuppressionBatchRemoveResult": {
        "type": "object",
        "required": [
          "removed"
        ],
        "properties": {
          "removed": {
            "type": "integer",
            "description": "Suppressions that existed with that scope and were deleted. Not the number of addresses sent: an address with nothing in that scope, or repeated, is not counted."
          }
        }
      },
      "Template": {
        "type": "object",
        "description": "A template. Every field is always present, null when it has no value.",
        "required": [
          "id",
          "slug",
          "name",
          "subject",
          "html",
          "text",
          "variables",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Not used by any endpoint; templates are addressed by slug."
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique within the workspace."
          },
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "string",
            "description": "The subject line, with {{name}} placeholders."
          },
          "html": {
            "type": "string",
            "description": "The HTML body, with placeholders. Values substituted here are HTML-escaped."
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "The plain-text body; null when the template has none. An empty string counts as no text body when rendering."
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Every placeholder name in the subject and both bodies, sorted, without duplicates. All are required to render or send."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "null until the template is first updated."
          }
        }
      },
      "TemplateRenderResult": {
        "type": "object",
        "required": [
          "subject",
          "html",
          "text"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "description": "Values substituted as given (the subject is not HTML)."
          },
          "html": {
            "type": "string",
            "description": "Values HTML-escaped on substitution."
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "null when the template has no text body. Values substituted as given."
          }
        }
      },
      "Topic": {
        "type": "object",
        "required": [
          "id",
          "key",
          "name",
          "description",
          "default_subscribed",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Not used by any endpoint; topics are addressed by key."
          },
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique within the workspace. The identifier used in paths, in topic on POST /v1/emails, in topic_key on campaigns and automations, and in unsubscribe links."
          },
          "name": {
            "type": "string",
            "description": "Shown to the person on the preference page."
          },
          "description": {
            "type": [
              "string",
              "null"
            ],
            "description": "Shown under the name. null when not set."
          },
          "default_subscribed": {
            "type": "boolean",
            "description": "Whether someone with no recorded preference receives this topic. Defaults are never written out as rows, so changing this moves everyone who never chose."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TopicPreference": {
        "type": "object",
        "description": "A topic with subscribed resolved for one address.",
        "required": [
          "id",
          "key",
          "name",
          "description",
          "default_subscribed",
          "created_at",
          "subscribed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "default_subscribed": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "subscribed": {
            "type": "boolean",
            "description": "The person's recorded choice where there is one, otherwise the topic's default_subscribed."
          }
        }
      },
      "TopicImportResult": {
        "type": "object",
        "required": [
          "topic",
          "written"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "description": "The topic key."
          },
          "written": {
            "type": "integer",
            "description": "Distinct addresses whose preference was recorded."
          }
        }
      },
      "WebhookEndpoint": {
        "type": "object",
        "description": "A webhook endpoint. The signing secret is left out of every response except creation.",
        "required": [
          "id",
          "url",
          "events",
          "enabled",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string",
            "description": "Where deliveries are POSTed."
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "inbound",
                "send",
                "delivery",
                "bounce",
                "complaint",
                "reject",
                "open",
                "click",
                "rendering_failure",
                "delivery_delay"
              ]
            }
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether deliveries are made. True on creation."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WebhookEndpointWithSecret": {
        "type": "object",
        "description": "The endpoint as created, with its signing secret: the only response that ever carries it.",
        "required": [
          "id",
          "url",
          "events",
          "enabled",
          "created_at",
          "secret"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "inbound",
                "send",
                "delivery",
                "bounce",
                "complaint",
                "reject",
                "open",
                "click",
                "rendering_failure",
                "delivery_delay"
              ]
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "secret": {
            "type": "string",
            "description": "Starts whsec_. Signs every delivery in the X-CN-Signature header (t=<unix>,v1=<hex HMAC-SHA256 of \"<t>.<body>\">). Store it now: it cannot be read back or rotated."
          }
        }
      },
      "WebhookDelivery": {
        "type": "object",
        "description": "One event delivered (or being delivered) to an endpoint, with the outcome of its latest attempt.",
        "required": [
          "id",
          "event",
          "status",
          "attempts",
          "last_status_code",
          "last_error",
          "created_at",
          "delivered_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "event": {
            "type": "string",
            "enum": [
              "inbound",
              "send",
              "delivery",
              "bounce",
              "complaint",
              "reject",
              "open",
              "click",
              "rendering_failure",
              "delivery_delay"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "success",
              "failed"
            ],
            "description": "pending before the first attempt finishes, success once an attempt got a 2xx, failed after an attempt that did not. A failed delivery with fewer than six attempts is still being retried."
          },
          "attempts": {
            "type": "integer",
            "description": "Attempts made so far, at most six."
          },
          "last_status_code": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The HTTP status the endpoint returned on the most recent attempt that got a response."
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ],
            "description": "The most recent error that prevented a usable response (timeout, refused connection, a redirect, a destination that resolves to a non-public address, the endpoint removed or disabled), up to 500 characters. A later success does not clear it."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the event was queued for this endpoint."
          },
          "delivered_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When an attempt succeeded."
          }
        }
      }
    }
  },
  "paths": {
    "/v1/emails": {
      "post": {
        "summary": "Send an email",
        "description": "Sends one message now, schedules it (scheduled_at), or, from a key that requires approval, holds it for a person. Always pass an Idempotency-Key: a retry after a timeout then returns the original result instead of delivering a second copy. Checks run in order and the first failure decides the response: more than 50 recipients across to, cc and bcc (422 invalid_request, naming the limit and the count); validation, template (422 invalid_request, 422 missing_variables) and topic (422 unknown_topic); subject and body (422); a marketing send with more than one recipient (422 invalid_request); suspension (422 workspace_suspended); schedule (422 invalid_schedule); the key's recipient allowlist (403); reply_to_message_id and thread_id (422); suppressed, undeliverable and opted-out addresses are dropped; plan allowance (402); the key's daily cap (429); the sending domain (422 no_verified_identity); postal address for marketing (422); then a 202. Four outcomes answer 202 and only sent and scheduled mean mail is on its way: read status, and skipped. pending_approval is not an error and must not be retried. The plan allowance and daily cap count every recipient left in to, cc and bcc together.",
        "x-required-scope": "emails:send",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Sent, scheduled, held for approval, or rejected because every to address was dropped.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendEmailResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_json: the request body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "description": "Four billing refusals, each needing a different thing from the account's owner; none is retryable as sent. plan_limit_reached: the workspace is on Free and this send's recipients, in to, cc and bcc together after suppressed and undeliverable addresses are dropped, would take the month past its 3,000 included emails. The whole send is refused; do not split it. Paid sending has to be activated, or the month has to turn over. payment_method_required: the workspace has never had a payment method verified, so no outbound email may leave — this applies on Free too, and nothing an API caller can do fixes it; a person has to add one in the dashboard. billing_past_due: the paid subscription is unpaid or canceled after Stripe gave up retrying; the payment method has to be fixed. budget_exceeded: the workspace set its own monthly spend ceiling and reached it; by default that pauses marketing and lets transactional through, so this can answer for one risk_class and not the other. GET /v1/usage shows all of it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "recipient_not_allowed: this API key has a recipient allowlist and an address in to, cc or bcc is not on it (the message names it); do not retry with a different spelling of the address. Also forbidden: the key lacks the emails:send scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "idempotency_in_progress: a request with the same Idempotency-Key was still running on this path after waiting up to 8 seconds for it (a retry that finds it finished receives its response instead). Retry after a short wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large: the body is larger than this endpoint accepts (5 MB unless stated).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "invalid_request: to, cc and bcc together hold more than 50 recipients (checked before the body is validated; the message is 'A message can have at most 50 recipients across to, cc and bcc; this one has N. Send it as separate messages, or use a campaign.'), the body failed validation (with a details array), the template slug does not exist ('template: No template with slug ...'), there is no subject, there is no html, text or template, reply_to_message_id matches no message in the workspace, thread_id is not a thread in the workspace, or a marketing send names more than one address across to, cc and bcc (a marketing message carries one person's unsubscribe link: send one message per recipient, or use a campaign). missing_variables: the template has variables with no value; the error carries missing, an array of their names. unknown_topic: topic is not a topic key in this workspace (GET /v1/topics); the message starts 'topic:'. no_verified_identity: no sending domain verified for this risk_class matches the from domain; a domain verified only for transactional mail does not cover a marketing send, and retrying will not help until the domain is verified. invalid_schedule: scheduled_at could not be parsed, or is an empty string. workspace_suspended: sending is suspended for this workspace; the message gives the reason, and nothing sends until staff lift it. no_postal_address: a marketing send from a workspace with no postal address set. warmup_limit: a marketing send from a domain that has spent today's warm-up allowance; it resets at 00:00 UTC, so schedule it for tomorrow rather than retrying. Fix the request before retrying any of these. Also idempotency_key_reused: this Idempotency-Key was already used on this path with a different request body (checked right after the scope, so a credential without the scope gets 403 instead, and answered at once even while the first request is still running). Do not retry; send the new request under a new key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "daily_limit: this API key's daily cap would be exceeded by the recipients in to, cc and bcc. Stop; do not loop. It resets at 00:00 UTC. Also rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "ses_error: the email provider refused or throttled the message. The attempt stays in the log as failed, or as queued when it was throttled. A retry creates a new message, so check GET /v1/emails before retrying.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Replaying the same key on the same path in this workspace within 24 hours returns the stored response, with an Idempotent-Replay: true header, instead of acting again. Only successful responses are stored, so a failed request can be fixed and retried under the same key. The body is compared (key order ignored): the same key with a different body is 422 idempotency_key_reused, so use a new key for every new request. Use an unguessable value such as a UUID."
          }
        ]
      },
      "get": {
        "summary": "List emails",
        "description": "The message log, newest first by created_at, cursor-paged. Held, scheduled, rejected and failed messages appear as well as delivered ones, and so do messages sent by campaigns and automations. To find out why one message did not arrive, follow up with GET /v1/emails/{id} for its events.",
        "x-required-scope": "emails:read",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "queued",
                "scheduled",
                "sent",
                "delivered",
                "bounced",
                "complained",
                "rejected",
                "canceled",
                "failed"
              ]
            },
            "description": "Only messages with exactly this status. Any other value, or the parameter repeated, is 422 invalid_request."
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Only messages with this address in to. Lowercased and compared exactly: it does not match cc or bcc, a partial address, or an address stored with capital letters."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Page size. A larger value is capped at 100, a fraction is rounded down, and zero, a negative or a non-number falls back to 50. None of these is an error."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "The next_cursor from the previous page, passed back unchanged. An unreadable cursor returns the first page."
          }
        ],
        "responses": {
          "200": {
            "description": "A page of messages.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "object",
                    "data",
                    "has_more",
                    "next_cursor"
                  ],
                  "properties": {
                    "object": {
                      "type": "string",
                      "enum": [
                        "list"
                      ]
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Email"
                      }
                    },
                    "has_more": {
                      "type": "boolean",
                      "description": "True when another page exists; pass next_cursor back as cursor."
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the emails:read scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "invalid_request: status is not one of the listed values.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/emails/batch": {
      "post": {
        "summary": "Send up to 100 emails",
        "description": "A JSON array of 1 to 100 bodies, each exactly a POST /v1/emails body. Entries are sent one after another through the full send path and results come back in input order. Once the array validates, each entry succeeds or fails on its own (more than 50 recipients across to, cc and bcc, a marketing entry with more than one recipient, a missing variable, a guardrail, a suppressed recipient affects only that entry), but one entry failing schema validation refuses the whole batch with 422 and sends nothing. An entry over the recipient limit is not schema-checked and fails alone, with the same error POST /v1/emails gives. The body may be up to 25 MB. An Idempotency-Key covers the batch as a whole and a replay returns the stored response, 207 included, without sending: to retry only the failed entries, send them as a new batch under a new key.",
        "x-required-scope": "emails:send",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailBatchRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Every entry was accepted (sent, scheduled, held or skipped).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendEmailBatchResponse"
                }
              }
            }
          },
          "207": {
            "description": "At least one entry failed; failed says how many and each data entry with ok false carries its error. Retry only those.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendEmailBatchResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_json: the request body is not valid JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the emails:send scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "idempotency_in_progress: a request with the same Idempotency-Key was still running on this path after waiting up to 8 seconds for it (a retry that finds it finished receives its response instead). Retry after a short wait.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "payload_too_large: the body is larger than this endpoint accepts (5 MB unless stated).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "invalid_request: the body is not an array of 1 to 100 entries, or an entry fails schema validation (details paths start with the entry index). Nothing was sent. Also idempotency_key_reused: this Idempotency-Key was already used on this path with a different request body (checked right after the scope, so a credential without the scope gets 403 instead, and answered at once even while the first request is still running). Do not retry; send the new request under a new key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Replaying the same key on the same path in this workspace within 24 hours returns the stored response, with an Idempotent-Replay: true header, instead of acting again. Only successful responses are stored, so a failed request can be fixed and retried under the same key. The body is compared (key order ignored): the same key with a different body is 422 idempotency_key_reused, so use a new key for every new request. Use an unguessable value such as a UUID."
          }
        ]
      }
    },
    "/v1/emails/metrics": {
      "get": {
        "summary": "Get email metrics",
        "description": "Delivery and engagement for the whole workspace over the last days UTC days, today included: totals and a gap-filled daily series. Rates are fractions, not percentages. bounce_rate is permanent bounces over sent, the figure AWS reviews; open_rate and click_rate are over delivered so a deliverability problem does not read as low engagement. sent counts recipients while delivered, bounced and complained count notices, so rates are approximate for multi-recipient messages, and sent trails by about a minute. Opens and clicks are only recorded for domains whose tracking hostname is live.",
        "x-required-scope": "emails:read",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 365,
              "default": 30
            },
            "description": "The window. Clamped to 1-365: a larger value is 365, a negative one 1. Missing, zero or non-numeric means 30. Never an error."
          }
        ],
        "responses": {
          "200": {
            "description": "Totals and the daily series.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailMetrics"
                }
              }
            }
          },
          "401": {
            "description": "unauthorized: no Bearer token, or the key or token is invalid, revoked or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "forbidden: the key lacks the emails:read scope. The message names it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "rate_limited: more requests than the per-key rate (600 a minute by default). Wait the seconds in the Retry-After header and retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "service_unavailable: the API is under heavy load and could not get a database connection in time. Usually nothing was done; a send that was already under way may have been, so check GET /v1/emails before retrying one. Wait the seconds in the Retry-After header.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
