    "/v1/webhook-endpoints": {
      "get": {
        "summary": "List webhook endpoints",
        "description": "Endpoints newest first, cursor-paged, without their signing secrets.",
        "x-required-scope": "webhooks:read",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
