{
  "openapi": "3.0.3",
  "info": {
    "title": "Blink Card Present API",
    "version": "1.0.0",
    "contact": {},
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/MSHAH_1/blink-card-present-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.blinkpayment.co.uk/sandbox"
    },
    {
      "url": "https://api.blinkpayment.co.uk/"
    }
  ],
  "paths": {
    "/v1/card-present/sales": {
      "post": {
        "summary": "sales",
        "description": "sales",
        "operationId": "sales",
        "parameters": [
          {
            "name": "user-agent",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "AcmeApp/1.2.0 (ReactNative; iOS 15+; iPhone 12+; Android 11+; Build/12345)"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "terminal_id"
                ],
                "properties": {
                  "currency": {
                    "type": "string",
                    "example": "GBP"
                  },
                  "is_receipt_required": {
                    "type": "boolean",
                    "example": false
                  },
                  "metadata": {
                    "type": "object",
                    "properties": {}
                  },
                  "operator_id": {
                    "type": "string",
                    "example": "12345"
                  },
                  "order_number": {
                    "type": "string",
                    "example": "8110397865"
                  },
                  "pos_location": {
                    "type": "string",
                    "example": "POS-01"
                  },
                  "request_timestamp": {
                    "type": "string",
                    "example": "2026-01-01T15:30:58+01:00"
                  },
                  "requested_amount": {
                    "type": "string",
                    "example": "15.42"
                  },
                  "site_branch_id": {
                    "type": "string",
                    "example": "London"
                  },
                  "terminal_id": {
                    "type": "string",
                    "example": "AAA0001-T01"
                  }
                }
              },
              "examples": {
                "sales": {
                  "value": {
                    "currency": "GBP",
                    "is_receipt_required": false,
                    "metadata": {},
                    "operator_id": "12345",
                    "order_number": "8110397865",
                    "pos_location": "POS-01",
                    "request_timestamp": "2026-01-01T15:30:58+01:00",
                    "requested_amount": "15.42",
                    "site_branch_id": "London",
                    "terminal_id": "AAA0001-T01"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "tags": []
}
