{
  "openapi": "3.0.3",
  "info": {
    "title": "CheapShark API",
    "description": "CheapShark is a price comparison website for digital PC Games. The API provides access to game deals, store listings, game search, and deal alerts.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://apidocs.cheapshark.com/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://www.cheapshark.com/api/1.0",
      "description": "CheapShark API v1.0"
    }
  ],
  "paths": {
    "/deals": {
      "get": {
        "operationId": "getDeals",
        "summary": "Get a list of current game deals with optional filters",
        "parameters": [
          {
            "name": "storeID",
            "in": "query",
            "required": false,
            "description": "Filter by store ID (comma-separated for multiple)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "description": "Page number for pagination (0-indexed)",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Number of results per page (max 60)",
            "schema": {
              "type": "integer",
              "default": 60
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "required": false,
            "description": "Sort criteria",
            "schema": {
              "type": "string",
              "enum": [
                "DealRating",
                "Title",
                "Savings",
                "Price",
                "Metacritic",
                "Reviews",
                "Release",
                "Store",
                "recent"
              ]
            }
          },
          {
            "name": "desc",
            "in": "query",
            "required": false,
            "description": "Sort descending (0 or 1)",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          {
            "name": "lowerPrice",
            "in": "query",
            "required": false,
            "description": "Minimum sale price",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "upperPrice",
            "in": "query",
            "required": false,
            "description": "Maximum sale price (use 50 for no limit)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "metacritic",
            "in": "query",
            "required": false,
            "description": "Minimum Metacritic score",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "steamRating",
            "in": "query",
            "required": false,
            "description": "Minimum Steam rating",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "steamAppID",
            "in": "query",
            "required": false,
            "description": "Filter by Steam App ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title",
            "in": "query",
            "required": false,
            "description": "Search by game title",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exact",
            "in": "query",
            "required": false,
            "description": "Exact title match (0 or 1)",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          {
            "name": "AAA",
            "in": "query",
            "required": false,
            "description": "Include only AAA titles (0 or 1)",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          {
            "name": "onSale",
            "in": "query",
            "required": false,
            "description": "Include only games on sale (0 or 1)",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          },
          {
            "name": "output",
            "in": "query",
            "required": false,
            "description": "Output format",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of game deals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Deal"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/stores": {
      "get": {
        "operationId": "getStores",
        "summary": "Get a list of all game stores tracked by CheapShark",
        "responses": {
          "200": {
            "description": "List of stores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Store"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/games": {
      "get": {
        "operationId": "getGames",
        "summary": "Search for games by title or get game details by ID",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "required": false,
            "description": "Search by game title",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Get details for a specific game by ID",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "steamAppID",
            "in": "query",
            "required": false,
            "description": "Filter by Steam App ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Max number of results",
            "schema": {
              "type": "integer",
              "default": 60
            }
          },
          {
            "name": "exact",
            "in": "query",
            "required": false,
            "description": "Exact title match (0 or 1)",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Game search results or game details",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GameSearchResult"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/GameDetail"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/alerts": {
      "get": {
        "operationId": "manageAlerts",
        "summary": "Set or manage price alerts for games",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "description": "Alert action to perform",
            "schema": {
              "type": "string",
              "enum": [
                "set",
                "delete",
                "manage"
              ]
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": true,
            "description": "Email address for alert notifications",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "gameID",
            "in": "query",
            "required": false,
            "description": "Game ID for the alert",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price",
            "in": "query",
            "required": false,
            "description": "Target price threshold",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Alert action result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Deal": {
        "type": "object",
        "properties": {
          "internalName": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "metacriticLink": {
            "type": "string"
          },
          "dealID": {
            "type": "string"
          },
          "storeID": {
            "type": "string"
          },
          "gameID": {
            "type": "string"
          },
          "salePrice": {
            "type": "string"
          },
          "normalPrice": {
            "type": "string"
          },
          "isOnSale": {
            "type": "string"
          },
          "savings": {
            "type": "string"
          },
          "metacriticScore": {
            "type": "string"
          },
          "steamRatingText": {
            "type": "string"
          },
          "steamRatingPercent": {
            "type": "string"
          },
          "steamRatingCount": {
            "type": "string"
          },
          "steamAppID": {
            "type": "string"
          },
          "releaseDate": {
            "type": "integer",
            "description": "Unix timestamp"
          },
          "lastChange": {
            "type": "integer",
            "description": "Unix timestamp"
          },
          "dealRating": {
            "type": "string"
          },
          "thumb": {
            "type": "string"
          }
        }
      },
      "Store": {
        "type": "object",
        "properties": {
          "storeID": {
            "type": "string"
          },
          "storeName": {
            "type": "string"
          },
          "isActive": {
            "type": "integer"
          },
          "images": {
            "type": "object",
            "properties": {
              "banner": {
                "type": "string"
              },
              "logo": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              }
            }
          }
        }
      },
      "GameSearchResult": {
        "type": "object",
        "properties": {
          "gameID": {
            "type": "string"
          },
          "steamAppID": {
            "type": "string",
            "nullable": true
          },
          "cheapest": {
            "type": "string"
          },
          "cheapestDealID": {
            "type": "string"
          },
          "external": {
            "type": "string",
            "description": "Game title"
          },
          "internalName": {
            "type": "string"
          },
          "thumb": {
            "type": "string"
          }
        }
      },
      "GameDetail": {
        "type": "object",
        "properties": {
          "info": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "steamAppID": {
                "type": "string"
              },
              "thumb": {
                "type": "string"
              }
            }
          },
          "cheapestPriceEver": {
            "type": "object",
            "properties": {
              "price": {
                "type": "string"
              },
              "date": {
                "type": "integer"
              }
            }
          },
          "deals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "storeID": {
                  "type": "string"
                },
                "dealID": {
                  "type": "string"
                },
                "price": {
                  "type": "string"
                },
                "retailPrice": {
                  "type": "string"
                },
                "savings": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": []
}
