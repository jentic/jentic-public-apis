                    "resellSsrs": true,
                    "resellUnitSsrs": 1,
                    "waiveSeatFee": true
                  }
                },
                "Resell SSRs And Do Not Auto Assign Seats": {
                  "description": "Example request for reselling SSRs, but no auto-assigning of passengers to new seats when reselling seat-dependent SSRs.",
                  "value": {
