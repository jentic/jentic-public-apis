    "/api/nsk/v3/booking": {
      "post": {
        "tags": [
          "booking"
        ],
        "summary": "Commits stateful changes made and processes the booking.",
        "description": "`IMPORTANT: This endpoint should NOT be called concurrently using the same session token to avoid performance\nproblems.`\nThis endpoint can be configured to allow for the newly created record locator to be returned in the response.\nThis is\nan API value that needs to be set in configuration, NskSystemOptions.ReturnPnrOnv3BookingPost = true.\nDefault behavior is to not return the new record locator.  This will require a SNOW ticket to change.\n\nGraphQL endpoint: bookingCommitv3",
        "operationId": "nsk_v3_booking_post",
        "requestBody": {
          "x-name": "request",
          "description": "Commit request.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommitRequestv2"
              }
            }
          },
          "required": true,
          "x-position": 1
        },
        "responses": {
          "201": {
            "description": "Committed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IJsonResponseOfCommitBookingResponse"
                }
              }
            }
          },
          "400": {
            "description": "There was a problem with the request and it could not be completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IJsonResponse"
