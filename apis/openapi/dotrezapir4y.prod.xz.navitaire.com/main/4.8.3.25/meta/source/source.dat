        ],
        "summary": "Sets the culture code for the lifetime of the token.",
        "description": "Note there is middleware that looks for \"Culture\" on every request in the headers or query string parameters.\nThese can be used if you want to set the culture for a single request only.\n\nGraphQL endpoint: tokenCultureSet",
        "operationId": "nsk_v1_token_culture_post",
        "parameters": [
          {
            "name": "defaultCultureCode",
