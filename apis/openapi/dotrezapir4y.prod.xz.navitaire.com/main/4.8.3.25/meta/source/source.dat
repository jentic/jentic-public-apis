          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DccAvailabilityBaseRequest"
              }
            }
          },
          "required": true,
          "x-position": 2
        },
        "responses": {
          "200": {
            "description": "OK. Request completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IJsonResponseOfDirectCurrencyConversionAvailability"
