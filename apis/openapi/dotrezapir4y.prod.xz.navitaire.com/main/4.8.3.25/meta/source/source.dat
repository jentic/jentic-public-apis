            "nullable": true
          },
          "inventoryControlType": {
            "description": "Inventory control.\n            ",
            "$ref": "#/components/schemas/InventoryControlType"
          },
          "changeReasonCode": {
            "description": "Change reason code.\n            ",
            "nullable": true,
            "$ref": "#/components/schemas/ChangeReasonCodes"
          }
        }
      },
