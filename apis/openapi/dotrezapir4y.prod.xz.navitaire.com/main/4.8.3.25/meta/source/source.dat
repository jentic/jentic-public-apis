                    "resellSsrs": true,
                    "resellUnitSsrs": 2,
                    "waiveSeatFee": true
                  }
                },
                "Do Not Resell Seat-Dependent SSRs": {
                  "description": "Example request for reselling SSRs, but no reselling of seat dependent SSRs.",
