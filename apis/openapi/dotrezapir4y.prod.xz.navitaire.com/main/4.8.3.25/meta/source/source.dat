    "/api/nsk/v1/resources/ExternalRates": {
      "get": {
        "tags": [
          "resources"
        ],
        "summary": "Retrieves the collection of external rate resources.",
        "description": "The external rates cache expiration is configurable as a number of minutes past the hour to expire.  This\nshould allow for better alignment with third party external rates providers' recommendations, which typically\nstate that external rates cache items should expire 5-7 minutes past the hour.  This can be configured in\nthe NskSystemOptions.ExternalRatesExpiration.  If no value is set, the API will default to five minutes\npast the hour.\nIf the value \"Enable External Currency Conversion\" is disabled in SkyPay, external rates won't be returned\nby this call.\nAdditionally, there are some edge cases where the cache entry expiration is created at or close to the configured\nexpiration time.  In these cases, an additional two minutes will be added to the cache expiration.\nFor example, if the configured external rate cache expiration is for five minutes after the hour, and the current\ntime is 12:04, the expiration will be 12:07 instead of 12:05.  This gives the cached item enough time to get set\ninto cache, but will expire quickly in order to refresh according to third party external rates providers' cache\nrequirements (refresh at 5-7 minutes past the hour).\n\nGraphQL endpoint: resourceExternalRates",
        "operationId": "nsk_v1_resources_ExternalRates_get",
        "parameters": [
          {
            "name": "ActiveOnly",
            "in": "query",
            "description": "Flag indicating to return just active only or all.\n            ",
            "schema": {
              "type": "boolean"
            },
            "x-position": 1
          },
          {
            "name": "CultureCode",
            "in": "query",
            "description": "The desired culture code to be returned.\n            ",
            "schema": {
              "type": "string",
              "maxLength": 17,
              "minLength": 0,
              "nullable": true
            },
            "x-position": 2
          },
          {
            "name": "ETag",
            "in": "query",
            "description": "The cache token for this request. Data will not be returned if etag still matches.\n            ",
            "schema": {
              "type": "string",
              "nullable": true
            },
            "x-position": 3
          },
          {
            "name": "StartIndex",
            "in": "query",
            "description": "The start index value for this request.\n            ",
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 2147483647,
              "minimum": 0,
              "nullable": true
            },
            "x-position": 4
          },
          {
            "name": "ItemCount",
            "in": "query",
            "description": "The item count value for this request.\n            ",
            "schema": {
              "type": "integer",
              "format": "int32",
              "maximum": 2147483647,
              "minimum": 0,
              "nullable": true
            },
            "x-position": 5
          }
        ],
        "responses": {
          "200": {
            "description": "OK. Request completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IJsonResponseOfIListOfExternalRate"
                }
              }
            }
          },
          "304": {
            "description": "The requested item has not been modified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IJsonResponse"
                }
              }
            }
          },
          "404": {
            "description": "The item was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IJsonResponse"
                }
              }
            }
          }
        }
      }
    },
