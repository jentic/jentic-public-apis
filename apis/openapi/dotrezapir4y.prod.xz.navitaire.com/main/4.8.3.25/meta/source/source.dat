          },
          "startDate": {
            "type": "string",
            "description": "The start date for the card to be blacklisted.\nDefaults to the current UTC-based date if not specified.\n            ",
            "format": "date-time",
            "nullable": true
          },
          "endDate": {
            "type": "string",
            "description": "The date when the card will be removed from the blacklist.\nIf not specified or set to null, the payment is blacklisted without expiration.\n            ",
            "format": "date-time",
            "nullable": true
          },
