    "/api/nsk/v1/booking/reset": {
      "delete": {
        "tags": [
          "booking"
        ],
        "summary": "Clears the current booking state.",
        "description": "`IMPORTANT: This endpoint should NOT be called concurrently using the same session token to avoid performance\nproblems.`\n\nGraphQL endpoint: bookingReset",
        "operationId": "nsk_v1_booking_reset_delete",
        "responses": {
          "200": {
            "description": "OK. Request completed successfully.",
