      "BlacklistPaymentEntry": {
        "type": "object",
        "description": "Defines the request for a card used in an external payment to be blacklisted.\n            ",
        "additionalProperties": false,
        "required": [
          "paymentKey"
        ],
        "properties": {
          "reason": {
            "description": "The reason why the card is being blacklisted.\nDefaults to None of no value is specified.\n            ",
