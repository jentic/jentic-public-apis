      "put": {
        "tags": [
          "booking/passengers"
        ],
        "summary": "Updates the collection of un-named or TBA passengers on the booking.",
        "description": "When Enforce Standard Group Booking setting is true, group name is required and\nun-named or TBA passengers will be setup with\nFirst Name: TBA, Middle Name: Sequential Numeric, Last Name = Group Name.\nWhen the setting is false, group name is not required and\npassengers will be setup with\nFirst Name: Sequential Alphabetic, Last Name: TBA\nIMPORTANT: This endpoint should NOT be called concurrently using the same session token to avoid performance\nproblems.\n\nGraphQL endpoint: passengersGroupBookingSet",
        "operationId": "nsk_v1_booking_passengers_groupBooking_put",
        "responses": {
          "200": {
            "description": "OK. Request completed successfully.",
