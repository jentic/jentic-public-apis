      "Availabilityv2": {
        "type": "object",
        "description": "Availabilityv2 represents the availability response based on the search criteria.\n            ",
        "additionalProperties": false,
        "properties": {
          "results": {
            "type": "array",
            "description": "The collection of trip results based on date and markets.\n            ",
