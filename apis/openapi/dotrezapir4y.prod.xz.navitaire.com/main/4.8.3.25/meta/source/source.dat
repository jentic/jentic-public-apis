      "get": {
        "tags": [
          "queues"
        ],
        "summary": "Gets the list of queues available.",
        "description": "This action requires a session token.\nThis endpoint has known issues where the total count returned is incorrect\nand on the first initial request, the count of the items returned is one less\nthan the requested page size. This is an issue with the underlying NewSkies\nremoting call and a bug has been logged to fix these issues.\n\nGraphQL endpoint: bookingQueuesv2",
        "operationId": "nsk_v2_queues_bookings_get",
        "parameters": [
          {
            "name": "QueueName",
            "in": "query",
