    "/api/nsk/v1/booking/retrieve/byRecordLocator/{recordLocator}": {
      "get": {
        "tags": [
          "booking/retrieve"
        ],
        "summary": "Gets a specific booking by record locator and stores it in state.",
        "description": "This endpoint requires a session token and is agent-only.\nIMPORTANT: This endpoint should NOT be called concurrently using the same session token to avoid performance\nproblems.\n\nGraphQL endpoint: bookingRetrieveByRecordLocator",
        "operationId": "nsk_v1_booking_retrieve_byRecordLocator_recordLocator_get",
        "parameters": [
          {
            "name": "recordLocator",
