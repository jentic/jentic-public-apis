    "/api/nsk/v1/booking/payments/voucher/reassess": {
      "put": {
        "tags": [
          "booking/payments"
        ],
        "summary": "Reassess the voucher payments on the current booking in state.\nThis will reverse non-adjustable voucher payments to balance the voucher when the booking is overpaid.\nThe use of the voucher is not considered in the reassessment of a non-adjustable voucher payment.\nMulti-use without adjustment vouchers will be prioritized over single-use without adjustment vouchers.\nVouchers with a longer expiration date will also be prioritized. The voucher type will be honored first and then\nthe expiration date.",
        "description": "IMPORTANT: This endpoint should NOT be called concurrently using the same session token to avoid performance\nproblems.\n\nGraphQL endpoint: paymentVouchersReassess",
        "operationId": "nsk_v1_booking_payments_voucher_reassess_put",
        "responses": {
          "200": {
            "description": "The item was updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IJsonResponse"
                }
              }
