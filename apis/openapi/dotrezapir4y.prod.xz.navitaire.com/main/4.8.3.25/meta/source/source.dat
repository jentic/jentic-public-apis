          {
            "name": "syncPassengerAndTravelDocGender",
            "in": "query",
            "description": "Indicates whether to synchronize the passenger and all its travel\ndocuments' gender. This will update the gender in the passengers[passengerKey] as well as the gender of the other\ntravel documents in the passengers[passengerKey].travelDocuments list in the booking model. The value defaults to\ntrue if not specified.\n            ",
