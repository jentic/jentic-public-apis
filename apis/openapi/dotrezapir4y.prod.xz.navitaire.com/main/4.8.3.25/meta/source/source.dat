      "CheckinRequirementsv2": {
        "type": "object",
        "description": "Defines the pre checkin requirements.\n            ",
        "additionalProperties": false,
        "properties": {
          "passengers": {
            "type": "object",
            "description": "The collection of passengers and there requirements to checkin.\nKey is the PassengerKey.\n            ",
