{
  "openapi": "3.0.4",
  "info": {
    "title": "Swagger Internal Transfer request - OpenAPI 3.0",
    "description": "This is an API document for Internal Transfer request.",
    "version": "1.0.1",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/puma-b38/Internal-transfer-request/1.0.1"
  },
  "servers": [
    {
      "url": "https://sourcing-automation.pdss.mypuma.net",
      "description": "Production"
    },
    {
      "url": "https://sourcing-automation.pdssstage.mypuma.net",
      "description": "Staging"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Operations about auth"
    },
    {
      "name": "Internal transfer",
      "description": "Operations about internal transfer request"
    }
  ],
  "paths": {
    "/auth/token": {
      "post": {
        "summary": "Request access token",
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/AuthSuccess"
          },
          "401": {
            "$ref": "#/components/responses/InvalidCredError"
          }
        },
        "operationId": "post-auth-token",
        "parameters": [],
        "requestBody": {
          "$ref": "#/components/requestBodies/auth"
        }
      }
    },
    "/chatbot/internal-transfer": {
      "parameters": [],
      "post": {
        "summary": "Internal transfer request",
        "tags": [
          "Internal transfer"
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/internal-transfer-request"
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/APIResponse"
          },
          "401": {
            "$ref": "#/components/responses/InvalidCredError"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Validation failed"
                    },
                    "details": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string",
                            "description": "Dot-separated path to the invalid field"
                          },
                          "error": {
                            "type": "string",
                            "description": "Human-readable error message"
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "invalid_so_number": {
                    "summary": "Invalid SO Number",
                    "value": {
                      "error": "Validation failed",
                      "details": [
                        {
                          "field": "payload.0.so_number",
                          "error": "Value error, Must contain only digits"
                        }
                      ]
                    }
                  },
                  "invalid_season": {
                    "summary": "Invalid Season Format",
                    "value": {
                      "error": "Validation failed",
                      "details": [
                        {
                          "field": "payload.0.season",
                          "error": "Value error, Season must end with '11' (Spring) or '21' (Autumn)"
                        }
                      ]
                    }
                  },
                  "invalid_article": {
                    "summary": "Invalid Article Format",
                    "value": {
                      "error": "Validation failed",
                      "details": [
                        {
                          "field": "payload.0.article",
                          "error": "Value error, Article must follow pattern: {digit} {two-digit}"
                        }
                      ]
                    }
                  },
                  "empty_factory_code": {
                    "summary": "Empty Factory Code",
                    "value": {
                      "error": "Validation failed",
                      "details": [
                        {
                          "field": "payload.0.factory_code",
                          "error": "Value error, Must be a non-empty string"
                        }
                      ]
                    }
                  },
                  "invalid_email": {
                    "summary": "Invalid Email Format",
                    "value": {
                      "error": "Validation failed",
                      "details": [
                        {
                          "field": "payload.0.updated_by",
                          "error": "value is not a valid email address: The email address is not valid. It must have exactly one @-sign."
                        }
                      ]
                    }
                  },
                  "multiple_errors": {
                    "summary": "Multiple Validation Errors",
                    "value": {
                      "error": "Validation failed",
                      "details": [
                        {
                          "field": "payload.0.so_number",
                          "error": "Value error, Must contain only digits"
                        },
                        {
                          "field": "payload.0.season",
                          "error": "Value error, Season must be 6 digits (YYYY11 or YYYY21)"
                        },
                        {
                          "field": "payload.1.factory_code",
                          "error": "Value error, Must be a non-empty string"
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "header",
            "name": "Authorization",
            "description": "Bearer Token"
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "xml": {
          "name": "##default"
        },
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "timestamp": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string",
            "example": "Job completed successfully"
          }
        }
      },
      "AuthSuccess": {
        "type": "object",
        "title": "Auth Success",
        "required": [
          "client_id",
          "client_secret"
        ],
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string"
          }
        }
      },
      "InvalidCredError": {
        "title": "InvalidCredError",
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "default": "Invalid client credentials",
            "example": "Invalid client credentials"
          }
        }
      }
    },
    "requestBodies": {
      "auth": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthSuccess"
            }
          }
        }
      },
      "internal-transfer-request": {
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "request_id": {
                    "type": "string"
                  },
                  "purchase_requisition": {
                    "type": "string"
                  },
                  "season": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  },
                  "article": {
                    "type": "string",
                    "pattern": "[0-9]+ [0-9]{2}$"
                  },
                  "so_number": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  },
                  "factory_code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "updated_at": {
                    "type": "string"
                  },
                  "updated_by": {
                    "type": "string",
                    "format": "email"
                  }
                }
              }
            },
            "examples": {
              "multiple-transfers": {
                "summary": "Multiple transfer requests",
                "value": [
                  {
                    "request_id": "2945245",
                    "purchase_requisition": "3004718909",
                    "season": "202611",
                    "article": "406887 05",
                    "so_number": "0123296842",
                    "factory_code": "FCNRF",
                    "updated_at": "2025-09-15",
                    "updated_by": "jeffy.fung@puma.com"
                  },
                  {
                    "request_id": "2945246",
                    "purchase_requisition": "3004718910",
                    "season": "202621",
                    "article": "406888 06",
                    "so_number": "0123296843",
                    "factory_code": "FCNRG",
                    "updated_at": "2025-09-16",
                    "updated_by": "john.doe@puma.com"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "JWT": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "AuthSuccess": {
        "description": "Granted access token with its info.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "x-examples": {
                "Example 1": {
                  "access_token": "feefe.efefe.fefefe",
                  "expires_in": 86400,
                  "token_type": "Bearer"
                }
              },
              "properties": {
                "access_token": {
                  "type": "string"
                },
                "expires_in": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 86400,
                  "example": 86400
                },
                "token_type": {
                  "type": "string",
                  "example": "Bearer",
                  "default": "Bearer"
                }
              }
            }
          }
        }
      },
      "InvalidCredError": {
        "description": "",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                }
              },
              "x-examples": {
                "Example 1": {
                  "error": "Invalid client credentials"
                }
              }
            },
            "examples": {
              "Example 1": {
                "value": {
                  "error": "Invalid client credentials"
                }
              }
            }
          }
        }
      },
      "APIResponse": {
        "description": "Success response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiResponse"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "JWT": []
    }
  ]
}
