{
  "openapi": "3.1.0",
  "info": {
    "title": "Mobile BFF - Onboarding Service API",
    "description": "Backend for Frontend (BFF) service for mobile onboarding journey.\n\n**Architecture:** Clean/Hexagonal, Reactive (WebFlux)\n\n**Security:** OAuth2/JWT, Zero-Trust\n\n**Compliance:** SAMA KYC/AML, Data Residency\n\nThis API provides mobile-optimized endpoints for customer onboarding including:\n- Content retrieval (T&C, Privacy Policy, Contracts)\n- Identity verification (Nationality, OTP, Nafath)\n- Personal information collection\n- Tax compliance (FATCA/CRS)\n- Card selection and personalization\n- Contract signing\n",
    "version": "1.0.0",
    "contact": {
      "name": "FAB KSA Mobile Team",
      "email": "mobile-support@fab.ksa"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://fab.ksa/licenses"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/NISHANTTYAGI1023/mobile-bff-onboarding-service-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.fab.ksa/v1",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Content",
      "description": "Retrieve onboarding content (T&C, Privacy Policy, Contracts)"
    },
    {
      "name": "Verification",
      "description": "Identity and eligibility verification (Nationality, OTP, Nafath, IVR)"
    },
    {
      "name": "Personal Information",
      "description": "Customer personal and employment details"
    },
    {
      "name": "Tax & Compliance",
      "description": "Tax information and FATCA compliance"
    },
    {
      "name": "Card Management",
      "description": "Card selection, limits, and personalization"
    },
    {
      "name": "Contracts",
      "description": "Contract retrieval and signing"
    }
  ],
  "security": [
    {
      "OAuth2": []
    },
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/onboarding/content/{contentType}": {
      "get": {
        "tags": [
          "Content"
        ],
        "summary": "Retrieve onboarding content",
        "description": "Retrieves Terms & Conditions and Privacy Policy (tncAndPrivacy) or\nContract documents (contracts: Murabaha, Commodity, Card).\n\nAggregates multiple downstream calls into single mobile-optimized response.\n",
        "operationId": "getContent",
        "parameters": [
          {
            "name": "contentType",
            "in": "path",
            "required": true,
            "description": "Type of content to retrieve",
            "schema": {
              "type": "string",
              "enum": [
                "tncAndPrivacy",
                "contracts"
              ]
            },
            "example": "tncAndPrivacy"
          }
        ],
        "responses": {
          "200": {
            "description": "Content retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ContentResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ContractsResponse"
                    }
                  ]
                },
                "examples": {
                  "tncAndPrivacy": {
                    "value": {
                      "termsAndConditions": {
                        "version": "v1.0",
                        "body": "<h1>Terms and Conditions</h1>",
                        "fileName": "tnc.pdf",
                        "url": "https://cdn.fab.ksa/tnc.pdf"
                      },
                      "privacyPolicy": {
                        "version": "v1.0",
                        "body": "<h1>Privacy Policy</h1>",
                        "fileName": "privacy.pdf",
                        "url": "https://cdn.fab.ksa/privacy.pdf"
                      }
                    }
                  },
                  "contracts": {
                    "value": {
                      "murabahaContract": {
                        "version": "v1.0",
                        "body": "<h1>Murabaha Contract</h1>",
                        "fileName": "murabaha.pdf",
                        "url": "https://cdn.fab.ksa/murabaha.pdf"
                      },
                      "commodityContract": {
                        "version": "v1.0",
                        "body": "<h1>Commodity Contract</h1>",
                        "fileName": "commodity.pdf",
                        "url": "https://cdn.fab.ksa/commodity.pdf"
                      },
                      "cardContract": {
                        "version": "v1.0",
                        "body": "<h1>Card Contract</h1>",
                        "fileName": "card.pdf",
                        "url": "https://cdn.fab.ksa/card.pdf"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/onboarding/verify-nationality": {
      "post": {
        "tags": [
          "Verification"
        ],
        "summary": "Verify nationality and eligibility",
        "description": "Validates customer eligibility based on Iqama number, phone number, and consent.\n\n**SAMA Compliance:** Captures consent for T&C, Privacy Policy, and Early Access Offer.\n",
        "operationId": "verifyNationality",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyNationalityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nationality verified successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyNationalityResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/onboarding/otp-generate": {
      "post": {
        "tags": [
          "Verification"
        ],
        "summary": "Generate OTP for phone verification",
        "description": "Sends a one-time password to the customer's mobile number for verification.",
