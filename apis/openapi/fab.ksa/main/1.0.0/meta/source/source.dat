    "/onboarding/tax-config": {
      "get": {
        "tags": [
          "Tax & Compliance"
        ],
        "summary": "Retrieve tax configuration",
        "description": "Retrieves FATCA/CRS master data including:\n- Document types\n- Account classifications\n- Address types\n- TIN reasons\n- Country list with TIN requirements\n",
