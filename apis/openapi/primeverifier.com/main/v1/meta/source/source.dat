      },
      "post": {
        "tags": [
          "Webhook"
        ],
        "summary": "Create a new webhook endpoint. A signing secret is auto-generated.\r\nAt least one event type must be specified in the `events` array.",
        "requestBody": {
          "content": {
            "application/json": {
