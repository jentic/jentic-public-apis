{"openapi":"3.0.0","info":{"title":"Embeddables API","version":"1.0.0","description":"Public API for Embeddables. Authenticate with the `x-api-key` header."},"servers":[{"url":"https://api.embeddables.com"}],"components":{"securitySchemes":{"ApiKeyAuth":{"type":"apiKey","in":"header","name":"x-api-key"}},"schemas":{"Embeddable":{"type":"object","properties":{"embeddable_id":{"type":"string","description":"Unique identifier of the embeddable."},"title":{"type":"string","nullable":true,"description":"Human-readable title, or null if unset."},"project_id":{"type":"string","description":"Project the embeddable belongs to."},"group_id":{"type":"string","nullable":true,"description":"Group the embeddable belongs to, or null."},"created_at":{"type":"string","description":"ISO-8601 creation timestamp."}},"required":["embeddable_id","title","project_id","group_id","created_at"],"example":{"embeddable_id":"flow_abc123","title":"Insurance quote flow","project_id":"proj_123","group_id":"grp_456","created_at":"2026-01-01T00:00:00.000Z"}},"Pagination":{"type":"object","properties":{"next_cursor":{"type":"string","nullable":true,"description":"Cursor for the next page, or null if none."}},"required":["next_cursor"]},"ListEmbeddablesResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Embeddable"}},"pagination":{"$ref":"#/components/schemas/Pagination"}},"required":["data","pagination"]},"ErrorResponse":{"type":"object","properties":{"error":{"type":"object","properties":{"code":{"type":"string","example":"UNAUTHORIZED"},"message":{"type":"string"},"requestId":{"type":"string"}},"required":["code","message","requestId"]}},"required":["error"]},"Entry":{"type":"object","properties":{"entry_id":{"type":"string","description":"Unique identifier of the entry."},"group_id":{"type":"string","description":"Group the entry belongs to."},"project_id":{"type":"string","description":"Project the entry belongs to."},"embeddable_id":{"type":"string","description":"Embeddable (flow) the entry belongs to."},"contact_id":{"type":"string","description":"Contact associated with the entry."},"first_updated_in_period":{"type":"string","description":"ISO-8601 UTC — earliest entries-row timestamp within the query window (updated_after..updated_before)."},"last_updated_in_period":{"type":"string","description":"ISO-8601 UTC — latest entries-row timestamp within the query window (updated_after..updated_before)."},"created_at":{"type":"string","description":"ISO-8601 UTC lifetime first timestamp. Only present when use_full_time_history=true (heavier query)."},"updated_at":{"type":"string","description":"ISO-8601 UTC lifetime last timestamp. Only present when use_full_time_history=true (heavier query)."},"entry_data":{"type":"string","description":"Stringified entry user data (PII)."},"utm_source":{"type":"string","nullable":true,"description":"Populated only when include_utm_params=true (from the latest flowpage:viewed event in the UTM search window); otherwise omitted."},"utm_medium":{"type":"string","nullable":true,"description":"Populated only when include_utm_params=true (from the latest flowpage:viewed event in the UTM search window); otherwise omitted."},"utm_campaign":{"type":"string","nullable":true,"description":"Populated only when include_utm_params=true (from the latest flowpage:viewed event in the UTM search window); otherwise omitted."},"utm_term":{"type":"string","nullable":true,"description":"Populated only when include_utm_params=true (from the latest flowpage:viewed event in the UTM search window); otherwise omitted."},"utm_content":{"type":"string","nullable":true,"description":"Populated only when include_utm_params=true (from the latest flowpage:viewed event in the UTM search window); otherwise omitted."}},"required":["entry_id","group_id","project_id","embeddable_id","contact_id","first_updated_in_period","last_updated_in_period","entry_data"],"example":{"entry_id":"entry_abc123","group_id":"grp_456","project_id":"proj_123","embeddable_id":"flow_abc123","contact_id":"contact_abc","first_updated_in_period":"2026-01-01T00:00:00.000Z","last_updated_in_period":"2026-01-02T00:00:00.000Z","entry_data":"{ \"email\": \"ada@lovelace.com\" }"}},"ListEntriesResponse":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Entry"}},"pagination":{"$ref":"#/components/schemas/Pagination"}},"required":["data","pagination"]},"ConversionsOverview":{"type":"object","properties":{"total_traffic":{"type":"object","properties":{"id":{"type":"string","description":"Metric id from the request, or total_traffic for aggregate traffic."},"count":{"type":"integer","minimum":0},"utm_source":{"type":"object","additionalProperties":{"type":"integer","minimum":0},"description":"UTM value → distinct-user count. Empty string key when unset."},"utm_medium":{"type":"object","additionalProperties":{"type":"integer","minimum":0},"description":"UTM value → distinct-user count. Empty string key when unset."},"utm_campaign":{"type":"object","additionalProperties":{"type":"integer","minimum":0},"description":"UTM value → distinct-user count. Empty string key when unset."}},"required":["id","count"]},"metrics":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string","description":"Metric id from the request, or total_traffic for aggregate traffic."},"count":{"type":"integer","minimum":0},"utm_source":{"type":"object","additionalProperties":{"type":"integer","minimum":0},"description":"UTM value → distinct-user count. Empty string key when unset."},"utm_medium":{"type":"object","additionalProperties":{"type":"integer","minimum":0},"description":"UTM value → distinct-user count. Empty string key when unset."},"utm_campaign":{"type":"object","additionalProperties":{"type":"integer","minimum":0},"description":"UTM value → distinct-user count. Empty string key when unset."}},"required":["id","count"]}}},"required":["total_traffic","metrics"]},"ConversionResponse":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/ConversionsOverview"}},"required":["data"]}},"parameters":{}},"paths":{"/api/v1/embeddables":{"get":{"tags":["Embeddables"],"summary":"List embeddables","description":"Returns a paginated list of the API key's project embeddables (keyset pagination).","security":[{"ApiKeyAuth":[]}],"parameters":[{"schema":{"type":"integer","minimum":1,"maximum":1000,"default":25,"description":"Max items to return (1–1000).","example":25},"required":false,"name":"limit","in":"query"},{"schema":{"type":"string","description":"Opaque pagination cursor from a previous response.","example":"eyJjcmVhdGVkQXQiOiI...\""},"required":false,"name":"cursor","in":"query"},{"schema":{"type":"string","description":"Project the API key belongs to (or send via the x-project-id header)."},"required":false,"name":"project_id","in":"query"},{"schema":{"type":"string","description":"Project the API key belongs to."},"required":false,"name":"x-project-id","in":"header"}],"responses":{"200":{"description":"A page of embeddables.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListEmbeddablesResponse"}}}},"400":{"description":"Invalid parameters (bad limit or cursor).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"API key lacks the required scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/entries":{"get":{"tags":["Entries"],"summary":"List entries","description":"Returns a paginated list of the project's entries in a UTC time window (default: last 24 hours UTC via updated_after/updated_before). Response uses first_updated_in_period / last_updated_in_period; pass use_full_time_history=true for lifetime created_at/updated_at (heavier). Optional include_utm_params attaches flat utm_* from flowpage:viewed (UTM window widened by utm_window_padding_days, default ±1). Requires analyticsDeanonymized.read (PII) or analyticsAnonymized.read (anonymized tables).","security":[{"ApiKeyAuth":[]}],"parameters":[{"schema":{"type":"integer","minimum":1,"maximum":1000,"default":25,"description":"Max items to return (1–1000).","example":25},"required":false,"name":"limit","in":"query"},{"schema":{"type":"string","description":"Opaque pagination cursor from a previous response."},"required":false,"name":"cursor","in":"query"},{"schema":{"type":"string","description":"Project the API key belongs to (or send via the x-project-id header)."},"required":false,"name":"project_id","in":"query"},{"schema":{"type":"string","enum":["last_updated_in_period","first_updated_in_period","lastUpdatedInPeriod","firstUpdatedInPeriod","updated_at","created_at","updatedAt","createdAt"],"default":"last_updated_in_period","description":"Sort field (default last_updated_in_period). updated_at/created_at sort by lifetime timestamps when use_full_time_history=true; otherwise they map to the period fields.","example":"last_updated_in_period"},"required":false,"name":"sort","in":"query"},{"schema":{"type":"string","enum":["asc","desc","ASC","DESC"],"default":"desc","description":"Sort direction (default desc).","example":"desc"},"required":false,"name":"direction","in":"query"},{"schema":{"type":"string","description":"UTC lower bound (exclusive) for the entries time window. ISO-8601 with Z or offset. Default: 24 hours before updated_before (or before now UTC).","example":"2026-01-01T00:00:00.000Z"},"required":false,"name":"updated_after","in":"query"},{"schema":{"type":"string","description":"UTC upper bound (exclusive) for the entries time window. ISO-8601 with Z or offset. Default: now UTC.","example":"2026-01-02T00:00:00.000Z"},"required":false,"name":"updated_before","in":"query"},{"schema":{"type":"string","enum":["true","false"],"default":"false","description":"When true, also resolve lifetime created_at/updated_at over all history for the page (heavier ClickHouse work). Default false — fast path uses only the UTC window.","example":"false"},"required":false,"name":"use_full_time_history","in":"query"},{"schema":{"type":"string","enum":["true","false"],"default":"false","description":"When true, attach utm_* from the latest non-empty flowpage:viewed campaign fields in the UTM search window. Default false — events are not queried.","example":"false"},"required":false,"name":"include_utm_params","in":"query"},{"schema":{"type":"integer","nullable":true,"minimum":0,"maximum":30,"default":1,"description":"Days to widen the UTM events window around updated_after/updated_before (±N). Default 1. Max 30.","example":1},"required":false,"name":"utm_window_padding_days","in":"query"},{"schema":{"type":"string","description":"Project the API key belongs to."},"required":false,"name":"x-project-id","in":"header"}],"responses":{"200":{"description":"A page of entries.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ListEntriesResponse"}}}},"400":{"description":"Invalid parameters (bad limit, cursor, or filters).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"API key lacks analyticsDeanonymized or analyticsAnonymized read scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}},"/api/v1/conversions":{"get":{"tags":["Conversions"],"summary":"Conversion counts","description":"Pass `metrics` (URL-encoded JSON: `tracked_event`, `event_key`, optional `id`/`title`). Returns `total_traffic` and per-metric counts; set `include_utm_params=true` for utm_source / utm_medium / utm_campaign breakdown maps. Requires analyticsDeanonymized.read (PII tables) or analyticsAnonymized.read (anonymized tables).","security":[{"ApiKeyAuth":[]}],"parameters":[{"schema":{"type":"string","description":"Project the API key belongs to (or send via the x-project-id header)."},"required":false,"name":"project_id","in":"query"},{"schema":{"type":"string","minLength":1,"description":"Embeddable (flow) id to scope conversion counts.","example":"flow_abc123"},"required":true,"name":"embeddable_id","in":"query"},{"schema":{"type":"string","minLength":1,"description":"URL-encoded JSON array of metrics: `tracked_event` (optional, default custom_event:triggered), `event_key`, optional `id` / `title`.","example":"[{\"tracked_event\":\"flowpage:viewed\",\"event_key\":\"landing_page_a,landing_page\"}]"},"required":true,"name":"metrics","in":"query"},{"schema":{"type":"string","enum":["true","false"],"default":"false","description":"When true, attach utm_source, utm_medium, and utm_campaign count maps on total_traffic and each metric. Default false — no UTM breakdown queries.","example":"false"},"required":false,"name":"include_utm_params","in":"query"},{"schema":{"type":"integer","nullable":true,"minimum":0,"maximum":30,"description":"Reserved for parity with /entries (±N around the list window). Default 1.","example":1},"required":false,"name":"utm_window_padding_days","in":"query"},{"schema":{"type":"string","description":"UTC lower bound (exclusive). Default: 7 days before updated_before (or before now UTC).","example":"2026-01-01T00:00:00.000Z"},"required":false,"name":"updated_after","in":"query"},{"schema":{"type":"string","description":"UTC upper bound (exclusive). Default: now UTC.","example":"2026-01-02T00:00:00.000Z"},"required":false,"name":"updated_before","in":"query"},{"schema":{"type":"string","description":"Project the API key belongs to."},"required":false,"name":"x-project-id","in":"header"}],"responses":{"200":{"description":"Conversion totals and per-metric counts; optional utm_* maps when include_utm_params=true.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConversionResponse"}}}},"400":{"description":"Invalid parameters.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"403":{"description":"API key lacks analyticsDeanonymized or analyticsAnonymized read scope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"429":{"description":"Rate limit exceeded.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"500":{"description":"Internal error.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}}}}}}}