              },
              "basketId": {
                "type": "string",
                "example": "basket50"
              },
              "trxId": {
                "type": "string",
                "example": 3894536578682735
              },
              "posId": {
                "type": "string",
                "example": "pos1"
              },
              "cashierId": {
                "type": "string",
                "example": "admin"
              }
            }
          }
        }
      },
      "validateResponse": {
        "type": "object",
        "description": "Response received from the backend for the service order call",
        "properties": {
          "responseCode": {
            "type": "string",
            "example": -1
          },
          "responseDesc": {
            "type": "string",
            "example": "Success"
          }
        }
      },
      "adviseRequest": {
        "properties": {
          "action": {
            "type": "string",
            "example": "FINALISE"
          },
          "originalTrx": {
            "properties": {
              "storeTrxDetails": {
                "properties": {
                  "storeId": {
                    "type": "string",
                    "example": 1050
                  },
                  "basketId": {
                    "type": "string",
                    "example": "Test VSP 09-05-2015 15:42:13"
                  },
                  "trxId": {
                    "type": "string",
                    "example": 1543
                  },
                  "posId": {
                    "type": "string",
                    "example": 8
                  },
                  "cashierId": {
                    "type": "string",
                    "example": "Sam"
                  }
                }
              },
              "wiTrxId": {
                "type": "string",
                "example": 21752
              },
              "type": {
                "type": "string",
                "example": "PAYMENT"
              },
              "vspTrxId": {
                "type": "string",
                "example": 12
              }
            }
          },
          "vspCredentials": {
            "properties": {
              "id": {
                "type": "string",
                "example": "AAAAAA"
              },
              "password": {
                "type": "string",
                "example": "AAAAAA"
              }
            }
          }
        }
      },
      "adviseResponse": {
        "type": "object",
        "description": "Response received from the backend for the service order call",
        "properties": {
          "responseCode": {
            "type": "string",
            "example": -1
          },
          "responseDesc": {
            "type": "string",
            "example": "Success"
          }
        }
      },
      "ErrorNotFound": {
        "type": "object",
        "properties": {
          "sourceTransactionId": {
            "maxLength": 36,
            "minLength": 36,
            "type": "string",
            "format": "uuid",
            "description": "Correlating back the same source transaction ID which was sent in the request object for this transaction. This will help us in tracking the overall request and response flow. UUID should be string with 36 characters (32 hex digits + 4 dashes)",
            "example": "123e4567-e89b-42d3-a456-556642440000"
          },
          "apiGatewayTransactionId": {
            "type": "string",
            "description": "ApiGateway transaction ID correlating back the same source transaction ID which was  sent in the request object for this transaction.",
            "example": "apigateway-00000-0000000-0"
          },
          "errorCode": {
            "type": "string",
            "example": "404"
          },
          "errorType": {
            "type": "string",
            "example": "BusinessRuleViolation"
          },
          "details": {
