  "components": {
    "securitySchemes": {
      "oAuth2ClientCredentials": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://qaapix.vodacom.co.za/oauth-framework/generateaccesstoken",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "notificationrequest": {
        "properties": {
          "customerId": {
            "type": "string",
            "example": "27729092452"
          },
          "customerIdType": {
            "type": "string",
            "example": "MSISDN"
          },
          "sourceId": {
            "type": "string",
            "example": "Contact Centre"
          },
          "messageTypeId": {
            "type": "string",
            "example": "Directory Enquiries"
          },
          "transactionId": {
            "type": "string",
            "example": "123456 "
          },
          "messageText": {
            "type": "string",
            "example": "123456 "
          },
          "messageTemplate": {
            "type": "object",
            "properties": {
              "templateId": {
                "type": "string",
                "example": "MessageTemplateDirectoryEnquiry"
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                },
                "example": [
                  {
                    "name": "company",
                    "value": "vodacom"
                  },
                  {
                    "name": "companyNumber",
                    "value": "00000"
                  }
                ]
              }
            }
          }
        },
        "description": "This is the service orders API call for Tier 2 Partners"
      },
      "notificationResponse": {
        "type": "object",
        "description": "Response received from the backend for the service order call",
        "properties": {
          "sourceTransactionId": {
            "type": "string",
            "description": "Correlating back the same source transaction ID which was sent in the request object for this transaction. This will help us in tracking the overall request and response flow. UUID should be string with 36 characters (32 hex digits + 4 dashes)ashes)",
            "example": "c0f6312a-a643-436c-b111-763062ac06ae"
          },
          "apiGatewayTransactionId": {
            "type": "string",
            "example": "apigateway-656832-111461-1"
          },
          "backendResponse": {
            "type": "object",
            "properties": {
              "requestStatus": {
                "type": "string",
                "example": "Message submitted to notifier."
              },
              "channelsSubmitted": {
                "type": "array",
                "items": {
                  "type": "string",
                  "example": "SMS"
                }
              }
            }
          }
        }
      },
      "initiateRequest": {
        "properties": {
          "wiTrxId": {
            "type": "string",
            "example": 263012
          },
          "token": {
            "properties": {
              "id": {
                "type": "string",
                "example": 536598854
              },
              "type": {
                "type": "string",
                "example": "WICODE"
              },
              "vspReference": {
                "type": "string",
                "example": 12
              }
            }
          },
          "type": {
            "type": "string",
            "example": "PAYMENT"
          },
          "storeTrxDetails": {
            "properties": {
              "storeId": {
                "type": "string",
                "example": 1050
              },
              "remoteStoreId": {
                "type": "string",
                "example": "12345abc"
              },
              "retailerId": {
                "type": "string",
                "example": 999
              },
              "basketId": {
                "type": "string",
                "example": "basket50"
              },
              "trxId": {
                "type": "string",
                "example": 3894536578682735
              },
              "posId": {
                "type": "string",
                "example": "pos1"
              },
              "cashierId": {
                "type": "string",
                "example": "admin"
              }
            }
          },
          "totalAmount": {
            "type": "string",
            "example": 10000
          },
          "basketAmount": {
            "type": "string",
            "example": 0
          },
          "products": {
            "type": "array",
            "items": {
              "properties": {
                "id": {
                  "type": "string",
                  "example": "example_sku_1"
                },
                "units": {
                  "type": "string",
                  "example": 1
                },
                "pricePerUnit": {
                  "type": "string",
                  "example": 1
                }
              }
            }
          },
          "vspCredentials": {
            "properties": {
              "id": {
                "type": "string",
                "example": "AAAAAA"
              },
              "password": {
                "type": "string",
                "example": "AAAAAA"
              }
            }
          }
        }
      },
      "initiateResponse": {
        "type": "object",
        "description": "Response received from the backend for the service order call",
        "properties": {
          "responseCode": {
            "type": "string",
            "example": -1
          },
          "responseDesc": {
            "type": "string",
            "example": "Success"
          },
          "vspTrxId": {
            "type": "string",
            "example": 1924
          },
          "totalAmountProcessed": {
            "type": "integer",
            "example": 900.0
          },
          "basketAmountProcessed": {
            "type": "integer",
            "example": 900.0
          },
          "cashbackAmountProcessed": {
            "type": "integer",
            "example": 0
          },
          "id": {
            "type": "integer",
            "example": 1234
          },
          "name": {
            "type": "string",
            "example": "VSP_50943"
          }
        }
      },
      "validateRequest": {
        "properties": {
          "token": {
            "properties": {
              "id": {
                "type": "string",
                "example": 536598854
              },
              "type": {
                "type": "string",
                "example": "WICODE"
              }
            }
          },
          "type": {
            "type": "string",
            "example": "PAYMENT"
