{
  "openapi": "3.0.3",
  "info": {
    "title": "SmartThings API",
    "description": "Samsung SmartThings API for IoT device management. Control smart home devices, manage locations, rooms, scenes, and automations. Supports device commands, status queries, and event subscriptions.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://developer.smartthings.com/docs/api-ref/st-api"
  },
  "servers": [
    {
      "url": "https://api.smartthings.com/v1",
      "description": "SmartThings API v1"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/devices": {
      "get": {
        "operationId": "listDevices",
        "summary": "List Devices",
        "description": "List all devices available to the authenticated user.",
        "parameters": [
          {
            "name": "capability",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by capability (e.g. 'switch', 'temperatureMeasurement')"
          },
          {
            "name": "locationId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deviceId",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Device list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Device"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/devices/{deviceId}": {
      "get": {
        "operationId": "getDevice",
        "summary": "Get Device",
        "description": "Get details of a specific device.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Device details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Device"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteDevice",
        "summary": "Delete Device",
        "description": "Delete a device.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Device deleted"
          }
        }
      }
    },
    "/devices/{deviceId}/status": {
      "get": {
        "operationId": "getDeviceStatus",
        "summary": "Get Device Status",
        "description": "Get the full status of a device including all component and capability values.",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Device status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceStatus"
                }
              }
            }
          }
        }
      }
    },
    "/devices/{deviceId}/commands": {
      "post": {
        "operationId": "executeDeviceCommands",
        "summary": "Execute Device Commands",
        "description": "Execute commands on a device (e.g., turn on/off, set level).",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeviceCommandsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Commands executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/locations": {
      "get": {
        "operationId": "listLocations",
        "summary": "List Locations",
        "description": "List all locations for the authenticated user.",
        "responses": {
          "200": {
            "description": "Location list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Location"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createLocation",
        "summary": "Create Location",
        "description": "Create a new location.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocationCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created location",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          }
        }
      }
    },
    "/locations/{locationId}": {
      "get": {
        "operationId": "getLocation",
        "summary": "Get Location",
        "description": "Get a specific location.",
        "parameters": [
          {
            "name": "locationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Location details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Location"
                }
              }
            }
          }
        }
      }
    },
    "/locations/{locationId}/rooms": {
      "get": {
        "operationId": "listRooms",
        "summary": "List Rooms",
        "description": "List rooms in a location.",
        "parameters": [
          {
            "name": "locationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Room list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Room"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/scenes": {
      "get": {
        "operationId": "listScenes",
        "summary": "List Scenes",
        "description": "List all scenes available to the user.",
        "parameters": [
          {
            "name": "locationId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scene list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Scene"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/scenes/{sceneId}/execute": {
      "post": {
        "operationId": "executeScene",
        "summary": "Execute Scene",
        "description": "Execute a scene.",
        "parameters": [
          {
            "name": "sceneId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scene executed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/installedapps": {
      "get": {
        "operationId": "listInstalledApps",
        "summary": "List Installed Apps",
        "description": "List installed SmartApps.",
        "parameters": [
          {
            "name": "locationId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Installed apps list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "installedAppId": {
                            "type": "string"
                          },
                          "installedAppType": {
                            "type": "string"
                          },
                          "installedAppStatus": {
                            "type": "string"
                          },
                          "displayName": {
                            "type": "string"
                          },
                          "appId": {
                            "type": "string"
                          },
                          "locationId": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/subscriptions": {
      "get": {
        "operationId": "listSubscriptions",
        "summary": "List Subscriptions",
        "description": "List event subscriptions for an installed app.",
        "parameters": [
          {
            "name": "installedAppId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Subscription list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "installedAppId": {
                            "type": "string"
                          },
                          "sourceType": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal Access Token (PAT) or OAuth2 access token"
      }
    },
    "schemas": {
      "Device": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "deviceManufacturerCode": {
            "type": "string"
          },
          "locationId": {
            "type": "string"
          },
          "roomId": {
            "type": "string"
          },
          "deviceTypeId": {
            "type": "string"
          },
          "deviceTypeName": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "capabilities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "version": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "DeviceStatus": {
        "type": "object",
        "properties": {
          "components": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "value": {},
                    "unit": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "DeviceCommandsRequest": {
        "type": "object",
        "required": [
          "commands"
        ],
        "properties": {
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "component",
                "capability",
                "command"
              ],
              "properties": {
                "component": {
                  "type": "string",
                  "description": "Component ID (usually 'main')"
                },
                "capability": {
                  "type": "string",
                  "description": "Capability ID (e.g. 'switch')"
                },
                "command": {
                  "type": "string",
                  "description": "Command name (e.g. 'on', 'off', 'setLevel')"
                },
                "arguments": {
                  "type": "array",
                  "items": {},
                  "description": "Command arguments"
                }
              }
            }
          }
        }
      },
      "Location": {
        "type": "object",
        "properties": {
          "locationId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "regionRadius": {
            "type": "integer"
          },
          "temperatureScale": {
            "type": "string",
            "enum": [
              "F",
              "C"
            ]
          },
          "timeZoneId": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          }
        }
      },
      "LocationCreate": {
        "type": "object",
        "required": [
          "name",
          "countryCode"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "temperatureScale": {
            "type": "string",
            "enum": [
              "F",
              "C"
            ]
          },
          "locale": {
            "type": "string"
          }
        }
      },
      "Room": {
        "type": "object",
        "properties": {
          "roomId": {
            "type": "string"
          },
          "locationId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Scene": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string"
          },
          "sceneName": {
            "type": "string"
          },
          "sceneIcon": {
            "type": "string"
          },
          "sceneColor": {
            "type": "string"
          },
          "locationId": {
            "type": "string"
          }
        }
      }
    }
  }
}
