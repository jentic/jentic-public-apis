{
  "swagger": "2.0",
  "info": {
    "title": "LivBnB Partner API",
    "description": "Integrated API for Property Search, Details, Availability, and Pricing.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/livbnbvacationhomesr/Livbnb-Partner-API/1.0.0"
  },
  "host": "api.livbnb.com",
  "basePath": "/api",
  "schemes": [
    "https"
  ],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Format: Bearer <your_token>"
    }
  },
  "paths": {
    "/authentication": {
      "get": {
        "summary": "Validate Authentication Token",
        "description": "Check the validity of the Bearer token and retrieve account status.",
        "tags": [
          "Security"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK - Token is valid",
            "schema": {
              "$ref": "#/definitions/AuthResponse"
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or expired token",
            "schema": {
              "$ref": "#/definitions/StructuredErrorResponse"
            }
          },
          "403": {
            "description": "Forbidden - Account disabled",
            "schema": {
              "$ref": "#/definitions/StructuredErrorResponse"
            }
          },
          "500": {
            "description": "Server Error - Service unavailable",
            "schema": {
              "$ref": "#/definitions/StructuredErrorResponse"
            }
          }
        }
      }
    },
    "/properties/search": {
      "get": {
        "summary": "Search Properties",
        "tags": [
          "Search"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "type": "string",
            "default": "dubai"
          },
          {
            "name": "location",
            "in": "query",
            "type": "string",
            "enum": [
              "dubai marina",
              "palm jumeirah"
            ]
          },
          {
            "name": "checkIn",
            "in": "query",
            "type": "string",
            "format": "date"
          },
          {
            "name": "checkOut",
            "in": "query",
            "type": "string",
            "format": "date"
          },
          {
            "name": "adults",
            "in": "query",
            "type": "integer"
          },
          {
            "name": "children",
            "in": "query",
            "type": "integer"
          },
          {
            "name": "rooms",
            "in": "query",
            "type": "integer"
          },
          {
            "name": "page",
            "in": "query",
            "type": "integer"
          },
          {
            "name": "pageSize",
            "in": "query",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/SearchResponse"
            }
          }
        }
      }
    },
    "/properties": {
      "get": {
        "summary": "Property Details",
        "tags": [
          "Property"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "type": "string",
            "default": "214536"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/PropertyDetail"
            }
          }
        }
      }
    },
    "/properties/{id}/availability": {
      "get": {
        "summary": "Calendar Availability",
        "tags": [
          "Property"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "checkin",
            "in": "query",
            "required": true,
            "type": "string",
            "format": "date"
          },
          {
            "name": "checkout",
            "in": "query",
            "required": true,
            "type": "string",
            "format": "date"
          },
          {
            "name": "guests",
            "in": "query",
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/AvailabilityResponse"
            }
          }
        }
      }
    },
    "/properties/{id}/pricebreakdown": {
      "get": {
        "summary": "Price Breakdown",
        "tags": [
          "Pricing"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "checkin",
            "in": "query",
            "required": true,
            "type": "string",
            "format": "date"
          },
          {
            "name": "checkout",
            "in": "query",
            "required": true,
            "type": "string",
            "format": "date"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/QuoteResponse"
            }
          }
        }
      }
    },
    "/booking": {
      "post": {
        "summary": "Create a New Booking",
        "tags": [
          "Booking"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateBookingRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booking saved successfully",
            "schema": {
              "$ref": "#/definitions/BookingSuccessResponse"
            }
          },
          "400": {
            "description": "Database or validation error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "Internal server error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    },
    "/terms": {
      "get": {
        "summary": "Get Terms and Policies",
        "description": "Returns static information regarding fees, penalties, and legal terms and conditions.",
        "tags": [
          "Legal & Policies"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/TermsResponse"
            }
          }
        }
      }
    },
    "/privacy": {
      "get": {
        "summary": "Get Privacy Policy",
        "tags": [
          "Legal & Privacy"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/PrivacyResponse"
            }
          }
        }
      }
    },
    "/faq": {
      "get": {
        "summary": "Get Frequently Asked Questions",
        "tags": [
          "Support & Info"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/FAQResponse"
            }
          }
        }
      }
    },
    "/booking/{id}": {
      "get": {
        "summary": "Get Booking Details",
        "description": "Retrieve full details of a specific booking by its ID.",
        "tags": [
          "Booking Management"
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the booking to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/BookingDetail"
            }
          },
          "400": {
            "description": "Invalid ID format",
            "schema": {
              "$ref": "#/definitions/StructuredErrorResponse"
            }
          },
          "403": {
            "description": "Access Denied",
            "schema": {
              "$ref": "#/definitions/StructuredErrorResponse"
            }
          },
          "500": {
            "description": "Server Error",
            "schema": {
              "$ref": "#/definitions/StructuredErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "AuthResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "properties": {
            "userId": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "lastLogin": {
              "type": "string",
              "format": "date-time"
            },
            "isActive": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "BookingDetail": {
      "type": "object",
      "properties": {
        "bookingId": {
          "type": "string"
        },
        "checkin": {
          "type": "string",
          "format": "date"
        },
        "checkout": {
          "type": "string",
          "format": "date"
        },
        "guests": {
          "type": "integer"
        },
        "guestFirstName": {
          "type": "string"
        },
        "guestLastName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "specialRequest": {
          "type": "string"
        },
        "quoteId": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "accommodationFare": {
          "type": "number"
        },
        "cleaningFee": {
          "type": "number"
        },
        "processingFee": {
          "type": "number"
        },
        "vatFee": {
          "type": "number"
        },
        "tourismTax": {
          "type": "number"
        },
        "weeklyDiscount": {
          "type": "number"
        },
        "monthlyDiscount": {
          "type": "number"
        }
      }
    },
    "StructuredErrorResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      }
    },
    "CreateBookingRequest": {
      "type": "object",
      "required": [
        "uplistingId",
        "checkin",
        "checkout",
        "guests",
        "email",
        "quoteId"
      ],
      "properties": {
        "uplistingId": {
          "type": "string"
        },
        "checkin": {
          "type": "string",
          "format": "date"
        },
        "checkout": {
          "type": "string",
          "format": "date"
        },
        "guests": {
          "type": "integer"
        },
        "guestFirstName": {
          "type": "string"
        },
        "guestLastName": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "specialRequest": {
          "type": "string"
        },
        "quoteId": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "accommodationFare": {
          "type": "number"
        },
        "cleaningFee": {
          "type": "number"
        },
        "processingFee": {
          "type": "number"
        },
        "vatFee": {
          "type": "number"
        },
        "tourismTax": {
          "type": "number"
        },
        "weeklyDiscount": {
          "type": "number"
        },
        "monthlyDiscount": {
          "type": "number"
        }
      }
    },
    "BookingSuccessResponse": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      }
    },
    "FAQResponse": {
      "type": "object",
      "properties": {
        "faq": {
          "type": "object",
          "properties": {
            "introduction": {
              "type": "string"
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FAQEntry"
              }
            }
          }
        }
      }
    },
    "FAQEntry": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "PrivacyResponse": {
      "type": "object",
      "properties": {
        "privacy_policy": {
          "type": "object",
          "properties": {
            "introduction": {
              "type": "string"
            },
            "clauses": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/PrivacyClause"
              }
            }
          }
        }
      }
    },
    "PrivacyClause": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "content": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Used when the clause has multiple paragraphs"
        },
        "body": {
          "type": "string",
          "description": "Used when the clause is a single block of text"
        }
      }
    },
    "TermsResponse": {
      "type": "object",
      "properties": {
        "fees_and_policies": {
          "type": "object",
          "properties": {
            "lost_items": {
              "type": "object",
              "properties": {
                "lost_key": {
                  "$ref": "#/definitions/FeeItem"
                },
                "lost_access_card": {
                  "$ref": "#/definitions/FeeItem"
                },
                "lost_parking_remote": {
                  "$ref": "#/definitions/FeeItem"
                }
              }
            },
            "penalties": {
              "type": "object",
              "properties": {
                "smoking_penalty": {
                  "$ref": "#/definitions/FeeItem"
                }
              }
            },
            "cleaning": {
              "type": "object",
              "properties": {
                "additional_cleaning": {
                  "type": "object",
                  "properties": {
                    "chargeable": {
                      "type": "boolean"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "security_deposit": {
              "type": "object",
              "properties": {
                "mandatory": {
                  "type": "boolean"
                },
                "due": {
                  "type": "string"
                },
                "refund_timeline": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          }
        },
        "terms_and_conditions": {
          "type": "object",
          "properties": {
            "introduction": {
              "type": "string"
            },
            "clauses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "FeeItem": {
      "type": "object",
      "properties": {
        "charge": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "SearchResponse": {
      "type": "object",
      "properties": {
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PropertyDetail"
          }
        },
        "totalCount": {
          "type": "integer"
        },
        "page": {
          "type": "integer"
        },
        "pageSize": {
          "type": "integer"
        },
        "totalPages": {
          "type": "integer"
        }
      }
    },
    "PropertyDetail": {
      "type": "object",
      "properties": {
        "uplistingId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "beds": {
          "type": "integer"
        },
        "bedrooms": {
          "type": "integer"
        },
        "bathrooms": {
          "type": "number"
        },
        "accommodates": {
          "type": "integer"
        },
        "address": {
          "$ref": "#/definitions/Address"
        },
        "publicDescription": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            }
          }
        },
        "rating": {
          "type": "number"
        },
        "cancellationPolicy": {
          "type": "string",
          "enum": [
            "strict",
            "firm",
            "moderate"
          ]
        },
        "price": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        },
        "suitability": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pictures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Picture"
          }
        },
        "amenities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "type": "string"
        },
        "defaultCheckInTime": {
          "type": "string"
        },
        "defaultCheckOutTime": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        }
      }
    },
    "AvailabilityResponse": {
      "type": "object",
      "properties": {
        "calendar": {
          "type": "object",
          "properties": {
            "days": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/CalendarDay"
              }
            }
          }
        }
      }
    },
    "CalendarDay": {
      "type": "object",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "available_count": {
          "type": "integer"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "day_rate": {
          "type": "number"
        },
        "minimum_length_of_stay": {
          "type": "integer"
        },
        "maximum_available_nights": {
          "type": "integer"
        },
        "closed_for_arrival": {
          "type": "boolean"
        },
        "closed_for_departure": {
          "type": "boolean"
        }
      }
    },
    "QuoteResponse": {
      "type": "object",
      "properties": {
        "quoteId": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        },
        "accommodationFare": {
          "type": "number"
        },
        "cleaningFee": {
          "type": "number"
        },
        "processingFee": {
          "type": "number"
        },
        "vatFee": {
          "type": "number"
        },
        "tourismTax": {
          "type": "number"
        },
        "weeklyDiscount": {
          "type": "number"
        },
        "monthlyDiscount": {
          "type": "number"
        }
      }
    },
    "Address": {
      "type": "object",
      "properties": {
        "full": {
          "type": "string"
        },
        "lng": {
          "type": "number"
        },
        "lat": {
          "type": "number"
        },
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "neighborhood": {
          "type": "string"
        }
      }
    },
    "Picture": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        }
      }
    }
  }
}
