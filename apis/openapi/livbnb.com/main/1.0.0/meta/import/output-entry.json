{
  "openapi": "3.0.0",
  "info": {
    "description": "Integrated API for Property Search, Details, Availability, and Pricing.",
    "title": "LivBnB Partner API",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/livbnbvacationhomesr/Livbnb-Partner-API/1.0.0"
