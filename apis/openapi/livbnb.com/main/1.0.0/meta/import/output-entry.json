  "paths": {
    "/authentication": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "OK - Token is valid"
          },
          "401": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredErrorResponse"
                }
              }
            },
            "description": "Unauthorized - Invalid or expired token"
          },
          "403": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredErrorResponse"
                }
              }
            },
            "description": "Forbidden - Account disabled"
          },
          "500": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/StructuredErrorResponse"
                }
              }
            },
            "description": "Server Error - Service unavailable"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "tags": [
          "Security"
        ],
        "description": "Check the validity of the Bearer token and retrieve account status.",
        "summary": "Validate Authentication Token"
      }
    },
    "/booking": {
      "post": {
