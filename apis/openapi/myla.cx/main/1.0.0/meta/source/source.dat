{"openapi":"3.1.0","info":{"title":"Myla Developer API","version":"1.0.0","description":"The Myla Developer API lets you read and manage your Myla data programmatically — contacts, conversations, and outbound webhooks.\n\n## Authentication\nAll requests require a brand-scoped API key sent as a Bearer token:\n\n```\nAuthorization: Bearer myla_sk_xxxxxxxx\n```\n\nCreate a key in your Myla dashboard under **Settings → Integrations → Developer API**. Each key is scoped to a single brand/workspace.\n\n## Responses\nSuccessful responses wrap the payload in a `data` field. List endpoints also include a `meta` object with `page`, `limit`, and `total`. Errors return an `error` string with the relevant HTTP status code.\n\n## Rate limits\nRequests are rate limited per API key. If you exceed the limit you will receive an HTTP 429 response; retry after a short delay.","contact":{"name":"Myla Support","email":"support@myla.cx"}},"servers":[{"url":"https://api.myla.cx","description":"Production"}],"security":[{"bearerAuth":[]}],"tags":[{"name":"Account","description":"Verify the API key and brand."},{"name":"Contacts","description":"Create, read, update, and tag contacts."},{"name":"Conversations","description":"Read conversations and messages."},{"name":"Webhooks","description":"Subscribe to real-time events."}],"paths":{"/api/v1/me":{"get":{"tags":["Account"],"summary":"Verify credentials","description":"Returns the brand associated with the API key. Use this to test a connection.","responses":{"200":{"description":"The authenticated brand.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"brandId":{"type":"string"},"name":{"type":"string"}}}}}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}}}}},"/api/v1/contacts":{"get":{"tags":["Contacts"],"summary":"List contacts","description":"Returns contacts ordered by most recently updated. Optionally filter by email or phone.","parameters":[{"name":"page","in":"query","schema":{"type":"integer","minimum":1,"default":1},"description":"1-based page number."},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":50},"description":"Items per page (max 100)."},{"name":"email","in":"query","schema":{"type":"string","format":"email"},"description":"Case-insensitive exact email match."},{"name":"phone","in":"query","schema":{"type":"string"},"description":"Exact phone match."}],"responses":{"200":{"description":"A page of contacts.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string","nullable":true},"phone":{"type":"string","nullable":true},"email":{"type":"string","format":"email","nullable":true},"lifecycleStageId":{"type":"string","nullable":true},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"lifecycleStage":{"type":"object","nullable":true,"properties":{"id":{"type":"string"},"name":{"type":"string"}}},"tags":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"}}}},"fieldValues":{"type":"array","items":{"type":"object","properties":{"value":{"type":"string","nullable":true},"field":{"type":"object","properties":{"id":{"type":"string"},"key":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"}}}}}}}}},"meta":{"type":"object","properties":{"page":{"type":"integer"},"limit":{"type":"integer"},"total":{"type":"integer"}}}}}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}}}},"post":{"tags":["Contacts"],"summary":"Create or update a contact","description":"Upserts a contact by phone and/or email (at least one is required). If an existing contact matches, it is updated; otherwise a new one is created.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","nullable":true},"phone":{"type":"string","nullable":true},"email":{"type":"string","format":"email","nullable":true},"lifecycleStageId":{"type":"string","nullable":true},"customFields":{"type":"array","items":{"type":"object","required":["fieldId","value"],"properties":{"fieldId":{"type":"string"},"value":{"type":"string","nullable":true}}}}}}}}},"responses":{"201":{"description":"The created or updated contact.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string","nullable":true},"phone":{"type":"string","nullable":true},"email":{"type":"string","format":"email","nullable":true},"lifecycleStageId":{"type":"string","nullable":true},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"lifecycleStage":{"type":"object","nullable":true,"properties":{"id":{"type":"string"},"name":{"type":"string"}}},"tags":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"}}}},"fieldValues":{"type":"array","items":{"type":"object","properties":{"value":{"type":"string","nullable":true},"field":{"type":"object","properties":{"id":{"type":"string"},"key":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"}}}}}}}}}}}}},"400":{"description":"Validation error (e.g. no phone or email supplied).","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}},"404":{"description":"Referenced lifecycle stage or contact field not found.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}},"409":{"description":"Phone and email belong to different contacts.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}}}}},"/api/v1/contacts/{id}":{"get":{"tags":["Contacts"],"summary":"Get a contact","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"The contact.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string","nullable":true},"phone":{"type":"string","nullable":true},"email":{"type":"string","format":"email","nullable":true},"lifecycleStageId":{"type":"string","nullable":true},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"lifecycleStage":{"type":"object","nullable":true,"properties":{"id":{"type":"string"},"name":{"type":"string"}}},"tags":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"}}}},"fieldValues":{"type":"array","items":{"type":"object","properties":{"value":{"type":"string","nullable":true},"field":{"type":"object","properties":{"id":{"type":"string"},"key":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"}}}}}}}}}}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}},"404":{"description":"Contact not found.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}}}},"patch":{"tags":["Contacts"],"summary":"Update a contact","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","nullable":true},"phone":{"type":"string","nullable":true},"email":{"type":"string","format":"email","nullable":true},"lifecycleStageId":{"type":"string","nullable":true},"customFields":{"type":"array","items":{"type":"object","required":["fieldId","value"],"properties":{"fieldId":{"type":"string"},"value":{"type":"string","nullable":true}}}}}}}}},"responses":{"200":{"description":"The updated contact.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string","nullable":true},"phone":{"type":"string","nullable":true},"email":{"type":"string","format":"email","nullable":true},"lifecycleStageId":{"type":"string","nullable":true},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"},"lifecycleStage":{"type":"object","nullable":true,"properties":{"id":{"type":"string"},"name":{"type":"string"}}},"tags":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"}}}},"fieldValues":{"type":"array","items":{"type":"object","properties":{"value":{"type":"string","nullable":true},"field":{"type":"object","properties":{"id":{"type":"string"},"key":{"type":"string"},"name":{"type":"string"},"type":{"type":"string"}}}}}}}}}}}}},"400":{"description":"Validation error.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}},"404":{"description":"Contact not found.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}}}}},"/api/v1/contacts/{id}/tags":{"post":{"tags":["Contacts"],"summary":"Add tags to a contact","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["tagIds"],"properties":{"tagIds":{"type":"array","items":{"type":"string"},"minItems":1,"maxItems":100,"description":"IDs of existing tags to apply."}}}}}},"responses":{"200":{"description":"The contact's applied tags.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"contactId":{"type":"string"},"tags":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"name":{"type":"string"}}}}}}}}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}},"404":{"description":"Contact or tag not found.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}}}}},"/api/v1/conversations":{"get":{"tags":["Conversations"],"summary":"List conversations","parameters":[{"name":"page","in":"query","schema":{"type":"integer","minimum":1,"default":1},"description":"1-based page number."},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":50},"description":"Items per page (max 100)."}],"responses":{"200":{"description":"A page of conversations.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"contactId":{"type":"string","nullable":true},"channel":{"type":"string"},"status":{"type":"string"},"priority":{"type":"string","nullable":true},"customerName":{"type":"string","nullable":true},"customerEmail":{"type":"string","nullable":true},"customerPhone":{"type":"string","nullable":true},"awaitingReply":{"type":"boolean"},"lastMessageAt":{"type":"string","format":"date-time","nullable":true},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}}}},"meta":{"type":"object","properties":{"page":{"type":"integer"},"limit":{"type":"integer"},"total":{"type":"integer"}}}}}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}}}}},"/api/v1/conversations/{id}":{"get":{"tags":["Conversations"],"summary":"Get a conversation with messages","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"The conversation and its messages.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"allOf":[{"type":"object","properties":{"id":{"type":"string"},"contactId":{"type":"string","nullable":true},"channel":{"type":"string"},"status":{"type":"string"},"priority":{"type":"string","nullable":true},"customerName":{"type":"string","nullable":true},"customerEmail":{"type":"string","nullable":true},"customerPhone":{"type":"string","nullable":true},"awaitingReply":{"type":"boolean"},"lastMessageAt":{"type":"string","format":"date-time","nullable":true},"createdAt":{"type":"string","format":"date-time"},"updatedAt":{"type":"string","format":"date-time"}}},{"type":"object","properties":{"messages":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"senderType":{"type":"string"},"content":{"type":"string","nullable":true},"contentHtml":{"type":"string","nullable":true},"status":{"type":"string"},"sentAt":{"type":"string","format":"date-time","nullable":true},"createdAt":{"type":"string","format":"date-time"}}}}}}]}}}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}},"404":{"description":"Conversation not found.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}}}}},"/api/v1/webhooks":{"post":{"tags":["Webhooks"],"summary":"Subscribe to an event","description":"Registers a webhook that POSTs to your target URL when the event fires. Deliveries are HMAC-signed. Used by Zapier REST Hook triggers.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["event","targetUrl"],"properties":{"event":{"type":"string","enum":["message.received","conversation.opened","conversation.closed"]},"targetUrl":{"type":"string","format":"uri","description":"Public HTTPS URL to receive deliveries."}}}}}},"responses":{"201":{"description":"The created webhook subscription.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"id":{"type":"string"}}}}}}}},"400":{"description":"Invalid event or non-public webhook URL.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}}}}},"/api/v1/webhooks/{id}":{"delete":{"tags":["Webhooks"],"summary":"Unsubscribe","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"The subscription was removed.","content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"object","properties":{"id":{"type":"string"},"deleted":{"type":"boolean"}}}}}}}},"401":{"description":"Missing or invalid API key.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}},"404":{"description":"Webhook endpoint not found.","content":{"application/json":{"schema":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]}}}}}}}},"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"Brand-scoped API key from Settings → Integrations → Developer API."}}}}