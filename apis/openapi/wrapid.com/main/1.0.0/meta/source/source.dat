{
  "openapi": "3.0.3",
  "info": {
    "title": "WRapid Assessment API",
    "description": "The WRapid Assessment API provides endpoints for managing candidate assessments \nwithin the WRapid System. The API allows integration partners to list available \nassessments, start assessments for candidates, update assessment statuses, and \ncancel assessments.\n",
    "version": "1.0.0",
    "contact": {
      "name": "WRapid API Support"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/wolfsdorfrosenthalll/wrapid-assessment-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.wrapid.com/v1",
      "description": "Production Server"
    },
    {
      "url": "https://sandbox-api.wrapid.com/v1",
      "description": "Sandbox Server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Assessments",
      "description": "Assessment management operations"
    },
    {
      "name": "File Transfers",
      "description": "File upload and transfer operations"
    }
  ],
  "paths": {
    "/assessment.list": {
      "post": {
        "tags": [
          "Assessments"
        ],
        "summary": "List Assessments",
        "description": "Retrieves a list of all available assessments in your WRapid account.",
        "operationId": "listAssessments",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentListResponse"
                },
                "example": {
                  "success": true,
                  "results": [
                    {
                      "id": "aGJVm00000000G9OAI",
                      "title": "U.S. Visa Assessment",
                      "description": "Provides US Visa Assessment for a Candidate"
                    },
                    {
                      "id": "aGJVm00000000HlOAI",
                      "title": "Global Visa Assessment",
                      "description": "Provides Global Visa Assessment for a Candidate or Employee"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/assessment.start": {
      "post": {
        "tags": [
          "Assessments"
        ],
        "summary": "Start Assessment",
        "description": "Initiates an assessment for a specific candidate application.",
        "operationId": "startAssessment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartAssessmentRequest"
              },
              "example": {
                "assessmentId": "assessment_abc123",
                "applicationId": "application_xyz789",
                "candidateId": "candidate_123456",
                "callbackUrl": "https://your-domain.com/webhooks/assessment"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assessment started successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "A successful response returns an empty object"
                },
                "example": {}
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/assessment.cancel": {
      "post": {
        "tags": [
          "Assessments"
        ],
        "summary": "Cancel Assessment",
        "description": "Cancels an in-progress assessment for a candidate.",
        "operationId": "cancelAssessment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelAssessmentRequest"
              },
              "example": {
                "assessmentId": "assessment_abc123",
                "applicationId": "application_xyz789",
                "candidateId": "candidate_123456"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assessment cancelled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelAssessmentResponse"
                },
                "example": {
                  "success": true,
                  "message": "Assessment has been cancelled successfully"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/assessment.update": {
      "post": {
        "tags": [
          "Assessments"
        ],
        "summary": "Update Assessment",
        "description": "Updates the status or results of an existing assessment. \nTypically used to report assessment completion or results.\n",
        "operationId": "updateAssessment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAssessmentRequest"
              },
              "example": {
                "assessmentId": "assessment_abc123",
                "applicationId": "application_xyz789",
                "candidateId": "candidate_123456",
                "status": "completed",
                "score": 85,
                "resultUrl": "https://assessment-provider.com/results/abc123",
                "completedAt": "2024-01-15T14:30:00Z",
                "metadata": {
                  "percentile": 92,
                  "timeSpent": 3600
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assessment updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateAssessmentResponse"
                },
                "example": {
                  "success": true,
                  "assessment": {
                    "id": "assessment_abc123",
                    "applicationId": "application_xyz789",
                    "candidateId": "candidate_123456",
                    "status": "completed",
                    "score": 85,
                    "updatedAt": "2024-01-15T14:30:00Z"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key authentication using Bearer token"
      }
    },
    "schemas": {
      "StartAssessmentRequest": {
        "type": "object",
        "required": [
          "assessmentId",
          "applicationId",
          "candidateId"
        ],
        "properties": {
          "assessmentId": {
            "type": "string",
            "description": "The unique identifier of the assessment to start"
          },
          "applicationId": {
            "type": "string",
            "description": "The unique identifier of the candidate's application"
          },
          "candidateId": {
            "type": "string",
            "description": "The unique identifier of the candidate"
          },
          "callbackUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to receive webhook notifications for assessment updates"
          }
        }
      },
      "CancelAssessmentRequest": {
        "type": "object",
        "required": [
          "assessmentId",
          "applicationId",
          "candidateId"
        ],
        "properties": {
          "assessmentId": {
            "type": "string",
            "description": "The unique identifier of the assessment to cancel"
          },
          "applicationId": {
            "type": "string",
            "description": "The unique identifier of the candidate's application"
          },
          "candidateId": {
            "type": "string",
            "description": "The unique identifier of the candidate"
          }
        }
      },
      "UpdateAssessmentRequest": {
        "type": "object",
        "required": [
          "assessmentId",
          "applicationId",
          "candidateId",
          "status"
        ],
        "properties": {
          "assessmentId": {
            "type": "string",
            "description": "The unique identifier of the assessment"
          },
          "applicationId": {
            "type": "string",
            "description": "The unique identifier of the candidate's application"
          },
          "candidateId": {
            "type": "string",
            "description": "The unique identifier of the candidate"
          },
          "status": {
            "type": "string",
            "description": "The new status of the assessment",
            "enum": [
              "completed",
              "in_progress",
              "failed"
            ]
          },
          "score": {
            "type": "number",
            "description": "The assessment score (if applicable)"
          },
          "resultUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to view detailed assessment results"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of when the assessment was completed"
          },
          "metadata": {
            "type": "object",
            "description": "Additional custom data related to the assessment",
            "additionalProperties": true
          }
        }
      },
      "AssessmentListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates if the request was successful"
          },
          "results": {
            "type": "array",
            "description": "Array of assessment objects",
            "items": {
              "$ref": "#/components/schemas/Assessment"
            }
          }
        }
      },
      "Assessment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the assessment"
          },
          "title": {
            "type": "string",
            "description": "Name/title of the assessment"
          },
          "description": {
            "type": "string",
            "description": "Description of the assessment"
          }
        }
      },
      "CancelAssessmentResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates if the cancellation was successful"
          },
          "message": {
            "type": "string",
            "description": "Confirmation message"
          }
        }
      },
      "UpdateAssessmentResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates if the update was successful"
          },
          "assessment": {
            "$ref": "#/components/schemas/UpdatedAssessment"
          }
        }
      },
      "UpdatedAssessment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The assessment ID"
          },
          "applicationId": {
            "type": "string",
            "description": "The application ID"
          },
          "candidateId": {
            "type": "string",
            "description": "The candidate ID"
          },
          "status": {
            "type": "string",
            "description": "The current status"
          },
          "score": {
            "type": "number",
            "description": "The assessment score"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp of the last update"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Always false for errors",
            "example": false
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Error code identifier"
          },
          "message": {
            "type": "string",
            "description": "Human-readable error message"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request body is malformed or missing required fields",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "invalid_request",
                "message": "The request body is malformed or missing required fields"
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Invalid or missing API key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "unauthorized",
                "message": "Invalid or missing API key"
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "The API key does not have permission for this operation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "forbidden",
                "message": "The API key does not have permission for this operation"
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "The specified resource was not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "not_found",
                "message": "Assessment with ID 'assessment_abc123' was not found"
              }
            }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "rate_limited",
                "message": "Too many requests; please retry after the specified time"
              }
            }
          }
        }
      },
      "InternalError": {
        "description": "An unexpected server error occurred",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "internal_error",
                "message": "An unexpected server error occurred"
              }
            }
          }
        }
      }
    }
  }
}