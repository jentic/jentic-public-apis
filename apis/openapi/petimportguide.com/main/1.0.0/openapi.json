{
 "openapi": "3.0.0",
 "info": {
  "title": "Pet Import Guide API",
  "version": "1.0.0",
  "description": "Read-only JSON API of official-source-checked pet import rules (routes, airline pet policies, rule changes). CC BY 4.0. Cite the record's verified date.",
  "x-jentic-source-url": "https://petimportguide.com/api/v1/openapi.json",
  "contact": {}
 },
 "servers": [
  {
   "url": "https://petimportguide.com"
  }
 ],
 "paths": {
  "/api/v1/routes.json": {
   "get": {
    "summary": "Index of all verified pet import routes",
    "responses": {
     "200": {
      "description": "Route index"
     }
    }
   }
  },
  "/api/v1/routes/{routeId}.json": {
   "get": {
    "summary": "One route's full verified record",
    "parameters": [
     {
      "name": "routeId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "example": "united-states-to-japan-dog"
     }
    ],
    "responses": {
     "200": {
      "description": "Route record"
     }
    }
   }
  },
  "/api/v1/airlines.json": {
   "get": {
    "summary": "Index of verified airline pet policies",
    "responses": {
     "200": {
      "description": "Airline index"
     }
    }
   }
  },
  "/api/v1/airlines/{airlineSlug}.json": {
   "get": {
    "summary": "One airline's full verified policy record",
    "parameters": [
     {
      "name": "airlineSlug",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      },
      "example": "lufthansa"
     }
    ],
    "responses": {
     "200": {
      "description": "Airline record"
     }
    }
   }
  },
  "/api/v1/changes.json": {
   "get": {
    "summary": "Recent pet import rule changes",
    "responses": {
     "200": {
      "description": "Change log"
     }
    }
   }
  },
  "/api/v1/signals.json": {
   "get": {
    "summary": "Signals that may indicate rule changes",
    "responses": {
     "200": {
      "description": "Signals list"
     }
    }
   }
  }
 }
}
