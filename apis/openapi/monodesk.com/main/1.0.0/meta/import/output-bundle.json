{
  "openapi": "3.1.0",
  "info": {
    "title": "MonoDesk API",
    "version": "1.0.0",
    "description": "Discovery surface for MonoDesk API and MCP transport.",
    "x-jentic-source-url": "https://www.monodesk.com/.well-known/openapi.json"
  },
  "servers": [
    {
      "url": "https://api.monodesk.com"
    }
  ],
  "paths": {
    "/api/mcp/mcp": {
      "post": {
        "summary": "MonoDesk MCP streamable HTTP endpoint",
        "description": "Authenticated endpoint for MCP tool/resource/prompt access.",
        "security": [
          {
            "oauth2": [
              "openid",
              "profile",
              "email",
              "phone"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "MCP request accepted"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          }
        }
      },
      "get": {
        "summary": "MCP endpoint status check",
        "security": [
          {
            "oauth2": [
              "openid",
              "profile",
              "email",
              "phone"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "MCP endpoint reachable"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://qeepznvxluywnlkaqgnu.supabase.co/auth/v1/oauth/authorize",
            "tokenUrl": "https://qeepznvxluywnlkaqgnu.supabase.co/auth/v1/oauth/token",
            "scopes": {
              "openid": "OpenID Connect scope",
              "profile": "Basic profile access",
              "email": "Email access",
              "phone": "Phone access"
            }
          }
        }
      }
    }
  }
}