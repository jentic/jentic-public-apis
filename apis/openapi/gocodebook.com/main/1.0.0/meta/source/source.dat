            }
          },
          "403": {
            "description": "Needs paid access or a feature not enabled (e.g. the AI overview)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "request_id"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "type",
                        "code",
                        "message"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "invalid_request",
                            "authentication",
                            "permission",
                            "billing",
                            "rate_limited",
                            "not_found",
                            "api_error"
                          ]
                        },
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "param": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "docs": {
                          "type": "string"
                        }
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
