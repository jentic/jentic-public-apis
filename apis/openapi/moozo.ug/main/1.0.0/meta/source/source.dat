    "/api/v1/staff/{userId}/approve": {
      "patch": {
        "tags": [
          "Staff"
        ],
        "summary": "Approve a staff member",
        "description": "Requires OWNER or ADMIN role.\n\nApproves a staff member with status `PENDING_APPROVAL`. Their status\nmoves to `ACTIVE` and they can now log in.\n\nAn approval email is sent to the staff member with a link to log in.\n",
        "operationId": "approveStaff",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Staff member approved. Status is now ACTIVE.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/StaffMemberResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/staff/{userId}/reject": {
      "patch": {
        "tags": [
          "Staff"
        ],
        "summary": "Reject a staff member",
        "description": "Requires OWNER role only. ADMIN cannot reject other staff.\n\nRejects a staff member with status `PENDING_APPROVAL`. Their status\nmoves to `REJECTED`. They cannot log in.\n\nOWNER accounts cannot be rejected.\n",
        "operationId": "rejectStaff",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Staff member rejected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/StaffMemberResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
