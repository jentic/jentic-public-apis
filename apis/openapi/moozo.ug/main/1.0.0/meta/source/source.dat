            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/wellbeing/checkins": {
      "post": {
        "tags": [
          "Wellbeing"
        ],
        "summary": "Submit a mood check-in",
        "description": "PARENT only.\n\nSubmits a mood check-in on behalf of the student.\nParental consent must be granted before this endpoint can be used.\n\nOne check-in per student per date — submitting again on the same\ndate updates the existing record (upsert).\n\nWhen the last 3 consecutive check-ins are all level 1 (NOT_GREAT),\nthe system logs a consecutive low mood alert for the insights engine\nto deliver to admin.\n",
        "operationId": "submitMoodCheckin",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoodCheckinRequest"
              },
              "example": {
                "studentId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                "checkinDate": "2026-03-19",
                "moodLevel": 2,
                "notes": "John seemed quiet and tired this morning"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Check-in submitted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/MoodCheckinResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "description": "Consent not given for this student",
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
