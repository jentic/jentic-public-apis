    "/api/v1/staff/me/photo": {
      "post": {
        "tags": [
          "Staff"
        ],
        "summary": "Upload or replace staff profile photo",
        "description": "Uploads a profile photo for the currently authenticated staff member.\nRe-uploading replaces the previous photo — the old file is overwritten\non Cloudinary using the user ID as the stable public ID.\n\nAccepted types: JPEG, PNG, WebP, SVG. Maximum size: 5 MB.\n",
        "operationId": "uploadStaffPhoto",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "photo"
                ],
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "Profile photo file. Max 5 MB."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Photo uploaded. Returns updated staff profile with new profilePhotoUrl.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/StaffMemberResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "415": {
            "description": "Unsupported file type or file exceeds 5 MB",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ApiError"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/students": {
      "post": {
        "tags": [
          "Students"
        ],
        "summary": "Register a student",
        "description": "Requires OWNER or ADMIN role.\n\nCreates a new student record. The student is not yet enrolled in a class —\nuse `POST /api/v1/students/{studentId}/enrol` after registration.\n\nIf `studentNumber` is omitted the system auto-generates one in the format\n`STU-{year}-{sequence}` e.g. `STU-2026-0001`.\n",
        "operationId": "registerStudent",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentRequest"
              },
              "example": {
                "firstName": "John",
                "middleName": "Michael",
                "lastName": "Doe",
                "gender": "MALE",
                "dateOfBirth": "2010-03-15",
                "admissionDate": "2026-02-03",
                "homeDistrict": "Kampala",
                "nationality": "Ugandan"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Student registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/StudentResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "get": {
        "tags": [
          "Students"
        ],
        "summary": "List all students",
        "description": "Returns a paginated list of active students.\nOptionally filter by name using the `search` query parameter.\n",
        "operationId": "listStudents",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search by first name or last name (case-insensitive)",
            "example": "john"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of students",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StudentResponse"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PageMeta"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/students/import": {
      "post": {
        "tags": [
          "Students"
        ],
        "summary": "Bulk import students from CSV",
        "description": "Requires OWNER or ADMIN role.\n\nImports multiple students from a CSV file. Each row is processed\nindependently — a failure on one row does not affect others.\n\n**CSV format (header row required):**\n```\nstudentNumber,firstName,lastName,gender,dateOfBirth,admissionDate,middleName,nationality,homeDistrict\nSTU-2026-0001,John,Doe,MALE,2010-03-15,2026-02-03,Michael,Ugandan,Kampala\n,Sarah,Nakato,FEMALE,2011-07-22,2026-02-03,,,Wakiso\n```\n\n`studentNumber` can be empty — the system auto-generates it.\nColumns after `admissionDate` are optional.\n\nReturns a summary with `imported`, `failed`, and a list of row-level errors.\n",
        "operationId": "importStudentsCsv",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "CSV file containing student data"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import complete. Check imported and failed counts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/CsvImportResponse"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "totalRows": 120,
                    "imported": 118,
                    "failed": 2,
                    "errors": [
                      {
                        "row": 47,
                        "field": "studentNumber",
                        "message": "Student number 'STU-2026-0047' is already in use"
                      },
                      {
                        "row": 93,
                        "field": "dateOfBirth",
                        "message": "Failed to import row: Text '32/13/2010' could not be parsed"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/students/{studentId}": {
      "get": {
        "tags": [
