        "summary": "Update a student",
        "description": "Requires OWNER or ADMIN role.\nUpdates student profile fields. All fields are optional — only provided\nfields are updated. `studentNumber` and `admissionDate` cannot be changed\nafter registration.\n",
        "operationId": "updateStudent",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
