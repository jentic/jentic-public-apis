                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PlatformLoginResponse"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/platform/auth/refresh": {
      "post": {
        "tags": [
          "Platform Auth"
        ],
        "summary": "Refresh Super Admin access token",
        "operationId": "platformRefreshToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New access token issued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PlatformLoginResponse"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/platform/auth/logout": {
      "post": {
        "tags": [
          "Platform Auth"
        ],
        "summary": "Super Admin logout",
        "operationId": "platformLogout",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "X-Refresh-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Logged out successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "nullable": true,
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/schools/me": {
      "get": {
        "tags": [
          "School Profile"
        ],
        "summary": "Get current school profile",
        "description": "Returns the full profile of the school the authenticated user belongs to,\nalong with the onboarding checklist showing which setup steps have been\ncompleted.\n",
        "operationId": "getSchoolProfile",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "School profile with onboarding checklist",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/SchoolProfileResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "put": {
        "tags": [
          "School Profile"
        ],
        "summary": "Update current school profile",
        "description": "Updates the school profile. All fields are optional — only provided\nfields are updated. Completing `logoUrl` and `schoolType` marks the\nprofile step of the onboarding checklist as done.\n",
        "operationId": "updateSchoolProfile",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSchoolRequest"
              },
              "example": {
                "location": "Nakasero, Kampala",
                "schoolType": "PRIVATE",
                "logoUrl": "https://storage.moozo.ug/logos/kit001.png",
                "website": "https://kitante.ac.ug"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/SchoolProfileResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/platform/schools": {
      "get": {
        "tags": [
          "Platform Schools"
        ],
        "summary": "List all schools",
        "description": "Super Admin only. Returns a paginated list of all schools on the platform.\nCan be filtered by status.\n",
        "operationId": "listSchools",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SchoolStatus"
            },
            "description": "Filter by school status"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            },
            "description": "Page number (0-indexed)"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            },
            "description": "Number of results per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of schools",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SchoolResponse"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PageMeta"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/platform/schools/{id}/suspend": {
      "patch": {
        "tags": [
          "Platform Schools"
        ],
        "summary": "Suspend a school",
        "description": "Super Admin only.\n\nSuspends a school account. All staff logins for this school will\nimmediately be blocked. The school's previous status is stored so it\ncan be restored correctly on reactivation.\n",
        "operationId": "suspendSchool",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "School UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "School suspended",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/SchoolResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/v1/platform/schools/{id}/reactivate": {
      "patch": {
        "tags": [
          "Platform Schools"
        ],
        "summary": "Reactivate a suspended school",
        "description": "Super Admin only.\n\nReactivates a suspended school. Restores the school to its previous\nstatus before suspension — either `ONBOARDING` or `ACTIVE`. Never\nblindly sets status to `ACTIVE` regardless of what the previous status was.\n",
        "operationId": "reactivateSchool",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "School UUID"
          }
        ],
        "responses": {
          "200": {
            "description": "School reactivated and restored to previous status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/SchoolResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/classes": {
      "post": {
        "tags": [
          "Classes"
        ],
        "summary": "Create a class",
        "description": "Creates a new class in the school. Requires authentication.",
        "operationId": "createClass",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchoolClassRequest"
              },
              "example": {
                "yearLevel": "S2",
                "streamName": "Blue",
                "displayName": "S2 Blue",
                "academicYear": 2026,
                "capacity": 45
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Class created",
