    "/api/v1/attendance": {
      "post": {
        "tags": [
          "Attendance"
        ],
        "summary": "Mark attendance for a student",
        "description": "Marks attendance for a single student on a specific date.\n\n**Upsert behaviour:** If a record already exists for this student on this\ndate it is updated — not duplicated. The original `markedBy` is preserved.\n`lastModifiedBy` is set to the current user on update.\n\n**Permission:** Any teacher assigned to the class (via teacher-class-subject\nor as class teacher) or OWNER/ADMIN.\n",
        "operationId": "markAttendance",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceRequest"
              },
              "example": {
                "studentId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                "classId": "4ab96f75-6828-5673-b4cd-3d074f77bfb7",
                "termId": "5bc07e86-7939-6784-c5ef-4e185e88bec8",
                "academicYear": 2026,
                "date": "2026-03-18",
                "status": "PRESENT"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Attendance marked or updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AttendanceResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/attendance/batch": {
      "post": {
        "tags": [
          "Attendance"
        ],
        "summary": "Batch mark attendance (offline sync)",
        "description": "Submits multiple attendance records in a single request.\nDesigned for offline-first mobile use — teachers mark attendance offline\nand sync when connectivity returns.\n\nEach record is processed independently. A failure on one record does not\naffect others. Returns a summary with counts and per-record errors.\n",
        "operationId": "markAttendanceBatch",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceBatchRequest"
              },
              "example": {
                "records": [
                  {
                    "studentId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "classId": "4ab96f75-6828-5673-b4cd-3d074f77bfb7",
                    "termId": "5bc07e86-7939-6784-c5ef-4e185e88bec8",
                    "academicYear": 2026,
                    "date": "2026-03-18",
                    "status": "PRESENT"
                  },
                  {
                    "studentId": "6cd18f97-8040-7895-d6fa-5f296f99cdce",
                    "classId": "4ab96f75-6828-5673-b4cd-3d074f77bfb7",
                    "termId": "5bc07e86-7939-6784-c5ef-4e185e88bec8",
                    "academicYear": 2026,
                    "date": "2026-03-18",
                    "status": "ABSENT"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch processed. Check saved and failed counts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/AttendanceBatchResponse"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "total": 35,
                    "saved": 34,
                    "failed": 1,
                    "errors": [
                      {
                        "studentId": "6cd18f97-8040-7895-d6fa-5f296f99cdce",
                        "message": "Student not found"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
