                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/StudentTermReportResponse"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "studentId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "studentName": "John Doe",
                    "studentNumber": "STU-2026-0001",
                    "termId": "5bc07e86-7939-6784-c5ef-4e185e88bec8",
                    "termName": "Term 1 2026",
                    "overallPercentage": 71.3,
                    "overallGrade": "C",
