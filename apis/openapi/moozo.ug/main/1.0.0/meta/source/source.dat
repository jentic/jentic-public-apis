        ],
        "responses": {
          "200": {
            "description": "Current grading scale ordered by minScore descending",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GradingScaleResponse"
                      }
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "name": "A",
                      "minScore": 80,
                      "maxScore": 100,
                      "remark": "Excellent"
                    },
                    {
                      "name": "B",
                      "minScore": 70,
                      "maxScore": 79,
                      "remark": "Good"
                    },
                    {
                      "name": "C",
                      "minScore": 60,
                      "maxScore": 69,
                      "remark": "Satisfactory"
                    },
                    {
                      "name": "D",
                      "minScore": 50,
                      "maxScore": 59,
                      "remark": "Pass"
                    },
                    {
                      "name": "F",
                      "minScore": 0,
                      "maxScore": 49,
                      "remark": "Fail"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "put": {
        "tags": [
          "Grading Scale"
        ],
        "summary": "Update the school grading scale",
        "description": "Requires OWNER or ADMIN role.\n\nReplaces the entire grading scale with the provided bands.\nTakes effect immediately — all subsequent grade letter derivations\nuse the new scale.\n\nBands must not overlap. The system validates that no two bands share\nany score value.\n",
        "operationId": "updateGradingScale",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/GradingScaleRequest"
                }
              },
              "example": [
                {
                  "name": "A",
                  "minScore": 75,
                  "maxScore": 100,
                  "remark": "Excellent"
                },
                {
                  "name": "B",
                  "minScore": 60,
                  "maxScore": 74,
                  "remark": "Good"
                },
                {
                  "name": "C",
                  "minScore": 50,
                  "maxScore": 59,
                  "remark": "Satisfactory"
                },
                {
                  "name": "D",
                  "minScore": 40,
                  "maxScore": 49,
                  "remark": "Pass"
                },
                {
                  "name": "F",
                  "minScore": 0,
                  "maxScore": 39,
                  "remark": "Fail"
                }
              ]
            }
          }
        },
        "responses": {
          "200": {
            "description": "Grading scale updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GradingScaleResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/grades/scale/{scaleId}": {
      "delete": {
        "tags": [
          "Grading Scale"
        ],
        "summary": "Delete a single grading scale band",
        "description": "Requires OWNER or ADMIN role.\n\nRemoves a single band from the grading scale by its ID.\nIf the deletion creates a gap in the score range (e.g. no band covers\nscores between 50 and 60), the system logs a warning but allows the\ndeletion. The admin is responsible for keeping the scale complete.\n\nUse `GET /api/v1/grades/scale` after deletion to verify the scale\nis still contiguous.\n",
        "operationId": "deleteScaleBand",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "scaleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scale band deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "nullable": true,
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/grades/scale/band": {
      "post": {
        "tags": [
          "Grading Scale"
        ],
        "summary": "Add a single grading scale band",
        "description": "Requires OWNER or ADMIN role.\n\nAdds a single new band to the existing grading scale.\nThe new band must not overlap with any existing band — the system\nvalidates this and returns a 422 if an overlap is detected.\n\nIf the new band leaves a gap in the score range the system logs a\nwarning but allows the addition. Use `GET /api/v1/grades/scale`\nto review the full scale after adding.\n\nFor structural changes (e.g. redefining all bands at once) use\n`PUT /api/v1/grades/scale` instead.\n",
        "operationId": "addScaleBand",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GradingScaleRequest"
              },
              "example": {
                "name": "A+",
                "minScore": 95,
                "maxScore": 100,
                "remark": "Outstanding"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Scale band added",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/GradingScaleResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/discipline/incidents": {
      "post": {
        "tags": [
          "Discipline"
        ],
        "summary": "Log a discipline incident",
        "description": "Any authenticated staff member can log an incident.\n\nOn creation the `resolutionStatus` is always set to `OPEN` regardless\nof what is submitted. Use `PATCH /api/v1/discipline/incidents/{id}` to\nupdate the status.\n\nHIGH and CRITICAL severity incidents set `parentNotified = false`\nautomatically — a flag for the notifications module to deliver alerts.\n",
        "operationId": "logIncident",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DisciplineIncidentRequest"
              },
              "example": {
                "studentId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                "incidentDate": "2026-03-19",
                "type": "BULLYING",
                "severity": "HIGH",
                "description": "Student was verbally bullying a classmate during break time",
                "actionTaken": "PARENT_CALLED",
                "followUpRequired": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Incident logged",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/DisciplineIncidentResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
