              "example": {
                "studentId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                "observationDate": "2026-03-19",
                "tags": [
                  "DROWSY",
                  "PALE"
                ],
                "notes": "Student seemed very tired during morning session"
              }
            }
          }
