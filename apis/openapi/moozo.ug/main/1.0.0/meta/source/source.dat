                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "studentId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "consentGiven": true,
                    "averageMoodLast30Days": 2.8,
                    "totalCheckins": 12,
                    "consecutiveLowMoodAlert": false,
                    "observationTagFrequency": {
                      "WITHDRAWN": 4,
                      "TIRED": 3
                    },
                    "concernTags": [
