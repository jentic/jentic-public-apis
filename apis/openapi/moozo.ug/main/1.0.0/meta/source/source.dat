    "/api/v1/health/observations": {
      "post": {
        "tags": [
          "Health Observations"
        ],
        "summary": "Log a health observation",
        "description": "TEACHER only.\n\nQuick multi-tag observation about a student's physical state during class.\nDesigned for speed — should take under 10 seconds on mobile.\n\nTags feed the health summary and insights engine. The parent dashboard\nshows grouped observation summaries (paid tier) when the same tag\nappears more than once in a 2-week window.\n",
        "operationId": "logHealthObservation",
