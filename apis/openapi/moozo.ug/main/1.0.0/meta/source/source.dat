              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ConsentResponse"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "studentId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "consented": true,
                    "consentedAt": "2026-03-01T09:15:00",
                    "consentedByName": "James Doe"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
