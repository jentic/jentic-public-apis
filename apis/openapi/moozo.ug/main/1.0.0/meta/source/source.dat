        ],
        "summary": "Register a parent account",
        "description": "Public — no authentication required.\n\nCreates a parent account and links it to any matching children\nin the selected school. Phone number is matched against the\n`student_parents` table in the school schema.\n\nIf no match is found the account is still created — the parent\nsees a \"no children linked\" state and is prompted to contact\ntheir school admin.\n\nA free trial period is granted automatically on registration\n(configurable, default 30 days).\n",
        "operationId": "registerParent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParentRegistrationRequest"
              },
              "example": {
                "schoolId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                "phoneNumber": "+256772000001",
                "firstName": "James",
                "lastName": "Doe",
                "email": "james.doe@gmail.com",
                "password": "SecurePass123!"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Parent registered. JWT returned for immediate login.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ParentLoginResponse"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/parent/auth/login": {
      "post": {
        "tags": [
          "Parent Auth"
        ],
        "summary": "Parent login",
        "description": "Public — no authentication required.\n\nAuthenticates a parent by phone number and password.\nReturns a JWT access token (15 min) and refresh token (7 days).\n\nThe response includes all linked children across all schools\nand the current subscription status.\n",
        "operationId": "loginParent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParentLoginRequest"
              },
              "example": {
                "phoneNumber": "+256772000001",
                "password": "SecurePass123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ParentLoginResponse"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/parent/me/children": {
      "get": {
        "tags": [
          "Parent"
        ],
        "summary": "List linked children",
        "description": "Returns all children linked to the parent account across all schools.\nUsed to populate the child selector on the parent app home screen.\n",
        "operationId": "listLinkedChildren",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Linked children",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LinkedStudentSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Parent"
        ],
        "summary": "Add a child from another school",
        "description": "Links an additional child to the parent account from a different school.\nThe parent selects the school first, then the system matches their\nphone number against `student_parents` in that school's schema.\n\nPhone number must match the number already on the parent account.\n",
        "operationId": "addChild",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddChildRequest"
              },
              "example": {
                "schoolId": "4ab96f75-6828-5673-b4cd-3d074f77bfb7",
                "phoneNumber": "+256772000001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Child linked. Returns updated list of all linked children.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LinkedStudentSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/parent/students/{studentId}/overview": {
      "get": {
        "tags": [
          "Parent"
        ],
        "summary": "Get child dashboard overview",
        "description": "Lightweight overview — loads first on the parent dashboard.\nReturns key stats only: student info, attendance rate, grade summary,\nalert counts, and subscription status.\n\nOther data sections (grades history, health, wellbeing, discipline)\nare available via separate endpoints and load on demand.\n\nAvailable on both free and paid tiers. Paid-only fields\n(trend, full history) are populated based on `fullAccessUnlocked`.\n",
        "operationId": "getParentOverview",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "studentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Child dashboard overview",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ParentOverviewResponse"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "studentId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "studentName": "John Doe",
                    "studentNumber": "STU-2026-0001",
                    "className": "S2 Blue",
                    "attendance": {
                      "rateThisTerm": 92.5,
                      "daysAbsentThisTerm": 3
                    },
                    "grades": {
                      "overallPercentage": 71.3,
                      "overallGrade": "C",
                      "trend": "DECLINING"
                    },
                    "alerts": {
                      "criticalCount": 1,
                      "warningCount": 2
                    },
                    "subscription": {
                      "plan": "TRIAL",
                      "daysRemaining": 22,
                      "fullAccessUnlocked": true,
                      "priceUgx": 10000
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "Parent is not linked to this student",
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/parent/students/{studentId}/home-environment": {
      "put": {
        "tags": [
          "Parent"
        ],
        "summary": "Save home environment profile",
        "description": "Saves or updates the home environment profile for a child.\nAll fields are optional — partial updates are supported.\n\nThis data is used to personalise recommendations. A parent who\nprovides more context gets more accurate recommendations.\n\nPrompted after first login but never mandatory.\n",
        "operationId": "saveHomeEnvironment",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "studentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HomeEnvironmentRequest"
              },
              "example": {
                "studySpace": true,
                "textbookAccess": false,
                "homeworkSupport": true,
                "languageAtHome": "LUGANDA",
                "distanceToSchool": "BODA",
                "householdStructure": "SINGLE_PARENT"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Home environment profile saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "nullable": true,
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
