        ],
        "summary": "Get wellbeing summary for a student",
        "description": "OWNER, ADMIN, and PARENT (own child, paid tier) only.\n\nReturns aggregated wellbeing data. If consent has not been given,\nreturns a minimal response with `consentGiven: false` and no data.\n\n`consecutiveLowMoodAlert: true` is a high-priority signal that should\ntrigger an immediate admin notification.\n\n`concernTags` feeds the insights engine for wellbeing cross-domain alerts.\n",
        "operationId": "getWellbeingSummary",
        "security": [
          {
            "BearerAuth": []
