    "/api/v1/health/student/{studentId}/summary": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Get health summary for a student",
        "description": "Returns aggregated health data including symptom frequency, observation\ntag frequency (last 2 weeks), and recurring symptoms.\n\nUsed on the student profile card, admin dashboard, and the parent\ndashboard (paid tier). `recurringSymptoms` feeds the insights engine\nfor health alerts.\n",
        "operationId": "getHealthSummary",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "studentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "termId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Optional — filter sick bay visits to a specific term"
          }
        ],
        "responses": {
          "200": {
            "description": "Health summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/HealthSummaryResponse"
                    }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "studentId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                    "totalVisitsAllTime": 8,
                    "symptomFrequency": {
                      "FEVER": 4,
                      "HEADACHE": 3,
                      "FATIGUE": 2
                    },
                    "observationTagFrequency": {
                      "DROWSY": 3,
                      "HUNGRY": 2
                    },
                    "recurringSymptoms": [
                      "FEVER",
                      "HEADACHE"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/wellbeing/consent": {
      "put": {
        "tags": [
          "Wellbeing Consent"
        ],
        "summary": "Grant or revoke wellbeing consent",
        "description": "PARENT only.\n\nGrants or revokes parental consent for wellbeing data collection\nfor their child. Setting `consented: false` revokes consent — all\nsubsequent wellbeing write operations for this student will be blocked\nuntil consent is re-granted.\n\nConsent is upsert — calling this endpoint multiple times is safe.\n",
        "operationId": "setWellbeingConsent",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentRequest"
              },
              "example": {
                "studentId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                "consented": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consent updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ConsentResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/wellbeing/consent/{studentId}": {
      "get": {
        "tags": [
          "Wellbeing Consent"
        ],
        "summary": "Get consent status for a student",
        "description": "OWNER, ADMIN, and PARENT can check consent status.\nUsed by the UI to show a consent gate before any wellbeing data entry.\nReturns `consented: false` if consent has never been given.\n",
        "operationId": "getWellbeingConsent",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "studentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consent status",
