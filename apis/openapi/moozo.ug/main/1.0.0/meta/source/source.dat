            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/staff/{userId}/deactivate": {
      "patch": {
        "tags": [
          "Staff"
        ],
        "summary": "Deactivate a staff member",
        "description": "Requires OWNER role only. ADMIN cannot deactivate other staff.\n\nDeactivates an ACTIVE staff member. Their status moves to `DEACTIVATED`\nand they can no longer log in. Their historical data (attendance records,\ngrades entered) is preserved.\n\nOWNER accounts cannot be deactivated.\n",
        "operationId": "deactivateStaff",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Staff member deactivated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/StaffMemberResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/v1/staff/{userId}/invite/resend": {
      "post": {
        "tags": [
          "Staff"
        ],
        "summary": "Resend an invite",
        "description": "Requires OWNER or ADMIN role.\n\nCreates a new invite token for a staff member with status `INVITED`\nwhose original invite has expired. Sends a fresh invitation email.\n\nOnly works for staff with status `INVITED` — staff who have already\naccepted their invite (PENDING_APPROVAL, ACTIVE, etc.) cannot be resent.\n",
        "operationId": "resendInvite",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "New invite sent",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/StaffInviteResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/teacher-assignments": {
      "post": {
        "tags": [
          "Teacher Assignments"
        ],
        "summary": "Assign a teacher to a class-subject",
        "description": "Requires OWNER or ADMIN role.\n\nAssigns a teacher to teach a specific subject in a specific class.\nThe subject must already be assigned to the class via\n`POST /api/v1/classes/{classId}/subjects/{subjectId}`.\n\nIf the class-subject already has a teacher assigned, the previous\nassignment is replaced with the new one.\n",
        "operationId": "assignTeacher",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeacherAssignmentRequest"
              },
              "example": {
                "teacherId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                "classId": "4ab96f75-6828-5673-b4cd-3d074f77bfb7",
                "subjectId": "5bc07e86-7939-6784-c5ef-4e185e88bec8"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Teacher assigned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/TeacherAssignmentResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/teacher-assignments/class/{classId}/subject/{subjectId}": {
      "delete": {
        "tags": [
          "Teacher Assignments"
        ],
        "summary": "Remove a teacher from a class-subject",
        "description": "Requires OWNER or ADMIN role.\n\nRemoves the teacher assignment for a specific class-subject combination.\nThe subject remains assigned to the class — only the teacher link is removed.\n",
        "operationId": "removeTeacherAssignment",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "classId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "subjectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Teacher assignment removed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "nullable": true,
                      "example": null
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/teacher-assignments/class/{classId}": {
      "get": {
