    "/api/v1/health/sick-bay": {
      "post": {
        "tags": [
          "Health"
        ],
        "summary": "Log a sick bay visit",
        "description": "NURSE only.\n\nLogs a student's sick bay visit with symptoms and action taken.\n`timeOut` is optional — can be updated later via PATCH when the student leaves.\n\nHIGH frequency visits (>2 in a week) feed the insights engine for health alerts.\n",
