    "/api/v1/students/{studentId}/parents": {
      "post": {
        "tags": [
          "Students"
        ],
        "summary": "Add a parent or guardian",
        "description": "Requires OWNER or ADMIN role.\n\nLinks a parent or guardian to a student. Phone number must be unique\nper student — the same parent cannot be added twice for the same student.\n\nIf `primaryContact` is true and another parent is already primary,\nthe existing primary contact is automatically demoted.\n",
        "operationId": "addParent",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "studentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParentRequest"
              },
              "example": {
                "firstName": "James",
                "lastName": "Doe",
                "phoneNumber": "+256772000002",
                "relationship": "FATHER",
                "primaryContact": true
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Parent added",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ParentResponse"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "get": {
        "tags": [
          "Students"
        ],
        "summary": "List parents for a student",
        "description": "Returns all parents and guardians linked to the student.",
        "operationId": "listParents",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "studentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Parents linked to the student",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ParentResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
