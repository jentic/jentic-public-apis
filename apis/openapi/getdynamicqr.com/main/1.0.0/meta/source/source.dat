                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            },
            "post": {
                "operationId": "PostMeDeletionRequest",
                "summary": "Request account deletion",
                "description": "Submits a request to permanently delete the account. An administrator\nreviews it; nothing is deleted at this point and the account keeps\nworking until the request is approved.\n\nApproval permanently erases the account, every QR code and its scan\nhistory, link pages, business cards, short links, folders and all\nuploaded images. It cannot be undone.",
                "tags": [
                    "User Profile"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "reason": {
                                        "type": "string",
                                        "description": "Why the account should be deleted (10–1000 chars)."
                                    },
                                    "confirm": {
                                        "type": "boolean",
                                        "description": "Must be true to acknowledge the deletion is permanent."
                                    }
                                },
                                "required": [
                                    "reason",
                                    "confirm"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "409": {
                        "description": "Response",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "You already have a deletion request awaiting review."
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
