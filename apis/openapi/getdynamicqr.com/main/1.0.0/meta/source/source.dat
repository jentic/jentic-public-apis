            "get": {
                "operationId": "GetMeDeletionRequest",
                "summary": "Get account deletion request",
                "description": "Returns the user's pending account deletion request, or null when there\nis none. Use this to decide whether to show the request form or the\nwithdraw action.",
                "tags": [
