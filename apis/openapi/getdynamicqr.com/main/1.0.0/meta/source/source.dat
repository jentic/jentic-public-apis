        "/passes/validate": {
            "post": {
                "operationId": "PostPassesValidate",
                "summary": "Check a pass and, when it is good, spend one admission.",
                "description": "Spends one admission when the pass is good. The check and the increment happen inside\na transaction against a locked row, so two doors scanning the same ticket in the same\nsecond cannot both admit.\n\nEvery attempt is recorded, refusals included — \"the door said it was already used\" is\na dispute somebody has to settle later. Staff can only validate passes belonging to\ntheir own account, and another account's pass reads as not found.\n\n**Requires the `pass_validation` plan feature.** Without it this endpoint answers 403 even with valid credentials.",
                "tags": [
                    "Passes"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "token": {
                                        "type": "string",
                                        "description": "The scanned value — a token or the URL a camera read."
                                    },
                                    "gate": {
                                        "type": "string",
                                        "description": "Which door this was, for the audit trail."
                                    }
                                },
                                "required": [
                                    "token"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "Ticket validation is not available on your plan."
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-plan-feature": "pass_validation",
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/passes/{token}": {
            "get": {
                "operationId": "GetPassesToken",
                "summary": "Look at a pass without spending it.",
                "description": "The read-only twin of the validate endpoint, for showing a holder the state of their\nown ticket. Looking at a pass must never spend it, so nothing is redeemed and nothing\nis recorded.\n\nA pass belonging to another account is reported as not found rather than forbidden:\nconfirming that somebody else's ticket exists is itself a leak.\n\n**Requires the `pass_validation` plan feature.** Without it this endpoint answers 403 even with valid credentials.",
                "tags": [
                    "Passes"
                ],
                "parameters": [
                    {
                        "name": "token",
                        "in": "path",
                        "required": true,
                        "description": "The pass token, or the full /pass/{token} URL a camera read.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "example": {
                                    "data": {
                                        "ok": true,
                                        "result": "valid",
                                        "pass": {
                                            "label": "Ticket 104",
                                            "status": "Unused",
                                            "remaining": 1,
                                            "max_uses": 1
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "description": "Not found",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "Not found"
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-plan-feature": "pass_validation",
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/public/config": {
            "get": {
                "operationId": "GetPublicConfig",
                "summary": "Mobile app configuration",
                "description": "Returns runtime configuration for the mobile app. Called once on startup.\nNo authentication required.\n\nResponse includes:\n - Paddle checkout settings (client token, price IDs, environment)\n - Anonymous QR feature flags and limits\n - App Store / Play Store URLs\n - Minimum required app version (for force-update prompting)\n - Mobile maintenance mode flag and message\n - Branding (app name, primary colour)",
                "tags": [
                    "Public / Unauthenticated"
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                },
                "security": []
            }
        },
        "/public/openapi.json": {
            "get": {
                "operationId": "GetPublicOpenapiJson",
                "summary": "OpenAPI specification",
                "description": "The whole REST API as an OpenAPI 3.1 document, generated from the\nendpoints themselves. Import it into Postman or Insomnia, render it with\nSwagger UI or Redoc, generate a typed client from it, or hand the URL to\nan assistant — it describes every endpoint, its parameters, its plan\nrequirement and its responses.\n\nNo authentication, deliberately: a specification names the endpoints, not\nthe data behind them, and every one of them still refuses a request with\nno token. Requiring credentials to read it would mean a developer has to\nbe integrated before their tooling can tell them how to integrate.",
                "tags": [
                    "Public / Unauthenticated"
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                },
                "security": []
            }
        },
        "/public/qrcodes": {
            "get": {
                "operationId": "GetPublicQrcodes",
                "summary": "List anonymous QR codes for a session",
                "description": "Retrieves all QR codes belonging to an anonymous session token.",
                "tags": [
                    "Public / Unauthenticated"
                ],
                "parameters": [
                    {
                        "name": "token",
                        "in": "query",
                        "required": true,
                        "description": "The anonymous_token returned on creation.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "anon_9f2c81aa"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                },
                "security": []
            },
            "post": {
                "operationId": "PostPublicQrcodes",
                "summary": "Create an anonymous QR code",
                "description": "Create a URL QR code without an account.\nThe returned `anonymous_token` must be stored on device to retrieve or\nclaim the QR later. Anonymous QRs have no analytics, no editing, and expire\nafter the configured number of hours (default 24 h).",
                "tags": [
                    "Public / Unauthenticated"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "destination_url": {
                                        "type": "string",
                                        "description": "The URL the QR code should point to."
                                    },
                                    "name": {
                                        "type": "string",
                                        "description": "Optional label. Defaults to the URL hostname."
                                    },
                                    "anonymous_token": {
                                        "type": "string",
                                        "description": "Existing session token (so the server can enforce the per-session limit)."
                                    }
                                },
                                "required": [
                                    "destination_url"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created"
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "Anonymous QR creation is disabled."
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "Anonymous QR limit reached (3 per session)."
                                }
                            }
                        }
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                },
                "security": []
            }
        },
        "/qrcodes": {
            "get": {
                "operationId": "GetQrcodes",
                "summary": "List all QR codes",
                "description": "Returns a paginated list of all QR codes belonging to the authenticated user.",
                "tags": [
                    "QR Codes"
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            },
            "post": {
                "operationId": "PostQrcodes",
                "summary": "Create a QR code",
                "description": "Supports all 14 QR types. URL-based types (url, video, social, app, pdf, coupon, menu)\nuse `destination_url`. Content types (wifi, vcard, email, sms, phone, text, whatsapp)\npass their fields inside `qr_meta` as a key-value object.\n\nqr_meta fields per type:\n  whatsapp: { phone, message }\n  wifi:     { ssid, password, encryption (WPA|WEP|nopass) }\n  vcard:    { name, phone, email, organization, title, website, address }\n  email:    { to, subject, body }\n  sms:      { phone, message }\n  phone:    { phone }\n  text:     { content }",
                "tags": [
                    "QR Codes"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "Label for the QR code."
                                    },
                                    "qr_type": {
                                        "type": "string",
                                        "description": "One of: url, whatsapp, wifi, vcard, email, sms, phone, text, video, social, app, pdf, coupon, menu. Default: url."
                                    },
                                    "destination_url": {
                                        "type": "string",
                                        "description": "Required for url/video/social/app/pdf/coupon/menu types."
                                    },
                                    "qr_meta": {
                                        "type": "object",
                                        "description": "Type-specific fields (see below)."
                                    },
                                    "color_foreground": {
                                        "type": "string",
                                        "description": "Hex colour for QR dots.",
                                        "example": "#1d4ed8"
                                    },
                                    "color_background": {
                                        "type": "string",
                                        "description": "Hex background colour.",
                                        "example": "#ffffff"
                                    },
                                    "frame_text": {
                                        "type": "string",
                                        "description": "Label text below QR frame."
                                    },
                                    "expires_at": {
                                        "type": "string",
                                        "description": "ISO-8601 expiry datetime."
                                    },
                                    "expired_url": {
                                        "type": "string",
                                        "description": "Fallback URL after expiry."
                                    },
                                    "design_preset": {
                                        "type": "string",
                                        "description": "A QR Studio look to create the code already wearing. Requires the qr_studio plan flag."
                                    },
                                    "design": {
                                        "type": "object",
                                        "description": "QR Studio fields, applied over design_preset (or over the studio defaults on their own). Requires the qr_studio plan flag."
                                    },
                                    "slug": {
                                        "type": "string",
                                        "description": "A memorable short link, e.g. `summer-menu`, in place of the uuid. Needs the custom_slug plan feature; sent without it, it is ignored rather than refused."
                                    },
                                    "dot_style": {
                                        "type": "string",
                                        "description": "Module shape: square, rounded (default), dots, classy, classy_rounded, extra_rounded."
                                    },
                                    "frame_style": {
                                        "type": "string",
                                        "description": "Frame around the code: none, simple (default), rounded, bold, banner, label_top."
                                    },
                                    "show_type_icon": {
                                        "type": "boolean",
                                        "description": "Draw the type's icon in the middle. Default: true. Ignored when the code carries a logo."
                                    }
                                },
                                "required": [
                                    "name"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "description": "Validation failed"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/qrcodes/bulk": {
            "post": {
                "operationId": "PostQrcodesBulk",
                "summary": "Create QR codes in bulk",
                "description": "Every row is validated first; rows that fail are reported and skipped\nwhile the rest are created, so one bad URL does not lose the batch.\n\n**Requires the `bulk_qr` plan feature.** Without it this endpoint answers 403 even with valid credentials.",
                "tags": [
                    "Bulk QR Codes"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "type": "object"
                                        },
                                        "description": "Up to 100 rows."
                                    },
                                    "items[].name": {
                                        "type": "string",
                                        "description": "Display name."
                                    },
                                    "items[].destination_url": {
                                        "type": "string",
                                        "description": "Target URL."
                                    },
                                    "items[].qr_type": {
                                        "type": "string",
                                        "description": "One of url, whatsapp, email, sms, phone, vcard, text, wifi. Defaults to url."
                                    },
                                    "items[].color_foreground": {
                                        "type": "string",
                                        "description": "Hex colour, e.g. #4f46e5."
                                    },
                                    "folder_id": {
                                        "type": "integer",
                                        "description": "Put every created code in this folder."
                                    }
                                },
                                "required": [
                                    "items",
                                    "items[].name",
                                    "items[].destination_url"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-plan-feature": "bulk_qr",
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/qrcodes/render": {
            "post": {
                "operationId": "PostQrcodesRender",
                "summary": "Render a QR code (stores nothing)",
                "description": "Encodes your content into a QR image and returns it in the response\nbody. **Nothing is stored**: no QR code record is created, no UUID is\nminted, no redirect through this domain is involved, no audit entry is\nwritten, and the encoded content is not logged.\n\nEvery other endpoint here creates a *dynamic* code, which encodes a\n`/q/{uuid}` address on this domain and resolves to your destination on\neach scan — that is what lets a printed code be re-pointed later. This\none encodes your address directly, so the scanner never touches us. The\ntrade is the obvious one: **a code rendered here can never be re-pointed,\nand it records no scans.** Print it only when that is what you want.\n\nSend either `data` (the literal payload) or `qr_type` plus `content`\n(a type described by its fields). The types that resolve to a page this\napplication serves — social, app, coupon, menu, barcode, gift_giveaway —\nare refused here, because there is no version of them that encodes\nnothing of ours.\n\nFour advisory headers ride on the response, because an image body has\nnowhere to put them: `X-QR-Scannable` (`yes` or `warnings`),\n`X-QR-Warnings`, `X-QR-Contrast-Ratio`, and `X-QR-Frame-Omitted` on a PNG\nwhose design carries a frame or caption.\n\n**Requires the `api_access` plan feature.** Without it this endpoint answers 403 even with valid credentials.",
                "tags": [
                    "QR Codes"
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "data": {
                                        "type": "string",
                                        "description": "The literal string to encode, max 2048 characters. Mutually exclusive with qr_type/content.",
                                        "example": "https://your-own-domain.example/offer"
                                    },
                                    "qr_type": {
                                        "type": "string",
                                        "description": "One of: url, whatsapp, wifi, email, sms, phone, vcard, text, pdf, video. Default: url."
                                    },
                                    "content": {
                                        "type": "object",
                                        "description": "The fields belonging to qr_type, using the same names the dashboard uses, e.g. {\"wifi_ssid\":\"Guest\",\"wifi_security\":\"WPA\"}. Also accepted at the top level. An unrecognised key is a 422."
                                    },
                                    "format": {
                                        "type": "string",
                                        "description": "svg (default) or png.",
                                        "example": "svg"
                                    },
                                    "size": {
                                        "type": "integer",
                                        "description": "Edge length in pixels. SVG 96-4096 (default 512); PNG 96-512 (default 512). For print, ask for SVG and scale it losslessly.",
                                        "example": "1024"
                                    },
                                    "design_preset": {
                                        "type": "string",
                                        "description": "A QR Studio look to draw it in. With neither this nor design, the code is drawn as classic_ink.",
                                        "example": "midnight_indigo"
                                    },
                                    "design": {
                                        "type": "object",
                                        "description": "QR Studio fields applied over design_preset, or over the studio defaults on their own."
                                    },
                                    "logo": {
                                        "type": "string",
                                        "format": "binary",
                                        "description": "An image for the centre (jpg, jpeg, png, gif, webp; max 2MB), sent as multipart/form-data. Read from the request and never written to disk."
                                    },
                                    "logo_path": {
                                        "type": "string",
                                        "description": "A path returned earlier by POST /me/qr-logo, of the form qr-logos/... Any other path is a 422."
                                    }
                                }
                            }
                        },
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "data": {
                                        "type": "string",
                                        "description": "The literal string to encode, max 2048 characters. Mutually exclusive with qr_type/content.",
                                        "example": "https://your-own-domain.example/offer"
                                    },
                                    "qr_type": {
                                        "type": "string",
                                        "description": "One of: url, whatsapp, wifi, email, sms, phone, vcard, text, pdf, video. Default: url."
                                    },
                                    "content": {
                                        "type": "object",
                                        "description": "The fields belonging to qr_type, using the same names the dashboard uses, e.g. {\"wifi_ssid\":\"Guest\",\"wifi_security\":\"WPA\"}. Also accepted at the top level. An unrecognised key is a 422."
                                    },
                                    "format": {
                                        "type": "string",
                                        "description": "svg (default) or png.",
                                        "example": "svg"
                                    },
                                    "size": {
                                        "type": "integer",
                                        "description": "Edge length in pixels. SVG 96-4096 (default 512); PNG 96-512 (default 512). For print, ask for SVG and scale it losslessly.",
                                        "example": "1024"
                                    },
                                    "design_preset": {
                                        "type": "string",
                                        "description": "A QR Studio look to draw it in. With neither this nor design, the code is drawn as classic_ink.",
                                        "example": "midnight_indigo"
                                    },
                                    "design": {
                                        "type": "object",
                                        "description": "QR Studio fields applied over design_preset, or over the studio defaults on their own."
                                    },
                                    "logo": {
                                        "type": "string",
                                        "format": "binary",
                                        "description": "An image for the centre (jpg, jpeg, png, gif, webp; max 2MB), sent as multipart/form-data. Read from the request and never written to disk."
                                    },
                                    "logo_path": {
                                        "type": "string",
                                        "description": "A path returned earlier by POST /me/qr-logo, of the form qr-logos/... Any other path is a 422."
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK — the image bytes, Content-Type image/svg+xml or image/png"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "description": "Forbidden",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "REST API access is not available on your current plan.",
                                    "upgrade": "..."
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "There is no QR type called 'hologram'. This endpoint renders: url, whatsapp, ..."
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "503": {
                        "description": "Unavailable",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "This install cannot produce PNG (no GD extension). Request format=svg."
                                }
                            }
                        }
                    }
                },
                "x-plan-feature": "api_access",
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
