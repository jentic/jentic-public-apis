        "/auth/login": {
            "post": {
                "operationId": "PostAuthLogin",
                "summary": "Sign in",
                "description": "Authenticate with your website email and password.\nReturns a mobile token valid for 1 year.\n\nIf the account has 2FA enabled, first call this without `two_factor_code` —\nyou will receive HTTP 202 `{\"requires_two_factor\": true}`.\nThen call again with the 6-digit TOTP code included.",
                "tags": [
                    "Mobile Authentication"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "description": "Your account email.",
                                        "example": "user@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "description": "Your account password."
                                    },
                                    "two_factor_code": {
                                        "type": "string",
                                        "description": "6-digit TOTP code (only when prompted)."
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "description": "Optional device label stored with the token."
                                    }
                                },
                                "required": [
                                    "email",
                                    "password"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "202": {
                        "description": "Response",
                        "content": {
                            "application/json": {
                                "example": {
                                    "requires_two_factor": true
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "Invalid email or password"
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 10,
                    "minutes": 1
                },
                "security": []
            }
        },
