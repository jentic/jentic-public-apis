{
    "openapi": "3.1.0",
    "info": {
        "title": "D-QR REST API",
        "version": "1.0.0",
        "description": "The REST API for D-QR.\n\n## Authentication\n\nMost endpoints take two headers: `X-Client-ID` with your client id, and `Authorization: Bearer <client_secret>`. Credentials are generated from the dashboard under Developer API and require a plan carrying `api_access`.\n\nThe mobile app authenticates differently: `POST /auth/login` returns an `mqt_` token which is sent as `Authorization: Bearer mqt_…` with no `X-Client-ID`. Both modes reach the same endpoints; which plans may use them differs.\n\n## Rate limiting\n\nAuthenticated endpoints allow 60 requests per minute keyed by client id, and carry `X-RateLimit-Limit`, `X-RateLimit-Remaining` and `X-RateLimit-Reset`. The `/auth/*` endpoints allow 10 per minute, because those are the ones a credential run hits. A 429 carries `Retry-After`.\n\n## Plan features\n\nSome endpoints additionally need a feature flag on the account — noted per endpoint as `x-plan-feature`. A token that authenticates fine still gets a 403 from those without it, so a 403 on a valid token is a plan question rather than a credential one.\n\n## Errors\n\nErrors are JSON with an `error` key. A 422 from a validated endpoint also carries `messages`, keyed by field — except in production, where the field names and rules are withheld because they are useful to whoever is probing the endpoint and to nobody else."
    },
    "servers": [
        {
            "url": "https://getdynamicqr.com/api/v1",
            "description": "This installation"
        }
    ],
    "tags": [
        {
            "name": "Mobile Authentication",
            "description": "Authenticate with the same email and password used on the website.\n\nNo API plan or special credentials required — any plan (including Free) can sign in.\nFeatures are gated by the user's current plan, identical to the web app.\n\nOn login/register, a mobile token (mqt_...) is returned.\nStore it securely and send it as: Authorization: Bearer <token>"
        },
        {
            "name": "QR Codes",
            "description": "Endpoints for managing QR codes programmatically."
        },
        {
            "name": "Bulk QR Codes",
            "description": "Create many QR codes in one request. The web app has had a CSV importer for\n\na while, but `bulk_qr` is a sold plan flag with no API behind it, so an\nintegration had to loop the single-create endpoint and wear the rate limit."
        },
        {
            "name": "Folders",
            "description": "Group QR codes into folders. Folders are first-class in the web app but were\n\nunreachable from the API, so an integration could not organise what it created."
        },
        {
            "name": "Dashboard & Analytics",
            "description": "Endpoints for dashboard overview stats and time-series scan analytics."
        },
        {
            "name": "Link Pages",
            "description": "Manage link-in-bio style landing pages.\n\nRequires the `link_pages` feature (Normal / Pro plan)."
        },
        {
            "name": "Business Cards",
            "description": "Manage digital business cards.\n\nRequires the `business_cards` feature (Normal / Pro plan)."
        },
        {
            "name": "Mobile Links",
            "description": "Manage short-URL mobile links (6-character codes).\n\nRequires the `mobile_links` feature (Normal / Pro plan)."
        },
        {
            "name": "Custom Domains",
            "description": "Serve short links from your own domain. Verification is a DNS TXT record,\n\nthe same flow the web app uses."
        },
        {
            "name": "Teams",
            "description": "Read access to the teams the caller owns or belongs to. Creating teams and\n\nmanaging invitations stays in the web app, where the seat-limit and billing\nflows live; this exists so an integration can see team context."
        },
        {
            "name": "Passes",
            "description": "Pass validation for the mobile app.\n\nThe same decision the web validator makes, so a venue can put half its staff\non phones and half on tablets without the two disagreeing about whether a\nticket has been used."
        },
        {
            "name": "Support",
            "description": "Manage support tickets / conversations.\n\nRequires the `support` feature (Pro plan or admin-enabled plans)."
        },
        {
            "name": "Billing & Subscriptions",
            "description": "Manage Paddle subscriptions from the mobile app.\n\nAll endpoints require a valid mobile token (Authorization: Bearer mqt_...)."
        },
        {
            "name": "User Profile",
            "description": "Endpoints for viewing and updating the authenticated user's profile."
        },
        {
            "name": "Public / Unauthenticated",
            "description": "Endpoints that require no authentication — used by the mobile app on startup\n\nand for anonymous QR creation before the user signs in."
        },
        {
            "name": "Admin",
            "description": "Admin-only endpoints. Require an admin mobile token."
        }
    ],
    "security": [
        {
            "clientId": [],
            "bearerAuth": []
        }
    ],
    "components": {
        "securitySchemes": {
            "clientId": {
                "type": "apiKey",
                "in": "header",
                "name": "X-Client-ID",
                "description": "Your client id. Not sent for mobile (`mqt_`) tokens."
            },
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "description": "Your client secret, or an `mqt_` mobile token."
            }
        },
        "schemas": {
            "Error": {
                "type": "object",
                "properties": {
                    "error": {
                        "type": "string",
                        "description": "What went wrong, in one sentence."
                    },
                    "messages": {
                        "type": "object",
                        "description": "Per-field validation messages. Withheld in production.",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "required": [
                    "error"
                ]
            }
        },
        "responses": {
            "Unauthorized": {
                "description": "No credentials, or credentials that are not valid.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "Forbidden": {
                "description": "The account is inactive, or the plan does not carry this feature.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "NotFound": {
                "description": "No such record on this account. Another account's id reads as not found rather than forbidden.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "TooManyRequests": {
                "description": "Rate limit exceeded. See `Retry-After`.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            }
        }
    },
    "paths": {
        "/admin/dashboard": {
            "get": {
                "operationId": "GetAdminDashboard",
                "summary": "Admin dashboard stats",
                "description": "Returns global platform statistics: user counts, scan trends, device\nbreakdown, top-performing QR codes, and recent registrations.\n\n**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
                        "name": "range",
                        "in": "query",
                        "required": false,
                        "description": "Time window. One of: 24h, 7d (default), 30d, 3m, 1y.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "30d"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/admin/qrcodes": {
            "get": {
                "operationId": "GetAdminQrcodes",
                "summary": "List / search all QR codes across the platform.",
                "description": "Every account's codes, for oversight. Ordinary customers reach only their own through\nGET /qrcodes.\n\n**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "required": false,
                        "description": "Name, UUID, or owner email.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "menu"
                    },
                    {
                        "name": "filter",
                        "in": "query",
                        "required": false,
                        "description": "all (default), active, inactive, anonymous.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "active"
                    },
                    {
                        "name": "type",
                        "in": "query",
                        "required": false,
                        "description": "QR type filter (url, whatsapp, wifi, etc.).",
                        "schema": {
                            "type": "string"
                        },
                        "example": "url"
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "required": false,
                        "description": "created_at (default), scans_count, name.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "scans_count"
                    },
                    {
                        "name": "dir",
                        "in": "query",
                        "required": false,
                        "description": "desc (default) or asc.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "desc"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "description": "Page number (default 1). 20 results per page.",
                        "schema": {
                            "type": "integer"
                        },
                        "example": "1"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/admin/qrcodes/{id}": {
            "delete": {
                "operationId": "DeleteAdminQrcodesId",
                "summary": "Move a QR code to the trash. It stops resolving immediately and its owner",
                "description": "can restore it, with scan history intact, until the retention window ends.\n\n**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "The QR code ID.",
                        "schema": {
                            "type": "integer"
                        },
                        "example": "42"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Deleted successfully"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            },
            "get": {
                "operationId": "GetAdminQrcodesId",
                "summary": "Get a single QR code with full analytics.",
                "description": "Returns QR code details, scan stats, 30-day trend, device/OS/country\nbreakdowns, and the most recent 20 scans.\n\n**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "The QR code ID.",
                        "schema": {
                            "type": "integer"
                        },
                        "example": "42"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "404": {
                        "description": "Not found",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "Not found"
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/admin/qrcodes/{id}/scans": {
            "get": {
                "operationId": "GetAdminQrcodesIdScans",
                "summary": "Paginated scan history for a single QR code.",
                "description": "Human scans only — bots are filtered out by the global scope on scans.\n\n**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "The QR code ID.",
                        "schema": {
                            "type": "integer"
                        },
                        "example": "42"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "description": "Page number (default 1). 30 results per page.",
                        "schema": {
                            "type": "integer"
                        },
                        "example": "1"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/admin/qrcodes/{id}/toggle": {
            "patch": {
                "operationId": "PatchAdminQrcodesIdToggle",
                "summary": "Toggle a QR code's active status.",
                "description": "Switches the code between active and paused. A paused code redirects nobody and keeps\nits history and its link.\n\n**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "The QR code ID.",
                        "schema": {
                            "type": "integer"
                        },
                        "example": "42"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "QR code paused.",
                                    "data": {
                                        "is_active": false
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/admin/users": {
            "get": {
                "operationId": "GetAdminUsers",
                "summary": "List / search users",
                "description": "Every account, for oversight.\n\n**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "required": false,
                        "description": "Name or email search.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "ada"
                    },
                    {
                        "name": "filter",
                        "in": "query",
                        "required": false,
                        "description": "all (default), user, moderator, past_due, early_bird, coffee.",
                        "schema": {
                            "type": "string"
                        },
                        "example": "moderator"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "description": "Page number (default 1). 20 results per page.",
                        "schema": {
                            "type": "integer"
                        },
                        "example": "1"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/admin/users/{id}": {
            "delete": {
                "operationId": "DeleteAdminUsersId",
                "summary": "Permanently delete a user and all their data.",
                "description": "**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "The user ID.",
                        "schema": {
                            "type": "integer"
                        },
                        "example": "8"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Account deleted."
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "You cannot delete your own account here."
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/admin/users/{id}/demote": {
            "patch": {
                "operationId": "PatchAdminUsersIdDemote",
                "summary": "Demote a moderator back to regular user.",
                "description": "Returns a moderator to an ordinary customer account.\n\n**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "The user ID.",
                        "schema": {
                            "type": "integer"
                        },
                        "example": "8"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Ada Lovelace has been changed to a regular user."
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "Only moderators can be demoted."
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/admin/users/{id}/plan": {
            "patch": {
                "operationId": "PatchAdminUsersIdPlan",
                "summary": "Change a user's plan.",
                "description": "Writes the stored `plan` column. It is not the whole story of what a customer has —\nlifetime access, a paid or granted trial and inherited team access all live outside it,\nwhich is why the account payload reports both `plan` (in effect) and `base_plan` (stored).\n\n**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "The user ID.",
                        "schema": {
                            "type": "integer"
                        },
                        "example": "8"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "plan": {
                                        "type": "string",
                                        "description": "freemium, normal, or pro."
                                    }
                                },
                                "required": [
                                    "plan"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Ada Lovelace plan changed to pro."
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "Admin plan cannot be changed."
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/admin/users/{id}/promote": {
            "patch": {
                "operationId": "PatchAdminUsersIdPromote",
                "summary": "Promote a regular user to moderator.",
                "description": "**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "The user ID.",
                        "schema": {
                            "type": "integer"
                        },
                        "example": "8"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Ada Lovelace has been promoted to Moderator."
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "Only regular users can be promoted to moderator."
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/admin/users/{id}/reset-password": {
            "post": {
                "operationId": "PostAdminUsersIdResetPassword",
                "summary": "Reset a user's password and email them the new one.",
                "description": "Generates a new password and emails it to the customer. It is never returned here.\n\n**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "description": "The user ID.",
                        "schema": {
                            "type": "integer"
                        },
                        "example": "8"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "A new password has been emailed to Ada Lovelace."
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "description": "Validation failed",
                        "content": {
                            "application/json": {
                                "example": {
                                    "error": "Use the normal password-change flow for your own account."
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    }
                },
                "x-rate-limit": {
                    "limit": 60,
                    "minutes": 1
                }
            }
        },
        "/admin/users/{id}/toggle-status": {
            "patch": {
                "operationId": "PatchAdminUsersIdToggleStatus",
                "summary": "Toggle a user's active status (activate / deactivate).",
                "description": "An inactive account is refused at every door, including this API.\n\n**Admin only.** The authenticated account must have the admin role.",
                "tags": [
                    "Admin"
                ],
                "parameters": [
                    {
