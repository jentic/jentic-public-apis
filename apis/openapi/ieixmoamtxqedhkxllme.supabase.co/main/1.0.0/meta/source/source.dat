{
  "openapi": "3.0.3",
  "info": {
    "title": "Api Dashboard Águias",
    "version": "1.0.0",
    "description": "API do painel administrativo Águias.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/imsantosdevorganizat/Aguias-admin/1.0.0"
  },
  "servers": [
    {
      "url": "https://ieixmoamtxqedhkxllme.supabase.co/functions/v1",
      "description": "Supabase Edge Functions"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Auth",
      "description": "Autenticação e identificação de usuários"
    },
    {
      "name": "Users",
      "description": "Gestão de usuários (admin)"
    },
    {
      "name": "Events",
      "description": "Gestão de eventos (admin)"
    },
    {
      "name": "Contents",
      "description": "Gestão e consulta de conteúdos (notícias, artigos, vídeos, podcasts, PDFs)"
    },
    {
      "name": "Surveys",
      "description": "Formulário de pesquisa de membros"
    }
  ],
  "paths": {
    "/admin-login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login exclusivo para administradores",
        "description": "Autentica um usuário com email e senha e verifica se possui a role `admin` na tabela `user_roles`.\nCaso não seja admin, a sessão é invalidada e retorna 403.\n",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "admin@exemplo.com"
                  },
                  "password": {
                    "type": "string",
                    "example": "senha123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admin autenticado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "session": {
                      "$ref": "#/components/schemas/Session"
                    },
                    "user": {
                      "$ref": "#/components/schemas/AdminUser"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Email ou senha não fornecidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Email e senha são obrigatórios"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Email ou senha inválidos"
                }
              }
            }
          },
          "403": {
            "description": "Usuário não é administrador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Acesso restrito a administradores"
                }
              }
            }
          },
          "405": {
            "description": "Método não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Método não permitido"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Erro interno do servidor"
                }
              }
            }
          }
        }
      }
    },
    "/auth-me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Retorna dados e permissões do usuário autenticado",
        "description": "Valida o token JWT e retorna o perfil do usuário com suas roles e flags `is_admin` e `is_leadership`.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do usuário retornados com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "user": {
                      "$ref": "#/components/schemas/AuthUser"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token não fornecido ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Token inválido ou expirado"
                }
              }
            }
          },
          "404": {
            "description": "Perfil não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Perfil não encontrado"
                }
              }
            }
          },
          "405": {
            "description": "Método não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Método não permitido"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Erro interno do servidor"
                }
              }
            }
          }
        }
      }
    },
    "/list-users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Lista todos os usuários (somente admin)",
        "description": "Retorna a lista de usuários com perfil, roles e flags `is_admin`/`is_leadership`.\nSuporta paginação, busca por nome/email/CPF e filtro por role.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Número da página"
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            },
            "description": "Quantidade de registros por página"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Busca por nome, email ou CPF (parcial, case-insensitive)"
          },
          {
            "name": "role",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "admin",
                "member",
                "leadership"
              ]
            },
            "description": "Filtra por role específica"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de usuários retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/UserListItem"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "example": 150
                    },
                    "page": {
                      "type": "integer",
                      "example": 1
                    },
                    "page_size": {
                      "type": "integer",
                      "example": 20
                    },
                    "total_pages": {
                      "type": "integer",
                      "example": 8
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token não fornecido ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Token inválido ou expirado"
                }
              }
            }
          },
          "403": {
            "description": "Usuário não é administrador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Acesso restrito a administradores"
                }
              }
            }
          },
          "405": {
            "description": "Método não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Método não permitido"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "Erro interno do servidor"
                }
              }
            }
          }
        }
      }
    },
    "/get-user": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Busca um único usuário por ID (somente admin)",
        "description": "Retorna os dados completos de um usuário específico pelo UUID.\nInclui dados pessoais, endereço, roles e flags de permissão.\nIdeal para abrir a tela de edição de um usuário no dashboard sem precisar paginar a listagem.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "UUID do usuário a ser buscado"
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/UserItem"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "user_id não fornecido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "user_id é obrigatório"
                }
              }
            }
          },
          "401": {
            "description": "Token não fornecido ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Usuário não é administrador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "Método não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/update-user": {
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Atualiza dados de um usuário (somente admin)",
        "description": "Permite ao administrador atualizar dados do perfil e roles de qualquer usuário.\nApenas os campos enviados serão atualizados (atualização parcial).\n\nCampos suportados:\n- **Dados pessoais**: full_name, email, phone, cpf, avatar_url\n- **Endereço**: zip_code, street, number, neighborhood, complement, city, state\n- **Permissões**: roles (array com admin, member, leadership)\n- **Senha**: password (atualiza via Supabase Auth Admin API)\n\nPara desativar um usuário, utilize o endpoint `DELETE /delete-user`.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Usuário atualizado com sucesso"
                    },
                    "user_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "user_id não fornecido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "user_id é obrigatório"
                }
              }
            }
          },
          "401": {
            "description": "Token não fornecido ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Usuário não é administrador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/delete-user": {
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Desativar / Excluir um usuário (somente admin)",
        "description": "Remove completamente um usuário do sistema (desativação), incluindo perfil, roles, filiação,\ndocumentos, participações, tokens e conta de autenticação.\nEste endpoint é usado como mecanismo de desativação de usuários no painel administrativo.\nO admin não pode excluir a si mesmo por esta via.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "ID do usuário a ser excluído"
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário excluído com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Usuário excluído com sucesso"
                    },
                    "user_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "user_id não fornecido ou auto-exclusão",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token não fornecido ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Usuário não é administrador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/upload-avatar": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Upload de avatar do usuário",
        "description": "Faz upload de uma imagem de perfil (avatar) para o usuário autenticado.\nAceita `multipart/form-data` com o parâmetro `file`.\n\nComportamento:\n- Valida tipo (apenas imagens: JPEG, PNG, GIF, WebP) e tamanho (máx. 5MB).\n- Remove avatares anteriores do storage para evitar acúmulo.\n- Salva com nome timestamped para cache-busting (`avatar_{timestamp}.ext`).\n- Atualiza automaticamente o campo `avatar_url` no perfil do usuário.\n\nCompatível com FlutterFlow (multipart request).\n",
        "security": [
          {
            "bearerAuth": [],
            "apiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Arquivo de imagem (JPEG, PNG, GIF ou WebP). Máximo 5MB."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Avatar atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "avatar_url": {
                      "type": "string",
                      "description": "URL pública do novo avatar",
                      "example": "https://ieixmoamtxqedhkxllme.supabase.co/storage/v1/object/public/profile_avatars/user-id/avatar_1706012345678.jpg"
                    },
                    "message": {
                      "type": "string",
                      "example": "Avatar atualizado com sucesso"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Arquivo não enviado, tipo inválido ou tamanho excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token não fornecido ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "Método não permitido (use POST)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/admin-list-events": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Lista todos os eventos (somente admin)",
        "description": "Retorna a lista de eventos com paginação, busca por título/endereço,\nfiltro por status e opção de somente eventos futuros.\nInclui contagem de participantes confirmados e dados do criador.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Número da página"
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            },
            "description": "Quantidade de registros por página"
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Busca por título ou endereço (parcial, case-insensitive)"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "scheduled",
                "cancelled"
              ]
            },
            "description": "Filtra por status do evento"
          },
          {
            "name": "only_future",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "description": "Se \"true\", retorna apenas eventos futuros"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de eventos retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EventItem"
                      }
                    },
                    "total": {
                      "type": "integer",
                      "example": 45
                    },
                    "page": {
                      "type": "integer",
                      "example": 1
                    },
                    "page_size": {
                      "type": "integer",
                      "example": 20
                    },
                    "total_pages": {
                      "type": "integer",
                      "example": 3
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token não fornecido ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Usuário não é administrador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "Método não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/rest/v1/rpc/admin_create_or_update_event": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Criar ou editar evento (admin)",
        "description": "Cria um novo evento ou atualiza um existente.\n- **Criar**: envie o payload SEM o campo `id`.\n- **Editar**: envie o payload COM o campo `id` do evento existente.\nCampos não enviados no modo edição mantêm o valor atual (COALESCE).\nApenas administradores podem usar este endpoint.\n",
        "security": [
          {
            "bearerAuth": [],
            "apiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_payload"
                ],
                "properties": {
                  "p_payload": {
                    "type": "object",
                    "required": [
                      "title",
                      "start_at",
                      "end_at",
                      "address"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "format": "uuid",
                        "description": "UUID do evento (enviar apenas para edição)"
                      },
                      "title": {
                        "type": "string",
                        "description": "Título do evento",
                        "example": "Reunião Regional Norte"
                      },
                      "start_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Data/hora de início",
                        "example": "2026-04-15T19:00:00Z"
                      },
                      "end_at": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Data/hora de término",
                        "example": "2026-04-15T21:00:00Z"
                      },
                      "address": {
                        "type": "string",
                        "description": "Endereço do evento",
                        "example": "Rua das Flores, 123 - Brasília/DF"
                      },
                      "location_url": {
                        "type": "string",
                        "description": "URL do mapa ou link de localização (opcional)",
                        "example": "https://maps.google.com/?q=..."
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "scheduled",
                          "cancelled"
                        ],
                        "description": "Status do evento (padrão: scheduled)",
                        "example": "scheduled"
                      }
                    }
                  }
                }
              },
              "examples": {
                "criar": {
                  "summary": "Criar novo evento",
                  "value": {
                    "p_payload": {
                      "title": "Reunião Regional Norte",
                      "start_at": "2026-04-15T19:00:00Z",
                      "end_at": "2026-04-15T21:00:00Z",
                      "address": "Rua das Flores, 123 - Brasília/DF"
                    }
                  }
                },
                "editar": {
                  "summary": "Editar evento existente",
                  "value": {
                    "p_payload": {
                      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                      "title": "Reunião Regional Norte (atualizada)",
                      "start_at": "2026-04-16T19:00:00Z",
                      "end_at": "2026-04-16T21:00:00Z",
                      "address": "Rua Nova, 456 - Brasília/DF"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Evento criado ou atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Evento criado com sucesso"
                    },
                    "event_id": {
                      "type": "string",
                      "format": "uuid",
                      "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token não fornecido ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Acesso restrito a administradores",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
