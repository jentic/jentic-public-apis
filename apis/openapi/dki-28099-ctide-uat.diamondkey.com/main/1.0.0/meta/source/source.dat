{
  "openapi": "3.0.3",
  "info": {
    "title": "Omega Hostcomms Gateway",
    "version": "1.0.0",
    "description": "Gateway API to reroute requests to Omega API",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Test44927/omega-hostcomms-V9/1.0.0"
  },
  "servers": [
    {
      "url": "https://dki-28099-ctide-uat.diamondkey.com:3001/gateway/"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Message_Header": {
        "type": "object",
        "required": [
          "Message_Type",
          "VersionNumber",
          "Message_Date",
          "SiteCode",
          "MessageID"
        ],
        "properties": {
          "Message_Type": {
            "type": "string",
            "maxLength": 16,
            "example": "EQPT:DELETE",
            "enum": [
              "AUTH:TOKEN",
              "LOAD:SPEC",
              "LOAD:DELETE",
              "EQPT:DETAIL",
              "EQPT:DELETE",
              "LOAD:DETAIL",
              "TANKER:DETAIL",
              "TANKER:DELETE",
              "PERSONNEL:DETAIL",
              "PERSONNEL:DELETE",
              "COMPANY:DETAIL",
              "COMPANY:DELETE"
            ]
          },
          "VersionNumber": {
            "type": "string",
            "maxLength": 8,
            "example": "09.06.12"
          },
          "Message_Date": {
            "type": "string",
            "format": "date-time",
            "maxLength": 20,
            "example": "2025-05-20T09:12:28Z"
          },
          "SiteCode": {
            "type": "string",
            "maxLength": 16,
            "example": "1111"
          },
          "MessageID": {
            "type": "string",
            "maxLength": 20,
            "example": "20250518022500"
          }
        }
      },
      "Schedule_Details": {
        "type": "object",
        "required": [
          "Message_Header",
          "shls_trip_no",
          "shls_supplier"
        ],
        "properties": {
          "Message_Header": {
            "$ref": "#/components/schemas/Message_Header"
          },
          "shls_trip_no": {
            "type": "string",
            "maxLength": 9,
            "example": "944"
          },
          "shls_supplier": {
            "type": "string",
            "maxLength": 16,
            "example": "1"
          }
        }
      },
      "Schedule_Create": {
        "type": "object",
        "required": [
          "Message_Header",
          "shls_terminal",
          "supplier_code",
          "tnkr_code",
          "drawer_code",
          "compartments"
        ],
        "properties": {
          "Message_Header": {
            "$ref": "#/components/schemas/Message_Header"
          },
          "shls_terminal": {
            "type": "string",
            "maxLength": 16,
            "example": "1111"
          },
          "SAP_Ref_Number": {
            "type": "string",
            "maxLength": 16
          },
          "supplier_code": {
            "type": "string",
            "maxLength": 16,
            "example": "1"
          },
          "shls_trip_no": {
            "type": "string",
            "maxLength": 9,
            "example": "944"
          },
          "shls_sold_to_num": {
            "type": "string",
            "maxLength": 20
          },
          "shls_ship_to_num": {
            "type": "string",
            "maxLength": 20
          },
          "shl_fleet_data": {
            "type": "string",
            "maxLength": 40
          },
          "Host_Ref_Data": {
            "type": "string",
            "maxLength": 20
          },
          "carrier_code": {
            "type": "string",
            "maxLength": 16,
            "example": "3001840"
          },
          "Host_Carrier_Code": {
            "type": "string",
            "maxLength": 20,
            "example": "3001888"
          },
          "tnkr_code": {
            "type": "string",
            "maxLength": 20,
            "example": "1643"
          },
          "tnkr_eqpt": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sequence_no",
                "eqpt_id"
              ],
              "properties": {
                "sequence_no": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99
                },
                "eqpt_id": {
                  "type": "string",
                  "maxLength": 9
                },
                "eqpt_code": {
                  "type": "string",
                  "maxLength": 20
                }
              }
            }
          },
          "shls_caldate": {
            "type": "string",
            "maxLength": 20,
            "anyOf": [
              {
                "format": "date-time"
              },
              {
                "enum": [
                  ""
                ]
              }
            ],
            "nullable": true
          },
          "shls_shift": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3",
              ""
            ],
            "maxLength": 1
          },
          "shls_priority": {
            "type": "string",
            "maxLength": 9
          },
          "shls_expiry": {
            "type": "string",
            "maxLength": 20,
            "anyOf": [
              {
                "format": "date-time"
              },
              {
                "enum": [
                  ""
                ]
              }
            ],
            "nullable": true
          },
          "driver": {
            "type": "string",
            "maxLength": 12
          },
          "driver_company": {
            "type": "string",
            "maxLength": 16
          },
          "drawer_code": {
            "type": "string",
            "maxLength": 16,
            "example": "1"
          },
          "shls_isotainer_num": {
            "type": "string",
            "maxLength": 20
          },
          "shls_spec_ins": {
            "type": "string",
            "maxLength": 4000
          },
          "shls_load_security_info": {
            "type": "string",
            "maxLength": 120
          },
          "shls_delvloc": {
            "type": "string",
            "maxLength": 16
          },
          "shls_cust": {
            "type": "string",
            "maxLength": 20
          },
          "unload": {
            "type": "boolean",
            "default": false
          },
          "compartments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "eqpt_id",
                "compartment",
                "eqpt_cmpt",
                "prod_code",
                "prod_cmpy",
                "unit_name",
                "qty_scheduled",
                "qty_preload"
              ],
              "properties": {
                "eqpt_id": {
                  "type": "string",
                  "maxLength": 9
                },
                "eqpt_code": {
                  "type": "string",
                  "maxLength": 20
                },
                "compartment": {
                  "type": "integer",
                  "maximum": 9999
                },
                "eqpt_cmpt": {
                  "type": "string",
                  "maxLength": 9999
                },
                "prod_code": {
                  "type": "string",
                  "maxLength": 36
                },
                "prod_cmpy": {
                  "type": "string",
                  "maxLength": 16
                },
                "unit_name": {
                  "type": "string",
                  "enum": [
                    "l (amb)",
                    "l (cor)",
                    "kg"
                  ],
                  "maxLength": 7
                },
                "qty_scheduled": {
                  "type": "number",
                  "maximum": 999999999
                },
                "qty_preload": {
                  "type": "number",
                  "maximum": 999999999
                }
              }
            }
          }
        }
      },
      "Schedule_Delete": {
        "type": "object",
        "required": [
          "Message_Header",
          "shls_trip_no",
          "shls_terminal",
          "shls_supplier"
        ],
        "properties": {
          "Message_Header": {
            "$ref": "#/components/schemas/Message_Header"
          },
          "shls_trip_no": {
            "type": "string",
            "nullable": true,
            "maxLength": 9,
            "example": "940"
          },
          "Order_Number": {
            "type": "string",
            "nullable": true,
            "maxLength": 9,
            "example": null
          },
          "shls_terminal": {
            "type": "string",
            "maxLength": 16,
            "example": "1111"
          },
          "shls_supplier": {
            "type": "string",
            "maxLength": 16,
            "example": "1"
          }
        }
      },
      "Equipment_Create": {
        "type": "object",
        "required": [
          "Message_Header",
          "eqpt_code",
          "eqpt_title",
          "eqpt_owner",
          "eqpt_etp",
          "eqpt_area",
          "eqpt_compartments"
        ],
        "properties": {
          "Message_Header": {
            "$ref": "#/components/schemas/Message_Header"
          },
          "eqpt_id": {
            "type": "string",
            "maxLength": 9
          },
          "eqpt_code": {
            "type": "string",
            "maxLength": 20
          },
          "eqpt_title": {
            "type": "string",
            "maxLength": 20
          },
          "eqpt_tanker": {
            "type": "string",
            "maxLength": 20
          },
          "eqpt_owner": {
            "type": "string",
            "maxLength": 16
          },
          "eqpt_owner_name": {
            "type": "string",
            "maxLength": 20
          },
          "eqpt_etp": {
            "type": "string",
            "maxLength": 9
          },
          "eqpt_etp_code": {
            "type": "string",
            "maxLength": 40
          },
          "eqpt_exp_d1_dmy": {
            "type": "string",
            "maxLength": 20,
            "anyOf": [
              {
                "format": "date"
              },
              {
                "enum": [
                  ""
                ]
              }
            ],
            "nullable": true
          },
          "eqpt_exp_d2_dmy": {
            "type": "string",
            "maxLength": 20,
            "anyOf": [
              {
                "format": "date"
              },
              {
                "enum": [
                  ""
                ]
              }
            ],
            "nullable": true
          },
          "eqpt_exp_d3_dmy": {
            "type": "string",
            "maxLength": 20,
            "anyOf": [
              {
                "format": "date"
              },
              {
                "enum": [
                  ""
                ]
              }
            ],
            "nullable": true
          },
          "eqpt_lock": {
            "type": "boolean",
            "default": false
          },
          "eqp_must_tare_in": {
            "type": "boolean",
            "default": false
          },
          "eqpt_comments": {
            "type": "string",
            "maxLength": 4000,
            "default": ""
          },
          "eqpt_area": {
            "type": "string",
            "maxLength": 4,
            "default": "9999"
          },
          "eqpt_guard_master_used": {
            "type": "boolean",
            "default": false
          },
          "eqpt_guard_master_desc": {
            "type": "string",
            "maxLength": 200,
            "default": ""
          },
          "eqpt_guard_master_id": {
            "type": "string",
            "maxLength": 10,
            "default": ""
          },
          "slp_expiry": {
            "type": "string",
            "maxLength": 20,
            "default": ""
          },
          "vin_number": {
            "type": "string",
            "maxLength": 120,
            "default": ""
          },
          "eqpt_compartments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "cmpt_no",
                "cmpt_units",
                "safefill",
                "capacity",
                "cmpt_lock"
              ],
              "properties": {
                "cmpt_no": {
                  "type": "string",
                  "maxLength": 4
                },
                "cmpt_units": {
                  "type": "string",
                  "enum": [
                    "l (amb)",
                    "l (cor)",
                    "kg"
                  ],
                  "maxLength": 7
                },
                "safefill": {
                  "type": "number",
                  "maximum": 999999
                },
                "capacity": {
                  "type": "number",
                  "maximum": 9999999
                },
                "cmpt_lock": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          }
        }
      },
      "Equipment_Delete": {
        "type": "object",
        "required": [
          "Message_Header",
          "eqpt_id"
        ],
        "properties": {
          "Message_Header": {
            "$ref": "#/components/schemas/Message_Header"
          },
          "eqpt_id": {
            "type": "string",
            "maxLength": 9,
            "example": "315"
          },
          "eqpt_code": {
            "type": "string",
            "maxLength": 20,
            "example": "EQPT1234"
          }
        }
      },
      "Tanker_Create": {
        "type": "object",
        "required": [
          "Message_Header",
          "tnkr_code",
          "tnkr_name",
          "tnkr_carrier",
          "tnkr_owner",
          "tnkr_etp",
          "tnkr_lock",
          "tnkr_active",
          "tnkr_max_kg",
          "tnkr_eqpt"
        ],
        "properties": {
          "Message_Header": {
            "$ref": "#/components/schemas/Message_Header"
          },
          "tnkr_code": {
            "type": "string",
            "maxLength": 20,
            "example": "115701",
            "description": "Tanker code identifier"
          },
          "tnkr_number": {
            "type": "string",
            "maxLength": 20,
            "example": "115701",
            "description": "Optional tanker number"
          },
          "tnkr_name": {
            "type": "string",
            "maxLength": 20,
            "example": "Test_12_Cmpt",
            "description": "Tanker name"
          },
          "tnkr_carrier": {
            "type": "string",
            "maxLength": 16,
            "example": "611",
            "description": "Carrier code"
          },
          "tnkr_owner": {
            "type": "string",
            "maxLength": 16,
            "example": "611",
            "description": "Owner code"
          },
          "tnkr_etp": {
            "type": "string",
            "maxLength": 9,
            "example": "16",
            "description": "Equipment type code"
          },
          "tnkr_etp_code": {
            "type": "string",
            "maxLength": 40,
            "example": "TANKER TYPE"
          },
          "tnkr_pin": {
            "type": "string",
            "maxLength": 20,
            "example": "",
            "description": "Optional tanker PIN"
          },
          "tnkr_lock": {
            "type": "boolean",
            "default": false,
            "description": "Tanker lock status"
          },
          "tnkr_active": {
            "type": "boolean",
            "default": true,
            "description": "Tanker active status"
          },
          "tnkr_long_vehicle": {
            "type": "boolean",
            "default": false,
            "description": "Long vehicle indicator"
          },
          "tnkr_lic_exp": {
            "type": "string",
            "anyOf": [
              {
                "format": "date"
              },
              {
                "enum": [
                  ""
                ]
              }
            ],
            "nullable": true,
            "maxLength": 20,
            "example": "2023-10-26",
            "description": "Optional license expiry date"
          },
          "tnkr_dglic_exp": {
            "type": "string",
            "anyOf": [
              {
                "format": "date"
              },
              {
                "enum": [
                  ""
                ]
              }
            ],
            "nullable": true,
            "maxLength": 20,
            "example": "2023-10-26",
            "description": "Optional dangerous goods license expiry date"
          },
          "tnkr_ins_exp": {
            "type": "string",
            "anyOf": [
              {
                "format": "date"
              },
              {
                "enum": [
                  ""
                ]
              }
            ],
            "nullable": true,
            "maxLength": 20,
            "example": "2023-10-26",
            "description": "Optional insurance expiry date"
          },
          "tnkr_stats": {
            "type": "string",
            "maxLength": 1,
            "example": "",
            "description": "Tanker statistics"
          },
          "tnkr_max_kg": {
            "type": "number",
            "maximum": 999999999,
            "example": 0,
            "description": "Maximum weight in kg"
          },
          "comments": {
            "type": "string",
            "maxLength": 4000,
            "example": "",
            "description": "Additional comments"
          },
          "tnkr_eqpt": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sequence_no",
                "eqpt_id"
              ],
              "properties": {
                "sequence_no": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99
                },
                "eqpt_id": {
                  "type": "string",
                  "maxLength": 9
                },
                "eqpt_code": {
                  "type": "string",
                  "maxLength": 20
                }
              }
            }
          }
        }
      },
      "Tanker_Delete": {
        "type": "object",
        "required": [
          "Message_Header",
          "tnkr_code"
        ],
        "properties": {
          "Message_Header": {
            "$ref": "#/components/schemas/Message_Header"
          },
          "tnkr_code": {
            "type": "string",
            "maxLength": 20,
            "example": "115701",
            "description": "Tanker code identifier to delete"
          }
        }
      },
      "Personnel_Create": {
        "type": "object",
        "required": [
          "Message_Header",
          "person_code",
          "person_name",
          "person_employer",
          "person_time_code",
          "person_role_auth"
        ],
        "properties": {
          "Message_Header": {
            "$ref": "#/components/schemas/Message_Header"
          },
          "person_code": {
            "type": "string",
            "maxLength": 12,
            "example": "ABSHKR1234",
            "description": "Personnel code identifier"
          },
          "person_name": {
            "type": "string",
            "maxLength": 50,
            "example": "ABC SHKR",
            "description": "Personnel full name"
          },
          "person_employer": {
            "type": "string",
            "maxLength": 16,
            "example": "200",
            "description": "Employer code"
          },
          "person_employer_name": {
            "type": "string",
            "maxLength": 20,
            "example": "EMPLOYER NAME",
            "description": "Employer name"
          },
          "person_email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "abc@mail.com",
            "description": "Personnel email address"
          },
          "person_phone": {
            "type": "string",
            "maxLength": 32,
            "example": "+61402302302",
            "description": "Personnel phone number"
          },
          "person_time_code": {
            "type": "string",
            "maxLength": 4,
            "example": "AL",
            "description": "Roster schedule code"
          },
          "person_role_auth": {
            "type": "string",
            "maxLength": 12,
            "enum": [
              "DRIVER",
              "CONTRACTOR",
              "LOADER"
            ],
            "example": "DRIVER",
            "description": "Personnel role authorization"
          },
          "person_exp_d1_ymd": {
            "type": "string",
            "format": "date",
            "maxLength": 20,
            "example": "2023-10-26",
            "description": "Personnel expiry date 1"
          },
          "person_exp_d2_ymd": {
            "type": "string",
            "format": "date",
            "maxLength": 20,
            "example": "2023-10-26",
            "description": "Personnel expiry date 2"
          },
          "person_exp_d3_ymd": {
            "type": "string",
            "format": "date",
            "maxLength": 20,
            "example": "2023-10-19",
            "description": "Personnel expiry date 3"
          },
          "person_lock": {
            "type": "boolean",
            "default": false,
            "description": "Personnel lock status"
          },
          "person_department": {
            "type": "string",
            "maxLength": 16,
            "example": "OPERATIONS",
            "description": "Personnel department"
          },
          "person_licence_number": {
            "type": "string",
            "maxLength": 20,
            "example": "P1234343434",
            "description": "Personnel licence number"
          },
          "person_comments": {
            "type": "string",
            "maxLength": 4000,
            "example": "",
            "description": "Additional comments"
          },
          "person_area": {
            "type": "string",
            "maxLength": 4,
            "example": "9999",
            "description": "Personnel area code"
          }
        }
      },
      "Personnel_Delete": {
        "type": "object",
        "required": [
          "Message_Header",
          "person_code"
        ],
        "properties": {
          "Message_Header": {
            "$ref": "#/components/schemas/Message_Header"
          },
          "person_code": {
            "type": "string",
            "maxLength": 12,
            "example": "ABSHKR1234",
            "description": "Personnel code identifier to delete"
          }
        }
      },
      "Company_Create": {
        "type": "object",
        "required": [
          "Message_Header",
          "company_code",
          "company_name",
          "company_site_manager",
          "company_supplier",
          "company_carrier",
          "company_customer",
          "company_drawer",
          "company_issuer",
          "company_employer",
          "company_host"
        ],
        "properties": {
          "Message_Header": {
            "$ref": "#/components/schemas/Message_Header"
          },
          "company_code": {
            "type": "string",
            "maxLength": 16,
            "example": "991234",
            "description": "Company code identifier"
          },
          "company_name": {
            "type": "string",
            "maxLength": 300,
            "example": "Ipiranga Ltd.",
            "description": "Company name"
          },
          "company_site_manager": {
            "type": "boolean",
            "default": false,
            "description": "Whether company can act as site manager"
          },
          "company_supplier": {
            "type": "boolean",
            "default": false,
            "description": "Whether company can act as supplier"
          },
          "company_carrier": {
            "type": "boolean",
            "default": false,
            "description": "Whether company can act as carrier"
          },
          "company_customer": {
            "type": "boolean",
            "default": false,
            "description": "Whether company can act as customer"
          },
          "company_drawer": {
            "type": "boolean",
            "default": false,
            "description": "Whether company can act as drawer"
          },
          "company_issuer": {
            "type": "boolean",
            "default": false,
            "description": "Whether company can act as issuer"
          },
          "company_employer": {
            "type": "boolean",
            "default": false,
            "description": "Whether company can act as employer"
          },
          "company_host": {
            "type": "boolean",
            "default": false,
            "description": "Whether company can act as host"
          },
          "company_Ref_Number": {
            "type": "string",
            "maxLength": 4,
            "example": "T521",
            "description": "Optional company reference number"
          }
        }
      },
      "Company_Delete": {
        "type": "object",
        "required": [
          "Message_Header",
          "company_code"
        ],
        "properties": {
          "Message_Header": {
            "$ref": "#/components/schemas/Message_Header"
          },
          "company_code": {
            "type": "string",
            "maxLength": 16,
            "example": "991234",
            "description": "Company code identifier to delete"
          }
        }
      },
      "Load_Details_Response": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Load details retrieved"
          },
          "data": {
            "$ref": "#/components/schemas/Load_Details_Data"
          }
        }
      },
      "Load_Details_Data": {
        "type": "object",
        "properties": {
