{
  "openapi": "3.0.3",
  "info": {
    "title": "Calendarific Holiday API",
    "description": "Calendarific provides a comprehensive list of holidays for over 200 countries and regions.",
    "version": "2.0.0",
    "x-jentic-source-url": "https://calendarific.com/api-documentation",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://calendarific.com/api/v2",
      "description": "Calendarific API v2"
    }
  ],
  "security": [
    {
      "apiKeyQuery": []
    }
  ],
  "paths": {
    "/holidays": {
      "get": {
        "operationId": "getHolidays",
        "summary": "Get a list of holidays for a given country and year",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": true,
            "description": "Country code in ISO-3166 format (e.g., US, GB)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": true,
            "description": "Year to retrieve holidays for (supports historical through 2049)",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "day",
            "in": "query",
            "required": false,
            "description": "Day of the month (1-31)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": false,
            "description": "Month (1-12)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "State or region in ISO-3166 format (e.g., us-ny)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Holiday type filter",
            "schema": {
              "type": "string",
              "enum": [
                "national",
                "local",
                "religious",
                "observance"
              ]
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "2-letter ISO-639 language code (Premium plan required)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "uuid",
            "in": "query",
            "required": false,
            "description": "Include unique identifiers (Premium plan required)",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of holidays",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer"
                        }
                      }
                    },
                    "response": {
                      "type": "object",
                      "properties": {
                        "holidays": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Holiday"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing API key"
          },
          "422": {
            "description": "Unprocessable entity - invalid parameters"
          },
          "429": {
            "description": "Too many requests - API limits reached"
          }
        }
      }
    },
    "/languages": {
      "get": {
        "operationId": "getLanguages",
        "summary": "Get list of supported languages",
        "responses": {
          "200": {
            "description": "List of supported languages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer"
                        }
                      }
                    },
                    "response": {
                      "type": "object",
                      "properties": {
                        "languages": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "code": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/countries": {
      "get": {
        "operationId": "getCountries",
        "summary": "Get list of supported countries",
        "responses": {
          "200": {
            "description": "List of supported countries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "integer"
                        }
                      }
                    },
                    "response": {
                      "type": "object",
                      "properties": {
                        "countries": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "country_name": {
                                "type": "string"
                              },
                              "iso-3166": {
                                "type": "string"
                              },
                              "total_holidays": {
                                "type": "integer"
                              },
                              "supported_languages": {
                                "type": "integer"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key",
        "description": "API key passed as a query parameter"
      }
    },
    "schemas": {
      "Holiday": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Holiday name"
          },
          "description": {
            "type": "string",
            "description": "Holiday description"
          },
          "date": {
            "type": "object",
            "properties": {
              "iso": {
                "type": "string",
                "description": "ISO format date"
              },
              "datetime": {
                "type": "object",
                "properties": {
                  "year": {
                    "type": "integer"
                  },
                  "month": {
                    "type": "integer"
                  },
                  "day": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "type": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Types of observance"
          }
        }
      }
    }
  }
}
