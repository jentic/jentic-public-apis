                    "type": "number",
                    "example": 5
                  },
                  "entertainment_id": {
                    "type": "number",
                    "example": 12
                  },
                  "offline_download": {
                    "type": "number",
                    "example": 1
                  },
                  "partner_id": {
                    "type": "number",
                    "example": 3
                  },
                  "priority": {
                    "type": "number",
                    "example": 2
                  },
                  "size_bytes": {
                    "type": "number",
                    "example": 1048576
                  }
                }
              },
              "examples": {
                "Device Download Task Management": {
                  "value": {
                    "customer_id": 8,
                    "device_id": 5,
                    "entertainment_id": 12,
                    "offline_download": 1,
                    "partner_id": 3,
                    "priority": 2,
                    "size_bytes": 1048576
                  }
