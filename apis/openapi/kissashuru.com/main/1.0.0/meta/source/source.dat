  "paths": {
    "/api/register": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "User register",
        "description": "User register",
        "operationId": "userRegister",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "created_at": {
                    "type": "string",
                    "example": "2025-10-08T12:00:00Z"
                  },
                  "date_of_birth": {
                    "type": "string",
                    "example": "1998-06-14"
                  },
                  "email": {
                    "type": "string",
                    "example": "tushargahiwal55@gmail.com"
                  },
                  "email_verified_at": {
                    "type": "string",
                    "example": "2025-10-07T12:00:00Z"
                  },
                  "file_url": {
                    "type": "string",
                    "example": "/dummy-images/profile/admin/super_admin.png"
                  },
                  "first_name": {
                    "type": "string",
                    "example": "Tushar"
                  },
                  "gender": {
                    "type": "string",
                    "example": "male"
                  },
                  "is_subscribe": {
                    "type": "number",
                    "example": 0
                  },
                  "last_name": {
                    "type": "string",
                    "example": "Gahiwal"
                  },
                  "login_type": {
                    "type": "string",
                    "example": "manual"
                  },
                  "mobile": {
                    "type": "string",
                    "example": "9579652873"
                  },
                  "password": {
                    "type": "string",
                    "example": "tushar@123"
                  },
                  "updated_at": {
                    "type": "string",
                    "example": "2025-10-08T12:00:00Z"
                  },
                  "user_type": {
                    "type": "string",
                    "example": "admin"
                  }
                }
              },
              "examples": {
                "User register": {
                  "value": {
                    "created_at": "2025-10-08T12:00:00Z",
                    "date_of_birth": "1998-06-14",
                    "email": "tushargahiwal55@gmail.com",
                    "email_verified_at": "2025-10-07T12:00:00Z",
                    "file_url": "/dummy-images/profile/admin/super_admin.png",
                    "first_name": "Tushar",
                    "gender": "male",
                    "is_subscribe": 0,
                    "last_name": "Gahiwal",
                    "login_type": "manual",
                    "mobile": "9579652873",
                    "password": "tushar@123",
                    "updated_at": "2025-10-08T12:00:00Z",
                    "user_type": "admin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
