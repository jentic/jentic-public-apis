        "description": "Read one operation's status and error.\n\nEvery asynchronous action - a deploy, a delete, a secret write, an environment create - will run as an operation, so a `failed` state comes with the reason instead of leaving you to guess.",
        "parameters": [
          {
            "name": "opId",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the operation",
