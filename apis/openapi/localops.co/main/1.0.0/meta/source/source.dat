    "/v1/environments/{envId}": {
      "get": {
        "tags": ["Environments"],
        "summary": "Get Environment",
        "operationId": "getEnvironment",
        "description": "Read an environment's identity, lifecycle state, network edges and workload identity.\n\nThree fields exist so you can wire your own infrastructure to the environment, and all three are read live from the environment's infrastructure on every request:\n\n- `ingress_host` is the load balancer in front of the environment's ingress. Point your own DNS records at it - a `CNAME` when it is a hostname (AWS), an `A` record when it is an IP address (GCP).\n- `public_nat_ips` are the NAT gateway addresses the environment's outbound traffic leaves from. Allowlist them in your own firewalls and database security groups.\n- `svc_role_arn` is the IAM role the environment's pods assume on AWS. Name it as a principal in your own bucket, queue and KMS key policies. It is an identifier and not a credential, so naming it grants nothing until you also set up the trust in your own account.\n\nAll three are empty until the environment is provisioned. `svc_role_arn` is always empty on GCP, where the equivalent identity is a service account rather than a role.",
        "parameters": [
          {
            "name": "envId",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the environment",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Environment details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "environment": {
                          "$ref": "#/components/schemas/Environment"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "message": "success",
                  "data": {
                    "environment": {
                      "id": "6a1f7e0c-0000-0000-0000-000000000000",
                      "name": "production",
                      "state": "available",
                      "cloud_region_code": "aws-us-east-1",
                      "ingress_host": "k8s-ingress-a1b2c3d4.elb.us-east-1.amazonaws.com",
                      "public_nat_ips": ["43.204.246.44"],
                      "svc_role_arn": "arn:aws:iam::123456789012:role/lops-prod-a1b2-svc-role",
                      "default_origin": "https://production-a1b2.localops.co",
                      "created_at": "2026-07-02T11:20:31Z"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "tags": ["Environments"],
        "summary": "Delete Environment",
        "operationId": "deleteEnvironment",
        "x-mint": {
          "metadata": {
            "tag": "COMING SOON",
            "playground": "none"
