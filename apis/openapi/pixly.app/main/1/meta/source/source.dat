{"openapi":"3.1.0","info":{"title":"Pixly API","version":"1","summary":"Real-estate photo and video tools over plain HTTP.","description":"Turn listing photos into staged photos and short videos. Typical flow: POST a tool with imageUrl → if the answer is 202, poll the job until status is \"completed\" → download resultUrls. Generation tools spend credits from the account's Pixly balance. Full reference: https://pixly.app/docs.md","termsOfService":"https://pixly.app/terms","contact":{"name":"Pixly support","email":"support@pixly.app","url":"https://pixly.app/docs"}},"servers":[{"url":"https://pixly.app"}],"security":[{"apiKey":[]},{"oauth":["tools"]}],"tags":[{"name":"Tools","description":"Generation tools — each spends credits"},{"name":"Jobs","description":"Status and results"},{"name":"Account"},{"name":"Uploads","description":"Only needed for local files with no URL"}],"paths":{"/api/v1/tools":{"get":{"operationId":"list_tools","summary":"Tool catalog with JSON Schema for every input","tags":["Tools"],"responses":{"200":{"description":"The catalog","content":{"application/json":{"schema":{"type":"object","properties":{"tools":{"type":"array","items":{"type":"object"}}}}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/virtual_staging":{"post":{"operationId":"virtual_staging","summary":"Virtual Staging","description":"AI virtual staging: furnish and style an empty (or badly furnished) room photo in a chosen interior design style — also the tool for \"redesign this room\" or \"show this room in another style\". HD, watermark-free results.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."},"style":{"type":"string","minLength":1,"description":"Interior style id. One of: modern-minimal, scandinavian, industrial, mid-century-modern, japandi, contemporary, transitional, urban-chic, bauhaus, organic-modern, brutalist, italian-modern, traditional, art-deco, colonial, victorian, french-country, english-cottage, neoclassical, art-nouveau, grandmillennial, hollywood-regency, parisian-chic, modern-classic, craftsman, mediterranean, mediterranean-modern, rustic-farmhouse, bohemian, tropical, family-staging, hygge, wabi-sabi, modern-farmhouse, cottagecore, shabby-chic, cabin-lodge, eclectic, retro-70s, warm-luxury, investor-premium, contemporary-dark, glam, penthouse-modern, hotel-suite, maximalist, quiet-luxury, coastal, desert-modern, hacienda, pacific-northwest, caribbean-resort, hamptons, moroccan, tuscan, southwestern, asian-zen, coastal-grandmother, cape-cod, california-casual, mountain-modern. When the user has no preference, \"modern-minimal\" or \"scandinavian\" suit most listings.","examples":["modern-minimal","scandinavian","industrial","mid-century-modern","japandi"]},"roomType":{"description":"Room type hint; omit to let vision infer it from the photo","type":"string"},"customInstructions":{"description":"Optional: ONLY a wish the user stated beyond the style and room, in their words (e.g. \"add a reading chair\", \"no rug\"). Leave it out otherwise — Pixly writes the staging prompt itself (keeps walls, windows and camera angle, furnishes to scale); never restate the request or list furniture here.","type":"string"},"numImages":{"default":1,"description":"Ignored — staging always returns one image. Call again for another take.","deprecated":true,"type":"integer","minimum":1,"maximum":4},"stagingQuality":{"description":"Ignored — the Pro tier is retired. Every staging costs 1 credit.","deprecated":true,"type":"string","enum":["standard","pro"]}},"required":["style"]}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/edit_staged_photo":{"post":{"operationId":"edit_staged_photo","summary":"Edit Photo","description":"Change one thing in a photo and keep everything else exactly as it is — the parts the edit doesn't touch are copied from the photo, not redrawn. Works on any photo: a staged room, any Pixly result, or the user's own picture (swap the sofa, recolour a wall, remove a car, change the words on a sign). Optional `mask` limits the change to a marked area.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"description":"The photo to edit: a Pixly result (a resultUrls entry), the user's own photo, or any public image URL / data:image URI. Either imageUrl or r2Path is required.","type":"string","minLength":1},"r2Path":{"description":"Storage path of the photo to edit (a resultPaths entry, or an upload) — the alternative to imageUrl.","type":"string","minLength":1},"style":{"description":"Optional. Style id of the staging being edited (the ids virtual_staging takes). Left out, it is read from the photo's history; a photo that was never staged needs none.","type":"string"},"customInstructions":{"type":"string","minLength":1,"description":"The change to make, in the user's words, e.g. \"make the sofa dark green\", \"remove the car from the driveway\", \"change the sign to SOLD\"."},"mask":{"description":"Optional area to change: a PNG as a data:image/png;base64 URI or an https URL, the photo's shape, WHITE where the photo may change and BLACK (or transparent) everywhere else. Leave it out to let the request alone decide — that already keeps the rest of the photo.","type":"string","minLength":1},"maskR2Path":{"description":"Storage path of a mask — the alternative to mask.","type":"string","minLength":1},"sourceJobId":{"description":"Job the photo came from, when it is a Pixly result (lineage)","type":"string"},"sourceResultIndex":{"description":"Which of that job's results was edited","type":"integer","minimum":-9007199254740991,"maximum":9007199254740991}},"required":["customInstructions"]}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/cinematic_motion":{"post":{"operationId":"cinematic_motion","summary":"Cinematic Motion","description":"Photo to video: turn a single listing photo into a short cinematic real estate video with a professional camera move (zoom, orbit, fly-through, crane up…). No second frame needed.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."},"cameraMove":{"default":"zoom","description":"Camera-move preset","type":"string","enum":["zoom","fly-through","orbit","pan","aerial","pull-back","crane-up","tilt-up","boom-down","drone-orbit","flyover","pull-away","handheld"]},"direction":{"description":"The direction the camera travels, for the moves that have one (orbit, pan, drone-orbit). 'left-to-right' sends the camera rightward, 'right-to-left' leftward. Ignored by every other move; omit to use the move's own default.","type":"string","enum":["left-to-right","right-to-left"]},"durationSeconds":{"default":5,"description":"Clip length in seconds. Leave out for the default 5 s; 10 s costs about twice as much — use it only when the user asks for a longer video.","anyOf":[{"type":"number","const":5},{"type":"number","const":10}]},"format":{"default":"original","description":"Video shape. original (default) keeps the photo's own shape; 9:16 or 16:9 crop the photo, centred, to that shape before it is animated.","type":"string","enum":["original","9:16","16:9"]}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/photo_to_video":{"post":{"operationId":"photo_to_video","summary":"Photo to Video","description":"Turn a start photo — and optionally an end photo — into a video. With an end photo the camera travels from the first photo and lands exactly on the second (e.g. two views of the same kitchen → an orbit around the island). Pick a ready-made camera move or write your own prompt; choose the model, length and sound.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"description":"Start frame — where the video begins. Public https URL or data: URI; either imageUrl or r2Path is required.","type":"string","minLength":1},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."},"endImageUrl":{"description":"Optional end frame — the camera travels from the start photo and lands exactly on this one. Best when both photos show the same space from different spots.","type":"string","minLength":1},"endR2Path":{"description":"R2 path of the end frame — the alternative to endImageUrl.","type":"string","minLength":1},"cameraMove":{"default":"smooth","description":"Ready-made camera move used when no prompt is given.","type":"string","enum":["smooth","walk","orbitLeft","orbitRight","pushIn","pullBack","riseUp"]},"prompt":{"description":"Your own description of the video, in any language. Replaces cameraMove when set.","type":"string","maxLength":1000},"model":{"default":"kling-v3","description":"kling-v3: 3/5/8/10/15 s, optional sound, lands most precisely on the end frame. kling-2.6: 5/10 s, silent, cheaper.","type":"string","enum":["kling-v3","kling-2.6"]},"durationSeconds":{"default":5,"description":"Clip length. kling-v3 takes 3, 5, 8, 10 or 15; kling-2.6 takes 5 or 10.","type":"integer","minimum":3,"maximum":15},"sound":{"default":false,"description":"Add ambient sound (kling-v3 only; kling-2.6 is always silent).","type":"boolean"},"format":{"default":"original","description":"Video shape. original (default) keeps the start photo's own shape; 16:9, 9:16 or 1:1 crop the photos, centred, to that shape before they are animated.","type":"string","enum":["original","16:9","9:16","1:1"]}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/before_after_reel":{"post":{"operationId":"before_after_reel","summary":"Before & After Video","description":"Before and after video: animate a before→after transformation (e.g. empty room → staged, or a renovation, or a daylight photo → its Day to Night version with videoIntent day_to_night) into a social-ready reveal reel from two photos. Both photos are required. Only have one? Make the other first with a photo tool — virtual_staging (empty room → furnished), remove_furniture (furnished → empty), day_to_night, restyle_room, makeover_exterior and the other edit tools — and pass its result as afterImageUrl (or beforeImageUrl).","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"beforeImageUrl":{"description":"Start frame (e.g. the empty room photo) — https URL or data: URI","type":"string","minLength":1},"afterImageUrl":{"description":"End frame (e.g. the staged result) — https URL or data: URI","type":"string","minLength":1},"beforeR2Path":{"description":"R2 path of the start frame — the alternative to beforeImageUrl.","type":"string","minLength":1},"afterR2Path":{"description":"R2 path of the end frame — the alternative to afterImageUrl.","type":"string","minLength":1},"videoIntent":{"default":"staging_reveal","description":"staging_reveal: an empty room becoming a furnished one (or a renovation). day_to_night: Before is a daylight photo and After its dusk version (a Pixly Day to Night result and its original) — the video turns day into the lit evening; revealStyle does not apply.","type":"string","enum":["staging_reveal","staging_reveal_reverse","construction_timelapse","day_to_night"]},"revealStyle":{"default":"smooth","description":"How the transformation is revealed","type":"string","enum":["smooth","slideIn","dropLand","glowBuild","movers"]},"durationSeconds":{"default":5,"anyOf":[{"type":"number","const":5},{"type":"number","const":10}]},"format":{"default":"original","description":"Video shape. original (default) keeps the photos' own shape; 9:16, 16:9 or 1:1 crop both photos, centred, to that shape first.","type":"string","enum":["original","9:16","16:9","1:1"]}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/flythrough_video":{"post":{"operationId":"flythrough_video","summary":"Flythrough","description":"Flythrough video: one continuous camera move through a home from 2-4 room photos in walking order. Each pair of neighbouring photos becomes a 3-second move that flies from one room into the next, and the moves are stitched into one film with a cinematic speed ramp. Returns one job: poll get_job until the film is ready (a few minutes).","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"photos":{"minItems":2,"maxItems":4,"type":"array","items":{"type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."}}},"description":"The rooms in walking order, 2 to 4 photos (e.g. hallway → living room → kitchen). Each photo should show the doorway or opening into the next room — the camera flies through it. Each item takes imageUrl or r2Path."},"format":{"description":"Film shape. Omit to follow the photos (landscape photos → 16:9).","type":"string","enum":["16:9","9:16","1:1"]},"title":{"description":"Optional name for the tour, e.g. the street address.","type":"string","maxLength":80}},"required":["photos"]}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/before_after_image":{"post":{"operationId":"before_after_image","summary":"Before & After Image","description":"Free (no credits): one comparison image from a before and an after photo of the same place — e.g. an empty room and its virtual staging, a daylight shot and its dusk version, a room before and after a restyle. Side by side, stacked, or split by a line; original shape, square, 4:5 or 9:16. Write the labels in the user's language. Returns a finished image at once.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"beforeImageUrl":{"description":"The BEFORE photo (e.g. the empty room, the daylight shot). Public https URL or data: URI; or beforeR2Path.","type":"string","minLength":1},"beforeR2Path":{"description":"Storage path of the before photo — the alternative to beforeImageUrl. For a Pixly result, its original photo is the job's source.","type":"string","minLength":1},"afterImageUrl":{"description":"The AFTER photo (e.g. the staged room, the dusk version). Public https URL or data: URI; or afterR2Path.","type":"string","minLength":1},"afterR2Path":{"description":"Storage path of the after photo — the alternative to afterImageUrl.","type":"string","minLength":1},"layout":{"default":"side","description":"side = next to each other, stack = one above the other, vsplit = one frame split by a vertical line, diagonal = split by a slanted line.","type":"string","enum":["side","stack","vsplit","diagonal"]},"aspect":{"default":"original","description":"Shape of the image: original (follows the photos), 1:1 square, 4:5 Instagram post, 9:16 Stories/Reels.","type":"string","enum":["original","1:1","4:5","9:16"]},"labels":{"default":true,"description":"Show the Before / After labels.","type":"boolean"},"beforeLabel":{"description":"Label text for the before photo, in the user's language (default \"Before\").","type":"string","maxLength":24},"afterLabel":{"description":"Label text for the after photo, in the user's language (default \"After\").","type":"string","maxLength":24}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/watermark_photos":{"post":{"operationId":"watermark_photos","summary":"Watermark Photos","description":"Free (no credits): put the agent's or agency's mark on listing photos — text (name, phone) and/or the logo saved on their Pixly account — in a corner or the middle, up to 10 photos per call. Returns every marked photo at once.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"photos":{"minItems":1,"maxItems":10,"type":"array","items":{"type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."}}},"description":"The photos to mark, 1–10. Each item takes imageUrl or r2Path."},"text":{"description":"The text, e.g. \"Smith Realty · 555-0100\". Optional when the account has a saved logo.","type":"string","maxLength":60},"position":{"default":"bottom-right","type":"string","enum":["bottom-right","bottom-left","top-right","top-left","center"]},"size":{"default":"medium","type":"string","enum":["small","medium","large"]},"useLogo":{"default":true,"description":"Add the logo saved on the account (Pixly floor plan settings), when there is one.","type":"boolean"}},"required":["photos"]}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/blur_faces_plates":{"post":{"operationId":"blur_faces_plates","summary":"Blur Faces & Plates","description":"Free (no credits): find and blur people's faces and car licence plates in property photos before they're posted — street and exterior shots, open houses. Automatic detection, 1–5 photos per call. Says so when nothing is found.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"photos":{"minItems":1,"maxItems":5,"type":"array","items":{"type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."}}},"description":"The photos, 1–5. Each item takes imageUrl or r2Path."},"faces":{"default":true,"type":"boolean"},"plates":{"default":true,"type":"boolean"},"style":{"default":"blur","type":"string","enum":["blur","pixelate"]}},"required":["photos"]}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/straighten_photo":{"post":{"operationId":"straighten_photo","summary":"Straighten Photo","description":"Free (no credits): automatically straighten a property photo — leaning walls made vertical (converging verticals from a tilted camera) and a tilted horizon levelled, like a pro photographer's lens correction. Crops the edges slightly. Best before staging or any other edit. Says so when the photo is already straight or has no straight lines to go by.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/draw_floor_plan":{"post":{"operationId":"draw_floor_plan","summary":"Draw Floor Plan","description":"Free (no credits): draw a clean 2D floor plan from a layout YOU write — read the user's description, or look at their hand sketch or brochure plan, and send every room as a rectangle in metres (or feet) plus doors and windows. Returns the drawn plan (areas and dimensions on it) at once, saved so the user can fine-tune it in Pixly's floor plan editor. If the layout has problems (overlapping rooms, a door between rooms that don't touch) you get exactly what to fix — fix it and call again. To change a plan, call again with its planId and the whole updated layout; the new version is saved as its own plan and the earlier one is kept.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"title":{"description":"Address or listing name for the plan's title block.","type":"string","maxLength":80},"units":{"default":"m","description":"Units of every number below, and of the labels on the plan.","type":"string","enum":["m","ft"]},"rooms":{"minItems":1,"maxItems":40,"type":"array","items":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":30,"description":"Your own short handle for the room (\"kitchen\", \"bed1\"); doors and windows refer to it."},"type":{"type":"string","enum":["living","kitchen","dining","bedroom","bathroom","wc","hall","office","laundry","storage","garage","balcony","terrace","utility","other"],"description":"What the room is; sets its colour and default label."},"name":{"description":"Label on the plan when the type isn't enough (\"Bedroom 2\", \"Master bedroom\").","type":"string","maxLength":40},"x":{"type":"number","description":"Left edge. The plan's x runs to the right."},"y":{"type":"number","description":"Top edge. The plan's y runs DOWN (the top of the drawing is 0)."},"width":{"type":"number","minimum":0.1,"description":"Size along x."},"depth":{"type":"number","minimum":0.1,"description":"Size along y."}},"required":["id","type","x","y","width","depth"]},"description":"Every room as an axis-aligned rectangle. Neighbouring rooms must share the wall exactly (one's right edge = the other's left edge) and must not overlap. An L-shaped space = two rectangles joined by a doorway. Lay out a typical sensible plan when the user gives only rough sizes."},"doors":{"default":[],"maxItems":60,"type":"array","items":{"type":"object","properties":{"from":{"type":"string","description":"A room id."},"to":{"type":"string","description":"Another room id that shares a wall with it, or \"outside\"."},"side":{"description":"Only for to = \"outside\": which wall of the room the entrance is on.","type":"string","enum":["top","right","bottom","left"]},"kind":{"default":"door","description":"door = hinged door, doorway = open gap with no door, sliding = sliding/patio door.","type":"string","enum":["door","doorway","sliding"]},"width":{"type":"number","minimum":0.1}},"required":["from","to"]}},"windows":{"default":[],"maxItems":80,"type":"array","items":{"type":"object","properties":{"room":{"type":"string","description":"A room id."},"side":{"type":"string","enum":["top","right","bottom","left"],"description":"Which wall; it must be an outside wall (not shared with another room)."},"count":{"default":1,"type":"integer","minimum":1,"maximum":4},"width":{"type":"number","minimum":0.1},"full":{"default":false,"description":"Floor-to-ceiling glass (French window, balcony door).","type":"boolean"}},"required":["room","side"]}},"planId":{"description":"To CHANGE a plan you drew before: its planId from that result, with the whole updated layout — saved as a new plan beside it (nothing is overwritten). Omit for a new plan.","type":"string","maxLength":40}},"required":["rooms"]}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/enhance_photo":{"post":{"operationId":"enhance_photo","summary":"Enhance","description":"Real estate photo editing in one step: turn an amateur listing photo into a finished, professional photo (exposure, color, clarity). Returns 3 variants to pick from.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/declutter_photo":{"post":{"operationId":"declutter_photo","summary":"Declutter","description":"Remove clutter, mess, and personal items from a listing photo while keeping the room, furniture, and architecture intact.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/remove_furniture":{"post":{"operationId":"remove_furniture","summary":"Remove Furniture","description":"Remove furniture from a photo: empty a room and rebuild the surfaces behind what was taken out, keeping the architecture and camera angle identical — the blank canvas for restaging. By default it also removes the room's own joinery (fitted kitchen, built-in wardrobes, bathroom fixtures); mode 'movable' leaves those alone, and an optional extra takes the floor covering out too, for a full renovation strip-back. Doors always stay. (Declutter is the opposite: it keeps the furniture.)","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."},"mode":{"description":"How far to strip the room. 'fitted' (the default) removes the movable contents AND the room's own joinery — the fitted kitchen and its appliances, built-in wardrobes and shelving, and bathroom sanitaryware. 'movable' removes only furniture, rugs, curtains, art, plants and lamps, leaving the kitchen, built-ins, sanitaryware, floor and doors exactly as they are.","type":"string","enum":["movable","fitted"]},"extras":{"description":"Extra things to take out, for a full strip-back. Only applies with mode 'fitted' and is ignored otherwise: 'floor' takes the floor covering down to bare concrete screed. Omit to keep the floor. Doors always stay, as do walls, ceiling, windows, structural openings and the camera.","type":"array","items":{"type":"string","enum":["floor"]}}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/day_to_night":{"post":{"operationId":"day_to_night","summary":"Day to Night","description":"Day to dusk (virtual twilight): turn a daytime listing photo into a magazine-style evening scene — lights on, warm glow, dusk sky — with the building and camera angle unchanged.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/replace_sky":{"post":{"operationId":"replace_sky","summary":"Sky Replacement","description":"Replace a grey, overcast or blown-out sky in an exterior listing photo with a natural clear blue sky, matching the light and keeping the building, trees and reflections unchanged. A run takes about 1–2 minutes; poll get_job until it completes.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."},"sky":{"default":"auto","description":"Sky style. 'auto' lets the tool pick what suits the photo's light.","type":"string","enum":["auto","clear","light_clouds","dramatic_clouds","sunset","pastel_sunrise","winter_clear"]},"sun":{"default":"auto","description":"Sun glow: auto (a glow for sunset/sunrise styles, none otherwise), on (place it with sunX/sunY), off.","type":"string","enum":["auto","on","off"]},"sunX":{"description":"With sun=on: glow position from the left edge, 0..1.","type":"number","minimum":0,"maximum":1},"sunY":{"description":"With sun=on: glow position from the top edge, 0..1 (kept in the top 60%).","type":"number","minimum":0,"maximum":1}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/replace_lawn":{"post":{"operationId":"replace_lawn","summary":"Lawn Replacement","description":"Turn patchy, brown or bare grass in an exterior listing photo into a healthy green lawn, leaving driveways, paths, beds and the house untouched.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."},"lawn":{"default":"auto","description":"Lawn style. 'auto' lets the tool pick a healthy lawn that suits the photo.","type":"string","enum":["auto","fresh_mown","lush","natural","golf","warm_season"]},"shade":{"default":"medium","description":"How green; only used with a chosen lawn style.","type":"string","enum":["light","medium","deep"]},"stripes":{"default":"auto","description":"Mowing stripes: auto (stripes for fresh_mown and golf, none otherwise), on, off.","type":"string","enum":["auto","on","off"]}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/restyle_room":{"post":{"operationId":"restyle_room","summary":"Restyle","description":"Give one or more surfaces of a room a new finish — repaint the walls, change the floor, reface the kitchen cabinets and worktop, retile the bathroom or refinish the furniture — while the room's layout, fittings, windows and camera angle stay exactly as shot.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."},"surfaces":{"description":"Which surfaces get a new finish: 'walls', 'floor', 'cabinets' (fitted joinery plus its worktop and splashback), 'bathroom_tiles' (the tiled walls; a bathroom floor is 'floor') or 'furniture' (upholstery and wood finishes). Omit for walls. The room's layout, fittings and camera never change.","type":"array","items":{"type":"string","enum":["walls","floor","cabinets","bathroom_tiles","furniture"]}},"looks":{"description":"The finish per surface: 'auto', one of the presets below, 'custom' with your own words in `notes`, 'own_colour' (walls, cabinets, furniture) with a hex colour in `colours`, or 'material_photo' with a photo of the material in `references`. A finish that does not belong to its surface falls back to 'auto' (the tool picks one that suits the room; several on auto are made to agree). walls: warm_white, soft_grey, greige, sage, deep_navy. floor: light_oak, walnut, grey_plank, polished_concrete, stone_tile. cabinets: white_shaker, charcoal, natural_oak, forest_green, navy_cabinets. bathroom_tiles (wall tiles only; a bathroom floor is 'floor'): white_metro, zellige_white, marble_large, travertine, green_gloss. floor also takes terrazzo, encaustic_pattern, matt_black_hex. furniture: light_neutral, warm_wood, dark_wood, black_leather.","type":"object","propertyNames":{"type":"string","enum":["walls","floor","cabinets","bathroom_tiles","furniture"]},"additionalProperties":{"type":"string","enum":["auto","custom","own_colour","material_photo","warm_white","crisp_white","soft_grey","greige","warm_beige","clay_pink","sage","soft_blue","olive_green","graphite","deep_navy","terracotta_walls","panelling","wallpaper_textured","limewash","microcement","exposed_brick","timber_slats","light_oak","mid_oak","wide_ash","walnut","herringbone_oak","grey_plank","polished_concrete","stone_tile","terracotta_floor","slate_tile","checker_tile","carpet_neutral","white_shaker","cream_shaker","handleless_white","handleless_grey","charcoal","matt_black_cabinets","natural_oak","walnut_cabinets","sage_cabinets","forest_green","navy_cabinets","two_tone","gloss_white","white_metro","zellige_white","white_large","grey_porcelain","marble_large","travertine","terrazzo","encaustic_pattern","matt_black_hex","slate_dark","wood_effect_tile","green_gloss","light_neutral","mid_grey_wool","warm_greige","cream_boucle","tan_leather","black_leather","green_velvet","navy_velvet","rust_velvet","warm_wood","dark_wood","black_metal"]}},"notes":{"description":"Your own description of the finish for a surface, used when that surface's look is \"custom\" (e.g. \"terracotta hex tiles with dark grout\"). Set look \"custom\" and the note together; \"custom\" with no note falls back to \"auto\". 120 characters max, and anything in it that is not a description of a finish is ignored.","type":"object","propertyNames":{"type":"string","enum":["walls","floor","cabinets","bathroom_tiles","furniture"]},"additionalProperties":{"type":"string"}},"colours":{"description":"Any colour as a hex code for walls, cabinets or furniture (e.g. {\"walls\": \"#7A8B6F\"}), used when that surface's look is \"own_colour\". The result matches it closely as it would look in the room's light.","type":"object","propertyNames":{"type":"string","enum":["walls","floor","cabinets","bathroom_tiles","furniture"]},"additionalProperties":{"type":"string"}},"references":{"description":"A photo of the material itself — a floor plank, a tile, a fabric swatch, a wallpaper sample — for ONE surface, as the r2Path from create_upload_ticket or list_library (e.g. {\"floor\": \"users/…/oak.jpg\"}). Set that surface's look to \"material_photo\". One photo per run; a close, straight-on photo of the sample works best.","type":"object","propertyNames":{"type":"string","enum":["walls","floor","cabinets","bathroom_tiles","furniture"]},"additionalProperties":{"type":"string"}}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/reset_season":{"post":{"operationId":"reset_season","summary":"Seasonal Reset","description":"Photograph the same property in another season: take the snow off the ground, the roof and the branches and put the garden in leaf, or move a summer shot to autumn or winter. The house, the driveway, the paths and the camera angle stay exactly as shot.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."},"season":{"description":"The season to show the property in: 'spring', 'summer', 'autumn', 'winter', or 'auto' (the default — the tool shows the property at its best, which for a snowy or dormant photo means high summer). Only the planting, the ground cover and the daylight change; the house, the driveway, the paths and the framing stay exactly as shot.","type":"string","enum":["auto","spring","summer","autumn","winter"]}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/makeover_exterior":{"post":{"operationId":"makeover_exterior","summary":"Exterior Makeover","description":"Design the garden of an exterior listing photo as one coherent scheme — planting, a terrace or deck, a pool, a pergola, a fire pit, a fence, lighting — in a chosen style, at the right scale and perspective, while the house, its roof, the driveway, the sun direction and the neighbours stay exactly as shot. One run builds the whole scheme.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."},"style":{"description":"The design language of the whole scheme: 'modern_minimal', 'mediterranean', 'classic_english', 'natural_lowwater', 'tropical_resort', 'farmhouse', or 'auto' (the default — chosen to suit the house's architecture and the climate in the photo).","type":"string","enum":["auto","modern_minimal","mediterranean","classic_english","natural_lowwater","tropical_resort","farmhouse"]},"include":{"description":"Which elements the scheme includes, any number: 'planting' (beds, hedges, a feature tree), 'patio_dining' (a paved terrace with a dining set), 'deck_lounge' (a deck with loungers or a low sofa), 'pool', 'pergola', 'fire_pit', 'fence_gate' (a boundary treatment with a gate), 'lighting'. Omit or send an empty list (the default) to let the tool design what the lot wants. One run composes them all into one garden, each sized to the plot.","type":"array","items":{"type":"string","enum":["planting","patio_dining","deck_lounge","pool","pergola","fire_pit","fence_gate","lighting"]}},"scope":{"description":"'full' (the default) redesigns the whole yard in the style; 'add' keeps the existing garden and builds the chosen elements into it. The house, the driveway and the neighbours never change either way.","type":"string","enum":["add","full"]},"note":{"description":"Your own words about the garden you want (e.g. \"a small kidney-shaped pool with a stone surround and lavender everywhere\"). 160 characters max; anything in it that is not a description of the garden is ignored.","type":"string"}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/render_floor_plan":{"post":{"operationId":"render_floor_plan","summary":"Floor Plan Render","description":"Turn a picture of any floor plan — a hand sketch, a photo of a brochure page, a blueprint, a screenshot — into a polished real-estate floor plan: a furnished top-down 2D plan with real floors and room names, or a 3D isometric cutaway. The rooms, walls, doors and windows are kept exactly as drawn; nothing is added and written dimensions are left off.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."},"look":{"description":"Which picture to make of the plan: 'furnished' (the default — a polished top-down 2D plan with real floors, furniture and room names) or 'isometric' (a 3D cutaway of the same layout, furnished, no text). The photo must show a floor plan: a hand sketch, a brochure page, a blueprint, a screenshot. The layout is kept exactly as drawn; written dimensions are left off.","type":"string","enum":["furnished","isometric"]}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/touch_up_exterior":{"post":{"operationId":"touch_up_exterior","summary":"Exterior Touch-up","description":"One-click retouch of an exterior listing photo: a natural sky where it is dull, a healthy lawn where the grass is dead, a clean driveway, and bins, hoses and other clutter removed — each only where needed, with the house unchanged.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."},"fix":{"description":"Which areas the tool may touch: 'sky', 'lawn', 'hardscape' (driveway, paths, patio), 'clutter' (bins, hoses, tools, a stray vehicle). Omit for all four; each is fixed only where the photo needs it.","type":"array","items":{"type":"string","enum":["sky","lawn","hardscape","clutter"]}}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/upscale_hd":{"post":{"operationId":"upscale_hd","summary":"HD Upscale","description":"Enlarge a photo by up to four times with real detail, to a maximum of 4096 px on the long edge — for print, MLS uploads and large screens. Nothing in the photo changes. Free on any result Pixly made (pass its r2Path from list_library); 1 credit on your own photo.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."}}}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/tools/plot_sign":{"post":{"operationId":"plot_sign","summary":"Plot Number","description":"Place a photorealistic 3D monument sign with your exact text (price, area, SOLD) onto a photo of an empty plot, matched to perspective and lighting.","tags":["Tools"],"parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"imageUrl":{"type":"string","minLength":1,"description":"Public https URL of the source photo, or a data: URI. Either imageUrl or r2Path is required."},"r2Path":{"type":"string","minLength":1,"description":"Storage path of a photo already in the user's Pixly library (from list_library, or returned by an upload ticket) — the alternative to imageUrl."},"text":{"type":"string","minLength":1,"maxLength":24,"description":"Sign label, verbatim — a price (\"$1,200,000\"), area (\"800 m²\"), or short word (\"SOLD\")"},"look":{"description":"Sign material/style; defaults server-side","type":"string","enum":["stone","metal","grass","sign"]},"orientation":{"description":"Letter orientation (letter looks only); defaults server-side","type":"string","enum":["standing","lying"]}},"required":["text"]}}}},"responses":{"200":{"description":"Finished inline — resultUrls present (photo tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"202":{"description":"Accepted and running — poll GET /api/v1/jobs/{id} (video tools)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"409":{"description":"A request with the same Idempotency-Key is still running — retry in a few seconds for its result","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"410":{"description":"Source photo no longer available — re-upload","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/jobs/{id}":{"get":{"operationId":"get_job","summary":"Job status and result URLs (valid 7 days)","tags":["Jobs"],"parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"The job","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Job"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"404":{"description":"Unknown tool or job","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/jobs":{"get":{"operationId":"list_jobs","summary":"Recent generations","tags":["Jobs"],"parameters":[{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":50}},{"name":"type","in":"query","schema":{"type":"string","enum":["images","videos"]}}],"responses":{"200":{"description":"Newest first","content":{"application/json":{"schema":{"type":"object","properties":{"jobs":{"type":"array","items":{"$ref":"#/components/schemas/Job"}}}}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/library":{"get":{"operationId":"list_library","summary":"Your library as pictures: results or uploads with thumbnail, file and source links (valid 7 days)","tags":["Jobs"],"parameters":[{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":60}},{"name":"type","in":"query","schema":{"type":"string","enum":["images","videos","uploads"]}},{"name":"locale","in":"query","description":"Language of the item titles; default en.","schema":{"type":"string","enum":["en","es","pt","de","fr","it","pl","cs"]}},{"name":"before","in":"query","description":"Paging: the previous page's nextBefore.","schema":{"type":"string","format":"date-time"}}],"responses":{"200":{"description":"Newest first. Pass an item's r2Path to any tool to run it on that picture.","content":{"application/json":{"schema":{"type":"object","properties":{"nextBefore":{"type":"string","description":"Present when the page is full: pass as before for older items."},"items":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"kind":{"type":"string","enum":["image","video","upload"]},"title":{"type":"string"},"made":{"type":"string","description":"What made it, as a stable key: a job intent (\"sky_replace\"), \"staging\", \"video\" or \"upload\"."},"status":{"type":"string","enum":["completed","processing","failed"]},"createdAt":{"type":"string"},"thumbUrl":{"type":"string"},"url":{"type":"string"},"r2Path":{"type":"string"},"sourceUrl":{"type":"string"},"sourceR2Path":{"type":"string"},"style":{"type":"string"}},"required":["id","kind","title","status"]}}}}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/account":{"get":{"operationId":"get_account","summary":"Credit balance and plan","tags":["Account"],"responses":{"200":{"description":"The account","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Account"}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/checkout":{"post":{"operationId":"get_checkout_link","summary":"A Stripe Checkout URL for the account holder to pay on","description":"Call when a tool answers 402. Nothing is charged here: the person completes Stripe's page, credits arrive within seconds, then retry the tool. No active plan → a subscription; active plan → a one-time credit top-up. A subscriber asking for a different plan gets the billing page instead.","tags":["Account"],"requestBody":{"required":false,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"plan":{"description":"Plan to subscribe to, for an account with no active plan. Defaults to \"starter\". Ignored for a top-up.","type":"string","enum":["starter","agent","pro_agent","team"]},"topUpUsd":{"description":"For an account that already has a plan: one-time credit top-up amount in USD (10–500, default 10), priced at that plan's rate.","type":"number","minimum":10,"maximum":500}}}}}},"responses":{"201":{"description":"The link","content":{"application/json":{"schema":{"type":"object","required":["kind","url","summary","next"],"properties":{"kind":{"type":"string","enum":["subscribe","top_up","manage"]},"url":{"type":"string","format":"uri","description":"Give this to the user. Expires in 24 hours."},"summary":{"type":"string"},"priceUsd":{"type":"number"},"credits":{"type":"number"},"next":{"type":"string","description":"What to do after handing over the link"}}}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/uploads":{"post":{"operationId":"create_upload","summary":"Import a photo from a URL, or get a presigned PUT ticket for a local file","tags":["Uploads"],"requestBody":{"required":true,"content":{"application/json":{"schema":{"oneOf":[{"type":"object","required":["url"],"properties":{"url":{"type":"string","format":"uri"}}},{"type":"object","required":["filename","contentType"],"properties":{"filename":{"type":"string","maxLength":120},"contentType":{"type":"string","enum":["image/jpeg","image/png","image/webp","image/heic","image/heif","image/tiff"]},"sizeBytes":{"type":"integer"}}}]}}}},"responses":{"201":{"description":"r2Path always; a ticket also carries uploadUrl (PUT the bytes there) and imageUrl (pass to any tool)","content":{"application/json":{"schema":{"type":"object","required":["r2Path"],"properties":{"r2Path":{"type":"string"},"uploadUrl":{"type":"string"},"imageUrl":{"type":"string"},"note":{"type":"string"}}}}}},"401":{"description":"Missing/invalid credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"402":{"description":"Out of credits, or no active subscription (error.required = credits needed) — POST /api/v1/checkout returns a payment link","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Invalid input — error.issues lists the offending fields","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limited — see Retry-After (120 req/min, 30/min for generations)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}},"components":{"parameters":{"IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":200},"description":"Recommended. A retry with the same key and body returns the first run's result (header Idempotency-Replayed: true) instead of running and charging again. Kept 24 hours; failed runs release the key."}},"securitySchemes":{"apiKey":{"type":"http","scheme":"bearer","description":"An API key (pixly_sk_…) created at https://pixly.app/app/settings."},"oauth":{"type":"oauth2","description":"OAuth 2.1 with PKCE; public clients, dynamic registration or Client ID Metadata Documents.","flows":{"authorizationCode":{"authorizationUrl":"https://pixly.app/oauth/authorize","tokenUrl":"https://pixly.app/api/oauth/token","refreshUrl":"https://pixly.app/api/oauth/token","scopes":{"tools":"Run Pixly tools with the account's credits; read its jobs and balance"}}}}},"schemas":{"Job":{"type":"object","required":["jobId","type","status","creditsCharged","createdAt"],"properties":{"jobId":{"type":"string","description":"Job id — pass to get_job to poll"},"type":{"type":"string","enum":["image_staging","video_pair","video_tour"],"description":"Job family"},"status":{"type":"string","enum":["pending","processing","completed","failed"],"description":"Anything not completed/failed is still running"},"creditsCharged":{"type":["number","null"],"description":"Credits debited for this job"},"createdAt":{"type":"string","format":"date-time","description":"Submission time"},"completedAt":{"type":"string","format":"date-time","description":"Present once finished"},"resultUrls":{"type":"array","items":{"type":"string"},"description":"Presigned download URLs (present when completed; valid 7 days)"},"resultPaths":{"type":"array","items":{"type":"string"},"description":"Storage path of each result, in resultUrls order — pass one as r2Path (or beforeR2Path, a photos[] item…) to run another tool on this result"},"error":{"type":"string","description":"Failure reason; the message says whether the credit came back immediately or is in 24h refund review"},"note":{"type":"string","description":"Hint for agents, e.g. poll again in a few seconds"}}},"Account":{"type":"object","properties":{"creditsRemaining":{"type":"number"},"creditsTotal":{"type":"number"},"plan":{"type":["string","null"]},"canUseCredits":{"type":"boolean","description":"False = no active plan; tools answer 402"}}},"Error":{"type":"object","required":["error"],"properties":{"error":{"type":"object","required":["code","message"],"properties":{"code":{"type":"string"},"message":{"type":"string","description":"Says what to do next"},"issues":{"type":"array","items":{"type":"object","properties":{"path":{"type":"string"},"message":{"type":"string"}}}},"required":{"type":"number","description":"Credits the run needs (402)"},"jobId":{"type":"string"}}}}}}}}