s","description":"Requires the `tools:company_buying_intents` scope.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":200},"description":"A unique key per logical request; retries replay the first result instead of re-running."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"domain":{"type":"string","minLength":4,"maxLength":253,"description":"Bare company domain, e.g. example.com"},"confidence":{"description":"Only topics at these confidence levels","maxItems":3,"type":"array","items":{"type":"string","enum":["low","medium","high"]}},"limit":{"type":"integer","minimum":1,"maximum":50}},"required":["domain"]}}}},"responses":{"200":{"description":"The tool result, inside the { ok, tool, result } envelope."},"400":{"description":"Input failed the schema; `issues` says what to fix."},"402":{"description":"The workspace credits are spent."},"403":{"description":"The API key lacks the required scope."},"409":{"description":"The tool needs a connected account (`code: \"not_connected\"`, `toolkit`)."},"422":{"description":"The tool ran but could not produce a result."}}}},"/api/v1/tools/funding_events":{"post":{"summary":"Financing events: rounds, amounts, investors and dates for up to 25 named companies, or discovered across the market when no domains are giv","tags":["tools"],"operationId":"tool_funding_events","description":"Requires the `tools:funding_events` scope.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":200},"description":"A unique key per logical request; retries replay the first result instead of re-running."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"domains":{"maxItems":25,"type":"array","items":{"type":"s