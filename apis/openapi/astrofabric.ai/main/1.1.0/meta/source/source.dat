r.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":200},"description":"A unique key per logical request; retries replay the first result instead of re-running."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"objective":{"type":"string","minLength":5,"maxLength":4000,"examples":["Build a list of 100 companies showing buying intent for building insulation, with verified emails"]},"thread_id":{"type":"string","description":"Continue a previous mission with full memory."},"mode":{"type":"string","enum":["sync","async"],"default":"sync"},"callback_url":{"type":"string","format":"uri"}},"required":["objective"]}}}},"responses":{"200":{"description":"The mission reply: { thread_id, kind, reply, events }."},"202":{"description":"Queued (async mode) - poll /api/v1/runs/{id}."}}}},"/api/v1/workspace":{"get":{"summary":"The workspace this API key belongs to","tags":["workspace"],"responses":{"200":{"description":"Identity and billing: name, slug, plan, status, billing (same state contract as /api/v1/usage)."}}}},"/api/v1/usage":{"get":{"summary":"Plan and credit balance for this workspace","tags":["workspace"],"responses":{"200":{"description":"{ plan, status, credits: { included, topup, used, remaining }, period: { start, resets_at }, billing: { status, access, billing_url, trial: { ends_at, credits, active }, subscription: { plan, monthly_credits, interval, period_ends_at, cancel_at_period_end, renews_at }, can_purchase_credits, can_upgrade_now, paid_work_allowed, next_action: { code, label, url } } }. Trial allowance is 200 total credits; period.resets_at is null until paid service starts. Paid credit resets follow UTC calendar months; subscription renewal is separate. Billing access values: checkout_required, trial, active, trial_expired, payment_required, subscription_inactive, subscription_expired. Existing keys may read usage and workspace status before checkout; product actions return 402 checkout_required."},"503":{"description":"balance_unavailable or billing_unavailable: the authoritative balance/state cannot be read. Retry; never assume a new allowance."}}}},"/api/v1/runs":{"get":{"summary":"List recent runs (newest first)","tags":["runs"],"description":"Requires the `runs:read` scope.","parameters":[{"name":"status","in":"query","required":false,"schema":{"type":"string","enum":["queued","running","completed","failed","cancelled"]},"description":"Filter by status."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":50,"default":10},"description":"Page size."}],"responses":{"200":{"description":"Light rows: id, agent, status, objective, clipped result_text, cost and timestamps. Full transcript on /api/v1/runs/{id}."}}}},"/api/v1/runs/{id}":{"get":{"summary":"One agent run, including the step transcript","tags":["runs"],"description":"Requires the `runs:read` scope.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"The run.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"run":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"agent":{"type":"string"},"status":{"type":"string","enum":["queued","running","completed","failed","budget_exceeded","canceled"]},"input":{"type":"object"},"output":{},"error":{"type":["string","null"]},"steps":{"type":"array"},"usage":{"type":"object","properties":{"tokens_in":{"type":"integer"},"tokens_out":{"type":"integer"}}},"cost_usd":{"type":"number"},"created_at":{"type":"string","format":"date-time"},"started_at":{"type":["string","null"],"format":"date-time"},"finished_at":{"type":["string","null"],"format":"date-time"}}}},"required":["ok"]}}}},"404":{"description":"No such run in this workspace."}}}},"/api/v1/runs/{id}/cancel":{"post":{"summary":"Cancel a queued or running run","tags":["runs"],"description":"Requires the `agents:run` scope. Cooperative: the loop stops at its next step and settles what was already consumed. Idempotent - a finished run answers with its final status.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"The run with status \"canceled\" (or its final status)."}}}},"/api/v1/threads/{id}":{"get":{"summary":"One mission thread with its turns","tags":["threads"],"description":"Requires the `agents:mission` scope.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"The thread."},"404":{"description":"Not found."}}}},"/api/v1/lists":{"get":{"summary":"The workspace lists","tags":["lists"],"operationId":"lists_list","description":"Requires the `lists:read` scope. Lists are the persistent unit of work: missions and agents write rows into them.","responses":{"200":{"description":"Every list with its kind, status and live row count.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"lists":{"type":"array","items":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"name":{"type":"string"},"kind":{"type":"string","enum":["companies","people","mixed"]},"status":{"type":"string","enum":["building","ready","archived"]},"row_count":{"type":"integer","description":"Live (non-suppressed) rows."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},"required":["id","name","kind","status","row_count","created_at","updated_at"]}}},"required":["ok"]}}}}}},"post":{"summary":"Create an empty list","tags":["lists"],"operationId":"lists_create","description":"Requires the `lists:write` scope. Names are unique per workspace.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","maxLength":200},"kind":{"type":"string","enum":["companies","people","mixed"]},"description":{"type":"string"},"criteria":{"type":"object","description":"The ICP or search criteria the list is built from, kept with it for refreshes."}},"required":["name","kind"]}}}},"responses":{"200":{"description":"The new list.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"list":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"name":{"type":"string"},"kind":{"type":"string","enum":["companies","people","mixed"]},"status":{"type":"string","enum":["building","ready","archived"]},"row_count":{"type":"integer","description":"Live (non-suppressed) rows."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},"required":["id","name","kind","status","row_count","created_at","updated_at"]}},"required":["ok"]}}}}}}},"/api/v1/lists/{id}":{"get":{"summary":"One list","tags":["lists"],"operationId":"lists_get","description":"Requires the `lists:read` scope.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"},"description":"The list id."}],"responses":{"200":{"description":"The list.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"list":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"name":{"type":"string"},"kind":{"type":"string","enum":["companies","people","mixed"]},"status":{"type":"string","enum":["building","ready","archived"]},"row_count":{"type":"integer","description":"Live (non-suppressed) rows."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},"required":["id","name","kind","status","row_count","created_at","updated_at"]}},"required":["ok"]}}}},"404":{"description":"No such list in this workspace."}}},"patch":{"summary":"Rename, describe or change the status of a list","tags":["lists"],"operationId":"lists_update","description":"Requires the `lists:write` scope.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"},"description":"The list id."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"name":{"type":"string","maxLength":200},"status":{"type":"string","enum":["building","ready","archived"]},"description":{"type":"string"}}}}}},"responses":{"200":{"description":"The updated list.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"list":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"name":{"type":"string"},"kind":{"type":"string","enum":["companies","people","mixed"]},"status":{"type":"string","enum":["building","ready","archived"]},"row_count":{"type":"integer","description":"Live (non-suppressed) rows."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},"required":["id","name","kind","status","row_count","created_at","updated_at"]}},"required":["ok"]}}}}}},"delete":{"summary":"Archive a list","tags":["lists"],"operationId":"lists_archive","description":"Requires the `lists:write` scope. Archives rather than deletes: rows and exports stay attributable.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"},"description":"The list id."}],"responses":{"200":{"description":"Archived."}}}},"/api/v1/lists/{id}/rows":{"get":{"summary":"Read rows of a list","tags":["lists"],"operationId":"lists_rows","description":"Requires the `lists:read` scope. Rows carry the company or person fields, fit score, email status, signals and provenance by capability.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"},"description":"The list id."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":1000,"default":100},"description":"Page size."},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0},"description":"Page start."},{"name":"filters","in":"query","required":false,"schema":{"type":"string"},"description":"A JSON-encoded filter object: [\"entity\",\"email_status\",\"min_fit\",\"has_email\",\"has_phone\",\"has_linkedin\",\"tags\",\"domains\",\"signal_types\",\"suppressed\",\"search\"]."}],"responses":{"200":{"description":"A page of rows.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"rows":{"type":"array","items":{"type":"object"}},"total":{"type":"integer","description":"Rows matching the filters."},"next_offset":{"type":["integer","null"],"description":"Pass as offset for the next page; null on the last page."}},"required":["ok"]}}}}}},"post":{"summary":"Add rows to a list","tags":["lists"],"operationId":"lists_add_rows","description":"Requires the `lists:write` scope. Rows are normalized and deduped on their strongest identity. on_conflict:\"merge\" (default) folds new fields into an existing row; \"skip\" leaves the existing row untouched.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"},"description":"The list id."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"rows":{"type":"array","items":{"type":"object","description":"A row as a caller hands it in. Rows dedupe on their strongest identity (email or LinkedIn for people, domain or LinkedIn for companies).","properties":{"entity":{"type":"string","enum":["company","person"]},"company":{"type":"object","description":"domain, name, industry, employees, employee_range, hq, linkedin_url, website, technologies, funding, tags."},"person":{"type":"object","description":"first_name, last_name, full_name, title, seniority, department, email, email_status, phone, linkedin_url, location, company_domain, company_name."},"signals":{"type":"array","items":{"type":"object"},"description":"{ type, summary, at?, score?, ref?, source? }"},"fit_score":{"type":"number","minimum":0,"maximum":100},"fit_reasons":{"type":"object"},"tags":{"type":"array","items":{"type":"string"}}},"required":["entity"]},"minItems":1},"on_conflict":{"type":"string","enum":["merge","skip"],"default":"merge"}},"required":["rows"]}}}},"responses":{"200":{"description":"What happened to each row, and the new live count.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"received":{"type":"integer"},"inserted":{"type":"integer"},"merged":{"type":"integer"},"skipped_invalid":{"type":"integer"},"row_count":{"type":"integer"}},"required":["ok"]}}}}}}},"/api/v1/lists/{id}/export":{"post":{"summary":"Export a list as a signed download link","tags":["lists"],"operationId":"lists_export","description":"Requires the `lists:read` scope. csv is the plain file; crm_hubspot and crm_generic are CRM-import shapes; outreach is an upload for sequencing tools.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"},"description":"The list id."}],"requestBody":{"required":false,"content":{"application/json":{"schema":{"type":"object","properties":{"format":{"type":"string","enum":["csv","crm_hubspot","crm_generic","outreach"],"default":"csv"},"filters":{"type":"object","description":"Row filters; every key is optional and they AND together.","properties":{"entity":{"type":"string","enum":["company","person"]},"email_status":{"type":"array","items":{"type":"string","enum":["unknown","verified","risky","invalid","catch_all"]}},"min_fit":{"type":"number","minimum":0,"maximum":100,"description":"Keep rows scoring at least this."},"has_email":{"type":"boolean"},"has_phone":{"type":"boolean"},"has_linkedin":{"type":"boolean"},"tags":{"type":"array","items":{"type":"string"},"description":"Rows carrying ALL of these tags."},"domains":{"type":"array","items":{"type":"string"},"description":"Company domains; people rows match on company_domain."},"signal_types":{"type":"array","items":{"type":"string"},"description":"Rows carrying at least one signal of ANY of these types."},"suppressed":{"type":"boolean","description":"Omitted = live rows only; true = suppressed only."},"search":{"type":"string","maxLength":120,"description":"Case-insensitive substring over name, domain and title."}}},"columns":{"type":"array","items":{"type":"string"},"description":"Only these columns, in this order. Omit for every column."}}}}}},"responses":{"200":{"description":"The artifact.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"url":{"type":"string","format":"uri","description":"Signed download link."},"artifact_id":{"type":"string"},"rows":{"type":"integer"},"expires_at":{"type":"string","format":"date-time"}},"required":["ok"]}}}}}}},"/api/v1/lists/{id}/push":{"post":{"summary":"Push a list into a CRM, an ad audience, a sheet or a connected tool","tags":["lists"],"operationId":"lists_push","description":"Requires the `lists:write` scope. Writes that reach the outside world are approval-gated: when a human has to decide, the response carries queued_for_approval and an approval_id, and the approval.decided event reports the outcome. Honors `Idempotency-Key`. destination:\"audience\" stages an audience on a connected ad account and follows the audience.* events.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"},"description":"The list id."},{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":200},"description":"A unique key per logical request; retries replay the first result instead of re-running."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"destination":{"type":"string","enum":["crm_hubspot","audience","sheet","connected"]},"filters":{"type":"object","description":"Row filters; every key is optional and they AND together.","properties":{"entity":{"type":"string","enum":["company","person"]},"email_status":{"type":"array","items":{"type":"string","enum":["unknown","verified","risky","invalid","catch_all"]}},"min_fit":{"type":"number","minimum":0,"maximum":100,"description":"Keep rows scoring at least this."},"has_email":{"type":"boolean"},"has_phone":{"type":"boolean"},"has_linkedin":{"type":"boolean"},"tags":{"type":"array","items":{"type":"string"},"description":"Rows carrying ALL of these tags."},"domains":{"type":"array","items":{"type":"string"},"description":"Company domains; people rows match on company_domain."},"signal_types":{"type":"array","items":{"type":"string"},"description":"Rows carrying at least one signal of ANY of these types."},"suppressed":{"type":"boolean","description":"Omitted = live rows only; true = suppressed only."},"search":{"type":"string","maxLength":120,"description":"Case-insensitive substring over name, domain and title."}}}},"required":["destination"],"additionalProperties":{"description":"Destination-specific options (for example the platform and account for an audience, or the toolkit and action for a connected tool)."}}}}},"responses":{"200":{"description":"Either the delivery result or the approval hand-off.","content":{"application/json":{"schema":{"oneOf":[{"type":"object","properties":{"ok":{"type":"boolean"},"result":{}},"required":["ok"]},{"type":"object","properties":{"ok":{"type":"boolean"},"queued_for_approval":{"type":"boolean","const":true},"approval_id":{"type":"string"}},"required":["ok"]}]}}}},"409":{"description":"The destination needs a connected account."}}}},"/api/v1/audiences":{"get":{"summary":"The workspace audiences","tags":["audiences"],"operationId":"audiences_list","description":"Requires the `audiences:read` scope. Statuses: staged, denied, approved, pushed, processing, ready, failed, exported.","responses":{"200":{"description":"Every audience.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"audiences":{"type":"array","items":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"name":{"type":"string"},"platform":{"type":"string","enum":["linkedin","meta","reddit","google","tiktok","x","pinterest"]},"delivery":{"type":"string","enum":["api","csv"],"description":"api = pushed to the connected account; csv = a platform-formatted file."},"audience_kind":{"type":"string","enum":["contacts","companies"]},"status":{"type":"string","enum":["staged","denied","approved","pushed","processing","ready","failed","exported"]},"list_id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}}}},"required":["ok"]}}}}}}},"/api/v1/audiences/accounts":{"get":{"summary":"Connected ad accounts an audience can be pushed to","tags":["audiences"],"operationId":"audiences_accounts","description":"Requires the `audiences:read` scope. delivery says how each account takes an audience: api (pushed directly) or csv (a platform-formatted file to upload).","responses":{"200":{"description":"The accounts.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"accounts":{"type":"array","items":{"type":"object","properties":{"platform":{"type":"string"},"account_ref":{"type":"string","description":"The platform-side account id."},"name":{"type":"string"},"delivery":{"type":"string","enum":["api","csv"]}},"required":["platform","account_ref","delivery"]}}},"required":["ok"]}}}}}}},"/api/v1/audiences/{id}":{"get":{"summary":"One audience with its match status","tags":["audiences"],"operationId":"audiences_get","description":"Requires the `audiences:read` scope.","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"},"description":"The audience id."}],"responses":{"200":{"description":"The audience.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"audience":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"name":{"type":"string"},"platform":{"type":"string","enum":["linkedin","meta","reddit","google","tiktok","x","pinterest"]},"delivery":{"type":"string","enum":["api","csv"],"description":"api = pushed to the connected account; csv = a platform-formatted file."},"audience_kind":{"type":"string","enum":["contacts","companies"]},"status":{"type":"string","enum":["staged","denied","approved","pushed","processing","ready","failed","exported"]},"list_id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}}},"required":["ok"]}}}},"404":{"description":"No such audience in this workspace."}}}},"/api/v1/ads/accounts":{"get":{"summary":"Alias of /api/v1/audiences/accounts","tags":["audiences"],"operationId":"ads_accounts_alias","deprecated":true,"description":"Requires the `audiences:read` scope. The pre-rescope path; it stays as an alias and the old `ads:read` scope is still accepted. New clients should call /api/v1/audiences/accounts.","responses":{"200":{"description":"The accounts.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"accounts":{"type":"array","items":{"type":"object","properties":{"platform":{"type":"string"},"account_ref":{"type":"string","description":"The platform-side account id."},"name":{"type":"string"},"delivery":{"type":"string","enum":["api","csv"]}},"required":["platform","account_ref","delivery"]}}},"required":["ok"]}}}}}}},"/api/v1/watches":{"get":{"summary":"Standing signal watches","tags":["signals"],"operationId":"watches_list","description":"Requires the `signals:read` scope. One watch per company domain: which signal kinds to look for, and optionally the list whose rows detections attach to.","responses":{"200":{"description":"The watches.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"watches":{"type":"array","items":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"domain":{"type":"string"},"kinds":{"type":"array","items":{"type":"string"},"description":"Signal kinds watched, e.g. hiring, funding, news, tech_adopted, tech_dropped."},"list_id":{"type":["integer","string"],"description":"The list whose rows detections attach to, when set."},"active":{"type":"boolean"},"last_polled_at":{"type":["string","null"],"format":"date-time"},"last_event_at":{"type":["string","null"],"format":"date-time"},"created_at":{"type":"string","format":"date-time"}}}}},"required":["ok"]}}}}}},"post":{"summary":"Watch company domains for signals","tags":["signals"],"operationId":"watches_add","description":"Requires the `signals:write` scope. Idempotent per domain: watching a domain again updates its kinds and list. Detections arrive as signal.detected webhooks and on GET /api/v1/signals.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"domains":{"type":"array","items":{"type":"string"},"minItems":1,"description":"Bare registrable domains; URLs are normalized."},"kinds":{"type":"array","items":{"type":"string"},"description":"Defaults to hiring, funding, news, tech_adopted, tech_dropped."},"list_id":{"type":["integer","string"],"description":"Attach detections to the rows of this list."}},"required":["domains"]}}}},"responses":{"200":{"description":"The watches created or updated.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"watches":{"type":"array","items":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"domain":{"type":"string"},"kinds":{"type":"array","items":{"type":"string"},"description":"Signal kinds watched, e.g. hiring, funding, news, tech_adopted, tech_dropped."},"list_id":{"type":["integer","string"],"description":"The list whose rows detections attach to, when set."},"active":{"type":"boolean"},"last_polled_at":{"type":["string","null"],"format":"date-time"},"last_event_at":{"type":["string","null"],"format":"date-time"},"created_at":{"type":"string","format":"date-time"}}}}},"required":["ok"]}}}}}},"delete":{"summary":"Stop watching company domains","tags":["signals"],"operationId":"watches_remove","description":"Requires the `signals:write` scope.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"domains":{"type":"array","items":{"type":"string"},"minItems":1}},"required":["domains"]}}}},"responses":{"200":{"description":"Removed."}}}},"/api/v1/signals":{"get":{"summary":"The signal feed","tags":["signals"],"operationId":"signals_list","description":"Requires the `signals:read` scope. Detections from every watch, newest first, deduped per job post, funding round or article.","parameters":[{"name":"list_id","in":"query","required":false,"schema":{"type":"string"},"description":"Only signals attached to this list."},{"name":"domains","in":"query","required":false,"schema":{"type":"string"},"description":"Comma-separated company domains."},{"name":"kinds","in":"query","required":false,"schema":{"type":"string"},"description":"Comma-separated signal kinds."},{"name":"since","in":"query","required":false,"schema":{"type":"string","format":"date-time"},"description":"Only signals detected at or after this time."},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":500,"default":50},"description":"Page size."}],"responses":{"200":{"description":"The events.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"events":{"type":"array","items":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"domain":{"type":"string"},"type":{"type":"string","description":"The signal kind: hiring, funding, news, tech_adopted, tech_dropped, intent, growth, leadership_change, launch, partnership, expansion, filing."},"summary":{"type":"string","description":"One line, written without naming any data source."},"payload":{"type":"object","description":"The customer-safe detail behind the summary."},"watch_id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"at":{"type":"string","format":"date-time"}}}}},"required":["ok"]}}}}}}},"/api/v1/webhooks":{"get":{"summary":"List webhook endpoints","tags":["webhooks"],"description":"Requires the `webhooks:read` scope.","responses":{"200":{"description":"Endpoints (no secrets)."}}},"post":{"summary":"Register a webhook endpoint","tags":["webhooks"],"description":"Requires the `webhooks:write` scope. Returns the HMAC signing secret exactly once. Filters accept \"*\", a family (agent.*, approval.*, list.*, audience.*, signal.*, ads.*, webhook.*) or exact names from the event catalog; unknown names are refused with 400.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"url":{"type":"string","format":"uri"},"events":{"type":"array","items":{"type":"string"},"description":"\"*\", \"family.*\", or exact names. Live events: agent.run.finished, approval.decided, list.ready, list.updated, audience.staged, audience.exported, audience.pushed, audience.ready, audience.failed, signal.detected, ads.conversions.streamed, webhook.test."}},"required":["url"]}}}},"responses":{"201":{"description":"{ id, secret } - store the secret now."},"400":{"description":"Bad url or unknown event filters (`unknown` lists them)."}}},"delete":{"summary":"Deactivate a webhook endpoint","tags":["webhooks"],"description":"Requires the `webhooks:write` scope.","reques