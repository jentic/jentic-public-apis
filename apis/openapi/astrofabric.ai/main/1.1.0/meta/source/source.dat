{"openapi":"3.1.0","info":{"title":"AstroFabric API","version":"1.1.0","description":"Deploy autonomous AI agents to discover, verify, enrich and stream high-fidelity company, person and market intelligence into your existing systems. Authenticate every call with an API key: `Authorization: Bearer ek_live_...`. Webhook deliveries are HMAC-signed and retried with backoff (at-least-once). Renamed tools, agents and scopes keep working under their old names; retired names answer 410 and are listed under `x-deprecations`."},"servers":[{"url":"https://www.astrofabric.ai"}],"security":[{"bearerAuth":[]}],"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"An API key from the console (ek_live_...)."}},"schemas":{"List":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"name":{"type":"string"},"kind":{"type":"string","enum":["companies","people","mixed"]},"status":{"type":"string","enum":["building","ready","archived"]},"row_count":{"type":"integer","description":"Live (non-suppressed) rows."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}},"required":["id","name","kind","status","row_count","created_at","updated_at"]},"ListRowInput":{"type":"object","description":"A row as a caller hands it in. Rows dedupe on their strongest identity (email or LinkedIn for people, domain or LinkedIn for companies).","properties":{"entity":{"type":"string","enum":["company","person"]},"company":{"type":"object","description":"domain, name, industry, employees, employee_range, hq, linkedin_url, website, technologies, funding, tags."},"person":{"type":"object","description":"first_name, last_name, full_name, title, seniority, department, email, email_status, phone, linkedin_url, location, company_domain, company_name."},"signals":{"type":"array","items":{"type":"object"},"description":"{ type, summary, at?, score?, ref?, source? }"},"fit_score":{"type":"number","minimum":0,"maximum":100},"fit_reasons":{"type":"object"},"tags":{"type":"array","items":{"type":"string"}}},"required":["entity"]},"RowFilters":{"type":"object","description":"Row filters; every key is optional and they AND together.","properties":{"entity":{"type":"string","enum":["company","person"]},"email_status":{"type":"array","items":{"type":"string","enum":["unknown","verified","risky","invalid","catch_all"]}},"min_fit":{"type":"number","minimum":0,"maximum":100,"description":"Keep rows scoring at least this."},"has_email":{"type":"boolean"},"has_phone":{"type":"boolean"},"has_linkedin":{"type":"boolean"},"tags":{"type":"array","items":{"type":"string"},"description":"Rows carrying ALL of these tags."},"domains":{"type":"array","items":{"type":"string"},"description":"Company domains; people rows match on company_domain."},"signal_types":{"type":"array","items":{"type":"string"},"description":"Rows carrying at least one signal of ANY of these types."},"suppressed":{"type":"boolean","description":"Omitted = live rows only; true = suppressed only."},"search":{"type":"string","maxLength":120,"description":"Case-insensitive substring over name, domain and title."}}},"Audience":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"name":{"type":"string"},"platform":{"type":"string","enum":["linkedin","meta","reddit","google","tiktok","x","pinterest"]},"delivery":{"type":"string","enum":["api","csv"],"description":"api = pushed to the connected account; csv = a platform-formatted file."},"audience_kind":{"type":"string","enum":["contacts","companies"]},"status":{"type":"string","enum":["staged","denied","approved","pushed","processing","ready","failed","exported"]},"list_id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}},"AdAccount":{"type":"object","properties":{"platform":{"type":"string"},"account_ref":{"type":"string","description":"The platform-side account id."},"name":{"type":"string"},"delivery":{"type":"string","enum":["api","csv"]}},"required":["platform","account_ref","delivery"]},"Watch":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"domain":{"type":"string"},"kinds":{"type":"array","items":{"type":"string"},"description":"Signal kinds watched, e.g. hiring, funding, news, tech_adopted, tech_dropped."},"list_id":{"type":["integer","string"],"description":"The list whose rows detections attach to, when set."},"active":{"type":"boolean"},"last_polled_at":{"type":["string","null"],"format":"date-time"},"last_event_at":{"type":["string","null"],"format":"date-time"},"created_at":{"type":"string","format":"date-time"}}},"SignalEvent":{"type":"object","properties":{"id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"domain":{"type":"string"},"type":{"type":"string","description":"The signal kind: hiring, funding, news, tech_adopted, tech_dropped, intent, growth, leadership_change, launch, partnership, expansion, filing."},"summary":{"type":"string","description":"One line, written without naming any data source."},"payload":{"type":"object","description":"The customer-safe detail behind the summary."},"watch_id":{"type":["integer","string"],"description":"Opaque id; numeric today."},"at":{"type":"string","format":"date-time"}}},"WebhookEvent":{"type":"object","description":"The wire body of every webhook delivery. Signed: X-AF-Signature is sha256=hex(hmac(secret, `${X-AF-Timestamp}.${rawBody}`)).","properties":{"type":{"type":"string","enum":["agent.run.finished","approval.decided","list.ready","list.updated","audience.staged","audience.exported","audience.pushed","audience.ready","audience.failed","signal.detected","ads.conversions.streamed","webhook.test"]},"data":{"type":"object"},"at":{"type":"string","format":"date-time","description":"Stamped once at fanout; retries deliver an identical payload, so dedupe on type + at."}},"required":["type","data","at"]}}},"tags":[{"name":"agents","description":"Registered agents and the mission orchestrator"},{"name":"tools","description":"The governed data and execution catalog"},{"name":"lists","description":"Persistent lists: rows, exports and pushes"},{"name":"audiences","description":"Ad audiences and the connected accounts they push to"},{"name":"signals","description":"Standing signal watches and the signal feed"},{"name":"runs","description":"Run observability and control"},{"name":"threads","description":"Mission memory"},{"name":"webhooks","description":"Signed event deliveries"},{"name":"workspace","description":"Identity and credit balance"}],"paths":{"/api/v1/tools":{"get":{"summary":"List every callable tool","tags":["tools"],"description":"Requires the `tools:list` scope.","responses":{"200":{"description":"The tool catalog with names, descriptions, scopes and input schemas."}}}},"/api/v1/tools/web_search":{"post":{"summary":"Live Google organic results for one query: top-ranked pages with position, title, URL and snippet, plus People Also Ask questions and relate","tags":["tools"],"operationId":"tool_web_search","description":"Requires the `tools:web_search` scope.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":200},"description":"A unique key per logical request; retries replay the first result instead of re-running."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"keyword":{"type":"string","minLength":1,"maxLength":700,"description":"The search query"},"location":{"description":"Location name, e.g. \"United Kingdom\"","type":"string","maxLength":100},"depth":{"description":"How many results to read (10-30)","type":"integer","minimum":10,"maximum":30}},"required":["keyword"]}}}},"responses":{"200":{"description":"The tool result, inside the { ok, tool, result } envelope."},"400":{"description":"Input failed the schema; `issues` says what to fix."},"402":{"description":"The workspace credits are spent."},"403":{"description":"The API key lacks the required scope."},"409":{"description":"The tool needs a connected account (`code: \"not_connected\"`, `toolkit`)."},"422":{"description":"The tool ran but could not produce a result."}}}},"/api/v1/tools/domain_competitors":{"post":{"summary":"The domains competing for the same Google organic keywords as a target domain, ranked by keyword overlap, with average position and estimate","tags":["tools"],"operationId":"tool_domain_competitors","description":"Requires the `tools:domain_competitors` scope.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":200},"description":"A unique key per logical request; retries replay the first result instead of re-running."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"domain":{"type":"string","minLength":4,"maxLength":253,"description":"Bare domain, e.g. example.com"},"limit":{"type":"integer","minimum":5,"maximum":30}},"required":["domain"]}}}},"responses":{"200":{"description":"The tool result, inside the { ok, tool, result } envelope."},"400":{"description":"Input failed the schema; `issues` says what to fix."},"402":{"description":"The workspace credits are spent."},"403":{"description":"The API key lacks the required scope."},"409":{"description":"The tool needs a connected account (`code: \"not_connected\"`, `toolkit`)."},"422":{"description":"The tool ran but could not produce a result."}}}},"/api/v1/tools/web_footprint":{"post":{"summary":"A domain's web footprint as a sizing signal: estimated organic traffic value and ranked-keyword counts for up to 25 domains in one call, plu","tags":["tools"],"operationId":"tool_web_footprint","description":"Requires the `tools:web_footprint` scope.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":200},"description":"A unique key per logical request; retries replay the first result instead of re-running."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"domains":{"minItems":1,"maxItems":25,"type":"array","items":{"type":"string","minLength":4,"maxLength":253},"description":"Bare domains, e.g. [\"example.com\"]"}},"required":["domains"]}}}},"responses":{"200":{"description":"The tool result, inside the { ok, tool, result } envelope."},"400":{"description":"Input failed the schema; `issues` says what to fix."},"402":{"description":"The workspace credits are spent."},"403":{"description":"The API key lacks the required scope."},"409":{"description":"The tool needs a connected account (`code: \"not_connected\"`, `toolkit`)."},"422":{"description":"The tool ran but could not produce a result."}}}},"/api/v1/tools/company_lookup":{"post":{"summary":"Look up to 10 companies up by exact domain: name, description, industry, size, headquarters, founding year, funding (total raised, last stag","tags":["tools"],"operationId":"tool_company_lookup","description":"Requires the `tools:company_lookup` scope.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":200},"description":"A unique key per logical request; retries replay the first result instead of re-running."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"domains":{"minItems":1,"maxItems":10,"type":"array","items":{"type":"string","minLength":4,"maxLength":253,"description":"Bare company domain, e.g. example.com"}},"fields":{"description":"Which field groups to fill (default: identity + firmographics + funding)","minItems":1,"maxItems":4,"type":"array","items":{"type":"string","enum":["identity","firmographics","funding","technographics_summary"]}}},"required":["domains"]}}}},"responses":{"200":{"description":"The tool result, inside the { ok, tool, result } envelope."},"400":{"description":"Input failed the schema; `issues` says what to fix."},"402":{"description":"The workspace credits are spent."},"403":{"description":"The API key lacks the required scope."},"409":{"description":"The tool needs a connected account (`code: \"not_connected\"`, `toolkit`)."},"422":{"description":"The tool ran but could not produce a result."}}}},"/api/v1/tools/company_to_domain":{"post":{"summary":"Resolve company names to their website domains, up to 50 per call: the first step of enriching a CSV or CRM segment that only carries names.","tags":["tools"],"operationId":"tool_company_to_domain","description":"Requires the `tools:company_to_domain` scope.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":200},"description":"A unique key per logical request; retries replay the first result instead of re-running."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"names":{"minItems":1,"maxItems":50,"type":"array","items":{"type":"string","minLength":2,"maxLength":160}},"country":{"description":"ISO-2 country hint used to break ties","type":"string","minLength":2,"maxLength":2}},"required":["names"]}}}},"responses":{"200":{"description":"The tool result, inside the { ok, tool, result } envelope."},"400":{"description":"Input failed the schema; `issues` says what to fix."},"402":{"description":"The workspace credits are spent."},"403":{"description":"The API key lacks the required scope."},"409":{"description":"The tool needs a connected account (`code: \"not_connected\"`, `toolkit`)."},"422":{"description":"The tool ran but could not produce a result."}}}},"/api/v1/tools/discover_companies":{"post":{"summary":"Find companies that match criteria: industries, keywords, employee ranges, countries, technologies (any or all), funding stage or amount, wh","tags":["tools"],"operationId":"tool_discover_companies","description":"Requires the `tools:discover_companies` scope.","parameters":[{"name":"Idempotency-Key","in":"header","required":false,"schema":{"type":"string","maxLength":200},"description":"A unique key per logical request; retries replay the first result instead of re-running."}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","properties":{"industries":{"maxItems":25,"type":"array","items":{"type":"string","minLength":2,"maxLength":80}},"keywords":{"description":"Words that should appear in the company description","maxItems":25,"type":"array","items":{"type":"string","minLength":2,"maxLength":80}},"employee_ranges":{"maxItems":8,"type":"array","items":{"type":"string","enum":["1-10","11-50","51-200","201-500","501-1000","1001-5000","5001-10000","10001+"]}},"countries":{"description":"ISO-2 codes","maxItems":25,"type":"array","items":{"type":"string","minLength":2,"maxLength":2}},"technologies":{"maxItems":10,"type":"array","items":{"type":"string","minLength":2,"maxLength":60}},"technology_match":{"type":"string","enum":["any","all"]},"exclude_technologies":{"maxItems":10,"type":"array","items":{"type":"string","minLength":2,"maxLength":60}},"funding_stages":{"description":"e.g. [\"Series A\",\"Series B\"]","maxItems":10,"type":"array","items":{"type":"string","minLength":2,"maxLength":40}},"min_funding_usd":{"type":"number","minimum":0},"max_funding_usd":{"type":"number","minimum":0},"hiring":{"type":"object","properties":{"titles":{"maxItems":10,"type":"array","items":{"type":"st