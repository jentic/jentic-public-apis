{
  "openapi": "3.0.3",
  "info": {
    "title": "Reveula API",
    "description": "API-token endpoints for brands, collection forms, and testimonial invitations.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.reveula.com/openapi.json"
  },
  "servers": [
    {
      "url": "https://api.reveula.com",
      "description": "Reveula API"
    }
  ],
  "paths": {
    "/v1/brands": {
      "get": {
        "operationId": "listBrands",
        "description": "Returns the brands available to the authenticated API token.",
        "summary": "List brands",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "items": {
                        "properties": {
                          "handle": {
                            "type": "string"
                          },
                          "id": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "role": {
                            "type": "string"
                          },
                          "category": {
                            "nullable": true,
                            "type": "string"
                          },
                          "roleId": {
                            "type": "string"
                          },
                          "ownerId": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "website": {
                            "type": "string"
                          },
                          "logo": {
                            "nullable": true,
                            "type": "string"
                          }
                        },
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "website",
                          "handle",
                          "logo",
                          "category",
                          "ownerId",
                          "role",
                          "roleId",
                          "createdAt",
                          "updatedAt"
                        ]
                      },
                      "type": "array"
                    },
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "type": "object",
                  "required": [
                    "success",
                    "status",
                    "message",
                    "data"
                  ]
                },
                "example": {
                  "status": 200,
                  "message": "Brands retrieved.",
                  "data": [
                    {
                      "handle": "acme",
                      "id": "brand_demo_001",
                      "createdAt": "2025-01-15T10:30:00.000Z",
                      "role": "owner",
                      "category": "Software",
                      "roleId": "role_demo_owner",
                      "ownerId": "user_demo_001",
                      "name": "Acme",
                      "updatedAt": "2025-02-01T08:15:00.000Z",
                      "website": "acme.test",
                      "logo": null
                    }
                  ],
                  "success": true
                }
              }
            },
            "description": "Brands retrieved."
          }
        }
      }
    },
    "/v1/brands/forms": {
      "get": {
        "operationId": "listForms",
        "description": "Returns the collection forms for the brand.",
        "summary": "List forms",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "items": {
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "slug": {
                            "type": "string"
                          },
                          "publicUrl": {
                            "type": "string",
                            "format": "uri"
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "title": {
                            "type": "string"
                          },
                          "brand": {
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "website": {
                                "type": "string"
                              },
                              "logo": {
                                "nullable": true,
                                "type": "string"
                              },
                              "category": {
                                "nullable": true,
                                "type": "string"
                              },
                              "handle": {
                                "type": "string"
                              }
                            },
                            "type": "object",
                            "required": [
                              "id",
                              "name",
                              "website",
                              "handle",
                              "logo",
                              "category"
                            ]
                          }
                        },
                        "type": "object",
                        "required": [
                          "id",
                          "title",
                          "slug",
                          "publicUrl",
                          "brand",
                          "createdAt",
                          "updatedAt"
                        ]
                      },
                      "type": "array"
                    },
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "type": "object",
                  "required": [
                    "success",
                    "status",
                    "message",
                    "data"
                  ]
                },
                "example": {
                  "status": 200,
                  "message": "Forms retrieved.",
                  "data": [
                    {
                      "id": "form_demo_001",
                      "slug": "customer-feedback",
                      "publicUrl": "https://reveula.com/@acme/customer-feedback",
                      "createdAt": "2025-01-20T14:00:00.000Z",
                      "updatedAt": "2025-02-02T09:45:00.000Z",
                      "title": "Customer feedback",
                      "brand": {
                        "id": "brand_demo_001",
                        "name": "Acme",
                        "website": "acme.test",
                        "logo": null,
                        "category": "Software",
                        "handle": "acme"
                      }
                    }
                  ],
                  "success": true
                }
              }
            },
            "description": "Forms retrieved."
          }
        }
      }
    },
    "/v1/brands/forms/{formId}/invites": {
      "post": {
        "description": "Sends testimonial collection invitations to the supplied recipients.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "type": "integer",
                      "enum": [
                        200
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "properties": {
                        "skippedFormPaused": {
                          "type": "integer"
                        },
                        "skippedInFlight": {
                          "type": "integer"
                        },
                        "skippedUndelivered": {
                          "type": "integer"
                        },
                        "sent": {
                          "type": "integer"
                        },
                        "skippedDeclined": {
                          "type": "integer"
                        },
                        "skippedUnsubscribed": {
                          "type": "integer"
                        },
                        "skippedRecentlyCollected": {
                          "type": "integer"
                        }
                      },
                      "type": "object",
                      "required": [
                        "sent",
                        "skippedUnsubscribed",
                        "skippedUndelivered",
                        "skippedRecentlyCollected",
                        "skippedDeclined",
                        "skippedInFlight",
                        "skippedFormPaused"
                      ]
                    },
                    "success": {
                      "type": "boolean"
                    }
                  },
                  "type": "object",
                  "required": [
                    "success",
                    "status",
                    "message",
                    "data"
                  ]
                },
                "example": {
                  "status": 200,
                  "message": "Invite sent.",
                  "data": {
                    "skippedFormPaused": 0,
                    "skippedInFlight": 0,
                    "skippedUndelivered": 0,
                    "sent": 1,
                    "skippedDeclined": 0,
                    "skippedUnsubscribed": 0,
                    "skippedRecentlyCollected": 0
                  },
                  "success": true
                }
              }
            },
            "description": "Invite sent."
          }
        },
        "summary": "Send form invitations",
        "operationId": "triggerFormInvites",
        "parameters": [
          {
            "description": "Identifier of the collection form.",
            "name": "formId",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "recipients": {
                    "items": {
                      "properties": {
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "type": "object",
                      "required": [
                        "name",
                        "email"
                      ]
                    },
                    "type": "array"
                  }
                },
                "type": "object",
                "required": [
                  "recipients"
                ]
              },
              "example": {
                "recipients": [
                  {
                    "email": "ada@company.test",
                    "name": "Ada Lovelace"
                  }
                ]
              }
            }
          },
          "required": true
        }
      }
    }
  },
