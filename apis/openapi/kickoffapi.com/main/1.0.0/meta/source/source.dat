          $ref: '#/components/responses/Success'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /fixtures/lineups:
    get:
      summary: Lineups
      operationId: getFixturesLineups
      tags: [football]
      parameters:
        - name: fixture
          in: query
          required: true
          schema:
            type: string
        - name: team
          in: query
          required: false
          schema:
            type: string
        - name: player
          in: query
          required: false
          schema:
            type: string
        - name: type
          in: query
          required: false
          schema:
            type: string
      responses:
        '200':
          $ref: '#/components/responses/Success'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /fixtures/players:
    get:
      summary: Players statistics
      operationId: getFixturesPlayers
      tags: [football]
      parameters:
        - name: fixture
          in: query
          required: true
          schema:
            type: string
        - name: team
          in: query
          required: false
          schema:
            type: string
      responses:
        '200':
          $ref: '#/components/responses/Success'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /fixtures/{id}/events:
    get:
      summary: >
        Fixture events by fixture id. Distinct from `/fixtures/events`, which
        takes the fixture in a `fixture` query parameter and is the same data —
        this is the same endpoint addressed by path, for a client whose SDK
        builds URLs that way.
      operationId: getFixtureEventsById
      tags: [football]
      parameters:
        - name: id
          in: path
          required: true
          description: The fixture id.
          schema:
            type: integer
        - name: refresh
          in: query
          required: false
          description: Set to 1 to force a fresh upstream read instead of the cache.
          schema:
            type: string
      responses:
        '200':
          $ref: '#/components/responses/Success'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /fixtures/{id}/lineups:
    get:
      summary: Fixture lineups by fixture id.
      operationId: getFixtureLineupsById
      tags: [football]
      parameters:
        - name: id
          in: path
          required: true
          description: The fixture id.
          schema:
            type: integer
        - name: refresh
          in: query
          required: false
          schema:
            type: string
      responses:
        '200':
          $ref: '#/components/responses/Success'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /fixtures/{id}/statistics:
    get:
      summary: Fixture team statistics by fixture id.
      operationId: getFixtureStatisticsById
      tags: [football]
      parameters:
        - name: id
          in: path
          required: true
          description: The fixture id.
          schema:
            type: integer
        - name: refresh
          in: query
          required: false
          schema:
            type: string
      responses:
        '200':
          $ref: '#/components/responses/Success'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /fixtures/{id}/players:
    get:
      summary: >
        Fixture player statistics by fixture id. `/fixtures/players?fixture=…`
        is the same data reached with the fixture in a query parameter.
      operationId: getFixturePlayersById
      tags: [football]
      parameters:
        - name: id
          in: path
          required: true
          description: The fixture id.
          schema:
            type: integer
        - name: team
          in: query
          required: false
          description: Restrict to one side of the fixture.
          schema:
            type: integer
        - name: refresh
          in: query
          required: false
          schema:
            type: string
      responses:
        '200':
          $ref: '#/components/responses/Success'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '404':
          $ref: '#/components/responses/NotFound'
        '429':
          $ref: '#/components/responses/RateLimited'
  /status:
    get:
      summary: >
        This key's plan and today's usage — the endpoint a v1 client library
        calls to render a quota meter. No parameters: it is always about the key
        you authenticated with.
      operationId: getStatus
      tags: [account]
      responses:
        '200':
          description: >
            The v1 envelope, with the account, the subscription and today's
            request count in `response`. `requests.limit_day` is `null` for an
            internal key, which has no daily ceiling — JSON has no Infinity, and
            `0` would read as "no quota left".
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Envelope' }
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /account/status:
    get:
      summary: >
        Today's and this month's usage against the plan's daily and monthly
        ceilings. Read the same numbers as `/status`, in a flatter body.
      operationId: getAccountStatus
      tags: [account]
      responses:
        '200':
          description: >
            NOT enveloped — this one operation answers a bare object with
            `plan`, `dailyUsage`, `monthlyUsage` and `resetTime`, because it was
            built to match the account-quota body v1 clients already read. Every
            other v1 endpoint wraps its payload in `{ get, results, response }`;
            do not assume the envelope here.
          content:
            application/json:
              schema:
                type: object
                properties:
                  plan: { type: string, description: 'FREE, PRO or INTERNAL' }
                  unlimited: { type: boolean, description: True only for an internal key }
                  dailyUsage:
                    type: object
                    properties:
                      used: { type: integer }
                      limit: { type: integer, nullable: true }
                      remaining: { type: integer, nullable: true }
                  monthlyUsage:
                    type: object
                    properties:
                      used: { type: integer }
                      limit: { type: integer, nullable: true }
                  resetTime: { type: string, format: date-time, description: The next UTC midnight }
              example:
                plan: PRO
                unlimited: false
                dailyUsage: { used: 1420, limit: 75000, remaining: 73580 }
                monthlyUsage: { used: 18450, limit: 2250000 }
                resetTime: '2026-10-03T23:59:59.999Z'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /teams/logos:
    get:
      summary: >
        Absolute logo URLs for one or more clubs, keyed by team id. Use it to
        resolve logos for a fixture list in one call instead of reading the
        `logo` field on each row.
      operationId: getTeamLogos
      tags: [football]
      parameters:
        - name: ids
          in: query
          required: true
          description: Comma-separated team ids.
          schema:
            type: string
      responses:
        '200':
          description: >
            The v1 envelope, with an object keyed by team id in `response`. A
            club with no logo on record maps to `null` rather than being absent.
          content:
            application/json:
              schema: { $ref: '#/components/schemas/Envelope' }
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
