        - name: season
          in: query
          required: true
          schema:
            type: string
        - name: current
          in: query
          required: false
          schema:
            type: string
        - name: dates
          in: query
          required: false
          schema:
            type: string
        - name: timezone
          in: query
          required: false
          schema:
            type: string
      responses:
        '200':
          $ref: '#/components/responses/Success'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /fixtures/statistics:
    get:
