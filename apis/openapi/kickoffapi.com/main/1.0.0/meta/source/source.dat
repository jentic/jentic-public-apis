openapi: 3.0.3
info:
  title: KickoffAPI — Football Data API (v1, legacy)
  version: "1.0.0"
  description: >-
    Real-time football (soccer) data API: live scores, fixtures, results, deep player
    and team statistics, lineups, head-to-head, standings, transfers, in-play odds and
    1,245 leagues in 171 countries, delivered as predictable JSON with rate-limit headers on every response.
    Authenticate by sending your key in the x-api-key header.


    ## v1 is legacy

    v1 stays live until its sunset on 01 January 2027 and is frozen. New
    integrations should use v2, which has KickoffAPI's own string identifiers
    and a `{ data, meta }` envelope.


    ## Response format — flat by default, nested on request

    Every `/api/v1` response is wrapped in `{ get, parameters, errors, results,
    paging, response }`. What is inside `response` is the question, and the answer
    is **the flat row by default**: `id`, `date`, `status`, `homeTeam`,
    `homeTeamId`, `goalsHome`, `elapsed` and the rest, all at the top level. That
    is the body every existing integration already parses and it does not change.


    Ask for the nested `{ fixture, league, teams, goals, score }` form — which is
    what a client migrating from another football feed expects — in any of three
    ways:

    * `?format=nested` on the request;
    * `?format=flat` to force the flat row back, from any client, whatever else is
      in the headers;


    `GET /leagues` and `GET /fixtures` and `GET /fixtures/headtohead` are the
    three endpoints that carry the nested shape.


    ## Rate limits

    Per-minute: `X-RateLimit-Limit`, `X-RateLimit-Remaining`, `X-RateLimit-Reset`
    (reset is the next minute boundary). Per plan, per day (UTC):
    `X-RateLimit-Daily-Limit`, `X-RateLimit-Daily-Remaining`,
    `X-RateLimit-Daily-Reset`. Every 429 carries a `Retry-After` header in
    seconds. Plans: Free 100/day (30/min), Starter 7,500/day (120/min), Pro
    75,000/day (300/min), Ultra 250,000/day (600/min), Enterprise on request.
  contact:
    name: KickoffAPI Support
    email: contact@kickoffapi.com
    url: https://kickoffapi.com
servers:
  - url: https://api.kickoffapi.com/api/v1
    description: Production
security:
  - ApiKeyAuth: []
components:
  securitySchemes:
    ApiKeyAuth:
      type: apiKey
      in: header
      name: x-api-key
      description: >
        Your KickoffAPI key.
  schemas:
    Envelope:
      type: object
      properties:
        get:
          type: string
          description: The endpoint that was queried.
        results:
          type: integer
          description: Number of items returned in response.
        response:
          type: array
          description: >
            The result payload — flat rows by default, nested objects when
            `?format=nested` or an alias key header is used.
          items:
            type: object
    Error:
      type: object
      properties:
        error: { type: string }
  responses:
    Success:
      description: Successful response.
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/Envelope'
    BadRequest:
      description: A required parameter is missing or malformed.
      content:
        application/json:
          schema: { $ref: '#/components/schemas/Error' }
          example: { error: 'league must be a positive integer' }
    NotFound:
      description: No such resource for that id.
      content:
        application/json:
          schema: { $ref: '#/components/schemas/Error' }
    Unauthorized:
      description: >
        No API key, or the key is unknown, disabled or revoked. The message names
        the path that wanted a key.
      content:
        application/json:
          schema: { $ref: '#/components/schemas/Error' }
          example: { error: 'Missing x-api-key header for path: /api/v1/fixtures' }
    RateLimited:
      description: >
        Rate limited or out of quota. Read `Retry-After` (seconds) and the `code`
        in the body: `RATE_LIMIT_PER_MINUTE`, `PLAN_LIMIT_REACHED`,
        `NO_ACTIVE_SUBSCRIPTION`, `OVERAGE_CAP_REACHED` or `CREDITS_EXHAUSTED`.
      headers:
        Retry-After:
          description: >
            Seconds to wait before retrying. Present on every 429. It names the
            window that actually refused the request: to the next minute
            boundary on the per-minute wall, to the next UTC midnight on a daily
            one, to the 1st on the monthly one.
          schema: { type: integer }
      content:
        application/json:
          schema: { $ref: '#/components/schemas/Error' }
          example:
            error: 'Rate limit exceeded'
            code: RATE_LIMIT_PER_MINUTE
            limit: 30
            retryAfter: 42
paths:
  /coachs:
    get:
      summary: Coachs
      operationId: getCoachs
      tags: [football]
      parameters:
        - name: id
          in: query
          required: false
          schema:
            type: string
        - name: team
          in: query
          required: false
          schema:
            type: string
        - name: search
          in: query
          required: false
          schema:
            type: string
      responses:
        '200':
          $ref: '#/components/responses/Success'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /countries:
    get:
      summary: Countries
      operationId: getCountries
      tags: [football]
      parameters:
        - name: name
          in: query
          required: false
          schema:
            type: string
        - name: code
          in: query
          required: false
          schema:
            type: string
        - name: search
          in: query
          required: false
          schema:
            type: string
      responses:
        '200':
          $ref: '#/components/responses/Success'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /fixtures:
    get:
      summary: Fixtures
      operationId: getFixtures
      tags: [football]
      parameters:
        - name: id
          in: query
          required: false
          schema:
            type: string
        - name: ids
          in: query
          required: false
          schema:
            type: string
        - name: live
          in: query
          required: false
          schema:
            type: string
        - name: date
          in: query
          required: false
          schema:
            type: string
        - name: league
          in: query
          required: false
          schema:
            type: string
        - name: season
          in: query
          required: false
          schema:
            type: string
        - name: team
          in: query
          required: false
          schema:
            type: string
        - name: last
          in: query
          required: false
          schema:
            type: string
        - name: next
          in: query
          required: false
          schema:
            type: string
        - name: from
          in: query
          required: false
          schema:
            type: string
        - name: to
          in: query
          required: false
          schema:
            type: string
        - name: round
          in: query
          required: false
          schema:
            type: string
        - name: status
          in: query
          required: false
          schema:
            type: string
        - name: venue
          in: query
          required: false
          schema:
            type: string
        - name: timezone
          in: query
          required: false
          schema:
            type: string
      responses:
        '200':
          $ref: '#/components/responses/Success'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /fixtures/events:
    get:
      summary: Events
      operationId: getFixturesEvents
      tags: [football]
      parameters:
        - name: fixture
          in: query
          required: true
          schema:
            type: string
        - name: team
          in: query
          required: false
          schema:
            type: string
        - name: player
          in: query
          required: false
          schema:
            type: string
        - name: type
          in: query
          required: false
          schema:
            type: string
      responses:
        '200':
          $ref: '#/components/responses/Success'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '429':
          $ref: '#/components/responses/RateLimited'
  /fixtures/headtohead:
    get:
      summary: Head To Head
      operationId: getFixturesHeadtohead
      tags: [football]
      parameters:
        - name: h2h
          in: query
          required: true
          schema:
            type: string
        - name: date
          in: query
          required: false
          schema:
            type: string
        - name: league
          in: query
          required: false
          schema:
            type: string
        - name: season
          in: query
          required: false
          schema:
            type: string
        - name: last
          in: query
          required: false
          schema:
            type: string
        - name: next
          in: query
          required: false
          schema:
            type: string
        - name: from
          in: query
          required: false
          schema:
            type: string
        - name: to
          in: query
          required: false
          schema:
            type: string
        - name: status
          in: query
          required: false
          schema:
            type: string
        - name: venue
          in: query
          required: false
          schema:
            type: string
        - name: timezone
          in: query
          required: false
          schema:
            type: string
