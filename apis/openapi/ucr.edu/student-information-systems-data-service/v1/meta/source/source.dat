    "/api/sis-data-api/v1/ethos/academic-periods/list": {
      "get": {
        "description": "The year records are retrieved from STVACYR table, the term records are retrieved from STVTERM table, the subterm records of type part of term are retrieved from STVPTRM table and subterm records with Open Learning rules are retrieved from SOBODTE table.<br/><br/>Returns all academic periods for the registration passed.<br/>?criteria={\"registration\":\"open\"}<br/><br/>Returns all academic periods for the code passed.<br/>?criteria={\"code\":\"201410\"}<br/><br/>Returns all academic periods for the category passed.<br/>?criteria={\"category\":{\"type\":\"term\"}}<br/><br/>Supported operators are $gte or the default of equals if operator is not specified.<br/>Returns all academic periods for the start on date passed.<br/>?criteria={\"startOn\":\"2016-03-07T00:00:00Z\"}<br/>?criteria={\"startOn\":{\"$eq\":\"2016-03-07T00:00:00Z\"}}<br/><br/>Returns all academic periods with start date greater than or equals to the start on date passed.<br/>?criteria={\"startOn\":{\"$gte\":\"2016-03-07T00:00:00Z\"}}<br/><br/>Supported operators are $lte or the default of equals if operator is not specified.<br/>Returns all academic periods for the end on date passed.<br/>?criteria={\"endOn\":\"2025-09-30T00:00:00Z\"}<br/>?criteria={\"endOn\":{\"$eq\":\"2025-09-30T00:00:00Z\"}}<br/><br/>Returns all academic periods with end date less than or equals to the end on date passed.<br/>?criteria={\"endOn\":{\"$lte\":\"2025-09-30T00:00:00Z\"}}<br/>",
        "externalDocs": {
          "url": "https://resources.elluciancloud.com/bundle/banner_api_academic_periods_16.1.0/page/academic-periods.html"
        },
        "operationId": "list",
        "parameters": [
          {
            "in": "query",
            "name": "refresh",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "criteria",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "criteriaPlaceholder",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "max",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "description": "This route will auto-paginate all the results from Ethos unless you set this to true.",
            "in": "query",
            "name": "disableAutoPagination",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PagedResult"
                    },
                    {
                      "properties": {
                        "data": {
                          "items": {
                            "$ref": "#/components/schemas/AcademicPeriod"
                          },
                          "type": "array"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": ""
          }
        },
        "summary": "",
        "tags": [
