            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "criteriaPlaceholder",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "max",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PagedResult"
                    },
                    {
                      "properties": {
                        "data": {
                          "items": {
