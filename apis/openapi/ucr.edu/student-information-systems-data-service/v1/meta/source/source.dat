                        "type": "string"
                      },
                      "id": {
                        "description": "Concatenation of Institution Code, Subject Code, Course Number, Term Code, Level Code, Subject Code UCR, Course Number UCR, Sequence Number Transfer Course, Sequence Number Comment, Group (0 if null), Program (NONE if '......')",
                        "type": "string"
                      },
                      "levelCode": {
                        "description": "Level code for comment",
                        "type": "string"
                      },
                      "program": {
                        "description": "None or value",
                        "type": "string"
                      },
                      "seqNo": {
                        "description": "Sequence number of the comment. Can be decimal.",
                        "format": "double",
                        "type": "number"
                      },
                      "subjectCode": {
                        "description": "UCR Institution Subject code",
                        "type": "string"
                      },
                      "termCode": {
                        "description": "Term Code for comment",
                        "type": "string"
                      },
                      "text": {
                        "description": "Comment text",
                        "type": "string"
                      },
                      "transferCourseNmuber": {
                        "description": "Transfer course number",
                        "type": "string"
                      },
                      "transferSubjectCode": {
                        "description": "Subject code of transfer course",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "connector": {
                  "description": "Logical connector between courses 'AND' or 'OR' SHRTATC_CONNECTOR",
                  "enum": [
                    "AND",
                    "OR"
                  ],
                  "type": "string"
                },
                "courseNumber": {
                  "description": "Course number of the equivalent course SHRTATC_CRSE_NUMB_INST",
                  "type": "string"
                },
                "creditsUsed": {
                  "description": "Number of credits used in equivalency SHRTATC_INST_CREDITS_USED",
                  "format": "double",
                  "type": "number"
                },
                "id": {
                  "description": "Concatenation of Institution Code, Subject Code, Course Number, Term Code, Level Code, Sequence Number, Group (0 if null), Program (NONE if '......')",
                  "type": "string"
                },
                "leftParen": {
                  "description": "Left parenthesis for grouping SHRTATC_INST_LPAREN_CONN",
                  "type": "string"
                },
                "rightParen": {
                  "description": "Right parenthesis for grouping SHRTATC_INST_RPAREN",
                  "type": "string"
                },
                "seqNo": {
                  "description": "Sequence number SHRTATC_SEQNO, can be decimal.",
                  "format": "double",
                  "type": "number"
                },
                "subjectCode": {
                  "description": "Subject code of the equivalent course SHRTATC_SUBJ_CODE_INST",
                  "type": "string"
                },
                "title": {
                  "description": "Title of the equivalent course SHRTATC_INST_TITLE",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "group": {
            "description": "Group identifier SHBTATCT_GROUP",
            "type": "string"
          },
          "highHours": {
            "description": "Maximum credit hours SHBTACT_TRNS_HIGH_HRS, may be a decimal.",
            "format": "double",
            "type": "number"
          },
          "id": {
            "description": "Concatenation of Institution Code, Subject Code, Course Number, Term Code, Level Code, Group (0 if null), Program (NONE if '......')",
