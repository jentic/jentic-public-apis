    "/api/sis-data-api/v1/ethos/sections-maximum/list": {
      "get": {
        "description": "Section records from SSBSECT.Returns all sections which contains the title passed in the course short title, long title and section short title, long title.<br/>criteria={\"title\":\"AstronomyLab\"}<br/><br/>Returns all sections with start date greater than or equal to the date passed.<br/>criteria={\"startOn\":\"2015-08-29\"}<br/><br/>Returns all sections with end date lesser than or equal to the date passed.<br/>criteria={\"endOn\":\"2025-08-29\"}<br/><br/>Returns all sections for the code passed.<br/>criteria={\"code\":\"10001\"}<br/><br/>Returns all sections for the number passed.<br/>criteria={\"number\":\"1\"}<br/><br/>Returns all sections for the instructional platform(intergration partner system rule) id passed.<br/>criteria={\"instructionalPlatform\":{\"detail\":{\"id\":\"a1cde877-a535-41ad-9a19-44ab4c23d6f8\"}}}<br/><br/>Returns all sections for the Course id passed.<br/>criteria={\"course\":{\"detail\":{\"id\":\"09b5960d-3741-43c0-98eb-b12c6bed5820\"}}}<br/><br/>Returns all sections for the Site id passed.<br/>criteria={\"site\":{\"detail\":{\"id\":\"7bb8ce69-3e77-4bc7-982d-07041726502e\"}}}<br/><br/>Returns all sections for the status category passed.<br/>criteria={\"status\":{\"category\":\"open\"}}<br/><br/>Returns all sections for the owning institution units ID passed.<br/>criteria={\"owningInstitutionUnits\":[{\"institutionUnit\":{\"id\":\"b23bb183-7d73-4726-af1b-661510324c88\"}}]}<br/><br/>Returns all sections for the instructor ids passed.<br/>criteria={\"instructorRosterDetails\":[{\"instructor\":{\"detail\":{\"id\":\"47bffoc4-202a-4835-a657-773763adf1f0\"}}}]}<br/><br/>Returns all sections for the academic period id passed.<br/>criteria={\"academicPeriod\":{\"detail\":{\"id\":\"47bffac4-202a-4835-a657-773763adf1f0\"}}}<br/><br/>Returns all sections for the reporting academic period id (section term) passed.<br/>criteria={\"reportingAcademicPeriod\":{\"id\":\"47bffac4-202a-4835-a657-773763adf1f0\"}}<br/><br/>Returns all sections for the schedule academic period ID passed.<br/>criteria={\"scheduleAcademicPeriod\":{\"detail\":{\"id\":\"6582835d-3e14-435b-b74f-4311746987ch\"}}}<br/>",
        "externalDocs": {
          "url": "https://resources.elluciancloud.com/bundle/banner_api_sections_maximum_16.0.0/page/sections-maximum.html"
        },
        "operationId": "list",
        "parameters": [
          {
            "in": "query",
            "name": "refresh",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "criteria",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "criteriaPlaceholder",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "max",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PagedResult"
                    },
                    {
                      "properties": {
                        "data": {
                          "items": {
                            "$ref": "#/components/schemas/SectionMaximum"
                          },
                          "type": "array"
                        }
