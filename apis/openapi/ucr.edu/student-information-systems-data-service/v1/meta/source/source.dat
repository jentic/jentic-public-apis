    "/api/sis-data-api/v1/ethos/sections/list": {
      "get": {
        "description": "Section records from SSBSECT.The title for the section associated with the type.<br/>?criteria={\"titles\":[{\"value\":\"Astronomy Lab\"}]}<br/><br/>The starting date at which a section may be scheduled to be taken.<br/>?criteria={\"startOn\": \"2015-08-29\"}<br/><br/>The ending date at which a section may no longer be scheduled to be taken.<br/>?criteria={\"endOn\": \"2025-08-29\"}<br/><br/>A code that may be used to identify a section<br/>?criteria={\"code\": \"10001\"}<br/><br/>A numbering scheme or other mark that distinguishes between multiple sections.<br/>?criteria={\"number\": \"1\"}<br/><br/>A technology platform used to manage the administration of a     section.<br/>?criteria={\"instructionalPlatform\": {\"id\": \"80d49491-00ff-483e-aab5-da76fea6528d\"}}<br/><br/>The academic time period associated with a section.<br/>?criteria={\"academicPeriod\": {\"id\": \"8b5f95a3-677f-4846-a329-3eb54a670111\"}}<br/><br/>The smallest unit of instruction for which an organization grants credits.<br/>?criteria={\"course\": {\"id\": \"39e7cfb1-e045-44d1-8446-7e3d55a33ea0\"}}<br/><br/>The levels of academic progress that can be associated with a section.<br/>?criteria={\"academicLevels\": [{\"id\": \"c6aab4d0-d3c7-40d9-96a6-09db8deaf403\"}]}<br/><br/>The primary location within the organization where a section's meetings will be held.<br/>?criteria={\"site\": {\"id\": \"0ed94aa2-dc31-494c-99a7-f4c272fa6416\"}}<br/><br/>The category of the section status.<br/>?criteria={\"status\":{\"category\":\"open\"}}<br/><br/>The units (departments) of the educational institution which own, or are responsible for, a course<br/>?criteria={\"owningInstitutionUnits\": [{\"institutionUnit\":{\"id\":\"b23bb183-7d73-4726-af1b-661510324c88\"}}]}<br/><br/>The reporting academic period associated with the section.<br/>?criteria={\"reportingAcademicPeriod\": {\"id\": \"060d0dd1-75aa-4c43-989c-0015b6f01d6e\"}}<br/><br/>Perform a keyword search.<br/>?criteria={\"keywordSearch\": \"Science\"}&criteriaPlaceholder=keywordSearch<br/><br/>Filter to return subject associated with a section.<br/>?criteria={\"subject\": {\"id\": \"70e3fdb8-1a06-416f-bb76-f78da649d6e1\"}}&criteriaPlaceholder=subject<br/><br/>Filter to return instructor associated with a section.<br/>?criteria={\"instructor\": {\"id\": \"cb3ebfe9-4a31-4933-a504-04d110413a61\"}}&criteriaPlaceholder=instructor<br/>",
        "externalDocs": {
