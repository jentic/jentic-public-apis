  "info": {
    "contact": {
      "name": "UC Riverside - Information Technology Solutions (ITS)",
      "url": "https://its.ucr.edu"
    },
    "description": "The Student Information Systems Data Service provides access to student data. Use the Ellucian Ethos Data Model Spreadsheet to locate the data that you may need. The links to Ellucian Documentation requires a login to the Ellucian Support Center. If you would like access to this API, please complete a <a target=\"_blank\" href=\"https://ucrsupport.service-now.com/ucr_portal/?id=sc_cat_item&sys_id=b5f056761b17c090609f86e9cd4bcba8\">Request form</a>. <br/> <br/>QA references PPRDXE <br/>PROD references BANPROD",
    "title": "Student Information Systems Data Service",
    "version": "v1",
    "x-jentic-source-url": "https://storage.googleapis.com/ucr-open-api/sis-data-api/sis-data-api-v1.yml?latest=true&amp;q=1&quot;"
  },
