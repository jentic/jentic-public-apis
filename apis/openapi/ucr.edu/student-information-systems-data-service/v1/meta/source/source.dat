      "get": {
        "description": "Custom route to list the a student's programs, majors, minors and concentrations.\nPer unique term, degree, and major for a student.\nIf a student has an Undergraduate, Masters, and PhD this would list 3 records\n```\ncriteria={\"college\": { \"code\": \"MD\"}}\n\ncriteria={\"major\": { \"code\": \"MDCL\", \"activityStatus\": \"ACTIVE\", \"status\": \"INPROGRESS\", \"term\": \"202130\", \"priority\": 1, \"department\": { \"code\": \"MDCL\"} } }\n\ncriteria={ \"student\": { \"id\": \"453c0ba2-b123-4c8a-9f3e-acd4c456a278\", \"term\": \"202130\", \"status\": \"IS\", \"level\": \"M\" } }\n\ncriteria={\"pastStudent\": {\"id\": \"453c0ba2-b123-4c8a-9f3e-acd4c456a278\",\"term\": \"202130\",\"status\": \"IS\",\"level\": \"M\" } }\n\ncriteria={\"person\": { \"pidm\": ######, \"bannerId\": \"8########\" } }\n\ncriteria={\"degree\": { \"code\": \"MD\" } }\n\ncriteria= { \"program\": { \"id\": \"eb4b6f25-63c5-40a4-b044-733c11c5aa2a\", \"type\": \"LEARNER\", \"activityStatus\": \"ACTIVE\", \"currentIndicator\": \"Y\", \"code\": \"MD-MDCL\", \"term\": \"202130\", \"priority\": 1, \"level\": \"M\" } }\n```\n",
        "operationId": "ListXCollegeDegreeMajor",
        "parameters": [
          {
            "in": "query",
            "name": "refresh",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
