    "/api/sis-data-api/v1/ethos/section-registration-statuses/list": {
      "get": {
        "description": "Section registration statuses from STVRSTS table.<br/><br/>The 'status' property in the API is retrieved based on the STVRSTS_CODE mapped in API setting REGISTRATION.STATUS.REASON.V4. The voice type value stored in STVRSTS_VOICE_TYPE for the STVRSTS_CODE should match the mappings.<br/><br/>The API publishes status.registrationStatus as 'registered', if the STVRSTS_CODE has STVRSTS_VOICE_TYPE ='R'<br/>The API publishes status.registrationStatus as 'notRegistered', if the STVRSTS_CODE has STVRSTS_VOICE_TYPE ='W' or 'D' or 'L'If the voice type and mappings in API settings do not match the API returns error.",
        "externalDocs": {
          "url": "https://resources.elluciancloud.com/bundle/banner_api_section_registration_statuses_8.0.0/page/section-registration-statuses.html"
