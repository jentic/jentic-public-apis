    "/api/sis-data-api/v1/ethos/student-academic-programs/list": {
      "get": {
        "description": "Active and inactive academic program details from SORLCUR table. This includes matriculated, outcome, recruited, and applied curriculum objective records. Retrieves only the current curriculum records with SORLCUR_CURRENT_CDE = 'Y'.<br/><br/>The person id of the student who is enrolled in an academic program.<br/>?criteria={\"student\": {\"id\": \"5674f28b-b216-4055-b236-81a922d93b4c\"}}<br/><br/>The academic program in which a student is enrolled.<br/>?criteria={\"program\": {\"id\": \"3befa8ca-11dc-4bed-aa2c-f07b21713bab\"}}<br/><br/>The site (campus) at which the student is enrolled in the program.<br/>?criteria={\"site\": {\"id\": \"5503039a-16a9-496a-9d1a-3baa923a8d70\"}}<br/><br/>The academic level associated with the enrollment of the student in the academic program.<br/>?criteria={\"academicLevel\": {\"id\": \"c6aab4d0-d3c7-40d9-96a6-09db8deaf403\"}}<br/><br/>The academic credentials that can be awarded for completing an academic program.<br/>?criteria={\"credentials\": [{\"id\": \"1e8ba315-b506-4bc0-ba4a-e64453359804\"}]}<br/><br/>The date on which an academic program begins.<br/>?criteria={\"startOn\": \"2009-01-01\"}<br/><br/>The date on which an academic program ends.<br/>?criteria={\"endOn\": \"2010-09-01\"}<br/><br/>The status of the academic program enrollment.<br/>?criteria={\"enrollmentStatus\":{\"status\":\"active\"}}<br/><br/>The curriculum objective associated with the student's academic program.<br/>?criteria={\"curriculumObjective\": \"matriculated\"}<br/><br/>Retrieve information for a specified population.<br/>?criteria={\"personFilter\": {\"id\": \"9a8f748a-47c8-4f70-8809-3a93e0b96abe\"}}&criteriaPlaceholder=personFilter<br/>",
        "externalDocs": {
          "url": "https://resources.elluciancloud.com/bundle/banner_api_student_academic_programs_17.0.0/page/student-academic-programs.html"
        },
        "operationId": "list",
        "parameters": [
          {
            "in": "query",
            "name": "refresh",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "in": "query",
