    "/api/sis-data-api/v1/ethos/student-cohort-assignments/list": {
      "get": {
        "description": "Cohorts records from SGRCHRT table of all students for the effective term.<br/><br/>The person who has been assigned to a cohort.<br/>criteria={\"person\":{\"id\":\"5674f28b-b216-4055-b236-81a922d93b4c\"}}<br/><br/>The grouping of students for reporting/tracking purposes (cohorts) to which the student is assigned for a period of time.<br/>criteria={\"cohort\": {\"id\":\"42cd0517-fbf8-4340-b852-1becac04792d\"}}<br/><br/>Supported operators are $gte or the default of equals if operator is not specified.<br/>Returns all student cohort assignments for the start on date passed.<br/>criteria={\"startOn\":\"1995-02-06\"}<br/>criteria={\"startOn\":{\"$eq\":\"1995-01-01\"}}<br/><br/>Returns all student cohort assignments with start date greater than or equals to the start on date passed.<br/>criteria={\"startOn\":{\"$gte\":\"1995-01-01\"}}<br/><br/>Supported operators are $lte or the default of equals if operator is not specified.<br/>Returns all student cohort assignments for the end on date passed.<br/>criteria={\"endOn\":\"2016-02-06\"}<br/>criteria={\"endOn\":{\"$eq\":\"2016-01-01\"}}<br/><br/>Returns all student cohort assignments with end date less than or equals to the end on date passed.<br/>criteria={\"endOn\":{\"$lte\":\"2016-01-01\"}}<br/>",
        "externalDocs": {
          "url": "https://resources.elluciancloud.com/bundle/banner_api_student_cohort_assignments_1.0.0/page/student-cohort-assignments.html"
