    "/api/sis-data-api/v1/ethos/x-zureacs-banner-security": {
      "get": {
        "description": "Returns a paged listing of all Banner Security resources.\nThis project provides a custom Ethos API to retrieve user security information from a Banner database. It is designed as a modern, RESTful replacement for the legacy PL/SQL procedure `zureacs.p_get_banner_security`.\n\n### Criteria\n\n#### By netId\nReturns the netId and class codes for a given netId.\n```\n?criteria={\"netId\":\"someNetId\"}\n```\n",
        "operationId": "listXZureacsBannerSecurity",
        "parameters": [
          {
            "description": "The maximum number of resources requesting for this result set. Default page limit is 500 and upper limit is 1000.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "The 0 based index for a collection of resources for the page requested.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "JSON object to filter the results.",
            "in": "query",
            "name": "criteria",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/PagedResult"
                    },
                    {
                      "properties": {
                        "data": {
                          "items": {
                            "$ref": "#/components/schemas/XZureacsBannerSecurity"
                          },
                          "type": "array"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "description": "Successful operation",
            "headers": {
              "X-Media-Type": {
                "description": "The Ethos Media Type",
                "schema": {
                  "type": "string"
                }
              },
              "X-Total-Count": {
                "description": "Specifies the total number of resources that satisfy the query.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Returns Banner Security resources",
