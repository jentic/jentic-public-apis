{
  "openapi": "3.0.0",
  "info": {
    "title": "Contar Xmls",
    "description": "Realiza a contagem de XMLs armazenados no Cofre SIEG conforme filtros de datas e CNPJs.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/siegcom/ContarXmls/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.sieg.com",
      "description": ""
    }
  ],
  "security": [
    {
      "JWT": [],
      "APIKey": []
    },
    {
      "JWT": [],
      "OAuthToken": []
    }
  ],
  "paths": {
    "/api/v1/contar-xmls": {
      "post": {
        "tags": [
          "Contar Xmls"
        ],
        "operationId": "countXmls",
        "summary": "Contar Xmls",
        "description": "Realiza a contagem de XMLs armazenados no Cofre SIEG conforme filtros de datas e CNPJs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContarXmlsRequestDto"
              },
              "example": {
                "CnpjEmit": "00000000000000",
                "CnpjDest": "00000000000000",
                "CnpjTom": "00000000000000",
                "CnpjRem": "00000000000000",
                "DataEmissaoInicio": "2025-11-21T12:12:27.923Z",
                "DataEmissaoFim": "2025-11-21T12:12:27.923Z",
                "DataUploadInicio": "2025-11-21T12:12:27.923Z",
                "DataUploadFim": "2025-11-21T12:12:27.923Z"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retorna a contagem de XMLs encontrados por tipo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountXmlsResponse"
                },
                "example": {
                  "NFe": 0,
                  "NFCe": 0,
                  "CTe": 0,
                  "CFe": 0,
                  "NFSe": 0
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida (filtros obrigatórios ausentes, datas inconsistentes, etc.)"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "JWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cole apenas o token JWT gerado pelo endpoint de autenticação."
      },
      "APIKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "OAuthToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-OAuth-Token",
        "description": "Token OAuth 2.0 Sieg (utilize em conjunto com o JWT)."
      }
    },
    "schemas": {
      "ContarXmlsRequestDto": {
        "type": "object",
        "description": "É necessário passar DataEmissaoInicio/DataEmissaoFim e/ou DataUploadInicio/DataUploadFim (Limite de 3 meses)",
        "properties": {
          "CnpjEmit": {
            "type": "string",
            "description": "CNPJ do emitente (14 dígitos)"
          },
          "CnpjDest": {
            "type": "string",
            "description": "CNPJ do destinatário (14 dígitos)"
          },
          "CnpjTom": {
            "type": "string",
            "description": "CNPJ do tomador (14 dígitos) — usado para CTe"
          },
          "CnpjRem": {
            "type": "string",
            "description": "CNPJ do remetente (14 dígitos) — usado para CTe"
          },
          "DataEmissaoInicio": {
            "type": "string",
            "format": "date-time",
            "description": "Início do intervalo por data de emissão (ISO 8601)"
          },
          "DataEmissaoFim": {
            "type": "string",
            "format": "date-time",
            "description": "Fim do intervalo por data de emissão (ISO 8601)"
          },
          "DataUploadInicio": {
            "type": "string",
            "format": "date-time",
            "description": "Início do intervalo por data de upload (ISO 8601)"
          },
          "DataUploadFim": {
            "type": "string",
            "format": "date-time",
            "description": "Fim do intervalo por data de upload (ISO 8601)"
          }
        },
        "required": []
      },
      "CountXmlsResponse": {
        "type": "object",
        "description": "Contagem de documentos por tipo retornada pela API",
        "properties": {
          "NFe": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "NFCe": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "CTe": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "CFe": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "NFSe": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          }
        }
      }
    }
  }
}
