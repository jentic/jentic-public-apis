{
  "openapi": "3.0.1",
  "info": {
    "title": "BaixarXml",
    "version": "1.0.0",
    "description": "Baixar um XML individual.\n\n### Autenticação\nUtilize o botão \"Authorize\" para inserir o token JWT (Bearer) e as chaves de acesso.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/siegcom/BaixarXml/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.sieg.com"
    }
  ],
  "security": [
    {
      "JWT": [],
      "APIKey": []
    },
    {
      "JWT": [],
      "OAuthToken": []
    }
  ],
  "paths": {
    "/api/v1/baixar-xml": {
      "post": {
        "tags": [
          "BaixarXml"
        ],
        "summary": "BaixarXml",
        "description": "Endpoint para download de XML individual de NF-e, CT-e, NFC-e, NFS-e e outros.",
        "operationId": "baixarXml",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadIndividualXmlRequestDto"
              },
              "example": {
                "ChaveXml": "string",
                "TipoXml": 1,
                "BaixarEventos": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Retorno padrão da operação de download",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadResponse"
                },
                "example": {
                  "Status": "Sucesso",
                  "Codigo": "200",
                  "Mensagens": [
                    "Arquivo gerado com sucesso"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Erro na requisição",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadResponse"
                },
                "example": {
                  "Status": "Erro",
                  "Codigo": "400",
                  "Mensagens": [
                    "Chave XML inválida"
                  ]
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "cURL",
            "label": "cURL",
            "source": "curl -X POST \"https://api.sieg.com/api/v1/baixar-xml\" \\\n-H \"accept: application/json\" \\\n-H \"Content-Type: application/json\" \\\n-d '{\"ChaveXml\":\"string\",\"TipoXml\":1,\"BaixarEventos\":true}'\n"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "JWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cole apenas o token JWT gerado pelo endpoint de autenticação."
      },
      "APIKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "OAuthToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-OAuth-Token",
        "description": "Token OAuth 2.0 Sieg (utilize em conjunto com o JWT)."
      }
    },
    "schemas": {
      "DownloadIndividualXmlRequestDto": {
        "type": "object",
        "description": "DTO utilizado para baixar um único XML específico.",
        "required": [
          "ChaveXml",
          "TipoXml"
        ],
        "properties": {
          "ChaveXml": {
            "type": "string",
            "description": "Chave da NF-e/CT-e/NFS-e que deseja baixar ."
          },
          "TipoXml": {
            "type": "integer",
            "format": "int32",
            "enum": [
              1,
              2,
              3,
              4,
              5,
              6,
              7,
              8,
              10,
              99,
              100
            ],
            "description": "Tipo do XML. Ex: 1=NFe, 2=CTe, 3=NFSe, etc."
          },
          "BaixarEventos": {
            "type": "boolean",
            "description": "Se true, retorna eventos relacionados à nota."
          }
        }
      },
      "DownloadResponse": {
        "type": "object",
        "description": "Resposta genérica da API ao baixar XMLs individuais ou em lote.",
        "properties": {
          "Status": {
            "type": "string"
          },
          "Codigo": {
            "type": "string"
          },
          "Mensagens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
