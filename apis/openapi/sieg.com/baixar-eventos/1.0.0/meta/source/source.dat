{
  "openapi": "3.0.1",
  "info": {
    "title": "Baixar Eventos",
    "version": "1.0.0",
    "description": "Endpoint para realizar o download de eventos relacionados a NF-e, CT-e e NFC-e\n\n### Autenticação\nUtilize o botão \"Authorize\" para inserir o token JWT (Bearer) e as chaves de acesso.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/siegcom/BaixarEventos/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.sieg.com"
    }
  ],
  "security": [
    {
      "JWT": [],
      "APIKey": []
    },
    {
      "JWT": [],
      "OAuthToken": []
    }
  ],
  "paths": {
    "/api/v1/baixar-eventos": {
      "post": {
        "tags": [
          "BaixarEventos"
        ],
        "summary": "Baixar eventos vinculados a um XML",
        "description": "Permite baixar eventos relacionados a documentos fiscais eletrônicos,\nfiltrando por chave, CNPJs envolvidos, tipo do evento ou intervalo de datas.\n",
        "operationId": "baixarEventos",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaixarEventosRequestDto"
              },
              "example": {
                "ChaveXml": "string",
                "TipoXml": 1,
                "TipoEvento": 0,
                "DataInicioEvento": "2025-11-21T18:50:15.328Z",
                "DataFimEvento": "2025-11-21T18:50:15.328Z",
                "CnpjEmit": "string",
                "CnpjDest": "string",
                "CnpjRem": "string",
                "CnpjTom": "string",
                "Skip": 0,
                "Take": 0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Eventos encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaixarEventosResponseDto"
                },
                "example": {
                  "Status": "Sucesso",
                  "Codigo": "200",
                  "Mensagens": [
                    "Eventos encontrados com sucesso."
                  ],
                  "Eventos": [
                    {
                      "TipoEvento": 110111,
                      "Descricao": "Cancelamento",
                      "Protocolo": "135220000000000",
                      "DataEvento": "2025-01-01T10:20:30Z",
                      "Xml": "<evento>...</evento>"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Erro de validação da requisição",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaixarEventosResponseDto"
                },
                "example": {
                  "Status": "Erro",
                  "Codigo": "400",
                  "Mensagens": [
                    "Parâmetros de filtro inválidos."
                  ]
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "cURL",
            "label": "cURL",
            "source": "curl -X POST \"https://api.sieg.com/api/v1/baixar-eventos\" \\\n  -H \"accept: application/json\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{ \n        \"ChaveXml\": \"string\",\n        \"TipoXml\": 1,\n        \"TipoEvento\": 0,\n        \"DataInicioEvento\": \"2025-11-21T18:50:15.328Z\",\n        \"DataFimEvento\": \"2025-11-21T18:50:15.328Z\",\n        \"CnpjEmit\": \"string\",\n        \"CnpjDest\": \"string\",\n        \"CnpjRem\": \"string\",\n        \"CnpjTom\": \"string\",\n        \"Skip\": 0,\n        \"Take\": 0\n      }'\n"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "JWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cole apenas o token JWT gerado pelo endpoint de autenticação."
      },
      "APIKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "OAuthToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-OAuth-Token",
        "description": "Token OAuth 2.0 Sieg (utilize em conjunto com o JWT)."
      }
    },
    "schemas": {
      "BaixarEventosRequestDto": {
        "type": "object",
        "description": "DTO utilizado para solicitar o download de eventos vinculados a documentos fiscais eletrônicos.",
        "required": [
          "ChaveXml",
          "TipoXml"
        ],
        "properties": {
          "ChaveXml": {
            "type": "string",
            "description": "Chave do documento (44 caracteres)."
          },
          "TipoXml": {
            "type": "integer",
            "format": "int32",
            "description": "Tipo do XML (1=NFe, 2=CTe, 3=NFSe etc)."
          },
          "TipoEvento": {
            "type": "integer",
            "format": "int32",
            "description": "Tipo específico de evento (ex: 110111 cancelamento)."
          },
          "DataInicioEvento": {
            "type": "string",
            "format": "date-time"
          },
          "DataFimEvento": {
            "type": "string",
            "format": "date-time"
          },
          "CnpjEmit": {
            "type": "string",
            "description": "CNPJ do emitente."
          },
          "CnpjDest": {
            "type": "string",
            "description": "CNPJ do destinatário."
          },
          "CnpjRem": {
            "type": "string",
            "description": "CNPJ do remetente."
          },
          "CnpjTom": {
            "type": "string",
            "description": "CNPJ do tomador."
          },
          "Skip": {
            "type": "integer",
            "format": "int32",
            "description": "Quantidade de registros para pular (paginação)."
          },
          "Take": {
            "type": "integer",
            "format": "int32",
            "description": "Quantidade de registros a retornar (paginação)."
          }
        }
      },
      "BaixarEventosResponseDto": {
        "type": "object",
        "description": "Resposta da API ao solicitar eventos.",
        "properties": {
          "Status": {
            "type": "string"
          },
          "Codigo": {
            "type": "string"
          },
          "Mensagens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Eventos": {
            "type": "array",
            "description": "Lista de eventos retornados.",
            "items": {
              "type": "object",
              "properties": {
                "TipoEvento": {
                  "type": "integer"
                },
                "Descricao": {
                  "type": "string"
                },
                "Protocolo": {
                  "type": "string"
                },
                "DataEvento": {
                  "type": "string",
                  "format": "date-time"
                },
                "Xml": {
                  "type": "string",
                  "description": "XML bruto do evento."
                }
              }
            }
          }
        }
      }
    }
  }
}
