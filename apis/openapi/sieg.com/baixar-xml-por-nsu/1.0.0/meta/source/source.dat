{
  "openapi": "3.0.1",
  "info": {
    "title": "Baixar XML por NSU",
    "version": "1.0.0",
    "description": "Endpoint para download de XML utilizando NSU.\nO retorno da requisição é um arquivo compactado (.zip).\n\n### Autenticação\nUtilize o botão \"Authorize\" para inserir o token JWT (Bearer) e as chaves de acesso.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/siegcom/BaixarXmlNSU/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.sieg.com"
    }
  ],
  "paths": {
    "/api/v1/baixar-xml/nsu": {
      "post": {
        "tags": [
          "Baixar Xml NSU"
        ],
        "summary": "Baixar XML por NSU",
        "description": "Realiza o download de um ou mais XMLs associados ao NSU informado.\nO retorno da API é um arquivo ZIP contendo os XMLs.\n",
        "operationId": "baixarXmlPorNsu",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BaixarXmlPorNsuRequestDto"
              },
              "example": {
                "Nsu": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Download do arquivo ZIP contendo os XMLs",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida"
          },
          "401": {
            "description": "Não autorizado"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "JWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cole apenas o token JWT gerado pelo endpoint de autenticação."
      },
      "APIKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "OAuthToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-OAuth-Token",
        "description": "Token OAuth 2.0 Sieg (utilize em conjunto com o JWT)."
      }
    },
    "schemas": {
      "BaixarXmlPorNsuRequestDto": {
        "type": "object",
        "description": "DTO utilizado para download de XML via NSU.",
        "required": [
          "Nsu"
        ],
        "properties": {
          "Nsu": {
            "type": "integer",
            "format": "int64",
            "description": "NSU do XML que será baixado.",
            "example": 1
          }
        }
      }
    }
  },
  "security": [
    {
      "JWT": [],
      "APIKey": []
    },
    {
      "JWT": [],
      "OAuthToken": []
    }
  ]
}
