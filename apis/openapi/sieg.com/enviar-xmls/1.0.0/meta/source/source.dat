{
  "openapi": "3.0.0",
  "info": {
    "title": "Enviar Xmls",
    "description": "Api para envio de Xmls.                \n\n### Autenticação\nUtilize o botão \"Authorize\" para inserir o token JWT (Bearer) e a API Key.\n",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/siegcom/EnviarXmls/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.sieg.com/"
    }
  ],
  "paths": {
    "/api/v1/send-xml": {
      "post": {
        "operationId": "sendExternalSystemXml",
        "summary": "Send XML data to external system",
        "description": "Endpoint para envio de XML em Base64 para a SIEG.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExternalSystemXmlRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "XML data sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultApiGeneralString"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - Invalid company",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultApiGeneralString"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "JWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cole apenas o token JWT gerado pelo endpoint de autenticação."
      },
      "APIKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Insira sua API Key no cabeçalho X-API-Key."
      },
      "OAuthToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-OAuth-Token",
        "description": "Token OAuth 2.0 Sieg (utilize em conjunto com o JWT)."
      }
    },
    "schemas": {
      "ExternalSystemXmlRequestDto": {
        "type": "object",
        "properties": {
          "Xml": {
            "type": "string",
            "description": "XML content to be sent (Base64)"
          }
        }
      },
      "ResultApiGeneralString": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean",
            "description": "Indicates if the operation was successful"
          },
          "errorMessage": {
            "type": "string",
            "description": "Error message if the operation failed"
          },
          "statusCode": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code of the response"
          },
          "data": {
            "type": "string",
            "nullable": true,
            "description": "Response data"
          },
          "isFailure": {
            "type": "boolean",
            "description": "Indicates if the operation failed"
          }
        }
      }
    }
  },
  "security": [
    {
      "JWT": [],
      "APIKey": []
    },
    {
      "JWT": [],
      "OAuthToken": []
    }
  ]
}
