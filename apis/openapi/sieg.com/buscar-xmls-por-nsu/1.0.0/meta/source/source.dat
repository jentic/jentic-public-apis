{
  "openapi": "3.0.1",
  "info": {
    "title": "Buscar XMLs por NSU",
    "version": "1.0.0",
    "description": "Endpoint para busca incremental de XMLs utilizando NSU.\nPadrão compatível com SmartBear SwaggerHub e Portal.\n\n### Autenticação\nUtilize o botão \"Authorize\" para inserir o token JWT (Bearer) e as chaves de acesso.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/siegcom/BuscarXmlsNSU/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.sieg.com"
    }
  ],
  "paths": {
    "/api/v1/buscar-xmls/nsu": {
      "post": {
        "tags": [
          "Buscar Xmls NSU"
        ],
        "summary": "Buscar XMLs por NSU",
        "description": "Retorna documentos fiscais disponíveis a partir de um NSU inicial.\nIdeal para sincronização incremental.\n",
        "operationId": "buscarXmlsPorNsu",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BuscarXmlsPorNsuRequestDto"
              },
              "example": {
                "NsuInicial": 1,
                "LimiteResultados": 50
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuscarXmlsPorNsuResponseDto"
                },
                "example": {
                  "IsSuccess": true,
                  "ErrorMessage": "",
                  "StatusCode": 200,
                  "Data": {
                    "ListaNsuConsulta": [
                      {
                        "CnpjCpfEmitente": null,
                        "CnpjCpfDestinatario": null,
                        "CnpjCpfTomador": null,
                        "CnpjCpfRemetente": null,
                        "NumeroNsu": 114,
                        "TipoXml": "Event",
                        "DataEmissao": "0001-01-01T00:00:00"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida"
          },
          "401": {
            "description": "Não autorizado"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "JWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cole apenas o token JWT gerado pelo endpoint de autenticação."
      },
      "APIKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "OAuthToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-OAuth-Token",
        "description": "Token OAuth 2.0 Sieg (utilize em conjunto com o JWT)."
      }
    },
    "schemas": {
      "BuscarXmlsPorNsuRequestDto": {
        "type": "object",
        "description": "DTO para consulta de XMLs por NSU.",
        "required": [
          "NsuInicial"
        ],
        "properties": {
          "NsuInicial": {
            "type": "integer",
            "format": "int64",
            "description": "NSU inicial para início da busca.",
            "example": 1
          },
          "LimiteResultados": {
            "type": "integer",
            "format": "int32",
            "description": "Quantidade máxima de registros retornados.",
            "example": 50
          }
        }
      },
      "BuscarXmlsPorNsuResponseDto": {
        "type": "object",
        "description": "Resposta padrão da API.",
        "properties": {
          "IsSuccess": {
            "type": "boolean",
            "example": true
          },
          "ErrorMessage": {
            "type": "string",
            "nullable": true,
            "example": ""
          },
          "StatusCode": {
            "type": "integer",
            "format": "int32",
            "example": 200
          },
          "Data": {
            "$ref": "#/components/schemas/BuscarXmlsPorNsuDataDto"
          }
        }
      },
      "BuscarXmlsPorNsuDataDto": {
        "type": "object",
        "properties": {
          "ListaNsuConsulta": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NsuConsultaDto"
            }
          }
        }
      },
      "NsuConsultaDto": {
        "type": "object",
        "description": "Item retornado na consulta de NSU.",
        "properties": {
          "CnpjCpfEmitente": {
            "type": "string",
            "nullable": true
          },
          "CnpjCpfDestinatario": {
            "type": "string",
            "nullable": true
          },
          "CnpjCpfTomador": {
            "type": "string",
            "nullable": true
          },
          "CnpjCpfRemetente": {
            "type": "string",
            "nullable": true
          },
          "NumeroNsu": {
            "type": "integer",
            "format": "int64",
            "example": 114
          },
          "TipoXml": {
            "type": "string",
            "example": "Event"
          },
          "DataEmissao": {
            "type": "string",
            "format": "date-time",
            "example": "0001-01-01T00:00:00"
          }
        }
      }
    }
  },
  "security": [
    {
      "JWT": [],
      "APIKey": []
    },
    {
      "JWT": [],
      "OAuthToken": []
    }
  ]
}
