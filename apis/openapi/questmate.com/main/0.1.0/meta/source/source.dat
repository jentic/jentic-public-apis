              schema:
                $ref: '#/components/schemas/WorkspaceMembershipListItem'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    delete:
      summary: 'Remove member from Workspace.'
      tags:
        - Workspaces
      responses:
        '200':
          description: 'Deleted Workspace Membership.'
          content:
            application/json:
              schema: {}
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
  /templates:
    post:
      summary: 'Copy an existing Template.'
      tags:
        - Quests
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TemplateCopyRequest'
      responses:
        '201':
          description: 'Created Template.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TemplateDetails'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    get:
      summary: 'Retrieve Templates.'
      tags:
        - Quests
      parameters:
        - in: query
          name: include_archived
          schema:
            type: string
            enum:
              - 'true'
              - 'false'
          description: 'Include archived Templates.'
        - in: query
          required: false
          name: workspaceId
          schema:
            oneOf:
              - type: string
                format: uuid
              - type: string
                enum:
                  - 'null'
          description: 'Get Templates for specific workspace only.'
      responses:
        '200':
          description: 'Array of Templates.'
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/TemplateListItem'
        '401':
          $ref: '#/components/responses/Unauthorized'
  '/templates/{id}':
    get:
      summary: 'Retrieve Template.'
      tags:
        - Quests
        - Library
      responses:
        '200':
          description: Template.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TemplateDetails'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: id
        description: 'Id of Template to retrieve.'
        required: true
        schema:
          type: string
          format: uuid
    patch:
      summary: 'Update Template.'
      tags:
        - Quests
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchTemplateRequestBody'
      responses:
        '200':
          description: 'Updated Template.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TemplateDetails'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
  '/templates/{id}/archive':
    post:
      summary: 'Archive Template'
      tags:
        - Quests
      responses:
        '200':
          description: 'Archived Template.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TemplateArchiveResult'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: id
        description: 'Id of Template to archive.'
        required: true
        schema:
          type: string
          format: uuid
  '/templates/{id}/unarchive':
    post:
      summary: 'Unarchive Template'
      tags:
        - Quests
      responses:
        '200':
          description: 'Unarchived Template.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TemplateArchiveResult'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: id
        description: 'Id of Template to unarchive.'
        required: true
        schema:
          type: string
          format: uuid
  '/templates/{id}/promoteDraftQuest':
    post:
      summary: 'Promote Draft Quest from Template to Current/Active Quest.'
      tags:
        - Quests
      responses:
        '200':
          description: 'Updated Template.'
          content:
            application/json:
              schema: {}
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: id
        description: 'Id of Template to update Draft Quest to Current/Active Quest.'
        required: true
        schema:
          type: string
          format: uuid
  /library/templates:
    get:
      summary: 'Get Templates from Library'
      security: []
      tags:
        - Library
      responses:
        '200':
          description: 'List of Templates from Library.'
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/LibraryTemplateListItem'
  '/library/templates/{questId}':
    get:
      summary: 'Get Template from Library'
      security: []
      tags:
        - Library
      responses:
        '200':
          description: 'Library Template Details'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LibraryTemplateDetails'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
  /library/scripts:
    get:
      summary: 'Get Custom Scripts from Library'
      security: []
      tags:
        - Library
      parameters:
        - in: query
          name: useTypes
          description: 'Filter scripts by their use type'
          required: false
          schema:
            type: array
            items:
              $ref: '#/components/schemas/LibraryQuestScriptUseType'
      responses:
        '200':
          description: 'List of Custom Scripts from Library.'
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/LibraryQuestScriptListItem'
  '/library/scripts/{id}':
    parameters:
      - in: path
        name: id
        description: 'QuestScript ID'
        required: true
        schema:
          type: string
    get:
      summary: 'Get QuestScript Detail'
      security: []
      tags:
        - Library
      responses:
        '200':
          description: 'QuestScript details'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LibraryQuestScriptDetail'
        '404':
          $ref: '#/components/responses/NotFound'
  '/library/apps/{appId}':
    get:
      summary: 'Get App information'
      operationId: getLibraryApp
      security: []
      tags:
        - Library
      parameters:
        - in: path
          name: appId
          description: 'Id of Service to retrieve.'
          required: true
          schema:
            $ref: '#/components/schemas/AppId'
      responses:
        '200':
          description: 'App Information.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LibraryAppDetails'
        '404':
          $ref: '#/components/responses/NotFound'
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
  schemas:
    AppId:
      type: string
      nullable: false
      enum:
        - tremendous
        - slack
        - airtable
        - hue
        - google
        - spotify
        - notion
        - hubspot
        - tesla
        - nexudus
        - pipedrive
        - atlassian
        - microsoft
        - ewelink
    App:
      required:
        - id
        - name
        - linked
        - clientId
        - authorizationUrl
        - linkingStrategy
      properties:
        id:
          $ref: '#/components/schemas/AppId'
        name:
          type: string
        linked:
          type: boolean
        clientId:
          type: string
        authorizationUrl:
          type: string
        audience:
          type: string
          nullable: true
        additionalAuthParams:
          type: object
        linkingStrategy:
          type: string
          enum:
            - authorizationCodeFlow
            - refreshToken
        scopes:
          type: array
          nullable: true
          items:
            type: string
      additionalProperties: false
    QMErrorResponse:
      type: object
      required:
        - message
        - errors
      properties:
        message:
          type: string
        eventId:
          type: string
        errors:
          type: array
          items:
            type: object
            required:
              - message
              - path
              - errorCode
            properties:
              path:
                type: array
                items:
                  type: string
              message:
                type: string
              errorCode:
                type: string
    AppLinkRequest:
      type: object
      required:
        - params
        - returnUrl
      properties:
        params:
          type: object
          nullable: false
          additionalProperties: true
        returnUrl:
          type: string
          nullable: false
        codeVerifier:
          type: string
    JsonValue:
      description: 'Can be anything: string, number, array, object, null, etc.'
      anyOf:
        - type: string
          nullable: true
        - type: number
          nullable: true
        - type: integer
          nullable: true
        - type: boolean
          nullable: true
        - type: array
          nullable: true
          items: {}
        - type: object
          nullable: true
          additionalProperties: true
    ItemType:
      type: string
      enum:
        - Amount
        - Checkbox
        - Checklist
        - Custom
        - CustomV2
        - Date
        - DateTime
        - Email
        - FileUploadV2
        - Location
        - MultiLineText
        - MultiSelect
        - Rating
        - Schedule
        - Signature
        - SingleSelect
        - SlackMessage
        - Subquest
        - Switch
        - Text
        - UserPicker
        - Video
    SendSMSRequest:
      type: object
      required:
        - mobileNumber
        - message
      properties:
        mobileNumber:
          type: string
          minLength: 1
        message:
          type: string
          minLength: 1
    SendEmailRequest:
      type: object
      required:
        - to
        - subject
        - body
      properties:
        to:
          type: string
          minLength: 1
        subject:
          type: string
          minLength: 1
        body:
          type: string
          minLength: 1
    QuestscriptExecutionListItem:
      type: object
      required:
        - id
        - status
        - runAsUser
        - value
        - exception
        - durationMs
        - logs
        - startedAt
        - completedAt
        - triggerType
        - triggerIdentifier
      properties:
        id:
          type: string
          format: uuid
        triggerType:
          type: string
          enum:
            - ITEM_INSTANCE
        triggerIdentifier:
          type: string
        status:
          type: string
          enum:
            - PENDING
            - OK
            - FAILED
        runAsUser:
          type: object
          required:
            - id
            - displayName
          properties:
            id:
              type: string
              format: uuid
            displayName:
              type: string
        exception:
          type: object
          nullable: true
          properties:
            message:
              type: string
            stack:
              type: array
              items:
                type: string
        value:
          type: object
          nullable: true
          properties: {}
        durationMs:
          type: number
          nullable: true
        logs:
          type: array
          nullable: true
          items:
            type: string
        startedAt:
          type: string
          format: date-time
        completedAt:
          type: string
          format: date-time
          nullable: true
    RestrictedQuestscriptExecutionListItem:
      type: object
      required:
        - id
        - status
        - triggerType
        - triggerIdentifier
      properties:
        id:
          type: string
          format: uuid
        triggerType:
          type: string
          enum:
            - ITEM_INSTANCE
        triggerIdentifier:
          type: string
        status:
          type: string
          enum:
            - PENDING
            - OK
            - FAILED
    NullableString:
      nullable: true
      type: string
    AppNavigationRoute:
      type: object
      description: 'App screen to navigate to'
      required:
        - screen
      properties:
        screen:
          type: string
        params:
          type: object
          additionalProperties: true
    NavigateAction:
      type: object
      required:
        - type
        - data
      properties:
        type:
          type: string
          enum:
            - NAVIGATE
        data:
          type: object
          required:
            - to
          properties:
            to:
              oneOf:
                - type: string
                  description: 'App path to navigate to'
                - $ref: '#/components/schemas/AppNavigationRoute'
    LinkAccountAction:
      type: object
      required:
        - type
        - data
      properties:
        type:
          type: string
          enum:
            - LINK_ACCOUNT
        data:
          type: object
          required:
            - identifier
            - connection
            - provider
          properties:
            identifier:
              description: 'Email or Mobile Number'
              type: string
            connection:
              description: 'Auth0 Connection Name'
              type: string
            provider:
              description: 'Auth0 Connection Provider Strategy'
              type: string
              enum:
                - email
                - sms
                - samlp
    LoginResponse:
      type: object
      required:
        - user
        - requiredActions
      properties:
        user:
          type: object
          nullable: true
          required:
            - id
            - displayName
            - email_address
            - mobile_number
            - avatarSmallUrl
            - avatarLargeUrl
          properties:
            id:
              type: string
              format: uuid
            displayName:
              type: string
              minLength: 1
              maxLength: 255
            email_address:
              anyOf:
                - $ref: '#/components/schemas/NullableString'
                - type: string
            mobile_number:
              anyOf:
                - $ref: '#/components/schemas/NullableString'
                - type: string
            avatarSmallUrl:
              anyOf:
                - $ref: '#/components/schemas/NullableString'
                - type: string
            avatarLargeUrl:
              anyOf:
                - $ref: '#/components/schemas/NullableString'
                - type: string
        requiredActions:
          type: array
          items:
            oneOf:
              - $ref: '#/components/schemas/NavigateAction'
              - $ref: '#/components/schemas/LinkAccountAction'
            discriminator:
              propertyName: type
              mapping:
                NAVIGATE: '#/components/schemas/NavigateAction'
                LINK_ACCOUNT: '#/components/schemas/LinkAccountAction'
    UserDetail:
      required:
        - id
        - displayName
        - email_address
        - mobile_number
        - emailNotificationsEnabled
        - mobileNotificationsEnabled
        - defaultPdfPageSize
        - avatarSmallUrl
        - avatarLargeUrl
      properties:
        id:
          type: string
          format: uuid
        displayName:
          type: string
          minLength: 1
          maxLength: 255
        email_address:
          type: string
          nullable: true
        mobile_number:
          type: string
          nullable: true
        emailNotificationsEnabled:
          type: boolean
        mobileNotificationsEnabled:
          type: boolean
        defaultPdfPageSize:
          type: string
          enum:
            - letter
            - a4
        avatarSmallUrl:
          type: string
          nullable: true
        avatarLargeUrl:
          type: string
          nullable: true
    PatchUserRequest:
      properties:
        displayName:
          type: string
          minLength: 1
          maxLength: 255
        emailNotificationsEnabled:
          type: boolean
        mobileNotificationsEnabled:
          type: boolean
        defaultPdfPageSize:
          type: string
          enum:
            - letter
            - a4
    UserListItem:
      required:
        - id
        - displayName
        - avatarSmallUrl
        - avatarLargeUrl
      properties:
        id:
          type: string
          format: uuid
        displayName:
          type: string
          minLength: 1
          maxLength: 255
        avatarSmallUrl:
          type: string
          nullable: true
        avatarLargeUrl:
          type: string
          nullable: true
    CreateUsersResponse:
      allOf:
        - $ref: '#/components/schemas/UserListItem'
        - type: object
          required:
            - matchedIdentifiers
          properties:
            matchedIdentifiers:
              type: array
              items:
                type: string
    TeamMembershipRole:
      type: string
      enum:
        - OWNER
        - ADMIN
        - MEMBER
    TeamDeletionInfo:
      required:
        - id
        - name
        - role
        - willBeDeleted
      properties:
        id:
          type: string
          format: uuid
        name:
          type: string
        role:
          $ref: '#/components/schemas/TeamMembershipRole'
        willBeDeleted:
          type: boolean
        newOwner:
          type: object
          nullable: true
          required:
            - id
            - displayName
          properties:
            id:
              type: string
              format: uuid
            displayName:
              type: string
    UserDeletionAnalysisResponse:
      type: object
      required:
        - canDelete
        - blockingIssues
        - personalWorkspace
        - workspaces
        - teams
        - totalQuestsToDelete
        - totalRunsToDelete
      properties:
        canDelete:
          type: boolean
        blockingIssues:
          type: array
          items:
            type: string
        teams:
          type: array
          items:
            $ref: '#/components/schemas/TeamDeletionInfo'
        personalWorkspace:
          type: object
          required:
            - quests
          properties:
            quests:
              type: array
              items:
                type: object
                required:
                  - id
                  - title
                  - totalRuns
                  - willBeDeleted
                properties:
                  id:
                    type: string
                    format: uuid
                  title:
                    type: string
                  totalRuns:
                    type: number
                  willBeDeleted:
                    type: boolean
                    enum:
                      - true
        workspaces:
          type: array
          items:
            type: object
            required:
              - id
              - name
              - role
              - willBeDeleted
              - quests
            properties:
              id:
                type: string
                format: uuid
              name:
                type: string
              role:
                type: string
              willBeDeleted:
                type: boolean
              newOwner:
                type: object
                required:
                  - id
                  - displayName
                properties:
                  id:
                    type: string
                    format: uuid
                  displayName:
                    type: string
              quests:
                type: array
                items:
                  type: object
                  required:
                    - id
                    - title
                    - totalRuns
                    - willBeDeleted
                  properties:
                    id:
                      type: string
                      format: uuid
                    title:
                      type: string
                    totalRuns:
                      type: number
                    willBeDeleted:
                      type: boolean
        totalQuestsToDelete:
          type: number
        totalRunsToDelete:
          type: number
        subscription:
          type: object
          required:
            - willBeCancelled
            - cancellationNote
          properties:
            willBeCancelled:
              type: boolean
            cancellationNote:
              type: string
    UserDeletionInitiateResponse:
      type: object
      required:
        - jobId
        - message
      properties:
        jobId:
          type: string
          format: uuid
        message:
          type: string
    PublicQuestOkResponse:
      type: object
      required:
        - result
        - questInstanceId
        - publicQuestSessionToken
      properties:
        result:
          type: string
          enum:
            - OK
        questInstanceId:
          type: string
          format: uuid
        publicQuestSessionToken:
          type: string
          nullable: true
    JsonObject:
      type: object
      additionalProperties: true
    PublicQuestAuthenticationRequiredResponse:
      type: object
      required:
        - result
        - startTrigger
      properties:
        result:
          type: string
          enum:
            - AUTHENTICATION_REQUIRED
        startTrigger:
          type: object
          required:
            - id
            - config
            - formPrototype
          properties:
            id:
              type: string
              format: uuid
            config:
              $ref: '#/components/schemas/JsonObject'
            formPrototype:
              type: object
              required:
                - id
                - name
              properties:
                id:
                  type: string
                  format: uuid
                name:
                  type: string
                  minLength: 1
    PublicQuestInvalidAuthDomainResponse:
      type: object
      required:
        - result
        - startTrigger
      properties:
        result:
          type: string
          enum:
            - INVALID_AUTH_DOMAIN
        startTrigger:
          type: object
          required:
            - id
            - config
            - formPrototype
          properties:
            id:
              type: string
              format: uuid
            config:
              $ref: '#/components/schemas/JsonObject'
            formPrototype:
              type: object
              required:
                - id
                - name
              properties:
                id:
                  type: string
                  format: uuid
                name:
                  type: string
                  minLength: 1
    GetPublicQuestResponse:
      oneOf:
        - $ref: '#/components/schemas/PublicQuestOkResponse'
        - $ref: '#/components/schemas/PublicQuestAuthenticationRequiredResponse'
        - $ref: '#/components/schemas/PublicQuestInvalidAuthDomainResponse'
      discriminator:
        propertyName: result
        mapping:
          OK: '#/components/schemas/PublicQuestOkResponse'
          AUTHENTICATION_REQUIRED: '#/components/schemas/PublicQuestAuthenticationRequiredResponse'
          INVALID_AUTH_DOMAIN: '#/components/schemas/PublicQuestInvalidAuthDomainResponse'
    QuestPrototypeStatus:
      type: string
      enum:
        - DRAFT
        - ACTIVE
        - ARCHIVED
    QuestMode:
      type: string
      enum:
        - SHARED_INSTANCE
        - INDIVIDUAL_INSTANCE
    QuestInstanceStatus:
      type: string
      enum:
        - OPEN
        - IN_REVIEW
        - COMPLETED
    QuestPrototypeListItem:
      required:
        - id
        - name
        - startedAt
        - status
        - mode
        - sharedInstance
        - assignments
      properties:
        id:
          type: string
          format: uuid
        name:
          type: string
          minLength: 1
          maxLength: 255
        status:
          $ref: '#/components/schemas/QuestPrototypeStatus'
        mode:
          $ref: '#/components/schemas/QuestMode'
        startedAt:
          deprecated: true
          type: string
          format: date-time
          nullable: true
        sharedInstance:
          oneOf:
            - type: object
              nullable: true
              additionalProperties: false
            - type: object
              required:
                - id
                - status
                - startedAt
                - itemInstances
              properties:
                id:
                  type: string
                  format: uuid
                status:
                  $ref: '#/components/schemas/QuestInstanceStatus'
                startedAt:
                  type: string
                  format: date-time
                  nullable: true
                itemInstances:
                  type: array
                  items:
                    type: object
                    required:
                      - completed
                      - isCompletionAction
                    properties:
                      completed:
                        type: boolean
                      isCompletionAction:
                        type: boolean
        assignments:
          type: array
          items:
            type: object
            required:
              - id
              - formInstance
              - assignee
            properties:
              id:
                type: string
                format: uuid
              formInstance:
                oneOf:
                  - type: object
                    nullable: true
                    additionalProperties: false
                  - type: object
                    required:
                      - id
                      - status
                      - startedAt
                    properties:
                      id:
                        type: string
                        format: uuid
                      status:
                        $ref: '#/components/schemas/QuestInstanceStatus'
                      startedAt:
                        type: string
                        format: date-time
                        nullable: true
              assignee:
                type: object
                required:
                  - id
                  - displayName
                  - avatarSmallUrl
                  - avatarLargeUrl
                properties:
                  id:
                    type: string
                    format: uuid
                  displayName:
                    type: string
                  avatarSmallUrl:
                    type: string
                    nullable: true
                  avatarLargeUrl:
                    type: string
                    nullable: true
    CreateQuestPrototypeRunDraftRequest:
      type: object
      required:
        - templateId
      properties:
        templateId:
          type: string
          format: uuid
        introText:
          type: string
        name:
          type: string
        publicSubmissionsEnabled:
          type: boolean
        inviteMessage:
          type: string
          nullable: true
        dueAt:
          type: string
          format: date-time
          nullable: true
        remindBeforeSeconds:
          type: number
          nullable: true
        alertBeforeSeconds:
          type: number
          nullable: true
        runSchedule:
          type: string
          nullable: true
        runScheduleTimezone:
