        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: instanceId
        description: 'Id of Quest Instance Reward is on.'
        required: true
        schema:
          type: string
          format: uuid
      - in: path
        name: rewardId
