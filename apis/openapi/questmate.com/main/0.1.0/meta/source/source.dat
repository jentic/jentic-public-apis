          description: 'Created Webhook.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Webhook'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
  '/webhooks/{id}':
    get:
      summary: 'Retrieve Webhook.'
      tags:
