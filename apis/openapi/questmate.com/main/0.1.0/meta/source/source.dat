    CustomItemPrototypeV1Request:
      type: object
      description: 'Custom Item V1 Request'
      required:
        - script
        - method
        - params
      properties:
        script:
          description: 'QuestScript code, must include `return defineCustomItem({...});`'
          type: string
        method:
          description: 'Which method to call. E.g. `renderFillout`, `renderConfig`'
          type: string
        params:
          description: 'Params to pass to method. E.g. [runState, configState]'
          type: array
          items:
            $ref: '#/components/schemas/JsonValue'
    CustomItemPrototypeV2Request:
      type: object
      description: 'Custom Item V2 Request'
      required:
        - script
        - events
      properties:
        script:
          description: 'QuestScript code, must include `return defineCustomItem({...}, (...) => {...});`'
          type: string
        timezone:
          type: string
        locale:
          type: string
        events:
          description: 'Which events to process.'
          type: array
          items:
            type: object
            required:
              - id
              - type
            properties:
              id:
                type: string
              type:
                type: string
              data: {}
        runPreviewState:
          type: object
          nullable: true
          description: '`runState` to use when rendering the Run View for preview purposes.'
        debugCommands:
          type: array
          items:
            type: string
            enum:
              - CLEAR_CACHE
              - CLEAR_CONFIG_STATE
