openapi: 3.0.0
info:
  title: 'Questmate API'
  version: 0.1.0
servers:
  - url: 'https://api.questmate.com'
security:
  - bearerAuth: []
tags:
  - name: Metadata
    description: 'Information about the API'
  - name: Quests
    description: 'Everything regarding Quests and their associated data'
  - name: Library
    description: 'Public Quest templates available to clone'
  - name: Profile
    description: 'Logged-in user''s profile data'
  - name: Workspaces
    description: 'Workspaces and WorkspaceMemberships data'
  - name: Users
    description: 'Limited access to other users'' data'
  - name: Webhooks
    description: 'For managing webhooks to subscribe to Questmate events'
paths:
  /openapi.yaml:
    get:
      summary: 'OpenAPI specification file'
      security: []
      tags:
        - Metadata
      responses:
        '200':
          description: 'Download this OpenAPI specification file'
          content:
            application/yaml:
              schema:
                type: string
                format: binary
  /health:
    get:
      summary: 'Endpoint to check general health of API.'
      security: []
      tags:
        - Metadata
      responses:
        '200':
          description: 'OK Health Response'
          content:
            application/json:
              schema:
                type: object
                properties:
                  status:
                    type: string
        '503':
          description: 'Degraded Health Response'
          content:
            application/json:
              schema:
                type: object
                properties:
                  status:
                    type: string
                  message:
                    type: string
  /questscript/executions:
    get:
      summary: 'Retrieve a list of Questscript Executions.'
      tags:
        - Quests
      parameters:
        - in: query
          name: triggerId
          required: true
          schema:
            type: string
        - in: query
          name: triggerType
          required: true
          schema:
            type: string
            enum:
              - ITEM_INSTANCE
      responses:
        '200':
          description: 'A list of Questscript Executions.'
          content:
            application/json:
              schema:
                type: array
                items:
                  anyOf:
                    - $ref: '#/components/schemas/QuestscriptExecutionListItem'
                    - $ref: '#/components/schemas/RestrictedQuestscriptExecutionListItem'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
  '/questscript/executions/{id}':
    get:
      summary: 'Retrieve a Questscript Execution by ID.'
      tags:
        - Quests
      parameters:
        - in: path
          name: id
          required: true
          schema:
            type: string
      responses:
        '200':
          description: 'A Questscript Execution.'
          content:
            application/json:
              schema:
                anyOf:
                  - $ref: '#/components/schemas/QuestscriptExecutionListItem'
                  - $ref: '#/components/schemas/RestrictedQuestscriptExecutionListItem'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
  /login:
    post:
      summary: 'Log in to Questmate.'
      security: []
      tags:
        - Profile
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                accessToken:
                  type: string
                postLoginTargetRoute:
                  nullable: true
                  type: object
                  required:
                    - screen
                    - path
                  properties:
                    screen:
                      type: string
                    params: {}
                    path:
                      type: string
      responses:
        '200':
          description: 'Login successful.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LoginResponse'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
  /me:
    get:
      summary: 'Retrieve user profile.'
      tags:
        - Profile
      responses:
        '200':
          description: 'Profile of the authenticated user.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserDetail'
        '401':
          $ref: '#/components/responses/Unauthorized'
    patch:
      summary: 'Update user profile.'
      tags:
        - Profile
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchUserRequest'
      responses:
        '200':
          description: 'Updated profile of the authenticated user.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserDetail'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
  /users:
    post:
      summary: 'Create users.'
      tags:
        - Users
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                identifiers:
                  type: array
                  items:
                    type: string
      responses:
        '200':
          description: 'List of Users'
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/CreateUsersResponse'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
    get:
      summary: 'Get users.'
      tags:
        - Users
      parameters:
        - in: query
          name: id
          description: 'Ids of Users to retrieve.'
          required: true
          schema:
            type: array
            items:
              type: string
              format: uuid
      responses:
        '200':
          description: 'List of Users'
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/UserListItem'
        '401':
          $ref: '#/components/responses/Unauthorized'
  /users/me/deletion/analyze:
    get:
      summary: 'Analyze user deletion impact.'
      tags:
        - Users
      responses:
        '200':
          description: 'Analysis of what will be deleted and any blocking issues.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserDeletionAnalysisResponse'
        '401':
          $ref: '#/components/responses/Unauthorized'
  /users/me/deletion:
    post:
      summary: 'Initiate user account deletion.'
      tags:
        - Users
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
      responses:
        '202':
          description: 'Deletion initiated successfully.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/UserDeletionInitiateResponse'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '409':
          $ref: '#/components/responses/Conflict'
  '/publicQuests/{publicId}':
    get:
      summary: 'Retrieve Public Quest.'
      security: []
      tags:
        - Quests
      responses:
        '200':
          description: 'Public Quest.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GetPublicQuestResponse'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: publicId
        description: 'Id of Public Quest to retrieve.'
        required: true
        schema:
          type: string
          format: uuid
  /quests:
    post:
      summary: 'Create Quest.'
      tags:
        - Quests
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/CreateQuestPrototypeRunDraftRequest'
      responses:
        '201':
          description: 'Created Quest.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/QuestPrototypeDetail'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
    get:
      summary: 'Retrieve Quest Prototypes.'
      tags:
        - Quests
      parameters:
        - in: query
          name: filterPreset
          schema:
            type: string
            enum:
              - OPEN
              - COMPLETED
        - in: query
          name: status
          schema:
            type: array
            items:
              $ref: '#/components/schemas/QuestPrototypeStatus'
        - in: query
          name: templateId
          schema:
            type: string
            format: uuid
          description: 'Include archived Quests.'
      responses:
        '200':
          description: 'An array of Quests.'
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/QuestPrototypeListItem'
        '401':
          $ref: '#/components/responses/Unauthorized'
  '/quests/{id}':
    get:
      summary: 'Retrieve Quest.'
      security: []
      tags:
        - Quests
      responses:
        '200':
          description: Quest.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/QuestPrototypeDetail'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    patch:
      summary: 'Update Quest.'
      tags:
        - Quests
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchQuestRequest'
      responses:
        '200':
          description: 'Updated Quest.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/QuestPrototypeDetail'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: id
        description: 'Id of Quest to retrieve.'
        required: true
        schema:
          type: string
          format: uuid
  '/quests/{questId}/runs/export':
    get:
      operationId: exportQuestRuns
      summary: 'Export Quest runs as CSV.'
      tags:
        - Quests
      parameters:
        - in: query
          name: startDate
          description: 'Filter runs started on or after this date (ISO 8601 format).'
          required: false
          schema:
            type: string
            format: date-time
        - in: query
          name: endDate
          description: 'Filter runs started on or before this date (ISO 8601 format).'
          required: false
          schema:
            type: string
            format: date-time
        - in: query
          name: archived
          description: 'Set to "include" to include archived runs.'
          required: false
          schema:
            type: string
            enum:
              - include
        - in: query
          name: limit
          description: 'Maximum number of runs to export.'
          required: false
          schema:
            type: integer
            minimum: 1
      responses:
        '200':
          description: 'CSV file containing Quest runs.'
          content:
            text/csv:
              schema:
                type: string
                format: binary
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: questId
        description: 'Id of Quest to export runs for.'
        required: true
        schema:
          type: string
          format: uuid
  '/quests/{questId}/runs/export/pdf':
    get:
      operationId: exportQuestRunsPdf
      summary: 'Export Quest runs as PDF (one page per run).'
      tags:
        - Quests
      parameters:
        - in: query
          name: startDate
          description: 'Filter runs started on or after this date (ISO 8601 format).'
          required: false
          schema:
            type: string
            format: date-time
        - in: query
          name: endDate
          description: 'Filter runs started on or before this date (ISO 8601 format).'
          required: false
          schema:
            type: string
            format: date-time
        - in: query
          name: archived
          description: 'Set to "include" to include archived runs.'
          required: false
          schema:
            type: string
            enum:
              - include
        - in: query
          name: limit
          description: 'Maximum number of runs to export.'
          required: false
          schema:
            type: integer
            minimum: 1
        - in: query
          name: pageSize
          description: 'Page size for the PDF (letter or a4). Defaults to letter.'
          required: false
          schema:
            type: string
            enum:
              - letter
              - a4
      responses:
        '200':
          description: 'PDF file containing Quest runs.'
          content:
            application/pdf:
              schema:
                type: string
                format: binary
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: questId
        description: 'Id of Quest to export runs for.'
        required: true
        schema:
          type: string
          format: uuid
  '/quests/{questId}/runs':
    get:
      summary: 'Retrieve Quest runs.'
      tags:
        - Quests
      parameters:
        - in: query
          name: status
          description: 'Quest Instance status to filter by.'
          required: false
          schema:
            type: array
            items:
              $ref: '#/components/schemas/QuestInstanceStatus'
        - in: query
          name: archived
          description: "Archived:\n * `include` - Both archived and non-archived\n * `true`    - Only archived\n * Default   - Only non-archived\n"
          required: false
          schema:
            type: string
            enum:
              - 'true'
              - include
        - in: query
          name: limit
          description: 'Number to retrieve.'
          required: false
          schema:
            type: number
            minimum: 1
        - in: query
          name: cursor
          description: 'Cursor to start from. Provided by a prior response.'
          required: false
          schema:
            type: string
            format: uuid
      responses:
        '200':
          description: 'Quest Runs.'
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                  - nextCursor
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/QuestInstanceListItem'
                  nextCursor:
                    type: string
                    nullable: true
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: questId
        description: 'Id of Quest to retrieve.'
        required: true
        schema:
          type: string
          format: uuid
  '/quests/{id}/assignments':
    get:
      summary: 'Retrieve Assignments on Quest.'
      tags:
        - Quests
      responses:
        '200':
          description: 'Array of Assignments.'
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/AssignmentOnQuest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    post:
      summary: 'Create Assignment.'
      tags:
        - Quests
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                userIds:
                  type: array
                  items:
                    type: string
                    format: uuid
                identifiers:
                  type: array
                  items:
                    type: string
      responses:
        '200':
          description: 'No new assignments created.'
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/AssignmentOnQuest'
                maxItems: 0
        '201':
          description: 'Created Assignment.'
          content:
            application/json:
              schema:
                type: array
                minItems: 1
                items:
                  $ref: '#/components/schemas/AssignmentOnQuest'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: id
        description: 'Id of Quest.'
        required: true
        schema:
          type: string
          format: uuid
  '/quests/{id}/assignments/{assignmentId}':
    get:
      summary: 'Retrieve Assignment.'
      tags:
        - Quests
      responses:
        '200':
          description: Assignment.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssignmentOnQuest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    delete:
      summary: 'Deletes an Assignment.'
      tags:
        - Quests
      responses:
        '200':
          description: 'The deleted Assignment.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AssignmentOnQuest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: id
        description: 'Id of Quest.'
        required: true
        schema:
          type: string
          format: uuid
      - in: path
        name: assignmentId
        description: 'Id of Assignment to retrieve.'
        required: true
        schema:
          type: string
          format: uuid
  '/quests/{questId}/scheduled-starts':
    delete:
      summary: 'Deletes a Scheduled Quest Start.'
      operationId: deleteScheduledQuestStartsByExternalId
      tags:
        - Quests
      parameters:
        - in: query
          name: externalId
          description: 'External ID provided when the scheduled start was created.'
          required: true
          schema:
            type: string
      responses:
        '200':
          description: 'The deleted Scheduled Quest Starts.'
          content:
            application/json:
              schema:
                type: array
                items:
                  type: object
                  required:
                    - id
                    - createdAt
                    - startAt
                    - scheduledByUserId
                    - runExternalId
                    - startConfiguration
                  properties:
                    id:
                      type: string
                      format: uuid
                    createdAt:
                      type: string
                    startAt:
                      type: string
                    scheduledByUserId:
                      type: string
                    runExternalId:
                      type: string
                      nullable: true
                    startConfiguration:
                      type: object
                      required:
                        - id
                        - formPrototypeId
                      properties:
                        id:
                          type: string
                        formPrototypeId:
                          type: string
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    get:
      summary: 'Gets Scheduled Quest Starts for a Quest.'
      tags:
        - Quests
      responses:
        '200':
          description: 'List of Scheduled Quest Starts.'
          content:
            application/json:
              schema:
                type: array
                items:
                  $ref: '#/components/schemas/ScheduledQuestStartListItem'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: questId
        description: 'Id of Quest. Not the form prototype.'
        required: true
        schema:
          type: string
          format: uuid
  '/quests/{questId}/scheduled-starts/{scheduledQuestStartId}':
    delete:
      summary: 'Deletes a Scheduled Quest Start.'
      operationId: deleteScheduledQuestStart
      tags:
        - Quests
      responses:
        '200':
          description: 'The deleted Scheduled Quest Start.'
          content:
            application/json:
              schema:
                type: object
                required:
                  - id
                  - createdAt
                  - startAt
                  - scheduledByUserId
                  - runExternalId
                  - startConfiguration
                properties:
                  id:
                    type: string
                    format: uuid
                  createdAt:
                    type: string
                  startAt:
                    type: string
                  scheduledByUserId:
                    type: string
                  runExternalId:
                    type: string
                    nullable: true
                  startConfiguration:
                    type: object
                    required:
                      - id
                      - formPrototypeId
                    properties:
                      id:
                        type: string
                      formPrototypeId:
                        type: string
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: questId
        description: 'Id of Quest. Not the form prototype.'
        required: true
        schema:
          type: string
          format: uuid
      - in: path
        name: scheduledQuestStartId
        description: 'Id of ScheduledQuestStart.'
        required: true
        schema:
          type: string
          format: uuid
  '/quests/{questId}/scheduled-starts/{scheduledQuestStartId}/start':
    post:
      summary: 'Start a configured ScheduledQuestStart immediately.'
      operationId: startScheduledQuest
      tags:
        - Quests
      responses:
        '200':
          description: 'List of started Quest Instances.'
          content:
            application/json:
              schema:
                type: object
                required:
                  - data
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/QuestInstanceListItem'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: questId
        description: 'Id of Quest. Not the form prototype.'
        required: true
        schema:
          type: string
          format: uuid
      - in: path
        name: scheduledQuestStartId
        description: 'Id of ScheduledQuestStart.'
        required: true
        schema:
          type: string
          format: uuid
  '/quests/{id}/items/{itemId}/custom':
    post:
      summary: 'Render Custom Item Config (or Preview) view.'
      tags:
        - Quests
      parameters:
        - in: path
          name: id
          description: 'Id of Quest Prototype.'
          required: true
          schema:
            type: string
            format: uuid
        - in: path
          name: itemId
          description: 'Id of Custom Item.'
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              oneOf:
                - $ref: '#/components/schemas/CustomItemPrototypeV1Request'
                - $ref: '#/components/schemas/CustomItemPrototypeV2Request'
      responses:
        '200':
          description: 'Custom item script evaluated.'
          content:
            application/json:
              schema:
                type: object
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
  '/quests/{id}/items':
    patch:
      summary: 'Update Quest Items.'
      tags:
        - Quests
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UpdateItemsRequest'
      responses:
        '200':
          description: 'Quest Items updated.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/QuestPrototypeDetail'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
      - in: path
        name: id
        description: 'Id of Quest.'
        required: true
        schema:
          type: string
          format: uuid
  '/quests/{id}/rewards':
    patch:
      summary: 'Update Quest Rewards.'
      tags:
        - Quests
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/UpdateRewardsRequest'
      responses:
        '200':
          description: 'Quest Rewards updated.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/QuestPrototypeDetail'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
    parameters:
