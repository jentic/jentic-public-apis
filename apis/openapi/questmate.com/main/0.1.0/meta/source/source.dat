        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '422':
          $ref: '#/components/responses/UnprocessableEntity'
  '/questInstances/{instanceId}/item/{itemId}':
    parameters:
      - in: path
        name: instanceId
        description: 'Id of Instance to update Item on.'
        required: true
        schema:
          type: string
          format: uuid
      - in: path
        name: itemId
        description: 'Id of Item to update.'
        required: true
        schema:
          type: string
    patch:
      summary: 'Update Item Instance.'
      tags:
        - Quests
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                version:
                  type: number
                data:
                  $ref: '#/components/schemas/JsonObject'
      responses:
        '200':
          description: 'Updated Item Instance.'
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ItemInstance'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '404':
          $ref: '#/components/responses/NotFound'
  '/questInstances/{instanceId}/item/{itemId}/uploadConfiguration':
    get:
      operationId: GetItemInstanceFileUploadConfiguration
      summary: 'Request pre-signed TransloadIt upload configuration for file uploads to a FileUploadV2 Item Instance.'
      tags:
        - Quests
      parameters:
        - in: path
          name: instanceId
          description: 'Id of Quest Instance.'
          required: true
          schema:
            type: string
            format: uuid
        - in: path
          name: itemId
          description: 'Id of Item Instance.'
          required: true
          schema:
            type: string
        - in: query
          name: sourceFileUrl
          description: 'URL of the file to upload.'
          required: false
          schema:
            type: string
      responses:
        '200':
          description: 'Pre-signed upload configuration generated successfully.'
          content:
            application/json:
              schema:
                type: object
                required:
                  - assemblyOptions
                  - expiresAt
                properties:
                  assemblyOptions:
                    type: object
                    description: 'Assembly Options for TransloadIt.'
                    required:
                      - params
                      - signature
                    properties:
                      params:
                        type: string
                        description: 'Stringified JSON params for TransloadIt.'
                      signature:
                        type: string
                        description: 'Signature validating params for use.'
                  expiresAt:
                    type: string
                    format: date-time
                    description: 'Configuration expiration timestamp.'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
  '/questInstances/{instanceId}/item/{itemId}/custom':
    post:
      summary: 'Evaluate custom component script.'
      tags:
        - Quests
      parameters:
        - in: path
          name: instanceId
          description: 'Id of Quest Instance.'
          required: true
          schema:
            type: string
            format: uuid
        - in: path
          name: itemId
          description: 'Id of Custom Item.'
          required: true
          schema:
            type: string
      requestBody:
        required: true
        content:
          application/json:
            schema:
              oneOf:
                - type: object
                  description: 'Custom Item V1 Request'
                  required:
                    - filloutData
                  properties:
                    filloutData:
                      $ref: '#/components/schemas/JsonObject'
                - type: object
                  description: 'Custom Item V2 Request'
                  required:
                    - events
                  properties:
                    timezone:
                      type: string
                    locale:
                      type: string
                    events:
                      description: 'Which events to process.'
                      type: array
                      items:
                        type: object
                        required:
                          - id
                          - type
                        properties:
                          id:
                            type: string
                          type:
                            type: string
                          payload: {}
      responses:
        '200':
          description: 'Quest component script evaluated.'
          content:
            application/json:
              schema:
                type: object
        '202':
          description: 'Events received successfully and will be processed asynchronously.'
          content:
            application/json:
              schema:
                type: object
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
  '/questInstances/{instanceId}/rewards/{rewardId}':
    get:
      summary: 'Retrieve Reward Instance.'
