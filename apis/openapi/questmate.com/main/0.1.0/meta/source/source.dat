        - questId
        - successUrl
        - cancelUrl
      properties:
        type:
          type: string
          enum:
            - QUEST_TEMPLATE
        questId:
          type: string
          format: uuid
        successUrl:
          type: string
        cancelUrl:
          type: string
        referralId:
          type: string
    StripeCheckoutRequest:
      type: object
      oneOf:
        - $ref: '#/components/schemas/StripeSubscriptionCheckoutRequest'
        - $ref: '#/components/schemas/StripeQuestTemplateCheckoutRequest'
      discriminator:
        propertyName: type
        mapping:
          SUBSCRIPTION: '#/components/schemas/StripeSubscriptionCheckoutRequest'
          QUEST_TEMPLATE: '#/components/schemas/StripeQuestTemplateCheckoutRequest'
    QuestTemplatePurchasedResult:
      type: object
      required:
        - status
        - purchasedAt
      properties:
        status:
          type: string
          enum:
            - PURCHASED
        purchasedAt:
          type: string
          format: date-time
    QuestTemplatePurchasableResult:
      type: object
      required:
        - status
        - price
      properties:
        status:
          type: string
          enum:
            - PURCHASABLE
        price:
          type: number
          minimum: 0
          description: 'USD cents'
    QuestTemplatePurchaseNotRequiredResult:
      type: object
      required:
        - status
      properties:
        status:
          type: string
          enum:
            - PURCHASE_NOT_REQUIRED
    QuestPurchaseStatus:
      type: object
      oneOf:
        - $ref: '#/components/schemas/QuestTemplatePurchasedResult'
        - $ref: '#/components/schemas/QuestTemplatePurchasableResult'
        - $ref: '#/components/schemas/QuestTemplatePurchaseNotRequiredResult'
      discriminator:
        propertyName: status
        mapping:
          PURCHASED: '#/components/schemas/QuestTemplatePurchasedResult'
          PURCHASABLE: '#/components/schemas/QuestTemplatePurchasableResult'
          PURCHASE_NOT_REQUIRED: '#/components/schemas/QuestTemplatePurchaseNotRequiredResult'
    PushToken:
      properties:
        token:
          type: string
    RecentQuestsListItem:
      required:
        - id
        - openRunsCount
        - lastRunAt
        - currentFormPrototype
        - workspace
        - owner
      properties:
        id:
          type: string
          format: uuid
        openRunsCount:
          type: number
        lastRunAt:
          type: string
          format: date-time
          nullable: true
        workspace:
          type: object
          nullable: true
          required:
            - id
          properties:
            id:
              type: string
              format: uuid
        owner:
          required:
            - id
          properties:
            id:
              type: string
              format: uuid
        currentFormPrototype:
          type: object
          required:
            - name
            - id
          properties:
            id:
              type: string
              format: uuid
            name:
              type: string
              minLength: 1
    MediaContext:
      properties:
        id:
          type: string
          format: uuid
        type:
          type: string
          enum:
            - questPrototype
            - questInstance
      required:
        - id
        - type
    Tokens:
      properties:
        mediaToken:
          type: string
        mediaPreviewToken:
          type: string
        mediaUploadSignature:
          type: string
        timestamp:
          type: number
        expires_at:
          type: number
        duration:
          type: number
        apiKey:
          type: string
        context:
          $ref: '#/components/schemas/MediaContext'
  responses:
    Unauthorized:
      description: Unauthorized
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/QMErrorResponse'
    NotFound:
      description: 'Not Found'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/QMErrorResponse'
    BadRequest:
      description: 'Bad request'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/QMErrorResponse'
    Forbidden:
      description: Forbidden
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/QMErrorResponse'
    Conflict:
      description: Conflict
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/QMErrorResponse'
    UnprocessableEntity:
      description: 'Unprocessable entity'
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/QMErrorResponse'
