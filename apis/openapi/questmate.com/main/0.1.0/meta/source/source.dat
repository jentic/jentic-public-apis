    RestartSubmissionBehavior:
      type: object
      required:
        - type
        - delaySeconds
        - buttonLabel
      properties:
        type:
          type: string
          enum:
            - RESTART
        delaySeconds:
          type: number
          minimum: 0
          maximum: 180
        buttonLabel:
          type: string
          minLength: 1
          maxLength: 128
        nextInstanceId:
          type: string
          format: uuid
    SubmissionBehavior:
      oneOf:
        - $ref: '#/components/schemas/DefaultSubmissionBehavior'
        - $ref: '#/components/schemas/RestartSubmissionBehavior'
      discriminator:
        propertyName: type
        mapping:
          DEFAULT: '#/components/schemas/DefaultSubmissionBehavior'
          RESTART: '#/components/schemas/RestartSubmissionBehavior'
    UpdateStartTriggerRequest:
      type: object
      properties:
        type:
          $ref: '#/components/schemas/QuestStartTriggerType'
        enabled:
          type: boolean
        config:
          $ref: '#/components/schemas/JsonObject'
        startConfiguration:
          type: object
          properties:
            dueAt:
              type: string
              format: date-time
              nullable: true
            dueAfterSeconds:
              type: number
              nullable: true
            allowOverdueSubmissions:
              type: boolean
            remindBeforeSeconds:
              type: number
              nullable: true
            alertBeforeSeconds:
              type: number
              nullable: true
            slideMode:
              type: boolean
            submissionBehavior:
              $ref: '#/components/schemas/SubmissionBehavior'
            assignees:
              type: array
              items:
                $ref: '#/components/schemas/UserReference'
            reviewers:
              type: array
              items:
                $ref: '#/components/schemas/UserReference'
    ItemInstance:
      required:
        - prototype
        - completed
        - data
        - version
        - isCompletionAction
        - subquestInstances
      properties:
        version:
          type: number
        data:
          $ref: '#/components/schemas/JsonObject'
        completed:
          type: boolean
        isCompletionAction:
          type: boolean
        prototype:
          type: object
          required:
            - id
            - name
            - position
            - required
            - type
            - isCompletionAction
            - referenceSlug
          properties:
            id:
              type: string
            name:
              type: string
            position:
              type: number
            required:
              type: boolean
            type:
              $ref: '#/components/schemas/ItemType'
            isCompletionAction:
              type: boolean
            referenceSlug:
              type: string
              nullable: true
        subquestInstances:
          type: array
          items:
            type: object
            required:
              - id
            properties:
              id:
                type: string
                format: uuid
    RewardInstance:
      required:
        - prototype
        - status
      properties:
        version:
          type: number
        data:
          $ref: '#/components/schemas/JsonObject'
        status:
          type: string
          enum:
            - WAITING_TO_START
            - PENDING
            - COMPLETED
            - FAILED
        prototype:
          type: object
          required:
            - id
          properties:
            id:
              type: string
    ReviewResult:
      type: string
      nullable: true
      enum:
        - APPROVED
        - CHANGES_REQUESTED
    RestrictedItemDetail:
      required:
        - id
        - name
        - type
        - infos
        - required
        - position
        - isCompletionAction
        - referenceSlug
      properties:
        id:
          type: string
        name:
          type: string
          minLength: 0
          maxLength: 255
        type:
          $ref: '#/components/schemas/ItemType'
        isCompletionAction:
          type: boolean
        required:
          type: boolean
        referenceSlug:
          type: string
          nullable: true
        infos:
          type: array
          items:
            $ref: '#/components/schemas/ItemInfo'
        subquest:
          type: object
          nullable: true
          required:
            - id
          properties:
            id:
              type: string
              format: uuid
        position:
          type: number
    RestrictedRewardDetail:
      type: object
