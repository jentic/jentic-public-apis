        - id
        - position
        - type
      properties:
        id:
          type: string
        type:
          $ref: '#/components/schemas/RewardType'
        position:
          type: number
    QuestInstanceDetail:
      required:
        - id
        - name
        - introText
        - status
        - archived
        - initialized
        - startedAt
        - completedAt
        - allowOverdueSubmissions
        - dueAt
        - alertAt
        - remindAt
        - slideMode
        - assignments
        - itemInstances
        - rewardInstances
        - prototype
        - requestingUser
        - quest
        - startedByUser
        - submittedByUser
        - submissionBehavior
        - parentFormInstanceId
        - parentItemPrototypeId
      properties:
        id:
          type: string
          format: uuid
        parentFormInstanceId:
          type: string
          nullable: true
          format: uuid
        parentItemPrototypeId:
          type: string
          nullable: true
        status:
          $ref: '#/components/schemas/QuestInstanceStatus'
        archived:
          type: boolean
        initialized:
          type: boolean
        name:
          type: string
        introText:
          type: string
        startedAt:
          type: string
          format: date-time
          nullable: true
        completedAt:
          type: string
          format: date-time
          nullable: true
        dueAt:
          type: string
          format: date-time
          nullable: true
        remindAt:
          type: string
          format: date-time
          nullable: true
        alertAt:
          type: string
          format: date-time
          nullable: true
        allowOverdueSubmissions:
          type: boolean
        slideMode:
          type: boolean
        submissionBehavior:
          $ref: '#/components/schemas/SubmissionBehavior'
        assignments:
          type: array
          items:
            type: object
            required:
              - id
              - assignee
            properties:
              id:
                type: string
                format: uuid
              assignee:
                type: object
                required:
                  - id
                  - displayName
                  - is_anonymous
                  - avatarSmallUrl
                  - avatarLargeUrl
                properties:
                  id:
                    type: string
                    format: uuid
                  displayName:
                    type: string
                  is_anonymous:
                    type: boolean
                  avatarSmallUrl:
                    type: string
                    nullable: true
                  avatarLargeUrl:
                    type: string
                    nullable: true
        submittedByUser:
          type: object
          nullable: true
          required:
            - id
            - displayName
            - is_anonymous
            - email_address
            - mobile_number
            - avatarSmallUrl
          properties:
            id:
              type: string
              format: uuid
            displayName:
              type: string
            is_anonymous:
              type: boolean
            avatarSmallUrl:
              anyOf:
                - $ref: '#/components/schemas/NullableString'
                - type: string
            email_address:
              anyOf:
                - $ref: '#/components/schemas/NullableString'
                - type: string
            mobile_number:
              anyOf:
                - $ref: '#/components/schemas/NullableString'
                - type: string
        startedByUser:
          type: object
          required:
            - id
            - displayName
            - avatarSmallUrl
          properties:
            id:
              type: string
              format: uuid
            displayName:
              type: string
            avatarSmallUrl:
              type: string
              nullable: true
        itemInstances:
          type: array
          items:
            $ref: '#/components/schemas/ItemInstance'
        rewardInstances:
          type: array
          items:
            $ref: '#/components/schemas/RewardInstance'
        requestingUser:
          type: object
          required:
            - instanceRoles
          properties:
            reviewResult:
              $ref: '#/components/schemas/ReviewResult'
            instanceRoles:
              type: array
              items:
                type: string
                enum:
                  - OWNER
                  - ASSIGNEE
                  - REVIEWER
        quest:
          type: object
          required:
            - id
          properties:
            id:
              type: string
        prototype:
          required:
            - id
            - name
            - introText
            - slideMode
            - items
            - rewards
            - status
            - owner
            - quest
            - dueAt
            - startedAt
            - allowOverdueSubmissions
          properties:
            id:
              type: string
              format: uuid
            name:
              type: string
            status:
              $ref: '#/components/schemas/QuestPrototypeStatus'
            slideMode:
              type: boolean
            introText:
              type: string
            allowOverdueSubmissions:
              type: boolean
            dueAt:
              type: string
              format: date-time
              nullable: true
            startedAt:
              deprecated: true
              type: string
              format: date-time
              nullable: true
            items:
              type: array
              items:
                $ref: '#/components/schemas/RestrictedItemDetail'
            rewards:
              type: array
              items:
                $ref: '#/components/schemas/RestrictedRewardDetail'
            owner:
              type: object
              required:
                - id
                - displayName
                - avatarSmallUrl
              properties:
                id:
                  type: string
                  format: uuid
                displayName:
                  type: string
                avatarSmallUrl:
                  type: string
                  nullable: true
            quest:
              required:
                - id
                - owner
              properties:
                id:
                  type: string
                owner:
                  type: object
                  required:
                    - id
                    - displayName
                  properties:
                    id:
                      type: string
                      format: uuid
                    displayName:
                      type: string
