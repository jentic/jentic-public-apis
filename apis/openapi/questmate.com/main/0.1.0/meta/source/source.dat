        description: 'Ids of Templates to retrieve Quest Instances for.'
        required: true
        schema:
          type: array
          items:
            type: string
            format: uuid
  '/questInstances/{questInstanceId}':
    get:
      summary: 'Retrieve Quest Instance.'
