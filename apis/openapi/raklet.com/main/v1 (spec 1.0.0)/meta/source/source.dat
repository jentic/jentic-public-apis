              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RakletListResponse_ActionLogApiDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RakletListResponse_ActionLogApiDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or expired bearer token."
          },
          "403": {
            "description": "The token's user cannot access this organisation or resource."
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "oauth2Password": []
          }
        ],
        "x-raklet-access": "Premium plan (API access); token inherits the admin user's role permissions"
      }
    },
