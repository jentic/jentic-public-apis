    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Access token from POST /token. The token inherits the admin user's role-based permissions in Raklet; there are no narrower scopes."
      },
      "oauth2Password": {
        "type": "oauth2",
        "description": "OAuth 2.0 resource owner password grant against POST /token, using a Raklet admin user's email and password. Raklet does not define named scopes: every token is granted the full role-based permissions of the user it was issued to, so `scopes` is empty by design.",
        "flows": {
          "password": {
            "tokenUrl": "https://api.raklet.com/token",
            "scopes": {}
          }
        }
      }
    },
