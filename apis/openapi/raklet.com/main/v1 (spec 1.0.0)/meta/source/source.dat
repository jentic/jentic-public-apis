  "paths": {
    "/token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "Auth_GetAccessToken",
        "summary": "Get an access token (OAuth 2.0 password grant)",
        "description": "Exchange a Raklet admin user's email and password for a bearer token. Send the fields as application/x-www-form-urlencoded with grant_type=password. The response is `{\"access_token\": \"...\", \"token_type\": \"bearer\", \"expires_in\": 3600}`; put the access_token in an `Authorization: Bearer` header on every other request. Tokens expire after about an hour and can be re-requested at any time.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type",
                  "username",
                  "password"
                ],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "password"
                    ],
                    "default": "password",
                    "description": "Always `password`."
                  },
                  "username": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address of a Raklet admin user."
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "description": "That user's Raklet password."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "access_token",
                    "token_type",
                    "expires_in"
                  ],
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string",
                      "enum": [
                        "bearer"
                      ]
                    },
                    "expires_in": {
                      "type": "integer",
                      "description": "Lifetime in seconds."
                    },
                    "userName": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "invalid_grant: the credentials were not accepted."
          }
        },
        "security": [],
        "x-raklet-access": "No token required"
      }
    },
    "/app/actionlogs": {
      "get": {
        "tags": [
          "ActionLogs"
        ],
        "operationId": "ActionLogs_GetActionLogs",
        "summary": "List actionlogs",
