{
  "openapi": "3.0.3",
  "info": {
    "title": "Twelve Data API",
    "description": "Financial data API providing real-time and historical stock, forex, cryptocurrency, ETF, fund, commodity, and bond data. Supports time series, quotes, technical indicators, and market metadata.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://twelvedata.com/docs",
    "x-jentic-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.twelvedata.com"
    }
  ],
  "security": [
    {
      "apiKeyQuery": [],
      "apiKeyHeader": []
    }
  ],
  "paths": {
    "/time_series": {
      "get": {
        "operationId": "getTimeSeries",
        "summary": "Get time series data (OHLCV)",
        "description": "Returns time series of OHLCV data for a given symbol and interval.",
        "parameters": [
          { "name": "symbol", "in": "query", "required": true, "description": "Instrument symbol (e.g., AAPL, EUR/USD, BTC/USD).", "schema": { "type": "string" } },
          { "name": "interval", "in": "query", "required": true, "description": "Time interval (1min, 5min, 15min, 30min, 45min, 1h, 2h, 4h, 1day, 1week, 1month).", "schema": { "type": "string" } },
          { "name": "exchange", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "mic_code", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "country", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "type", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "outputsize", "in": "query", "required": false, "description": "Number of data points (default 30, max 5000).", "schema": { "type": "integer", "default": 30 } },
          { "name": "format", "in": "query", "required": false, "schema": { "type": "string", "enum": ["JSON", "CSV"], "default": "JSON" } },
          { "name": "start_date", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "end_date", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "timezone", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "order", "in": "query", "required": false, "schema": { "type": "string", "enum": ["ASC", "DESC"], "default": "DESC" } }
        ],
        "responses": {
          "200": {
            "description": "Time series data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "meta": {
                      "type": "object",
                      "properties": {
                        "symbol": { "type": "string" },
                        "interval": { "type": "string" },
                        "currency": { "type": "string" },
                        "exchange_timezone": { "type": "string" },
                        "exchange": { "type": "string" },
                        "type": { "type": "string" }
                      }
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "datetime": { "type": "string" },
                          "open": { "type": "string" },
                          "high": { "type": "string" },
                          "low": { "type": "string" },
                          "close": { "type": "string" },
                          "volume": { "type": "string" }
                        }
                      }
                    },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Invalid API key." },
          "429": { "description": "Rate limit exceeded." }
        }
      }
    },
    "/quote": {
      "get": {
        "operationId": "getQuote",
        "summary": "Get real-time quote",
        "description": "Returns real-time price quote with OHLCV, change, and volume data.",
        "parameters": [
          { "name": "symbol", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "interval", "in": "query", "required": false, "schema": { "type": "string", "default": "1day" } },
          { "name": "exchange", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "mic_code", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "country", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "volume_time_period", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "type", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Quote data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "symbol": { "type": "string" },
                    "name": { "type": "string" },
                    "exchange": { "type": "string" },
                    "datetime": { "type": "string" },
                    "timestamp": { "type": "integer" },
                    "open": { "type": "string" },
                    "high": { "type": "string" },
                    "low": { "type": "string" },
                    "close": { "type": "string" },
                    "volume": { "type": "string" },
                    "previous_close": { "type": "string" },
                    "change": { "type": "string" },
                    "percent_change": { "type": "string" },
                    "average_volume": { "type": "string" },
                    "fifty_two_week": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/price": {
      "get": {
        "operationId": "getPrice",
        "summary": "Get latest price",
        "description": "Returns the latest price for a given symbol.",
        "parameters": [
          { "name": "symbol", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "exchange", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "mic_code", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "country", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "type", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Latest price.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "price": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/eod": {
      "get": {
        "operationId": "getEndOfDay",
        "summary": "Get end of day price",
        "parameters": [
          { "name": "symbol", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "exchange", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "mic_code", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "country", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "End of day data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "symbol": { "type": "string" },
                    "exchange": { "type": "string" },
                    "datetime": { "type": "string" },
                    "close": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/market_movers/{market}": {
      "get": {
        "operationId": "getMarketMovers",
        "summary": "Get top market movers (gainers/losers)",
        "parameters": [
          { "name": "market", "in": "path", "required": true, "description": "Market type.", "schema": { "type": "string", "enum": ["stocks", "etf", "crypto", "forex"] } },
          { "name": "direction", "in": "query", "required": false, "schema": { "type": "string", "enum": ["gainers", "losers"] } },
          { "name": "outputsize", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "country", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Market movers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "values": { "type": "array", "items": { "type": "object" } },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/symbol_search": {
      "get": {
        "operationId": "symbolSearch",
        "summary": "Search for symbols",
        "parameters": [
          { "name": "symbol", "in": "query", "required": true, "description": "Search query.", "schema": { "type": "string" } },
          { "name": "outputsize", "in": "query", "required": false, "schema": { "type": "integer", "default": 30 } }
        ],
        "responses": {
          "200": {
            "description": "Matching symbols.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "symbol": { "type": "string" },
                          "instrument_name": { "type": "string" },
                          "exchange": { "type": "string" },
                          "mic_code": { "type": "string" },
                          "exchange_timezone": { "type": "string" },
                          "instrument_type": { "type": "string" },
                          "country": { "type": "string" },
                          "currency": { "type": "string" }
                        }
                      }
                    },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/stocks": {
      "get": {
        "operationId": "listStocks",
        "summary": "List available stocks",
        "parameters": [
          { "name": "exchange", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "mic_code", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "country", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "type", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Stock listings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "symbol": { "type": "string" },
                          "name": { "type": "string" },
                          "currency": { "type": "string" },
                          "exchange": { "type": "string" },
                          "mic_code": { "type": "string" },
                          "country": { "type": "string" },
                          "type": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/forex_pairs": {
      "get": {
        "operationId": "listForexPairs",
        "summary": "List available forex pairs",
        "parameters": [
          { "name": "currency_base", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "currency_quote", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Forex pair listings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cryptocurrencies": {
      "get": {
        "operationId": "listCryptocurrencies",
        "summary": "List available cryptocurrency pairs",
        "parameters": [
          { "name": "exchange", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "currency_base", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "currency_quote", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Cryptocurrency listings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/etfs": {
      "get": {
        "operationId": "listETFs",
        "summary": "List available ETFs",
        "parameters": [
          { "name": "exchange", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "country", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "ETF listings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/exchanges": {
      "get": {
        "operationId": "listExchanges",
        "summary": "List available exchanges",
        "parameters": [
          { "name": "type", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "name", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "code", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "country", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Exchange listings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/market_state": {
      "get": {
        "operationId": "getMarketState",
        "summary": "Get current market state (open/closed)",
        "parameters": [
          { "name": "exchange", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "code", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "country", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Market state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "type": "object" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/earliest_timestamp": {
      "get": {
        "operationId": "getEarliestTimestamp",
        "summary": "Get earliest available data timestamp",
        "parameters": [
          { "name": "symbol", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "interval", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "exchange", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Earliest timestamp.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "datetime": { "type": "string" },
                    "unix_time": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/technical_indicators": {
      "get": {
        "operationId": "listTechnicalIndicators",
        "summary": "List available technical indicators",
        "responses": {
          "200": {
            "description": "Technical indicator list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": { "type": "object" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "apikey",
        "description": "Twelve Data API key passed as a query parameter."
      },
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "API key passed in header as 'apikey YOUR_API_KEY'."
      }
    }
  }
}
