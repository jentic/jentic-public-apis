{
  "openapi": "3.0.0",
  "info": {
    "title": "Yummy Calorie Log API",
    "version": "1.0.0",
    "description": "API for managing user accounts, calorie logging, and AI-powered food scanning",
    "contact": {
      "url": "https://yummyyummy.site"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/dev-7dd/yummy/1.0.0"
  },
  "servers": [
    {
      "url": "https://yummyyummy.site",
      "description": "Production server"
    },
    {
      "url": "https://virtserver.swaggerhub.com/dev-7dd/yummy/1.0.0",
      "description": "SwaggerHub API Auto Mocking"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token obtained from login or registration (expires in 30 days)"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Unique user identifier",
            "example": "665f1c0b3a4a9b0012ab34cd"
          },
          "username": {
            "type": "string",
            "description": "Unique username",
            "example": "matthew"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User email address",
            "example": "matthew@example.com"
          },
          "verified": {
            "type": "boolean",
            "description": "Email verification status",
            "example": true
          },
          "calorieGoal": {
            "type": "number",
            "description": "Daily calorie goal",
            "example": 2000
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-11-17T10:30:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-11-17T10:30:00Z"
          }
        },
        "required": [
          "_id",
          "username",
          "email",
          "verified"
        ]
      },
      "RegisterUserRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "matthew"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "matthew@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "SecurePass123!"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "RegisterUserResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "User registered successfully. Please check your email to verify your account."
          }
        },
        "required": [
          "message"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "matthew@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SecurePass123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "665f1c0b3a4a9b0012ab34cd"
          },
          "username": {
            "type": "string",
            "example": "matthew"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "matthew@example.com"
          },
          "token": {
            "type": "string",
            "description": "JWT bearer token (expires in 30 days)",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "_id",
          "username",
          "email",
          "token"
        ]
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "matthew@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ForgotPasswordResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "If an account with that email exists, a password reset link has been sent."
          }
        },
        "required": [
          "message"
        ]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "NewSecurePass123!"
          }
        },
        "required": [
          "newPassword"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "format": "password",
            "example": "OldPass123!"
          },
          "newPassword": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "NewPass123!"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "CalorieLog": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Unique log identifier",
            "example": "666abc1234ff9900123abcd0"
          },
          "userId": {
            "type": "string",
            "description": "User who owns this log",
            "example": "665f1c0b3a4a9b0012ab34cd"
          },
          "meal": {
            "type": "string",
            "description": "Name or description of the meal",
            "example": "Chicken bowl"
          },
          "calories": {
            "type": "number",
            "minimum": 0,
            "description": "Total calories",
            "example": 650
          },
          "protein": {
            "type": "number",
            "minimum": 0,
            "description": "Protein in grams",
            "example": 40
          },
          "carbs": {
            "type": "number",
            "minimum": 0,
            "description": "Carbohydrates in grams",
            "example": 60
          },
          "fats": {
            "type": "number",
            "minimum": 0,
            "description": "Fats in grams",
            "example": 20
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date of the meal (YYYY-MM-DD)",
            "example": "2025-11-17"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-11-17T10:30:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2025-11-17T10:30:00Z"
          }
        },
        "required": [
          "_id",
          "userId",
          "meal",
          "calories",
          "protein",
          "carbs",
          "fats",
          "date"
        ]
      },
      "CreateCalorieLogRequest": {
        "type": "object",
        "properties": {
          "meal": {
            "type": "string",
            "description": "Name or description of the meal",
            "example": "Chicken bowl"
          },
          "calories": {
            "type": "number",
            "minimum": 0,
            "description": "Total calories",
            "example": 650
          },
          "protein": {
            "type": "number",
            "minimum": 0,
            "description": "Protein in grams",
            "example": 40
          },
          "carbs": {
            "type": "number",
            "minimum": 0,
            "description": "Carbohydrates in grams",
            "example": 60
          },
          "fats": {
            "type": "number",
            "minimum": 0,
            "description": "Fats in grams",
            "example": 20
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date of the meal (YYYY-MM-DD)",
            "example": "2025-11-17"
          }
        },
        "required": [
          "meal",
          "calories",
          "protein",
          "carbs",
          "fats",
          "date"
        ]
      },
      "CreateCalorieLogResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Calorie log added successfully"
          },
          "calorieLog": {
            "$ref": "#/components/schemas/CalorieLog"
          }
        },
        "required": [
          "message",
          "calorieLog"
        ]
      },
      "UpdateCalorieLogRequest": {
        "type": "object",
        "properties": {
          "meal": {
            "type": "string",
            "description": "Name or description of the meal",
            "example": "Grilled chicken bowl"
          },
          "calories": {
            "type": "number",
            "minimum": 0,
            "description": "Total calories",
            "example": 680
          },
          "protein": {
            "type": "number",
            "minimum": 0,
            "description": "Protein in grams",
            "example": 45
          },
          "carbs": {
            "type": "number",
            "minimum": 0,
            "description": "Carbohydrates in grams",
            "example": 62
          },
          "fats": {
            "type": "number",
            "minimum": 0,
            "description": "Fats in grams",
            "example": 22
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date of the meal (YYYY-MM-DD)",
            "example": "2025-11-18"
          }
        },
        "description": "All fields are optional for updates"
      },
      "UpdateCalorieLogResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Calorie log updated successfully"
          },
          "calorieLog": {
            "$ref": "#/components/schemas/CalorieLog"
          }
        },
        "required": [
          "message",
          "calorieLog"
        ]
      },
      "GetCalorieLogsResponse": {
        "type": "object",
        "properties": {
          "meals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalorieLog"
            }
          }
        },
        "required": [
          "meals"
        ]
      },
      "GetCalorieLogsByDateResponse": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2025-11-17"
          },
          "meals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalorieLog"
            }
          },
          "totalCalories": {
            "type": "number",
            "example": 1850
          },
          "totalProtein": {
            "type": "number",
            "example": 120
          },
          "totalCarbs": {
            "type": "number",
            "example": 180
          },
          "totalFats": {
            "type": "number",
            "example": 65
          }
        },
        "required": [
          "date",
          "meals",
          "totalCalories",
          "totalProtein",
          "totalCarbs",
          "totalFats"
        ]
      },
      "DeleteCalorieLogResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Calorie log deleted successfully"
          }
        },
        "required": [
          "message"
        ]
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "matthew_updated"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "newemail@example.com"
          },
          "calorieGoal": {
            "type": "number",
            "example": 2200
          }
        },
        "description": "All fields are optional for updates"
      },
      "GetUserByUsernameResponse": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "matthew"
          },
          "meals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalorieLog"
            }
          }
        },
        "required": [
          "username",
          "meals"
        ]
      },
      "FoodScanRequest": {
        "type": "object",
        "properties": {
          "imageUrl": {
            "type": "string",
            "description": "Public URL to the food image",
            "example": "https://example.com/my-food-photo.jpg"
          },
          "imageBase64": {
            "type": "string",
            "description": "Base64-encoded image data with or without data URL prefix",
            "example": "/9j/4AAQSkZJRgABAQEAYABgAAD/2wBD..."
          }
        },
        "description": "Either imageUrl or imageBase64 is required"
      },
      "FoodItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Identified food item name",
            "example": "Pizza slice"
          },
          "quantity": {
            "type": "string",
            "description": "Estimated quantity",
            "example": "1 slice"
          },
          "calories": {
            "type": "number",
            "description": "Estimated calories",
            "example": 280
          },
          "protein": {
            "type": "number",
            "description": "Estimated protein in grams",
            "example": 12
          },
          "carbs": {
            "type": "number",
            "description": "Estimated carbs in grams",
            "example": 30
          },
          "fats": {
            "type": "number",
            "description": "Estimated fats in grams",
            "example": 10
          }
        },
        "required": [
          "name",
          "calories",
          "protein",
          "carbs",
          "fats"
        ]
      },
      "FoodScanResponse": {
        "type": "object",
        "properties": {
          "foods": {
            "type": "array",
            "description": "Detected food items in the image",
            "items": {
              "$ref": "#/components/schemas/FoodItem"
            }
          },
          "totalCalories": {
            "type": "number",
            "description": "Sum of all food calories",
            "example": 850
          },
          "totalProtein": {
            "type": "number",
            "description": "Sum of all food protein",
            "example": 42
          },
          "totalCarbs": {
            "type": "number",
            "description": "Sum of all food carbs",
            "example": 95
          },
          "totalFats": {
            "type": "number",
            "description": "Sum of all food fats",
            "example": 28
          }
        },
        "required": [
          "foods",
          "totalCalories",
          "totalProtein",
          "totalCarbs",
          "totalFats"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Human-readable error message",
            "example": "Invalid email or password"
          }
        },
        "required": [
          "message"
        ]
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Success message",
            "example": "Operation completed successfully"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  },
  "paths": {
    "/api/users": {
      "post": {
        "summary": "Register a new user",
        "description": "Create a new user account and send verification email",
        "tags": [
          "Users"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User successfully registered, verification email sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterUserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or user already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingFields": {
                    "value": {
                      "message": "Please provide username, email, and password"
                    }
                  },
                  "duplicateEmail": {
                    "value": {
                      "message": "User with this email already exists"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (email sending failed or server error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "emailFailed": {
                    "value": {
                      "message": "Failed to send verification email: SMTP connection failed"
                    }
                  },
                  "configError": {
                    "value": {
                      "message": "CLIENT_URL environment variable is not set"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get all users",
        "description": "Retrieve list of all users (admin/demo endpoint)",
        "tags": [
          "Users"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of users retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid or missing token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "summary": "Login user",
        "description": "Authenticate user and receive a JWT token (30-day expiration)",
        "tags": [
          "Users"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Please provide email and password"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Invalid email or password"
                }
              }
            }
          },
          "403": {
            "description": "Email not verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Please verify your email first"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/forgot-password": {
      "post": {
        "summary": "Request password reset",
        "description": "Send password reset email to user (returns success even if email doesn't exist for security)",
        "tags": [
          "Users"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset email sent if user exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForgotPasswordResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Please provide an email address"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (email sending failed or config error)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "emailFailed": {
                    "value": {
                      "message": "Failed to send password reset email: SMTP connection failed"
                    }
                  },
                  "configError": {
                    "value": {
                      "message": "CLIENT_URL environment variable is not set"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/users/reset-password/{token}": {
      "post": {
        "summary": "Reset password",
        "description": "Reset user password using the token from the reset email (1-hour expiration)",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Password reset token from email"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "message": "Password has been reset successfully"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingPassword": {
                    "value": {
                      "message": "Please provide a new password"
                    }
                  },
                  "shortPassword": {
                    "value": {
                      "message": "Password must be at least 6 characters long"
                    }
                  },
                  "invalidToken": {
                    "value": {
                      "message": "Invalid or expired reset token"
                    }
                  },
                  "wrongTokenType": {
                    "value": {
                      "message": "Invalid reset token"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "User not found"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/verify/{token}": {
      "get": {
        "summary": "Verify email",
        "description": "Verify user email address using token from verification email (24-hour expiration)",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Email verification token"
          }
        ],
        "responses": {
          "200": {
            "description": "Email verified successfully",
            "content": {
              "application/json": {
                "schema": {
