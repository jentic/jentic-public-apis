    "/api/food-scan": {
      "post": {
        "summary": "Scan food from image",
        "description": "Use AI (GPT-4o-mini via OpenRouter) to identify food items and estimate nutritional information from an image",
        "tags": [
          "Food Scan"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FoodScanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Food scan completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FoodScanResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "Either imageUrl or imageBase64 is required"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "message": "User not authenticated"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (API configuration error or AI model failure)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "configError": {
                    "value": {
                      "message": "OpenRouter API key not configured"
                    }
                  },
                  "aiError": {
                    "value": {
                      "message": "No response from AI model"
                    }
                  },
                  "parseError": {
                    "value": {
                      "message": "Invalid response format from AI"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
