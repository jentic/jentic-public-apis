{
  "openapi": "3.0.3",
  "info": {
    "title": "Toolhouse API",
    "description": "Agent tool platform API. Manage AI agents, tools, agent runs, schedules, and key-value storage. Toolhouse provides a Backend-as-a-Service for building, running, and managing AI agents with tool-use capabilities.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://docs.toolhouse.ai/",
    "x-provenance": "jentic-generated"
  },
  "servers": [
    {
      "url": "https://api.toolhouse.ai",
      "description": "Toolhouse API"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v1/get_tools": {
      "post": {
        "operationId": "getTools",
        "summary": "Get Tools",
        "description": "Get available tools for an agent based on the provided messages and metadata. Returns tool definitions that can be passed to an LLM.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "description": "LLM provider (e.g., openai, anthropic)"
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Metadata including user ID and timezone"
                  },
                  "bundle": {
                    "type": "string",
                    "description": "Tool bundle name to filter tools"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of available tools",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/run_tools": {
      "post": {
        "operationId": "runTools",
        "summary": "Run Tools",
        "description": "Execute tool calls requested by an LLM. Processes tool call results and returns the outputs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "description": "LLM provider"
                  },
                  "metadata": {
                    "type": "object",
                    "description": "Metadata including user ID"
                  },
                  "content": {
                    "type": "object",
                    "description": "LLM response containing tool calls"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool execution results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agent-runs": {
      "get": {
        "operationId": "getAllAgentRuns",
        "summary": "Get All Agent Runs",
        "description": "List all agent execution runs.",
        "responses": {
          "200": {
            "description": "List of agent runs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentRun"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createAgentRun",
        "summary": "Create Agent Run",
        "description": "Create a new agent run to execute an agent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agent_id": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "vars": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent run created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRun"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agent-runs/{run_id}": {
      "get": {
        "operationId": "getAgentRun",
        "summary": "Get Agent Run",
        "description": "Get details of a specific agent run.",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent run details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRun"
                }
              }
            }
          },
          "404": {
            "description": "Run not found"
          }
        }
      },
      "put": {
        "operationId": "updateAgentRun",
        "summary": "Update Agent Run",
        "description": "Update an existing agent run (e.g., continue a conversation).",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent run updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRun"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agents": {
      "get": {
        "operationId": "getAllAgents",
        "summary": "Get All Agents",
        "description": "List all agents.",
        "responses": {
          "200": {
            "description": "List of agents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Agent"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "upsertAgent",
        "summary": "Upsert Agent",
        "description": "Create or update an agent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "system_prompt": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent created or updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agents/{agent_id}": {
      "get": {
        "operationId": "getAgent",
        "summary": "Get Agent",
        "description": "Get agent details by ID.",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "editAgent",
        "summary": "Edit Agent",
        "description": "Fully replace an agent configuration.",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent updated"
          }
        }
      },
      "patch": {
        "operationId": "patchAgent",
        "summary": "Patch Agent",
        "description": "Partially update an agent configuration.",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent patched"
          }
        }
      },
      "delete": {
        "operationId": "deleteAgent",
        "summary": "Delete Agent",
        "description": "Delete an agent.",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent deleted"
          }
        }
      }
    },
    "/v1/agents/{agent_id}/clone": {
      "post": {
        "operationId": "cloneAgent",
        "summary": "Clone Agent",
        "description": "Create a copy of an existing agent.",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent cloned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          }
        }
      }
    },
    "/v1/agents/{agent_id}/files": {
      "get": {
        "operationId": "getAgentFiles",
        "summary": "Get Agent Files",
        "description": "List files associated with an agent.",
        "parameters": [
          {
            "name": "agent_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of agent files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/schedules": {
      "get": {
        "operationId": "getScheduleList",
        "summary": "Get Schedule List",
        "description": "List all agent schedules.",
        "responses": {
          "200": {
            "description": "List of schedules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Schedule"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createSchedule",
        "summary": "Create Schedule",
        "description": "Create a new agent execution schedule.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agent_id": {
                    "type": "string"
                  },
                  "cron": {
                    "type": "string",
                    "description": "Cron expression for the schedule"
                  },
                  "message": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Schedule created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Schedule"
                }
              }
            }
          }
        }
      }
    },
    "/v1/schedules/{schedule_id}": {
      "get": {
        "operationId": "getScheduleById",
        "summary": "Get Schedule by ID",
        "description": "Get schedule details.",
        "parameters": [
          {
            "name": "schedule_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Schedule details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Schedule"
                }
              }
            }
          }
        }
      }
    },
    "/v1/schedules/text-to-cron": {
      "get": {
        "operationId": "textToCron",
        "summary": "Text to Cron",
        "description": "Convert a natural language description to a cron expression.",
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Natural language schedule description"
          }
        ],
        "responses": {
          "200": {
            "description": "Cron expression",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cron": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/kv": {
      "get": {
        "operationId": "getAllKv",
        "summary": "Get All Key-Value Pairs",
        "description": "List all key-value pairs in storage.",
        "responses": {
          "200": {
            "description": "List of key-value pairs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "upsertKv",
        "summary": "Upsert Key-Value Pair",
        "description": "Create or update a key-value pair.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["key", "value"],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Key-value pair upserted"
          }
        }
      }
    },
    "/v1/kv/{key}": {
      "delete": {
        "operationId": "deleteKv",
        "summary": "Delete Key-Value Pair",
        "description": "Delete a key-value pair by key.",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Key-value pair deleted"
          }
        }
      }
    },
    "/v1/users": {
      "get": {
        "operationId": "getUsers",
        "summary": "Get Users",
        "description": "Get user information.",
        "responses": {
          "200": {
            "description": "User information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cli/version": {
      "get": {
        "operationId": "getCliVersion",
        "summary": "Get CLI Version",
        "description": "Get the latest CLI version information.",
        "responses": {
          "200": {
            "description": "CLI version info",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Toolhouse API key as Bearer token"
      }
    },
    "schemas": {
      "Agent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "system_prompt": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AgentRun": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Schedule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "cron": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
