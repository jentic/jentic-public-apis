        "description": "Use this endpoint to enable or disable specific maintenance modes for a device.\r\n            \r\n**Maintenance Mode IDs:**\r\n* **Application Control Monitor**: `1`\r\n* **Application Control Installation**: `2`\r\n* **Application Control Learning**: `3`\r\n* **Network Control Monitor**: `17`\r\n* **Storage Control Monitor**: `18`\r\n            \r\n**OS Type IDs:**\r\n* **Windows**: `1`\r\n* **MAC**: `2`\r\n* **Linux**: `3`",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "applicationId": {
                    "type": "string"
                  },
                  "computerDetailDto": {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string"
                      },
                      "computerId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "computerGroupId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "computerName": {
                        "type": "string"
                      },
                      "computerInstallDate": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "isIsolated": {
                        "type": "boolean"
                      },
                      "isLockedOut": {
                        "type": "boolean"
                      },
                      "lastVersionChange": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "maintenanceTypeId": {
                        "type": "integer"
                      },
                      "maintenanceEndDate": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "monitorOnlyDateTime": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "organizationId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "osType": {
                        "type": "integer"
                      },
                      "pendingBaseFiles": {
                        "type": "boolean"
                      },
                      "threatLockerVersion": {
                        "type": "string"
                      },
                      "threatLockerVersionId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "threatLockerVersionGroup": {
                        "type": "string"
                      },
