                    "type": "string"
                  },
                  "dateTime": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "groupBy": {
                    "type": "string"
                  },
                  "pageNumber": {
                    "type": "integer"
                  },
                  "pageSize": {
                    "type": "integer"
                  },
                  "paramsFieldsDto": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
