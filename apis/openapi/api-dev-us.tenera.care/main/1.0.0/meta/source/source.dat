{
  "openapi": "3.0.0",
  "info": {
    "title": "Tenera API",
    "description": "API for posting device events and other device data",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/teneracare/TeneraAPI/1.0.0"
  },
  "servers": [
    {
      "url": "https://api-dev-us.tenera.care/v1",
      "description": "Development"
    }
  ],
  "tags": [
    {
      "name": "Devices",
      "description": "Device related endpoints"
    }
  ],
  "paths": {
    "/devices": {
      "get": {
        "tags": [
          "Devices"
        ],
        "operationId": "getDevices",
        "summary": "Get Tenera deviceId mapping for externalId",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "externalId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "External identifier for the device"
          }
        ],
        "responses": {
          "200": {
            "description": "Device retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deviceId": {
                      "type": "string",
                      "description": "Tenera Unique identifier for the device.",
                      "example": "AynVcTUIKrL2NokVFyOW"
                    },
                    "deviceType": {
                      "type": "string",
                      "description": "Type of the device e.g. bed-pad, exit-alarm, health-monitor, fall-detector, nurse-call, environment-sensor",
                      "example": "exit-alarm"
                    },
                    "deviceName": {
                      "type": "string",
                      "description": "Name of the device type",
                      "example": "Exit Bed Alarm"
                    },
                    "externalId": {
                      "type": "string",
                      "description": "External identifier for the device",
                      "example": "EXT-DEVICE-ID-001"
                    },
                    "geofenceName": {
                      "type": "string",
                      "description": "The name of the geofence the device is assigned to",
                      "example": "Bed 203"
                    },
                    "productName": {
                      "type": "string",
                      "description": "The name of the product brand of the device",
                      "example": "Acme Bed Exit Alarm"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": false
                        },
                        "message": {
                          "type": "string",
                          "example": "Missing or invalid query parameters"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": false
                        },
                        "message": {
                          "type": "string",
                          "example": "Invalid authentication credentials"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - unauthorized access attempt",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": false
                        },
                        "message": {
                          "type": "string",
                          "example": "Unauthorized access attempt."
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": false
                        },
                        "message": {
                          "type": "string",
                          "example": "Internal server error"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/devices/{deviceId}/events": {
      "post": {
        "tags": [
          "Devices"
        ],
        "operationId": "postDeviceStatus",
        "summary": "Post device events",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Tenera Unique identifier for the device."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "description": "Current operational status of the device.",
                    "example": "exited"
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Timestamp of the event",
                    "example": "2026-02-10T14:32:11.123Z"
                  },
                  "notes": {
                    "type": "string",
                    "description": "Optional notes or comments about the status update.",
                    "example": "Resident exited bed at 12:35 AM"
                  }
                },
                "required": [
                  "status",
                  "timestamp"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device status posted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Device event received"
                    },
                    "received": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-02-10T14:32:11Z"
                    },
                    "eventId": {
                      "type": "string",
                      "example": "bD6VuZWMqSDaIgFSgBAn",
                      "description": "Unique identifier for the event"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": false
                        },
                        "message": {
                          "type": "string",
                          "example": "deviceId not found"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": false
                        },
                        "message": {
                          "type": "string",
                          "example": "Invalid authentication credentials"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - unauthorized access attempt",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": false
                        },
                        "message": {
                          "type": "string",
                          "example": "Unauthorized access attempt."
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": false
                        },
                        "message": {
                          "type": "string",
                          "example": "Internal server error"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/devices/{deviceId}/data": {
      "post": {
        "tags": [
          "Devices"
        ],
        "operationId": "postDeviceData",
        "summary": "Post other device data",
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the device."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "data": {
                    "type": "object",
                    "description": "JSON payload containing the device's reported data.",
                    "additionalProperties": true,
                    "example": {
                      "Systolic Blood Pressure": 100,
                      "Diastolic Blood Pressure": 80,
                      "Heart Rate": 72
                    }
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Timestamp of the event",
                    "example": "2026-02-10T14:32:11.123Z"
                  }
                },
                "required": [
                  "data",
                  "timestamp"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device data posted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Device data received"
                    },
                    "received": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-02-10T14:32:11Z"
                    },
                    "dataId": {
                      "type": "string",
                      "example": "08dVt84axwz01z30tcQB",
                      "description": "Unique identifier for the response"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": false
                        },
                        "message": {
                          "type": "string",
                          "example": "deviceId not found"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": false
                        },
                        "message": {
                          "type": "string",
                          "example": "Invalid authentication credentials"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - unauthorized access attempt",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": false
                        },
                        "message": {
                          "type": "string",
                          "example": "Unauthorized access attempt."
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "success": {
                          "type": "boolean",
                          "example": false
                        },
                        "message": {
                          "type": "string",
                          "example": "Internal server error"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates failure"
          },
          "message": {
            "type": "string",
            "description": "Error message detailing the cause of the error"
          }
        }
      }
    }
  }
}
