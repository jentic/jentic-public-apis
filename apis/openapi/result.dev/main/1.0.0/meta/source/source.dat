{
  "openapi": "3.1.0",
  "info": {
    "title": "Result API",
    "version": "1.0.0",
    "summary": "The account and signup operations behind Result, the workspace for running a business.",
    "description": "Result is one workspace for running a business. This document describes its HTTP API: the operations behind identifying an account, reading where it is in signing up, creating a business, and crossing from result.dev to the product at app.result.dev with the session intact.\n\nEvery operation requires a bearer token and there is no anonymous surface, by design.\n\nTo OPERATE a Result business — read its numbers, work its pipeline, publish, answer support — use the Model Context Protocol server at https://app.result.dev/mcp rather than this API. It exposes the same tools the product uses internally, under the same permission checks, and it is the interface built for agents.\n\nBoth hosts answer these paths. `https://result.dev/api/...` is rewritten to the product, same-origin, which is how this site's own signup calls avoid CORS entirely.",
    "contact": {
      "name": "Result support",
      "email": "support@result.dev",
      "url": "https://result.dev/contact"
    },
    "termsOfService": "https://result.dev/terms",
    "license": {
      "name": "Proprietary",
      "url": "https://result.dev/terms"
    }
  },
  "externalDocs": {
    "description": "The Result MCP server — how an agent actually operates a business here.",
    "url": "https://app.result.dev/mcp"
  },
  "servers": [
    {
      "url": "https://result.dev",
      "description": "The marketing site. It rewrites /api/* to the product, so these paths answer here too."
    },
    {
      "url": "https://app.result.dev",
      "description": "The product, which owns these routes."
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "The signed-in person: who they are, and where they are in signing up."
    },
    {
      "name": "Businesses",
      "description": "A business is a workspace with a permanent public @handle. One account may own several."
    },
    {
      "name": "Sessions",
      "description": "Crossing from the marketing site to the product without putting a credential in a URL."
    }
  ],
  "security": [
    {
      "resultSession": []
    }
  ],
  "paths": {
    "/api/account/state": {
      "get": {
        "operationId": "getAccountState",
        "tags": [
          "Account"
        ],
        "summary": "Where this account is in signing up",
        "description": "Legacy-safe account progress for old links and recovery clients. Current Google sign-in hands off immediately; the app's workspace and plan gates decide the two paid-setup screens. Deliberately exposes no workspace rows, subscription rows or schema. Never cached.",
        "security": [
          {
            "resultSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "The account's signup state.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/AccountState"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No session token, or a token that is expired or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Something failed on our side. The response body says so and nothing more; the detail is in our logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/account/identity": {
      "post": {
        "operationId": "claimGoogleIdentity",
        "tags": [
          "Account"
        ],
        "summary": "Fill in a name and photo from a Google ID token",
        "description": "Posts the raw Google ID token minted by the sign-in button. The server verifies the signature with Google, checks the audience is Result's own client and that the token's email matches the session, then fills in the profile's display name and avatar ONLY where they are still empty — a name typed in Settings is never overwritten by a later sign-in. Returns the resulting values whether or not anything was written.",
        "security": [
          {
            "resultSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "idToken"
                ],
                "properties": {
                  "idToken": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The `credential` from Google Identity Services, unmodified. It is verified server-side; never decode it client-side."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The profile's name and photo after the call.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Identity"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request body did not match the schema for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No session token, or a token that is expired or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The token is valid but does not authorize this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Something failed on our side. The response body says so and nothing more; the detail is in our logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/username/check": {
      "get": {
        "operationId": "checkUsernameAvailability",
        "tags": [
          "Businesses"
        ],
        "summary": "Is this @handle free",
        "description": "Availability for the create-business form. Handles are global and permanent, so this takes no business context — for a second business, your own other handles are taken like anyone else's. Read-only and advisory: the real guarantee is the unique index that `createBusiness` hits, which is why that operation can still answer 409. Authenticated so it is not an open handle-enumeration endpoint.",
        "security": [
          {
            "resultSession": []
          }
        ],
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": true,
            "description": "The handle to test, without the leading @. Lowercase letters, digits, hyphens and underscores.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "example": "northwind"
          }
        ],
        "responses": {
          "200": {
            "description": "Whether the handle is free. NOTE: this operation answers at the top level rather than inside a `data` envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsernameAvailability"
                }
              }
            }
          },
          "401": {
            "description": "No session token, or a token that is expired or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Something failed on our side. The response body says so and nothing more; the detail is in our logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/business": {
      "post": {
        "operationId": "createBusiness",
        "tags": [
          "Businesses"
        ],
        "summary": "Create a business",
        "description": "Creates the business and claims its permanent public @handle. It SPENDS NOTHING: describing a business comes before paying for one, so an account with no plan may call this, and the paid setup — the content workspace, the app backend, the subdomains — is released later by the payment projection. An account that already pays gets that release before the response. Answers 201 for a new row and 200 when a double-submit resolved to a row that already existed.",
        "security": [
          {
            "resultSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewBusiness"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A double-submit resolved to the business the first request created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Business"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "The business that was created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Business"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The request body did not match the schema for this operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No session token, or a token that is expired or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The write lost a race for a unique value, such as an @handle.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "A field parsed but is not usable — an invalid @handle, or a website URL that does not resolve.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Something failed on our side. The response body says so and nothing more; the detail is in our logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/handoff": {
      "post": {
        "operationId": "createSessionHandoff",
        "tags": [
          "Sessions"
        ],
        "summary": "Mint a one-time code for crossing to the product",
        "description": "The session held on result.dev cannot be shared with app.result.dev by cookie — the refresh token is host-only and must stay that way — so crossing is a one-time code instead. It is single-use, expires in minutes, is stored only as a hash, and is spent by the product's own /auth/enter page. Never cached.",
        "security": [
          {
            "resultSession": []
          }
        ],
        "requestBody": {
          "required": false,
          "description": "Optional. Omit it entirely to land on the product's home page.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "next": {
                    "type": "string",
                    "description": "Where to land inside the product. Must be a same-origin path; anything else — an absolute URL, a protocol-relative one, a backslash escape — is replaced with `/`.",
                    "example": "/finance/payments"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The one-time code.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "Pass as `?code=` to the product's /auth/enter page. Single use, minutes long."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No session token, or a token that is expired or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "This path exists but not for this method.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Something failed on our side. The response body says so and nothing more; the detail is in our logs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "resultSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "The refresh token of a signed-in Result session, sent as `Authorization: Bearer <token>`.\n\nThis is the credential a browser on result.dev or app.result.dev already holds after signing in with Google; there is no way to mint one from a client secret, because there is no machine-to-machine tier of this API.\n\nAn AGENT should not be reaching for this. Connect to the MCP server at https://app.result.dev/mcp instead, which authorizes with OAuth 2.1 and PKCE and is discoverable at /.well-known/oauth-protected-resource."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Every failure from every route, in one shape. Clients branch on `code` and show `message`; `hint` and `documentation` appear where there is a next step worth naming.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string",
                "description": "Copy written for a person. Safe to show; never a stack trace."
              },
              "code": {
                "type": "string",
                "description": "A stable string for the few conditions a client must DO something about.",
                "enum": [
                  "username_taken",
                  "plan_inactive",
                  "no_credits",
                  "provider_request_in_progress",
                  "route_not_found"
                ]
              },
              "hint": {
                "type": "string",
                "description": "How to resolve it, in one sentence."
              },
              "documentation": {
                "type": "string",
                "format": "uri",
                "description": "Where the resolution is described in full."
              }
            }
          }
        }
      },
      "AccountState": {
        "type": "object",
        "required": [
          "entitled",
          "businessId",
          "idea",
          "answers",
          "provisioned",
          "named"
        ],
        "properties": {
          "entitled": {
            "type": "boolean",
            "description": "Whether the account has a live plan."
          },
          "businessId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The oldest business this account owns, which is the one it described first. Null before the first is created."
          },
          "idea": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the account said it is building — the business's description, and the input to every later suggestion."
          },
          "answers": {
            "$ref": "#/components/schemas/SignupAnswers"
          },
          "provisioned": {
            "type": "boolean",
            "description": "Whether the paid setup has been released. Distinguishes 'paid, still building' from 'not paid'."
          },
          "named": {
            "type": "boolean",
            "description": "Whether the person has a display name, so signing up does not ask twice."
          }
        }
      },
      "SignupAnswers": {
        "type": "object",
        "description": "How far the signup interview got. Every field is absent until answered; `website: null` means 'asked, and there is not one yet', which is a different state from absent.",
        "properties": {
          "kind": {
            "type": "string",
            "description": "What kind of business this is."
          },
          "audience": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Who it is for."
          },
          "website": {
            "type": [
              "string",
              "null"
            ],
            "description": "An existing website, or null when the answer was 'not yet'."
          },
          "pitch": {
            "type": "string",
            "description": "The business in the account's own words."
          }
        }
      },
      "Identity": {
        "type": "object",
        "required": [
          "displayName",
          "avatarUrl"
        ],
        "properties": {
          "displayName": {
            "type": [
              "string",
              "null"
            ],
            "description": "The person's name, or null if still unknown."
          },
          "avatarUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "A photo URL on Google's own image host, or null. Never an arbitrary origin."
          }
        }
      },
      "UsernameAvailability": {
        "type": "object",
        "required": [
          "available"
        ],
        "properties": {
          "available": {
            "type": "boolean",
            "description": "Whether the handle can be claimed right now."
          },
          "reason": {
            "type": "string",
            "description": "Why not, as copy to show under the field. Present only when `available` is false."
          }
        }
      },
      "NewBusiness": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "description": "What the business is called."
          },
          "username": {
            "type": "string",
            "maxLength": 120,
            "description": "The public @handle, without the leading @. PERMANENT: it names the public pages and the tenant subdomains, and there is no rename. Omit it and one is derived from the name."
          },
          "websiteUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "description": "An existing website for the business. Must be https and must be publicly fetchable."
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "maxLength": 50000,
            "description": "What the business does, in the account's own words. The input to every later suggestion."
          },
          "kind": {
            "type": "string",
            "description": "The signup interview's first answer: what kind of thing this is."
          }
        }
      },
      "Business": {
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The business's id."
          },
          "username": {
            "type": [
              "string",
              "null"
            ],
            "description": "Its permanent public @handle, without the leading @."
          }
        }
      }
    }
  }
}
