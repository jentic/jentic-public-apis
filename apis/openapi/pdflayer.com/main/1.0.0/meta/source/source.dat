{
  "openapi": "3.1.0",
  "info": {
    "title": "pdflayer API",
    "version": "1.0.0",
    "description": "The pdflayer API was built to provide a quick and seamless way to automate HTML to PDF conversion in any application. Its lightweight RESTful infrastructure is based on an efficient combination of the most powerful PDF rendering engines available, making it the most cost-effective and reliable option for anyone looking to process small or large numbers of documents within short time windows.\n                               \nThe pdflayer API comes with a full set of customization functionalities, including document configuration, a series of layout adjustment options, authentication and security, design and branding tweaks, and much more.\n                                    \nThe following documentation intends to outline in detail the pdflayer API's specification, access and use of any features and parameters currently available.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/apilayer-863/PDFlayer-API/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.pdflayer.com/api"
    }
  ],
  "security": [
    {
      "AccessKeyQuery": []
    }
  ],
  "paths": {
    "/convert": {
      "get": {
        "summary": "Convert",
        "description": "Convert a publicly accessible URL to PDF.\n",
        "operationId": "convertGet",
        "parameters": [
          {
            "$ref": "#/components/parameters/access_key"
          },
          {
            "$ref": "#/components/parameters/document_url"
          },
          {
            "$ref": "#/components/parameters/document_name"
          },
          {
            "$ref": "#/components/parameters/custom_unit"
          },
          {
            "$ref": "#/components/parameters/user_agent"
          },
          {
            "$ref": "#/components/parameters/accept_lang"
          },
          {
            "$ref": "#/components/parameters/ttl"
          },
          {
            "$ref": "#/components/parameters/force"
          },
          {
            "$ref": "#/components/parameters/inline"
          },
          {
            "$ref": "#/components/parameters/auth_user"
          },
          {
            "$ref": "#/components/parameters/auth_pass"
          },
          {
            "$ref": "#/components/parameters/encryption"
          },
          {
            "$ref": "#/components/parameters/owner_password"
          },
          {
            "$ref": "#/components/parameters/user_password"
          },
          {
            "$ref": "#/components/parameters/no_images"
          },
          {
            "$ref": "#/components/parameters/no_hyperlinks"
          },
          {
            "$ref": "#/components/parameters/no_backgrounds"
          },
          {
            "$ref": "#/components/parameters/no_javascript"
          },
          {
            "$ref": "#/components/parameters/use_print_media"
          },
          {
            "$ref": "#/components/parameters/grayscale"
          },
          {
            "$ref": "#/components/parameters/low_quality"
          },
          {
            "$ref": "#/components/parameters/no_print"
          },
          {
            "$ref": "#/components/parameters/no_modify"
          },
          {
            "$ref": "#/components/parameters/no_copy"
          },
          {
            "$ref": "#/components/parameters/page_size"
          },
          {
            "$ref": "#/components/parameters/page_width"
          },
          {
            "$ref": "#/components/parameters/page_height"
          },
          {
            "$ref": "#/components/parameters/orientation"
          },
          {
            "$ref": "#/components/parameters/margin_top"
          },
          {
            "$ref": "#/components/parameters/margin_bottom"
          },
          {
            "$ref": "#/components/parameters/margin_left"
          },
          {
            "$ref": "#/components/parameters/margin_right"
          },
          {
            "$ref": "#/components/parameters/header_spacing"
          },
          {
            "$ref": "#/components/parameters/header_text"
          },
          {
            "$ref": "#/components/parameters/header_align"
          },
          {
            "$ref": "#/components/parameters/header_url"
          },
          {
            "$ref": "#/components/parameters/footer_spacing"
          },
          {
            "$ref": "#/components/parameters/footer_text"
          },
          {
            "$ref": "#/components/parameters/footer_align"
          },
          {
            "$ref": "#/components/parameters/footer_url"
          },
          {
            "$ref": "#/components/parameters/viewport"
          },
          {
            "$ref": "#/components/parameters/css_url"
          },
          {
            "$ref": "#/components/parameters/delay"
          },
          {
            "$ref": "#/components/parameters/dpi"
          },
          {
            "$ref": "#/components/parameters/zoom"
          },
          {
            "$ref": "#/components/parameters/page_numbering_offset"
          },
          {
            "$ref": "#/components/parameters/watermark_url"
          },
          {
            "$ref": "#/components/parameters/watermark_offset_x"
          },
          {
            "$ref": "#/components/parameters/watermark_offset_y"
          },
          {
            "$ref": "#/components/parameters/watermark_opacity"
          },
          {
            "$ref": "#/components/parameters/watermark_in_background"
          },
          {
            "$ref": "#/components/parameters/title"
          },
          {
            "$ref": "#/components/parameters/subject"
          },
          {
            "$ref": "#/components/parameters/creator"
          },
          {
            "$ref": "#/components/parameters/author"
          },
          {
            "$ref": "#/components/parameters/secret_key"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful PDF generation — binary PDF returned. `Content-Disposition` depends on the `inline` parameter (inline display vs. attachment).",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                },
                "examples": {
                  "invoice": {
                    "summary": "Binary PDF (example not embeddable)."
                  }
                }
              }
            },
            "headers": {
              "Content-Disposition": {
                "description": "Content disposition used to instruct inline display or download (controlled by `inline` param).",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/MissingOrInvalidKey"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "406": {
            "$ref": "#/components/responses/InvalidParameter"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitReached"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "summary": "Convert",
        "description": "Preferred method for conversion when sending raw HTML (`document_html`) or complex header/footer HTML (`header_html`, `footer_html`). For POST you may supply `document_html` in the request body (form or JSON). The API accepts application/json or form-encoded POST bodies with many parameters as described in the `GET convert` section.\n",
        "operationId": "convertPost",
        "parameters": [
          {
            "$ref": "#/components/parameters/access_key"
          },
          {
            "$ref": "#/components/parameters/secret_key"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "JSON body containing conversion options. Provide either `document_url` (public URL) or `document_html` (raw HTML). Many of the standard params are allowed here (see components for the full list).\n",
                "properties": {
                  "document_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "document_html": {
                    "type": "string",
                    "description": "Raw HTML to convert. POST-only."
                  },
                  "document_name": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "document_html": "<html><body><h1>Invoice</h1></body></html>",
                "document_name": "invoice"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "document_url": {
                    "type": "string"
                  },
                  "document_html": {
                    "type": "string"
                  },
                  "document_name": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "document_url": "https://example.com/invoice.html",
                "document_name": "invoice"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful PDF generation (binary PDF).",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/MissingOrInvalidKey"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "406": {
            "$ref": "#/components/responses/InvalidParameter"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitReached"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "AccessKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "access_key",
        "description": "API Access Key provided by pdflayer. Attach as `?access_key=YOUR_KEY` to requests."
      }
    },
    "parameters": {
      "access_key": {
        "name": "access_key",
        "in": "query",
        "required": true,
        "description": "Your pdflayer API Access Key.",
        "schema": {
          "type": "string"
        },
        "example": "YOUR_ACCESS_KEY"
      },
      "document_url": {
        "name": "document_url",
        "in": "query",
        "required": false,
        "description": "Public URL to convert to PDF. Must include protocol (http:// or https://). Either document_url or document_html (POST) is required.",
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "example": "https://example.com/invoice.html"
      },
      "document_name": {
        "name": "document_name",
        "in": "query",
        "required": false,
        "description": "Filename for the generated PDF (up to 180 characters). Default: pdflayer.pdf",
        "schema": {
          "type": "string"
        },
        "example": "invoice"
      },
      "custom_unit": {
        "name": "custom_unit",
        "in": "query",
        "required": false,
        "description": "Units for numeric layout parameters: px (pixels), pt (points), in (inches) or mm (millimeters). Default: px.",
        "schema": {
          "type": "string",
          "enum": [
            "px",
            "pt",
            "in",
            "mm"
          ]
        },
        "example": "px"
      },
      "user_agent": {
        "name": "user_agent",
        "in": "query",
        "required": false,
        "description": "User-Agent header string used when fetching document_url.",
        "schema": {
          "type": "string"
        },
        "example": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
      },
      "accept_lang": {
        "name": "accept_lang",
        "in": "query",
        "required": false,
        "description": "Accept-Language header used when fetching document_url (e.g., en-US).",
        "schema": {
          "type": "string"
        },
        "example": "en-US"
      },
      "ttl": {
        "name": "ttl",
        "in": "query",
        "required": false,
        "description": "Cache TTL in seconds for generated PDF. Default: 2592000 (30 days).",
        "schema": {
          "type": "integer",
          "minimum": 0
        },
        "example": 2592000
      },
      "force": {
        "name": "force",
        "in": "query",
        "required": false,
        "description": "Set to 1 to force generation of a new PDF even if cached version exists.",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 0
      },
      "inline": {
        "name": "inline",
        "in": "query",
        "required": false,
        "description": "Set to 1 to display PDF inline in browser; if omitted or 0, client will be prompted to download (Content-Disposition header).",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 1
      },
      "auth_user": {
        "name": "auth_user",
        "in": "query",
        "required": false,
        "description": "Username for HTTP Basic auth if the document_url is protected.",
        "schema": {
          "type": "string"
        },
        "example": "user"
      },
      "auth_pass": {
        "name": "auth_pass",
        "in": "query",
        "required": false,
        "description": "Password for HTTP Basic auth if the document_url is protected.",
        "schema": {
          "type": "string"
        },
        "example": "s3cret"
      },
      "encryption": {
        "name": "encryption",
        "in": "query",
        "required": false,
        "description": "Enable PDF encryption. Supported values: 40, 128 or 256 (bit).",
        "schema": {
          "type": "integer",
          "enum": [
            40,
            128,
            256
          ]
        },
        "example": 128
      },
      "owner_password": {
        "name": "owner_password",
        "in": "query",
        "required": false,
        "description": "Owner password for the encrypted PDF (if encryption is enabled).\n\nThe pdflayer API offers two levels of PDF password protection: **owner password** and **user password**. These can be specified by appending the owner_password and user_password parameter(s) and setting them to their respective password value. Both owner_password and user_password must be provided.\n",
        "schema": {
          "type": "string"
        },
        "example": "ownerpass"
      },
      "user_password": {
        "name": "user_password",
        "in": "query",
        "required": false,
        "description": "User password for the encrypted PDF (if encryption is enabled).\n\nThe pdflayer API offers two levels of PDF password protection: **owner password** and **user password**. These can be specified by appending the owner_password and user_password parameter(s) and setting them to their respective password value. Both owner_password and user_password must be provided.\n",
        "schema": {
          "type": "string"
        },
        "example": "userpass"
      },
      "grayscale": {
        "name": "grayscale",
        "in": "query",
        "required": false,
        "description": "Set to 1 to convert the PDF to grayscale (black and white).",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 0
      },
      "no_images": {
        "name": "no_images",
        "in": "query",
        "required": false,
        "description": "Set to 1 to remove all images from the generated PDF.",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 0
      },
      "no_hyperlinks": {
        "name": "no_hyperlinks",
        "in": "query",
        "required": false,
        "description": "Set to 1 to remove all hyperlinks from the generated PDF.",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 0
      },
      "no_backgrounds": {
        "name": "no_backgrounds",
        "in": "query",
        "required": false,
        "description": "Set to 1 to remove CSS #/components/parameters/no_backgrounds",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 0
      },
      "no_javascript": {
        "name": "no_javascript",
        "in": "query",
        "required": false,
        "description": "Set to 1 to disable JavaScript execution when rendering the PDF.",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 0
      },
      "use_print_media": {
        "name": "use_print_media",
        "in": "query",
        "required": false,
        "description": "Set to 1 to use print media CSS styles when rendering the PDF.",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 0
      },
      "low_quality": {
        "name": "low_quality",
        "in": "query",
        "required": false,
        "description": "Set to 1 to generate a lower quality PDF (faster processing, smaller file).",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 0
      },
      "no_print": {
        "name": "no_print",
        "in": "query",
        "required": false,
        "description": "PDFLayer allows you to configure document permission options such as printing, copying, and modification restrictions at the time of PDF generation. Certain permission flags, including no_print, no_copy, and no_modify, can now be applied **without requiring** an owner_password, user_password, or the encryption parameter. These restrictions are embedded directly during PDF creation.\n\nFor advanced security features — such as password-protected documents, encrypted PDFs, or permissions that require post-generation control — Please check the [PDF Authentication] (https://docs.apilayer.com/pdflayer/docs/document-configuration#pdf-authentication) section.\n\nAfter a PDF is generated, permission settings that rely on passwords or encryption can only be changed or removed by supplying the **owner password**.\n\nSet to 1 to disable printing of the PDF.\n",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 0
      },
      "no_modify": {
        "name": "no_modify",
        "in": "query",
        "required": false,
        "description": "PDFLayer allows you to configure document permission options such as printing, copying, and modification restrictions at the time of PDF generation. Certain permission flags, including no_print, no_copy, and no_modify, can now be applied **without requiring** an owner_password, user_password, or the encryption parameter. These restrictions are embedded directly during PDF creation.\n\nFor advanced security features — such as password-protected documents, encrypted PDFs, or permissions that require post-generation control — Please check the [PDF Authentication] (https://docs.apilayer.com/pdflayer/docs/document-configuration#pdf-authentication) section.\n\nAfter a PDF is generated, permission settings that rely on passwords or encryption can only be changed or removed by supplying the **owner password**.\n\nSet to 1 to disable modifications to the PDF.\n",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 0
      },
      "no_copy": {
        "name": "no_copy",
        "in": "query",
        "required": false,
        "description": "PDFLayer allows you to configure document permission options such as printing, copying, and modification restrictions at the time of PDF generation. Certain permission flags, including no_print, no_copy, and no_modify, can now be applied **without requiring** an owner_password, user_password, or the encryption parameter. These restrictions are embedded directly during PDF creation.\n\nFor advanced security features — such as password-protected documents, encrypted PDFs, or permissions that require post-generation control — Please check the [PDF Authentication] (https://docs.apilayer.com/pdflayer/docs/document-configuration#pdf-authentication) section.\n\nAfter a PDF is generated, permission settings that rely on passwords or encryption can only be changed or removed by supplying the **owner password**.\n\nSet to 1 to disable copying text and graphics from the PDF.\n",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 0
      },
      "permissions": {
        "name": "permissions",
        "in": "query",
        "required": false,
        "description": "Permission set for the PDF (e.g., printing, copying). Format depends on provider UI. Use documented permission flags if needed.",
        "schema": {
          "type": "string"
        },
        "example": "print=no,copy=no"
      },
      "page_size": {
        "name": "page_size",
        "in": "query",
        "required": false,
        "description": "Page size (e.g., A4, A3, A5, Letter, Legal). If `page_width` and `page_height` are set, those override `page_size`.",
        "schema": {
          "type": "string"
        },
        "example": "A4"
      },
      "page_width": {
        "name": "page_width",
        "in": "query",
        "required": false,
        "description": "Custom page width (numeric). Units determined by `custom_unit`.\n\n**Note:**\nThe size must be greater than **75px**. If it is below 75px, **PDFLayer will reject it and throw a “not processable” error.**\n",
        "schema": {
          "type": "number"
        },
        "example": 210
      },
      "page_height": {
        "name": "page_height",
        "in": "query",
        "required": false,
        "description": "Custom page height (numeric). Units determined by `custom_unit`.\n\n**Note:**\nThe size must be greater than **75px**. If it is below 75px, **PDFLayer will reject it and throw a “not processable” error.**\n",
        "schema": {
          "type": "number"
        },
        "example": 297
      },
      "orientation": {
        "name": "orientation",
        "in": "query",
        "required": false,
        "description": "Page orientation: portrait or landscape.",
        "schema": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "example": "portrait"
      },
      "margin_top": {
        "name": "margin_top",
        "in": "query",
        "required": false,
        "description": "Top margin (numeric).",
        "schema": {
          "type": "number"
        },
        "example": 10
      },
      "margin_bottom": {
        "name": "margin_bottom",
        "in": "query",
        "required": false,
        "description": "Bottom margin (numeric).",
        "schema": {
          "type": "number"
        },
        "example": 10
      },
      "margin_left": {
        "name": "margin_left",
        "in": "query",
        "required": false,
        "description": "Left margin (numeric).",
        "schema": {
          "type": "number"
        },
        "example": 10
      },
      "margin_right": {
        "name": "margin_right",
        "in": "query",
        "required": false,
        "description": "Right margin (numeric).",
        "schema": {
          "type": "number"
        },
        "example": 10
      },
      "header_spacing": {
        "name": "header_spacing",
        "in": "query",
        "required": false,
        "description": "Spacing for header (numeric).",
        "schema": {
          "type": "number"
        },
        "example": 10
      },
      "header_text": {
        "name": "header_text",
        "in": "query",
        "required": false,
        "description": "Header text content. For complex HTML use header_html (POST-only).",
        "schema": {
          "type": "string"
        },
        "example": "Invoice - Company Inc."
      },
      "header_align": {
        "name": "header_align",
        "in": "query",
        "required": false,
        "description": "Header alignment: left, center, right.",
        "schema": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "example": "center"
      },
      "header_url": {
        "name": "header_url",
        "in": "query",
        "required": false,
        "description": "URL pointing to a header HTML fragment (urlencoded). header_html (POST-only) can be used for raw HTML instead.",
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "example": "https://example.com/header.html"
      },
      "header_html": {
        "name": "header_html",
        "in": "query",
        "required": false,
        "description": "Raw header HTML (POST-only).",
        "schema": {
          "type": "string"
        },
        "deprecated": true
      },
      "footer_spacing": {
        "name": "footer_spacing",
        "in": "query",
        "required": false,
        "description": "Spacing for footer (numeric).",
        "schema": {
          "type": "number"
        },
        "example": 10
      },
      "footer_text": {
        "name": "footer_text",
        "in": "query",
        "required": false,
        "description": "Footer text content. For complex HTML use footer_html (POST-only).",
        "schema": {
          "type": "string"
        },
        "example": "Page [page] of [topage]"
      },
      "footer_align": {
        "name": "footer_align",
        "in": "query",
        "required": false,
        "description": "Footer alignment: left, center, right.",
        "schema": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "example": "center"
      },
      "footer_url": {
        "name": "footer_url",
        "in": "query",
        "required": false,
        "description": "URL pointing to a footer HTML fragment (urlencoded). footer_html (POST-only) can be used for raw HTML instead.",
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "example": "https://example.com/footer.html"
      },
      "footer_html": {
        "name": "footer_html",
        "in": "query",
        "required": false,
        "description": "Raw footer HTML (POST-only).",
        "schema": {
          "type": "string"
        },
        "deprecated": true
      },
      "viewport": {
        "name": "viewport",
        "in": "query",
        "required": false,
        "description": "Viewport size used when rendering (format 'widthxheight', e.g. '1440x900'). Default: 1440x900.",
        "schema": {
          "type": "string"
        },
        "example": "1440x900"
      },
      "css_url": {
        "name": "css_url",
        "in": "query",
        "required": false,
        "description": "URL to a custom CSS file to inject into the document (urlencoded).",
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "example": "https://example.com/styles.css"
      },
      "delay": {
        "name": "delay",
        "in": "query",
        "required": false,
        "description": "Delay (in milliseconds) before rendering the PDF (useful for JS-heavy pages).",
        "schema": {
          "type": "number",
          "minimum": 0
        },
        "example": 2
      },
      "dpi": {
        "name": "dpi",
        "in": "query",
        "required": false,
        "description": "DPI resolution for output (numeric between 10 and 192). Default: 96.",
        "schema": {
          "type": "integer",
          "minimum": 10,
          "maximum": 192
        },
        "example": 96
      },
      "zoom": {
        "name": "zoom",
        "in": "query",
        "required": false,
        "description": "Zoom factor (numeric, 0..50).",
        "schema": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "example": 1
      },
      "page_numbering_offset": {
        "name": "page_numbering_offset",
        "in": "query",
        "required": false,
        "description": "Offset for page numbering (numeric).",
        "schema": {
          "type": "integer"
        },
        "example": 0
      },
      "watermark_url": {
        "name": "watermark_url",
        "in": "query",
        "required": false,
        "description": "URL to a PNG / JPG / JPEG / WEBP / SVG watermark image (urlencoded).",
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "example": "https://example.com/wm.png"
      },
      "watermark_offset_x": {
        "name": "watermark_offset_x",
        "in": "query",
        "required": false,
        "description": "Horizontal offset for watermark (numeric).",
        "schema": {
          "type": "number"
        },
        "example": 10
      },
      "watermark_offset_y": {
        "name": "watermark_offset_y",
        "in": "query",
        "required": false,
        "description": "Vertical offset for watermark (numeric).",
        "schema": {
          "type": "number"
        },
        "example": 10
      },
      "watermark_opacity": {
        "name": "watermark_opacity",
        "in": "query",
        "required": false,
        "description": "Watermark opacity (0..100).",
        "schema": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "example": 20
      },
      "watermark_in_background": {
        "name": "watermark_in_background",
        "in": "query",
        "required": false,
        "description": "Set to 1 to render watermark behind the document content.",
        "schema": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "example": 0
      },
      "title": {
        "name": "title",
        "in": "query",
        "required": false,
        "description": "Document title metadata (max 150 chars).",
        "schema": {
          "type": "string"
        },
        "example": "Invoice #12345"
      },
      "subject": {
        "name": "subject",
        "in": "query",
        "required": false,
        "description": "Document subject metadata (max 150 chars).",
        "schema": {
          "type": "string"
        },
        "example": "Monthly invoice"
      },
      "creator": {
        "name": "creator",
        "in": "query",
        "required": false,
        "description": "Document creator metadata (max 150 chars). Default: pdflayer.com",
        "schema": {
          "type": "string"
        },
        "example": "pdflayer"
      },
      "author": {
        "name": "author",
        "in": "query",
        "required": false,
        "description": "Document author metadata (max 150 chars).",
        "schema": {
          "type": "string"
        },
        "example": "Jane Doe"
      },
      "secret_key": {
        "name": "secret_key",
        "in": "query",
        "required": false,
        "description": "MD5 secret key (generated from your secret keyword + document_url) to protect publicly exposed URLs. See docs for generation steps.",
        "schema": {
          "type": "string"
        },
        "example": "2fc63a2144965d3695bf370011cdc9fb"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "Standard error payload returned by pdflayer.",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Always false for error responses."
          },
          "example": false,
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "Numeric error code (see pdflayer docs).",
                "example": 311
              },
              "type": {
                "type": "string",
                "description": "Machine-readable error type string.",
                "example": "invalid_document_url"
              },
              "info": {
                "type": "string",
                "description": "Human-readable error information with remediation steps.",
                "example": "You have specified an invalid document URL. Include the HTTP protocol."
              }
            },
            "required": [
              "code",
              "type",
              "info"
            ]
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request — missing or invalid required parameters.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "examples": {
              "missing_url": {
                "value": {
                  "success": false,
                  "error": {
                    "code": 311,
                    "type": "invalid_document_url",
                    "info": "You have specified an invalid document URL. [Make sure to include the HTTP protocol - example: http://example.com/invoice.html]"
                  }
                }
              }
            }
          }
        }
      },
      "MissingOrInvalidKey": {
        "description": "Missing or invalid access key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "examples": {
              "missing_key": {
                "value": {
                  "success": false,
                  "error": {
                    "code": 101,
                    "type": "missing_access_key",
                    "info": "User did not supply an Access Key."
                  }
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden — account inactive, feature restricted or secret_key mismatch.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "examples": {
              "inactive": {
                "value": {
                  "success": false,
                  "error": {
                    "code": 102,
                    "type": "inactive_user",
                    "info": "Your account is not active. Please contact support."
                  }
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found — resource missing (e.g., document URL returned 404).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "examples": {
              "doc_missing": {
                "value": {
                  "success": false,
                  "error": {
                    "code": 312,
                    "type": "document_url_not_found",
                    "info": "The specified document URL could not be found. [Status: 404]"
                  }
                }
              }
            }
          }
        }
      },
      "InvalidParameter": {
        "description": "Invalid parameter value or format.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "examples": {
              "bad_param": {
                "value": {
                  "success": false,
                  "error": {
                    "code": 313,
                    "type": "missing_document_source",
                    "info": "User did not specify a document source. Provide `document_url` or `document_html`."
                  }
                }
              }
            }
          }
        }
      },
      "RateLimitReached": {
        "description": "Rate limit exceeded for your plan (per-minute limit).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "examples": {
              "rate_limit": {
                "value": {
                  "success": false,
                  "error": {
                    "code": 106,
                    "type": "rate_limit_reached",
                    "info": "You have exceeded the allowed rate limit. See the Rate Limits section of the docs."
                  }
                }
              }
            }
          }
        }
      },
      "ServerError": {
        "description": "Server error (unexpected).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            },
            "examples": {
              "internal": {
                "value": {
                  "success": false,
                  "error": {
                    "code": 500,
                    "type": "internal_server_error",
                    "info": "An unexpected internal server error occurred."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "externalDocs": {
    "description": "Official pdflayer documentation (reference)",
    "url": "https://pdflayer.com/documentation"
  }
}
