{"openapi":"3.1.0","info":{"title":"CAAC Go Developer API","version":"1.0.0","description":"Send WhatsApp messages and generate AI replies programmatically. Authenticate with a workspace API key as a Bearer token."},"servers":[{"url":"https://caacgo.cresclab.com","description":"Production"}],"components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","description":"Workspace API key (cwa_…)"}},"schemas":{"Error":{"type":"object","properties":{"error":{"type":"string"}},"required":["error"]},"Workspace":{"type":"object","description":"A CAAC Go workspace.","properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string","example":"Glow Skin Clinic"},"plan":{"type":"string","example":"free"}}},"SendMessageRequest":{"type":"object","required":["to","text"],"properties":{"to":{"type":"string","description":"Recipient phone in international format","example":"+5511988887777"},"text":{"type":"string","maxLength":4096,"example":"Hi! Thanks for reaching out 👋"}}},"AiReplyRequest":{"type":"object","required":["message"],"properties":{"message":{"type":"string","description":"The customer's message","example":"How much is a haircut?"},"url":{"type":"string","description":"Business website to read answers from","example":"https://example-clinic.com"},"context":{"type":"string","description":"Raw business text to answer from (alternative to url)"},"businessName":{"type":"string","example":"Glow Skin Clinic"}}},"WebhookEnvelope":{"type":"object","description":"Every webhook is delivered as this signed JSON envelope. The shape of `data` varies by event — see the per-event payload schemas (e.g. LeadCapturedPayload).","properties":{"id":{"type":"string","format":"uuid"},"event":{"type":"string","description":"The event type, e.g. lead.captured"},"createdAt":{"type":"string","format":"date-time"},"data":{"type":"object"}}},"MessageReceivedPayload":{"type":"object","properties":{"conversationId":{"type":"string","format":"uuid"},"contactId":{"type":"string","format":"uuid"},"messageId":{"type":"string","format":"uuid"},"channelType":{"type":"string","enum":["whatsapp","web"]},"body":{"type":"string"},"contact":{"type":"object","properties":{"name":{"type":["string","null"]},"phone":{"type":["string","null"]},"externalId":{"type":["string","null"]}}}}},"ConversationEscalatedPayload":{"type":"object","properties":{"conversationId":{"type":"string","format":"uuid"},"contactId":{"type":["string","null"]},"question":{"type":"string","description":"The visitor message that triggered the handoff."},"contact":{"type":["object","null"],"properties":{"name":{"type":["string","null"]},"email":{"type":["string","null"]},"phone":{"type":["string","null"]},"metadata":{"type":["object","null"],"additionalProperties":true}}},"transcript":{"type":"array","items":{"type":"object","properties":{"role":{"type":"string","enum":["visitor","agent"]},"text":{"type":"string"}}}}}},"ContactCreatedPayload":{"type":"object","properties":{"contactId":{"type":"string","format":"uuid"},"name":{"type":["string","null"]},"phone":{"type":["string","null"]},"externalId":{"type":["string","null"]},"source":{"type":"string"},"channelType":{"type":"string","enum":["whatsapp","web"]}}},"LeadCapturedPayload":{"type":"object","properties":{"conversationId":{"type":["string","null"]},"contactId":{"type":["string","null"]},"name":{"type":["string","null"]},"email":{"type":["string","null"]},"phone":{"type":["string","null"]},"interest":{"type":["string","null"]}}},"AppointmentRequestedPayload":{"type":"object","properties":{"conversationId":{"type":["string","null"]},"contactId":{"type":["string","null"]},"service":{"type":["string","null"]},"preferredTime":{"type":["string","null"]},"name":{"type":["string","null"]},"phone":{"type":["string","null"]}}}}},"security":[{"bearerAuth":[]}],"paths":{"/api/v1/me":{"get":{"summary":"Verify key & get workspace","operationId":"getMe","responses":{"200":{"description":"The workspace this key belongs to.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"},"workspace":{"$ref":"#/components/schemas/Workspace"}}}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded (120 req/min).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/messages":{"post":{"summary":"Send a WhatsApp text message","operationId":"sendMessage","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SendMessageRequest"}}}},"responses":{"200":{"description":"Sent.","content":{"application/json":{"schema":{"type":"object","properties":{"ok":{"type":"boolean"}}}}}},"400":{"description":"Invalid input.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded (60 req/min).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"Upstream WhatsApp send failed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}},"/api/v1/ai/reply":{"post":{"summary":"Generate an AI reply from business content","operationId":"aiReply","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AiReplyRequest"}}}},"responses":{"200":{"description":"The generated reply.","content":{"application/json":{"schema":{"type":"object","properties":{"reply":{"type":"string"}}}}}},"400":{"description":"Invalid input.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"401":{"description":"Missing or invalid key.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"422":{"description":"Could not read the provided URL.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"429":{"description":"Rate limit exceeded (20 req/min).","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"502":{"description":"AI generation failed.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}}}}},"webhooks":{"message.received":{"post":{"summary":"Message received","description":"A visitor sent a message to your agent. Delivered as a POST with header X-CAAC-Signature: hex HMAC-SHA256 of the raw body, keyed with the endpoint's signing secret.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"event":{"type":"string","enum":["message.received"]},"createdAt":{"type":"string","format":"date-time"},"data":{"$ref":"#/components/schemas/MessageReceivedPayload"}}}}}},"responses":{"2XX":{"description":"Return any 2xx status to acknowledge receipt."}}}},"conversation.escalated":{"post":{"summary":"Conversation escalated","description":"The AI flagged a conversation for a human to follow up. Delivered as a POST with header X-CAAC-Signature: hex HMAC-SHA256 of the raw body, keyed with the endpoint's signing secret.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"event":{"type":"string","enum":["conversation.escalated"]},"createdAt":{"type":"string","format":"date-time"},"data":{"$ref":"#/components/schemas/ConversationEscalatedPayload"}}}}}},"responses":{"2XX":{"description":"Return any 2xx status to acknowledge receipt."}}}},"contact.created":{"post":{"summary":"Contact created","description":"A new contact / lead was captured. Delivered as a POST with header X-CAAC-Signature: hex HMAC-SHA256 of the raw body, keyed with the endpoint's signing secret.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"event":{"type":"string","enum":["contact.created"]},"createdAt":{"type":"string","format":"date-time"},"data":{"$ref":"#/components/schemas/ContactCreatedPayload"}}}}}},"responses":{"2XX":{"description":"Return any 2xx status to acknowledge receipt."}}}},"lead.captured":{"post":{"summary":"Lead captured","description":"The AI saved a visitor as a lead (the money event). Delivered as a POST with header X-CAAC-Signature: hex HMAC-SHA256 of the raw body, keyed with the endpoint's signing secret.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"event":{"type":"string","enum":["lead.captured"]},"createdAt":{"type":"string","format":"date-time"},"data":{"$ref":"#/components/schemas/LeadCapturedPayload"}}}}}},"responses":{"2XX":{"description":"Return any 2xx status to acknowledge receipt."}}}},"appointment.requested":{"post":{"summary":"Appointment requested","description":"The AI recorded a booking request for your team to confirm. Delivered as a POST with header X-CAAC-Signature: hex HMAC-SHA256 of the raw body, keyed with the endpoint's signing secret.","requestBody":{"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"type":"string","format":"uuid"},"event":{"type":"string","enum":["appointment.requested"]},"createdAt":{"type":"string","format":"date-time"},"data":{"$ref":"#/components/schemas/AppointmentRequestedPayload"}}}}}},"responses":{"2XX":{"description":"Return any 2xx status to acknowledge receipt."}}}}}}