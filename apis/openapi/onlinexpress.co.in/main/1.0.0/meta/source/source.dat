{
  "openapi": "3.0.3",
  "info": {
    "title": "OnlineXpress B2C API",
    "version": "1.0.0",
    "description": "Production-accurate API specification for OnlineXpress B2C operations.",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/bhaskarvyas001/Onlinexpressv2/1.0.0"
  },
  "servers": [
    {
      "url": "https://b2ccore.onlinexpress.co.in/api/b2c"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Login user",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/shipments": {
      "post": {
        "tags": [
          "Shipments"
        ],
        "summary": "Create Forward or Reverse Shipment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateShipmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shipment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateShipmentResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/bulkcreate": {
      "post": {
        "tags": [
          "Shipments"
        ],
        "summary": "Bulk Create Shipments",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkCreateShipmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk shipment creation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkCreateShipmentResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/track/{order_id}": {
      "get": {
        "tags": [
          "Tracking"
        ],
        "summary": "Track shipment by Order ID",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tracking details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackingResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/pincodes/{pin}": {
      "get": {
        "tags": [
          "Utility"
        ],
        "summary": "Validate pincode",
        "parameters": [
          {
            "name": "pin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pincode details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PincodeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/cancelorder": {
      "post": {
        "tags": [
          "Shipments"
        ],
        "summary": "Cancel Shipment(s)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelOrderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cancellation result per shipment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelOrderResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "mobile",
          "password"
        ],
        "properties": {
          "mobile": {
            "type": "string",
            "pattern": "^[6-9]\\d{9}$"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "company_id": {
            "type": "integer"
          },
          "client_id": {
            "type": "integer"
          },
          "employee_id": {
            "type": "integer",
            "nullable": true
          },
          "role": {
            "type": "string"
          },
          "mobile": {
            "type": "string"
          },
          "mobile_verified_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "token": {
            "type": "string"
          },
          "client": {
            "$ref": "#/components/schemas/Client"
          },
          "employee": {
            "nullable": true,
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Client": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "client_code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "biling_address": {
            "type": "string"
          },
          "biling_pincode": {
            "type": "integer"
          },
          "biling_city": {
            "type": "string"
          },
          "biling_state": {
            "type": "string"
          },
          "biling_country": {
            "type": "string"
          },
          "biling_email": {
            "type": "string",
            "format": "email"
          },
          "biling_mobile": {
            "type": "string"
          },
          "account_name": {
            "type": "string"
          },
          "bank_name": {
            "type": "string"
          },
          "account_number": {
            "type": "string"
          },
          "bank_branch": {
            "type": "string"
          },
          "account_type": {
            "type": "string"
          },
          "ifsc_code": {
            "type": "string"
          },
          "pan_number": {
            "type": "string"
          },
          "aadhaar": {
            "type": "string"
          },
          "tan_number": {
            "type": "string"
          },
          "type_of_company": {
            "type": "string"
          },
          "gst": {
            "type": "string"
          },
          "company_name": {
            "type": "string"
          },
          "company_address": {
            "type": "string"
          },
          "company_pincode": {
            "type": "integer"
          },
          "company_city": {
            "type": "string"
          },
          "company_state": {
            "type": "string"
          },
          "company_country": {
            "type": "string"
          },
          "company_email": {
            "type": "string",
            "format": "email"
          },
          "company_mobile": {
            "type": "string"
          },
          "website_url": {
            "type": "string",
            "format": "uri"
          },
          "company_logo": {
            "type": "string",
            "nullable": true
          },
          "main_balance": {
            "type": "number"
          },
          "adjust_remittance_balance": {
            "type": "number"
          },
          "isapproved": {
            "type": "integer"
          },
          "approval_comment": {
            "type": "string",
            "nullable": true
          },
          "company_id": {
            "type": "integer"
          },
          "branch_id": {
            "type": "integer",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateShipmentRequest": {
        "type": "object",
        "required": [
          "order_type_code",
          "booking_type",
          "order_id",
          "client_id",
          "company_id",
          "payment_type",
          "products"
        ],
        "properties": {
          "order_type_code": {
            "type": "string",
            "enum": [
              "FWD",
              "RVP"
            ]
          },
          "booking_type": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "return_id": {
            "type": "string",
            "nullable": true
          },
          "client_id": {
            "type": "integer"
          },
          "company_id": {
            "type": "integer"
          },
          "payment_type": {
            "type": "string"
          },
          "total_weight": {
            "type": "number"
          },
          "volumetric_weight": {
            "type": "number"
          },
          "invoice_amount": {
            "type": "number"
          },
          "quality_check_required": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "dimensions": {
            "type": "object",
            "required": [
              "quantity",
              "length",
              "width",
              "height"
            ],
            "properties": {
              "quantity": {
                "type": "integer"
              },
              "length": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            }
          },
          "products": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "product_name",
          "quantity",
          "unit_price"
        ],
        "properties": {
          "product_name": {
            "type": "string"
          },
          "product_category": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price": {
            "type": "number",
            "minimum": 0
          },
          "sku": {
            "type": "string",
            "nullable": true
          },
          "hsn": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateShipmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "order_id": {
            "type": "string"
          },
          "docket_number": {
            "type": "string"
          },
          "order_type_code": {
            "type": "string",
            "enum": [
              "FWD",
              "RVP"
            ]
          },
          "booking_type": {
            "type": "string"
          },
          "payment_type": {
            "type": "string"
          },
          "total_weight": {
            "type": "number"
          },
          "volumetric_weight": {
            "type": "number"
          },
          "invoice_amount": {
            "type": "number"
          },
          "status_code": {
            "type": "string"
          },
          "status_description": {
            "type": "string"
          },
          "client_id": {
            "type": "integer"
          },
          "company_id": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BulkCreateShipmentRequest": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/components/schemas/CreateShipmentRequest"
        }
      },
      "BulkCreateShipmentResponse": {
        "type": "object",
        "properties": {
          "created": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateShipmentResponse"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkCreateError"
            }
          }
        }
      },
      "BulkCreateError": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "TrackingResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "status_code": {
            "type": "string"
          },
          "docket_number": {
            "type": "string"
          },
          "origin_pincode": {
            "type": "integer"
          },
          "destination_pincode": {
            "type": "integer"
          },
          "origin_city": {
            "type": "string"
          },
          "destination_city": {
            "type": "string"
          },
          "receiver": {
            "type": "string"
          },
          "status_description": {
            "type": "string"
          },
          "shipment_histories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrackingHistory"
            }
          }
        }
      },
      "TrackingHistory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "shipment_id": {
            "type": "integer"
          },
          "run_date": {
            "type": "string",
            "format": "date-time"
          },
          "run_time": {
            "type": "string"
          },
          "status_code": {
            "type": "string"
          },
          "status_description": {
            "type": "string"
          },
          "formatted_run_date": {
            "type": "string"
          }
        }
      },
      "PincodeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "pin": {
            "type": "integer"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "isdelivery": {
            "type": "boolean"
          },
          "ispickup": {
            "type": "boolean"
          },
          "isreverse": {
            "type": "boolean"
          },
          "iscod": {
            "type": "boolean"
          },
          "isoda": {
            "type": "boolean"
          },
          "zone": {
            "$ref": "#/components/schemas/Zone"
          }
        }
      },
      "Zone": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "zone": {
            "type": "string"
          }
        }
      },
      "CancelOrderRequest": {
        "type": "object",
        "required": [
          "shipment_ids",
          "cancel_reason"
        ],
        "properties": {
          "shipment_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer"
            }
          },
          "cancel_reason": {
            "type": "string",
            "minLength": 3
          }
        }
      },
      "CancelOrderResponse": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "shipment_id": {
              "type": "integer"
            },
            "success": {
              "type": "boolean"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
