                  "aadhar_no": {
                    "type": "string",
                    "example": " 123412341234"
                  },
                  "aadhar_pic[]": {
                    "type": "string",
                    "format": "binary"
                  },
                  "address": {
                    "type": "string",
                    "example": " Flat 12B, MG Road, Andheri East, Mumbai, Maharashtra - 400069"
                  },
                  "bank_acc_no": {
                    "type": "string",
                    "example": " 123456789012"
                  },
                  "delivery_area": {
                    "type": "string",
                    "example": " Andheri East, Mumbai1"
                  },
                  "dl_pic": {
                    "type": "string",
                    "format": "binary"
                  },
                  "driver_pic": {
                    "type": "string",
                    "format": "binary"
                  },
                  "driving_licence_no": {
                    "type": "string",
                    "example": " MH1420123456789"
                  },
                  "email_id": {
                    "type": "string",
                    "example": " rahul.shardsfdsdfsfma@example.com"
                  },
                  "emergency_contact": {
                    "type": "string",
                    "example": " 9876543210"
                  },
                  "ifsc": {
                    "type": "string",
