  "info": {
    "title": "GEOD Delivery Boy",
    "version": "1.0.0",
    "contact": {},
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/dfgdfgdfgdfg-0d5/geod-delivery-boy/1.0.0"
  },
  "servers": [
    {
      "url": "https://geodservice.com"
    }
  ],
  "paths": {
    "/Api/delivery_boy_login": {
      "post": {
        "summary": "Login",
        "description": "Login",
        "operationId": "login",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone_no": {
                    "type": "string",
                    "example": "9563256415"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/Api/delivery_boy_verify_otp": {
      "post": {
        "summary": "Verify otp",
        "description": "Verify otp",
        "operationId": "verifyOtp",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "otp": {
                    "type": "string",
                    "example": "1234"
                  },
                  "phone_no": {
                    "type": "string",
                    "example": "9563256415"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/Api/new_delivery_boy_registration": {
      "post": {
        "summary": "Registration",
        "description": "Registration",
        "operationId": "registration",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "aadhar_no": {
                    "type": "string",
                    "example": " 123412341234"
                  },
                  "aadhar_pic[]": {
                    "type": "string",
                    "format": "binary"
                  },
                  "address": {
                    "type": "string",
                    "example": " Flat 12B, MG Road, Andheri East, Mumbai, Maharashtra - 400069"
                  },
                  "bank_acc_no": {
                    "type": "string",
                    "example": " 123456789012"
                  },
                  "delivery_area": {
                    "type": "string",
                    "example": " Andheri East, Mumbai"
                  },
                  "dl_pic": {
                    "type": "string",
                    "format": "binary"
                  },
                  "driver_pic": {
                    "type": "string",
                    "format": "binary"
                  },
                  "driving_licence_no": {
                    "type": "string",
                    "example": " MH1420123456789"
                  },
                  "email_id": {
                    "type": "string",
                    "example": " rahul.sharxcvdsfdsdfsfma@example.com"
                  },
                  "emergency_contact": {
                    "type": "string",
                    "example": " 9876543210"
                  },
                  "ifsc": {
                    "type": "string",
                    "example": " HDFC0001234"
                  },
                  "name": {
                    "type": "string",
                    "example": " Rahul Sharma"
                  },
                  "pan_no": {
                    "type": "string",
                    "example": " ABCDE1234F"
                  },
                  "pan_pic": {
                    "type": "string",
                    "format": "binary"
                  },
                  "upi_id": {
                    "type": "string",
                    "example": " rahulsharma@upi"
                  },
                  "vehicle_no": {
                    "type": "string",
                    "example": " MH02AB1234"
                  },
                  "vehicle_type": {
                    "type": "string",
                    "example": " Bike"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
