                  },
                  "name": {
                    "type": "string",
                    "example": " Rahul Sharma"
                  },
                  "pan_no": {
                    "type": "string",
                    "example": " ABCDE1234F"
                  },
                  "pan_pic": {
                    "type": "string",
                    "format": "binary"
                  },
                  "upi_id": {
                    "type": "string",
                    "example": " rahulsharma@upi"
                  },
                  "vehicle_no": {
                    "type": "string",
                    "example": " MH02AB1234"
                  },
                  "vehicle_type": {
                    "type": "string",
                    "example": " Bike"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/Api/delivery_boy_view_order": {
      "get": {
        "summary": "View Order",
        "description": "View Order",
        "operationId": "viewOrder",
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/Api/change_order_status_by_order_id": {
      "post": {
        "summary": "Change Order Status",
        "description": "Change Order Status",
        "operationId": "changeOrderStatus",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string",
                    "example": "1771573165"
                  },
                  "otp": {
                    "type": "string",
                    "example": "1234"
                  },
                  "status": {
                    "type": "string",
                    "example": "6"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": ""
          }
        }
