            "schema": {
              "type": "string",
              "enum": [
                "inflation",
                "policyRate",
                "depositRate",
                "lendingRate",
                "realDepositRate",
                "realPolicyRate"
              ]
            },
            "description": "Ranking metric (default inflation)"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "highest",
                "lowest"
              ]
            },
            "description": "Ranking direction"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum countries in a ranking"
          }
        ],
        "responses": {
          "200": {
            "description": "Rows with caveats and an attribution block naming World Bank, BIS and IMF"
          },
          "400": {
            "description": "Fewer than two countries (TOO_FEW) or an unrecognised metric (INVALID_METRIC)"
          },
          "422": {
            "description": "Country not on the spine (UNKNOWN_COUNTRY) or with no inflation figure (NO_DATA)"
          }
        }
      }
    },
    "/api/remittance.json": {
      "get": {
        "operationId": "remittanceCost",
        "summary": "Cost of sending money on a corridor, or corridors ranked",
        "description": "World Bank Remittance Prices Worldwide, newest quarter: mean total cost of sending USD 200 and USD 500, cheapest provider, providers surveyed. `from` and `to` for one corridor (with optional `amount` for a quote at the nearer band); one of them for a ranking. Unsurveyed pairs are 422 NO_DATA.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Sending country, ISO alpha-2"
