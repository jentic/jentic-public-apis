            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "doctors",
                "nurses",
                "beds"
              ]
            },
            "description": "Ranking metric (default doctors)"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "lowest",
                "highest"
              ]
            },
            "description": "Default highest"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum countries"
          }
        ],
        "responses": {
          "200": {
            "description": "One country, comparison rows, or ranked rows; attribution names WHO and OECD"
          },
          "400": {
            "description": "A bad metric (INVALID_METRIC) or fewer than two countries (TOO_FEW)"
          },
          "422": {
            "description": "A country outside the spine (UNKNOWN_COUNTRY) or below the vintage floor (NO_DATA)"
          }
        }
      }
    },
    "/api/childcare.json": {
      "get": {
        "operationId": "compareChildcareCost",
        "summary": "Net childcare cost for a couple and a single parent (OECD), per country or ranked",
        "description": "OECD tax-benefit model: net cost of full-time centre-based care for two children, couple at 100%/100% and single parent at 67% of the average wage, as % of disposable income, % of the average wage and local currency. OECD members only; others are NO_DATA. For information only; every response says so first.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "One ISO alpha-2 code"
          },
          {
            "name": "countries",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated ISO alpha-2 codes, two or more"
          },
          {
            "name": "household",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "couple",
                "singleParent"
              ]
            },
            "description": "Ranking household (default couple)"
          },
          {
            "name": "unit",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pctDisposableIncome",
                "pctAverageWage"
              ]
            },
            "description": "Ranking unit"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "lowest",
                "highest"
              ]
            },
            "description": "Default lowest"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum countries"
          }
        ],
        "responses": {
          "200": {
            "description": "One country, comparison rows, or ranked rows; attribution names OECD's tax-benefit model"
          },
          "400": {
            "description": "A bad household or unit (INVALID_PARAM) or fewer than two countries (TOO_FEW)"
          },
          "422": {
            "description": "A country outside the spine (UNKNOWN_COUNTRY) or outside OECD's model (NO_DATA)"
          }
        }
      }
    },
    "/api/food-cost.json": {
      "get": {
        "operationId": "compareFoodCost",
        "summary": "Measured cost of a healthy diet (World Bank), per country or ranked, and the grocery model’s error",
        "description": "World Bank Food Prices for Nutrition: the cheapest locally available healthy diet, per person per day, in local currency and USD, with the share who cannot afford it and the food-group split. Also how far this site’s modelled grocery prices are from it (modelError, and modelErrorSummary on a ranking). A least-cost diet, not typical spending; display only. Dollar figures are withheld where a local figure does not convert consistently. For information only; every response says so first.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "One ISO alpha-2 code"
          },
          {
            "name": "countries",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated ISO alpha-2 codes, two or more"
          },
          {
            "name": "metric",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "dailyUsd",
                "unaffordablePct"
              ]
            },
            "description": "Ranking metric (default dailyUsd)"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "lowest",
                "highest"
              ]
            },
            "description": "Default lowest"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum countries"
          }
        ],
        "responses": {
          "200": {
            "description": "One country, comparison rows, or ranked rows with modelErrorSummary; attribution names the World Bank series and the FX table"
          },
          "400": {
            "description": "A bad metric or sort (INVALID_PARAM) or fewer than two countries (TOO_FEW)"
          },
          "422": {
            "description": "A country outside the spine (UNKNOWN_COUNTRY) or with no World Bank survey (NO_DATA)"
          }
        }
      }
    },
