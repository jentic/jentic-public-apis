          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Receiving country, ISO alpha-2"
          },
          {
            "name": "amount",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Amount to send, USD"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "lowest",
                "highest"
              ]
            },
            "description": "Ranking direction (default lowest)"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum corridors in a ranking"
          }
        ],
        "responses": {
          "200": {
            "description": "Corridor figures (and a quote) or a ranking, with an attribution block naming RPW"
          },
          "400": {
            "description": "Neither from nor to (MISSING_PARAMS), same country (SAME_COUNTRY), or a non-positive amount (INVALID_PARAM)"
          },
          "422": {
            "description": "A country the survey does not cover (UNKNOWN_COUNTRY) or an unsurveyed corridor (NO_DATA)"
          }
        }
      }
    },
    "/api/pension-abroad.json": {
      "get": {
        "operationId": "pensionAbroad",
        "summary": "What a pension is worth in another country, now and after N years",
        "description": "Converts a monthly pension at the site's FX snapshot, re-prices it at the destination through the PPP engine, and projects it flat at the destination's latest annual inflation for `years`. Without `amount`, the origin's typical state pension (OECD net replacement rate on the modelled median wage) is used and `basis` says so.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Country the pension is paid from, ISO alpha-2"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Country it is spent in, ISO alpha-2"
          },
          {
            "name": "amount",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Monthly pension in `currency`"
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ISO 4217 code of amount (default USD)"
          },
          {
            "name": "years",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 40
            },
            "description": "Years to project (whole number, default 10)"
          }
        ],
        "responses": {
          "200": {
            "description": "Worth today and after the period in USD and local currency, erosion, caveats, attribution"
          },
          "400": {
            "description": "Missing from/to (MISSING_PARAMS), bad years/amount (INVALID_PARAM), same country (SAME_COUNTRY)"
          },
          "422": {
            "description": "Unknown country (UNKNOWN_COUNTRY), unknown currency (UNKNOWN_CURRENCY), or no replacement rate/inflation figure (NO_DATA)"
          }
        }
      }
    },
