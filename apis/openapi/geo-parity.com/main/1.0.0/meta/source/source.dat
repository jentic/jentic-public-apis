          "422": {
            "description": "An unsupported currency (UNKNOWN_CURRENCY)"
          }
        }
      }
    },
    "/api/dossier.json": {
      "get": {
        "operationId": "countryDossier",
        "summary": "One country, every hub: headline figures with their sources",
        "description": "Three to six headline figures per hub (compare, costs, earn, move, work, money) for one country, each with the id of the source that produced it, the MCP tool for detail per section, and a `sources` list derived from what was included. Absent sections mean no data, never null. `income` (monthly USD) unlocks the total-cost figures.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ISO alpha-2 code"
          },
          {
            "name": "income",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Gross monthly income in USD"
          }
        ],
        "responses": {
          "200": {
            "description": "Sections, tools, sources, updated, and an attribution block"
          },
          "400": {
            "description": "Missing country (MISSING_PARAMS) or non-positive income (INVALID_PARAM)"
          },
          "422": {
            "description": "Unknown country (UNKNOWN_COUNTRY)"
          }
        }
      }
    },
    "/api/datasets.json": {
      "get": {
        "operationId": "listDatasets",
        "summary": "Every dataset and when it last changed",
        "description": "The registry of datasets behind the site's figures with their last-changed dates, kind (fetched or reviewed), page and refresh script. With `since`, `changed` lists only those strictly newer. No figures, so no attribution block.",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "description": "Only datasets changed strictly after this date"
          }
        ],
        "responses": {
          "200": {
            "description": "count, changedCount, newest, changed[], datasets[]"
          },
          "400": {
            "description": "since is not a calendar date (INVALID_PARAM)"
          }
        }
      }
    },
    "/api/climate.json": {
      "get": {
        "operationId": "compareClimate",
        "summary": "Climate normals and comfortable days, by city or ranked",
        "description": "Monthly normals from ERA5 reanalysis (2015-2024) via Open-Meteo. `city` or `country` returns one place's twelve months; otherwise cities are ranked by comfortable days for a `month` or across the year. The comfort band (max 18-27 C, under 1 mm rain) is a stated preference and is temperate-biased; mean maximum and rainfall are returned alongside so callers can rank on those instead.",
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "City slug, e.g. lisbon"
          },
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ISO alpha-2; answers via the representative city"
          },
          {
            "name": "month",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 12
            },
            "description": "Rank a single month; omit for the whole year"
          },
          {
            "name": "minComfortDays",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0
            },
            "description": "Minimum comfortable days in the ranked window"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum cities returned"
          }
        ],
        "responses": {
          "200": {
            "description": "City normals or a ranking, with an attribution block"
          },
          "400": {
            "description": "month outside 1-12 (code INVALID_MONTH)"
          },
          "422": {
            "description": "No climate data for that city or country"
          }
        }
      }
    },
    "/api/risk.json": {
      "get": {
        "operationId": "compareCountryRisk",
        "summary": "INFORM Risk scores by country (EC JRC)",
        "description": "0-10 composite where higher is worse, plus hazard, vulnerability and coping-capacity dimensions. Safest-first by default. 191 countries; a country INFORM does not score is absent rather than zero, because zero is the safest value and would rank an unassessed country first.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ISO alpha-2 for one country's scores"
          },
          {
            "name": "maxRisk",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "description": "Keep only countries at or below this composite score"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "risk",
                "hazard",
                "vulnerability",
                "copingCapacity"
              ]
            },
            "description": "Dimension to sort by"
          },
          {
            "name": "descending",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "True lists most dangerous first"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum countries returned"
          }
        ],
        "responses": {
          "200": {
            "description": "Scores with an attribution block"
          },
          "400": {
            "description": "maxRisk was not a number (code INVALID_PARAM)"
          },
          "422": {
            "description": "INFORM does not score that country"
          }
        }
      }
    },
    "/api/arrival.json": {
      "get": {
        "operationId": "arrivalCost",
        "summary": "What it costs to arrive in a country",
        "description": "The cash needed to ARRIVE, as distinct from what a month costs once you live there: the entry fee for a given passport, the first month's rent, the deposit, and a long-stay visa fee where one has been verified against the issuing government. READ `complete` BEFORE `totalUsd`. Rent covers a subset of the country spine and most visa fees could not be verified, so the total is a FLOOR whenever `complete` is false, and `missing` names each component that could not be priced. The total can legitimately be 0 - visa-free entry into a country with no rent figure sums to nothing known - which is honest arithmetic and a false headline. `depositMonths` is a stated assumption rather than a measurement: no free global dataset of deposit norms exists. The entry ROUTE is derived exactly from passport mobility data, so 'visa-free for this passport' is always answered even where no fee is. The destination must be in the PPP registry; some countries with a verified nomad-visa fee are reachable only through /api/visas.json.",
        "parameters": [
          {
            "name": "passport",
            "in": "query",
            "required": true,
            "description": "ISO 3166-1 alpha-2 of the traveller's passport. Determines the entry route and therefore the fee.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "required": true,
            "description": "ISO 3166-1 alpha-2 of the destination. Must be in the PPP country registry.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "depositMonths",
            "in": "query",
            "required": false,
            "description": "Months of rent held as a deposit. Defaults to the site's stated assumption of 1.",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 12,
              "default": 1
            }
          },
          {
            "name": "income",
            "in": "query",
            "required": false,
            "description": "Monthly remote income in USD. Optional; enables housing's income-relative view.",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked countries with rentBasis, per-metric reference years, a count of countries excluded for want of the sorted metric, and an attribution block."
          },
          "400": {
            "description": "Invalid parameter (bad sort, or a non-positive income, filter or flat size)."
          },
          "422": {
            "description": "Unknown country code."
          }
        }
      }
    },
    "/api/occupation-pay.json": {
      "get": {
        "operationId": "compareOccupationPay",
        "summary": "Measured pay by ISCO-08 occupation group, with the gender pay gap",
        "description": "MEASURED gross monthly earnings of employees by occupation, from ILOSTAT — the only measured wage series here; /api/wage-bands.json is modelled and the two are not interchangeable. Employees only, before tax. Countries with no ILO data return 422 NO_DATA rather than a modelled substitute.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ISO country code"
          },
          {
            "name": "occupation",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "total",
                "armed-forces",
                "managers",
                "professionals",
                "technicians",
                "clerical",
                "services-sales",
                "agricultural",
                "craft",
                "operators",
                "elementary"
              ]
            },
            "description": "Narrow to one ISCO-08 major group. An unrecognised value is rejected, never widened."
          }
        ],
        "responses": {
          "200": {
            "description": "Per-occupation median/mean (USD, PPP, local), gender gap, modelled percentile, and modelRatio"
          },
          "400": {
            "$ref": "#/components/responses/MissingParams"
          },
          "422": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/pay-range.json": {
      "get": {
        "operationId": "buildPayRange",
        "summary": "A defensible pay range (floor, midpoint, ceiling) for a role in a country",
        "description": "For employers publishing a salary range. NOT LEGAL ADVICE AND NOT A CERTIFICATION OF COMPLIANCE with the EU Pay Transparency Directive or any national law — every 200 response carries a `caveats` array saying so, which should be reproduced with any quoted figure. `basis` is `measured` or `modelled` and is never blurred. Seniority is a percentile offset within the country's own wage distribution, not a fixed multiplier.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ISO country code"
          },
          {
            "name": "occupation",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "total",
                "armed-forces",
                "managers",
                "professionals",
                "technicians",
                "clerical",
                "services-sales",
                "agricultural",
                "craft",
                "operators",
                "elementary"
              ],
              "default": "total"
            },
            "description": "ISCO-08 major group. An unrecognised value is rejected."
          },
          {
            "name": "seniority",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "entry",
                "mid",
                "senior",
                "lead"
              ],
              "default": "mid"
            },
            "description": "An unrecognised value is rejected."
          }
        ],
        "responses": {
          "200": {
            "description": "floor/midpoint/ceiling (monthly + annual USD, each with its local percentile), basis, gender gap, and caveats"
          },
          "400": {
            "$ref": "#/components/responses/MissingParams"
          },
          "422": {
            "$ref": "#/components/responses/InvalidInput"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        }
      }
    },
    "/api/effective-tax.json": {
      "get": {
        "operationId": "compareEffectiveTax",
        "summary": "Effective corporate tax rate (OECD EATR/EMTR) beside the statutory rate, per country or ranked",
        "description": "OECD's forward-looking effective average and marginal corporate tax rates and cost of capital beside the statutory combined rate, with the gap. `country` for one, `countries` to compare, neither ranks by `metric`. Countries outside the model keep their statutory rate and a caveat. For information only; every response says so first.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "One ISO alpha-2 code"
          },
          {
            "name": "countries",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated ISO alpha-2 codes, two or more"
          },
          {
            "name": "metric",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "eatr",
                "emtr",
                "costOfCapital",
                "gap"
              ]
            },
            "description": "Ranking metric (default eatr)"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "lowest",
                "highest"
              ]
            },
            "description": "Default lowest"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum countries"
          }
        ],
        "responses": {
          "200": {
            "description": "One country, comparison rows, or ranked rows; attribution names the OECD ETR model and the CIT dataset"
          },
          "400": {
            "description": "A bad metric (INVALID_METRIC) or fewer than two countries (TOO_FEW)"
          },
          "422": {
            "description": "A country outside the spine (UNKNOWN_COUNTRY)"
          }
        }
      }
    },
    "/api/withholding-tax.json": {
      "get": {
        "operationId": "withholdingTax",
        "summary": "Withholding tax on dividends, interest, royalties and fees paid abroad — standard rate and treaty rate per pair",
        "description": "Standard withholding rates for the paying company's country (`from`) and, with `to`, the treaty rate for the pair where OECD publishes one, with the saving in points. A pair without a published treaty rate reports the standard rate and says so. Without `from`, ranks by standard rate on `type`. For information only; every response says so first.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ISO alpha-2 code of the paying company's country"
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ISO alpha-2 code of the recipient's country"
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "dividends",
                "interest",
                "royalties",
                "technicalFees"
              ]
            },
            "description": "Income type to rank by (default dividends)"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "lowest",
                "highest"
              ]
            },
            "description": "Default lowest"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum countries"
          }
        ],
        "responses": {
          "200": {
            "description": "Standard rates, treaty lines for the pair, or ranked rows; attribution names OECD's withholding tables"
          },
          "400": {
            "description": "`from` equal to `to` (INVALID_PARAM) or a bad type (INVALID_METRIC)"
          },
          "422": {
            "description": "A country outside the spine (UNKNOWN_COUNTRY)"
          }
        }
      }
    },
    "/api/business-entry.json": {
      "get": {
        "operationId": "compareBusinessEntry",
        "summary": "Days and cost to register a company (B-READY) and the new-company rate, per country or ranked",
        "description": "B-READY company-entry facts for a domestic and a foreign-owned company (cost in local currency, converted), minimum capital, ownership limits, online registration, plus new companies per 1,000 adults. Countries outside the B-READY cohort answer with the activity figure alone. `country`, `countries`, or a ranking by `metric`. For information only; every response says so first.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "One ISO alpha-2 code"
          },
          {
            "name": "countries",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated ISO alpha-2 codes, two or more"
          },
          {
            "name": "metric",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "daysDomestic",
                "costDomesticUsd",
                "daysForeign",
                "costForeignUsd",
                "density"
              ]
            },
            "description": "Ranking metric (default daysDomestic)"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "lowest",
                "highest"
              ]
            },
            "description": "Default lowest for days and cost, highest for density"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum countries"
          }
        ],
        "responses": {
          "200": {
            "description": "One country, comparison rows, or ranked rows; attribution names B-READY and the Entrepreneurship Database"
          },
          "400": {
            "description": "A bad metric (INVALID_METRIC) or fewer than two countries (TOO_FEW)"
          },
          "422": {
            "description": "A country outside the spine (UNKNOWN_COUNTRY) or one with neither dataset (NO_DATA)"
          }
        }
      }
    },
    "/api/founder-visas.json": {
      "get": {
        "operationId": "findFounderVisas",
        "summary": "Founder, start-up and investor visa routes, matched to funds or listed per country",
        "description": "Hand-curated register of founder, start-up and investor routes with the published funds figure and its basis, endorsement, duration, official page and check date. `funds` (+ `currency`) matches; `country` or `countries` lists. Funding-raised thresholds are never met by funds in hand. For information only; every response says so first.",
        "parameters": [
          {
            "name": "funds",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Funds available to commit"
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ISO 4217 code of funds (default USD)"
          },
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "One ISO alpha-2 code"
          },
          {
            "name": "countries",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated ISO alpha-2 codes, two or more"
          }
        ],
        "responses": {
          "200": {
            "description": "Match groups (qualify, nearMiss, fundingRaised, unpublished, excluded, none), one entry, or comparison rows; attribution names the curated register"
          },
          "400": {
            "description": "No parameter (MISSING_PARAMS), a non-positive funds figure (INVALID_PARAM), or fewer than two countries (TOO_FEW)"
          },
          "422": {
            "description": "A country outside the spine (UNKNOWN_COUNTRY) or an unsupported currency (UNKNOWN_CURRENCY)"
          }
        }
      }
    },
    "/api/health-capacity.json": {
      "get": {
        "operationId": "compareHealthCapacity",
        "summary": "Doctors, nurses and hospital beds per 10,000 beside the UHC index, per country or ranked",
        "description": "WHO workforce series and hospital beds (WHO or OECD, source named per row) at the vintage floor, with the UHC index. `country`, `countries`, or a ranking by `metric`. Density is not access. For information only; every response says so first.",
        "parameters": [
          {
            "name": "country",
