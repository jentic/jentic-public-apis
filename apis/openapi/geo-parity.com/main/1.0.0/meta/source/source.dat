          }
        }
      }
    },
    "/api/property-rules.json": {
      "get": {
        "operationId": "propertyRules",
        "summary": "Whether a foreigner may buy a home, the restrictions and the transfer tax, per country or ranked",
        "description": "Hand-curated register: ownership band (free, restricted, leasehold-only, prohibited), restrictions, land ownership, headline transfer tax, official page and check date. Without `country`/`countries`, all 41 ranked free-first then by transfer tax, optionally within one `band`. For information only; every response says so first.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "One ISO alpha-2 code"
          },
          {
            "name": "countries",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated ISO alpha-2 codes, two or more"
          },
          {
            "name": "band",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "free",
                "restricted",
                "leasehold-only",
                "prohibited"
              ]
            },
            "description": "Restrict the ranking to one band"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum countries"
          }
        ],
        "responses": {
          "200": {
            "description": "One entry, comparison rows, or ranked rows; attribution names the curated register"
          },
          "400": {
            "description": "A bad band (INVALID_PARAM) or fewer than two countries (TOO_FEW)"
          },
          "422": {
            "description": "A country outside the spine (UNKNOWN_COUNTRY)"
          }
        }
      }
    },
    "/api/employment-rules.json": {
      "get": {
        "operationId": "employmentRules",
        "summary": "Statutory minimum annual leave, notice, probation and weekly hours, per country or ranked",
        "description": "Hand-curated register: minimum paid annual leave with its working/calendar basis, minimum notice for employer and employee in weeks, probation ceiling, weekly-hours ceiling, authority page and check date. A fact the law does not set is absent, never zero. Without `country`/`countries`, ranks by `metric`; countries with no figure are listed in `excluded`. For information only — not legal advice; every response says so first.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "One ISO alpha-2 code"
          },
          {
            "name": "countries",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated ISO alpha-2 codes, two or more"
          },
          {
            "name": "metric",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "minAnnualLeaveDays",
                "noticeEmployerMinWeeks",
                "probationMaxMonths",
                "maxWeeklyHours"
              ]
            },
            "description": "Ranking metric"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "most",
                "fewest"
              ]
            },
            "description": "most (default) or fewest"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum countries"
          }
        ],
        "responses": {
          "200": {
            "description": "One entry, comparison rows, or ranked rows; attribution names the curated register"
          },
          "400": {
            "description": "A bad metric or sort (INVALID_PARAM) or fewer than two countries (TOO_FEW)"
          },
          "422": {
            "description": "A country outside the spine (UNKNOWN_COUNTRY)"
          }
        }
      }
    },
    "/api/driving-rules.json": {
      "get": {
        "operationId": "drivingRules",
        "summary": "Side of the road, speed limits, alcohol limit, required equipment and IDP, per country or ranked",
        "description": "Hand-curated register: drivesOn, default urban/rural/motorway limits in the signed unit (km/h or mph, never converted), blood-alcohol limit in g/100 ml, required equipment, whether an International Driving Permit is needed (GOV.UK's table), authority page and check date. A limit not set nationally is absent. Without `country`/`countries`, ranks by `metric` within the optional filters. For information only; every response says so first.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "One ISO alpha-2 code"
          },
          {
            "name": "countries",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated ISO alpha-2 codes, two or more"
          },
          {
            "name": "metric",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "speedMotorway",
                "speedUrban",
                "speedRural",
                "bacLimitPct"
              ]
            },
            "description": "Ranking metric"
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "highest",
                "lowest"
              ]
            },
            "description": "highest (default) or lowest"
          },
          {
            "name": "drivesOn",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "left",
                "right"
              ]
            },
            "description": "Restrict the ranking to one side of the road"
          },
          {
            "name": "idpRequired",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "description": "Restrict the ranking by IDP requirement"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum countries"
          }
        ],
        "responses": {
          "200": {
            "description": "One entry, comparison rows, or ranked rows; attribution names the curated register"
          },
          "400": {
            "description": "A bad metric, sort or filter (INVALID_PARAM) or fewer than two countries (TOO_FEW)"
          },
          "422": {
            "description": "A country outside the spine (UNKNOWN_COUNTRY)"
          }
        }
      }
    },
    "/api/student-visas.json": {
      "get": {
        "operationId": "findStudentVisas",
        "summary": "Student-visa routes, matched to funds or listed per country",
        "description": "Hand-curated register: funds proof (amount, currency, per month/year), work hours in term, post-study stay, official page and check date. `funds` (+ `currency`, `per`) matches; `country` or `countries` lists. No tuition figures. For information only; every response says so first.",
        "parameters": [
          {
            "name": "funds",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Living funds the student can show"
          },
          {
            "name": "currency",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ISO 4217 code of funds (default USD)"
          },
          {
            "name": "per",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "year",
                "month"
              ]
            },
            "description": "Period of funds (default year)"
          },
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "One ISO alpha-2 code"
          },
          {
            "name": "countries",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated ISO alpha-2 codes, two or more"
          }
        ],
        "responses": {
          "200": {
            "description": "Match groups (qualify, nearMiss, unpublished, excluded, none), one entry, or comparison rows; attribution names the curated register"
          },
          "400": {
            "description": "No parameter (MISSING_PARAMS), a non-positive funds figure or bad period (INVALID_PARAM), or fewer than two countries (TOO_FEW)"
          },
          "422": {
            "description": "A country outside the spine (UNKNOWN_COUNTRY) or an unsupported currency (UNKNOWN_CURRENCY)"
          }
        }
      }
    },
    "/api/banking-access.json": {
      "get": {
        "operationId": "bankingAccess",
        "summary": "Opening an account as a newcomer, deposit protection and instant payments",
        "description": "Whether a non-resident can open a personal account (`yes`, `restricted`, `no`), the documents usually asked for, the statutory deposit guarantee in local currency and USD, the country's instant payment systems (World Bank Project FASTT), and the EU basic-account right where it applies. A hand-curated register over all 186 spine countries with the page and check date per row; secondary-sourced rows are marked. A country with no scheme has no `depositGuarantee` — never a zero. `country` for one, `countries` for a comparison; without either, a ranking by `metric`. International options are returned as categories, never named providers. For information only, not financial advice.",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "ISO alpha-2 code for a single country, e.g. PT."
          },
          {
            "name": "countries",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated ISO alpha-2 codes, at least two."
          },
          {
            "name": "metric",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "depositGuaranteeUsd",
                "instantPaymentsSince"
              ]
            },
            "description": "Ranking metric: depositGuaranteeUsd (default) or instantPaymentsSince."
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "highest",
                "lowest"
              ]
            },
            "description": "highest (default) or lowest; lowest lists the longest-running instant payment systems first."
          },
          {
            "name": "access",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "yes",
                "restricted",
                "no"
              ]
            },
            "description": "Narrow a ranking to one non-resident access rule."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Maximum rows in a ranking."
          }
        ],
        "responses": {
          "200": {
            "description": "A country entry, a comparison, or a ranking, each with caveats, international account categories and attribution."
          },
          "400": {
            "description": "Fewer than two countries (TOO_FEW) or an unrecognised metric, sort or access value (INVALID_PARAM)."
          },
          "422": {
            "description": "Country not on the 186-country spine (UNKNOWN_COUNTRY) or with no register entry (NO_DATA)."
          }
        }
      }
    },
    "/api/country-fit.json": {
      "get": {
        "operationId": "findCountryFit",
        "summary": "Countries ranked by your own weights on quality and cost",
        "description": "Blends the livability composite with budget reach by 0–10 weights; region, budget and visa are filters. A POST with `preferences` (words) is for paid plans and uses TypeSafe Jev to turn them into weights; GET is free. For information only; every response says so first.",
        "parameters": [
          {
            "name": "budget",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Monthly budget in USD (default 3000)"
          },
          {
            "name": "cost",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "description": "Weight 0–10 for cost (default 5)"
          },
          {
            "name": "internet",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "description": "Weight 0–10 for internet (default 5)"
          },
          {
            "name": "safety",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "description": "Weight 0–10 for safety (default 5)"
          },
          {
            "name": "healthcare",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "description": "Weight 0–10 for healthcare (default 5)"
          },
          {
            "name": "air",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "description": "Weight 0–10 for air (default 5)"
          },
          {
            "name": "english",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "description": "Weight 0–10 for english (default 5)"
          },
          {
            "name": "region",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "East Asia & Pacific",
                "Europe & Central Asia",
                "Latin America & Caribbean",
                "Middle East, North Africa, Afghanistan & Pakistan",
                "North America",
                "South Asia",
                "Sub-Saharan Africa"
              ]
            },
            "description": "World Bank region filter"
          },
          {
            "name": "withinBudget",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            },
            "description": "1 (default) keeps only countries the budget covers"
          },
          {
            "name": "needsVisa",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            },
            "description": "Keep only countries with a nomad visa the budget meets"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1
            },
            "description": "Maximum rows (default 10)"
          }
        ],
        "responses": {
          "200": {
            "description": "Match groups (qualify, nearMiss, unpublished, excluded, none), one entry, or comparison rows; attribution names the curated register"
          },
          "400": {
            "description": "No parameter (MISSING_PARAMS), a non-positive funds figure or bad period (INVALID_PARAM), or fewer than two countries (TOO_FEW)"
          },
          "422": {
            "description": "A country outside the spine (UNKNOWN_COUNTRY) or an unsupported currency (UNKNOWN_CURRENCY)"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "MissingParams": {
        "description": "Required parameters missing; body includes code, message, and a worked example."
      },
      "InvalidInput": {
        "description": "Well-formed but invalid input; body includes a machine-readable code (e.g. UNKNOWN_TARGET) and message."
      },
      "RateLimited": {
        "description": "A ceiling was exceeded. Body is { ok:false, code, message, retryAfterSeconds } where code is RATE_LIMITED (per-minute burst — back off and retry within the minute) or QUOTA_EXCEEDED (the monthly allowance is spent; retrying will not help until it resets on the 1st). Honour Retry-After.",
        "headers": {
          "Retry-After": {
            "description": "Seconds until the exceeded ceiling resets.",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Limit": {
            "description": "Requests allowed per minute for this caller (burst).",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Remaining": {
            "description": "Requests left in the current minute.",
            "schema": {
              "type": "integer"
            }
          },
          "X-RateLimit-Reset": {
            "description": "Minute window reset, epoch seconds.",
            "schema": {
              "type": "integer"
            }
          },
          "X-Quota-Limit": {
            "description": "Requests allowed this calendar month for this caller.",
            "schema": {
              "type": "integer"
            }
          },
          "X-Quota-Remaining": {
            "description": "Requests left this month.",
            "schema": {
              "type": "integer"
            }
          },
          "X-Quota-Reset": {
            "description": "Quota reset (1st of next month, UTC), epoch seconds.",
            "schema": {
              "type": "integer"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional Geo-Parity API key (gp_live_...), created at /account. Raises the monthly quota and per-minute burst; never changes a response. Metered per account, so extra keys do not add allowance."
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "key",
        "description": "The same key, for clients that cannot set headers."
      }
    }
  },
  "externalDocs": {
    "description": "Developer guide: quota ladder, error codes, API keys and MCP setup",
    "url": "https://geo-parity.com/developers/"
  }
}
