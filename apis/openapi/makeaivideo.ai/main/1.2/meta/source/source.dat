              "string",
              "null"
            ]
          }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "pub_..."
          },
          "status": {
            "type": "string",
            "enum": [
              "preparing",
              "importing",
              "pending",
              "scheduled",
              "publishing",
              "published",
              "partial",
              "failed"
            ],
            "description": "Terminal: published, partial, failed"
          },
          "done": {
            "type": "boolean"
          },
          "video_id": {
            "type": [
              "string",
              "null"
