    "/videos/character-swap": {
      "post": {
        "tags": [
          "Videos"
        ],
        "summary": "Character Swap: the person in your video becomes a character or the person in your photos. Motion, camera, room and the original audio are kept; lips stay in sync. 3-60 s",
        "operationId": "createCharacterSwap",
        "x-scope": "ai",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source_video_key": {
                    "type": "string",
                    "description": "From /uploads/video-avatar or /uploads/video-from-url"
                  },
                  "character_id": {
                    "type": "integer",
                    "description": "A preset or your own character. Send this OR photo_keys"
                  },
                  "photo_keys": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "1-4 photos of the new person (face-on first). Send this OR character_id"
                  },
                  "direction": {
                    "type": "string",
                    "maxLength": 400
                  },
                  "duration_seconds": {
                    "type": "number",
                    "description": "Length of the source clip, 3-60"
                  },
                  "rights_confirmed": {
                    "type": "boolean",
                    "description": "Must be true: you own the video (or have permission) and have the right to use the likeness"
                  },
                  "title": {
                    "type": "string"
                  },
                  "idempotency_key": {
                    "type": "string"
                  }
                },
                "required": [
                  "source_video_key",
                  "duration_seconds",
                  "rights_confirmed"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/VideoCreated"
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Not enough credits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
