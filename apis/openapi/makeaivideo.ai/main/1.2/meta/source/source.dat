    "/publishing/accounts/connect": {
      "post": {
        "tags": [
          "Publishing"
        ],
        "summary": "Link a PERSON opens to connect one OAuth account",
        "operationId": "createConnectLink",
        "x-scope": "write",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "platform": {
                    "type": "string",
                    "enum": [
                      "tiktok",
                      "instagram",
                      "youtube",
                      "facebook",
                      "linkedin",
                      "threads",
                      "pinterest",
                      "bluesky",
                      "telegram",
                      "discord",
                      "x"
                    ],
                    "description": "OAuth platforms only. bluesky, telegram and discord return 422 connect_in_web_app."
                  }
                },
                "required": [
                  "platform"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Link. A person must open `url` in a browser and approve; afterwards they land on the web app's Accounts page. Poll GET /publishing/accounts for the new account.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "platform": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "expires_in_seconds": {
                          "type": "integer"
                        },
                        "note": {
                          "type": "string"
                        }
                      }
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "publishing_unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "account_limit: the plan's account limit is reached (details.limit)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "connect_in_web_app (Bluesky, Telegram, Discord)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The publishing service refused or failed (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/videos/{id}/publish": {
      "post": {
        "tags": [
          "Publishing"
        ],
        "summary": "Post a finished video to connected accounts, now or scheduled (async)",
        "operationId": "publishVideo",
        "x-scope": "write",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Public video id, e.g. vid_abc123"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "account_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "acc_... ids from GET /publishing/accounts (1-20)"
                  },
                  "caption": {
                    "type": "string",
                    "maxLength": 10000,
                    "description": "Caption for every platform"
                  },
                  "caption_overrides": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 10000
                    },
                    "description": "Per-platform caption keyed by platform id; replaces caption there"
                  },
                  "youtube_title": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 100,
                    "description": "YouTube title. Default: the video's title"
                  },
                  "scheduled_for": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "description": "Omit or null to post now. Posts go out within about 2 minutes of this time"
                  },
                  "timezone": {
                    "type": "string",
                    "description": "IANA timezone, e.g. Europe/London"
                  },
                  "idempotency_key": {
                    "type": "string",
                    "description": "Same key within 24 hours returns the same post instead of posting again"
                  }
                },
                "required": [
                  "account_ids",
                  "caption"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted. Poll GET /publishing/posts/{id} until done is true",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Post"
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Video not ready, or a bad account id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "publishing_unavailable, or the key lacks the write scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Unknown video",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "no_accounts, account_unavailable (details.account_ids need reconnecting), or an idempotency_key still in flight",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "video_too_large (a platform's size or length limit, such as X's 140 seconds)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "The publishing service refused or failed (retryable)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/publishing/posts": {
      "get": {
        "tags": [
          "Publishing"
        ],
        "summary": "Publish history, newest first (keyset pagination)",
        "operationId": "listPosts",
        "x-scope": "read",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "next_cursor from the previous page"
          },
          {
            "name": "video_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Only this video's posts"
          }
        ],
        "responses": {
          "200": {
            "description": "Posts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "posts": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Post"
                          }
                        },
                        "has_more": {
                          "type": "boolean"
                        },
                        "next_cursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/publishing/posts/{id}": {
      "get": {
        "tags": [
          "Publishing"
        ],
        "summary": "One post: status and per-destination results",
        "operationId": "getPost",
        "x-scope": "read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Publish job (post) id, e.g. pub_abc123"
          }
        ],
        "responses": {
          "200": {
            "description": "Post",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Post"
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown post",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/device": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Start a device login",
        "operationId": "deviceStart",
        "security": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_name": {
                    "type": "string",
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Codes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "device_code": {
                          "type": "string"
                        },
                        "user_code": {
                          "type": "string"
                        },
                        "verification_uri": {
                          "type": "string"
                        },
                        "verification_uri_complete": {
                          "type": "string"
                        },
                        "expires_in": {
                          "type": "integer"
                        },
                        "interval": {
                          "type": "integer"
                        }
                      }
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too many starts from this IP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/auth/device/token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Poll a device login; receives the key once",
        "operationId": "deviceToken",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_code": {
                    "type": "string"
                  }
                },
                "required": [
                  "device_code"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "pending | slow_down | expired | denied | authorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "pending",
                            "slow_down",
                            "expired",
                            "denied",
                            "authorized"
                          ]
                        },
                        "api_key": {
                          "type": "string",
                          "description": "Only on authorized; shown once"
                        },
                        "api_key_id": {
                          "type": "integer"
                        },
                        "scopes": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "organization_id": {
                          "type": "integer"
                        },
                        "user": {
                          "type": [
                            "object",
                            "null"
                          ]
                        }
                      }
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "mav_...",
        "description": "Organization API key."
      }
    },
    "schemas": {
      "Meta": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              },
              "details": {}
            }
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "Me": {
        "type": "object",
        "properties": {
          "api_key": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "key_prefix": {
                "type": "string"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "created_at": {
                "type": "string"
              },
              "last_used_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "expires_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "write",
                "ai"
              ]
            }
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "role": {
                "type": "string"
              }
            }
          },
          "organization": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "plan": {
                "type": "string"
              },
              "subscription_status": {
                "type": "string"
              },
              "trial_end": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "entitled": {
                "type": "boolean"
              }
            }
          },
          "credits": {
            "$ref": "#/components/schemas/Credits"
          }
        }
      },
      "Credits": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string"
          },
          "subscription_status": {
            "type": "string"
          },
          "allowance": {
            "type": "integer"
          },
          "bonus": {
            "type": "integer"
          },
          "used": {
            "type": "integer"
          },
          "remaining": {
            "type": "integer"
          }
        }
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "default_aspect_ratio": {
            "type": [
              "string",
              "null"
            ]
          },
          "default_style": {
            "type": [
              "string",
              "null"
            ]
          },
          "default_character_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "Tools": {
        "type": "object",
        "properties": {
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "hint": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "required": {
                        "type": "boolean"
                      },
                      "multiline": {
                        "type": "boolean"
                      },
                      "max_length": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "example": {
                        "type": "string"
                      }
                    }
                  }
                },
                "defaults": {
                  "type": "object",
                  "properties": {
                    "duration_seconds": {
                      "type": "integer"
                    },
                    "durations": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "aspect_ratio": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "VideoScript": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "hook": {
            "type": "string"
          },
          "visual_thread": {
            "type": "string"
          },
          "total_duration_seconds": {
            "type": "number"
          },
          "hashtags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scenes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scene_number": {
                  "type": "integer"
                },
                "narration": {
                  "type": "string"
                },
                "visual_description": {
                  "type": "string"
                },
                "duration_seconds": {
                  "type": "number"
                },
                "scene_type": {
                  "type": "string",
                  "enum": [
                    "character",
                    "scene"
                  ]
                },
                "image_prompt": {
                  "type": "string"
                },
                "video_prompt": {
                  "type": "string"
                }
              },
              "required": [
                "scene_number",
                "narration",
                "visual_description",
                "duration_seconds"
              ]
            }
          }
        },
        "required": [
          "title",
          "hook",
          "scenes",
          "total_duration_seconds"
        ]
      },
      "CreateVideo": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "description": "Path A: a tool id from GET /tools; we write the script"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "duration_seconds": {
            "type": "integer"
          },
          "script": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "hook": {
                "type": "string"
              },
              "visual_thread": {
                "type": "string"
              },
              "total_duration_seconds": {
                "type": "number"
              },
              "hashtags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scenes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "scene_number": {
                      "type": "integer"
                    },
                    "narration": {
                      "type": "string"
                    },
                    "visual_description": {
                      "type": "string"
                    },
                    "duration_seconds": {
                      "type": "number"
                    },
                    "scene_type": {
                      "type": "string",
                      "enum": [
                        "character",
                        "scene"
                      ]
                    },
                    "image_prompt": {
                      "type": "string"
                    },
                    "video_prompt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "scene_number",
                    "narration",
                    "visual_description",
                    "duration_seconds"
                  ]
                }
              }
            },
            "required": [
              "title",
              "hook",
              "scenes",
              "total_duration_seconds"
            ],
            "description": "Path B: your own script (from /videos/script, /videos/scriptify, or hand-written)"
          },
          "title": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "talking-head",
              "cinematic",
              "hybrid",
              "stock-narrated",
              "smart-mix"
            ]
          },
          "style": {
            "type": "string",
            "enum": [
              "talking-head",
              "cinematic"
            ]
          },
          "character_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "voice_id": {
            "type": "string"
          },
          "music_id": {
            "type": "string"
          },
          "caption_style": {
            "type": "string"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "9:16",
              "1:1",
              "16:9"
            ]
          },
          "language": {
            "type": "string"
          },
          "start_generation": {
            "type": "boolean"
          },
          "idempotency_key": {
            "type": "string",
            "description": "Same key = same video. Set it when retrying."
          },
          "video_model": {
            "type": "string",
            "enum": [
              "minimax-h3-max",
              "minimax-h3-max-turbo",
              "kling-2.6"
            ],
            "description": "Video model family. Default minimax-h3-max (fastest, arena top-3). kling-2.6 renders 1080p but takes 2-4 minutes per clip."
          }
        },
        "description": "Send either tool + fields, or script. Not both."
      },
      "VideoCreated": {
        "type": "object",
        "properties": {
          "video_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "generating",
              "draft"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "scene_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "poll_after_seconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "next": {
            "type": "string"
          }
        }
      },
      "VideoList": {
        "type": "object",
        "properties": {
          "videos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "video_id": {
                  "type": "string"
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "type": "string"
                },
                "created_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "thumbnail_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "Video": {
        "type": "object",
        "properties": {
          "video_id": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "idea",
              "draft",
              "scripting",
              "generating",
              "scenes-ready",
              "composing",
              "ready",
              "failed"
            ],
            "description": "Terminal: ready, failed. A cancelled render ends as failed."
          },
          "progress": {
            "type": "object",
            "properties": {
              "note": {
                "type": "string"
              },
              "scenes_done": {
                "type": "integer"
              },
              "scenes_total": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          },
          "duration_seconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "aspect_ratio": {
            "type": [
              "string",
              "null"
            ]
          },
          "credits_used": {
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "download": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "poll_after_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "description": "null when terminal"
          }
        }
      },
      "SocialAccount": {
        "type": "object",
        "properties": {
          "id": {
