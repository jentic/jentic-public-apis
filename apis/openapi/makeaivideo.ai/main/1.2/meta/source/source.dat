    "/videos/script": {
      "post": {
        "tags": [
          "Scripts"
        ],
        "summary": "Write a script from a topic or a brief (no video yet)",
        "operationId": "generateScript",
        "x-scope": "ai",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "brief": {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "description": "A tool id from GET /tools"
                      },
                      "fields": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        },
                        "description": "The tool's brief fields by name"
                      },
                      "duration_seconds": {
                        "type": "integer"
                      },
                      "aspect_ratio": {
                        "type": "string",
                        "enum": [
                          "9:16",
                          "1:1",
                          "16:9"
                        ]
                      },
                      "language": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "tool",
                      "fields"
                    ]
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "talking-head",
                      "cinematic",
                      "hybrid",
                      "stock-narrated",
                      "smart-mix"
                    ]
                  },
                  "target_duration": {
                    "type": "integer"
                  },
                  "language": {
                    "type": "string"
                  },
                  "character_name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Script",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "script": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "hook": {
                              "type": "string"
                            },
                            "visual_thread": {
                              "type": "string"
                            },
                            "total_duration_seconds": {
                              "type": "number"
                            },
                            "hashtags": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "scenes": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "scene_number": {
                                    "type": "integer"
                                  },
                                  "narration": {
                                    "type": "string"
                                  },
                                  "visual_description": {
                                    "type": "string"
                                  },
                                  "duration_seconds": {
                                    "type": "number"
                                  },
                                  "scene_type": {
                                    "type": "string",
                                    "enum": [
                                      "character",
                                      "scene"
                                    ]
                                  },
                                  "image_prompt": {
                                    "type": "string"
                                  },
                                  "video_prompt": {
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "scene_number",
                                  "narration",
                                  "visual_description",
                                  "duration_seconds"
                                ]
                              }
                            }
                          },
                          "required": [
                            "title",
                            "hook",
                            "scenes",
                            "total_duration_seconds"
                          ]
                        },
                        "credits": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        }
                      }
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
