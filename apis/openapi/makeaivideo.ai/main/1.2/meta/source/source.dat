    "/videos/image-to-video": {
      "post": {
        "tags": [
          "Videos"
        ],
        "summary": "Animate one image into a 5 or 10 s clip; optional narration makes the subject speak it (voice + lip-sync)",
        "operationId": "createImageToVideo",
        "x-scope": "ai",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image_key": {
                    "type": "string",
                    "description": "From /uploads/reference or /uploads/reference-from-url"
                  },
                  "duration_seconds": {
                    "type": "integer",
                    "enum": [
                      5,
                      10
                    ]
                  },
                  "animation_prompt": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "narration": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "voice_id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "idempotency_key": {
                    "type": "string"
                  }
                },
                "required": [
                  "image_key"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/VideoCreated"
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          },
          "402": {
            "description": "Not enough credits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/videos/talking-avatar": {
      "post": {
        "tags": [
          "Videos"
        ],
        "summary": "Your own filmed video speaks a new script (voice + lip-sync onto your clip). For an AI presenter use POST /videos with mode talking-head",
        "operationId": "createTalkingAvatar",
        "x-scope": "ai",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "avatar_video_key": {
                    "type": "string",
                    "description": "From /uploads/video-avatar or /uploads/video-from-url"
                  },
                  "script": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 5000
                  },
                  "voice_id": {
                    "type": "string"
                  },
                  "add_broll": {
                    "type": "boolean"
                  },
                  "title": {
                    "type": "string"
                  },
                  "idempotency_key": {
                    "type": "string"
                  }
                },
                "required": [
                  "avatar_video_key",
                  "script",
                  "voice_id"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/VideoCreated"
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
