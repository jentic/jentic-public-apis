                    "description": "r2_key from POST /characters/variations or a key from /uploads/reference"
                  },
                  "voice_preview_temp_key": {
                    "type": "string",
                    "description": "from POST /characters/voice-previews"
                  },
                  "reference_temp_keys": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "voice_id": {
                    "type": "string"
                  },
                  "voice_settings": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "generation_prompt": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "style",
                  "portrait_temp_key",
                  "voice_preview_temp_key",
                  "voice_id"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Character",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "character": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      }
                    },
                    "error": {
                      "type": "null"
                    },
                    "meta": {
                      "$ref": "#/components/schemas/Meta"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
