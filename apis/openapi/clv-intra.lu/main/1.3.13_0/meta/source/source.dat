            "$ref": "#/components/schemas/Regulation.Fatca.ExemptedEntity",
            "description": "For exempted legal entity"
          },
          "active_entity": {
            "$ref": "#/components/schemas/Regulation.Fatca.ActiveEntity",
            "description": "For active entity that are not financial institution"
          },
          "passive_entity": {
            "$ref": "#/components/schemas/Regulation.Fatca.PassiveEntity",
            "description": "For passive entity that are not financial institution"
          }
        },
        "required": [
          "is_a_us_person"
        ]
      },
