              "NON_LUCRATIVE",
              "OTHER"
            ]
          },
          "other": {
            "type": "string",
            "description": "In case of OTHER - the specific type"
          }
        },
        "required": [
          "type"
        ]
      },
      "Regulation.Fatca.ExemptedEntity": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "LISTED_PUBLIC_EXCHANGE",
              "PUBLIC_ENTITY",
              "CENTRAL_BANK",
              "INTERNATION_ORGANISATION",
              "LOCAL"
            ]
          },
          "public_exchange": {
            "type": "string",
            "description": "In case of LISTED_PUBLIC_EXCHANGE - indicate a place where the stock can be traded"
          },
          "exact_status": {
            "type": "string",
            "description": "In case of LOCAL - indicate the exact fatca status"
          }
        },
        "required": [
          "type"
        ]
      },
      "Regulation.Fatca.FinancialInstitution": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "PARTICIPATING",
              "NON_DECLARANT",
              "NON_PARTICIPATING",
              "OTHER"
            ]
          },
          "giin": {
            "type": "string",
            "description": "In case of participating - indicate giin number"
          },
          "mainly_financial_assets": {
            "type": "boolean",
            "description": "Is the entity an investment entity whose gross income is mainly derived from investments,\n reinvestment or the trade of financial assets and is managed by a financial institution?"
          },
          "is_financial_assets_participating": {
            "type": "boolean",
            "description": "If mainlyFinancialAssets, is at least one of the countries of tax residence declared in\n Section II not a participating jurisdiction in the CRS? (for the list of participating\n countries: http://www.oecd.org/tax/exchange-of-tax-information/MCAA-Signatories.pdf)"
          }
        },
        "required": [
          "mainly_financial_assets",
          "type"
        ]
      },
