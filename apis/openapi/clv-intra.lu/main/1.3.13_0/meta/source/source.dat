  "servers": [
    {
      "url": "https://in1.clv-intra.lu/passif-services"
    },
    {
      "url": "https://foundation.clv.cardif.api.bnpparibas/oauth2/v1"
    }
  ],
  "tags": [
    {
      "name": "Process",
      "description": "Policy Process endpoints"
    },
    {
      "name": "Documents",
      "description": "Document endpoints"
    },
    {
      "name": "Utilities",
      "description": "the Utilities API"
    }
  ],
  "paths": {
    "/italy/subscription": {
      "post": {
        "tags": [
          "Process"
        ],
        "summary": "Subscription Dataset",
        "description": "Send the subscription dataset. This endpoint can be called multiple times, in `draft` or `final` mode. Once it is called in `final` cannot return to `draft`. Due to the size of the payload, only multipart request are supported",
        "operationId": "subscriptionDataset",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "subscriptionRequest": {
                    "$ref": "#/components/schemas/SubscriptionRequest",
                    "description": "(required)"
                  }
                },
                "required": [
                  "subscriptionRequest"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authentication": []
          }
        ]
      }
    },
    "/italy/proposal": {
      "post": {
        "tags": [
          "Process"
        ],
        "summary": "Proposal Create",
        "description": "Create a new Subscription process.",
        "operationId": "policyProposalCreate",
        "requestBody": {
          "description": "(required)",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProposalRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authentication": []
          }
        ]
      }
    },
    "/italy/process/status": {
      "get": {
        "tags": [
          "Utilities",
          "Firstance API"
        ],
        "summary": "Check Process Status",
        "description": "Read Process status",
        "operationId": "processStatusGet",
        "parameters": [
          {
            "name": "process_id",
            "in": "query",
            "description": "Process ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "transaction_id",
            "in": "query",
            "description": "Transaction ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessStatusGet200Response"
                }
              }
            }
          },
          "400": {
            "description": "Request Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authentication": []
          }
        ]
      },
      "post": {
        "tags": [
          "Process"
        ],
        "summary": "Process Status Change",
        "description": "Modify Process status",
        "operationId": "processStatusChange",
        "requestBody": {
          "description": "(required)",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authentication": []
          }
        ]
      }
    },
    "/italy/document/upload": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Document Upload",
        "description": "Upload a Document related to a process. Either `uri` or `content` must be filled.  Each document will be identified by a code agreed upon with the Insurance Company. The code `wire-transfer` is reserved for uploading the wire transfer receipt in `payment-collection` status.",
        "operationId": "documentUpload",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "processDocumentUploadRequest": {
                    "$ref": "#/components/schemas/ProcessDocumentUploadRequest",
                    "description": "(required)"
                  },
                  "document": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "document",
                  "processDocumentUploadRequest"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Request Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authentication": []
          }
        ]
      }
    },
    "/italy/process/print": {
      "get": {
        "tags": [
          "Process"
        ],
        "summary": "Process Print",
        "description": "Returns a pre-filled application form in PDF Format",
        "operationId": "processPrint",
        "parameters": [
          {
            "name": "process_id",
            "in": "query",
            "description": "Process ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "transaction_id",
            "in": "query",
            "description": "Transaction ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "code",
            "in": "query",
            "description": "Document Code",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Request Error",
            "content": {
              "application/pdf": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/pdf": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authentication": []
          }
        ]
      }
    },
    "/italy/document/checklist": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Document Process Checklist",
        "description": "Read the list of document status",
        "operationId": "documentChecklist",
        "parameters": [
          {
            "name": "process_id",
            "in": "query",
            "description": "Process ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "transaction_id",
            "in": "query",
            "description": "Transaction ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Checklist"
                }
              }
            }
          },
          "400": {
            "description": "Request Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "Authentication": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProcessResponse": {
        "type": "object",
        "description": "ProcessResponse",
        "properties": {
          "process_id": {
            "type": "string",
            "format": "uuid"
          },
          "transaction_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "error"
            ]
          }
        },
        "required": [
          "process_id",
          "status",
          "transaction_id"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Error",
        "properties": {
          "error": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "exception": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        },
        "required": [
          "error",
          "message",
          "path",
          "status",
          "timestamp"
        ]
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "arguments": {
            "type": "array",
            "items": {}
          },
          "defaultMessage": {
            "type": "string"
          },
          "objectName": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "rejectedValue": {},
          "bindingFailure": {
            "type": "boolean"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "AML": {
        "type": "object",
        "description": "AML",
        "properties": {
          "investment_scope": {
            "type": "string",
            "enum": [
              "complementary_income",
              "succession_planning",
              "assets_enhancement",
              "prudential_purposes",
              "guarantee_instrument",
              "project_preparation",
              "retirement",
              "other"
            ]
          },
          "gross_annual_income": {
            "$ref": "#/components/schemas/Amount"
          },
          "real_estate_assets": {
            "$ref": "#/components/schemas/Amount"
          },
          "securities": {
            "$ref": "#/components/schemas/Amount"
          },
          "participating_companies": {
            "$ref": "#/components/schemas/Amount"
          },
          "life_insurances": {
            "$ref": "#/components/schemas/Amount"
          },
          "liquidities": {
            "$ref": "#/components/schemas/Amount"
          },
          "other_assets": {
            "$ref": "#/components/schemas/Amount"
          },
          "wealth_origin_text": {
            "type": "string"
          }
        }
      },
      "Address": {
        "type": "object",
        "description": "Address",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "correspondence",
              "domicile",
              "legal",
              "operative",
              "residence",
              "financial_manager",
              "financial_manager_headquarters",
              "custodian_bank",
              "custodian_bank_headquarters",
              "legal_old"
            ]
          },
          "city": {
            "type": "string"
          },
          "province": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "description": "Country code ISO 3166-1 (https://www.iso.org/iso-3166-country-codes.html)"
          },
          "street_name": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "postal_code": {
            "type": "string"
          },
          "addressee": {
            "type": "string",
            "description": "For correspondence address"
          }
        },
        "required": [
          "city",
          "country",
          "postal_code",
          "province",
          "street_name",
          "type"
        ]
      },
      "Amount": {
        "type": "object",
        "description": "Amount",
        "properties": {
          "currency": {
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "currency",
          "value"
        ]
      },
      "BeneficiaryOptions": {
        "type": "object",
        "description": "BeneficiaryOptions",
        "properties": {
          "death_generic": {
            "type": "string",
            "enum": [
              "remaining_beneficiary",
              "legitimate_heirs",
              "testamentary_heirs_or_legitimate_heirs",
              "other"
            ]
          }
        }
      },
      "Clv.MainData": {
        "type": "object",
        "properties": {
          "funds_origin": {
            "$ref": "#/components/schemas/Clv.MainData.FundsOrigin"
          },
          "operations_planned": {
            "type": "string",
            "description": "What are the operations envisaged during the life of the contract?"
          },
          "operations_planned_frequency": {
            "type": "string",
            "description": "What frequency are the operations envisaged during the life of the contract?"
          },
          "client_relation_establishment_date": {
            "type": "string",
            "format": "date",
            "description": "When did the intermediary/adviser establish a relationship with the client?"
          },
          "client_relation_establishment": {
            "type": "string",
            "description": "how did the intermediary/adviser establish a relationship with the client?"
          },
          "last_meeting_date": {
            "type": "string",
            "format": "date",
            "description": "When was the last meeting?"
          },
          "physical_meeting": {
            "$ref": "#/components/schemas/Clv.MainData.NoOrYesWithDate",
            "description": "The insurance intermediary certifies having met, at least once, the client in person for the purpose of identification?"
          },
          "already_subscribed_life_insurance": {
            "type": "boolean",
            "description": "Has the policyholder already subscribed to life insurance policies/capital redemption bonds through you?"
          },
          "regular_payment": {
            "type": "boolean",
            "description": "In consideration of the facts at your disposal, does the payment seem to match the policyholder’s socio-economic profile?"
          },
          "additional_risk_factor": {
            "type": "boolean",
            "description": "Based on your previous knowledge of the client, are you aware of any AML/CFT risk factors that we have not been informed of (e.g. previous activity in a sensitive sector or country)?"
          },
          "unusual_address": {
            "$ref": "#/components/schemas/Clv.MainData.NoOrYesWithJustification",
            "description": "Has your client provided a non-standard address (e.g. a PO box address) or does he/she often change address? If so, do your client’s explanations seem reasonable?"
          },
          "unusual_country": {
            "$ref": "#/components/schemas/Clv.MainData.YesOrNoWithJustification",
            "description": "If your client is not in the geographical region normally covered by CLV, has he/she provided sufficient reasons to establish/continue a relationship with the BNPP Group in that country? If not, please assess the potential AML/CFT or tax risk that this represents <p>Yes, No or N/A(null)"
          },
          "public_sector_link": {
            "$ref": "#/components/schemas/Clv.MainData.NoOrYesWithJustification",
            "description": "To the best of your knowledge, does your client have professional links with the public sector (participation in public contracts, etc.) or with countries or sectors that are potentially high risk, giving rise to a risk of corruption? If so, please specify"
          },
          "unusual_income": {
            "type": "boolean",
            "description": "Has your client shown any reluctance to provide you with information/documents regarding the source of their wealth, income or activity? If so, do you think that your client’s reluctance to disclose the information/documents could be linked to risks of money laundering, corruption or terrorist financing?"
          },
          "mscq_ties": {
            "type": "boolean",
            "description": "Are there any past or present ties with the following countries: Iran, Syria, Cuba, North Korea and/or Crimea/Sevastopol/Donetsk People's Republic (DPR)/Luhansk People's Republic (LPR) (Ukraine-Russia) or any potential high-risk country?"
          },
          "unusual_transactions": {
            "$ref": "#/components/schemas/Clv.MainData.NoOrYesWithJustification",
            "description": "Are your client’s transactions unusual or inconsistent with the information you hold about the client (revenue, business sector, countries of activity, etc.) or with the stated purpose of the business relationship? If so, please specify"
          },
          "risky_relations": {
            "$ref": "#/components/schemas/Clv.MainData.NoOrYesWithJustification",
            "description": "Does the client have legal, professional or family ties with companies or individuals posing a significant risk (high-risk countries, undisclosed PEPs, high-net-worth individuals)? If so, which companies/individuals are they?"
          },
          "additional_politically_exposed_person": {
            "$ref": "#/components/schemas/Clv.MainData.NoOrYesWithJustification",
            "description": "Only for subscriptions by legal persons. Within your client’s company, are you aware of any PEPs other than the beneficial owners or directors previously identified? "
          },
          "additional_business_market": {
            "$ref": "#/components/schemas/Clv.MainData.NoOrYesWithJustification",
            "description": "Only for subscriptions by legal persons. Does your client earn revenue in countries or business sectors other than the ones disclosed?"
          }
        },
        "required": [
          "additional_risk_factor",
          "already_subscribed_life_insurance",
          "client_relation_establishment",
          "client_relation_establishment_date",
          "funds_origin",
          "last_meeting_date",
          "mscq_ties",
          "operations_planned",
          "operations_planned_frequency",
          "physical_meeting",
          "public_sector_link",
          "regular_payment",
          "risky_relations",
          "unusual_address",
          "unusual_income",
          "unusual_transactions"
        ]
      },
      "Clv.MainData.FundsOrigin": {
        "type": "object",
        "properties": {
          "savings": {
            "$ref": "#/components/schemas/Clv.MainData.FundsOrigin.Savings"
          },
          "fortune": {
            "$ref": "#/components/schemas/Clv.MainData.FundsOrigin.Fortune"
          },
          "donation": {
            "$ref": "#/components/schemas/Clv.MainData.FundsOrigin.Fortune"
          },
          "inheritance": {
            "$ref": "#/components/schemas/Clv.MainData.FundsOrigin.Inheritance"
          },
          "other": {
            "type": "string"
          },
          "fund_setup_countries": {
            "type": "string"
          },
          "fund_setup_countries_text": {
            "type": "string"
          },
          "life_insurance": {
            "$ref": "#/components/schemas/Clv.MainData.FundsOrigin.LifeInsurance"
          },
          "real_estate": {
            "$ref": "#/components/schemas/Clv.MainData.FundsOrigin.RealEstate"
          },
          "business_transfer": {
            "$ref": "#/components/schemas/Clv.MainData.FundsOrigin.BusinessTransfer"
          }
        },
        "required": [
          "fund_setup_countries",
          "fund_setup_countries_text"
        ]
      },
      "Clv.MainData.FundsOrigin.BusinessTransfer": {
        "type": "object",
        "properties": {
          "explanation": {
            "type": "string",
            "description": "Nature of the transaction (date of sale, name of company, total or partial transfer, amount of transaction, name of the buyer, number\nof shares held in the company’s capital prior to transfer and number of shares sold):"
          }
        },
        "required": [
          "explanation"
        ]
      },
      "Clv.MainData.FundsOrigin.Fortune": {
        "type": "object",
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "relationship": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "explanation": {
            "type": "string",
            "description": "Justification of the origin of the funds with regard to the donor (if originating from occupation/ profession, the exact position and\nplace of business of the donor’s employer)"
          },
          "donor_full_name": {
            "type": "string"
          }
        },
        "required": [
          "amount",
          "date",
          "donor_full_name",
          "explanation",
          "relationship"
        ]
      },
      "Clv.MainData.FundsOrigin.Inheritance": {
        "type": "object",
        "properties": {
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "relationship": {
            "type": "string"
          },
          "explanation": {
            "type": "string",
            "description": "Justification of the origin of the funds with regard to the deceased (if originating from occupation/profession, the exact position and\nplace of business of the deceased’s employer"
          },
          "deceased_full_name": {
            "type": "string"
          },
          "year_of_death": {
            "type": "string"
          }
        },
        "required": [
          "amount",
