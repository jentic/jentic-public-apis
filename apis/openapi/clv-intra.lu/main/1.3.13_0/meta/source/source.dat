      "Clv.SectionFund.StandardStrategy": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "instruments": {
            "type": "string",
            "description": "Exemples :\n <li>types of instrument;\n <li>issuer rating;\n <li>geographical area ;\n <li>currency exposure;\n <li>activity area ;\n <li>etc.",
            "minLength": 1
          },
          "horizon": {
            "type": "string",
            "description": "Investment horizon",
            "minLength": 1
          },
          "risk_level": {
            "type": "string",
            "description": "Examples:\n <li>risk exposure indicator (low, moderate, balanced, high, very high, etc.);\n <li>level of volatility, SRRI indicator, etc. ;\n <li>benchmark;\n <li>type of risk (loss of capital, liquidity, foreign exchange, credit, etc.);\n <li>etc.",
            "minLength": 1
          },
          "final_objective": {
            "type": "string",
            "description": "Examples:\n <li>preservation of capital, limited growth, capital appreciation, capital increase, generating\n     capital gains, etc. ;\n <li>level of market exposure;\n <li>expected return;\n <li>investment in a certain asset class to reduce volatility / diversify the portfolio / add a\n     dynamic component, etc. ;\n <li>desired behavior compared to a benchmark;\n <li>etc.",
            "minLength": 1
          },
          "money_market": {
            "$ref": "#/components/schemas/Clv.SectionFund.StandardStrategy.AssetClass",
            "description": "Money market and similar securities"
          },
          "money_market_with_terms": {
            "type": "boolean",
            "description": "The Internal Dedicated Fund may invest in current accounts, term deposits and monetary claims\n in general"
          },
          "bonds": {
            "$ref": "#/components/schemas/Clv.SectionFund.StandardStrategy.AssetClass",
            "description": "Bonds and similar securities"
          },
          "equities": {
            "$ref": "#/components/schemas/Clv.SectionFund.StandardStrategy.AssetClass",
            "description": "Equities and similar securities"
          },
          "alternative_funds": {
            "$ref": "#/components/schemas/Clv.SectionFund.StandardStrategy.AssetClass",
            "description": "Alternative funds"
          },
          "alternative_funds_to_funds": {
            "type": "boolean",
            "description": "Investments in alternative2 funds shall be made exclusively in funds of funds"
          },
          "real_estate_funds": {
            "$ref": "#/components/schemas/Clv.SectionFund.StandardStrategy.AssetClass",
            "description": "Real Estate funds"
          },
          "unlisted_securities": {
            "$ref": "#/components/schemas/Clv.SectionFund.StandardStrategy.AssetClassWithoutBoundaries",
            "description": "Unlisted securities"
          },
          "structured": {
            "$ref": "#/components/schemas/Clv.SectionFund.StandardStrategy.AssetClass",
            "description": "Structured"
          },
          "derivatives": {
            "$ref": "#/components/schemas/Clv.SectionFund.StandardStrategy.AssetClassWithoutBoundaries",
            "description": "Derivatives"
          },
          "enable_direct_investment": {
            "type": "boolean"
          },
          "enable_indirect_investment": {
            "type": "boolean"
          }
