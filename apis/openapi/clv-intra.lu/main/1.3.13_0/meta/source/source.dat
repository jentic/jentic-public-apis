    "contact": {
      "name": "Cardif Lux Vie - Digital Squad",
      "email": "digitalsquad@cardifluxvie.lu"
    },
    "version": "1.3.13_0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/GROSSINI_1/italy-operations-requests/1.3.13_0"
