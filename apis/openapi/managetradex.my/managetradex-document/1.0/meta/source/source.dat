{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0",
    "title": "ManageTradeX - Document API",
    "description": "Provides exchanging documents with the ManageTradeX platform.",
    "contact": {
      "name": "ManageTradeX Support",
      "url": "https://www.managetradex.com/",
      "email": "support@managetradex.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/managetradex/Document-API/1.0"
  },
  "servers": [
    {
      "url": "https://api-sbox.managetradex.my/api/1.0",
      "description": "Sandbox"
    }
  ],
  "paths": {
    "/documents/{docType}": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Get document details",
        "description": "Get document details by transaction id.",
        "parameters": [
          {
            "in": "path",
            "name": "docType",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/DocType"
            }
          },
          {
            "in": "query",
            "name": "transactionId",
            "required": false,
            "description": "Unique alphanumeric identity code for submitted document.",
            "schema": {
              "$ref": "#/components/schemas/TransactionId"
            }
          },
          {
            "in": "query",
            "name": "includeArtefacts",
            "description": "Include artefact. E.g. PDF",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response the document details in xml format.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceValidationResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "502": {
            "$ref": "#/components/responses/502"
          },
          "504": {
            "$ref": "#/components/responses/504"
          }
        },
        "security": [
          {
            "oAuth2ClientCredentials": []
          }
        ]
      },
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Submit document.",
        "description": "Submit a document in json/xml format for validation and processing.<br>\nUpon validation and processing completed, it will invoke callback api with success validation result or validation failed error.",
        "parameters": [
          {
            "in": "path",
            "name": "docType",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/DocType"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Invoice"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceXml"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The document submitted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentReponseMessage"
                }
              }
            }
          },
          "400": {
            "description": "Failed to submit the document with the error message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseMessage"
                },
                "example": {
                  "statusCode": "999",
                  "statusDescription": "Error message"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "502": {
            "$ref": "#/components/responses/502"
          },
          "504": {
            "$ref": "#/components/responses/504"
          }
        },
        "security": [
          {
            "oAuth2ClientCredentials": []
          }
        ]
      }
    },
    "/documents/{docType}/cancel": {
      "put": {
        "tags": [
          "Documents"
        ],
        "summary": "Cancel document",
        "description": "Cancel a validated document in MyInvois system.",
        "parameters": [
          {
            "in": "path",
            "name": "docType",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/DocType"
            }
          },
          {
            "in": "query",
            "name": "docNo",
            "required": true,
            "description": "The invoice or credit note number.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "reason",
            "required": true,
            "description": "Reason for cancelling the invoice.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The document cancelled successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseMessage"
                }
              }
            }
          },
          "400": {
            "description": "Failed to cancel the document with the error message.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseMessage"
                },
                "example": {
                  "statusCode": "999",
                  "statusDescription": "Error message"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "502": {
            "$ref": "#/components/responses/502"
          },
          "504": {
            "$ref": "#/components/responses/504"
          }
        },
        "security": [
          {
            "oAuth2ClientCredentials": []
          }
        ]
      }
    },
    "/validateTin/{tin}": {
      "get": {
        "tags": [
          "Validate"
        ],
        "summary": "TIN validation",
        "description": "This API is used to validate TIN.<br>\nThe input parameters of TIN, identity type and the actual value of the identity type selected are required to perform the validation.",
        "parameters": [
          {
            "in": "path",
            "name": "tin",
            "required": true,
            "description": "The Tax Identification Number of the supplier/buyer.",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "idType",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/IdentityType"
            }
          },
          {
            "in": "query",
            "name": "idValue",
            "required": true,
            "description": "The actual value of the id type selected.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The TIN is valid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseMessage"
                }
              }
            }
          },
          "400": {
            "description": "The TIN or any of the input parameters does not match.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReponseMessage"
                },
                "example": {
                  "statusCode": "999",
                  "statusDescription": "Error message"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "502": {
            "$ref": "#/components/responses/502"
          },
          "504": {
            "$ref": "#/components/responses/504"
          }
        },
        "security": [
          {
            "oAuth2ClientCredentials": []
          }
        ]
      }
    },
    "/lookup/participants/{peppolId}": {
      "get": {
        "tags": [
          "Lookup"
        ],
        "summary": "PEPPOL participant lookup",
        "description": "PEPPOL ID search and document types supported.",
        "parameters": [
          {
            "in": "path",
            "name": "peppolId",
            "required": true,
            "description": "The PEPPOL ID for the supplier/buyer.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response the matched PEPPODL ID and all the supported document types.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeppolReponseMessage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "502": {
            "$ref": "#/components/responses/502"
          },
          "504": {
            "$ref": "#/components/responses/504"
          }
        },
        "security": [
          {
            "oAuth2ClientCredentials": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oAuth2ClientCredentials": {
        "type": "oauth2",
        "description": "The authentication mechanism of this API supports OAuth 2.0 with the client credentials grant flow to obtain tokens. [More info](https://www.oauth.com/oauth2-servers/access-tokens/client-credentials/).",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth2/token",
            "scopes": {}
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "Unauthorised.\n* Due to an expired access token.\n* Due to invalid access token.\n",
        "content": {
          "application/error+json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseMessage"
            },
            "example": {
              "timestamp": "2024-09-02T09:17:06.14Z",
              "status": 401,
              "error": "Unauthorized"
            }
          }
        }
      },
      "403": {
        "description": "Access to the API is denied.",
        "content": {
          "application/error+json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseMessage"
            },
            "example": {
              "timestamp": "2024-09-02T09:17:06.14Z",
              "status": 403,
              "error": "Forbidden",
              "message": "Access to resource X not allowed."
            }
          }
        }
      },
      "404": {
        "description": "The requested resource not available.",
        "content": {
          "application/error+json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponseMessage"
            },
            "example": {
              "timestamp": "2024-09-02T09:17:06.14Z",
              "status": 404,
              "error": "Not found",
              "message": "Requested resource X is not found."
            }
          }
        }
      },
      "502": {
        "description": "Bad Gateway"
      },
      "504": {
        "description": "Gateway Timeout"
      }
    },
    "schemas": {
      "Invoice": {
        "type": "object",
        "properties": {
          "senderId": {
            "$ref": "#/components/schemas/SenderId"
          },
          "departmentCode": {
            "type": "string",
            "description": "Department code"
          },
          "docType": {
            "$ref": "#/components/schemas/DocType"
          },
          "docNo": {
            "type": "string",
            "description": "Unique Document number by supplier"
          },
          "docDate": {
            "type": "string",
            "format": "date",
            "description": "Document date"
          },
          "docTime": {
            "type": "string",
            "description": "Document time",
            "example": "15:30:41"
          },
          "currency": {
            "type": "string",
            "description": "Invoice/Credit Note currency code.<br>\nRefer to the Appendix for the 3 letter currency code to be used.\n",
            "minLength": 3,
            "maxLength": 3,
            "example": "MYR"
          },
          "deliveryMethod": {
            "type": "object",
            "nullable": true,
            "properties": {
              "method": {
                "$ref": "#/components/schemas/DeliveryMethod"
              },
              "peppolId": {
                "type": "string",
                "nullable": true,
                "description": "Unique alphanumeric code used within the Peppol network.<br>\nMandatory when delivery method is P(PEPPOL).\n"
              },
              "email": {
                "type": "string",
                "format": "email",
                "nullable": true,
                "description": "Email address of recipient to received generated PDF thru email.<br>\nMandatory when delivery method is E(Email).\n"
              }
            },
            "example": {
              "method": "E",
              "email": "xyz@buyer.com"
            }
          },
          "supplier": {
            "$ref": "#/components/schemas/Supplier"
          },
          "buyer": {
            "$ref": "#/components/schemas/Buyer"
          },
          "header": {
            "$ref": "#/components/schemas/Header"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "classification": {
                  "type": "string",
                  "description": "Category of products or services<br>\nLink for the list of classification codes:<br>\nhttps://sdk.myinvois.hasil.gov.my/codes/classification-codes/\n"
                },
                "itemId": {
                  "type": "string",
                  "nullable": true,
                  "description": "Product or service Item Id or code"
                },
                "description": {
                  "type": "string",
                  "description": "Description of product or service"
                },
                "quantity": {
                  "type": "number",
                  "format": "double",
                  "nullable": true,
                  "description": "Number of units of a particular product or service.<br>\nMax 9 digits and 3 decimals.\n"
                },
                "uom": {
                  "$ref": "#/components/schemas/Uom"
                },
                "unitPrice": {
                  "type": "number",
                  "format": "double",
                  "description": "Price assigned to a single unit of a product or service.<br>\nMax 2 decimals.\n"
                },
                "discount": {
                  "$ref": "#/components/schemas/ItemDiscount"
                },
                "charge": {
                  "$ref": "#/components/schemas/ItemCharge"
                },
                "totalTax": {
                  "type": "number",
                  "format": "double",
                  "nullable": true,
                  "description": "Total tax amount for the line item.<br>\nMax 2 decimals.\n"
                },
                "taxes": {
                  "type": "array",
                  "nullable": true,
                  "items": {
                    "$ref": "#/components/schemas/Tax"
                  }
                },
                "taxExmptRsn": {
                  "type": "string",
                  "nullable": true,
                  "description": "Description of tax exemption. Mandatory when tax exemption is applied."
                },
                "totalExclTax": {
                  "type": "number",
                  "format": "double",
                  "nullable": true,
                  "description": "Line amount excluding tax.<br>\nMax 2 decimals.\n"
                },
                "total": {
                  "type": "number",
                  "format": "double",
                  "nullable": true,
                  "description": "Total line amount including tax, discount or charge.<br>\nMax 2 decimals.\n"
                },
                "hscCode": {
                  "type": "string",
                  "nullable": true,
                  "description": "Harmonized system code of the goods."
                },
                "countryOrigin": {
                  "$ref": "#/components/schemas/CountryOfOrigin"
                }
              }
            },
            "example": [
              {
                "classification": "022",
                "itemId": "1001",
                "description": "Mouse Pad Eco",
                "quantity": 100,
                "uom": {
                  "code": "EA",
                  "name": "Each"
                },
                "unitPrice": 1.0,
                "totalTax": 5.0,
                "taxes": [
                  {
                    "taxable": 100.0,
                    "code": "ST",
                    "rate": 5,
                    "amount": 5.0
                  }
                ],
                "totalExclTax": 100.0,
                "total": 105.0
              },
              {
                "classification": "022",
                "itemId": "1002",
                "description": "Nexus Wireless Mouse E-2099",
                "quantity": 50,
                "uom": {
                  "code": "EA",
                  "name": "Each"
                },
                "unitPrice": 8.0,
                "totalTax": 20.0,
                "taxes": [
                  {
                    "taxable": 400.0,
                    "code": "ST",
                    "rate": 5,
                    "amount": 20.0
                  }
                ],
                "totalExclTax": 400.0,
                "total": 420.0
              }
            ]
          },
          "headerDiscounts": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/HeaderDiscount"
            }
          },
          "headerCharges": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/HeaderCharge"
            }
          },
          "summary": {
            "type": "object",
            "nullable": true,
            "properties": {
              "totalExclTax": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total invoice amount  without tax.<br>\nMax 2 decimals.\n",
                "example": 500.0
              },
              "discount": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total discount amount for the invoice.<br>\nMax 2 decimals.\n",
                "example": 5.0
              },
              "charge": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total charge amount for the invoice.<br>\nMax 2 decimals.\n",
                "example": 50.0
              },
              "totalTax": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total tax amount for the invoice.<br>\nMax 2 decimals.\n",
                "example": 27.5
              },
              "taxes": {
                "type": "array",
                "nullable": true,
                "items": {
                  "$ref": "#/components/schemas/Tax"
                },
                "example": [
                  {
                    "taxable": 550.0,
                    "code": "ST",
                    "rate": 5,
                    "amount": 27.5
                  }
                ]
              },
              "rounding": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The rounding amount for the invoice.<br>\nMax 2 decimals.\n"
              },
              "total": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total amount needs to be paid for the invoice.<br>\nMax 2 decimals.\n",
                "example": 572.5
              }
            }
          },
          "paymentMeans": {
            "type": "array",
            "nullable": true,
            "items": {
              "$ref": "#/components/schemas/PaymentMean"
            }
          },
          "paymentTerms": {
            "type": "object",
            "nullable": true,
            "properties": {
              "notes": {
                "type": "string",
                "description": "An agreed-upon payment terms and conditions"
              }
            }
          },
          "deliveryAddress": {
            "$ref": "#/components/schemas/DeliveryAddress"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "description": "Document notes"
          }
        }
      },
      "InvoiceXml": {
        "type": "object",
        "properties": {
          "senderId": {
            "$ref": "#/components/schemas/SenderId"
          },
          "departmentCode": {
            "type": "string",
            "description": "Department code"
          },
          "docType": {
            "$ref": "#/components/schemas/DocType"
          },
          "docNo": {
            "type": "string",
            "description": "Unique Document number by supplier"
          },
          "docDate": {
            "type": "string",
            "format": "date",
            "description": "Document date"
          },
          "docTime": {
            "type": "string",
            "description": "Document time",
            "example": "15:30:41"
          },
          "currency": {
            "type": "string",
            "description": "Invoice/Credit Note currency code.<br>\nRefer to the Appendix for the 3 letter currency code to be used.\n",
            "minLength": 3,
            "maxLength": 3,
            "example": "MYR"
          },
          "deliveryMethod": {
            "type": "object",
            "nullable": true,
            "properties": {
              "method": {
                "$ref": "#/components/schemas/DeliveryMethod"
              },
              "peppolId": {
                "type": "string",
                "nullable": true,
                "description": "Unique alphanumeric code used within the Peppol network.<br>\nMandatory when delivery method is P(PEPPOL).\n"
              },
              "email": {
                "type": "string",
                "format": "email",
                "nullable": true,
                "description": "Email address of recipient to received generated PDF thru email.<br>\nMandatory when delivery method is E(Email).\n"
              }
            },
            "example": {
              "method": "E",
              "email": "xyz@buyer.com"
            }
          },
          "supplier": {
            "$ref": "#/components/schemas/Supplier"
          },
          "buyer": {
            "$ref": "#/components/schemas/Buyer"
          },
          "header": {
            "$ref": "#/components/schemas/Header"
          },
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "classification": {
                      "type": "string",
                      "description": "Category of products or services<br>\nLink for the list of classification codes:<br>\nhttps://sdk.myinvois.hasil.gov.my/codes/classification-codes/\n"
                    },
                    "itemId": {
                      "type": "string",
                      "nullable": true,
                      "description": "Product or service Item Id or code"
                    },
                    "description": {
                      "type": "string",
                      "description": "Description of product or service"
                    },
                    "quantity": {
                      "type": "number",
                      "format": "double",
                      "nullable": true,
                      "description": "Number of units of a particular product or service.<br>\nMax 9 digits and 3 decimals.\n"
                    },
                    "uom": {
                      "$ref": "#/components/schemas/Uom"
                    },
                    "unitPrice": {
                      "type": "number",
                      "format": "double",
                      "description": "Price assigned to a single unit of a product or service.<br>\nMax 2 decimals.\n"
                    },
                    "discount": {
                      "$ref": "#/components/schemas/ItemDiscount"
                    },
                    "charge": {
                      "$ref": "#/components/schemas/ItemCharge"
                    },
                    "totalTax": {
                      "type": "number",
                      "format": "double",
                      "nullable": true,
                      "description": "Total tax amount for the line item.<br>\nMax 2 decimals.\n"
                    },
                    "taxes": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "tax": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Tax"
                          }
                        }
                      }
                    },
                    "taxExmptRsn": {
                      "type": "string",
                      "nullable": true,
                      "description": "Description of tax exemption. Mandatory when tax exemption is applied."
                    },
                    "totalExclTax": {
                      "type": "number",
                      "format": "double",
                      "nullable": true,
                      "description": "Line amount excluding tax.<br>\nMax 2 decimals.\n"
                    },
                    "total": {
                      "type": "number",
                      "format": "double",
                      "nullable": true,
                      "description": "Total line amount including tax, discount or charge.<br>\nMax 2 decimals.\n"
                    },
                    "hscCode": {
                      "type": "string",
                      "nullable": true,
                      "description": "Harmonized system code of the goods"
                    },
                    "countryOrigin": {
                      "$ref": "#/components/schemas/CountryOfOrigin"
                    }
                  }
                },
                "example": [
                  {
                    "classification": "022",
                    "itemId": "1001",
                    "description": "Mouse Pad Eco",
                    "quantity": 100,
                    "uom": {
                      "code": "EA",
                      "name": "Each"
                    },
                    "unitPrice": 1.0,
                    "totalTax": 5.0,
                    "taxes": {
                      "tax": {
                        "taxable": 100.0,
                        "code": "ST",
                        "rate": 5,
                        "amount": 5.0
                      }
                    },
                    "totalExclTax": 100.0,
                    "total": 105.0
                  },
                  {
                    "classification": "022",
                    "itemId": "1002",
                    "description": "Nexus Wireless Mouse E-2099",
                    "quantity": 50,
                    "uom": {
                      "code": "EA",
                      "name": "Each"
                    },
                    "unitPrice": 8.0,
                    "totalTax": 20.0,
                    "taxes": {
                      "tax": {
                        "taxable": 400.0,
                        "code": "ST",
                        "rate": 5,
                        "amount": 20.0
                      }
                    },
                    "totalExclTax": 400.0,
                    "total": 420.0
                  }
                ]
              }
            }
          },
          "headerDiscounts": {
            "type": "object",
            "nullable": true,
            "properties": {
              "headerDiscount": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HeaderDiscount"
                },
                "example": [
                  {
                    "description": "Quantity Discount",
                    "amount": 5
                  }
                ]
              }
            }
          },
          "headerCharges": {
            "type": "object",
            "nullable": true,
            "properties": {
              "headerCharge": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/HeaderCharge"
                },
                "example": [
                  {
                    "description": "Bank Charges",
                    "rate": 10,
                    "tax": {
                      "taxable": 50.0,
                      "code": "ST",
                      "rate": 5,
                      "amount": 2.5
                    }
                  }
                ]
              }
            }
          },
          "summary": {
            "type": "object",
            "nullable": true,
            "properties": {
              "totalExclTax": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total invoice amount  without tax.<br>\nMax 2 decimals.\n",
                "example": 500.0
              },
              "discount": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total discount amount for the invoice.<br>\nMax 2 decimals.\n",
                "example": 5.0
              },
              "charge": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total charge amount for the invoice.<br>\nMax 2 decimals.\n",
                "example": 50.0
              },
              "totalTax": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total tax amount for the invoice.<br>\nMax 2 decimals.\n",
                "example": 27.5
              },
              "taxes": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "tax": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Tax"
                    },
                    "example": [
                      {
                        "taxable": 550.0,
                        "code": "ST",
                        "rate": 5,
                        "amount": 27.5
                      }
                    ]
                  }
                }
              },
              "rounding": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The rounding amount for the invoice.<br>\nMax 2 decimals.\n"
              },
              "total": {
                "type": "number",
                "format": "double",
                "nullable": true,
                "description": "The total amount needs to be paid for the invoice.<br>\nMax 2 decimals.\n",
                "example": 572.5
              }
            }
          },
          "paymentMeans": {
            "type": "object",
            "nullable": true,
            "properties": {
              "paymentMean": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PaymentMean"
                },
                "example": [
                  {
                    "method": "B",
                    "bank": {
                      "name": "Maybank",
                      "accountName": "A B",
                      "accountNumber": "A1234567890"
                    }
                  },
                  {
                    "method": "C"
                  },
                  {
                    "method": "Q"
                  }
                ]
              }
            }
          },
          "paymentTerms": {
            "type": "object",
            "nullable": true,
            "properties": {
              "notes": {
                "type": "string",
                "description": "An agreed-upon payment terms and conditions"
              }
            }
          },
          "deliveryAddress": {
            "$ref": "#/components/schemas/DeliveryAddress"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "description": "Document notes"
          }
        },
        "xml": {
          "name": "invoice"
        }
      },
      "InvoiceValidationResult": {
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string",
            "description": "Unique alphanumeric identity code for submitted document."
          },
          "docType": {
            "$ref": "#/components/schemas/DocType"
          },
          "docNo": {
            "type": "string",
            "description": "Unique Invoice or Credit Note number by supplier"
          },
          "docDate": {
            "type": "string",
            "format": "date",
            "description": "Invoice/Credit Note date time",
            "example": "2024-09-23T15:30:41Z"
          },
          "currency": {
            "type": "string",
            "description": "Invoice/Credit Note currency code.<br>\nRefer to the Appendix for the 3 letter currency code to be used.\n",
            "minLength": 3,
            "maxLength": 3,
            "example": "MYR"
          },
          "supplier": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the supplier’s company."
              },
              "tin": {
                "type": "string",
                "description": "Supplier’s TIN assigned by IRBM."
              },
              "registrationNumber": {
                "type": "string",
                "description": "New BRN (12 digits) to be used."
              }
            }
          },
          "buyer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the buyer’s company."
              },
              "tin": {
                "type": "string",
                "description": "Buyer’s TIN assigned by IRBM."
              },
              "registrationNumber": {
                "type": "string",
                "description": "New BRN (12 digits) to be used."
              }
            }
          },
          "totalAmount": {
            "type": "number",
            "format": "double",
            "description": "Total amount of the invoice"
          },
          "digiSign": {
            "type": "string",
            "description": "Digital signature for the invoice."
          },
          "validationDate": {
            "type": "string",
            "format": "date",
            "description": "Validated date and time.",
            "example": "2024-09-23T15:30:43Z"
          },
          "validationStatus": {
            "type": "string",
            "description": "Validation status of the submitted invoice.\n* Processing - Document is processing\n* Valid - Document is validated\n* Invalid - Validation error\n",
            "example": "Valid"
          },
          "uuid": {
            "type": "string",
            "description": "Unique ID of the document assigned by IRBM when validation result is valid."
          },
          "link": {
            "type": "string",
            "description": "The public URL link to verify the validated e-invoices via MyInvois.<br>\nThis info is only available when the validation result is valid.\n"
          },
          "qrCode": {
            "type": "string",
            "description": "QR code image represented in Base64 format.<br>\nThis info is only available when the validation result is valid.\n"
          },
          "error": {
            "type": "string",
            "description": "Error message if the validation result is invalid only."
          },
          "artefacts": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "artefact type\n* PDF - Generated PDF file\n",
                  "enum": [
                    "PDF"
                  ]
                },
                "contentType": {
                  "type": "string",
                  "description": "MIME file content type. E.g. application/pdf"
                },
                "content": {
                  "type": "string",
                  "description": "File content in Base64."
                }
              }
            }
          }
        },
        "xml": {
          "name": "result"
        }
      },
      "Supplier": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the supplier’s company."
          },
          "tin": {
            "type": "string",
            "description": "Supplier’s TIN assigned by IRBM."
          },
          "identityType": {
            "type": "string",
            "description": "Supplier Identity Type. Only applicable for Self-billed.\n * BRN - Business Reg. No.\n * NRIC - MyKad\n * ARMY - Army No.\n * PASSPORT - Passport\n<br>\nDefault to ‘BRN’\n",
            "enum": [
              "BRN",
              "NRIC",
              "ARMY",
              "PASSPORT"
            ]
          },
          "registrationNumber": {
            "type": "string",
            "description": "New BRN (12 digits) to be used."
          },
          "taxNumber": {
            "type": "string",
            "nullable": true,
            "description": "SST registration number of the supplier. This is not applicable to the suppliers that are not SST registered."
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "contact": {
            "type": "object",
            "nullable": true,
            "properties": {
              "firstName": {
                "type": "string",
                "description": "First name of the contact person"
              },
              "lastName": {
                "type": "string",
                "description": "Last name of the contact person"
              }
            }
          },
          "email": {
            "type": "string",
            "description": "Email address of the supplier",
            "format": "email",
            "nullable": true,
            "example": "abc@supplier.com"
          },
          "telephone": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Country dialing code of the contact phone number.",
                "example": 60
              },
              "number": {
                "type": "string",
                "description": "The contact telephone number of the supplier (e.g,, office, mobile)",
                "example": 16889888
              }
            }
          }
        }
      },
      "Buyer": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the buyer’s company (recipient of goods or services)"
          },
          "tin": {
            "type": "string",
            "description": "Buyer’s TIN assigned by IRBM."
          },
          "identityType": {
            "$ref": "#/components/schemas/IdentityType"
          },
          "registrationNumber": {
            "type": "string",
            "description": "New BRN (12 digits) to be used."
          },
          "taxNumber": {
            "type": "string",
            "nullable": true,
            "description": "SST registration number of the buyer. This is not applicable to the buyers that are not SST registered."
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "contact": {
            "type": "object",
            "nullable": true,
            "properties": {
              "firstName": {
                "type": "string",
                "description": "First name of the contact person"
              },
              "lastName": {
                "type": "string",
                "description": "Last name of the contact person"
              }
            }
          },
          "email": {
            "type": "string",
            "description": "Email address of the buyer",
            "format": "email",
            "nullable": true,
            "example": "xyz@buyer.com"
          },
          "telephone": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Country dialing code of the contact phone number.",
                "example": 60
              },
              "number": {
                "type": "string",
                "description": "The contact telephone number of the buyer (e.g,, office, mobile)",
                "example": 88920202
              }
            }
          },
          "erpId": {
            "type": "string",
            "nullable": true,
            "description": "Buyer’s ERP identifier."
          }
        }
      },
      "Header": {
        "type": "object",
        "nullable": true,
        "properties": {
          "paymentDueDate": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "description": "Payment due date"
          },
          "exchangeRate": {
            "type": "object",
            "nullable": true,
            "properties": {
              "rate": {
                "type": "number",
                "format": "double",
                "description": "Currency exchange rate to the invoice currency.<br>\nMax 5 decimals.\n"
              },
              "currency": {
                "type": "string",
                "nullable": true,
                "description": "Exchange currency code. This is applicable when invoice currency is not MYR currency.<br> \nRefer to the Appendix for the 3 letter currency code to be used.<br>\nDefault is MYR.\n"
              },
              "exchangeDate": {
                "type": "string",
                "format": "date",
                "description": "Date of exchange rate.\n"
              }
            },
            "example": {
              "rate": 4.33876,
              "currency": "USD"
            }
          },
          "poNo": {
            "type": "string",
            "nullable": true,
            "description": "Purchase order number"
          },
          "taxPointDate": {
            "type": "string",
            "nullable": true,
            "format": "date",
            "description": "Tax point date"
          },
          "origInvNo": {
            "type": "string",
            "nullable": true,
            "description": "Original invoice reference number. Applicable when document type is credit note/debit note/refund note."
          },
          "billingReference": {
            "type": "string",
            "nullable": true,
            "description": "Bill reference number"
          },
          "billingFrequency": {
            "type": "string",
            "nullable": true,
            "description": "Frequency of the invoice (e.g., Monthly, Quarterly, Yearly, etc)"
          },
          "billingPeriod": {
            "type": "object",
            "nullable": true,
            "properties": {
              "startDate": {
                "type": "string",
                "format": "date",
                "description": "Start date of invoice period"
              },
              "endDate": {
                "type": "string",
                "format": "date",
                "description": "End date of invoice period"
              }
            }
          },
          "msic": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Supplier’s Malaysia Standard Industrial Classification (MSIC) Code. It is a 5-digit numeric code that represent the Supplier’s business nature and activity.<br>\nLink for the list of MSIC codes:<br>\nhttps://sdk.myinvois.hasil.gov.my/codes/msic-codes/\n",
                "example": 46510
              },
              "name": {
                "type": "string",
                "description": "Description of the supplier’s business activity.",
                "example": "Wholesale of computer hardware, software and peripherals"
              }
            }
          },
          "ftaInfo": {
            "type": "string",
            "nullable": true,
            "description": "Trade agreement between two or more countries."
          },
          "incoterms": {
            "type": "string",
            "nullable": true,
            "description": "A set of international trade rules that define the responsibilities of buyers and suppliers.<br>\nRefer to the Appendix for the INCOTERMS code to be used.\n"
          },
          "certExporterAuthNo": {
            "type": "string",
            "nullable": true,
            "description": "Authorisation Number for Certified Exporter"
          },
          "customsRef1": {
            "type": "string",
            "nullable": true,
            "description": "Unique number assigned on the declaration of goods imported. Customs Form No.1"
          },
          "customsRef2": {
            "type": "string",
            "nullable": true,
            "description": "Unique number assigned on the declaration of goods exported. Customs Form No.2"
          }
        }
      },
      "HeaderDiscount": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Header discount description\n"
          },
          "rate": {
            "type": "number",
            "format": "double",
            "description": "Header discount percentage.<br>\nMax 2 decimals.\n"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Header discount amount deducted from the original price of a product or service.<br>\nMax 2 decimals.\n"
          },
          "tax": {
            "$ref": "#/components/schemas/Tax"
          }
        },
        "example": [
          {
            "description": "Quantity Discount",
            "amount": 5
          }
        ]
      },
      "HeaderCharge": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "Header charge description\n"
          },
          "rate": {
            "type": "number",
            "format": "double",
            "description": "Header charge percentage.<br>\nMax 2 decimals.\n"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Header charge amount deducted from the original price of a product or service.<br>\nMax 2 decimals.\n"
          },
          "tax": {
            "$ref": "#/components/schemas/Tax"
          }
        },
        "example": [
          {
            "description": "Bank Charges",
            "rate": 10,
            "tax": [
              {
                "taxable": 50.0,
                "code": "ST",
                "rate": 5,
                "amount": 2.5
              }
            ]
          }
        ]
      },
      "ItemDiscount": {
        "type": "object",
        "nullable": true,
        "properties": {
          "description": {
            "type": "string",
            "description": "Discount description. If not provided, default to ‘Discount’\n"
          },
          "rate": {
            "type": "number",
            "format": "double",
            "description": "Discount percentage to the invoiced item.<br>\nMax 2 decimals.\n"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Line discount amount deducted from the original price of a product or service.<br>\nMax 2 decimals.\n"
          }
        }
      },
      "ItemCharge": {
        "type": "object",
        "nullable": true,
        "properties": {
          "description": {
            "type": "string",
            "description": "Charge description. If not provided, default to ‘Charge’\n"
          },
          "rate": {
            "type": "number",
            "format": "double",
            "description": "Charge percentage applied to the item.<br>\nMax 2 decimals.\n"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Charge amount to the item.<br>\nMax 2 decimals.\n"
          }
        }
      },
      "Uom": {
        "type": "object",
        "nullable": true,
        "properties": {
          "code": {
            "type": "string",
            "description": "Standard unit used to measure the product or service. (UN/ECE Recommendation 20, Revision 17)<br>\nLink for the list of UOM:<br>\nhttps://sdk.myinvois.hasil.gov.my/codes/unit-types/\n",
            "example": "EA"
          },
          "name": {
            "type": "string",
            "description": "Name/description of the UOM code.",
            "example": "Each"
          }
        }
      },
      "CountryOfOrigin": {
        "type": "object",
        "nullable": true,
        "properties": {
          "code": {
            "type": "string",
            "description": "A two-letter country code of the origin of goods.<br>\nRefer to the Appendix for the 2 letter country code to be used.\n",
            "example": "MY"
          },
          "name": {
            "type": "string",
            "description": "Country name",
            "example": "Malaysia"
          }
        }
      },
      "PaymentMean": {
        "type": "object",
        "properties": {
          "method": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "bank": {
            "type": "object",
            "nullable": true,
            "properties": {
              "name": {
                "type": "string",
                "description": "Bank name",
                "example": "Maybank"
              },
              "accountName": {
                "type": "string",
                "description": "Bank account no."
              },
              "accountNumber": {
                "type": "string",
                "description": "Bank account name"
              }
            }
          }
        },
        "example": [
          {
            "method": "B",
            "bank": {
              "name": "Maybank",
              "accountName": "A B",
              "accountNumber": "A1234567890"
            }
          },
          {
            "method": "C"
          },
          {
            "method": "Q"
          }
        ]
      },
      "DeliveryAddress": {
        "type": "object",
        "nullable": true,
        "properties": {
          "name": {
            "type": "string",
            "nullable": true,
            "description": "Name of the shipping recipient of the goods/services"
          },
          "tin": {
            "type": "string",
            "nullable": true,
            "description": "TIN of the shipping recipient"
          },
          "registrationType": {
            "$ref": "#/components/schemas/IdentityType"
          },
          "registrationNumber": {
            "type": "string",
            "nullable": true,
            "description": "Shipping recipient’s Registration / Identification number / Passport number"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "SenderId": {
        "type": "string",
        "description": "Unique Id assigned by MTX.",
        "minLength": 8,
        "maxLength": 8,
        "example": "MYXXXXXXX"
      },
      "PeppolId": {
        "type": "string",
        "description": "Unique alphanumeric code used within the Peppol network."
      },
      "TransactionId": {
        "type": "string",
        "description": "Unique alphanumeric identity code for submitted document."
      },
      "DocType": {
        "type": "string",
        "description": "Type of the document.\n * IN - Invoice\n * CN - Credit Note\n * DN - Debit Note\n * RN - Refund Note\n * SIN - Self-billed Invoice\n * SCN - Self-billed Credit Note\n * SDN - Self-billed Debit Note\n * SRN - Self-billed Refund Note\n",
        "enum": [
          "IN",
          "CN",
          "DN",
          "RN",
          "SIN",
          "SCN",
          "SDN",
          "SRN"
        ]
      },
      "IdentityType": {
        "type": "string",
        "description": "Identity Type.\n * BRN - Business Reg. No.\n * NRIC - MyKad\n * ARMY - Army No.\n * PASSPORT - Passport\n<br>\nDefault to ‘BRN’\n",
        "enum": [
          "BRN",
          "NRIC",
          "ARMY",
          "PASSPORT"
        ]
      },
      "DeliveryMethod": {
        "type": "string",
        "description": "Delivery method.\n * E - Email\n * P - PEPPOL\n * O - No delivery\n",
        "enum": [
          "O",
          "E",
          "P"
        ]
      },
      "PaymentMethod": {
        "type": "string",
        "description": "Payment methods:\n * B - Bank Transfer\n * C - Cash\n * D - Debit Card\n * R - Credit Card\n * Q - Cheque\n * W - e-Wallet\n",
        "enum": [
          "B",
          "C",
          "D",
          "R",
          "Q",
          "W"
        ]
      },
      "Address": {
        "type": "object",
        "properties": {
          "address1": {
            "type": "string",
            "description": "Address line 1"
          },
          "address2": {
            "type": "string",
            "description": "Address Line 2",
            "nullable": true
          },
          "city": {
            "type": "string",
            "description": "City name"
          },
          "postcode": {
            "type": "string",
            "description": "Postal code"
          },
          "state": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "The state code of the country in Malaysia.<br>\nRefer to the Appendix for the list of state codes.\n",
                "example": 10
              },
              "name": {
                "type": "string",
                "description": "State name",
                "example": "Selangor"
              }
            }
          },
          "country": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Country code.<br>\nRefer to the Appendix for the list of 2 letter country codes.\n",
                "example": "MY"
              },
              "name": {
                "type": "string",
                "description": "Country name",
                "example": "Malaysia"
              }
            }
          }
        }
      },
      "Tax": {
        "type": "object",
        "nullable": true,
        "properties": {
          "taxable": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Taxable amount for the line item."
          },
          "code": {
            "type": "string",
            "description": "Type of taxes for the line item. Mandatory when the line item is subjected to tax.<br>\n* ST = Sales Tax\n* SV = Service Tax\n* STE = Sales Tax Exempted\n* SVE = Service Tax Exempted\n* TTX = Tourism Tax\n* LVG = Sales Tax on LVG\n"
          },
          "quantity": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "Number of units of a particular tax.\n"
          },
          "rate": {
            "type": "number",
            "format": "double",
            "description": "Tax rate applied to the line item.<br>\nTax rate is mandatory when tax type is provided.<br>\nMax 2 decimals.\n"
          },
          "amount": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "tax amount"
          }
        }
      },
      "IncludeArtefacts": {
        "type": "boolean",
        "description": "To include artefact files in Base64 (E.g. PDF).<br/>  Default is false."
      },
      "ReponseMessage": {
        "type": "object",
        "description": "Response message in json.",
        "properties": {
          "statusCode": {
            "type": "string",
            "description": "Status code.\n* 000 - Success\n* 999 - Failed\n",
            "example": "000"
          },
          "statusDescription": {
            "type": "string",
            "description": "Status description.\n* SUCCESS_RESPONSE - Success\n* ERROR_RESPONSE - Failed\n",
            "example": "SUCCESS_RESPONSE"
          }
        }
      },
      "DocumentReponseMessage": {
        "type": "object",
        "description": "Response message in json.",
        "properties": {
          "statusCode": {
            "type": "string",
            "description": "Status code.\n* 000 - Success\n* 999 - Failed\n",
            "example": "000"
          },
          "statusDescription": {
            "type": "string",
            "description": "Status description.\n* SUCCESS_RESPONSE - Success\n* ERROR_RESPONSE - Failed\n",
            "example": "SUCCESS_RESPONSE"
          },
          "message": {
            "type": "object",
            "properties": {
              "transactionId": {
                "$ref": "#/components/schemas/TransactionId"
              }
            }
          }
        }
      },
      "ErrorResponseMessage": {
        "type": "object",
        "description": "Always available in the body for responses of type 'application/problem+json'.",
        "properties": {
          "timestamp": {
            "type": "string",
            "description": "Date and time of the error response.",
            "format": "date"
          },
          "status": {
            "type": "string",
            "description": "HTTP status codes."
          },
          "error": {
            "type": "string",
            "description": "HTTP status description."
          },
          "message": {
            "type": "string",
            "description": "Detailed error description."
          }
        }
      },
      "PeppolReponseMessage": {
        "type": "object",
        "description": "Response message in json.",
        "properties": {
          "statusCode": {
            "type": "string",
            "description": "Status code.\n* 000 - Success\n* 999 - Failed\n",
            "example": "000"
          },
          "statusDescription": {
            "type": "string",
            "description": "Status description.\n* SUCCESS_RESPONSE - Success\n* ERROR_RESPONSE - Failed\n",
            "example": "SUCCESS_RESPONSE"
          },
          "messages": {
            "type": "object",
            "properties": {
              "idScheme": {
                "type": "string"
              },
              "idType": {
                "type": "string"
              },
              "idValue": {
                "type": "string"
              },
              "supportedDocuments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "commonName": {
                      "type": "string"
                    },
                    "profileCode": {
                      "type": "string"
                    },
                    "documentLocalName": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "documentIdentifier": {
                      "type": "string"
                    },
                    "documentIdentifierScheme": {
                      "type": "string"
                    },
                    "processIdentifier": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
