{
  "openapi": "3.0.0",
  "servers": [
    {
      "url": "https://kong-3cdc8cc5a2usq6l5c.kongcloud.dev"
    }
  ],
  "info": {
    "description": "This is the API for our VNX Buy Calls list.",
    "version": "1.0.0",
    "title": "TradeVSA SMARTRobie® VNX Buy Calls",
    "contact": {
      "email": "support@tradevsa.com"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/tradevsa-3b0/TradeVSA_VNX_BuyCall/1.0.0"
  },
  "tags": [
    {
      "name": "client",
      "description": "Current VNX Buy Calls available"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "client"
        ],
        "operationId": "getBuyCalls",
        "description": "Retrieve current VNX Buy Calls available in the system\n",
        "responses": {
          "200": {
            "description": "VNX Buy Call results in JSON Array format.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BuyCalls"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Not Found"
          },
          "429": {
            "description": "API rate limit exceeded"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "parameters": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey"
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Unauthorized"
      }
    },
    "schemas": {
      "BuyCalls": {
        "type": "object",
        "required": [
          "stock_symbol",
          "stock_name",
          "buycall_rating",
          "pentagon_date",
          "valid_date",
          "industry",
          "remark",
          "syariah",
          "call_price",
          "tp1",
          "tp2",
          "sl",
          "last_close"
        ],
        "properties": {
          "stock_symbol": {
            "type": "string",
            "example": "VCB"
          },
          "stock_name": {
            "type": "string",
            "example": "Joint Stock Commercial Bank for Foreign Trade of Vietnam"
          },
          "buycall_rating": {
            "type": "number",
            "example": 5
          },
          "pentagon_date": {
            "type": "string",
            "example": "2025-08-21"
          },
          "valid_date": {
            "type": "string",
            "example": "2025-08-25"
          },
          "industry": {
            "type": "string",
            "example": "Financial Services"
          },
          "remark": {
            "type": "string",
            "example": "Long paragraph text containing information of the stock buy call"
          },
          "syariah": {
            "type": "string",
            "example": ""
          },
          "call_price": {
            "type": "number",
            "example": 64660
          },
          "tp1": {
            "type": "number",
            "example": 70000
          },
          "tp2": {
            "type": "number",
            "example": 75000
          },
          "sl": {
            "type": "number",
            "example": 60000
          },
          "last_close": {
            "type": "number",
            "example": 65660
          }
        }
      }
    }
  }
}
