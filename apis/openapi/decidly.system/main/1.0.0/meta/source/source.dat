{
  "openapi": "3.0.0",
  "info": {
    "title": "Decidly System API",
    "description": "API for managing Sets with create, update (draft), delete, and publish operations.",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/warsawuniversityofte-167/GeneratedAPI_2026-01-11-1947/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.decidly.system/v1"
    }
  ],
  "paths": {
    "/sets": {
      "post": {
        "operationId": "createSet",
        "summary": "Create a new Set",
        "tags": [
          "Sets"
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "My New Set"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Set created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Set"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/sets/{setId}": {
      "put": {
        "operationId": "updateSet",
        "summary": "Update Set / Save Draft",
        "tags": [
          "Sets"
        ],
        "parameters": [
          {
            "name": "setId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Set updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Set"
                }
              }
            }
          },
          "400": {
            "description": "Validation Error"
          },
          "404": {
            "description": "Set not found"
          }
        }
      },
      "delete": {
        "operationId": "deleteSet",
        "summary": "Delete Set",
        "tags": [
          "Sets"
        ],
        "parameters": [
          {
            "name": "setId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Set deleted successfully"
          },
          "404": {
            "description": "Set not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/sets/{setId}/publish": {
      "post": {
        "operationId": "publishSet",
        "summary": "Publish Set",
        "tags": [
          "Sets"
        ],
        "parameters": [
          {
            "name": "setId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Set published successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Set"
                }
              }
            }
          },
          "400": {
            "description": "Validation Error"
          },
          "409": {
            "description": "Conflict - e.g., already published"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Set": {
        "type": "object",
        "description": "A Set object representing a collection of items with status and metadata.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "name": {
            "type": "string",
            "example": "Example Set"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SetItem"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "NEW",
              "DRAFT",
              "PUBLISHED",
              "ARCHIVED"
            ],
            "example": "DRAFT"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-11T19:47:00Z"
          }
        }
      },
      "SetInput": {
        "type": "object",
        "description": "Input model for creating or updating a Set.",
        "required": [
          "name",
          "items"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Updated Set Name"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SetItemInput"
            }
          }
        }
      },
      "SetItem": {
        "type": "object",
        "description": "An item within a Set.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "1c6b147e-8f3a-4d2a-9f3e-1a2b3c4d5e6f"
          },
          "content": {
            "type": "string",
            "example": "Item content here"
          }
        }
      },
      "SetItemInput": {
        "type": "object",
        "description": "Input model for creating or updating a Set item.",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "example": "New item content"
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}
