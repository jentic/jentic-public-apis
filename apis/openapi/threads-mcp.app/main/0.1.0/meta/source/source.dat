ct","description":"Agent Skills discovery index.","required":["skills"],"properties":{"$schema":{"type":"string","format":"uri"},"skills":{"type":"array","items":{"type":"object","required":["name","url"],"properties":{"name":{"type":"string"},"type":{"type":"string"},"description":{"type":"string"},"url":{"type":"string","description":"Path or URL of the SKILL.md file."},"digest":{"type":"string","description":"`sha256:<hex>` digest of the SKILL.md file."}},"additionalProperties":true}}}},"OpenApiDocument":{"type":"object","description":"An OpenAPI 3.1 document.","required":["openapi","info","paths"],"properties":{"openapi":{"type":"string"},"info":{"type":"object","additionalProperties":true},"paths":{"type":"object","additionalProperties":true}},"additionalProperties":true}}}}