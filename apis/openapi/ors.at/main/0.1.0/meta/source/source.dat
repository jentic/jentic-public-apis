{
  "openapi": "3.1.0",
  "info": {
    "version": "0.1.0",
    "title": "sOps - Streaming Operations API",
    "description": "Client API for ORS's Streaming Operations Platform.",
    "contact": {
      "name": "Thomas Altenhofer",
      "email": "t.altenhofer@bigbluemarble.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/na-5ef-42f/sOps/0.1.0"
  },
  "servers": [
    {
      "url": "https://sops.ors.at/api/v1",
      "description": "Production"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "RECORD",
      "description": "Mange L2V-Recordings"
    },
    {
      "name": "CACHE",
      "description": "Flush Cached Objects"
    },
    {
      "name": "INGEST",
      "description": "Ingest a VoD-File"
    },
    {
      "name": "STORAGE",
      "description": "Manage VoD-Storage"
    },
    {
      "name": "NOTIFICATION",
      "description": "Subscribe to Notification Services"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Schema for 4xx, 5xx error responses.",
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "description": "Machine readable error code."
          },
          "message": {
            "type": "string",
            "description": "Human readable short description."
          },
          "source": {
            "type": "string",
            "description": "Origin of the error.",
            "enum": [
              "API",
              "DOWNSTREAM"
            ]
          },
          "service": {
            "type": "string",
            "description": "Downstream service (present only when source=DOWNSTREAM).",
            "enum": [
              "BKS",
              "BKM",
              "BKY",
              "SH1",
              "SH2",
              "SH3",
              "SH4",
              "VLX",
              "AWS"
            ]
          },
          "details": {
            "type": "string",
            "description": "Optional additional information."
          }
        }
      },
      "OrfChannel": {
        "type": "string",
        "description": "Supported channel.",
        "enum": [
          "orf1",
          "orf2",
          "orf3",
          "orfk",
          "orfs",
          "orf2w",
          "orf2n",
          "orf2b",
          "orf2stmk",
          "orf2k",
          "orf2ooe",
          "orf2s",
          "orf2t",
          "orf2v",
          "web01",
          "web02",
          "web03",
          "web04",
          "web05",
          "webo6",
          "web07",
          "web08",
          "web09",
          "web10",
          "web11",
          "web12"
        ]
      },
      "ServiceUser": {
        "type": "string",
        "description": "Service user.",
        "enum": [
          "orf-247",
          "orf-vod",
          "orf-vod-ixstg",
          "orf-vod-esstg"
        ]
      },
      "RecordService": {
        "type": "string",
        "description": "Recording service.",
        "enum": [
          "bpk"
        ]
      },
      "CacheService": {
        "type": "string",
        "description": "Caching service.",
        "enum": [
          "bpk",
          "all",
          "sh1",
          "sh2",
          "sh3",
          "sh4",
          "vlx",
          "aws"
        ]
      },
      "Timestamp": {
        "type": "string",
        "pattern": "^[0-9]{8}T[0-9]{6}$",
        "description": "UTC timestamp in the format YYYYMMDDTHHMMSS."
      },
      "RecordStatus": {
        "type": "string",
        "enum": [
          "Recorded",
          "Generated",
          "Failed",
          "Scheduled",
          "Deleted",
          "ToDelete"
        ]
      }
    },
    "parameters": {
      "RecordServicePath": {
        "name": "service",
        "in": "path",
        "required": true,
        "description": "Recording service to use.",
        "schema": {
          "$ref": "#/components/schemas/RecordService"
        },
        "example": "bpk"
      },
      "CacheServicePath": {
        "name": "service",
        "in": "path",
        "required": true,
        "description": "Service to flush.",
        "schema": {
          "$ref": "#/components/schemas/CacheService"
        },
        "example": "all"
      },
      "UserPath": {
        "name": "user",
        "in": "path",
        "required": true,
        "description": "Service user.",
        "schema": {
          "$ref": "#/components/schemas/ServiceUser"
        },
        "example": "orf-vod"
      },
      "ChannelPath": {
        "name": "channel",
        "in": "path",
        "required": true,
        "description": "Channel.",
        "schema": {
          "$ref": "#/components/schemas/OrfChannel"
        },
        "example": "orf1"
      },
      "VideoIdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Video identifier (e.g., VideoID, RecordID, ExtractionID).",
        "schema": {
          "type": "string"
        },
        "example": "ODUwNzQ2MTAyNzE3MDAxNzYxNjUwODIxLjc1NzExMzM4NDI4Nz"
      },
      "PageQuery": {
        "name": "page",
        "in": "query",
        "description": "Page number for filtered results.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "example": 1
      },
      "ItemsPerPageQuery": {
        "name": "itemsPerPage",
        "in": "query",
        "description": "Amount of filtered results per page.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        },
        "example": 100
      },
      "StartDateQuery": {
        "name": "startDate",
        "in": "query",
        "required": true,
        "description": "Filter by start date of the clip (YYYYMMDDTHHMMSS). When endDate is also present, all results between startDate and endDate are shown.",
        "schema": {
          "$ref": "#/components/schemas/Timestamp"
        },
        "example": "20260131T061000"
      },
      "EndDateQuery": {
        "name": "endDate",
        "in": "query",
        "required": true,
        "description": "Filter by end date of the clip (YYYYMMDDTHHMMSS). When startDate is also present, all results between startDate and endDate are shown.",
        "schema": {
          "$ref": "#/components/schemas/Timestamp"
        },
        "example": "20260131T061000"
      },
      "StatusQuery": {
        "name": "status",
        "in": "query",
        "description": "Filter results by status.",
        "schema": {
          "$ref": "#/components/schemas/RecordStatus"
        },
        "example": "Generated"
      },
      "ChannelQuery": {
        "name": "channel",
        "in": "query",
        "description": "Filter results by channel.",
        "schema": {
          "$ref": "#/components/schemas/OrfChannel"
        },
        "example": "orf1"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "400 Bad request response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "downstreamBadRequest": {
                "description": "A dependant service is returning a bad request.",
                "value": {
                  "code": "DOWNSTREAM_BAD_REQUEST",
                  "message": "Bad request.",
                  "source": "DOWNSTREAM",
                  "service": "BKS",
                  "details": "A dependant service cannot process the request due to invalid input."
                }
              },
              "apiBadRequest": {
                "description": "API is returing a bad request.",
                "value": {
                  "code": "API_BAD_REQUEST",
                  "message": "Bad request.",
                  "source": "API",
                  "details": "The API cannot process the request due to invalid input."
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "401 unauthorized response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "API_UNAUTHORIZED",
              "message": "Authentication required.",
              "source": "API",
              "details": "Missing or invalid API key."
            }
          }
        }
      },
      "Forbidden": {
        "description": "403 forbidden response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "notWhitelisted": {
                "description": "Client-IP is not whitelisted.",
                "value": {
                  "code": "NOT_WHITELISTED",
                  "message": "Not whitelisted.",
                  "source": "DOWNSTREAM",
                  "service": "SH1",
                  "details": "Client-IP is not on the whitelist."
                }
              },
              "userNotAuthorized": {
                "description": "API key is not authorized to use the defined path parameter user value.",
                "value": {
                  "code": "USER_FORBIDDEN",
                  "message": "Forbidden.",
                  "source": "API",
                  "details": "API key is not authorized for user path 'orf-vod'."
                }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "404 not found response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "NOT_FOUND",
              "message": "Ressource not found.",
              "source": "DOWNSTREAM",
              "service": "BKS",
              "details": "The requested ressource does not exist."
            }
          }
        }
      },
      "NotAcceptable": {
        "description": "406 not acceptable response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "NOT_ACCEPTABLE",
              "message": "Not acceptable.",
              "source": "DOWNSTREAM",
              "service": "BKS",
              "details": "Requested date range is outdated."
            }
          }
        }
      },
      "TooEarly": {
        "description": "425 too early response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "TOO_EARLY",
              "message": "Too early.",
              "source": "DOWNSTREAM",
              "service": "BKS",
              "details": "Requested date range is in the future."
            }
          }
        }
      },
      "InternalServerError": {
        "description": "500 internal server error response (API failure).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "API_ERROR",
              "message": "Internal server error.",
              "source": "API",
              "details": "An unexpected error occurred."
            }
          }
        }
      },
      "BadGateway": {
        "description": "502 bad gateway response (invalid response from downstream service).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "DOWNSTREAM_BAD_GATEWAY",
              "message": "Bad gateway.",
              "source": "DOWNSTREAM",
              "service": "BKS",
              "details": "A dependent service returned an invalid response."
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "503 service unavailable response (API or downstream temporarily unavailable).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "apiUnavailable": {
                "value": {
                  "code": "API_UNAVAILABLE",
                  "message": "Temporarily unavailable.",
                  "source": "API",
                  "details": "The API is currently unavailable. Please try again later."
                }
              },
              "downstreamUnavailable": {
                "value": {
                  "code": "DOWNSTREAM_UNAVAILABLE",
                  "message": "Service unavailable.",
                  "source": "DOWNSTREAM",
                  "service": "BKM",
                  "details": "A dependent service is currently unavailable."
                }
              }
            }
          }
        }
      },
      "GatewayTimeout": {
        "description": "504 gateway timeout response (downstream did not respond in time).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "code": "DOWNSTREAM_TIMEOUT",
              "message": "Gateway timeout.",
              "source": "DOWNSTREAM",
              "service": "BKS",
              "details": "A dependent service did not respond in time."
            }
          }
        }
      }
    },
    "requestBodies": {
      "RecordingRequest": {
        "description": "Recording request body object.",
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "Source",
                "StartDate",
                "EndDate",
                "DeliveryType"
              ],
              "additionalProperties": false,
              "properties": {
                "Source": {
                  "type": "string",
                  "description": "Channel source (e.g. orf1)."
                },
                "StartDate": {
                  "$ref": "#/components/schemas/Timestamp",
                  "description": "UTC start date of the recording (YYYYMMDDTHHMMSS)."
                },
                "EndDate": {
                  "$ref": "#/components/schemas/Timestamp",
                  "description": "UTC end date of the recording (YYYYMMDDTHHMMSS)."
                },
                "EndUserID": {
                  "type": "string",
                  "maxLength": 64,
                  "description": "Optional ID field (e.g., for exteranl IDs)."
                },
                "DeliveryType": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": [
                        "OTT",
                        "DSH",
                        "HLS",
                        "MP4"
                      ]
                    },
                    {
                      "type": "object",
                      "maxProperties": 0
                    }
                  ],
                  "description": "'OTT' for HLS and DASH recordings; 'DSH' for only DASH and 'HLS' for only HLS recordings. 'MP4' for MP4 clip extraction. When empty, all types are extracted."
                },
                "ExtractOptions": {
                  "type": "object",
                  "description": "Additional options for MP4 extraction. When empty or not added, all quality layers are extracted.",
                  "properties": {
                    "Profile": {
                      "type": "string",
                      "description": "'highest' extracts only the highest video quality layer.",
                      "enum": [
                        "highest"
                      ]
                    },
                    "Priority": {
                      "type": "integer",
                      "description": "Sets the extraction job priority. '0' is the lowest priority; higher values increase the priority."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/record/{service}/{user}/preview": {
      "post": {
        "tags": [
          "RECORD"
        ],
        "summary": "Requests preview manifest from rolling buffer.",
        "operationId": "recordPreview",
        "parameters": [
          {
            "$ref": "#/components/parameters/RecordServicePath"
          },
          {
            "$ref": "#/components/parameters/UserPath"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/RecordingRequest"
        },
        "responses": {
          "200": {
            "description": "Successfully returned a manifest.",
            "content": {
              "application/dash+xml": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "mpdPreview": {
                    "summary": "Minimal DASH MPD",
                    "value": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<MPD\n  xmlns=\"urn:mpeg:dash:schema:mpd:2011\"\n  type=\"static\"\n  minBufferTime=\"PT2S\"\n  mediaPresentationDuration=\"PT5M0.480S\"\n  profiles=\"urn:com:dashif:dash264\">\n\n  <Period id=\"1\" duration=\"PT5M0.480S\">\n    <BaseURL>dash/</BaseURL>\n\n    <!-- Audio (de) -->\n    <AdaptationSet\n      id=\"a1\"\n      contentType=\"audio\"\n      lang=\"de\"\n      mimeType=\"audio/mp4\"\n      codecs=\"mp4a.40.2\"\n      segmentAlignment=\"true\"\n      startWithSAP=\"1\">\n      <AudioChannelConfiguration\n        schemeIdUri=\"urn:mpeg:dash:23003:3:audio_channel_configuration:2011\"\n        value=\"2\"/>\n      <SegmentTemplate\n        timescale=\"48000\"\n        startNumber=\"1\"\n        initialization=\"orf1-$RepresentationID$.dash?location=g.at.9\"\n        media=\"orf1-$RepresentationID$-$Time$.dash?location=g.at.9\">\n        <SegmentTimeline>\n          <!-- Start bei 0, konstante Dauer -->\n          <S t=\"0\" d=\"46080\" r=\"312\"/>\n        </SegmentTimeline>\n      </SegmentTemplate>\n      <Representation\n        id=\"audio_ger\"\n        bandwidth=\"206000\"\n        audioSamplingRate=\"48000\"/>\n    </AdaptationSet>\n\n    <!-- Video -->\n    <AdaptationSet\n      id=\"v1\"\n      contentType=\"video\"\n      mimeType=\"video/mp4\"\n      codecs=\"avc1.4D401E\"\n      segmentAlignment=\"true\"\n      startWithSAP=\"1\"\n      par=\"16:9\"\n      sar=\"1:1\">\n      <SegmentTemplate\n        timescale=\"600\"\n        startNumber=\"1\"\n        initialization=\"orf1-$RepresentationID$.dash?location=g.at.9\"\n        media=\"orf1-$RepresentationID$-$Time$.dash?location=g.at.9\">\n        <SegmentTimeline>\n          <S t=\"0\" d=\"576\" r=\"312\"/>\n        </SegmentTimeline>\n      </SegmentTemplate>\n      <Representation\n        id=\"video_496k\"\n        bandwidth=\"496400\"\n        width=\"512\"\n        height=\"288\"\n        frameRate=\"25\"\n        scanType=\"progressive\"/>\n    </AdaptationSet>\n\n  </Period>\n</MPD>\n"
                  }
                }
              },
              "application/vnd.apple.mpegurl": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "hlsMaster": {
                    "summary": "Minimal HLS Master Playlist",
                    "value": "#EXTM3U\n#EXT-X-VERSION:7\n\n# AUDIO group\n#EXT-X-MEDIA:TYPE=AUDIO,GROUP-ID=\"audio-aacl-206\",LANGUAGE=\"de\",NAME=\"Deutsch\",DEFAULT=YES,AUTOSELECT=YES,CHANNELS=\"2\",URI=\"orf1-audio_206101_ger=206000.m3u8?location=g.at.9&vbegin=1769044800&vend=1769045100\"\n\n# SUBTITLES group\n#EXT-X-MEDIA:TYPE=SUBTITLES,GROUP-ID=\"textstream\",LANGUAGE=\"de\",NAME=\"Deutsch\",DEFAULT=YES,AUTOSELECT=YES,CHARACTERISTICS=\"public.accessibility.transcribes-spoken-dialog\",URI=\"orf1-textstream_1270351735_deu=8000.m3u8?location=g.at.9&vbegin=1769044800&vend=1769045100\"\n\n# Single variant (minimal)\n#EXT-X-STREAM-INF:BANDWIDTH=817000,AVERAGE-BANDWIDTH=743000,CODECS=\"mp4a.40.2,avc1.4D401E\",RESOLUTION=512x288,FRAME-RATE=25,VIDEO-RANGE=SDR,AUDIO=\"audio-aacl-206\",SUBTITLES=\"textstream\",CLOSED-CAPTIONS=NONE\norf1-video=496400.m3u8?location=g.at.9&vbegin=1769044800&vend=1769045100\n"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "425": {
            "$ref": "#/components/responses/TooEarly"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          },
          "502": {
            "$ref": "#/components/responses/BadGateway"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          },
          "504": {
            "$ref": "#/components/responses/GatewayTimeout"
          }
        }
      }
    },
    "/record/{service}/{user}/create": {
      "post": {
        "tags": [
          "RECORD"
        ],
        "summary": "Creates recording/extraction job.",
        "operationId": "recordCreate",
        "parameters": [
          {
            "$ref": "#/components/parameters/RecordServicePath"
          },
          {
            "$ref": "#/components/parameters/UserPath"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/RecordingRequest"
        },
        "responses": {
          "200": {
            "description": "Recording or extraction job successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "PlayingURL"
                  ],
                  "properties": {
                    "PlayingURL": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "Type",
                          "URL"
                        ],
                        "properties": {
                          "Type": {
                            "type": "string",
                            "enum": [
                              "HLS",
                              "HLS-DRM",
                              "DASH",
                              "DASH-DRM",
                              "SMIL",
                              "MP4"
                            ]
                          },
                          "URL": {
                            "type": "string",
                            "format": "uri"
                          },
                          "addidionalProperties": false
                        }
                      }
                    },
                    "RecordID": {
                      "type": "string",
                      "descripiton": "ID of the HLS-/DASH- Recording Job."
                    },
                    "ExtractionID": {
                      "type": "string",
                      "descripiton": "ID of the MP4 Extraction Job."
                    },
                    "EndUserID": {
                      "type": "string",
                      "maxLength": 64,
                      "description": "Optional ID field (e.g. for exteranl IDs)."
                    }
                  },
                  "additionalProperties": false
                },
                "example": {
                  "PlayingURL": [
                    {
                      "Type": "HLS",
                      "URL": "https://vod-ixstg.mdn.ors.at/orf/orfk/qxa-l2v/index.m3u8?begin=20260119T105500&end=20260119T110000&type=record&subtitle=none"
                    },
                    {
                      "Type": "HLS-DRM",
                      "URL": "https://vod-ixstg.mdn.ors.at/orf/orfk/drmqxa-l2v/index.m3u8?begin=20260119T105500&end=20260119T110000&type=record&subtitle=none"
                    },
                    {
                      "Type": "DASH",
                      "URL": "https://vod-ixstg.mdn.ors.at/orf/orfk/qxa-l2v/index.mpd?begin=20260119T105500&end=20260119T110000&type=record&subtitle=none"
                    },
                    {
                      "Type": "DASH-DRM",
                      "URL": "https://vod-ixstg.mdn.ors.at/orf/orfk/drmqxa-l2v/index.mpd?begin=20260119T105500&end=20260119T110000&type=record&subtitle=none"
                    },
                    {
                      "Type": "SMIL",
                      "URL": "https://vod-ixstg.mdn.ors.at/orf/orfk/extract/1768785000_1768785060/orfk-1768785000-1768785060.smil"
                    },
                    {
                      "Type": "MP4",
                      "URL": "https://vod-ixstg.mdn.ors.at/orf/orfk/extract/1768785000_1768785060/orfk-1768785000-1768785060_5299600.mp4"
                    }
                  ],
                  "RecordID": "MjM1Nzk5N1VOSVFJRF82OTZlMmU5MWMyODFmOTAwMzg4NTQyMTc2ODgyODU2MS43OTYyMTQ0MDY5NjczOA",
                  "ExtractionID": "MjE3MTk0OXRlc3QxNzY4ODI4NzU1LjgxMjUxMjg2MDQyMz",
                  "EndUserID": "UNIQID_696e2e91c281f900388542"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
