,"description":"Whether the render cache served it, as in x-render-cache"}},"required":["format","contentType","content","diagramType","mermaidVersion","requestId","cacheStatus"],"additionalProperties":false},"RenderRequest":{"type":"object","properties":{"code":{"type":"string","minLength":1,"description":"Diagram code"},"format":{"type":"string","enum":["svg","png","pdf"],"description":"Output format"},"config":{"description":"The standard Mermaid config object, any subset; omitted keys take Mermaid defaults","$ref":"#/components/schemas/MermaidConfig"},"png":{"description":"Format options for png; ignored for other formats","$ref":"#/components/schemas/PngOptions"},"pdf":{"description":"Format options for pdf; ignored for other formats","$ref":"#/components/schemas/PdfOptions"},"cache":{"default":true,"description":"false: this render is neither served from nor stored in the render cache; the cache is also off for a key when a super admin disabled it, whatever this says","type":"boolean"}},"required":["code","format"]},"PngOptions":{"type":"object","properties":{"scale":{"default":2,"description":"Device pixels per CSS pixel; lowered when the image would exceed the service ceiling","type":"number","minimum":0.5,"maximum":4},"background":{"default":"white","description":"CSS colour behind the diagram, or transparent","type":"string","pattern":"^(transparent|[a-z]{3,20}|#[0-9a-f]{3,8}|(rgb|hsl)a?\\([0-9.,\\s%]+\\))$"}}},"PdfOptions":{"type":"object","properties":{"fit":{"default":true,"description":"true: the page is the size of the diagram; false: one A4 page, the diagram scaled down to fit","type":"boolean"}}},"Balance":{"type":"object","properties":{"ownerType":{"type":"string","enum":["user","organisation"],"description":"Whose balance: the key owner's own on a personal key, the organisation's on an organisation key"},"month":{"type":"string","description":"The current calendar month, YYYY-MM, UTC"},"allowance":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"The owner's API credits per month across all their keys"},"spent":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"The API credits charged to all the owner's keys this month, purchased ones included"},"remaining":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"What is left of the allowance, never below zero; purchased credits are apart"},"resetAt":{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$","description":"When the allowance resets: the first instant of next month, UTC"},"purchasedSpent":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"The purchased API credits charged to the owner's keys this month"},"spendLimit":{"anyOf":[{"type":"integer","minimum":0,"maximum":9007199254740991},{"type":"null"}],"description":"The most purchased API credits the keys may spend in a calendar month, UTC; null, no limit"},"autoTopUp":{"oneOf":[{"type":"object","properties":{"enabled":{"type":"boolean","const":true},"pack":{"type":"integer","minimum":1000,"maximum":1000000,"multipleOf":1000,"description":"The credit pack bought, in API credits"},"threshold":{"type":"integer","minimum":0,"maximum":9007199254740991,"description":"The balance in API credits under which the pack is bought"}},"required":["enabled","pack","threshold"],"additionalProperties":false},{"type":"object","properties":{"enabled":{"type":"boolean","const":false}},"required":["enabled"],"additionalProperties":false}],"description":"The owner's auto top-up: on, with its pack and threshold, or off"},"purchased":{"description":"The owner's purchased API credits, each purchase valid twelve months","$ref":"#/components/schemas/PurchasedCredits"},"costs":{"type":"array","items":{"$ref":"#/components/schemas/EndpointCost"},"description":"Every keyed endpoint, this one included"}},"required":["ownerType","month","allowance","spent","remaining","resetAt","purchasedSpent","spendLimit","autoTopUp","purchased","costs"],"additionalProperties":false},"PurchasedCredits":{"type":"object","properties":{"remaining":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"API credits left from purchases that have not expired"},"soonestExpiry":{"anyOf":[{"type":"string","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"},{"type":"null"}],"description":"When the first of those credits expire; null when there are none"}},"required":["remaining","soonestExpiry"],"additionalProperties":false},"EndpointCost":{"type":"object","properties":{"method":{"type":"string"},"path":{"type":"string"},"callClass":{"type":"string","description":"The call class the endpoint is metered as"},"cost":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"API credits a call is charged when the service does the work; 0 is free"}},"required":["method","path","callClass","cost"],"additionalProperties":false},"ErrorReference":{"type":"object","properties":{"errors":{"type":"array","items":{"type":"object","properties":{"code":{"type":"string","description":"The stable code, as in the error body"},"status":{"type":"integer","minimum":-9007199254740991,"maximum":9007199254740991,"description":"The HTTP status the code comes with"},"meaning":{"type":"string","description":"What went wrong and what to do about it"},"details":{"description":"The shape of `details`, when the code carries one","type":"string"}},"required":["code","status","meaning"],"additionalProperties":false}}},"required":["errors"],"additionalProperties":false}},"securitySchemes":{"apiKey":{"type":"http","scheme":"bearer","description":"An API key, as issued: shown once at creation."}}}}