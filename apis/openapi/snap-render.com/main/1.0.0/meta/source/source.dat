    "/v1/schedules": {
      "post": {
        "operationId": "createSchedule",
        "summary": "Create a scheduled capture",
        "description": "Capture a URL every hour, day or week. The first capture runs within a minute. Each capture counts as one render (failed renders are refunded), is stored as PNG with its SHA-256, and is compared with the previous capture. Subscribe to the capture.completed and change.detected webhook events to be notified. Every plan includes schedules: Free holds 1 (daily or weekly, kept 7 days), Starter 5 (14 days), Growth 25 (30 days), Business 100 (90 days), Scale 300 (180 days).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url",
                  "interval"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Page to capture. Public http or https URL."
                  },
                  "interval": {
                    "type": "string",
                    "enum": [
                      "hourly",
                      "daily",
                      "weekly"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "png"
                    ],
                    "description": "Captures are always PNG so they can be compared."
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 320,
                    "maximum": 3840,
                    "default": 1280
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 200,
                    "maximum": 10000,
                    "default": 800
                  },
                  "full_page": {
                    "type": "boolean",
                    "default": false
                  },
                  "delay": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000,
                    "default": 0
                  },
                  "dark_mode": {
                    "type": "boolean",
                    "default": false
                  },
                  "block_ads": {
                    "type": "boolean",
                    "default": true
                  },
                  "block_cookie_banners": {
                    "type": "boolean",
                    "default": true
                  },
                  "hide_selectors": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "click_selector": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "device": {
                    "type": "string",
                    "enum": [
                      "iphone_14",
                      "iphone_15_pro",
                      "pixel_7",
                      "ipad_pro",
                      "macbook_pro"
                    ]
                  },
                  "user_agent": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "change_threshold": {
                    "type": "number",
                    "minimum": 0.001,
                    "maximum": 100,
                    "default": 0.5,
                    "description": "Percent of the page that must change before change.detected fires."
                  },
                  "notify_email": {
                    "type": "boolean",
                    "default": false,
                    "description": "Email the account owner when change.detected fires: verified addresses only, at most one email per schedule every 50 minutes and 50 per account a day."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Schedule created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Schedule"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, unknown device, interval not on this plan, or schedule limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scheduled captures are not available on this account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ]
      },
      "get": {
        "operationId": "listSchedules",
        "summary": "List scheduled captures",
        "description": "All schedules on the account, newest first, with the plan's limits.",
        "responses": {
          "200": {
            "description": "Schedules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schedules": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Schedule"
                      }
                    },
                    "limits": {
                      "type": "object",
                      "properties": {
                        "plan": {
                          "type": "string"
                        },
                        "eligible": {
                          "type": "boolean"
                        },
                        "maxSchedules": {
                          "type": "integer"
                        },
                        "retentionDays": {
                          "type": "integer"
                        },
                        "used": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ]
      }
    },
