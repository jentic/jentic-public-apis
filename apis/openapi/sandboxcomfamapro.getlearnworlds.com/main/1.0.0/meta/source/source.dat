{
  "openapi": "3.0.3",
  "info": {
    "title": "Web Services public API",
    "description": "This is a short documentation of the Comfama pro API usage",
    "version": "1.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/non-951/servicios-web/1.0.0"
  },
  "servers": [
    {
      "url": "https://sandboxcomfamapro.getlearnworlds.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Users"
    },
    {
      "name": "Courses"
    },
    {
      "name": "Enrollments"
    }
  ],
  "paths": {
    "/admin/api/v2/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create user",
        "description": "This endpoint is used to manage users.\n\nHere, you can create a new user.\n\nRequired fields:\n- email\n- username\n",
        "operationId": "createUser",
        "parameters": [
          {
            "name": "lw-client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "username"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "john@doe.com"
                  },
                  "username": {
                    "type": "string",
                    "example": "John"
                  },
                  "fields": {
                    "type": "object",
                    "properties": {
                      "bio": {
                        "type": "string",
                        "example": "my story"
                      },
                      "fb": {
                        "type": "string",
                        "example": "https://www.facebook.com/johndoe"
                      },
                      "location": {
                        "type": "string",
                        "example": "Panormo"
                      },
                      "twitter": {
                        "type": "string",
                        "example": "https://www.twitter.com/johndoe"
                      },
                      "url": {
                        "type": "string",
                        "example": "https://test.com"
                      }
                    }
                  },
                  "is_admin": {
                    "type": "boolean",
                    "example": false
                  },
                  "send_registration_email": {
                    "type": "boolean",
                    "example": true
                  },
                  "signup_validation_rules": {
                    "type": "boolean",
                    "example": true
                  },
                  "subscribed_for_marketing_emails": {
                    "type": "boolean",
                    "nullable": true,
                    "example": null
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "quicklearner",
                      "power-user"
                    ]
                  },
                  "utms": {
                    "type": "object",
                    "properties": {
                      "fc_utm_campaign": {
                        "type": "string",
                        "example": "WOW campaign"
                      },
                      "fc_utm_medium": {
                        "type": "string",
                        "example": "FB"
                      },
                      "fc_utm_source": {
                        "type": "string",
                        "example": "Facebook"
                      }
                    }
                  }
                }
              },
              "examples": {
                "createUserExample": {
                  "value": {
                    "email": "john@doe.com",
                    "username": "John"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "requestBody"
          }
        }
      }
    },
    "/admin/api/v2/courses": {
      "post": {
        "tags": [
          "Courses"
        ],
        "summary": "Create course",
        "description": "This endpoint is used to manage courses.\n\nHere, you can create a new course.\n\nRequired fields:\n- titleId\n- title\n- access\n",
        "operationId": "createCourse",
        "parameters": [
          {
            "name": "lw-client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "titleId",
                  "title",
                  "access"
                ],
                "properties": {
                  "access": {
                    "type": "string",
                    "example": "paid"
                  },
                  "price": {
                    "type": "number",
                    "format": "float",
                    "example": 100
                  },
                  "title": {
                    "type": "string",
                    "example": "Curso de Breyner Tejada"
                  },
                  "titleId": {
                    "type": "string",
                    "example": "CDBT"
                  }
                }
              },
              "examples": {
                "createCourseExample": {
                  "value": {
                    "access": "paid",
                    "price": 100,
                    "title": "Curso de Breyner Tejada",
                    "titleId": "CDBT"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "requestBody"
          }
        }
      }
    },
    "/admin/api/v2/users/{id}/enrollment": {
      "post": {
        "tags": [
          "Enrollments"
        ],
        "summary": "Enroll user",
        "description": "This endpoint is used to manage user enrollments.\n\nHere, you can enroll a user into a product (course or bundle).\n\nRequired fields:\n- productId\n- productType\n- price\n",
        "operationId": "enrollUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lw-client",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "productId",
                  "productType",
                  "price"
                ],
                "properties": {
                  "productId": {
                    "type": "string",
                    "example": "bundle-new"
                  },
                  "productType": {
                    "type": "string",
                    "example": "bundle"
                  },
                  "justification": {
                    "type": "string",
                    "example": "Added by admin"
                  },
                  "price": {
                    "type": "number",
                    "format": "float",
                    "example": 100.23
                  },
                  "send_enrollment_email": {
                    "type": "boolean",
                    "example": true
                  }
                }
              },
              "examples": {
                "enrollUserExample": {
                  "value": {
                    "productId": "bundle-new",
                    "productType": "bundle",
                    "justification": "Added by admin",
                    "price": 100.23,
                    "send_enrollment_email": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Enrollment successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  }
}
