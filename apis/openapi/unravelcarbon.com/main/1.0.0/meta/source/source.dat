  /export/emission/aggregated:
    post:
      tags: [Analytics & Reporting]
      summary: Get aggregated emissions data
      description: |
        Retrieve aggregated and summarized emissions data with advanced filtering, grouping, and analytics capabilities.

        This endpoint provides powerful data aggregation features:

        - **Flexible column selection**: Choose from available fields including derived fields like month, year, quarter
        - **Advanced filtering**: Filter by emission scope (1, 2, 3), data type, facilities, files, dates, and more
        - **Multiple export formats**: Get results in JSON or CSV format
        - **Async processing**: Large CSV exports are processed asynchronously with status tracking
        - **Sorting and pagination**: Sort results and paginate through large datasets

        Perfect for creating dashboards, reports, and analytics applications.
      parameters:
        - $ref: "#/components/parameters/Authorization"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/DataAggregationRequest"
            examples:
              default:
                summary: "Basic aggregation with date filters"
                value:
                  columns:
                    [
                      "date",
                      "year",
                      "month",
                      "quarter",
                      "file_name",
                      "business_facility_name",
                      "company",
                      "uploader",
                      "total_emission",
                      "data_type",
                      "scope_category",
                      "city",
                      "country",
                    ]
                  scope: [2]
                  data_type: ["scope2_electricity"]
                  business_facility_name: ["UC_CORP"]
                  scope_category: ["Fuel and energy related"]
                  date_from: "2025-01-01"
                  date_to: "2025-01-29"
                  file_name: ["UC_CORP_20250603062403.csv"]
                  uploader: ["system@unravelcarbon.com"]
                  format: "json"
                  per_page: 1
                  sort_by: "total_emission"
                  sort_order: "desc"
                  page: 1
              data_type_filter:
                summary: "Filter by data type only"
                value:
                  columns:
                    [
                      "date",
                      "year",
                      "month",
                      "quarter",
                      "file_name",
                      "business_facility_name",
                      "company",
                      "uploader",
                      "total_emission",
                      "data_type",
                      "scope_category",
                      "city",
                      "country",
                    ]
                  data_type: ["scope2_electricity", "scope1_fuel"]
                  format: "json"
                  per_page: 100
                  page: 1
      responses:
        "200":
          description: Aggregated emissions data
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/DataAggregationResponse"
              examples:
                default:
                  summary: "JSON response with aggregated data"
                  value:
                    data:
                      - date: "2025-01-13"
                        year: 2025
                        month: "2025-01"
                        quarter: 1
                        file_name: "UC_CORP_20250603062403.csv"
                        business_facility_name: "UC_CORP"
                        company: "Alpha Corporation"
                        uploader: "system@unravelcarbon.com"
                        total_emission: 0.7749856676879998
                        data_type: "scope2_electricity"
                        scope_category: "Fuel and energy related"
                        city: "None"
                        country: "Singapore"
                    count: 27
                    page: 1
                    per_page: 1
                    format: "json"
            text/csv:
              schema:
                type: object
                properties:
                  download_url:
                    type: string
                    description: Direct download URL for the CSV file (when processing is complete)
                    example: "https://s3.amazonaws.com/bucket/aggregated_emissions_20240115.csv"
                  status:
                    type: string
                    enum: [complete, processing]
                    description: Status of the CSV export
                    example: "complete"
                  task_id:
                    type: string
                    description: Task ID for tracking async exports (when status is 'processing')
                    example: "abc123def456"
                  message:
                    type: string
                    description: Status message or instructions
                    example: "CSV export completed successfully"
              examples:
                direct_download:
                  summary: "Direct CSV download (small aggregated exports)"
                  value:
                    download_url: "https://s3.amazonaws.com/bucket/aggregated_emissions_20240115.csv"
                    status: "complete"
                    message: "CSV export completed successfully"
                async_processing:
                  summary: "Async processing (large aggregated exports)"
                  value:
                    task_id: "abc123def456"
                    status: "processing"
                    message: "CSV export is being processed. Use task_id to check status."
                processing_with_eta:
                  summary: "Processing with estimated completion time"
                  value:
                    task_id: "def789ghi012"
                    status: "processing"
                    message: "CSV export is being processed. Estimated completion: 10 minutes."
        "400":
          $ref: "#/components/responses/BadRequestError"
        "401":
          $ref: "#/components/responses/UnauthorizedError"

  /export/status/{task_id}:
    get:
      tags: [Analytics & Reporting]
      summary: Check export task status
      description: |
        Check the status of an asynchronous export task.

        Large exports (especially CSV exports) are processed asynchronously. This endpoint allows you to:

        - **Track progress**: Check if your export is still processing
        - **Get download links**: Retrieve the download URL once processing is complete
        - **Handle errors**: Get error information if the export failed

        Use the `task_id` returned from export endpoints to check status.
      parameters:
        - $ref: "#/components/parameters/Authorization"
        - name: task_id
          in: path
          required: true
          description: Task ID returned from export endpoints
          schema:
            type: string
            example: "abc123def456"
      responses:
        "200":
          description: Export task status
          content:
            application/json:
              schema:
                type: object
                properties:
                  status:
                    type: string
                    enum: [processing, complete, failed]
                    description: Current status of the export task
                  download_url:
                    type: string
                    description: Download URL (only present when status is 'complete')
                    example: "https://s3.amazonaws.com/bucket/file.csv"
                  message:
                    type: string
                    description: Status message or error details
              examples:
                processing:
                  summary: "Task still processing"
                  value:
                    status: "processing"
                    message: "Export is being processed"
                complete:
                  summary: "Task completed successfully"
                  value:
                    status: "complete"
                    download_url: "https://s3.amazonaws.com/bucket/file.csv"
                    message: "Export completed successfully"
                failed:
                  summary: "Task failed"
                  value:
                    status: "failed"
                    message: "Export failed: Invalid parameters"
        "404":
          description: Task not found
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Error"
              example:
                error: "Task not found"
        "401":
          $ref: "#/components/responses/UnauthorizedError"

  /emissions/updates:
    get:
      tags: [Analytics & Reporting]
      summary: Check for emissions data updates
      description: |
        Check for data updates to efficiently synchronize your local systems with the latest emissions data.

        This endpoint helps you implement efficient data synchronization by:

        - **Identifying changes**: Check which facilities have updated data for specific time periods
        - **Optimizing sync**: Only fetch new data when updates are detected
        - **Reducing bandwidth**: Avoid unnecessary data transfers when no changes exist
        - **Supporting incremental updates**: Use the `since` parameter to check for updates since a specific timestamp

        Ideal for building data synchronization workflows and keeping external systems up-to-date.
      parameters:
        - $ref: "#/components/parameters/Authorization"
        - name: date_from
          in: query
          description: Start date (ISO 8601)
          required: false
          schema: { type: string, format: date }
        - name: date_to
          in: query
          description: End date (ISO 8601)
          required: false
          schema: { type: string, format: date }
        - name: facility_ids
          in: query
          description: Comma-separated facility IDs
          required: false
          schema: { type: string }
        - name: since
          in: query
          description: Check for updates since this timestamp (ISO 8601)
          required: false
          schema: { type: string, format: date-time }
      responses:
        "200":
          description: Update status for emissions data
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/UpdateStatusResponse"
              examples:
                default:
                  value:
                    data:
                      - facility_id: "abc123"
                        date: "2023-03-15"
                        has_updates: true
                        last_updated_at: "2023-03-16T10:00:00Z"
        "400":
          $ref: "#/components/responses/BadRequestError"
        "401":
          $ref: "#/components/responses/UnauthorizedError"

  /facilities:
    get:
      tags: [Reference & Metadata]
      summary: Get facilities
      description: |
        Retrieve the organizational structure and facilities for your company.

        This endpoint returns a hierarchical view of your organization's facilities, including:

        - **Facility hierarchy**: Parent-child relationships between facilities
        - **Facility metadata**: Names, categories, and organizational details
        - **Company structure**: Complete organizational tree for your company

        Use this data to understand your organizational structure and filter emissions data by specific facilities.
      parameters:
        - $ref: "#/components/parameters/Authorization"
      responses:
        "200":
          description: List of facilities
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FacilityResponse"
        "401":
          $ref: "#/components/responses/UnauthorizedError"

  /emissions/categories:
    get:
      tags: [Reference & Metadata]
      summary: Get emission categories
      description: |
        Retrieve emission categories, scopes, and data types available in your system.

        This endpoint provides metadata about:

        - **Emission categories**: Available categories like "Fuel combustion", "Business travel", etc.
        - **Scope classifications**: S1, S2, S3 scope mappings for each category grouping
        - **Data types**: Supported data types for each category grouping (e.g., trx, emp_com, biz_travel_air)

        Use this information to understand available data types and build dynamic filtering interfaces.
      parameters:
        - $ref: "#/components/parameters/Authorization"
      responses:
        "200":
          description: List of emission categories
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/EmissionCategoryResponse"
              example:
                data:
                  - scope: ["S1", "S2", "S3"]
                    category:
                      - "Industrial processes"
                      - "Fuel combustion"
                      - "Fugitive emissions"
                      - "AFOLU"
                      - "On-site waste treatment"
                      - "Purchased electricity"
                      - "Purchased heat"
                      - "Purchased cold"
                      - "Purchased goods and services"
                      - "Capital goods"
                      - "Fuel and energy related"
                      - "Upstream transportation"
                      - "Waste"
                      - "Business travel"
                      - "Employee commuting"
                      - "Upstream leased assets"
                      - "Downstream transportation"
                      - "Processing of sold products"
                      - "Use of sold products"
                      - "End-of-life treatment of sold products"
                      - "Downstream leased assets"
                      - "Franchises"
                      - "Investments"
                    data_types: ["trx"]
                  - scope: "S1"
                    category:
                      - "Fuel combustion"
                      - "Fuel and energy related"
                    data_types: ["scope1_fuel"]
                  - scope: "S2"
                    category:
                      - "Purchased electricity"
                      - "Fuel and energy related"
                    data_types: ["scope2_electricity"]
                  - scope: "S2"
                    category:
                      - "Purchased heat"
                      - "Purchased cold"
                    data_types: ["scope2_heat_cold"]
                  - scope: "S3"
                    category:
                      - "Purchased goods and services"
                      - "Upstream transportation"
                    data_types: ["operational_expenses"]
                  - scope: "S3"
                    category:
                      - "Capital goods"
                      - "Upstream transportation"
                    data_types: ["capital_expenses"]
                  - scope: "S3"
                    category:
                      - "Business travel"
                    data_types:
                      - "biz_travel_air"
                      - "biz_travel_hotel"
                      - "biz_travel_land"
                  - scope: "S3"
                    category:
                      - "Employee commuting"
                    data_types: ["emp_com"]
                  - scope: "S3"
                    category:
                      - "Waste"
                    data_types: ["waste"]
                  - scope: "S3"
                    category:
                      - "Upstream leased assets"
                      - "Downstream leased assets"
                    data_types:
                      - "leased_space_asset_upstream"
                      - "leased_space_asset_downstream"
                      - "leased_vehicle_asset_upstream"
                      - "leased_vehicle_asset_downstream"
                  - scope: "S3"
                    category:
                      - "Upstream transportation"
                      - "Downstream transportation"
                    data_types: ["transport"]
                  - scope: "S3"
                    category:
                      - "Use of sold products"
                    data_types: ["use_sold"]
                  - scope: "S3"
                    category:
                      - "End-of-life treatment of sold products"
                    data_types: ["use_end"]
                  - scope: "S1"
                    category:
                      - "Industrial processes"
                    data_types: ["refrigerant"]
                  - scope: "S3"
                    category:
                      - "Investments"
                    data_types: ["investment"]
        "401":
          $ref: "#/components/responses/UnauthorizedError"

  /admin/active-users:
    get:
      tags: [Admin]
      summary: Get active user listing
      description: |
        Export a daily active user listing for IT access reviews.

        - **Grain**: one row per active company user
        - **Scope**: company associated with the API key
        - **Role formatting**: `OrgName: Role` pairs, comma-separated when a user has multiple assignments
        - **Subsystem**: always `ESG`

        Requires an API key whose owner currently has company Administrator or workspace Administrator access.
      parameters:
        - $ref: "#/components/parameters/Authorization"
      responses:
        "200":
          description: Active user listing
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AuditActiveUserResponse"
              example:
                data:
                  - Name: "Ada Admin"
                    Status: "Active"
                    UserPrincipalName: "ada@example.com"
                    Company Level: "HQ, Nike France"
                    Role: "HQ: Admin, Nike France: Viewer"
                    Subsystem: "ESG"
                    Load Date: "28/08/2026"
                    Last Login Date: "15/08/2026"
        "401":
          $ref: "#/components/responses/AuditUnauthorizedError"

  /admin/user-to-roles:
    get:
      tags: [Admin]
      summary: Get user-to-role report (U2R)
      description: |
        Export the user-to-role (U2R) mapping for access reviews.

        - **Grain**: one row per user, role, and organizational unit
        - **Active rows** (`User Active Status` / `User Role Active Status` = `1`): live `UserRole` assignments
        - **Inactive rows** (status = `0`): pending company invitations, including **Invite Expired** and Invite Sent, plus the latest deleted-user snapshot per email
        - **Precedence**: a live assignment for an email is status `1` only (no duplicate inactive row); pending invitations win over deleted snapshots for the same email
        - **Blank fields**: `Department` is always an empty string
        - **UserID**: SSO login email (same as `UserEmail`)
        - **Created / Modified**: from the live role assignment for active rows; from the invitation or deleted-user snapshot for inactive rows
        - **CreatedBy / ModifiedBy**: actor emails when known (granting admin, inviter, or last role editor). Deleted snapshots leave `CreatedBy` blank

        Requires an API key whose owner currently has company Administrator or workspace Administrator access.
      parameters:
        - $ref: "#/components/parameters/Authorization"
      responses:
        "200":
          description: User-to-role report
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AuditUserToRoleResponse"
              example:
                data:
                  - UserID: "ada@example.com"
                    User: "Ada Admin"
                    UserEmail: "ada@example.com"
                    Department: ""
                    Rolename: "Admin"
                    Created: "01/01/2026"
                    Modified: "15/08/2026"
                    CreatedBy: "admin@example.com"
                    ModifiedBy: "admin@example.com"
                    LastLoginDateTime: "15/08/2026 09:30:00"
                    LastLogoutDateTime: "15/08/2026 17:00:00"
                    User Active Status (0 equal inactive, 1 equal active): 1
                    User Role Active Status (0 equal inactive, 1 equal active): 1
                  - UserID: "expired@example.com"
                    User: "Expired Invite"
                    UserEmail: "expired@example.com"
                    Department: ""
                    Rolename: "Viewer"
                    Created: "20/08/2026"
                    Modified: "20/08/2026"
                    CreatedBy: "ada@example.com"
                    ModifiedBy: "ada@example.com"
                    LastLoginDateTime: ""
                    LastLogoutDateTime: ""
                    User Active Status (0 equal inactive, 1 equal active): 0
                    User Role Active Status (0 equal inactive, 1 equal active): 0
                  - UserID: "removed@example.com"
                    User: "Removed User"
                    UserEmail: "removed@example.com"
                    Department: ""
                    Rolename: "Editor"
                    Created: "04/09/2026"
                    Modified: "04/09/2026"
                    CreatedBy: ""
                    ModifiedBy: "admin@example.com"
                    LastLoginDateTime: ""
                    LastLogoutDateTime: ""
                    User Active Status (0 equal inactive, 1 equal active): 0
                    User Role Active Status (0 equal inactive, 1 equal active): 0
        "401":
          $ref: "#/components/responses/AuditUnauthorizedError"

  /admin/role-permissions:
    get:
      tags: [Admin]
      summary: Get role-to-function report (R2F)
      description: |
        Export the role-to-function (R2F) permission matrix.

        - **Grain**: one row per role and permission claim
        - **Roles**: `Admin`, `Editor`, and `Viewer`
        - **Current state only**: audit metadata columns (`Created`, `Modified`, `CreatedBy`, `ModifiedBy`) are blank

        Requires an API key whose owner currently has company Administrator or workspace Administrator access.
      parameters:
        - $ref: "#/components/parameters/Authorization"
      responses:
        "200":
          description: Role-to-function permission matrix
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AuditRolePermissionResponse"
              example:
                data:
                  - RoleName: "Admin"
                    FunctionCode: "invite:user"
                    FunctionDescription: "invite:user"
                    Role Active Status (0 equal inactive, 1 equal active): 1
                    Created: ""
                    Modified: ""
                    CreatedBy: ""
                    ModifiedBy: ""
        "401":
          $ref: "#/components/responses/AuditUnauthorizedError"

  /admin/access-events:
    get:
      tags: [Admin]
      summary: Get privileged access audit events
      description: |
        Export privileged account activity history for bi-annual or annual access reviews.

        Captures login, logout, password changes, and user-administration actions (grant access, delete, role update, org assignment update).

        Grant-access rows (`admin-invite-user`) appear when a user is given a role: invitation accepted, SSO user created, or roles added to an existing user. Sending an invitation email alone does not create a row.

        - **Default window**: last 365 days when `start_date` and `end_date` are omitted
        - **Date filters**: `start_date` and `end_date` accept `YYYY-MM-DD`, `dd/MM/yyyy`, or `YYYY-MM-DDTHH:MM:SS`
        - **End-date semantics**: date-only `end_date` values are inclusive through the end of that calendar day (UTC)
        - **Pagination**: `page` (default `1`) and `limit` (default `100`, max `1000`)
        - **Sorting**: ascending by event time, with `id` as a stable tie-breaker

        Requires an API key whose owner currently has company Administrator or workspace Administrator access.
      parameters:
        - $ref: "#/components/parameters/Authorization"
        - name: start_date
          in: query
          required: false
          description: Inclusive lower bound for event `created_at` (UTC).
          schema:
            type: string
            example: "2026-01-01"
        - name: end_date
          in: query
          required: false
          description: Inclusive upper bound for event `created_at` when given as a date-only value (UTC).
          schema:
            type: string
            example: "2026-08-31"
        - name: page
          in: query
          required: false
          schema:
            type: integer
            minimum: 1
            default: 1
        - name: limit
          in: query
          required: false
          schema:
            type: integer
            minimum: 1
            maximum: 1000
            default: 100
      responses:
        "200":
          description: Paginated privileged access audit events
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/AuditEventResponse"
              example:
                data:
                  - Performed By (UserID): "admin@example.com"
                    Performed By (UserName): "Ada Admin"
                    Applied on account / role / configuration: "ada@example.com"
                    Activity Type: "admin-invite-user"
                    Old Value: ""
                    New Value: "HQ: Admin"
                    Created Date / Time UTC (dd/MM/yyyy HH:mm:ss): "28/08/2026 09:30:00"
                page: 1
                limit: 100
                total: 1
        "400":
          $ref: "#/components/responses/BadRequestError"
        "401":
          $ref: "#/components/responses/AuditUnauthorizedError"

  /ingest/electricity:
    post:
      tags: [Data Ingestion]
      summary: Submit electricity consumption data
      description: |
        Submit electricity consumption data directly to the Unravel Carbon platform for processing and carbon footprint calculation.

        This endpoint allows you to:

        - **Ingest electricity data**: Submit consumption records with facility and supplier information
        - **Automatic processing**: Data is automatically grouped by facility and processed for carbon calculations
        - **Deduplication**: Use unique transaction IDs to prevent duplicate data processing


        Each facility receives its own dedicated upload job for optimal processing and tracking.

        **Note**: This endpoint is designed for direct API integration and replaces the need for manual file uploads.
      parameters:
        - $ref: "#/components/parameters/Authorization"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/ElectricityIngestRequest"
            examples:
              default:
                summary: "Basic electricity data ingestion"
                value:
                  records:
                    - transaction_id: "ELEC_01_2024_01_1"
                      date: "2024-01-16"
                      consumption_kwh: 1150.5
                      facility_name: "Alpha Llama Lima HQ"
                      subfacility_code: "BF0"
                      supplier_name: "Supplier A"
                    - transaction_id: "ELEC_01_NEW_2024_01_2"
                      date: "2024-01-17"
                      consumption_kwh: 1150.5
                      facility_name: "Alpha Llama Lima HQ"
                    - transaction_id: "ELEC_01_NEW_2024_01_3"
                      date: "2024-01-18"
                      consumption_kwh: 1150.5
                      facility_name: "Alpha Llama Lima HQ"
                      supplier_name: "Supplier B"
                    - transaction_id: "ELEC_01_NEW_2024_01_4"
                      date: "2024-01-19"
                      consumption_kwh: 1150.5
                      facility_name: "Alpha Llama Lima HQ"
                      subfacility_code: "BF0"
      responses:
        "200":
          description: Electricity data successfully ingested
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ElectricityIngestResponse"
              examples:
                success:
                  summary: "Successful electricity data ingestion"
                  value:
                    status: "success"
                    message: "Successfully processed electricity data for 1 facilities"
                    data:
                      facilities_processed:
                        - facility_name: "Alpha Llama Lima HQ"
                          status: "updated"
                          records_count: 4
                          total_consumption_kwh: 4602.0
                          date_range:
                            start_date: "2024-01-16"
                            end_date: "2024-01-19"
                      summary:
                        total_facilities: 1
                        total_records: 4
                        total_consumption_kwh: 4602.0
                        existing_facilities: ["Alpha Llama Lima HQ"]
                        date_range:
                          start_date: "2024-01-16"
                          end_date: "2024-01-19"
                      next_steps:
                        - "Your scope2 electricity data has been successfully uploaded"
                        - "Carbon calculations will be processed automatically"
                        - "You can view results in your dashboard within 5-10 minutes"
                        - "Check your email for processing confirmation"
        "400":
          description: Validation error
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              examples:
                validation_error:
                  summary: "Validation error example"
                  value:
                    status: "error"
                    message: "Please check your data and try again"
                    errors:
                      - field: "records[0].consumption_kwh"
                        message: "Consumption must be greater than 0"
                      - field: "records[1].date"
                        message: "Please use YYYY-MM-DD format for dates"
                    help: "Make sure all required fields are filled and data is in the correct format"
        "401":
          $ref: "#/components/responses/UnauthorizedError"
        "403":
          description: Invalid API key
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              example:
                status: "error"
                message: "Invalid or expired API key"
                help: "Please check your API key or create a new one"
        "409":
          description: Duplicate transaction
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              example:
                status: "error"
                message: "Some data has already been processed"
                data:
                  duplicate_transaction_ids: ["ELEC_001_2024_01_15"]
                help: "Each transaction ID should be unique. Please use different IDs for new data"
        "422":
          description: Processing error
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              example:
                status: "error"
                message: "Some facilities could not be processed"
                data:
                  failed_facilities:
                    - facility_name: "Unknown Facility"
                      reason: "Facility not found in your organization"
                  successful_facilities:
                    - facility_name: "Main Office Building"
                      records_count: 2
                help: "Please check facility names and ensure they exist in your organization"
        "500":
          description: Internal server error
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              example:
                status: "error"
                message: "Something went wrong on our end"
                help: "Please try again in a few minutes. If the problem persists, contact support"

  /ingest/scope1_fuel:
    post:
      tags: [Data Ingestion]
      summary: Submit scope 1 fuel consumption data
      description: |
        Submit scope 1 fuel consumption data directly to the Unravel Carbon platform for processing and carbon footprint calculation.

        This endpoint allows you to:

        - **Ingest fuel consumption data**: Submit fuel usage records with detailed facility and fuel type information
        - **Validation**: Validates fuel types, quantities, date ranges, and facility information
        - **Deduplication**: Use unique transaction IDs to prevent duplicate data processing
        - **Flexible data submission**: Supports both JSON and CSV formats

        **Key Validation Rules**:
        - Fuel quantity must be greater than 0
        - Start date must be before or equal to end date
        - Dates cannot be in the future
        - Transaction IDs must be unique within each request
        - Facility names must exist in your organization

        Each facility receives its own dedicated upload job for optimal processing and tracking.
      parameters:
        - $ref: "#/components/parameters/Authorization"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/Scope1FuelIngestRequest"
            examples:
              default:
                summary: "Basic scope 1 fuel data ingestion"
                value:
                  records:
                    - transaction_id: "FUEL_001_2024_01_15"
                      start_date: "2024-01-15"
                      end_date: "2024-01-15"
                      facility_name: "Main Plant"
                      fuel_type: "Diesel"
                      quantity: 1000.50
                      unit_of_measurement: "liters"
                      subfacility: "BOILER-01"
                      supplier_name: "PetroCo Inc"
                      supplier_country: "USA"
                    - transaction_id: "FUEL_002_2024_01_16"
                      start_date: "2024-01-16"
                      end_date: "2024-01-17"
                      facility_name: "Main Plant"
                      fuel_type: "Natural Gas"
                      quantity: 5000.25
                      unit_of_measurement: "cubic meters"
                      supplier_name: "GasCorp Ltd"
                      supplier_country: "Canada"
      responses:
        "200":
          description: Scope 1 fuel data successfully ingested
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/Scope1FuelIngestResponse"
              examples:
                success:
                  summary: "Successful scope 1 fuel data ingestion"
                  value:
                    status: "success"
                    message: "Successfully processed 1 records across 1 facilities"
                    data:
                      sync_run_id: "6937e5b81dcdfab34c7a3cd5"
                      import_type: "scope1_fuel"
                      total_records: 1
                      facilities_processed:
                        - facility_name: "Sample 1"
                          records_count: 1
                          status: "success"
                      upload_jobs_created: 1
                      upload_job_ids: ["6937e5b81dcdfab34c7a3cd6"]
                      summary:
                        total_facilities: 1
                        total_records: 1
                        successful_facilities: 1
                        failed_facilities: 0
        "400":
          description: Validation error
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              examples:
                validation_error:
                  summary: "Validation error example"
                  value:
                    status: "error"
                    message: "Please check your data and try again"
                    errors:
                      - field: "records[0].quantity"
                        message: "Fuel quantity must be greater than 0"
                      - field: "records[1].start_date"
                        message: "Start date must be before or equal to end date"
                      - field: "records[2].transaction_id"
                        message: "Transaction ID must contain only alphanumeric characters, underscores, and hyphens"
                    help: "Make sure all required fields are filled and data is in the correct format"
        "401":
          $ref: "#/components/responses/UnauthorizedError"
        "403":
          description: Invalid API key
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              example:
                status: "error"
                message: "Invalid or expired API key"
                help: "Please check your API key or create a new one"
        "409":
          description: Duplicate transaction
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              example:
                status: "error"
                message: "Some data has already been processed"
                data:
                  duplicate_transaction_ids: ["FUEL_DUPLICATE_001"]
                help: "Each transaction ID should be unique. Please use different IDs for new data"
        "422":
          description: Processing error
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              example:
                status: "error"
                message: "Some facilities could not be processed"
                data:
                  failed_facilities:
                    - facility_name: "Unknown Facility"
                      reason: "Facility not found in your organization"
                  successful_facilities:
                    - facility_name: "Main Plant"
                      records_count: 1
                help: "Please check facility names and ensure they exist in your organization"
        "500":
          description: Internal server error
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ErrorResponse"
              example:
                status: "error"
                message: "Something went wrong on our end"
                help: "Please try again in a few minutes. If the problem persists, contact support"

  /ingest/purchase_goods_and_services:
    post:
      tags: [Data Ingestion]
      summary: Submit purchase goods and services data
      description: |
        Submit purchase goods and services data directly to the Unravel Carbon platform for processing and carbon footprint calculation.

        This endpoint allows you to:

        - **Ingest transaction data**: Submit purchase records with detailed item information
        - **Validation**: Validates supplier/manufacturer information, currency formats, and activity measurements
        - **Deduplication**: Use unique transaction IDs to prevent duplicate data processing
        - **Flexible data submission**: Supports both JSON and CSV formats

        **Key Validation Rules**:
        - Transaction dates cannot be in the future
        - supplier_name + supplier_location must be provided
        - activity_measure_value and activity_measure_unit must be provided together
        - Currency codes are automatically uppercased

        Each facility receives its own dedicated upload job for optimal processing and tracking.
      parameters:
        - $ref: "#/components/parameters/Authorization"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/PurchaseGoodsAndServicesIngestRequest"
            examples:
              default:
                summary: "Basic purchase goods and services data ingestion"
                value:
                  records:
                    - transaction_id: "PGS_001_2024_01_15"
                      transaction_date: "2024-01-15"
                      facility_name: "Main Office"
                      item_description: "Office Supplies - Notebooks and Pens"
                      transaction_amount: 1250.50
                      supplier_name: "Office Depot Inc"
                      supplier_location: "New York, USA"
                      currency: "USD"
                      activity_measure_value: 150
                      activity_measure_unit: "kilograms"
                      product_category: "Office Supplies"
                      material_composition: "100% recycled paper"
                    - transaction_id: "PGS_002_2024_01_16"
                      transaction_date: "2024-01-16"
