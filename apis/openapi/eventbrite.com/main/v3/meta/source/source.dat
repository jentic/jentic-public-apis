{
  "openapi": "3.0.3",
  "info": {
    "title": "Eventbrite API",
    "description": "The Eventbrite API allows you to create, read, update and manage events, organizations, venues, tickets, orders, and attendees on the Eventbrite platform.",
    "version": "v3",
    "contact": {
      "name": "Eventbrite Developer Support",
      "url": "https://www.eventbrite.com/platform"
    },
    "x-jentic-source-url": "https://www.eventbrite.com/platform/api"
  },
  "servers": [
    {
      "url": "https://www.eventbriteapi.com/v3",
      "description": "Production"
    }
  ],
  "security": [
    {
      "oauth2": []
    }
  ],
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://www.eventbrite.com/oauth/authorize",
            "tokenUrl": "https://www.eventbrite.com/oauth/token",
            "scopes": {}
          }
        }
      },
      "bearerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Private token or OAuth token"
      }
    },
    "schemas": {
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "html": {
                "type": "string"
              }
            }
          },
          "description": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "html": {
                "type": "string"
              }
            }
          },
          "url": {
            "type": "string"
          },
          "start": {
            "type": "object",
            "properties": {
              "timezone": {
                "type": "string"
              },
              "utc": {
                "type": "string"
              },
              "local": {
                "type": "string"
              }
            }
          },
          "end": {
            "type": "object",
            "properties": {
              "timezone": {
                "type": "string"
              },
              "utc": {
                "type": "string"
              },
              "local": {
                "type": "string"
              }
            }
          },
          "organization_id": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "changed": {
            "type": "string",
            "format": "date-time"
          },
          "capacity": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "live",
              "started",
              "ended",
              "completed",
              "canceled"
            ]
          },
          "currency": {
            "type": "string"
          },
          "online_event": {
            "type": "boolean"
          },
          "listed": {
            "type": "boolean"
          },
          "shareable": {
            "type": "boolean"
          },
          "logo_id": {
            "type": "string"
          },
          "venue_id": {
            "type": "string"
          },
          "category_id": {
            "type": "string"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "object_count": {
            "type": "integer"
          },
          "page_number": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "page_count": {
            "type": "integer"
          },
          "continuation": {
            "type": "string"
          },
          "has_more_items": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/users/me/": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "Get current user",
        "description": "Returns the currently authenticated user",
        "responses": {
          "200": {
            "description": "User object"
          }
        }
      }
    },
    "/users/{id}/": {
      "get": {
        "operationId": "getUser",
        "summary": "Get user by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User object"
          }
        }
      }
    },
    "/organizations/{id}/": {
      "get": {
        "operationId": "getOrganization",
        "summary": "Get organization by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Organization object"
          }
        }
      }
    },
    "/organizations/{id}/events/": {
      "get": {
        "operationId": "listOrganizationEvents",
        "summary": "List events for an organization",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order_by",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of events"
          }
        }
      },
      "post": {
        "operationId": "createEvent",
        "summary": "Create an event",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Event"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created event"
          }
        }
      }
    },
    "/events/{id}/": {
      "get": {
        "operationId": "getEvent",
        "summary": "Get event by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "updateEvent",
        "summary": "Update an event",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Event"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated event"
          }
        }
      },
      "delete": {
        "operationId": "deleteEvent",
        "summary": "Delete an event",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          }
        }
      }
    },
    "/events/{id}/attendees/": {
      "get": {
        "operationId": "listEventAttendees",
        "summary": "List attendees for an event",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of attendees"
          }
        }
      }
    },
    "/events/{id}/orders/": {
      "get": {
        "operationId": "listEventOrders",
        "summary": "List orders for an event",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of orders"
          }
        }
      }
    },
    "/events/{id}/ticket_classes/": {
      "get": {
        "operationId": "listTicketClasses",
        "summary": "List ticket classes for an event",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket classes"
          }
        }
      },
      "post": {
        "operationId": "createTicketClass",
        "summary": "Create a ticket class",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Created ticket class"
          }
        }
      }
    },
    "/events/{id}/ticket_classes/{ticket_class_id}/": {
      "get": {
        "operationId": "getTicketClass",
        "summary": "Get a ticket class",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ticket_class_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket class"
          }
        }
      }
    },
    "/venues/{id}/": {
      "get": {
        "operationId": "getVenue",
        "summary": "Get venue by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Venue object"
          }
        }
      }
    },
    "/organizations/{id}/venues/": {
      "get": {
        "operationId": "listOrganizationVenues",
        "summary": "List venues for an organization",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of venues"
          }
        }
      },
      "post": {
        "operationId": "createVenue",
        "summary": "Create a venue",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Created venue"
          }
        }
      }
    },
    "/categories/": {
      "get": {
        "operationId": "listCategories",
        "summary": "List event categories",
        "responses": {
          "200": {
            "description": "List of categories"
          }
        }
      }
    },
    "/categories/{id}/": {
      "get": {
        "operationId": "getCategory",
        "summary": "Get category by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Category object"
          }
        }
      }
    },
    "/orders/{id}/": {
      "get": {
        "operationId": "getOrder",
        "summary": "Get order by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order object"
          }
        }
      }
    },
    "/events/{id}/structured_content/": {
      "get": {
        "operationId": "getEventStructuredContent",
        "summary": "Get structured content for an event",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Structured content"
          }
        }
      }
    },
    "/media/upload/": {
      "get": {
        "operationId": "getMediaUploadInstructions",
        "summary": "Get media upload instructions",
        "responses": {
          "200": {
            "description": "Upload instructions"
          }
        }
      },
      "post": {
        "operationId": "uploadMedia",
        "summary": "Upload media",
        "responses": {
          "200": {
            "description": "Uploaded media"
          }
        }
      }
    }
  }
}
