{
  "openapi": "3.0.3",
  "info": {
    "title": "Eventbrite API",
    "description": "The Eventbrite API enables programmatic access to Eventbrite's event management platform. Create, manage, and search events, manage orders and attendees, and access organization data.",
    "version": "3.0.0",
    "x-jentic-source-url": "https://www.eventbrite.com/platform/api"
  },
  "servers": [
    {
      "url": "https://www.eventbriteapi.com/v3",
      "description": "Eventbrite API v3"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/users/me/": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "Get Current User",
        "description": "Returns the authenticated user.",
        "responses": {
          "200": {
            "description": "User object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/organizations/{organization_id}/events/": {
      "get": {
        "operationId": "listOrganizationEvents",
        "summary": "List Organization Events",
        "description": "Returns a paginated list of events for an organization.",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "live",
                "started",
                "ended",
                "completed",
                "canceled"
              ]
            }
          },
          {
            "name": "order_by",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "start_asc",
                "start_desc",
                "created_asc",
                "created_desc"
              ]
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated event list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedEvents"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createEvent",
        "summary": "Create Event",
        "description": "Creates a new event within an organization.",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        }
      }
    },
    "/events/{event_id}/": {
      "get": {
        "operationId": "getEvent",
        "summary": "Get Event",
        "description": "Returns an event by ID.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "updateEvent",
        "summary": "Update Event",
        "description": "Updates an event.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteEvent",
        "summary": "Delete Event",
        "description": "Deletes an event. Only draft events can be deleted.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event deleted"
          }
        }
      }
    },
    "/events/{event_id}/publish/": {
      "post": {
        "operationId": "publishEvent",
        "summary": "Publish Event",
        "description": "Publishes a draft event, making it live.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event published"
          }
        }
      }
    },
    "/events/{event_id}/attendees/": {
      "get": {
        "operationId": "listAttendees",
        "summary": "List Event Attendees",
        "description": "Returns a paginated list of attendees for an event.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "attending",
                "not_attending",
                "unpaid"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated attendee list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedAttendees"
                }
              }
            }
          }
        }
      }
    },
    "/events/{event_id}/orders/": {
      "get": {
        "operationId": "listOrders",
        "summary": "List Event Orders",
        "description": "Returns a paginated list of orders for an event.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "inactive",
                "both"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated order list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedOrders"
                }
              }
            }
          }
        }
      }
    },
    "/events/{event_id}/ticket_classes/": {
      "get": {
        "operationId": "listTicketClasses",
        "summary": "List Ticket Classes",
        "description": "Returns the ticket classes for an event.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket classes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ticket_classes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TicketClass"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createTicketClass",
        "summary": "Create Ticket Class",
        "description": "Creates a new ticket class for an event.",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketClassCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created ticket class",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketClass"
                }
              }
            }
          }
        }
      }
    },
    "/events/search/": {
      "get": {
        "operationId": "searchEvents",
        "summary": "Search Events",
        "description": "Search for public events on Eventbrite.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search query"
          },
          {
            "name": "location.address",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location.within",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Radius with units (e.g. '10mi')"
          },
          {
            "name": "categories",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated category IDs"
          },
          {
            "name": "start_date.range_start",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "start_date.range_end",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedEvents"
                }
              }
            }
          }
        }
      }
    },
    "/organizations/{organization_id}/venues/": {
      "get": {
        "operationId": "listVenues",
        "summary": "List Organization Venues",
        "description": "Returns venues for an organization.",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Venue list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "venues": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Venue"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createVenue",
        "summary": "Create Venue",
        "description": "Creates a venue for an organization.",
        "parameters": [
          {
            "name": "organization_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VenueCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created venue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Venue"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "OAuth 2.0 Bearer token from Eventbrite"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "emails": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "verified": {
                  "type": "boolean"
                },
                "primary": {
                  "type": "boolean"
                }
              }
            }
          },
          "image_id": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "html": {
                "type": "string"
              }
            }
          },
          "description": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "html": {
                "type": "string"
              }
            }
          },
          "url": {
            "type": "string"
          },
          "start": {
            "type": "object",
            "properties": {
              "timezone": {
                "type": "string"
              },
              "local": {
                "type": "string"
              },
              "utc": {
                "type": "string"
              }
            }
          },
          "end": {
            "type": "object",
            "properties": {
              "timezone": {
                "type": "string"
              },
              "local": {
                "type": "string"
              },
              "utc": {
                "type": "string"
              }
            }
          },
          "organization_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "online_event": {
            "type": "boolean"
          },
          "venue_id": {
            "type": "string"
          },
          "category_id": {
            "type": "string"
          },
          "capacity": {
            "type": "integer"
          },
          "is_free": {
            "type": "boolean"
          }
        }
      },
      "EventCreate": {
        "type": "object",
        "required": [
          "event"
        ],
        "properties": {
          "event": {
            "type": "object",
            "required": [
              "name",
              "start",
              "end",
              "currency"
            ],
            "properties": {
              "name": {
                "type": "object",
                "properties": {
                  "html": {
                    "type": "string"
                  }
                }
              },
              "description": {
                "type": "object",
                "properties": {
                  "html": {
                    "type": "string"
                  }
                }
              },
              "start": {
                "type": "object",
                "properties": {
                  "timezone": {
                    "type": "string"
                  },
                  "utc": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "end": {
                "type": "object",
                "properties": {
                  "timezone": {
                    "type": "string"
                  },
                  "utc": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              "currency": {
                "type": "string"
              },
              "online_event": {
                "type": "boolean"
              },
              "venue_id": {
                "type": "string"
              },
              "category_id": {
                "type": "string"
              },
              "capacity": {
                "type": "integer"
              }
            }
          }
        }
      },
      "PaginatedEvents": {
        "type": "object",
        "properties": {
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          }
        }
      },
      "PaginatedAttendees": {
        "type": "object",
        "properties": {
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          },
          "attendees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attendee"
            }
          }
        }
      },
      "PaginatedOrders": {
        "type": "object",
        "properties": {
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          },
          "orders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          }
        }
      },
      "Attendee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "profile": {
            "type": "object",
            "properties": {
              "first_name": {
                "type": "string"
              },
              "last_name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              }
            }
          },
          "status": {
            "type": "string"
          },
          "checked_in": {
            "type": "boolean"
          },
          "event_id": {
            "type": "string"
          },
          "order_id": {
            "type": "string"
          },
          "ticket_class_id": {
            "type": "string"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "costs": {
            "type": "object",
            "properties": {
              "gross": {
                "$ref": "#/components/schemas/Money"
              },
              "tax": {
                "$ref": "#/components/schemas/Money"
              }
            }
          },
          "event_id": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TicketClass": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity_total": {
            "type": "integer"
          },
          "quantity_sold": {
            "type": "integer"
          },
          "cost": {
            "$ref": "#/components/schemas/Money"
          },
          "free": {
            "type": "boolean"
          },
          "on_sale_status": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          }
        }
      },
      "TicketClassCreate": {
        "type": "object",
        "required": [
          "ticket_class"
        ],
        "properties": {
          "ticket_class": {
            "type": "object",
            "required": [
              "name",
              "quantity_total"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "quantity_total": {
                "type": "integer"
              },
              "cost": {
                "type": "string",
                "description": "Price in minor units (e.g. 'USD,1000' for $10.00)"
              },
              "free": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "Venue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "object",
            "properties": {
              "address_1": {
                "type": "string"
              },
              "address_2": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "postal_code": {
                "type": "string"
              },
              "country": {
                "type": "string"
              },
              "latitude": {
                "type": "string"
              },
              "longitude": {
                "type": "string"
              }
            }
          },
          "capacity": {
            "type": "integer"
          }
        }
      },
      "VenueCreate": {
        "type": "object",
        "required": [
          "venue"
        ],
        "properties": {
          "venue": {
            "type": "object",
            "required": [
              "name",
              "address"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "address": {
                "type": "object",
                "properties": {
                  "address_1": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "postal_code": {
                    "type": "string"
                  },
                  "country": {
                    "type": "string"
                  }
                }
              },
              "capacity": {
                "type": "integer"
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "object_count": {
            "type": "integer"
          },
          "page_number": {
            "type": "integer"
          },
          "page_size": {
            "type": "integer"
          },
          "page_count": {
            "type": "integer"
          },
          "has_more_items": {
            "type": "boolean"
          }
        }
      },
      "Money": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string"
          },
          "value": {
            "type": "integer"
          },
          "display": {
            "type": "string"
          }
        }
      }
    }
  }
}
