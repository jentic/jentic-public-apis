{
  "openapi": "3.0.3",
  "info": {
    "title": "Angi Pros API",
    "version": "1.0.0",
    "description": "REST API to retrieve a ranked list of service professionals (\"pros\") for a given service/category and location.\n\n## Authentication\nThis API requires **Bearer Token** authentication. Include your API key in the Authorization header of every request.\n\n- Header Name: `Authorization`\n- Format: `Bearer <YOUR_API_KEY>`\n\n> Note: Authentication method may change in the future.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/angi/Pros/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.angi.com/api/v1",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Pros",
      "description": "Operations related to retrieving service professionals."
    }
  ],
  "paths": {
    "/pros": {
      "get": {
        "tags": [
          "Pros"
        ],
        "operationId": "getPros",
        "summary": "Get Pros",
        "description": "Get pros for a zip_code either by service_id or by initial_text(search description). At least one must be sent.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "zip_code",
            "in": "query",
            "required": true,
            "description": "Zip code for the search.",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{5}(-[0-9]{4})?$",
              "example": "02139"
            }
          },
          {
            "name": "service_id",
            "in": "query",
            "required": false,
            "description": "String ID representing the service category or task (e.g., 47001).",
            "schema": {
              "type": "string",
              "example": "47001"
            }
          },
          {
            "name": "initial_text",
            "in": "query",
            "required": false,
            "description": "Human-friendly description of the search text (e.g., \"bathroom plumbing\").",
            "schema": {
              "type": "string",
              "example": "bathroom plumbing"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of results to return. Default is 3. Maximum is 10.",
            "schema": {
              "type": "integer",
              "default": 3,
              "minimum": 1,
              "maximum": 10,
              "example": 3
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "description": "Non-PII unique ID tied to the user.",
            "schema": {
              "type": "string",
              "example": "user_8f3b2a0c"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProsListResponse"
                },
                "examples": {
                  "example": {
                    "summary": "Example response",
                    "value": {
                      "request_id": "req_abc123",
                      "count": 2,
                      "limit": 3,
                      "service_name": "Plumber",
                      "results": [
                        {
                          "id": "pro_0001",
                          "name": "Joe's Plumbing",
                          "highlighted_review": "Fast, professional and affordable.",
                          "logo_url": "https://cdn.angi.com/pros/pro_0001/logo.png",
                          "profile_url": "https://angi.com/pros/pro_0001",
                          "accolades": [
                            "licensed",
                            "popular",
                            "high_quality"
                          ],
                          "rating": 4.9,
                          "review_count": 124
                        },
                        {
                          "id": "pro_0002",
                          "name": "ACME Electric",
                          "highlighted_review": "On time and solved the issue quickly.",
                          "logo_url": "https://cdn.angi.com/pros/pro_0002/logo.png",
                          "profile_url": "https://angi.com/pros/pro_0002",
                          "accolades": [
                            "highly_rated"
                          ],
                          "rating": 4.7,
                          "review_count": 58
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request (invalid or missing parameters)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidZip": {
                    "summary": "Invalid zip_code",
                    "value": {
                      "error": {
                        "code": "bad_request",
                        "message": "zip_code is invalid",
                        "details": {
                          "field": "zip_code"
                        }
                      },
                      "request_id": "req_badzip_001"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing or invalid bearer token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "missingAuth": {
                    "summary": "Missing Authorization header",
                    "value": {
                      "error": {
                        "code": "unauthorized",
                        "message": "Missing or invalid Authorization token"
                      },
                      "request_id": "req_noauth_001"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden (token valid but not permitted)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests (rate limit exceeded)",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer",
                  "example": 2
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API_KEY"
      }
    },
    "schemas": {
      "ProsListResponse": {
        "type": "object",
        "required": [
          "request_id",
          "count",
          "limit",
          "results",
          "category_name"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Request identifier for traceability.",
            "example": "req_abc123"
          },
          "count": {
            "type": "integer",
            "description": "Number of results returned in this response.",
            "example": 2
          },
          "limit": {
            "type": "integer",
            "description": "The limit applied for this response.",
            "example": 3
          },
          "service_name": {
            "type": "string",
            "description": "Human-friendly category or task name related to search (e.g., \"Plumber\").",
            "example": "Plumber"
          },
          "results": {
            "type": "array",
            "description": "Array of pro objects.",
            "items": {
              "$ref": "#/components/schemas/Pro"
            }
          }
        }
      },
      "Pro": {
        "type": "object",
        "required": [
          "id",
          "name",
          "logo_url",
          "profile_url",
          "accolades",
          "rating",
          "review_count"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the pro (internal id).",
            "example": "pro_0001"
          },
          "name": {
            "type": "string",
            "description": "Business or professional name.",
            "example": "Joe's Plumbing"
          },
          "highlighted_review": {
            "type": "string",
            "description": "Best review to show.",
            "example": "Fast, professional and affordable."
          },
          "logo_url": {
            "type": "string",
            "format": "uri",
            "description": "URL to profile image.",
            "example": "https://cdn.angi.com/pros/pro_0001/logo.png"
          },
          "profile_url": {
            "type": "string",
            "format": "uri",
            "description": "Pro page for redirect.",
            "example": "https://angi.com/pros/pro_0001"
          },
          "accolades": {
            "type": "array",
            "description": "Array of short badge strings (e.g., [\"popular\",\"licensed\",\"high_quality\"]).",
            "items": {
              "type": "string"
            },
            "example": [
              "licensed",
              "popular",
              "high_quality"
            ]
          },
          "rating": {
            "type": "number",
            "nullable": true,
            "description": "Average rating numeric (scale 1-5). Null if unavailable.",
            "minimum": 1,
            "maximum": 5,
            "example": 4.9
          },
          "review_count": {
            "type": "integer",
            "description": "Number of reviews.",
            "minimum": 0,
            "example": 124
          },
          "founding_year": {
            "type": "integer",
            "description": "year founded",
            "example": 2012
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "bad_request"
              },
              "message": {
                "type": "string",
                "example": "zip_code is invalid"
              },
              "details": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          "request_id": {
            "type": "string",
            "example": "req_abc123"
          }
        }
      }
    }
  }
}
