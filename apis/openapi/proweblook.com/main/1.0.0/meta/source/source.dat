              "type": "string",
              "example": "+14155552671"
            }
          },
          {
            "name": "country_code",
            "in": "query",
            "required": false,
            "description": "Optional ISO 3166-1 alpha-2 hint",
            "schema": {
              "type": "string",
              "example": "US"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "WhatsApp validation result"
          }
        }
      },
      "post": {
        "summary": "WhatsApp Validation",
        "operationId": "validateWhatsAppPost",
        "tags": [
          "WhatsApp"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
