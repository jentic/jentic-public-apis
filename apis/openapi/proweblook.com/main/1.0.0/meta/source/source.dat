    "/google_serp": {
      "get": {
        "summary": "Google SERP",
        "description": "Google Search organic results. Path is /google_serp; the search parameter is query, not q.",
        "operationId": "googleSerp",
        "tags": [
          "Scraping"
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Search keywords (1-2000 characters)",
            "schema": {
              "type": "string",
              "example": "mcp server"
            }
          },
          {
            "name": "domain",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "google.com",
                "google.co.uk",
                "google.in",
                "google.de",
                "google.fr",
                "google.es",
                "google.it",
                "google.com.au",
                "google.ca"
              ],
              "default": "google.com"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "US"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "en"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "description": "Result offset; multiple of 10 between 0 and 990",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "num",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 10,
              "maximum": 100
            }
          },
          {
            "name": "device",
            "in": "query",
