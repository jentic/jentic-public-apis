    "/scrapersearch": {
      "get": {
        "summary": "Search Reddit, X, or LinkedIn",
        "description": "Search public posts. Default platform is reddit. Use platform=linkedin \u2014 there is no /scraperlinkedinsearch path.",
        "operationId": "searchReddit",
        "tags": [
          "Scraping"
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Search query term",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "platform",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "reddit",
                "x",
                "linkedin"
              ],
              "default": "reddit"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "new"
            }
          },
          {
            "name": "time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "week"
            }
          },
          {
            "name": "maxItems",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "subreddits",
            "in": "query",
