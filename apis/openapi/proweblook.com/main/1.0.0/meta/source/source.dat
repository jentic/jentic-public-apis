                "properties": {
                  "api_key": {
                    "type": "string"
                  },
                  "phone_number": {
                    "type": "string"
                  },
                  "country_code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "WhatsApp validation result"
          }
        }
      }
    },
