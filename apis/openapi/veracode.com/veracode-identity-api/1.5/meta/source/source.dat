      "post": {
        "description": "Creates a custom role and returns details about it.",
        "operationId": "createCustomRole",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "description": "A single role.",
                "example": {
                  "role_name": "download",
                  "role_description": "Developer Download",
                  "is_api": false,
                  "team_admin_manageable": true,
                  "jit_assignable": true,
                  "jit_assignable_default": true,
                  "permissions": [
                    {
                      "permission_name": "downloadDiscoverySiteList"
                    },
                    {
                      "permission_name": "downloadScanReportXML"
                    },
                    {
                      "permission_name": "downloadScript"
                    },
                    {
                      "permission_name": "downloadSiteList"
                    },
                    {
                      "permission_name": "ManageApiCredentials",
                      "permission_types": [
                        "retrieve,revoke,generate"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "description": "Role details",
          "required": true
        },
