      "post": {
        "description": "Creates the Just-In-Time (JIT) default settings for an organization.",
        "operationId": "createJitDefaultSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "description": "JIT Default Settings structure",
                "example": "{\n    \"ip_restricted\": true,\n    \"prefer_veracode_data\": true,\n    \"allowed_ip_addresses\": [\n        \"127.0.0.1\"\n    ],\n    \"teams\": [\n        {\n            \"team_name\": \"Team Name\" or \"team_id\" : \"team UUID\"\n        }\n    ],\n    \"use_csv_for_roles_claim\": false,\n    \"use_csv_for_teams_claim\": false,\n    \"use_csv_for_teams_managed_claim\": false,\n    \"use_csv_for_ip_address_claim\": true,\n    \"roles\": [\n        {\n            \"role_name\": \"custom-developer\" or \"role_id\" : \"role uuid\"\n        }\n    ]\n}"
