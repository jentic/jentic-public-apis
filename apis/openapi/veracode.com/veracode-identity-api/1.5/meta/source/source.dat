      "OAuthProtectedResourceMetadataResponse": {
        "type": "object",
        "description": "OAuth 2.0 Protected Resource metadata as defined in RFC 9728",
        "properties": {
          "authorization_servers": {
            "type": "array",
            "description": "Array of authorization server issuer identifiers that can issue tokens for this resource",
            "example": [
              "https://api.veracode.com/api/authn/identity-authn/oauth2"
            ],
            "items": {
              "type": "string"
            }
          },
          "bearer_methods_supported": {
            "type": "array",
            "description": "Methods supported for presenting bearer tokens to the resource",
            "example": [
              "header"
            ],
            "items": {
              "type": "string"
            }
          },
          "claims_supported": {
            "type": "array",
            "description": "JWT claims that the protected resource validates or requires",
            "example": [
              "sub",
              "iss",
              "aud",
              "exp",
              "iat",
              "scope"
            ],
            "items": {
              "type": "string"
            }
          },
          "resource": {
            "type": "string",
            "description": "The protected resource identifier",
            "example": "https://api.veracode.com/fix/mcp_sca"
          },
          "resource_documentation": {
            "type": "string",
            "description": "URL of human-readable documentation for the protected resource",
            "example": "https://docs.veracode.com/r/fix/mcp_sca"
          },
          "resource_policy_uri": {
            "type": "string",
            "description": "URL describing the protected resource's access policies",
            "example": "https://www.veracode.com/security/policy"
          },
          "resource_signing_alg_values_supported": {
            "type": "array",
            "description": "JWS signing algorithms supported for validating signed requests",
            "example": [
              "RS256"
            ],
            "items": {
              "type": "string"
            }
          },
          "resource_tos_uri": {
            "type": "string",
            "description": "URL of the protected resource's terms of service",
            "example": "https://www.veracode.com/terms-of-use/"
          }
        }
      },
      "OAuthServerMetadataResponse": {
        "type": "object",
        "description": "OAuth 2.0 Authorization Server metadata for client credentials flow",
        "properties": {
          "grant_types_supported": {
            "type": "array",
            "description": "Grant types supported by the authorization server",
            "example": [
              "client_credentials"
            ],
            "items": {
              "type": "string"
            }
          },
          "id_token_signing_alg_values_supported": {
            "type": "array",
            "description": "JWS signing algorithms supported for ID tokens",
            "example": [
              "RS256"
            ],
            "items": {
              "type": "string"
            }
          },
          "issuer": {
            "type": "string",
            "description": "The authorization server's issuer identifier URL",
            "example": "https://api.veracode.com"
          },
          "jwks_uri": {
            "type": "string",
            "description": "URL of the authorization server's JWK Set document",
            "example": "https://api.veracode.com/.well-known/jwks.json"
          },
          "op_tos_uri": {
            "type": "string",
            "description": "URL of the authorization server's terms of service",
            "example": "https://www.veracode.com/terms-of-use/"
          },
          "service_documentation": {
            "type": "string",
            "description": "URL of a page containing human-readable information about the authorization server",
            "example": "https://docs.veracode.com/r/Veracode_APIs"
          },
          "token_endpoint": {
            "type": "string",
            "description": "URL of the authorization server's token endpoint",
            "example": "https://api.veracode.com/oauth/token"
          },
          "token_endpoint_auth_methods_supported": {
            "type": "array",
            "description": "Client authentication methods supported by the token endpoint",
            "example": [
              "client_secret_basic",
              "client_secret_post"
            ],
            "items": {
              "type": "string"
            }
          },
          "token_endpoint_auth_signing_alg_values_supported": {
            "type": "array",
            "description": "JWS signing algorithms supported by the token endpoint for client authentication",
            "example": [
              "RS256"
            ],
            "items": {
              "type": "string"
            }
          },
          "token_introspection_endpoint": {
            "type": "string",
            "description": "URL of the authorization server's OAuth 2.0 introspection endpoint",
            "example": "https://api.veracode.com/oauth/introspect"
          },
          "token_revocation_endpoint": {
            "type": "string",
            "description": "URL of the authorization server's OAuth 2.0 revocation endpoint",
            "example": "https://api.veracode.com/oauth/revoke"
          },
          "ui_locales_supported": {
            "type": "array",
            "description": "Languages and scripts supported for the user interface",
            "example": [
              "en-US"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
