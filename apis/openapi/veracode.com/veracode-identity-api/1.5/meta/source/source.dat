  "components": {
    "schemas": {
      "ApiCredentials": {
        "type": "object",
        "description": "The API credentials for a client.",
        "properties": {
          "api_id": {
            "type": "string",
            "description": "The unique ID for the API credentials."
          },
          "api_secret": {
            "type": "string",
            "description": "The client secret key."
          },
          "created_ts": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the API credentials were created."
          },
          "expiration_ts": {
            "type": "string",
            "format": "date-time",
            "description": "The expiration date for the API credentials."
          },
          "last_used_ts": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the API credentials were last used."
          },
          "org_id": {
            "type": "string",
            "format": "uuid"
          },
          "revocation_ts": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the user credentials were revoked."
          },
          "revocation_user": {
            "type": "string",
            "description": "The administrator user who revoked the credentials.",
            "maxLength": 256,
            "minLength": 0
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "The user ID associated with the API credentials."
          }
        }
      },
      "Attribute": {
        "type": "object",
        "properties": {
          "canonicalValues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "caseExact": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "multiValued": {
            "type": "boolean"
          },
          "mutability": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "primary": {
            "type": "boolean"
          },
          "referenceTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required": {
            "type": "boolean"
          },
          "returned": {
            "type": "string"
          },
          "subAttributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attribute"
            }
          },
          "type": {
            "type": "string"
          },
          "uniqueness": {
            "type": "string"
          }
        }
      },
      "AuthProviderConfig": {
        "type": "object",
        "properties": {
          "pwdPolicy": {
            "$ref": "#/components/schemas/PasswordPolicyPasswordSettings"
          },
          "secretQuestions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SecretQuestion"
            }
          }
        }
      },
      "AuthenticationScheme": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "description": "The description of the authentication scheme."
          },
          "name": {
            "type": "string",
            "description": "The name of the authentication scheme."
          },
          "primary": {
            "type": "boolean",
            "description": "Boolean stating which scheme is the primary scheme."
          },
          "specUri": {
            "type": "string",
            "description": "URI to the spec of the authentication scheme."
          },
          "type": {
            "type": "string",
            "description": "Type of the authentication scheme."
          }
        }
      },
      "BlockedEmailDomain": {
        "type": "object",
        "description": "Email Domains Blocked For Users.",
        "properties": {
          "blocked_email_domain": {
            "type": "string",
            "writeOnly": true
          },
          "blocked_email_domain_id": {
            "type": "string",
            "description": "The blocked email domain ID in the Veracode Identity API."
          },
          "email_domain": {
            "type": "string",
            "description": "The actual domain that is to be blocked."
          }
        }
      },
      "BulkConfig": {
        "type": "object",
        "properties": {
          "maxOperations": {
            "type": "integer",
            "format": "int32",
            "description": "The max operations suppported."
          },
          "maxPayloadSize": {
            "type": "integer",
            "format": "int32",
            "description": "The max payload size returned."
          },
          "supported": {
            "type": "boolean",
            "description": "Boolean stating we don't support this right now."
          }
        }
      },
      "BusinessUnit": {
        "type": "object",
        "properties": {
          "bu_id": {
            "type": "string",
            "description": "The business unit ID in the Veracode Identity API."
          },
          "bu_legacy_id": {
            "type": "integer",
            "format": "int32",
            "description": "The business unit ID in the Veracode database."
          },
          "bu_name": {
            "type": "string",
            "description": "The business unit name.",
            "maxLength": 256,
            "minLength": 1
          },
          "is_default": {
            "type": "boolean",
            "description": "Flag indicating if this is the default business unit for the organization."
          },
          "teams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Team"
            },
            "uniqueItems": true
          }
        }
      },
      "ChangePasswordConfig": {
        "type": "object",
        "properties": {
          "supported": {
            "type": "boolean",
            "description": "Boolean stating we don't support this right now."
          }
        }
      },
      "ClientCredentialsRecord": {
        "type": "object",
        "properties": {
          "client_credential_ttl": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "maxLength": 256,
            "minLength": 0
          },
          "expires_at": {
            "type": "string"
          },
          "is_scoped": {
