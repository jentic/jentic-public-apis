      "UserRolesRequest": {
        "type": "object",
        "description": "The permissions list.",
        "properties": {
          "role_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UserTeam": {
        "type": "object",
        "description": "A team-to-user relationship.",
        "properties": {
          "first_name": {
            "type": "string",
            "description": "The first name of the user.",
            "maxLength": 256,
            "minLength": 0
          },
          "last_name": {
            "type": "string",
            "description": "The last name of the user.",
            "maxLength": 256,
            "minLength": 0
          },
          "no_teams_required": {
            "type": "boolean",
            "description": "None of the roles the user currently has require being part of a team."
          },
          "relationship": {
            "type": "string",
            "description": "Enum to indicate the relationship this user has with this team.",
            "enum": [
              "ADMIN",
              "MEMBER"
            ]
          },
          "team_admin_manageable": {
            "type": "boolean",
            "description": "If true, this team is manageable by a Team Admin. This is ONLY for sending to the UI"
          },
          "team_count": {
            "type": "integer",
            "format": "int32",
            "description": "The number of teams of which the user is currently a member. This data is only for sending to the UI."
          },
          "team_id": {
            "type": "string",
            "description": "The team ID in the Veracode Identity API."
          },
          "team_legacy_id": {
            "type": "integer",
            "format": "int32",
            "description": "The team ID in the Veracode database."
          },
          "team_name": {
            "type": "string",
            "description": "The team name.",
            "maxLength": 256,
            "minLength": 0
          },
          "user_id": {
            "type": "string",
            "description": "The user ID in the Veracode Identity API."
          },
          "user_legacy_id": {
            "type": "integer",
            "format": "int32",
            "description": "The user ID in the Veracode database."
          },
          "user_name": {
            "type": "string",
            "description": "The username of the user.",
            "maxLength": 256,
            "minLength": 0
          }
        }
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
