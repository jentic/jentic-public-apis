        "description": "A single SKU.",
        "properties": {
          "default_units_purchased": {
            "type": "integer",
            "format": "int32",
            "description": "The number of deafult units of this SKU that can be purchased.",
            "maximum": 2147483647
          },
          "deleted": {
            "type": "boolean",
            "description": "If true, this SKU was soft deleted."
          },
          "discontinued": {
            "type": "boolean",
            "description": "If true, this SKU is discontinued."
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Feature"
            },
            "uniqueItems": true
          },
          "publish_type": {
            "type": "string",
            "description": "Enum indicating the publish type of this SKU.",
            "enum": [
              "PLATFORM",
              "GREENLIGHT"
            ]
          },
          "sku_analysis_type": {
            "type": "string",
            "description": "Enum indicating the SKU analysis type of this SKU.",
            "enum": [
              "STATIC",
              "DYNAMIC",
              "STATIC_AND_DYNAMIC",
              "NOT_APPLICABLE",
              "DYNAMIC_ANALYSIS"
            ]
          },
          "sku_description": {
            "type": "string",
            "description": "The short description for this SKU.",
            "maxLength": 256,
            "minLength": 0
          },
          "sku_id": {
            "type": "string",
            "description": "The SKU ID in the Veracode Identity API."
          },
          "sku_legacy_id": {
            "type": "integer",
            "format": "int32",
            "description": "The SKU ID in the Veracode database.",
            "maximum": 2147483647
          },
          "sku_name": {
            "type": "string",
            "description": "The SKU name.",
            "maxLength": 256,
            "minLength": 0
          },
          "sku_type": {
            "type": "string",
            "description": "Enum indicating the SKU type of this SKU.",
            "enum": [
              "SDLC",
              "COTS_ENTERPRISE",
              "ELEARNING",
              "APPLICATION",
              "CSM",
              "DISCOVERY",
              "DYNAMICMP",
              "SCA",
              "DYN_APP",
              "DYN_SCANS",
              "DYN_SCANNER",
              "SC_ACCEL_NEXTDAY",
              "SC_SCA",
              "SCA_AND_SC",
              "SCA_UNIFIED",
              "CSM_MPT",
              "GENERIC",
              "SECURITY_LABS",
              "EASM"
            ]
          }
        }
      },
      "SortConfig": {
        "type": "object",
        "properties": {
          "supported": {
            "type": "boolean",
            "description": "Boolean stating we don't support this right now."
          }
        }
      },
      "SortObject": {
        "type": "object",
        "properties": {
          "empty": {
            "type": "boolean"
          },
          "sorted": {
            "type": "boolean"
          },
          "unsorted": {
            "type": "boolean"
          }
        }
      },
      "StaticEnginePreferenceRequest": {
        "type": "object",
        "properties": {
          "static_engine_preference_type": {
            "type": "string"
          }
        }
      },
      "Team": {
        "type": "object",
        "properties": {
          "business_unit": {
            "$ref": "#/components/schemas/BusinessUnit"
          },
          "external_id": {
            "type": "string",
            "description": "The team(group) ID in a customers system. This is created for SCIM users"
          },
          "features": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Feature"
            },
            "uniqueItems": true
          },
          "insert_ts": {
            "type": "string",
            "format": "date-time"
          },
          "member_only": {
            "type": "boolean"
          },
          "modify_ts": {
            "type": "string",
            "format": "date-time"
          },
          "relationship": {
            "type": "string",
            "description": "Enum to indicate the relationship this user has with this team.",
            "enum": [
              "ADMIN",
              "MEMBER"
            ]
          },
          "scim_team": {
            "type": "boolean",
            "description": "Flag indicating if this team(group) was created via the SCIM APIs."
          },
          "team_id": {
            "type": "string",
            "description": "The team ID in the Veracode Identity API."
          },
          "team_legacy_id": {
            "type": "integer",
            "format": "int32",
            "description": "The ID in the Veracode database."
          },
          "team_name": {
            "type": "string",
            "description": "The team name.",
            "maxLength": 256,
            "minLength": 1
          },
          "user_count": {
            "type": "integer",
            "format": "int32"
          },
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserTeam"
            },
            "uniqueItems": true
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "account_type": {
            "type": "string",
            "enum": [
              "USER",
              "API"
            ]
          },
          "active": {
            "type": "boolean",
            "description": "If true, this user record is currently active."
          },
          "agree_terms": {
            "type": "boolean",
            "description": "Flag indicating if the user has accepted the Veracode terms and conditions."
          },
          "allow_edit": {
            "type": "boolean",
            "description": "If true, this SAML user prefers IDP data."
          },
          "allow_maintenance": {
            "type": "boolean",
            "description": "Flag to allow maintenance."
          },
          "allow_multiple_sessions": {
            "type": "boolean",
            "description": "If true, this user is allowed to have multiple active sessions."
          },
          "allowed_ip_addresses": {
            "type": "array",
            "description": "Property to indicate the allowed IP addresses from which this user can log in.",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "api_credentials": {
            "$ref": "#/components/schemas/ApiCredentials"
          },
          "api_user": {
            "type": "boolean"
          },
          "copyable": {
            "type": "boolean",
            "description": "If true, this user can be duplicated."
          },
          "custom_five": {
            "type": "string",
            "description": "Custom text field 5 for this user.",
            "maxLength": 256,
            "minLength": 0
          },
          "custom_four": {
            "type": "string",
            "description": "Custom text field 4 for this user.",
            "maxLength": 256,
            "minLength": 0
          },
          "custom_one": {
            "type": "string",
            "description": "Custom text field 1 for this user.",
            "maxLength": 256,
            "minLength": 0
          },
          "custom_three": {
            "type": "string",
            "description": "Custom text field 3 for this user.",
            "maxLength": 256,
            "minLength": 0
          },
          "custom_two": {
            "type": "string",
            "description": "Custom text field 2 for this user.",
            "maxLength": 256,
            "minLength": 0
          },
          "deleted": {
            "type": "boolean",
            "description": "If true, this user was soft deleted."
          },
          "email_address": {
            "type": "string",
            "description": "The email address of this user."
          },
          "external_id": {
            "type": "string",
            "description": "The user ID in a customers system. This is created for SCIM users"
          },
          "first_name": {
            "type": "string",
            "description": "The first name of the user.",
            "maxLength": 256,
            "minLength": 0
          },
          "insert_ts": {
            "type": "string",
            "format": "date-time"
          },
          "ip_address": {
            "type": "string"
          },
          "ip_restricted": {
            "type": "boolean",
            "description": "Flag indicating whether this user can only log in from a specified set of IPs."
          },
          "last_host": {
            "type": "string",
            "description": "The last host used by the user to log in.",
            "maxLength": 256,
            "minLength": 0
          },
          "last_login": {
            "type": "string",
            "format": "date-time",
            "description": "The last login time for the user in date format."
          },
          "last_name": {
            "type": "string",
            "description": "The last name of the user.",
            "maxLength": 256,
            "minLength": 0
          },
          "learn_group_id": {
            "type": "integer",
            "format": "int32",
            "description": "Learn group ID."
          },
          "learn_track_id": {
            "type": "integer",
            "format": "int32",
            "description": "Learn track ID."
          },
          "login_answer": {
            "type": "string",
            "description": "The security answer associated with this user account.",
            "maxLength": 256,
            "minLength": 0
          },
          "login_enabled": {
            "type": "boolean",
            "description": "If true, login is enabled for this user."
          },
          "login_failure_count": {
            "type": "integer",
            "format": "int32",
            "description": "Property to indicate the count of failed logins this user has accumulated."
          },
          "login_question": {
            "type": "string",
            "description": "The security question associated with this user account.",
            "maxLength": 256,
            "minLength": 0
          },
          "modify_ts": {
            "type": "string",
            "format": "date-time"
          },
          "no_teams_required": {
            "type": "boolean",
            "description": "If true, none of the roles assigned to the user require being part of a team."
          },
          "okta_user_id": {
            "type": "string",
            "description": "The user ID in Okta."
          },
          "partial_team_admin_manageable": {
            "type": "boolean",
            "description": "If true, this user can be partially managed by the Team Admin."
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            },
            "uniqueItems": true
          },
          "phone": {
            "type": "string",
            "description": "The phone number of the user."
          },
          "pin_required": {
            "type": "boolean",
            "description": "Flag indicating if this user must provide a PIN to log in."
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "uniqueItems": true
          },
          "saml_subject": {
            "type": "string",
            "description": "Property for passing the SAML subject from the user."
          },
          "saml_user": {
            "type": "boolean",
            "description": "Flag indicating if this user is a SAML user."
          },
          "scim_user": {
            "type": "boolean",
            "description": "Flag indicating if this user was created via the SCIM APIs."
          },
          "session_id": {
            "type": "integer",
            "format": "int32",
            "description": "Session ID."
          },
          "show_html5_flaw_viewer_check": {
            "type": "integer",
            "format": "int32",
            "description": "Show HTML5 Flaw Viewer Check."
          },
          "show_welcome": {
            "type": "boolean",
            "description": "If true, shows the welcome message upon logging in to the Veracode Platform."
          },
          "team_admin_manageable": {
            "type": "boolean",
            "description": "If true, this user can be managed by the Team Admin."
          },
          "team_count": {
            "type": "integer",
            "format": "int32",
            "description": "The number of teams the user is a member of. This data is only for sending to the UI."
          },
          "teams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserTeam"
            },
            "uniqueItems": true
          },
          "title": {
            "type": "string",
            "description": "The title of this user.",
            "maxLength": 256,
            "minLength": 0
          },
          "user_id": {
            "type": "string",
            "description": "The user ID in the Veracode Identity API."
          },
          "user_legacy_id": {
            "type": "integer",
            "format": "int32",
            "description": "The user ID in the Veracode database.",
            "maximum": 2147483647
          },
          "user_name": {
            "type": "string",
            "description": "The username for this user."
          },
          "user_type": {
            "type": "string",
            "description": "Enum indicating the user type.",
            "enum": [
              "VOSP",
              "NO_VOSP"
            ]
          }
        }
      },
      "UserBasicInfo": {
        "type": "object",
