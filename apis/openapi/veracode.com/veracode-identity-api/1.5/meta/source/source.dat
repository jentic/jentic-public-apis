{
  "openapi": "3.1.0",
  "info": {
    "description": "Veracode Identity API Documentation\n\nUse one of the following base URLs depending on the region for your account:\n* https://api.veracode.com/api/authn - Veracode US Region (default)\n* https://api.veracode.eu/api/authn  - Veracode European Region\n* https://api.veracode.us/api/authn  - Veracode US Federal Region\n\nFor well-known end points use one of the following URLs depending on the region for your account:\n* https://api.veracode.com - Veracode US Region (default)\n* https://api.veracode.eu - Veracode European Region\n* https://api.veracode.us  - Veracode US Federal Region\n",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "title": "Veracode Identity API",
    "version": "1.5",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Veracode/veracode-identity_api/1.5"
  },
  "externalDocs": {
    "description": "Veracode API Documentation",
    "url": "https://docs.veracode.com"
  },
  "servers": [
    {
      "url": "https://api.veracode.com/api/authn",
      "description": "Veracode US Region (default)"
    },
    {
      "url": "https://api.veracode.eu/api/authn",
      "description": "Veracode European Region"
    },
    {
      "url": "https://api.veracode.us/api/authn",
      "description": "Veracode US Federal Region"
    },
    {
      "url": "https://api.veracode.com",
      "description": "Veracode US Region - For public .well-known endpoints"
    },
    {
      "url": "https://api.veracode.eu",
      "description": "Veracode European Region - For public .well-known endpoints"
    },
    {
      "url": "https://api.veracode.us",
      "description": "Veracode US Federal Region - For public .well-known endpoints"
    }
  ],
  "tags": [
    {
      "name": "Api Credentials",
      "description": ""
    },
    {
      "name": "Business Units",
      "description": ""
    },
    {
      "name": "Client Credentials",
      "description": "Used by secure clients to call our APIs using the OAuth2.0 Client Credentials flow. (service to service).\nClient Credentials are used at runtime to get an access token (JWT), which is used to actually call our APIs.\nAccess tokens have a time-to-live (TTL) of 60 minutes.\nClient Credentials have a TTL that is configurable up to the TTL of API credentials, which is set as a default by your organization."
    },
    {
      "name": "Jit Default Settings",
      "description": ""
    },
    {
      "name": "Permissions",
      "description": ""
    },
    {
      "name": "Principal",
      "description": "Permissions and features a user is allowed to use."
    },
    {
      "name": "Roles",
      "description": "Used for disabling default Veracode roles."
    },
    {
      "name": "Teams",
      "description": ""
    },
    {
      "name": "Users",
      "description": ""
    },
    {
      "name": "Veracode CLI and IDE plugins",
      "description": "Used to revoke OAuth2.0 JWT tokens used by the CLI or IDE plugins."
    }
  ],
