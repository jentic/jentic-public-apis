    "/identity-authn/oauth2/jwks": {
      "get": {
        "description": "JSON Web Key Set for token verification.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keys": {
                      "type": "array",
                      "description": "JSON Web Key Set containing public keys for token verification",
                      "example": {
                        "keys": [
                          {
                            "e": "AQAB",
                            "kid": "7c2431cf-ff9a-4a38-8353-ed352a01339e",
                            "kty": "RSA",
                            "n": "tRuQlaFj68ygOzDtKFGjkHWqQKho97ePxC56rBDCt5UG..."
                          },
                          {
                            "e": "AQAB",
                            "kid": "bfd9b9ed-9caf-4aa0-9d15-c0ac94c29038",
                            "kty": "RSA",
                            "n": "6hYVDfnWgPmu1bH79sGzLadiGHTq-QhmT6vcGIGfcWXb..."
                          }
                        ]
                      },
                      "items": {
                        "type": "object",
                        "properties": {
                          "e": {
                            "type": "string",
                            "description": "RSA public exponent",
                            "example": "AQAB"
                          },
                          "kid": {
                            "type": "string",
                            "description": "Key ID",
                            "example": "7c2431cf-ff9a-4a38-8353-ed352a01339e"
                          },
                          "kty": {
                            "type": "string",
                            "description": "Key type",
                            "example": "RSA"
                          },
                          "n": {
                            "type": "string",
                            "description": "RSA modulus",
                            "example": "tRuQlaFj68ygOzDtKFGjkHWqQKho97ePxC56rBDCt5UGe..."
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "JWK Set"
          }
        },
        "summary": "Get active public keys for validating OAuth2.0 tokens.",
        "tags": [
          "Client Credentials"
        ]
      }
    },
    "/identity-authn/oauth2/token": {
      "post": {
        "description": "Generate an access token using client credentials grant.",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "description": "Must be 'client_credentials'",
                    "enum": [
                      "client_credentials"
                    ],
                    "example": "client_credentials"
                  }
                },
                "required": [
                  "grant_type"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string",
                      "description": "The access token",
                      "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
                    },
                    "expires_in": {
                      "type": "integer",
                      "format": "int32",
                      "description": "Token expiration time in seconds",
                      "example": 3600
                    },
                    "token_type": {
                      "type": "string",
                      "description": "Token type, always 'Bearer'",
                      "example": "Bearer"
                    }
                  }
                }
              }
            },
            "description": "Access token response"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid client credentials"
          }
        },
        "summary": "Generate an access token using Client Credentials.",
        "tags": [
          "Client Credentials"
        ]
      }
    },
