            "allOf": [
              {
                "$ref": "#/components/schemas/oauth_client_secret"
              }
            ],
            "nullable": true
          },
          "authorization_url": {
            "allOf": [
              {
                "$ref": "#/components/schemas/oauth_authorization_url"
              }
            ],
            "nullable": true
          },
          "grant_type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/oauth_grant_type"
              }
            ]
          },
          "username": {
            "allOf": [
              {
                "$ref": "#/components/schemas/oauth_username"
              }
            ],
            "nullable": true
          },
          "password": {
            "allOf": [
              {
                "$ref": "#/components/schemas/oauth_password"
              }
            ],
            "nullable": true
          },
          "redirect_url": {
            "allOf": [
              {
                "$ref": "#/components/schemas/oauth_redirect_url"
              }
            ],
            "nullable": true
          },
          "scope": {
            "allOf": [
              {
                "$ref": "#/components/schemas/oauth_scope"
              }
            ],
            "nullable": true
          },
          "use_openid_connect": {
            "allOf": [
              {
                "$ref": "#/components/schemas/oauth_use_openid_connect"
              }
            ],
            "default": false
          },
          "openid_url": {
            "allOf": [
              {
                "$ref": "#/components/schemas/oauth_openid_url"
              }
            ],
            "nullable": true
          }
        }
      },
