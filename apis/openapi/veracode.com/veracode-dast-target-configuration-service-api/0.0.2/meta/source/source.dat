    "/analysis_profiles/assignable_parent_profiles": {
      "get": {
        "tags": [
          "analysis_profile"
        ],
        "operationId": "getAssignableParentProfiles",
        "summary": "Return a list of analysis profiles that can be assigned as parent analysis profiles.\n",
        "description": "Return a list of analysis profiles that can be assigned as parent analysis profiles.\n",
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "description": "Flag that filters by analysis profile mode.\n",
            "schema": {
              "$ref": "#/components/schemas/ModeEnum"
            }
          },
          {
            "name": "analysis_profile_id",
            "in": "query",
            "description": "ID of the target's analysis profile. \nIf ID is provided, response returns available parent analysis profiles for an analysis profile.\nIf ID is missing, response returns available parent analysis profiles for the user organization.\n",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_scanners",
            "in": "query",
            "description": "Flag that denotes whether the analysis profile scanners should be included in the response.\nIf this is set to true, the analysis profile scanners should be included in the response.\nIf this is set to false, the analysis profile scanners are not returned in the response.\nIf flag is not included in the request, analysis profile scanners are not provided by default.\n",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssignableParentAnalysisProfile"
                  }
                }
              }
            },
            "description": "Success. The parent analysis profile list is returned."
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later."
          }
        }
      }
    },
