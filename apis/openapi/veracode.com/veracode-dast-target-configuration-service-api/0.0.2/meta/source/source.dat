    "/analysis_profiles/{analysis_profile_id}": {
      "put": {
        "tags": [
          "analysis_profile"
        ],
        "operationId": "updateAnalysisProfile",
        "summary": "Update an analysis profile for an account.\n",
        "description": "Update an analysis profile for an account.\n",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisProfileUpdateRequest"
              }
            }
          },
          "description": "Details of the analysis profile request.",
          "required": true
