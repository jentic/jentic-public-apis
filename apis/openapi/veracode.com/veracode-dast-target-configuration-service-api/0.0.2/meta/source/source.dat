        "required": [
          "is_inherited"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "A Problem Details object (RFC 7807).\n",
        "properties": {
          "type": {
            "type": "string",
            "default": "about:blank",
            "description": "An absolute URI that identifies the problem type.",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "description": "A short, summary of the problem type. Written in English and \nreadable for engineers (usually not suited for non technical stakeholders and not localized).\n"
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code is generated by the origin server for this occurrence of the problem.",
            "example": 500,
            "format": "int32",
            "maximum": 599,
            "minimum": 400
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence of the problem."
          },
          "instance": {
            "type": "string",
            "description": "An absolute URI that identifies the specific occurrence of the problem.",
            "format": "URI"
          },
          "errors": {
            "type": "array",
            "description": "A list of errors that exist with the request.",
            "items": {
              "$ref": "#/components/schemas/ProblemError"
            }
          }
        }
      },
      "PageMeta": {
        "type": "object",
        "description": "Information related to the current page of results returned.",
        "properties": {
          "number": {
            "type": "integer",
            "description": "Current page number."
          },
          "size": {
            "type": "integer",
            "description": "Size of the current page."
          },
          "total_pages": {
            "type": "integer",
            "description": "Total number of pages in the results."
          },
          "total_elements": {
            "type": "integer",
            "format": "int64",
            "description": "Total number of records in the results."
          }
        },
        "required": [
          "number",
          "size",
          "total_pages",
          "total_elements"
        ]
      },
      "PagedTargets": {
        "type": "object",
        "properties": {
          "_embedded": {
            "$ref": "#/components/schemas/EmbeddedTargets"
          },
          "_links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          },
          "page": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "required": [
          "page"
        ]
      },
      "SortBy": {
        "type": "string",
        "enum": [
          "name",
          "url",
          "target_type",
          "last_scan",
          "status",
          "max_cvss"
        ],
        "default": "name",
        "description": "Permitted parameters for sorting paginated results: name, URL, target_type\n"
      },
      "SortOrder": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ],
        "default": "asc",
        "description": "Permitted sorting direction for paginated results: asc, desc\n"
      },
      "Status": {
        "type": "string",
        "enum": [
          "RUNNING",
          "STOPPING",
          "STOPPED",
          "FINISHED",
          "FAILED"
        ]
      },
      "EmbeddedTargets": {
        "type": "object",
        "properties": {
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Target"
            }
          }
        },
        "required": [
          "targets"
        ]
      },
      "PagedDiscoveredTargets": {
        "type": "object",
        "properties": {
          "_embedded": {
            "$ref": "#/components/schemas/EmbeddedDiscoveredTargets"
          },
          "_links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          },
          "page": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "required": [
          "page"
        ]
      },
      "EmbeddedDiscoveredTargets": {
        "type": "object",
        "properties": {
          "discovered_targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiscoveredTarget"
            }
          }
        },
        "required": [
          "discovered_targets"
        ]
      },
      "DiscoveredTarget": {
        "type": "object",
        "description": "The discovered target model.\n",
        "example": {
          "discovered_target_id": "f2f030d8-9012-4ef0-a889-96f6f7ce152e",
          "protocol": "HTTP",
          "url": "veracode.com",
          "target_type": "WEB_APP",
          "first_discovered_date": "12.02.2025",
          "last_discovered_date": "25.03.2025",
          "status": "NEW",
          "discovery_source_url": "source.com/target/f2f030d8-9012-4ef0-a889-96f6f7ce152e",
          "mapped_target_id": "b45e3516-1b1c-45eb-a3e8-dd4393ac5a4a"
        },
        "required": [
          "discovered_target_id",
          "protocol",
          "url",
          "target_type",
          "first_discovered_date",
          "last_discovered_date",
          "status",
          "discovery_source_url"
        ],
        "properties": {
          "discovered_target_id": {
            "type": "string",
            "description": "UUID of the discovered target."
          },
          "protocol": {
            "type": "string",
            "description": "Protocol of the discovered target.",
            "enum": [
              "HTTP",
              "HTTPS"
            ]
          },
          "url": {
            "type": "string",
            "description": "URL of the discovered target."
          },
          "target_type": {
            "type": "string",
            "description": "Type of the discovered target.\n",
            "enum": [
              "WEB_APP",
              "API"
            ]
          },
          "first_discovered_date": {
            "type": "string",
            "description": "The date when the target was discovered for the first time."
          },
          "last_discovered_date": {
            "type": "string",
            "description": "The date when the target was discovered for the last time."
          },
          "status": {
            "type": "string",
            "description": "Status of the discovered target.\n",
            "enum": [
              "NEW",
              "MAPPED",
              "IGNORED"
            ]
          },
          "discovery_source_url": {
            "type": "string",
            "description": "The source URL of the discovered target."
          },
          "mapped_target_id": {
            "type": "string",
            "description": "UUID of the DAST target to which the discovered target is mapped."
          }
        }
      },
      "DiscoveredTargetSortBy": {
        "type": "string",
        "enum": [
          "protocol",
          "url",
          "target_type",
          "status",
          "first_discovered_date",
          "last_discovered_date"
        ],
        "default": "last_discovered_date",
        "description": "Permitted parameters for sorting discovered targets.\n"
      },
      "IgnoreDiscoveredTargetsRequest": {
        "type": "object",
        "description": "List of discovered targets to ignore.",
        "required": [
          "discovered_target_ids"
        ],
        "properties": {
          "discovered_target_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of discovered target IDs to ignore."
          }
        }
      },
      "MapDiscoveredTargetRequest": {
        "type": "object",
        "required": [
          "target_id"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "description": "ID of the DAST target to map to."
          }
        }
      },
      "BatchMapDiscoveredTargetsRequest": {
        "type": "object",
        "required": [
          "discovered_target_ids"
        ],
        "properties": {
          "discovered_target_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 100,
            "description": "List of discovered target IDs to map."
          },
          "authorized_to_scan": {
            "type": "boolean",
            "description": "Whether the organization is allowed to scan the target."
          }
        }
      },
      "PagedApplications": {
        "type": "object",
        "properties": {
          "_embedded": {
            "$ref": "#/components/schemas/EmbeddedApplications"
          },
          "_links": {
            "type": "array",
