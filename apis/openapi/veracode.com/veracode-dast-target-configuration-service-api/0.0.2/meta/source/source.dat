      "AnalysisProfile": {
        "type": "object",
        "required": [
          "analysis_profile_id",
          "parent_analysis_profile_id",
          "name",
          "allowed_urls",
          "denied_urls",
          "seed_urls",
          "grouped_urls",
          "crawler_enabled",
          "crawler_mode",
          "rate_limit",
          "max_duration",
          "max_crawl_duration",
          "mode"
        ],
        "properties": {
          "analysis_profile_id": {
            "type": "string",
            "description": "ID of the analysis profile."
          },
          "parent_analysis_profile_id": {
            "type": "string",
            "description": "ID of the parent analysis profile."
          },
          "name": {
            "type": "string",
            "description": "Name of the analysis profile."
          },
          "target_id": {
            "type": "string",
            "description": "ID of the target associated with analysis profile."
          },
          "mode": {
            "$ref": "#/components/schemas/ModeEnum"
          },
          "allowed_urls": {
            "$ref": "#/components/schemas/AllowedUrls"
          },
          "denied_urls": {
            "$ref": "#/components/schemas/DeniedUrls"
          },
          "seed_urls": {
            "$ref": "#/components/schemas/SeedUrls"
          },
          "grouped_urls": {
            "$ref": "#/components/schemas/GroupedUrls"
          },
          "crawler_enabled": {
            "$ref": "#/components/schemas/CrawlerEnabled"
          },
          "crawler_mode": {
            "$ref": "#/components/schemas/CrawlerMode"
          },
          "rate_limit": {
            "$ref": "#/components/schemas/RateLimit"
          },
          "max_duration": {
            "$ref": "#/components/schemas/MaxDuration"
          },
          "max_crawl_duration": {
            "$ref": "#/components/schemas/MaxCrawlDuration"
          },
          "max_browsers": {
            "$ref": "#/components/schemas/MaxBrowsers"
          },
          "api_spec": {
            "$ref": "#/components/schemas/ApiSpec"
          },
          "similarity_threshold": {
            "$ref": "#/components/schemas/SimilarityThreshold"
          }
        }
      },
      "AllowedUrls": {
        "type": "object",
        "description": "List of allowed URLs.",
        "required": [
          "effective_value",
          "is_inherited"
        ],
        "properties": {
          "effective_value": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The list of allowed URL in effect for this  analysis profile."
          },
          "is_inherited": {
            "type": "boolean",
            "description": "True if the effective value is inherited from parent analysis profile, false otherwise."
          }
        }
      },
      "DeniedUrls": {
        "type": "object",
        "description": "List of denied URLs.",
        "required": [
          "effective_value",
          "is_inherited"
        ],
        "properties": {
          "effective_value": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The list of denied URLs in effect for this analysis profile."
          },
          "is_inherited": {
            "type": "boolean",
            "description": "True if the effective value is inherited from parent analysis profile, false otherwise."
          }
        }
      },
      "SeedUrls": {
        "type": "object",
        "description": "List of seed URLs.",
        "required": [
          "effective_value",
          "is_inherited"
        ],
        "properties": {
          "effective_value": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The list of seed URLs in effect for this analysis profile."
          },
          "is_inherited": {
            "type": "boolean",
            "description": "True if the effective value is inherited from parent analysis profile, false otherwise."
          }
        }
      },
      "GroupedUrls": {
        "type": "object",
        "description": "List of grouped URL.",
        "required": [
          "effective_value",
          "is_inherited"
        ],
        "properties": {
          "effective_value": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The list of grouped URLs in effect for this analysis profile."
          },
          "is_inherited": {
            "type": "boolean",
            "description": "True if the effective value is inherited from parent analysis profile, false otherwise."
          }
        }
      },
      "CrawlerEnabled": {
        "type": "object",
        "description": "Determines whether crawler can be used during scans.",
        "required": [
          "effective_value",
          "is_inherited"
        ],
        "properties": {
          "effective_value": {
            "type": "boolean",
            "description": "Determines whether crawler can be used during scans."
          },
          "is_inherited": {
            "type": "boolean",
            "description": "True if the effective value is inherited from parent analysis profile, false otherwise."
          }
        }
      },
      "CrawlerMode": {
        "type": "object",
        "description": "Crawler mode.",
        "required": [
          "effective_value",
          "is_inherited"
        ],
        "properties": {
          "effective_value": {
            "$ref": "#/components/schemas/CrawlerModeEnum"
          },
          "is_inherited": {
            "type": "boolean",
            "description": "True if the effective value is inherited from parent analysis profile, false otherwise."
          }
        }
      },
      "CrawlerModeEnum": {
        "type": "string",
        "description": "The crawler mode in effect for this analysis profile.",
        "enum": [
          "SMART",
          "EXHAUSTIVE"
        ]
      },
      "ModeEnum": {
        "type": "string",
        "description": "If ENTERPRISE, then enterprise mode is enabled and more features are available for the user.",
        "enum": [
          "STANDARD",
          "ENTERPRISE"
        ]
      },
      "RateLimit": {
        "type": "object",
        "description": "Maximum number of requests per second sent to the server during scanning.",
        "required": [
          "effective_value",
          "is_inherited"
        ],
        "properties": {
          "effective_value": {
            "type": "integer",
            "description": "The rate limit value in effect for this analysis profile.",
            "example": 200
          },
          "is_inherited": {
            "type": "boolean",
            "description": "True if the effective value is inherited from parent analysis profile, false otherwise."
          }
        }
      },
      "MaxBrowsers": {
        "type": "object",
        "description": "Maximum number of browsers during scanning.",
        "required": [
          "effective_value",
          "is_inherited"
        ],
        "properties": {
          "effective_value": {
            "default": 4,
            "type": "integer",
            "description": "The maximum concurrent browsers value in effect for this analysis profile.",
            "example": 4
          },
          "is_inherited": {
            "type": "boolean",
            "default": false,
            "description": "True if the effective value is inherited from parent analysis profile, false otherwise."
          }
        }
      },
      "SimilarityThreshold": {
        "type": "object",
        "description": "Setting for how alike pages should be scanned.",
        "required": [
          "effective_value",
          "is_inherited"
        ],
        "properties": {
          "effective_value": {
            "type": "number",
            "format": "double",
            "default": 0.95,
            "description": "The similarity threshold value in effect for this analysis profile.",
            "example": 0.95
          },
          "is_inherited": {
            "type": "boolean",
            "description": "True if the effective value is inherited from parent analysis profile, false otherwise."
          }
        }
      },
      "MaxDuration": {
        "type": "object",
        "description": "Maximum duration for scan in minutes.",
        "required": [
          "effective_value",
          "is_inherited"
        ],
        "properties": {
          "effective_value": {
            "type": "integer",
            "description": "The maximum duration value in effect for this analysis profile.",
            "example": 4320
          },
          "is_inherited": {
            "type": "boolean",
            "description": "True if the effective value is inherited from parent analysis profile, false otherwise."
          }
        }
      },
      "MaxCrawlDuration": {
        "type": "object",
        "description": "Maximum crawl duration for a scan in minutes.",
        "required": [
          "effective_value",
          "is_inherited"
        ],
        "properties": {
          "effective_value": {
            "type": "integer",
            "description": "The maximum crawl duration in effect for this analysis profile.",
            "example": 4320
          },
          "is_inherited": {
            "type": "boolean",
            "description": "True if the effective value is inherited from parent analysis profile, false otherwise."
          }
        }
      },
      "CrawlConfigurationRequest": {
        "type": "object",
        "description": "The crawl script request configuration for a URL scan.",
        "properties": {
          "advanced_scan": {
            "type": "boolean",
            "nullable": true,
            "description": "If true, it scans only what is specified in the crawl script. If false, it scans using the automated crawl engine."
          },
          "script": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Script"
              }
            ],
            "nullable": true
          }
        }
      },
      "ScopeRule": {
        "type": "object",
        "description": "Enterprise mode scope rule for API scans.",
        "required": [
          "uuid",
          "http_method",
          "url",
          "scope_type",
          "scope_rule_type"
        ],
        "properties": {
          "uuid": {
            "type": "string",
            "description": "Scope rule UUID."
          },
          "http_method": {
            "type": "string",
            "description": "Enterprise mode HTTP method for API scans."
          },
          "url": {
            "type": "string",
            "description": "Enterprise mode URL for API scans."
          },
          "scope_type": {
            "$ref": "#/components/schemas/ScopeTypeEnum"
          },
          "scope_rule_type": {
            "$ref": "#/components/schemas/ScopeRuleTypeEnum"
          }
        }
      },
      "ScopeTypeEnum": {
        "type": "string",
        "description": "Enterprise mode scope type for API scans.",
        "enum": [
          "AUDIT",
          "BLOCK",
          "IGNORE"
        ]
      },
      "ScopeRuleTypeEnum": {
        "type": "string",
        "description": "Enterprise mode scope rule type for API scans.",
        "enum": [
          "PATTERN",
          "INDEX"
        ]
      },
      "CrawlConfiguration": {
        "type": "object",
        "description": "The crawl script configuration for a URL scan.",
        "properties": {
          "advanced_scan": {
            "type": "boolean",
            "description": "If true the scan uses only what is specified in the crawl script. If false, the scan uses the automated crawl engine."
          },
          "script": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Script"
              }
            ],
            "nullable": true
          },
          "number_scripts": {
            "type": "integer",
            "description": "Number of crawl scripts. Present only in response, ignored in request."
          }
        }
      },
      "AnalysisProfileUpdateRequest": {
        "type": "object",
        "properties": {
          "allowed_urls": {
            "nullable": true,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of URL allowed."
          },
          "denied_urls": {
            "nullable": true,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of URL denied."
          },
          "seed_urls": {
            "nullable": true,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of seed URL."
          },
          "grouped_urls": {
            "nullable": true,
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of group URL."
          },
          "crawler_mode": {
            "$ref": "#/components/schemas/CrawlerModeEnum"
          },
          "rate_limit": {
            "type": "integer",
            "description": "Maximum number of requests per second sent to the server during scanning.",
            "example": 200,
            "minimum": 50,
            "maximum": 1000000000
          },
          "max_duration": {
            "type": "integer",
            "description": "Maximum duration for scan in minutes.",
            "example": 4320,
            "minimum": 50,
            "maximum": 129599
          },
          "max_crawl_duration": {
            "type": "integer",
            "description": "Maximum crawl duration for a scan in minutes.",
            "example": 4320,
            "minimum": 1,
            "maximum": 129599
          },
          "max_browsers": {
            "type": "integer",
            "description": "The maximum number of concurrent browsers for a scan.",
            "example": 3,
            "minimum": 1,
            "maximum": 12
          },
          "scope_rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScopeRule"
            }
          },
          "similarity_threshold": {
            "type": "number",
            "format": "double",
            "description": "The similarity threshold value in effect for this analysis profile.",
            "example": 0.95,
            "minimum": 0.6,
            "maximum": 0.99
          }
        }
      },
      "AnalysisProfileUpdateParentRequest": {
        "type": "object",
        "required": [
          "parent_analysis_profile_id"
        ],
        "properties": {
          "parent_analysis_profile_id": {
            "type": "string",
            "description": "ID of the parent analysis profile."
          }
        }
      },
      "AnalysisProfileListItem": {
        "type": "object",
        "required": [
          "analysis_profile_id",
          "name"
        ],
        "properties": {
          "analysis_profile_id": {
            "type": "string",
            "description": "ID of the analysis profile."
          },
          "target_id": {
            "type": "string",
            "description": "ID of the target associated with analysis profile."
          },
          "name": {
            "type": "string",
            "description": "Name of the analysis profile."
          }
        }
      },
      "EmbeddedAnalysisProfile": {
        "type": "object",
        "properties": {
          "analysis_profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnalysisProfileListItem"
            }
          }
        },
        "required": [
          "analysis_profiles"
        ]
      },
      "PagedAnalysisProfiles": {
        "type": "object",
        "properties": {
          "_embedded": {
            "$ref": "#/components/schemas/EmbeddedAnalysisProfile"
          },
          "_links": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Link"
            }
          },
          "page": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "required": [
          "page"
        ]
      },
      "AssignableParentAnalysisProfile": {
        "type": "object",
        "properties": {
          "analysis_profile_id": {
            "$ref": "#/components/schemas/UUIDWithoutHyphens"
          },
          "name": {
            "type": "string",
            "description": "Name of the analysis profile."
          },
          "type": {
            "$ref": "#/components/schemas/AnalysisProfileType"
          },
          "scanners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScannerValue"
            }
          }
        },
        "required": [
          "analysis_profile_id",
          "name",
          "type"
        ]
      },
      "UUIDWithoutHyphens": {
        "type": "string",
        "format": "^[0-9a-fA-F]{32}$",
        "description": "A UUID string without hyphens.\n"
      },
      "username": {
        "type": "string",
        "description": "Username of the authentication.\n",
        "maxLength": 255,
        "minLength": 1,
        "pattern": "^[\\p{L}\\p{Nl}\\p{Nd}\\p{Print}]*$"
      },
      "password": {
        "type": "string",
        "description": "Password of the authentication.\n",
        "maxLength": 255,
        "minLength": 1
      },
      "login_url": {
        "type": "string",
        "description": "Application login URL for the form-based application authentication.\n"
      },
      "enable_ai_login": {
        "x-internal": true,
        "type": "boolean",
        "description": "Toggle that enables the use of AI to generate login scripts for form-based application authentication.\n"
      },
      "base64_pkcs12": {
        "type": "string",
        "description": "description: Encoded, Base64 certificate file. File format must be PFX or P12.\n",
        "maxLength": 5000000,
        "minLength": 50
      },
      "cert_name": {
        "type": "string",
        "description": "Name of the certificate.\n"
      },
      "Script": {
        "type": "object",
        "properties": {
          "script_name": {
            "description": "Script name.",
            "type": "string"
          },
          "script_type": {
            "$ref": "#/components/schemas/ScriptTypeEnum"
          },
          "script_body": {
            "description": "Script body.",
            "type": "string"
          }
        }
      },
      "ScriptTypeEnum": {
        "type": "string",
        "nullable": true,
        "description": "The type of script. Selenium and JavaScript are the only supported formats. Both JSON and HTML-formatted Selenium scripts are supported. However, not all commands may be supported. A validation error is reported if an unsupported command is used.\n",
        "enum": [
          "SELENIUM",
          "JAVASCRIPT"
        ]
      },
      "oauth_access_token_url": {
        "description": "Access token URL.",
        "type": "string",
        "format": "uri"
      },
      "oauth_client_id": {
        "description": "Client ID.",
        "type": "string"
      },
      "oauth_client_secret": {
        "description": "Client secret. Optional for password grant type.",
        "type": "string"
      },
      "oauth_authorization_url": {
        "description": "Authorization URL.",
        "type": "string",
        "format": "uri"
      },
      "oauth_grant_type": {
        "$ref": "#/components/schemas/OAuth2GrantType"
      },
      "oauth_username": {
        "description": "Username for password credentials grant type.",
        "type": "string"
      },
      "oauth_password": {
        "description": "Password for password credentials grant type.",
        "type": "string"
      },
      "oauth_redirect_url": {
        "description": "Redirect URL.",
        "type": "string",
        "format": "uri"
      },
      "oauth_scope": {
        "description": "Scope for the specified access token. Separate multiple values with spaces.",
        "type": "string"
      },
      "oauth_use_openid_connect": {
        "type": "boolean",
        "example": true,
        "description": "Set to true to use OpenID Connect. The OpenID Connect URL replaces the access token URL and authorization URL for grant types."
      },
      "oauth_openid_url": {
        "description": "Enter the OpenID Connect URL to use when use_openid_connect is true.",
        "type": "string",
        "format": "uri"
      },
      "AnalysisRun": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The ID of the analysis run."
          },
          "project_uuid": {
            "type": "string",
            "description": "The target ID of analysis run."
          },
          "scan_number": {
            "type": "integer",
            "description": "The specific analysis run number associated with a target."
          },
          "started_at": {
            "type": "string",
            "description": "The timestamp of when the analysis run started."
          },
          "url": {
            "type": "string",
            "description": "The target URL of analysis run."
          },
          "protocol": {
            "type": "integer",
            "description": "The target protocol code of analysis run."
          },
          "environment": {
            "type": "integer",
            "description": "The target scan type code of analysis run."
          },
          "started_by": {
            "type": "integer",
            "description": "The user ID of the user that started the analysis run."
          },
          "estimated_duration": {
            "type": "integer",
            "description": "The estimated duration for the analysis run."
          }
        },
        "required": [
          "id",
          "project_uuid",
          "scan_number",
          "started_at",
          "url",
          "protocol",
          "environment",
          "started_by"
        ]
      },
      "ScannerProfile": {
        "type": "object",
        "required": [
          "analysis_profile_id",
          "parent_analysis_profile_id",
          "scanners"
        ],
        "properties": {
          "analysis_profile_id": {
            "type": "string",
            "description": "ID of the analysis profile."
          },
          "parent_analysis_profile_id": {
            "type": "string",
            "description": "ID of the parent analysis profile."
          },
          "scanners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScannerValue"
            }
          }
        }
      },
      "ScannerProfileUpdateRequest": {
        "type": "object",
        "properties": {
          "scanners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScannerUpdateValue"
            }
          }
        }
      },
      "ScannerValue": {
        "type": "object",
        "description": "Settings for a scanner in an analysis profile.",
        "required": [
          "id",
          "effective_value",
          "is_inherited",
          "is_editable"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ScannerType"
          },
          "effective_value": {
            "type": "boolean",
            "description": "True if this scanner is enabled."
          },
          "is_inherited": {
            "type": "boolean",
            "description": "True if the effective value is inherited from parent analysis profile, false otherwise."
          },
          "is_editable": {
            "type": "boolean",
            "description": "True if the effective value is editable for this analysis profile."
          }
        }
      },
      "ScannerUpdateValue": {
        "type": "object",
        "description": "Update value for a specific scanner.",
        "required": [
          "id",
          "value"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ScannerType"
          },
          "value": {
            "type": "boolean",
            "description": "True if this scanner is enabled."
          }
        }
      },
      "ScannerType": {
        "type": "string",
        "description": "Type of the scanner.",
        "enum": [
          "fingerprinting",
          "ssl",
          "http_header",
          "portscan",
          "fuzzer",
          "sql_injection",
          "xss",
          "file_inclusion",
          "deserialization",
          "xxe",
          "command_injection",
          "privilege_escalation",
          "csrf",
          "ldap_injection",
          "common_login",
          "trace_method",
          "code_injection",
          "unsecured_login",
          "clickjacking",
          "ssti",
          "obsolete_resource",
          "insecure_jwt",
          "backup_file",
          "error_pattern",
          "open_redirect",
          "ssrf",
          "webserver_dir_list",
          "http_resp_split",
          "view_state",
          "file_upload",
          "flash",
          "file_dir_exposure",
          "url_session",
          "struts2",
          "malicious_host"
        ]
      },
      "AnalysisProfileType": {
        "description": "The type of an analysis profile.",
        "type": "string",
        "enum": [
          "TARGET",
          "ORG",
          "SYSTEM"
        ]
      },
      "ParameterAuthenticationType": {
        "type": "string",
        "enum": [
          "GET_PARAMETER",
          "HTTP_HEADER",
          "COOKIE",
          "LOCAL_STORAGE",
          "SESSION_STORAGE"
        ]
      },
      "ParameterAuthentication": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UUIDWithoutHyphens"
          },
          "title": {
            "type": "string",
            "description": "The title of the parameter authentication.",
            "minLength": 1,
            "maxLength": 255
          },
          "type": {
            "$ref": "#/components/schemas/ParameterAuthenticationType"
          },
          "key": {
            "type": "string",
            "description": "The key of the parameter authentication.",
            "minLength": 1,
            "maxLength": 255
          },
          "value": {
            "type": "string",
            "description": "The value of the parameter authentication.",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": [
          "title",
          "type",
          "key"
        ]
      },
      "ParameterAuthentications": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ParameterAuthentication"
        }
      },
      "EffectiveParameterAuthentications": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/InheritableValue"
          }
        ],
        "properties": {
          "effective_value": {
            "$ref": "#/components/schemas/ParameterAuthentications"
          }
        },
        "nullable": true,
        "required": [
          "is_inherited",
          "effective_value"
        ]
      },
      "ParameterAuthenticationsUpdateRequest": {
        "description": "The parameter authentication list update request.\n",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ParameterAuthentication"
        }
      },
      "ScannerVariableEvaluationMode": {
        "type": "string",
        "enum": [
          "RAW",
          "TOTP"
        ],
        "default": "RAW",
        "description": "Specifies the evaluation mode of the scanner variable. 'TOTP' for Time-Based One-Time Password and 'RAW' for as-is evaluation."
      },
      "ScannerVariable": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/UUIDWithoutHyphens"
          },
          "reference_key": {
            "type": "string",
            "description": "The reference key of the scan engine variable.",
            "minLength": 1,
            "maxLength": 255
          },
          "evaluation_mode": {
            "$ref": "#/components/schemas/ScannerVariableEvaluationMode"
          },
          "value": {
            "type": "string",
            "description": "The value of the scanner variable.",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "reference_key",
          "value"
        ]
      },
      "EffectiveScannerVariables": {
        "description": "The list of effective scanner variables.",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/EffectiveScannerVariable"
        }
      },
      "EffectiveScannerVariable": {
        "type": "object",
        "description": "The effective scanner variable.",
        "allOf": [
          {
            "$ref": "#/components/schemas/InheritableValue"
          }
        ],
        "properties": {
          "effective_value": {
            "$ref": "#/components/schemas/ScannerVariable"
          }
        },
        "nullable": true,
        "required": [
          "is_inherited",
          "effective_value"
        ]
      },
      "ScannerVariablesUpdateRequest": {
        "description": "Update request to the list of the scanner variables.",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ScannerVariable"
        }
      },
      "StopActionType": {
        "type": "string",
        "enum": [
          "STOP_DELETE",
          "STOP_SAVE"
        ],
        "default": "STOP_DELETE",
        "description": "The type of stop action."
      }
    },
    "parameters": {
      "PageNumber": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "description": "Page number index to start pagination."
      },
      "PageLimit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 10,
          "maximum": 200,
          "default": 10
        },
        "description": "Number of records to return from pagination."
      },
      "AnalysisProfileId": {
        "name": "analysis_profile_id",
        "in": "path",
        "description": "ID of the analysis profile.",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/UUIDWithoutHyphens"
        }
      },
      "PutMethod": {
        "name": "method",
        "in": "query",
        "description": "If set to PATCH, updates the content to values in the request, but null values and absent attributes are ignored.",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "PATCH"
          ]
        }
      }
    },
    "responses": {
      "Problem400Response": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "urn:problem-type:veracode:dast:bad-request",
              "title": "Bad Request",
              "status": 400,
              "detail": "There are one or more errors in the request",
              "instance": "/api/v1/entity",
              "errors": [
                {
                  "code": "ILLEGAL_ARGUMENT",
                  "detail": "error detailed description"
                }
              ]
            }
          }
        },
        "description": "Invalid request. If there is no response body, your request contains malformed JSON. \nIf there is a response body, Veracode could not validate your JSON payload. \nVerify the source attribute in each service error in the response and the associated code, and try again.\n"
      },
      "Problem500Response": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Server-side error. Please try again later."
      },
      "AnalysisProfile404Response": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Unknown analysis profile identifier. Verify the analysis profile ID and try again."
      },
      "Authentication404Response": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "Unknown analysis profile or authentication identifier. Verify the analysis profile ID and authentication ID and try again."
      }
    },
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
  },
  "security": [
    {
      "apiKeyAuth": []
    }
  ]
}
