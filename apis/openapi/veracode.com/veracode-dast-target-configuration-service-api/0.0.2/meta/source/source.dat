            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "required": [
          "page"
        ]
      },
      "EmbeddedApplications": {
        "type": "object",
        "properties": {
          "Applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          }
        },
        "required": [
          "Applications"
        ]
      },
      "Application": {
        "type": "object",
        "properties": {
          "guid": {
            "type": "string",
            "description": "Application UUID"
          },
          "id": {
            "type": "string",
            "description": "Application Identifier"
          },
          "name": {
            "type": "string",
            "description": "Application Name"
          },
          "linked_scan_target_url": {
            "type": "string",
            "description": "Target URL of the scan linked to this Application"
          }
        },
        "required": [
          "guid",
          "id",
          "name"
        ]
      },
      "Link": {
        "description": "A HATEOAS link.",
        "type": "object",
        "properties": {
          "href": {
            "type": "string"
          },
          "rel": {
            "type": "string"
          },
          "templated": {
            "type": "boolean"
          }
        }
      },
