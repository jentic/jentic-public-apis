{
  "openapi": "3.0.1",
  "info": {
    "title": "Veracode DAST Target Configuration Service API",
    "description": "Veracode DAST Target Configuration Service API Documentation\nUse one of the following base URLs depending on the region for your account:\n\n  • https://api.veracode.com/ - Veracode US Region (default)\n  • https://api.veracode.eu/ - Veracode European Region\n",
    "contact": {
      "email": "veracode@veracode.com"
    },
    "version": "0.0.2",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Veracode/veracode-dast-target-configuration-service-api/0.0.2"
  },
  "servers": [
    {
      "url": "https://api.veracode.com/dae/api/tcs-api/api/v1"
    }
  ],
  "tags": [
    {
      "name": "target",
      "description": "Create, update, delete, and retrieve targets."
    },
    {
      "name": "analysis_profile",
      "description": "Retrieve and update analysis profiles. \nAnalysis profiles define the configurations for your analyses.\n"
    },
    {
      "name": "authentication",
      "description": "Retrieve and update authentication options that targets use to access URLs.\n"
    },
    {
      "name": "analysis_profile_scanners",
      "description": "Retrieve and update scanner configuration options.\n"
    },
    {
      "name": "crawl_configuration",
      "description": "Retrieve and update crawl configuration options.\n"
    },
    {
      "name": "scanner_variables",
      "description": "Create, update, delete, and retrieve scanner variables.\n"
    },
    {
      "name": "ism_gateway",
      "description": "Retrieve and update ISM configuration options.\n"
    },
    {
      "name": "schedule",
      "description": "Create, update, delete, and retrieve schedules that define when to run analyses.\n"
    },
    {
      "name": "analysis_run",
      "description": "Run analyses and retrieve the results.\n"
    },
    {
      "name": "discovered_target",
      "description": "Retrieve and update discovered targets.\n"
    },
    {
      "name": "applications",
      "description": "Retrieve applications.\n"
    }
  ],
  "paths": {
    "/targets": {
      "post": {
        "tags": [
          "target"
        ],
        "operationId": "createTarget",
        "summary": "Create a target for the specified account.\n",
        "description": "Create a target for the specified account.\n",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TargetRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Target"
                }
              }
            },
            "description": "You have successfully submitted your target. The URL of the new target is in the HTTP response header",
            "headers": {
              "location": {
                "description": "Link to the newly created target.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem400Response"
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later.\n"
          }
        }
      },
      "get": {
        "tags": [
          "target"
        ],
        "operationId": "getTargets",
        "summary": "Return a list of all targets.\n",
        "description": "Return a list of all targets.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageNumber"
          },
          {
            "$ref": "#/components/parameters/PageLimit"
          },
          {
            "in": "query",
            "name": "sort_by",
            "schema": {
              "$ref": "#/components/schemas/SortBy"
            }
          },
          {
            "in": "query",
            "name": "sort_order",
            "schema": {
              "$ref": "#/components/schemas/SortOrder"
            }
          },
          {
            "in": "query",
            "name": "name",
            "description": "Filter by the target name.",
            "schema": {
              "type": "string",
              "maxLength": 255,
              "minLength": 1,
              "pattern": "^[ -~]+$",
              "example": "target name"
            }
          },
          {
            "in": "query",
            "name": "url",
            "description": "Filter by the target URL.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "^[ -~]+$"
            }
          },
          {
            "in": "query",
            "name": "search_term",
            "description": "Filter by the target name or target URL.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "^[ -~]+$",
              "example": "search term"
            }
          },
          {
            "in": "query",
            "name": "target_type",
            "description": "Filter by the target type. Can be web application or API target.",
            "schema": {
              "type": "string",
              "enum": [
                "WEB_APP",
                "API"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedTargets"
                }
              }
            },
            "description": "Success. The target list is returned."
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later."
          }
        }
      }
    },
    "/targets/{target_id}": {
      "get": {
        "tags": [
          "target"
        ],
        "operationId": "getTargetById",
        "summary": "Return the target for the provided target ID.\n",
        "description": "Return the target for the provided target ID.\n",
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "description": "ID of the target.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Target"
                }
              }
            },
            "description": "Success. The target is returned."
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "403": {
            "description": "Forbidden access to this resource."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown target ID. Verify the target ID and try again.\n"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later."
          }
        }
      },
      "put": {
        "tags": [
          "target"
        ],
        "operationId": "updateTarget",
        "summary": "Update a target for an account.\n",
        "description": "Update a target for an account.\n",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TargetUpdateRequest"
              }
            }
          },
          "description": "Details of the target request.",
          "required": true
        },
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "description": "ID of the target.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Target"
                }
              }
            },
            "description": "You have successfully edited your target.\n"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid request. If there is no response body, your request contains malformed JSON. \nIf there is a response body, Veracode could not validate your JSON payload. \nVerify the source attribute in each service error in the response and the associated code, and try again.\n"
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "403": {
            "description": "Forbidden access to this resource."
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later.\n"
          }
        }
      },
      "delete": {
        "tags": [
          "target"
        ],
        "operationId": "deleteTargetById",
        "summary": "Delete the target with the provided target ID.",
        "description": "Delete the target with the provided target ID.",
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "description": "ID of the target.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted the target."
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "404": {
            "description": "Unknown target ID. Verify the target ID and try again."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later."
          }
        }
      }
    },
    "/targets/{target_id}/spec": {
      "post": {
        "tags": [
          "target"
        ],
        "operationId": "uploadTargetApiSpec",
        "summary": "Upload an API specification.\n",
        "description": "Upload an API specification.\n",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "specFile": {
                    "type": "string",
                    "format": "binary",
                    "description": "The API specification file must be in JSON, YAML, or HAR format."
                  }
                },
                "required": [
                  "specFile"
                ]
              }
            }
          },
          "required": true
        },
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "description": "ID of the target.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "You have successfully uploaded an API specification.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSpec"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid request. If there is no response body, your request contains malformed JSON. If there is a response body, Veracode could not validate your API specification file. Verify the source attribute in each service error in the response and the associated code, and try again.\n"
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "403": {
            "description": "Forbidden access to this resource."
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later.\n"
          }
        }
      },
      "get": {
        "tags": [
          "target"
        ],
        "operationId": "getTargetApiSpec",
        "summary": "Return a target API specification.\n",
        "description": "Return a target API specification.\n",
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "description": "ID of the target.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scan_id",
            "in": "query",
            "description": "UUID of the scan or analysis run.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success. The API specification is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSpec"
                }
              }
            }
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "403": {
            "description": "Forbidden access to this resource."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown target ID. Verify the target ID and try again.\n"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later."
          }
        }
      }
    },
    "/targets/{target_id}/spec/download": {
      "get": {
        "tags": [
          "target"
        ],
        "operationId": "downloadTargetApiSpecContents",
        "summary": "Return the contents of an API specification.\n",
        "description": "Return the contents of an API specification.\n",
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "description": "ID of the target.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "scan_id",
            "in": "query",
            "description": "UUID of the scan or analysis run.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success. The content of the API specification is returned.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "403": {
            "description": "Forbidden access to this resource."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown target ID. Verify the target ID and try again.\n"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later."
          }
        }
      }
    },
    "/targets/{target_id}/link": {
      "put": {
        "tags": [
          "target"
        ],
        "operationId": "linkTarget",
        "summary": "Link a target to an application.\n",
        "description": "Link a target to an application.\n",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TargetLinkRequest"
              }
            }
          },
          "description": "Details of the Dynamic Target app linking request.",
          "required": true
        },
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "description": "UUID of the Target.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "You have successfully linked the target to an application.\n"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid request. If there is no response body, your request contains malformed JSON. \nIf there is a  response body, Veracode could not validate your JSON payload. \nVerify the source attribute in each  service error in the response and the associated code, and try again.\n"
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "403": {
            "description": "Forbidden access to this resource."
          },
          "404": {
            "description": "Dynamic target or application not found."
          },
          "409": {
            "description": "Dynamic target or application is already linked."
          },
          "422": {
            "description": "Target must be of enterprise type."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later.\n"
          }
        }
      },
      "delete": {
        "tags": [
          "target"
        ],
        "operationId": "unlinkTarget",
        "summary": "Unlinks a target from an application.\n",
        "description": "Unlinks a target from an application.\n",
        "parameters": [
          {
            "name": "target_id",
            "in": "path",
            "description": "ID of the Target.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "You have successfully unlinked the target from the application.\n"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid request. If there is no response body, your request contains malformed JSON. \nIf there is a  response body, Veracode could not validate your JSON payload. \nVerify the source attribute in each  service error in the response and the associated code, and try again.\n"
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "403": {
            "description": "Forbidden access to this resource."
          },
          "404": {
            "description": "Target not found."
          },
          "409": {
            "description": "Unable to unlink, one or more result imports are still in progress."
          },
          "422": {
            "description": "Target must be of enterprise type."
          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later.\n"
          }
        }
      }
    },
