        "type": "object",
        "title": "The OAuth 2.0 Authentication.",
        "description": "Configure OAuth 2.0 authentication based on grant type for Veracode to scan APIs. Veracode supports client credentials and password credentials grant types. You can also use OpenID Connect. It sends the authorization data automatically as an HTTP Authorization Header.\n",
        "properties": {
          "access_token_url": {
            "allOf": [
              {
                "$ref": "#/components/schemas/oauth_access_token_url"
              }
