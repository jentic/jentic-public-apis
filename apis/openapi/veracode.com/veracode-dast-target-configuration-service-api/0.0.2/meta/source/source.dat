    "/discovered_targets": {
      "get": {
        "tags": [
          "discovered_target"
        ],
        "operationId": "getDiscoveredTargets",
        "summary": "Returns a list of all discovered targets.\n",
        "description": "Returns a list of all discovered targets.\n",
        "parameters": [
          {
            "$ref": "#/components/parameters/PageNumber"
          },
          {
            "$ref": "#/components/parameters/PageLimit"
          },
          {
            "in": "query",
            "name": "sort_by",
            "schema": {
              "$ref": "#/components/schemas/DiscoveredTargetSortBy"
            }
          },
          {
            "in": "query",
            "name": "sort_order",
            "schema": {
              "$ref": "#/components/schemas/SortOrder"
            }
          },
          {
            "in": "query",
            "name": "url",
            "description": "Filter by the discovered target url.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "^[ -~]+$"
            }
          },
          {
            "in": "query",
            "name": "target_type",
            "description": "Filter by the discovered target type.",
            "schema": {
              "type": "string",
              "enum": [
                "WEB_APP",
                "API"
              ]
            }
          },
          {
            "in": "query",
            "name": "status",
            "description": "Filter by the discovered target status.",
            "schema": {
              "type": "string",
              "enum": [
                "NEW",
                "MAPPED",
                "IGNORED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedDiscoveredTargets"
                }
              }
            },
            "description": "Success. The discovered target list is returned."
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later."
          }
        }
      }
    },
    "/discovered_targets/ignore": {
      "post": {
        "tags": [
          "discovered_target"
        ],
        "operationId": "ignoreDiscoveredTargets",
        "summary": "Marks the provided discovered targets as ignored.\n",
        "description": "Sets the status of multiple discovered targets to IGNORED, unless any are already MAPPED.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IgnoreDiscoveredTargetsRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully set the IGNORED status to the discovered targets."
          },
          "400": {
            "$ref": "#/components/responses/Problem400Response"
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request contains an unknown discovered target identifier. Verify the discovered target IDs and try again.\n"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Discovered target is already mapped.\n"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later."
          }
        }
      }
    },
    "/discovered_targets/{discovered_target_id}/map": {
      "post": {
        "tags": [
          "discovered_target"
        ],
        "operationId": "mapDiscoveredTarget",
        "summary": "Maps a discovered target to an existing DAST target.\n",
        "description": "Maps a Discovered Target with status NEW to an existing DAST target. \nUpon successful mapping, the status of the Discovered Target will be updated to MAPPED.\n",
        "parameters": [
          {
            "name": "discovered_target_id",
            "in": "path",
            "description": "ID of the discovered target to map.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MapDiscoveredTargetRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully mapped the discovered target."
          },
          "400": {
            "$ref": "#/components/responses/Problem400Response"
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Discovered target or DAST target not found.\n"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Discovered target is already mapped or ignored.\n"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later."
          }
        }
      }
    },
    "/discovered_targets/map_to_new": {
      "x-hidden": true,
      "post": {
        "tags": [
          "discovered_target"
        ],
        "operationId": "batchMapDiscoveredTargets",
        "summary": "Maps multiple discovered targets by creating new DAST targets.\n",
        "description": "Creates a new dynamic target for each provided discovered target and maps them.\nThe operation is atomic: if validation fails for any discovered target, the entire request is rejected.\nAfter mapping, the status of each discovered target will be updated to MAPPED.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchMapDiscoveredTargetsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmbeddedDiscoveredTargets"
                }
              }
            },
            "description": "Successfully mapped all discovered targets to new DAST targets."
          },
          "400": {
            "$ref": "#/components/responses/Problem400Response"
          },
          "401": {
            "description": "You are not authorized to perform this action."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "One or more discovered targets not found.\n"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "One or more discovered targets are already mapped or ignored.\n"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server-side error. Please try again later."
          }
        }
      }
    },
