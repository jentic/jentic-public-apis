{
  "openapi": "3.1.0",
  "info": {
    "title": "Regintel API",
    "version": "0.1.0",
    "description": "V0 to expose scraping results, search on indexed data, and agents grounded on those sources.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/ANAS_6/regintel-api/0.1.0"
  },
  "servers": [
    {
      "url": "https://api.regintel.biolevatecloud.com",
      "description": "Production"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "raw",
      "description": "Access to raw scraped data"
    },
    {
      "name": "search",
      "description": "Search documents and chunks"
    },
    {
      "name": "agents",
      "description": "Q&A, extractMeta agents"
    }
  ],
  "paths": {
    "/v1/raw": {
      "get": {
        "tags": [
          "raw"
        ],
        "summary": "List raw scraping results",
        "description": "Returns raw scraped documents with pagination and filters.",
        "parameters": [
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 50
            },
            "description": "Maximum number of items to return."
          },
          {
            "in": "query",
            "name": "page_token",
            "schema": {
              "type": "string"
            },
            "description": "Cursor returned by a previous page for forward pagination."
          },
          {
            "in": "query",
            "name": "order_by",
            "schema": {
              "type": "string",
              "enum": [
                "fetched_at_desc",
                "fetched_at_asc"
              ],
              "default": "fetched_at_desc"
            },
            "description": "Sort order based on the last fetch timestamp."
          },
          {
            "in": "query",
            "name": "fetched_since",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Only return items last fetched >= this timestamp (UTC ISO8601)"
          },
          {
            "in": "query",
            "name": "fetched_until",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Only return items last fetched < this timestamp (UTC ISO8601)"
          },
          {
            "in": "query",
            "name": "source",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": true,
            "description": "One or more regulator domains/sources"
          },
          {
            "in": "query",
            "name": "media_type",
            "schema": {
              "type": "string",
              "enum": [
                "html",
                "pdf",
                "txt",
                "json"
              ]
            },
            "description": "Filter by media type."
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of raw results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RawListResponse"
                },
                "examples": {
                  "ok": {
                    "summary": "Mixed sources example",
                    "value": {
                      "items": [
                        {
                          "id": "raw_12345",
                          "blob_uri": "s3://regintel/raw/raw_12345.html",
                          "source_url": "https://www.fda.gov/drugs/drug-safety-and-availability/drug-alerts-and-statements",
                          "fetched_at": "2025-11-10T08:23:45Z",
                          "media_type": "html",
                          "metadata": {
                            "language": "fr",
                            "size_bytes": 125000
                          }
                        },
                        {
                          "id": "raw_12346",
                          "blob_uri": "s3://regintel/raw/raw_12346.pdf",
                          "source_url": "https://www.esma.europa.eu/document-abc.pdf",
                          "fetched_at": "2025-11-09T22:10:12Z",
                          "media_type": "pdf",
                          "metadata": {
                            "language": "en",
                            "pages": 32
                          }
                        }
                      ],
                      "next_page_token": "eyJ..."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/raw/{id}": {
      "get": {
        "tags": [
          "raw"
        ],
        "summary": "Retrieve a raw document by ID",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier of the raw or indexed document"
          }
        ],
        "responses": {
          "200": {
            "description": "Raw document (metadata and optional small content snippet)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RawDocument"
                },
                "examples": {
                  "html_snippet": {
                    "value": {
                      "id": "raw_12345",
                      "blob_uri": "s3://regintel/raw/raw_12345.html",
                      "source_url": "https://www.fda.gov/drugs/drug-safety-and-availability/drug-alerts-and-statements",
                      "fetched_at": "2025-11-10T08:23:45Z",
                      "media_type": "html",
                      "content": "<html>...small snippet...</html>",
                      "metadata": {
                        "language": "fr"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/raw/{id}/download": {
      "get": {
        "tags": [
          "raw"
        ],
        "summary": "Stream raw document bytes",
        "description": "Streams the original binary bytes of the raw document identified by `id`.\nSupports HTTP Range requests for partial content and an optional `disposition` to hint inline vs attachment.\n",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier of the raw or indexed document"
          },
          {
            "in": "query",
            "name": "disposition",
            "description": "Content disposition hint for downloads",
            "schema": {
              "type": "string",
              "enum": [
                "inline",
                "attachment"
              ],
              "default": "inline"
            }
          },
          {
            "in": "header",
            "name": "Range",
            "description": "HTTP Range header to request partial bytes (e.g., `bytes=0-1023`)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Full file delivered",
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string"
                },
                "description": "Media type of the file (e.g., application/pdf)"
              },
              "Content-Length": {
                "schema": {
                  "type": "integer"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Last-Modified": {
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Ranges": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "bytes"
                  ]
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Partial content (Range)",
            "headers": {
              "Content-Range": {
                "schema": {
                  "type": "string"
                }
              },
              "Accept-Ranges": {
                "schema": {
                  "type": "string",
                  "examples": [
                    "bytes"
                  ]
                }
              }
            },
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "302": {
            "description": "Optional redirect to blob storage (if configured)"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "416": {
            "description": "Requested Range Not Satisfiable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Search in indexed data",
        "description": "Unified search over documents and chunks. Supports dense, sparse, exact, or hybrid modes with filters.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              },
              "examples": {
                "hybrid_chunks": {
                  "value": {
                    "query": "MiFID II passporting",
                    "mode": "hybrid",
                    "target": "chunk",
                    "limit": 20,
                    "filters": {
                      "source": [
                        "ema.europa.eu",
                        "fda.gov"
                      ]
                    }
                  }
                },
                "exact_docs": {
                  "value": {
                    "query": "\"article 721-1\"",
                    "mode": "exact",
                    "target": "document",
                    "limit": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                },
                "examples": {
                  "sample": {
                    "value": {
                      "total": 2,
                      "took_ms": 37,
                      "hits": [
                        {
                          "score": 12.34,
                          "doc": {
                            "id": "raw_12345",
                            "blob_uri": "s3://regintel/index/doc_12345.json",
                            "media_type": "html",
                            "chunks_count": 24,
                            "metadata": {
                              "title": "AMF – communiqué X"
                            }
                          },
                          "chunk": {
                            "id": "ch_001",
                            "doc_id": "raw_12345",
                            "content": "Passporting under MiFID II allows...",
                            "type": "TEXT",
                            "nb_tokens": 142
                          }
                        },
                        {
                          "score": 10.02,
                          "doc": {
                            "id": "raw_98765",
                            "blob_uri": "s3://regintel/index/doc_98765.json",
                            "media_type": "pdf",
                            "chunks_count": 12,
                            "metadata": {
                              "title": "ESMA guidance Y"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/chunks:batchGet": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Batch get chunks by IDs",
        "description": "Retrieve multiple chunks in one call, as returned by search.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "ids"
                ]
              },
              "examples": {
                "chunks": {
                  "value": {
                    "ids": [
                      "ch_001",
                      "ch_045"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch payload of chunks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchGetChunksResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/agents/qa": {
      "post": {
        "tags": [
          "agents"
        ],
        "summary": "Ask a question (Q&A) on sourced documents",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QARequest"
              },
              "examples": {
                "simple": {
                  "value": {
                    "questions": [
                      {
                        "question": "What are the reporting obligations for crypto-assets in France?",
                        "guideline": "If unclear, ask for jurisdiction scope."
                      }
                    ],
                    "doc_ids": [
                      "raw_12345",
                      "raw_98765"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Answer with sources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QAResponse"
                },
                "examples": {
                  "one": {
                    "value": {
                      "answer": "Crypto-asset service providers must...",
                      "explanation": "Derived from AMF notice 2025-XYZ and ESMA guidance 2024-ABC.",
                      "referenceIds": [
                        "raw_12345",
                        "raw_98765",
                        "ch_001"
                      ],
                      "usage": {
                        "tokens_input": 1823,
                        "tokens_output": 421,
                        "model": "gpt-4o-mini"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/v1/agents/extract-meta": {
      "post": {
        "tags": [
          "agents"
        ],
        "summary": "Extract structured metadata from docs",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractMetaRequest"
              },
              "examples": {
                "meta": {
                  "value": {
                    "metas": [
                      {
                        "meta": "regulation_number",
                        "answerType": {
                          "dataType": "STRING"
                        }
                      },
                      {
                        "meta": "publication_date",
                        "answerType": {
                          "dataType": "DATE"
                        }
                      },
                      {
                        "meta": "obligations",
                        "answerType": {
                          "dataType": "ENUM",
                          "enumValues": [
                            "REPORTING",
                            "CUSTODY",
                            "MARKET_ABUSE"
                          ],
                          "multiValued": true
                        }
                      }
                    ],
                    "doc_ids": [
                      "raw_12345"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Extraction result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractMetaResponse"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "metaAnswers": [
                        {
                          "meta": "regulation_number",
                          "answer": "AMF-2025-XYZ",
                          "explanation": "Appears in heading section.",
                          "referenceIds": [
                            "ch_003"
                          ]
                        },
                        {
                          "meta": "publication_date",
                          "answer": "2025-11-04",
                          "referenceIds": [
                            "raw_12345"
                          ]
                        }
                      ],
                      "usage": {
                        "tokens_input": 902,
                        "tokens_output": 210,
                        "model": "gpt-4o-mini"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait before retrying",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "Server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "RawListRequest": {
        "type": "object",
        "properties": {
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 50,
            "description": "Maximum number of items to return."
          },
          "page_token": {
            "type": "string",
            "description": "Cursor returned by a previous page for forward pagination."
          },
          "order_by": {
            "type": "string",
            "enum": [
              "fetched_at_desc",
              "fetched_at_asc"
            ],
            "default": "fetched_at_desc",
            "description": "Sort order based on the last fetch timestamp."
          },
          "fetched_since": {
            "type": "string",
            "format": "date-time",
            "description": "Only return items last fetched >= this timestamp (UTC ISO8601)"
          },
          "fetched_until": {
            "type": "string",
            "format": "date-time",
            "description": "Only return items last fetched < this timestamp (UTC ISO8601)"
          },
          "source": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "One or more regulator domains/sources"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "html",
              "pdf",
              "txt",
              "json"
            ],
            "description": "Filter by media type."
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "RawDocument": {
        "type": "object",
        "description": "Raw scraped payload (pre-indexing) and its metadata.",
        "properties": {
          "id": {
            "type": "string"
          },
          "blob_uri": {
            "type": "string",
            "description": "Pointer to the stored blob (e.g., s3://...)"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "html",
              "pdf",
              "txt",
              "json"
            ]
          },
          "content": {
            "type": "string",
            "description": "Raw content (optional if large)"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "blob_uri",
          "source_url",
          "fetched_at"
        ]
      },
      "RawListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RawDocument"
            }
          },
          "next_page_token": {
            "type": "string"
          }
        }
      },
      "IndexedDocument": {
        "type": "object",
        "description": "Normalized/indexed view of a raw document (used by search).",
        "properties": {
          "id": {
            "type": "string",
            "description": "Same ID as raw document"
          },
          "blob_uri": {
            "type": "string",
            "format": "uri",
            "description": "Pointer to the indexed payload"
          },
          "media_type": {
            "type": "string",
            "enum": [
              "html",
              "pdf",
              "txt",
              "json"
            ]
          },
          "chunks_count": {
            "type": "integer"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "blob_uri"
        ]
      },
      "Chunk": {
        "type": "object",
        "description": "An atomic retrieval unit (text, table, image, composite) extracted from an indexed document.",
        "properties": {
          "id": {
            "type": "string"
          },
          "doc_id": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "TEXT",
              "TABLE",
              "IMAGE",
              "COMPOSITE"
            ]
          },
          "nb_tokens": {
            "type": "integer"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Positions, page numbers, offsets, etc."
          }
        }
      },
      "BatchGetChunksResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Chunk"
            }
          }
        }
      },
      "SearchFilters": {
        "type": "object",
        "properties": {
          "source": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "media_type": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "html",
                "pdf",
                "txt",
                "json"
              ]
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "SearchRequest": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query (supports exact/hybrid depending on mode)"
          },
          "mode": {
            "type": "string",
            "enum": [
              "dense",
              "sparse",
              "hybrid",
              "exact"
            ],
            "default": "hybrid"
          },
          "target": {
            "type": "string",
            "enum": [
              "document",
              "chunk"
            ],
            "default": "chunk"
          },
          "limit": {
            "type": "integer",
            "default": 10
          },
          "offset": {
            "type": "integer",
            "default": 0
          },
          "filters": {
            "$ref": "#/components/schemas/SearchFilters"
          },
          "doc_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Restrict search to a whitelist of documents"
          }
        },
        "required": [
          "query"
        ]
      },
      "SearchHit": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number"
          },
          "doc": {
            "$ref": "#/components/schemas/IndexedDocument"
          },
          "chunk": {
            "$ref": "#/components/schemas/Chunk"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "hits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchHit"
            }
          },
          "took_ms": {
            "type": "integer"
          }
        }
      },
      "QARequest": {
        "type": "object",
        "properties": {
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QAQuestion"
            }
          },
          "doc_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "QAQuestion": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "guideline": {
            "type": "string"
          }
        },
        "required": [
          "question"
        ]
      },
      "QAResponse": {
        "type": "object",
        "properties": {
          "answer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "referenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "tokens_input": {
                "type": "integer"
              },
              "tokens_output": {
                "type": "integer"
              },
              "model": {
                "type": "string"
              }
            }
          }
        }
      },
      "ExtractMetaRequest": {
        "type": "object",
        "properties": {
          "metas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetaRequest"
            }
          },
          "doc_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MetaRequest": {
        "type": "object",
        "properties": {
          "meta": {
            "type": "string"
          },
          "answerType": {
            "type": "object",
            "properties": {
              "dataType": {
                "type": "string",
                "enum": [
                  "STRING",
                  "INT",
                  "FLOAT",
                  "BOOL",
                  "DATE",
                  "ENUM"
                ]
              },
              "enumValues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "multiValued": {
                "type": "boolean"
              },
              "decimalPrecision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "enumSuggestionsEnabled": {
                "type": "boolean"
              }
            }
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ExtractMetaResponse": {
        "type": "object",
        "properties": {
          "metaAnswers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MetaResponse"
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "tokens_input": {
                "type": "integer"
              },
              "tokens_output": {
                "type": "integer"
              },
              "model": {
                "type": "string"
              }
            }
          }
        }
      },
      "MetaResponse": {
        "type": "object",
        "properties": {
          "meta": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "referenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
