{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Registro de Boleto com QR Code",
    "description": "Esta API permite registrar boletos híbridos com QrCode e boletos sem QrCode.",
    "version": "2.0.58",
    "contact": {
      "name": "API Support",
      "email": "suporte.api@bradesco.com.br"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/C2781/api-de-registro-de-boleto-com-qr-code/2.0.58"
  },
  "servers": [
    {
      "url": "https://proxy.api.prebanco.com.br"
    }
  ],
  "paths": {
    "/v1/boleto-hibrido/registrar-boleto": {
      "post": {
        "tags": [
          "Registrar Boleto Híbrido"
        ],
        "summary": "Gerar Boleto de Cobrança",
        "operationId": "gerarBoleto",
        "parameters": [
          {
            "name": "X-Brad-Nonce",
            "in": "header",
            "schema": {
              "type": "string",
              "example": 1711640504036
            },
            "required": true,
            "description": "Data/hora atual em milissegundos conforme orientado na <code>seção Consumo da API - Server-to-Server do guia de autenticação do Bradesco</code>."
          },
          {
            "name": "X-Brad-Signature",
            "in": "header",
            "schema": {
              "type": "string",
              "example": ""
            },
            "required": true,
            "description": "JWS assinado com o certificado privado do parceiro contendo informações da api consumida conforme orientado na <code>seção Consumo da API - Server-to-Server do guia de autenticação do Bradesco</code>."
          },
          {
            "name": "X-Brad-Timestamp",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "2024-03-28T12:41:44-03:00"
            },
            "required": true,
            "description": "Data/hora atual no formato (AAAA-MM-DDThh:mm:ss-00:00) conforme orientado na <code>seção Consumo da API - Server-to-Server do guia de autenticação do Bradesco</code>."
          },
          {
            "name": "X-Brad-Algorithm",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "SHA256"
            },
            "required": true,
            "description": "Algoritmo utilizado na assinatura do JWT ao gerar o JWS do campo X-Brad-Signature conforme orientado na <code>seção Consumo da API - Server-to-Server do guia de autenticação do Bradesco</code>."
          },
          {
            "name": "access-token",
            "in": "header",
            "schema": {
              "type": "string",
              "example": "2e14abe5-dqcf-474b-9e4a-b779511376ef7"
            },
            "required": true,
            "description": "Client ID do cadastro do parceiro conforme orientado na <code>seção Consumo da API - Server-to-Server do guia de autenticação do Bradesco</code>."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/gerarBoletoRequest"
              },
              "example": {
                "registrarTitulo": 1,
