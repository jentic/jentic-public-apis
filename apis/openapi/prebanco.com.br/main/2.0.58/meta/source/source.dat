  "components": {
    "schemas": {
      "gerarBoletoRequest": {
        "type": "object",
        "properties": {
          "registrarTitulo": {
            "type": "integer",
            "description": "Registrar título, 1 = Registrar o título."
          },
          "codUsuario": {
            "type": "string",
            "description": "Código do Usuário responsável."
          },
          "nroCpfCnpjBenef": {
            "type": "number",
            "format": null,
            "description": "Número de Inscrição do CNPJ ou CPF do Beneficiário (Cedente)."
          },
          "filCpfCnpjBenef": {
            "type": "integer",
            "description": "Número da Filial do CNPJ do Beneficiário (Cedente) Obs. incluir zeros quando se tratar de CPF."
          },
          "digCpfCnpjBenef": {
            "type": "integer",
            "description": "Dígitos verificadores do CNPJ ou CPF do Beneficiário (Cedente)."
          },
          "tipoAcesso": {
            "type": "integer",
            "description": "Tipo de acesso desejado."
          },
          "cpssoaJuridContr": {
            "type": "number",
            "description": "Código da pessoa jurídica do contrato."
          },
          "ctpoContrNegoc": {
            "type": "integer",
            "description": "Tipo do Contrato."
          },
          "nseqContrNegoc": {
            "type": "number",
            "description": "Número do Contrato."
          },
          "cidtfdProdCobr": {
            "type": "integer",
            "description": "Identificador do Produto Cobrança (Carteira) ."
          },
          "cnegocCobr": {
            "type": "number",
            "description": "Número do Contrato (Negociação Agência + Conta)"
          },
          "filler": {
            "type": "string",
            "description": "Implementações futuras."
          },
          "codigoBanco": {
            "type": "integer",
            "description": "Código do Banco."
          },
          "eNseqContrNegoc": {
            "type": "number",
            "description": "Número do Contrato."
          },
          "tipoRegistro": {
            "type": "integer",
            "description": "Tipo de registro do título; 001 = Título | 002 = Título com Instrução de Protesto | 003 = Título com Instrução de Protesto Falimentar."
          },
          "cprodtServcOper": {
            "type": "integer",
            "description": "Código do Produto Cobrança."
          },
          "ctitloCobrCdent": {
            "type": "number",
            "description": "Nosso Número."
          },
          "ctitloCliCdent": {
            "type": "string",
            "description": "Identificador do título pelo beneficiário (Seu Número)."
          },
          "demisTitloCobr": {
            "type": "string",
            "description": "Data de emissão do título. Deve ser informada como o exemplo 01.01.2001."
          },
          "dvctoTitloCobr": {
            "type": "string",
            "description": "Data de vencimento do título. Deve ser informada como o exemplo 01.01.2001."
          },
          "cidtfdTpoVcto": {
            "type": "integer",
            "description": "Identificador do tipo de vencimento."
          },
          "cindcdEconmMoeda": {
            "type": "integer",
            "description": "Identificador da moeda do título (BACEN)."
          },
          "vnmnalTitloCobr": {
            "type": "number",
            "description": "Valor nominal do título. Deve ser informado com 2 decimais (Exemplo; R$ 2,00 = 200 | R$ 0,05 = 005)."
          },
          "qmoedaNegocTitlo": {
            "type": "number",
            "description": "Quantidade de moeda do título."
          },
          "cespceTitloCobr": {
            "type": "integer",
            "description": "Código da espécie do título Ex. 02 = DM (item 8)."
          },
          "cindcdAceitSacdo": {
            "type": "string",
            "description": "Identificador de aceite do devedor (Sacado)."
          },
          "ctpoProteTitlo": {
            "type": "integer",
            "description": "Tipo de protesto automático do título. 1 = Dias corridos | 2 = Dias úteis."
          },
          "ctpoPrzProte": {
            "type": "integer",
            "description": "Quantidade de dias após o vencimento, para protesto automático."
          },
          "ctpoProteDecurs": {
            "type": "integer",
            "description": "Tipo decurso de protesto. 1 = Dias corridos | 2 = Dias úteis."
          },
          "ctpoPrzDecurs": {
            "type": "integer",
            "description": "Quantidade de dias para decurso de protesto."
          },
          "cctrlPartcTitlo": {
            "type": "string",
            "description": "Controle do participante."
          },
          "cformaEmisPplta": {
            "type": "integer",
            "description": "Forma de emissão do boleto (Papeleta). 02 = Cliente emite."
          },
          "cindcdPgtoParcial": {
            "type": "string",
            "description": "Indicador de pagamento parcial. S = Sim | N = Não."
          },
          "qtdePgtoParcial": {
            "type": "integer",
            "description": "Quantidade de pagamento parcial de 001 a 099."
          },
          "filler1": {
            "type": "string",
            "description": "Implementações futuras."
          },
          "ptxJuroVcto": {
            "type": "integer",
            "description": "Percentual de juros após vencimento. Deve ser informado com 5 decimais (Exemplo; 2% = 2.00000 | 0,05% = 0.05000)."
          },
          "vdiaJuroMora": {
            "type": "number",
            "description": "Valor diário de juros após vencimento. Deve ser informado com 2 decimais (Exemplo; R$ 2,00 = 200 | R$ 0,05 = 005)."
          },
          "qdiaInicJuro": {
            "type": "integer",
            "description": "Quantidade de dias após o vencimento, para incidência de juros."
          },
          "pmultaAplicVcto": {
            "type": "integer",
            "description": "Percentual de multa após vencimento. Deve ser informado com 5 decimais (Exemplo; 2% = 2.00000 | 0,05% = 0.05000)."
          },
          "vmultaAtrsoPgto": {
            "type": "number",
            "description": "Valor da multa após vencimento. Deve ser informado com 2 decimais (Exemplo; R$ 2,00 = 200 | R$ 0,05 = 005)."
          },
          "qdiaInicMulta": {
            "type": "integer",
            "description": "Quantidade de dias após o vencimento, para incidência de multa."
          },
          "pdescBonifPgto01": {
            "type": "integer",
            "description": "1° - Percentual de desconto. Deve ser informado com 5 decimais (Exemplo; 2% = 2.00000 | 0,05% = 0.05000)."
          },
          "vdescBonifPgto01": {
            "type": "number",
            "description": "1° - Valor de desconto. Deve ser informado com 2 decimais (Exemplo; R$ 2,00 = 200 | R$ 0,05 = 005)."
          },
          "dlimDescBonif1": {
            "type": "string",
            "description": "1° - Data-limite de desconto. Deve ser informada como o exemplo 01.01.2001."
          },
          "pdescBonifPgto02": {
            "type": "integer",
            "description": "2° - Percentual de desconto. Deve ser informado com 5 decimais (Exemplo; 2% = 2.00000 | 0,05% = 0.05000).."
          },
          "vdescBonifPgto02": {
            "type": "number",
            "description": "2° - Valor de desconto. Deve ser informado com 2 decimais (Exemplo; R$ 2,00 = 200 | R$ 0,05 = 005).."
          },
          "dlimDescBonif2": {
            "type": "string",
            "description": "2° - Data-limite de desconto. Deve ser informada como o exemplo 01.01.2001."
          },
          "pdescBonifPgto03": {
            "type": "integer",
            "description": "3° - Percentual de desconto. Deve ser informado com 5 decimais (Exemplo; 2% = 2.00000 | 0,05% = 0.05000).."
          },
          "vdescBonifPgto03": {
            "type": "number",
            "description": "3° - Valor de desconto. Deve ser informado com 2 decimais (Exemplo; R$ 2,00 = 200 | R$ 0,05 = 005).."
          },
          "dlimDescBonif3": {
            "type": "string",
            "description": "3° - Data-limite de desconto. Deve ser informada como o exemplo 01.01.2001.."
          },
          "ctpoPrzCobr": {
            "type": "integer",
            "description": "Tipo de prazo desconto/bonificação. 1 = Dias corridos | 2 = Dias úteis."
          },
          "pdescBonifPgto": {
            "type": "integer",
            "description": "Percentual de desconto. Deve ser informado com 5 decimais (Exemplo; 2% = 2.00000 | 0,05% = 0.05000)."
          },
          "vdescBonifPgto": {
            "type": "number",
            "description": "Valor de bonificação. Deve ser informado com 2 decimais (Exemplo; R$ 2,00 = 200 | R$ 0,05 = 005)."
          },
          "dlimBonifPgto": {
            "type": "string",
            "description": "Data-limite de bonificação. Deve ser informada como o exemplo 01.01.2001."
          },
          "vabtmtTitloCobr": {
            "type": "number",
            "description": "Valor de abatimento do título."
          },
          "viofPgtoTitlo": {
            "type": "number",
            "description": "Valor de IOF do título."
          },
          "filler2": {
            "type": "string",
            "description": "Implementações futuras."
          },
          "isacdoTitloCobr": {
            "type": "string",
