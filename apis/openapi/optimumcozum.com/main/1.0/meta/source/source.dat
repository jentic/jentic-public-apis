{
  "openapi": "3.1.0",
  "info": {
    "title": "LeasePlan Api",
    "description": "Dosya bilgilerini listeler \n\nKullanıcı adı: `akademi`\\\nParola: `MSCSkZj4UUD65395`\n",
    "version": "1.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/YGMRAKBS90/leaseplan-api/1.0"
  },
  "servers": [
    {
      "url": "https://orp.optimumcozum.com/integrations/web-service-apis/l/akademi"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "Dosya Detayları",
      "description": "Açılan dosya detaylarını listeler"
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "ClaimPayload": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "description": "Hata durumunda hata mesajlarını içeren array",
            "items": {
              "type": "string"
            }
          },
          "input": {
            "type": "object"
          },
          "output": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "Dosya Id"
                },
                "code": {
                  "type": "string",
                  "description": "Dosya No"
                },
                "createdAt": {
                  "type": "object",
                  "description": "Dosya oluşturma tarihi",
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "timezone_type": {
                      "type": "integer",
                      "enum": [
                        3
                      ]
                    },
                    "timezone": {
                      "type": "string",
                      "enum": [
                        "Etc/UTC"
                      ]
                    }
                  }
                },
                "contactPersonName": {
                  "type": "string",
                  "description": "İhbarı yapan kişi"
                },
                "contactPersonPhoneNumber": {
                  "type": "string",
                  "description": "İhbarı yapan kişi telefon numarası"
                },
                "contactPersonEmail": {
                  "type": "string",
                  "format": "email",
                  "description": "İhbarı yapan kişi e-posta adresi"
                },
                "claimType": {
                  "type": "string",
                  "description": "Dosya Tipi"
                },
                "estimatedDeliveryDate": {
                  "description": "Tahmini teslim tarihi",
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "timezone_type": {
                      "type": "integer",
                      "enum": [
                        3
                      ]
                    },
                    "timezone": {
                      "type": "string",
                      "enum": [
                        "Etc/UTC"
                      ]
                    }
                  }
                },
                "deliveryDate": {
                  "description": "Gerçekleşen teslim tarihi",
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "timezone_type": {
                      "type": "integer",
                      "enum": [
                        3
                      ]
                    },
                    "timezone": {
                      "type": "string",
                      "enum": [
                        "Etc/UTC"
                      ]
                    }
                  }
                },
                "temporaryCarRequested": {
                  "type": "boolean",
                  "description": "İkame talebi var mı"
                },
                "serviceNotes": {
                  "type": "string",
                  "description": "Servis Notu"
                },
                "customerDemandsFromService": {
                  "type": "string",
                  "description": "Kullanıcının servise gittiğinde ilettiği istekleri"
                },
                "customerDemandsFromCallCenter": {
                  "type": "string",
                  "description": "Kullanıcının çağrı merkezini aradığında ilettiği istekleri"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "available-for-sending-to-service",
                    "in-service",
                    "directed-to-service",
                    "waiting-for-send-to-expert",
                    "waiting-for-expert-approval",
                    "waiting-for-missing-documents",
                    "waiting-for-damage-follow-up",
                    "returned-from-approval-problem-document",
                    "ready-to-repair",
                    "started-to-repair",
                    "available-for-deliver",
                    "waiting-for-delivery-approval",
                    "returned-from-delivery-approval",
                    "delivered"
                  ],
                  "description": "Dosya durumu"
                },
                "serviceCheckInAt": {
                  "description": "Servis giriş tarihi",
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "timezone_type": {
                      "type": "integer",
                      "enum": [
                        3
                      ]
                    },
                    "timezone": {
                      "type": "string",
                      "enum": [
                        "Etc/UTC"
                      ]
                    }
                  }
                },
                "km": {
                  "type": "integer",
                  "description": "Servisin girdiği araç km bilgisi"
                },
                "expertApprovedAt": {
                  "description": "Uzman Onaylama tarihi",
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "timezone_type": {
                      "type": "integer",
                      "enum": [
                        3
                      ]
                    },
                    "timezone": {
                      "type": "string",
                      "enum": [
                        "Etc/UTC"
                      ]
                    }
                  }
                },
                "callCenterMaintenanceKm": {
                  "type": "string",
                  "description": "Kullanıcının çağrı merkezini aradığında ilettiği km bilgisi"
                },
                "callCenterKm": {
                  "type": "string",
                  "description": "Kullanıcının çağrı merkezini aradığında ilettiği km bilgisi"
                },
                "claimAvailableForDelivered": {
                  "description": "Dosya teslime uygun tarihi",
                  "type": "object",
                  "properties": {
                    "date": {
                      "type": "string"
                    },
                    "timezone_type": {
                      "type": "integer",
                      "enum": [
                        3
                      ]
                    },
                    "timezone": {
                      "type": "string",
                      "enum": [
                        "Etc/UTC"
                      ]
                    }
                  }
                },
                "uid": {
                  "type": "string",
                  "description": "Dosya uid numarası"
                },
                "fleetCar": {
                  "description": "Filo aracı",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "Filo Araç ID"
                    },
                    "uid": {
                      "type": "string",
                      "description": "Filo Araç Uid"
                    },
                    "chassisNumber": {
                      "type": "string",
                      "description": "Araç Sasi Numarası"
                    },
                    "registrationNumber": {
                      "type": "string",
                      "description": "Araç Plakası"
                    },
                    "year": {
                      "type": "integer",
                      "description": "Araç Yılı"
                    },
                    "carBrand": {
                      "type": "object",
                      "description": "Araç Marka",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "description": "Araç Marka Id"
                        },
                        "name": {
                          "type": "string",
                          "description": "Araç Marka Adı"
                        }
                      }
                    },
                    "carModel": {
                      "type": "object",
                      "description": "Araç Model",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "description": "Araç Model Id"
                        },
                        "name": {
                          "type": "string",
                          "description": "Araç Model Adı"
                        }
                      }
                    }
                  }
                },
                "service": {
                  "description": "Dosya servis bilgileri",
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "Servis ID"
                    },
                    "name": {
                      "type": "string",
                      "description": "Servis adı"
                    },
                    "addressCity_id": {
                      "type": "integer",
                      "description": "İl Id"
                    },
                    "addressDistrict_id": {
                      "type": "integer",
                      "description": "İlçe Id"
                    },
                    "idForCustomer": {
                      "type": "integer",
                      "description": "İhale No"
                    }
                  }
                },
                "lineItems": {
                  "type": "array",
                  "description": "Dosya parça bilgileri",
                  "items": {
                    "properties": {
                      "id": {
                        "type": "integer",
                        "description": "Parça Id"
                      },
                      "uid": {
                        "type": "string",
                        "description": "Parça UID"
                      },
                      "partNumber": {
                        "type": "string",
                        "description": "Parça Numarası"
                      },
                      "partName": {
                        "type": "string",
                        "description": "Parça Adı"
                      },
                      "quantity": {
                        "type": "number",
                        "format": "float",
                        "description": "Parça Adedi"
                      },
                      "totalLaborPrice": {
                        "format": "float",
                        "type": "number",
                        "description": "İşçilik Tutarı"
                      },
                      "laborHour": {
                        "type": "number",
                        "format": "float",
                        "description": "İşçilik Saati"
                      },
                      "laborCode": {
                        "type": "string",
                        "description": "İşçilik Kodu"
                      },
                      "totalPartPriceWithDiscount": {
                        "type": "number",
                        "format": "float",
                        "description": "Toplam İndirimli Parça Fiyatı"
                      },
                      "totalLaborPriceWithDiscount": {
                        "type": "number",
                        "format": "float",
                        "description": "Toplam İndirimli İşçilik Tutarı"
                      },
                      "lastPartPricePerItem": {
                        "type": "number",
                        "format": "float",
                        "description": "Birim Fiyatı"
                      },
                      "partOriginality": {
                        "type": "string",
                        "description": "Parça ID"
                      },
                      "subsidiaryCode": {
                        "type": "integer",
                        "description": "Üretici Parça Kodu"
                      },
                      "recourseNotesFromExpert": {
                        "type": "string",
                        "description": "Yansıtma Notu"
                      }
                    }
                  }
                },
                "claimUploads": {
                  "type": "array",
                  "description": "Dosya belgeleri",
                  "items": {
                    "properties": {
                      "id": {
                        "type": "integer",
                        "description": "Belge Id"
                      },
                      "type": {
                        "type": "string",
                        "description": "Belge tipi"
                      },
                      "uploadType": {
                        "type": "string",
                        "description": "Yüklenen belge tipi"
                      },
                      "upload": {
                        "type": "object",
                        "description": "Belge",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "fileType": {
                            "type": "string"
                          },
                          "originalFilename": {
                            "type": "string"
                          },
                          "uploadedFilename": {
                            "type": "string"
                          },
                          "uploadPath": {
                            "type": "string",
                            "description": "Dosya yolu"
                          }
                        }
                      }
                    }
                  }
                },
                "address": {
                  "type": "array",
                  "items": {
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "type": {
                        "type": "string",
                        "description": "Adres Türü",
                        "enum": [
                          "damage-location",
                          "car-location"
                        ]
                      }
                    }
                  }
                },
                "trackingNumber": {
                  "type": "string",
                  "description": "Takip No"
                },
                "remarketingCostType": {
                  "type": "integer",
                  "description": ""
                },
                "paymentComplate": {
                  "type": "boolean",
                  "description": "Ödeme tamamlandı mı"
                },
                "isCancelled": {
                  "type": "boolean",
                  "description": "iptal edildi mi"
                },
                "claim": {
                  "type": "object",
                  "properties": {
                    "expertApprovedAt": {
                      "description": "Uzman Onay Tarihi",
                      "type": "object",
                      "properties": {
                        "date": {
                          "type": "string"
                        },
                        "timezone_type": {
                          "type": "integer",
                          "enum": [
                            3
                          ]
                        },
                        "timezone": {
                          "type": "string",
                          "enum": [
                            "Etc/UTC"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "ERROR",
              "NOT_VALID",
              "SUCCESS"
            ]
          },
          "extras": {
            "type": "object"
          }
        }
      }
    }
  },
  "paths": {
    "/claimDetails": {
      "get": {
        "tags": [
          "Dosya Detayları"
        ],
        "parameters": [
          {
            "name": "uid",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Dosya Uid"
          },
          {
            "name": "code",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Dosya Kodu"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "available-for-sending-to-service",
                "in-service",
                "directed-to-service",
                "waiting-for-send-to-expert",
                "waiting-for-expert-approval",
                "waiting-for-missing-documents",
                "waiting-for-damage-follow-up",
                "returned-from-approval-problem-document",
                "ready-to-repair",
                "started-to-repair",
                "available-for-deliver",
                "waiting-for-delivery-approval",
                "returned-from-delivery-approval",
                "delivered"
              ]
            },
            "description": "Dosya Statüsü"
          },
          {
            "name": "createdAtFrom",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Y-m-d formatında dosya oluşturma tarihi alt sınırı"
          },
          {
            "name": "createdAtTo",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Y-m-d formatında dosya oluşturma tarihi üst sınırı"
          },
          {
            "name": "deliveryAtFrom",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Y-m-d formatında dosya teslim tarihi alt sınırı\n"
          },
          {
            "name": "deliveryAtTo",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Y-m-d formatında dosya teslim tarihi üst sınırı"
          },
          {
            "name": "lastControlDate",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Y-m-d formatında son kontrol tarihi"
          },
          {
            "name": "serviceCheckInAtFrom",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Y-m-d formatında dosya servise giriş tarihi alt sınırı"
          },
          {
            "name": "serviceCheckInAtTo",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Y-m-d formatında dosya servise giriş üst sınırı"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimPayload"
                }
              }
            }
          },
          "401": {
            "description": "NOT AUTHORIZED"
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    }
  }
}
