          },
          "titre": {
            "type": "string"
          },
          "regles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/StepRule"
            }
          }
        }
      },
      "Menu": {
        "properties": {
          "tva": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Tva"
            }
          },
          "categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          },
          "groupes": {
            "type": "array",
            "minItems": 1,
            "items": {
