{
  "openapi": "3.0.0",
  "info": {
    "title": "SPLASH Click & Collect API",
    "version": "1.0.0",
    "description": "",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/SPLASH360/splash-click-collect-api/1.0.0"
  },
  "servers": [
    {
      "url": "https://api.splash360.fr"
    }
  ],
  "tags": [
    {
      "name": "Menu",
      "description": "Menu APIs"
    },
    {
      "name": "Commande",
      "description": "Commandes APIS"
    }
  ],
  "paths": {
    "/api/export/menus": {
      "get": {
        "tags": [
          "Menu"
        ],
        "summary": "Get menus",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Menu"
                }
              }
            }
          }
        }
      }
    },
    "/api/import/submitcommande": {
      "post": {
        "tags": [
          "Commande"
        ],
        "summary": "Soumettre une commande",
        "description": "Soumettre une commande",
        "operationId": "submitcommande",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mode",
                  "total",
                  "items"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "description": "Nom du provider"
                  },
                  "mode": {
                    "type": "string",
                    "description": "Mode de livraison",
                    "enum": [
                      "surplace",
                      "emporter",
                      "livraison"
                    ]
                  },
                  "bipper": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "standby",
                      "confirmed"
                    ],
                    "description": "Statut de la commande (standby)"
                  },
                  "total": {
                    "type": "number",
                    "description": "Montant total commande"
                  },
                  "paymentType": {
                    "type": "string",
                    "enum": [
                      "carte",
                      "especes",
                      "cheque",
                      "ticket",
                      "desk"
                    ],
                    "description": "Moyen de paiement pour les paiement à reception de la commande"
                  },
                  "orderNumber": {
                    "type": "string",
                    "description": "Numéro de commande externe (Ex. numéro commande Dishop)"
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "itemid",
                        "produitid",
                        "quantite"
                      ],
                      "properties": {
                        "ingredients": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "ingredient",
                              "qte"
                            ],
                            "properties": {
                              "ingredient": {
                                "type": "string",
                                "description": "Ingredient ID"
                              },
                              "qte": {
                                "type": "integer",
                                "minimum": 1,
                                "description": "Quantité"
                              },
                              "price": {
                                "type": "number",
                                "description": "Prix"
                              }
                            }
                          }
                        },
                        "itemid": {
                          "type": "integer",
                          "description": "ID aleatoire unique identifiant la ligne dans la commande"
                        },
                        "produitid": {
                          "type": "string",
                          "description": "Produit ID"
                        },
                        "quantite": {
                          "type": "integer",
                          "minimum": 1,
                          "description": "Quantité"
                        },
                        "price": {
                          "type": "number",
                          "description": "Prix unitaire du produit"
                        }
                      }
                    }
                  },
                  "comments": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "text"
                        ],
                        "properties": {
                          "id": {
                            "type": "number",
                            "description": "ID commentaire"
                          },
                          "itemid": {
                            "type": "number",
                            "description": "ID de la ligne concernée si relatif à une ligne"
                          },
                          "text": {
                            "type": "string",
                            "description": "Text du commentaire"
                          }
                        }
                      }
                    },
                    "description": "Commentaires commande et/ou sur les lignes"
                  },
                  "client": {
                    "type": "object",
                    "required": [
                      "nom",
                      "prenom",
                      "telephone"
                    ],
                    "description": "Infos client",
                    "properties": {
                      "nom": {
                        "type": "string",
                        "maxLength": 150
                      },
                      "prenom": {
                        "type": "string",
                        "maxLength": 150
                      },
                      "telephone": {
                        "type": "string",
                        "maxLength": 150
                      },
                      "telephone2": {
                        "type": "string"
                      },
                      "adresse": {
                        "type": "string"
                      },
                      "adresse2": {
                        "type": "string"
                      },
                      "batiment": {
                        "type": "string"
                      },
                      "etage": {
                        "nullable": true
                      },
                      "codepostal": {
                        "type": "string",
                        "format": "utc-millisec"
                      },
                      "ville": {
                        "type": "string"
                      },
                      "commentaire": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string",
                        "format": "email"
                      },
                      "mode": {
                        "type": "string"
                      }
                    }
                  },
                  "modificateurs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "valeur",
                        "nom"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "discount",
                            "frais"
                          ]
                        },
                        "valeur": {
                          "type": "string",
                          "description": "Valeur du modificateur, nombre + suffix (€, %). Le suffixe € pour les valeurs numeraires et % pour les pourcentage"
                        },
                        "taux": {
                          "type": "number",
                          "description": "Pour les modificateurs type frais, il est indispensable de le taux de TVA à appliqué, la valeur devant être le TTC"
                        },
                        "item": {
                          "type": "number",
                          "description": "L'ID de la ligne sur la quelle appliquer le modificateur. Ommettre s'il s'agit d'un modificateur global"
                        },
                        "nom": {
                          "type": "string",
                          "description": "Nom du modificateur"
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "mode": "emporter",
                "bipper": "",
                "status": "standby",
                "total": 27.5,
                "items": [
                  {
                    "ingredients": [
                      {
                        "ingredient": "ing108",
                        "qte": 1
                      },
                      {
                        "ingredient": "ing110",
                        "qte": 1
                      },
                      {
                        "ingredient": "ing109",
                        "qte": 1
                      },
                      {
                        "ingredient": "ing111",
                        "qte": 1
                      },
                      {
                        "ingredient": "ing118",
                        "qte": 1
                      },
                      {
                        "ingredient": "ing122",
                        "qte": 1
                      },
                      {
                        "ingredient": "ing143",
                        "qte": 1
                      },
                      {
                        "ingredient": "ing7349",
                        "qte": 1
                      }
                    ],
                    "itemid": 1692893182272,
                    "produitid": "prd87",
                    "quantite": 1,
                    "comments": []
                  },
                  {
                    "ingredients": [
                      {
                        "ingredient": "ing108",
                        "qte": 1
                      },
                      {
                        "ingredient": "ing110",
                        "qte": 1
                      },
                      {
                        "ingredient": "ing120",
                        "qte": 1
                      },
                      {
                        "ingredient": "ing143",
                        "qte": 1
                      }
                    ],
                    "itemid": 1692893182273,
                    "produitid": "prd85",
                    "quantite": 1,
                    "comments": []
                  },
                  {
                    "ingredients": [],
                    "itemid": 1692893182274,
                    "produitid": "prd1826",
                    "quantite": 1,
                    "comments": []
                  }
                ],
                "reglements": [],
                "comments": [],
                "client": {
                  "nom": "DIALLO",
                  "prenom": "Abdoul",
                  "telephone": "+33629443731",
                  "telephone2": "",
                  "adresse": "9 rue de la vega",
                  "adresse2": "",
                  "batiment": "",
                  "etage": null,
                  "codepostal": "77115",
                  "ville": "BLANDY LES TOURS",
                  "commentaire": "",
                  "email": "abdoulsalamy@yahoo.fr",
                  "mode": "emporter"
                },
                "modificateurs": [
                  {
                    "type": "frais",
                    "valeur": "1.00€",
                    "taux": 0.2,
                    "item": null,
                    "ingredient": null,
                    "nom": "frais de gestion",
                    "operation": 1
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "success",
                        "error"
                      ]
                    },
                    "ticketId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "4XX": {
            "description": "Invalid data"
          },
          "5XX": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/export/cmdstatus/{ticketId}": {
      "get": {
        "tags": [
          "Commande"
        ],
        "summary": "Commande status",
        "description": "Retourne le statut de la commande.",
        "operationId": "getPetById",
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "description": "Commande ticket id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "4XX": {
            "description": "Invalid data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitError"
                }
              }
            }
          },
          "5XX": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/import/submitcmdpaiement/{ticketId}": {
      "post": {
        "tags": [
          "Commande"
        ],
        "summary": "Soumettre le paiement",
        "description": "Notifier le paiement de la Commande",
        "operationId": "submitcmdpaiement",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "description": "Commande ticket id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reglements"
                ],
                "properties": {
                  "reglements": {
                    "description": "Tableau des reglements (peut être vide si commande payée à reception)",
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Payment"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitResponse"
                }
              }
            }
          },
          "4XX": {
            "description": "Invalid data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitError"
                }
              }
            }
          },
          "5XX": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Payment": {
        "required": [
          "type",
          "valeur"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "carte",
              "especes",
              "cheque",
              "ticket"
            ]
          },
          "valeur": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "SubmitResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "ticketId": {
            "type": "string"
          }
        }
      },
      "SubmitError": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error_message": {
            "type": "string"
          }
        }
      },
      "Image": {
        "properties": {
          "location": {
            "type": "string"
          },
          "fileHash": {
            "type": "string"
          },
          "hashAlg": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "location",
          "fileHash",
          "hashAlg",
          "type"
        ]
      },
      "Tva": {
        "properties": {
          "tva_id": {
            "type": "string"
          },
          "nom": {
            "type": "string"
          },
          "valeur": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Category": {
        "properties": {
          "categorie_id": {
            "type": "string"
          },
          "nom": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "catalog_id": {
            "type": "integer"
          },
          "revision": {
            "type": "integer"
          },
          "image": {
            "$ref": "#/components/schemas/Image"
          }
        }
      },
      "Groupe": {
        "properties": {
          "groupe_id": {
            "type": "string"
          },
          "categorie": {
            "type": "string"
          },
          "noprint": {
            "type": "array",
            "items": {}
          },
          "nom": {
            "type": "string"
          },
          "weight": {
            "type": "integer"
          },
          "hidden": {
            "type": "boolean"
          },
          "suggestion": {
            "type": "boolean"
          },
          "image": {
            "$ref": "#/components/schemas/Image"
          }
        }
      },
      "Personalisation": {
        "properties": {
          "type_id": {
            "type": "string"
          },
          "produit_id": {
            "type": "string"
          },
          "nom": {
            "type": "string"
          },
          "weight": {
            "type": "integer"
          },
          "noprint": {
            "type": "array",
            "items": {}
          }
        }
      },
      "Price": {
        "properties": {
          "ttc": {
            "type": "string"
          },
          "ht": {
            "type": "string"
          }
        },
        "required": [
          "ttc",
          "ht"
        ]
      },
      "PriceCents": {
        "properties": {
          "ht": {
            "type": "integer"
          },
          "ttc": {
            "type": "integer"
          },
          "tva": {
            "type": "integer"
          }
        }
      },
      "Comment": {
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "Ingredient": {
        "properties": {
          "_id": {
            "type": "integer"
          },
          "ingredient_id": {
            "type": "string"
          },
          "custom_id": {
            "type": "string"
          },
          "nom": {
            "type": "string"
          },
          "legende": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "active": {
            "type": "integer"
          },
          "visible": {
            "type": "integer"
          },
          "supplement": {
            "type": "string"
          },
          "supplement_c": {
            "type": "integer"
          },
          "tva": {
            "type": "string"
          },
          "supplementArray": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/Price"
            }
          },
          "supplementArray_c": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/PriceCents"
            }
          },
          "tvaArray": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "weight": {
            "type": "integer"
          },
          "color": {
            "type": "string"
          },
          "noprint": {
            "type": "array",
            "items": {}
          },
          "hilite": {
            "type": "boolean"
          },
          "asproduct": {
            "type": "boolean"
          },
          "personalization_id": {
            "type": "integer"
          },
          "comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Comment"
            }
          },
          "image": {
            "$ref": "#/components/schemas/Image"
          }
        }
      },
      "Produit": {
        "properties": {
          "_id": {
            "type": "integer"
          },
          "produit_id": {
            "type": "string"
          },
          "custom_id": {
            "type": "string"
          },
          "groupe": {
            "type": "string"
          },
          "groupes_alt": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "active": {
            "type": "integer"
          },
          "visible": {
            "type": "integer"
          },
          "nom": {
            "type": "string"
          },
          "legende": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "prix": {
            "type": "string"
          },
          "prix_c": {
            "type": "integer"
          },
          "tva": {
            "type": "string"
          },
          "prixArray": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/Price"
            }
          },
          "prixArray_c": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": {
              "$ref": "#/components/schemas/PriceCents"
            }
          },
          "tvaArray": {
            "type": "array",
