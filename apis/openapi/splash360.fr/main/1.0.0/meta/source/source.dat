            }
          },
          "types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Personalisation"
            }
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ingredient"
            }
