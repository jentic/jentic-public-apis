            }
          },
          "composition": {
            "type": "array",
            "items": {}
          },
          "compo": {
            "type": "array",
            "items": {}
          },
          "weight": {
            "type": "integer"
          },
          "color": {
            "type": "string"
          },
          "noprint": {
            "type": "array",
            "items": {}
          },
          "comments": {
            "$ref": "#/components/schemas/Comment"
          },
          "image": {
            "$ref": "#/components/schemas/Image"
          }
        }
      },
      "StepRule": {
        "properties": {
          "type": {
            "type": "string"
          },
          "regle": {
            "type": "string"
          },
          "supplement": {
            "type": "string"
          },
          "supplement_c": {
            "type": "integer"
          }
        }
