          "change_sim_card_status",
          "schedule_data_status_change",
          "schedule_rate_plan_change"
        ],
        "type": "object"
      },
      "RulesActionsV2dot0Serializer": {
        "properties": {
          "changeRatePlan": {
            "description": "Name of the new rate plan to change to",
