      },
      "RatePlanTestModeV2dot1Serializer": {
        "properties": {
          "bearerServices": {
            "$ref": "#/components/schemas/SubscriptionBearerServicesV2ot0Serializer"
          },
          "servicePackId": {
            "description": "Service Pack ID (i.e., Rate Plan label)",
            "type": "string"
          },
          "supportsTestMode": {
            "description": "Indicates if the Rate Plan supports Test Mode for the SIM cards",
            "type": "boolean"
          },
          "testMode": {
            "$ref": "#/components/schemas/TestModeV2dot1Serializer"
          }
        },
        "required": [
          "bearerServices",
          "servicePackId",
          "supportsTestMode",
          "testMode"
        ],
        "type": "object"
      },
      "RatePlanV2dot0Serializer": {
        "properties": {
          "bearerServices": {
            "$ref": "#/components/schemas/SubscriptionBearerServicesV2ot0Serializer"
          },
          "servicePackId": {
            "description": "Service Pack ID (i.e., Rate Plan label)",
            "type": "string"
          }
        },
        "required": [
          "bearerServices",
          "servicePackId"
        ],
        "type": "object"
      },
      "ReportGenerateV2dot0RequestSerializer": {
        "properties": {
          "all_sim_cards": {
            "description": "Uses All SIM Cards from the organization.",
            "type": "boolean"
          },
          "billing_cycle": {
            "description": "Select the starting day of the billing cycle (e.g., 5, 20).",
            "format": "int64",
            "maximum": 31,
            "minimum": 1,
            "type": "integer"
          },
          "endDate": {
            "description": "Date format: YYYY-MM-DD HH:MM:SS",
            "format": "date-time",
            "type": "string"
          },
          "granularity": {
            "description": "Select the report granularity - Hourly (Max: 7 Days) Daily (Max: 6 Months).",
            "enum": [
              "Month",
              "Cycle",
              "Day",
              "Hour"
            ],
            "type": "string"
          },
          "iccid": {
            "description": "List of ICCIDs - each separated by a comma (e.g., iccid1,iccid2).",
            "items": {
              "properties": {},
              "type": "object"
            },
            "type": "array"
          },
          "output_format": {
            "description": "Select the output format you prefer.",
            "enum": [
              "CSV",
              "JSON"
            ],
            "type": "string"
          },
          "period": {
            "description": "The period selected ends in the current day.",
            "enum": [
              "PAST_7_DAYS",
              "PAST_14_DAYS",
              "PAST_30_DAYS",
              "PAST_3_MONTHS",
              "PAST_6_MONTHS",
              "PAST_1_YEAR"
            ],
            "type": "string"
          },
          "report_type": {
            "description": "Choose the report type",
            "enum": [
              "INVENTORY",
              "LOCATION",
              "DATA_USAGE",
              "SMS_USAGE",
              "EVENT_RULES",
              "USAGE_RULES",
              "NOTIFICATIONS"
            ],
            "type": "string"
          },
          "startDate": {
            "description": "Date format: YYYY-MM-DD HH:MM:SS",
            "format": "date-time",
            "type": "string"
          },
          "tag": {
            "description": "List of Tags - each separated by a comma (e.g., tag1,tag2).",
            "items": {
              "properties": {},
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "all_sim_cards",
          "billing_cycle",
          "endDate",
          "granularity",
          "iccid",
          "output_format",
          "period",
          "report_type",
          "startDate",
          "tag"
        ],
        "type": "object"
      },
      "RulePeriodSerializer": {
        "properties": {
          "of": {
            "description": "Fill only if period=Custom Period",
            "format": "int64",
            "type": "integer"
          },
          "period": {
            "enum": [
              "Calendar Month",
              "Billing Cycle",
              "Calendar Week",
              "Calendar Day",
              "Past 24 hours",
              "Past 7 days",
              "Past 14 days",
              "Past 30 days",
              "Custom Period",
              "Per Session",
              "Current Rate Plan"
            ],
            "type": "string"
          },
          "units": {
            "description": "Available options ['Minutes', 'Hours', 'Days']. Fill only if period=Custom Period",
            "enum": [
              1,
              60,
              1440
            ],
            "format": "int32",
            "type": "integer"
          }
        },
        "required": [
          "of",
          "period",
          "units"
        ],
        "type": "object"
      },
      "RulesActionSerializer": {
        "properties": {
          "change_data_status": {
            "enum": [
              "ACTIVATE_DATA",
              "SUSPEND_DATA"
            ],
            "type": "string"
          },
