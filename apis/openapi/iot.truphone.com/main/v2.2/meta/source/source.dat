          },
          "parentOrganization": {
            "description": "Parent Organization Name",
            "type": "string"
          },
          "phoneNumber": {
            "description": "Phone Number - To be discontinued",
            "type": "string"
          },
          "segment": {
            "description": "Segment - To be discontinued",
            "type": "string"
          },
          "vertical": {
            "description": "Vertical - To be discontinued",
            "type": "string"
          },
          "website": {
            "description": "Website - To be discontinued",
