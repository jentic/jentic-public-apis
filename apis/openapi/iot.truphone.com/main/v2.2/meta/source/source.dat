    "/api/v2.0/sims/change_data_status": {
      "post": {
        "description": "Change the Data Status for one or more SIM cards</p> <p>This endpoint is idempotent.</p>",
        "operationId": "Change_Sim_Cards_Data_Status_Request_Api_POST",
        "requestBody": {
          "content": {
