            "description": "User ID",
            "in": "query",
            "name": "id",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Organization Name",
            "in": "query",
            "name": "organization",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "First Name",
            "in": "query",
            "name": "firstName",
            "schema": {
