            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Destination",
            "in": "query",
            "name": "destination",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Location",
            "in": "query",
            "name": "location",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Country",
            "in": "query",
            "name": "country",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Network",
            "in": "query",
            "name": "network",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "enum": [
                "SMS_IN",
                "SMS_OUT",
