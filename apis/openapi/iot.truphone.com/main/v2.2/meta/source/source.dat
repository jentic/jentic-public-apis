      "WriteEventRuleConditionSerializer": {
        "properties": {
          "country_list": {
            "description": "Must be uppercase such as [\"AUSTRIA\", \"SPAIN\", ...].",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "from_device": {
            "description": "Fill only if type=New Device",
            "enum": [
              "NO_DEVICE",
              "ANY",
              "IMEI_IN"
            ],
            "type": "string"
          },
          "from_imei_prefix": {
            "description": "Prefix or full IMEI number which would trigger the rule. Fill only if from_device=IMEI_IN",
            "type": "string"
          },
          "from_sim_state": {
            "description": "Fill only if type=New SIM State",
            "enum": [
              "ANY",
              "PROVISIONED",
              "TEST",
              "PRE_ACTIVE",
              "ACTIVE",
              "SUSPENDED",
              "BLOCKED",
              "RETIRED"
            ],
            "type": "string"
          },
          "network_list": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "to_device": {
            "description": "Fill only if type=New Device",
            "enum": [
              "ANY",
              "IMEI_IN",
              "IMEI_NOT_IN"
            ],
            "type": "string"
          },
          "to_imei_prefix": {
            "description": "Prefix or full IMEI number which would trigger the rule. Fill only if to_device=IMEI_IN",
            "type": "string"
          },
          "to_sim_state": {
            "description": "Fill only if type=New SIM State",
            "enum": [
              "ANY",
              "PROVISIONED",
              "TEST",
              "PRE_ACTIVE",
              "ACTIVE",
              "SUSPENDED",
              "BLOCKED",
              "RETIRED",
              "REMOVED"
            ],
            "type": "string"
          },
          "triggers_when_location": {
            "description": "Fill only if type=New Location",
            "enum": [
              1,
              5,
              6,
              2,
              3,
              4
            ],
            "format": "int32",
            "type": "integer"
          },
          "triggers_when_session": {
            "description": "Available options ['The Session Ends', 'The Session Starts']. Fill only if type=New Data Session.",
            "enum": [
              1,
              2
            ],
            "format": "int32",
            "type": "integer"
          },
          "type": {
            "enum": [
              "New Short Message",
              "New Device",
              "New Location",
              "New Data Session",
              "New SIM State",
              "Expires From Date",
              "Expires From Rate Plan"
            ],
            "type": "string"
          }
        },
        "required": [
          "country_list",
          "from_device",
          "from_imei_prefix",
          "from_sim_state",
          "network_list",
          "to_device",
          "to_imei_prefix",
          "to_sim_state",
          "triggers_when_location",
          "triggers_when_session",
          "type"
        ],
        "type": "object"
      },
