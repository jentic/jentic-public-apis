{
  "components": {
    "parameters": {
      "IccidPath": {
        "description": "Unique SIM Card Identifier (ICCID)",
        "in": "path",
        "name": "iccid",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "IccidQuery": {
        "description": "Unique SIM Card Identifier (ICCID)",
        "in": "query",
        "name": "iccid",
        "schema": {
          "type": "string"
        }
      },
      "LabelPath": {
        "description": "Tag Label",
        "in": "path",
        "name": "label",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "PaginationPage": {
        "description": "The page to retrieve",
        "in": "query",
        "name": "page",
        "schema": {
          "oneOf": [
            {
              "default": 1,
              "format": "int32",
              "minimum": 1,
              "type": "integer"
            },
            {
              "enum": [
                "last"
              ],
              "type": "string"
            }
          ]
        }
      },
      "PaginationPerPage": {
        "description": "The maximum number of items to retrieve in a single page",
        "in": "query",
        "name": "per_page",
        "schema": {
          "default": 50,
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "responses": {
      "ResponseNoContent": {
        "description": "No Content"
      },
      "ResponseNotFound": {
        "content": {
          "application/json": {
            "examples": {
              "Not found": {
                "value": {
                  "detail": "Not found."
                }
              }
            },
            "schema": {
              "$ref": "#/components/schemas/V2dot0ResponseSerializer"
            }
          }
        },
        "description": "Not Found"
      },
      "ResponseOk": {
        "content": {
          "application/json": {
            "examples": {
              "OK": {
                "value": {
                  "detail": "OK"
                }
              }
            },
            "schema": {
              "$ref": "#/components/schemas/V2dot0ResponseSerializer"
            }
          }
        },
        "description": "Success"
      }
    },
    "schemas": {
      "ApnV2ot0Serializer": {
        "properties": {
          "description": {
            "description": "Additional information related to the APN",
            "type": "string"
          },
          "name": {
            "description": "Name of the APN assign",
            "type": "string"
          }
        },
        "required": [
          "description",
          "name"
        ],
        "type": "object"
      },
      "AttributeOnlyLabelValueV2dot0Serializer": {
        "properties": {
          "label": {
            "description": "Label",
            "type": "string"
          },
          "value": {
            "description": "Value",
            "type": "string"
          }
        },
        "required": [
          "label",
          "value"
        ],
        "type": "object"
      },
      "AttributeV2dot0Serializer": {
        "properties": {
          "label": {
            "description": "Label",
            "type": "string"
          },
          "simCard": {
            "type": "string"
          },
          "value": {
            "description": "Value",
            "type": "string"
          }
        },
        "required": [
          "label",
          "simCard",
          "value"
        ],
        "type": "object"
      },
      "AuditTrailV2dot0Serializer": {
        "properties": {
          "action": {
            "type": "string"
          },
          "date": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "interface": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "objectType": {
            "type": "string"
          },
          "user": {
            "type": "string"
          }
        },
        "required": [
          "action",
          "date",
          "description",
          "interface",
          "object",
          "objectType",
          "user"
        ],
        "type": "object"
      },
      "CallDetailRecordV2dot0Serializer": {
        "properties": {
          "country": {
            "type": "string"
          },
          "destination": {
            "format": "int64",
            "maximum": 9223372036854776000,
            "minimum": -9223372036854776000,
            "nullable": true,
            "type": "integer"
          },
          "duration": {
            "format": "int64",
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "endDate": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "network": {
            "type": "string"
          },
          "origin": {
            "format": "int64",
            "maximum": 9223372036854776000,
            "minimum": -9223372036854776000,
            "nullable": true,
            "type": "integer"
          },
          "simCard": {
            "type": "string"
          },
          "startDate": {
            "format": "date-time",
            "type": "string"
          },
          "type": {
            "enum": [
              "SMS_IN",
              "SMS_OUT",
              "DATA"
            ],
            "type": "string"
          }
        },
        "required": [
          "country",
          "destination",
          "duration",
          "endDate",
          "id",
          "network",
          "origin",
          "simCard",
          "startDate",
          "type"
        ],
        "type": "object"
      },
      "DeviceV2dot2Serializer": {
        "properties": {
          "dateFirstRegistered": {
            "description": "Date First Registered",
            "format": "date-time",
            "type": "string"
          },
          "dateLatestUpdate": {
            "description": "Date Last Registered",
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "description": "Description",
            "type": "string"
          },
          "iccid": {
            "description": "ICCID of the related SIM card",
            "type": "string"
          },
          "imei": {
            "description": "International Mobile Station Equipment Identity",
            "type": "string"
          },
          "label": {
            "description": "Label",
            "type": "string"
          },
          "organization": {
            "description": "Organization which the device belongs to",
            "type": "string"
          }
        },
        "required": [
          "dateFirstRegistered",
          "dateLatestUpdate",
          "description",
          "iccid",
          "imei",
          "label",
          "organization"
        ],
        "type": "object"
      },
      "DownloadReportV2dot0Serializer": {
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "EventRuleConditionSerializer": {
        "properties": {
          "country_list": {
            "description": "Must be uppercase such as [\"AUSTRIA\", \"SPAIN\", ...].",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "from_device": {
            "description": "Fill only if type=New Device",
            "enum": [
              "NO_DEVICE",
              "ANY",
              "IMEI_IN"
            ],
            "type": "string"
          },
          "from_imei_prefix": {
            "description": "Prefix or full IMEI number which would trigger the rule. Fill only if from_device=IMEI_IN",
            "type": "string"
          },
          "from_sim_state": {
            "description": "Fill only if type=New SIM State",
            "enum": [
              "ANY",
              "PROVISIONED",
              "TEST",
              "PRE_ACTIVE",
              "ACTIVE",
              "SUSPENDED",
              "BLOCKED",
              "RETIRED"
            ],
            "type": "string"
          },
          "network_list": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "to_device": {
            "description": "Fill only if type=New Device",
            "enum": [
              "ANY",
              "IMEI_IN",
              "IMEI_NOT_IN"
            ],
            "type": "string"
          },
          "to_imei_prefix": {
            "description": "Prefix or full IMEI number which would trigger the rule. Fill only if to_device=IMEI_IN",
            "type": "string"
          },
          "to_sim_state": {
            "description": "Fill only if type=New SIM State",
            "enum": [
              "ANY",
              "PROVISIONED",
              "TEST",
              "PRE_ACTIVE",
              "ACTIVE",
              "SUSPENDED",
              "BLOCKED",
              "RETIRED",
              "REMOVED"
            ],
            "type": "string"
          },
          "triggers_when_location": {
            "description": "Fill only if type=New Location",
            "enum": [
              1,
              5,
              6,
              2,
              3,
              4
            ],
            "format": "int32",
            "type": "integer"
          },
          "triggers_when_session": {
            "description": "Available options ['The Session Ends', 'The Session Starts']. Fill only if type=New Data Session.",
            "enum": [
              1,
              2
            ],
            "format": "int32",
            "type": "integer"
          },
          "type": {
            "enum": [
              "New Short Message",
              "New Device",
              "New Location",
              "New Data Session",
              "New SIM State",
              "Expires From Date",
              "Expires From Rate Plan"
            ],
            "type": "string"
          }
        },
        "required": [
          "country_list",
          "from_device",
          "from_imei_prefix",
          "from_sim_state",
          "network_list",
          "to_device",
          "to_imei_prefix",
          "to_sim_state",
          "triggers_when_location",
          "triggers_when_session",
          "type"
        ],
        "type": "object"
      },
      "EventRuleSerializer": {
        "properties": {
          "action": {
            "$ref": "#/components/schemas/RulesActionSerializer"
          },
          "condition": {
            "$ref": "#/components/schemas/EventRuleConditionSerializer"
          },
          "description": {
            "description": "Additional description of the rule",
            "type": "string"
          },
          "filters": {
            "$ref": "#/components/schemas/RulesFilterSerializer"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "description": "Title of the rule",
            "type": "string"
          },
          "notifications": {
            "$ref": "#/components/schemas/RulesNotificationSerializer"
          }
        },
        "required": [
          "action",
          "condition",
          "description",
          "filters",
          "id",
          "label",
          "notifications"
        ],
        "type": "object"
      },
      "LocationTagV2dot0Serializer": {
        "properties": {
          "label": {
            "description": "Name of a location",
            "type": "string"
          },
          "lat": {
            "description": "Location latitude",
            "format": "float",
            "type": "number"
          },
          "lng": {
            "description": "Location longitude",
            "format": "float",
            "type": "number"
          }
        },
        "required": [
          "label",
          "lat",
          "lng"
        ],
        "type": "object"
      },
      "LocationUpdateV2dot0Serializer": {
        "properties": {
          "country": {
            "type": "string"
          },
          "date": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "networkName": {
            "type": "string"
          },
          "simCard": {
            "type": "string"
          }
        },
        "required": [
          "country",
          "date",
          "id",
          "networkName",
          "simCard"
        ],
        "type": "object"
      },
      "NoBody": {
        "type": "object"
      },
      "NotificationV2dot0Serializer": {
        "properties": {
          "date": {
            "format": "date-time",
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "sourceType": {
            "type": "string"
          },
          "state": {
            "enum": [
              "PRE_TEST",
              "PROVISIONED",
              "PRE_ACTIVE",
              "TEST",
              "ACTIVE",
              "SUSPENDED",
              "BLOCKED",
              "UNLOCKED",
              "NOT_ALLOWED",
              "SWAPPED",
              "RETIRED",
              "SET"
            ],
            "type": "string"
          },
          "type": {
            "enum": [
              "SIM Card Updated",
              "SIM Card state update order submitted to Order Manager",
              "SIM Card state update order submission failed to Order Manager"
            ],
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "date",
          "object",
          "source",
          "sourceType",
          "state",
          "type",
          "value"
        ],
        "type": "object"
      },
      "OngoingSessionsV2dot0Serializer": {
        "properties": {
          "duration": {
            "type": "string"
          },
          "iccid": {
            "type": "string"
          },
          "ipAddress": {
            "type": "string"
          },
          "mcc": {
            "type": "string"
          },
          "mnc": {
            "type": "string"
          },
          "startDate": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "duration",
          "iccid",
          "ipAddress",
          "mcc",
          "mnc",
          "startDate"
        ],
        "type": "object"
      },
      "OrganizationV2dot0Serializer": {
        "properties": {
          "bill_cycle_start_day": {
            "description": "Bill Cycle Start Day",
            "format": "int64",
