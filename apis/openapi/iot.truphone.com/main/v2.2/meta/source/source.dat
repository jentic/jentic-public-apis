    "/api/v2.2/sims/change_sms_service": {
      "post": {
        "description": "Change the SMS (Mobile Originated or Terminated) Services for one or more SIM cards.</p>\n<p>This endpoint is idempotent.</p>",
        "operationId": "Change_Sim_Cards_Sms_Service_Request_Api_POST",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "Activate SIM SMS MO": {
                  "summary": "Activate SIM SMS MO",
                  "value": {
                    "iccid": [
                      "8944479999999999999"
                    ],
                    "sms_service": "MO",
                    "status": "ACTIVE"
                  }
                },
                "Activate SIM SMS MT": {
                  "summary": "Activate SIM SMS MT",
                  "value": {
                    "iccid": [
                      "8944479999999999999"
                    ],
                    "sms_service": "MT",
                    "status": "ACTIVE"
                  }
                },
                "Suspend SIM SMS MO": {
                  "summary": "Suspend SIM SMS MO",
                  "value": {
                    "iccid": [
                      "8944479999999999999"
                    ],
                    "sms_service": "MO",
                    "status": "SUSPENDED"
                  }
                },
                "Suspend SIM SMS MT": {
                  "summary": "Suspend SIM SMS MT",
                  "value": {
                    "iccid": [
                      "8944479999999999999"
                    ],
                    "sms_service": "MT",
                    "status": "SUSPENDED"
                  }
                }
              },
              "schema": {
                "properties": {
                  "iccid": {
                    "description": "List of strings of ICCIDs",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "sms_service": {
                    "description": "Select which SMS Service to apply the change.",
                    "enum": [
                      "MO",
                      "MT"
                    ],
                    "type": "string"
                  },
                  "status": {
                    "description": "Select the change to perform to the SMS Service",
                    "enum": [
                      "ACTIVE",
                      "SUSPENDED"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "iccid",
                  "sms_service",
                  "status"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "success": {
                    "summary": "Successful response",
                    "value": {
                      "detail": "OK"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/WriteV2dot0ResponseSerializer"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "content": {
              "application/json": {
                "examples": {
                  "bad_request": {
                    "summary": "Bad request",
                    "value": {
                      "detail": "SIM card(s) with ICCID(s) [u'89444799999999999990'] unknown"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/WriteV2dot0ResponseSerializer"
                }
              }
            },
            "description": "Bad request"
          }
        },
        "summary": "Change SMS Status",
        "tags": [
          "SIM Cards SMS Management"
        ]
      }
    },
