    "/api/v2.0/reports/download/{pk}": {
      "get": {
        "description": "Download the generated reports previously, the download link has a expired time of 1 Hour and the response comes as JSON or CSV depending on the options selected.</p>",
        "operationId": "Download_Report_V2Dot0_V2Dot0_retrieve",
        "parameters": [
          {
            "in": "path",
            "name": "pk",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "Inventory JSON": {
                    "summary": "Inventory JSON",
                    "value": [
                      {
                        "Date": "2021-10-25 08:33:20+00:00",
                        "Source": 8944480000000000000,
                        "State": "SUSPENDED"
                      },
                      {
                        "Date": "2021-11-08 13:44:45+00:00",
                        "Source": 8944478888888889000,
                        "State": "SUSPENDED"
                      },
                      {
                        "Date": "2021-11-08 14:01:05+00:00",
                        "Source": 8944480000000000000,
                        "State": "ACTIVE"
                      }
                    ]
                  }
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "content": {
              "application/json": {
                "examples": {
                  "No SIM Cards available": {
                    "summary": "No SIM Cards available",
                    "value": {
                      "detail": "No SIM Cards available - The selected SIM Cards are no longer available."
                    }
                  },
                  "Report not available": {
                    "summary": "Report not available",
                    "value": {
                      "detail": "Report not available - Link expired or wrong link."
                    }
                  },
                  "Tag not assigned": {
                    "summary": "Tag not assigned",
                    "value": {
                      "detail": "Tag 'TAG_NAME' does not have SIM cards assign. Please associate SIM Cards - Assign SIM Cards to Tag in the portal."
                    }
                  },
                  "Tag not created": {
                    "summary": "Tag not created",
                    "value": {
                      "detail": "Tag 'TAG_NAME' not created. Please create a tag and associate SIM Cards - This error appears if the selected tag was deleted in the meantime."
                    }
                  }
                },
                "schema": {
                  "properties": {
                    "detail": {
                      "description": "This is the Detail response",
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Bad request"
          }
        },
        "summary": "Download Report",
        "tags": [
          "Reports"
        ]
      }
    },
    "/api/v2.0/reports/generate": {
      "post": {
        "description": "Generate reports with the same conditions as the report session wizard in the Portal. This endpoint will generate a CSV or JSON response, depending on the options you choose, the download link is available for one hour.</p>",
        "operationId": "Report_Genarate_Api_POST",
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "DATA_USAGE": {
                  "summary": "Data usage",
                  "value": {
                    "all_sim_cards": true,
                    "granularity": "Day",
                    "output_format": "CSV",
                    "period": "PAST_7_DAYS",
                    "report_type": "DATA_USAGE"
                  }
                }
              },
              "schema": {
                "properties": {
                  "all_sim_cards": {
                    "description": "Uses All SIM Cards from the organization.",
                    "type": "boolean"
                  },
                  "billing_cycle": {
                    "description": "Select the starting day of the billing cycle (e.g., 5, 20).",
                    "format": "int64",
                    "type": "integer"
                  },
                  "endDate": {
                    "description": "Date format: YYYY-MM-DD HH:MM:SS",
                    "format": "date-time",
                    "type": "string"
                  },
                  "granularity": {
                    "description": "Select the report granularity - Hourly (Max: 7 Days) Daily (Max: 6 Months).",
                    "enum": [
                      "Month",
                      "Cycle",
                      "Day",
                      "Hour"
                    ],
                    "type": "string"
                  },
                  "iccid": {
                    "description": "List of ICCIDs - each separated by a comma (e.g., iccid1,iccid2).",
                    "items": {
                      "properties": {},
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "output_format": {
                    "description": "Select the output format you prefer.",
                    "enum": [
                      "CSV",
                      "JSON"
                    ],
                    "type": "string"
                  },
                  "period": {
                    "description": "The period selected ends in the current day.",
                    "enum": [
                      "PAST_7_DAYS",
                      "PAST_14_DAYS",
                      "PAST_30_DAYS",
                      "PAST_3_MONTHS",
                      "PAST_6_MONTHS",
                      "PAST_1_YEAR"
                    ],
                    "type": "string"
                  },
                  "report_type": {
                    "description": "Choose the report type",
                    "enum": [
                      "INVENTORY",
                      "LOCATION",
                      "DATA_USAGE",
                      "SMS_USAGE",
                      "EVENT_RULES",
                      "USAGE_RULES",
                      "NOTIFICATIONS"
                    ],
                    "type": "string"
                  },
                  "startDate": {
                    "description": "Date format: YYYY-MM-DD HH:MM:SS",
                    "format": "date-time",
                    "type": "string"
                  },
                  "tag": {
                    "description": "List of Tags - each separated by a comma (e.g., tag1,tag2).",
                    "items": {
                      "properties": {},
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "granularity",
                  "output_format",
                  "report_type"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "success": {
                    "summary": "Successful response",
                    "value": {
                      "detail": "OK",
                      "downloadUrl": "https://iot.truphone.com/api/v2.0/reports/download/012ea5b7-a6bc-4892-ac69-06f1af2ea8d5/",
                      "validUntil": "2022-01-01T00:00:00"
                    }
                  }
                },
                "schema": {
                  "properties": {
                    "detail": {
                      "description": "Detailed message",
                      "type": "string"
                    },
                    "downloadUrl": {
                      "description": "Download URL",
                      "type": "string"
                    },
                    "validUntil": {
                      "description": "Report expiration date",
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "content": {
              "application/json": {
                "examples": {
                  "Missing SIM filter": {
                    "summary": "Missing SIM filter",
                    "value": {
                      "detail": "Please select 'iccid', 'tag' or 'all_sim_cards'."
                    }
                  },
                  "Missing bill cycle": {
                    "summary": "Missing bill cycle",
                    "value": {
                      "detail": "Cannot choose 'granularity' with option 'Cycle' and no 'billing_cycle' selected. - Add the field billing_cycle - check the rate plans to know the values."
                    }
                  },
                  "Missing start or end date": {
                    "summary": "Missing start or end date",
                    "value": {
                      "detail": "Need both fields 'startDate' and 'endDate' - More then one fields startDate or endDate."
                    }
                  },
                  "Missing timeframe": {
                    "summary": "Missing timeframe",
                    "value": {
                      "detail": "Please choose a 'period' option or a 'startDate' and 'endDate'.</b>  - Missing one of the options."
                    }
                  },
                  "More than one SIM filter": {
                    "summary": "More than one SIM filter",
                    "value": {
                      "detail": "Only choose 'iccid', 'tag' or 'all_sim_cards"
                    }
                  },
                  "More than one timeframe": {
                    "summary": "More than one timeframe",
                    "value": {
                      "detail": "Cannot choose 'period' option with 'startDate' and 'endDate' options selected. - Select only one of the options."
                    }
                  },
                  "No SIM Cards in the Selected Billing Cycle": {
                    "summary": "No SIM Cards in the Selected Billing Cycle",
                    "value": {
                      "detail": "No SIM Cards in the Selected Billing Cycle. - Check the rate plan to view what day the billing cycle starts, otherwise there is no SIM Cards in that Billing Cycle."
                    }
                  },
                  "Too many SIM cards": {
                    "summary": "Too many SIM cards",
                    "value": {
                      "detail": "Too many SIM Cards. This field has TOTAL_SIMS iccid's (max: MAX_SIMS), please use less or assign tags and use them."
                    }
                  },
                  "Too many days": {
                    "summary": "Too many days",
                    "value": {
                      "detail": "Please choose 7 days or less to see the graph in a hourly basis. - Too many days for a hourly granularity."
                    }
                  },
                  "Too many months": {
                    "summary": "Too many months",
                    "value": {
                      "detail": "Please choose 6 months or less to see the graph in a daily basis. - Too many months for a daily granularity."
                    }
                  },
                  "Unassigned Tag": {
                    "summary": "Unassigned Tag",
                    "value": {
                      "detail": "Tag 'TAG_NAME' does not have SIM cards assign - Assign SIM Cards to Tag in the portal."
                    }
                  },
                  "Unknown ICCIDs": {
                    "summary": "Unknown ICCIDs",
                    "value": {
                      "detail": "One or more ICCIDs are incorrect, or do not belong to you."
                    }
                  },
                  "Unknown Tag": {
                    "summary": "Unknown Tag",
                    "value": {
                      "detail": "Tag 'TAG_NAME' not created."
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/WriteV2dot0ResponseSerializer"
                }
              }
            },
            "description": "Bad request"
          }
        },
        "summary": "Generate Reports",
        "tags": [
          "Reports"
        ]
      }
    },
