            "type": "string"
          },
          "email": {
            "description": "Email Address",
            "type": "string"
          },
          "id": {
            "description": "Organization unique identifier",
            "type": "string"
          },
          "name": {
            "description": "Organization name",
            "type": "string"
          }
        },
        "required": [
          "company_description",
          "date_created",
          "email",
          "id",
          "name"
        ],
