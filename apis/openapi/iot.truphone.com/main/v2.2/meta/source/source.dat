      },
      "RulesFilterSerializer": {
        "properties": {
          "rate_plan": {
            "description": "Rate plan name",
            "type": "string"
          },
          "sim_cards": {
            "description": "List of ICCIDs",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tags": {
            "description": "List of Tag's labels",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "rate_plan",
          "sim_cards",
          "tags"
        ],
        "type": "object"
      },
      "RulesFiltersV2dot0Serializer": {
        "properties": {
          "all": {
            "description": "True of rules applies to all the SIM cards in the account, false if applies only to selected SIM cards",
            "type": "boolean"
          },
