            "in": "query",
            "name": "lastName",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Email Address",
            "in": "query",
            "name": "email",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Earliest Date Joined",
            "in": "query",
            "name": "dateJoined_from",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Latest Date Joined",
            "in": "query",
            "name": "dateJoined_to",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserV2dot2Serializer"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Get Users",
        "tags": [
          "User Management"
        ]
      },
      "post": {
        "description": "Create a user for your organization or for one of your sub organization.</p> <p>This endpoint is idempotent.</p> <h2 id=\"error-400-bad-request\">Error 400 - Bad Request</h2> <p>This error might be returned in case of errors in the request's body. In case this occurs, the description of the error will be sent in the response body, regarding each one of the fields with errors.</p> <h2 id=\"error-403-forbidden\">Error 403 - Forbidden</h2> <p>This error is returned in case you don't have permission to, either:</p> <pre><code>- Create users with the Role you provided. - Create users for an organization you don't have access to. </code></pre>",
        "operationId": "User_V2Dot2_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": {
                    "description": "Email Address",
                    "type": "string"
                  },
                  "firstName": {
                    "description": "First Name",
                    "type": "string"
                  },
                  "lastName": {
                    "description": "Last Name",
                    "type": "string"
                  },
                  "organization": {
                    "description": "Organization Name",
                    "type": "string"
                  },
                  "password": {
                    "description": "User's password",
                    "type": "string"
                  },
                  "role": {
                    "description": "User's role in the organization",
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "organization",
                  "password",
                  "role"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoBody"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Create User",
        "tags": [
          "User Management"
        ]
      }
    },
    "/api/v2.2/users/{id}": {
      "delete": {
        "description": "Delete a user corresponding to the given ID.</p> <h2 id=\"error-403-forbidden\">Error 403 - Forbidden</h2> <p>This error is returned in case you don't have permission to, either:</p> <pre><code>- Access the user's organization. - Delete users of the user's current role. </code></pre>",
        "operationId": "User_V2Dot2_destroy",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoBody"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Delete User",
        "tags": [
          "User Management"
        ]
      },
      "get": {
        "description": "Access the details of a specific user of an organization.</p> <h2 id=\"error-404-not-found\">Error 404 - Not Found</h2> <p>This error will be returned in case there is no user with the selected key.</p>",
        "operationId": "User_V2Dot2_retrieve",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserV2dot2Serializer"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Get User details",
        "tags": [
          "User Management"
        ]
      },
      "patch": {
        "description": "Updates a specific user of an organization. This operation only affects the user identified in the URL of the request.</p> <p>This endpoint is idempotent.</p> <p>To unset a value associated to an attribute, please provide an empty value in the body of the request. For example: {\"firstName\": \"\"}</p> <h2 id=\"error-400-bad-request\">Error 400 - Bad Request</h2> <p>This error might be returned in case of errors in the request's body. In case this occurs, the description of the error will be sent in the response body, regarding each one of the fields with errors.</p> <h2 id=\"error-403-forbidden\">Error 403 - Forbidden</h2> <p>This error is returned in case you don't have permission to, either:</p> <pre><code>- Create users of the Role you want to update the user to. - Move the user to an organization you don't have access to. - Update users of the user's current role. - Access user's current organization. </code></pre>",
        "operationId": "User_V2Dot2_update",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "email": {
                    "description": "Email Address",
                    "type": "string"
                  },
                  "firstName": {
                    "description": "First Name",
                    "type": "string"
                  },
                  "lastName": {
                    "description": "Last Name",
                    "type": "string"
                  },
                  "organization": {
                    "description": "Organization Name",
                    "type": "string"
                  },
                  "role": {
                    "description": "User's role in the organization",
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoBody"
                }
              }
            },
            "description": "Success"
          }
        },
        "summary": "Modify User",
        "tags": [
          "User Management"
        ]
      }
    }
