{
  "openapi": "3.0.3",
  "info": {
    "title": "Magic: The Gathering API",
    "version": "1.0",
    "description": "The Magic: The Gathering API provides access to MTG card data, sets, and game formats. Free to use with no authentication required. Rate limited to 5000 requests per hour.",
    "contact": {
      "url": "https://magicthegathering.io"
    },
    "x-jentic-source-url": "https://docs.magicthegathering.io/",
    "x-no-auth-reason": "Genuinely public API with no authentication required. Rate limited to 5000 requests/hour by IP."
  },
  "servers": [
    {
      "url": "https://api.magicthegathering.io/v1",
      "description": "MTG API v1"
    }
  ],
  "paths": {
    "/cards": {
      "get": {
        "summary": "Get All Cards",
        "operationId": "getCards",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "colors",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rarity",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "set",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "orderBy",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "random",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cards list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cards": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "manaCost": {
                            "type": "string"
                          },
                          "cmc": {
                            "type": "number"
                          },
                          "colors": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "type": {
                            "type": "string"
                          },
                          "rarity": {
                            "type": "string"
                          },
                          "set": {
                            "type": "string"
                          },
                          "setName": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string"
                          },
                          "artist": {
                            "type": "string"
                          },
                          "power": {
                            "type": "string"
                          },
                          "toughness": {
                            "type": "string"
                          },
                          "imageUrl": {
                            "type": "string"
                          },
                          "multiverseid": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cards/{id}": {
      "get": {
        "summary": "Get Card by ID",
        "operationId": "getCardById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Card details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "card": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sets": {
      "get": {
        "summary": "Get All Sets",
        "operationId": "getSets",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "block",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sets list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "releaseDate": {
                            "type": "string"
                          },
                          "block": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sets/{id}": {
      "get": {
        "summary": "Get Set by Code",
        "operationId": "getSetByCode",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Set details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "set": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sets/{id}/booster": {
      "get": {
        "summary": "Generate Booster Pack",
        "operationId": "generateBooster",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Booster pack",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cards": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/types": {
      "get": {
        "summary": "Get Card Types",
        "operationId": "getTypes",
        "responses": {
          "200": {
            "description": "Types",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "types": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/subtypes": {
      "get": {
        "summary": "Get Card Subtypes",
        "operationId": "getSubtypes",
        "responses": {
          "200": {
            "description": "Subtypes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "subtypes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/supertypes": {
      "get": {
        "summary": "Get Card Supertypes",
        "operationId": "getSupertypes",
        "responses": {
          "200": {
            "description": "Supertypes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "supertypes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/formats": {
      "get": {
        "summary": "Get Game Formats",
        "operationId": "getFormats",
        "responses": {
          "200": {
            "description": "Formats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "formats": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": []
}
