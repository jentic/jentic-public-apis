  "components": {
    "schemas": {
      "Authorization": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "InstallDccfHanCustomerBuild": {
        "type": "object",
        "properties": {
          "ticketNumber": {
            "type": "string",
            "example": "CA12345"
          },
          "dataCenter": {
            "type": "string",
            "example": "se2"
          },
          "siteId": {
            "type": "string",
            "example": "s123456"
          },
          "numberOfServersToBuildNetworkFor": {
            "type": "integer",
            "example": 4
          },
          "primarySwitch": {
            "type": "string",
            "example": "dccf-dtst201.se2"
          },
          "secondarySwitch": {
            "type": "string",
            "example": "dccf-dtst202.se2"
          },
          "ipSubnetValidation": {
            "type": "boolean",
            "example": false
          },
          "internetVlan": {
            "type": "integer",
            "example": 100
          },
          "internetNetwork": {
            "type": "string",
            "example": "10.26.1.0"
          },
          "internetCidr": {
            "type": "string",
            "example": "28"
          },
          "vMotionVlan": {
            "type": "integer",
            "example": 200
          },
          "vMotionNetwork": {
            "type": "string",
            "example": "10.26.2.0"
          },
          "vMotionCidr": {
            "type": "string",
            "example": "26"
          },
          "vXlanVlan": {
            "type": "integer",
            "example": 300
          },
          "vXlanNetwork": {
            "type": "string",
            "example": "10.26.3.0"
          },
          "vXlanCidr": {
            "type": "string",
            "example": "26"
          },
          "vSanVlan": {
            "type": "integer",
            "example": 400
          },
          "vSanNetwork": {
            "type": "string",
            "example": "10.26.4.0"
          },
          "vSanCidr": {
            "type": "string",
            "example": "26"
          },
          "mgmtVlan": {
            "type": "integer",
            "example": 500
          },
          "mgmtNetwork": {
            "type": "string",
            "example": "10.26.5.0"
          },
          "mgmtCidr": {
            "type": "string",
            "example": "26"
          }
        }
      },
      "Mop": {
        "type": "object",
        "properties": {
          "team": {
            "type": "string",
            "example": "HSIE"
          },
          "ticketNumber": {
            "type": "string",
            "example": "CRQ12345"
          },
          "preCommunication": {
            "type": "string",
            "example": "Baby Yoda +1 (555) 555-5555 byoda@centurylink.com"
          },
          "devices": {
            "type": "array",
            "items": {
              "example": [
                "dtc1.sl7",
                "msslab-la1-asa-3-pri",
                "apic1.sl7"
              ]
            }
          },
          "preCheck": {
            "type": "array",
            "items": {
              "example": [
                "show clock",
                "show version",
                "show interface description | i LukeSkywalker",
                "show interface LukeSkywalker"
              ]
            }
          },
          "execution": {
            "type": "array",
            "items": {
              "example": [
                "configure terminal",
                "interface LukeSkywalker",
                "description Luke is a Jedi"
              ]
            }
          },
          "postCheck": {
            "type": "array",
            "items": {
              "example": [
                "show interface description | i LukeSkywalker",
                "show interface LukeSkywalker"
              ]
            }
          },
          "finalCommunication": {
            "type": "string",
            "example": "Baby Yoda +1 (555) 555-5555 byoda@centurylink.com"
          },
          "rollback": {
            "type": "array",
            "items": {
              "example": [
                "configure terminal",
                "interface LukeSkywalker",
                "description Available"
              ]
            }
          }
        }
      },
      "CiscoNexusCliShowCommand": {
        "type": "object",
        "properties": {
