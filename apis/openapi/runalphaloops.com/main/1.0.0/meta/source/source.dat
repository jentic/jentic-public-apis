{
  "openapi": "3.1.0",
  "info": {
    "title": "AlphaLoops FMCSA Carrier Data API",
    "version": "1.0.0",
    "description": "Fleet intelligence API for looking up FMCSA-registered carriers by DOT number, MC number, or company name. Access carrier profiles with 200+ fields, safety data, authority history, fleet equipment, inspections, crashes, news, and decision-maker contacts.\n\nBase URL: https://api.runalphaloops.com\n\nAPI access is available exclusively on the Enterprise plan. Contact sales at https://runalphaloops.com/contact to get your API key.",
    "contact": {
      "name": "AlphaLoops",
      "url": "https://runalphaloops.com/contact",
      "email": "hello@runalphaloop.com"
    }
  },
  "servers": [
    {
      "url": "https://api.runalphaloops.com",
      "description": "Production"
    }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/v1/carriers/{dot_number}": {
      "get": {
        "operationId": "getCarrierByDot",
        "summary": "Look up a carrier by DOT number",
        "description": "Returns the full carrier profile with 200+ fields including identity, authority, safety, fleet, technology stack, and contacts. Use the fields parameter to project only the fields you need.",
        "parameters": [
          {
            "name": "dot_number",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The carrier's USDOT number"
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Comma-separated list of fields to return (e.g. \"legal_name,power_units,latitude,longitude\"). Omit to return all fields."
          }
        ],
        "responses": {
          "200": {
            "description": "Full carrier profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CarrierProfile" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/mc/{mc_number}": {
      "get": {
        "operationId": "getCarrierByMc",
        "summary": "Look up a carrier by MC/MX docket number",
        "description": "Returns the full carrier profile (same fields as the DOT lookup). Supports the same ?fields= projection parameter.",
        "parameters": [
          {
            "name": "mc_number",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The carrier's MC or MX docket number"
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Comma-separated list of fields to return. Omit to return all fields."
          }
        ],
        "responses": {
          "200": {
            "description": "Full carrier profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CarrierProfile" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/search": {
      "get": {
        "operationId": "searchCarriers",
        "summary": "Match a company to a carrier by name",
        "description": "Match a company to a carrier by name, domain, state, and city. Returns ranked results with a confidence score. At minimum, company_name is required.",
        "parameters": [
          {
            "name": "company_name",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Company name to match against (fuzzy matching)"
          },
          {
            "name": "domain",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Company website domain (e.g. \"swifttrans.com\") — improves match accuracy"
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "State abbreviation (e.g. \"TX\", \"CA\")"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "City name (e.g. \"Phoenix\", \"Dallas\")"
          },
          { "$ref": "#/components/parameters/page" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 10, "maximum": 50 },
            "description": "Results per page (default: 10, max: 50)"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated search results with confidence scores",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CarrierSearchResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/authority": {
      "get": {
        "operationId": "getCarrierAuthority",
        "summary": "Get carrier operating authority history",
        "description": "Returns all authority actions including grants, revocations, and reinstatements.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" },
          { "$ref": "#/components/parameters/limit" },
          { "$ref": "#/components/parameters/offset" }
        ],
        "responses": {
          "200": {
            "description": "Authority history records",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthorityResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/trucks": {
      "get": {
        "operationId": "getCarrierTrucks",
        "summary": "Get carrier truck (power unit) fleet",
        "description": "Returns the carrier's registered truck fleet. Includes VIN, make, model, engine specs, weight, and manufacturing details.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50, "maximum": 200 },
            "description": "Results per page (default: 50, max: 200)"
          },
          { "$ref": "#/components/parameters/offset" }
        ],
        "responses": {
          "200": {
            "description": "Paginated truck fleet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TrucksResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/trailers": {
      "get": {
        "operationId": "getCarrierTrailers",
        "summary": "Get carrier trailer fleet",
        "description": "Returns the carrier's registered trailer fleet. Includes VIN, manufacturer, type, and reefer status.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50, "maximum": 200 },
            "description": "Results per page (default: 50, max: 200)"
          },
          { "$ref": "#/components/parameters/offset" }
        ],
        "responses": {
          "200": {
            "description": "Paginated trailer fleet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TrailersResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/inspections": {
      "get": {
        "operationId": "getCarrierInspections",
        "summary": "Get carrier inspection history",
        "description": "Returns roadside inspection history with metadata and out-of-service counts. Use /v1/inspections/{inspection_id}/violations to get violation details for a specific inspection.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50, "maximum": 200 },
            "description": "Results per page (default: 50, max: 200)"
          },
          { "$ref": "#/components/parameters/offset" }
        ],
        "responses": {
          "200": {
            "description": "Paginated inspection records",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InspectionsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/inspections/{inspection_id}/violations": {
      "get": {
        "operationId": "getInspectionViolations",
        "summary": "Get violations for a specific inspection",
        "description": "Retrieve all violations from a specific roadside inspection. Use the inspection report number returned from the Inspections endpoint.",
        "parameters": [
          {
            "name": "inspection_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The inspection report number"
          },
          { "$ref": "#/components/parameters/page" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 25, "maximum": 100 },
            "description": "Results per page (default: 25, max: 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated violation records",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ViolationsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/crashes": {
      "get": {
        "operationId": "getCarrierCrashes",
        "summary": "Get carrier crash history",
        "description": "Returns reported crash history with details, severity, and contributing factors.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Filter from date (ISO 8601, e.g. \"2024-01-01\")"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Filter to date (ISO 8601, e.g. \"2024-12-31\")"
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["FATAL", "INJURY", "TOW", "PROPERTY_DAMAGE"] },
            "description": "Filter by severity"
          },
          { "$ref": "#/components/parameters/page" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 25, "maximum": 100 },
            "description": "Results per page (default: 25, max: 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated crash records",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CrashesResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/news": {
      "get": {
        "operationId": "getCarrierNews",
        "summary": "Get carrier news and press mentions",
        "description": "Returns recent news articles and press mentions related to the carrier.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Filter from date (ISO 8601)"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Filter to date (ISO 8601)"
          },
          { "$ref": "#/components/parameters/page" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 25, "maximum": 100 },
            "description": "Results per page (default: 25, max: 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated news articles",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NewsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/contacts/search": {
      "get": {
        "operationId": "searchContacts",
        "summary": "Find people at a carrier company",
        "description": "Returns professional profiles including name, title, seniority, social profiles, and industry. Use dot_number or company_name to search. Note: This endpoint may return HTTP 202 with a Retry-After header if contacts are still being fetched — retry after the specified delay.",
        "parameters": [
          {
            "name": "dot_number",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "The carrier's USDOT number"
          },
          {
            "name": "company_name",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Company name to search (required if dot_number not provided)"
          },
          {
            "name": "job_title",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by job title keyword (e.g. \"safety\", \"operations\")"
          },
          {
            "name": "job_title_levels",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["vp", "director", "manager", "c_suite"] },
            "description": "Filter by seniority level"
          },
          { "$ref": "#/components/parameters/page" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 25, "maximum": 100 },
            "description": "Results per page (default: 25, max: 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated contact results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ContactSearchResponse" }
              }
            }
          },
          "202": {
            "description": "Contacts are being fetched asynchronously. Retry after the delay specified in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "schema": { "type": "integer" },
                "description": "Seconds to wait before retrying"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "pending" },
                    "dot_number": { "type": "string" },
                    "message": { "type": "string" },
                    "retry_after": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/contacts/{contact_id}/enrich": {
      "get": {
        "operationId": "enrichContact",
        "summary": "Enrich a contact profile",
        "description": "Returns verified emails, phone numbers, skills, full work history, education, and social profiles. Consumes 1 enrichment credit per new lookup (cached results are free). Returns HTTP 402 when credits are exhausted.",
        "parameters": [
          {
            "name": "contact_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The contact ID returned from /v1/contacts/search"
          }
        ],
        "responses": {
          "200": {
            "description": "Enriched contact profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EnrichedContact" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "402": {
            "description": "Enrichment credits exhausted",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/query": {
      "post": {
        "operationId": "queryCarriers",
        "summary": "Advanced filtered carrier search",
        "description": "Filtered search with include/exclude conditions, geo-radius search, sorting, and field projection. No company name required — filter by state, fleet size, cargo type, technology, authority status, revenue, and more.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CarrierQueryRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paginated, optionally field-projected carrier results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CarrierQueryResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/insurance": {
      "get": {
        "operationId": "getCarrierInsurance",
        "summary": "Get carrier insurance filings",
        "description": "Retrieve insurance filings (BIPD, cargo, bond) for a carrier from the FMCSA insurance table. Includes policy numbers, coverage limits, and insurer details.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50, "maximum": 500 },
            "description": "Results per page (default: 50, max: 500)"
          },
          { "$ref": "#/components/parameters/page" },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["effective_date", "insurance_type_code", "bipd_maximum_dollar_limit", "insurance_company_name"], "default": "effective_date" },
            "description": "Sort field"
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" },
            "description": "Sort direction"
          },
          {
            "name": "insurance_type",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by insurance type code (e.g. BIPD, CARGO, BOND)"
          },
          {
            "name": "insurer",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Partial match on insurance company name"
          },
          {
            "name": "min_coverage",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "Minimum BIPD dollar limit"
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Effective date start (ISO date)"
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Effective date end (ISO date)"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated insurance filings",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InsuranceResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/mc/{mc_number}/insurance": {
      "get": {
        "operationId": "getCarrierInsuranceByMc",
        "summary": "Get carrier insurance filings by MC number",
        "description": "Retrieve insurance filings by MC docket number. Same response shape and filters as the DOT-based insurance endpoint.",
        "parameters": [
          {
            "name": "mc_number",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "MC docket number (numeric)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50, "maximum": 500 },
            "description": "Results per page (default: 50, max: 500)"
          },
          { "$ref": "#/components/parameters/page" },
          {
            "name": "sort_by",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["effective_date", "insurance_type_code", "bipd_maximum_dollar_limit", "insurance_company_name"], "default": "effective_date" },
            "description": "Sort field"
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" },
            "description": "Sort direction"
          },
          {
            "name": "insurance_type",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by insurance type code"
          },
          {
            "name": "insurer",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Partial match on insurance company name"
          },
          {
            "name": "min_coverage",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" },
            "description": "Minimum BIPD dollar limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated insurance filings",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InsuranceResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/timeline": {
      "get": {
        "operationId": "getCarrierTimeline",
        "summary": "Get carrier change-event and authority timeline",
        "description": "Merged chronological feed of carrier change events and authority history. Combines field-level changes from monthly FMCSA census diffs (contact, address, fleet, operations, authority, people) with authority history records.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50, "maximum": 200 },
            "description": "Max results (default: 50, max: 200)"
          },
          { "$ref": "#/components/parameters/offset" },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Comma-separated categories: contact, address, fleet, operations, authority, people"
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "Start date (ISO date)"
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date" },
            "description": "End date (ISO date)"
          }
        ],
        "responses": {
          "200": {
            "description": "Merged timeline of change events and authority actions",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TimelineResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/mc-sales": {
      "get": {
        "operationId": "getCarrierMcSales",
        "summary": "Get authority-for-sale listings for a carrier",
        "description": "Returns any authority-for-sale listings (Facebook groups, Telegram channels, BizBuySell, etc.) linked to this carrier's DOT number, with seller info, asking prices, post URLs, and matching reasoning. Returns found: false with mc_sale: null when no listings are linked.",
        "parameters": [
          {
            "name": "dot_number",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "The carrier's USDOT number"
          }
        ],
        "responses": {
          "200": {
            "description": "Authority-for-sale listings, or a found: false sentinel when none are linked",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/McSalesResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/equipment-for-sale": {
      "get": {
        "operationId": "getCarrierEquipmentForSale",
        "summary": "Get carrier fleet VINs listed for sale",
        "description": "Cross-references the VINs this carrier has been inspected with against a marketplace dataset of trucks and trailers currently (or recently) listed for sale. Returns one row per matching VIN, sorted by most recent inspection date. Empty results are common.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 25, "maximum": 200 },
            "description": "Results per page (default: 25, max: 200)"
          },
          { "$ref": "#/components/parameters/page" }
        ],
        "responses": {
          "200": {
            "description": "Paginated equipment-marketplace matches",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EquipmentForSaleResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/connections": {
      "get": {
        "operationId": "getCarrierConnections",
        "summary": "Get a carrier's relationship graph",
        "description": "Retrieve a carrier's corporate connections graph — shared officers, addresses, phones, emails, and equipment linking it to other carriers.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50, "maximum": 200 },
            "description": "Max results (default: 50, max: 200)"
          }
        ],
        "responses": {
          "200": {
            "description": "Connection graph nodes and edges",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ConnectionsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/risk-signals": {
      "get": {
        "operationId": "getCarrierRiskSignals",
        "summary": "Get aggregated carrier risk signals",
        "description": "Aggregated carrier risk assessment in a single call. Returns an AI-generated risk score (0-10) and level, plus six signal categories — authority-for-sale listings, equipment-for-sale marketplace matches, financial-distress indicators, fraud/chameleon patterns, historical authority/insurance/change-event patterns, and recent news sentiment. Each category carries a derived level of \"high\", \"medium\", \"clear\", or \"unknown\". The risk summary is cached; pass force_refresh=true to force regeneration.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" },
          {
            "name": "force_refresh",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean", "default": false },
            "description": "Set to true to bypass the cached risk summary and regenerate it from current signals (slower)."
          },
          {
            "name": "include_equipment",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean", "default": true },
            "description": "Set to false to skip the equipment-marketplace VIN lookup for a faster response."
          }
        ],
        "responses": {
          "200": {
            "description": "Scored risk header plus six derived signal categories",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RiskSignalsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/similar": {
      "get": {
        "operationId": "getSimilarCarriers",
        "summary": "Find carriers similar to a given carrier",
        "description": "Find carriers similar to the specified carrier based on fleet size, location, cargo type, and other attributes.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 20, "maximum": 100 },
            "description": "Max results (default: 20, max: 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked list of similar carriers",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SimilarResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/overview": {
      "get": {
        "operationId": "getCarrierOverview",
        "summary": "Get an AI-generated carrier overview",
        "description": "Returns an AI-generated summary overview of a carrier including key highlights.",
        "parameters": [
          { "$ref": "#/components/parameters/dotNumber" }
        ],
        "responses": {
          "200": {
            "description": "AI-generated overview and highlights",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OverviewResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/inspections/vin/{vin}": {
      "get": {
        "operationId": "getVinInspectionHistory",
        "summary": "Get inspection history for a VIN",
        "description": "Look up the inspection history for a VIN. Returns the unique DOT numbers the VIN has been associated with (with last date seen on each), plus the unique FIPS-coded county locations where the VIN has been inspected. Capped at the 5,000 most-recent inspections; successful responses are edge-cached for 24h.",
        "parameters": [
          {
            "name": "vin",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Vehicle Identification Number (case-insensitive — normalized to uppercase server-side)"
          }
        ],
        "responses": {
          "200": {
            "description": "VIN inspection history aggregated by DOT and location",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VinInspectionResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/vins": {
      "get": {
        "operationId": "lookupVins",
        "summary": "Look up one or more VINs",
        "description": "For each VIN, returns its FMCSA inspection-unit history, most recent sighting, every DOT it has been associated with, and whether it has ever been listed for sale. Accepts a single VIN or a comma-separated list via query params. Max 100 VINs per request; results preserve input order and include misses (found: false).",
        "parameters": [
          {
            "name": "vin",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "A single VIN to look up (e.g. ?vin=3AKJHHDR3RSUV5213). Case-insensitive."
          },
          {
            "name": "vins",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Comma-separated list of VINs (e.g. ?vins=VIN1,VIN2,VIN3). Max 100."
          }
        ],
        "responses": {
          "200": {
            "description": "Per-VIN lookup results in input order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VinsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "post": {
        "operationId": "lookupVinsBatch",
        "summary": "Batch look up VINs",
        "description": "Batch form of the VIN lookup. Send a JSON array of VINs in the request body. Max 100 VINs per request; results preserve input order and include misses (found: false).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "vins": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Array of VINs to look up (max 100)"
                  }
                },
                "required": ["vins"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-VIN lookup results in input order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VinsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/custom-data/fields": {
      "get": {
        "operationId": "getCustomDataFields",
        "summary": "Discover custom data availability and schema",
        "description": "Whether custom data is enabled for the calling account, and the schema of the exposed fields. Safe capability probe: a key without custom data receives 200 with custom_data_enabled: false, never 403. Call this before using the custom-data endpoints.",
        "responses": {
          "200": {
            "description": "Capability flag and field schema",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CustomDataFieldsResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/CustomDataMisconfigured" }
        }
      }
    },
    "/v1/custom-data": {
      "get": {
        "operationId": "listCustomData",
        "summary": "List custom-data records",
        "description": "Paginated collection of the account’s custom-data records. Page mode for browsing; cursor (keyset) mode — required for full exports — forces dot_number ascending order (lexicographic; dot_number is a string). Use updated_after for incremental sync after an initial export. Full exports typically exceed the default daily quota; contact support to arrange a limit increase first.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 100, "maximum": 1000 }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 },
            "description": "1-based. Mutually exclusive with cursor (400 if both are sent)."
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Opaque next_cursor from a previous response. Follow until has_more is false."
          },
          {
            "name": "dot_number",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Comma-separated list of up to 50 DOT numbers (each 1-8 digits); use POST /v1/custom-data/lookup for larger batches"
          },
          {
            "name": "updated_after",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" },
            "description": "ISO-8601; records loaded on/after"
          },
          {
            "name": "updated_before",
            "in": "query",
            "schema": { "type": "string", "format": "date-time" },
            "description": "ISO-8601; date-only values include the whole day"
          },
          {
            "name": "sort_by",
            "in": "query",
            "schema": { "type": "string", "enum": ["updated_at", "dot_number"], "default": "updated_at" },
            "description": "Ignored in cursor mode; other values return 400"
          },
          {
            "name": "sort_order",
            "in": "query",
            "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
          }
        ],
        "responses": {
          "200": {
            "description": "Records with page- or cursor-mode pagination",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CustomDataCollectionResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/CustomDataNotEnabled" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/CustomDataMisconfigured" }
        }
      }
    },
    "/v1/carriers/{dot_number}/custom-data": {
      "get": {
        "operationId": "getCarrierCustomData",
        "summary": "Get custom data for a carrier",
        "description": "The account’s custom-data record for one carrier. A miss returns 200 with found: false, never 404. Leading-zero requests are retried with zeros stripped (one direction only); the response echoes the requested dot_number.",
        "parameters": [
          {
            "name": "dot_number",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d{1,8}$" },
            "description": "The carrier’s USDOT number"
          }
        ],
        "responses": {
          "200": {
            "description": "Record, or a found: false sentinel",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CustomDataCarrierResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/CustomDataNotEnabled" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/CustomDataMisconfigured" }
        }
      }
    },
    "/v1/custom-data/lookup": {
      "post": {
        "operationId": "lookupCustomData",
        "summary": "Batch custom-data lookup",
        "description": "Custom-data records for up to 500 DOT numbers in one call. Records come back under the requested DOT number; misses are listed in missing_dot_numbers. Optional fields projection narrows the returned custom_data keys.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CustomDataLookupRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Batch results with found/missing partition",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CustomDataLookupResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/CustomDataNotEnabled" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/CustomDataMisconfigured" }
        }
      }
    },
    "/v1/peer-groups": {
      "get": {
        "operationId": "listPeerGroups",
        "summary": "List safety-benchmark peer lenses",
        "description": "The 33 peer framings accepted by the peer_group parameter: industry, 7 single axes, 21 axis pairs, and the 4 canonical scoring groups the fixed grade is computed against. Static metadata — call once to build a lens picker.",
        "responses": {
          "200": {
            "description": "All peer-group definitions plus the reliability threshold",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/PeerGroupsResponse" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/safety-benchmark": {
      "get": {
        "operationId": "getCarrierSafetyBenchmark",
        "summary": "Get a carrier’s safety benchmark",
        "description": "A carrier’s safety standing: a FIXED overall score and letter grade (computed once against the canonical peer model — it never changes with the lens) plus a peer comparison re-framed against whichever peer_group you pick. Percentiles are always oriented so 100 is best. Check peer_group.reliable before presenting comparisons; thin buckets (n < 384) are returned flagged, never hidden. Data refreshes weekly (as_of). 404 no_benchmark means the carrier has no inspection history, not an invalid DOT.",
        "parameters": [
          {
            "name": "dot_number",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d+$" },
            "description": "The carrier’s USDOT number"
          },
          {
            "name": "peer_group",
            "in": "query",
            "schema": { "type": "string", "default": "industry" },
            "description": "Comparison lens — any group_type from GET /v1/peer-groups (33 lenses). Unknown values return 400."
          },
          {
            "name": "include",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Comma-separated subset of: overall, categories, metrics, violations, flags (default: all five)"
          },
          {
            "name": "peer_key",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Advanced: compare against a specific peer bucket (e.g. \"2-5 Trucks | Local\") instead of the carrier’s own"
          },
          {
            "name": "violations_limit",
            "in": "query",
            "schema": { "type": "integer", "default": 25, "maximum": 100 },
            "description": "Max inline violation rows; page the /violations sub-resource for the full list"
          }
        ],
        "responses": {
          "200": {
            "description": "Fixed standing plus the requested sections framed by the chosen lens",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SafetyBenchmarkResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Carrier has no inspections and therefore no safety benchmark",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": {
                  "error": "no_benchmark",
                  "message": "carrier has no inspections and therefore no safety benchmark"
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/carriers/{dot_number}/safety-benchmark/violations": {
      "get": {
        "operationId": "getCarrierSafetyBenchmarkViolations",
        "summary": "Page a carrier’s benchmark violations",
        "description": "The violations section of the safety benchmark on its own, paginated. Same peer framing and row shape as the parent endpoint, sorted worst over-index first.",
        "parameters": [
          {
            "name": "dot_number",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d+$" },
            "description": "The carrier’s USDOT number"
          },
          {
            "name": "peer_group",
            "in": "query",
            "schema": { "type": "string", "default": "industry" },
            "description": "Comparison lens — any group_type from GET /v1/peer-groups (33 lenses). Unknown values return 400."
          },
          {
            "name": "peer_key",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Advanced: compare against a specific peer bucket (e.g. \"2-5 Trucks | Local\") instead of the carrier’s own"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 25, "maximum": 100 }
          },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } }
        ],
        "responses": {
          "200": {
            "description": "One page of violation standings",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SafetyBenchmarkViolationsPage" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": {
            "description": "Carrier has no safety benchmark",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/mc-sales": {
      "get": {
        "operationId": "listMcSales",
        "summary": "List carrier-resolved authority-for-sale records",
        "description": "Paginated collection of every carrier-resolved authority-for-sale record (one row per DOT), same row shape as /v1/carriers/{dot_number}/mc-sales. Built for bulk export and incremental sync: pass updated_after with sort_by=updated_at&sort_order=asc to sync changes since your last pull.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 25, "maximum": 100 }
          },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          {
            "name": "sort_by",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["updated_at", "created_at", "max_confidence", "occurrence_count"],
              "default": "updated_at"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
          },
          {
            "name": "created_after",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "ISO-8601 — records first seen on/after (date-only \"before\" values include the whole day)"
            }
          },
          {
            "name": "created_before",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "ISO-8601 — records first seen on/before (date-only \"before\" values include the whole day)"
            }
          },
          {
            "name": "updated_after",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "ISO-8601 — records changed on/after (date-only \"before\" values include the whole day)"
            }
          },
          {
            "name": "updated_before",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "ISO-8601 — records changed on/before (date-only \"before\" values include the whole day)"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": { "type": "string" },
            "description": "2-letter carrier state"
          },
          {
            "name": "min_confidence",
            "in": "query",
            "schema": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of resolved records",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/McSalesCollectionResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/mc-sale-listings": {
      "get": {
        "operationId": "listMcSaleListings",
        "summary": "Raw authority-for-sale listings feed",
        "description": "Cursor-paginated feed of raw listings across all monitored sale channels and marketplaces, independent of carrier resolution. Ordered posted-at descending; follow next_cursor until has_more is false. Offset/page params return 400.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 25, "maximum": 100 }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Opaque next_cursor from a previous response"
          },
          {
            "name": "source",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Comma-separated subset of: facebook_group, facebook_page, telegram, mcxchange, bizbuysell"
          },
          {
            "name": "posted_after",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "ISO-8601 — posts on/after (date-only \"before\" values include the whole day)"
            }
          },
          {
            "name": "posted_before",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "ISO-8601 — posts on/before (date-only \"before\" values include the whole day)"
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": { "type": "string" },
            "description": "2-letter authority state extracted from the post"
          },
          {
            "name": "min_price",
            "in": "query",
            "schema": { "type": "number" },
            "description": "Only listings with a parsed price >= this (parsed prices are bounded $1-$1M)"
          },
          { "name": "max_price", "in": "query", "schema": { "type": "number" } },
          {
            "name": "amazon_status",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Live | Suspended | Not Applicable — sources without Amazon metadata are excluded when set"
          },
          { "name": "highway_setup", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": {
            "description": "One page of the raw listings feed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/McSaleListingsFeedResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key provided by AlphaLoops. Include as: Authorization: Bearer YOUR_API_KEY"
      }
    },
    "parameters": {
      "dotNumber": {
        "name": "dot_number",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "The carrier's USDOT number"
      },
      "page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "default": 1 },
        "description": "Page number (default: 1)"
      },
      "limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "default": 50 },
        "description": "Results per page (default: 50)"
      },
      "offset": {
        "name": "offset",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "default": 0 },
        "description": "Number of results to skip (default: 0)"
      }
    },
    "responses": {
      "CustomDataNotEnabled": {
        "description": "Custom data is not enabled for this account. Not an auth failure and not transient — do not retry with backoff; probe GET /v1/custom-data/fields instead.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": {
              "error": "Custom data not enabled",
              "message": "Your account does not have custom data configured. Call GET /v1/custom-data/fields to check availability or contact support to enable it."
            }
          }
        }
      },
      "CustomDataMisconfigured": {
        "description": "The account’s custom data configuration is invalid. Contact support; retrying will not help.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": {
              "error": "Custom data misconfigured",
              "message": "Your custom data configuration is invalid. Contact support."
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid parameters",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Invalid or missing API key",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Carrier does not exist",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "RateLimited": {
        "description": "Too many requests. Check X-RateLimit-Remaining and Retry-After headers.",
        "headers": {
          "Retry-After": {
            "schema": { "type": "integer" },
            "description": "Seconds to wait before retrying"
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "McSaleListingPost": {
        "type": ["object", "null"],
        "description": "Source-post metadata. The whole group is null when the source post is no longer available.",
        "properties": {
          "source": {
            "type": "string",
            "enum": ["facebook_group", "facebook_page", "telegram", "mcxchange", "bizbuysell"]
          },
          "source_url": { "type": ["string", "null"] },
          "source_name": { "type": ["string", "null"] },
          "posted_at": { "type": ["string", "null"] },
          "engagement": {
            "type": ["object", "null"],
            "properties": {
              "likes": { "type": "integer" },
              "comments": { "type": "integer" },
              "shares": { "type": "integer" }
            }
          }
        }
      },
      "McSaleListingAuthority": {
        "type": ["object", "null"],
        "description": "Authority details extracted from the post text — the SELLER’S CLAIMS, not FMCSA records; cross-check against /authority.",
        "properties": {
          "type": { "type": ["string", "null"] },
          "status": { "type": ["string", "null"] },
          "state": { "type": ["string", "null"] },
          "mc_number": { "type": ["string", "null"] },
          "dot_number": { "type": ["string", "null"] },
          "granted_date": { "type": ["string", "null"] },
          "granted_date_precision": {
            "type": ["string", "null"],
            "description": "one of exact | month | year | age — \"age\" dates are back-computed and ±1 year"
          },
          "reinstated_date": { "type": ["string", "null"] },
          "ein_disclosed": { "type": "boolean" }
        }
      },
      "McSaleListingSafety": {
        "type": ["object", "null"],
        "description": "Safety stats as claimed in the post text, not FMCSA records.",
        "properties": {
          "total_inspections": { "type": ["integer", "null"] },
          "total_violations": { "type": ["integer", "null"] },
          "total_crashes": { "type": ["integer", "null"] },
          "vehicle_oos_pct": { "type": ["number", "null"] },
          "driver_oos_pct": { "type": ["number", "null"] },
          "vehicle_oos_count": { "type": ["integer", "null"] },
          "driver_oos_count": { "type": ["integer", "null"] }
        }
      },
      "McSaleListingAssets": {
        "type": ["object", "null"],
        "description": "What the seller says is included. Booleans are tri-state: null means the post didn’t mention it.",
        "properties": {
          "highway_setup": { "type": ["boolean", "null"] },
          "amazon_status": { "type": ["string", "null"], "description": "Live | Suspended | Not Applicable | null" },
          "bank_name": { "type": ["string", "null"] },
          "factoring_name": { "type": ["string", "null"] },
          "insurer": { "type": ["string", "null"] },
          "insurance_limit_k": { "type": ["number", "null"] },
          "fleet_size": { "type": ["integer", "null"] },
          "email_included": { "type": ["boolean", "null"] },
          "phone_included": { "type": ["boolean", "null"] }
        }
      },
      "McSaleRecord": {
        "type": "object",
        "description": "One carrier-resolved authority-for-sale record (one row per DOT).",
        "properties": {
          "dot_number": { "type": "integer" },
          "mc_numbers": { "type": "array", "items": { "type": "string" } },
          "carrier": {
            "type": "object",
            "properties": {
              "legal_name": { "type": ["string", "null"] },
              "dba_name": { "type": ["string", "null"] },
              "state": { "type": ["string", "null"] },
              "city": { "type": ["string", "null"] },
              "phone": { "type": ["string", "null"] },
              "email": { "type": ["string", "null"] },
              "officers": { "type": "array", "items": { "type": "string" } }
            }
          },
          "summary": {
            "type": "object",
            "properties": {
              "occurrence_count": { "type": "integer" },
              "avg_confidence": { "type": ["number", "null"], "description": "0-1; treat < 0.4 as weak" },
              "max_confidence": { "type": ["number", "null"] }
            }
          },
          "listings": { "type": "array", "items": { "$ref": "#/components/schemas/McSaleListing" } },
          "first_seen": { "type": ["string", "null"] },
          "last_seen": { "type": ["string", "null"] }
        }
      },
      "McSalesCollectionResponse": {
        "type": "object",
        "properties": {
          "total_results": { "type": "integer" },
          "mc_sales": { "type": "array", "items": { "$ref": "#/components/schemas/McSaleRecord" } },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "McSaleFeedItem": {
        "type": "object",
        "description": "One raw listing from the cross-source feed, independent of carrier resolution.",
        "properties": {
          "id": {
            "type": "string",
            "description": "source-prefixed stable id, e.g. \"facebook_group:<uuid>\""
          },
          "post_url": { "type": ["string", "null"] },
          "post_text": { "type": ["string", "null"] },
          "seller_name": { "type": ["string", "null"] },
          "phone": { "type": ["string", "null"] },
          "email": { "type": ["string", "null"] },
          "linked_dot_numbers": {
            "type": "array",
            "items": { "type": "integer" },
            "description": "DOTs this listing has been resolved to (empty when unresolved)"
          },
          "post": { "$ref": "#/components/schemas/McSaleListingPost" },
          "authority": { "$ref": "#/components/schemas/McSaleListingAuthority" },
          "safety": { "$ref": "#/components/schemas/McSaleListingSafety" },
          "included_assets": { "$ref": "#/components/schemas/McSaleListingAssets" },
          "asking_price_usd": {
            "type": ["number", "null"],
            "description": "Parsed numeric price; null when unparsed or outside $1-$1M sanity bounds"
          },
          "sold": {
            "type": ["boolean", "null"],
            "description": "true once a sold marker is detected; expect lag"
          }
        }
      },
      "McSaleListingsFeedResponse": {
        "type": "object",
        "properties": {
          "listings": { "type": "array", "items": { "$ref": "#/components/schemas/McSaleFeedItem" } },
          "limit": { "type": "integer" },
          "has_more": { "type": "boolean" },
          "next_cursor": {
            "type": ["string", "null"],
            "description": "Opaque keyset cursor — pass back verbatim; page/offset params return 400"
          }
        }
      },
      "PeerGroupDef": {
        "type": "object",
        "properties": {
          "group_type": { "type": "string", "description": "Value accepted by the peer_group parameter" },
          "label": { "type": "string" },
          "kind": { "type": "string", "enum": ["industry", "axis", "axis_pair", "canonical"] },
          "axes": { "type": "array", "items": { "type": "string" } },
          "precomputed": {
            "type": "boolean",
            "description": "true for the 5 lenses whose percentiles the pipeline scores directly"
          }
        }
      },
      "PeerGroupsResponse": {
        "type": "object",
        "properties": {
          "peer_groups": { "type": "array", "items": { "$ref": "#/components/schemas/PeerGroupDef" } },
          "total": { "type": "integer" },
          "reliable_min_n": {
            "type": "integer",
            "description": "Bucket size below which a comparison is flagged low_sample (±5% at 95% CI)"
          }
        }
      },
      "ResolvedPeerGroup": {
        "type": "object",
        "description": "The peer frame the comparison was placed in.",
        "properties": {
          "group_type": { "type": "string" },
          "label": { "type": "string" },
          "peer_key": {
            "type": ["string", "null"],
            "description": "The carrier’s bucket within the lens; null when unresolvable"
          },
          "n": { "type": ["integer", "null"], "description": "Bucket size" },
          "reliable": {
            "type": "boolean",
            "description": "n >= 384; thin buckets are returned flagged, never hidden"
          },
          "available": {
            "type": "boolean",
            "description": "false when the carrier’s profile is missing an axis this lens needs — the fixed grade still returns, only the comparison is omitted"
          }
        }
      },
      "SafetyBenchmarkMetric": {
        "type": "object",
        "properties": {
          "metric": { "type": "string" },
          "label": { "type": ["string", "null"] },
          "units": { "type": ["string", "null"] },
          "carrier_value": { "type": ["number", "null"] },
          "percentile": { "type": ["number", "null"], "description": "Oriented so 100 is always best" },
          "direction": {
            "type": "string",
            "enum": ["lower_is_better", "higher_is_better"],
            "description": "Orientation of the RAW value"
          },
          "scored": {
            "type": "boolean",
            "description": "Whether this metric feeds the overall peer percentile"
          },
          "percentile_source": {
            "type": ["string", "null"],
            "enum": ["precomputed", "interpolated", null],
            "description": "precomputed = the pipeline’s own number (canonical lenses, matches the grade); interpolated = placed inside the lens’s quantile distribution"
          },
          "peer": {
            "type": ["object", "null"],
            "properties": {
              "n": { "type": ["integer", "null"] },
              "median": { "type": ["number", "null"] },
              "boxplot": {
                "type": ["object", "null"],
                "properties": {
                  "min": { "type": "number" },
                  "p10": { "type": "number" },
                  "p25": { "type": "number" },
                  "p50": { "type": "number" },
                  "p75": { "type": "number" },
                  "p90": { "type": "number" },
                  "max": { "type": "number" }
                }
              }
            }
          }
        }
      },
      "SafetyBenchmarkViolation": {
        "type": "object",
        "description": "One violation family, carrier side vs peer side. Sorted worst over_index first.",
        "properties": {
          "unit": { "type": ["string", "null"] },
          "unit_id": { "type": "string" },
          "family": { "type": ["string", "null"] },
          "basic": { "type": ["string", "null"], "description": "FMCSA BASIC category" },
          "severity": { "type": ["number", "null"] },
          "eligible_denominator": {
            "type": "boolean",
            "description": "true when both sides used the eligible-inspection denominator (vehicle-condition families are only citable at CVSA levels 1/2/5)"
          },
          "carrier": {
            "type": "object",
            "properties": {
              "times_cited": { "type": ["integer", "null"] },
              "last_cited_date": { "type": ["string", "null"], "format": "date" },
              "days_since": { "type": ["integer", "null"] },
              "trend_direction": { "type": ["string", "null"] },
              "trend_slope_per_yr": { "type": ["number", "null"] },
              "rate_per_1k": {
                "type": ["number", "null"],
                "description": "The rate the carrier is judged on, per the eligible_denominator rule"
              },
              "total_inspections": { "type": ["integer", "null"] },
              "q_citations": {
                "type": ["array", "null"],
                "items": { "type": "number" },
                "description": "Trailing quarters, oldest first"
              },
              "q_inspections": { "type": ["array", "null"], "items": { "type": "number" } },
              "q_inspections_eligible": { "type": ["array", "null"], "items": { "type": "number" } }
            }
          },
          "peer": {
            "type": ["object", "null"],
            "description": "null when the lens resolves no bucket for this family",
            "properties": {
              "rate_per_1k": { "type": ["number", "null"] },
              "rate_per_1k_eligible": { "type": ["number", "null"] },
              "oos_pct": { "type": ["number", "null"] },
              "group_carriers": { "type": ["integer", "null"] },
              "group_inspections": { "type": ["integer", "null"] },
              "low_sample": { "type": "boolean" },
              "q_rate_per_1k": { "type": ["array", "null"], "items": { "type": "number" } },
              "q_starts": { "type": ["array", "null"], "items": { "type": "string" } }
            }
          },
          "over_index": {
            "type": ["number", "null"],
            "description": "carrier rate ÷ peer rate: 1.0 = at peer, 2.0 = double. Always computed from matched denominators; null when the peer side is missing."
          }
        }
      },
      "SafetyBenchmarkResponse": {
        "type": "object",
        "properties": {
          "dot_number": { "type": "integer" },
          "as_of": { "type": ["string", "null"], "format": "date", "description": "Weekly data vintage" },
          "carrier": {
            "type": "object",
            "properties": {
              "name": { "type": ["string", "null"] },
              "profile": {
                "type": "object",
                "additionalProperties": true,
                "description": "The carrier’s axis values (region, carrier_type, fleet_size, radius, equipment, cab, mileage)"
              }
            }
          },
          "peer_group": { "$ref": "#/components/schemas/ResolvedPeerGroup" },
          "overall": {
            "type": "object",
            "description": "FIXED — computed against the canonical peer model; never moves with peer_group",
            "properties": {
              "score": { "type": ["number", "null"] },
              "grade": { "type": ["string", "null"] },
              "peer_percentile": {
                "type": ["number", "null"],
                "description": "Standing within the chosen lens (mean of scored metric percentiles)"
              },
              "industry_percentile": { "type": ["number", "null"] },
              "data_confidence": { "type": ["string", "null"] }
            }
          },
          "categories": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "score": { "type": ["number", "null"] },
                "grade": { "type": ["string", "null"] },
                "method": { "type": ["string", "null"] }
              }
            },
            "description": "Key set is whatever the pipeline emitted — do not hardcode it"
          },
          "metrics": { "type": "array", "items": { "$ref": "#/components/schemas/SafetyBenchmarkMetric" } },
          "violations": { "type": "array", "items": { "$ref": "#/components/schemas/SafetyBenchmarkViolation" } },
          "violations_truncated": { "type": "boolean" },
          "flags": {
            "type": "object",
            "properties": {
              "low_sample": { "type": "boolean" },
              "litigation_notes": { "type": "array", "items": { "type": "string" } },
              "data_limitations": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      },
      "SafetyBenchmarkViolationsPage": {
        "type": "object",
        "properties": {
          "dot_number": { "type": "integer" },
          "as_of": { "type": ["string", "null"], "format": "date" },
          "peer_group": { "$ref": "#/components/schemas/ResolvedPeerGroup" },
          "violations": { "type": "array", "items": { "$ref": "#/components/schemas/SafetyBenchmarkViolation" } },
          "pagination": { "$ref": "#/components/schemas/Pagination" }
        }
      },
      "CustomDataField": {
        "type": "object",
        "description": "Descriptor for one account-specific custom data field.",
        "properties": {
          "field_key": {
            "type": "string",
            "description": "Key used inside custom_data objects and in POST /v1/custom-data/lookup field projections"
          },
          "display_name": { "type": ["string", "null"] },
          "data_type": {
            "type": ["string", "null"],
            "description": "e.g. number, boolean, text — from the account’s CRM configuration"
          }
        }
      },
      "CustomDataRecord": {
        "type": "object",
        "description": "One custom-data record. Fields appear only inside custom_data, never at the top level.",
        "properties": {
          "dot_number": { "type": "string", "description": "Echoes the requested DOT number" },
          "custom_data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Only the account’s enabled fields, keyed by field_key. Missing values are null."
          },
          "updated_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "When the record was last loaded into AlphaLoops (not real-time CRM state)"
          }
        }
      },
      "CustomDataFieldsResponse": {
        "type": "object",
        "properties": {
          "custom_data_enabled": { "type": "boolean" },
          "source_integration": {
            "type": "string",
            "enum": ["salesforce", "hubspot"],
            "description": "Present when enabled"
          },
          "fields": { "type": "array", "items": { "$ref": "#/components/schemas/CustomDataField" } },
          "total_records": { "type": "integer", "description": "Estimated record count (present when enabled)" },
          "message": { "type": "string", "description": "Present when not enabled" }
        },
        "required": ["custom_data_enabled", "fields"]
      },
      "CustomDataCollectionResponse": {
        "type": "object",
        "properties": {
          "total_results": {
            "type": "integer",
            "description": "Page mode only. May be approximate when no filters are applied; exact when filtered."
          },
          "fields": { "type": "array", "items": { "$ref": "#/components/schemas/CustomDataField" } },
          "records": { "type": "array", "items": { "$ref": "#/components/schemas/CustomDataRecord" } },
          "pagination": {
            "description": "Page mode: page/limit/total_results/total_pages. Cursor mode: limit/next_cursor/has_more (next_cursor null when done), no totals.",
            "oneOf": [
              { "$ref": "#/components/schemas/Pagination" },
              {
                "type": "object",
                "properties": {
                  "limit": { "type": "integer" },
                  "next_cursor": {
                    "type": ["string", "null"],
                    "description": "Pass as ?cursor= for the next page; null when the export is complete"
                  },
                  "has_more": { "type": "boolean" }
                }
              }
            ]
          }
        }
      },
      "CustomDataCarrierResponse": {
        "type": "object",
        "properties": {
          "dot_number": { "type": "string", "description": "Echoes the requested value" },
          "found": { "type": "boolean" },
          "custom_data": {
            "type": ["object", "null"],
            "additionalProperties": true,
            "description": "null when found is false"
          },
          "updated_at": { "type": ["string", "null"], "format": "date-time" },
          "fields": { "type": "array", "items": { "$ref": "#/components/schemas/CustomDataField" } }
        },
        "required": ["dot_number", "found", "fields"]
      },
      "CustomDataLookupRequest": {
        "type": "object",
        "required": ["dot_numbers"],
        "properties": {
          "dot_numbers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": { "type": "string", "pattern": "^\\d{1,8}$" },
            "description": "1-500 DOT numbers; numbers are coerced to strings"
          },
          "fields": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional projection: subset of the account’s field keys. Unknown keys return 400."
          }
        }
      },
      "CustomDataLookupResponse": {
        "type": "object",
        "properties": {
          "requested_count": { "type": "integer", "description": "After deduplication" },
          "found_count": { "type": "integer" },
          "records": { "type": "array", "items": { "$ref": "#/components/schemas/CustomDataRecord" } },
          "missing_dot_numbers": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Requested DOTs with no record, echoed as requested"
          }
        }
      },
