            "items": {
              "type": "object"
            }
          }
        }
      },
      "Location": {
        "type": "object",
        "properties": {
          "locationId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "countryCode": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "temperatureScale": {
            "type": "string",
            "enum": [
              "F",
              "C"
            ]
          }
        }
      },
      "PagedResult": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "_links": {
            "type": "object"
          }
        }
      }
    }
