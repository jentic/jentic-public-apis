openapi: 3.1.0
info:
  title: TruVerifAI External API V1
  version: "2026-05-01"
  description: |
    Multi-model verification by API. Run any prompt through GPT, Claude,
    Gemini, and Grok in parallel, then synthesize a single answer with
    sources, conflicts, and confidence — depending on the mode you pick.

    Three modes:
      - **unify** (~1 credit) — fast synthesis across all four providers
      - **justify** (~2.5 credits) — multi-round deliberation that
        surfaces real disagreement
      - **verify** (~5 credits) — full claim extraction with web-grounded
        per-claim verdicts

    The 1 / 2.5 / 5 baselines assume Standard-tier models across all
    four families. Actual credits charged per query are derived from
    measured provider cost + a fixed margin (Credit System v2) — call
    `POST /v1/estimate-cost` for a pre-flight estimate of the current
    selection.

    Auth: Bearer token (`tvai_…`). Get a key at
    `https://truverif.ai/settings/api-keys`.
  contact:
    email: support@truverif.ai
    url: https://truverif.ai/api
  license:
    name: TruVerifAI Acceptable Use Policy
    url: https://truverif.ai/terms

servers:
  - url: https://api.truverif.ai
    description: Production

tags:
  - name: Queries
    description: Submit and retrieve verification jobs.
  - name: Models
    description: Catalog of provider/model combinations available for selection.
  - name: Usage
    description: Credit usage and per-request history.
  - name: Files
    description: Upload files and reference them in queries.
  - name: Audit
    description: Tamper-evident log of every authenticated call.

security:
  - BearerAuth: []

paths:

  # ============================================================
  # /v1/queries
  # ============================================================

  /v1/queries:
    post:
      tags: [Queries]
      summary: Submit a verification query
      description: |
        Returns 202 with a `request_id`. The job runs asynchronously
        (10s–5min depending on mode). Two ways to retrieve the result:

        - **Polling** — `GET /v1/queries/{id}` every 5–10 seconds until
          `status == "completed"`. Recommended cadence: 5s for the
          first 60s, then 10s.
        - **SSE** — `GET /v1/queries/{id}/stream` to receive
          `progress` events plus a final `result`.

        ### Idempotency

        Pass an `Idempotency-Key` header (any unique string ≤ 200 chars)
        to make submission idempotent. Replays within 24h with the same
        body return the original `request_id` with
        `idempotent_replayed: true`. Replays with a different body
        return 409 `idempotency_conflict`.

        ### Restart caveat (V1)

        In V1, in-flight jobs live in process memory. If the worker
        restarts mid-run, polling returns 404. Retry with the same
        `Idempotency-Key` — the next submit will re-enqueue without
        double-charging credits. We're migrating to durable queues
        post-V1; until then, set client retry policy on 404.
      operationId: submitQuery
      parameters:
        - $ref: "#/components/parameters/IdempotencyKey"
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: "#/components/schemas/QueryRequest"
            examples:
              unify_default:
                summary: Unify with default models
                value:
                  mode: unify
                  prompt: "What is the capital of France?"
              verify_with_web:
                summary: Verify mode with explicit web-search preference
                value:
                  mode: verify
                  prompt: "Fact-check this article: ..."
                  web_search: always
                  metadata:
                    article_id: "9482"
              one_provider_only:
                summary: Single-provider Unify (skip the others)
                value:
                  mode: unify
                  prompt: "Summarize: ..."
                  models:
                    openai: "gpt-5.4-2026-03-05"
                    anthropic: null
                    google: null
                    xai: null
              with_files:
                summary: Verify mode with a PDF attachment
                value:
                  mode: verify
                  prompt: "Verify the claims in this report."
                  files:
                    - file_id: "file_1234abcd"
              with_byom:
                summary: 3 first-party + 1 BYOM (4 participants, the per-query max)
                value:
                  mode: unify
                  prompt: "Compare the defaults with our fine-tuned model."
                  models:
                    openai: "gpt-5.4-2026-03-05"
                    anthropic: "claude-opus-4-7"
                    google: "gemini-2.5-pro"
                    xai: null
                  custom_models:
                    - "byom_42"
      responses:
        "202":
          description: Job accepted; poll or stream for the result.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/SubmitAccepted"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthenticated"
        "402":
          $ref: "#/components/responses/InsufficientCredits"
        "403":
          $ref: "#/components/responses/Forbidden"
        "409":
          $ref: "#/components/responses/IdempotencyConflict"
        "429":
          $ref: "#/components/responses/RateLimited"

  /v1/queries/{request_id}:
    get:
      tags: [Queries]
      summary: Get the result of a submitted query
      description: |
        Returns one of:

        - **200** with `status: "queued"` or `status: "running"` while
          the job is in flight. Repeat until `status == "completed"`.
        - **200** with `status: "completed"` and the full response body
          once the job finishes.
        - **200** with `status: "failed"` and an `error` block if the
          aggregation pipeline raised. Don't retry on this — the
          underlying problem won't fix itself.
        - **404** if the `request_id` isn't found (expired or worker
          restart — see Idempotency on POST).
      operationId: getQuery
      parameters:
        - in: path
          name: request_id
          required: true
          schema:
            type: string
            pattern: "^req_[a-f0-9]+$"
      responses:
        "200":
          description: Query result (status varies — check the `status` field).
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/QueryResponse"
        "401":
          $ref: "#/components/responses/Unauthenticated"
        "404":
          $ref: "#/components/responses/NotFound"

  /v1/queries/{request_id}/stream:
    get:
      tags: [Queries]
      summary: Stream the result via Server-Sent Events
      description: |
        Opens a long-lived SSE connection. Emits `progress` events while
        the job is running and a final `result` event when complete (or
        an `error` event on failure). The connection closes after the
        terminal event.

        ### Event types

        - `progress` — payload `{stage, message, percent, eta}`
        - `result` — payload is the same shape as
          `GET /v1/queries/{id}` returns at status=completed
        - `error` — payload `{error: {...}}` matching the V1 error
          envelope

        Reconnection is a manual concern — re-issuing this endpoint
        with the same `request_id` is safe; you'll get only `result`
        or `error` if the job is already done.
      operationId: streamQuery
      parameters:
        - in: path
          name: request_id
          required: true
          schema:
            type: string
      responses:
        "200":
          description: SSE stream.
          content:
            text/event-stream:
              schema:
                type: string
                description: Server-Sent Events payload.
        "401":
          $ref: "#/components/responses/Unauthenticated"
        "403":
          description: |
            The stream belongs to a different API key (`permission_denied`).
            A not-found request is delivered as an in-stream `error` event on
            an open 200 stream rather than an HTTP error.
          content:
            application/json:
              schema: { $ref: "#/components/schemas/ErrorEnvelope" }

  # ============================================================
  # /v1/models
  # ============================================================

  /v1/models:
    get:
      tags: [Models]
      summary: List available models grouped by provider
      description: |
        Returns the catalog of models the API can select from. Group
        keys are public provider names (`openai`, `anthropic`, `google`,
        `xai`); each group is an ordered array of models.

        Each model lists its `model_id` (the value to pass in the
        `models` field on `POST /v1/queries`), pricing per million
        tokens, and a `tier` hint (`budget`, `standard`, `premium`).
      operationId: listModels
      responses:
        "200":
          description: Model catalog.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/ModelCatalog"
        "401":
          $ref: "#/components/responses/Unauthenticated"

  # ============================================================
  # /v1/estimate-cost
  # ============================================================

  /v1/estimate-cost:
    post:
      tags: [Queries]
      summary: Pre-flight credit estimate for a hypothetical query
      description: |
        Returns per-mode credit estimates for the caller's model
        selection, plus a `can_afford` pre-flight against the tier
        balance. Mirrors the Credit Cost Preview surfaced on the web
        `/models` page.

        The numbers are estimates — actual credit deduction is post-hoc
        cost+ from `provider_call_log` data, so real credits charged
        may differ in either direction. The response always carries a
        `disclaimer` field explaining the variance.

        Use this endpoint to:
        - show "this would cost ~X credits" pre-submit UIs
        - check `can_afford` before submitting a query
        - illustrate how switching models / modes changes the estimate
          (the response includes all three modes' estimates, not just
          the one requested)
      operationId: estimateCost
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [mode]
              properties:
                mode:
                  $ref: "#/components/schemas/Mode"
                  description: |
                    The mode to gate-check with `can_afford` /
                    `reservation_credits`. The response also includes
                    estimates for the other two modes under
                    `credits_by_mode`.
                models:
                  type: object
                  description: |
                    Same shape as the field on `POST /v1/queries`.
                    When supplied, the preview reflects this selection
                    instead of the user's saved defaults. Pass
                    `null` for a family to exclude it from the preview.
                  properties:
                    openai:    { type: string, nullable: true }
                    anthropic: { type: string, nullable: true }
                    google:    { type: string, nullable: true }
                    xai:       { type: string, nullable: true }
                custom_models:
                  type: array
                  description: |
                    BYOM ids that would participate. Echoed back in the
                    response; BYOMs are zero variable cost so they do
                    not change the per-mode estimate.
                  items:
                    type: string
                    pattern: "^byom_[0-9]+$"
            examples:
              default:
                summary: Estimate for Verify with the user's default models
                value: { mode: verify }
              with_overrides:
                summary: Estimate with explicit model selection
                value:
                  mode: justify
                  models:
                    openai: "gpt-5.4-2026-03-05"
                    anthropic: "claude-opus-4-7"
              byom_only:
                summary: BYOM-only query estimate
                value:
                  mode: unify
                  models: { openai: null, anthropic: null, google: null, xai: null }
                  custom_models: ["byom_42"]
      responses:
        "200":
          description: Credit estimate.
          content:
            application/json:
              schema:
                type: object
                properties:
                  requested_mode:
                    $ref: "#/components/schemas/Mode"
                  reservation_credits:
                    type: number
                    description: |
                      Per-mode credit estimate for `requested_mode`.
                      Same value as `credits_by_mode[mode]`. Echoed at
                      the top level for callers that only care about
                      one mode.
                  credits_by_mode:
                    type: object
                    description: |
                      Per-mode estimates for all three modes — lets the
                      caller render "switching to Verify would cost X
                      more" UI without a second round-trip.
                    properties:
                      unify:   { type: number }
                      justify: { type: number }
                      verify:  { type: number }
                  model_multiplier:
                    type: number
                    description: |
                      Display-only — the selected-set credit ratio
                      relative to the four default Standard-tier models.
                      `1.0` means the selection has identical cost to
                      the defaults; `>1.0` means more expensive.
                  selected_models:
                    type: object
                    description: |
                      Echo of which models the preview was computed
                      against. Includes a `custom` array when
                      `custom_models` was supplied in the request.
                    additionalProperties: true
                  can_afford:
                    type: boolean
                    description: |
                      True when the user has enough remaining credits
                      AND is within their monthly tier ceiling /
                      spend-cap for the requested mode.
                  remaining_credits:
                    type: number
                  estimated_remaining_after_query:
                    type: number
                  disclaimer:
                    type: string
                    description: |
                      Plain-English variance explanation. Surface this
                      verbatim alongside any credit estimate.
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthenticated"

  # ============================================================
  # /v1/usage
  # ============================================================

  /v1/usage:
    get:
      tags: [Usage]
      summary: Current credit usage snapshot
      operationId: getUsage
      responses:
        "200":
          description: Tier, allotment, used, remaining, mode weights.
          content:
            application/json:
              schema:
                type: object
                additionalProperties: true
                description: |
                  Usage snapshot for the key's owner. Fields vary by tier and
                  account state; the stable ones are below and the object may
                  carry additional fields.
                properties:
                  tier:
                    type: string
                    enum: [anonymous, free, basic, pro, admin]
                  tier_name:           { type: string }
                  allocated:           { type: number }
                  remaining:           { type: number }
                  total_remaining:     { type: number, nullable: true }
                  reset_period:        { type: string, nullable: true }
                  billing_cycle_start: { type: string, nullable: true }
                  credit_breakdown:
                    type: object
                    nullable: true
                    additionalProperties: true
                  query_weights:
                    type: object
                    properties:
                      unify: { type: number }
                      justify: { type: number }
                      verify: { type: number }
        "401":
          $ref: "#/components/responses/Unauthenticated"

  /v1/usage/queries:
    get:
      tags: [Usage]
      summary: Per-query usage history
      description: |
        Paginated list of `QueryCost` rows. Cursor pagination via
        `cursor` (an ISO-8601 timestamp from a prior response's
        `next_cursor`). `format=csv` returns a downloadable CSV
        attachment; pagination is disabled in CSV mode (max 5000 rows).
      operationId: listUsageQueries
      parameters:
        - in: query
          name: limit
          schema: { type: integer, default: 50, maximum: 100 }
        - in: query
          name: cursor
          schema: { type: string, format: date-time }
        - in: query
          name: api_key_only
          schema: { type: boolean, default: false }
        - in: query
          name: format
          schema:
            type: string
            enum: [json, csv]
            default: json
      responses:
        "200":
          description: Usage history.
          content:
            application/json:
              schema:
                type: object
                properties:
                  queries:
                    type: array
                    items:
                      $ref: "#/components/schemas/QueryCostRow"
                  limit: { type: integer }
                  next_cursor:
                    type: string
                    format: date-time
                    nullable: true
            text/csv:
              schema:
                type: string
                description: |
                  CSV with columns: timestamp / mode / fingerprint /
                  credits_charged / file_attached / file_category /
                  success.
        "401":
          $ref: "#/components/responses/Unauthenticated"

  # ============================================================
  # /v1/files
  # ============================================================

  /v1/files:
    post:
      tags: [Files]
      summary: Upload a file
      description: |
        Multipart upload. Returns a `file_id` you can pass to
        `POST /v1/queries` via the `files` array.

        Supported categories (per provider capability matrix):
          - **Images** PNG / JPG / GIF / WEBP — max 20 MB
          - **PDF** — max 32 MB
          - **Documents** DOC / DOCX — max 32 MB
          - **Code** py / js / ts / html / css / json / yaml / sql — max 10 MB

        Per-request: max 5 files, 30 MB combined size.
      operationId: uploadFile
      requestBody:
        required: true
        content:
          multipart/form-data:
            schema:
              type: object
              required: [file]
              properties:
                file:
                  type: string
                  format: binary
      responses:
        "201":
          description: File uploaded — file metadata.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FileMetadata"
        "400":
          $ref: "#/components/responses/BadRequest"
        "401":
          $ref: "#/components/responses/Unauthenticated"

  /v1/files/{file_id}:
    get:
      tags: [Files]
      summary: Get file metadata
      operationId: getFile
      parameters:
        - in: path
          name: file_id
          required: true
          schema: { type: string }
      responses:
        "200":
          description: File metadata.
          content:
            application/json:
              schema:
                $ref: "#/components/schemas/FileMetadata"
        "401":
          $ref: "#/components/responses/Unauthenticated"
        "404":
          $ref: "#/components/responses/NotFound"
    delete:
      tags: [Files]
      summary: Delete a file
      operationId: deleteFile
      parameters:
        - in: path
          name: file_id
          required: true
          schema: { type: string }
      responses:
        "200":
          description: Deleted.
          content:
            application/json:
              schema:
                type: object
                properties:
                  deleted: { type: boolean }
                  file_id: { type: string }
        "401":
          $ref: "#/components/responses/Unauthenticated"
        "404":
          $ref: "#/components/responses/NotFound"

  # ============================================================
  # /v1/audit/events
  # ============================================================

  /v1/audit/events:
    get:
      tags: [Audit]
      summary: Audit log scoped to the calling key
      description: |
        Tamper-evident log of every authenticated call (and every failed
        auth attempt) made with this key. Cursor pagination; pass
        `format=csv` for a downloadable CSV.
      operationId: listAuditEvents
      parameters:
        - in: query
          name: from
          schema: { type: string, format: date-time }
        - in: query
          name: to
          schema: { type: string, format: date-time }
        - in: query
          name: event_type
          schema:
            type: string
            enum:
              - request
              - auth_failed
              - rate_limited
              - idempotency_replay
              - idempotency_conflict
              - aup_rejected
              - cap_rejected
              - key_created
              - key_revoked
              - key_suspended
              - key_unsuspended
              - key_disabled
              - key_enabled
        - in: query
          name: limit
          schema: { type: integer, default: 50, maximum: 200 }
        - in: query
          name: cursor
          schema: { type: string, format: date-time }
      responses:
        "200":
          description: Audit events.
          content:
            application/json:
              schema:
                type: object
                properties:
                  events:
                    type: array
                    items:
                      $ref: "#/components/schemas/AuditEvent"
                  limit: { type: integer }
                  next_cursor:
                    type: string
                    format: date-time
                    nullable: true
        "401":
          $ref: "#/components/responses/Unauthenticated"

# ============================================================
# COMPONENTS
# ============================================================

components:

  securitySchemes:
    BearerAuth:
      type: http
      scheme: bearer
      bearerFormat: tvai
      description: |
        `Authorization: Bearer tvai_…`. Get a key at
        `https://truverif.ai/settings/api-keys`. Treat keys like
        passwords — they're shown exactly once at creation.

  parameters:
    IdempotencyKey:
      in: header
      name: Idempotency-Key
      required: false
      description: |
        Any unique string ≤ 200 chars. Replays within 24h with the same
        body return the original `request_id` with
        `idempotent_replayed: true`. Different body with the same key
        returns 409 `idempotency_conflict`.
      schema:
        type: string
        maxLength: 200

  schemas:

    Mode:
      type: string
      enum: [unify, justify, verify]
      description: |
        - **unify** (~1 credit) — single-pass synthesis across all four
          providers
        - **justify** (~2.5 credits) — multi-round deliberation
        - **verify** (~5 credits) — claim extraction + web verification

        Baselines assume Standard-tier models across all four families.
        Actual credits charged depend on query complexity, model
        selection, and web-search activity (Credit System v2 cost+).
        Call `POST /v1/estimate-cost` for a pre-flight estimate.

    Provider:
      type: string
      enum: [openai, anthropic, google, xai, custom]
      description: |
        Public provider identifier. `custom` indicates a Bring-Your-Own-Model
        (BYOM) participant — when this value appears, the same response
        object carries a `custom_model` field echoing the `byom_<id>` the
        caller passed in `custom_models`.

    QueryRequest:
      type: object
      required: [mode, prompt]
      description: |
        Submission payload for `POST /v1/queries`. A single query may
        have at most **4 participants** total — first-party providers
        (`models`) + BYOMs (`custom_models`) combined. The synthesizer
        was tuned for ≤4 inputs; requests exceeding the cap return 400
        with `error.code = "invalid_request"`. Override via the
        `PARTICIPANT_CAP` env var server-side.
      properties:
        mode:
          $ref: "#/components/schemas/Mode"
        prompt:
          type: string
          maxLength: 32000
          description: User prompt. 32 KB ceiling enforced server-side.
        models:
          type: object
          description: |
            Optional per-provider model selection. Only the providers you
            list run: pass a `model_id` (string) to use that specific model,
            or `null` to skip the provider. Omitting a provider inside this
            object also skips it. Omit the entire `models` field to fall
            back to the user's default selection.

            Example: `{"openai": "gpt-5.4-2026-03-05", "anthropic": null,
            "google": null, "xai": null}` runs only OpenAI.
          properties:
            openai:    { type: string, nullable: true }
            anthropic: { type: string, nullable: true }
            google:    { type: string, nullable: true }
            xai:       { type: string, nullable: true }
        custom_models:
          type: array
          description: |
            Add Bring-Your-Own-Model participants to the deliberation.
            Each entry is a `byom_<id>` string — the same ids returned in
            the `custom` group of `GET /v1/models`. The BYOM must be
            active and owned by the calling API key's user.

            Pair with `models: {openai: null, anthropic: null, google: null,
            xai: null}` for a BYOM-only query.
          items:
            type: string
            pattern: "^byom_[0-9]+$"
          example: ["byom_42"]
        web_search:
          type: string
          enum: [auto, always, never]
          default: auto
          description: |
            Accepted on all three modes. `auto` defers to the engine's
            heuristic, `always` forces web search, `never` disables it.
            Verify additionally runs web search as part of fact-checking;
            for Verify, `mode_options.verify_with_web` overrides this field.
        files:
          type: array
          maxItems: 5
          items:
            type: object
            required: [file_id]
            properties:
              file_id:
                type: string
        mode_options:
          type: object
          description: |
            Mode-specific options. Currently: `verify_with_web`
            (`auto` / `always` / `never`) for Verify mode, which overrides
            the top-level `web_search`.
          properties:
            verify_with_web:
              type: string
              enum: [auto, always, never]
          additionalProperties: true
        aggregation_model:
          type: string
          nullable: true
          description: |
            Optional synthesizer override — the model that merges the
            panel's responses into the final answer. A first-party catalog
            `model_id`, or a `byom_<id>` for a Bring-Your-Own-Model
            synthesizer. Defaults to the account's configured synthesizer.
          example: byom_42
        client_request_id:
          type: string
          maxLength: 200
          description: Echoed in response metadata.client_request_id.
        metadata:
          type: object
          description: |
            Free-form key/value bag echoed back in
            response.metadata.metadata. Use for your own tracing.
          additionalProperties: true

    SubmitAccepted:
      type: object
      properties:
        request_id:
          type: string
          example: req_2x847dca91b3
        status:
          type: string
          enum: [queued]
        mode:
          $ref: "#/components/schemas/Mode"
        estimated_credits:
          type: number
          nullable: true
          description: |
            Estimated credit cost for this query. Present on a fresh
            submission; omitted on an idempotency replay.
        idempotent_replayed:
          type: boolean
          description: |
            Present and `true` only when this 202 was served from the
            idempotency cache (a replay). Absent on a fresh submission.
        links:
          type: object
          properties:
            self:
              type: string
              format: uri-reference
              example: /v1/queries/req_2x847dca91b3
            stream:
              type: string
              format: uri-reference
              example: /v1/queries/req_2x847dca91b3/stream

    QueryResponse:
      type: object
      properties:
        request_id: { type: string }
        mode:       { $ref: "#/components/schemas/Mode" }
        status:
          type: string
          enum: [running, completed, failed]
        error:
          type: object
          nullable: true
          description: Present only on a failed poll response (status failed).
          properties:
            code:    { type: string }
            message: { type: string }
        stage:
          type: string
          nullable: true
          description: Present on in-flight (status running) responses.
        progress_percent:
          type: integer
          nullable: true
          description: Present on in-flight responses (0-100).
        message:
          type: string
          nullable: true
          description: Present on in-flight responses.
        eta_seconds:
          type: integer
          nullable: true
          description: Present on in-flight responses.
        answer:
          type: object
          properties:
            text:        { type: string }
            stop_reason: { type: string }
            truncated:   { type: boolean }
        models:
          type: array
          items:
            type: object
            properties:
              provider: { $ref: "#/components/schemas/Provider" }
              model:    { type: string, nullable: true }
              status:   { type: string, enum: [ok, error] }
              response: { type: string, nullable: true }
              error:    { type: string, nullable: true }
              custom_model:
                type: string
                nullable: true
                description: |
                  Present only when `provider == "custom"`. Echoes the
                  `byom_<id>` the caller passed in `custom_models`, so
                  responses can be mapped back to the BYOM that produced
                  them.
        skipped_models:
          type: array
          description: |
            Preselected BYOMs dropped from this query's fan-out because they
            were inactive (kill-switched) or could not be found (deleted /
            not owned). Present only when the request omitted `custom_models`
            (so the saved preselection was used) AND at least one preselected
            BYOM was dropped — omitted entirely otherwise.
          items:
            type: object
            properties:
              model:
                type: string
                description: The `byom_<id>` identifier from the saved preselection.
              reason:
                type: string
                enum: [inactive, not_found]
                description: |
                  `inactive` — the BYOM is kill-switched; re-test it to
                  re-enable. `not_found` — it was deleted or isn't owned by
                  this account; remove it from the saved preselection.
        evidence_sources:
          type: array
          items:
            type: object
            properties:
              id:         { type: integer, nullable: true }
              url:        { type: string }
              title:      { type: string, nullable: true }
              snippet:    { type: string, nullable: true }
              providers:
                type: array
                items: { $ref: "#/components/schemas/Provider" }
              published_date: { type: string, nullable: true }
        usage:
          type: object
          description: |
            Credits actually charged for this query under the Credit
            System v2 cost-plus formula. V1 multi-axis fields
            (`mode_weight`, `model_multiplier`, `file_multiplier`) were
            removed when V2 shipped — credits are now derived from
            measured provider cost + a fixed margin, not a multiplier
            stack.
          properties:
            credits_charged: { type: number, nullable: true }
        timing:
          type: object
          properties:
            queued_ms:       { type: integer, nullable: true }
            model_calls_ms:  { type: integer, nullable: true }
            aggregation_ms:  { type: integer, nullable: true }
            total_ms:        { type: integer, nullable: true }
        metadata:
          type: object
          properties:
            client_request_id:   { type: string, nullable: true }
            metadata:            { type: object, nullable: true }
            idempotent_replayed: { type: boolean }
            api_version:         { type: string }
        justify:
          type: object
          nullable: true
          description: Present only when mode == "justify".
          properties:
            rounds:    { type: integer }
            conflicts:
              type: array
              items:
                type: object
                properties:
                  topic:    { type: string }
                  severity: { type: string, enum: [high, medium, low] }
                  positions:
                    type: object
                    additionalProperties: { type: string }
                  consensus: { type: string, nullable: true }
            deliberation:
              type: object
              properties:
                initial:
                  type: array
                  items:
                    type: object
                    properties:
                      provider: { $ref: "#/components/schemas/Provider" }
                      response: { type: string, nullable: true }
                revised:
                  type: array
                  items:
                    type: object
                    properties:
                      provider: { $ref: "#/components/schemas/Provider" }
                      action:   { type: string, nullable: true }
                      response: { type: string, nullable: true }
        verify:
          type: object
          nullable: true
          description: Present only when mode == "verify".
          properties:
            facts:
              type: object
              properties:
                verified:
                  type: array
                  items:
                    $ref: "#/components/schemas/VerifiedFact"
                disputed:
                  type: array
                  items:
                    $ref: "#/components/schemas/VerifiedFact"
            summary:
              type: object
              properties:
                total_extracted: { type: integer }
                consensus:       { type: integer }
                web_verified:    { type: integer }

    VerifiedFact:
      type: object
      properties:
        claim: { type: string }
        supporting_providers:
          type: array
          items: { $ref: "#/components/schemas/Provider" }
        agreement_level: { type: string, nullable: true }
        status:          { type: string, nullable: true }
        confidence:      { type: string, nullable: true }
        verification:
          type: object
          properties:
            verified:             { type: boolean, nullable: true }
            note:                 { type: string, nullable: true }
            perplexity_reasoning: { type: string, nullable: true }
            sources:
              type: array
              description: Raw engine source objects (shape passed through untransformed).
              items:
                type: object
                additionalProperties: true

    ModelCatalog:
      type: object
      properties:
        openai:    { type: array, items: { $ref: "#/components/schemas/ModelInfo" } }
        anthropic: { type: array, items: { $ref: "#/components/schemas/ModelInfo" } }
        google:    { type: array, items: { $ref: "#/components/schemas/ModelInfo" } }
        xai:       { type: array, items: { $ref: "#/components/schemas/ModelInfo" } }
        custom:
          type: array
          description: |
            The calling API key's active BYOMs. Pass any `id` from this
            list to `POST /v1/queries` via `custom_models`. Absent when
            the user has no BYOMs configured.
          items:
            $ref: "#/components/schemas/CustomModelInfo"

    ModelInfo:
      type: object
      properties:
        model_id:           { type: string }
        display_name:       { type: string }
        tier:
          type: string
          enum: [budget, standard, premium]
        is_default:         { type: boolean }
        input_per_million:  { type: number, nullable: true }
        output_per_million: { type: number, nullable: true }

    CustomModelInfo:
      type: object
      description: |
        A BYOM (Bring-Your-Own-Model) entry from `GET /v1/models`'s
        `custom` group. `id` is the value to pass in `custom_models` on
        `POST /v1/queries`. The `model_id` and `wire_protocol` fields
        are echoed from the BYOM's setup for informational purposes —
        the request only needs the `id`.
      properties:
        id:
          type: string
          pattern: "^byom_[0-9]+$"
          example: "byom_42"
        display_name: { type: string }
        model_id:     { type: string }
        wire_protocol:
          type: string
          description: |
            The wire protocol the BYOM uses to talk to its host.
          enum:
            - openai_chat
            - anthropic_messages
            - google_generate_content
            - custom_openai_chat
            - bedrock_converse
            - vertex_gemini
            - anthropic_messages_bedrock
            - anthropic_messages_vertex
            - vertex_openai_chat

    QueryCostRow:
      type: object
      description: |
        One row of per-query usage history. V2-aligned shape — V1
        multi-axis multipliers and the raw cost surface
        (`estimated_cost_usd`, `tavily_searches`, `perplexity_calls`)
        are no longer exposed; `credits_charged` is the only price
        field.
      properties:
        id:                 { type: integer }
        mode:               { $ref: "#/components/schemas/Mode" }
        credits_charged:    { type: number }
        file_attached:      { type: boolean }
        file_category:      { type: string, nullable: true }
        success:            { type: boolean }
        api_key_attributed: { type: boolean }
        timestamp:          { type: string, format: date-time }

    FileMetadata:
      type: object
      properties:
        file_id:    { type: string }
        name:       { type: string }
        size_bytes: { type: integer }
        category:
          type: string
          enum: [image, pdf, document, code]
        mime_type:  { type: string }
        created_at: { type: string, format: date-time }
        expires_at:
          type: string
          format: date-time
          description: Files auto-expire 30 days after upload (FILE_RETENTION_DAYS).

    AuditEvent:
      type: object
      properties:
        timestamp:   { type: string, format: date-time }
        event_type:
          type: string
          description: See the event_type query param for the full enum.
        request_id:  { type: string, nullable: true }
        endpoint:    { type: string, nullable: true }
        status_code: { type: integer, nullable: true }
        error_code:  { type: string, nullable: true }
        ip:          { type: string, nullable: true }
        user_agent:  { type: string, nullable: true }
        latency_ms:  { type: integer, nullable: true }
        metadata:
          type: object
          nullable: true
          additionalProperties: true

    ErrorEnvelope:
      type: object
      required: [error]
      properties:
        error:
          type: object
          required: [code, message, retriable, docs_url]
          properties:
            code:
              type: string
              description: Stable machine-readable error code.
              enum:
                - invalid_request
                - invalid_prompt
                - invalid_mode
                - invalid_model
                - invalid_models
                - unsupported_file_type
                - file_too_large
                - file_not_found
                - request_not_found
                - file_expired
                - unauthenticated
                - invalid_api_key
                - key_revoked
                - key_suspended
                - key_disabled
                - aup_required
                - permission_denied
                - insufficient_credits
                - monthly_cap_exceeded
                - rate_limited
                - idempotency_conflict
                - provider_error
                - aggregation_failed
                - service_restarting
                - internal_error
                - service_unavailable
            message:
              type: string
              description: Human-readable explanation. Subject to change.
            request_id:
              type: string
              nullable: true
            retriable:
              type: boolean
              description: |
                True for 5xx and 429. False for 4xx (which means fix
                the request, don't retry it).
            retry_after_seconds:
              type: integer
              nullable: true
            docs_url:
              type: string

  responses:
    BadRequest:
      description: Invalid request body or parameters.
      content:
        application/json:
          schema: { $ref: "#/components/schemas/ErrorEnvelope" }

    Unauthenticated:
      description: Missing or invalid Bearer token.
      content:
        application/json:
          schema: { $ref: "#/components/schemas/ErrorEnvelope" }

    Forbidden:
      description: |
        Authenticated but the action isn't permitted (key suspended,
        AUP not yet accepted, etc.).
      content:
        application/json:
          schema: { $ref: "#/components/schemas/ErrorEnvelope" }

    NotFound:
      description: Resource doesn't exist (or has expired).
      content:
        application/json:
          schema: { $ref: "#/components/schemas/ErrorEnvelope" }

    InsufficientCredits:
      description: |
        Tier allotment exhausted, or per-key monthly spend cap exceeded.
      content:
        application/json:
          schema: { $ref: "#/components/schemas/ErrorEnvelope" }

    IdempotencyConflict:
      description: |
        Same Idempotency-Key with a different body within the 24h TTL.
      content:
        application/json:
          schema: { $ref: "#/components/schemas/ErrorEnvelope" }

    RateLimited:
      description: |
        Up to 8 concurrent in-flight queries per API key; submitting while at
        the cap returns 429 `rate_limited`. There is no fixed per-minute
        request cap — the effective ceiling is the account's credit balance.
        Honor the `Retry-After` header.
      headers:
        Retry-After:
          schema: { type: integer }
          description: Seconds to wait before retrying.
      content:
        application/json:
          schema: { $ref: "#/components/schemas/ErrorEnvelope" }
