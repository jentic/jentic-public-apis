    "/api/external/v2/api-keys": {
      "post": {
        "operationId": "postApiKeys",
        "summary": "Create a new API key for the authenticated user",
        "description": "Create a new API key for the authenticated user\n\nDocs page: https://www.lev.com/docs/build/api-keys",
