    "/projects/{PROJECT_ID}/processors/{PROCESSOR_ID}/process": {
      "post": {
        "tags": [
          "processors"
        ],
        "summary": "Submit a document to a Processor (canonical, server resolves latest ready version)",
        "description": "Submit a document for asynchronous processing using the identified Processor. The request binds the Processor version in use at submission time. Server validates base64 content, processor readiness, and returns a 202 Accepted with a Job URI. See Processor Job result query (REQ-FUNC-002) for retrieving status.\n",
        "operationId": "submitToProcessor",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/ProcessorId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "submit-example": {
                  "$ref": "#/components/examples/SubmitDocumentExample"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted for processing. Returns Job URI and identifier.",
            "headers": {
              "Content-Location": {
                "description": "Job URI (status endpoint) where results can be polled.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (invalid base64, invalid document representation, or processor not in ready state)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Project or Processor not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{PROJECT_ID}/processors/{PROCESSOR_ID}/{VERSION_ID}/process": {
      "post": {
        "tags": [
          "processors"
        ],
        "summary": "Submit a document to a specific Processor version",
        "description": "Submit a document to a specific processor version. This yields deterministic behavior since the version is recorded at submission. Returns 202 Accepted and Job URI. Same validation and error semantics as canonical submit.\n",
        "operationId": "submitToProcessorVersion",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/ProcessorId"
          },
          {
            "$ref": "#/components/parameters/VersionId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitRequest"
              },
              "examples": {
                "submit-example": {
                  "$ref": "#/components/examples/SubmitDocumentExample"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted for processing. Returns Job URI and identifier.",
            "headers": {
              "Location": {
                "description": "Job URI (status endpoint) where results can be polled.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (invalid base64, invalid document representation, or processor/version not in ready state)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Project, Processor or Version not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{PROJECT_ID}/jobs/{JOB_ID}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job status and results",
        "description": "Retrieve the current status, metadata, and processing results for a Job. For completed jobs, returns result artifacts. For failed jobs, returns failure reason and remediation guidance. Webhook notifications may be emitted on state transitions per configuration.\n",
        "operationId": "getJob",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Job status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResult"
                },
                "examples": {
                  "completed": {
                    "$ref": "#/components/examples/JobSucceededExample"
                  },
                  "failed": {
                    "$ref": "#/components/examples/JobFailedExample"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "jobs"
        ],
        "summary": "Delete a Job",
        "description": "Delete a job and its associated resources. In-progress jobs will be canceled. Completed jobs' metadata may be retained according to retention policies.\n",
        "operationId": "deleteJob",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "202": {
            "description": "Job deletion accepted"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Job not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict (job cannot be deleted in current state)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
