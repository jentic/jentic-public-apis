{
  "openapi": "3.1.0",
  "info": {
    "title": "Minerva API",
    "version": "1.0.0",
    "description": "Intelligent document processing API that enables you to extract structured data from documents. Securely manage document processors and submit documents for automated processing using OAuth2/JWT authentication.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/kokyhin/Minerva/1.0.0"
  },
  "servers": [
    {
      "url": "https://ai.innovsolved.com/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "processors",
      "description": "Processor lifecycle and submission jobs"
    },
    {
      "name": "jobs",
      "description": "Job status and results"
    },
    {
      "name": "projects",
      "description": "Project management within a tenant"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "pageToken": {
        "name": "pageToken",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Cursor token for pagination"
      },
      "pageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        },
        "description": "Page size"
      },
      "ProjectId": {
        "name": "PROJECT_ID",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Project identifier (URL-encoded)"
      },
      "ClientAppId": {
        "name": "CLIENT_APP_ID",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Client App identifier"
      },
      "ProcessorId": {
        "name": "PROCESSOR_ID",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Processor identifier (URL-encoded)"
      },
      "VersionId": {
        "name": "VERSION_ID",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Processor version identifier"
      },
      "JobId": {
        "name": "JOB_ID",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Job identifier (returned by submission)"
      }
    },
    "schemas": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "fatal",
              "error",
              "warning",
              "information"
            ]
          },
          "code": {
            "type": "string"
          },
          "diagnostics": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "severity",
          "details"
        ]
      },
      "Errors": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/ErrorDetail"
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "issue": {
            "$ref": "#/components/schemas/Errors"
          }
        }
      },
      "ObjectMeta": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "readOnly": true
          },
          "project": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "labels": {
            "additionalProperties": {
              "type": "string"
            }
          },
          "creationTimestamp": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          }
        }
      },
      "ObjectRef": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "readOnly": true
          },
          "project": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PaginatedList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$dynamicRef": "#T"
            }
          },
          "nextPage": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "items"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/ObjectMeta"
          },
          "name": {
            "type": "String"
          }
        },
        "required": [
          "metadata",
          "name"
        ]
      },
      "ProjectList": {
        "$defs": {
          "projects": {
            "$dynamicAnchor": "T",
            "$ref": "#/components/schemas/Project"
          }
        },
        "$ref": "#/components/schemas/PaginatedList"
      },
      "ClientApp": {
        "type": "object",
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/ObjectMeta"
          },
          "scope": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          },
          "clientId": {
            "type": "string",
            "readOnly": true
          },
          "clientSecret": {
            "type": "string",
            "readOnly": true,
            "description": "Only returned on creation"
          }
        },
        "required": [
          "metadata",
          "scope"
        ]
      },
      "ClientAppList": {
        "$defs": {
          "clientApps": {
            "$dynamicAnchor": "T",
            "$ref": "#/components/schemas/ClientApp"
          }
        },
        "$ref": "#/components/schemas/PaginatedList"
      },
      "ProcessorBase": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "extractor"
            ]
          },
          "metadata": {
            "$ref": "#/components/schemas/ObjectMeta"
          }
        },
        "required": [
          "metadata",
          "type"
        ]
      },
      "Processor": {
        "type": "object",
        "$ref": "#/components/schemas/ProcessorBase",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ExtractorProcessor"
          }
        ]
      },
      "ExtractorProcessor": {
        "type": "object",
        "properties": {
          "type": {
            "constant": "extractor"
          },
          "spec": {
            "type": "object",
            "properties": {
              "schema": {
                "type": "object",
                "anyOf": [
                  {
                    "jsonSchema": {
                      "$ref": "https://json-schema.org/draft/2020-12/schema"
                    }
                  }
                ]
              },
              "prompt": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProcessorSummaryList": {
        "$defs": {
          "processors": {
            "$dynamicAnchor": "T",
            "$ref": "#/components/schemas/ProcessorBase"
          }
        },
        "$ref": "#/components/schemas/PaginatedList"
      },
      "RawDocument": {
        "type": "object",
        "properties": {
          "mimeType": {
            "type": "string",
            "example": "application/pdf"
          },
          "content": {
            "type": "string",
            "format": "byte",
            "description": "Base64-encoded content bytes"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "mimeType",
          "content",
          "name"
        ]
      },
      "Document": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "raw"
            ]
          }
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/RawDocument"
          }
        ],
        "required": [
          "type"
        ]
      },
      "SubmitRequest": {
        "type": "object",
        "properties": {
          "labels": {
            "additionalProperties": {
              "type": "string"
            }
          },
          "document": {
            "$ref": "#/components/schemas/Document"
          }
        },
        "required": [
          "document"
        ]
      },
      "JobResult": {
        "type": "object",
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/ObjectMeta"
          },
          "spec": {
            "type": "object",
            "properties": {
              "processor": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "uid": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "entities": {
            "type": "object",
            "additionalProperties": true
          },
          "issue": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "status": {
            "type": "object",
            "properties": {
              "startTime": {
                "type": "string",
                "format": "date-time"
              },
              "phase": {
                "type": "string",
                "enum": [
                  "pending",
                  "processing",
                  "cancelled",
                  "completed",
                  "failed"
                ]
              }
            }
          }
        }
      }
    },
    "examples": {
      "CreateProcessorExample": {
        "value": {
          "type": "extractor",
          "metadata": {
            "name": "invoice-extractor",
            "project": "default",
            "labels": {
              "domain": "finance"
            }
          },
          "spec": {
            "schema": {
              "type": "object",
              "properties": {
                "total": {
                  "type": "number"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "vendor": {
                  "type": "string"
                }
              },
              "required": [
                "total",
                "date",
                "vendor"
              ]
            },
            "prompt": "Extract invoice information including total amount, date, and vendor name"
          }
        }
      },
      "SubmitDocumentExample": {
        "value": {
          "labels": {
            "source": "upload"
          },
          "document": {
            "type": "raw",
            "mimeType": "application/pdf",
            "name": "invoice.pdf",
            "content": "JVBERi0xLjcKCjEgMCBvYmogICUgZW50cnkgcG9pbnQKPDwKICAvVHlwZSAvQ2F0YWxvZwog"
          }
        }
      },
      "JobSucceededExample": {
        "value": {
          "metadata": {
            "uid": "op-123",
            "project": "default",
            "name": "invoice-extraction-1"
          },
          "spec": {
            "processor": {
              "name": "invoice-extractor",
              "version": "v1",
              "uid": "proc-456"
            }
          },
          "entities": {
            "total": 123.45,
            "date": "2023-12-01",
            "vendor": "ACME Corp"
          },
          "status": {
            "phase": "succeeded",
            "startTime": "2023-12-01T10:00:00Z"
          }
        }
      },
      "JobFailedExample": {
        "value": {
          "metadata": {
            "uid": "op-124",
            "project": "default",
            "name": "invoice-extraction-2"
          },
          "spec": {
            "processor": {
              "name": "invoice-extractor",
              "version": "v1",
              "uid": "proc-456"
            }
          },
          "issue": {
            "severity": "error",
            "code": "PROC-001",
            "diagnostics": "Document processing failed",
            "details": {
              "text": "Unable to extract required fields from document"
            }
          },
          "status": {
            "phase": "failed",
            "startTime": "2023-12-01T11:00:00Z"
          }
        }
      },
      "ProjectCreateExample": {
        "value": {
          "name": "default"
        }
      }
    }
  },
  "paths": {
    "/projects": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "List Projects",
        "description": "List projects",
        "operationId": "listProjects",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/pageToken"
          },
          {
            "$ref": "#/components/parameters/pageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated list of projects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedList"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Tenant not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "projects"
        ],
        "summary": "Create Project",
        "description": "Create a new project",
        "operationId": "createProject",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Project"
              },
              "examples": {
                "create": {
                  "$ref": "#/components/examples/ProjectCreateExample"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created. Location header contains project URI.",
            "headers": {
              "Location": {
                "description": "URI of the created project",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Tenant not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{PROJECT_ID}": {
      "get": {
        "tags": [
          "projects"
        ],
        "summary": "Get Project",
        "description": "Retrieve project details.",
        "operationId": "getProject",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Project details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Project not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "projects"
        ],
        "summary": "Delete Project",
        "description": "Delete a project. May fail if resources exist.",
        "operationId": "deleteProject",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "responses": {
          "204": {
            "description": "Project deleted"
          },
          "400": {
            "description": "Bad request / cannot delete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Project not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{PROJECT_ID}/processors": {
      "get": {
        "tags": [
          "processors"
        ],
        "summary": "List Processors",
        "description": "List Processor definitions for the specified project. Returns a paginated collection.\n",
        "operationId": "listProcessors",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          },
          {
            "$ref": "#/components/parameters/pageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "List of processors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessorSummaryList"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "processors"
        ],
        "summary": "Create a Processor definition",
        "description": "Create a new Processor definition. For \"extractor\" type processors, a syntactically valid JSON Schema MUST be provided in \"schema\". On success returns 201 and Location header pointing to the created processor/version. Requests are authenticated and authorization checked per RBAC. Validation errors return 4xx with details.\n",
        "operationId": "createProcessor",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          }
        ],
        "requestBody": {
          "description": "Processor create payload",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Processor"
              },
              "examples": {
                "create-example": {
                  "$ref": "#/components/examples/CreateProcessorExample"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Processor created. Location header contains canonical Processor Version URI.",
            "headers": {
              "Location": {
                "description": "URI for the created processor version",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Processor"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (validation failed)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized (missing/invalid token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden (insufficient scope/role)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/projects/{PROJECT_ID}/processors/{PROCESSOR_ID}": {
      "get": {
        "tags": [
          "processors"
        ],
        "summary": "Retrieve a Processor definition",
        "description": "Retrieve a Processor definition and its versions.\n",
        "operationId": "getProcessor",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/ProcessorId"
          }
        ],
        "responses": {
          "200": {
            "description": "Processor detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Processor"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Processor not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "processors"
        ],
        "summary": "Delete (mark) a Processor",
        "description": "Marks a Processor for deletion per retention/safety rules. In-flight jobs complete before final removal.\n",
        "operationId": "deleteProcessor",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ProjectId"
          },
          {
            "$ref": "#/components/parameters/ProcessorId"
          }
        ],
        "responses": {
          "202": {
            "description": "Deletion scheduled/accepted"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Processor not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict (cannot delete due to constraints)",
