{
  "openapi": "3.0.3",
  "info": {
    "title": "Communication Consent SOR API",
    "version": "1.2.0",
    "description": "System-of-Record API for member contact point consents.\nChanges in v1.2.0:\n- **PUT now writes to `consent_event`** (idempotent upsert via path `consent_event_id`).\n- Added **POST /consent-events** to create a new consent event.\n- Removed `individual_id` from POST/PUT paths (it belongs in the body of the event resource).\n- Kept **GET /consent/{individual_id}** for current-state lookups in `contact_point_consent_current`.\n- Kept **POST /events/sfmc** for footer unsubscribe.\n",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/lantern-37c/communication-consent-sor-api/1.2.0"
  },
  "servers": [
    {
      "url": "https://api.lanterncare.com/sor/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.lanterncare.com/oauth/token",
            "scopes": {
              "preferences.read": "Read current consent",
              "preferences.write": "Create/Update consent events"
            }
          }
        }
      }
    },
    "schemas": {
      "ContactPointConsentCurrent": {
        "type": "object",
        "required": [
          "individual_id",
          "contact_point_id",
          "channel_type",
          "channel_value",
          "consent_status",
          "purpose",
          "last_changed_at",
          "source_system"
        ],
        "properties": {
          "individual_id": {
            "type": "string",
            "format": "uuid"
          },
          "contact_point_id": {
            "type": "string",
            "format": "uuid"
          },
          "channel_type": {
            "type": "string",
            "example": "email"
          },
          "channel_value": {
            "type": "string",
            "example": "user@example.com"
          },
          "consent_status": {
            "type": "string",
            "example": "opted_in"
          },
          "purpose": {
            "type": "string",
            "example": "marketing"
          },
          "last_changed_at": {
            "type": "string",
            "example": "2026-01-16T19:30:00Z"
          },
          "source_system": {
            "type": "string",
            "example": "sfhc"
          }
        }
      },
      "ConsentEvent": {
        "type": "object",
        "required": [
          "consent_event_id",
          "individual_id",
          "channel_type",
          "contact_point_id",
          "purpose",
          "consent_status",
          "source_system",
          "effective_from",
          "modified_date",
          "is_current"
        ],
        "properties": {
          "consent_event_id": {
            "type": "string",
            "format": "uuid"
          },
          "individual_id": {
            "type": "string",
            "format": "uuid"
          },
          "channel_type": {
            "type": "string",
            "example": "email"
          },
          "contact_point_id": {
            "type": "string",
            "description": "Matches DB `varchar(20)`; may be an external key. If you use UUIDs for contact points, ensure mapping.",
            "example": "CP-00012345678901234567"
          },
          "purpose": {
            "type": "string",
            "example": "marketing"
          },
          "consent_status": {
            "type": "string",
            "example": "opted_out"
          },
          "source_system": {
            "type": "string",
            "example": "sfhc"
          },
          "sf_consent_id": {
            "type": "string",
            "nullable": true
          },
          "effective_from": {
            "type": "boolean",
            "description": "Maps SQL `bit` (true means event effective at `modified_date`)."
          },
          "extracted_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "modified_date": {
            "type": "string",
            "format": "date-time"
          },
          "is_current": {
            "type": "boolean",
            "description": "Mirrors DB `is_current` flag used for event streams."
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_REQUEST"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "security": [
    {
      "oauth2": []
    }
  ],
  "paths": {
    "/consent/{individual_id}": {
      "get": {
        "summary": "Get current consent by individual and channel",
        "description": "Returns a single current consent row from `contact_point_consent_current` for the given individual and channel.",
        "parameters": [
          {
            "in": "path",
            "name": "individual_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "channel_type",
            "required": true,
            "schema": {
              "type": "string",
              "example": "email"
            }
          },
          {
            "in": "query",
            "name": "channel_value",
            "required": false,
            "schema": {
              "type": "string",
              "example": "user@example.com"
            }
          },
          {
            "in": "query",
            "name": "purpose",
            "required": false,
            "schema": {
              "type": "string",
              "example": "marketing"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current consent record found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactPointConsentCurrent"
                }
              }
            }
          },
          "404": {
            "description": "No current consent found for the given keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/consent-events": {
      "post": {
        "summary": "Create a new consent event (append-only)",
        "description": "Inserts a new row into `consent_event`. Server may generate `consent_event_id` if not provided.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentEvent"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Event created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "created"
                    },
                    "consent_event_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid event payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/consent-events/{consent_event_id}": {
      "put": {
        "summary": "Upsert a consent event by ID (idempotent)",
        "description": "Writes to `consent_event` using the provided `consent_event_id`. Use for idempotent retries.",
        "parameters": [
          {
            "in": "path",
            "name": "consent_event_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event upserted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "upserted"
                    },
                    "consent_event_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid event payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflict (e.g., mismatched body/path IDs or authority violation)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/events/sfmc": {
      "post": {
        "summary": "Ingest SFMC footer unsubscribe event (original POST)",
        "description": "Original POST endpoint retained for SFMC footer unsubscribe flows; payload maps into ConsentEvent semantics.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "individual_id",
                  "channel_type",
                  "purpose",
                  "consent_status",
                  "source_system"
                ],
                "properties": {
                  "individual_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "channel_type": {
                    "type": "string",
                    "example": "email"
                  },
                  "channel_value": {
                    "type": "string",
                    "example": "user@example.com"
                  },
                  "purpose": {
                    "type": "string",
                    "example": "marketing"
                  },
                  "consent_status": {
                    "type": "string",
                    "example": "opted_out"
                  },
                  "source_system": {
                    "type": "string",
                    "example": "sfmc_footer"
                  },
                  "idempotency_key": {
                    "type": "string",
                    "description": "Recommended header; may also be passed in body if header not available."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Event accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "accepted"
                    },
                    "event_id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid event payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
