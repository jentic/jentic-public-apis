{
  "openapi": "3.0.1",
  "info": {
    "title": "Customer Management",
    "description": "**CustomerDetails Management**",
    "version": "5.0.0",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/Techmahindra68/customer-management/5.0.0"
  },
  "servers": [
    {
      "url": "https://stg.api.ooredoo.com/tmf-api/customerDetailsManagement/v4"
    }
  ],
  "security": [
    {
      "OAuth2": []
    }
  ],
  "tags": [
    {
      "name": "customer",
      "description": "Operations for Customer Resource"
    }
  ],
  "paths": {
    "/customerDetails/{msisdn}": {
      "get": {
        "tags": [
          "customer"
        ],
        "summary": "Retrieves MSISDN information by msisdn",
        "description": "This operation retrieves a MSISDN type and status. Attribute selection enabled for all first level attributes.\n",
        "operationId": "retrieveCustomer",
        "parameters": [
          {
            "$ref": "#/components/parameters/MSISDN"
          },
          {
            "$ref": "#/components/parameters/TransactionId"
          },
          {
            "$ref": "#/components/parameters/CountryCode"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/200Customer_Get"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "412": {
            "$ref": "#/components/responses/412"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "405": {
            "$ref": "#/components/responses/405"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "501": {
            "$ref": "#/components/responses/501"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://stg.api.ooredoo.com/tmf-api/oauth/v4/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "Customer": {
        "type": "object",
        "required": [
          "@type",
          "eligibility",
          "status"
        ],
        "properties": {
          "@type": {
            "type": "string",
            "description": "Denotes type of MSISDN",
            "enum": [
              "Prepaid",
              "Postpaid",
              "Hybrid"
            ]
          },
          "eligibility": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "description": "Status of MSISDN",
            "enum": [
              "Active",
              "Inactive"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "reason"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Application relevant detail, defined in the API or a common list."
          },
          "reason": {
            "type": "string",
            "description": "Explanation of the reason for the error which can be shown to a client user."
          },
          "message": {
            "type": "string",
            "description": "More details and corrective actions related to the error which can be shown to a client user."
          },
          "status": {
            "type": "string",
            "description": "HTTP Error code extension"
          },
          "referenceError": {
            "type": "string",
            "description": "URI of documentation describing the error."
          }
        },
        "description": "Used when an API throws an Error, typically with a HTTP error response-code (3xx, 4xx, 5xx)"
      }
    },
    "parameters": {
      "MSISDN": {
        "name": "msisdn",
        "in": "path",
        "required": true,
        "description": "Identifier of the Resource",
        "schema": {
          "type": "string",
          "example": 9612198
        }
      },
      "TransactionId": {
        "name": "transactionId",
        "in": "header",
        "required": true,
        "description": "Unique Transaction ID generated by consumer",
        "schema": {
          "type": "string",
          "example": 12345678912345678
        }
      },
      "CountryCode": {
        "name": "countryCode",
        "in": "header",
        "required": true,
        "description": "Denotes the country to which the phone number belongs",
        "schema": {
          "type": "string",
          "example": "MDV"
        }
      }
    },
    "responses": {
      "200": {
        "description": "OK"
      },
      "400": {
        "description": "Bad Request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "412": {
        "description": "PreCondition Failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "403": {
        "description": "Forbidden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "Not Found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "405": {
        "description": "Method Not Allowed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "Conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "500": {
        "description": "Internal Server Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "501": {
        "description": "Not Implemented",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "503": {
        "description": "Service Unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "200Customer_Get": {
        "description": "Success",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Customer"
            },
            "examples": {
              "Customer_retrieve_example": {
                "$ref": "#/components/examples/Customer_retrieve_example_response"
              }
            }
          }
        }
      }
    },
    "examples": {
      "Customer_retrieve_example_response": {
        "value": {
          "@type": "Prepaid",
          "eligibility": true,
          "status": "Active"
        }
      }
    }
  }
}
