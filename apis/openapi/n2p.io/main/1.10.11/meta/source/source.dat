{"openapi":"3.0.0","info":{"title":"net2phone API","version":"1.10.11","description":"The net2phone API is an HTTP web service that provides programmatic access to selected features of your net2phone account. It empowers you with the ability to create your integrations using our communication data resources, for example, call data records that contain details about phone calls."},"components":{"schemas":{"cdr-page":{"type":"object","description":"A page of call detail records (CDR).","title":"A Page of CDRs","properties":{"cursor":{"type":"string","description":"The cursor\/index from which to continue a previous request from."},"more":{"type":"boolean","description":"True if there is more data available. If True use the cursor to request the next batch of data."},"result":{"items":{"$ref":"#\/components\/schemas\/cdr"},"type":"array","description":"A list of CDR data","uniqueItems":true}}},"http-only-webhook-subscription-settings":{"required":["post_uri"],"properties":{"post_uri":{"description":"The HTTP(S) endpoint which is notified when an event occurs.","type":"string","format":"uri"}},"type":"object"},"user":{"type":"object","description":"Details of the user","title":"User Details","required":["username","user","first_name","last_name","email","scope"],"properties":{"first_name":{"type":"string","description":"The first name of the user"},"last_name":{"type":"string","description":"The last name of the user"},"domain":{"type":"string","description":"The domain for the user"},"email":{"type":"string","description":"The email address of the user"},"username":{"type":"string","description":"The user identifier"},"scope":{"description":"The role of this user","type":"string","enum":["Basic User","Office Manager","Call Center Supervisor","Call Center User","admin","regular","primary","anonymous"]},"user":{"type":"string","description":"The user's extension"},"time_zone":{"type":"string","description":"The time zone this user resides in"}}},"http-webhook-subscriptio