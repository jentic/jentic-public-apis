given endpoint."},"id":{"type":"string","description":"The phone number or device\/extension. Phone numbers will be in E164 notation."},"state":{"description":"The state of this call.","type":"string","enum":["progressing","ringing","active","ended"]},"name":{"description":"Name of the extension\/user","type":"string","nullable":true}},"description":"Where the call originated"},"to":{"type":"object","properties":{"call_id":{"type":"string","description":"The unique id of this call."},"user":{"type":"integer","description":"The extension\/user id. `null` if a net2phone user is not involved.","format":"int32","nullable":true},"domain":{"nullable":true,"description":"The customer\/company associated with this call. Null if a net2phone domain is not involved on the given endpoint."},"is_human":{"type":"boolean"},"id":{"type":"string","description":"The phone number or device\/ext. Phone numbers will be in E164 notation. In case of auto-attendant, call queue or transfer from one extension to another, the call id will be the extension number instead of the phone number."},"state":{"description":"The state of this call.","type":"string","enum":["progressing","ringing","active","ended"]}},"description":"The destination of the call."},"time_answer":{"type":"string","description":"When the end user picked up the call. `null` for ringing event.","format":"date-time","nullable":true}}}}},"call":{"type":"object","description":"Body of create call request","title":"Create Call","required":["to"],"properties":{"auto_answer":{"default":false,"type":"boolean","x-n2p-supportedGenerations":["gen_v"],"description":"Should this caller side be auto answered. (Note. It may not be supported by the answering device.)\n\nSupported in the following net2phone account generations: Gen V","nullable":true},"from":{"type":"string","description":"For Gen P and Gen V accounts the `from` parameter is the authenticated user id where this call originates from. For Gen U and Gen X accounts the `from` parameter can be the user phone number or the user extension. Exceptions: For Gen V you can also use the SIP user.\n\nSupported in the following net2phone account generations: Gen P, Gen X, Gen U, Gen V","nullable":true,"x-n2p-supportedGenerations":["gen_p","gen_x","gen_u","gen_v"]},"to":{"description":"The destination for this call. All Generations accounts allow the use of E.164 phone number and extensions. Exception: Gen V accounts also allow the use of SIP user.\n\nSupported in the following net2phone account generations: Gen P, Gen X, Gen U, Gen V","type":"string","x-n2p-supportedGenerations":["gen_p","gen_x","gen_u","gen_v"]}}},"endpoints":{"items":{"description":"Endpoint descriptions","type":"string","enum":["password_grant","refresh_token_grant","place_call","read_subscription","delete_subscription","create_subscription","refresh_subscription","cdrs"]},"type":"array","description":"List of available endpoints","title":"Available endpoints","uniqueItems":true},"webhook-subscription-settings-common":{"type":"object","properties":{"user":{"default":"*","type":"string","description":"One or more users to subscribe to. Omit to subscribe to all users webhooks.\nAppend multiple times to subscribe to multiple users."},"calls":{"default":false,"type":"boolean","description":"Subscribe to call events"},"cdrs":{"default":false,"type":"boolean","description":"Subscribe to CDR events"},"expires_in":{"default":7200,"type":"integer","format":"int32","description":"The number of seconds until the webhook subscription expires","maximum":604800},"recordings":{"default":false,"type":"boolean","description":"Subscribe to recording events"}}},"account":{"type":"object","description":"Details about the user's account number and generation","title":"Account generation","required":["domain","generation"],"properties":{"package":{"type":"string","description":"Type of plan (tier) that a net2phone Canada client pays for to get services.\n\nSupported in the following net2phone account 