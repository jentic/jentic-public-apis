{"openapi":"3.0.3","info":{"title":"SuppCo Public API","description":"Read-only public supplement data: products, brands, TrustScores, nutrients, protocols, research effects, goals, lab tests, and articles. For agents, prefer the MCP server at https://api.supp.co/mcp. Documentation: https://supp.co/developers.","termsOfService":"https://supp.co/terms","contact":{"name":"SuppCo Partnerships","email":"partners@supp.co"},"version":"1.0.0"},"servers":[{"url":"https://api.supp.co"}],"paths":{"/api/products":{"get":{"tags":["products"],"summary":"List and search for Products","description":"","operationId":"listProducts","parameters":[{"name":"query","in":"query","description":"Search query for brand, name, supplements, or UPC","required":false,"schema":{"type":"string"},"examples":{"searchBrand":{"value":"Nature Made","summary":"Search for brand Nature Made"},"searchName":{"value":"Vitamin D3 10,000 IU Softgels","summary":"Search for name of Walgreens Vitamin D"}}},{"name":"upc","in":"query","schema":{"type":"string"},"description":"Search query for UPC","examples":{"searchUPC":{"value":"31191702201","summary":"Search for a single UPC"}}},{"name":"upcs","in":"query","schema":{"type":"string"},"description":"Search query for multiple comma separated UPCs","examples":{"searchUPCs":{"value":"31191702201,3390210420","summary":"Search for multiple UPCs"}}},{"name":"amazonProductID","in":"query","schema":{"type":"string"},"description":"Search query for Amazon Product ID","examples":{"searchAmazonProductID":{"value":"B0000D9N7E","summary":"Search for a single Amazon Product ID"}}},{"name":"shopifyVariantID","in":"query","schema":{"type":"string"},"description":"Search query for Shopify Variant ID","examples":{"searchShopifyVariantID":{"value":"123456789","summary":"Search for a single Shopify Variant ID"}}},{"name":"search_session_id","in":"query","required":false,"schema":{"type":"string"},"description":"Client-minted id for one search session, shared with /api/products/filter and /api/shop/products. When present with `query`, the typeahead query is recorded into that session's product search row. Only `query` (and `client_key` when sent) is written, so the category, filters, sort and result count a /filter request set on the same row are kept. Omit it on page-load/prefetch requests."},{"name":"client_key","in":"query","required":false,"schema":{"type":"string"},"description":"Surface tag for the captured search (e.g. `products`). Kept on the row when a later request omits it. No effect without `search_session_id`."}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CachedProduct"}},"example":[{"name":"Vitamin C 200mg","brand":"Nature Made"},{"name":"AG1","brand":"Athletic Greens"}]}}}},"security":[]}},"/api/products/{slug}":{"get":{"tags":["products"],"summary":"Get a single Product","description":"","operationId":"showProduct","parameters":[{"name":"slug","in":"path","description":"Unique identifier slug","required":true,"schema":{"type":"string"},"examples":{"vitamin_d":{"value":"walgreens-vitamin-d3-10000-iu-softgels-31191702201","summary":"Slug for Walgreens Vitamin D"}}}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CachedProduct"},"example":[{"name":"Vitamin C 200mg","brand":"Nature Made"}]}}}},"security":[]}},"/api/products/{slug}/alternatives":{"get":{"tags":["products"],"summary":"Get Product Alternatives","operationId":"getProductAlternatives","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"},"description":"Product slug"}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProductAlternatives"}}}}},"security":[]}},"/api/products/{product_id}/lab-results":{"get":{"tags":["products"],"summary":"Get Independent Lab Testing Results for a Product","description":"Returns Certificate of Analysis (COA) results for a product, grouped by\ncanonical analyte. Each canonical analyte has a single `most_recent` round\nplus a `history` array of older rounds. Both `published` and `archived`\nCOA→product links contribute, so disjoint-analyte COAs (e.g. one COA\nfor Vitamin D3 and a separate COA for Vitamin K1/K2 on the same\nproduct) both surface their unique canonicals.\n\nPicking is per canonical analyte. The selector prefers the newest\n`active` round (ops nominates which rounds are live by leaving them\nactive), and falls back to the newest of all surfaceable rounds when\nno active round exists for that canonical. Demoted/inactive rounds\nstill appear in `history` for the audit trail. Rows in `pending` /\n`needs_manual_review` / `suppressed` states are excluded.\n\nEntries in `lab_results` are sorted alphabetically by `display_name`\n(case-insensitive) so FE rendering order is stable across requests.\n\nThe response is unauthenticated and ships with a `public, max-age=…`\n`Cache-Control` header so it can be cached on a shared CDN per\nproduct. Edits to the underlying COA/result rows are visible on the\nnext request after the CDN TTL elapses.\n","operationId":"getProductLabResults","parameters":[{"name":"product_id","in":"path","required":true,"schema":{"type":"string"},"description":"Product UUID or slug"}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"type":"object","properties":{"product_id":{"type":"string","format":"uuid"},"has_lab_results":{"type":"boolean","description":"True iff at least one canonical-analyte entry survived all surface filters; FE can short-circuit the PDP \"Lab Testing\" panel on this flag."},"lab_results":{"type":"array","items":{"type":"object","properties":{"canonical_analyte_id":{"type":"string","format":"uuid","description":"For sum_group rounds whose members span multiple canonicals, this is the\nprimary canonical (lowest coa_result_index member).\n"},"display_name":{"type":"string","description":"For sum_group rounds this is the group's optional ops-set display name\n(the \"Summed Group Module\" label). When no name is set it falls back to a\ncomma-joined string of the members' canonical names (e.g.\n\"Vitamin A (Retinol Palmitate), Vitamin A (Beta Carotene)\"). For\nsingle-assay rounds it is the canonical analyte's display name.\n"},"category":{"type":"string","nullable":true,"description":"Pass-through of `Supplement#category` (`IngredientCategory` —\ne.g. `vitamin`, `mineral`, `amino acid`, `botanical`, `peptide`).\nLooked up by matching the canonical analyte's display name to\n`Supplement#name`. Nullable when no matching supplement record\nexists.\n"},"optional_description":{"type":"string","nullable":true},"test_date":{"type":"string","format":"date","nullable":true},"label_claim_pct":{"type":"number","nullable":true,"description":"Percent of label claim, rounded to the nearest whole number. Uncapped — values \u003e100 are normal (brands typically overdose to retain potency through expiration)."},"pass_fail_status":{"type":"string","enum":["pass","fail"],"description":"Surfaced rows are always pass or fail. Pending / needs_manual_review rows are filtered out before they reach the FE."},"lab_name":{"type":"string","nullable":true,"description":"ISO 17025 accredited lab that ran the assay."},"measured_amount":{"type":"number","nullable":true,"description":"The lab-measured amount in `measured_units`, in the same unit family as the label claim.\nFor sum groups this is the sum across constituent assays.\n"},"measured_units":{"type":"string","nullable":true},"target_amount":{"type":"number","nullable":true,"description":"The label claim the result is being measured against."},"target_units":{"type":"string","nullable":true},"undisclosed_on_label":{"type":"boolean","description":"True when the canonical analyte being measured is not on the supplement-facts label\n(e.g. Withanolides from Ashwagandha, Silymarins from Milk Thistle). Lets the FE\nrender an \"undisclosed on label\" hint. For sum_group rounds, true iff every\nconstituent member is flagged.\n"},"attempt_number":{"type":"integer","description":"1-indexed chronological ordinal of this test for this canonical analyte (oldest = 1)."},"total_attempts":{"type":"integer","description":"Total number of rounds for this canonical analyte (most_recent + history.length)."},"most_recent":{"type":"boolean"},"history":{"type":"array","items":{"type":"object","properties":{"test_date":{"type":"string","format":"date","nullable":true},"label_claim_pct":{"type":"number","nullable":true},"pass_fail_status":{"type":"string","enum":["pass","fail"]},"lab_name":{"type":"string","nullable":true},"measured_amount":{"type":"number","nullable":true},"measured_units":{"type":"string","nullable":true},"target_amount":{"type":"number","nullable":true},"target_units":{"type":"string","nullable":true},"undisclosed_on_label":{"type":"boolean"},"attempt_number":{"type":"integer"}}}}}}}}}}}},"404":{"description":"Product not found"}},"security":[]}},"/api/brands":{"get":{"tags":["brands"],"summary":"List Brands","description":"List, search, and paginate Brands","operationId":"indexBrands","parameters":[{"name":"query","description":"Search query for name","in":"query","required":true,"schema":{"type":"string"},"examples":{"searchName":{"value":"Nature Made","summary":"Search names for Nature Made"}}}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/BrandIndex"}},"example":[{"name":"Nature Made","slug":"nature-made"},{"name":"Athletic Greens","slug":"athletic-greens"}]}}}},"security":[]}},"/api/brands/{slug}":{"get":{"tags":["brands"],"summary":"Show a Brand","description":"Show a single Brand with associated Products","operationId":"showBrand","parameters":[{"name":"slug","in":"path","description":"Slug","required":true,"schema":{"type":"string"},"examples":{"nature-made":{"value":"nature-made","summary":"Nature Made"}}}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BrandShow"}}}}},"security":[]}},"/api/brands/{slug}/products":{"get":{"tags":["brands"],"summary":"List Brand Products","operationId":"getBrandProducts","parameters":[{"name":"slug","in":"path","required":true,"schema":{"type":"string"},"description":"Brand slug"}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/CachedProduct"}}}}}},"security":[]}},"/api/brands/{slug}/top_products":{"get":{"tags":["brands"],"summary":"Get Top Products for a Brand","description":"Returns the top products for a brand organized by format (capsule, softgel, etc.) and health goal (bone-health, immune-support, etc.).\n\n**What it returns:**\n- Top 4 products per format (ranked by popularity)\n- Top 4 products per health goal (ranked by popularity)\n- Products are ranked by popularity (number of times added to user stacks); the underlying count is not exposed in the payload\n\nThis endpoint helps users discover the most popular products from a brand in specific formats or for specific health goals.\n","operationId":"getBrandTopProducts","parameters":[{"name":"slug","in":"path","description":"Brand slug","required":true,"schema":{"type":"string"},"examples":{"thorne":{"value":"thorne","summary":"Thorne Research"},"nordic-naturals":{"value":"nordic-naturals","summary":"Nordic Naturals"}}}],"responses":{"200":{"description":"Successfully retrieved top products","content":{"application/json":{"schema":{"type":"object","required":["all","by_format","by_health_goal"],"properties":{"all":{"type":"array","description":"Flat, deduplicated union of the health-goal buckets, ordered by\npopularity (most-stacked first). The underlying count is not exposed.\n","items":{"$ref":"#/components/schemas/ProductCard"},"example":[{"id":"3fa85f64-5717-4562-b3fc-2c963f66afa6","slug":"vitamin-d3-5000-iu","name":"Vitamin D3 5000 IU","brand":"Thorne"}]},"by_format":{"type":"object","description":"Top products grouped by product format","additionalProperties":{"type":"array","items":{"$ref":"#/components/schemas/ProductCard"}},"example":{"capsule":[{"id":"3fa85f64-5717-4562-b3fc-2c963f66afa6","slug":"vitamin-d3-5000-iu","name":"Vitamin D3 5000 IU","brand":"Thorne","format":"capsule"}],"softgel":[{"id":"4gb96f75-6828-5673-c4gd-3d074g77bgb7","slug":"omega-3-fish-oil","name":"Omega-3 Fish Oil","brand":"Thorne","format":"softgel"}]}},"by_health_goal":{"type":"object","description":"Top products grouped by health goal","additionalProperties":{"type":"array","items":{"$ref":"#/components/schemas/ProductCard"}},"example":{"bone-health":[{"id":"3fa85f64-5717-4562-b3fc-2c963f66afa6","slug":"vitamin-d3-5000-iu","name":"Vitamin D3 5000 IU","brand":"Thorne"}],"immune-support":[{"id":"5hc07g86-7939-6784-d5he-4e185h88chc8","slug":"vitamin-c-1000-mg","name":"Vitamin C 1000 mg","brand":"Thorne"}]}}}}}}},"404":{"description":"Brand not found"}},"security":[]}},"/api/brands/highest_trust_score":{"get":{"tags":["brands"],"summary":"Get Top 10 Brands by Trust Score","description":"Returns the top 10 brands ranked by trust score.\n\n**Performance \u0026 Caching:**\n- Response is cached for 1 day (24 hours)\n- Data is returned immediately from cache\n- Cache is public (can be cached by CDNs and browsers)\n\n**What it returns:**\n- Top 10 brands with highest trust scores\n- Brands must have a trust score greater than 0\n- Sorted by trust score in descending order\n\nThis endpoint helps users discover the most trusted brands on the platform.\n","operationId":"getBrandsHighestTrustScore","responses":{"200":{"description":"Successfully retrieved highest trust score brands","headers":{"Cache-Control":{"schema":{"type":"string"},"description":"public, max-age=86400"}},"content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Brand"}},"example":[{"name":"Thorne","slug":"thorne","trust_score":95.5,"logo":"https://example.com/thorne-logo.png"},{"name":"Pure Encapsulations","slug":"pure-encapsulations","trust_score":94.2,"logo":"https://example.com/pure-encapsulations-logo.png"}]}}}},"security":[]}},"/api/nutrients":{"get":{"tags":["nutrients"],"summary":"List Nutrients","description":"List and paginate Nutrients (formerly Supplements)","operationId":"indexNutrients","parameters":[{"name":"page","in":"query","description":"Page number","required":false,"schema":{"type":"integer"},"examples":{"first":{"value":1,"summary":"The first page"}}},{"name":"filter=featured","in":"query","description":"Filter for featured Nutrients","required":false,"schema":{"type":"boolean"},"examples":{"first":{"value":true,"summary":"Return only featured Nutrients"}}}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/NutrientSummary"}}}}}},"security":[]}},"/api/nutrients/{slug}":{"get":{"tags":["nutrients"],"summary":"Show a Nutrient","description":"Show a single Nutrient with associated Effects","operationId":"showNutrient","parameters":[{"name":"slug","in":"path","description":"Slug","required":true,"schema":{"type":"string"},"examples":{"vitamin_d":{"value":"vitamin-d","summary":"Vitamin D"}}}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/NutrientDetail"}}}}},"security":[]}},"/api/protocols/{slug}":{"get":{"tags":["protocols"],"summary":"Show a Protocol","description":"Returns a protocol only when it is public.","operationId":"showProtocol","parameters":[{"name":"slug","in":"path","description":"Slug","required":true,"schema":{"type":"string"},"examples":{"first":{"value":"tim-ferriss-longevity-protocol","summary":"Tim Ferris Longevity Protocol"}}}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Protocol"}}}},"404":{"description":"Protocol not found or not public"}},"security":[]}},"/api/product_categories":{"get":{"tags":["product_categories"],"summary":"List Product Categories","description":"Get a list of all product categories, optionally filtered by search query","operationId":"listProductCategories","parameters":[{"name":"query","in":"query","description":"Search query to filter categories by name or ID","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ProductCategory"}}}}}},"security":[]}},"/api/product_categories/{id}":{"get":{"tags":["product_categories"],"summary":"Get Product Category by ID","description":"Get a specific product category by ID or slug. Uses hybrid matching to find the best match.","operationId":"getProductCategory","parameters":[{"name":"id","in":"path","description":"Product category ID or slug","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ProductCategory"}}}},"302":{"description":"Redirect to canonical product category"},"404":{"description":"Product category not found"}},"security":[]}},"/api/product_categories/{id}/top_products":{"get":{"tags":["product_categories"],"summary":"List Top Products for Category","operationId":"listProductCategoryTopProducts","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"},"description":"Resource ID"},{"name":"page","in":"query","required":false,"schema":{"type":"integer"},"description":"Page number"}],"responses":{"200":{"description":"Successful operation"}},"security":[]}},"/api/health_effects/{id}":{"get":{"tags":["health_effects"],"summary":"Get Health Effect by ID","description":"Returns a single health effect with its associated papers","operationId":"getHealthEffect","parameters":[{"name":"id","in":"path","description":"ID of the health effect to retrieve","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthEffect"}}}},"404":{"$ref":"#/components/responses/NotFound"}},"security":[]}},"/api/health_goals":{"get":{"tags":["health_goals"],"summary":"List Health Goals","description":"List all health goals with their associated subgoals","operationId":"listHealthGoals","responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/HealthGoal"}}}}}},"security":[]}},"/api/health_goals/{id}":{"get":{"tags":["health_goals"],"summary":"Get Health Goal by ID","description":"Returns a single health goal with its associated subgoals","operationId":"getHealthGoal","parameters":[{"name":"id","in":"path","description":"ID of the health goal to retrieve","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthGoalDetail"}}}},"404":{"$ref":"#/components/responses/NotFound"}},"security":[]}},"/api/biomarkers":{"get":{"tags":["biomarkers"],"summary":"List Biomarkers","operationId":"listBiomarkers","parameters":[{"name":"page","in":"query","required":false,"schema":{"type":"integer"},"description":"Page number"}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Biomarker"}}}}}},"security":[]}},"/api/biomarkers/{id}":{"get":{"tags":["biomarkers"],"summary":"Get Biomarker","operationId":"getBiomarker","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"},"description":"Resource ID"}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BiomarkerDetail"}}}}},"security":[]}},"/api/tested_reports":{"get":{"tags":["tested_reports"],"summary":"List Tested Reports","description":"List all published tested reports with pagination","operationId":"listTestedReports","parameters":[{"name":"page","in":"query","description":"Page number for pagination","required":false,"schema":{"type":"integer","default":1}},{"name":"per_page","in":"query","description":"Number of items per page","required":false,"schema":{"type":"integer","default":10}}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/TestedReport"}}}}}},"security":[]}},"/api/tested_reports/{id}":{"get":{"tags":["tested_reports"],"summary":"Get Tested Report by slug","description":"Returns a single published tested report by its slug","operationId":"getTestedReport","parameters":[{"name":"id","in":"path","description":"Slug of the tested report to retrieve","required":true,"schema":{"type":"string","example":"berberine"}}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TestedReport"}}}},"404":{"$ref":"#/components/responses/NotFound"}},"security":[]}},"/api/documents/{slug}":{"get":{"tags":["documents"],"summary":"Get a document by slug","operationId":"getDocument","parameters":[{"name":"slug","in":"path","description":"Slug of the document to retrieve. A document's alternate slug (kept after a slug correction) also resolves.","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"Document found","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Document"}}}},"404":{"$ref":"#/components/responses/NotFound"},"500":{"$ref":"#/components/responses/InternalServerError"}},"security":[]}},"/api/searches/autocomplete":{"get":{"tags":["searches"],"summary":"Search Autocomplete","operationId":"searchAutocomplete","parameters":[{"name":"query","in":"query","required":true,"schema":{"type":"string"},"description":"Search query prefix"}],"responses":{"200":{"description":"Successful operation","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/AutocompleteSuggestion"}}}}}},"security":[]}}},"components":{"schemas":{"CachedProduct":{"type":"object","description":"Product payload served from ProductCache (ProductSerializer.find_all + ProductDto#as_json). Every key is always emitted.","required":["active_fda_recall","active_fda_recall_body","active_fda_recall_header","active_fda_recall_url","added_to_tested_by_suppco_at","additional_categories","additional_category_ids","archived","average_excipient_risk_rating","best_value","brand","brand_active_fda_recall","brand_id","brand_practitioner_grade_integration","brand_supple100","brand_trust_score","brand_trust_score_percentile","brand_trust_score_state","brand_trust_score_updated_at","category","category_name","certified","community_insights","contains_proprietary_blend","country_of_manufacture","eurofins_certified_supplement","eurofins_clean_sport_certified","excipients","failed_any_tests","faq_questions","fda_warning_letter_url","featured","format","free_from_artificial_colors_flavors_fillers","gluten_free_certified","gluten_free_ingredients","health_goals","heavy_metals_testing","heavy_metals_testing_public_explanation","id","identity_potency_testing","identity_potency_testing_public_explanation","igen_non_gmo_tested","image_url","informed_choice_certified","informed_sport_certified","intro_paragraph","label_url","mislabeled_principal_display_panel","most_popular","most_trusted","msrp","name","non_gmo_certified","non_gmo_ingredients","nsf_certified_for_sport","nsf_contents_certified","off_market","organic_ingredients","other_ingredients","patented_or_trademarked_ingredients","price","price_per_serving","price_per_serving_percentile_in_category","product_ingredients","product_line","product_trust_score","product_trust_score_complete","product_trust_score_complete_at","product_trust_score_percentile_in_category","product_trust_score_status","purchase_links","received_fda_warning_letter","resolved_fda_warning_letter","serving_size","servings_per_container","similar_products","slug","stacks_count_percentile_in_category","suggested_use","suppco_testing_headline","suppco_testing_sub_header","supplement_count","supplement_names","tested_by_suppco","transparent_batch_specific_coas","trending_percentage_30d","trust_clinical_study_url","trust_clinical_study_url2","trust_clinical_study_url3","trust_clinically_studied_product","trust_score_details","trust_score_suppressed","upc","usda_organic_certified","usp_verified","validated","vegan_action_certified","vegan_friendly_ingredients"],"properties":{"active_fda_recall":{"type":"boolean","nullable":true},"active_fda_recall_body":{"type":"string","nullable":true},"active_fda_recall_header":{"type":"string","nullable":true},"active_fda_recall_url":{"type":"string","nullable":true},"added_to_tested_by_suppco_at":{"type":"string","format":"date-time","nullable":true},"additional_categories":{"type":"array","items":{"type":"object","required":["id","name"],"properties":{"id":{"type":"string"},"name":{"type":"string"}}}},"additional_category_ids":{"type":"array","items":{"type":"string"}},"archived":{"type":"boolean","nullable":true},"average_excipient_risk_rating":{"type":"string","nullable":true},"best_value":{"type":"boolean"},"brand":{"type":"string"},"brand_active_fda_recall":{"type":"boolean","nullable":true},"brand_id":{"type":"string","nullable":true},"brand_practitioner_grade_integration":{"type":"boolean","nullable":true},"brand_supple100":{"type":"boolean","nullable":true},"brand_trust_score":{"type":"string","nullable":true,"description":"Decimal column serialized as a string (for example \"0.95\")."},"brand_trust_score_percentile":{"type":"string","nullable":true,"description":"Decimal column serialized as a string (for example \"0.95\")."},"brand_trust_score_state":{"type":"string","nullable":true},"brand_trust_score_updated_at":{"type":"string","format":"date-time","nullable":true},"category":{"type":"string","nullable":true},"category_name":{"type":"string","nullable":true},"certified":{"type":"boolean","nullable":true},"community_insights":{"type":"object"},"contains_proprietary_blend":{"type":"boolean","nullable":true},"country_of_manufacture":{"type":"string","nullable":true},"eurofins_certified_supplement":{"type":"boolean","nullable":true},"eurofins_clean_sport_certified":{"type":"boolean","nullable":true},"excipients":{"type":"array","items":{"type":"object"}},"failed_any_tests":{"type":"boolean"},"faq_questions":{"type":"string","description":"JSON-encoded array of FAQ entries (the raw jsonb column text, not a decoded array)."},"fda_warning_letter_url":{"type":"string","nullable":true},"featured":{"type":"boolean","nullable":true},"format":{"type":"string","nullable":true},"free_from_artificial_colors_flavors_fillers":{"type":"boolean","nullable":true},"gluten_free_certified":{"type":"boolean","nullable":true},"gluten_free_ingredients":{"type":"boolean","nullable":true},"health_goals":{"type":"array","nullable":true,"items":{"type":"string"}},"heavy_metals_testing":{"type":"string","nullable":true},"heavy_metals_testing_public_explanation":{"type":"string","nullable":true},"id":{"type":"string","format":"uuid"},"identity_potency_testing":{"type":"string","nullable":true},"identity_potency_testing_public_explanation":{"type":"string","nullable":true},"igen_non_gmo_tested":{"type":"boolean","nullable":true},"image_url":{"type":"string","nullable":true},"informed_choice_certified":{"type":"boolean","nullable":true},"informed_sport_certified":{"type":"boolean","nullable":true},"intro_paragraph":{"type":"string","nullable":true},"label_url":{"type":"string","nullable":true},"mislabeled_principal_display_panel":{"type":"boolean","nullable":true},"most_popular":{"type":"boolean"},"most_trusted":{"type":"boolean"},"msrp":{"type":"string","nullable":true,"description":"Decimal column serialized as a string (for example \"0.95\")."},"name":{"type":"string"},"non_gmo_certified":{"type":"boolean","nullable":true},"non_gmo_ingredients":{"type":"boolean","nullable":true},"nsf_certified_for_sport":{"type":"boolean","nullable":true},"nsf_contents_certified":{"type":"boolean","nullable":true},"off_market":{"type":"boolean","nullable":true},"organic_ingredients":{"type":"boolean","nullable":true},"other_ingredients":{"type":"string","nullable":true},"patented_or_trademarked_ingredients":{"type":"boolean","nullable":true},"price":{"type":"string","nullable":true,"description":"Decimal column serialized as a string (for example \"0.95\")."},"price_per_serving":{"type":"string","nullable":true,"description":"Decimal column serialized as a string (for example \"0.95\")."},"price_per_serving_percentile_in_category":{"type":"number","nullable":true},"product_ingredients":{"type":"array","items":{"type":"object"}},"product_line":{"type":"string","nullable":true},"product_trust_score":{"type":"string","nullable":true,"description":"Decimal column serialized as a string (for example \"0.95\")."},"product_trust_score_complete":{"type":"boolean","nullable":true},"product_trust_score_complete_at":{"type":"string","format":"date-time","nullable":true},"product_trust_score_percentile_in_category":{"type":"number","nullable":true},"product_trust_score_status":{"type":"string"},"purchase_links":{"type":"array","items":{"type":"object"}},"received_fda_warning_letter":{"type":"boolean","nullable":true},"resolved_fda_warning_letter":{"type":"boolean"},"serving_size":{"type":"string","nullable":true},"servings_per_container":{"type":"number","nullable":true},"similar_products":{"type":"array","items":{"type":"object"}}