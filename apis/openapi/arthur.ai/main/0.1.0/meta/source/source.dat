            "type": "boolean",
            "title": "Allow Any Column Type",
            "description": "Indicates if this metric parameter can accept any column type.",
            "default": false
          },
          "parameter_type": {
            "type": "string",
            "const": "column",
            "title": "Parameter Type",
            "default": "column"
          }
