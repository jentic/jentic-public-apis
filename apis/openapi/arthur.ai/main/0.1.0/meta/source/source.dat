          "description": {
            "type": "string",
            "title": "Description",
            "description": "Description of the parameter."
          },
          "tag_hints": {
            "items": {
              "$ref": "#/components/schemas/ScopeSchemaTag"
            },
            "type": "array",
            "title": "Tag Hints",
