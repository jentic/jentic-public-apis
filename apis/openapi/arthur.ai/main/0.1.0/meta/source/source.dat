                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Policies V1"
        ],
        "summary": "List Assignment Attestations",
        "description": "Lists attestation history for a policy assignment. Requires policy_assignment_list_attestations permission.",
        "operationId": "list_assignment_attestations",
        "security": [
          {
            "OAuth2AuthorizationCode": [
              "policy_assignment_list_attestations"
            ]
          }
        ],
        "parameters": [
          {
            "name": "assignment_id",
