            "title": "Allow List",
            "description": "Optional. List of strings to pass PII validation."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PIIConfig",
        "example": {
          "allow_list": [
            "arthur.ai",
            "Arthur"
          ],
