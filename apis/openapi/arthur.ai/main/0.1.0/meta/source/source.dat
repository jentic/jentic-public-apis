            "anyOf": [
              {
                "items": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ScalarType"
                    },
                    {
                      "$ref": "#/components/schemas/ObjectType"
                    },
                    {
                      "$ref": "#/components/schemas/ListType"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
