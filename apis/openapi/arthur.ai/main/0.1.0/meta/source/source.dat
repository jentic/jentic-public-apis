              },
              {
                "$ref": "#/components/schemas/DiscoverAgentsJobSpec"
              },
              {
                "$ref": "#/components/schemas/CompliancePolicyCheckJobSpec"
              },
              {
                "$ref": "#/components/schemas/ScheduleComplianceJobsJobSpec"
              }
            ],
