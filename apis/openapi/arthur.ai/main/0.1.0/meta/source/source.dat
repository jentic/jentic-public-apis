            "items": {
              "$ref": "#/components/schemas/Dimension"
            },
            "type": "array",
            "title": "Dimensions",
            "description": "List of dimensions for the value."
          }
        },
        "type": "object",
        "required": [
          "test_run_id",
          "metric_name",
          "timestamp",
          "value",
          "dimensions"
        ],
