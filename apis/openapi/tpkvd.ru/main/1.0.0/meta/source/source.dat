        "description": "Осуществить запрос переноса даты работы по отгрузке, связанной с сделкой / сервисной заявкой",
        "operationId": "ConfirmDate",
        "requestBody": {
          "description": "Поля для запроса переноса",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmDate"
              }
            },
            "application/xml": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmDate"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmDate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Успешная операция",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "reschedule_id": {
                        "type": "string",
                        "example": "4879511"
                      },
                      "message": {
                        "type": "string",
                        "example": "Заявка на перенос отправлена менеджеру"
                      },
                      "status": {
                        "type": "string",
                        "example": "pending"
                      },
                      "manager_notified": {
                        "type": "boolean",
                        "example": true
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некорректные исходные данные или ошибка на сервере"
          },
          "default": {
            "description": "Неизвестная ошибка",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
