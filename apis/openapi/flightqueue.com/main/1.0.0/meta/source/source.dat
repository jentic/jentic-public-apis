{"openapi":"3.1.0","info":{"title":"FlightQueue API","version":"1.0.0","description":"Real-time airport intelligence: security wait times, FAA delays, ML predictions, and historical patterns for 8,000+ airports.","termsOfService":"https://flightqueue.com/terms","contact":{"name":"FlightQueue API","url":"https://flightqueue.com/features/agent-access","email":"api@flightqueue.com"}},"servers":[{"url":"https://flightqueue.com/api/v1"}],"security":[{"BearerAuth":[]},{"ApiKeyAuth":[]}],"paths":{"/airports":{"get":{"operationId":"listAirports","summary":"List supported airports","parameters":[{"name":"country","in":"query","schema":{"type":"string"},"description":"Filter by ISO country code"},{"name":"limit","in":"query","schema":{"type":"integer","default":50,"maximum":200}},{"name":"page","in":"query","schema":{"type":"integer","default":1,"minimum":1}}],"responses":{"200":{"description":"Airport directory page"},"401":{"description":"Missing or invalid API key"},"429":{"description":"Rate limit exceeded"}}}},"/airports/bulk":{"post":{"operationId":"bulkWaitTimes","summary":"Bulk wait times (Enterprise)","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["codes"],"properties":{"codes":{"type":"array","items":{"type":"string","pattern":"^[A-Z]{3}$"}}}}}}},"responses":{"200":{"description":"Bulk wait time estimates"},"403":{"description":"Enterprise tier required"}},"x-payment-info":{"intent":"session","method":"stripe","amount":"49900","currency":"usd","description":"Enterprise API plan, 100,000 calls/month included. Subscribe at https://flightqueue.com/pricing"}}},"/alerts":{"post":{"operationId":"createWaitTimeAlert","summary":"Create or update a wait time alert","description":"Requires a user-scoped key. The airport must have a live wait time feed.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["airportCode","thresholdMinutes"],"properties":{"airportCode":{"type":"string","pattern":"^[A-Za-z]{3}$"},"thresholdMinutes":{"type":"integer","minimum":1},"direction":{"type":"string","enum":["above","below"],"default":"above"}}}}}},"responses":{"200":{"description":"Alert saved"},"400":{"description":"Invalid body, airport code, or airport without a live feed"},"401":{"description":"Endpoint requires a user-scoped key"}}}},"/airports/{iata}/wait-times":{"get":{"operationId":"getWaitTimes","summary":"Current security, check-in, and immigration wait estimates","parameters":[{"name":"iata","in":"path","required":true,"schema":{"type":"string","pattern":"^[A-Z]{3}$"}}],"responses":{"200":{"description":"Current wait time estimates"},"403":{"description":"Premium subscription required"}},"x-payment-info":{"intent":"session","method":"stripe","amount":"9900","currency":"usd","description":"Pro API plan, 5,000 calls/month included. Subscribe at https://flightqueue.com/pricing"}}},"/airports/{iata}/predictions":{"get":{"operationId":"getPredictions","summary":"Hourly wait time predictions","parameters":[{"name":"iata","in":"path","required":true,"schema":{"type":"string","pattern":"^[A-Z]{3}$"}},{"name":"date","in":"query","schema":{"type":"string","format":"date"},"description":"Forecast date (YYYY-MM-DD, default today)"}],"responses":{"200":{"description":"Hourly predictions"},"403":{"description":"Premium subscription required"}},"x-payment-info":{"intent":"session","method":"stripe","amount":"9900","currency":"usd","description":"Pro API plan, 5,000 calls/month included. Subscribe at https://flightqueue.com/pricing"}}},"/airports/{iata}/delays":{"get":{"operationId":"getDelays","summary":"FAA delay status for an airport","parameters":[{"name":"iata","in":"path","required":true,"schema":{"type":"string","pattern":"^[A-Z]{3}$"}}],"responses":{"200":{"description":"FAA delay information"}}}},"/airports/{iata}/historical":{"get":{"operationId":"getHistorical","summary":"Historical wait time patterns","parameters":[{"name":"iata","in":"path","required":true,"schema":{"type":"string","pattern":"^[A-Z]{3}$"}}],"responses":{"200":{"description":"Historical patterns"},"403":{"description":"Premium subscription required"}},"x-payment-info":{"intent":"session","method":"stripe","amount":"9900","currency":"usd","description":"Pro API plan, 5,000 calls/month included. Subscribe at https://flightqueue.com/pricing"}}}},"components":{"securitySchemes":{"BearerAuth":{"type":"http","scheme":"bearer","description":"Agent key (`fqagent_…`) from POST /api/agent/register, or developer key (`fq_live_…`) from https://flightqueue.com/pricing"},"ApiKeyAuth":{"type":"apiKey","in":"header","name":"X-API-Key","description":"Same keys as Bearer auth, sent via X-API-Key header"}}},"x-service-info":{"categories":["travel","data"],"docs":{"homepage":"https://flightqueue.com/features/agent-access","llms":"https://flightqueue.com/llms.txt","apiReference":"https://flightqueue.com/openapi.json"}}}