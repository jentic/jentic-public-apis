{
  "openapi": "3.1.0",
  "info": {
    "title": "GoRoost Partner API",
    "description": "API for partners to create property move-in requests.",
    "version": "1.1",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/helpthemove/goroost-partner-api/1.1"
  },
  "servers": [
    {
      "url": "https://data-hive.helpthemove.co.uk",
      "description": "Production Server"
    },
    {
      "url": "https://data-hive-clone.helpthemove.co.uk",
      "description": "Clone/Staging Server"
    }
  ],
  "paths": {
    "/goroost/create_move": {
      "post": {
        "summary": "Create a New Move",
        "description": "Registers a new move for a user, property, and associated details.",
        "operationId": "createMove",
        "tags": [
          "Moves"
        ],
        "requestBody": {
          "description": "The move object containing all details for the new move.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveRequest"
              },
              "example": {
                "move": {
                  "external_id": "4e3dbc66",
                  "switch_date": "2025-10-29",
                  "property": {
                    "address": {
                      "address_1": "Flat 3",
                      "address_2": "1 Bryanston Square",
                      "address_3": "",
                      "town": "London",
                      "county": "London",
                      "post_code": "W1H 2DH"
                    }
                  },
                  "branch": {
                    "name": "Test Branch",
                    "logo": "https://admin-helpthemove-assets.s3.amazonaws.com/uploads/branch/image/6/preview_download.jpg",
                    "htm_id": "38",
                    "htm_uuid": "HTM-035938"
                  },
                  "residents": [
                    {
                      "title": "Mr",
                      "first_name": "Postman",
                      "last_name": "Russell",
                      "email": "david+endtoendnogas9@underdawgs.co",
                      "date_of_birth": "1997-06-04",
                      "is_student": false,
                      "student_id_number": "",
                      "phone_number": "+447309257823"
                    }
                  ],
                  "residentialStatus": "Homeowner",
                  "electricVehicleOwner": true,
                  "council": "Bury",
                  "water_supplier": "United Utilities",
                  "energy_supplier": "Octupus Energy",
                  "electric_meter_serial": "13456",
                  "electric_meter_reading_1": "1221",
                  "electric_meter_reading_2": "9988",
                  "gas_meter_serial": "8456665",
                  "gas_meter_reading": "88543",
                  "water_meter_serial": "2000475574",
                  "water_meter_reading": "9000932277"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Move created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "status": "success",
                  "response": {}
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "UserExists": {
                    "summary": "Email already in use",
                    "value": {
                      "statusCode": 400,
                      "reason": "USED_EMAIL",
                      "message": "This email address is already registered. Try logging in or use a different email address.",
                      "args": {
                        "bubble_code": "1761730445432x364275445100446200"
                      }
                    }
                  },
                  "MissingParameter": {
                    "summary": "Missing required parameter",
                    "value": {
                      "status": "NOT_RUN",
                      "message": "The condition for the workflow create_move is not met. Workflow won't run"
                    }
                  },
                  "AuthError": {
                    "summary": "Authentication Error",
                    "value": {
                      "statusCode": 400,
                      "message": "Unrecognized authorization type"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "api_key",
        "description": "Partner API Key"
      }
    },
    "schemas": {
      "MoveRequest": {
        "title": "MoveRequest",
        "type": "object",
        "properties": {
          "move": {
            "$ref": "#/components/schemas/Move"
          }
        }
      },
      "Move": {
        "title": "Move",
        "type": "object",
        "required": [
          "switch_date",
          "property",
          "residents"
        ],
        "properties": {
          "external_id": {
            "type": "string",
            "description": "Optional partner-provided ID for their own reference."
          },
          "switch_date": {
            "type": "string",
            "format": "date",
            "description": "The date the user moves into the property (yyyy-mm-dd). Allowed range: up to 29 days in the future or 90 days in the past.",
            "example": "2025-10-29"
          },
          "property": {
            "$ref": "#/components/schemas/Property"
          },
          "branch": {
            "$ref": "#/components/schemas/Branch"
          },
          "residents": {
            "type": "array",
            "description": "A list of residents moving into the property. At least one is required.",
            "items": {
              "$ref": "#/components/schemas/Resident"
            },
            "minItems": 1
          },
          "residentialStatus": {
            "type": "string",
            "description": "Optional: The resident's status (e.g., Homeowner).",
            "example": "Homeowner"
          },
          "electricVehicleOwner": {
            "type": "boolean",
            "description": "Optional: Does the resident own an electric vehicle?"
          },
          "council": {
            "type": "string",
            "description": "Optional: The property's local council."
          },
          "water_supplier": {
            "type": "string",
            "description": "Optional: The property's water supplier."
          },
          "energy_supplier": {
            "type": "string",
            "description": "Optional: The property's energy supplier."
          },
          "electric_meter_serial": {
            "type": "string",
            "description": "Optional: Serial number for the electric meter."
          },
          "electric_meter_reading_1": {
            "type": "string",
            "description": "Optional: Primary electric meter reading."
          },
          "electric_meter_reading_2": {
            "type": "string",
            "description": "Optional: Secondary electric meter reading (if applicable)."
          },
          "gas_meter_serial": {
            "type": "string",
            "description": "Optional: Serial number for the gas meter."
          },
          "gas_meter_reading": {
            "type": "string",
            "description": "Optional: Gas meter reading."
          },
          "water_meter_serial": {
            "type": "string",
            "description": "Optional: Serial number for the water meter."
          },
          "water_meter_reading": {
            "type": "string",
            "description": "Optional: Water meter reading."
          }
        }
      },
      "Property": {
        "title": "Property",
        "type": "object",
        "required": [
          "address"
        ],
        "properties": {
          "address": {
            "$ref": "#/components/schemas/Address"
          }
        }
      },
      "Address": {
        "title": "Address",
        "type": "object",
        "required": [
          "address_1",
          "town",
          "county",
          "post_code"
        ],
        "properties": {
          "address_1": {
            "type": "string",
            "description": "First line of the address."
          },
          "address_2": {
            "type": "string",
            "description": "Optional: Second line of the address."
          },
          "address_3": {
            "type": "string",
            "description": "Optional: Third line of the address."
          },
          "town": {
            "type": "string",
            "description": "Town or city."
          },
          "county": {
            "type": "string",
            "description": "County."
          },
          "post_code": {
            "type": "string",
            "description": "Postcode."
          }
        }
      },
      "Branch": {
        "title": "Branch",
        "type": "object",
        "description": "Optional: Details of the partner branch.",
        "properties": {
          "name": {
            "type": "string"
          },
          "logo": {
            "type": "string",
            "format": "uri",
            "description": "URL to the branch logo."
          },
          "htm_id": {
            "type": "string"
          },
          "htm_uuid": {
            "type": "string"
          }
        }
      },
      "Resident": {
        "title": "Resident",
        "type": "object",
        "required": [
          "title",
          "first_name",
          "last_name",
          "email",
          "date_of_birth",
          "phone_number"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Resident's title.",
            "enum": [
              "Mr",
              "Mrs",
              "Miss",
              "Ms",
              "Mx",
              "Dr",
              "Prof",
              "Lady",
              "Sir",
              "Rev"
            ]
          },
          "first_name": {
            "type": "string",
            "description": "Resident's first name."
          },
          "last_name": {
            "type": "string",
            "description": "Resident's last name."
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Resident's unique email address."
          },
          "date_of_birth": {
            "type": "string",
            "format": "date",
            "description": "Resident's date of birth (yyyy-mm-dd)."
          },
          "is_student": {
            "type": "boolean",
            "description": "Optional: Is the resident a student?",
            "default": false
          },
          "student_id_number": {
            "type": "string",
            "description": "Optional: Student ID, if applicable."
          },
          "phone_number": {
            "type": "string",
            "description": "Resident's phone number (07######## or +447########).",
            "example": "+447123456789"
          }
        }
      },
      "SuccessResponse": {
        "title": "SuccessResponse",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "response": {
            "type": "object"
          }
        }
      },
      "ErrorResponse": {
        "title": "ErrorResponse",
        "type": "object",
        "description": "Generic error response. Fields will vary based on the error.",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 400
          },
          "status": {
            "type": "string",
            "example": "NOT_RUN"
          },
          "reason": {
            "type": "string",
            "example": "USED_EMAIL"
          },
          "message": {
            "type": "string",
            "example": "An error message."
          },
          "args": {
            "type": "object",
            "example": {
              "bubble_code": "1761730445432x364275445100446200"
            }
          }
        }
      }
    }
  }
}
