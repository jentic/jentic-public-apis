            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AugmentationActivity"
            }
          },
          "outputAugmentation": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AugmentationActivity"
            }
          },
          "graphFileInfo": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GraphFileInfo"
            }
          },
