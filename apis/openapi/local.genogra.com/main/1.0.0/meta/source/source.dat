    "parameters": {
      "FileIdParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "FileExtensionParam": {
        "name": "extension",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "FASTA",
            "FASTQ",
            "FASTQ_GZ",
            "VCF",
            "VCF_GZ",
            "GFA",
            "VG",
            "GAM",
            "SAM",
            "BAM",
            "JSON",
            "TSV",
            "CSV"
          ]
        }
      },
      "FileTypeParam": {
        "name": "fileType",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "GENOME",
            "VARIATION",
            "READS",
            "ALIGNMENT",
            "GRAPH",
            "GRAPHINDEX",
            "METADATA",
            "GRAPHLAYOUT",
            "GRAPHFILTERS",
            "GRAPHVISUALIZATION",
            "ANY"
          ]
        }
      },
      "GraphIdParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "ActivityTypeParam": {
        "name": "type",
        "in": "query",
        "required": true,
        "description": "The type of activity.",
        "schema": {
          "type": "string",
          "enum": [
            "UPLOAD",
            "ALIGNMENT",
            "CONSTRUCTION",
            "AUGMENTATION",
            "VISUALIZATION_CONVERSION",
            "VARIANT_CALLING",
            "ANY"
          ]
        }
      },
      "ActivityStatusParam": {
        "name": "status",
        "in": "query",
        "required": true,
        "description": "The status of the activity.",
        "schema": {
          "type": "boolean"
        }
      },
      "ActivityIdParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "NotificationUserIdParam": {
        "name": "userId",
        "in": "query",
        "required": true,
        "description": "Numeric identifier of the user to fetch notifications for.",
        "schema": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "example": "123"
        }
      },
      "NotificationLimitParam": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Maximum number of notifications to return. Defaults to 100 and cannot exceed the cache size.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 100,
          "example": 20
        }
      }
    },
