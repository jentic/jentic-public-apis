          "id": {
            "type": "integer",
            "example": 823
          },
          "userId": {
            "type": "integer",
            "example": 814
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "example": "2025-03-28T14:49:13.904Z"
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": null
          },
          "type": {
            "type": "string",
            "example": "UPLOAD"
          },
          "isCompleted": {
            "type": "boolean",
            "example": false
          }
