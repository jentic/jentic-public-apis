          "isUpload": {
            "type": "boolean"
          },
          "isDeleted": {
            "type": "boolean"
          },
          "upload": {
            "type": "integer"
          }
        },
        "required": [
          "userId",
          "name",
          "type"
        ]
      },
      "FileList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/File"
        }
      },
      "Update": {
        "type": "object",
