  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Use the Bearer token for authentication. The token should be provided in the Authorization header as \"Bearer {token}\"."
      }
    },
    "schemas": {
      "AuthenticatedUser": {
        "type": "object",
        "description": "The authenticated user object returned after login, from the OIDC provider.",
        "required": [
          "id_token",
          "access_token",
          "refresh_token",
          "profile"
        ],
        "properties": {
          "id_token": {
            "type": "string",
            "description": "The OIDC ID token",
            "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "access_token": {
            "type": "string",
            "description": "The access token for API calls",
            "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "refresh_token": {
            "type": "string",
            "description": "The token used to refresh the session",
            "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "profile": {
            "$ref": "#/components/schemas/UserProfile"
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "description": "User profile information returned from the OIDC provider.",
        "required": [
          "sub",
          "email"
        ],
        "properties": {
          "sub": {
            "type": "string",
            "description": "Unique stable identifier of the user from the identity provider",
            "example": "123456789"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User's email address",
            "example": "john.doe@example.com"
          },
          "given_name": {
            "type": "string",
            "description": "User's first name",
            "example": "John",
            "nullable": true
          },
          "family_name": {
            "type": "string",
            "description": "User's last name",
            "example": "Doe",
            "nullable": true
          },
          "preferred_username": {
            "type": "string",
            "description": "User's preferred username",
            "example": "johndoe",
            "nullable": true
          },
          "picture": {
            "type": "string",
            "format": "uri",
            "description": "URL of the user's profile picture",
            "example": "http://example.com/profile.jpg",
            "nullable": true
          }
        }
      },
      "AssemblyType": {
        "type": "string",
        "enum": [
          "SHORTPAIRED",
          "SHORTUNPAIRED",
          "LONG",
          "HYBRID"
        ],
        "example": "SHORTPAIRED",
        "description": "The type of assembly."
      },
      "VariationType": {
        "type": "string",
        "enum": [
          "VG_FROM_VCF",
          "VG_FROM_READS",
          "CACTUS"
        ],
        "example": "VG_FROM_VCF"
      },
      "UpdateActionType": {
        "type": "string",
        "enum": [
          "APPEND",
          "REPLACE",
          "PREPEND"
        ],
        "example": "APPEND",
        "description": "The action to perform on the file content."
      },
      "User": {
        "type": "object",
        "description": "The user object in the local database.",
        "required": [
          "id",
          "subAuth",
          "email",
          "registrationDate"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "The user ID.",
            "example": 1
          },
          "subAuth": {
            "type": "string",
            "description": "The sub zitadel identifier.",
            "example": "123456789"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "The email address of the user.",
            "example": "john.doe@example.com"
          },
          "givenName": {
            "type": "string",
            "description": "The first name of the user.",
            "example": "John",
            "nullable": true
          },
          "familyName": {
            "type": "string",
            "description": "The last name of the user.",
            "example": "Doe",
            "nullable": true
          },
          "picture": {
            "type": "string",
            "format": "uri",
            "description": "The URL of the user's profile picture.",
            "example": "http://example.com/profile.jpg",
            "nullable": true
          },
          "registrationDate": {
            "type": "string",
            "format": "date-time",
            "description": "The registration date."
          },
          "lastLogin": {
            "type": "string",
            "format": "date-time",
            "description": "The last login date.",
            "nullable": true
          }
        }
      },
      "Notification": {
        "type": "object",
        "description": "Notification delivered by the local server.",
        "required": [
          "id",
          "userId",
          "topic",
          "key",
          "text",
          "type",
          "timestamp",
          "isRead"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the notification.",
            "example": "notif-8b31c2f9"
          },
          "userId": {
            "type": "string",
            "description": "Identifier of the user that should receive the notification.",
            "example": "123"
          },
          "topic": {
            "type": "string",
            "description": "Kafka topic that produced the notification.",
            "example": "platform.ui-notifications.tenant1"
          },
          "key": {
            "type": "string",
            "description": "Notification key, used for deduplication and cache storage.",
            "example": "user:123"
          },
          "partition": {
            "type": "integer",
            "nullable": true,
            "description": "Kafka partition for the event when available.",
            "example": 0
          },
          "offset": {
            "type": "string",
            "nullable": true,
            "description": "Kafka offset represented as a string to preserve precision.",
            "example": "42"
          },
          "text": {
            "type": "string",
            "description": "Message presented to the user.",
            "example": "Il tuo job è stato completato con successo."
          },
          "type": {
            "type": "string",
            "description": "Application-defined notification type.",
            "example": "success"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "ISO timestamp when the notification was generated.",
            "example": "2024-10-05T12:34:56.000Z"
          },
          "isRead": {
            "type": "boolean",
            "description": "Whether the notification has been read by the user.",
            "example": false
          }
        }
      },
      "NotificationListResponse": {
        "type": "object",
        "description": "Response wrapper containing notifications for a user.",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "array",
            "description": "Ordered list of notifications, newest first.",
            "items": {
              "$ref": "#/components/schemas/Notification"
            }
          }
        }
      },
      "NotificationReadStatusUpdate": {
        "type": "object",
        "description": "Update payload for a single notification read state.",
        "required": [
          "id",
          "isRead"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the notification to update.",
            "example": "notif-8b31c2f9"
          },
          "isRead": {
            "type": "boolean",
            "description": "Flag indicating whether the notification has been read.",
            "example": true
          }
        }
      },
      "NotificationReadStatusSyncRequest": {
        "description": "Accepts updates as an array or wrapped in an object under the `updates` key.",
        "oneOf": [
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationReadStatusUpdate"
            }
          },
          {
            "type": "object",
            "required": [
              "updates"
            ],
            "properties": {
              "updates": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/NotificationReadStatusUpdate"
                }
              }
            }
          }
        ]
      },
      "NotificationReadStatusSyncResponse": {
        "type": "object",
        "description": "Acknowledgement of notification read status synchronization.",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "Status message confirming the synchronization.",
            "example": "Read status updated"
          }
        }
      },
      "File": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "userId": {
            "type": "integer"
          },
          "extension": {
