              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "description": "Operation status message.",
                  "example": "Activity retrieved successfully."
                },
                "data": {
                  "$ref": "#/components/schemas/Activity"
                }
              }
            }
          }
        }
      },
      "OkResponseActivity": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "description": "Operation status message.",
                  "example": "Activities retrieved successfully."
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Activity"
                  }
                }
              },
              "required": [
                "message",
                "data"
              ]
            }
          }
        }
      },
      "OkResponseNotificationSync": {
        "description": "Notification read status synchronized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NotificationReadStatusSyncResponse"
            }
          }
        }
      },
      "StopResponseActivityById": {
        "description": "Stopped",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "description": "Operation status message.",
                  "example": "Activity stopped successfully."
                },
                "data": {
                  "$ref": "#/components/schemas/Activity"
                }
              }
            }
          }
        }
      },
      "DeletedResponseActivity": {
        "description": "Deleted",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "description": "Operation status message.",
                  "example": "Activities deleted successfully."
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Activity"
                  }
                }
              }
            }
          }
        }
      }
    },
    "requestBodies": {
      "PostFileBody": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "$ref": "#/components/schemas/File"
            }
          }
        }
      },
      "PostFileInfoBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/FileInfo"
            }
          }
        }
      },
      "PostGraphBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Graph"
            }
          }
        }
      },
      "PostUpdateFileContentBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UpdateFileContent"
            }
          }
        }
      },
      "PatchBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UpdateBody"
            }
          }
        }
      },
      "PostActivityBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "discriminator": {
                "propertyName": "activityType",
                "mapping": {
                  "UPLOAD": "#/components/schemas/PostUploadActivityBody",
                  "ALIGNMENT": "#/components/schemas/PostAlignmentActivityBody",
                  "CONSTRUCTION": "#/components/schemas/PostConstructionActivityBody",
                  "AUGMENTATION": "#/components/schemas/PostAugmentationActivityBody",
                  "VISUALIZATION_CONVERSION": "#/components/schemas/PostVisualizationConversionActivityBody",
                  "VARIANT_CALLING": "#/components/schemas/PostVariantCallingActivityBody"
                }
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/PostUploadActivityBody"
                },
                {
                  "$ref": "#/components/schemas/PostAlignmentActivityBody"
                },
                {
                  "$ref": "#/components/schemas/PostConstructionActivityBody"
                },
                {
                  "$ref": "#/components/schemas/PostAugmentationActivityBody"
                },
                {
                  "$ref": "#/components/schemas/PostVisualizationConversionActivityBody"
                },
                {
                  "$ref": "#/components/schemas/PostVariantCallingActivityBody"
                }
              ]
            }
          }
        }
      },
      "PatchActivityBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UpdateBody"
            }
          }
        }
      },
      "SyncNotificationReadStatusBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NotificationReadStatusSyncRequest"
            }
          }
        }
      }
    }
  }
}
