    "/sections": {
      "get": {
        "tags": [
          "Sections"
        ],
        "summary": "Get section data",
        "description": "Returns all active sections, or a single section with its articles\nwhen `section_id` is supplied.\n\nWhen the `RSS_SECTIONS_IDS` server config is set, only those section\nIDs are returned.\n",
        "operationId": "getSectionData",
        "parameters": [
          {
            "name": "section_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Return a specific section (with articles)."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Number of articles to include when a single section is requested."
          },
          {
            "name": "format_type",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Section data",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "sections_data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Section"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": [
          "Search & Tags"
        ],
        "summary": "Full-text article search",
        "description": "Searches articles using Sphinx full-text search (falls back to a\ndatabase `LIKE` query when Sphinx is unavailable).\n\nReturns a paginated result set.  When `USE_WEIGHTS` is enabled\nserver-side, results are weighted by field importance.\n",
        "operationId": "getSearchData",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search query string."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "section_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Restrict search to a specific section."
          },
          {
            "name": "format_type",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "articles_data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Article"
                          }
                        },
                        "pagination": {
                          "$ref": "#/components/schemas/Pagination"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "response": "success",
                  "articles_data": [],
                  "pagination": {
                    "current_page": 1,
                    "last_page": 3,
                    "per_page": 10,
                    "total": 27
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tags/{tag_name}": {
