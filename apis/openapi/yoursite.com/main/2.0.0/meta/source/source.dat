    "/latest-pdf/{publication_name}": {
      "get": {
        "tags": [
          "PDF & Epaper"
        ],
        "summary": "Get latest PDF (route alias 1)",
        "description": "Returns the latest published PDF.  When `publication_name` contains\ncomma-separated values, one row per publication is returned (the most\nrecent issue for each).\n\n`preview_image` and `pdf_name` are returned as fully-qualified URLs\nwith CDN transformations applied when CDN is enabled.\n",
        "operationId": "getLatestPdfV1",
        "parameters": [
          {
            "name": "publication_name",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Publication name (comma-separated for multiple)."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Number of PDFs to return (single publication only)."
          },
          {
            "name": "order_by",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "issue_date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest PDF(s)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Pdf"
                          }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "response": "success",
                  "data": [
                    {
                      "pdf_id": 99,
                      "pdf_name": "https://cdn.example.com/issues/2024-01-15.pdf",
                      "preview_image": "https://img.example.com/?url=...&w=300&q=100&f=jpg&t=2",
                      "issue_date": "2024-01-15",
                      "publication_name": "Daily News"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/get_latest_pdf/{publication_name}": {
      "get": {
        "tags": [
          "PDF & Epaper"
        ],
