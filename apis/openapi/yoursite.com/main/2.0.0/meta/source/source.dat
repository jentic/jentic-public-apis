    "/subscribe_newsletter": {
      "get": {
        "tags": [
          "Newsletter"
        ],
        "summary": "Subscribe to newsletter",
        "description": "Subscribes an email address to the newsletter.  Performs basic email\nvalidation and uniqueness check before inserting.\n",
        "operationId": "subscribeNewsletter",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            },
            "description": "Subscriber email address."
          },
          {
            "name": "format_type",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Subscription result",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "subscribed": {
