{
  "openapi": "3.0.3",
  "info": {
    "title": "Website API V2",
    "description": "Optimised V2 of the Website public API.\n\n**Base URL:** `{scheme}://{host}/api/v2`\n\nAll endpoints require the `public_api` middleware (token passed via the\n`X-API-Key` request header or the `api_token` query parameter, depending\non your server configuration).\n\n### Common response envelope\n\nEvery response is a JSON object with at minimum a `response` field:\n\n| Value | Meaning |\n|-------|---------|\n| `\"success\"` | Request succeeded — look for the domain-specific payload field |\n| `\"failed\"` | Request failed or returned no results |\n\n### Pagination\n\nEndpoints that return lists accept `page` (1-based) and `limit` query\nparameters.  When pagination metadata is present it is returned in a\n`pagination` object:\n\n```json\n{\n  \"current_page\": 1,\n  \"last_page\": 10,\n  \"per_page\": 10,\n  \"total\": 98\n}\n```\n",
    "version": "2.0.0",
    "contact": {
      "name": "API Support"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/test-597-d4a/website-api-v2/2.0.0"
  },
  "servers": [
    {
      "url": "https://yoursite.com/api/v2",
      "description": "Production"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "ApiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "api_token"
      }
    },
    "parameters": {
      "format_type": {
        "name": "format_type",
        "in": "path",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "json"
          ],
          "default": "json"
        },
        "description": "Response format. Only `json` is supported."
      }
    },
    "schemas": {
      "SuccessEnvelope": {
        "type": "object",
        "required": [
          "response"
        ],
        "properties": {
          "response": {
            "type": "string",
            "example": "success"
          }
        }
      },
      "FailedEnvelope": {
        "type": "object",
        "required": [
          "response"
        ],
        "properties": {
          "response": {
            "type": "string",
            "example": "failed"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer",
            "example": 1
          },
          "last_page": {
            "type": "integer",
            "example": 10
          },
          "per_page": {
            "type": "integer",
            "example": 10
          },
          "total": {
            "type": "integer",
            "example": 98
          }
        }
      },
      "Article": {
        "type": "object",
        "description": "Article listing representation (subset of all columns).",
        "properties": {
          "np_article_id": {
            "type": "integer"
          },
          "cms_article_id": {
            "type": "integer"
          },
          "article_title": {
            "type": "string"
          },
          "article_subtitle": {
            "type": "string"
          },
          "article_byline": {
            "type": "string"
          },
          "author_id": {
            "type": "integer"
          },
          "author_name": {
            "type": "string"
          },
          "section_id": {
            "type": "integer"
          },
          "section_name": {
            "type": "string"
          },
          "sub_section_id": {
            "type": "integer"
          },
          "sub_section_name": {
            "type": "string"
          },
          "publish_time": {
            "type": "string",
            "format": "date-time"
          },
          "last_edited": {
            "type": "string",
            "format": "date-time"
          },
          "image_path": {
            "type": "string"
          },
          "permalink": {
            "type": "string"
          },
          "article_tags": {
            "type": "string"
          },
          "is_old_article": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "max_publish_time": {
            "type": "string",
            "format": "date-time"
          },
          "article_custom_fields": {
            "type": "string",
            "description": "JSON-encoded custom field map."
          },
          "article_shortlink": {
            "type": "string"
          },
          "cropped_image": {
            "type": "string"
          },
          "breaking_news": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "highlight_flag": {
            "type": "integer"
          },
          "visit_count": {
            "type": "integer"
          },
          "featured_article_flag": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "is_updated": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "related_articles_ids": {
            "type": "string"
          },
          "sponsored_flag": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "offer_flag": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          },
          "publication_id": {
            "type": "integer"
          }
        }
      },
      "ArticleDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Article"
          },
          {
            "type": "object",
            "description": "Extra fields included only for single-article detail responses.",
            "properties": {
              "article_body": {
                "type": "string"
              },
              "seo_meta_keywords": {
                "type": "string"
              },
              "seo_meta_description": {
                "type": "string"
              },
              "seo_meta_title": {
                "type": "string"
              },
              "a_custom_data": {
                "type": "string"
              },
              "media_gallery_flag": {
                "type": "integer"
              },
              "video_gallery_flag": {
                "type": "integer"
              },
              "top_story_flag": {
                "type": "integer"
              },
              "slide_show": {
                "type": "integer"
              },
              "page_number": {
                "type": "integer"
              },
              "homepage_article_flag": {
                "type": "integer"
              },
              "push_sent": {
                "type": "integer"
              }
            }
          }
        ]
      },
      "Author": {
        "type": "object",
        "properties": {
          "author_id": {
            "type": "integer"
          },
          "author_name": {
            "type": "string"
          },
          "author_email": {
            "type": "string"
          },
          "author_bio": {
            "type": "string"
          },
          "author_image": {
            "type": "string"
          },
          "twitter_handle": {
            "type": "string"
          }
        }
      },
      "Section": {
        "type": "object",
        "properties": {
          "section_id": {
            "type": "integer"
          },
          "section_name": {
            "type": "string"
          },
          "section_permalink": {
            "type": "string"
          },
          "parent_section_id": {
            "type": "integer"
          },
          "section_order": {
            "type": "integer"
          }
        }
      },
      "MenuItem": {
        "type": "object",
        "properties": {
          "np_menu_item_id": {
            "type": "integer"
          },
          "np_menu_id": {
            "type": "integer"
          },
          "menu_item_title": {
            "type": "string"
          },
          "menu_item_link": {
            "type": "string"
          },
          "menu_item_order": {
            "type": "integer"
          },
          "parent_menu_item_id": {
            "type": "integer"
          },
          "sub_items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MenuItem"
            }
          }
        }
      },
      "Pdf": {
        "type": "object",
        "properties": {
          "pdf_id": {
            "type": "integer"
          },
          "pdf_name": {
            "type": "string",
            "description": "Full URL to the PDF file."
          },
          "preview_image": {
            "type": "string",
            "description": "Full URL to the preview/thumbnail image."
          },
          "issue_date": {
            "type": "string",
            "format": "date"
          },
          "publication_name": {
            "type": "string"
          }
        }
      },
      "Country": {
        "type": "object",
        "properties": {
          "country_id": {
            "type": "integer"
          },
          "country_name": {
            "type": "string"
          },
          "country_code": {
            "type": "string"
          }
        }
      },
      "City": {
        "type": "object",
        "properties": {
          "city_id": {
            "type": "integer"
          },
          "city_name": {
            "type": "string"
          },
          "country_id": {
            "type": "integer"
          }
        }
      }
    }
  },
  "security": [
    {
      "ApiKeyHeader": []
    },
    {
      "ApiKeyQuery": []
    }
  ],
  "paths": {
    "/article/{article_id}": {
      "get": {
        "tags": [
          "Articles"
        ],
        "summary": "Get single article",
        "description": "Returns a single article by its ID.  Looks in the live `article` table\nfirst; falls back to the `article_archive` table when `is_old_article`\nis set or no live row is found.\n\nThe response includes the full detail column set (body, SEO fields,\ngallery flags, etc.) in addition to all listing fields.\n",
        "operationId": "getArticleData",
        "parameters": [
          {
            "name": "article_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Primary article identifier (`np_article_id`)."
          },
          {
            "name": "format_type",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ],
              "default": "json"
            }
          },
          {
            "name": "cms_article_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Alternative lookup by CMS article ID."
          },
          {
            "name": "permalink",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Alternative lookup by permalink slug."
          }
        ],
        "responses": {
          "200": {
            "description": "Article found",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "article_data": {
                          "$ref": "#/components/schemas/ArticleDetail"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "response": "success",
                  "article_data": {
                    "np_article_id": 12345,
                    "article_title": "Sample Article Title",
                    "permalink": "sample-article-title",
                    "publish_time": "2024-01-15T10:30:00Z"
                  }
                }
              }
            }
          },
          "200-failed": {
            "description": "Article not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FailedEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/articles": {
      "get": {
        "tags": [
          "Articles"
        ],
        "summary": "Get articles list",
        "description": "Returns a paginated list of articles.  Supports filtering by section,\nauthor, tags, publication, date range, and many other criteria.\n\nWhen `MULTI_COUNTRIES` is enabled server-side, section filtering uses\nthe `article_multi_section` join table instead of the direct\n`section_id` column.\n\nArticles are ordered by `max_publish_time DESC` by default.\n",
        "operationId": "getArticlesData",
        "parameters": [
          {
            "name": "format_type",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          },
          {
            "name": "section_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by section."
          },
          {
            "name": "sub_section_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by sub-section."
          },
          {
            "name": "author_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by author."
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by article tag."
          },
          {
            "name": "publication_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Filter by publication."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            },
            "description": "Number of articles per page."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "Page number (1-based)."
          },
          {
            "name": "date_from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter articles published on or after this date (YYYY-MM-DD)."
          },
          {
            "name": "date_to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter articles published on or before this date (YYYY-MM-DD)."
          },
          {
            "name": "featured",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "description": "Filter by featured flag."
          },
          {
            "name": "breaking_news",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ]
            },
            "description": "Filter breaking news articles."
          },
          {
            "name": "order_by",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "max_publish_time"
            },
            "description": "Column to sort results by."
          },
          {
            "name": "order_dir",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ],
              "default": "DESC"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Articles list",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "articles_data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Article"
                          }
                        },
                        "pagination": {
                          "$ref": "#/components/schemas/Pagination"
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "response": "success",
                  "articles_data": [],
                  "pagination": {
                    "current_page": 1,
                    "last_page": 5,
                    "per_page": 10,
                    "total": 48
                  }
                }
              }
            }
          }
        }
      }
    },
    "/relatedArticles": {
      "get": {
        "tags": [
          "Articles"
        ],
        "summary": "Get related articles",
        "description": "Returns articles related to a given article.  Uses the\n`related_articles_ids` field on the source article plus tag-based\nmatching as a fallback.\n",
        "operationId": "getRelatedArticles",
        "parameters": [
          {
            "name": "np_article_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Source article whose related articles should be retrieved."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 5
            },
            "description": "Maximum number of related articles."
          },
          {
            "name": "format_type",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Related articles",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "articles_data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Article"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/articles_pushed": {
      "get": {
        "tags": [
          "Articles"
        ],
        "summary": "Get pushed articles",
        "description": "Returns articles that have been push-notified (`push_sent = 1`).",
        "operationId": "getPushedArticles",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "format_type",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pushed articles",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "articles_data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Article"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sitemap/articles": {
      "get": {
        "tags": [
          "Articles"
        ],
        "summary": "Get sitemap articles",
        "description": "Returns articles intended for XML sitemap generation.  Supports\ndate-range filtering and optionally supplements live articles with\narchive rows.\n",
        "operationId": "getSiteMapArticles",
        "parameters": [
          {
            "name": "date_from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Start date (YYYY-MM-DD)."
          },
          {
            "name": "date_to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "End date (YYYY-MM-DD)."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1000
            }
          },
          {
            "name": "with_archive",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "default": 0
            },
            "description": "Include rows from the article_archive table."
          },
          {
            "name": "format_type",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sitemap articles",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "articles_data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Article"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/next-related-article": {
      "get": {
        "tags": [
          "Articles"
        ],
        "summary": "Get next related article",
        "description": "Returns the next chronological article in the same section,\nused for article-to-article navigation (\"Read next\").\n",
        "operationId": "getNextRelatedArticle",
        "parameters": [
          {
            "name": "np_article_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "section_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "format_type",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Next article",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "article_data": {
                          "$ref": "#/components/schemas/Article"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/getMostReadArticles": {
      "get": {
        "tags": [
          "Articles"
        ],
        "summary": "Get most-read articles",
        "description": "Returns the most-read articles ordered by `visit_count` descending.",
        "operationId": "getMostReadArticles",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          },
          {
            "name": "section_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Limit to articles in a specific section."
          }
        ],
        "responses": {
          "200": {
            "description": "Most-read articles",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "articles_data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Article"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/authors": {
      "get": {
        "tags": [
          "Authors"
        ],
        "summary": "Get author data",
        "description": "Returns a single author's profile together with their articles, or a\nlist of all authors when no `author_id` is supplied.\n\nWhen `with_archive=1`, the article count is supplemented with rows\nfrom the archive table (result cached for 24 hours).\n",
        "operationId": "getAuthorData",
        "parameters": [
          {
            "name": "author_id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Specific author to retrieve."
          },
          {
            "name": "with_archive",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "default": 0
            },
            "description": "Include archived articles in the count."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Number of articles to return alongside author data."
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "format_type",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Author data",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "author_data": {
                          "$ref": "#/components/schemas/Author"
                        },
                        "articles_data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Article"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/get_distinct_authors_articles": {
      "get": {
