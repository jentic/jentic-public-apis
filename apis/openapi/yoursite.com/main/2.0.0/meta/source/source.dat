    "/menu_items/{np_menu_id}": {
      "get": {
        "tags": [
          "Menu"
        ],
        "summary": "Get menu items",
        "description": "Returns all items for a given menu.  Items with `parent_menu_item_id = 0`\nare top-level; when `nested=1` child items are embedded in a `sub_items`\narray on the parent.\n",
        "operationId": "getMenuItemsData",
        "parameters": [
          {
            "name": "np_menu_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Menu identifier."
          },
          {
            "name": "nested",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "default": 0
            },
            "description": "Return items in nested tree format."
          },
          {
            "name": "format_type",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Menu items",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessEnvelope"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "menu_data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/MenuItem"
                          }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "response": "success",
                  "menu_data": [
                    {
                      "np_menu_item_id": 1,
                      "menu_item_title": "Home",
                      "menu_item_link": "/",
                      "menu_item_order": 1
                    }
                  ]
                }
              }
            }
          }
        }
      }
