{
  "openapi": "3.0.3",
  "info": {
    "title": "Restrata People Connector - Person Profile Ingestion API",
    "description": "Synchronous API for bulk ingestion of person profiles into the Restrata platform. Accepts an array of person profiles, validates them, and publishes to NATS JetStream for async processing across 10 parallel segment handlers.",
    "version": "1.0",
    "contact": {
      "name": "Platform Engineering",
      "email": "platform@restrata.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/restratalimitedstd/restrata-person-profile-ingestion/1.0"
  },
  "servers": [
    {
      "url": "https://global-f1dev.demo.copy.restrata.net/restrata-people-connector-service/v1",
      "description": "F1Dev Environment"
    },
    {
      "url": "https://demo.global-demo.restrata.net/restrata-people-connector-service/v1",
      "description": "Demo Environment"
    },
    {
      "url": "https://global.restrata.net/restrata-people-connector-service/v1",
      "description": "Production Environment"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/{tenantId}/sync-people-data": {
      "post": {
        "summary": "Sync Person Profiles",
        "description": "Submits one or more person profiles for ingestion. Each profile is validated. On success, profiles are published to NATS JetStream for async processing. Returns immediately with `200 OK` or `422` with validation errors per profile.",
        "operationId": "syncPeopleData",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "description": "Tenant identifier (custom-generated UUID or code)",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "id-676479aa-f662-4839-9e43-a715ac746242"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonProfilesRequest"
              },
              "example": {
                "personProfiles": [
                  {
                    "id": "100174",
                    "source": "workday",
                    "firstName": "Rizzal",
                    "lastName": "Abdullah",
                    "email": "rizzal.abdullah@example.com",
                    "active": true,
                    "companyDetails": {
                      "company": "6225 Baker Hughes Saudi Arabia Company",
                      "employeeId": "100174",
                      "jobTitle": "Remote Professional General",
                      "department": "S61029591 OFSE-Regions-KSA (ALI MOHAMMED ALAWAMI)",
                      "departmentHead": "ALI MOHAMMED ALAWAMI",
                      "personType": "Employee",
                      "employeeType": "Rotator"
                    },
                    "contactDetails": [
                      {
                        "contactDetailType": "EMAIL",
                        "contactType": "Work",
                        "primary": true,
                        "value": "RIZZAL.ABDULLAH@example.COM"
                      },
                      {
                        "contactDetailType": "MOBILE",
                        "contactType": "Work",
                        "primary": true,
                        "value": "+60162034283"
                      }
                    ],
                    "addresses": [
                      {
                        "type": "Work",
                        "title": "BLD-1039780",
                        "isPrimary": true,
                        "line1": "Abqaiq Highway",
                        "line2": "Opposite 2nd Industrial City, Behind Sahel Gas Station Units 1-6",
                        "city": "Dhahran",
                        "region": "Eastern Region",
                        "country": "Saudi Arabia",
                        "postCode": "31952"
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success — all profiles accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "status": "OK",
                  "error": null
                }
              }
            }
          },
          "400": {
            "description": "Bad Request — malformed JSON or missing tenantId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — invalid or missing X-API-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Failed — one or more profiles have errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "example": {
                  "status": "ERROR",
                  "error": {
                    "100174": [
                      "'firstName' is mandatory",
                      "+60162034283 is invalid. Please ensure it starts with the correct country code..."
                    ],
                    "100175": [
                      "Address Type is mandatory"
                    ]
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Randomly generated API key per tenant and endpoint"
      }
    },
    "schemas": {
      "PersonProfilesRequest": {
        "type": "object",
        "required": [
          "personProfiles"
        ],
        "properties": {
          "personProfiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PersonProfileRequest"
            },
            "minItems": 1,
            "description": "Array of person profiles to ingest"
          }
        }
      },
      "PersonProfileRequest": {
        "type": "object",
        "required": [
          "id",
          "firstName",
          "lastName"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "3rd Party Primary ID for this profile",
            "example": "100174"
          },
          "source": {
            "type": "string",
            "description": "Source system name",
            "example": "workday"
          },
          "title": {
            "type": "string",
            "example": "Mr."
          },
          "firstName": {
            "type": "string",
            "example": "Rizzal"
          },
          "middleNames": {
            "type": "string"
          },
          "lastName": {
            "type": "string",
            "example": "Abdullah"
          },
          "alternateName": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO date (yyyy-MM-dd), must not be in the future",
            "example": "1990-05-23"
          },
          "gender": {
            "type": "string",
            "enum": [
              "Male",
              "Female"
            ],
            "example": "Male"
          },
          "nationality": {
            "type": "string"
          },
          "countryOfResidenceRef": {
            "type": "string",
            "example": "Malaysia"
          },
          "userPreferredLanguage": {
            "type": "string"
          },
          "active": {
            "type": "boolean",
            "default": true
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "profilePicture": {
            "type": "string",
            "format": "uri"
          },
          "profilePictureThumbnail": {
            "type": "string",
            "format": "uri"
          },
          "companyDetails": {
            "$ref": "#/components/schemas/CompanyDetailsRequest"
          },
          "contactDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactDetailsRequest"
            }
          },
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddressRequest"
            }
          },
          "medicalDetails": {
            "$ref": "#/components/schemas/MedicalDetailsRequest"
          },
          "emergencyContacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmergencyContactDetailsRequest"
            }
          },
          "distinguishingFeatures": {
            "$ref": "#/components/schemas/DistinguishingFeatureRequest"
          }
        }
      },
      "CompanyDetailsRequest": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "employeeId": {
            "type": "string"
          },
          "jobTitle": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "departmentHead": {
            "type": "string"
          },
          "lineManager": {
            "type": "string"
          },
          "personType": {
            "type": "string"
          },
          "employeeType": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          }
        }
      },
      "ContactDetailsRequest": {
        "type": "object",
        "required": [
          "contactDetailType",
          "contactType",
          "value"
        ],
        "properties": {
          "contactDetailType": {
            "type": "string",
            "enum": [
              "EMAIL",
              "MOBILE",
              "PHONE"
            ],
            "description": "Must be EMAIL, MOBILE, or PHONE"
          },
          "contactType": {
            "type": "string",
            "example": "Work"
          },
          "primary": {
            "type": "boolean",
            "default": false
          },
          "value": {
            "type": "string",
            "description": "Email address or phone number (with country code)"
          }
        }
      },
      "AddressRequest": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "Work",
              "Home"
            ],
            "description": "Work or Home"
          },
          "title": {
            "type": "string",
            "description": "Required if type is not Work"
          },
          "isPrimary": {
            "type": "boolean",
            "default": false
          },
          "name": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "line1": {
            "type": "string",
            "description": "Required if type is not Work"
          },
          "line2": {
            "type": "string"
          },
          "line3": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "postCode": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "MedicalDetailsRequest": {
        "type": "object",
        "properties": {
          "bloodType": {
            "type": "string"
          },
          "height": {
            "type": "number",
            "format": "double"
          },
          "heightUnit": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "format": "double"
          },
          "weightUnit": {
            "type": "string"
          },
          "medicalConditionsList": {
            "type": "string"
          },
          "allergiesList": {
            "type": "string"
          },
          "medicationsList": {
            "type": "string"
          }
        }
      },
      "EmergencyContactDetailsRequest": {
        "type": "object",
        "required": [
          "emergencyContactType"
        ],
        "properties": {
          "emergencyContactType": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "relationship": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "line3": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "postCode": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phoneList": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      },
      "DistinguishingFeatureRequest": {
        "type": "object",
        "properties": {
          "tattoosList": {
            "type": "string"
          },
          "scarsList": {
            "type": "string"
          },
          "birthMarksList": {
            "type": "string"
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "OK"
          },
          "error": {
            "type": "null",
            "example": null
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ERROR"
          },
          "error": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Map of profile ID → list of validation errors"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
