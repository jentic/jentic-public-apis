{
  "openapi": "3.0.3",
  "info": {
    "title": "Restrata Static Location Connector - Location Ingestion API",
    "description": "Synchronous API for bulk ingestion of static locations into the Restrata platform. Accepts an array of location records, validates them, and publishes to NATS JetStream for async processing. Returns immediately with `200 OK` or `422` with validation errors per location.",
    "version": "1.0",
    "contact": {
      "name": "Platform Engineering",
      "email": "platform@restrata.com"
    },
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/restratalimitedstd/restrata-static-location-ingestion/1.0"
  },
  "servers": [
    {
      "url": "https://global-f1dev.demo.copy.restrata.net/restrata-static-location-connector-service/v1",
      "description": "F1Dev Environment"
    },
    {
      "url": "https://demo.global-demo.restrata.net/restrata-static-location-connector-service/v1",
      "description": "Demo Environment"
    },
    {
      "url": "https://global.restrata.net/restrata-static-location-connector-service/v1",
      "description": "Production Environment"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/{tenantId}/sync-locations": {
      "post": {
        "summary": "Sync Static Locations",
        "description": "Submits one or more static locations for ingestion. Each location is validated. On success, locations are published to NATS JetStream for async processing. Returns immediately with `200 OK` or `422` with validation errors per location ID.",
        "operationId": "syncLocations",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "description": "Tenant identifier (custom-generated UUID or code)",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "id-676479aa-f662-4839-9e43-a715ac746242"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddressesRequest"
              },
              "example": {
                "locations": [
                  {
                    "id": "1039780",
                    "type": "Work",
                    "title": "Site 1039780",
                    "name": "Site 1039780",
                    "isPrimary": true,
                    "line1": "Abqaiq Highway",
                    "line2": "Opposite 2nd Industrial City",
                    "city": "Dhahran",
                    "region": "Eastern Region",
                    "country": "Saudi Arabia",
                    "postCode": "31952",
                    "latitude": 26.3085,
                    "longitude": 50.1132
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success — all locations accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "example": {
                  "status": "OK",
                  "error": null
                }
              }
            }
          },
          "400": {
            "description": "Bad Request — malformed JSON or missing tenantId",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — invalid or missing X-API-Key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Failed — one or more locations have errors",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationValidationErrorResponse"
                },
                "example": {
                  "status": "ERROR",
                  "error": {
                    "LOC-1001": [
                      "Address Line 1 is mandatory"
                    ],
                    "LOC-1002": [
                      "Address Title is mandatory"
                    ]
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Randomly generated API key per tenant and endpoint"
      }
    },
    "schemas": {
      "AddressesRequest": {
        "type": "object",
        "required": [
          "locations"
        ],
        "properties": {
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddressRequest"
            },
            "minItems": 1,
            "description": "Array of static locations to ingest"
          }
        }
      },
      "AddressRequest": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the location",
            "example": "LOC-1001"
          },
          "type": {
            "type": "string",
            "enum": [
              "Work",
              "Home"
            ],
            "description": "Location type"
          },
          "title": {
            "type": "string",
            "description": "Required if type is not Work"
          },
          "isPrimary": {
            "type": "boolean",
            "default": false
          },
          "name": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "line1": {
            "type": "string",
            "description": "Required if type is not Work"
          },
          "line2": {
            "type": "string"
          },
          "line3": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "postCode": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "OK"
          },
          "error": {
            "type": "null",
            "example": null
          }
        }
      },
      "LocationValidationErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ERROR"
          },
          "error": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Map of location ID to list of validation errors"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
