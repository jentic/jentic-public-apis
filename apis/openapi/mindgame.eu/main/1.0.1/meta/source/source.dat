{
  "openapi": "3.0.0",
  "info": {
    "title": "LTPM API",
    "description": "This is the API which can be used by LTP to access Mindgame's products and retrieve usage data.",
    "version": "1.0.1",
    "x-jentic-source-url": "https://api.swaggerhub.com/apis/mindgamebv/ltpm-api/1.0.1"
  },
  "servers": [
    {
      "url": "https://api-ltp.mindgame.eu"
    }
  ],
  "paths": {
    "/sso": {
      "post": {
        "summary": "Process SSO request and return game link",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "uuid": {
                    "type": "string",
                    "example": "XXXXX-XXXXX-XXXXX-XXXXX"
                  },
                  "company": {
                    "type": "string",
                    "example": "CompanyX"
                  },
                  "language": {
                    "type": "string",
                    "example": "en"
                  },
                  "product_id": {
                    "type": "number",
                    "example": 1,
                    "minimum": 1,
                    "maximum": 7
                  },
                  "callback_url": {
                    "type": "string",
                    "example": "https://example.com"
                  },
                  "webhook_url": {
                    "type": "string",
                    "example": "https://example.com"
                  }
                },
                "required": [
                  "uuid",
                  "company",
                  "language",
                  "product_id",
                  "callback_url",
                  "webhook_url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Game link with JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "game_link": {
                          "type": "string",
                          "example": "https://gamedomain.com/sso?jwt=eyJ0..."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    },
    "/register-360": {
      "post": {
        "summary": "Process register request for UUID",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "uuid": {
                    "type": "string",
                    "example": "XXXXX-XXXXX-XXXXX-XXXXX"
                  },
                  "company": {
                    "type": "string",
                    "example": "CompanyX"
                  },
                  "custom": {
                    "type": "object",
                    "example": "{ title: '<title>', introduction: '<introduction>', prompt: '<prompt>', start_text: '<starttext>' }"
                  }
                },
                "required": [
                  "uuid",
                  "company",
                  "custom"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status code with message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "success"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    },
    "/data": {
      "get": {
        "summary": "Process UUID token and return play data",
        "parameters": [
          {
            "in": "query",
            "name": "uuid",
            "schema": {
              "type": "string",
              "example": "XXXXX-XXXXX-XXXXX-XXXXX"
            },
            "required": true,
            "description": "Unique identifier for the session"
          },
          {
            "in": "query",
            "name": "company",
            "schema": {
              "type": "string",
              "example": "CompanyX"
            },
            "required": true,
            "description": "Company name"
          },
          {
            "in": "query",
            "name": "product_id",
            "schema": {
              "type": "number",
              "example": 1,
              "minimum": 1,
              "maximum": 7
            },
            "required": true,
            "description": "Unique product id to fetch data for"
          }
        ],
        "responses": {
          "200": {
            "description": "Play data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true,
                      "description": "Boolean that indicates if the request has been succesfully evaluated"
                    },
                    "message": {
                      "type": "string",
                      "example": "success",
                      "description": "Basic message adding insight into result of request"
                    },
                    "data": {
                      "type": "object",
                      "description": "Data related to the games played by this uuid",
                      "properties": {
                        "sessions": {
                          "type": "object"
                        },
                        "session_resume_requests": {
                          "type": "number"
                        },
                        "play_status": {
                          "type": "string",
                          "example": "not_played"
                        }
                      }
                    }
                  },
                  "required": [
                    "status",
                    "message"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    },
    "/reset": {
      "get": {
        "summary": "Resets progress of a UUID for a product and company",
        "parameters": [
          {
            "in": "query",
            "name": "uuid",
            "schema": {
              "type": "string",
              "example": "XXXXX-XXXXX-XXXXX-XXXXX"
            },
            "required": true,
            "description": "Unique identifier for the session"
          },
          {
            "in": "query",
            "name": "company",
            "schema": {
              "type": "string",
              "example": "CompanyX"
            },
            "required": true,
            "description": "Company name"
          },
          {
            "in": "query",
            "name": "product_id",
            "schema": {
              "type": "number",
              "example": 1,
              "minimum": 1,
              "maximum": 7
            },
            "required": true,
            "description": "Unique product id to reset data for"
          }
        ],
        "responses": {
          "200": {
            "description": "Resets progress",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true,
                      "description": "Boolean that indicates if the request has been succesfully evaluated"
                    },
                    "message": {
                      "type": "string",
                      "example": "success",
                      "description": "Basic message adding insight into result of request"
                    }
                  },
                  "required": [
                    "status",
                    "message"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  }
}
