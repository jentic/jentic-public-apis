    "/v1/og": {
      "get": {
        "operationId": "ogImageGet",
        "summary": "Generate a 1200x630 Open Graph PNG (query parameters; for og:image tags use a signed URL: kid + sig, no API key)",
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "subtitle",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 300
            }
          },
          {
            "name": "template",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "gradient",
                "split"
              ],
              "default": "default"
            }
          },
          {
            "name": "theme",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "light",
                "dark"
              ],
              "default": "dark"
            }
          },
          {
            "name": "accent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$",
              "default": "#ff5a1f"
            }
          },
          {
            "name": "site",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 60
            }
          },
          {
            "name": "cache_ttl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2592000,
              "default": 604800
            }
          },
          {
            "name": "kid",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^kid_[0-9A-Za-z]{16}$"
            },
            "description": "Signed URLs: the key id from POST /v1/keys/signing-secret"
          },
          {
            "name": "exp",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Signed URLs: optional expiry, Unix seconds"
          },
          {
            "name": "sig",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "description": "Signed URLs: hex HMAC-SHA256 of \"/v1/og?\" + the other parameters sorted and percent-encoded, keyed with the signing secret"
          }
        ],
        "responses": {
          "200": {
            "description": "Rendered file",
            "content": {
              "image/png": {}
            },
            "headers": {
              "X-Cache": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "HIT",
                    "MISS",
                    "BYPASS"
                  ]
                }
              },
              "X-Quota-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter or blocked URL (code: invalid_parameter, invalid_url, url_blocked, blocked_url)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "invalid_signature or signature_expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Target page too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit, daily limit or monthly quota exceeded (see Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Target page failed to load",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Browser capacity temporarily unavailable (see Retry-After)",
            "content": {
