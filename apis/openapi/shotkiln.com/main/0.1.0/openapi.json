{
  "openapi": "3.1.0",
  "info": {
    "title": "Shotkiln API",
    "version": "0.1.0",
    "description": "Screenshots, PDFs and OG images from any public URL or HTML. Plans: Free 100/mo, Starter 2000/mo, Pro 10000/mo, Scale 50000/mo.",
    "contact": {
      "name": "Shotkiln support",
      "email": "support@shotkiln.com"
    },
    "x-jentic-source-url": "https://shotkiln.com/openapi.json"
  },
  "servers": [
    {
      "url": "https://shotkiln.com"
    }
  ],
  "paths": {
    "/v1/screenshot": {
      "get": {
        "operationId": "screenshotGet",
        "summary": "Screenshot a web page (query parameters; embeddable in <img src> with api_key)",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri",
              "description": "Public http(s) URL (ports 80/443/8080/8443)"
            }
          },
          {
            "name": "width",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 320,
              "maximum": 3840,
              "default": 1280
            }
          },
          {
            "name": "height",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 200,
              "maximum": 3840,
              "default": 800
            }
          },
          {
            "name": "full_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "description": "Capture the full scrollable page (max 16384 px tall)"
            }
          },
          {
            "name": "scroll",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "description": "With full_page: scroll through the page in steps first, then back to the top, so lazy-loaded images appear. Bounded by the render timeout. Set false to capture without scrolling. Ignored for viewport captures."
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "png",
                "jpeg",
                "webp"
              ],
              "default": "png"
            }
          },
          {
            "name": "quality",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 80,
              "description": "jpeg/webp only"
            }
          },
          {
            "name": "delay",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0,
              "description": "Extra wait after load (ms)"
            }
          },
          {
            "name": "device_scale_factor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 3,
              "default": 1
            }
          },
          {
            "name": "dark_mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "description": "Emulate prefers-color-scheme: dark"
            }
          },
          {
            "name": "cache_ttl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2592000,
              "default": 3600,
              "description": "Seconds to cache; 0 = always render fresh. Cache hits do not use quota."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rendered file",
            "content": {
              "image/png": {},
              "image/jpeg": {},
              "image/webp": {}
            },
            "headers": {
              "X-Cache": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "HIT",
                    "MISS",
                    "BYPASS"
                  ]
                }
              },
              "X-Quota-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameter or blocked URL (code: invalid_parameter, invalid_url, url_blocked, blocked_url)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Target page too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit, daily limit or monthly quota exceeded (see Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Target page failed to load",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Browser capacity temporarily unavailable (see Retry-After)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Render timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "screenshot",
        "summary": "Screenshot a web page",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
