            "schema": {
              "type": "string"
            }
          },
          {
            "name": "delay",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          },
          {
            "name": "cache_ttl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2592000,
              "default": 3600
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rendered file",
            "content": {
