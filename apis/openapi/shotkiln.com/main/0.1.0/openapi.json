            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "print_background",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "margin",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "10mm",
              "description": "All sides; or margin_top/right/bottom/left"
            }
          },
          {
            "name": "margin_top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "margin_right",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "margin_bottom",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "margin_left",
            "in": "query",
