{"openapi":"3.1.0","info":{"title":"Vaneform API","version":"1.4.0","description":"Read website intelligence through HTTP or MCP. Free and Pro keys can call the API. Free includes 100 credits per UTC month, Pro 10,000. A domain read spends 1 credit; bulk and TLD spend 1 credit per compared domain with data. Keyword lookup (60 credits) and include=search (200 credits) are Pro-only; a Free key gets 403 pro_required or search_requires_pro with an upgrade_url. Each key allows 60 requests a minute and 5,000 a day; over that returns 429 lookup_rate_exceeded with Retry-After. include=search uses a 24-hour receipt. A keyword repeat is free when the saved brief is ready or empty. Every estimate keeps as_of and confidence. The human guide is available at /docs/api."},"externalDocs":{"description":"Human API, MCP and agent documentation","url":"https://vaneform.com/docs/api"},"servers":[{"url":"https://vaneform.com/api/v1"}],"tags":[{"name":"Domain","description":"Cached snapshot for one domain."},{"name":"Keyword","description":"US/EN keyword brief. Pro-only."},{"name":"Compare","description":"Bulk and TLD compare. Scale plus registry."},{"name":"Account","description":"Plan, website-lookup count, and credits. This call spends 0."}],"security":[{"bearerAuth":[]},{"apiKeyHeader":[]}],"paths":{"/domains/{domain}":{"get":{"operationId":"lookupDomain","tags":["Domain"],"summary":"Read a cached domain snapshot","parameters":[{"name":"domain","in":"path","required":true,"description":"A public host such as google.com. A leading www. is removed and the host is lowercased. The receipt uses that host.","schema":{"type":"string","example":"google.com"}},{"name":"include","in":"query","required":false,"description":"Comma-separated families. Default is scale,registry,profile,popularity. Add baidu for cached Baidu rank. Add search for the Pro keyword rankings cache.","schema":{"type":"string","example":"scale,registry,profile,popularity"}}],"responses":{"200":{"description":"Cached snaps